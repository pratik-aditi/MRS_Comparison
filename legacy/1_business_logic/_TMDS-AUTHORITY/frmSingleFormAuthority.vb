                            End If
                            Me.btnBox1.Text = "X"
                            If Me.cmbItem1Void1.Text <> "" Then
                                Dim OverridePTCGPSCheck As Boolean = False
                                Dim SFAVoidAuth As TMDS.TrackAuthority.SFAuthority = FindAuthority(Me.cmbItem1Void1.Text)
                                'If optEnablePTCBOSAPIMode Then
                                '    OverridePTCGPSCheck = OkToOverRideGPSPrompt(SFAVoidAuth)
                                'End If
                                If Not Me.PerformJobBriefingConfirmation(SFAVoidAuth, OverridePTCGPSCheck) Then
                                    ClearSystemVariables()
                                    Me.CloseForm()
                                    Exit Sub
                                End If
                            End If

                            If Me.cmbItem1Void2.Text <> "" And cmbItem1Void2.Tag <> "BRIEFED" Then
                                Dim OverridePTCGPSCheck As Boolean = False
                                Dim SFAVoidAuth As TMDS.TrackAuthority.SFAuthority = FindAuthority(Me.cmbItem1Void2.Text)
                                'If optEnablePTCBOSAPIMode Then
                                '    OverridePTCGPSCheck = OkToOverRideGPSPrompt(SFAVoidAuth)
                                'End If
                                If Not Me.PerformJobBriefingConfirmation(SFAVoidAuth, OverridePTCGPSCheck) Then
                                    ClearSystemVariables()
                                    Me.CloseForm()
                                    Exit Sub
                                Else
                                    cmbItem1Void2.Tag = "BRIEFED"
                                    Me.cmbItem1Void2.Enabled = False
                                End If
                            ElseIf cmbItem1Void2.Tag <> "BRIEFED" Then
                                Me.cmbItem1Void2.Enabled = True
                            End If

                            If Me.cmbItem1Void3.Text <> "" And cmbItem1Void3.Tag <> "BRIEFED" Then
                                Dim OverridePTCGPSCheck As Boolean = False
                                Dim SFAVoidAuth As TMDS.TrackAuthority.SFAuthority = FindAuthority(Me.cmbItem1Void3.Text)
                                'If optEnablePTCBOSAPIMode Then
                                '    OverridePTCGPSCheck = OkToOverRideGPSPrompt(SFAVoidAuth)
                                'End If
                                If Not Me.PerformJobBriefingConfirmation(SFAVoidAuth, OverridePTCGPSCheck) Then
                                    ClearSystemVariables()
                                    Me.CloseForm()
                                    Exit Sub
                                Else
                                    cmbItem1Void3.Tag = "BRIEFED"
                                    Me.cmbItem1Void3.Enabled = False
                                End If
                            ElseIf cmbItem1Void3.Tag <> "BRIEFED" Then
                                Me.cmbItem1Void3.Enabled = True

                            End If
                            If Me.cmbItem1Void1.Text = "" Or Me.cmbItem1Void2.Text = "" Or Me.cmbItem1Void3.Text = "" Then
                                Me.LoadPotentialVoidAuthorities()
                            End If

                            If Me.cmbItem1Void2.Items.Count = 0 Then
                                Me.cmbItem1Void2.Enabled = False
                            End If
                            If Me.cmbItem1Void3.Items.Count = 0 Then
                                Me.cmbItem1Void3.Enabled = False
                            End If
                        Else
                            If Not gBoxOneRequired Then
                                Me.cmbItem1Void1.Enabled = True
                                Me.cmbItem1Void2.Enabled = True
                                Me.cmbItem1Void3.Enabled = True

                                Me.cmbItem1Void1.Items.Clear()
                                Me.cmbItem1Void2.Items.Clear()
                                Me.cmbItem1Void3.Items.Clear()

                                Me.cmbItem1Void1.Text = ""
                                Me.btnBox1.Text = ""
                                Me.cmbItem1Void2.Text = ""
                                Me.cmbItem1Void3.Text = ""
                                Me.AuthorityConfirmedList.Clear()
                                Me.cmbItem1Void1.Enabled = False
                                Me.cmbItem1Void2.Enabled = False
                                Me.cmbItem1Void3.Enabled = False
                                Me.LoadPotentialVoidAuthorities()
                            End If
                        End If

                    Case "chkItem2"
                        If gBoxTwoRequired Then
                            thisCheckBox.Checked = True
                            Me.txtItem2From1.ReadOnly = True
                            Me.txtItem2To1.ReadOnly = True
                            Me.txtItem2Track1.ReadOnly = True
                            Me.txtItem2From1.Tag = "VALIDATE"
                            Me.txtItem2To1.Tag = "VALIDATE"
                            Me.txtItem2Track1.Tag = "VALIDATE"
