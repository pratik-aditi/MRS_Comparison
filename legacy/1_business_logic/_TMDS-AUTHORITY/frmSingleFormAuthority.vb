    Private Sub PerformItemOneCheckForOtherAuthorities(ByVal item1 As ComboBox)
        Try

            Select Case item1.Name
                Case "cmbItem1Void1"
                    If item1.Text <> "" Then
                        item1.Enabled = False
                        Me.cmbItem1Void2.Items.Remove(Me.cmbItem1Void1.Text)
                        Me.cmbItem1Void3.Items.Remove(Me.cmbItem1Void1.Text)
                        If Me.cmbItem1Void2.Items.Count <> 0 And Me.cmbItem1Void2.Tag = "" Then
                            Me.cmbItem1Void2.Enabled = True
                        End If
                        If Not gBoxOneRequired Then
                            If Not Me.PerformJobBriefingConfirmation(FindAuthority(Me.cmbItem1Void1.Text)) Then
                                ClearSystemVariables()
                                Me.CloseForm()
                                Exit Sub
                            End If
                        End If
                    End If

                Case "cmbItem1Void2"
                    If item1.Text <> "" Then
                        If item1.Text <> Me.cmbItem1Void1.Text And item1.Tag = "" Then
                            If Not Me.PerformJobBriefingConfirmation(FindAuthority(Me.cmbItem1Void2.Text)) Then
                                ClearSystemVariables()
                                Me.CloseForm()
                                Exit Sub
                            Else
                                Me.cmbItem1Void2.Enabled = False
                            End If
                            Me.cmbItem1Void3.Items.Remove(Me.cmbItem1Void2.Text)
                            If Me.cmbItem1Void3.Items.Count <> 0 Then
                                Me.cmbItem1Void2.Enabled = False
                                Me.cmbItem1Void3.Enabled = True
                            End If
                        ElseIf item1.Tag <> "LOCK" Then
                            Me.cmbItem1Void2.Text = ""
                            SendKeys.Send("{BKSP}")
                        End If
                    End If

                Case "cmbItem1Void3"
                    If item1.Text <> "" And item1.Enabled Then
                        If item1.Text <> Me.cmbItem1Void1.Text And item1.Text <> Me.cmbItem1Void2.Text And item1.Tag = "" Then
                            If Not Me.PerformJobBriefingConfirmation(FindAuthority(Me.cmbItem1Void3.Text)) Then
                                ClearSystemVariables()
                                Me.CloseForm()
                                Exit Sub
                            End If
                            Me.cmbItem1Void3.Enabled = False
                        ElseIf item1.Tag <> "LOCK" Then
                            Me.cmbItem1Void3.Text = ""
                            SendKeys.Send("{BKSP}")
                        End If
                    End If
            End Select

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

