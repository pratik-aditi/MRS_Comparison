    Private Sub CheckToAddSwitchPointsToBox12(ByVal CompList As ArrayList)
        Try
            Dim LastTrack As Track = Me.FindLastTrackInList(CompList)
            Dim FirstSwitch As Object = CompList(0)

            If FirstSwitch.GetType.ToString = gSwitchComponentName Then
                If FirstSwitch.SwitchPointerMonitorMode And (FirstSwitch.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or FirstSwitch.FailState) Then
                    Item12Forced = True
                    gBoxTwelveRequired = True
                    If Not BoxTwelveSwitches.Contains(FirstSwitch.Name) Then
                        BoxTwelveSwitches.Add(FirstSwitch.Name)
                    End If
                End If
            End If

            If Not IsNothing(LastTrack) Then
                If Not IsNothing(LastTrack.OsComponentCollection) Then
                    Dim comp As Object
                    For Each comp In LastTrack.OsComponentCollection
                        If comp.GetType.ToString = gSwitchComponentName Then
                            Dim sw As Switch = CType(comp, Switch)
                            If sw.SwitchPointerMonitorMode And (sw.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or sw.FailState) Then
                                Item12Forced = True
                                gBoxTwelveRequired = True
                                If Not BoxTwelveSwitches.Contains(sw.Name) Then
                                    BoxTwelveSwitches.Add(sw.Name)
                                End If
                            End If
                        End If
                    Next
                Else

                    If gSearchDirection = "LEFT" Then
                        Dim swLeft As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(LastTrack.LeftLink)
                        If Not IsNothing(swLeft) Then
                            If swLeft.SwitchPointerMonitorMode And (swLeft.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or swLeft.FailState) Then
                                Dim AddSwitch As Boolean = True
                                If swLeft.ComponentType = "SPRT" Or swLeft.ComponentType = "SPRB" Then
                                    AddSwitch = False
                                End If
                                If AddSwitch Then
                                    Item12Forced = True
                                    gBoxTwelveRequired = True
                                    If Not BoxTwelveSwitches.Contains(swLeft.Name) Then
                                        BoxTwelveSwitches.Add(swLeft.Name)
                                    End If
                                End If
                            End If
                        End If
                    Else
                        Dim swRight As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(LastTrack.RightLink)
                        If Not IsNothing(swRight) Then
                            If swRight.SwitchPointerMonitorMode And (swRight.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or swRight.FailState) Then
                                Dim AddSwitch As Boolean = True
                                If swRight.ComponentType = "SPLT" Or swRight.ComponentType = "SPLB" Then
                                    AddSwitch = False
                                End If
                                If AddSwitch Then
                                    Item12Forced = True
                                    gBoxTwelveRequired = True
                                    If Not BoxTwelveSwitches.Contains(swRight.Name) Then
                                        BoxTwelveSwitches.Add(swRight.Name)
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
            End If
            'If OverideSPMSSwitch.Count > 0 Then
            '    Dim sw As Switch
            '    For Each sw In OverideSPMSSwitch
            '        Item12Forced = True
            '        gBoxTwelveRequired = True
            '        If Not BoxTwelveSwitches.Contains(sw.Name) Then
            '            BoxTwelveSwitches.Add(sw.Name)
            '        End If
            '    Next
            'End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

