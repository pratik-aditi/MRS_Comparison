#Region "PROTECT OPEN SWITCH"

    Private Function ProtectOpenSwitchCheck(ByVal ComponentList As ArrayList, ByVal FirstTypeOfWarrant As String, ByVal SearchDirection As String) As Boolean

        '*******************************PROTECT OPEN SWITCH - PROTECT LOGIC
        Dim CompToInspect As Object
        Dim Box12Counter As Integer
        Dim SystemMessage As String
        'Dim SignalSystemFound As Boolean

        Try
            For Each CompToInspect In ComponentList

                If CompToInspect.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(CompToInspect, Switch)
                    If sw.ControlledReverse And sw.LeaveReversePermission And sw.ProtectOpenSwitchEnabled And Not sw.RCPS Then
                        Box12Counter += 1
                    End If
                    If Box12Counter > 3 Then
                        Return False
                    End If
                End If
            Next
            For Each CompToInspect In ComponentList
                If CompToInspect.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(CompToInspect, Switch)
                    If sw.AuthorityType <> "TWC" Then
                        'SignalSystemFound = True
                    End If

                    If sw.ControlledReverse And sw.LeaveReversePermission And sw.ProtectOpenSwitchEnabled And Not sw.RCPS And Not sw.BoxThirteenControlled Then

                        Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                        Dim frmMessageBox As frmMessageBox
                        Dim MessageList As New ArrayList()
                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                        MessageList.Add(sw.Name & " INDICATES IN THE REVERSE POSITION.")
                        MessageList.Add("")
                        MessageList.Add("BOX 12 WILL BE FORCED!")
                        MessageList.Add("")

                        frmMessageBox.SetMessage(MessageList, "PROTECT OPEN SWITCH CHECK", False, LaunchPoint)

                        SystemMessage = sw.Name & " INDICATES IN THE REVERSE POSITION. " & vbCrLf & vbCrLf & "BOX 12 WILL BE FORCED.!"
                        AuthorityEvent(SystemMessage)
                        'frmMessageBox.SetMessage(MessageList, "PROTECT OPEN SWITCH CHECK", False, LaunchPoint)

                        'SystemMessage = sw.Name & " INDICATES IN THE REVERSE POSITION. " & vbCrLf & vbCrLf & "BOX 12 WILL BE FORCED.!"
                        'AuthorityEvent(SystemMessage)

                        If optBox20ForcedDialogBox Then
                            frmMessageBox.ShowDialog()
                        End If
                        MessageList.Clear()
                        MessageList = Nothing
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing

                        Item12Forced = True
                        gBoxTwelveRequired = True
                        If Not BoxTwelveSwitches.Contains(sw.Name) Then
                            BoxTwelveSwitches.Add(sw.Name)
                        End If
                        'ElseIf sw.RCPS Then
                        '    If sw.FailState Or sw.ForceProtectionOnRCPS Then
                        '        Item12Forced = True
                        '        gBoxTwelveRequired = True
                        '        If Not BoxTwelveSwitches.Contains(sw.Name) Then
                        '            BoxTwelveSwitches.Add(sw.Name)
                        '        End If
                        '    End If
                    End If
                End If
            Next
            '********************************PROTECT OPEN SWITCH - PROTECTION
            If Mid(FirstTypeOfWarrant, 1, 14) = "ItemTwoToTrain" Then
                Dim ByPassPOSCheck As Boolean
                If Me.cbIssueTo.Text = "ENTER ENGINE ID" Or Trim(Me.cbIssueTo.Text = "") Then
                    ByPassPOSCheck = True
                End If
                If Not ByPassPOSCheck Then
                    If Not CheckForBeginAuthorityOnPOS() Then
                        ClearSystemVariables()
                        CloseForm()
                        Exit Function
                    End If

                    If Not CheckForEndAuthorityOnPOSPerformed Then
                        If Not CheckForEndAuthorityOnPOS() Then
                            ClearSystemVariables()
                            CloseForm()
                            Exit Function
                        End If
                    End If
                End If
            End If

            'This a check for other warrants issued in the selection and where box 21 is being selected
            'to force a box nine for trains that already have authority in these limits.
            Dim CompToTest As Object
            If gBoxThirteenRequired Then
                For Each CompToTest In ComponentList
                    If CompToTest.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If CompToTest.TrackAuthorities.Count > 0 Then
                            Dim warr As SFAuthority
                            For Each warr In CompToTest.TrackAuthorities
                                'Keep track of the warrants found in the track selection
                                If warr.IssueTo <> Me.cbIssueTo.Text Then
                                    If Not WarrantsFoundForBoxSix.Contains(warr) Then
                                        WarrantsFoundForBoxSix.Add(warr)
                                    End If
                                End If
                            Next
                        End If
                    End If
                Next
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Function

    Private Function CheckForBlockSwitches(ByVal CompList As ArrayList) As Boolean
        Try
            Dim comp As Object
            For Each comp In CompList
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.BlockAbsolute Then
                        If Not sw.ControlledReverse Then
                            If Not IsNothing(gEndTrackSelect.OsComponentCollection) Then
                                If gEndTrackSelect.OsComponentCollection.Contains(sw) Then
                                    ForceBoxThreeDisabled = True
                                    Me.chkItem3.Checked = False
                                    Me.chkItem3.Enabled = False
                                    Me.gbItem3.Visible = False
                                End If
                            End If
                        Else
                            If Not IsNothing(gEndTrackSelect.OsComponentCollection) Then
                                If Not gEndTrackSelect.OsComponentCollection.Contains(sw) Then
                                    Return False
                                Else
                                    ForceBoxThirteen = True
                                End If
                            Else
                                Return False
                            End If
                        End If
                    End If
                End If
            Next
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Private Sub RestorePendingBoxThirteenSwitches()
        Try
            Dim comp As Object
            For Each comp In CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.BoxThirteenControlled Then
                        sw.BoxThirteenControlled = False
                        If sw.ControlledReverse Then
                            sw.ControlSwitch()
                            sw.LeaveReversePermission = False
                            sw.UpdateProtectOpenSwitch(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority)
                            sw.UpdateSwitchPositionInDatabase(TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
                        End If
                    End If
                End If
            Next
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function ResetBoxThirteenSwitches() As Boolean
        Try
            Dim comp As Object
            For Each comp In CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    sw.BoxThirteenControlled = False
                End If
            Next
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

#End Region

#Region "CONFLICT CHECKS"

    Private Sub PerformLockIssueToList()
        Try
            Me.cbIssueTo.Items.Clear()
            Me.cbIssueTo.DropDownStyle = ComboBoxStyle.DropDownList
            LockIssueToList = True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function GetTrainDirection() As String
        Try
            Dim TrainDirection As String
            If gSearchDirection = "LEFT" Then
                If Not IsNothing(thisSubdivision) Then
                    If thisSubdivision.SubDirection Then
                        TrainDirection = "SOUTH"
                    Else
                        TrainDirection = "WEST"
                    End If
                Else
                    TrainDirection = "WEST"
                End If

            Else
                If Not IsNothing(thisSubdivision) Then
                    If thisSubdivision.SubDirection Then
                        TrainDirection = "NORTH"
                    Else
                        TrainDirection = "EAST"
                    End If
                Else
                    TrainDirection = "EAST"
                End If
            End If
            Return TrainDirection
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try

    End Function

    Private Function CheckForAuthorityIssueToOnTrack(ByVal trk As Track, ByVal TrnName As String) As Boolean
        Try
            Dim auth As SFAuthority
            For Each auth In trk.TrackAuthorities
                If auth.IssueTo = TrnName Then
                    Return True
                End If
            Next
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try

    End Function

    Private Function ConflictResolution(ByVal ComponentList As ArrayList, ByRef TypeOfWarrant As String, ByVal SearchDirection As String) As Boolean
        Dim ErrorMessage As String
        Try

            '************DO THE CHECK TO SEE IF A CONFLICT RESOLUTION IS NEEDED
            'Do a check of all the tracks tht are in the selection and see if they have active warrants on them
            Dim comp As Object
            For Each comp In ComponentList
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    If comp.DeviceBlocked Or comp.BlockAbsolute Then
                        ErrorMessage = "Track Warrant Limits Selected Has Device Blocking! - EXITING!"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Return False
                    End If
                ElseIf comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.RCPS Then
                        Me.RCPSwitchesFound = True
                    End If
                End If
            Next

            For Each comp In ComponentList
                If comp.ActiveTrackWarrant Or comp.TrackAuthorities.Count > 0 Then
                    ConflictCheckNeeded = True
                End If
            Next



            gHistoryMessage = "ConflictCheckNeeded = " & ConflictCheckNeeded.ToString
            gHistoryMessage = gHistoryMessage & ". FirstTypeOfWarrant=" & FirstTypeOfWarrant
            SysEvent = New SystemEventRecord(Now, SystemEventRecord.EventEnum.DispatcherEvent, gHistoryMessage, SystemEventQueue)
            SysEvent = Nothing

            Select Case TypeOfWarrant
                Case "ItemTwoToTrain", "ItemFourToTrain", "ItemFourToSameTrain", "ItemTwoToSameTrain", "ItemTwoFiveToTrain", "ItemFourToTrainWithItem8"
                    IssuedToTrain = True
                Case "ItemFourSixToSameMOW"
                    If Not ConflictCheckNeeded Then
                        FirstTypeOfWarrant = "ItemFourToMOW"
                    Else
                        FirstTypeOfWarrant = "ItemFourSixToSameMOW"
                    End If
            End Select
            If Not ConflictCheckNeeded Then Return True
            '************************************************


            Select Case TypeOfWarrant
                Case "ItemTwoToTrain"
                    IssuedToTrain = True
                    Return ConflictCheckItemTwoToTrain(ComponentList, SearchDirection, FirstTypeOfWarrant)
                Case "ItemTwoToMOW"
                    Return ConflictCheckItemTwoToMOW(ComponentList, SearchDirection)
                Case "ItemFourToTrain"
                    IssuedToTrain = True
                    Return ConflictCheckItemFour(ComponentList, SearchDirection)
                Case "ItemFourToTrainWithItem8"
                    IssuedToTrain = True
                    gBox8Required = True
                    Return ConflictCheckItemFour(ComponentList, SearchDirection)
                Case "ItemFourToMOW" ', "ItemFourSixToMOW"
                    Return ConflictCheckItemFour(ComponentList, SearchDirection)
                Case "ItemFourToSameTrain"
                    IssuedToTrain = True
                    Return ConflictCheckItemFourSameTrain(ComponentList, SearchDirection)
                Case "ItemFourToSameMOW"

                    Return ConflictCheckItemFourSameMOW(ComponentList, SearchDirection)
                Case "ItemTwoToSameMOW"
                    Return ConflictCheckItemTwoToSameMOW(ComponentList, SearchDirection)
                Case "ItemTwoToSameTrain"
                    IssuedToTrain = True
                    Return ConflictCheckItemTwoToSameTrain(ComponentList, SearchDirection)
                Case "ItemTwoSixToMOW"
                    Return ConflictCheckItemTwoSixToMOW(ComponentList, SearchDirection)
                Case "ItemFourSixToMOW"
                    Return Me.ConflictCheckItemFourSixToMOW(ComponentList, SearchDirection)
                Case "ItemFourSixToSameMOW"
                    Return Me.ConflictCheckItemFourSixToMOW(ComponentList, SearchDirection, True)
                Case "ItemTwoFiveToTrain"
                    IssuedToTrain = True
                    Return ConflictCheckItemTwoFive(ComponentList, SearchDirection)
                Case "ItemTwoFiveToMOW"
                    Return ConflictCheckItemTwoFive(ComponentList, SearchDirection)

                Case Else
                    Return False
            End Select

        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            ClearSystemVariables()
            Me.CloseForm()
        End Try
    End Function

    Private Function ConflictCheckItemTwoToTrain(ByVal ComponentList As ArrayList, ByVal SearchDirection As String, ByVal WarrantType As String) As Boolean
        Try
            Dim SignalTerritory As Boolean
            Dim comp As Object
            Dim ErrorMessage As String
            Dim warrToCheck As SFAuthority
            Dim FirstTrackInList As Track = gBeginTrackSelect 'ComponentList.Item(0)
            Dim ItemTwoWarrantNumToBeVoided As String = String.Empty
            'Dim JointLimitsFoundInSignalTerritory As Boolean

            If FirstTrackInList.BiDirectionalABS Then SignalTerritory = True
            If FirstTrackInList.SingleABSEast And (SearchDirection = "RIGHT") Then SignalTerritory = True
            If FirstTrackInList.SingleABSWest And (SearchDirection = "LEFT") Then SignalTerritory = True

            Dim SigAndNonSigFound As Boolean
            Dim IssueToList As ArrayList = Nothing
            Dim FirstTrackInNonSignal As Object = Nothing
            For Each comp In ComponentList
                Dim FirstAuthFound As SFAuthority = Nothing

                If SignalTerritory Then
                    If (Not comp.SingleABSEast And Not comp.SingleABSWest And Not comp.BiDirectionalABS) Then
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trkToCheck As Track = CType(comp, Track)
                            Dim authToCheck As SFAuthority
                            If trkToCheck.TrackAuthorities.Count > 0 Then
                                'P1-4072 ITEM 2
                                Dim ConflictCheck As Boolean = True
                                Dim a As SFAuthority
                                For Each a In trkToCheck.TrackAuthorities
                                    If a.AuthType1 = "ItemFourToMOW" And a.CheckBoxItemsStatus(7) Then
                                        ConflictCheck = False
                                    Else
                                        ConflictCheck = True
                                        Exit For
                                    End If
                                Next
                                'P1-4072 ITEM 2
                                If ConflictCheck Then
                                    SigAndNonSigFound = True
                                    If IsNothing(IssueToList) Then
                                        IssueToList = New ArrayList()
                                    End If
                                    If IsNothing(FirstTrackInNonSignal) Then
                                        FirstTrackInNonSignal = comp
                                        For Each authToCheck In trkToCheck.TrackAuthorities
                                            If authToCheck.IssuedToTrain Then
                                                'If authToCheck.AuthType1 = "ItemTwoToTrain" Then
                                                If Not IssueToList.Contains(authToCheck.IssueTo) Then
                                                    IssueToList.Add(authToCheck.IssueTo)
                                                End If
                                                'End If
                                                If gLaunchCreateItemTwoToTrain Then
                                                    If Mid(authToCheck.IssueTo, 1, gTrainMenuMiscSelectedTrainID.IdentifingUnit.Length) <> gTrainMenuMiscSelectedTrainID.IdentifingUnit Then
                                                        ErrorMessage = "Track Warrant Limits Are Not Allowed to Have Both Signaled and Non-Signaled Limits! - EXITING!"
                                                        AuthorityEvent(ErrorMessage)
                                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                                        Return False
                                                    End If
                                                End If
                                            End If
                                        Next
                                    End If
                                End If
                            End If
                        End If
                    End If

                    'ADD THIS IF THERE IS A MOW ITEM TWO ISSUED BEHIND TRAIN IN SIGNAL TWC TERRITORY THEN EXIT SUB
                    If comp.TrackAuthorities.Count > 0 Then

                        For Each warrToCheck In comp.TrackAuthorities
                            If warrToCheck.AuthType1 <> WarrantType And Not warrToCheck.CheckBoxItemsStatus(7) And Not warrToCheck.CheckBoxItemsStatus(5) Then
                                ErrorMessage = "Conflict Not Resolvable! Warrant Types Conflict (ITEM 4). - EXITING!"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                Return False
                            ElseIf warrToCheck.CheckBoxItemsStatus(7) Then
                                'JointLimitsFoundInSignalTerritory = True
                            ElseIf warrToCheck.CheckBoxItemsStatus(5) Then
                                Me.LockIssueToList = True
                                Me.cbIssueTo.Items.Clear()
                                Me.cbIssueTo.DropDownStyle = ComboBoxStyle.DropDownList
                                Dim BoxSix As String
                                For Each BoxSix In warrToCheck.Box6Train
                                    Me.cbIssueTo.Items.Add(BoxSix)
                                Next
                                For Each BoxSix In Me.cbIssueTo.Items
                                    If Not warrToCheck.Box6Train.Contains(BoxSix) Then
                                        Return False
                                    End If
                                Next
                                Me.cbIssueTo.Items.Add(" ")
                            End If
                        Next
                    End If
                    If (comp.SingleABSEast And (SearchDirection <> "RIGHT") And comp.TrackAuthorities.Count > 0) Or (comp.SingleABSWest And (SearchDirection <> "LEFT") And comp.TrackAuthorities.Count > 0) Then
                        ErrorMessage = "Track Warrant Limits Are Not Allowed to Have Both Signaled and Against Current of Traffic Limits! - EXITING!"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Return False
                    ElseIf (comp.SingleABSEast And (SearchDirection = "RIGHT") And comp.TrackAuthorities.Count > 0) Or (comp.SingleABSWest And (SearchDirection = "LEFT") And comp.TrackAuthorities.Count > 0) Then
                        Dim authToCheck As SFAuthority
                        For Each authToCheck In comp.TrackAuthorities
                            Dim OverRideConflictCheck As Boolean = False
                            If SearchDirection <> authToCheck.Direction Then
                                'P1-3769
                                'If (authToCheck.AuthType1 = "ItemFourToMOW") And authToCheck.CheckBoxItemsStatus(7) Then
                                If (authToCheck.AuthType1 = "ItemFourToMOW" Or authToCheck.AuthType1 = "ItemFourToTrain") And authToCheck.CheckBoxItemsStatus(7) Then
                                    OverRideConflictCheck = True
                                End If
                                If Not OverRideConflictCheck Then
                                    ErrorMessage = "Conflict Not Resolvable! Opposing Warrant Found! - EXITING!"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    Return False
                                Else
                                    OverRideConflictCheck = False
                                End If
                            End If
                        Next
                    End If

                Else
                    If (comp.SingleABSEast Or comp.SingleABSWest Or comp.BiDirectionalABS) Then
                        Dim OverrideConflict As Boolean = False
                        Dim auth As SFAuthority
                        If comp.TrackAuthorities.Count = 0 Then
                            OverrideConflict = True
                        ElseIf comp.BiDirectionalABS And comp.TrackAuthorities.Count > 0 Then
                            For Each auth In comp.TrackAuthorities
                                If auth.Direction <> gSearchDirection Then
                                    'P1-4072 Item 1
                                    If auth.AuthType1 = "ItemFourToMOW" And auth.CheckBoxItemsStatus(7) Then
                                        OverrideConflict = True
                                    Else
                                        OverrideConflict = False
                                        Exit For
                                    End If
                                    'P1-4072 Item 1
                                Else
                                    OverrideConflict = True
                                End If
                            Next
                        ElseIf comp.SingleABSWest And comp.TrackAuthorities.Count > 0 And gSearchDirection = "LEFT" Then
                            For Each auth In comp.TrackAuthorities
                                If auth.Direction <> "LEFT" Then
                                    OverrideConflict = False
                                    Exit For
                                Else
                                    OverrideConflict = True
                                End If
                            Next
                        ElseIf comp.SingleABSEast And comp.TrackAuthorities.Count > 0 And gSearchDirection = "RIGHT" Then
                            For Each auth In comp.TrackAuthorities
                                If auth.Direction <> "RIGHT" Then
                                    OverrideConflict = False
                                    Exit For
                                Else
                                    OverrideConflict = True
                                End If
                            Next
                        ElseIf comp.SingleABSEast And comp.TrackAuthorities.Count > 0 And gSearchDirection = "LEFT" Then
                            If IsNothing(FirstAuthFound) Then
                                FirstAuthFound = comp.TrackAuthorities(0)
                            End If
                            Dim authToCheck As SFAuthority
                            For Each authToCheck In comp.TrackAuthorities
                                If FirstAuthFound.AuthorityUID = authToCheck.AuthorityUID Then
                                    OverrideConflict = True
                                ElseIf authToCheck.CheckBoxItemsStatus(5) And authToCheck.Box6Train.Contains(FirstAuthFound.IssueTo) Then
                                    OverrideConflict = True
                                    'P1-3769
                                ElseIf (authToCheck.AuthType1 = "ItemFourToMOW" Or authToCheck.AuthType1 = "ItemFourToTrain") And authToCheck.CheckBoxItemsStatus(7) Then
                                    OverrideConflict = True
                                    'P1-3769
                                Else
                                    OverrideConflict = False
                                    Exit For
                                End If
                            Next
                        ElseIf comp.SingleABSWest And comp.TrackAuthorities.Count > 0 And gSearchDirection = "RIGHT" Then
                            If IsNothing(FirstAuthFound) Then
                                FirstAuthFound = comp.TrackAuthorities(0)
                            End If
                            Dim authToCheck As SFAuthority
                            For Each authToCheck In comp.TrackAuthorities
                                If FirstAuthFound.AuthorityUID = authToCheck.AuthorityUID Then
                                    OverrideConflict = True
                                ElseIf authToCheck.CheckBoxItemsStatus(5) And authToCheck.Box6Train.Contains(FirstAuthFound.IssueTo) Then
                                    OverrideConflict = True
                                    'P1-3769
                                ElseIf (authToCheck.AuthType1 = "ItemFourToMOW" Or authToCheck.AuthType1 = "ItemFourToTrain") And authToCheck.CheckBoxItemsStatus(7) Then
                                    OverrideConflict = True
                                    'P1-3769
                                Else
                                    OverrideConflict = False
                                    Exit For
                                End If
                            Next
                        End If
                        If Not OverrideConflict Then
                            ErrorMessage = "Track Warrant Limits Has an Un-resolvable Conflict in Both Signaled and Non-Signaled Limits! - EXITING!"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            Return False
                        End If
                    End If
                End If

                'If comp.BiDirectionalABS <> SignalTerritory Then
                'ErrorMessage = "Track Warrant Limits Are INCOMPATIBLE! - EXITING!"
                'AuthorityEvent(ErrorMessage)
                'MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                'Return False
                'End If
            Next

            Dim IssueToItem As String
            If SigAndNonSigFound Then
                Me.LockIssueToList = True
                Me.cbIssueTo.Items.Clear()
                Me.cbIssueTo.DropDownStyle = ComboBoxStyle.DropDownList
                Dim TrainDirection As String
                If gSearchDirection = "LEFT" Then
                    If Not IsNothing(thisSubdivision) Then
                        If thisSubdivision.SubDirection Then
                            TrainDirection = "SOUTH"
                        Else
                            TrainDirection = "WEST"
                        End If
                    Else
                        TrainDirection = "WEST"
                    End If

                Else
                    If Not IsNothing(thisSubdivision) Then
                        If thisSubdivision.SubDirection Then
                            TrainDirection = "NORTH"
                        Else
                            TrainDirection = "EAST"
                        End If
                    Else
                        TrainDirection = "EAST"
                    End If
                End If

                For Each IssueToItem In IssueToList
                    IssueToItem = Mid(IssueToItem, 1, 10)
                    Me.cbIssueTo.Items.Add(IssueToItem & " " & TrainDirection)
                Next
            End If

            'Check to see if authority starts in a MOW limit and does not have a break from item 8 limits and then back into MOW limits. 
            'This is not allowed
            If FirstTrackInList.TrackAuthorities.Count > 0 Then
                Dim OverrideConflict As Boolean = True
                Dim MOWFoundOnFirstTrack As Boolean
                Dim AuthToCheckMOW As SFAuthority
                For Each AuthToCheckMOW In FirstTrackInList.TrackAuthorities
                    If Not AuthToCheckMOW.IssuedToTrain Then
                        MOWFoundOnFirstTrack = True
                        Exit For
                    Else
                        If AuthToCheckMOW.CheckBoxItemsStatus(7) Then
                            MOWFoundOnFirstTrack = True
                            Exit For
                        End If
                    End If
                Next

                For Each comp In ComponentList
                    Dim MOWFoundOnOtherTracks As Boolean
                    Dim Item8BreakFoundInSelection As Boolean
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        For Each AuthToCheckMOW In comp.TrackAuthorities
                            If Not AuthToCheckMOW.IssuedToTrain Then
                                MOWFoundOnOtherTracks = True
                            Else
                                If AuthToCheckMOW.CheckBoxItemsStatus(7) And AuthToCheckMOW.AuthType1 = "ItemFourToTrain" Then
                                    MOWFoundOnOtherTracks = True
                                    Exit For
                                End If
                            End If
                        Next
                        If Not MOWFoundOnOtherTracks Then
                            Item8BreakFoundInSelection = True
                        ElseIf MOWFoundOnOtherTracks And Not MOWFoundOnFirstTrack Then
                            OverrideConflict = False
                            Exit For
                        ElseIf Item8BreakFoundInSelection And MOWFoundOnOtherTracks Then
                            OverrideConflict = False
                            Exit For
                        ElseIf MOWFoundOnOtherTracks Then
                            MOWFoundOnOtherTracks = False
                        End If
                    End If
                Next
                If Not OverrideConflict Then
                    ErrorMessage = "Track Warrant Limits Has Box 4 Limits That DO NOT Start On Beginning Limits! - EXITING!"
                    AuthorityEvent(ErrorMessage)
                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return False
                End If

            End If
            'This is not allowed
            'Check to see if authority starts in a MOW limit and does not have a break from item 8 limits and then back into MOW limits. 


            'Check for number of joint authorities allowed on track
            For Each comp In ComponentList
                If Not optAllowInfiniteNumberOfAuthoritiesInABS Then
                    If SignalTerritory And comp.TrackAuthorities.Count >= 4 Then
                        ErrorMessage = "Too Many Track Warrants Issued In ABS. No More Then Four! - EXITING!"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Return False
                    End If
                End If
            Next

            Dim WarrToVoid As SFAuthority = Nothing
            Dim FirstTrainWarrant As SFAuthority = Nothing

            'FIRST CHECK - Make sure the overlap starts within an existing authorities
            '              since these type of track selections are normally continance of another authority
            If (Not FirstTrackInList.BiDirectionalABS And Not FirstTrackInList.SingleABSEast And Not FirstTrackInList.SingleABSWest) Or _
            (FirstTrackInList.SingleABSEast And gSearchDirection <> "RIGHT") Or _
            (FirstTrackInList.SingleABSWest And gSearchDirection <> "LEFT") Then
                If FirstTrackInList.TrackAuthorities.Count = 0 Then
                    Dim OverrideConflictCheck As Boolean = True
                    For Each comp In ComponentList
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If (Not comp.BiDirectionalABS And comp.TrackAuthorities.Count > 0) Or _
                            (comp.SingleABSEast And gSearchDirection = "LEFT" And comp.TrackAuthorities.Count > 0) Or _
                            (comp.SingleABSWest And gSearchDirection = "RIGHT" And comp.TrackAuthorities.Count > 0) Then
                                OverrideConflictCheck = False
                            End If
                        End If
                    Next
                    If Not OverrideConflictCheck Then
                        ErrorMessage = "OverLapping Requests Need To Start In An Existing Warrant! - EXITING!"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Return False
                    End If
                Else
                    Dim WarrToFind As SFAuthority
                    Dim ItemFourTrain As String
                    For Each WarrToFind In FirstTrackInList.TrackAuthorities
                        If WarrToFind.AuthType1 = "ItemTwoToTrain" Then
                            FirstTrainWarrant = WarrToFind
                            Exit For
                        ElseIf WarrToFind.AuthType1 = "ItemFourToTrain" And Not WarrToFind.CheckBoxItemsStatus(7) Then
                            ItemFourTrain = WarrToFind.IssueTo
                            'Dim OverrideConflictCheck As Boolean = True
                            For Each comp In ComponentList
                                If comp.TrackAuthorities.Count > 0 Then
                                    Dim warrToCheckForSameItemFour As SFAuthority
                                    For Each warrToCheckForSameItemFour In comp.TrackAuthorities
                                        If warrToCheckForSameItemFour.AuthType1 = "ItemFourToTrain" Then
                                            If ItemFourTrain <> warrToCheckForSameItemFour.IssueTo Then
                                                ErrorMessage = "OverLapping Request Spans Multiple Item Four Warrants! - EXITING!"
                                                AuthorityEvent(ErrorMessage)
                                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                                ClearSystemVariables()
                                                Return False
                                            End If
                                        End If
                                    Next
                                End If
                            Next
                        End If
                    Next
                    If Not IsNothing(FirstTrainWarrant) Then
                        If WarrantType = FirstTrainWarrant.AuthType1 Then
                            ForceBoxOne = True
                            VoidedWarrant = FirstTrainWarrant
                            WarrToVoid = FirstTrainWarrant
                            If Not IsNothing(WarrToVoid) Then
                                ItemTwoWarrantNumToBeVoided = WarrToVoid.AuthorityUID
                            End If
                        End If
                    End If
                End If
            Else
                If gLaunchCreateItemTwoToTrain Then
                    If IsNothing(gTrainMenuMiscSelectedTrainID) Then
                        Return False
                    End If
                    Dim sfa As SFAuthority
                    For Each sfa In FirstTrackInList.TrackAuthorities
                        If Mid(sfa.IssueTo, 1, gTrainMenuMiscSelectedTrainID.IdentifingUnit.Length) = gTrainMenuMiscSelectedTrainID.IdentifingUnit Then
                            If WarrantType = sfa.AuthType1 Then
                                ForceBoxOne = True
                                WarrToVoid = FirstTrackInList.TrackAuthorities(0)
                                If Not IsNothing(WarrToVoid) Then
                                    ItemTwoWarrantNumToBeVoided = WarrToVoid.AuthorityUID
                                End If
                                Exit For
                            End If
                        End If
                    Next
                End If
            End If

            For Each comp In ComponentList
                If comp.TrackAuthorities.Count > 0 Then 'Do these checks on components that have active warrants

                    'SECOND CHECK - Make sure there is only one active warrant on these tracks
                    '               if they are TWC type tracks and not TWC-ABS type opeartion
                    If comp.AuthorityType = "TWC" And (Not comp.BiDirectionalABS And ((comp.SingleABSEast And gSearchDirection <> "RIGHT") Or (comp.SingleABSWest And gSearchDirection <> "LEFT") Or (Not comp.SingleABSWest And Not comp.SingleABSEast))) Then
                        If comp.TrackAuthorities.Count >= 1 Then
                            'added for item2/9 MOW on same track as itemtwototrain
                            Dim BeginTrackWarrantForTrain As SFAuthority = Nothing
                            Dim WarrToFind As SFAuthority

                            If FirstTrackInList.TrackAuthorities.Count > 0 Then
                                For Each warrtofind In FirstTrackInList.TrackAuthorities
                                    If warrtofind.AuthType1 = "ItemTwoToTrain" Then
                                        BeginTrackWarrantForTrain = WarrToFind
                                        Exit For
                                    End If
                                Next
                                If IsNothing(BeginTrackWarrantForTrain) Then
                                    BeginTrackWarrantForTrain = FirstTrackInList.TrackAuthorities(0)
                                End If
                                If Not comp.TrackAuthorities.Contains(BeginTrackWarrantForTrain) Then
                                    Dim CurrentCompWarrant As SFAuthority = comp.TrackAuthorities.Item(0)
                                    If CurrentCompWarrant.AuthorityUID <> BeginTrackWarrantForTrain.AuthorityUID Then
                                        Dim OverrideConflict As Boolean
                                        If CurrentCompWarrant.AuthType1 = "ItemFourToTrain" And CurrentCompWarrant.CheckBoxItemsStatus(7) Then
                                            OverrideConflict = True
                                        End If
                                        If CurrentCompWarrant.AuthType1 = "ItemFourToMOW" And CurrentCompWarrant.CheckBoxItemsStatus(7) And CurrentCompWarrant.BoxEightRestrictionComponents.Contains(comp) Then
                                            OverrideConflict = True
                                        End If

                                        If CurrentCompWarrant.AuthType1 = "ItemFourToMOW" And CurrentCompWarrant.CheckBoxItemsStatus(5) And CurrentCompWarrant.Box6Train.Contains(BeginTrackWarrantForTrain.IssueTo) Then
                                            OverrideConflict = True
                                        End If

                                        If Not OverrideConflict Then
                                            ErrorMessage = "Conflict Not Resolvable! Warrant Types Conflict. - EXITING!"
                                            AuthorityEvent(ErrorMessage)
                                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            ClearSystemVariables()
                                            Return False
                                        Else
                                            OverrideConflict = False
                                        End If
                                    End If
                                End If
                            Else 'added for item2/9 MOW on same track as itemtwototrain
                                ErrorMessage = "Conflict Not Resolvable! Too Many Warrants . - EXITING!"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                ClearSystemVariables()
                                Return False
                            End If 'added for item2/9 MOW on same track as itemtwototrain

                            Dim TrainWarrantOnFirstTrack As SFAuthority = Nothing
                            For Each warrtofind In FirstTrackInList.TrackAuthorities
                                If warrtofind.AuthType1 = "ItemTwoToTrain" Then
                                    TrainWarrantOnFirstTrack = WarrToFind
                                    Exit For
                                End If
                            Next
                            If IsNothing(TrainWarrantOnFirstTrack) Then
                                TrainWarrantOnFirstTrack = FirstTrackInList.TrackAuthorities.Item(0)
                            End If
                            Dim VoidedWarrUID As String = String.Empty
                            If Not IsNothing(WarrToVoid) Then
                                VoidedWarrUID = WarrToVoid.AuthorityUID
                            End If
                            If Not comp.TrackAuthorities.Contains(TrainWarrantOnFirstTrack) Then
                                Dim OverrideConflict As Boolean
                                If TrainWarrantOnFirstTrack.AuthType1 = "ItemFourToTrain" And TrainWarrantOnFirstTrack.CheckBoxItemsStatus(7) Then
                                    OverrideConflict = True
                                End If
                                If TrainWarrantOnFirstTrack.AuthType1 = "ItemFourToMOW" And TrainWarrantOnFirstTrack.CheckBoxItemsStatus(5) And TrainWarrantOnFirstTrack.Box6Train.Contains(TrainWarrantOnFirstTrack.IssueTo) Then
                                    OverrideConflict = True
                                End If
                                If TrainWarrantOnFirstTrack.AuthType1 = "ItemTwoToTrain" And TrainWarrantOnFirstTrack.CheckBoxItemsStatus(7) And TrainWarrantOnFirstTrack.AuthorityUID = VoidedWarrUID Then
                                    OverrideConflict = True
                                End If

                                If Not OverrideConflict Then
                                    ErrorMessage = "Conflict Not Resolvable! Warrant Mismatch. - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    Return False
                                Else
                                    OverrideConflict = False
                                End If
                            End If
                            TrainWarrantOnFirstTrack = Nothing
                            'Dim TrainWarrantOnFirstTrack As SFAuthority
                            'FirstTrackInList.TrackAuthorities.Item(0)
                            'warr = comp.TrackAuthorities.Item(0)
                            'If WarrantOnFirstTrack.AuthorityUID <> warr.AuthorityUID Then
                            '    ErrorMessage = "Conflict Not Resolvable! Warrant Mismatch. - EXITING"
                            '    AuthorityEvent(ErrorMessage)
                            '    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            '    ClearSystemVariables()
                            '    Return False
                            'End If
                            'WarrantOnFirstTrack = Nothing

                            'THIRD CHECK - Make sure the authority types match for each track
                            For Each warrToCheck In comp.TrackAuthorities
                                If FirstTypeOfWarrant <> warrToCheck.AuthType1 Then
                                    Dim OverrideConflictCheck As Boolean
                                    If warrToCheck.AuthType1 = "ItemFourToMOW" And ForceBoxOne Then
                                        If Not IsNothing(WarrToVoid) Then
                                            If warrToCheck.Box6Train.Contains(WarrToVoid.IssueTo) Then
                                                OverrideConflictCheck = True
                                            ElseIf warrToCheck.CheckBoxItemsStatus(7) And WarrToVoid.CheckBoxItemsStatus(7) Then
                                                OverrideConflictCheck = True
                                            End If
                                        End If
                                    ElseIf warrToCheck.AuthType1 = "ItemFourToMOW" Or warrToCheck.AuthType1 = "ItemFourToTrain" Then
                                        If warrToCheck.CheckBoxItemsStatus(7) Then
                                            OverrideConflictCheck = True
                                        End If
                                    End If
                                    If Not OverrideConflictCheck Then
                                        ErrorMessage = "Conflict Not Resolvable! Conflicting Warrant Types. - EXITING!"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        ClearSystemVariables()
                                        Return False
                                    Else
                                        OverrideConflictCheck = False
                                    End If
                                End If
                            Next

                            'FOURTH CHECK - Make sure new selection is same direction of existing warrant
                            If Not SignalTerritory Then
                                For Each warrToCheck In comp.TrackAuthorities
                                    If SearchDirection <> warrToCheck.Direction Then
                                        If (Not warrToCheck.CheckBoxItemsStatus(7) And Not warrToCheck.IssuedToTrain) Or (warrToCheck.IssuedToTrain And Not warrToCheck.CheckBoxItemsStatus(4)) Then
                                            Dim OverRideConflict As Boolean
                                            If Not IsNothing(VoidedWarrant) Then
                                                If Not warrToCheck.IssuedToTrain And warrToCheck.Box6Train.Contains(VoidedWarrant.IssueTo) Then
                                                    OverRideConflict = True
                                                End If
                                            End If
                                            If warrToCheck.AuthType1 = "ItemFourToTrain" And warrToCheck.CheckBoxItemsStatus(7) Then
                                                OverRideConflict = True
                                            End If
                                            If Not OverRideConflict Then
                                                ErrorMessage = "Conflict Not Resolvable! Opposing Direction and No Joint Limits. - EXITING"
                                                AuthorityEvent(ErrorMessage)
                                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                                ClearSystemVariables()
                                                Return False
                                            Else
                                                OverRideConflict = False
                                            End If
                                        ElseIf (warrToCheck.IssuedToTrain And warrToCheck.CheckBoxItemsStatus(4)) Then
                                            Dim OverRideConflict As Boolean
                                            If comp.TrackAuthorities.Count > 0 Then
                                                VoidedWarrant = comp.TrackAuthorities(0)
                                            End If

                                            If Not IsNothing(VoidedWarrant) Then
                                                ForceBoxOne = True
                                                WarrToVoid = FirstTrackInList.TrackAuthorities(0)
                                                If warrToCheck.Box5Arrival.Contains(VoidedWarrant.IssueTo) Then
                                                    OverRideConflict = True
                                                End If
                                            End If

                                            If Not OverRideConflict Then
                                                ErrorMessage = "Conflict Not Resolvable! Opposing Direction and No Joint Limits. - EXITING"
                                                AuthorityEvent(ErrorMessage)
                                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                                ClearSystemVariables()
                                                Return False
                                            End If
                                        End If
                                    End If
                                    If warrToCheck.CheckBoxItemsStatus(5) And Not warrToCheck.IssuedToTrain And Not warrToCheck.CheckBoxItemsStatus(7) Then
                                        Dim BoxSixTrain As String
                                        Dim OverRideConflictCheck As Boolean = True
                                        For Each BoxSixTrain In warrToCheck.Box6Train
                                            If gSearchDirection = "LEFT" And Not ((InStr(BoxSixTrain, "WEST") <> 0) Or (InStr(BoxSixTrain, "SOUTH") <> 0)) Then
                                                OverRideConflictCheck = False
                                            ElseIf gSearchDirection = "RIGHT" And Not ((InStr(BoxSixTrain, "EAST") <> 0) Or (InStr(BoxSixTrain, "NORTH") <> 0)) Then
                                                OverRideConflictCheck = False
                                            End If
                                        Next
                                        If Not OverRideConflictCheck Then
                                            ErrorMessage = "Conflict Not Resolvable! Opposing Direction. - EXITING"
                                            AuthorityEvent(ErrorMessage)
                                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            ClearSystemVariables()
                                            Return False
                                        End If
                                    End If

                                Next
                            End If
                        End If
                    ElseIf comp.AuthorityType = "TWC" And (comp.BiDirectionalABS Or FirstTrackInList.SingleABSEast Or FirstTrackInList.SingleABSWest) Then
                        If comp.TrackAuthorities.Count > 0 Then
                            'ALLOW WARRANTS FOR TRAINS THAT HAVE ITEM FIVE TRAINS IN THE OPPOSING WARRANT'S AUTHORITY
                            For Each warrToCheck In comp.TrackAuthorities
                                If warrToCheck.Direction <> SearchDirection Then

                                    If (Not warrToCheck.CheckBoxItemsStatus(4) And warrToCheck.IssuedToTrain) And (Not warrToCheck.CheckBoxItemsStatus(7) And Not warrToCheck.BoxEightRestrictionComponents.Contains(comp)) Then
                                        ErrorMessage = "Conflict Not Resolvable! Opposing Warrant Found In Signal " & gTWCVariableName & " Territory. - EXITING"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        ClearSystemVariables()
                                        OpposingAuthoritiesWithBoxFiveToResolve = False
                                        Return False
                                    ElseIf (Not warrToCheck.CheckBoxItemsStatus(7) And Not warrToCheck.IssuedToTrain And Not warrToCheck.CheckBoxItemsStatus(5)) Or (warrToCheck.IssuedToTrain And Not warrToCheck.CheckBoxItemsStatus(4)) Then
                                        Dim OverRideConflict As Boolean
                                        If warrToCheck.IssuedToTrain And warrToCheck.CheckBoxItemsStatus(7) And warrToCheck.AuthType1 = "ItemFourToTrain" Then
                                            OverRideConflict = True
                                        End If
                                        If Not OverRideConflict Then
                                            ErrorMessage = "Conflict Not Resolvable! Opposing Direction. - EXITING"
                                            AuthorityEvent(ErrorMessage)
                                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            ClearSystemVariables()
                                            Return False
                                        Else
                                            OverRideConflict = False
                                        End If
                                    ElseIf (warrToCheck.IssuedToTrain And warrToCheck.CheckBoxItemsStatus(4)) Then
                                        Dim OverRideConflict As Boolean
                                        If warrToCheck.Box5Arrival.Count > 0 Then
                                            Dim BoxFive As String
                                            If gLaunchCreateItemTwoToTrain Then
                                                If Not warrToCheck.Box5Arrival.Contains(GetEngineIDFormatting(gTrainMenuMiscSelectedTrainID)) Then
                                                    ErrorMessage = "Conflict Not Resolvable! Box Five Arrival List Does Not Match For This Train. - EXITING"
                                                    AuthorityEvent(ErrorMessage)
                                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                                    ClearSystemVariables()
                                                    Return False
                                                End If
                                            Else
                                                Me.LockIssueToList = True
                                                Me.cbIssueTo.Items.Clear()
                                                Me.cbIssueTo.DropDownStyle = ComboBoxStyle.DropDownList
                                                For Each BoxFive In warrToCheck.Box5Arrival
                                                    Me.cbIssueTo.Items.Add(BoxFive)
                                                Next
                                            End If
                                            OverRideConflict = True

                                        End If
                                        If Not OverRideConflict Then
                                            ErrorMessage = "Conflict Not Resolvable! Opposing Direction and No Joint Limits. - EXITING"
                                            AuthorityEvent(ErrorMessage)
                                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            ClearSystemVariables()
                                            Return False
                                        End If

                                    ElseIf warrToCheck.CheckBoxItemsStatus(4) And warrToCheck.IssuedToTrain Then
                                        If Not OpposingAuthoritiesWithBoxFive.Contains(warrToCheck) Then
                                            OpposingAuthoritiesWithBoxFive.Add(warrToCheck)
                                        End If
                                        OpposingAuthoritiesWithBoxFiveToResolve = True
                                    ElseIf Not warrToCheck.CheckBoxItemsStatus(7) And Not warrToCheck.IssuedToTrain And warrToCheck.CheckBoxItemsStatus(5) Then
                                        Dim BoxSixTrain As String
                                        Dim OverRideConflictCheck As Boolean = True
                                        For Each BoxSixTrain In warrToCheck.Box6Train
                                            If gSearchDirection = "LEFT" And Not ((InStr(BoxSixTrain, "WEST") <> 0) Or (InStr(BoxSixTrain, "SOUTH") <> 0)) Then
                                                OverRideConflictCheck = False
                                            ElseIf gSearchDirection = "RIGHT" And Not ((InStr(BoxSixTrain, "EAST") <> 0) Or (InStr(BoxSixTrain, "NORTH") <> 0)) Then
                                                OverRideConflictCheck = False
                                            End If
                                        Next
                                        If Not OverRideConflictCheck Then
                                            ErrorMessage = "Conflict Not Resolvable! Opposing Direction. - EXITING"
                                            AuthorityEvent(ErrorMessage)
                                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            ClearSystemVariables()
                                            Return False
                                        End If
                                    End If
                                ElseIf warrToCheck.Direction = SearchDirection Then
                                    If warrToCheck.CheckBoxItemsStatus(5) And Not warrToCheck.IssuedToTrain And Not warrToCheck.CheckBoxItemsStatus(7) Then
                                        Dim BoxSixTrain As String
                                        Dim OverRideConflictCheck As Boolean = True
                                        For Each BoxSixTrain In warrToCheck.Box6Train
                                            If gSearchDirection = "LEFT" And Not ((InStr(BoxSixTrain, "WEST") <> 0) Or (InStr(BoxSixTrain, "SOUTH") <> 0)) Then
                                                OverRideConflictCheck = False
                                            ElseIf gSearchDirection = "RIGHT" And Not ((InStr(BoxSixTrain, "EAST") <> 0) Or (InStr(BoxSixTrain, "NORTH") <> 0)) Then
                                                OverRideConflictCheck = False
                                            End If
                                        Next
                                        If Not OverRideConflictCheck Then
                                            ErrorMessage = "Conflict Not Resolvable! Opposing Direction. - EXITING"
                                            AuthorityEvent(ErrorMessage)
                                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            ClearSystemVariables()
                                            Return False
                                        End If
                                    End If
                                End If
                            Next
                        End If
                    End If
                End If
            Next comp

            If OpposingAuthoritiesWithBoxFiveToResolve Then
                Me.LockIssueToList = True
                Dim BoxFiveList As New ArrayList()
                Dim BoxFiveAuth As SFAuthority
                Dim BoxFiveCount As Integer
                Dim BoxFive As String
                'Check to see if Box Five Authority Arrival List Counts match each authority
                For Each BoxFiveAuth In OpposingAuthoritiesWithBoxFive
                    If BoxFiveCount = 0 Then
                        BoxFiveCount = BoxFiveAuth.Box5Arrival.Count
                    Else
                        If BoxFiveCount <> BoxFiveAuth.Box5Arrival.Count Then
                            ErrorMessage = "Conflict Not Resolvable! Box Five Arrival List Does Not Match. - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            Return False
                        End If
                    End If
                    For Each BoxFive In BoxFiveAuth.Box5Arrival
                        If Not BoxFiveList.Contains(BoxFive) Then
                            BoxFiveList.Add(BoxFive)
                        End If
                    Next

                Next
                'Check to see if Box Five Authority Arrival train match each authority
                For Each BoxFiveAuth In OpposingAuthoritiesWithBoxFive
                    For Each BoxFive In BoxFiveAuth.Box5Arrival
                        If Not BoxFiveList.Contains(BoxFive) Then
                            ErrorMessage = "Conflict Not Resolvable! Box Five Arrival List Does Not Match. - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            Return False
                        End If
                    Next
                Next
                If BoxFiveCount = 1 Then
                    ForceBoxOne = True
                    Me.cbIssueTo.Text = BoxFiveList(0)
                    Me.cbIssueTo.Enabled = False
                    Me.CheckForBoxOneWarrantInSelectedABSLimits()
                Else
                    Me.cbIssueTo.Items.Clear()
                    Me.cbIssueTo.DropDownStyle = ComboBoxStyle.DropDownList
                    For Each BoxFive In BoxFiveList
                        Me.cbIssueTo.Items.Add(BoxFive)
                    Next
                End If
            End If

            If SignalTerritory Then
                If Me.cbIssueTo.DropDownStyle = ComboBoxStyle.DropDownList Then
                    AddIssueToTrainsToList()
                End If
            End If

            If Not SignalTerritory Then
                If Not Me.ConflictCheckJointAuthoritiesForItemTwoSameTrain(ComponentList, ItemTwoWarrantNumToBeVoided, WarrToVoid) Then
                    Return False
                End If
            Else
                If Not Me.ConflictCheckJointAuthoritiesForItemTwoSameTrainInABS(ComponentList, ItemTwoWarrantNumToBeVoided, WarrToVoid) Then
                    Return False
                End If
                Me.SignalLimitsFound = True
            End If

            AuthorityEvent("OVERLAP IS VALIDATED FOR WARRANT TYPE:" & FirstTypeOfWarrant)
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try
    End Function

    Private Sub AddIssueToTrainsToList()
        Try
            Dim TrainList As New ArrayList
            Dim NotValidIssueTo As New ArrayList
            Dim comp As Object
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.TrackAuthorities.Count > 0 Then
                        Dim sfa As SFAuthority
                        For Each sfa In trk.TrackAuthorities
                            If sfa.Direction = gSearchDirection And sfa.IssuedToTrain Then
                                If Not CheckForPendingContingentAuthority(sfa, trk) Then
                                    NotValidIssueTo.Add(sfa.IssueTo)
                                End If

                                If Not TrainList.Contains(sfa.IssueTo) Then
                                    TrainList.Add(sfa.IssueTo)
                                End If
                            End If
                        Next
                    End If
                End If
            Next


            Dim RemoveList As New ArrayList
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.TrackAuthorities.Count > 0 Then
                        Dim trn As String
                        Dim TrnExists As Boolean
                        For Each trn In TrainList
                            Dim sfa As SFAuthority
                            For Each sfa In trk.TrackAuthorities
                                If sfa.Direction = gSearchDirection And sfa.IssuedToTrain Then
                                    If sfa.IssueTo = trn Then
                                        TrnExists = True
                                    End If
                                End If
                            Next
                            If Not TrnExists Then
                                RemoveList.Add(trn)
                            End If
                            TrnExists = False
                        Next
                    End If
                End If
            Next

            Dim r As String
            For Each r In RemoveList
                TrainList.Remove(r)
            Next

            For Each r In NotValidIssueTo
                TrainList.Remove(r)
            Next

            For Each r In TrainList
                If Not cbIssueTo.Items.Contains(r) Then
                    If Me.FirstTypeOfWarrant = "ItemTwoToTrain" Then
                        If r.Length > 10 Then
                            cbIssueTo.Items.Add(r)
                        End If
                    Else
                        cbIssueTo.Items.Add(r)
                    End If
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function CheckForPendingContingentAuthority(ByVal SFAToToCheck As SFAuthority, ByVal trkToCheck As Track) As Boolean
        Try

            If SFAToToCheck.CheckBoxItemsStatus(4) Then
                Dim sfa As SFAuthority
                For Each sfa In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If SFAToToCheck.Box5Arrival.Contains(sfa.IssueTo) And sfa.Components.Contains(trkToCheck) Then
                        Return False
                    End If
                Next
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Private Function ConflictCheckItemTwoToMOW(ByVal ComponentList As ArrayList, ByVal SearchDirection As String) As Boolean
        Try
            Dim comp As Object
            Dim ErrorMessage As String
            Dim warr As Warrant
            Dim FirstTrackInList As Track = ComponentList.Item(0)

            'FIRST CHECK - Make sure the overlap starts within an existing authorities
            '              since these type of track selections are normally continance of another authority
            If FirstTrackInList.TrackAuthorities.Count = 0 Then
                ErrorMessage = "OverLapping Requests Need To Start In An Existing Warrant! - EXITING!"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If

            'Loop through each component in selection and see if they meet the remainder of the checks per component
            For Each comp In ComponentList

                If comp.TrackAuthorities.Count > 0 Then 'Do these checks on components that have active warrants

                    'SECOND CHECK - Make sure there is only one active warrant on these tracks
                    '               if they are TWC type tracks and not TWC-ABS type opeartion
                    If comp.AuthorityType = "TWC" Then
                        If comp.TrackAuthorities.Count > 1 Then

                            'added for item2/9 MOW on same track as itemtwototrain
                            Dim BeginTrackWarrant As Warrant
                            If FirstTrackInList.TrackAuthorities.Count > 0 Then
                                BeginTrackWarrant = FirstTrackInList.TrackAuthorities(0)
                                Dim CurrentCompWarrant As Warrant = comp.TrackAuthorities.Item(0)
                                If CurrentCompWarrant.WarrantNumber <> BeginTrackWarrant.WarrantNumber Then
                                    ErrorMessage = "Conflict Not Resolvable! Warrant Types Conflict. - EXITING!"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    Return False
                                End If
                            Else 'added for item2/9 MOW on same track as itemtwototrain
                                ErrorMessage = "Conflict Not Resolvable! Too Many Warrants . - EXITING!"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                ClearSystemVariables()
                                Return False
                            End If 'added for item2/9 MOW on same track as itemtwototrain
                        End If
                    End If

                    'THIRD CHECK - Make sure the authority types match for each track
                    warr = comp.TrackAuthorities.Item(0)
                    If FirstTypeOfWarrant <> warr.WarrantType Then
                        ErrorMessage = "Conflict Not Resolvable! Conflicting Warrant Types. - EXITING!"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Return False
                    End If

                    'FOURTH CHECK - Make sure new selection is same direction of existing warrant
                    If SearchDirection <> warr.Direction Then
                        ErrorMessage = "Conflict Not Resolvable! Opposing Direction. - EXITING"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Return False
                    End If

                    Dim WarrantOnFirstTrack As Warrant
                    WarrantOnFirstTrack = FirstTrackInList.TrackAuthorities.Item(0)
                    If WarrantOnFirstTrack.WarrantNumber <> warr.WarrantNumber Then
                        ErrorMessage = "Conflict Not Resolvable! Warrant Mismatch. - EXITING"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Return False
                    End If
                    WarrantOnFirstTrack = Nothing
                    warr = Nothing
                End If 'comp.TrackAuthorities.Count
            Next comp

            AuthorityEvent("OVERLAP IS VALIDATED FOR WARRANT TYPE:" & FirstTypeOfWarrant)
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try

    End Function

    Private Function ConflictCheckItemFour(ByVal ComponentList As ArrayList, ByVal SearchDirection As String) As Boolean
        Try
            Dim comp As Object
            Dim ErrorMessage As String
            Dim warr As SFAuthority
            'Dim FirstTrackInList As Track = ComponentList.Item(0)

            'For each component in the selection collection
            For Each comp In ComponentList

                If comp.TrackAuthorities.Count > 0 Then 'Do these checks on components that have active warrants only
                    Dim CurrentBeginningLimit As String = String.Empty
                    If SearchDirection = "RIGHT" Then
                        CurrentBeginningLimit = gBeginTrackSelect.LeftLimitName
                    ElseIf SearchDirection = "LEFT" Then
                        CurrentBeginningLimit = gBeginTrackSelect.RightLimitName
                    End If

                    'FIRST CHECK - Make sure that box 8 is check on each warrant
                    Dim ForceItemTwoVoid As Boolean
                    For Each warr In comp.TrackAuthorities

                        If FirstTypeOfWarrant <> "ItemFourNineToMOW" Then
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If Not warr.CheckBoxItemsStatus(7) Or Not warr.BoxEightRestrictionComponents.Contains(comp) Then
                                    Dim OverRideConflictCheck As Boolean
                                    If gLaunchCreateItemFourToSameTrain Then
                                        If Mid(warr.IssueTo, 1, gTrainMenuMiscSelectedTrainID.IdentifingUnit.Length) = gTrainMenuMiscSelectedTrainID.IdentifingUnit Then
                                            OverRideConflictCheck = True
                                        End If
                                    ElseIf comp.TrackAuthorities.Count = 1 And warr.AuthType1 = "ItemTwoToTrain" And Mid(FirstTypeOfWarrant, 1, 13) <> "ItemFourToMOW" And warr.BoxEightRestrictionComponents.Contains(comp) Then
                                        OverRideConflictCheck = True
                                        If Not warr.CheckBoxItemsStatus(7) Then
                                            ForceItemTwoVoid = True
                                        End If
                                        'BNSF P1-3769 #3
                                    ElseIf comp.TrackAuthorities.Count = 1 And warr.AuthType1 = "ItemTwoToTrain" And Mid(FirstTypeOfWarrant, 1, 13) <> "ItemFourToMOW" Then
                                        If Not warr.CheckBoxItemsStatus(7) And Not ForceItemTwoVoid Then
                                            ForceItemTwoVoid = True
                                            OverRideConflictCheck = True
                                        ElseIf ForceItemTwoVoid Then
                                            If Not IsNothing(VoidedWarrant) Then
                                                If ItemOneAuthorityToBeReplaced.AuthorityUID = warr.AuthorityUID Then
                                                    OverRideConflictCheck = True
                                                End If
                                            End If
                                        End If
                                        'BNSF P1-3769 #3
                                    End If

                                    If Not OverRideConflictCheck Then
                                        ErrorMessage = "Track Warrant Number: " & warr.AuthorityUID & vbCrLf & "DOES NOT HAVE BOX 8 CHECKED FOR THIS TRACK!! - EXITING"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        ClearSystemVariables()
                                        Return False
                                    Else
                                        OverRideConflictCheck = False
                                    End If

                                ElseIf warr.AuthType1 = "ItemTwoToTrain" And (warr.Box8From1 <> CurrentBeginningLimit Or Not warr.Components.Contains(gBeginTrackSelect)) Then
                                    Dim OverRideConflict As Boolean
                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        Dim thisTrk As Track = CType(comp, Track)
                                        'If thisTrk.BiDirectionalABS Or (thisTrk.SingleABSEast And gSearchDirection = "RIGHT") Or (thisTrk.SingleABSWest And gSearchDirection = "LEFT") Then
                                        If (thisTrk.BiDirectionalABS Or (thisTrk.SingleABSEast And gSearchDirection = "RIGHT") Or (thisTrk.SingleABSWest And gSearchDirection = "LEFT")) And Mid(FirstTypeOfWarrant, 1, 8) <> "ItemFour" Then
                                            OverRideConflict = True
                                        Else
                                            Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(warr.Components)
                                            If Not IsNothing(FirstTrack) Then
                                                Dim NewBeginningOfTrack As String = String.Empty
                                                If SearchDirection = "RIGHT" Then
                                                    NewBeginningOfTrack = FirstTrack.LeftLimitName
                                                ElseIf SearchDirection = "LEFT" Then
                                                    NewBeginningOfTrack = FirstTrack.RightLimitName
                                                End If
                                                If warr.AuthType1 = "ItemTwoToTrain" And NewBeginningOfTrack = CurrentBeginningLimit Then
                                                    OverRideConflict = True
                                                End If
                                            End If
                                        End If
                                    End If
                                    If Not OverRideConflict Then
                                        ErrorMessage = "ITEM 4 AUTHORITY DOES NOT START AT THE BEGINNING OF THE ITEM 2 AUTHORITY LIMIT!! - EXITING"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        ClearSystemVariables()
                                        Return False
                                    Else
                                        OverRideConflict = False
                                    End If
                                End If

                                If gLaunchCreateItemFourToSameTrain Then
                                    If Mid(warr.IssueTo, 1, gTrainMenuMiscSelectedTrainID.IdentifingUnit.Length) = gTrainMenuMiscSelectedTrainID.IdentifingUnit Then
                                        If IsNothing(VoidedWarrant) Then
                                            VoidedWarrant = warr
                                            ItemOneAuthorityToBeReplaced = warr
                                        End If
                                    End If
                                ElseIf ForceItemTwoVoid Then
                                    If IsNothing(VoidedWarrant) Then
                                        VoidedWarrant = warr
                                        ItemOneAuthorityToBeReplaced = warr
                                    End If
                                End If

                            End If
                        End If
                    Next

                    'SECOND CHECK - Make sure that there are no more then four warrants on each track
                    If comp.TrackAuthorities.Count > 6 Then
                        ErrorMessage = "Too Many Joint Authorities. Authority Form Only Allows Six Joint Authorities. - EXITING"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Return False
                    End If

                End If
                warr = Nothing
            Next comp

            AuthorityEvent("OVERLAP IS VALIDATED FOR WARRANT TYPE:" & FirstTypeOfWarrant)

            'Do these additional checks if this is a Item 4 with a box nine checked over a single item 2 issued to a train
            '**********************************************************************************************
            '************* Conflict resolution for item 4/9 to MOW over an existing Item 2 to Train********
            '**********************************************************************************************

            If FirstTypeOfWarrant = "ItemFourSixToMOW" Or FirstTypeOfWarrant = "ItemFourSixToSameMOW" Then
                'Assign the first Item 2 track warrant found as the one that will be protected with the item 9
                Dim FirstInstanceOfWarrant As Boolean
                Dim FirstItemTwoWarrantNumberFound As String = String.Empty
                For Each comp In ComponentList
                    If comp.TrackAuthorities.Count > 0 Then
                        warr = comp.TrackAuthorities(0)
                        If warr.AuthType1 = "ItemTwoToTrain" Or warr.AuthType1 = "ItemTwoToMOW" Then
                            FirstItemTwoWarrantNumberFound = warr.AuthorityUID
                            FirstWarrantFound = warr
                            Exit For
                        End If
                    End If
                Next comp
                warr = Nothing

                'Make sure the item4/9 is in the same direction of item 2 FirstWarrantFound
                If FirstWarrantFound.Direction <> gSearchDirection Then
                    ErrorMessage = "Conflict Not Resolvable!This Warrant Was Selected in the Opposite Direction Of Existing Warrant. - EXITING"
                    AuthorityEvent(ErrorMessage)
                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    ClearSystemVariables()
                    Return False
                End If

                'Go through each component and inspect it's waarants for conflicts
                For Each comp In ComponentList

                    'See if this warrant matches the first instance of the item 2 being protected
                    If Not FirstInstanceOfWarrant Then
                        If comp.TrackAuthorities.Count > 0 Then
                            warr = comp.TrackAuthorities(0)
                            If FirstWarrantFound.AuthorityUID = warr.AuthorityUID Then
                                FirstInstanceOfWarrant = True
                            End If
                        End If
                    End If

                    'if first instance of the item 2 being protected has been found in track selection AND
                    'we come upon a track that no longer has the instance of warrant assign to it's zero index, THEN
                    'exit the sub because the selection extends beyond the first instance of the item 2 being protected
                    If FirstInstanceOfWarrant Then
                        If comp.TrackAuthorities.Count > 0 Then
                            warr = comp.TrackAuthorities(0)
                            If warr.AuthorityUID <> FirstItemTwoWarrantNumberFound Then
                                ErrorMessage = "Conflict Not Resolvable! This Warrant Cannot Extend Beyond the Existing Item 2 Warrant being Protected.- EXITING"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                ClearSystemVariables()
                                Return False
                            End If
                        ElseIf comp.TrackAuthorities.Count = 0 Then
                            Dim CompOK As Boolean
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim trk As Track = CType(comp, Track)
                                If trk.NonTransverable Then
                                    CompOK = True
                                End If

                            End If
                            If Not CompOK Then
                                ErrorMessage = "Conflict Not Resolvable! This Warrant Cannot Extend Beyond the Existing Item 2 Warrant being Protected.- EXITING"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                ClearSystemVariables()
                                Return False
                            Else
                                CompOK = False
                            End If
                        End If

                    End If

                    If Not FirstInstanceOfWarrant Then
                        If comp.TrackAuthorities.Count > 0 Then
                            Dim WarrToCheck As SFAuthority
                            For Each WarrToCheck In comp.TrackAuthorities
                                'check for Item 11 checked
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If Not WarrToCheck.CheckBoxItemsStatus(7) Then
                                        ErrorMessage = "Conflict Not Resolvable! Item 11 Not Selected on Warrant:" & WarrToCheck.AuthorityUID & ". - EXITING"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        ClearSystemVariables()
                                        Return False
                                    End If
                                End If
                                'Check to make sure not an item 2 type of warrant
                                If WarrToCheck.AuthType1 = "ItemTwoToTrain" Or WarrToCheck.AuthType1 = "ItemTwoToMOW" Then
                                    ErrorMessage = "Conflict Not Resolvable! Two Many Warrants Found in The Selelction To Resolve. - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    Return False
                                End If
                            Next

                        End If
                    Else ' the first instance of an item 2 has been found then do these checks
                        If comp.TrackAuthorities.Count > 0 Then
                            Dim WarrToCheck As SFAuthority
                            For Each WarrToCheck In comp.TrackAuthorities
                                If WarrToCheck.AuthorityUID <> FirstItemTwoWarrantNumberFound Then
                                    'check for Item 11 checked
                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        If Not WarrToCheck.CheckBoxItemsStatus(7) Then
                                            ErrorMessage = "Conflict Not Resolvable! Item 8 Not Selected on Warrant:" & WarrToCheck.AuthorityUID & ". - EXITING"
                                            AuthorityEvent(ErrorMessage)
                                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            ClearSystemVariables()
                                            Return False
                                        End If
                                    End If
                                    'Check to make sure not an item 2 type of warrant
                                    If WarrToCheck.AuthType1 = "ItemTwoToTrain" Or WarrToCheck.AuthType1 = "ItemTwoToMOW" Then
                                        ErrorMessage = "Conflict Not Resolvable! Two Many Warrants Found in The Selelction To Resolve. - EXITING"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        ClearSystemVariables()
                                        Return False
                                    End If
                                End If
                            Next
                        End If
                    End If 'Not FirstInstanceOfWarrant 
                Next
            End If

            '/////////////////////////////////////////////////////////////////////////////
            '********************************************************************************
            'Begin to build the Joint Authority Array for BOX 9 Joint Authorities,
            'by finding all the different warrant numbers
            '********************************************************************************
            'Dim DuplicateWarrantNumber As Boolean = False
            'Dim DebugAuthMessage As String
            Dim DoJointToTrain As Boolean
            'For each component in the selection collection
            For Each comp In ComponentList

                If comp.TrackAuthorities.Count > 0 Then
                    For Each warr In comp.TrackAuthorities
                        'If (warr.AuthType1 = "ItemTwoToTrain" Or warr.AuthType1 = "ItemTwoToMOW") Then
                        '    'DO NOTHING
                        'ElseIf (FirstTypeOfWarrant = "ItemFourToTrain" And warr.AuthType1 = "ItemFourToTrain") Then
                        If (FirstTypeOfWarrant = "ItemFourToTrain" And warr.AuthType1 = "ItemFourToTrain") Then
                            If optJointTrainToTrain Then

                                If gLaunchCreateItemFourToSameTrain Then
                                    If Mid(warr.IssueTo, 1, gTrainMenuMiscSelectedTrainID.IdentifingUnit.Length) <> gTrainMenuMiscSelectedTrainID.IdentifingUnit Then
                                        DoJointToTrain = True
                                    End If
                                Else
                                    DoJointToTrain = True
                                End If
                                If DoJointToTrain Then
                                    DoJointToTrain = False
                                    JointAuthRequired = True
                                    gJointAuthRequired = True
                                    gBox8Required = True

                                    Dim ja As New JointAuthorityType()
                                    Dim AuthorityFound As Boolean
                                    For Each ja In Me.JointAuthoritiesFound
                                        If ja.AuthUID = warr.AuthorityUID Then
                                            AuthorityFound = True
                                        End If
                                    Next
                                    If Not AuthorityFound Then
                                        Dim jaNew As New JointAuthorityType()
                                        jaNew.AuthUID = warr.AuthorityUID
                                        Me.JointAuthoritiesFound.Add(jaNew)
                                    Else
                                        AuthorityFound = False
                                    End If
                                End If
                            End If

                        Else
                            DoJointToTrain = True
                            If gLaunchCreateItemFourToSameTrain Then
                                If Mid(warr.IssueTo, 1, gTrainMenuMiscSelectedTrainID.IdentifingUnit.Length) = gTrainMenuMiscSelectedTrainID.IdentifingUnit Then
                                    DoJointToTrain = False
                                End If
                            Else
                                If Not IsNothing(VoidedWarrant) Then
                                    If warr.IssueTo = VoidedWarrant.IssueTo Then
                                        DoJointToTrain = False
                                    End If
                                End If
                            End If

                            If DoJointToTrain Then

                                JointAuthRequired = True
                                gJointAuthRequired = True
                                gBox8Required = True

                                Dim ja As JointAuthorityType
                                Dim AuthorityFound As Boolean
                                For Each ja In Me.JointAuthoritiesFound
                                    If ja.AuthUID = warr.AuthorityUID Then
                                        AuthorityFound = True
                                    End If
                                Next
                                If Not AuthorityFound Then
                                    Dim jaNew As New JointAuthorityType()
                                    jaNew.AuthUID = warr.AuthorityUID
                                    Me.JointAuthoritiesFound.Add(jaNew)
                                Else
                                    AuthorityFound = False
                                End If
                                DoJointToTrain = False
                            End If
                        End If
                    Next
                End If

            Next 'component
            comp = Nothing

            'check to make sure there is no more then four joint overlapping authorities existing IN THIS SELECTION
            If JointAuthoritiesFound.Count > 6 Then
                ErrorMessage = "Too Many Joint Authorities. Authority Form Only Allows Six Joint Authorities. - EXITING"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If



            '*************************************************************************************
            'Now add the overlapping limits for each authority that this authority laps over.
            '*************************************************************************************
            Dim jat As JointAuthorityType
            For Each jat In Me.JointAuthoritiesFound
                For Each comp In ComponentList
                    If comp.TrackAuthorities.Count > 0 Then
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            For Each warr In comp.TrackAuthorities
                                If jat.AuthUID = warr.AuthorityUID Then
                                    If gSearchDirection = "RIGHT" Then
                                        If jat.LeftLimits = "" Then
                                            jat.LeftLimits = comp.LeftLimitName
                                        End If
                                        jat.RightLimits = comp.RightLimitName
                                    Else
                                        If jat.RightLimits = "" Then
                                            jat.RightLimits = comp.RightLimitName
                                        End If
                                        jat.LeftLimits = comp.LeftLimitName
                                    End If
                                    jat.IssueToName = warr.IssueTo
                                End If
                            Next warr
                        End If
                    End If
                Next comp
            Next

            'For Each jat In Me.JointAuthoritiesFound
            '    DebugAuthMessage = DebugAuthMessage & jat.IssueToName & ","
            '    DebugAuthMessage = DebugAuthMessage & jat.AuthUID & ","
            '    DebugAuthMessage = DebugAuthMessage & jat.LeftLimits & ","
            '    DebugAuthMessage = DebugAuthMessage & jat.RightLimits & vbCrLf
            'Next
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try

    End Function

    Private Function ConflictCheckItemFourSameTrain(ByVal ComponentList As ArrayList, ByVal SearchDirection As String) As Boolean
        Try
            Dim comp As Object
            Dim ErrorMessage As String
            Dim warr As SFAuthority
            Dim ItemFourWarrantNumToBeVoided As String = String.Empty


            '**************************************************************************************************************
            ''** Added to allow the dispatcher to give an item 4 to a train with item 2.
            ''** The item 2 gets voided and item 4 gets a item 11 check box
            Dim CurrentBeginningLimit As String = String.Empty
            If SearchDirection = "RIGHT" Then
                CurrentBeginningLimit = gBeginTrackSelect.LeftLimitName
            ElseIf SearchDirection = "LEFT" Then
                CurrentBeginningLimit = gBeginTrackSelect.RightLimitName
            End If


            For Each comp In ComponentList
                If comp.TrackAuthorities.Count = 1 Then
                    Dim WarrantToCheck As SFAuthority
                    WarrantToCheck = comp.TrackAuthorities(0)
                    If (WarrantToCheck.AuthType1 = "ItemFourToMOW") Or (WarrantToCheck.AuthType1 = "ItemTwoToMOW") Then
                        ErrorMessage = "INCOMPATIBLE WARRANT FOUND FOR THIS SELECTION! - EXITING"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        WarrantToCheck = Nothing
                        Return False
                    End If
                    WarrantToCheck = Nothing
                End If
            Next

            'Loop through each component selected and find the first warrant in the selection to assign
            'the track warrant number that will be voided with box one
            If IsNothing(VoidedWarrant) Then
                For Each comp In ComponentList
                    'If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    If comp.TrackAuthorities.Count = 1 Then
                        VoidedWarrant = comp.TrackAuthorities(0)
                        ItemFourWarrantNumToBeVoided = VoidedWarrant.AuthorityUID
                        Exit For
                    End If
                    'End If
                Next
            Else
                ItemFourWarrantNumToBeVoided = VoidedWarrant.AuthorityUID
            End If
            If VoidedWarrant Is Nothing Then
                'If warr Is Nothing Then
                ErrorMessage = "NO ITEM 4 WARRANT FOUND IN SELECTION FOR THIS TYPE OF SELECTION! - EXITING"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If

            'For each trach track in the flash array do the nested checkeds within this loop
            For Each comp In ComponentList
                'SECOND CHECK - Make sure there are NO more then one warrant active on the component
                If comp.TrackAuthorities.Count <= 1 Then
                    If comp.TrackAuthorities.Count > 0 Then
                        'THIRD CHECK - Make sure the first component's warrant matches all component's warrant number in each component.
                        warr = comp.TrackAuthorities(0)
                        If ItemFourWarrantNumToBeVoided <> warr.AuthorityUID Then
                            Dim OverrideConflict As Boolean
                            If warr.IssuedToTrain And warr.CheckBoxItemsStatus(7) Then
                                If warr.AuthType1 = "ItemTwoToTrain" And warr.Box8From1 <> CurrentBeginningLimit Then
                                    '                                    Dim OverRideConflict As Boolean
                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        Dim thisTrk As Track = CType(comp, Track)
                                        If thisTrk.BiDirectionalABS Then
                                            OverrideConflict = True
                                        End If
                                    End If
                                    If Not OverrideConflict Then
                                        ErrorMessage = "ITEM 4 AUTHORITY DOES NOT START AT THE BEGINNING OF THE ITEM 2 AUTHORITY LIMIT!! - EXITING"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        ClearSystemVariables()
                                        Return False
                                    Else
                                        OverrideConflict = False
                                    End If
                                ElseIf warr.AuthType1 = "ItemFourToTrain" And warr.BoxEightRestrictionComponents.Contains(comp) And warr.CheckBoxItemsStatus(7) Then
                                    OverrideConflict = True
                                End If
                            Else
                                OverrideConflict = False
                            End If
                            If Not OverrideConflict Then
                                ErrorMessage = "Conflict Not Resolvable! Different Authority Number Found in Track Selection. - EXITING"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                ClearSystemVariables()
                                VoidedWarrant = Nothing
                                Return False
                            End If
                        End If
                    End If

                Else
                    ErrorMessage = "Conflict Not Resolvable! To Many Different Authorities in Track Selection For This Type Of Warrant. - EXITING"
                    AuthorityEvent(ErrorMessage)
                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    ClearSystemVariables()
                    VoidedWarrant = Nothing
                    Return False
                End If

            Next comp
            AuthorityEvent("OVERLAP IS VALIDATED FOR WARRANT TYPE:" & FirstTypeOfWarrant)
            '/////////////////////////////////////////////////////////////////////////////
            '********************************************************************************
            'Begin to build the Joint Authority Array for BOX 9 Joint Authorities,
            'by finding all the different warrant numbers
            '********************************************************************************
            'Dim DuplicateWarrantNumber As Boolean = False
            'Dim DebugAuthMessage As String
            Dim DoJointToTrain As Boolean
            'For each component in the selection collection
            For Each comp In ComponentList

                If comp.TrackAuthorities.Count > 0 Then
                    For Each warr In comp.TrackAuthorities
                        'If (warr.AuthType1 = "ItemTwoToTrain" Or warr.AuthType1 = "ItemTwoToMOW") Then
                        '    'DO NOTHING
                        'ElseIf (FirstTypeOfWarrant = "ItemFourToTrain" And warr.AuthType1 = "ItemFourToTrain") Then
                        If (FirstTypeOfWarrant = "ItemFourToTrain" And warr.AuthType1 = "ItemFourToTrain") Then
                            If optJointTrainToTrain Then

                                If gLaunchCreateItemFourToSameTrain Then
                                    If Mid(warr.IssueTo, 1, gTrainMenuMiscSelectedTrainID.IdentifingUnit.Length) <> gTrainMenuMiscSelectedTrainID.IdentifingUnit Then
                                        DoJointToTrain = True
                                    End If
                                Else
                                    DoJointToTrain = True
                                End If
                                If DoJointToTrain Then
                                    DoJointToTrain = False
                                    JointAuthRequired = True
                                    gJointAuthRequired = True
                                    gBox8Required = True

                                    Dim ja As New JointAuthorityType()
                                    Dim AuthorityFound As Boolean
                                    For Each ja In Me.JointAuthoritiesFound
                                        If ja.AuthUID = warr.AuthorityUID Then
                                            AuthorityFound = True
                                        End If
                                    Next
                                    If Not AuthorityFound Then
                                        Dim jaNew As New JointAuthorityType()
                                        jaNew.AuthUID = warr.AuthorityUID
                                        Me.JointAuthoritiesFound.Add(jaNew)
                                    Else
                                        AuthorityFound = False
                                    End If
                                End If
                            End If

                        Else
                            DoJointToTrain = True
                            If gLaunchCreateItemFourToSameTrain Then
                                If Mid(warr.IssueTo, 1, gTrainMenuMiscSelectedTrainID.IdentifingUnit.Length) = gTrainMenuMiscSelectedTrainID.IdentifingUnit Then
                                    DoJointToTrain = False
                                End If
                            Else
                                If Not IsNothing(VoidedWarrant) Then
                                    If warr.IssueTo = VoidedWarrant.IssueTo Then
                                        DoJointToTrain = False
                                    End If
                                End If
                            End If

                            If DoJointToTrain Then
                                JointAuthRequired = True
                                gJointAuthRequired = True
                                gBox8Required = True

                                Dim ja As JointAuthorityType
                                Dim AuthorityFound As Boolean
                                For Each ja In Me.JointAuthoritiesFound
                                    If ja.AuthUID = warr.AuthorityUID Then
                                        AuthorityFound = True
                                    End If
                                Next
                                If Not AuthorityFound Then
                                    Dim jaNew As New JointAuthorityType()
                                    jaNew.AuthUID = warr.AuthorityUID
                                    Me.JointAuthoritiesFound.Add(jaNew)
                                Else
                                    AuthorityFound = False
                                End If
                                DoJointToTrain = False
                            End If
                        End If
                    Next
                End If

            Next 'component
            comp = Nothing

            'check to make sure there is no more then four joint overlapping authorities existing IN THIS SELECTION
            If JointAuthoritiesFound.Count > 3 Then
                ErrorMessage = "Too Many Joint Authorities. Authority Form Only Allows Three Joint Authorities. - EXITING"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If



            '*************************************************************************************
            'Now add the overlapping limits for each authority that this authority laps over.
            '*************************************************************************************
            Dim jat As JointAuthorityType
            For Each jat In Me.JointAuthoritiesFound
                For Each comp In ComponentList
                    If comp.TrackAuthorities.Count > 0 Then
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            For Each warr In comp.TrackAuthorities
                                If jat.AuthUID = warr.AuthorityUID Then
                                    If gSearchDirection = "RIGHT" Then
                                        If jat.LeftLimits = "" Then
                                            jat.LeftLimits = comp.LeftLimitName
                                        End If
                                        jat.RightLimits = comp.RightLimitName
                                    Else
                                        If jat.RightLimits = "" Then
                                            jat.RightLimits = comp.RightLimitName
                                        End If
                                        jat.LeftLimits = comp.LeftLimitName
                                    End If
                                    jat.IssueToName = warr.IssueTo
                                End If
                            Next warr
                        End If
                    End If
                Next comp
            Next

            'For Each jat In Me.JointAuthoritiesFound
            '    DebugAuthMessage = DebugAuthMessage & jat.IssueToName & ","
            '    DebugAuthMessage = DebugAuthMessage & jat.AuthUID & ","
            '    DebugAuthMessage = DebugAuthMessage & jat.LeftLimits & ","
            '    DebugAuthMessage = DebugAuthMessage & jat.RightLimits & vbCrLf
            'Next
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try
    End Function

    Private Function ConflictCheckItemFourSameMOW(ByVal ComponentList As ArrayList, ByVal SearchDirection As String) As Boolean

        Try
            Dim comp As Object
            Dim ErrorMessage As String
            Dim warr As SFAuthority
            Dim ItemFourWarrantNumToBeVoided As String = String.Empty

            For Each comp In ComponentList
                If comp.TrackAuthorities.Count = 1 Then
                    Dim WarrantToCheck As SFAuthority
                    WarrantToCheck = comp.TrackAuthorities(0)
                    If (WarrantToCheck.AuthType1 = "ItemFourToTrain") Or (WarrantToCheck.AuthType1 = "ItemTwoToTrain") Then
                        ErrorMessage = "INCOMPATIBLE WARRANT FOUND FOR THIS SELECTION! - EXITING"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        WarrantToCheck = Nothing
                        Return False
                    End If
                    WarrantToCheck = Nothing
                End If
            Next

            'Loop through each component selected and find the first warrant in the selection to assign
            'the track warrant number that will be voided with box one
            For Each comp In ComponentList
                'If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                If comp.TrackAuthorities.Count = 1 Then
                    VoidedWarrant = comp.TrackAuthorities(0)
                    ItemFourWarrantNumToBeVoided = VoidedWarrant.AuthorityUID
                    Exit For
                End If
                'End If
            Next
            If VoidedWarrant Is Nothing Then
                'If warr Is Nothing Then
                ErrorMessage = "NO ITEM 4 WARRANT FOUND IN SELECTION FOR THIS TYPE OF SELECTION! - EXITING"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If

            'For each trach track in the flash array do the nested checkeds within this loop
            For Each comp In ComponentList
                'SECOND CHECK - Make sure there are NO more then one warrant active on the component
                If comp.TrackAuthorities.Count <= 1 Then
                    If comp.TrackAuthorities.Count > 0 Then
                        'THIRD CHECK - Make sure the first component's warrant matches all component's warrant number in each component.
                        warr = comp.TrackAuthorities(0)
                        If ItemFourWarrantNumToBeVoided <> warr.AuthorityUID Then
                            Dim OverrideConflict As Boolean
                            If Not IsNothing(VoidedWarrant) Then
                                If VoidedWarrant.IssueTo = warr.IssueTo Then
                                    OverrideConflict = True
                                End If
                            End If
                            If Not OverrideConflict Then
                                ErrorMessage = "Conflict Not Resolvable! Different Authority Number Found in Track Selection. - EXITING"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                ClearSystemVariables()
                                VoidedWarrant = Nothing
                                Return False
                            Else
                                OverrideConflict = False
                            End If
                        End If
                    End If

                Else
                    ErrorMessage = "Conflict Not Resolvable! To Many Different Authorities in Track Selection For This Type Of Warrant. - EXITING"
                    AuthorityEvent(ErrorMessage)
                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    ClearSystemVariables()
                    VoidedWarrant = Nothing
                    Return False
                End If

            Next comp
            AuthorityEvent("OVERLAP IS VALIDATED FOR WARRANT TYPE:" & FirstTypeOfWarrant)
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try

    End Function

    Private Function ConflictCheckItemTwoToSameMOW(ByVal ComponentList As ArrayList, ByVal SearchDirection As String) As Boolean

        ''** added to allow the dispatcher to give an item 2 to a train with item 4.
        ''** The item 4 gets voided. The item two is of course sole authority on each track
        Try
            Dim comp As Object
            Dim ErrorMessage As String
            Dim warr As Warrant
            Dim FirstTrackInList As Track = ComponentList.Item(0)
            Dim ItemTwoWarrantNumToBeVoided As Integer

            For Each comp In ComponentList
                If comp.TrackAuthorities.Count = 1 Then
                    Dim WarrantToCheck As Warrant
                    WarrantToCheck = comp.TrackAuthorities(0)
                    If (WarrantToCheck.WarrantType = "ItemFourToTrain") Or (WarrantToCheck.WarrantType = "ItemTwoToTrain") Then
                        ErrorMessage = "INCOMPATIBLE WARRANT FOUND FOR THIS SELECTION! - EXITING"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        WarrantToCheck = Nothing
                        Return False
                    End If
                    WarrantToCheck = Nothing
                End If
            Next


            'FIRST CHECK - Make sure the overlap starts within an existing authorities
            '              since these type of track selections are normally continance of another authority
            If FirstTrackInList.TrackAuthorities.Count = 0 Then
                ErrorMessage = "OverLapping Requests Need To Start In An Existing Item 2 Warrant! - EXITING"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If

            'Assign the track warrant number that will be replaced
            warr = FirstTrackInList.TrackAuthorities(0)
            ItemTwoWarrantNumToBeVoided = warr.WarrantNumber

            'For each trach track in the flash array do the nested checkeds within this loop
            Dim warrToCheck As SFAuthority = Nothing
            Dim FirstTrainWarrant As SFAuthority = Nothing
            Dim FirstTrainWarrantFound As Boolean
            Dim FirstMowWarrantFound As Boolean
            For Each comp In ComponentList
                'SECOND CHECK - Make sure there are NO more then one warrant active on the component
                If comp.TrackAuthorities.Count <= 1 Then
                    If comp.TrackAuthorities.Count > 0 Then
                        'THIRD CHECK - Make sure the first component's warrant matches all component's warrant number in each component.
                        warr = comp.TrackAuthorities(0)
                        If ItemTwoWarrantNumToBeVoided <> warr.WarrantNumber Then
                            ErrorMessage = "Conflict Not Resolvable! Different Authority Number Found in Track Selection. - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            Return False
                        End If
                    End If

                Else
                    'Check to see if there is a situation to allow to issue a MOW warrant to same person when there is a train (BOX2) in the limits
                    For Each warrToCheck In comp.TrackAuthorities
                        If warrToCheck.AuthType1 = "ItemTwoToTrain" Then
                            If Not FirstTrainWarrantFound Then
                                FirstTrainWarrantFound = True
                                WarrantsFoundForBoxSix.Add(warrToCheck)
                                FirstTrainWarrant = warrToCheck
                                Me.ForceBoxSix = True
                                gItemSixRequired = True
                            Else
                                If FirstTrainWarrant.AuthorityUID <> warrToCheck.AuthorityUID Then
                                    ErrorMessage = "Conflict Not Resolvable! To Many Different Authorities in Track Selection For This Type Of Warrant. - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    Return False
                                End If
                            End If
                        ElseIf warrToCheck.AuthType1 = "ItemTwoToMOW" Then
                            If Not FirstMowWarrantFound Then
                                FirstMowWarrantFound = True
                                Me.VoidedWarrant = warrToCheck
                                Me.ForceBoxOne = True
                                gBoxOneRequired = True
                            Else
                                If Me.VoidedWarrant.AuthorityUID <> warrToCheck.AuthorityUID Then
                                    ErrorMessage = "Conflict Not Resolvable! To Many Different Authorities in Track Selection For This Type Of Warrant. - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    Return False
                                End If
                            End If
                        Else
                            ErrorMessage = "Conflict Not Resolvable! To Many Different Authorities in Track Selection For This Type Of Warrant. - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            Return False
                        End If
                    Next
                    'ErrorMessage = "Conflict Not Resolvable! To Many Different Authorities in Track Selection For This Type Of Warrant. - EXITING"
                    'AuthorityEvent(ErrorMessage)
                    'MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    'ClearSystemVariables()
                    'Return False
                End If

            Next comp

            If Me.ForceBoxSix Then
                Dim WarrToAddToBoxsix As Warrant
                For Each WarrToAddToBoxsix In WarrantsFoundForBoxSix
                    If WarrToAddToBoxsix.WarrantType = "ItemTwoToTrain" Then
                        If Not Me.BoxSixComponents.Contains(WarrToAddToBoxsix.IssueTo) Then
                            Me.BoxSixComponents.Add(WarrToAddToBoxsix.IssueTo)
                        End If
                    End If
                Next

                'Go back through the track selection componentlist and check to make sure that
                'the selection does not extend beyond any other train's authority
                Dim MinuminWarrantCount As Integer
                For Each comp In ComponentList
                    Dim WarrantCheckValid As Boolean
                    If comp.TrackAuthorities.Count > 0 Then

                        'Have a high-water mark for authority counts. 
                        'This helps to ensure this warrant does not extend beyond existing authorities
                        If comp.TrackAuthorities.Count >= MinuminWarrantCount Then
                            MinuminWarrantCount = comp.TrackAuthorities.Count
                        Else
                            'Check to see if existing warrant has Box ten check to allow this one to extend beyond
                            Dim WarrToCheckBoxTen As Warrant
                            For Each WarrToCheckBoxTen In comp.TrackAuthorities
                                If Not WarrToCheckBoxTen.CheckBox(10) Then
                                    ErrorMessage = "Conflict Not Resolvable! This Warrant CANNOT Extend Beyond Existing Warrants (NO BOX TEN). - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    WarrantsFoundForBoxSix.Clear()
                                    Return False
                                End If
                            Next
                        End If

                        Dim WarrantToCheck, WarrantToCrossCheck As Warrant
                        For Each WarrantToCheck In comp.TrackAuthorities
                            WarrantCheckValid = False
                            For Each WarrantToCrossCheck In WarrantsFoundForBoxSix
                                If WarrantToCheck.WarrantNumber = WarrantToCrossCheck.WarrantNumber _
                                Or ItemTwoWarrantNumToBeVoided = WarrantToCheck.WarrantNumber Then
                                    WarrantCheckValid = True
                                End If
                            Next

                            If Not WarrantCheckValid Then
                                ErrorMessage = "Conflict Not Resolvable! This Warrant CANNOT Extend Beyond Existing Warrants. - EXITING"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                ClearSystemVariables()
                                WarrantsFoundForBoxSix.Clear()
                                Return False
                            Else
                                WarrantCheckValid = False
                            End If
                        Next
                    Else

                        'Have a high-water mark for authority counts. 
                        'This helps to ensure this warrant does not extend beyond existing authorities
                        If comp.TrackAuthorities.Count >= MinuminWarrantCount Then
                            MinuminWarrantCount = comp.TrackAuthorities.Count
                        Else
                            'Check to see if existing warrant has Box ten check to allow this one to extend beyond
                            Dim WarrToCheckBoxTen As Warrant
                            For Each WarrToCheckBoxTen In WarrantsFoundForBoxSix
                                If Not WarrToCheckBoxTen.CheckBox(10) Then
                                    ErrorMessage = "Conflict Not Resolvable! This Warrant CANNOT Extend Beyond Existing Warrants (NO BOX TEN). - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    WarrantsFoundForBoxSix.Clear()
                                    Return False
                                End If
                            Next
                        End If


                    End If
                Next
            End If

            AuthorityEvent("OVERLAP IS VALIDATED FOR WARRANT TYPE:" & FirstTypeOfWarrant)
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try

    End Function

    Private Function ConflictCheckItemTwoToSameTrain(ByVal ComponentList As ArrayList, ByVal SearchDirection As String) As Boolean

        Try
            Dim comp As Object
            Dim ErrorMessage As String
            Dim warr As SFAuthority
            Dim FirstTrackInList As Track = ComponentList.Item(0)
            Dim ItemTwoWarrantNumToBeVoided As String
            'P1-4114 #1
            If FirstTrackInList.AuthorityType = "TWC" Then
                If FirstTrackInList.TrackAuthorities.Count > 1 Then
                    Dim auth As SFAuthority
                    For Each auth In FirstTrackInList.TrackAuthorities
                        If auth.AuthType1 = "ItemTwoToTrain" Then
                            VoidedWarrant = auth
                            Exit For
                        ElseIf auth.AuthType1 = "ItemFourToTrain" Then
                            If IsNothing(VoidedWarrant) Then
                                VoidedWarrant = auth
                            End If
                        End If
                    Next
                End If
            End If
            'P1-4114 #1

            For Each comp In ComponentList
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    If comp.TrackAuthorities.Count = 1 Then
                        Dim WarrantToCheck As SFAuthority
                        WarrantToCheck = comp.TrackAuthorities(0)
                        Dim OverrideConflict As Boolean

                        If (WarrantToCheck.AuthType1 = "ItemFourToMOW" Or WarrantToCheck.AuthType1 = "ItemFourToTrain") And WarrantToCheck.CheckBoxItemsStatus(7) And WarrantToCheck.BoxEightRestrictionComponents.Contains(comp) Then
                            OverrideConflict = True
                        ElseIf WarrantToCheck.AuthType1 = "ItemFourToMOW" And WarrantToCheck.CheckBoxItemsStatus(5) Then
                            If Not IsNothing(VoidedWarrant) Then
                                If WarrantToCheck.Box6Train.Contains(VoidedWarrant.IssueTo) Then
                                    OverrideConflict = True
                                End If
                            End If
                        ElseIf WarrantToCheck.AuthType1 = "ItemFourToTrain" Then
                            If FirstTrackInList.TrackAuthorities.Count = 1 Then
                                Dim warrToVerify As SFAuthority = FirstTrackInList.TrackAuthorities.Item(0)
                                If warrToVerify.AuthorityUID = WarrantToCheck.AuthorityUID Then
                                    If IsNothing(VoidedWarrant) Then
                                        VoidedWarrant = warrToVerify
                                        OverrideConflict = True
                                    Else
                                        If VoidedWarrant.AuthorityUID = WarrantToCheck.AuthorityUID Then
                                            OverrideConflict = True
                                        End If
                                    End If

                                End If
                            End If
                        ElseIf Not IsNothing(VoidedWarrant) Then
                            If VoidedWarrant.AuthorityUID = WarrantToCheck.AuthorityUID Then
                                OverrideConflict = True
                            End If
                        End If
                        If Not OverrideConflict Then
                            ErrorMessage = "INCOMPATIBLE WARRANT FOUND FOR THIS SELECTION! - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            WarrantToCheck = Nothing
                            Return False
                        Else
                            OverrideConflict = False
                        End If
                        WarrantToCheck = Nothing
                        'P1-4114 #1
                    ElseIf comp.TrackAuthorities.Count > 1 Then
                        Dim OverrideConflict As Boolean
                        If Not IsNothing(VoidedWarrant) Then
                            Dim auth As SFAuthority
                            For Each auth In comp.TrackAuthorities
                                If auth.AuthorityUID = VoidedWarrant.AuthorityUID And VoidedWarrant.Direction = gSearchDirection Then
                                    OverrideConflict = True
                                ElseIf auth.CheckBoxItemsStatus(7) And auth.AuthorityUID <> VoidedWarrant.AuthorityUID Then
                                    OverrideConflict = True
                                ElseIf (auth.AuthType1 = "ItemFourToMOW" And auth.CheckBoxItemsStatus(5)) Then
                                    If Not IsNothing(VoidedWarrant) Then
                                        If auth.Box6Train.Contains(VoidedWarrant.IssueTo) Then
                                            OverrideConflict = True
                                        End If
                                    End If
                                Else
                                    OverrideConflict = False
                                    Exit For
                                End If
                            Next
                        End If

                        If Not OverrideConflict Then
                            ErrorMessage = "INCOMPATIBLE WARRANT FOUND FOR THIS SELECTION! - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            Return False
                        Else
                            OverrideConflict = False
                        End If
                        'P1-4114 #1
                    End If
                End If
            Next
            'FIRST CHECK - Make sure the overlap starts within an existing authorities
            '              since these type of track selections are normally continance of another authority
            If FirstTrackInList.TrackAuthorities.Count = 0 And IsNothing(VoidedWarrant) Then
                ErrorMessage = "OverLapping Requests Need To Start In An Existing Item 2 Warrant! - EXITING"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If

            'Assign the track warrant number that will be replaced
            If IsNothing(VoidedWarrant) Then
                For Each warr In FirstTrackInList.TrackAuthorities

                    If warr.AuthType1 = "ItemTwoToTrain" Then
                        VoidedWarrant = warr
                    ElseIf warr.AuthType1 = "ItemFourToTrain" Then
                        If IsNothing(VoidedWarrant) Then
                            VoidedWarrant = warr
                        End If
                    End If
                Next
                If IsNothing(VoidedWarrant) Then
                    ErrorMessage = "Conflict Not Resolvable! To Many Different Authorities in Track Selection For This Type Of Warrant. - EXITING"
                    AuthorityEvent(ErrorMessage)
                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    ClearSystemVariables()
                    Return False
                End If
                ItemTwoWarrantNumToBeVoided = VoidedWarrant.AuthorityUID
            Else
                ItemTwoWarrantNumToBeVoided = VoidedWarrant.AuthorityUID
            End If


            For Each comp In ComponentList
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    If comp.TrackAuthorities.Count = 1 Then
                        Dim WarrantToCheck As SFAuthority
                        WarrantToCheck = comp.TrackAuthorities(0)
                        Dim OverrideConflict As Boolean

                        If (WarrantToCheck.AuthType1 = "ItemFourToMOW" Or WarrantToCheck.AuthType1 = "ItemFourToTrain") And WarrantToCheck.CheckBoxItemsStatus(7) And WarrantToCheck.BoxEightRestrictionComponents.Contains(comp) Then
                            OverrideConflict = True
                        End If
                        If WarrantToCheck.AuthorityUID = ItemTwoWarrantNumToBeVoided Then
                            OverrideConflict = True
                        End If

                        If WarrantToCheck.AuthType1 = "ItemFourToMOW" And WarrantToCheck.CheckBoxItemsStatus(5) Then
                            If Not IsNothing(VoidedWarrant) Then
                                If WarrantToCheck.Box6Train.Contains(VoidedWarrant.IssueTo) Then
                                    OverrideConflict = True
                                End If
                            End If
                        End If

                        If Not OverrideConflict Then
                            ErrorMessage = "INCOMPATIBLE WARRANT FOUND FOR THIS SELECTION! - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            WarrantToCheck = Nothing
                            Return False
                        Else
                            OverrideConflict = False
                        End If
                        WarrantToCheck = Nothing
                    End If
                End If
            Next


            'For each  track in the flash array do the nested checkeds within this loop
            For Each comp In ComponentList
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    'SECOND CHECK - Make sure there are NO more then one warrant active on the component
                    If comp.TrackAuthorities.Count <= 1 Then
                        If comp.TrackAuthorities.Count > 0 Then
                            'THIRD CHECK - Make sure the first component's warrant matches all component's warrant number in each component.
                            warr = comp.TrackAuthorities(0)
                            If ItemTwoWarrantNumToBeVoided <> warr.AuthorityUID Then
                                Dim OverrideCheck As Boolean
                                If warr.AuthType1 = "ItemFourToTrain" And warr.CheckBoxItemsStatus(7) Then
                                    OverrideCheck = True
                                End If
                                If (warr.AuthType1 = "ItemFourToMOW") And warr.CheckBoxItemsStatus(7) And warr.BoxEightRestrictionComponents.Contains(comp) Then
                                    OverrideCheck = True
                                End If
                                If warr.AuthType1 = "ItemFourToMOW" And warr.CheckBoxItemsStatus(5) Then
                                    If Not IsNothing(VoidedWarrant) Then
                                        If warr.Box6Train.Contains(VoidedWarrant.IssueTo) Then
                                            OverrideCheck = True
                                        End If
                                    End If
                                End If

                                If Not OverrideCheck Then
                                    ErrorMessage = "Conflict Not Resolvable! Different Authority Number Found in Track Selection. - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    Return False
                                Else
                                    OverrideCheck = False
                                End If

                            End If
                        End If

                    Else
                        If comp.TrackAuthorities.Count > 0 Then
                            For Each warr In comp.TrackAuthorities
                                If ItemTwoWarrantNumToBeVoided <> warr.AuthorityUID Then
                                    Dim OverrideConflict As Boolean
                                    If warr.AuthType1 = "ItemFourToTrain" And warr.CheckBoxItemsStatus(7) Then
                                        OverrideConflict = True
                                    ElseIf warr.AuthType1 = "ItemFourToMOW" And warr.CheckBoxItemsStatus(7) Then
                                        OverrideConflict = True
                                    End If
                                    If (warr.AuthType1 = "ItemFourToMOW") And warr.CheckBoxItemsStatus(5) Then
                                        If Not IsNothing(VoidedWarrant) Then
                                            If warr.Box6Train.Contains(VoidedWarrant.IssueTo) Then
                                                OverrideConflict = True
                                            End If
                                        End If
                                    End If

                                    If Not OverrideConflict Then
                                        ErrorMessage = "Conflict Not Resolvable! To Many Different Authorities in Track Selection For This Type Of Warrant. - EXITING"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        ClearSystemVariables()
                                        Return False
                                    Else
                                        OverrideConflict = False
                                    End If
                                End If
                            Next
                        End If
                    End If
                End If
            Next

            If (Not FirstTrackInList.BiDirectionalABS And Not FirstTrackInList.SingleABSEast And Not FirstTrackInList.SingleABSWest) Or _
                (FirstTrackInList.SingleABSEast And gSearchDirection <> "RIGHT") Or _
                (FirstTrackInList.SingleABSWest And gSearchDirection <> "LEFT") Then
                If FirstTrackInList.TrackAuthorities.Count > 0 Then
                    Dim OverrideConflictCheck As Boolean = True
                    For Each comp In ComponentList
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If (Not trk.BiDirectionalABS And trk.TrackAuthorities.Count > 0) Or _
                            (trk.SingleABSEast And gSearchDirection = "LEFT" And trk.TrackAuthorities.Count > 0) Or _
                            (trk.SingleABSWest And gSearchDirection = "RIGHT" And trk.TrackAuthorities.Count > 0) Then
                                Dim auth As SFAuthority
                                For Each auth In trk.TrackAuthorities
                                    If Not FirstTrackInList.TrackAuthorities.Contains(auth) Then
                                        If Mid(VoidedWarrant.IssueTo, 1, 10) = Mid(auth.IssueTo, 1, 10) Then
                                            OverrideConflictCheck = True
                                        Else
                                            OverrideConflictCheck = False
                                        End If

                                    End If
                                Next
                            End If
                        End If
                    Next
                    If Not OverrideConflictCheck Then
                        ErrorMessage = "OverLapping Requests Need To Start In An Existing Warrant! - EXITING!"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Return False
                    End If
                End If
            End If

            'Check to see if authority starts in a MOW limit and does not have a break from item 8 limits and then back into MOW limits. 
            'This is not allowed
            If FirstTrackInList.TrackAuthorities.Count > 0 Then
                Dim OverrideConflict As Boolean = True
                Dim MOWFoundOnFirstTrack As Boolean
                Dim AuthToCheckMOW As SFAuthority
                For Each AuthToCheckMOW In FirstTrackInList.TrackAuthorities
                    If Not AuthToCheckMOW.IssuedToTrain Then
                        MOWFoundOnFirstTrack = True
                        Exit For
                    End If
                Next

                For Each comp In Me.CompleteCompSelection 'ComponentList
                    Dim MOWFoundOnOtherTracks As Boolean
                    Dim Item8BreakFoundInSelection As Boolean
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        For Each AuthToCheckMOW In comp.TrackAuthorities
                            If Not AuthToCheckMOW.IssuedToTrain Then
                                MOWFoundOnOtherTracks = True
                            End If
                        Next
                        If Not MOWFoundOnOtherTracks Then
                            Item8BreakFoundInSelection = True
                        ElseIf MOWFoundOnOtherTracks And Not MOWFoundOnFirstTrack Then
                            OverrideConflict = False
                            Exit For
                        ElseIf Item8BreakFoundInSelection And MOWFoundOnOtherTracks Then
                            OverrideConflict = False
                            Exit For
                        ElseIf MOWFoundOnOtherTracks Then
                            MOWFoundOnOtherTracks = False
                        End If
                    End If
                Next
                If Not OverrideConflict Then
                    ErrorMessage = "Track Warrant Limits Has Box 4 Limits That DO NOT Start On Beginning Limits! - EXITING!"
                    AuthorityEvent(ErrorMessage)
                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return False
                End If

            End If
            'This is not allowed
            'Check to see if authority starts in a MOW limit and does not have a break from item 8 limits and then back into MOW limits. 

            If Not Me.ConflictCheckJointAuthoritiesForItemTwoSameTrain(ComponentList, ItemTwoWarrantNumToBeVoided, VoidedWarrant) Then
                Return False
            End If

            AuthorityEvent("OVERLAP IS VALIDATED FOR WARRANT TYPE:" & FirstTypeOfWarrant)
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try

    End Function

