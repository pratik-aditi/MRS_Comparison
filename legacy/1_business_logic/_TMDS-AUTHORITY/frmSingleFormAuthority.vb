    Private Function PerformJobBriefingConfirmation(ByVal auth As SFAuthority, Optional ByVal OverridePTCGPSCheck As Boolean = False) As Boolean
        Try
            Dim Satified As Boolean

            Dim AuthUID As String
            For Each AuthUID In Me.AuthorityConfirmedList
                If AuthUID = auth.AuthorityUID Then
                    Return True
                End If
            Next

            If MobileClientAuthorityRequest Then
                If Not Me.AuthorityConfirmedList.Contains(auth.AuthorityUID) Then
                    Me.AuthorityConfirmedList.Add(auth.AuthorityUID)
                End If
                Return True
            End If

            Dim TrackSelected As Track = Me.FirstTrackSelection(0)
            Dim LeftLaunchPoint As Integer
            If Not IsNothing(TrackSelected) Then
                LeftLaunchPoint = TMDS.SystemForms.MySystemForms.frmMainMDI.Left + TrackSelected.CurrentDrawingForm.Width / 3
            Else
                LeftLaunchPoint = 300
            End If
            Dim LaunchPoint As New Point(LeftLaunchPoint, 150)

            'Do Until Satified

            Dim frmMessageBox As frmMessageBox
            Dim MessageList As New ArrayList()
            MessageList.Add("WITHIN NON-ABS AND DT ABS TERRITORY FOR TRAINS - ALL " & gTWCVariableName & " TERRITORY FOR MW'UNDERLINE'")
            MessageList.Add("")
            'MessageList.Add("DISPATCHER MUST JOB BRIEF WITH EMPLOYEE REPORTING CLEAR / RELEASING")
            'MessageList.Add("AUTHORITY INCLUDING ALL OF THE FOLLOWING INFORMATION:")
            MessageList.Add("DISPATCHER MUST JOB BRIEF WITH EMPLOYEE RELEASING AUTHORITY")
            MessageList.Add("INCLUDING ALL OF THE FOLLOWING INFORMATION:")

            MessageList.Add("")
            MessageList.Add("POSITION OF SWITCHES OPERATED AND/OR TRAVERSED WITHIN THE LIMITS BEING RELEASED")
            MessageList.Add("ALL SWITCHES OPERATED ARE LOCKED (or NO SWITCHES OPERATED/HANDLED),")
            MessageList.Add("POSITION OF SWITCH FORM COMPLETED (or NO ENTRIES REQUIRED).")
            MessageList.Add("")
            MessageList.Add("IF CORRECT, DISPATCHER MUST REPEAT THE BRIEFING INFORMATION PROVIDED AND INQUIRE ('IS THAT CORRECT?') ")
            MessageList.Add("")
            MessageList.Add("SELECT YES TO CONFIRM REQUIRED BRIEFING HAS OCCURRED.")

            'Dispatcher must job brief with employee reporting clear / releasing
            'authority including all of the following information:

            'Position of switches operated and/or traversed within the limits being released
            'All switches operated are locked (or none were operated)
            'Position of Switch Form completed (or no entries required)

            'If correct, Dispatcher must repeat the briefing information provided and inquire("is that correct?")


            frmMessageBox = New frmMessageBox()
            frmMessageBox.Owner = Me


            If (optEnablePTCBOSAPIMode And auth.PTCTypeAuthority) And (auth.IssuedToTrain) Then

                Dim trnPTC As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIssueToAuthority(auth.IssueTo)
                If optEnableCheckTrnPTCStatusBeforeRollup Then
                    Try
                        'TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(System.Windows.Forms.Cursors.WaitCursor)
                        Me.Cursor = Cursors.WaitCursor
                        Application.DoEvents()
                        Me.btnCancel.Enabled = False
                        frmMessageBox.PTCTrainStatus = auth.CheckTrainPTCStatus(trnPTC)
                        If Not OverridePTCGPSCheck Then
                            If Not auth.CheckToVerifyPositionOnRollUp(True, auth.Components, Me.CompleteCompSelection) Then
                                ClearSelection()
                                Me.CloseForm()
                                Return False
                            End If
                        End If
                    Catch ex As Exception
                    Finally
                        Me.btnCancel.Enabled = True
                        Me.Cursor = Cursors.Default
                        'TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(System.Windows.Forms.Cursors.Default)
                    End Try
                Else
                    TrainIsActivePTC = True
                End If


                If Not IsNothing(trnPTC) Then
                    If trnPTC.PTCStatus <> "ACTIVE" Then
                        TrainIsActivePTC = False
                        SystemEvent("BOX1 AUTHORITY:" & auth.AuthorityUID & ". TRAIN:" & trnPTC.IdentifingUnit & " IS NOT PTC ACTIVE.")
                    Else
                        TrainIsActivePTC = True
                    End If
                Else
                    TrainIsActivePTC = False
                End If
                If TrainIsActivePTC Then
                    frmMessageBox.theSFAuth = auth
                    frmMessageBox.theTrain = trnPTC
                    frmMessageBox.CheckPTCTrainStatus = True
                    frmMessageBox.PTCVoidedAuthStatus = True
                End If
            End If


            frmMessageBox.SetMessage(MessageList, "JOB BRIEFING CONFIRMATION - AUTHORITY RELEASE (" & auth.AuthorityUID & ")", True, LaunchPoint)
            frmMessageBox.ShowDialog()
            If frmMessageBox.FormFeedBack = 6 Then
                gBoxOneRequired = True
                Me.AuthorityEvent(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES ACKNOWLEDGING THE JOB BRIEFING CONFIRMATION")
                TrainIsActivePTC = frmMessageBox.PTCTrainStatus
                Satified = True
                Me.cbIssueTo.Enabled = False
            End If
            frmMessageBox.Dispose()
            frmMessageBox = Nothing

            '    If Not Satified Then
            '        MessageList = New ArrayList()
            '        MessageList.Clear()
            '        MessageList.Add("THE TRACK WARRANT RELEASE/ISSUE/ROLL-UP CANNOT BE")
            '        MessageList.Add("COMPLETED UNTIL SWITCH POSITION JOB BRIEFING OCCURS.")
            '        MessageList.Add("DO YOU WANT TO EXIT?")
            '        MessageList.Add("")
            '        frmMessageBox = New frmMessageBox()
            '        frmMessageBox.Owner = Me
            '        frmMessageBox.SetMessage(MessageList, "JOB BRIEFING CONFIRMATION - AUTHORITY RELEASE (" & auth.AuthorityUID & ")", True, LaunchPoint)
            '        frmMessageBox.ShowDialog()
            '        If frmMessageBox.FormFeedBack = 6 Then
            '            Me.AuthorityEvent(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO EXIT THE JOB BRIEFING CONFIRMATION")
            '            Return False
            '        Else
            '            Me.AuthorityEvent(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED NO TO EXIT THE JOB BRIEFING CONFIRMATION")
            '        End If
            '        frmMessageBox.Dispose()
            '        frmMessageBox = Nothing
            '    End If
            'Loop

            If Satified Then
                If Not Me.AuthorityConfirmedList.Contains(auth.AuthorityUID) Then
                    Me.AuthorityConfirmedList.Add(auth.AuthorityUID)
                End If
                Return True
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Function

    Private Function FindAuthority(ByVal AuthUID As String) As SFAuthority
        Try
            Dim auth As Object
            For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                    'Dim sfa As SFAuthority = CType(auth, SFAuthority)
                    If auth.AuthorityUID = AuthUID Then
                        Return auth
                    End If
                End If
            Next
            Return Nothing
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

    Private Function FindAuthorityFromIssueTo(ByVal theTrack As Track, ByVal IssueToName As String) As SFAuthority
        Try
            Dim auth As Object
            If theTrack.TrackAuthorities.Count > 0 Then
                For Each auth In theTrack.TrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        'Dim sfa As SFAuthority = CType(auth, SFAuthority)
                        If Mid(auth.IssueTo, 1, IssueToName.Length) = IssueToName Then
                            Return auth
                        End If
                    End If
                Next
            End If
            Return Nothing
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

    Public Sub CheckItem_CheckChange(ByVal sender As Object, ByVal e As EventArgs) Handles chkItem1.CheckedChanged, chkItem2.CheckedChanged, chkItem3.CheckedChanged, chkItem4.CheckedChanged, chkItem5.CheckedChanged, chkItem6.CheckedChanged, chkItem7.CheckedChanged, chkItem8.CheckedChanged, chkItem9.CheckedChanged, chkItem10.CheckedChanged, chkItem11.CheckedChanged, chkItem12.CheckedChanged, chkItem13.CheckedChanged, chkItem14.CheckedChanged

        Dim thisCheckBox As CheckBox = CType(sender, CheckBox)
        Try

            If thisCheckBox.Checked Then
                SystemEvent("CHANGE EVENT RECORDED FOR AUTHORITY NUMBER:" & AuthorityNumberString & ". CHECK BOX WAS CHANGED TO CHECKED:" & thisCheckBox.Name)
            Else
                SystemEvent("CHANGE EVENT RECORDED FOR AUTHORITY NUMBER:" & AuthorityNumberString & ". CHECK BOX WAS CHANGED TO UNCHECKED:" & thisCheckBox.Name)
            End If
            If Not gRepeatMode Then

                Select Case thisCheckBox.Name
                    Case "chkItem1"

                        If gBoxOneRequired Then
                            thisCheckBox.CheckState = CheckState.Checked
