    Public Function CheckForSwitchPositionOnRCPS() As Boolean
        Try
            Dim comp As Object
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.RCPS Then
                        Dim SwitchInCorespondence As Boolean
                        If Not sw.FailState Then
                            If sw.ControlledReverse And sw.SwitchIndStatus = SwitchComponents.Switch.SwIndStatus.ReverseInd Then
                                SwitchInCorespondence = True
                            ElseIf Not sw.ControlledReverse And sw.SwitchIndStatus = SwitchComponents.Switch.SwIndStatus.NormalInd Then
                                SwitchInCorespondence = True
                            Else
                                SwitchInCorespondence = False
                            End If
                        Else
                            SwitchInCorespondence = False
                        End If

                        If Not SwitchInCorespondence Then
                            If IsNothing(sw.OsComponentCollection) Then Exit Function
                            If Not sw.OsComponentCollection.Contains(gBeginTrackSelect) Then
                                Return False
                            Else
                                TMDS.GlobalDeclarations.gBox14Required = True
                                BoxFourteenVerbiageRCPS = "YOU ARE INSTRUCTED TO HAND OPERATE THE DUAL CONTROL SWITCH AT "
                                BoxFourteenVerbiageRCPS = BoxFourteenVerbiageRCPS & sw.Name & " FOR YOUR ROUTE"
                                SystemEvent("FORCED BOX FOURTEEN FOR RCPS - " & BoxFourteenVerbiageRCPS)
                                Me.Item14Forced = True
                                Me.OutOfCorrespondenceProtection = True
                                Me.ReInitCheckBoxesAndForm()
                            End If
                        End If
                    End If
                End If
            Next
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Public Function CheckForSwitchLockOnAllRCPS() As Boolean
        Try
            Dim comp As Object
            Dim SwitchUnlockSituationFound As Boolean

            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.RCPS Then
                        If Not sw.CheckForLockingRCPS Then
                            If Not SwitchUnlockSituationFound Then
                                If IsNothing(sw.OsComponentCollection) Then Exit Function
                                If Not sw.OsComponentCollection.Contains(gBeginTrackSelect) Then
                                    Return False
                                Else
                                    SwitchUnlockSituationFound = True
                                    TMDS.GlobalDeclarations.gBox14Required = True
                                    BoxFourteenVerbiageRCPS = "YOU ARE INSTRUCTED TO HAND OPERATE THE DUAL CONTROL SWITCH AT "
                                    BoxFourteenVerbiageRCPS = BoxFourteenVerbiageRCPS & sw.Name & " FOR YOUR ROUTE"
                                    SystemEvent("FORCED BOX FOURTEEN FOR RCPS - " & BoxFourteenVerbiageRCPS)
                                    Me.Item14Forced = True
                                    Me.OutOfCorrespondenceProtection = True
                                    Me.ReInitCheckBoxesAndForm()
                                End If
                            Else
                                Return False
                            End If
                        End If
                    End If
                End If
            Next
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Public Sub LockRCPS()
        Try
            Dim LockRight As Boolean
            Dim LockLeft As Boolean
            Dim LockRestricting As Boolean
            Dim LockNoRestricting As Boolean
            Select Case TMDS.GlobalDeclarations.gWarrantType
                Case "ItemTwoToTrain"
                    Select Case TMDS.GlobalDeclarations.gSearchDirection
                        Case "RIGHT"
                            LockRight = True
                        Case "LEFT"
                            LockLeft = True
                        Case Else
                            LockRight = True
                    End Select
                Case "ItemFourToTrain"
                    If gBox8Required Then
                        LockRestricting = True
                    Else
                        LockNoRestricting = True
                    End If

            End Select

            Dim comp As Object
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.RCPS Then
                        RCPSwitchesFound = True
                        If LockRight Then
                            sw.LockControlRightDirection.BitState = True
                        ElseIf LockLeft Then
                            sw.LockControlLeftDirection.BitState = True
                        ElseIf LockNoRestricting Then
                            sw.LockControlBiDirectionNoRestriction.BitState = True
                        ElseIf LockRestricting Then
                            sw.LockControlBiDirectionRestricting.BitState = True
                        End If
                        sw.myControlPoint.SendCodeStationControlSpecial(True, True)
                    End If
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
            ClearSystemVariables()
            Me.CloseForm()
        End Try
    End Sub

    Public Sub UnLockRCPS()
        Try
            Dim comp As Object
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.RCPS Then
                        sw.CheckToRemoveRCPSControls()
                    End If
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Public Function CheckSwitchPositionRCPS() As ArrayList
        Try
            Dim comp As Object
            Dim SwList As ArrayList = Nothing
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.RCPS Then
                        Dim OutOfCorespond As Boolean
                        If sw.ControlledReverse And sw.SwitchIndStatus <> SwitchComponents.Switch.SwIndStatus.ReverseInd Then
                            OutOfCorespond = True
                        ElseIf sw.SwitchIndStatus <> SwitchComponents.Switch.SwIndStatus.NormalInd Then
                            OutOfCorespond = True
                        End If

                        If OutOfCorespond Then
                            If IsNothing(SwList) Then
                                SwList = New ArrayList()
                            End If
                            SwList.Add(sw.Name)
                        End If

                    End If
                End If
            Next
            Return SwList
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

    Public Sub CheckToAddRCPSSwitchPositionVerbiage()
        Try
            Dim comp As Object
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.RCPS Then
                        Dim SwitchInCorespondence As Boolean = False
                        If Not sw.FailState Then
                            If sw.ControlledReverse And sw.SwitchIndStatus = SwitchComponents.Switch.SwIndStatus.ReverseInd Then
                                SwitchInCorespondence = True
                            ElseIf Not sw.ControlledReverse And sw.SwitchIndStatus = SwitchComponents.Switch.SwIndStatus.NormalInd Then
                                SwitchInCorespondence = True
                            Else
                                SwitchInCorespondence = False
                            End If
                        Else
                            SwitchInCorespondence = False
                        End If

                        If SwitchInCorespondence Then
                            If IsNothing(sw.OsComponentCollection) Then Exit Sub
                            If sw.OsComponentCollection.Contains(gBeginTrackSelect) Or sw.OsComponentCollection.Contains(gEndTrackSelect) Then

                                TMDS.GlobalDeclarations.gBox14Required = True
                                If sw.ControlledReverse Then
                                    BoxFourteenVerbiageRCPS = BoxFourteenVerbiageRCPS & " " & sw.Name & " IN REVERSE POSITION."
                                Else
                                    BoxFourteenVerbiageRCPS = BoxFourteenVerbiageRCPS & " " & sw.Name & " IN NORMAL POSITION."
                                End If
                                SystemEvent("FORCED BOX FOURTEEN FOR RCPS - " & BoxFourteenVerbiageRCPS)
                                Me.Item14Forced = True
                                Me.ReInitCheckBoxesAndForm()
                            End If
                        End If
                    End If
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Public Function CheckRCPSSwitchPositionInRoute() As Boolean
        Try
            Dim comp As Object
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.RCPS Then
                        Dim NormalCorespondence As Boolean = False
                        If Not sw.FailState Then
                            If Not sw.ControlledReverse And sw.SwitchIndStatus = SwitchComponents.Switch.SwIndStatus.NormalInd Then
                                NormalCorespondence = True
                            End If
                        End If

                        If Not NormalCorespondence Then
                            If IsNothing(sw.OsComponentCollection) Then Exit Function
                            If Not sw.OsComponentCollection.Contains(gBeginTrackSelect) And Not sw.OsComponentCollection.Contains(gEndTrackSelect) Then
                                Return False
                            Else
                                If sw.OsComponentCollection.Contains(gBeginTrackSelect) And Not sw.OsComponentCollection.Contains(gEndTrackSelect) Then
                                    If gSearchDirection = "RIGHT" Then
                                        If sw.RightAltLink <> 0 Then
                                            Return False
                                        End If
                                    Else
                                        If sw.LeftAltLink <> 0 Then
                                            Return False
                                        End If
                                    End If
                                End If
                                If sw.OsComponentCollection.Contains(gEndTrackSelect) And Not sw.OsComponentCollection.Contains(gBeginTrackSelect) Then
                                    If gSearchDirection = "RIGHT" Then
                                        If sw.LeftAltLink <> 0 Then
                                            Return False
                                        End If
                                    Else
                                        If sw.RightAltLink <> 0 Then
                                            Return False
                                        End If
                                    End If
                                End If

                            End If
                        End If
                    End If
                End If
            Next
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

