    Private Sub BoxNineClearOverLaps()
        Try
            Me.gbItem9.Height = 56
            Me.txtItem9Person1.Text = String.Empty
            Me.txtItem9From1.Text = String.Empty
            Me.txtItem9To1.Text = String.Empty
            Me.txtItem9Person2.Text = String.Empty
            Me.txtItem9From2.Text = String.Empty
            Me.txtItem9To2.Text = String.Empty
            Me.txtItem9Person3.Text = String.Empty
            Me.txtItem9From3.Text = String.Empty
            Me.txtItem9To3.Text = String.Empty
            Me.txtItem9Person4.Text = String.Empty
            Me.txtItem9From4.Text = String.Empty
            Me.txtItem9To4.Text = String.Empty
            Me.txtItem9Person5.Text = String.Empty
            Me.txtItem9From5.Text = String.Empty
            Me.txtItem9To5.Text = String.Empty
            Me.txtItem9Person6.Text = String.Empty
            Me.txtItem9From6.Text = String.Empty
            Me.txtItem9To6.Text = String.Empty

            Dim BoxSixHolders As New ArrayList()
            Dim BoxFiveHolders As New ArrayList()
            Dim BoxEightHolders As New ArrayList()

            Dim Comp As Object
            Dim warr As SFAuthority = Nothing
            For Each Comp In Me.CompleteCompSelection
                If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trkToCheck As Track = CType(Comp, Track)
                    If trkToCheck.TrackAuthorities.Count > 0 Then
                        For Each warr In trkToCheck.TrackAuthorities
                            'If warr.CheckBoxItemsStatus(7) Then
                            If warr.CheckBoxItemsStatus(7) And Not warr.CheckBoxItemsStatus(5) Then
                                If Not BoxEightHolders.Contains(warr.IssueTo) Then
                                    BoxEightHolders.Add(warr.IssueTo)
                                End If
                            End If
                            If warr.Box6Train.Contains(Me.cbIssueTo.Text) Then
                                If Not BoxSixHolders.Contains(warr.IssueTo) And Not BoxEightHolders.Contains(warr.IssueTo) Then
                                    BoxSixHolders.Add(warr.IssueTo)
                                End If
                            End If
                        Next
                        If warr.CheckBoxItemsStatus(4) Then
                            For Each warr In trkToCheck.TrackAuthorities
                                If warr.Box5Arrival.Contains(Me.cbIssueTo.Text) Then
                                    If Not BoxFiveHolders.Contains(warr.IssueTo) Then
                                        BoxFiveHolders.Add(warr.IssueTo)
                                    End If
                                End If
                            Next
                        End If
                    End If
                End If
            Next
            Dim auth As Object
            For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                    Dim sfa As SFAuthority = CType(auth, SFAuthority)
                    If sfa.Box5Arrival.Contains(cbIssueTo.Text) Then
                        BoxFiveHolders.Add(sfa.IssueTo)
                    End If
                End If
            Next

            Dim JointAuthoritiesFoundClone As ArrayList = JointAuthoritiesFound.Clone
            Dim ja As JointAuthorityType
            For Each ja In JointAuthoritiesFoundClone
                If Me.IssuedToTrain Then
                    If Mid(ja.IssueToName, 1, 10) = Mid(Me.cbIssueTo.Text, 1, 10) Then
                        JointAuthoritiesFound.Remove(ja)
                    ElseIf BoxSixHolders.Contains(ja.IssueToName) And Not BoxEightHolders.Contains(warr.IssueTo) Then
                        JointAuthoritiesFound.Remove(ja)
                    ElseIf BoxFiveHolders.Contains(ja.IssueToName) Then
                        JointAuthoritiesFound.Remove(ja)
                    End If
                Else
                    If ja.IssueToName = Me.cbIssueTo.Text Then
                        JointAuthoritiesFound.Remove(ja)
                    End If

                End If
            Next

            If JointAuthoritiesFound.Count = 0 Then
                Me.gbItem9.Visible = False
                gJointAuthRequired = False
                JointAuthRequired = False
                gBox8Required = False
                Me.BoxEightComponents.Clear()
                Me.chkItem8.Checked = False
                Me.chkItem9.Checked = False
            Else
                JointAuthorityCheck()
            End If
            Me.ReInitCheckBoxesAndForm()
        Catch ex As Exception
            TMDS.SystemUtilities.Utilities.SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub JointAuthorityCheck()
        Dim ja As JointAuthorityType
        Try
            'InputBoxFactor = 0
            Me.gbItem9.Height = 56
            If JointAuthRequired Then
                gJointAuthRequired = True
                gBox8Required = True

                Me.gbItem9.Height = Me.gbItem9.Height + ((Me.JointAuthoritiesFound.Count - 1) * 40)
                Dim jaCount As Integer = 1
                For Each ja In Me.JointAuthoritiesFound
                    Dim LeftLimits As String = String.Empty
                    Dim RightLimits As String = String.Empty

                    If gSearchDirection = "LEFT" Then
                        LeftLimits = ja.RightLimits
                        RightLimits = ja.LeftLimits
                    Else
                        RightLimits = ja.RightLimits
                        LeftLimits = ja.LeftLimits
                    End If

                    Select Case jaCount
                        Case 1
                            Me.txtItem9Person1.Text = ja.IssueToName
                            Me.txtItem9From1.Text = LeftLimits
                            Me.txtItem9To1.Text = RightLimits
                        Case 2
                            Me.txtItem9Person2.Text = ja.IssueToName
                            Me.txtItem9From2.Text = LeftLimits
                            Me.txtItem9To2.Text = RightLimits
                        Case 3
                            Me.txtItem9Person3.Text = ja.IssueToName
                            Me.txtItem9From3.Text = LeftLimits
                            Me.txtItem9To3.Text = RightLimits
                        Case 4
                            Me.txtItem9Person4.Text = ja.IssueToName
                            Me.txtItem9From4.Text = LeftLimits
                            Me.txtItem9To4.Text = RightLimits
                        Case 5
                            Me.txtItem9Person5.Text = ja.IssueToName
                            Me.txtItem9From5.Text = LeftLimits
                            Me.txtItem9To5.Text = RightLimits
                        Case 6
                            Me.txtItem9Person6.Text = ja.IssueToName
                            Me.txtItem9From6.Text = LeftLimits
                            Me.txtItem9To6.Text = RightLimits
                    End Select
                    jaCount = jaCount + 1
                Next
            End If
            For Each ja In Me.JointAuthoritiesFound
                Dim sfa As TrackAuthority.SFAuthority = TMDS.SystemUtilities.FetchData.FindSFA(ja.AuthUID)
                If Not IsNothing(sfa) Then
                    Dim comp As Object
                    For Each comp In sfa.Components
                        If CompleteCompSelection.Contains(comp) Then
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If Not ja.TrackList.Contains(comp.GUID) Then
                                    ja.TrackList.Add(comp.GUID)
                                End If
                            End If
                        End If
                    Next
                End If
            Next


        Catch ex As Exception
            TMDS.SystemUtilities.Utilities.SystemException(ex.ToString)
        End Try

    End Sub

    Private Sub BoxEightCheckToRemoveRequirement()
        Try
            Dim PreSelectBoxEight As Boolean
            TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightCheckToRemoveRequirement")
            If Not gBox8Required Then
                TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightCheckToRemoveRequirement - Exit 1")
                Exit Sub
            End If
            If IsNothing(ItemOneAuthorityToBeReplaced) Then
                TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightCheckToRemoveRequirement - Exit 2")
                Exit Sub
            Else
                PreSelectBoxEight = ItemOneAuthorityToBeReplaced.CheckBoxItemsStatus(7)
            End If

            Dim Comp As Object
            Dim warr As SFAuthority
            For Each Comp In Me.CompleteCompSelection
                If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trkToCheck As Track = CType(Comp, Track)
                    If trkToCheck.TrackAuthorities.Count > 0 Then
                        For Each warr In trkToCheck.TrackAuthorities
                            If warr.AuthorityUID <> ItemOneAuthorityToBeReplaced.AuthorityUID Then
                                If warr.Box6Train.Contains(ItemOneAuthorityToBeReplaced.IssueTo) Then
                                    'do nothing
                                Else
                                    TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightCheckToRemoveRequirement - Exit 3")
                                    Exit Sub
                                End If
                            End If
                        Next
                    End If
                End If
            Next
            gBox8Required = False
            If PreSelectBoxEight Then
                Me.chkItem8.Checked = True
            End If
            TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightCheckToRemoveRequirement - Exit 4")
        Catch ex As Exception
            TMDS.SystemUtilities.Utilities.SystemException(ex.ToString)
        End Try
    End Sub

    Private Function BoxEightInitialCheck(ByVal ComponentList As ArrayList, ByVal WarrantTypeToCheck As String) As Boolean
        Try
            TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightInitialCheck - Begin")
            Dim Comp As Object
            Dim warr As SFAuthority = Nothing
            Dim ForceEntireLimits As Boolean
            Dim OverrideBoxEightChecked As Boolean
            For Each Comp In ComponentList
                'CHECK FOR EXISTING WARRANTS ON EACH TRACK
                If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trkToCheck As Track = CType(Comp, Track)
                    If trkToCheck.TrackAuthorities.Count > 0 Then
                        'CHECK TO SEE IF BOX 11 IS APPLIED TO TRACK
                        Dim BoxEightChecked As Boolean = False
                        If trkToCheck.BoxEightRestriction Then
                            For Each warr In Comp.TrackAuthorities
                                If warr.CheckBoxItemsStatus(7) Then
                                    BoxEightChecked = True

                                    If warr.AuthType1 = "ItemTwoToTrain" And trkToCheck.BiDirectionalABS Then
                                        OverrideBoxEightChecked = True
                                    Else
                                        OverrideBoxEightChecked = False
                                        If Not IsNothing(VoidedWarrant) Then
                                            If VoidedWarrant.AuthorityUID = warr.AuthorityUID And Not trkToCheck.BiDirectionalABS Then
                                                OverrideBoxEightChecked = True
                                            Else
                                                OverrideBoxEightChecked = False
                                            End If
                                        ElseIf Me.BoxFiveTrainList.Contains(warr.IssueTo) Then
                                            OverrideBoxEightChecked = True
                                        Else
                                            OverrideBoxEightChecked = False
                                        End If
                                    End If

                                    If WarrantTypeToCheck = "ItemFourToTrain" Then
                                        ForceEntireLimits = True
                                    End If

                                    If Not OverrideBoxEightChecked Then
                                        Exit For
                                    End If
                                End If
                            Next

                            'warr = Comp.Authorities.Item(0)
                            'CHECK TO SEE IF BOX 11 IS CHECKED ON THE WARRANT
                            If BoxEightChecked And Not ForceEntireLimits And Not OverrideBoxEightChecked Then 'warr.CheckBox(11) Then
                                Dim trk As Object
                                Dim trackFound As Boolean
                                'CHECK TO SEE IF THE TRACK REFERENCE IS A PART OF THE WARRANT's BOX 11 ARRAYLIST
                                For Each trk In warr.BoxEightRestrictionComponents
                                    If trk Is trkToCheck Then
                                        trackFound = True
                                        Exit For
                                    End If
                                Next
                                'IF THE TRACK IS FOUND AS PART OF THE WARRANT's BOX 11 RESTRICTION LIST THEN
                                'ADD IT TO THE ABSOLUTE RESTRICTIONS LIST THAT WILL BE CHECKED AGAINST
                                'IF BOX 11 IS CHECK FOR THIS CURRENT WARRANT OR IF THE LIMITS
                                'OF THE BOX ELEVEN IS CHANGED.
                                If trackFound Then
                                    gBox8Required = True
                                    trackFound = False
                                    If Not RestrictionList.Contains(Comp) Then
                                        RestrictionList.Add(Comp)
                                    End If
                                Else
                                    TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightInitialCheck - Exit 1")
                                    Return False
                                End If
                            ElseIf ForceEntireLimits Then
                                Dim compToAdd As Object
                                gBox8Required = True
                                For Each compToAdd In ComponentList
                                    If compToAdd.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        If Not RestrictionList.Contains(compToAdd) Then
                                            RestrictionList.Add(compToAdd)
                                        End If
                                    End If
                                Next
                                Exit For
                            ElseIf OverrideBoxEightChecked Then
                                OverrideBoxEightChecked = False
                            Else
                                TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightInitialCheck - Exit 2")
                                Return False
                            End If
                        End If

                    End If
                End If
            Next
            TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightInitialCheck - Exit 3")
            Return True

        Catch ex As Exception
            TMDS.SystemUtilities.Utilities.SystemException(ex.ToString)
            TMDS.SystemUtilities.Utilities.SystemEvent("BoxEightInitialCheck - Exit 4")
            Return False
        End Try
    End Function

    Private Sub ResetBoxEightInitialCheck()
        Try
            TMDS.SystemUtilities.Utilities.SystemEvent("ResetBoxEightInitialCheck - Begin")

            If IsNothing(VoidedWarrant) Then
                TMDS.SystemUtilities.Utilities.SystemEvent("ResetBoxEightInitialCheck - Exit 1")
                Exit Sub
            End If

            Dim Comp As Object
            Dim warr As SFAuthority = Nothing
            Dim RestrictionListRemove As New ArrayList
            For Each Comp In CompleteCompSelection
                If RestrictionList.Contains(Comp) Then
                    If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trkToCheck As Track = CType(Comp, Track)
                        If trkToCheck.TrackAuthorities.Count = 1 Then
                            warr = trkToCheck.TrackAuthorities.Item(0)
                            If warr.AuthorityUID = VoidedWarrant.AuthorityUID Then
                                RestrictionListRemove.Add(Comp)
                            End If
                        End If
                    End If
                End If
            Next
            For Each Comp In RestrictionListRemove
                RestrictionList.Remove(Comp)
            Next

            Me.ResetBoxEightLimits()
            TMDS.SystemUtilities.Utilities.SystemEvent("ResetBoxEightInitialCheck - Exit 2")
        Catch ex As Exception
            TMDS.SystemUtilities.Utilities.SystemException(ex.ToString)
        End Try
    End Sub

    Private Function ResetBoxEightLimits() As Boolean
        Try
            Dim comp As Object
            TMDS.SystemUtilities.Utilities.SystemEvent("ResetBoxEightLimits - Begin")
            If RestrictionList.Count = 0 Then
                If Mid(FirstTypeOfWarrant, 1, 7) = "ItemTwo" Then
                    Me.cmbBox8From.Text = Me.txtItem2From1.Text
                    If Not Me.SecondLineNeeded Then
                        Me.cmbBox8To.Text = Me.txtItem2To1.Text
                    Else
                        If Not Me.ThirdLineNeeded Then
                            Me.cmbBox8To.Text = Me.txtItem2To2.Text
                        Else
                            Me.cmbBox8To.Text = Me.txtItem2To3.Text
                        End If
                    End If

                Else
                    Me.cmbBox8From.Text = Me.txtItem4At1.Text
                    If Not Me.SecondLineNeeded Then
                        Me.cmbBox8To.Text = Me.txtItem4And1.Text
                    Else
                        If Not Me.ThirdLineNeeded Then
                            Me.cmbBox8To.Text = Me.txtItem4And2.Text
                        Else
                            Me.cmbBox8To.Text = Me.txtItem4And3.Text
                        End If
                    End If
                End If
                TMDS.SystemUtilities.Utilities.SystemEvent("ResetBoxEightLimits - Exit 1")
                Return True
            End If

            Dim RestListToUse As ArrayList
            If RestrictionList.Count < BoxEightComponents.Count Then
                RestListToUse = BoxEightComponents
            Else
                RestListToUse = RestrictionList
            End If

            If DirectionOfTheWarrant = "RIGHT" Then
                comp = RestListToUse.Item(0)
                If Me.cmbBox8From.Enabled Then
                    Me.cmbBox8From.Text = comp.LeftLimitName
                ElseIf Not Me.cmbBox8From.Enabled And Me.cmbBox8From.Text = "" Then
                    Me.cmbBox8From.Text = comp.LeftLimitName
                End If
                comp = RestListToUse.Item(RestListToUse.Count - 1)
                Me.cmbBox8To.Text = comp.RightLimitName
            Else
                comp = RestListToUse.Item(0)
                If Me.cmbBox8From.Enabled Then
                    Me.cmbBox8From.Text = comp.RightLimitName
                ElseIf Not Me.cmbBox8From.Enabled And Me.cmbBox8From.Text = "" Then
                    Me.cmbBox8From.Text = comp.RightLimitName
                End If
                comp = RestListToUse.Item(RestListToUse.Count - 1)
                Me.cmbBox8To.Text = comp.LeftLimitName
            End If
            BoxEightComponents = RestListToUse
            'Me.TextBoxArrayList(14).Text = Me.cmbBox8From.Text
            'Me.TextBoxArrayList(15).Text = Me.cmbBox8To.Text
            TMDS.SystemUtilities.Utilities.SystemEvent("ResetBoxEightLimits - Exit 2")
            Return True
        Catch ex As Exception
            TMDS.SystemUtilities.Utilities.SystemException(ex.ToString)
            TMDS.SystemUtilities.Utilities.SystemEvent("ResetBoxEightLimits - Exit 3")
            Return False
        End Try

    End Function

    Private Function CheckBoxEightChange(ByVal ComponentListToCheck As ArrayList, ByVal DirectionOfWarrant As String) As Boolean

        Dim CurrentBoxEightSelection As New ArrayList()
        Dim comp As Object
        Dim BoxElevenFromFound As Boolean
        Dim BoxElevenToFound As Boolean
        TMDS.SystemUtilities.Utilities.SystemEvent("CheckBoxEightChange - Begin")


        Try
            BoxEightLocked = "LOCKED"
            'if the FROM and TO limits are the same then reset the box eleven limits
            If Me.cmbBox8From.Text = Me.cmbBox8To.Text Or Me.cmbBox8From.Text.Trim(" ") = "" Or Me.cmbBox8To.Text.Trim(" ") = "" Then
                If Me.ResetBoxEightLimits Then
                    BoxEightLocked = ""
                    TMDS.SystemUtilities.Utilities.SystemEvent("CheckBoxEightChange - Exit 1")
                    Return True
                End If
            End If


            CurrentBoxEightSelection.Clear()

            'Find the current Box Eleven limits based on the From and To Text selections
            If DirectionOfTheWarrant = "RIGHT" Then

                For Each comp In ComponentListToCheck
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If Not BoxElevenFromFound Then
                            If comp.LeftLimitName = Me.cmbBox8From.Text Then
                                BoxElevenFromFound = True
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                        Else
                            If comp.LeftLimitName = Me.cmbBox8From.Text Then
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                        End If

                        If Not BoxElevenToFound And BoxElevenFromFound Then
                            If comp.RightLimitName = Me.cmbBox8To.Text Then
                                BoxElevenToFound = True
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                        Else
                            If comp.RightLimitName = Me.cmbBox8To.Text Then
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                        End If

                        If BoxElevenFromFound And BoxElevenToFound Then
                            'added this for OS track sections that have multiple track sections with the same 
                            'right limits name
                            If comp.RightLimitName = Me.cmbBox8To.Text Then
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                            'Exit For
                        Else
                            If BoxElevenFromFound Then
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                        End If
                    End If
                Next
            Else
                For Each comp In ComponentListToCheck
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If Not BoxElevenFromFound Then
                            If comp.RightLimitName = Me.cmbBox8From.Text Then
                                BoxElevenFromFound = True
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                        End If

                        If Not BoxElevenToFound And BoxElevenFromFound Then
                            If comp.LeftLimitName = Me.cmbBox8To.Text Then
                                BoxElevenToFound = True
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                        End If

                        If BoxElevenFromFound And BoxElevenToFound Then
                            'added this for OS track sections that have multiple track sections with the same 
                            'left limits name
                            If comp.LeftLimitName = Me.cmbBox8To.Text Then
                                BoxElevenToFound = True
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                            'Exit For
                        Else
                            If BoxElevenFromFound Then
                                If Not CurrentBoxEightSelection.Contains(comp) Then
                                    CurrentBoxEightSelection.Add(comp)
                                End If
                            End If
                        End If
                    End If
                Next
            End If

            Dim RestrictionComp As Object
            Dim RestrictionCompFound As Boolean
            For Each RestrictionComp In RestrictionList
                For Each comp In CurrentBoxEightSelection
                    If comp Is RestrictionComp Then
                        RestrictionCompFound = True
                    End If
                Next
                If Not RestrictionCompFound Then
                    If Me.ResetBoxEightLimits Then
                        BoxEightLocked = ""
                        TMDS.SystemUtilities.Utilities.SystemEvent("CheckBoxEightChange - Exit 2")
                        Return True
                    Else
                        TMDS.SystemUtilities.Utilities.SystemEvent("CheckBoxEightChange - Exit 3")
                        Return False
                    End If
                Else
                    RestrictionCompFound = False
                End If
            Next


            If DirectionOfTheWarrant = "RIGHT" Then
                comp = CurrentBoxEightSelection.Item(0)
                Me.cmbBox8From.Text = comp.LeftLimitName

                comp = CurrentBoxEightSelection.Item(CurrentBoxEightSelection.Count - 1)
                Me.cmbBox8To.Text = comp.RightLimitName
                Dim trk As Track = CType(comp, Track)
                Me.txtItem8Track.Text = trk.TrackName
            Else
                comp = CurrentBoxEightSelection.Item(0)
                Me.cmbBox8From.Text = comp.RightLimitName

                comp = CurrentBoxEightSelection.Item(CurrentBoxEightSelection.Count - 1)
                Me.cmbBox8To.Text = comp.LeftLimitName
                Dim trk As Track = CType(comp, Track)
                Me.txtItem8Track.Text = trk.TrackName
            End If



            BoxEightComponents = CurrentBoxEightSelection

            BoxEightLocked = ""
            TMDS.SystemUtilities.Utilities.SystemEvent("CheckBoxEightChange - Exit 4")
            Return True
        Catch ex As Exception
            BoxEightLocked = ""
            TMDS.SystemUtilities.Utilities.SystemException(ex.ToString)
            Return False
        End Try

    End Function

    Private Sub CheckForBoxThirteenSituation(Optional ByVal OverridePrompt As Boolean = False, Optional ByVal ForcePrompt As Boolean = False)
        Try
            'Dim comp As Track = CompleteCompSelection(CompleteCompSelection.Count - 1)
            'Dim compsToTest As ArrayList = comp.GetAllOSComponents(True)
            If CheckForBoxThirteenSituationPerformed Then Exit Sub
            CheckForBoxThirteenSituationPerformed = True
            Dim comp As Object = CompleteCompSelection(CompleteCompSelection.Count - 1)
            Dim compsToTest As ArrayList = comp.OsComponentCollection
            If IsNothing(compsToTest) Then Exit Sub
            Dim compToTest As Object
            For Each compToTest In compsToTest
                If compToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" Then

                    Dim SwitchProtected As Boolean
                    Dim sw As Switch = CType(compToTest, Switch)
                    If sw.BiDirectionalABS Or sw.SingleABSEast Or sw.SingleABSWest Then
                        If sw.TrackAuthorities.Count > 1 Then
                            Dim auth As SFAuthority
                            For Each auth In sw.TrackAuthorities
                                If Not auth.Box12Switches.Contains(sw.Name) Then
                                    Exit Sub
                                End If
                            Next
                        Else
                            Dim auth As SFAuthority
                            If IsNothing(VoidedWarrant) Then
                                For Each auth In sw.TrackAuthorities
                                    If Not auth.Box12Switches.Contains(sw.Name) Then
                                        Exit Sub
                                    End If
                                Next
                            Else
                                For Each auth In sw.TrackAuthorities
                                    If VoidedWarrant.AuthorityUID <> auth.AuthorityUID Then
                                        Exit Sub
                                    End If
                                Next
                            End If
                        End If
                    Else
                        Dim auth As SFAuthority
                        For Each auth In sw.TrackAuthorities
                            If (auth.CheckBoxItemsStatus(5) And auth.Box6Train.Contains(Me.cbIssueTo.Text)) Or auth.CheckBoxItemsStatus(7) Then
                                If Mid(Me.cbIssueTo.Text, 1, 10) <> Trim(auth.IssueTo) Then
                                    If Not auth.Box12Switches.Contains(sw.Name) Then
                                        Exit Sub
                                    End If
                                End If
                            End If
                        Next
                    End If
                    If Not IsNothing(gEndTrackSelect.OsComponentCollection) Then
                        If gEndTrackSelect.OsComponentCollection.Contains(comp) Then
                            If gSearchDirection = "RIGHT" And sw.LeftAltLink <> 0 Or gSearchDirection = "LEFT" And sw.RightAltLink <> 0 Then
                                SwitchProtected = True
                            End If
                        End If
                    End If


                    If BoxThirteenSwitches.Contains(sw.Name) Then
                        SwitchProtected = True
                    End If
                    If (Not compToTest.ControlledReverse Or ForcePrompt) And compToTest.ProtectOpenSwitchEnabled And Not SwitchProtected And Not CheckForEndAuthorityOnPOSPerformed Then
                        Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                        Dim frmMessageBox As frmMessageBox
                        Dim MessageList As New ArrayList()
                        frmMessageBox = New frmMessageBox()

                        If Not OverridePrompt Then
                            CheckForEndAuthorityOnPOSPerformed = True
                            CheckForBoxThirteenSituationPerformed = True
                            frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm
                            'MessageList.Add("GIVE PERMISSION TO LEAVE " & sw.Name & " SWITCH OPEN?")
                            'MessageList.Add("(Yes required in Non-ABS if train enters Main track at POS switch)")
                            MessageList.Add("TW ENDS AT POS SWITCH " & sw.Name)
                            MessageList.Add("ADD " & sw.Name & " TO BOX 13?")
                            MessageList.Add("")

                            frmMessageBox.SetMessage(MessageList, "LEAVE SWITCH OPEN DIALOG", True, LaunchPoint)
                            frmMessageBox.ShowDialog()
                        End If

                        If frmMessageBox.FormFeedBack = 6 Or OverridePrompt Then
                            If Not sw.ControlledReverse Then
                                sw.ControlSwitch()
                                sw.BoxThirteenControlled = True
                                If Not sw.UpdateProtectOpenSwitch(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                    sw.ControlSwitch()
                                    sw.ControlBrotherSwitches(compToTest.Index, compToTest.ControlledReverse)
                                    Dim ErrorMessage As String = "Protect Open Switch Database Write Error! Consider The Switch Not Protected!"
                                    MessageBox.Show(Me, ErrorMessage, "PROTECT OPEN SWITCH", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    SystemEvent(ErrorMessage)
                                Else
                                    gBoxThirteenRequired = True
                                    gBoxThreeRequired = True
                                    Item13Forced = True
                                    BoxThirteenSwitches.Add(compToTest.Name)
                                    ReInitCheckBoxesAndForm()
                                    chkItem13.Checked = True
                                    sw.UpdateSwitchPositionInDatabase(TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
                                End If

                            Else
                                gBoxThirteenRequired = True
                                gBoxThreeRequired = True
                                Item13Forced = True
                                BoxThirteenSwitches.Add(compToTest.Name)
                                ReInitCheckBoxesAndForm()
                                chkItem13.Checked = True
                                sw.UpdateSwitchPositionInDatabase(TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
                            End If
                        End If
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing

                    ElseIf compToTest.ControlledReverse And compToTest.ProtectOpenSwitchEnabled And OverridePrompt And Not SwitchProtected Then
                        gBoxThirteenRequired = True
                        gBoxThreeRequired = True
                        Item13Forced = True
                        BoxThirteenSwitches.Add(compToTest.Name)
                        ReInitCheckBoxesAndForm()
                        chkItem13.Checked = True
                    End If
                    SwitchProtected = False
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
            ClearSystemVariables()
            Me.CloseForm()
        End Try
    End Sub

    Private Function CheckForBoxOneWarrantInSelectedABSLimits() As Boolean
        Try
            Dim comp As Object
            CheckForBoxOneWarrantInSelectedABSLimitsPerformed = True
            If CompleteCompSelection Is Nothing Then Exit Function
            Dim FirstTrack As Track
            Dim LaunchPoint As Point
            Dim TopPoint As Integer
            Try
                FirstTrack = Me.FirstTrackSelection.Item(0)
                If FirstTrack.Top + 300 < FirstTrack.CurrentDrawingForm.Height Then
                    TopPoint = FirstTrack.Top + 100
                Else
                    TopPoint = 150
                End If
                LaunchPoint = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + FirstTrack.CurrentDrawingForm.Width / 2 - 100, TopPoint)
            Catch
            End Try

            Dim ItemOnePositionOneLocked As Boolean
            Dim ItemOnePositionTwoLocked As Boolean
            Dim ItemOnePositionThreeLocked As Boolean

            For Each comp In CompleteCompSelection
                If comp.TrackAuthorities.Count > 0 Then
                    Dim warr As SFAuthority
                    For Each warr In comp.TrackAuthorities
                        If (Mid(warr.IssueTo, 1, Me.cbIssueTo.Text.Length) = Me.cbIssueTo.Text And warr.IssuedToTrain) Or (warr.AuthType1 = "ItemFourToTrain" And Mid(Me.cbIssueTo.Text, 1, warr.IssueTo.Length) = warr.IssueTo) Or (warr.IssueTo = cbIssueTo.Text) Then
                            PerformLoadPotentialVoidAuthorities = False
                            gBoxOneRequired = True
                            ForceBoxOne = True
                            If Not CheckForReissueItem2FromItem4InNonABS() Then
                                Dim frmMessageBox As frmMessageBox
                                Dim MessageList As New ArrayList()
                                frmMessageBox = New frmMessageBox()
                                frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm
                                MessageList.Add("(ITEM 2 Authority Does Not Start Within ITEM 4 Limits.) - EXITING!")
                                MessageList.Add("")

                                frmMessageBox.SetMessage(MessageList, "CONFLICT CHECK", False, LaunchPoint)
                                frmMessageBox.ShowDialog()
                                frmMessageBox.Dispose()
                                frmMessageBox = Nothing
                                ClearSystemVariables()
                                Me.Close()
                                Return False
                            End If

                            If ItemOnePositionThreeLocked And ItemOnePositionOneLocked And ItemOnePositionTwoLocked Then
                                Dim AuthNotFound As Boolean
                                If Me.cmbItem1Void1.Text <> warr.AuthorityUID Then
                                    AuthNotFound = True
                                    If Me.cmbItem1Void2.Text <> warr.AuthorityUID Then
                                        AuthNotFound = True
                                        If Me.cmbItem1Void3.Text <> warr.AuthorityUID Then
                                            AuthNotFound = True
                                        Else
                                            AuthNotFound = False
                                        End If
                                    Else
                                        AuthNotFound = False
                                    End If
                                End If

                                If AuthNotFound Then
                                    'Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                                    Dim frmMessageBox As frmMessageBox
                                    Dim MessageList As New ArrayList()
                                    frmMessageBox = New frmMessageBox()
                                    frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                                    MessageList.Add("Too Many Voided Authorities.")
                                    MessageList.Add("Authority Form Only Allows Three Voided Authorities")
                                    MessageList.Add("")

                                    frmMessageBox.SetMessage(MessageList, "FORWARD AUTHORITY VOID CHECK", False, LaunchPoint)
                                    AuthorityEvent("Too Many Voided Authorities. Authority Form Only Allows Three Voided Authorities.")
                                    frmMessageBox.ShowDialog()
                                    MessageList.Clear()
                                    MessageList = Nothing
                                    frmMessageBox.Dispose()
                                    frmMessageBox = Nothing
                                    ClearSystemVariables()
                                    Me.CloseForm()
                                    Return False
                                End If
                            End If

                            If Not ItemOnePositionOneLocked Then
                                ItemOnePositionOneLocked = True
                                VoidedWarrant = warr
                                ItemOneAuthorityToBeReplaced = warr
                                If Not CheckForRollUpConfirmed Then
                                    If Not CheckForNeedsRollUp(warr, LaunchPoint) Then
                                        ClearSystemVariables()
                                        Me.CloseForm()
                                        Return False
                                    End If
                                End If
                                Me.LockIssueToList = True
                                Me.cbIssueTo.Text = VoidedWarrant.IssueTo
                                If Me.IssuedToTrain Then
                                    If Not Me.CheckEngineIDFormatting Then
                                        ClearSystemVariables()
                                        Me.CloseForm()
                                        Return False
                                    End If
                                End If
                                Me.cbIssueTo.Enabled = False
                                Me.IssueTo = Me.cbIssueTo.Text

                                Me.LoadPotentialVoidAuthorities()
                                Me.cmbItem1Void1.DropDownStyle = ComboBoxStyle.Simple
                                Me.cmbItem1Void1.Text = VoidedWarrant.AuthorityUID
                                Me.cmbItem1Void1.Enabled = False
                            End If

                            If Not ItemOnePositionTwoLocked And ItemOnePositionOneLocked And Me.cmbItem1Void1.Text <> warr.AuthorityUID Then
                                ItemOnePositionTwoLocked = True
                                Me.cmbItem1Void2.DropDownStyle = ComboBoxStyle.Simple
                                Me.cmbItem1Void2.Tag = "LOCK"
                                Me.cmbItem1Void2.Text = warr.AuthorityUID
                                Me.cmbItem1Void2.Enabled = False
                            End If

                            If Not ItemOnePositionThreeLocked And ItemOnePositionTwoLocked And Me.cmbItem1Void2.Text <> warr.AuthorityUID Then
                                ItemOnePositionThreeLocked = True
                                Me.cmbItem1Void3.DropDownStyle = ComboBoxStyle.Simple
                                Me.cmbItem1Void3.Tag = "LOCK"
                                Me.cmbItem1Void3.Text = warr.AuthorityUID
                                Me.cmbItem1Void3.Enabled = False
                            End If
                        End If

                    Next
                End If
            Next

            If Me.IssuedToTrain Then
                Me.CheckForForwardAuthorities()
            End If

            If ItemOnePositionOneLocked Then
                Me.chkItem1.Checked = True
                BoxNineClearOverLaps()
            End If

            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Private Function CheckForOtherExistingBoxFiveThisTrainIsWaitingOn(ByVal Auth As SFAuthority) As Boolean
        Try
            Dim sfa As SFAuthority
            For Each sfa In GlobalDeclarations.OtherTrackAuthorities
                If sfa.IssueTo = Me.cbIssueTo.Text And sfa.CheckBoxItemsStatus(4) And sfa.Box5Arrival.Contains(Auth.IssueTo) Then
                    Return True
                End If
            Next
            Return False
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Function CheckForReissueItem2FromItem4InNonABS() As Boolean
        Try
            If gBeginTrackSelect.BiDirectionalABS Or (gBeginTrackSelect.SingleABSEast And gSearchDirection = "RIGHT") Or (gBeginTrackSelect.SingleABSWest And gSearchDirection = "LEFT") Then
                Return True
            ElseIf FirstTypeOfWarrant = "ItemTwoToTrain" Then
                Dim Comp As Object
                Dim warr As SFAuthority
                For Each Comp In Me.CompleteCompSelection
                    If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trkToCheck As Track = CType(Comp, Track)
                        If trkToCheck.TrackAuthorities.Count > 0 Then
                            For Each warr In trkToCheck.TrackAuthorities
                                If warr.AuthType1 = "ItemFourToTrain" Then
                                    Dim OverrideConflict As Boolean
                                    If Not gBeginTrackSelect.TrackAuthorities.Contains(warr) Then
                                        If Mid(cbIssueTo.Text, 1, 10) = Mid(warr.IssueTo, 1, 10) Then
                                            OverrideConflict = True
                                        End If
                                    Else
                                        OverrideConflict = True
                                    End If
                                    If Not OverrideConflict Then
                                        Return False
                                    Else
                                        OverrideConflict = False
                                    End If
                                End If
                            Next
                        End If
                    End If
                Next
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Private Function CheckForBoxOneWarrantInSelectedABSLimitsFromMM(ByVal VOIDListFromMM As ArrayList) As Boolean
        Dim MessageList As New ArrayList()
        Dim LaunchPoint As Point
        Dim FirstTrack As Track
        Dim TopPoint As Integer
        Dim SFAAuth As TMDS.TrackAuthority.SFAuthority = Nothing
        Try
            CheckForBoxOneWarrantInSelectedABSLimitsPerformed = True
            If VOIDListFromMM Is Nothing Then Exit Function
            If VOIDListFromMM.Count = 0 Then Exit Function

            Try
                FirstTrack = Me.FirstTrackSelection.Item(0)
                If FirstTrack.Top + 300 < FirstTrack.CurrentDrawingForm.Height Then
                    TopPoint = FirstTrack.Top + 100
                Else
                    TopPoint = 150
                End If
                LaunchPoint = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + FirstTrack.CurrentDrawingForm.Width / 2 - 100, TopPoint)
            Catch
            End Try

            Dim ItemOnePositionOneLocked As Boolean
            Dim ItemOnePositionTwoLocked As Boolean
            Dim ItemOnePositionThreeLocked As Boolean


            If VOIDListFromMM.Count > 3 Then
                MessageList.Add("Too Many Voided Authorities.")
                MessageList.Add("Authority Form Only Allows Three Voided Authorities")
                MessageList.Add("")
                ShowCustomMessageBox(MessageList, "FORWARD AUTHORITY VOID CHECK", False, LaunchPoint)
                ClearSystemVariables()
                Me.CloseForm()
                Return False
            End If

            For Each SFAAuth In VOIDListFromMM
                If Not ItemOnePositionOneLocked Then
                    ItemOnePositionOneLocked = True
                    VoidedWarrant = SFAAuth
                    ItemOneAuthorityToBeReplaced = SFAAuth
                    ''If Not CheckForRollUpConfirmed Then
                    ''    If Not CheckForNeedsRollUp(SFAAuth, LaunchPoint) Then
                    ''        ClearSystemVariables()
                    ''        Me.CloseForm()
                    ''        Return False
                    ''    End If
                    ''End If
                    Me.LockIssueToList = True
                    Me.cbIssueTo.Text = VoidedWarrant.IssueTo
                    Me.cbIssueTo.Enabled = False
                    Me.IssueTo = Me.cbIssueTo.Text

                    Me.LoadForcedVoidAuthoritiesFromMM(VOIDListFromMM)
                    Me.cmbItem1Void1.DropDownStyle = ComboBoxStyle.Simple
                    Me.cmbItem1Void1.Text = VoidedWarrant.AuthorityUID
                    Me.cmbItem1Void1.Enabled = False
                End If

                If Not ItemOnePositionTwoLocked And ItemOnePositionOneLocked And Me.cmbItem1Void1.Text <> SFAAuth.AuthorityUID Then
                    ItemOnePositionTwoLocked = True
                    Me.cmbItem1Void2.DropDownStyle = ComboBoxStyle.Simple
                    Me.cmbItem1Void2.Tag = "LOCK"
                    Me.cmbItem1Void2.Text = SFAAuth.AuthorityUID
                    Me.cmbItem1Void2.Enabled = False
                End If

                If Not ItemOnePositionThreeLocked And ItemOnePositionTwoLocked And Me.cmbItem1Void2.Text <> SFAAuth.AuthorityUID Then
                    ItemOnePositionThreeLocked = True
                    Me.cmbItem1Void3.DropDownStyle = ComboBoxStyle.Simple
                    Me.cmbItem1Void3.Tag = "LOCK"
                    Me.cmbItem1Void3.Text = SFAAuth.AuthorityUID
                    Me.cmbItem1Void3.Enabled = False
                End If
            Next



            If ItemOnePositionOneLocked Then
                Me.chkItem1.Checked = True
                BoxNineClearOverLaps()
            End If



            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        Finally
            SFAAuth = Nothing
            LaunchPoint = Nothing
            FirstTrack = Nothing
            MessageList = Nothing
        End Try
    End Function


