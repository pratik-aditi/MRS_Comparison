    Private Sub CheckToRemoveItemFiveTrainsFromList()
        Try
            Dim AuthToCheck As SFAuthority = Nothing
            Dim a As SFAuthority
            Dim UpdateBoxFiveListEvent As Boolean

            For Each a In OtherTrackAuthorities
                If a.IssueTo = cbIssueTo.Text Then
                    If a.CheckBoxItemsStatus(4) And a.Components.Contains(gBeginTrackSelect) Then
                        Me.ForceBoxOne = True
                        Me.VoidedWarrant = a
                        FirstTypeOfWarrant = "ItemTwoFiveToTrain"
                        Me.SetUpTrackWarrantForm("ItemTwoFiveToTrain", "")
                        Exit For
                    End If
                End If
            Next

            Dim TrainsToRemove As New ArrayList
            For Each a In OtherTrackAuthorities
                Dim OverrideRemove As Boolean
                If a.IssueTo = Me.cbIssueTo.Text Then
                    If Not IsNothing(VoidedWarrant) Then
                        If a.AuthorityUID = VoidedWarrant.AuthorityUID Then
                            OverrideRemove = True
                        End If
                    End If
                    Dim box5 As String
                    For Each box5 In Me.BoxFiveTrainList
                        If a.Box5Arrival.Contains(box5) Then
                            If Not OverrideRemove Then
                                TrainsToRemove.Add(box5)
                                UpdateBoxFiveListEvent = True
                                'Else
                                '    OverrideRemove = False
                            End If
                        End If
                    Next
                    OverrideRemove = False
                End If
            Next

            Dim sTrain As String
            For Each sTrain In TrainsToRemove
                BoxFiveTrainList.Remove(sTrain)
            Next


            If UpdateBoxFiveListEvent Then
                Dim BoxFiveTrain As String
                Dim BoxFiveTrains As String = String.Empty
                Dim TrainCount As Integer
                For Each BoxFiveTrain In BoxFiveTrainList
                    If TrainCount = 0 Then
                        BoxFiveTrains = BoxFiveTrains & "(" & BoxFiveTrain & ")"
                    Else
                        BoxFiveTrains = BoxFiveTrains & "  (" & BoxFiveTrain & ")"
                    End If
                    TrainCount = TrainCount + 1
                Next
                Dim BoxfiveCount As Integer = 1
                Me.txtItem5Arrival1.Text = ""
                Me.txtItem5Arrival2.Text = ""
                Me.txtItem5Arrival3.Text = ""

                For Each BoxFiveTrain In Me.BoxFiveTrainList
                    BoxFiveTrains = BoxFiveTrains & BoxFiveTrain.ToString & ", "
                    Dim txtBoxFive As TextBox = Me.GetBoxFive(BoxfiveCount)
                    If IsNothing(txtBoxFive) Then
                        Dim ErrorMessage As String = "Can Not Find Box Five - After Arrival Trains...Exiting Warrant!"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Exit Sub
                    Else
                        txtBoxFive.Text = BoxFiveTrain
                        txtBoxFive.Enabled = True
                        txtBoxFive.ReadOnly = True
                    End If
                    BoxfiveCount = BoxfiveCount + 1
                Next


            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

