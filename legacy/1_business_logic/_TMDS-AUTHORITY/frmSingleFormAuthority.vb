                            Me.btnBox1.Text = "X"
                        End If
                        ' If Not Me.cmbItem1Void1.Enabled And Me.cmbItem1Void1.Text <> "" Then Exit Sub

                        If thisCheckBox.CheckState = CheckState.Checked Then
                            If Not gBoxOneRequired Then
