    Private Function ConflictCheckItemTwoSixToMOW(ByVal ComponentList As ArrayList, ByVal SearchDirection As String) As Boolean
        '**********************************************************************************************
        '************* Conflict resolution for item 2/9 to MOW over an existing Item 2 to Train********
        '**********************************************************************************************

        Try
            Dim comp As Object
            Dim ErrorMessage As String
            'Dim warr As SFAuthority = Nothing


            'For each trach track in the track selection do the nested checkeds within this loop
            For Each comp In ComponentList
                If comp.TrackAuthorities.Count > 0 Then
                    Dim WarrToCheck As SFAuthority
                    For Each WarrToCheck In comp.TrackAuthorities

                        'Keep track of the warrants found in the track selection
                        If Not WarrantsFoundForBoxSix.Contains(WarrToCheck) Then
                            WarrantsFoundForBoxSix.Add(WarrToCheck)
                        End If

                        'Check to make sure that there are no Item Four Type Warrants
                        If WarrToCheck.AuthType1 = "ItemFourToMOW" Or WarrToCheck.AuthType1 = "ItemFourToTrain" Then
                            ErrorMessage = "Conflict Not Resolvable! Conflicting Type Warrants Found. - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            WarrantsFoundForBoxSix.Clear()
                            Return False
                        ElseIf WarrToCheck.AuthType1 = "ItemTwoToMOW" Then
                            If Me.VoidedWarrant Is Nothing Then
                                Me.VoidedWarrant = WarrToCheck
                                Me.ForceBoxOne = True
                                gBoxOneRequired = True
                            Else
                                If WarrToCheck.AuthorityUID <> Me.VoidedWarrant.AuthorityUID Then
                                    ErrorMessage = "Conflict Not Resolvable! Conflicting Type Warrants Found. - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    WarrantsFoundForBoxSix.Clear()
                                    Return False
                                End If
                            End If
                        End If

                        'Make sure that there are no warrants in the opposing direction
                        If WarrToCheck.Direction <> SearchDirection Then
                            ErrorMessage = "Conflict Not Resolvable! Selection Not In Same Direction of Existing Authority! - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            WarrantsFoundForBoxSix.Clear()
                            Return False
                        End If

                    Next
                End If
            Next comp

            'Go back through the track selection componentlist and check to make sure that
            'the selection does not extend beyond any other train's authority
            Dim MinuminWarrantCount As Integer
            For Each comp In ComponentList
                Dim WarrantCheckValid As Boolean
                If comp.TrackAuthorities.Count > 0 Then

                    'Have a high-water mark for authority counts. 
                    'This helps to ensure this warrant does not extend beyond existing authorities
                    If comp.TrackAuthorities.Count >= MinuminWarrantCount Then
                        MinuminWarrantCount = comp.TrackAuthorities.Count
                    Else
                        'Check to see if existing warrant has Box ten check to allow this one to extend beyond
                        Dim WarrToCheckBoxTen As SFAuthority
                        For Each WarrToCheckBoxTen In comp.TrackAuthorities
                            If Not WarrToCheckBoxTen.Box3Clear Then
                                ErrorMessage = "Conflict Not Resolvable! This Authority CANNOT Extend Beyond Existing Warrants (NO BOX THREE). - EXITING"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                ClearSystemVariables()
                                WarrantsFoundForBoxSix.Clear()
                                Return False
                            End If
                        Next
                    End If

                    Dim WarrantToCheck, WarrantToCrossCheck As SFAuthority
                    For Each WarrantToCheck In comp.TrackAuthorities
                        WarrantCheckValid = False
                        For Each WarrantToCrossCheck In WarrantsFoundForBoxSix
                            If WarrantToCheck.AuthorityUID = WarrantToCrossCheck.AuthorityUID Then
                                WarrantCheckValid = True
                            End If
                        Next

                        If Not WarrantCheckValid Then
                            ErrorMessage = "Conflict Not Resolvable! This Authority CANNOT Extend Beyond Existing Authorities. - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            WarrantsFoundForBoxSix.Clear()
                            Return False
                        Else
                            WarrantCheckValid = False
                        End If
                    Next
                Else

                    'Have a high-water mark for authority counts. 
                    'This helps to ensure this warrant does not extend beyond existing authorities
                    If comp.TrackAuthorities.Count >= MinuminWarrantCount Then
                        MinuminWarrantCount = comp.TrackAuthorities.Count
                    Else
                        'Check to see if existing warrant has Box ten check to allow this one to extend beyond
                        Dim WarrToCheckBoxThree As SFAuthority
                        For Each WarrToCheckBoxThree In WarrantsFoundForBoxSix
                            If Not WarrToCheckBoxThree.Box3Clear Then
                                ErrorMessage = "Conflict Not Resolvable! This Authority CANNOT Extend Beyond Existing Warrants (NO BOX THREE). - EXITING"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                ClearSystemVariables()
                                WarrantsFoundForBoxSix.Clear()
                                Return False
                            End If
                        Next
                    End If


                End If
            Next


            Dim WarrToAddToBoxNine As SFAuthority
            For Each WarrToAddToBoxNine In WarrantsFoundForBoxSix
                If WarrToAddToBoxNine.AuthType1 = "ItemTwoToTrain" Then
                    If Not Me.BoxSixComponents.Contains(WarrToAddToBoxNine.IssueTo) Then
                        Me.BoxSixComponents.Add(WarrToAddToBoxNine.IssueTo)
                    End If
                End If
            Next


            AuthorityEvent("OVERLAP IS VALIDATED FOR AUTHORITY TYPE:" & FirstTypeOfWarrant)
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try

    End Function

