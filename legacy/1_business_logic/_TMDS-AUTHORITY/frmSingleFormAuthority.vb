#Region "OTHER WARRANT CHECKS"

    Private Function CheckForGappedAuthority() As Boolean
        Try
            If AuthorityGapEngineID = Me.cbIssueTo.Text And AuthorityGapChecked Then
                Return True
            End If

            Dim GapFound As Boolean = True
            Dim TrackToCheck As Track
            Dim auth As SFAuthority
            If gBeginTrackSelect.TrackAuthorities.Count > 0 Then
                For Each auth In gBeginTrackSelect.TrackAuthorities
                    If Mid(Me.cbIssueTo.Text, 1, auth.IssueTo.Length) = auth.IssueTo Then
                        GapFound = False
                        Exit For
                    End If
                Next
            End If

            If gSearchDirection = "LEFT" And Not gBeginTrackSelect.OStype Then
                TrackToCheck = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gBeginTrackSelect.RightLink)
                If IsNothing(TrackToCheck) Then
                    GapFound = False
                Else
                    If Mid(TrackToCheck.AuthorityType, 1, 3) <> "TWC" Then
                        GapFound = False
                    Else
                        If TrackToCheck.TrackAuthorities.Count > 0 Then
                            For Each auth In TrackToCheck.TrackAuthorities
                                If Mid(Me.cbIssueTo.Text, 1, 10) = Mid(auth.IssueTo, 1, 10) Then
                                    GapFound = False
                                    Exit For
                                End If
                            Next
                        End If
                    End If
                End If
            ElseIf gSearchDirection = "RIGHT" And Not gBeginTrackSelect.OStype Then
                TrackToCheck = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gBeginTrackSelect.LeftLink)
                If IsNothing(TrackToCheck) Then
                    GapFound = False
                Else
                    If Mid(TrackToCheck.AuthorityType, 1, 3) <> "TWC" Then
                        GapFound = False
                    Else
                        If TrackToCheck.TrackAuthorities.Count > 0 Then
                            For Each auth In TrackToCheck.TrackAuthorities
                                If Mid(Me.cbIssueTo.Text, 1, 10) = Mid(auth.IssueTo, 1, 10) Then
                                    GapFound = False
                                    Exit For
                                End If
                            Next
                        End If
                    End If
                End If
            ElseIf gBeginTrackSelect.OStype Then
                Dim comp As Object
                For Each comp In gBeginTrackSelect.OsComponentCollection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(comp, Track)
                        Dim LeftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trk.LeftLink)
                        Dim RightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trk.RightLink)
                        If Not IsNothing(LeftTrack) Then
                            If Mid(LeftTrack.AuthorityType, 1, 3) <> "TWC" Then
                                If LeftTrack.TrainIDs.Count > 0 Then
                                    Dim trn As TrainID
                                    For Each trn In LeftTrack.TrainIDs
                                        If Mid(Me.cbIssueTo.Text, 1, trn.IdentifingUnit.Length) = trn.IdentifingUnit Then
                                            GapFound = False
                                            Exit For
                                        End If
                                    Next
                                End If
                            Else
                                If LeftTrack.TrackAuthorities.Count > 0 Then
                                    For Each auth In LeftTrack.TrackAuthorities
                                        If Mid(Me.cbIssueTo.Text, 1, 10) = Mid(auth.IssueTo, 1, 10) Then
                                            GapFound = False
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                        End If
                        If Not IsNothing(RightTrack) Then
                            If Mid(RightTrack.AuthorityType, 1, 3) <> "TWC" Then
                                If RightTrack.TrainIDs.Count > 0 Then
                                    Dim trn As TrainID
                                    For Each trn In RightTrack.TrainIDs
                                        If Mid(Me.cbIssueTo.Text, 1, trn.IdentifingUnit.Length) = trn.IdentifingUnit Then
                                            GapFound = False
                                            Exit For
                                        End If
                                    Next
                                End If
                            Else
                                If RightTrack.TrackAuthorities.Count > 0 Then
                                    For Each auth In RightTrack.TrackAuthorities
                                        If Mid(Me.cbIssueTo.Text, 1, 10) = Mid(auth.IssueTo, 1, 10) Then
                                            GapFound = False
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                        End If

                    End If
                Next
            End If

            If Me.IssuedToTrain And Me.FirstTypeOfWarrant = "ItemFourToTrain" Then
                If gEndTrackSelect.TrackAuthorities.Count > 0 Then
                    For Each auth In gEndTrackSelect.TrackAuthorities
                        If Mid(Me.cbIssueTo.Text, 1, auth.IssueTo.Length) = auth.IssueTo Then
                            GapFound = False
                            Exit For
                        End If
                    Next
                End If

                If gSearchDirection = "LEFT" And Not gEndTrackSelect.OStype Then
                    TrackToCheck = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gEndTrackSelect.RightLink)
                    If IsNothing(TrackToCheck) Then
                        GapFound = False
                    Else
                        If Mid(TrackToCheck.AuthorityType, 1, 3) <> "TWC" Then
                            GapFound = False
                        Else
                            If TrackToCheck.TrackAuthorities.Count > 0 Then
                                For Each auth In TrackToCheck.TrackAuthorities
                                    If Mid(Me.cbIssueTo.Text, 1, 10) = Mid(auth.IssueTo, 1, 10) Then
                                        GapFound = False
                                        Exit For
                                    End If
                                Next
                            End If
                        End If
                    End If
                ElseIf gSearchDirection = "RIGHT" And Not gEndTrackSelect.OStype Then
                    TrackToCheck = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gEndTrackSelect.LeftLink)
                    If IsNothing(TrackToCheck) Then
                        GapFound = False
                    Else
                        If Mid(TrackToCheck.AuthorityType, 1, 3) <> "TWC" Then
                            GapFound = False
                        Else
                            If TrackToCheck.TrackAuthorities.Count > 0 Then
                                For Each auth In TrackToCheck.TrackAuthorities
                                    If Mid(Me.cbIssueTo.Text, 1, 10) = Mid(auth.IssueTo, 1, 10) Then
                                        GapFound = False
                                        Exit For
                                    End If
                                Next
                            End If
                        End If
                    End If
                ElseIf gEndTrackSelect.OStype Then
                    Dim comp As Object
                    For Each comp In gEndTrackSelect.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            Dim LeftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trk.LeftLink)
                            Dim RightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trk.RightLink)
                            If Not IsNothing(LeftTrack) Then
                                If Mid(LeftTrack.AuthorityType, 1, 3) <> "TWC" Then
                                    If LeftTrack.TrainIDs.Count > 0 Then
                                        Dim trn As TrainID
                                        For Each trn In LeftTrack.TrainIDs
                                            If Mid(Me.cbIssueTo.Text, 1, trn.IdentifingUnit.Length) = trn.IdentifingUnit Then
                                                GapFound = False
                                                Exit For
                                            End If
                                        Next
                                    End If
                                Else
                                    If LeftTrack.TrackAuthorities.Count > 0 Then
                                        For Each auth In LeftTrack.TrackAuthorities
                                            If Mid(Me.cbIssueTo.Text, 1, 10) = Mid(auth.IssueTo, 1, 10) Then
                                                GapFound = False
                                                Exit For
                                            End If
                                        Next
                                    End If
                                End If
                            End If
                            If Not IsNothing(RightTrack) Then
                                If Mid(RightTrack.AuthorityType, 1, 3) <> "TWC" Then
                                    If RightTrack.TrainIDs.Count > 0 Then
                                        Dim trn As TrainID
                                        For Each trn In RightTrack.TrainIDs
                                            If Mid(Me.cbIssueTo.Text, 1, trn.IdentifingUnit.Length) = trn.IdentifingUnit Then
                                                GapFound = False
                                                Exit For
                                            End If
                                        Next
                                    End If
                                Else
                                    If RightTrack.TrackAuthorities.Count > 0 Then
                                        For Each auth In RightTrack.TrackAuthorities
                                            If Mid(Me.cbIssueTo.Text, 1, 10) = Mid(auth.IssueTo, 1, 10) Then
                                                GapFound = False
                                                Exit For
                                            End If
                                        Next
                                    End If
                                End If
                            End If

                        End If
                    Next
                End If
            End If


            Dim AuthFound As Boolean
            Dim authToCheck As Object
            For Each authToCheck In TMDS.GlobalDeclarations.OtherTrackAuthorities
                If authToCheck.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                    If Mid(authToCheck.IssueTo, 1, 10) = Mid(Me.cbIssueTo.Text, 1, 10) Then
                        AuthFound = True
                        Exit For
                    End If
                End If
            Next
            If Not AuthFound Then
                GapFound = False
            End If

            Dim AuthFoundInCuurentLimits As Boolean
            If AuthFound Then
                Dim comp As Object
                For Each comp In Me.CompleteCompSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(comp, Track)
                        If trk.TrackAuthorities.Count > 0 Then
                            For Each authToCheck In trk.TrackAuthorities
                                If authToCheck.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                                    If Mid(authToCheck.IssueTo, 1, 10) = Mid(Me.cbIssueTo.Text, 1, 10) Then
                                        AuthFoundInCuurentLimits = True
                                        Exit For
                                    End If
                                End If
                            Next
                        End If
                    End If
                Next
            End If
            If AuthFoundInCuurentLimits Then
                GapFound = False
            End If
            If GapFound Then
                Dim LaunchPoint As New Point(Me.Left + 100, Me.Top + 100)
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = Me
                MessageList.Add("THIS AUTHORITY IS NOT CONSECTIVE")
                MessageList.Add("AND WILL RESULT IN A GAP OF AUTHORITY.")
                MessageList.Add("DO YOU WANT TO CONTINUE?")
                MessageList.Add("")
                frmMessageBox.SetMessage(MessageList, "AUTHORITY GAP CHECK", True, LaunchPoint)
                frmMessageBox.ShowDialog()
                If frmMessageBox.FormFeedBack = 6 Then
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    AuthorityGapEngineID = Me.cbIssueTo.Text
                    AuthorityGapChecked = True
                    Return True
                Else
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    Return False
                End If
            Else
                Return True
            End If


        Catch ex As Exception
            TMDS.SystemUtilities.Utilities.SystemException(ex.ToString)
        End Try
    End Function

