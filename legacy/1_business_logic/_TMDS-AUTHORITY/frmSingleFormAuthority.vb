    Private Sub cbIssueTo_Enter(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles cbIssueTo.Enter

        Try
            If Me.Visible And Me.cbIssueTo.Enabled And Me.IssuedToTrain Then
                ShowPendingLockRCPS()
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

    Private Sub cbIssueTo_Leave(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles cbIssueTo.Leave
        Try
            cbIssueTo.DroppedDown = False
            If Me.LockIssueToList Then
                Me.cbIssueTo.Enabled = False

                'If Not Me.CheckToEnableReadButton() Then
                '    Exit Sub
                'End If
                Me.IssueTo = Me.cbIssueTo.Text
                Exit Sub
            End If
            If Not ReadMode Then
                If Me.cbIssueTo.Text.TrimEnd.TrimStart = "" Then
                    Me.cbIssueTo.Text = "ENTER ISSUE TO"
                    Me.cbIssueTo.Focus()
                    SendKeys.Send("{Home}+{End}")
                    Exit Sub
                ElseIf Me.cbIssueTo.Text = "ENTER ISSUE TO" Then
                    Me.cbIssueTo.Focus()
                    SendKeys.Send("{Home}+{End}")
                    Exit Sub
                ElseIf Me.cbIssueTo.Text = "LASTNAME, FIRSTNAME" Then
                    Me.cbIssueTo.Focus()
                    SendKeys.Send("{Home}+{End}")
                    Exit Sub
                End If

                Dim IssueToPos As Integer = InStr(Me.cbIssueTo.Text, " (MOBILE") - 1
                If IssueToPos > 0 Then
                    Me.IssueTo = Mid(Me.cbIssueTo.Text.ToUpper, 1, IssueToPos)
                    Me.MobileClient = True
                    Me.MobileClientForeman = Me.FindForeman(IssueTo)
                Else
                    Me.IssueTo = Me.cbIssueTo.Text.ToUpper
                    'Me.MobileClient = False
                    'Me.MobileClientForeman = Nothing
                End If

                Me.cbIssueTo.Text = TMDS.SystemUtilities.Formatting.FormatProperAuthorityStringForDatabase(IssueTo)

                If Me.IssuedToTrain Then
                    If Not CheckEngineIDFormatting() Then
                        Me.cbIssueTo.Text = "ENTER ENGINE ID"
                        Me.cbIssueTo.Focus()
                        SendKeys.Send("{Home}+{End}")
                        Me.btnRead.Enabled = False
                        Me.btnTransmit.Enabled = False
                        Exit Sub
                    Else
                        Me.cbIssueTo.Enabled = False
                        Dim trnFound As Boolean
                        Dim trn As TrainID
                        For Each trn In TrainCollection
                            If trn.IdentifingUnit = Mid(Me.cbIssueTo.Text, 1, trn.IdentifingUnit.Length) Then
                                trnFound = True
                            End If
                        Next
                        If Not trnFound Then
                            If Me.CheckForBoxOneWarrantInSelectedABSLimits() Then
                                If Not CheckForBeginAuthorityOnPOS() Then
                                    ClearSystemVariables()
                                    CloseForm()
                                    Exit Sub
                                End If

                                If Not CheckForEndAuthorityOnPOS() Then
                                    ClearSystemVariables()
                                    CloseForm()
                                    Exit Sub
                                End If
                            End If
                        Else
                            If Not ForceBoxOne Then 'And optCheckForBoxOneWarrantInSelectedABSLimits Then
                                If CheckForBoxOneWarrantInSelectedABSLimits() Then
                                    If Not CheckForBeginAuthorityOnPOS() Then
                                        ClearSystemVariables()
                                        CloseForm()
                                        Exit Sub
                                    End If
                                    If Not CheckForEndAuthorityOnPOS() Then
                                        ClearSystemVariables()
                                        CloseForm()
                                        Exit Sub
                                    End If
                                End If
                                CheckForBoxFourSixEightMOWInABS()
                            End If
                        End If
                    End If

                    If Me.OpposingAuthoritiesWithBoxFiveToResolve Then
                        If Not CheckForBoxFiveOpposingAuthoritiesInABS() Then
                            Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                            Dim frmMessageBox As frmMessageBox
                            Dim MessageList As New ArrayList()
                            frmMessageBox = New frmMessageBox()
                            frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                            MessageList.Add("THE ISSUANCE TO " & Me.cbIssueTo.Text)
                            MessageList.Add("HAS A BOX FIVE CONFLICT WITH AN EXISTING AUTHORITY.")
                            MessageList.Add("")
                            frmMessageBox.SetMessage(MessageList, "BOX FIVE CHECK", False, LaunchPoint)
                            frmMessageBox.ShowDialog()
                            MessageList.Clear()
                            MessageList = Nothing
                            frmMessageBox.Dispose()
                            frmMessageBox = Nothing

                            Me.cbIssueTo.Text = "ENTER ENGINE ID"
                            Me.cbIssueTo.Focus()
                            SendKeys.Send("{Home}+{End}")
                            Me.btnRead.Enabled = False
                            Me.btnTransmit.Enabled = False
                            Exit Sub
                        End If
                    End If
                    If Me.FirstTypeOfWarrant = "ItemTwoToTrain" Or Me.FirstTypeOfWarrant = "ItemFourToTrain" Then
                        If Not Me.CheckForGappedAuthority Then
                            Me.RestorePendingBoxThirteenSwitches() 'P1-3807
                            ClearSystemVariables()
                            Me.CloseForm()
                            Exit Sub
                        End If
                    End If
                    If gBox8Required Then
                        ResetBoxEightLimits()
                    End If

                    If gItemFiveRequired Then
                        CheckToRemoveItemFiveTrainsFromList()
                    End If
                    If Not CheckToEnsureStartInBoxFourLimitsIfLimitsExist() Then
                        Me.RestorePendingBoxThirteenSwitches()
                        Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                        Dim frmMessageBox As frmMessageBox
                        Dim MessageList As New ArrayList()
                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm
                        MessageList.Add("CURRENT TRACK SELECTION DOES NOT START IN BOX 4 LIMITS.")
                        MessageList.Add("")
                        frmMessageBox.SetMessage(MessageList, "BEGIN IN BOX 4 CHECK", False, LaunchPoint)
                        frmMessageBox.ShowDialog()
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing
                        ClearSystemVariables()
                        Me.CloseForm()
                        Exit Sub
                    End If
                Else
                    If Not CheckMOWIDFormatting() Then
                        Me.cbIssueTo.Text = "LASTNAME, FIRSTNAME"
                        Me.cbIssueTo.Focus()
                        SendKeys.Send("{Home}+{End}")
                        Me.btnRead.Enabled = False
                        Me.btnTransmit.Enabled = False
                        Exit Sub
                    End If
                    Me.cbIssueTo.Enabled = False

                    If Not ForceBoxOne Then 'And optCheckForBoxOneWarrantInSelectedABSLimits Then
                        If CheckForBoxOneWarrantInSelectedABSLimits() Then
                            If Not CheckForBeginAuthorityOnPOS() Then
                                ClearSystemVariables()
                                CloseForm()
                                Exit Sub
                            End If

                            If Not CheckForEndAuthorityOnPOS() Then
                                ClearSystemVariables()
                                CloseForm()
                                Exit Sub
                            End If
                        End If
                        CheckForBoxFourSixEightMOWInABS()
                    Else
                        Me.LoadPotentialVoidAuthorities()
                    End If

                End If
                If PerformLoadPotentialVoidAuthorities Then
                    Me.LoadPotentialVoidAuthorities()
                End If

                Me.IssueTo = Me.cbIssueTo.Text

                If Not Me.CheckToEnableReadButton() Then
                    Exit Sub
                End If


                Me.ReInitVerbiage()
                If Not Me.IssuedToTrain Then
                    DoVehicleLookUp()
                    If optEnableCommaDelimitingFormatingOnMOW Then
                        CheckToFormatMOWID()
                    End If
                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
            ClearSystemVariables()
            Me.CloseForm()
        End Try
    End Sub

