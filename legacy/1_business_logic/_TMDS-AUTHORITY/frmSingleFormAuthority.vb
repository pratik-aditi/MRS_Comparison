    Private Sub CheckDirectionOfFaultSwitch(ByRef DirectionSwitched As Boolean)
        Dim comp As Object = Nothing

        Try
            If Me.IssuedToTrain AndAlso IsWorkAuthority Then
                If myTrainTIWSOccupacny Is Nothing Then Exit Sub
                If myTrainTIWSOccupacny.Count = 0 Then Exit Sub
                Dim TZN As TrackZone = myTrainTIWSOccupacny(0)
                If TZN IsNot Nothing AndAlso TZN.TrackList IsNot Nothing AndAlso TZN.TrackList.Count > 0 Then
                    Dim FirstObject As Object = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(TZN.TrackList)
                    For Each comp In CompleteCompSelection
                        If comp.GetType.ToString = gTrackComponentName Then
                            If TZN.TrackList.Contains(comp) AndAlso Not comp Is gBeginTrackSelect Then
                                FirstObject = comp
                                Exit For
                            End If
                        End If
                    Next
                    If FirstObject IsNot Nothing Then
                        Dim OkToProceed As Boolean = False
                        Dim SwToCheck As Switch = Nothing
                        For Each comp In CompleteCompSelection
                            If comp.GetType.ToString = gSwitchComponentName Then
                                Dim SW As Switch = TryCast(comp, Switch)
                                If SW IsNot Nothing Then
                                    If SW.SwitchPointerMonitorMode AndAlso (SW.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or SW.FailState) Then
                                        OkToProceed = True
                                        SwToCheck = SW
                                        Exit For
                                    End If
                                End If

                            End If
                        Next
                        If Not OkToProceed Then Exit Sub
                        If SwToCheck Is Nothing Then Exit Sub
                        Dim LastComp As Object = FirstObject
                        Dim DirectionOfFaultSwitch As String = ""
                        For i As Integer = 0 To CompleteCompSelection.Count - 1
                            If LastComp Is Nothing Then Exit For
                            Select Case LastComp.GetType.ToString
                                Case gSwitchComponentName
                                    If LastComp Is SwToCheck Then
                                        DirectionOfFaultSwitch = "LEFT"
                                        Exit For
                                    ElseIf Not CompleteCompSelection.Contains(LastComp) Then
                                        Exit For
                                    End If
                            End Select
                            LastComp = FindCompFromGUID(LastComp.LeftLink)
                        Next
                        If DirectionOfFaultSwitch.Trim = "" Then
                            LastComp = FirstObject
                            For i As Integer = 0 To CompleteCompSelection.Count - 1
                                If LastComp Is Nothing Then Exit For
                                Select Case LastComp.GetType.ToString
                                    Case gSwitchComponentName
                                        If LastComp Is SwToCheck Then
                                            DirectionOfFaultSwitch = "RIGHT"
                                            Exit For
                                        ElseIf Not CompleteCompSelection.Contains(LastComp) Then
                                            Exit For
                                        End If
                                End Select
                                LastComp = FindCompFromGUID(LastComp.RightLink)
                            Next
                        End If

                        If Not String.IsNullOrEmpty(DirectionOfFaultSwitch) AndAlso DirectionOfFaultSwitch.Trim <> "" Then
                            If gSearchDirection = DirectionOfFaultSwitch Then
                            Else
                                DirectionSwitched = True
                            End If
                        End If

                    End If
                End If

            End If
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Sub

    Private Function ValidateSwitchPointsInRouteBox4(ByVal CompList As ArrayList, Direction As String, FirstTrack As Track) As ArrayList
        Try
            Dim newList As New ArrayList
            Dim comp As Object
            Dim StartAtPOS As Boolean
            For Each comp In CompList
                If comp.GetType.ToString = gSwitchComponentName Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.SwitchPointerMonitorMode Then
                        If (sw.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or sw.FailState) And CompList.IndexOf(sw) <> 0 Then
                            Select Case sw.ComponentType
                                Case "SPRT", "SPRB"
                                    If gSearchDirection = "RIGHT" Then
                                        If Not newList.Contains(comp) Then newList.Add(comp)
                                    End If
                                Case "SPLT", "SPLB"
                                    If gSearchDirection = "LEFT" Then
                                        If Not newList.Contains(comp) Then newList.Add(comp)
                                    End If
                                Case Else
                                    If gSearchDirection = "RIGHT" Then
                                        If sw.RightAltLink <> 0 Then
                                            If Not newList.Contains(comp) Then newList.Add(comp)
                                            AddTracksThatTouchSwitch(newList, sw)
                                            Return newList
                                        ElseIf sw.LeftAltLink <> 0 Then
                                            If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                                                If gBeginTrackSelect.OsComponentCollection.Contains(sw) Then
                                                    If Not newList.Contains(comp) Then newList.Add(comp)
                                                    AddTracksThatTouchSwitch(newList, sw)
                                                    StartAtPOS = True
                                                End If
                                            End If
                                        End If
                                    Else
                                        If sw.LeftAltLink <> 0 Then
                                            If Not newList.Contains(comp) Then newList.Add(comp)
                                            AddTracksThatTouchSwitch(newList, sw)
                                            Return newList
                                        ElseIf sw.RightAltLink <> 0 Then
                                            If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                                                If gBeginTrackSelect.OsComponentCollection.Contains(sw) Then
                                                    If Not newList.Contains(comp) Then newList.Add(comp)
                                                    AddTracksThatTouchSwitch(newList, sw)
                                                    StartAtPOS = True
                                                End If
                                            End If
                                        End If
                                    End If
                                    If sw.ProtectOpenSwitchEnabled Then
                                        If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                                            If gBeginTrackSelect.OsComponentCollection.Contains(sw) Then
                                                StartAtPOS = True
                                                CheckToAddBeginningPOSToBox12(sw)
                                            End If
                                        End If
                                    End If
                                    If Not StartAtPOS Then
                                        Return RemoveOsTracks(newList, sw)
                                    End If
                            End Select
                            If Not StartAtPOS Then
                                Return newList
                            Else
                                StartAtPOS = False
                            End If
                        End If
                    End If
                End If
                If Not newList.Contains(comp) Then newList.Add(comp)
            Next
            Return newList
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

    Private Function ValidateSwitchPointsInRoute(ByVal CompList As ArrayList) As ArrayList
        Try
            Dim newList As New ArrayList
            Dim comp As Object
            Dim StartAtPOS As Boolean
            For Each comp In CompList
                If comp.GetType.ToString = gSwitchComponentName Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.SwitchPointerMonitorMode Then
                        If (sw.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or sw.FailState) And CompList.IndexOf(sw) <> 0 Then
                            Select Case sw.ComponentType
                                Case "SPRT", "SPRB"
                                    If gSearchDirection = "RIGHT" Then
                                        If Not newList.Contains(comp) Then newList.Add(comp)
                                    End If
                                Case "SPLT", "SPLB"
                                    If gSearchDirection = "LEFT" Then
                                        If Not newList.Contains(comp) Then newList.Add(comp)
                                    End If
                                Case Else
                                    If gSearchDirection = "RIGHT" Then
                                        If sw.RightAltLink <> 0 Then
                                            If Not newList.Contains(comp) Then newList.Add(comp)
                                            AddTracksThatTouchSwitch(newList, sw)
                                            Return newList
                                        ElseIf sw.LeftAltLink <> 0 Then
                                            If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                                                If gBeginTrackSelect.OsComponentCollection.Contains(sw) Then
                                                    If Not newList.Contains(comp) Then newList.Add(comp)
                                                    AddTracksThatTouchSwitch(newList, sw)
                                                    StartAtPOS = True
                                                End If
                                            End If
                                        End If
                                    Else
                                        If sw.LeftAltLink <> 0 Then
                                            If Not newList.Contains(comp) Then newList.Add(comp)
                                            AddTracksThatTouchSwitch(newList, sw)
                                            Return newList
                                        ElseIf sw.RightAltLink <> 0 Then
                                            If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                                                If gBeginTrackSelect.OsComponentCollection.Contains(sw) Then
                                                    If Not newList.Contains(comp) Then newList.Add(comp)
                                                    AddTracksThatTouchSwitch(newList, sw)
                                                    StartAtPOS = True
                                                End If
                                            End If
                                        End If
                                    End If
                                    If sw.ProtectOpenSwitchEnabled Then
                                        If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                                            If gBeginTrackSelect.OsComponentCollection.Contains(sw) Then
                                                StartAtPOS = True
                                                CheckToAddBeginningPOSToBox12(sw)
                                            End If
                                        End If
                                    End If
                                    If Not StartAtPOS Then
                                        Return RemoveOsTracks(newList, sw)
                                    End If
                            End Select
                            If Not StartAtPOS Then
                                Return newList
                            Else
                                StartAtPOS = False
                            End If
                        End If
                    End If
                End If
                If Not newList.Contains(comp) Then newList.Add(comp)
            Next
            Return newList
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

    Private Sub ValidateSwitchPointsInRoute(ByRef CompList As ArrayList, ZoneBehindTrain As ArrayList)
        Try
            Dim newList As New ArrayList
            Dim comp As Object
            Dim StartAtPOS As Boolean
            For Each comp In CompList
                If comp.GetType.ToString = gSwitchComponentName Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.SwitchPointerMonitorMode Then
                        If (sw.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or sw.FailState) And CompList.IndexOf(sw) <> 0 Then
                            Select Case sw.ComponentType
                                Case "SPRT", "SPRB"
                                    If gSearchDirection = "RIGHT" Then
                                        If Not newList.Contains(comp) Then newList.Add(comp)
                                    End If
                                Case "SPLT", "SPLB"
                                    If gSearchDirection = "LEFT" Then
                                        If Not newList.Contains(comp) Then newList.Add(comp)
                                    End If
                                Case Else
                                    If gSearchDirection = "RIGHT" Then
                                        If sw.RightAltLink <> 0 Then
                                            If Not newList.Contains(comp) Then newList.Add(comp)
                                            AddTracksThatTouchSwitch(newList, sw)
                                            Dim SwZOne As String = FindTrackZoneofTheSwitch(sw)
                                            If SwZOne IsNot Nothing AndAlso ZoneBehindTrain IsNot Nothing AndAlso ZoneBehindTrain.Count > 0 Then
                                                If Not ZoneBehindTrain.Contains(SwZOne) Then Exit For
                                            Else
                                                Exit For
                                            End If

                                        ElseIf sw.LeftAltLink <> 0 Then
                                            If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                                                If gBeginTrackSelect.OsComponentCollection.Contains(sw) Then
                                                    If Not newList.Contains(comp) Then newList.Add(comp)
                                                    AddTracksThatTouchSwitch(newList, sw)
                                                    StartAtPOS = True
                                                End If
                                            End If
                                        End If
                                    Else
                                        If sw.LeftAltLink <> 0 Then
                                            If Not newList.Contains(comp) Then newList.Add(comp)
                                            AddTracksThatTouchSwitch(newList, sw)
                                            Dim SwZOne As String = FindTrackZoneofTheSwitch(sw)
                                            If SwZOne IsNot Nothing AndAlso ZoneBehindTrain IsNot Nothing AndAlso ZoneBehindTrain.Count > 0 Then
                                                If Not ZoneBehindTrain.Contains(SwZOne) Then Exit For
                                            Else
                                                Exit For
                                            End If
                                            'Exit For
                                        ElseIf sw.RightAltLink <> 0 Then
                                            If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                                                If gBeginTrackSelect.OsComponentCollection.Contains(sw) Then
                                                    If Not newList.Contains(comp) Then newList.Add(comp)
                                                    AddTracksThatTouchSwitch(newList, sw)
                                                    StartAtPOS = True
                                                End If
                                            End If
                                        End If
                                    End If
                                    If sw.ProtectOpenSwitchEnabled Then
                                        If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                                            If gBeginTrackSelect.OsComponentCollection.Contains(sw) Then
                                                StartAtPOS = True
                                                CheckToAddBeginningPOSToBox12(sw)
                                            End If
                                        End If
                                    End If
                                    If Not StartAtPOS Then
                                        newList = RemoveOsTracks(newList, sw)
                                        Exit For
                                    End If
                            End Select
                            If Not StartAtPOS Then
                                Exit For
                            Else
                                StartAtPOS = False
                            End If
                        End If
                    End If
                End If
                If Not newList.Contains(comp) Then newList.Add(comp)
            Next

            CopyArrayCollection(CompList, newList)
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

