    Private Function BoxSixInit() As Boolean
        Try
            Dim ErrorMessage As String
            If Me.BoxSixComponents.Count = 0 Then
                ErrorMessage = "Can Not Find Box Six Trains...Exiting Authority!"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Exit Function
            End If

            Dim BoxSixTrains As String = String.Empty
            Dim BoxSixTrain As String = String.Empty
            Dim TrainCount As Integer = 1
            For Each BoxSixTrain In Me.BoxSixComponents
                If BoxSixTrain.Trim = "" Then
                    ErrorMessage = "Can Not Find Box Six Trains...Exiting Authority!"
                    AuthorityEvent(ErrorMessage)
                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    ClearSystemVariables()
                    Exit Function
                End If
                Select Case TrainCount
                    Case 1
                        Me.txtItem6Behind1.Text = BoxSixTrain
                    Case 2
                        Me.txtItem6Behind2.Text = BoxSixTrain
                    Case 3
                        Me.txtItem6Behind3.Text = BoxSixTrain
                    Case Else
                        Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Left + 300, 300)

                        ErrorMessage = "NO MORE THAN 3 BOX SIX TRAINS...EXITING AUTHORITY!"
                        Dim frmMessageBox As frmMessageBox
                        Dim MessageList As New ArrayList()
                        MessageList.Add(ErrorMessage)
                        MessageList.Add("")
                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = Me
                        frmMessageBox.SetMessage(MessageList, "SYSTEM MESSAGE", False, LaunchPoint)
                        frmMessageBox.ShowDialog()
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing
                        'AuthorityEvent(ErrorMessage)
                        'MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Return False
                End Select
                TrainCount = TrainCount + 1
                BoxSixTrains = BoxSixTrains & BoxSixTrain.ToString & "|"
            Next

            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Function

    Private Function FillBoxElevenComboBoxs(ByVal ComponentSelection As ArrayList, ByVal SearchDirection As String) As Boolean
        Dim comp As Object
        Try

            If SearchDirection = "RIGHT" Then
                For Each comp In ComponentSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If Not Me.cmbBox8From.Items.Contains(comp.LeftLimitName) Then
                            Me.cmbBox8From.Items.Add(comp.LeftLimitName)
                        End If
                    End If
                Next
                ComponentSelection.Reverse()
                For Each comp In ComponentSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If Not Me.cmbBox8To.Items.Contains(comp.RightLimitName) Then
                            Me.cmbBox8To.Items.Add(comp.RightLimitName)
                        End If
                    End If
                Next
                ComponentSelection.Reverse()

            Else

                For Each comp In ComponentSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If Not Me.cmbBox8From.Items.Contains(comp.RightLimitName) Then
                            Me.cmbBox8From.Items.Add(comp.RightLimitName)
                        End If
                    End If
                Next
                ComponentSelection.Reverse()
                For Each comp In ComponentSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If Not Me.cmbBox8To.Items.Contains(comp.LeftLimitName) Then
                            Me.cmbBox8To.Items.Add(comp.LeftLimitName)
                        End If
                    End If
                Next
                ComponentSelection.Reverse()

            End If

            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try

    End Function

    Private Function CheckForNeedsRollUp(ByVal auth As SFAuthority, ByVal LaunchPoint As Point) As Boolean
        Try
            Dim FirstTrack As Track = auth.Components.Item(0)
            Dim ItemFourTrainAuthority As Boolean
            Dim ItemFourMOWAuthority As Boolean
            If auth.AuthType1 = "ItemFourToTrain" Then
                ItemFourTrainAuthority = True
            ElseIf auth.AuthType1 = "ItemFourToMOW" Then
                ItemFourMOWAuthority = True
            End If
            Dim OverridePrompt As Boolean
            If Me.CompleteCompSelection.Contains(FirstTrack) Then OverridePrompt = True
            ItemFourMOWAuthority = True
            If Not OverridePrompt Or ItemFourTrainAuthority Or ItemFourMOWAuthority Then
                If gBeginTrackSelect.Name <> FirstTrack.Name Or gBeginTrackSelect.StationNumber <> FirstTrack.StationNumber Or ItemFourTrainAuthority Or ItemFourMOWAuthority Then
                    Dim frmMessageBox As frmMessageBox
                    Dim MessageList As New ArrayList()
                    MessageList.Add("HAS " & auth.IssueTo & optRollUpAuthorityString25)
                    MessageList.Add("THE BEGINNING OF THIS NEW AUTHORITY?")
                    MessageList.Add("")
                    MessageList.Add("SELECT YES TO CONFIRM.")
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = FirstTrack.CurrentDrawingForm
                    frmMessageBox.SetMessage(MessageList, optRollUpAuthorityString21, True, LaunchPoint)
                    frmMessageBox.ShowDialog()
                    If frmMessageBox.FormFeedBack <> 6 Then
                        AuthorityEvent("SELECTED - NO TO ROLL UP CONFIRMATION OF " & auth.IssueTo)
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing
                        Return False
                    Else
                        CheckForRollUpConfirmed = True
                        AuthorityEvent("SELECTED - YES TO ROLL UP CONFIRMATION OF " & auth.IssueTo)
                    End If
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                End If
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Function SetUpTrackWarrantForm(ByVal FirstWarrantType As String, ByVal SecondWarrantType As String) As Boolean

        Dim ErrorMessage As String
        Try
            'START ADDING THE ATTRIBUTES TO THE FORM
            Me.lblRailroadName.Text = CurrentSelectedTerritory.RailRoadName
            Me.lblDispInt.Text = gDispatcherFormTitle
