    Private Sub LoadPotentialVoidAuthorities()
        Try
            Dim auth As Object
            If cmbItem1Void1.Enabled Then
                Me.cmbItem1Void1.Items.Clear()
            End If
            If Me.cmbItem1Void2.Enabled Then
                Me.cmbItem1Void2.Items.Clear()
            End If

            If Me.cmbItem1Void3.Enabled Then
                Me.cmbItem1Void3.Items.Clear()
            End If

            PotentialAuthoritiesToVoid.Clear()

            For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                    Dim sfa As SFAuthority = CType(auth, SFAuthority)
                    'If Mid(sfa.IssueTo, 1, 10) = Mid(Me.cbIssueTo.Text, 1, 10) Then
                    If (Mid(sfa.IssueTo, 1, 10) = Mid(Me.cbIssueTo.Text, 1, 10) And sfa.IssuedToTrain) Or (Not sfa.IssuedToTrain And sfa.IssueTo = Me.cbIssueTo.Text) Then
                        If Me.cmbItem1Void1.Enabled Then
                            Me.cmbItem1Void1.Items.Add(sfa.AuthorityUID)
                        End If
                        If Me.cmbItem1Void2.Enabled Then
                            If Not cmbItem1Void1.Text = sfa.AuthorityUID Then
                                Me.cmbItem1Void2.Items.Add(sfa.AuthorityUID)
                            End If
                        End If
                        If Me.cmbItem1Void2.Enabled Then
                            If Not cmbItem1Void1.Text = sfa.AuthorityUID And Not cmbItem1Void2.Text = sfa.AuthorityUID Then
                                Me.cmbItem1Void3.Items.Add(sfa.AuthorityUID)
                            End If
                        End If

                        PotentialAuthoritiesToVoid.Add(sfa.AuthorityUID)
                    End If
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

