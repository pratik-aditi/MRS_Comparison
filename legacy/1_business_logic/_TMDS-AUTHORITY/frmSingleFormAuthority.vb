    Private Sub btnRepeat_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnRepeat.Click
        Try
            SystemEvent("CHANGE EVENT RECORDED FOR AUTHORITY NUMBER:" & AuthorityNumberString & ". REPEAT BUTTON SELECTED.")


            OKTime = "00:00"
            Me.RepeatMode = True

            Dim gHistoryMessage As String
            Dim SFA As New TrackAuthority.SFAuthority()
            Me.mySFAuthority = SFA
            Me.mySFAuthority.MobileClientForeman = Me.MobileClientForeman

            If Not PerformFinalChecksDuringIssuance() Then
                ClearSystemVariables()
                Me.CloseForm()
                Exit Sub
            End If

            If gTrackIntegrityMonitoringExists Then
                UpdateOverrideList()
            End If


            If SFA.AddAuthorityToComponents(Me, ItemOneAuthorityToBeReplaced) Then
                Me.AuthorityEvent("TNT AUTHORITY APPLIED TO COMPONENTS SUCCESSFULLY:" & SFA.AuthorityUID)
            Else
                gHistoryMessage = "SYSTEM ERROR! PLEASE CONSIDER TRACK AUTHORITY (" & Me.AuthorityNumberString & ") NOT IN EFFECT! CONTACT SYSTEM ADMINISTRATOR IMMEDIATELY!"
                AuthorityEvent(gHistoryMessage)
                MessageBox.Show(Me, gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Me.CloseForm()
                Exit Sub
            End If

            If SFA.AddAuthorityToDB(IssuedToMOW) Then
                Me.AuthorityEvent("AUTHORITY APPLIED TO DATABASE SUCCESSFULLY:" & SFA.AuthGUID)
                'SFA.ApplyTrackAuthToRemoteLinks()
            Else
                gHistoryMessage = "SYSTEM DATABASE ERROR! PLEASE CONSIDER TRACK AUTHORITY (" & Me.AuthorityNumberString & ") NOT IN EFFECT! CONTACT SYSTEM ADMINISTRATOR IMMEDIATELY!"
                AuthorityEvent(gHistoryMessage)
                MessageBox.Show(Me, gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Me.CloseForm()
                Exit Sub
            End If
            Me.CommitDataForBOSAPI()
            Me.mySFAuthority.Pending = True
            Dim SummItem As New SummaryItem("AUTHORITY", "ADD", SFA)
            SyncLock gSummaryAuthQueue.SyncRoot
                gSummaryAuthQueue.Enqueue(SummItem)
            End SyncLock

            Me.btnRepeat.Visible = False
            Me.btnVoid.Visible = True
            Me.lvVerbiage.Focus()
            Me.lvVerbiage.Items(0).Selected = True
            Me.Text = "LISTEN AND CONFIRM TRACK WARRANT " & AuthorityNumberString
            If Not Me.IssuedToTrain Then
                Dim UpdateMowEntry As New UpdateMowRecord(AddressOf Me.MowForemanUpdate)
                UpdateMowEntry.BeginInvoke(SFA.IssueTo, Nothing, Nothing)
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

