#Region "BUILD THE TRACK AUTHORITY"

    Public Function BuildAuthorityFromMobileRequest(ByVal AuthorityType As String, ByRef TrackSelection As ArrayList, ByVal MobileMess As MobileMessage, Optional ByVal TypeOfAuthority As String = "") As Boolean
        Dim comp As Object
        Dim ErrorMessage, SystemMessage As String
        Dim FirstWarrantType As String = "ItemFourToMOW"
        Dim SecondWarrantType As String = ""
        Dim ComponentSelectionSecondary As ArrayList = Nothing
        Dim FormLaunchPoint As Point
        Dim EicEnabled As String = " (MOBILE CLIENT)"
        If TypeOfAuthority.Trim <> "" Then
            FirstWarrantType = TypeOfAuthority
        End If

        Try
            Me.btnTransmit.Visible = False
            If IsNothing(gBeginTrackSelect) Then
                gBeginTrackSelect = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(TrackSelection)
            End If
            If IsNothing(gEndTrackSelect) Then
                gEndTrackSelect = TMDS.SystemUtilities.FetchData.FindLastTrackInList(TrackSelection)
            End If

            Try
                FormLaunchPoint = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
            Catch
                FormLaunchPoint = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + TMDS.SystemForms.MySystemForms.frmMainMDI.Width / 2 - 100, 150)
            End Try

            MobileClientAuthorityRequest = True 
            Me.btnRead.Enabled = True
            Me.thisMobilemessage = MobileMess
            Me.MobileClient = True
            Me.MobileClientForeman = Me.FindMobileClient(MobileMess)
            If IsNothing(Me.MobileClientForeman) Then       
                ErrorMessage = "THERE IS NO MOBILE CLIENT ASSIGNED TO THIS TERRITORY."
                Me.AuthorityEvent(ErrorMessage)
                MessageBox.Show(SystemForms.MySystemForms.frmMainMDI, ErrorMessage, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                Return False
            End If

            If Not IsNothing(MobileMess.authVehicleList) Then
                If MobileMess.authVehicleList.Count > 0 Then
                    Dim v As String
                    For Each v In MobileMess.authVehicleList
                        If Trim(v) <> "" Then
                            Me.lvVehicles.Items.Add(v)
                        End If
                    Next
                End If
            End If
            'LoadMOW()
            Me.cbIssueTo.Text = MobileClientForeman.LastName.ToUpper & ", " & MobileClientForeman.FirstName.ToUpper '& EicEnabled
            Me.IssueTo = Me.cbIssueTo.Text.ToUpper
            Me.cbIssueTo.Enabled = False
            If MobileMess.authJointStatus Then

            End If
            If MobileMess.authDirection = "" Then
                gSearchDirection = "RIGHT"
            Else
                gSearchDirection = MobileMess.authDirection
            End If
            Dim SearchDirection As String = gSearchDirection

            'If MobileMess.SFAVoidAuthList IsNot Nothing AndAlso MobileMess.SFAVoidAuthList.Count > 0 Then
            '    ForceBoxOne = True
            '    LoadForcedVoidAuthoritiesFromMM(MobileMess.SFAVoidAuthList)
            'End If

            CompleteCompSelection = TrackSelection.Clone

            AddGroupBoxesToList()
            AddCheckItemToList()
            AddCheckBoxToList()
            Me.AddCheckButtonToList()   

            'If InStr(FirstWarrantType, "MOW") = 0 Then
            '    Me.IssuedToTrain = True
            'End If
            IssuedToMOW = True

            Me.AddOsComponentsToSelection(CompleteCompSelection)

            'GET THE AUTHORITY NUMBER
            'GET THE AUTHORITY NUMBER
            If optEnableNumberPools Then
                AuthorityNumber = gRailroadInformation.GetNextNumberFromPool(RailroadInformation.PoolNumberTypes.TrackAndTime)
                AuthorityNumberString = AuthorityNumber

            ElseIf Not optUseWorkstationAuthorityNumbering Then
                If CurrentSelectedTerritory Is Nothing Then
                    AuthorityNumber = 0
                Else
                    AuthorityNumber = CurrentSelectedTerritory.GetNextAuthorityNumber(True)
                    AuthorityNumberString = Me.CurrentSelectedTerritory.TerritoryID.ToString & " - " & AuthorityNumber.ToString
                End If
            Else
                AuthorityNumber = TMDS.GlobalDeclarations.gThisWorkstation.GetNextAuthorityNumber()
                AuthorityNumberString = AuthorityNumber
            End If

            If AuthorityNumber = 0 Then
                Dim Message As String = "COULD NOT RETRIEVE NEXT AUTHORITY NUMBER!"
                MessageBox.Show(Me, Message, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                Me.AuthorityEvent(Message)
                Me.Valid = False
                Me.CloseForm()
            End If

            Dim MOWTypeOfAuthority As Boolean
            If InStr(FirstWarrantType, "MOW") Then
                MOWTypeOfAuthority = True
            End If

            'Check to see if box three will be needed
            'What determines a box three are tracks being different or authority type differences.
            Dim CompToCheck As Object
            Dim FirstTrackFound As String

            FirstTrackSelection = FirstCompList
            SecondTrackSelection = SecondCompList
            ThirdTrackSelection = ThirdCompList

            DirectionOfTheWarrant = SearchDirection
            FirstTypeOfWarrant = FirstWarrantType
            SecondTypeOfWarrant = SecondWarrantType

            SecondaryCompSelection = ComponentSelectionSecondary


            'initialize the selection
            FirstTrackFound = gBeginTrackSelect.TrackName

            Dim CurrentArrayList As ArrayList = FirstCompList
            Dim LimitsChangeDetected As Boolean
            Dim NumOfLimitChanges As Integer
            Dim LastCompToCheck As Track = gBeginTrackSelect
            For Each CompToCheck In CompleteCompSelection
                If CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trkToChk As Track = CType(CompToCheck, Track)

                    If ((MOWTypeOfAuthority And trkToChk.LeftAltLink <> 0 And gSearchDirection = "RIGHT") Or _
                       (MOWTypeOfAuthority And trkToChk.RightAltLink <> 0 And gSearchDirection = "LEFT")) And _
                         Not gBeginTrackSelect Is trkToChk And (LastCompToCheck.Name <> trkToChk.Name) Then
                        If NumOfLimitChanges >= 1 Then
                            ErrorMessage = "TOO MANY CHANGES IN AUTHORITY FOR MOW FOUND IN SELECTION. EXITING!"
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                            AuthorityEvent(ErrorMessage)
                            ClearSystemVariables()
                            Exit Function
                        End If
                        LimitsChangeDetected = True
                        NumOfLimitChanges += 1
                    End If
                    LastCompToCheck = trkToChk
                End If

                If CompToCheck.TrackName = FirstTrackFound And Not LimitsChangeDetected Then
                    CurrentArrayList.Add(CompToCheck)
                Else
                    If IsNothing(SecondCompList) Then
                        SecondCompList = New ArrayList()
                        CurrentArrayList = SecondCompList
                        CurrentArrayList.Add(CompToCheck)
                        FirstTrackFound = CompToCheck.TrackName
                        LimitsChangeDetected = False
                    Else
                        If IsNothing(ThirdCompList) And optEnableThreeLineAuthorityLimits Then
                            ThirdCompList = New ArrayList()
                            CurrentArrayList = ThirdCompList
                            CurrentArrayList.Add(CompToCheck)
                            FirstTrackFound = CompToCheck.TrackName
                        Else
                            ErrorMessage = "TOO MANY NON-CONTINUOUS TRACK TYPES FOUND IN SELECTION. Exiting!"
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                            AuthorityEvent(ErrorMessage)
                            ClearSystemVariables()
                            Exit Function
                        End If
                    End If
                End If
            Next

            FirstTrackFound = ""
            If Not IsNothing(ComponentSelectionSecondary) Then
                For Each CompToCheck In ComponentSelectionSecondary
                    If CompToCheck.TrackName = FirstTrackFound Then
                        CurrentArrayList.Add(CompToCheck)
                    Else
                        If IsNothing(SecondCompList) Then
                            SecondCompList = New ArrayList()
                            CurrentArrayList = SecondCompList
                            CurrentArrayList.Add(CompToCheck)
                            FirstTrackFound = CompToCheck.TrackName
                        Else
                            If IsNothing(ThirdCompList) Then
                                ThirdCompList = New ArrayList()
                                CurrentArrayList = ThirdCompList
                                CurrentArrayList.Add(CompToCheck)
                                FirstTrackFound = CompToCheck.TrackName
                            Else
                                ErrorMessage = "TOO MANY NON-CONTINUOUS TRACK TYPES FOUND IN SELECTION. Exiting!"
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                AuthorityEvent(ErrorMessage)
                                ClearSystemVariables()
                                Exit Function
                            End If
                        End If
                    End If
                Next
            End If


            'Check each track selection collection for conflict resolution
            'Check the first selection
            If FirstCompList Is Nothing Then
                ClearSystemVariables()
                Exit Function
            End If

            'Set the verbiage based on direction and type of warrant (i.e. Item2 or Item4)
            Dim FirstTrack1 As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(FirstCompList)
            Dim LastTrack1 As Track = FindLastTrackInList(FirstCompList) 'FirstCompList.Item(FirstCompList.Count - 1)

            Me.CurrentTimeZone = FirstTrack1.TimeZone.ToUpper
            SetCurrentTimeZone()
            Me.thisSubdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(FirstTrack1.SubdivisionID)


            If Not ConflictResolution(FirstCompList, FirstWarrantType, SearchDirection) Then
                ClearSystemVariables()
                Exit Function
            Else
                'set the type of track warrant (i.e. item2 or item4)
                If Mid(FirstWarrantType, 1, 7) = "ItemTwo" Then
                    ForceBoxTwo = True
                Else
                    ForceBoxFour = True
                End If


                If SearchDirection = "RIGHT" Then
                    BoxFrom1 = FirstTrack1.LeftLimitName
                    BoxTo1 = LastTrack1.RightLimitName
                    BoxTrack1 = FirstTrack1.TrackName
                ElseIf SearchDirection = "LEFT" Then
                    BoxFrom1 = FirstTrack1.RightLimitName
                    BoxTo1 = LastTrack1.LeftLimitName
                    BoxTrack1 = FirstTrack1.TrackName
                Else
                    ErrorMessage = "Direction of Warrant Not Established!"
                    AuthorityEvent((ErrorMessage & " - EXIT SUB"))
                    ClearSystemVariables()
                    Exit Function
                End If

            End If



            'Check second track selection if it exists
            If Not SecondCompList Is Nothing Then
                If Not ConflictResolution(SecondCompList, FirstWarrantType, SearchDirection) Then
                    ClearSystemVariables()
                    Exit Function
                Else
                    SecondLineNeeded = True
                    Dim FirstTrack As Track = SecondCompList.Item(0)
                    Dim LastTrack As Track = FindLastTrackInList(SecondCompList) 'SecondCompList.Item(SecondCompList.Count - 1)

                    If SearchDirection = "RIGHT" Then
                        BoxFrom2 = FirstTrack.LeftLimitName
                        BoxTo2 = LastTrack.RightLimitName
                        BoxTrack2 = FirstTrack.TrackName
                    ElseIf SearchDirection = "LEFT" Then
                        BoxFrom2 = FirstTrack.RightLimitName
                        BoxTo2 = LastTrack.LeftLimitName
                        BoxTrack2 = FirstTrack.TrackName
                    Else
                        ErrorMessage = "Direction of Warrant Not Established for Box Three Type!"
                        AuthorityEvent((ErrorMessage & " - EXIT SUB"))
                        ClearSystemVariables()
                        Exit Function
                    End If
                End If
            End If

            'Check second track selection if it exists
            If Not ThirdCompList Is Nothing Then
                If Not ConflictResolution(ThirdCompList, FirstWarrantType, SearchDirection) Then
                    ClearSystemVariables()
                    Exit Function
                Else
                    ThirdLineNeeded = True
                    'Set the verbiage based on direction and type of warrant FOR box3)
                    Dim FirstTrack As Track = ThirdCompList.Item(0)
                    Dim LastTrack As Track = FindLastTrackInList(ThirdCompList) 'ThirdCompList.Item(ThirdCompList.Count - 1)

                    If SearchDirection = "RIGHT" Then
                        BoxFrom3 = FirstTrack.LeftLimitName
                        BoxTo3 = LastTrack.RightLimitName
                        BoxTrack3 = FirstTrack.TrackName
                    ElseIf SearchDirection = "LEFT" Then
                        BoxFrom3 = FirstTrack.RightLimitName
                        BoxTo3 = LastTrack.LeftLimitName
                        BoxTrack3 = FirstTrack.TrackName
                    Else
                        ErrorMessage = "Direction of Warrant Not Established for Box Three Type!"
                        AuthorityEvent((ErrorMessage & " - EXIT SUB"))
                        ClearSystemVariables()
                        Exit Function
                    End If
                End If
            End If


            If Not CheckForBlockSwitches(FirstCompList) Then
                Return False
            End If


            'Fill Box Eleven Combo Boxes with limit selections
            If Not FillBoxElevenComboBoxs(CompleteCompSelection, SearchDirection) Then
                ErrorMessage = "Box Eleven Limits Fill Sub Error!"
                AuthorityEvent((ErrorMessage & " - EXIT SUB"))
                ClearSystemVariables()
                Exit Function
            End If


            'Box Eleven Initial Check for the limits selected in Item 4 type warrants only
            'If Mid(FirstWarrantType, 1, 8) = "ItemFour" Then
            Select Case FirstWarrantType
                Case "ItemTwoToTrain", "ItemFourToTrain", "ItemFourToMOW", "ItemFourNineToMOW", "ItemFourToTrainWithItem8", "ItemTwoToSameTrain", "ItemTwoFiveToTrain"
                    If Not Me.BoxEightInitialCheck(FirstCompList, FirstWarrantType) Then
                        ErrorMessage = "Box Eight Restriction Does Not Exist On The Track Selection. EXITING!"
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                        AuthorityEvent(ErrorMessage)
                        ClearSystemVariables()
                        Return False
                    End If
                    If Not IsNothing(SecondCompList) Then
                        If Not Me.BoxEightInitialCheck(SecondCompList, FirstWarrantType) Then
                            ErrorMessage = "Box Eight Restriction Does Not Exist On The Track Selection. EXITING!"
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                            AuthorityEvent(ErrorMessage)
                            ClearSystemVariables()
                            Return False
                        End If
                    End If
            End Select

            '**Added a form for person copying. DO NOT Prompt if Item 2 or 4 to same MOW
            If FirstWarrantType <> "ItemFourToSameMOW" And FirstWarrantType <> "ItemTwoToSameMOW" Then 'And Not Me.ForceBoxOne Then
                Select Case FirstWarrantType
                    Case "ItemTwoToTrain", "ItemTwoFiveToTrain"
                        If IsNothing(Me.VoidedWarrant) Then
                            Me.LoadCurrentTrains(False)
                        End If
                    Case "ItemFourToTrain", "ItemFourToTrainWithItem8"
                        Me.LoadCurrentTrains(True)
                    Case "ItemTwoToMOW", "ItemFourToMOW", "ItemFourSixToMOW", "ItemTwoSixToMOW", "ItemFourSixToMOW", "ItemTwoFiveToMOW", "ItemFourSixToSameMOW"
                        Me.LoadMOW()
                End Select
            End If




            '*****************Setup the track warrant form*****************************
            'Init Text and Check boxes, Init the header and footer fields on the form
            If Not SetUpTrackWarrantForm(FirstWarrantType, SecondWarrantType) Then
                ClearSystemVariables()
                Exit Function
            End If
            '*******************************End the Setup******************************

            '***************************CHECK FOR PROTECT OPEN SWITCHES*************************

            'Check for protecting open switches in TWC territory for the first component selection
            If Not ProtectOpenSwitchCheck(FirstCompList, FirstTypeOfWarrant, SearchDirection) Then
                Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                MessageList.Add("NO MORE THAN THREE BOX 12 SWITCHES ARE ALLOWED PER AUTHORITY.")
                MessageList.Add("")

                frmMessageBox.SetMessage(MessageList, "PROTECT OPEN SWITCH CHECK", False, LaunchPoint)

                SystemMessage = "NO MORE THAN THREE BOX 12 SWITCHES ARE ALLOWED PER AUTHORITY."
                AuthorityEvent(SystemMessage)
                frmMessageBox.ShowDialog()
                MessageList.Clear()
                MessageList = Nothing
                frmMessageBox.Dispose()
                frmMessageBox = Nothing
                ClearSystemVariables()
                Exit Function
            End If

            'Check for protecting open switches in TWC territory for Box Three component selection, if any
            If Not SecondCompList Is Nothing Then
                If Not ProtectOpenSwitchCheck(SecondCompList, FirstTypeOfWarrant, SearchDirection) Then
                    Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                    Dim frmMessageBox As frmMessageBox
                    Dim MessageList As New ArrayList()
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                    MessageList.Add("NO MORE THAN THREE BOX 12 SWITCHES ARE ALLOWED PER AUTHORITY.")
                    MessageList.Add("")

                    frmMessageBox.SetMessage(MessageList, "PROTECT OPEN SWITCH CHECK", False, LaunchPoint)

                    SystemMessage = "NO MORE THAN THREE BOX 12 SWITCHES ARE ALLOWED PER AUTHORITY."
                    AuthorityEvent(SystemMessage)
                    frmMessageBox.ShowDialog()
                    MessageList.Clear()
                    MessageList = Nothing
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    ClearSystemVariables()
                    Exit Function
                End If
            End If

            'Check for protecting open switches in TWC territory for the second component selection, if any
            If Not ComponentSelectionSecondary Is Nothing Then
                ProtectOpenSwitchCheck(ComponentSelectionSecondary, SecondWarrantType, SearchDirection)
            End If
            '******************************END CHECK FOR PROTECT OPEN SWITCHES***************************



            '********************************CHECK FOR TRACK TAGS*********************************
            'Check for track tags on first component selection
            If Not TrackTagCheck(FirstCompList, FirstTypeOfWarrant, SearchDirection) Then
                RestorePendingBoxThirteenSwitches()
                ClearSystemVariables()
                Exit Function
            End If

            If Not SecondCompList Is Nothing Then
                If Not TrackTagCheck(SecondCompList, FirstTypeOfWarrant, SearchDirection) Then
                    ClearSystemVariables()
                    Exit Function
                End If
            End If

            'Check for track tags on second component selection, if any
            If Not ComponentSelectionSecondary Is Nothing Then
                If Not TrackTagCheck(ComponentSelectionSecondary, SecondWarrantType, SearchDirection) Then
                    ClearSystemVariables()
                    Exit Function
                End If
            End If
            '******************************END CHECK FOR TRACK TAGS*******************************


            '*********************Check to see if Box Three needs to be check based on switch position
            BoxThreeCheck(FirstCompList)
            If Not SecondCompList Is Nothing Then BoxThreeCheck(SecondCompList)
            '*******************************************************************


            '***********************Check for joint authority for Box 8 and Box 9
            JointAuthorityCheck()
            '********************************************************************

            '*************************** CHECK FOR BOX 1 VOIDED AUTHORITY ************************************************
            If MobileClientAuthorityRequest Then
                If thisMobilemessage.SFAVoidAuthList IsNot Nothing AndAlso thisMobilemessage.SFAVoidAuthList.Count > 0 Then
                    ForceBoxOne = True
                    gBoxOneRequired = True
                    Me.CheckForBoxOneWarrantInSelectedABSLimitsFromMM(thisMobilemessage.SFAVoidAuthList)
                    LoadForcedVoidAuthoritiesFromMM(thisMobilemessage.SFAVoidAuthList)
                    Me.cmbItem1Void1.DropDownStyle = ComboBoxStyle.Simple
                    Me.cmbItem1Void1.Text = VoidedWarrant.AuthorityUID
                    Me.cmbItem1Void1.Enabled = False
                    Me.chkItem1.Checked = True
                    'Me.AddVehicleFromPreviousAuhtority(VoidedWarrant)
                    Me.ReInitVerbiage()
                End If
            End If
            '***************************************************************************

            '************************Re-INIT the Check Boxes, Header and footer on the track warrant form
            If Not ReInitCheckBoxesAndForm() Then
                ClearSystemVariables()
                Exit Function
            End If
            '************************************************************************************

            VehAssoctionEnabled = True
            Me.ShowVehicleList()
            Me.mnuVehAssociation.Enabled = True

            '******************Put the Item 2 and Item3 collection together to add to the track components and database
            If Not SecondCompList Is Nothing Then
                For Each comp In SecondCompList
                    If Not FirstCompList.Contains(comp) Then
                        FirstCompList.Add(comp)
                    End If
                Next
            End If

            SendKeys.Send("{TAB}") 'Set the "ISSUE To field as the focus
            SyncLock gMessageQueuefrmSingleFormAuthority
                gMessageQueuefrmSingleFormAuthority.Clear()
            End SyncLock

            If gIssueToSelected <> "" Then
                Me.cbIssueTo.Text = gIssueToSelected
                If Me.IssuedToTrain Then
                    CheckEngineIDFormatting()
                Else
                    Me.CheckMOWIDFormatting()
                End If
            End If
            Me.FormInitialized = True
            Me.cmbVehicles.Focus()
            If MobileMess.authJointStatus Then
                Me.chkItem8.Checked = True
                gBox8Required = True
            End If


            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            ClearSystemVariables()
            Me.CloseForm()
        End Try
    End Function

    Public Function BuildAuthority(ByVal TerritoryID As Integer, ByVal SearchDirection As String, _
                                  ByVal FirstWarrantType As String, ByVal SecondWarrantType As String, _
                                  ByRef ComponentSelection As ArrayList, _
                                  ByVal ComponentSelectionSecondary As ArrayList, Optional ByVal EndTerritoryID As Integer = -1) As Boolean
        Try
            Dim comp As Object
            Dim ErrorMessage, SystemMessage As String
            ApplyRailroadOptions()

            If gLaunchCreateItemTwoToTrain Or gLaunchCreateItemFourToSameTrain Then
                Me.IssuedToTrain = True
                Me.LockIssueToList = True
            End If
            Select Case FirstWarrantType
                Case "ItemFourToMOW", "ItemFourToSameMOW", "ItemFourToSameTrain", "ItemFourSixToSameMOW", "ItemFourSixToMOW", "ItemFourToTrain"
                    IsWorkAuthority = True
            End Select
            CompleteCompSelection = ComponentSelection.Clone

            AddGroupBoxesToList()
            AddCheckItemToList()
            AddCheckBoxToList()
            Me.AddCheckButtonToList()

            If InStr(FirstWarrantType, "MOW") = 0 Then
                Me.IssuedToTrain = True
            End If

            Me.AddOsComponentsToSelection(CompleteCompSelection)

            If gTrackIntegrityMonitoringExists Then  'add code to begin checking for TID
                If Me.IssuedToTrain Then
                    Dim newList As New ArrayList
                    newList = ValidateTrackZonesInRoute(CompleteCompSelection, FirstWarrantType)
                    If Not IsNothing(newList) AndAlso newList.Count = 0 Then
                        ClearSystemVariables()
                        Exit Function
                    End If
                    If newList IsNot Nothing AndAlso newList.Count > 0 Then
                        CompleteCompSelection = newList.Clone

                        Me.ResetOrginalFlashSelection(CompleteCompSelection, "TRACKZONE")
                        gEndTrackSelect = TMDS.SystemUtilities.FetchData.FindLastTrackInList(CompleteCompSelection)
                    End If
                End If
            End If
            'These Variables are added to satisfy BNSF-376
            Dim Box4HasShortenedZone As Boolean = False
            Dim Box4HasShortenedUnknownSwitch As Boolean = False
            If Me.IssuedToTrain AndAlso Me.IsWorkAuthority AndAlso PromptOnLimitsChangeFromTrackZone And gTrackIntegrityMonitoringExists Then Box4HasShortenedZone = True
            If Me.IssuedToTrain AndAlso Me.IsWorkAuthority Then
            Else
                If PromptOnLimitsChangeFromTrackZone And gTrackIntegrityMonitoringExists Then
                    If Not DisplayPromptOnLimitsChange("TRACKZONE", True) Then
                        Return False
                    End If
                End If
            End If

            If gSwitchPointMonitoringExists Then
                Dim CollectionReversed As Boolean
                If Me.IssuedToTrain Then
                    If UnknownSwitchOnLeft AndAlso gSearchDirection = "RIGHT" Then
                        gSearchDirection = "LEFT"
                        CompleteCompSelection.Reverse()
                        CollectionReversed = True
                    End If
                    If UnknownSwitchOnRight AndAlso gSearchDirection = "LEFT" Then
                        gSearchDirection = "RIGHT"
                        CompleteCompSelection.Reverse()
                        CollectionReversed = True
                    End If

                    If IsWorkAuthority AndAlso Not CollectionReversed Then
                        Dim IsSearchDirectionReversed As Boolean
                        CheckDirectionOfFaultSwitch(IsSearchDirectionReversed)
                        If IsSearchDirectionReversed Then
                            Dim Direction As String
                            CompleteCompSelection.Reverse()
                            If gSearchDirection = "LEFT" Then
                                Direction = "RIGHT"
                            Else
                                Direction = "LEFT"
                            End If
                            gSearchDirection = Direction
                            gBeginTrackSelect = gEndTrackSelect
                        End If
                    End If

                    Dim newList As ArrayList = ValidateSwitchPointsInRoute(CompleteCompSelection)
                    If newList.Count = 0 Then
                        ClearSystemVariables()
                        Exit Function
                    End If
                    CompleteCompSelection = newList.Clone

                    Me.ResetOrginalFlashSelection(CompleteCompSelection, "")
                    Me.CheckToAddSwitchPointsToBox12(CompleteCompSelection)
                    gEndTrackSelect = TMDS.SystemUtilities.FetchData.FindLastTrackInList(CompleteCompSelection)
                Else
                    If Not Me.CheckToAddSwitchPointsToBox12ForMOW(CompleteCompSelection) Then
                        Dim Message As String = "TO MANY BOX 12 SWITCHES IN THIS AUTHORITY."
                        MessageBox.Show(Me, Message, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                        Me.AuthorityEvent(Message)
                        Me.CloseForm()
                        Exit Function
                    End If
                End If
            End If

            If Me.IssuedToTrain AndAlso Me.IsWorkAuthority AndAlso PromptOnLimitsChange And gSwitchPointMonitoringExists Then Box4HasShortenedUnknownSwitch = True
            If Me.IssuedToTrain AndAlso Me.IsWorkAuthority Then
            Else
                If PromptOnLimitsChange And gSwitchPointMonitoringExists Then
                    If Not DisplayPromptOnLimitsChange("") Then
                        Return False
                    End If
                End If
            End If
            If Box4HasShortenedUnknownSwitch Or Box4HasShortenedZone Then
                If Box4HasShortenedZone Then
                    If Box4HasShortenedZone And gTrackIntegrityMonitoringExists Then
                        If Not DisplayPromptOnLimitsChange("TRACKZONE", True) Then
                            Return False
                        End If
                    End If
                Else
                    If Box4HasShortenedUnknownSwitch And gSwitchPointMonitoringExists Then
                        If Not DisplayPromptOnLimitsChange("") Then
                            Return False
                        End If
                    End If
                End If
                ReInitBox4Box8Check(CompleteCompSelection) ' RMT BNSF-380
            End If

            If gTrackIntegrityMonitoringExists Then 'This is added to recalculate box14 if the limits were shortened bcoz of SPMS check.
                If FirstWarrantType = "ItemTwoToTrain" OrElse FirstWarrantType = "ItemTwoToSameTrain" Then
                    CreateBox14VerbiageForBox2(CompleteCompSelection)
                Else
                    CreateBox14VerbiageForBox4(CompleteCompSelection)
                End If
            End If


            'If gTrackIntegrityMonitoringExists Then             'add code to begin checking for TID
            '    If Me.IssuedToTrain Then
            '        Dim newList As New ArrayList
            '        newList = ValidateTrackZonesInRoute(CompleteCompSelection, FirstWarrantType)
            '        If newList.Count = 0 Then
            '            ClearSystemVariables()
            '            Exit Function
            '        End If
            '        CompleteCompSelection = newList.Clone

            '        Me.ResetOrginalFlashSelection(CompleteCompSelection, "TRACKZONE")
            '        gEndTrackSelect = TMDS.SystemUtilities.FetchData.FindLastTrackInList(CompleteCompSelection)
            '    End If
            'End If

            'If gSwitchPointMonitoringExists Then
            '    If Me.IssuedToTrain Then
            '        Dim newList As ArrayList = ValidateSwitchPointsInRoute(CompleteCompSelection)
            '        If newList.Count = 0 Then
            '            ClearSystemVariables()
            '            Exit Function
            '        End If
            '        CompleteCompSelection = newList.Clone

            '        Me.ResetOrginalFlashSelection(CompleteCompSelection, "")
            '        Me.CheckToAddSwitchPointsToBox12(CompleteCompSelection)
            '        gEndTrackSelect = TMDS.SystemUtilities.FetchData.FindLastTrackInList(CompleteCompSelection)
            '    Else
            '        If Not Me.CheckToAddSwitchPointsToBox12ForMOW(CompleteCompSelection) Then
            '            Dim Message As String = "TO MANY BOX 12 SWITCHES IN THIS AUTHORITY."
            '            MessageBox.Show(Me, Message, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            '            Me.AuthorityEvent(Message)
            '            Me.CloseForm()
            '            Exit Function
            '        End If
            '    End If
            'End If

            'GET THE AUTHORITY NUMBER
            'GET THE AUTHORITY NUMBER
            If optEnableNumberPools Then
                AuthorityNumber = gRailroadInformation.GetNextNumberFromPool(RailroadInformation.PoolNumberTypes.TrackAndTime)
                AuthorityNumberString = AuthorityNumber

            ElseIf Not optUseWorkstationAuthorityNumbering Then
                If CurrentSelectedTerritory Is Nothing Then
                    AuthorityNumber = 0
                Else
                    AuthorityNumber = CurrentSelectedTerritory.GetNextAuthorityNumber(True)
                    AuthorityNumberString = Me.CurrentSelectedTerritory.TerritoryID.ToString & " - " & AuthorityNumber.ToString
                End If
            Else
                AuthorityNumber = TMDS.GlobalDeclarations.gThisWorkstation.GetNextAuthorityNumber()
                AuthorityNumberString = AuthorityNumber
            End If

            If AuthorityNumber = 0 Then
                Dim Message As String = "COULD NOT RETRIEVE NEXT AUTHORITY NUMBER!"
                MessageBox.Show(Me, Message, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                Me.AuthorityEvent(Message)
                Me.Valid = False
                Me.CloseForm()
            End If

            Dim MOWTypeOfAuthority As Boolean
            If InStr(FirstWarrantType, "MOW") Then
                MOWTypeOfAuthority = True
            End If

            'Check to see if box three will be needed
            'What determines a box three are tracks being different or authority type differences.
            Dim CompToCheck As Object
            Dim FirstTrackFound As String

            FirstTrackSelection = FirstCompList
            SecondTrackSelection = SecondCompList
            ThirdTrackSelection = ThirdCompList

            DirectionOfTheWarrant = SearchDirection
            FirstTypeOfWarrant = FirstWarrantType
            SecondTypeOfWarrant = SecondWarrantType

            SecondaryCompSelection = ComponentSelectionSecondary
            If gSwitchPointMonitoringExists And Not IsNothing(SecondaryCompSelection) And Not PromptOnLimitsChange Then
                Dim newList As ArrayList = ValidateSwitchPointsInRoute(SecondaryCompSelection)
                If newList.Count = 0 Then
                    ClearSystemVariables()
                    Exit Function
                End If
                SecondaryCompSelection = newList.Clone
                Me.ResetOrginalFlashSelection(SecondaryCompSelection, "")
                Me.CheckToAddSwitchPointsToBox12(SecondaryCompSelection)
            End If

            If gTrackIntegrityMonitoringExists And Not IsNothing(SecondaryCompSelection) And Not PromptOnLimitsChange Then

            End If

            If gBeginTrackSelect.myTerritory.AllowMovementPlanning Then Me.MovementPlanningDetected = True

            'initialize the selection
            FirstTrackFound = gBeginTrackSelect.TrackName

            Dim CurrentArrayList As ArrayList = FirstCompList
            Dim LimitsChangeDetected As Boolean
            Dim NumOfLimitChanges As Integer
            Dim LastCompToCheck As Track = gBeginTrackSelect
            For Each CompToCheck In CompleteCompSelection
                If CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trkToChk As Track = CType(CompToCheck, Track)

                    If ((MOWTypeOfAuthority And trkToChk.LeftAltLink <> 0 And gSearchDirection = "RIGHT") Or _
                       (MOWTypeOfAuthority And trkToChk.RightAltLink <> 0 And gSearchDirection = "LEFT")) And _
                         Not gBeginTrackSelect Is trkToChk And (LastCompToCheck.Name <> trkToChk.Name) Then
                        If NumOfLimitChanges >= 1 Then
                            ErrorMessage = "TOO MANY CHANGES IN AUTHORITY FOR MOW FOUND IN SELECTION. EXITING!"
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                            AuthorityEvent(ErrorMessage)
                            ClearSystemVariables()
                            Exit Function
                        End If
                        LimitsChangeDetected = True
                        NumOfLimitChanges += 1
                    End If
                    LastCompToCheck = trkToChk
                End If

                If CompToCheck.TrackName = FirstTrackFound And Not LimitsChangeDetected Then
                    CurrentArrayList.Add(CompToCheck)
                Else
                    If IsNothing(SecondCompList) Then
                        SecondCompList = New ArrayList()
                        CurrentArrayList = SecondCompList
                        CurrentArrayList.Add(CompToCheck)
                        FirstTrackFound = CompToCheck.TrackName
                        LimitsChangeDetected = False
                    Else
                        If IsNothing(ThirdCompList) And optEnableThreeLineAuthorityLimits Then
                            ThirdCompList = New ArrayList()
                            CurrentArrayList = ThirdCompList
                            CurrentArrayList.Add(CompToCheck)
                            FirstTrackFound = CompToCheck.TrackName
                        Else
                            ErrorMessage = "TOO MANY NON-CONTINUOUS TRACK TYPES FOUND IN SELECTION. Exiting!"
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                            AuthorityEvent(ErrorMessage)
                            ClearSystemVariables()
                            Exit Function
                        End If
                    End If
                End If
            Next

            FirstTrackFound = ""
            If Not IsNothing(ComponentSelectionSecondary) Then
                For Each CompToCheck In ComponentSelectionSecondary
                    If CompToCheck.TrackName = FirstTrackFound Then
                        CurrentArrayList.Add(CompToCheck)
                    Else
                        If IsNothing(SecondCompList) Then
                            SecondCompList = New ArrayList()
                            CurrentArrayList = SecondCompList
                            CurrentArrayList.Add(CompToCheck)
                            FirstTrackFound = CompToCheck.TrackName
                        Else
                            If IsNothing(ThirdCompList) Then
                                ThirdCompList = New ArrayList()
                                CurrentArrayList = ThirdCompList
                                CurrentArrayList.Add(CompToCheck)
                                FirstTrackFound = CompToCheck.TrackName
                            Else
                                ErrorMessage = "TOO MANY NON-CONTINUOUS TRACK TYPES FOUND IN SELECTION. Exiting!"
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                AuthorityEvent(ErrorMessage)
                                ClearSystemVariables()
                                Exit Function
                            End If
                        End If
                    End If
                Next
            End If


            'Check each track selection collection for conflict resolution
            'Check the first selection
            If FirstCompList Is Nothing Then
                ClearSystemVariables()
                Exit Function
            End If

            'Set the verbiage based on direction and type of warrant (i.e. Item2 or Item4)
            Dim FirstTrack1 As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(FirstCompList)
            Dim LastTrack1 As Track = FindLastTrackInList(FirstCompList) 'FirstCompList.Item(FirstCompList.Count - 1)

            Me.CurrentTimeZone = FirstTrack1.TimeZone.ToUpper
            SetCurrentTimeZone()
            Me.thisSubdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(FirstTrack1.SubdivisionID)


            If Not ConflictResolution(FirstCompList, FirstWarrantType, SearchDirection) Then
                ClearSystemVariables()
                Exit Function
            Else
                'set the type of track warrant (i.e. item2 or item4)
                If Mid(FirstWarrantType, 1, 7) = "ItemTwo" Then
                    ForceBoxTwo = True
                Else
                    ForceBoxFour = True
                End If
                If SearchDirection = "RIGHT" Then
                    BoxFrom1 = FirstTrack1.LeftLimitName
                    BoxTo1 = LastTrack1.RightLimitName
                    BoxTrack1 = FirstTrack1.TrackName
                ElseIf SearchDirection = "LEFT" Then
                    BoxFrom1 = FirstTrack1.RightLimitName
                    BoxTo1 = LastTrack1.LeftLimitName
                    BoxTrack1 = FirstTrack1.TrackName
                Else
                    ErrorMessage = "Direction of Warrant Not Established!"
                    AuthorityEvent((ErrorMessage & " - EXIT SUB"))
                    ClearSystemVariables()
                    Exit Function
                End If

            End If

            'Check second track selection if it exists
            If Not SecondCompList Is Nothing Then
                If Not ConflictResolution(SecondCompList, FirstWarrantType, SearchDirection) Then
                    ClearSystemVariables()
                    Exit Function
                Else
                    SecondLineNeeded = True
                    Dim FirstTrack As Track = SecondCompList.Item(0)
                    Dim LastTrack As Track = FindLastTrackInList(SecondCompList) 'SecondCompList.Item(SecondCompList.Count - 1)

                    If SearchDirection = "RIGHT" Then
                        BoxFrom2 = FirstTrack.LeftLimitName
                        BoxTo2 = LastTrack.RightLimitName
                        BoxTrack2 = FirstTrack.TrackName
                    ElseIf SearchDirection = "LEFT" Then
                        BoxFrom2 = FirstTrack.RightLimitName
                        BoxTo2 = LastTrack.LeftLimitName
                        BoxTrack2 = FirstTrack.TrackName
                    Else
                        ErrorMessage = "Direction of Warrant Not Established for Box Three Type!"
                        AuthorityEvent((ErrorMessage & " - EXIT SUB"))
                        ClearSystemVariables()
                        Exit Function
                    End If
                End If
            End If

            'Check second track selection if it exists
            If Not ThirdCompList Is Nothing Then
                If Not ConflictResolution(ThirdCompList, FirstWarrantType, SearchDirection) Then
                    ClearSystemVariables()
                    Exit Function
                Else
                    ThirdLineNeeded = True
                    'Set the verbiage based on direction and type of warrant FOR box3)
                    Dim FirstTrack As Track = ThirdCompList.Item(0)
                    Dim LastTrack As Track = FindLastTrackInList(ThirdCompList) 'ThirdCompList.Item(ThirdCompList.Count - 1)

                    If SearchDirection = "RIGHT" Then
                        BoxFrom3 = FirstTrack.LeftLimitName
                        BoxTo3 = LastTrack.RightLimitName
                        BoxTrack3 = FirstTrack.TrackName
                    ElseIf SearchDirection = "LEFT" Then
                        BoxFrom3 = FirstTrack.RightLimitName
                        BoxTo3 = LastTrack.LeftLimitName
                        BoxTrack3 = FirstTrack.TrackName
                    Else
                        ErrorMessage = "Direction of Warrant Not Established for Box Three Type!"
                        AuthorityEvent((ErrorMessage & " - EXIT SUB"))
                        ClearSystemVariables()
                        Exit Function
                    End If
                End If
            End If


            'If PromptOnLimitsChange And gSwitchPointMonitoringExists Then
            '    If Not DisplayPromptOnLimitsChange("") Then
            '        Return False
            '    End If
            'End If

            'If PromptOnLimitsChangeFromTrackZone And gTrackIntegrityMonitoringExists Then
            '    If Not DisplayPromptOnLimitsChange("TRACKZONE", True) Then
            '        Return False
            '    End If
            'End If

            If Me.IssuedToTrain Then
                Me.cbIssueTo.Text = "ENTER ENGINE ID"
            Else
                Me.cbIssueTo.Text = "LASTNAME, FIRSTNAME"
            End If

            If Not CheckForBlockSwitches(FirstCompList) Then
                Return False
            End If

            If Me.IssuedToTrain Then
                If Not Me.CheckForSwitchPositionOnRCPS Then
                    Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                    Dim frmMessageBox As frmMessageBox
                    Dim MessageList As New ArrayList()
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                    MessageList.Add("RCPS SWITCH OUT-OF-CORRESPONDENCE.")
                    MessageList.Add("AUTHORITY HAS TO START AT SWITCH.")
                    MessageList.Add("")

                    frmMessageBox.SetMessage(MessageList, "PROTECT RCPS SWITCH CHECK", False, LaunchPoint)

                    SystemMessage = "RCPS SWITCH OUT-OF-CORESPONDENCE. SWITCH IS NOT IN THE BEGINNING TRACK SELECTION."
                    AuthorityEvent(SystemMessage)
                    frmMessageBox.ShowDialog()
                    MessageList.Clear()
                    MessageList = Nothing
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    ClearSystemVariables()
                    Exit Function
                End If
                CheckToAddRCPSSwitchPositionVerbiage()
            Else
                IssuedToMOW = True
            End If
            If Not CheckRCPSSwitchPositionInRoute() Then
                Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                MessageList.Add("RCPS SWITCH NOT LINED NORMAL FOR ROUTE.")
                MessageList.Add("RCPS SWITCH HAS TO BE IN NORMAL POSITION FOR AUTHORITY.")
                MessageList.Add("")

                frmMessageBox.SetMessage(MessageList, "PROTECT RCPS SWITCH CHECK", False, LaunchPoint)

                SystemMessage = "RCPS SWITCH NOT NORMAL. SWITCH IS NOT IN THE BEGINNING OR ENDING OF TRACK SELECTION."
                AuthorityEvent(SystemMessage)
                frmMessageBox.ShowDialog()
                MessageList.Clear()
                MessageList = Nothing
                frmMessageBox.Dispose()
                frmMessageBox = Nothing
                ClearSystemVariables()
                Exit Function
            End If

            'Assign territory ID of the first track picked so it can be related to the warrant
            TerritoryIDAssignment = TerritoryID
            If EndTerritoryID > -1 Then
                If TerritoryID <> EndTerritoryID Then
                    GetSFASpanningTerritories(TerritoryID, EndTerritoryID, ComponentSelection)
                Else
                    TerritoryIDAssignment2 = TerritoryID
                    TerritoryIDAssignment3 = TerritoryID
                End If

            Else
                TerritoryIDAssignment2 = TerritoryID
                TerritoryIDAssignment3 = TerritoryID
            End If
            'Fill Box Eleven Combo Boxes with limit selections
            If Not FillBoxElevenComboBoxs(CompleteCompSelection, SearchDirection) Then
                ErrorMessage = "Box Eleven Limits Fill Sub Error!"
                AuthorityEvent((ErrorMessage & " - EXIT SUB"))
                ClearSystemVariables()
                Exit Function
            End If


            'Box Eleven Initial Check for the limits selected in Item 4 type warrants only
            'If Mid(FirstWarrantType, 1, 8) = "ItemFour" Then
            Select Case FirstWarrantType
                Case "ItemTwoToTrain", "ItemFourToTrain", "ItemFourToMOW", "ItemFourNineToMOW", "ItemFourToTrainWithItem8", "ItemTwoToSameTrain", "ItemTwoFiveToTrain"
                    If Not Me.BoxEightInitialCheck(FirstCompList, FirstWarrantType) Then
                        ErrorMessage = "Box Eight Restriction Does Not Exist On The Track Selection. EXITING!"
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                        AuthorityEvent(ErrorMessage)
                        ClearSystemVariables()
                        Return False
                    End If
                    If Not IsNothing(SecondCompList) Then
                        If Not Me.BoxEightInitialCheck(SecondCompList, FirstWarrantType) Then
                            ErrorMessage = "Box Eight Restriction Does Not Exist On The Track Selection. EXITING!"
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                            AuthorityEvent(ErrorMessage)
                            ClearSystemVariables()
                            Return False
                        End If
                    End If
            End Select

            '**Added a form for person copying. DO NOT Prompt if Item 2 or 4 to same MOW
            If FirstWarrantType <> "ItemFourToSameMOW" And FirstWarrantType <> "ItemTwoToSameMOW" Then 'And Not Me.ForceBoxOne Then
                Select Case FirstWarrantType
                    Case "ItemTwoToTrain", "ItemTwoFiveToTrain"
                        If IsNothing(Me.VoidedWarrant) Then
                            Me.LoadCurrentTrains(False)
                        End If
                    Case "ItemFourToTrain", "ItemFourToTrainWithItem8"
                        Me.LoadCurrentTrains(True)
                    Case "ItemTwoToMOW", "ItemFourToMOW", "ItemFourSixToMOW", "ItemTwoSixToMOW", "ItemFourSixToMOW", "ItemTwoFiveToMOW", "ItemFourSixToSameMOW"
                        Me.LoadMOW()
                End Select


            End If



            '*****************Setup the track warrant form*****************************
            'Init Text and Check boxes, Init the header and footer fields on the form
            If Not SetUpTrackWarrantForm(FirstWarrantType, SecondWarrantType) Then
                ClearSystemVariables()
                Exit Function
            End If
            '*******************************End the Setup******************************

            If Me.IssuedToTrain Then
                LockRCPS()
            End If


            '***************************CHECK FOR PROTECT OPEN SWITCHES*************************

            'Check for protecting open switches in TWC territory for the first component selection
            If Not ProtectOpenSwitchCheck(FirstCompList, FirstTypeOfWarrant, SearchDirection) Then
                Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                MessageList.Add("NO MORE THAN THREE BOX 12 SWITCHES ARE ALLOWED PER AUTHORITY.")
                MessageList.Add("")

                frmMessageBox.SetMessage(MessageList, "PROTECT OPEN SWITCH CHECK", False, LaunchPoint)

                SystemMessage = "NO MORE THAN THREE BOX 12 SWITCHES ARE ALLOWED PER AUTHORITY."
                AuthorityEvent(SystemMessage)
                frmMessageBox.ShowDialog()
                MessageList.Clear()
                MessageList = Nothing
                frmMessageBox.Dispose()
                frmMessageBox = Nothing
                ClearSystemVariables()
                Exit Function
            End If

            'Check for protecting open switches in TWC territory for Box Three component selection, if any
            If Not SecondCompList Is Nothing Then
                If Not ProtectOpenSwitchCheck(SecondCompList, FirstTypeOfWarrant, SearchDirection) Then
                    Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                    Dim frmMessageBox As frmMessageBox
                    Dim MessageList As New ArrayList()
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                    MessageList.Add("NO MORE THAN THREE BOX 12 SWITCHES ARE ALLOWED PER AUTHORITY.")
                    MessageList.Add("")

                    frmMessageBox.SetMessage(MessageList, "PROTECT OPEN SWITCH CHECK", False, LaunchPoint)

                    SystemMessage = "NO MORE THAN THREE BOX 12 SWITCHES ARE ALLOWED PER AUTHORITY."
                    AuthorityEvent(SystemMessage)
                    frmMessageBox.ShowDialog()
                    MessageList.Clear()
                    MessageList = Nothing
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    ClearSystemVariables()
                    Exit Function
                End If
            End If

            'Check for protecting open switches in TWC territory for the second component selection, if any
            If Not ComponentSelectionSecondary Is Nothing Then
                ProtectOpenSwitchCheck(ComponentSelectionSecondary, SecondWarrantType, SearchDirection)
            End If
            '******************************END CHECK FOR PROTECT OPEN SWITCHES***************************



            '********************************CHECK FOR TRACK TAGS*********************************
            'Check for track tags on first component selection
            If Not TrackTagCheck(FirstCompList, FirstTypeOfWarrant, SearchDirection) Then
                RestorePendingBoxThirteenSwitches()
                ClearSystemVariables()
                Exit Function
            End If

            If Not SecondCompList Is Nothing Then
                If Not TrackTagCheck(SecondCompList, FirstTypeOfWarrant, SearchDirection) Then
                    ClearSystemVariables()
                    Exit Function
                End If
            End If

            'Check for track tags on second component selection, if any
            If Not ComponentSelectionSecondary Is Nothing Then
                If Not TrackTagCheck(ComponentSelectionSecondary, SecondWarrantType, SearchDirection) Then
                    ClearSystemVariables()
                    Exit Function
                End If
            End If
            '******************************END CHECK FOR TRACK TAGS*******************************


            '*********************Check to see if Box Three needs to be check based on switch position
            BoxThreeCheck(FirstCompList)
            If Not SecondCompList Is Nothing Then BoxThreeCheck(SecondCompList)
            '*******************************************************************


            '***********************Check for joint authority for Box 8 and Box 9
            JointAuthorityCheck()
            '********************************************************************


            '************************Re-INIT the Check Boxes, Header and footer on the track warrant form
            If Me.IssuedToTrain Then
                Me.SetItemEightNote()
            End If
            If Not ReInitCheckBoxesAndForm() Then
                ClearSystemVariables()
                Exit Function
            End If
            '************************************************************************************

            If Me.IssuedToTrain Then
                Me.mnuVehAssociation.Enabled = False
                If Not loptDisableTrainViewButton Then Me.btnViewTrains.Visible = True
                If gLaunchCreateItemTwoToTrain Then
                    If gBox8Required Then
                        ResetBoxEightLimits()
                    End If
                End If
            Else
                VehAssoctionEnabled = True
                Me.ShowVehicleList()
                Me.mnuVehAssociation.Enabled = True
            End If


            '******************Put the Item 2 and Item3 collection together to add to the track components and database
            If Not SecondCompList Is Nothing Then
                For Each comp In SecondCompList
                    If Not FirstCompList.Contains(comp) Then
                        FirstCompList.Add(comp)
                    End If
                Next
            End If

            If optShowBulletinTabOnWarrantCreation Then
                If Not TMDS.SystemForms.MySystemForms.frmSystemSummary Is Nothing Then
                    TMDS.SystemForms.MySystemForms.frmSystemSummary.TabControl1.SelectedIndex = 5
                End If
            End If
            SendKeys.Send("{TAB}") 'Set the "ISSUE To field as the focus
            SyncLock gMessageQueuefrmSingleFormAuthority
                gMessageQueuefrmSingleFormAuthority.Clear()
            End SyncLock

            If gIssueToSelected <> "" Then
                Me.cbIssueTo.Text = gIssueToSelected
                If Me.IssuedToTrain Then
                    CheckEngineIDFormatting()
                Else
                    Me.CheckMOWIDFormatting()
                End If
            End If
            Me.FormInitialized = True
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            ClearSystemVariables()
            Me.CloseForm()
        End Try
    End Function

    Private Function FindPotentialIssueToTrain() As String
        Try
            If Me.SignalLimitsFound Or FirstTypeOfWarrant = "ItemTwoFiveToTrain" Then
                Return Nothing
            End If
            Dim PotentialIssueTo As String = String.Empty
            Dim TrainDirection As String = String.Empty
            Dim JointAuthorityFound As Boolean
            Dim comp As Object
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.TrainIDs.Count > 0 Then
                        If trk.BiDirectionalABS And trk.TrackAuthorities.Count > 0 Then
                        Else
                            If trk.TrackAuthorities.Count > 0 Then
                                Dim sfa As SFAuthority
                                For Each sfa In trk.TrackAuthorities
                                    If sfa.CheckBoxItemsStatus(7) Then
                                        JointAuthorityFound = True
                                        Exit For
                                    End If
                                Next
                            End If
                            If JointAuthorityFound Then
                                Exit For
                            Else
                                Dim trn As TrainID = trk.TrainIDs.Item(0)
                                PotentialIssueTo = trn.IdentifingUnit
                                Exit For
                            End If
                        End If
                    End If
                End If
            Next
            If PotentialIssueTo = "" And Not JointAuthorityFound Then
                If gSearchDirection = "LEFT" Then
                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gBeginTrackSelect.RightLink)
                    If Not IsNothing(trk) Then
                        If trk.TrackAuthorities.Count > 0 Then
                            Dim sfa As SFAuthority
                            For Each sfa In trk.TrackAuthorities
                                If sfa.CheckBoxItemsStatus(7) Then
                                    JointAuthorityFound = True
                                    Exit For
                                End If
                            Next
                        End If

                        If Not IsNothing(trk) And Not JointAuthorityFound Then
                            If trk.TrainIDs.Count > 0 Then
                                Dim trn As TrainID = trk.TrainIDs.Item(0)
                                PotentialIssueTo = trn.IdentifingUnit
                            End If
                        End If
                    End If
                Else
                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gBeginTrackSelect.LeftLink)
                    If Not IsNothing(trk) Then

                        If trk.TrackAuthorities.Count > 0 Then
                            Dim sfa As SFAuthority
                            For Each sfa In trk.TrackAuthorities
                                If sfa.CheckBoxItemsStatus(7) Then
                                    JointAuthorityFound = True
                                    Exit For
                                End If
                            Next
                        End If
                        If Not IsNothing(trk) And Not JointAuthorityFound Then
                            If trk.TrainIDs.Count > 0 Then
                                Dim trn As TrainID = trk.TrainIDs.Item(0)
                                PotentialIssueTo = trn.IdentifingUnit
                            End If
                        End If
                    End If
                End If
            End If
            If PotentialIssueTo <> "" Then
                Select Case FirstTypeOfWarrant
                    Case "ItemTwoToTrain", "ItemTwoFiveToTrain"
                        If gSearchDirection = "LEFT" Then
                            If Not IsNothing(thisSubdivision) Then
                                If thisSubdivision.SubDirection Then
                                    TrainDirection = "SOUTH"
                                Else
                                    TrainDirection = "WEST"
                                End If
                            Else
                                TrainDirection = "WEST"
                            End If
                        Else
                            If Not IsNothing(thisSubdivision) Then
                                If thisSubdivision.SubDirection Then
                                    TrainDirection = "NORTH"
                                Else
                                    TrainDirection = "EAST"
                                End If
                            Else
                                TrainDirection = "EAST"
                            End If
                        End If
                End Select
                PotentialIssueTo = PotentialIssueTo & " " & TrainDirection
            End If
            PotentialIssueTo = ""
            Return PotentialIssueTo
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

    Private Sub LoadCurrentTrains(ByVal ItemFourType As Boolean)
        Try
            Dim trn As TrainID
            Dim TrnString As String
            Dim TrainDirection As String = String.Empty

            If LockIssueToList Then Exit Sub

            Select Case FirstTypeOfWarrant
                Case "ItemTwoToTrain", "ItemTwoFiveToTrain"
                    If gSearchDirection = "LEFT" Then
                        If Not IsNothing(thisSubdivision) Then
                            If thisSubdivision.SubDirection Then
                                TrainDirection = "SOUTH"
                            Else
                                TrainDirection = "WEST"
                            End If
                        Else
                            TrainDirection = "WEST"
                        End If

                    Else
                        If Not IsNothing(thisSubdivision) Then
                            If thisSubdivision.SubDirection Then
                                TrainDirection = "NORTH"
                            Else
                                TrainDirection = "EAST"
                            End If
                        Else
                            TrainDirection = "EAST"
                        End If
                    End If
            End Select

            Dim EngineList As New ArrayList

            For Each trn In TrainCollection

                If ItemFourType Then
                    TrnString = trn.IdentifingUnit.ToUpper
                Else
                    TrnString = (trn.IdentifingUnit.ToUpper & " " & TrainDirection)
                End If
                If TrnString <> "" Then
                    'Me.cbIssueTo.Items.Add(TrnString)
                    If Not EngineList.Contains(TrnString) Then
                        EngineList.Add(TrnString)
                    End If
                End If
            Next
            EngineList.Sort()
            For Each TrnString In EngineList
                Me.cbIssueTo.Items.Add(TrnString)
            Next
            Dim PotentialIssueTo As String = String.Empty
            PotentialIssueTo = Me.FindPotentialIssueToTrain
            If PotentialIssueTo = "" Then
                Me.cbIssueTo.Text = "ENTER ENGINE ID"
            ElseIf FirstTypeOfWarrant <> "ItemFourToTrain" Then
                SystemEvent("CHANGE EVENT RECORDED FOR AUTHORITY NUMBER:" & AuthorityNumberString & ". ISSUE TO BOX SELECTION CHANGE TO THIS TEXT FROM A PRE-POPULATE EVENT:" & PotentialIssueTo)
                Me.cbIssueTo.Text = PotentialIssueTo
            End If
            'AddHandler Me.cbIssueTo.TextChanged, AddressOf TMDS.SystemUtilities.clsHandlers.sbFindComboItem

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

