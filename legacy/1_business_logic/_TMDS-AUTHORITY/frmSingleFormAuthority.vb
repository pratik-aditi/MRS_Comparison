#Region "REMOTE CONTROL POWER SWITCH"

    Private Sub ShowPendingLockRCPS()
        Try
            If CheckForRCPSPerformed Then
                Exit Sub
            End If
            CheckForRCPSPerformed = True

            If RCPSwitchesFound Then
                TMDS.SystemForms.MySystemForms.frmPending = New frmPending()
                TMDS.SystemForms.MySystemForms.frmPending.Location = New Point(Me.Left + Me.Width / 2 - TMDS.SystemForms.MySystemForms.frmPending.Width / 2, Me.Top + 200)
                TMDS.SystemForms.MySystemForms.frmPending.SetForm("APPLYING SWITCH LOCKING", 3000, "APPLYING AUTHORITY LOCKING TO SWITCHES")

                TMDS.SystemForms.MySystemForms.frmPending.TopMost = True
                TMDS.SystemForms.MySystemForms.frmPending.ShowDialog()
                If TMDS.SystemForms.MySystemForms.frmPending.RequestCancelled Then
                    TMDS.SystemForms.MySystemForms.frmPending.Close()
                    If Not Me.OutOfCorrespondenceProtection Then
                        If Not Me.CheckForSwitchLockOnAllRCPS Then
                            Me.UnLockRCPS()
                            Me.RestorePendingBoxThirteenSwitches()
                            Dim ErrorMessage As String = "DISPATCHER CANCELED RCPS LOCK REQUEST!"
                            AuthorityEvent((ErrorMessage & " - EXIT SUB"))
                            ClearSystemVariables()
                            TMDS.SystemForms.MySystemForms.frmPending.Dispose()
                            TMDS.SystemForms.MySystemForms.frmPending = Nothing
                            Me.Close()
                            Exit Sub
                        End If
                    End If
                End If
                TMDS.SystemForms.MySystemForms.frmPending.Dispose()
                TMDS.SystemForms.MySystemForms.frmPending = Nothing
                RCPSwitchesFound = False
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

