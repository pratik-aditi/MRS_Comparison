    Private Sub CheckForBoxFourSixEightMOWInABS(Optional ByVal IssueToTrain As String = Nothing)
        Try
            Dim comp As Object
            If IsNothing(IssueToTrain) Then IssueToTrain = Me.cbIssueTo.Text
            Dim BoxFourSixEightMOWFound As Boolean = True
            For Each comp In CompleteCompSelection
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.TrackAuthorities.Count > 0 Then
                        Dim auth As SFAuthority
                        For Each auth In trk.TrackAuthorities
                            If auth.IssueTo <> IssueToTrain Then
                                If auth.CheckBoxItemsStatus(5) And auth.Box6Train.Contains(IssueToTrain) Then
                                    'do nothing
                                Else
                                    BoxFourSixEightMOWFound = False
                                End If
                            End If
                        Next
                    End If
                End If
            Next
            If BoxFourSixEightMOWFound Then
                If gJointAuthRequired Or gBox8Required Then
                    'gJointAuthRequired = False
                    gBox8Required = False
                    Me.chkItem8.Checked = False
                End If
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

