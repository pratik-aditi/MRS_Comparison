    Private Function CheckForParallelAuthorities() As Boolean
        Try
            Dim TrackList As New ArrayList
            Dim comp As Object
            Dim trkToCheck As Track
            For Each comp In CompleteCompSelection
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    For Each trkToCheck In TrackCollection
                        If ((trk.LeftLimitMilePost = trkToCheck.LeftLimitMilePost And trk.MilePostSuffix = trkToCheck.MilePostSuffix And trk.RightLimitMilePost = trkToCheck.RightLimitMilePost) Or (trk.LeftLimitName = trkToCheck.LeftLimitName And trk.RightLimitName = trkToCheck.RightLimitName)) And trk.GUID <> trkToCheck.GUID And trk.TrackName <> trkToCheck.TrackName Then
                            If Not (trk.LeftLimitMilePost = 0 And trk.RightLimitMilePost = 0) Then
                                If Not TrackList.Contains(trkToCheck) Then
                                    TrackList.Add(trkToCheck)
                                    Exit For
                                End If
                            End If
                        End If
                    Next
                End If
            Next
            For Each trkToCheck In TrackList
                If trkToCheck.TrackAuthorities.Count > 0 Then
                    Dim sfa As SFAuthority
                    For Each sfa In trkToCheck.TrackAuthorities
                        If sfa.IssuedToTrain And Mid(cbIssueTo.Text, 1, 10) = Mid(sfa.IssueTo, 1, 10) Then
                            If sfa.CheckBoxItemsStatus(4) Then Return False
                            If Mid(FirstTypeOfWarrant, 1, 7) = "ItemTwo" Then 'And sfa.Box2To1 <> Me.BoxFrom1 Then
                                If sfa.CheckBoxItemsStatus(1) Then
                                    If Not IsNothing(VoidedWarrant) Then
                                        If VoidedWarrant.AuthorityUID <> sfa.AuthorityUID Then
                                            Return False
                                        End If
                                    Else
                                        Return False
                                    End If

                                ElseIf sfa.CheckBoxItemsStatus(3) And gItemFiveRequired Then
                                    Return False
                                End If
                            End If
                        End If
                    Next
                End If
            Next


            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Function CheckForAuthoritiesInBothDirections() As Boolean

        Try

            Dim LastTrack As Track = Me.FindFirstTrackInListFiltered(Me.CompleteCompSelection)
            Dim NextComp As Object

            Dim TrackListLeft As New ArrayList
            Dim TrackListRight As New ArrayList

            Dim Subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(LastTrack.SubdivisionID)
            Dim SubdivisionName As String = String.Empty
            If Not IsNothing(Subdvn) Then
                SubdivisionName = Subdvn.Name
            End If
            Dim AuthList As New ArrayList
            Dim auth As Object
            For Each auth In OtherTrackAuthorities
                If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                    Dim sfa1 As SFAuthority = CType(auth, SFAuthority)
                    If sfa1.IssuedToTrain And sfa1.AuthType1 = "ItemTwoToTrain" Then
                        If Mid(sfa1.IssueTo, 1, 10) = Mid(Me.cbIssueTo.Text, 1, 10) And sfa1.Subdivision = SubdivisionName Then
                            AuthList.Add(sfa1)
                        End If
                    End If
                End If
            Next

            Dim SwListLeft As New ArrayList
            Dim SwListRight As New ArrayList


            Dim comp As Object
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    SwListLeft.Add(comp)
                    SwListRight.Add(comp)
                End If
            Next

            'If gSearchDirection = "LEFT" Then
            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(LastTrack.LeftLink)
            Do
                If IsNothing(NextComp) Then Exit Do
                If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(NextComp, Track)
                    If trk.SubdivisionID <> LastTrack.SubdivisionID Then
                        Exit Do
                    End If
                    If Not IsNothing(trk.OsComponentCollection) Then
                        Dim c As Object
                        For Each c In trk.OsComponentCollection
                            If c.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If Not TrackListLeft.Contains(c) And Not Me.CompleteCompSelection.Contains(c) Then
                                    TrackListLeft.Add(c)
                                End If
                            End If
                        Next
                    End If

                ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    SwListLeft.Add(NextComp)
                End If

                If Not TrackListLeft.Contains(NextComp) And Not Me.CompleteCompSelection.Contains(NextComp) Then
                    TrackListLeft.Add(NextComp)
                End If
                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
            Loop

            'End If

            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(LastTrack.RightLink)

            Do
                If IsNothing(NextComp) Then Exit Do
                If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(NextComp, Track)
                    If trk.SubdivisionID <> LastTrack.SubdivisionID Then
                        Exit Do
                    End If
                    If Not IsNothing(trk.OsComponentCollection) Then
                        Dim c As Object
                        For Each c In trk.OsComponentCollection
                            If c.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If Not TrackListRight.Contains(c) And Not Me.CompleteCompSelection.Contains(c) Then
                                    TrackListRight.Add(c)
                                End If
                            End If
                        Next
                    End If
                ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    SwListRight.Add(NextComp)
                End If
                If Not TrackListRight.Contains(NextComp) And Not Me.CompleteCompSelection.Contains(NextComp) Then
                    TrackListRight.Add(NextComp)
                End If
                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
            Loop

            If LastTrack.OStype Then
                For Each NextComp In LastTrack.OsComponentCollection
                    If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        Dim sw1 As Switch = CType(NextComp, Switch)
                        If sw1.RightAltLink <> 0 Then
                            If Not SwListRight.Contains(sw1) Then
                                SwListRight.Add(sw1)
                            End If
                        Else
                            If Not SwListLeft.Contains(sw1) Then
                                SwListRight.Add(sw1)
                            End If
                        End If
                    End If
                Next
            End If
            Dim TrackSearchCount As Integer

            Dim sw As Switch
            For Each sw In SwListLeft
                TrackSearchCount = 0
                If sw.LeftAltLink <> 0 Then
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftAltLink)
                    Do
                        If IsNothing(NextComp) Then Exit Do
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(NextComp, Track)
                            If (trk.SubdivisionID <> LastTrack.SubdivisionID) Or Mid(trk.AuthorityType, 1, 3) <> "TWC" Or TrackListLeft.Contains(NextComp) Then
                                TrackSearchCount += 1
                                If TrackSearchCount > 3 Then
                                    TrackSearchCount = 0
                                    Exit Do
                                End If
                            End If
                        End If
                        TrackListLeft.Add(NextComp)
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                    Loop
                End If
            Next
            For Each sw In SwListRight
                TrackSearchCount = 0
                If sw.RightAltLink <> 0 Then
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightAltLink)
                    Do
                        If IsNothing(NextComp) Then Exit Do
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(NextComp, Track)
                            If (trk.SubdivisionID <> LastTrack.SubdivisionID) Or Mid(trk.AuthorityType, 1, 3) <> "TWC" Or TrackListRight.Contains(NextComp) Then
                                TrackSearchCount += 1
                                If TrackSearchCount > 3 Then
                                    TrackSearchCount = 0
                                    Exit Do
                                End If
                            End If
                        End If
                        TrackListRight.Add(NextComp)
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                    Loop
                End If

            Next

            Dim sfa As SFAuthority
            For Each sfa In AuthList
                'Dim comp As Object
                For Each comp In sfa.Components
                    If TrackListLeft.Contains(comp) Then
                        If Not IsNothing(VoidedWarrant) Then
                            If Not VoidedWarrant Is sfa Then
                                If Not CheckToVerifyIncludedInItemOneBoxes(sfa.AuthorityUID) Then
                                    If sfa.Direction = "LEFT" Then
                                        If sfa.Components.IndexOf(comp) = 0 Then
                                            Return False
                                        End If
                                    End If
                                End If
                            End If
                        Else
                            If Not CheckToVerifyIncludedInItemOneBoxes(sfa.AuthorityUID) Then
                                If sfa.Direction = "LEFT" Then
                                    If sfa.Components.IndexOf(comp) = 0 Then
                                        Return False
                                    End If
                                End If
                            End If
                        End If
                    End If
                Next
            Next

            For Each sfa In AuthList
                'Dim comp As Object
                For Each comp In sfa.Components
                    If TrackListRight.Contains(comp) Then
                        If Not IsNothing(VoidedWarrant) Then
                            If Not VoidedWarrant Is sfa Then
                                If Not CheckToVerifyIncludedInItemOneBoxes(sfa.AuthorityUID) Then
                                    If sfa.Direction = "RIGHT" Then
                                        If sfa.Components.IndexOf(comp) = 0 Then
                                            Return False
                                        End If
                                    End If
                                End If
                            End If
                        Else
                            If Not CheckToVerifyIncludedInItemOneBoxes(sfa.AuthorityUID) Then
                                If sfa.Direction = "RIGHT" Then
                                    If sfa.Components.IndexOf(comp) = 0 Then
                                        Return False
                                    End If
                                End If
                            End If
                        End If
                    End If
                Next
            Next

            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

