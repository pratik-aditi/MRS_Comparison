    Private Sub CheckToResetBox12OnSwitch(ByVal sw As Switch)

        Try
            If sw.TrackAuthorities.Count = 1 Then
                Dim auth As SFAuthority = sw.TrackAuthorities.Item(0)
                If Not IsNothing(Me.VoidedWarrant) Then
                    If Me.VoidedWarrant.AuthorityUID = auth.AuthorityUID Then
                        If Not VoidedWarrant.Box12Switches.Contains(sw.Name) Then
                            BoxTwelveSwitches.Remove(sw.Name)
                            If BoxTwelveSwitches.Count = 0 Then
                                Item12Forced = False
                                gBoxTwelveRequired = False
                                chkItem12.Checked = False
                            End If
                        End If
                    End If
                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

