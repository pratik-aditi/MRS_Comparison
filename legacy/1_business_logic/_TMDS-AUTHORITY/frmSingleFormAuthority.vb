    Private Function VoidTrackWarrant(ByVal AuthToVoid As SFAuthority, ByVal BoxOneVoid As Boolean, ByVal ForceAuthDeletion As Boolean) As Boolean
        Dim LongMessage(7), Limits As String, UserMessage As Integer
        Dim I As Integer
        Dim gHistoryMessage As String
        Try
            If Not ForceAuthDeletion Then 'Version 237
                tmrSelection.Enabled = True

                If AuthToVoid.AuthType1 = "ItemTwoToTrain" Or AuthToVoid.AuthType1 = "ItemTwoToMOW" Then
                    Limits = "FROM " & AuthToVoid.Box2From1 & vbCrLf & "TO " & AuthToVoid.Box2To1 & vbCrLf & "ON " & AuthToVoid.Box2Track1
                Else
                    Limits = "BETWEEN " & AuthToVoid.Box4From1 & vbCrLf & "AND " & AuthToVoid.Box4To1 & vbCrLf & "ON " & AuthToVoid.Box4Track1
                End If

                If Not BoxOneVoid Then
                    LongMessage(1) = "VOID TRACK WARRANT NUMBER: " & AuthToVoid.AuthorityUID
                    LongMessage(2) = "LIMITS: " & Limits
                    LongMessage(3) = "ISSUED TO: " & AuthToVoid.IssueTo
                    LongMessage(4) = "Report Clear Time: " & Format(Now, "MM-dd-yyy HH:mm")
                    LongMessage(5) = "BY: " & AuthToVoid.CopiedBy & vbCrLf
                    LongMessage(6) = "ARE YOU SURE?" & vbCrLf
                Else
                    LongMessage(1) = "ARE YOU SURE?" & vbCrLf & vbCrLf
                    LongMessage(2) = "RELEASE TRACK WARRANT NUMBER: " & AuthToVoid.AuthorityUID & vbCrLf
                    LongMessage(3) = "LIMITS: " & Limits & vbCrLf
                    LongMessage(4) = "ISSUED TO: " & AuthToVoid.IssueTo
                End If

                For I = 1 To 6
                    LongMessage(7) = LongMessage(7) & LongMessage(I) & vbCrLf
                    gHistoryMessage = LongMessage(I)
                Next I

                UserMessage = MessageBox.Show(Me, LongMessage(7), "REPORT LIMITS CLEAR CONFIRMATION", MessageBoxButtons.YesNo, MessageBoxIcon.Warning)


                If UserMessage = 6 Then
                    tmrSelection.Enabled = False

                    gHistoryMessage = "SELECTED - YES ON THE REPORT LIMITS CLEAR ON TRACK AUTHORITY:" & AuthToVoid.AuthorityUID
                    TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                    AuthToVoid.ReportClearTime = Format(Now, "g")
                    AuthToVoid.ReportClearBy = AuthToVoid.CopiedBy

                    'added this code to move the train id to new track warrant that replaces the item one warrant
                    Dim trn As TrainID = Me.TrainExistsForAuthority(AuthToVoid)
                    If Not trn Is Nothing Then
                        If Not trn.ReadOnlySymbol Then
                            Dim UserFeedBack As Integer
                            Dim UserMessageOne As String = "EXISTING TRAIN FOUND FOR TRACK AUTHORITY: " & trn.Name & vbCrLf
                            UserMessageOne = UserMessageOne & "MOVE TRAIN SYMBOL TO BEGINNING OF AUTHORITY?" & vbCrLf
                            UserFeedBack = MessageBox.Show(Me, UserMessageOne, "System Message", MessageBoxButtons.YesNo, MessageBoxIcon.Question)
                            If UserFeedBack = 6 Then
                                Dim MoveFromTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trn.TrackGUID)
                                Dim MoveToTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gBeginTrackSelect.GUID)
                                MoveToTrack.MoveTrainIDPlace(trn, MoveFromTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                            End If
                        End If
                    End If

                    If AuthToVoid.RemoveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                        If AuthToVoid.RemoveAuthorityFromComponents() Then
                            TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(AuthToVoid)
                            Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", AuthToVoid)
                            SyncLock gSummaryAuthQueue.SyncRoot
                                gSummaryAuthQueue.Enqueue(SummItem)
                            End SyncLock
                        Else
                            gHistoryMessage = "TRACK AUTHORITY " & AuthToVoid.AuthorityUID & " NOT DELETE FROM THE SYSTEM."
                            TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                            'SysEvent = New SystemEventRecord(Now, SysEvent.EventEnum.DispatcherEvent, gHistoryMessage, SystemEventQueue)
                            MessageBox.Show(MainForm, gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSelection()
                        End If
                    Else
                        gHistoryMessage = "TRACK AUTHORITY " & AuthToVoid.AuthorityUID & " NOT DELETED FROM THE DATABASE."
                        TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                        'SysEvent = New SystemEventRecord(Now, SysEvent.EventEnum.DispatcherEvent, gHistoryMessage, SystemEventQueue)
                        MessageBox.Show(MainForm, gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End If
                    ClearSelection()
                    Return True
                Else
                    gHistoryMessage = "SELECTED - NO TO REPORT LIMITS CLEAR ON TRACK WARRANT:" & AuthToVoid.AuthorityUID
                    TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                    ClearSelection()
                    Return False
                    'ClearSelection()
                    'gHistoryMessage = "SELECTED - NO ON THE REPORT LIMITS CLEAR"
                    ''DisplaygHistoryMessage(vbBlack, True)
                End If
                'Version 237
            Else

                'added this code to move the train id to new track warrant that replaces the item one warrant
                Dim trn As TrainID = Me.TrainExistsForAuthority(AuthToVoid)
                If Not trn Is Nothing Then
                    If Not trn.ReadOnlySymbol Then
                        Dim UserFeedBack As Integer
                        Dim UserMessageOne As String = "EXISTING TRAIN FOUND FOR TRACK WARRANT: " & trn.Name & vbCrLf
                        UserMessageOne = UserMessageOne & "MOVE TRAIN SYMBOL TO BEGINNING OF AUTHORITY?" & vbCrLf
                        UserFeedBack = MessageBox.Show(Me, UserMessageOne, "System Message", MessageBoxButtons.YesNo, MessageBoxIcon.Question)
                        If UserFeedBack = 6 Then
                            Dim MoveFromTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trn.TrackGUID)
                            Dim MoveToTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gBeginTrackSelect.GUID)
                            MoveToTrack.MoveTrainIDPlace(trn, MoveFromTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                        End If
                    End If
                End If

                If AuthToVoid.RemoveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                    If AuthToVoid.RemoveAuthorityFromComponents() Then
                        TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(AuthToVoid)
                        Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", AuthToVoid)
                        SyncLock gSummaryAuthQueue.SyncRoot
                            gSummaryAuthQueue.Enqueue(SummItem)
                        End SyncLock
                    Else
                        gHistoryMessage = "TRACK AUTHORITY " & AuthToVoid.AuthorityUID & " NOT DELETE FROM THE SYSTEM."
                        TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                        'SysEvent = New SystemEventRecord(Now, SysEvent.EventEnum.DispatcherEvent, gHistoryMessage, SystemEventQueue)
                        MessageBox.Show(MainForm, gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSelection()
                    End If
                Else
                    gHistoryMessage = "TRACK AUTHORITY " & AuthToVoid.AuthorityUID & " NOT DELETED FROM THE DATABASE."
                    TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                    'SysEvent = New SystemEventRecord(Now, SysEvent.EventEnum.DispatcherEvent, gHistoryMessage, SystemEventQueue)
                    MessageBox.Show(MainForm, gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If
                VoidTrackWarrant = True
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
            ClearSelection()
            VoidedWarrant = Nothing
            ClearSystemVariables()
            Me.CloseForm()
        End Try
    End Function

