    Private Function CheckForBeginAuthorityOnPOS() As Boolean
        Try
            If Mid(FirstTypeOfWarrant, 1, 8) = "ItemFour" Then
                Return True
            End If

            If CheckForBeginNAuthorityOnPOSPerformed Then
                If IsNothing(VoidedWarrant) Then
                    Return True
                End If
            End If
            CheckForBeginNAuthorityOnPOSPerformed = True

            If Not IsNothing(gBeginTrackSelect.OsComponentCollection) Then
                Dim comp As Object
                For Each comp In gBeginTrackSelect.OsComponentCollection
                    If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        Dim sw As Switch = CType(comp, Switch)
                        Dim OverridePrompt As Boolean

                        If Not sw.ProtectOpenSwitchEnabled Then
                            Return True
                        End If
                        If gSearchDirection = "RIGHT" Then
                            If sw.LeftAltLink = 0 Then
                                Return True
                            End If
                        ElseIf gSearchDirection = "LEFT" Then
                            If sw.RightAltLink = 0 Then
                                Return True
                            End If
                        End If

                        If BoxThirteenSwitches.Contains(sw.Name) Then
                            Return True
                        End If

                        'If sw.TrackAuthorities.Count > 0 Then
                        '    Dim sfa As SFAuthority
                        '    For Each sfa In sw.TrackAuthorities
                        '        If Not sfa.Box12Switches.Contains(sw.Name) Then
                        '            Return True
                        '        End If
                        '    Next
                        'End If

                        If sw.BlockAbsolute Then
                            Return True
                        End If

                        If sw.BiDirectionalABS Or sw.SingleABSEast Or sw.SingleABSWest Then
                            Dim auth As SFAuthority
                            For Each auth In sw.TrackAuthorities
                                If Not auth.Box12Switches.Contains(sw.Name) Then
                                    If Not Me.BoxFiveTrainList.Contains(auth.IssueTo) Then
                                        If Not IsNothing(Me.VoidedWarrant) Then
                                            If Me.VoidedWarrant.AuthorityUID <> auth.AuthorityUID Then
                                                Return True
                                            End If
                                        Else
                                            If Not CheckForOtherExistingBoxFiveThisTrainIsWaitingOn(auth) Then
                                                Return True
                                            End If
                                        End If
                                    End If
                                End If
                            Next
                        Else
                            Dim auth As SFAuthority
                            For Each auth In sw.TrackAuthorities
                                If (auth.CheckBoxItemsStatus(5) And auth.Box6Train.Contains(Me.cbIssueTo.Text)) Or auth.CheckBoxItemsStatus(7) Then
                                    If Me.cbIssueTo.Text <> auth.IssueTo Then
                                        If Not auth.Box12Switches.Contains(sw.Name) Then
                                            Return True
                                        End If
                                    End If
                                End If
                            Next
                        End If
                        'If gSearchDirection = "RIGHT" And sw.LeftAltLink <> 0 Or gSearchDirection = "LEFT" And sw.RightAltLink <> 0 Then
                        '    OverridePrompt = True
                        'End If

                        If Not OverridePrompt Then
                            Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)

