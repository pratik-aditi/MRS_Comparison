    Private Function FindFirstTrackInListFiltered(ByVal CompList As ArrayList) As Track
        Try
            Dim comp As Object
            For Each comp In CompList
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.OStype Then
                        Dim comp1 As Object

                        If trk.OsComponentCollection.Count = 1 Then
                            Return trk
                        End If
                        For Each comp1 In trk.OsComponentCollection
                            If comp1.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                Dim sw As Switch = CType(comp1, Switch)
                                If sw.RightAltLink <> 0 Then
                                    Dim tk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.LeftLink)
                                    Return tk
                                Else
                                    Dim tk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.RightLink)
                                    Return tk
                                End If
                            End If
                        Next
                    Else
                        Return comp
                    End If
                End If
            Next
            Return Nothing
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

    Public Sub LoadIssueToList()
        Dim DatabaseCommand As OleDb.OleDbCommand
        Dim DataReader As OleDb.OleDbDataReader
        Dim IssueToPerson As Foreman
        Try
            Dim terr As Territory
            Dim IssueToListQuery As String = "SELECT * FROM " & gtblForemen & " WHERE "
            Dim IssueToList As String = String.Empty

            TMDS.GlobalDeclarations.gMowForemen.Clear()

            For Each terr In TMDS.GlobalDeclarations.ControlledTerritories
                If IssueToList = "" Then
                    IssueToList = "TerritoryID = " & terr.TerritoryID
                Else
                    IssueToList = IssueToList & " OR TerritoryID = " & terr.TerritoryID
                End If
            Next
            IssueToListQuery = IssueToListQuery & IssueToList
            IssueToListQuery = IssueToListQuery & " ORDER BY LastName;"


            DatabaseCommand = New OleDbCommand(IssueToListQuery, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
            If TMDS.GlobalDeclarations.gDatabaseConnectionDynamic.State <> ConnectionState.Open Then
                TMDS.GlobalDeclarations.gDatabaseConnectionDynamic.Open()
            End If
            DataReader = DatabaseCommand.ExecuteReader()
            While DataReader.Read()
                IssueToPerson = New Foreman()
                With IssueToPerson
                    If Not DataReader.IsDBNull(1) Then
                        .LastName = DataReader.GetString(1).ToUpper
                    End If
                    If Not DataReader.IsDBNull(2) Then
                        .FirstName = DataReader.GetString(2).ToUpper
                    End If
                    If Not DataReader.IsDBNull(3) Then
                        .Initials = DataReader.GetString(3)
                    End If
                    If Not DataReader.IsDBNull(4) Then
                        .AliasName = DataReader.GetString(4)
                    End If
                    If Not DataReader.IsDBNull(5) Then
                        .PIN = DataReader.GetString(5)
                    End If
                    If Not DataReader.IsDBNull(6) Then
                        .VehicleID = DataReader.GetString(6)
                    End If
                    If Not DataReader.IsDBNull(7) Then
                        .TerritoryID = DataReader.GetInt32(7)
                    End If
                    If DataReader.FieldCount >= 14 Then
                        If Not DataReader.IsDBNull(13) Then
                            .EmployeeUID = DataReader.GetString(13)
                        End If
                    End If
                    If DataReader.FieldCount >= 15 Then
                        If Not DataReader.IsDBNull(14) Then
                            .EmployeeType = DataReader.GetString(14)
                        End If
                    End If
                    If DataReader.FieldCount >= 16 Then
                        If Not DataReader.IsDBNull(15) Then
                            .JobType = DataReader.GetString(15)
                        End If
                    End If

                    If CheckForDupMOW(.FirstName, .LastName) Then
                        TMDS.GlobalDeclarations.gMowForemen.Add(IssueToPerson)
                    End If

                End With
            End While

            DataReader.Close()
            TMDS.GlobalDeclarations.gDatabaseConnectionDynamic.Close()
            DatabaseCommand.Dispose()
            DatabaseCommand = Nothing
            'CheckForEICUsers()
            CheckForEICUsers()
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

    Public Function CheckForDupMOW(ByVal FirstName As String, ByVal LastName As String) As Boolean
        Try
            Dim frm As Foreman
            For Each frm In gMowForemen
                If frm.FirstName = FirstName And frm.LastName = LastName Then
                    Return False
                End If
            Next
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Private Sub SetCurrentTimeZone()
        Try
            Dim strMin As String = String.Empty
            Dim UntilTime As Date

            Dim currentMinutes As Integer = Now.Minute
            If currentMinutes >= 0 And currentMinutes <= 15 Then
                strMin = "15"
                'UntilTime = Format(Now, "MM-dd-yy HH:15")
            ElseIf currentMinutes >= 16 And currentMinutes <= 30 Then
                strMin = "30"
                'UntilTime = Format(Now, "MM-dd-yy HH:30")
            ElseIf currentMinutes >= 31 And currentMinutes <= 45 Then
                strMin = "45"
                'UntilTime = Format(Now, "MM-dd-yy HH:45")
            ElseIf currentMinutes >= 45 Then
                strMin = "00"
                'UntilTime = Format(Now.AddHours(1), "MM-dd-yy HH:00")
                'Me.dtUntil.Value = UntilTime
            End If

            Dim TimeFormat As String = "MM-dd-yy HH:" & strMin
            Select Case Me.CurrentTimeZone
                Case "M"
                    If strMin = "00" Then
                        UntilTime = Format(Now, TimeFormat)
                    Else
                        UntilTime = Format(Now.AddHours(-1), TimeFormat)
                    End If

                Case "P"
                    If strMin = "00" Then
                        UntilTime = Format(Now.AddHours(-1), TimeFormat)
                    Else
                        UntilTime = Format(Now.AddHours(-2), TimeFormat)

                    End If

                Case Else
                    If strMin = "00" Then
                        UntilTime = Format(Now.AddHours(1), TimeFormat)
                    Else
                        UntilTime = Format(Now, TimeFormat)
                    End If

            End Select

            Me.dtItem10.Value = UntilTime

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Public Function CheckEngineIDFormatting() As Boolean
        Try
            Dim c As String
            Dim NumericFound As Boolean
            Dim AlphaFound As Boolean
            Dim UnitID As String = String.Empty
            Dim AlphaPart As String = String.Empty
            Dim NumericPart As String = String.Empty

            For Each c In Me.cbIssueTo.Text
                If IsNumeric(c) Then
                    NumericFound = True
                    NumericPart = NumericPart & c
                Else
                    If Not NumericFound Then
                        AlphaPart = AlphaPart & c
                        If c <> " " Then
                            AlphaFound = True
                        End If
                    End If
                End If
            Next

            If Not NumericFound Then
                Return False
            End If
            If Not AlphaFound Then
                Return False
            End If
            Dim SpaceNeeded As Integer = 10 - (AlphaPart.Length + NumericPart.Length)
            If SpaceNeeded < 0 Then
                Return False
            End If
            UnitID = AlphaPart.ToUpper & Space(SpaceNeeded) & NumericPart


            Dim TrainDirection As String = String.Empty
            Select Case FirstTypeOfWarrant
                Case "ItemTwoToTrain", "ItemTwoFiveToTrain"
                    If gSearchDirection = "LEFT" Then
                        If Not IsNothing(thisSubdivision) Then
                            If thisSubdivision.SubDirection Then
                                TrainDirection = "SOUTH"
                            Else
                                TrainDirection = "WEST"
                            End If
                        Else
                            TrainDirection = "WEST"
                        End If

                    Else
                        If Not IsNothing(thisSubdivision) Then
                            If thisSubdivision.SubDirection Then
                                TrainDirection = "NORTH"
                            Else
                                TrainDirection = "EAST"
                            End If
                        Else
                            TrainDirection = "EAST"
                        End If
                    End If
            End Select
            SystemEvent("CHANGE EVENT RECORDED FOR AUTHORITY NUMBER:" & AuthorityNumberString & ". ISSUE TO BOX SELECTION CHANGE TO THIS TEXT FROM ENGINE ID FORMATTING:" & UnitID & " " & TrainDirection)

            Me.cbIssueTo.Text = UnitID & " " & TrainDirection
            Me.IssueTo = Me.cbIssueTo.Text
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Function GetEngineIDFormatting(ByVal trn As TrainID) As String
        Try
            Dim c As String
            Dim NumericFound As Boolean
            Dim UnitID As String = trn.IdentifingUnit
            Dim AlphaPart As String = String.Empty
            Dim NumericPart As String = String.Empty

            For Each c In UnitID
                If IsNumeric(c) Then
                    NumericFound = True
                    NumericPart = NumericPart & c
                Else
                    If Not NumericFound Then
                        AlphaPart = AlphaPart & c
                    End If
                End If
            Next

            If Not NumericFound Then
                Return False
            End If

            Dim SpaceNeeded As Integer = 10 - (AlphaPart.Length + NumericPart.Length)
            If SpaceNeeded < 0 Then
                Return False
            End If
            UnitID = AlphaPart.ToUpper & Space(SpaceNeeded) & NumericPart


            Dim TrainDirection As String = String.Empty
            Select Case FirstTypeOfWarrant
                Case "ItemTwoToTrain", "ItemTwoFiveToTrain"
                    If gSearchDirection = "LEFT" Then
                        If Not IsNothing(thisSubdivision) Then
                            If thisSubdivision.SubDirection Then
                                TrainDirection = "SOUTH"
                            Else
                                TrainDirection = "WEST"
                            End If
                        Else
                            TrainDirection = "WEST"
                        End If

                    Else
                        If Not IsNothing(thisSubdivision) Then
                            If thisSubdivision.SubDirection Then
                                TrainDirection = "NORTH"
                            Else
                                TrainDirection = "EAST"
                            End If
                        Else
                            TrainDirection = "EAST"
                        End If
                    End If
            End Select

            Dim newString As String = UnitID & " " & TrainDirection
            Return newString
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

    Private Function CheckMOWIDFormatting() As Boolean
        Try
            Dim c As String
            Dim NumericFound As Boolean
            Dim CommaFound As Boolean

            For Each c In Me.cbIssueTo.Text
                If IsNumeric(c) Then
                    NumericFound = True
                    Exit For
                Else
                    If c = "," Then
                        CommaFound = True
                    End If
                End If
            Next

            If NumericFound Then
                Return False
            End If
            If Not CommaFound Then
                Return False
            End If

            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Public Sub PerformForemanCheckFromTrackReservation(ByVal IssueToName As String)
        Try
            Dim First As String = String.Empty
            Dim Last As String = String.Empty
            Dim data() As String = IssueToName.Split(",")
            If data.Length = 2 Then
                Last = Trim(data(0))
                First = Trim(data(1))
            End If

            If CheckForDupMOW(First, Last) Then
                Me.cbIssueTo.Items.Add(Last.ToUpper & ", " & First.ToUpper)
            Else
                Me.cbIssueTo.Text = Last.ToUpper & ", " & First.ToUpper
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub
