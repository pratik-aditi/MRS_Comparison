    Private Function OkToOverRideGPSPrompt(ByVal SFAVoidAuth As TMDS.TrackAuthority.SFAuthority) As Boolean
        Dim rpcomp As Object = Nothing
        Try
            Dim strIssueTo As String
            strIssueTo = Mid(Me.IssueTo, 1, 10)
            If strIssueTo.Trim = "ISSUE TO" Then
                strIssueTo = Mid(cbIssueTo.Text, 1, 10)
            End If

            If Mid(SFAVoidAuth.IssueTo, 1, 10) = strIssueTo And Me.IssuedToTrain Then
                Dim blnCompExistinVoidAuth As Boolean = False
                For Each rpcomp In Me.CompleteCompSelection
                    If SFAVoidAuth.Components.Contains(rpcomp) Then
                        Return True
                    End If
                Next
            End If
        Catch ex As Exception
            GetErrorDetails(ex)
            Return False
        Finally
            rpcomp = Nothing
        End Try
        Return False
    End Function

