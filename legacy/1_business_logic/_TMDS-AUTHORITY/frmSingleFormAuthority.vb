#Region " TIWS "

    Public Sub UpdateTrackZoneStatus(trk As Track)
        Try
            If Me.CompleteCompSelection.Contains(trk) Then
                Dim IssuingAuthZonelist As New ArrayList
                IssuingAuthZonelist = GetZoneListWithinAuthority()

                Dim tzn As TrackZone
                If trk.TrackZoneIntegrityMonitoringEnabled AndAlso Not IsNothing(trk.TrackZoneReference) Then
                    tzn = trk.TrackZoneReference
                    If IsAdjacentZoneIdentified(IssuingAuthZonelist, tzn.ZoneName) Then
                        If Not TrackZoneIdentifiedList.Contains(tzn) Then
                            TrackZoneIdentifiedList.Add(tzn)
                            AddAuthorityUIDToZone()
                        End If
                    Else
                        If Me.FirstTypeOfWarrant = "ItemTwoToTrain" Then
                            If tzn.ZoneName.ToUpper = IssuingAuthZonelist(0).ZoneName.toupper Then
                                TrackZoneIdentifiedList.Add(tzn)
                                AddAuthorityUIDToZone()
                            End If
                        End If
                    End If
                End If
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function PerformFinalChecksDuringIssuance() As Boolean
        Dim SFA As TMDS.TrackAuthority.SFAuthority = Nothing
        Dim VoidCompCollection As New ArrayList
        Dim comp As Object = Nothing
        Dim TrackZoneBehindMyTrain As New ArrayList
        Dim ZoneTrainIsOn As TrackZone = Nothing
        Dim TmpOriginalIdentifiedZones As New ArrayList
        Dim TmpZonesOccupiedZones As New ArrayList
        Try
            Dim ConflictDetected As Boolean
            CopyArrayCollection(TmpOriginalIdentifiedZones, TrackZoneIdentifiedList)
            Dim IsMeEnabledForTIWS As Boolean = True
            If chkItem1.Checked Then
                SFA = Nothing
                SFA = FindAuthority(Me.cmbItem1Void1.Text)
                If SFA IsNot Nothing Then
                    For Each comp In SFA.Components
                        If Not VoidCompCollection.Contains(comp) Then VoidCompCollection.Add(comp)
                    Next
                End If
            End If
            If chkItem2.Checked Then
                SFA = Nothing
                SFA = FindAuthority(Me.cmbItem1Void2.Text)
                If SFA IsNot Nothing Then
                    For Each comp In SFA.Components
                        If Not VoidCompCollection.Contains(comp) Then VoidCompCollection.Add(comp)
                    Next
                End If
            End If
            If chkItem3.Checked Then
                SFA = Nothing
                SFA = FindAuthority(Me.cmbItem1Void3.Text)
                If SFA IsNot Nothing Then
                    For Each comp In SFA.Components
                        If Not VoidCompCollection.Contains(comp) Then VoidCompCollection.Add(comp)
                    Next
                End If
            End If

            If gSwitchPointMonitoringExists Then
                If Not LastSwitchCheckForSPMS() Then
                    gHistoryMessage = "SWITCH POINT MONITOR EVENT DETECTED DURING ISSUANCE PROCESS! PLEASE RE-ISSUE THE AUTHORITY."
                    AuthorityEvent(gHistoryMessage)
                    MessageBox.Show(Me, gHistoryMessage, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    ConflictDetected = True
                End If
            End If


            'If gBeginTrackSelect.TrackZoneReference Is Nothing Then
            '    IsMeEnabledForTIWS = False
            'End If

            'ADD ZONES BEHIND THE TRAIN 
            comp = Nothing
            TrackZoneBehindMyTrain = New ArrayList
            TrackZoneBehindMyTrain = GetZonesBehindTrainInAuthority(Me, ZoneTrainIsOn)

            AddAuthorityUIDToZone()

            If gTrackIntegrityMonitoringExists And Not ConflictDetected AndAlso Me.FirstTypeOfWarrant <> "ItemFourToMOW" AndAlso IsMeEnabledForTIWS Then
                Dim ShowTrackZoneWarning As Boolean = False


                Dim FoulingTrackSPMSlist As New ArrayList
                FoulingTrackSPMSlist = GetFoulingTrackSPMSWithinAuthority()

                Dim IssuingAuthZonelist As New ArrayList
                IssuingAuthZonelist = GetZoneListWithinAuthority()

                Dim IssuingAuthOOSZoneDownList As New ArrayList
                Dim tmpList As New ArrayList
                Dim tmpZn As ZoneDetail
                For Each zn As ZoneDetail In IssuingAuthZonelist
                    tmpZn = zn
                    tmpZn.ZoneIdentified = False
                    If IsZoneIdentified(tmpZn.ZoneName) Then
                        tmpZn.ZoneIdentified = True
                    End If
                    tmpList.Add(tmpZn)
                Next

                For Each zn As ZoneDetail In tmpList
                    If zn.ZoneDown And Not zn.ZoneIdentified Then
                        ''if three zones are down and in box 14  (means none of the zone is identified as train) then if the fourth zone goes down while in TW build form the TW issue process will exit after warning.
                        If SelectedAllZoneList.Count > 0 AndAlso IsAdjacentZoneIdentified(tmpList, zn.ZoneName) Then
                            zn.ZoneIdentified = True
                            If Not TrackZoneIdentifiedList.Contains(zn.ZoneTrackList(0).TrackZoneReference) Then
                                TrackZoneIdentifiedList.Add(zn.ZoneTrackList(0).TrackZoneReference)
                                AddAuthorityUIDToZone()
                                If Not Me.myTrainTIWSOccupacny.Contains(zn.ZoneTrackList(0).TrackZoneReference) Then Me.myTrainTIWSOccupacny.Add(zn.ZoneTrackList(0).TrackZoneReference)
                            End If
                        Else
                            IssuingAuthOOSZoneDownList.Add(zn)
                        End If
                    ElseIf zn.ZoneDown And zn.ZoneIdentified Then
                        If Not Me.myTrainTIWSOccupacny.Contains(zn.ZoneTrackList(0).TrackZoneReference) Then Me.myTrainTIWSOccupacny.Add(zn.ZoneTrackList(0).TrackZoneReference)
                    End If
                Next

                If chkItem1.Checked Then
                    Dim VoidAuthZonelist As New ArrayList
                    Dim VoidAuthZoneDownlist As New ArrayList
                    Dim VoidAuthFoulingTrackSPMSlist As New ArrayList

                    VoidAuthFoulingTrackSPMSlist = GetVoidAuthFoulingTrackSPMSList(VoidCompCollection)
                    VoidAuthZonelist = GetZoneListWithinVoidAuthority(VoidCompCollection)

                    For Each zn As ZoneDetail In VoidAuthZonelist
                        If zn.ZoneDown And Not zn.ZoneIdentified Then
                            VoidAuthZoneDownlist.Add(zn)
                        End If
                    Next
                    If VoidAuthZoneDownlist.Count > 0 AndAlso IssuingAuthOOSZoneDownList.Count > 0 Then
                        For Each zn As ZoneDetail In VoidAuthZoneDownlist
                            For Each izn As ZoneDetail In IssuingAuthOOSZoneDownList
                                If izn.ZoneName = zn.ZoneName AndAlso Not TrackZoneBehindMyTrain.Contains(izn.ZoneName) Then
                                    ShowTrackZoneWarning = True
                                    Exit For
                                End If
                            Next
                        Next

                        For Each izn As ZoneDetail In IssuingAuthOOSZoneDownList
                            If Not VoidAuthZoneDownlist.Contains(izn) AndAlso Not TrackZoneBehindMyTrain.Contains(izn.ZoneName) Then
                                ShowTrackZoneWarning = True
                                Exit For
                            End If
                        Next
                    End If

                    If tmpList.Count > 0 Then
                        For Each izn As ZoneDetail In tmpList
                            If izn.ZoneDown Then
                                Dim ZoneInVoidLimits As Boolean = False
                                For Each zn As ZoneDetail In VoidAuthZoneDownlist
                                    If zn.ZoneName.Trim = izn.ZoneName.Trim Then
                                        ZoneInVoidLimits = True
                                        If Not TmpZonesOccupiedZones.Contains(izn.ZoneDetailsTrackZone) Then TmpZonesOccupiedZones.Add(izn.ZoneDetailsTrackZone)
                                        Exit For
                                    End If
                                Next
                                If Not ZoneInVoidLimits Then
                                    Dim TZnTrack As Track
                                    For Each TZnTrack In izn.ZoneTrackList
                                        If TZnTrack.Authorities.Count = 0 Then
                                            ShowTrackZoneWarning = True
                                            If Not TmpZonesOccupiedZones.Contains(izn.ZoneDetailsTrackZone) Then TmpZonesOccupiedZones.Add(izn.ZoneDetailsTrackZone)
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                        Next
                    End If

                    If FoulingTrackSPMSlist.Count > 0 Then
                        Dim fltrk As Track
                        For Each fltrk In FoulingTrackSPMSlist
                            If fltrk.Occuppied Then
                                If Not VoidAuthFoulingTrackSPMSlist.Contains(fltrk) Then
                                    Dim FoulTrackParentZone As TrackZone = Nothing
                                    FoulTrackParentZone = GetFoulingTrkParentZone(fltrk)
                                    If FoulTrackParentZone IsNot Nothing Then
                                        If TrackZoneIdentifiedList.Contains(fltrk.TrackZoneReference) Or TrackZoneIdentifiedList.Contains(FoulTrackParentZone) Then
                                        Else
                                            ShowTrackZoneWarning = True
                                        End If
                                    Else
                                        If Not TrackZoneIdentifiedList.Contains(fltrk.TrackZoneReference) Then
                                            ShowTrackZoneWarning = True
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    End If

                    If VoidAuthFoulingTrackSPMSlist.Count > 0 Then
                        Dim vcomp As Object
                        For Each vcomp In VoidAuthFoulingTrackSPMSlist
                            If vcomp.Occuppied Then
                                If FoulingTrackSPMSlist.Contains(vcomp) Then
                                    Dim FoulTrackParentZone As TrackZone = Nothing
                                    FoulTrackParentZone = GetFoulingTrkParentZone(vcomp)
                                    If FoulTrackParentZone IsNot Nothing Then
                                        If TrackZoneIdentifiedList.Contains(vcomp.TrackZoneReference) Or TrackZoneIdentifiedList.Contains(FoulTrackParentZone) Then
                                        Else
                                            ShowTrackZoneWarning = True
                                        End If
                                    Else
                                        If Not TrackZoneIdentifiedList.Contains(vcomp.TrackZoneReference) Then
                                            ShowTrackZoneWarning = True
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    End If
                Else
                    If IssuingAuthOOSZoneDownList.Count > 0 Then
                        For Each izn As ZoneDetail In IssuingAuthOOSZoneDownList
                            If Not TmpZonesOccupiedZones.Contains(izn.ZoneDetailsTrackZone) Then TmpZonesOccupiedZones.Add(izn.ZoneDetailsTrackZone)
                        Next
                        ShowTrackZoneWarning = True
                    End If

                    If FoulingTrackSPMSlist.Count > 0 Then
                        Dim fltrk As Track
                        For Each fltrk In FoulingTrackSPMSlist
                            If fltrk.Occuppied Then
                                Dim FoulTrackParentZone As TrackZone = Nothing
                                FoulTrackParentZone = GetFoulingTrkParentZone(fltrk)
                                If FoulTrackParentZone IsNot Nothing Then
                                    If TrackZoneIdentifiedList.Contains(fltrk.TrackZoneReference) Or TrackZoneIdentifiedList.Contains(FoulTrackParentZone) Then
                                    Else
                                        ShowTrackZoneWarning = True
                                    End If
                                Else
                                    If Not TrackZoneIdentifiedList.Contains(fltrk.TrackZoneReference) Then
                                        ShowTrackZoneWarning = True
                                    End If
                                End If
                            End If
                        Next
                    End If
                End If

                'Added this condition to satisfy BNSF-375 Specific to Box4. 
                If ShowTrackZoneWarning AndAlso Me.IsWorkAuthority Then
                    Dim tz As TrackZone
                    Dim OverrideConflictCheck As Boolean = True
                    If TmpOriginalIdentifiedZones IsNot Nothing AndAlso TmpOriginalIdentifiedZones.Count > 0 Then
                        For Each tz In TmpZonesOccupiedZones
                            If Not TmpOriginalIdentifiedZones.Contains(tz) Then
                                OverrideConflictCheck = False
                                Exit For
                            End If
                        Next
                    Else
                        OverrideConflictCheck = False
                    End If

                    If OverrideConflictCheck Then ShowTrackZoneWarning = False
                End If

                If ShowTrackZoneWarning Then
                    gHistoryMessage = "TRACK ZONE EVENT DETECTED DURING ISSUANCE PROCESS! PLEASE RE-ISSUE THE AUTHORITY."
                    AuthorityEvent(gHistoryMessage)
                    MessageBox.Show(Me, gHistoryMessage, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    ConflictDetected = True
                End If

            End If

            If ConflictDetected Then
                RemoveAuthorityUIDFromZone()
                ForceVoidAuthority = True
                Me.btnVoid.PerformClick()
                Return False
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        Finally
            VoidCompCollection = New ArrayList
            TrackZoneBehindMyTrain = Nothing
        End Try
    End Function

    Public Function IsAdjacentZoneIdentified(ByVal pZoneList As ArrayList, ByVal pZoneName As String) As Boolean
        Try
            If pZoneList.Count > 1 Then
                For znindx As Integer = 0 To pZoneList.Count - 1
                    If pZoneList(znindx).ZoneName.toupper = pZoneName.ToUpper Then
                        Dim currseq As Int32 = znindx
                        Dim Prevseq As Int32 = -1
                        Dim Nextseq As Int32 = -1
                        If (znindx - 1) >= 0 Then
                            Prevseq = znindx - 1
                        End If
                        If (znindx + 1) <= (pZoneList.Count - 1) Then
                            Nextseq = znindx + 1
                        End If
                        If currseq <> -1 AndAlso Prevseq <> -1 Then
                            Dim zn1 As ZoneDetail = pZoneList(Prevseq)
                            Dim zn2 As ZoneDetail = pZoneList(currseq)
                            If zn1.ZoneSequence + 1 = zn2.ZoneSequence Then
                                'If zn1.ZoneIdentified Then
                                '    Return True
                                'End If
                                If IsZoneIdentified(zn1.ZoneName) Then
                                    Return True
                                End If
                            End If
                        End If
                        If currseq <> -1 AndAlso Nextseq <> -1 Then
                            Dim zn1 As ZoneDetail = pZoneList(currseq)
                            Dim zn2 As ZoneDetail = pZoneList(Nextseq)
                            If zn1.ZoneSequence + 1 = zn2.ZoneSequence Then
                                'If zn2.ZoneIdentified Then
                                '    Return True
                                'End If
                                If IsZoneIdentified(zn2.ZoneName) Then
                                    Return True
                                End If
                            End If
                        End If
                    End If
                Next
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return False
    End Function

    Public Function IsZoneIdentified(ByVal pZoneName As String) As Boolean
        Try
            Dim tzn As TrackZone
            If TrackZoneIdentifiedList.Count > 0 Then
                For Each tzn In TrackZoneIdentifiedList
                    If tzn.ZoneName = pZoneName Then
                        Return True
                    End If
                Next
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return False
    End Function

