    Private Function RemoveOsTracks(ByVal CompList As ArrayList, ByVal sw As Switch) As ArrayList
        Try
            Dim NewList As New ArrayList
            Dim comp As Object
            For Each comp In CompList
                If sw.OsComponentCollection.Contains(comp) Then
                    Return NewList
                Else
                    NewList.Add(comp)
                End If
            Next
            Return Nothing
