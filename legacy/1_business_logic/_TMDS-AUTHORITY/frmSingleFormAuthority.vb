#Region "NEW TRACK INTEGRITY MONITOR CHECKS"

    Dim OccupiedZoneListBeforeIssue As New ArrayList
    Dim OccupiedZoneList As New ArrayList
    Dim SelectedAllZoneList As New ArrayList
    Dim SelectedZoneList As New ArrayList
    Dim SelectedFoulingZoneList As New ArrayList
    Dim box14Comp As New ArrayList
    Dim FoulingBox14Comp As New ArrayList
