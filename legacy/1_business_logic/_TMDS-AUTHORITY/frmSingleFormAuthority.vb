    Private Function CheckToEnsureStartInBoxFourLimitsIfLimitsExist() As Boolean
        Try
            Dim IssueToCheck As String = String.Empty
            Dim Wait As Date = Now 'threading race block
            Do
                Threading.Thread.Sleep(100)
                Application.DoEvents()
                If Wait < Now.AddMilliseconds(-500) Then Exit Do
            Loop


            If IsNothing(VoidedWarrant) Then
                IssueToCheck = Me.cbIssueTo.Text
            Else
                IssueToCheck = VoidedWarrant.IssueTo
            End If

            If Mid(Me.FirstTypeOfWarrant, 1, 7) = "ItemTwo" Then
                Dim sfa As SFAuthority
                For Each sfa In gBeginTrackSelect.TrackAuthorities
                    If sfa.CheckBoxItemsStatus(7) And Mid(sfa.IssueTo, 1, 10) <> Mid(IssueToCheck, 1, 10) Then
                        Return True
                    End If
                Next

                Dim comp As Object
                For Each comp In CompleteCompSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(comp, Track)
                        If trk.TrackAuthorities.Count > 0 Then
                            For Each sfa In trk.TrackAuthorities
                                If Not sfa.IssuedToTrain And sfa.CheckBoxItemsStatus(7) Then
                                    Return False
                                End If
                                If sfa.IssuedToTrain And sfa.CheckBoxItemsStatus(7) And sfa.AuthType1 = "ItemFourToTrain" Then
                                    If Mid(sfa.IssueTo, 1, 10) <> Mid(IssueToCheck, 1, 10) Then
                                        Return False
                                    End If
                                End If
                            Next
                        End If
                    End If
                Next
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Sub CheckForForwardAuthorities()
        Dim MultipleAuthoritiesFound As Boolean
        Try

            If Not CheckForParallelAuthorities() Then
                'Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                'Dim frmMessageBox As frmMessageBox
                'Dim MessageList As New ArrayList()
