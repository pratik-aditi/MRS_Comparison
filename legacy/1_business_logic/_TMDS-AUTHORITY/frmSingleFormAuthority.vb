#Region "TRACK WARRANT FORM SETUP"

    Private Function CheckForTrainPositionOnRelease() As Boolean
        Try

            Dim auth1 As SFAuthority = FindAuthority(Me.cmbItem1Void1.Text)
            If Not IsNothing(auth1) Then
                If Not auth1.CheckToVerifyPositionOnReportClear(Me.CompleteCompSelection, False, True) Then
                    Return False
                End If
            End If

            Dim auth2 As SFAuthority = FindAuthority(Me.cmbItem1Void2.Text)
            If Not IsNothing(auth2) Then
                If Not auth2.CheckToVerifyPositionOnReportClear(Me.CompleteCompSelection, False, True) Then
                    Return False
                End If
            End If

            Dim auth3 As SFAuthority = FindAuthority(Me.cmbItem1Void3.Text)
            If Not IsNothing(auth3) Then
                If Not auth3.CheckToVerifyPositionOnReportClear(Me.CompleteCompSelection, False, True) Then
                    Return False
                End If
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Private Sub RemoveAuthority(ByVal auth As SFAuthority)
        Try

            auth.ReportClearTime = Now
            Dim OverrideRemoval As Boolean
            If Me.ForcePTCOperations And Me.RestrictingAuthority Then
                OverrideRemoval = True
            End If
            If Not OverrideRemoval Then
                If auth.RemoveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                    If auth.RemoveAuthorityFromComponents() Then
                        TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(auth)
                        Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", auth)
                        SyncLock gSummaryAuthQueue.SyncRoot
                            gSummaryAuthQueue.Enqueue(SummItem)
                        End SyncLock
                        Me.AuthorityEvent("AUTHORITY REMOVED FROM BOX ONE SELECTION - " & auth.AuthorityUID)
                    End If
                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub RemoveVoidedAuthorities()
        Dim comp As Object = Nothing
        Try

            Dim auth1 As SFAuthority = FindAuthority(Me.cmbItem1Void1.Text)
            If Not IsNothing(auth1) Then
                RemoveAuthority(auth1)
            End If

            Dim auth2 As SFAuthority = FindAuthority(Me.cmbItem1Void2.Text)
            If Not IsNothing(auth2) Then
                RemoveAuthority(auth2)
            End If

            Dim auth3 As SFAuthority = FindAuthority(Me.cmbItem1Void3.Text)
            If Not IsNothing(auth3) Then
                RemoveAuthority(auth3)
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub AddVoidedAuthoritiesToPTCCollection()
        Dim comp As Object = Nothing
        Try

            Dim auth1 As SFAuthority = FindAuthority(Me.cmbItem1Void1.Text)
            If Not IsNothing(auth1) Then
                If auth1.PTCTypeAuthority Then
                    auth1.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.VOID.ToString
                    For Each comp In auth1.Components
                        auth1.PTCAuthorityComponents.Add(comp)
                    Next
                    auth1.UpdateDatabaseWithPTCComponents()
                    PTCVOIDEDAuthories.Add(auth1)
                    'TMDS.NetworkMessages.PTCBOSAPIMessaging.SendAuthorityRelease(auth1)
                    TMDS.NetworkMessages.PTCBOSAPIMessaging.SendAuthorityVOID(auth1)
                End If
            End If

            Dim auth2 As SFAuthority = FindAuthority(Me.cmbItem1Void2.Text)
            If Not IsNothing(auth2) Then
                If auth1.PTCTypeAuthority Then
                    auth2.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.VOID.ToString
                    For Each comp In auth2.Components
                        auth2.PTCAuthorityComponents.Add(comp)
                    Next
                    auth2.UpdateDatabaseWithPTCComponents()
