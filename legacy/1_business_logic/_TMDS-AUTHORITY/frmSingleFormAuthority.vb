    Private Function CheckDirectionChange(ByVal LaunchPoint As Point) As Boolean
        Try
            Dim NewIssueTo As String = String.Empty
            Dim StringReplacement As String = String.Empty
            Dim strPosition As Integer

            If gSearchDirection = "RIGHT" Then
                If Not gSubdivisionDirection Then
                    StringReplacement = "EAST"
                Else
                    StringReplacement = "NORTH"
                End If
            ElseIf gSearchDirection = "LEFT" Then
                If Not gSubdivisionDirection Then
                    StringReplacement = "WEST"
                Else
                    StringReplacement = "SOUTH"
                End If
            End If
            strPosition = InStr(VoidedWarrant.IssueTo, "WORK")
            If strPosition > 0 Then
                NewIssueTo = Mid(VoidedWarrant.IssueTo, 1, strPosition - 1) & StringReplacement
            Else
                If InStr(VoidedWarrant.IssueTo, StringReplacement) = 0 Then
                    NewIssueTo = VoidedWarrant.IssueTo & " " & StringReplacement
                Else
                    NewIssueTo = VoidedWarrant.IssueTo
                End If
            End If
            If Not optDisableItemTwoToItemFourDirectionPrompt And VoidedWarrant.AuthType1 = "ItemFourToTrain" Then
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()
                MessageList.Add("IS THIS TO THE CORRECT ENGINE AND THE CORRECT DIRECTION?")
                MessageList.Add("ENGINE/DIRECTION: " & NewIssueTo)
                MessageList.Add("")
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = Me
                frmMessageBox.SetMessage(MessageList, "ENGINE ID CHANGE CONFIRMATION", True, LaunchPoint)
                frmMessageBox.ShowDialog()
                If frmMessageBox.FormFeedBack <> 6 Then
                    AuthorityEvent("SELECTED - NO TO CORRECT ENGINE AND THE CORRECT DIRECTION! - EXIT SUB")
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    Return False
                Else
                    AuthorityEvent("SELECTED - YES TO CORRECT ENGINE AND THE CORRECT DIRECTION! - EXIT SUB")
                End If
                frmMessageBox.Dispose()
                frmMessageBox = Nothing
            End If

            Me.cbIssueTo.Text = NewIssueTo
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

