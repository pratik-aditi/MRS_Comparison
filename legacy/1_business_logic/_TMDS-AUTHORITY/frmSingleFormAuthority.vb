    Private Function GetOccupiedZones(ByVal CompCollection As ArrayList, Optional ByVal PrevOccupiedAndSelList As ArrayList = Nothing) As ArrayList
        Dim ZoneList As New ArrayList
        Try
            Dim comp As Object
            For Each comp In CompCollection
                If comp.GetType.ToString = gTrackComponentName Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.TrackZoneIntegrityMonitoringEnabled Then
                        If trk.Occuppied Then
                            If Not ZoneList.Contains(trk.TrackZoneReference) Then
                                ZoneList.Add(trk.TrackZoneReference)
                            End If
                        Else
                            If Not IsNothing(PrevOccupiedAndSelList) AndAlso PrevOccupiedAndSelList.Count > 0 Then
                                If PrevOccupiedAndSelList.Contains(trk.TrackZoneReference) Then
                                    If Not ZoneList.Contains(trk.TrackZoneReference) Then
                                        ZoneList.Add(trk.TrackZoneReference)
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
            Next
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return ZoneList
    End Function

    Public Function GetTrackZoneWithinCollection(ByVal complist As ArrayList) As ArrayList
        Dim comp As Object
        Dim tzn As TrackZone
        Dim TZnTrack As Track
        Dim AuthZonelist As New ArrayList
        Try
            For Each comp In complist
                If comp.GetType.ToString = gTrackComponentName Then
                    Dim trk As Track = CType(comp, Track)
                    tzn = trk.TrackZoneReference
                    If Not IsNothing(tzn) Then
                        If tzn.ZoneName.ToUpper.Contains("ZONE") Then
                            Dim eZn As ZoneDetail
                            Dim ZoneFirstTrack As Track
                            Dim znExist As Boolean = False
                            For Each eZn In AuthZonelist
                                If eZn.ZoneName = tzn.ZoneName Then
                                    znExist = True
                                    Exit For
                                End If
                            Next

                            Dim Zn As New ZoneDetail
                            If Not znExist Then
                                Zn.ZoneName = tzn.ZoneName
                                Zn.ZoneId = tzn.ZoneUID
                                Zn.ZoneSequence = AuthZonelist.Count + 1
                                ZoneFirstTrack = tzn.TrackList.Item(0)
                                Zn.OccupiedTrainAuthUIDList = tzn.OccupiedTrainAuthUIDList.Clone
                                Zn.ZoneDown = False
                                Zn.ZoneTrackList = tzn.TrackList.Clone
                                Zn.ZoneDetailsTrackZone = tzn
                                For Each TZnTrack In tzn.TrackList
                                    If TZnTrack.Occuppied Then
                                        Zn.ZoneDown = True
                                        Exit For
                                    End If
                                Next
                                AuthZonelist.Add(Zn)
                            End If
                        End If
                    End If
                End If
            Next
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return AuthZonelist
    End Function

