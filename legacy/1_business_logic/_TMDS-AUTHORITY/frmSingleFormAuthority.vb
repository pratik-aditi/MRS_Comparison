    Private Sub btnDone_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnDone.Click
        Try
            SystemEvent("CHANGE EVENT RECORDED FOR AUTHORITY NUMBER:" & AuthorityNumberString & ". DONE BUTTON SELECTED.")

            If Me.mySFAuthority.AuthType1 = "ItemTwoToTrain" Or Me.mySFAuthority.AuthType1 = "ItemFourToTrain" Then

                Dim trn As TrainID = Me.TrainExistsForAuthority(Me.mySFAuthority, False)
                If Not trn Is Nothing Then
                    trn.AuthorityIssuedToMe = True
                    If Not trn.ReadOnlySymbol Then
                        Dim PromptUser As Boolean = True
                        If gBeginTrackSelect Is trn.myTrack Or ((trn.myTrack.TrackName <> gBeginTrackSelect.TrackName) And optVerifyTrainMovementOnMainTrackBeforeSymbolMove) Then
                            PromptUser = False
                        End If
                        If PromptUser Then
                            Dim LaunchPoint As Point = New Point(Me.Left + 50, Me.Top + 50)
                            Dim frmMessageBox As frmMessageBox
                            Dim MessageList As New ArrayList()
                            MessageList.Add("EXISTING TRAIN FOUND FOR TRACK AUTHORITY: (" & trn.Name & ")(" & trn.IdentifingUnit & ")")
                            MessageList.Add("MOVE TRAIN SYMBOL TO BEGINNING OF AUTHORITY?")
                            MessageList.Add("")
                            frmMessageBox = New frmMessageBox()
                            frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm
                            frmMessageBox.SetMessage(MessageList, "MOVE TRAIN SYMBOL CONFIRMATION", True, LaunchPoint)
                            frmMessageBox.ShowDialog()
                            If frmMessageBox.FormFeedBack = 6 Then
                                gBeginTrackSelect.MoveTrainIDPlaceManual(trn, trn.myTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                            End If
                            frmMessageBox.Dispose()
                            frmMessageBox = Nothing
                        End If

                    End If
                End If
            End If
            If gSwitchPointMonitoringExists Then
                Me.CheckToAcknowledgeSwitchPointAlerts()
            End If

            If Me.ForcePTCOperations And Me.RestrictingAuthority Then
                'Me.RemoveVoidedAuthorities()
            End If

            If optEnablePTCBOSAPIMode Then
                TMDS.NetworkMessages.PTCBOSAPIMessaging.SendAuthorityIssue(mySFAuthority)
            End If


            If optEnablePTCBOSAPIMode And TrainIsActivePTC And Me.RestrictingAuthority And Me.IssuedToTrain Then
                AddVoidedAuthoritiesToPTCCollection()
            ElseIf optEnablePTCBOSAPIMode And Me.IssuedToTrain And TrainIsActivePTC Then
                TMDS.NetworkMessages.PTCBOSAPIMessaging.SendAuthorityIssue(mySFAuthority)
                mySFAuthority.PTCTypeAuthority = True
                Me.mySFAuthority.UpdateDatabaseWithPTCAuthorityStatus("TEXT-SENT")
                mySFAuthority.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ISSUE.ToString
                mySFAuthority.PTCAuthorityComponents = mySFAuthority.Components
                mySFAuthority.UpdateDatabaseWithPTCComponents()
                mySFAuthority.FlasherMode(True)
            ElseIf optEnablePTCBOSVETMSMode And ForcePTCOperations Then
                mySFAuthority.PTCStatus = "AUTHORITY-SENT"
                mySFAuthority.SetPTCAuthorityFlasherStatus()
                mySFAuthority.FlasherMode(True)
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageCreate_TWC(mySFAuthority, PTCTrainFound, MessageUID)
            End If

            ClearSystemVariables()
            If optEnablePTCBOSAPIMode Then
                If Not PTCVOIDEDAuthories Is Nothing Then
                    If PTCVOIDEDAuthories.Count > 0 Then
                        Dim auth As TrackAuthority.SFAuthority
                        For Each auth In PTCVOIDEDAuthories
                            auth.FlasherMode(True, True)
                        Next

                    End If
                End If
            End If
            Me.Valid = True
            Me.CloseForm()
            If optEnableOverviewForTWC Then
                If Not IsNothing(gOverviewTWC) Then
                    SyncLock gOverviewTWC.myQueue
                        Try
                            If Me.mySFAuthority.Subdivision.Trim.ToUpper = gOverviewTWC.cmbSubs.Text.Trim.ToUpper Then
                                gOverviewTWC.myQueue.Enqueue("REFRESH")
                            End If
                        Catch ex As Exception
                            SystemException(ex.ToString)
                        End Try
                    End SyncLock
                End If
            End If

            If MovementPlanningDetected Then
                If Me.mySFAuthority.CheckBoxItemsStatus(7) And Me.mySFAuthority.CheckBoxItemsStatus(3) Then
                    If Me.chkAbsolute.Checked Then
                        TMDS.NetworkMessages.MPARMessages.SendAbsoluteBlockMessage(Me.mySFAuthority)
                    Else
                        TMDS.NetworkMessages.MPARMessages.SendSpeedRestrictionMessage(Me.mySFAuthority)
                    End If
                ElseIf Me.mySFAuthority.CheckBoxItemsStatus(3) Then
                    TMDS.NetworkMessages.MPARMessages.SendAbsoluteBlockMessage(Me.mySFAuthority)
                ElseIf Me.mySFAuthority.CheckBoxItemsStatus(1) Then
                    TMDS.NetworkMessages.MPARMessages.SendTrackWarrantRouteStatusMessage(Me.mySFAuthority)
                    If Me.mySFAuthority.CheckBoxItemsStatus(7) Then
                        TMDS.NetworkMessages.MPARMessages.SendSpeedRestrictionMessage(Me.mySFAuthority)
                    End If
                End If
                mySFAuthority.PublishSFAIssueForPlanning(mySFAuthority.TerrID1)
            End If


        Catch ex As Exception
            ClearSystemVariables()
            Me.Close()
            SystemException(ex.ToString)
        End Try
    End Sub

