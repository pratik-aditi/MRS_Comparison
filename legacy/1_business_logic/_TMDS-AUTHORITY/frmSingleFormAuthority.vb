    Private Sub AddOsComponentsToSelection(ByRef ComponentSelection As ArrayList)
        Try
            Dim comp As Object
            Dim CloneList As ArrayList = ComponentSelection.Clone
            For Each comp In CloneList
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.OStype Then
                        If Not IsNothing(trk.OsComponentCollection) Then
                            Dim OSComp As Object
                            Dim Index As Integer = ComponentSelection.IndexOf(trk)
                            For Each OSComp In trk.OsComponentCollection
                                If Not ComponentSelection.Contains(OSComp) Then
                                    ComponentSelection.Insert(Index, OSComp)
                                End If
                            Next
                        End If
                    End If

                End If
            Next
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub


    Private Sub GetSFASpanningTerritories(ByVal BeginTerritoryID As Integer, ByVal EndTerritoryID As Integer, ByVal CompCollection As ArrayList)
        Dim comp As Object

        Dim TerrID1 As Integer = BeginTerritoryID
        Dim TerrID2 As Integer = -1
        Dim TerrID3 As Integer = -1
        Try
            For Each comp In CompCollection
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    'Return comp
                    If comp.TerritoryID <> BeginTerritoryID Then
                        TerrID2 = comp.TerritoryID
                        Exit For
                    End If
                End If
            Next

            If TerrID2 <> EndTerritoryID Then
                For Each comp In CompCollection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        'Return comp
                        If comp.TerritoryID <> BeginTerritoryID And comp.TerritoryID <> TerrID2 Then
                            TerrID3 = comp.TerritoryID
                            Exit For
                        End If
                    End If
                Next
            End If

            If TerrID2 = EndTerritoryID Then
                TerritoryIDAssignment2 = BeginTerritoryID
                TerritoryIDAssignment3 = TerrID2
            Else
                TerritoryIDAssignment2 = TerrID2
                TerritoryIDAssignment3 = TerrID3

            End If


        Catch ex As Exception

        Finally
            comp = Nothing
        End Try

    End Sub

