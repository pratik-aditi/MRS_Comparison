            Dim DoAuthoritySecureEvent As New DoPublishSFAEvent(AddressOf Me.mySFAuthority.PublishSFAEventUpdate)
            DoAuthoritySecureEvent.BeginInvoke(SFAuthority.EventTypeSFA.SECURE, Nothing, Nothing)

            Me.btnOK.Visible = False
            'CloseForm()
            Dim item As ListViewItem
            For Each item In Me.lvVerbiage.Items
                If item.Text = "---------------------------------------------------------" Then
                    item.Tag = "READED-OKED"
