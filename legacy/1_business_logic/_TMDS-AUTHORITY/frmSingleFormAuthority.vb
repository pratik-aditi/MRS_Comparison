        End Try
    End Function

    Public Function CheckVehicleFormatting(ByVal pEngineId As String) As Boolean
        Try
            If pEngineId <> String.Empty Then
                pEngineId = pEngineId.Replace(" ", "")
                Dim c As String
                Dim NumericFound As Boolean = False
                Dim AlphaFirstFound As Boolean = False
                Dim AlphaPart As String = String.Empty
                Dim NumericPart As String = String.Empty
                Dim i As Integer = 0

                For Each c In pEngineId
                    i = i + 1
                    If i = 1 Then
                        If IsAlpha(c) Then
                            AlphaFirstFound = True
                        End If
                    End If

                    If IsNumeric(c) Then
                        NumericFound = True
                        NumericPart = NumericPart & c
                    Else
                        AlphaPart = AlphaPart & c
                    End If
                Next
                'If AlphaFirstFound And NumericFound Then
                '    Return True
                'Else
                '    Return False
                'End If
                If Not NumericFound Then
                    If pEngineId <> "NONE" Then
                        Return False
                    End If
                End If
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return True
    End Function

    Private Function FindForeman(ByVal ForemanName As String) As Foreman
        Try
            Dim data() As String = ForemanName.Split(",")
            If data.Length = 2 Then
                Dim LastName As String = Trim(data(0))
                Dim FirstName As String = Trim(data(1))
                Dim fmn As Foreman
                For Each fmn In TMDS.GlobalDeclarations.gMowForemen
                    If fmn.LastName.Trim.ToUpper = LastName.Trim.ToUpper And fmn.FirstName.Trim.ToUpper = FirstName.Trim.ToUpper Then
                        Return fmn
                    End If
                Next
            Else
                Return Nothing
            End If
            Return Nothing
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

