            If Me.chkItem2.Checked Then
                Dim Box2Line1 As String = "[X BOX  2] PROCEED FROM " & Me.txtItem2From1.Text.ToUpper
                Me.lvVerbiage.Items.Add(Box2Line1)
                Me.lvVerbiage.Items.Add("                   TO " & Me.txtItem2To1.Text.ToUpper)
