    Private Sub MowForemanUpdate(ByVal IssueToPerson As String)
        Try
            Try
                If Me.lvVehicles.InvokeRequired Then
                    Dim d As New SetListviewCallback(AddressOf MowForemanUpdate)
                    Me.Invoke(d, New Object() {IssueToPerson})
                    Exit Sub
                End If
            Catch ex As Exception
            End Try



            Dim fmn As Foreman
            Dim lvItem As ListViewItem
            Dim vehicles As String = String.Empty
            For Each fmn In TMDS.GlobalDeclarations.gMowForemen
                If fmn.LastName.ToUpper & ", " & fmn.FirstName.ToUpper = IssueToPerson Then
                    If Me.lvVehicles.Items.Count > 0 Then
                        For Each lvItem In Me.lvVehicles.Items
                            vehicles = vehicles & lvItem.Text & "|"
                        Next
                    End If
                    If fmn.VehicleID <> vehicles Then
                        fmn.VehicleID = vehicles
                        fmn.UpdateDatabase(False)
                    End If
                    Exit Sub
                End If
            Next

            Dim IssueToString() As String = Me.IssueTo.Split(",")
            If IssueToString.Length = 2 Then
                fmn = New Foreman()
                fmn.LastName = IssueToString(0)
                fmn.FirstName = Trim(IssueToString(1))
                fmn.TerritoryID = Me.CurrentSelectedTerritory.TerritoryID
                fmn.PIN = "99999"
                If Me.lvVehicles.Items.Count > 0 Then
                    For Each lvItem In Me.lvVehicles.Items
                        vehicles = vehicles & lvItem.Text & "|"
                    Next
                End If
                fmn.VehicleID = vehicles
                fmn.UpdateDatabase(True)
                Threading.Thread.Sleep(3000)
                LoadIssueToList()
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

