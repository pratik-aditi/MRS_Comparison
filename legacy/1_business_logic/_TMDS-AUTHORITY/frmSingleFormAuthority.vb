                        For Each trn In TrainCollection
                            If trn.IdentifingUnit = Mid(Me.cbIssueTo.Text, 1, trn.IdentifingUnit.Length) Then
                                trnFound = True
                            End If
                        Next
                        If Not trnFound Then
                            If Me.CheckForBoxOneWarrantInSelectedABSLimits() Then
                                If Not CheckForBeginAuthorityOnPOS() Then
                                    ClearSystemVariables()
                                    CloseForm()
                                    Exit Sub
                                End If

                                If Not CheckForEndAuthorityOnPOS() Then
                                    ClearSystemVariables()
                                    CloseForm()
                                    Exit Sub
                                End If
                            End If
                        Else
                            If Not ForceBoxOne Then 'And optCheckForBoxOneWarrantInSelectedABSLimits Then
                                If CheckForBoxOneWarrantInSelectedABSLimits() Then
                                    If Not CheckForBeginAuthorityOnPOS() Then
                                        ClearSystemVariables()
                                        CloseForm()
                                        Exit Sub
                                    End If
                                    If Not CheckForEndAuthorityOnPOS() Then
                                        ClearSystemVariables()
                                        CloseForm()
                                        Exit Sub
                                    End If
                                End If
                                CheckForBoxFourSixEightMOWInABS()
                            End If
                        End If
                    End If

                    If Me.OpposingAuthoritiesWithBoxFiveToResolve Then
                        If Not CheckForBoxFiveOpposingAuthoritiesInABS() Then
                            Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                            Dim frmMessageBox As frmMessageBox
                            Dim MessageList As New ArrayList()
                            frmMessageBox = New frmMessageBox()
                            frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                            MessageList.Add("THE ISSUANCE TO " & Me.cbIssueTo.Text)
                            MessageList.Add("HAS A BOX FIVE CONFLICT WITH AN EXISTING AUTHORITY.")
                            MessageList.Add("")
                            frmMessageBox.SetMessage(MessageList, "BOX FIVE CHECK", False, LaunchPoint)
                            frmMessageBox.ShowDialog()
                            MessageList.Clear()
                            MessageList = Nothing
                            frmMessageBox.Dispose()
                            frmMessageBox = Nothing

                            Me.cbIssueTo.Text = "ENTER ENGINE ID"
                            Me.cbIssueTo.Focus()
                            SendKeys.Send("{Home}+{End}")
                            Me.btnRead.Enabled = False
                            Me.btnTransmit.Enabled = False
                            Exit Sub
                        End If
                    End If
                    If Me.FirstTypeOfWarrant = "ItemTwoToTrain" Or Me.FirstTypeOfWarrant = "ItemFourToTrain" Then
                        If Not Me.CheckForGappedAuthority Then
                            Me.RestorePendingBoxThirteenSwitches() 'P1-3807
                            ClearSystemVariables()
                            Me.CloseForm()
                            Exit Sub
                        End If
                    End If
                    If gBox8Required Then
                        ResetBoxEightLimits()
                    End If

                    If gItemFiveRequired Then
                        CheckToRemoveItemFiveTrainsFromList()
                    End If
                    If Not CheckToEnsureStartInBoxFourLimitsIfLimitsExist() Then
                        Me.RestorePendingBoxThirteenSwitches()
                        Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                        Dim frmMessageBox As frmMessageBox
                        Dim MessageList As New ArrayList()
                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm
                        MessageList.Add("CURRENT TRACK SELECTION DOES NOT START IN BOX 4 LIMITS.")
                        MessageList.Add("")
                        frmMessageBox.SetMessage(MessageList, "BEGIN IN BOX 4 CHECK", False, LaunchPoint)
                        frmMessageBox.ShowDialog()
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing
                        ClearSystemVariables()
                        Me.CloseForm()
                        Exit Sub
                    End If
                Else
                    If Not CheckMOWIDFormatting() Then
                        Me.cbIssueTo.Text = "LASTNAME, FIRSTNAME"
                        Me.cbIssueTo.Focus()
                        SendKeys.Send("{Home}+{End}")
                        Me.btnRead.Enabled = False
                        Me.btnTransmit.Enabled = False
                        Exit Sub
                    End If
                    Me.cbIssueTo.Enabled = False

                    If Not ForceBoxOne Then 'And optCheckForBoxOneWarrantInSelectedABSLimits Then
                        If CheckForBoxOneWarrantInSelectedABSLimits() Then
                            If Not CheckForBeginAuthorityOnPOS() Then
                                ClearSystemVariables()
                                CloseForm()
                                Exit Sub
                            End If

                            If Not CheckForEndAuthorityOnPOS() Then
                                ClearSystemVariables()
                                CloseForm()
                                Exit Sub
                            End If
                        End If
                        CheckForBoxFourSixEightMOWInABS()
                    Else
                        Me.LoadPotentialVoidAuthorities()
                    End If

                End If
                If PerformLoadPotentialVoidAuthorities Then
                    Me.LoadPotentialVoidAuthorities()
                End If

                Me.IssueTo = Me.cbIssueTo.Text

                If Not Me.CheckToEnableReadButton() Then
                    Exit Sub
                End If


                Me.ReInitVerbiage()
                If Not Me.IssuedToTrain Then
                    DoVehicleLookUp()
                    If optEnableCommaDelimitingFormatingOnMOW Then
                        CheckToFormatMOWID()
                    End If
                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
            ClearSystemVariables()
            Me.CloseForm()
        End Try
    End Sub

    Private Sub cbIssueTo_KeyDown(ByVal sender As Object, ByVal e As System.Windows.Forms.KeyEventArgs) Handles cbIssueTo.KeyDown
        Dim cbo As ComboBox = CType(sender, ComboBox)
        Try
            If Not Me.IssuedToTrain Or Not FormInitialized Then Exit Sub
            If e.KeyCode = Keys.Enter Or cbIssueTo.Text = "ENTER ISSUE TO" Then
                cbo.DroppedDown = False
            ElseIf e.KeyCode = Keys.End Or e.KeyCode = Keys.Home Then
                cbo.DroppedDown = False
                Exit Sub
            ElseIf e.KeyCode = Keys.Escape Then
                Me.cbIssueTo.Text = ""
                cbo.DroppedDown = False
                Exit Sub
            Else
                If cbo.DroppedDown = False Then
                    cbo.DroppedDown = True
                End If
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub cbIssueTo_TextChanged(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles cbIssueTo.TextChanged
        Try
            If Me.IssuedToTrain Then Exit Sub
            If Me.LockIssueToList Then
                Me.LoadPotentialVoidAuthorities()
                Exit Sub
            End If

            If Me.cbIssueTo.Text.TrimEnd.TrimStart = "" Then
                Me.cbIssueTo.Text = "ENTER ISSUE TO"
                Me.cbIssueTo.Focus()
                SendKeys.Send("{Home}+{End}")
                Me.btnRead.Enabled = False
                Me.btnTransmit.Enabled = False
                Exit Sub
            ElseIf Me.cbIssueTo.Text = "ENTER ISSUE TO" Then
                Exit Sub
            End If

            If Me.IssueTo = Me.cbIssueTo.Text Then
                Exit Sub
            End If


            Dim IssueToPos As Integer = InStr(Me.cbIssueTo.Text, " (MOBILE") - 1
            If IssueToPos > 0 Then
                Me.IssueTo = Mid(Me.cbIssueTo.Text.ToUpper, 1, IssueToPos)
            Else
                Me.IssueTo = Me.cbIssueTo.Text.ToUpper
            End If

            Me.cbIssueTo.Text = TMDS.SystemUtilities.Formatting.FormatProperAuthorityStringForDatabase(IssueTo)
            Me.IssueTo = Me.cbIssueTo.Text
            Me.cbIssueTo.Focus()
            If Me.cbIssueTo.Enabled Then
                SendKeys.Send("{End}")
            End If
            If Not Me.CheckToEnableReadButton() Then
                'SendKeys.Send("{End}")
                Exit Sub
            End If

            Me.ReInitVerbiage()
            'SendKeys.Send("{End}")
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub cbIssueTo_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles cbIssueTo.SelectedIndexChanged
        Try
            If Me.LockIssueToList Then
                Me.cbIssueTo.Enabled = False
                If Me.IssueTo <> Me.cbIssueTo.Text Then
                    CheckForBoxOneWarrantInSelectedABSLimitsPerformed = False
                End If

                Me.IssueTo = Me.cbIssueTo.Text
                If Not CheckForBoxOneWarrantInSelectedABSLimitsPerformed Then
                    CheckForBoxOneWarrantInSelectedABSLimits()
                End If
                Exit Sub
            End If

            If Me.ManualEntry Then
                Me.ManualEntry = False
                Exit Sub
            End If

            If Me.IssuedToTrain Then
                If Not CheckEngineIDFormatting() Then
                    Me.cbIssueTo.Text = "ENTER ENGINE ID"
                    Me.cbIssueTo.Focus()
                    SendKeys.Send("{Home}+{End}")
                    Me.btnRead.Enabled = False
                    Me.btnTransmit.Enabled = False
                    Exit Sub
                Else
                    Me.LockIssueToList = True
                    If Me.FirstTypeOfWarrant = "ItemTwoToTrain" Or Me.FirstTypeOfWarrant = "ItemFourToTrain" Then
                        If Not Me.CheckForGappedAuthority Then
                            Me.RestorePendingBoxThirteenSwitches() 'P1-3807
                            ClearSystemVariables()
                            Me.CloseForm()
                            Exit Sub
                        End If
                    End If
                    If gBox8Required Then
                        ResetBoxEightLimits()
                    End If

                End If
                If gItemFiveRequired Then
                    CheckToRemoveItemFiveTrainsFromList()
                    Me.CheckForForwardAuthorities()
                End If

                Me.cbIssueTo.Enabled = False
                Me.LockIssueToList = True
                If Not CheckToEnsureStartInBoxFourLimitsIfLimitsExist() Then
                    Me.RestorePendingBoxThirteenSwitches()
                    Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                    Dim frmMessageBox As frmMessageBox
                    Dim MessageList As New ArrayList()
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm
                    MessageList.Add("CURRENT TRACK SELECTION DOES NOT START IN BOX 4 LIMITS.")
                    MessageList.Add("")
                    frmMessageBox.SetMessage(MessageList, "BEGIN IN BOX 4 CHECK", False, LaunchPoint)
                    frmMessageBox.ShowDialog()
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    ClearSystemVariables()
                    Me.CloseForm()
                    Exit Sub
                End If
            Else
                If Not CheckMOWIDFormatting() Then
                    Me.cbIssueTo.Text = "LASTNAME, FIRSTNAME"
                    Me.cbIssueTo.Focus()
                    SendKeys.Send("{Home}+{End}")
                    Me.btnRead.Enabled = False
                    Me.btnTransmit.Enabled = False
                    Exit Sub
                End If
            End If
            SystemEvent("CHANGE EVENT RECORDED FOR AUTHORITY NUMBER:" & AuthorityNumberString & ". ISSUE TO BOX SELECTION CHANGE TO THIS TEXT:" & Me.cbIssueTo.Text)
            Me.IssueTo = Me.cbIssueTo.Text

            If Not ForceBoxOne Then 'And optCheckForBoxOneWarrantInSelectedABSLimits Then
                If CheckForBoxOneWarrantInSelectedABSLimits() Then
                    If Not CheckForBeginAuthorityOnPOS() Then
                        ClearSystemVariables()
                        CloseForm()
                        Exit Sub
                    End If


                    If Not CheckForEndAuthorityOnPOS() Then
                        ClearSystemVariables()
                        CloseForm()
                        Exit Sub
                    End If
                End If
                If gBox8Required Then
                    ResetBoxEightInitialCheck()
                End If

                CheckForBoxFourSixEightMOWInABS()
            Else
                Me.LoadPotentialVoidAuthorities()
            End If


            Me.CheckToEnableReadButton()

            If Not Me.IssuedToTrain Then
                DoVehicleLookUp()
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function CheckForBoxFiveOpposingAuthoritiesInABS() As Boolean
        Try
            Dim comp As Object
            For Each comp In CompleteCompSelection
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.TrackAuthorities.Count > 0 Then
                        Dim auth As SFAuthority
                        For Each auth In trk.TrackAuthorities
                            If auth.Direction <> gSearchDirection Then
                                If auth.CheckBoxItemsStatus(4) Then
                                    'If Not auth.Components.Contains(gBeginTrackSelect) Then
                                    If Not auth.Box5Arrival.Contains(Me.cbIssueTo.Text) Then
                                        Return False
                                    End If
                                    'End If
                                Else
                                    Return False
                                End If
                            End If
                        Next
                    End If
                End If
            Next
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Sub CheckToFormatMOWID()
        Try
            If InStr(Me.cbIssueTo.Text, ",") <> 0 Then
                Dim data() As String = Me.cbIssueTo.Text.Split(",")
                If data.Length >= 2 Then
                    Me.cbIssueTo.Text = Trim(data(0)) & ", " & Trim(data(1))
                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

