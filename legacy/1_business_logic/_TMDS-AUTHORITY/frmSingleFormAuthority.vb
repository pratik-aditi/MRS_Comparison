    Private Function ValidateBox4TrackZone(ByVal CompList As ArrayList) As ArrayList
        Dim Comp As Object = Nothing
        Try
            Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(Mid(Me.IssueTo, 1, 10))
            Dim AddCompToList As Boolean = True
            Dim ShowAlertForInvalidSelection As Boolean = False
            Dim CurrentZone As TrackZone = Nothing
            Dim SelectedZoneIdentified As Boolean = False
            Dim ValidatedCompList As New ArrayList
            Dim ErrorMessage As String = String.Empty
            Dim TestBox4Comps As New ArrayList
            Dim StopProcess As Boolean = False

            ZoneListIncollection = GetTrackZoneWithinCollection(CompList)

            For Each zn As TrackZone In OccupiedZoneList
                If SelectedZonesOutOfSequence(ZoneListIncollection, SelectedZoneList, zn.ZoneName) Then
                    'Alert Suppressed based on RMT BNSF-352. BNSF Wants to allow Non-Seq Occupied Zones. 
                    'Return Nothing

                    'Re-Enabling Based on BNSF Request - 050114
                    ShowAlertForInvalidSelection = True
                    StopProcess = True
                    Exit For
                End If
            Next

            If Not StopProcess Then ' This check was added based on BNSF-371
                If Not ValidatFoulingZoneLimits(CompList, SelectedFoulingZoneList, SelectedZoneList) Then
                    StopProcess = True
                    ShowAlertForInvalidSelection = True
                End If
            End If

            If ShowAlertForInvalidSelection Then
                ErrorMessage = "INVALID TRACK ZONE SEQUENCE DETECTED DURING ISSUANCE PROCESS! PLEASE RE-ISSUE THE AUTHORITY."
                MessageBox.Show(Me, ErrorMessage, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                If StopProcess Then
                    Return New ArrayList
                Else
                    Return Nothing
                End If

            End If

            Dim CompListReversed As Boolean = False
            ValidatedCompList = GetBox4Components(CompList)

            If IsNothing(ValidatedCompList) Then
                ErrorMessage = "INVALID TRACK ZONE SEQUENCE DETECTED DURING ISSUANCE PROCESS! PLEASE RE-ISSUE THE AUTHORITY."
                MessageBox.Show(Me, ErrorMessage, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return Nothing
            End If

            If ValidatedCompList.Count <> CompList.Count Then
                Me.PromptOnLimitsChangeFromTrackZone = True
            End If

            '************************** BEGIN CHECK FOR FOULING TRACK OCCUPANY OVER VALIDATED COMPONENTS
            Dim FoulingValidatedZone As New ArrayList
            For Each fcomp As Object In ValidatedCompList
                If fcomp.GetType.ToString = gTrackComponentName Then
                    Dim trk As Track = CType(fcomp, Track)
                    If trk.TrackZoneIntegrityMonitoringEnabled Then
                        If trk.Occuppied AndAlso trk.FoulingTrackSPMS Then
                            Dim FoulTrackParentZone As TrackZone = Nothing
                            FoulTrackParentZone = GetFoulingTrkParentZone(trk)
                            If Not SelectedFoulingZoneList.Contains(trk.TrackZoneReference) Then
                                If Not FoulingBox14Comp.Contains(fcomp) Then
                                    FoulingBox14Comp.Add(fcomp)
                                End If
                            End If
                            If Not FoulingValidatedZone.Contains(trk.TrackZoneReference) Then
                                FoulingValidatedZone.Add(trk.TrackZoneReference)
                            End If
                        End If
                    End If
                End If
            Next
            If FoulingValidatedZone.Count > 0 Then
                For Each fvzn As TrackZone In FoulingValidatedZone
                    TrackZoneIdentifiedList.Add(fvzn)
                Next
            End If
            '************************** END CHECK FOR FOULING TRACK OCCUPANY OVER VALIDATED COMPONENTS
            Return ValidatedCompList
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return Nothing
    End Function

    Private Function GetBox4Components(ByVal CompList As ArrayList) As ArrayList
        Try
            Dim comp As Object = Nothing
            Dim AllZonesInMyCollection As New ArrayList
            Dim ReturnList As New ArrayList
            Dim ContinousTzList As New ArrayList

            For Each comp In CompList
                If comp.GetType.ToString = gTrackComponentName Then
                    If comp.TrackZoneIntegrityMonitoringEnabled Then
                        TIWSAuth = True
                        If Not AllZonesInMyCollection.Contains(comp.TrackZoneReference) Then AllZonesInMyCollection.Add(comp.TrackZoneReference)
                    End If
                End If
            Next

            If SelectedZoneList.Count = 0 AndAlso SelectedFoulingZoneList.Count = 0 And OccupiedZoneList.Count > 0 Then
                For Each comp In CompList
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim trk As Track = DirectCast(comp, Track)
                        If trk.TrackZoneIntegrityMonitoringEnabled AndAlso trk.Occuppied Then
                            If SelectedZoneList.Contains(trk.TrackZoneReference) Then
                            ElseIf SelectedFoulingZoneList.Contains(trk.TrackZoneReference) Then
                            Else
                                If Not trk.FoulingTrackSPMS Then
                                    If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                                End If
                            End If
                        End If
                    End If
                    If Not ReturnList.Contains(comp) Then ReturnList.Add(comp)
                    EnforceBox8FromTIWS = True
                    gBox8Required = True
                    JointAuthRequired = True
                    gJointAuthRequired = True
                Next
            End If

            If SelectedZoneList.Count > 0 OrElse SelectedFoulingZoneList.Count > 0 Then
                Dim rcomp As Object = Nothing
                Dim lcomp As Object = Nothing
                Dim IgnoreFoulingCheck As Boolean = False
                Dim ValidOccupiedZones As New ArrayList
                If SelectedZoneList.Count > 0 Then
                    ContinousTzList = GetAllContinuouslyOccupiedTrackZones(SelectedZoneList(0))
                    Dim trk As Track
                    For Each trk In SelectedZoneList(0).tracklist
                        If CompList.Contains(trk) Then
                            rcomp = trk
                            lcomp = trk
                            Exit For
                        End If
                    Next
                ElseIf SelectedFoulingZoneList.Count > 0 Then
                    '******************************
                    'BNSF-341 Changes
                    'Dim Swlist As New ArrayList
                    'Swlist = GetFoulingZoneConnectedSwitches(SelectedFoulingZoneList(0))
                    'Dim SW As Switch = Nothing
                    'If Swlist IsNot Nothing AndAlso Swlist.Count > 1 Then
                    '    SW = Swlist(0)
                    '    Dim tmpComp As Object = Nothing
                    '    If SW IsNot Nothing AndAlso SW.OsComponentCollection IsNot Nothing AndAlso SW.OsComponentCollection.Count > 0 Then
                    '        For Each tmpComp In SW.OsComponentCollection
                    '            If Not ReturnList.Contains(tmpComp) Then ReturnList.Add(tmpComp)
                    '        Next
                    '    End If

                    'End If
                    Dim FoulTrack As Track = Nothing
                    IgnoreFoulingCheck = False
                    FoulTrack = SelectedFoulingZoneList(0).TrackList(0)
                    Dim Prtzn As TrackZone = GetFoulingTrkParentZone(SelectedFoulingZoneList(0).TrackList(0))
                    If Prtzn.IsZownOccuppied Then
                        If Not ValidOccupiedZones.Contains(Prtzn) Then ValidOccupiedZones.Add(Prtzn)
                    End If
                    Dim Swlist As New ArrayList
                    Swlist = GetFoulingZoneConnectedSwitches(SelectedFoulingZoneList(0))
                    '**************************************************
                    If Swlist IsNot Nothing AndAlso Swlist.Count = 1 Then
                        Dim fTzCSw As Switch = GetFoulingZoneConnectedSwitch(SelectedFoulingZoneList(0))
                        If fTzCSw IsNot Nothing AndAlso Not ReturnList.Contains(fTzCSw) Then ReturnList.Add(fTzCSw)
                        If Not ReturnList.Contains(SelectedFoulingZoneList(0).tracklist(0)) Then ReturnList.Add(SelectedFoulingZoneList(0).tracklist(0))
                        rcomp = GetFoulingZoneRightTrack(SelectedFoulingZoneList(0))
                        lcomp = GetFoulingZoneLeftTrack(SelectedFoulingZoneList(0))
                    Else
                        Dim SW As Switch = Nothing
                        SW = Swlist(0)
                        Dim tmpComp As Object = Nothing
                        If SW IsNot Nothing AndAlso SW.OsComponentCollection IsNot Nothing AndAlso SW.OsComponentCollection.Count > 0 Then
                            GetRightLeftTrackFromCollection(rcomp, lcomp, SW.OsComponentCollection)
                            For Each tmpComp In SW.OsComponentCollection
                                If Not ReturnList.Contains(tmpComp) Then ReturnList.Add(tmpComp)
                            Next
                        End If

                    End If

                    ''Legacy Check
                    'Dim fTzCSw As Switch = GetFoulingZoneConnectedSwitch(SelectedFoulingZoneList(0))
                    'Dim Prtzn As TrackZone = GetFoulingTrkParentZone(SelectedFoulingZoneList(0).TrackList(0))
                    'If Prtzn.IsZownOccuppied Then
                    '    If Not ValidOccupiedZones.Contains(Prtzn) Then ValidOccupiedZones.Add(Prtzn)
                    'End If
                    'If fTzCSw IsNot Nothing AndAlso Not ReturnList.Contains(fTzCSw) Then ReturnList.Add(fTzCSw)
                    'If Not ReturnList.Contains(SelectedFoulingZoneList(0).tracklist(0)) Then ReturnList.Add(SelectedFoulingZoneList(0).tracklist(0))
                    'rcomp = GetFoulingZoneRightTrack(SelectedFoulingZoneList(0))
                    'lcomp = GetFoulingZoneLeftTrack(SelectedFoulingZoneList(0))

                End If
                GetDirectionalComplist(CompList, lcomp, "L", ContinousTzList, ValidOccupiedZones, ReturnList)
                GetDirectionalComplist(CompList, rcomp, "R", ContinousTzList, ValidOccupiedZones, ReturnList)
            End If

            'This is to include non-tiws componenets for authority that spans between tiws and non tiws CPs. 
            Dim RearrList As New ArrayList
            Dim RearrBox14 As New ArrayList
            For Each comp In CompList
                If comp.GetType.ToString = gTrackComponentName Then
                    If Not comp.TrackZoneIntegrityMonitoringEnabled Then
                        If Not RearrList.Contains(comp) AndAlso Not ReturnList.Contains(comp) Then
                            RearrList.Add(comp)
                        End If
                    Else
                        If Not RearrList.Contains(comp) AndAlso ReturnList.Contains(comp) Then
                            RearrList.Add(comp)
                        End If
                    End If
                    If box14Comp.Contains(comp) Then RearrBox14.Add(comp)
                Else
                    If Not RearrList.Contains(comp) AndAlso ReturnList.Contains(comp) Then
                        RearrList.Add(comp)
                    End If
                End If
            Next
            box14Comp = New ArrayList
            box14Comp = RearrBox14.Clone
            ReturnList = RearrList.Clone

            'Based on BNSF-341 We are going to add all Fpoulig track to Box14 so this check is not valid. Still It's not clear from BNSF what happens on Non Continous FT is occupied
            'ReturnList = CompList.Clone
            Return ReturnList
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
        Return Nothing
    End Function

    Public Sub GetDirectionalComplist(ByVal CompList As ArrayList, ByVal comp As Object, SearchDir As String, ByVal ContinousTzList As ArrayList, _
                           ByRef ValidOccupiedZones As ArrayList, ByRef ReturnList As ArrayList)
        Try
            Dim LastCompAdded As Track = Nothing
            If Not IsNothing(comp) Then
                Do While (CompList.Contains(comp) AndAlso comp.TrackZoneIntegrityMonitoringEnabled)
                    If comp.GetType.ToString = gTrackComponentName Then
                        '------------------ Zone Track Check --------------------
                        Dim trk As Track = DirectCast(comp, Track)
                        If Not trk.Occuppied Then
                            If Not ReturnList.Contains(trk) Then ReturnList.Add(trk)
                        Else
                            If SelectedZoneList.Contains(trk.TrackZoneReference) Then
                                If Not ReturnList.Contains(trk) Then ReturnList.Add(trk)
                            ElseIf ContinousTzList.Contains(trk.TrackZoneReference) Then
                                If Not ReturnList.Contains(trk) Then ReturnList.Add(comp)
                                If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                            ElseIf ValidOccupiedZones.Contains(trk.TrackZoneReference) Then
                                If Not ReturnList.Contains(trk) Then ReturnList.Add(comp)
                                If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                            ElseIf Not IsNothing(LastCompAdded) Then
                                If Not (LastCompAdded.TrackZoneReference Is trk.TrackZoneReference) Then
                                    If Not LastCompAdded.Occuppied Then
                                        Exit Do
                                    Else
                                        If ValidOccupiedZones.Contains(LastCompAdded.TrackZoneReference) Then
                                            If Not ReturnList.Contains(trk) Then ReturnList.Add(trk)
                                            If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                                        End If
                                    End If
                                End If
                            Else
                                Exit Do
                            End If
                            If ReturnList.Contains(trk) Then
                                If Not ValidOccupiedZones.Contains(trk.TrackZoneReference) Then ValidOccupiedZones.Add(trk.TrackZoneReference)
                            End If
                        End If
                        If ReturnList.Contains(trk) Then LastCompAdded = trk
                        '------------------ Zone Track Check --------------------
                        If SearchDir = "L" Then
                            comp = FindCompFromGUID(comp.leftlink)
                        Else
                            comp = FindCompFromGUID(comp.RightLink)
                        End If
                        If IsNothing(comp) Then Exit Do
                    End If

                    If comp.GetType.ToString = gSwitchComponentName Then
                        Dim sw As Switch = DirectCast(comp, Switch)
                        '------------------- Fouling track Check ----------------
                        Dim swFtz As TrackZone = GetSwitchFoulingZone(sw)
                        Dim Prtzn As TrackZone = Nothing
                        If Not IsNothing(swFtz) Then
                            If swFtz.IsZownOccuppied Then
                                If SelectedFoulingZoneList.Contains(swFtz) Then
                                    Prtzn = GetFoulingTrkParentZone(swFtz.TrackList(0))
                                    If Prtzn.IsZownOccuppied Then
                                        If Not ValidOccupiedZones.Contains(Prtzn) Then ValidOccupiedZones.Add(Prtzn)
                                    End If
                                ElseIf Not IsNothing(LastCompAdded) Then
                                    If LastCompAdded.Occuppied Then
                                    Else
                                        If ReturnList.Contains(LastCompAdded) Then ReturnList.Remove(LastCompAdded)
                                        Exit Do
                                    End If
                                Else
                                    Exit Do
                                End If
                                If Not ReturnList.Contains(swFtz.TrackList(0)) Then ReturnList.Add(swFtz.TrackList(0))
                                If Not ValidOccupiedZones.Contains(swFtz) Then ValidOccupiedZones.Add(swFtz)
                            Else
                                If Not ReturnList.Contains(swFtz.TrackList(0)) Then ReturnList.Add(swFtz.TrackList(0))
                                If Not ValidOccupiedZones.Contains(swFtz) Then ValidOccupiedZones.Add(swFtz)
                            End If
                        End If
                        If SelectedZoneList.Count = 0 And SelectedFoulingZoneList.Count = 1 Then
                            If sw.SwitchPointerMonitorMode AndAlso (sw.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or sw.FailState) Then
                                If SearchDir = "L" Then
                                    If Not UnknownSwitchOnLeft Then UnknownSwitchOnLeft = True
                                Else
                                    If Not UnknownSwitchOnRight Then UnknownSwitchOnRight = True
                                End If
                            End If
                        End If
                        '------------------- Fouling track Check ----------------
                        If Not ReturnList.Contains(sw) Then ReturnList.Add(sw)
                        If SearchDir = "L" Then
                            comp = FindCompFromGUID(sw.LeftLink)
                        Else
                            comp = FindCompFromGUID(sw.RightLink)
                        End If
                        If IsNothing(comp) Then Exit Do
                    End If
                Loop
            End If
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Sub

