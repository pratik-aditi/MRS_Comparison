                                    frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                                    MessageList.Add("THE ISSUANCE TO " & Me.cbIssueTo.Text)
                                    MessageList.Add("HAS A BOX FIVE CONFLICT WITH AN EXISTING AUTHORITY.")
                                    MessageList.Add("")
                                    frmMessageBox.SetMessage(MessageList, "BOX FIVE CHECK", False, LaunchPoint)
                                    frmMessageBox.ShowDialog()
                                    MessageList.Clear()
                                    MessageList = Nothing
                                    frmMessageBox.Dispose()
                                    frmMessageBox = Nothing

                                    Me.cbIssueTo.Text = "ENTER ENGINE ID"
                                    Me.cbIssueTo.Focus()
                                    SendKeys.Send("{Home}+{End}")
                                    Me.btnRead.Enabled = False
                                    Me.btnTransmit.Enabled = False
                                    Exit Function
                                End If
                            End If
                            If gLaunchCreateItemTwoToTrain Then
                                If Me.LockIssueToList Then
                                    CheckForBoxOneWarrantInSelectedABSLimits()
                                End If
                                If gBox8Required Then
                                    ResetBoxEightLimits()
                                End If
                            End If

                        Else
                            If gLaunchCreateItemTwoToTrain Then
                                If Not IsNothing(gTrainMenuMiscSelectedTrainID) Then
                                    Me.cbIssueTo.Text = gTrainMenuMiscSelectedTrainID.IdentifingUnit
                                    If Not CheckEngineIDFormatting() Then
                                        Return False
                                    End If
                                    Me.cbIssueTo.Enabled = False
                                    Me.IssueTo = Me.cbIssueTo.Text
                                End If
                                If gBox8Required Then
                                    ResetBoxEightLimits()
                                End If

                                If Not ForceBoxOne Then 'And optCheckForBoxOneWarrantInSelectedABSLimits Then
                                    If CheckForBoxOneWarrantInSelectedABSLimits() Then
                                        If Not CheckForBeginAuthorityOnPOS() Then
                                            ClearSystemVariables()
                                            CloseForm()
                                            Exit Function
                                        End If

                                        If Not CheckForEndAuthorityOnPOS() Then
                                            ClearSystemVariables()
                                            CloseForm()
                                            Exit Function
                                        End If
                                        If ForceBoxOne Then
                                            If Not CheckDirectionChange(LaunchPoint) Then
                                                ClearSystemVariables()
                                                Exit Function
                                            End If
                                        End If
                                    Else
                                        ClearSystemVariables()
                                        Exit Function
                                    End If
                                End If

                            End If
                        End If

                    Case "ItemTwoToMOW"
                        'not allowed
                    Case "ItemFourToTrain", "ItemFourToTrainWithItem8"
                        If FirstTypeOfWarrant = "ItemFourToTrainWithItem8" Then
                            gBox8Required = True
                        End If
                        gWarrantType = "ItemFourToTrain"
                        FirstTypeOfWarrant = "ItemFourToTrain"
                        PerformLoadPotentialVoidAuthorities = True
                        If gLaunchCreateItemFourToSameTrain Then
                            If Not IsNothing(gTrainMenuMiscSelectedTrainID) Then
                                Me.cbIssueTo.Text = gTrainMenuMiscSelectedTrainID.IdentifingUnit
                                If Not CheckEngineIDFormatting() Then
                                    Return False
                                End If
                                Me.cbIssueTo.Enabled = False
                                Me.IssueTo = Me.cbIssueTo.Text
                                If Not IsNothing(VoidedWarrant) Then
                                    gBoxOneRequired = True
                                    Me.cmbItem1Void1.DropDownStyle = ComboBoxStyle.Simple
                                    Me.cmbItem1Void1.Text = VoidedWarrant.AuthorityUID
                                    Me.cmbItem1Void1.Enabled = False
                                    If Not CheckForNeedsRollUp(VoidedWarrant, LaunchPoint) Then
                                        ClearSystemVariables()
                                        Return False
                                    End If
                                    Me.chkItem1.Checked = True
                                    BoxEightCheckToRemoveRequirement()

                                End If
                            End If
                        ElseIf Not IsNothing(VoidedWarrant) Then
                            NewIssueTo = Trim(Mid(VoidedWarrant.IssueTo, 1, 10))

                            Me.cbIssueTo.Text = NewIssueTo
                            If Not CheckEngineIDFormatting() Then
                                Return False
                            End If
                            Me.cbIssueTo.Enabled = False
                            Me.IssueTo = Me.cbIssueTo.Text
                            If Not IsNothing(VoidedWarrant) Then
                                gBoxOneRequired = True
                                Me.cmbItem1Void1.DropDownStyle = ComboBoxStyle.Simple
                                Me.cmbItem1Void1.Text = VoidedWarrant.AuthorityUID
                                Me.cmbItem1Void1.Enabled = False
                                If Not CheckForRollUpConfirmed Then
                                    If Not CheckForNeedsRollUp(VoidedWarrant, LaunchPoint) Then
                                        ClearSystemVariables()
                                        Return False
                                    End If
                                End If
                                Me.chkItem1.Checked = True
                                BoxEightCheckToRemoveRequirement()
                            End If
                        End If
                    Case "ItemFourToMOW"
                        gWarrantType = "ItemFourToMOW"
                        If Not MobileClientAuthorityRequest Then
                            Me.cbIssueTo.Text = gPersonCopying
                        Else
                            'If thisMobilemessage.SFAVoidAuthList IsNot Nothing AndAlso thisMobilemessage.SFAVoidAuthList.Count > 0 Then
