            Me.btnVoid.Visible = False
            Me.RepeatMode = False
            Me.ReInitVerbiage()
            Me.mySFAuthority.UpdateOKTime()
            Me.mySFAuthority.Pending = False

            Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE", mySFAuthority)
