                            Me.CheckBoxEightChange(Me.CompleteCompSelection, Me.DirectionOfTheWarrant)
                        Else
                            'Me.gbItem8.Visible = False
                            'Me.gbItem8.Enabled = False
                        End If

                    Case 9 'OVERLAPS
                        'If ItemFourWarrant And JointAuthRequired Then
                        If JointAuthRequired Then
                            Me.gbItem9.Visible = True
                            Me.gbItem9.Enabled = True
                            Me.chkItem9.Visible = True
                            Me.chkItem9.Enabled = True
                            'Me.chkItem9.Tag = "VALIDATE"
                            Me.chkItem9.Checked = True
                            Me.chkItem9.AccessibleDescription = "CHECKED"
                        Else
                            Me.gbItem9.Visible = False
                            Me.gbItem9.Enabled = False
                        End If

                    Case 10 'CLEAR BY TIME
                        'If ItemFourWarrant Then
                        Me.gbItem10.Visible = True
                        Me.gbItem10.Enabled = True
                        'Else
                        '    Me.gbItem10.Visible = False
                        '    Me.gbItem10.Enabled = False
                        'End If

                    Case 11 'SPEED RESTRICTIONS
                        Me.gbItem11.Visible = False
                        Me.gbItem11.Enabled = False

                    Case 12 'PROTECT OPEN SWITCHES
                        If Item12Forced Then
                            Me.gbItem12.Visible = True
                            Me.gbItem12.Enabled = True
                            Me.chkItem12.Visible = True
                            Me.chkItem12.Enabled = True
                            'Me.chkItem12.Tag = "VALIDATE"
                            Me.chkItem12.Checked = True
                            Me.chkItem12.AccessibleDescription = "CHECKED"
                            Dim BoxTwelveSwitch As String
                            Me.txtItem12.Text = ""
                            Dim BoxTwelveVerbiage As String = String.Empty
                            Dim Count As Integer
                            For Each BoxTwelveSwitch In BoxTwelveSwitches
                                If Count = 0 Then
                                    BoxTwelveVerbiage = BoxTwelveVerbiage & "(" & BoxTwelveSwitch & ")"
                                Else
                                    BoxTwelveVerbiage = BoxTwelveVerbiage & ", (" & BoxTwelveSwitch & ")"
                                End If
                                Count = Count + 1
                            Next
                            Me.txtItem12.ReadOnly = True
                            Me.txtItem12.Enabled = True
                            Me.txtItem12.Text = BoxTwelveVerbiage
                        Else
                            Me.gbItem12.Visible = False
                            Me.gbItem12.Enabled = False
                        End If

                    Case 13 'PERMISSION TO LEAVE SWITCHES OPEN
                        If Item13Forced Then
                            Me.gbItem13.Visible = True
                            Me.gbItem13.Enabled = True
                            Me.chkItem13.Visible = True
                            Me.chkItem13.Enabled = True
                            'Me.chkItem13.Tag = "VALIDATE"
                            'Me.chkItem13.Checked = True
                            Me.chkItem13.AccessibleDescription = "CHECKED"
                            Dim BoxThirteenSwitch As String
                            Me.txtItem13.Text = ""
                            Dim BoxThirteenVerbiage As String = String.Empty

                            Dim Count As Integer
                            For Each BoxThirteenSwitch In BoxThirteenSwitches
                                If Count = 0 Then
                                    BoxThirteenVerbiage = BoxThirteenVerbiage & "(" & BoxThirteenSwitch & ")"
                                Else
                                    BoxThirteenVerbiage = BoxThirteenVerbiage & ", (" & BoxThirteenSwitch & ")"
                                End If
                                Count = Count + 1
                            Next
                            Me.txtItem13.ReadOnly = True
                            Me.txtItem13.Enabled = True
                            Me.txtItem13.Text = BoxThirteenVerbiage
                        Else
                            Me.gbItem13.Visible = False
                            Me.gbItem13.Enabled = False
                        End If

                    Case 14 'OTHER INFORMATION
                        If Item14Forced Then
                            If BoxFourteenVerbiageRCPS <> "" Then
                                Me.txtItem14.Text = BoxFourteenVerbiageRCPS
                            ElseIf BoxFourteenVerbiageTrackZone <> "" Then
                                Me.txtItem14.Text = BoxFourteenVerbiageTrackZone
                            End If

                            Me.txtItem14.Visible = True
                            Me.txtItem14.Focus()
                            Me.btnBox14.Text = "X"
                            Me.chkItem14.Checked = True
                            Me.gbItem14.Visible = True
                            Me.gbItem14.Enabled = True
                            Me.txtItem14.ReadOnly = True
                        Else

                            Me.gbItem14.Visible = True
                            Me.gbItem14.Enabled = True
                        End If

                End Select

                Dim CurrentGroupBoxItem As GroupBox = GetGroupBoxItem(BoxIndex)
                If IsNothing(CurrentGroupBoxItem) Then
                    Return False
                Else
                    If CurrentGroupBoxItem.Enabled Then
                        CurrentGroupBoxItem.Location = CurrentPoint
                        CurrentTopLocation = CurrentTopLocation + CurrentGroupBoxItem.Height
                        CurrentPoint = New Point(CurrentLeftLocation, CurrentTopLocation)
                    End If
                End If

            Next BoxIndex

            Me.gbItemBox.Location = CurrentPoint
            Me.btnCancel.Top = Me.gbItemBox.Top + 80

            Me.btnRead.Top = Me.gbItemBox.Top + 80
            Me.btnTransmit.Top = Me.btnRead.Top

            CurrentTopLocation = CurrentTopLocation + Me.gbItemBox.Height

            gbMain.Height = CurrentTopLocation + 60
            gbFooter.Top = gbMain.Top + gbMain.Height + 1
            Me.Height = gbFooter.Top + gbFooter.Height + 30
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try

    End Function

    Private Function GetGroupBoxItem(ByVal gbIndex As Integer) As GroupBox
        Try
            Dim gb As GroupBox
            For Each gb In Me.GroupArrayList
                If gb.Tag = gbIndex.ToString Then
                    Return gb
                End If
            Next
            Return Nothing
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

