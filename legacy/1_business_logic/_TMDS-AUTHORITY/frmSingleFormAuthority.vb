                                            BoxThirteenSwitches.Add(sw.Name)
                                        End If
                                        ReInitCheckBoxesAndForm()
                                        Me.chkItem13.Checked = True
                                        If Not sw.UpdateSwitchPositionInDatabaseWithFeedBack(TMDS.GlobalDeclarations.gDatabaseConnectionStatic) Then
                                            Dim ErrMessage1 As String = "Protect Open Switch Database Write Error - Event One! Consider The Switch Not Protected!"
                                            SystemEvent(ErrMessage1)

                                            If Not sw.UpdateSwitchPositionInDatabaseWithFeedBack(TMDS.GlobalDeclarations.gDatabaseConnectionStatic) Then
                                                Dim ErrorMessage As String = "Protect Open Switch Database Write Error - Event Two! Consider The Switch Not Protected!"
                                                MessageBox.Show(Me, ErrorMessage, "PROTECT OPEN SWITCH", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                                SystemEvent(ErrorMessage)
                                                frmMessageBox.Dispose()
                                                frmMessageBox = Nothing
                                                Return False
                                            End If
                                        End If
                                        'sw.UpdateSwitchPositionInDatabase(TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
                                    End If
                                Else
                                    gBoxThirteenRequired = True
                                    'gBoxThreeRequired = True
                                    Item13Forced = True
                                    If Not BoxThirteenSwitches.Contains(sw.Name) Then
                                        BoxThirteenSwitches.Add(sw.Name)
                                    End If
                                    ReInitCheckBoxesAndForm()
                                    Me.chkItem13.Checked = True

                                    If Not sw.UpdateSwitchPositionInDatabaseWithFeedBack(TMDS.GlobalDeclarations.gDatabaseConnectionStatic) Then
                                        Dim ErrMessage1 As String = "Protect Open Switch Database Write Error - Event One! Consider The Switch Not Protected!"
                                        SystemEvent(ErrMessage1)

                                        If Not sw.UpdateSwitchPositionInDatabaseWithFeedBack(TMDS.GlobalDeclarations.gDatabaseConnectionStatic) Then
                                            Dim ErrorMessage As String = "Protect Open Switch Database Write Error - Event Two! Consider The Switch Not Protected!"
                                            MessageBox.Show(Me, ErrorMessage, "PROTECT OPEN SWITCH", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            SystemEvent(ErrorMessage)
                                            frmMessageBox.Dispose()
                                            frmMessageBox = Nothing
                                            Return False
                                        End If
                                    End If
                                    'sw.UpdateSwitchPositionInDatabase(TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
                                End If
                            End If
                            frmMessageBox.Dispose()
                            frmMessageBox = Nothing
                        Else
                            OverridePrompt = False
                        End If

                    End If
                Next
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

