#Region "REPEAT MODE"

    Private Sub lvVerbiage_Select(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles lvVerbiage.ItemActivate, lvVerbiage.ItemMouseHover, lvVerbiage.ItemSelectionChanged, lvVerbiage.Click, lvVerbiage.Enter, lvVerbiage.KeyPress, Me.KeyPress, lvVerbiage.LostFocus ',lvVerbiage.MouseClick
        Try
            Dim lvItem As ListViewItem
            Dim EventType As String = e.ToString
            If Me.RepeatMode Then
                For Each lvItem In Me.lvVerbiage.Items

                    Select Case EventType
                        Case "System.Windows.Forms.ListViewItemSelectionChangedEventArgs", "System.EventArgs"
                            If OkMode Then
                                PositionSelectionafterOK()
                            End If
                            Exit Sub
                        Case Else
                            If lvItem.Selected And lvItem.Tag = "READED" Then
                                lvItem.Selected = False
                                lvItem.BackColor = Color.LightGreen
                                Exit Sub
                            End If
                    End Select

                Next
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub lvVerbiage_MouseDown(ByVal sender As System.Object, ByVal e As System.Windows.Forms.MouseEventArgs) Handles lvVerbiage.MouseDown
        Try
            SystemEvent("lvVerbiage_MouseDown")

            Dim lvItem As ListViewItem
            If Me.RepeatMode Then
                For Each lvItem In Me.lvVerbiage.Items
                    If lvItem.Selected And Mid(lvItem.Tag, 1, 6) = "READED" Then
                        lvItem.Selected = False
                        Exit For
                    End If
                Next
                CheckForRepeatValidation()
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub lvVerbiage_MouseUp(ByVal sender As System.Object, ByVal e As System.Windows.Forms.MouseEventArgs) Handles lvVerbiage.MouseUp
        Try
            SystemEvent("lvVerbiage_MouseUp")
            Me.ReadBackKeyUp = False
            Dim item, OtherItem As ListViewItem
            If e.Button = Windows.Forms.MouseButtons.Left And Me.RepeatMode And Not OkButtonEnabled Then
                For Each item In Me.lvVerbiage.Items

                    If Mid(item.Tag, 1, 6) = "READED" And item.Selected Then
                        item.BackColor = Color.LightGray
                        Me.AuthorityEvent("LINE OF AUTHORITY VERBIAGE WAS UNCHECKED BY DISPATCHER: " & item.Text)
                        item.Tag = ""
                        item.Selected = False

                        Exit Sub
                    End If

                    If item.Selected Then
                        item.BackColor = Color.LightGreen
                        Me.AuthorityEvent("LINE OF AUTHORITY VERBIAGE CONFIRMED BY DISPATCHER: " & item.Text)
                        item.Tag = "READED"
                        item.Selected = False
                        CheckForRepeatValidation(True)
                        Exit Sub
                    End If
                Next
            ElseIf e.Button = Windows.Forms.MouseButtons.Left And Me.OkMode Then
                For Each item In Me.lvVerbiage.Items
                    If item.Selected And item.Index = Me.lvVerbiage.Items.Count - 1 Then
                        For Each OtherItem In Me.lvVerbiage.Items
                            If Mid(OtherItem.Tag, 1, 6) <> "READED" Then
                                If Not OtherItem.Index = Me.lvVerbiage.Items.Count - 1 Then
                                    Exit Sub
                                End If
                            End If
                        Next
                        If RestrictingAuthority = True And Me.ForcePTCOperations = True Then
                        Else
                            Me.btnDone.Enabled = True
                            Me.btnDone.Visible = True
                        End If
                        item.BackColor = Color.LightGreen
                        Me.AuthorityEvent("LINE OF AUTHORITY VERBIAGE CONFIRMED BY DISPATCHER: " & item.Text)
                        item.Selected = False
                        ValidationComplete()
                        Exit Sub
                    ElseIf item.Selected And Mid(item.Tag, 1, 6) <> "READED" Then
                        item.BackColor = Color.LightGreen
                        Me.AuthorityEvent("LINE OF AUTHORITY VERBIAGE CONFIRMED BY DISPATCHER: " & item.Text)
                        item.Tag = "READED"
                        item.Selected = False
                        Exit Sub
                    ElseIf item.Tag = "READED" Then
                        If item.Selected Then
                            item.BackColor = Color.LightGray
                            Me.AuthorityEvent("LINE OF AUTHORITY VERBIAGE WAS UNCHECKED BY DISPATCHER: " & item.Text)
                            item.Tag = ""
                            item.Selected = False
                            Exit Sub
                        End If
                    End If
                Next
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub lvVerbiage_KeyDown(ByVal sender As System.Object, ByVal e As System.Windows.Forms.KeyEventArgs) Handles lvVerbiage.KeyDown
        Try
            Dim item, OtherItem As ListViewItem
            If e.KeyCode <> Keys.Enter Then
                Exit Sub
            End If
            If e.KeyCode = Keys.Enter And Me.ReadBackKeyUp And Me.RepeatMode Then
                Me.ReadBackKeyUp = False
                For Each item In Me.lvVerbiage.Items
                    If item.Selected Then
                        If RepeatMode Then
                            item.BackColor = Color.LightGreen
                            Me.AuthorityEvent("LINE OF AUTHORITY VERBIAGE CONFIRMED BY DISPATCHER: " & item.Text)
                            'Else
                            '    item.BackColor = Color.LightSalmon
                        End If
                        item.Tag = "READED"
                        If item.Index <> Me.lvVerbiage.Items.Count - 1 Then
                            Me.lvVerbiage.Items(item.Index + 1).Selected = True
                            SendKeys.Send("{DOWN}")
                        End If
                        If RepeatMode Then
                            CheckForRepeatValidation(True)
                        End If
                        Exit Sub
                    End If
                Next
            ElseIf Me.OkMode Then
                For Each item In Me.lvVerbiage.Items
                    If item.Selected And item.Index = Me.lvVerbiage.Items.Count - 1 Then
                        For Each OtherItem In Me.lvVerbiage.Items
                            If Mid(OtherItem.Tag, 1, 6) <> "READED" Then
                                If Not OtherItem.Index = Me.lvVerbiage.Items.Count - 1 Then
                                    Exit Sub
                                End If
                            End If
                        Next
                        Me.btnDone.Visible = True
                        Me.btnDone.Enabled = True
                        item.BackColor = Color.LightGreen
                        Me.AuthorityEvent("LINE OF AUTHORITY VERBIAGE CONFIRMED BY DISPATCHER: " & item.Text)
                        item.Selected = False
                        ValidationComplete()
                        Exit Sub
                    ElseIf item.Selected And Mid(item.Tag, 1, 6) <> "READED" Then
                        item.BackColor = Color.LightGreen
                        Me.AuthorityEvent("LINE OF AUTHORITY VERBIAGE CONFIRMED BY DISPATCHER: " & item.Text)
                        item.Tag = "READED"
                        item.Selected = False

                        If item.Index <> Me.lvVerbiage.Items.Count - 1 Then
                            Me.lvVerbiage.Items(item.Index + 1).Selected = True
                        End If

                        Exit Sub
                    End If
                Next
                '    For Each item In Me.lvVerbiage.Items
                '        If item.Selected And item.Index = Me.lvVerbiage.Items.Count - 1 Then
                '            Me.btnDone.Enabled = True
                '            item.BackColor = Color.LightGreen
                '            Me.AuthorityEvent("LINE OF AUTHORITY VERBIAGE CONFIRMED BY DISPATCHER: " & item.Text)
                '            item.Selected = False
                '            Me.btnDone.Visible = True
                '            Me.btnDone.Focus()
                '            Exit Sub
                '        End If
                '    Next
            ElseIf e.KeyCode = Keys.Enter And Not Me.ReadBackKeyUp And Not Me.RepeatMode Then
                For Each item In Me.lvVerbiage.Items
                    If item.Selected Then
                        If item.Index <> Me.lvVerbiage.Items.Count - 1 Then
                            item.Selected = False
                            Me.lvVerbiage.Items(item.Index + 1).Selected = True
                            Exit Sub
                        Else
                            Me.btnRepeat.Focus()
                            Exit Sub
                        End If
                    End If
                Next
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub ReadBack_KeyUp(ByVal sender As System.Object, ByVal e As System.Windows.Forms.KeyEventArgs) Handles lvVerbiage.KeyUp
        Me.ReadBackKeyUp = True
    End Sub

    Sub CheckForRepeatValidation(Optional ByVal KeyPress As Boolean = False)

        Try
            Dim item As ListViewItem

            For Each item In Me.lvVerbiage.Items

                If item.Selected And item.Index >= Me.lvVerbiage.Items.Count - 1 Then
                    Dim CheckItem As ListViewItem
                    For Each CheckItem In Me.lvVerbiage.Items
                        If Mid(CheckItem.Tag, 1, 6) <> "READED" Then
                            Me.lvVerbiage.Items(item.Index).Selected = True
                            Exit Sub
                        End If
                    Next
                ElseIf Mid(item.Tag, 1, 6) <> "READED" Then
                    item.Selected = False
                    Exit Sub
                End If
            Next

            If Me.ForcePTCOperations And Not optEnablePTCBOSAPIMode Then
                If Me.RestrictingAuthority Then
                    If Not TransmissionInitialSatified Then
                        Exit Sub
                    End If
                End If
            End If


            Me.btnOK.Visible = True
            Me.btnOK.Enabled = True
            OkButtonEnabled = True
            Me.btnOK.Focus()
            SendKeys.Send("%")
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub ValidationComplete()
        Try


            If Not ResetBoxThirteenSwitches() Then
                SystemEvent("ERROR @ ResetBoxThirteenSwitches")
                gHistoryMessage = "SYSTEM ERROR! PLEASE CONTACT SYSTEM ADMINISTRATOR IMMEDIATELY!"
                AuthorityEvent(gHistoryMessage)
                MessageBox.Show(Me, gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End If

            Dim OverrideAuthorityRemoval As Boolean
            If Me.ForcePTCOperations And Me.RestrictingAuthority Then
                OverrideAuthorityRemoval = True
            End If

            If Not OverrideAuthorityRemoval And Not optEnablePTCBOSAPIMode Then
                Me.RemoveVoidedAuthorities()
            ElseIf Not OverrideAuthorityRemoval And optEnablePTCBOSAPIMode And Not TrainIsActivePTC Then
                Me.RemoveVoidedAuthorities()
            ElseIf Not OverrideAuthorityRemoval And optEnablePTCBOSAPIMode And Not Me.IssuedToTrain Then
                Me.RemoveVoidedAuthorities()
            End If

            If TransmitMode Then
                TMDS.SystemForms.MySystemForms.frmFaxPrinterList = New frmFaxPrinterList()
                TMDS.SystemForms.MySystemForms.frmFaxPrinterList.Owner = Me
                TMDS.SystemForms.MySystemForms.frmFaxPrinterList.Location = New Point(Me.Left + 50, Me.Top + 50)
                TMDS.SystemForms.MySystemForms.frmFaxPrinterList.SetupForm(gBeginTrackSelect.SubdivisionID, Me.mySFAuthority)
                TMDS.SystemForms.MySystemForms.frmFaxPrinterList.ShowDialog()
                TMDS.SystemForms.MySystemForms.frmFaxPrinterList.Dispose()
                TMDS.SystemForms.MySystemForms.frmFaxPrinterList = Nothing
            End If
            Dim CheckItem As ListViewItem
            For Each CheckItem In Me.lvVerbiage.Items
                CheckItem.Tag = "READED-OKED"
            Next


            If optEnablePTCBOSAPIMode Then
                Me.btnVoid.Visible = False
                Me.btnDone.Visible = True
                Me.btnDone.Enabled = True
                Me.btnDone.Focus()
            Else
                If Not RestrictingAuthority Then
                    Me.btnVoid.Visible = False
                    Me.btnDone.Visible = True
                    Me.btnDone.Enabled = True
                    Me.btnDone.Focus()
                End If
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

    Private Sub PositionSelectionafterOK()
        Try

            Dim item As ListViewItem
            For Each item In Me.lvVerbiage.Items
                If item.Text = "---------------------------------------------------------" Then
                    Dim NextItem As Integer = Me.lvVerbiage.Items.IndexOf(item)
                    Dim ItemToSelect As ListViewItem = Me.lvVerbiage.Items(NextItem + 1)
                    Me.lvVerbiage.Focus()
                    ItemToSelect.Selected = True
                    Exit Sub
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub
