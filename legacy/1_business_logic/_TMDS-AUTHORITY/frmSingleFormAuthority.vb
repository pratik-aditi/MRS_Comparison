                        Me.cmbItem1Void1.Text = VoidedWarrant.AuthorityUID
                        Me.cmbItem1Void1.Enabled = False
                        Me.chkItem1.Checked = True

                        If gItemSixRequired Or Me.ForceBoxSix Then
                            Me.chkItem6.Checked = True
                            If Me.BoxSixComponents.Count = 0 Then
                                ErrorMessage = "Can Not Find Box Six - Behind Trains...Exiting Warrant!"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                Exit Function
                            End If

                            Dim BoxSixTrains As String = String.Empty
                            Dim BoxSixTrain As String = String.Empty
                            Dim BoxSixCount As Integer = 1
                            For Each BoxSixTrain In Me.BoxSixComponents
                                BoxSixTrains = BoxSixTrains & BoxSixTrain.ToString & ", "
                                Dim txtBoxSix As TextBox = Me.GetBoxSix(BoxSixCount)
                                If IsNothing(txtBoxSix) Then
                                    ErrorMessage = "Can Not Find Box Six - Behind Trains...Exiting Warrant!"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    Exit Function
                                Else
                                    txtBoxSix.Text = BoxSixTrain
                                    txtBoxSix.Enabled = True
                                    txtBoxSix.ReadOnly = True
                                End If
                                BoxSixCount = BoxSixCount + 1
                            Next

                            If BoxSixTrains = "" Then
                                ErrorMessage = "Can Not Find Box Six - Behind Trains...Exiting Warrant!"
                                AuthorityEvent(ErrorMessage)
                                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                Exit Function
