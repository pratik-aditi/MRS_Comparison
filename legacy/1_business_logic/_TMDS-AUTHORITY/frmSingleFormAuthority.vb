                    Me.lvVerbiage.Items.Add("                    TO " & Me.txtItem2To3.Text.ToUpper)
                    Me.lvVerbiage.Items.Add("                    ON " & Me.txtItem2Track3.Text.ToUpper)
                End If

            End If

            If Me.chkItem3.Checked Then
                Dim Box3Line As String = "[X BOX  3] CLEAR AT LAST NAMED POINT."
                Me.lvVerbiage.Items.Add(Box3Line)
            End If


            If Me.chkItem4.Checked Then
                Dim Box4Line1 As String = "[X BOX  4] WORK BETWEEN " & Me.txtItem4At1.Text.ToUpper
                Me.lvVerbiage.Items.Add(Box4Line1)
                Me.lvVerbiage.Items.Add("                    AND " & Me.txtItem4And1.Text.ToUpper)
                Me.lvVerbiage.Items.Add("                    ON " & Me.txtItem4Track1.Text.ToUpper)

                If Me.SecondLineNeeded Then
                    Dim Box4Line2 As String = "                    WORK BETWEEN " & Me.txtItem4At2.Text.ToUpper
                    Me.lvVerbiage.Items.Add(Box4Line2)
                    Me.lvVerbiage.Items.Add("                    AND " & Me.txtItem4And2.Text.ToUpper)
                    Me.lvVerbiage.Items.Add("                    ON " & Me.txtItem4Track2.Text.ToUpper)

                End If
                If Me.ThirdLineNeeded Then
                    Dim Box4Line3 As String = "                    WORK BETWEEN " & Me.txtItem4At3.Text.ToUpper
                    Me.lvVerbiage.Items.Add(Box4Line3)
                    Me.lvVerbiage.Items.Add("                    AND " & Me.txtItem4And3.Text.ToUpper)
                    Me.lvVerbiage.Items.Add("                    ON " & Me.txtItem4Track3.Text.ToUpper)

                End If
            End If

            If Me.chkItem5.Checked Then
                Dim Box5AtLocation As String
                Dim Box5Line1 As String = "[X BOX  5] AUTHORITY IN EFFECT AFTER THE ARRIVAL OF (" & Me.txtItem5Arrival1.Text.ToUpper & ") "
                If txtItem5Arrival2.Text <> "" Then
                    Box5Line1 = Box5Line1 & "(" & Me.txtItem5Arrival2.Text.ToUpper & ") "
                End If
                If txtItem5Arrival3.Text <> "" Then
                    Box5Line1 = Box5Line1 & "(" & Me.txtItem5Arrival3.Text.ToUpper & ") "
                End If
                Box5AtLocation = "                    AT " & Me.txtItem5At.Text.ToUpper

                Me.lvVerbiage.Items.Add(Box5Line1)
                Me.lvVerbiage.Items.Add(Box5AtLocation)

            End If

            If Me.chkItem6.Checked Then
                Dim Box6Line1 As String = "[X BOX  6] AUTHORITY IN EFFECT BEHIND (" & Me.txtItem6Behind1.Text.ToUpper & ") "
                If txtItem6Behind2.Text <> "" Then
                    Box6Line1 = Box6Line1 & "(" & Me.txtItem6Behind2.Text.ToUpper & ") "
                End If
                If txtItem6Behind3.Text <> "" Then
                    Box6Line1 = Box6Line1 & "(" & Me.txtItem6Behind3.Text.ToUpper & ") "
                End If

                Me.lvVerbiage.Items.Add(Box6Line1)
            End If

            If Me.chkItem8.Checked Then
                Dim Box8Line As String = "[X BOX  8] JOINT AUTHORITY BETWEEN " & Me.cmbBox8From.Text & " AND " & Me.cmbBox8To.Text '& " ON " & Me.txtItem8Track.Text
                Me.lvVerbiage.Items.Add(Box8Line)
                'If Me.IssuedToTrain Then
                '    Me.lvVerbiage.Items.Add("                    NOTE: TRAINS MUST MOVE AT RESTRICTED SPEED.")
                'End If
            End If

            If Me.chkItem9.Checked Then
                Me.BoxNineList.Clear()
                Dim Box9Line As String = "[X BOX  9] OVERLAPS:"
                Me.lvVerbiage.Items.Add(Box9Line)
                Dim ja As JointAuthorityType
                Dim JointOverLap As String
                For Each ja In Me.JointAuthoritiesFound
                    JointOverLap = ""
                    If gSearchDirection = "LEFT" Then
                        JointOverLap = "     " & ja.IssueToName & " BETWEEN " & ja.RightLimits & " AND " & ja.LeftLimits
                    Else
                        JointOverLap = "     " & ja.IssueToName & " BETWEEN " & ja.LeftLimits & " AND " & ja.RightLimits
                    End If

                    BoxNineList.Add(JointOverLap)
                    Me.lvVerbiage.Items.Add(JointOverLap)
                Next
            End If

            If Me.chkItem10.Checked Then
                Dim Box10Line As String = "[X BOX 10] CLEAR BY " & Format(Me.dtItem10.Value, "HH:mm")
                Me.lvVerbiage.Items.Add(Box10Line)
            End If

            If Me.chkItem12.Checked Then
                Dim Counter As Integer
                Dim BoxTwelveSwitch As String = String.Empty
                Dim BoxTwelveVerbiage As String = String.Empty

                For Each BoxTwelveSwitch In BoxTwelveSwitches
                    If Counter = 0 Then
                        BoxTwelveVerbiage = BoxTwelveVerbiage & "(" & BoxTwelveSwitch & ")"
                    Else
                        BoxTwelveVerbiage = BoxTwelveVerbiage & ", (" & BoxTwelveSwitch & ")"
                    End If
                    Counter = Counter + 1
                Next
                Dim Box12Line As String = "[X BOX 12] BE PREPARED TO STOP AT FOLLOWING SWITCH(ES) UNTIL KNOWN TO BE IN NORMAL POSITION:"
                Me.lvVerbiage.Items.Add(Box12Line)
                BoxTwelveVerbiage = "                     " & BoxTwelveVerbiage
                Me.lvVerbiage.Items.Add(BoxTwelveVerbiage)
            End If

            If Me.chkItem13.Checked Then
                Dim Counter As Integer
                Dim BoxThirteenSwitch As String = String.Empty
                Dim BoxThirteenVerbiage As String = String.Empty

                For Each BoxThirteenSwitch In BoxThirteenSwitches
                    If Counter = 0 Then
                        BoxThirteenVerbiage = BoxThirteenVerbiage & "(" & BoxThirteenSwitch & ")"
                    Else
                        BoxThirteenVerbiage = BoxThirteenVerbiage & ", (" & BoxThirteenSwitch & ")"
                    End If
                    Counter = Counter + 1
                Next
                Dim Box13Line As String = "[X BOX 13] PERMISSION TO LEAVE FOLLOWING SWITCH(ES)IN REVERSE POSITION:"
                Me.lvVerbiage.Items.Add(Box13Line)
                BoxThirteenVerbiage = "                    " & BoxThirteenVerbiage
                Me.lvVerbiage.Items.Add(BoxThirteenVerbiage)
            End If

            If Me.chkItem14.Checked Then
                Dim Box14Line As String = "[X BOX 14] " '& Me.txtItem14.Text
                'Me.lvVerbiage.Items.Add(Box14Line)
                Dim s As String = ""
                Dim FirstLineFound As Boolean = False
                Dim Bx14Splt() As String = Me.txtItem14.Text.Split(Chr(10))
                If Bx14Splt.GetUpperBound(0) > 1 Then
                    For Each s In Bx14Splt
                        If s.Trim <> "" Then
                            If Not FirstLineFound Then
                                FirstLineFound = True
                                Me.lvVerbiage.Items.Add(Box14Line & " " & s)
                            Else
                                Me.lvVerbiage.Items.Add(Space(22) & s)
                            End If
                        End If
                    Next
                Else
                    Dim WordsInComment() As String = Me.txtItem14.Text.Split(" ")
                    Dim CharCount As Integer
                    Dim CurrentString As String = String.Empty

                    Dim word As String
                    For Each word In WordsInComment
                        If CharCount + word.Length > 80 Then
                            If Not FirstLineFound Then
                                FirstLineFound = True
                                Me.lvVerbiage.Items.Add(Box14Line & " " & CurrentString)
                            Else
                                Me.lvVerbiage.Items.Add(Space(22) & CurrentString)
                            End If
                            CurrentString = ""
                            CharCount = 0
                            CurrentString = CurrentString & word & " "
                            CharCount = CharCount + word.Length
                        Else
                            CurrentString = CurrentString & word & " "
                            CharCount = CharCount + word.Length
                        End If
                    Next
                    If Not FirstLineFound Then
                        Me.lvVerbiage.Items.Add(Box14Line & " " & CurrentString)
                    Else
                        Me.lvVerbiage.Items.Add(Space(22) & CurrentString)
                    End If
                End If


            End If

            Dim CheckedBoxes As String = Me.txtNumOfBoxes.Text & " BOX(ES) MARKED: "
            Dim BoxesChecked As String = String.Empty
            Dim count As Integer
            Dim chkItem As CheckBox
            Me.CheckBoxListItems = ""
            For Each chkItem In Me.CheckItemArrayList
                If chkItem.CheckState = CheckState.Checked Then
                    Dim Box As String = chkItem.Name.Replace("chkItem", "")
                    If count = 0 Then
                        count = 1
                        BoxesChecked = BoxesChecked & " [" & Box & "]"
                    Else
                        BoxesChecked = BoxesChecked & ", [" & Box & "]"
                    End If
                End If
            Next
            CheckBoxListItems = BoxesChecked
            Me.lvVerbiage.Items.Add(CheckedBoxes & BoxesChecked)


            If AuthorityOK Then

                Me.lvVerbiage.Items.Add(New ListViewItem("---------------------------------------------------------"))
                Dim OKHeader As String = "TRACK WARRANT " & Me.mySFAuthority.AuthorityUID & ", TO " & Me.mySFAuthority.IssueTo
                Me.lvVerbiage.Items.Add(New ListViewItem(OKHeader))


                If Me.chkItem5.Checked Then
                    Dim Box5Line As String = "WITH AFTER THE ARRIVAL OF:"
                    Me.lvVerbiage.Items.Add(Box5Line)

                    Dim box5Trn As String
                    Box5Line = ""
                    For Each box5Trn In Me.BoxFiveTrainList
                        Box5Line = Box5Line & "(" & box5Trn & ") "
                    Next
                    Box5Line = "                                     " & Box5Line
                    Me.lvVerbiage.Items.Add(Box5Line)

                    Box5Line = ""
                    Box5Line = "                                     AT " & Me.BoxFrom1
                    Me.lvVerbiage.Items.Add(Box5Line)
                End If


                Dim OKstring As String = "IS OK AT " & OKTime & ", " & TMDS.GlobalDeclarations.gCurrentUser.Initials
                Me.lvVerbiage.Items.Add(New ListViewItem(OKstring))
                'OKTime = OKstring
            Else
                Me.AuthorityVerbiage = ""
                Dim str As ListViewItem
                For Each str In Me.lvVerbiage.Items
                    Me.AuthorityVerbiage = Me.AuthorityVerbiage & str.Text & "|"
                Next
            End If
            Me.lvVerbiage.Refresh()
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Function

