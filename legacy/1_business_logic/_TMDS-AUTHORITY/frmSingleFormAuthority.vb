                'AuthorityEvent("PARALLEL AUTHORITY CHECK-INCOMPATIBLE WARRANT FOUND FOR THIS SELECTION! - EXITING")
                'frmMessageBox.ShowDialog()
                'MessageList.Clear()
                'MessageList = Nothing
                'frmMessageBox.Dispose()
                'frmMessageBox = Nothing
                'ClearSystemVariables()
                'Me.CloseForm()
                'Exit Sub
                MultipleAuthoritiesFound = True
            End If



            If Mid(Me.FirstTypeOfWarrant, 1, 7) <> "ItemTwo" Then
                If Not IsNothing(VoidedWarrant) Then
                    'If VoidedWarrant.AuthType1 <> "ItemTwoToTrain" Then
                    If FirstTypeOfWarrant = "ItemFourToTrain" Then
                        If Not CheckForAuthoritiesInBothDirections() Then
                            MultipleAuthoritiesFound = True
                        End If
                    End If
                    'End If
                Else
                    If FirstTypeOfWarrant = "ItemFourToTrain" Then
                        If Not CheckForAuthoritiesInBothDirections() Then
                            MultipleAuthoritiesFound = True
                        End If
                    End If
                End If
            End If
            If Not MultipleAuthoritiesFound And Mid(Me.FirstTypeOfWarrant, 1, 7) = "ItemTwo" Then
                Dim LastTrack As Track = Me.FindFirstTrackInList(Me.CompleteCompSelection)
                Dim NextComp As Object

                Dim TrackList As New ArrayList
                Dim Subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(LastTrack.SubdivisionID)
                Dim SubdivisionName As String = String.Empty
                If Not IsNothing(Subdvn) Then
                    SubdivisionName = Subdvn.Name
                End If
                Dim AuthList As New ArrayList
                Dim auth As Object
                For Each auth In OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        Dim sfa1 As SFAuthority = CType(auth, SFAuthority)
                        If sfa1.IssuedToTrain And Mid(sfa1.AuthType1, 1, 7) = "ItemTwo" Then
                            If Mid(sfa1.IssueTo, 1, 10) = Mid(Me.cbIssueTo.Text, 1, 10) And sfa1.Subdivision = SubdivisionName And sfa1.Direction = gSearchDirection Then
                                AuthList.Add(sfa1)
                            End If
                        End If
                    End If
                Next

                Dim SwList As New ArrayList
                Dim UseAltLink As Boolean
                Dim LastComp As Object = LastTrack
                If gSearchDirection = "LEFT" Then
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(LastTrack.LeftLink)

                    Do
                        If IsNothing(NextComp) Then
                            Exit Do
                        End If
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(NextComp, Track)

                            If trk.SubdivisionID <> LastTrack.SubdivisionID Then
                                Exit Do
                            End If
                            If Mid(trk.AuthorityType, 1, 3) = "CTC" Then
                                UseAltLink = True
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            SwList.Add(NextComp)
                        End If
                        If UseAltLink Then
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(LastComp.LeftAltLink)
                            UseAltLink = False
                        Else
                            TrackList.Add(NextComp)
                            LastComp = NextComp
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                    Loop
                Else
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(LastTrack.RightLink)
                    Do
                        If IsNothing(NextComp) Then Exit Do
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(NextComp, Track)
                            If trk.SubdivisionID <> LastTrack.SubdivisionID Then
                                Exit Do
                            End If
                            If Mid(trk.AuthorityType, 1, 3) = "CTC" Then
                                UseAltLink = True
                            End If

                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            SwList.Add(NextComp)
                        End If
                        'TrackList.Add(NextComp)
                        'NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        If UseAltLink Then
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(LastComp.RightAltLink)
                            UseAltLink = False
                        Else
                            TrackList.Add(NextComp)
                            LastComp = NextComp
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If
                    Loop
                End If

                Dim sw As Switch
                For Each sw In SwList
                    If gSearchDirection = "LEFT" Then
                        If sw.LeftAltLink <> 0 Then
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftAltLink)
                            Do
                                If IsNothing(NextComp) Then Exit Do
                                If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    Dim trk As Track = CType(NextComp, Track)
                                    If (trk.SubdivisionID <> LastTrack.SubdivisionID) Or Mid(trk.AuthorityType, 1, 3) <> "TWC" Or TrackList.Contains(NextComp) Then
                                        Exit Do
                                    End If
                                End If
                                TrackList.Add(NextComp)
