                Case "M"
                    OKTime = Format(Now.AddHours(-1 + gThisWorkstationTimeFactor), "HH:mm")
                    Me.mySFAuthority.OKTime = Format(Now.AddHours(-1 + gThisWorkstationTimeFactor), "MM-dd-yyyy HH:mm")

