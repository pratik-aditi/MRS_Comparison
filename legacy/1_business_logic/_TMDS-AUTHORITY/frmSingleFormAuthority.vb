                                End If
                            Next warr
                        End If
                    End If
                Next comp
            Next

            Dim WarrToAddToBoxNine As SFAuthority
            For Each WarrToAddToBoxNine In WarrantsFoundForBoxSix
                If WarrToAddToBoxNine.AuthType1 = "ItemTwoToTrain" Then
                    If Not Me.BoxSixComponents.Contains(WarrToAddToBoxNine.IssueTo) Then
                        Me.BoxSixComponents.Add(WarrToAddToBoxNine.IssueTo)
                    End If
                End If
            Next

            AuthorityEvent("OVERLAP IS VALIDATED FOR AUTHORITY TYPE:" & FirstTypeOfWarrant)
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try

    End Function

    Private Function ConflictCheckItemTwoFive(ByVal ComponentList As ArrayList, ByVal SearchDirection As String) As Boolean
        Try
            Dim ErrorMessage As String
            Dim SignalTerritory As Boolean
            Dim TrackToTest As Object
            Dim FirstTrackInList As Track = ComponentList.Item(0)

            If FirstTrackInList.BiDirectionalABS Then SignalTerritory = True
            If FirstTrackInList.SingleABSEast And (SearchDirection = "RIGHT") Then SignalTerritory = True
            If FirstTrackInList.SingleABSWest And (SearchDirection = "LEFT") Then SignalTerritory = True

            'If the item five warrant was created in bi-directional signal territory then check to insure all tracks are bi-directional ABS
            Dim comp As Object
            Dim FirstAuthFoundInNonSignalTerritory As SFAuthority = Nothing
            If SignalTerritory Then
                For Each comp In ComponentList
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(comp, Track)
                        If trk.TrackAuthorities.Count > 0 Then
                            Dim sfa As SFAuthority
                            For Each sfa In trk.TrackAuthorities
                                If sfa.CheckBoxItemsStatus(4) Then
                                    Dim OverrideConflict As Boolean
                                    If comp.BiDirectionalABS Or (comp.SingleABSEast And gSearchDirection = "RIGHT") Or (comp.SingleABSWest And gSearchDirection = "LEFT") Then
                                        OverrideConflict = True
                                    Else
                                        If IsNothing(FirstAuthFoundInNonSignalTerritory) Then
                                            FirstAuthFoundInNonSignalTerritory = sfa
                                            OverrideConflict = True
                                        Else
                                            If sfa Is FirstAuthFoundInNonSignalTerritory Then
                                                OverrideConflict = True
                                            End If
                                        End If
                                    End If

                                    If Not OverrideConflict Then
                                        ErrorMessage = "Track Warrant Limits Are Not Allowed to Have Both Signaled and Non-Signaled Limits! - EXITING!"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        Return False
                                    Else
                                        OverrideConflict = False
                                    End If
                                ElseIf Not comp.BiDirectionalABS And Not (comp.SingleABSWest And gSearchDirection = "LEFT") And Not (comp.SingleABSEast And gSearchDirection = "RIGHT") Then
                                    If SearchDirection = sfa.Direction Then
                                        ErrorMessage = "Track Warrant Limits Are Not Allowed to Have Both Signaled and Non-Signaled Limits for this Type of Autrhority! - EXITING!"
                                        AuthorityEvent(ErrorMessage)
                                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                        Return False
                                    End If
                                End If
                            Next
                        End If
                    End If
                Next
            End If

            For Each TrackToTest In ComponentList
                Dim WarrToTest As SFAuthority
                If TrackToTest.TrackAuthorities.Count > 0 Then
                    For Each WarrToTest In TrackToTest.TrackAuthorities

                        If (WarrToTest.AuthType1 = "ItemFourToMOW" And Not WarrToTest.CheckBoxItemsStatus(7)) Or (WarrToTest.AuthType1 = "ItemFourToTrain") Or (WarrToTest.AuthType1 = "ItemTwoToMOW") Then
                            ErrorMessage = "This Type of Track Warrant Not Compatiable With An Item Five Warrant! - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            Return False
                        End If

                        'Check for multiple trains for the Box Seven Train List
                        If SearchDirection <> WarrToTest.Direction Then
                            If Not BoxFiveTrainList.Contains(WarrToTest.IssueTo) And WarrToTest.IssuedToTrain Then
                                BoxFiveTrainList.Add(WarrToTest.IssueTo)
                                BoxFiveTrainSFA.Add(WarrToTest)
                            End If
                        End If

                        If Not SignalTerritory Then
                            If SearchDirection = WarrToTest.Direction Then
                                Dim OverrideConflict As Boolean
                                If Not IsNothing(gItemTwoFiveVoidedAuthorityCandidate) Then
                                    If gItemTwoFiveVoidedAuthorityCandidate.Box5Arrival.Contains(WarrToTest.IssueTo) Or gItemTwoFiveVoidedAuthorityCandidate.AuthorityUID = WarrToTest.AuthorityUID Then
                                        OverrideConflict = True
                                        Me.ForceBoxOne = True
                                        Me.VoidedWarrant = gItemTwoFiveVoidedAuthorityCandidate
                                    End If
                                End If

                                If TrackToTest.BiDirectionalABS Then
                                    If WarrToTest.Direction = gSearchDirection Then
                                        OverrideConflict = True
                                    End If
                                End If

                                If Not OverrideConflict Then
                                    ErrorMessage = "OVERLAPPING LIMITS EXISTS. AUTHORITY NOT ALLOWED! - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    Return False
                                Else
                                    OverrideConflict = False
                                End If
                            End If
                        End If
                    Next
                End If
            Next

            'Check to see if Box Five trains have authority to the point of conflict.
            Dim BoxFiveTrain As String
            If gBeginTrackSelect.TrackAuthorities.Count > 0 Then
                Dim AuthFound As Boolean
                Dim AuthToCheck As SFAuthority
                For Each BoxFiveTrain In Me.BoxFiveTrainList
                    For Each AuthToCheck In gBeginTrackSelect.TrackAuthorities
                        If AuthToCheck.IssueTo = BoxFiveTrain Then
                            AuthFound = True
                        End If
                    Next
                    If Not AuthFound Then
                        ErrorMessage = "AUTHORITY LIMITS SELECTION NOT ALLOWED SINCE NOT ALL OPPOSING TRAINS HAVE AUTHORITY TO THE POINT OF CONFLICT! - EXITING"
                        AuthorityEvent(ErrorMessage)
                        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Return False
                    Else
                        AuthFound = False
                    End If
                Next
            Else
                ErrorMessage = "AUTHORITY LIMITS SELECTION NOT ALLOWED SINCE NOT ALL ITEM 5 TRAINS HAVE AUTHORITY TO THE POINT OF CONFLICT! - EXITING"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If

            Dim TrainCount As Integer
            If BoxFiveTrainList.Count > 3 Then
                ErrorMessage = "TOO MANY OPPOSING TRAINS FOR BOX FIVE WARRANT! - EXITING"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If

            For Each BoxFiveTrain In BoxFiveTrainList
                If TrainCount = 0 Then
                    BoxFiveTrains = BoxFiveTrains & "(" & BoxFiveTrain & ")"
                Else
                    BoxFiveTrains = BoxFiveTrains & "  (" & BoxFiveTrain & ")"
                End If
                TrainCount = TrainCount + 1
            Next
            gItemFiveRequired = True

            If Not SignalTerritory Then
                If Not Me.ConflictCheckJointAuthoritiesForItemTwoSameTrain(ComponentList, Nothing, Nothing) Then
                    Return False
                End If
            Else
                If Not Me.ConflictCheckJointAuthoritiesForItemTwoSameTrainInABS(ComponentList, Nothing, Nothing) Then
                    Return False
                End If
                Me.SignalLimitsFound = True
            End If

            AuthorityEvent("OVERLAP IS VALIDATED FOR WARRANT TYPE:" & FirstTypeOfWarrant)
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            SysEvent = Nothing
            Return False
        End Try

    End Function

    Private Function ConflictCheckJointAuthoritiesForItemTwoSameTrain(ByVal ComponentList As ArrayList, Optional ByVal ReplacementAuthNumber As String = Nothing, Optional ByVal WarrToVoid As SFAuthority = Nothing) As Boolean
        Try
            Dim comp As Object
            Dim warr As SFAuthority
            Dim ErrorMessage As String
            Dim ReplacementAuth As SFAuthority = Me.FindAuthority(ReplacementAuthNumber)
            'For each component in the selection collection
            For Each comp In ComponentList
                If comp.TrackAuthorities.Count > 0 Then 'Do these checks on components that have active warrants only

                    'FIRST CHECK - Make sur that box 11 is check on each warrant
                    For Each warr In comp.TrackAuthorities
                        If FirstTypeOfWarrant <> "ItemFourNineToMOW" Then
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If ReplacementAuthNumber <> warr.AuthorityUID Then
                                    If Not warr.CheckBoxItemsStatus(7) And Not warr.CheckBoxItemsStatus(4) Then
                                        Dim OverrideConflictCheck As Boolean
                                        If warr.CheckBoxItemsStatus(5) Then
                                            If Not IsNothing(WarrToVoid) Then
                                                If warr.Box6Train.Contains(WarrToVoid.IssueTo) Then
                                                    OverrideConflictCheck = True
                                                End If
                                            End If
                                        End If
                                        If gItemFiveRequired And Me.BoxFiveTrainList.Contains(warr.IssueTo) Then
                                            OverrideConflictCheck = True
                                        End If

                                        If comp.BiDirectionalABS Or (gSearchDirection = "RIGHT" And comp.SingleABSEast) Or (gSearchDirection = "LEFT" And comp.SingleABSWest) Then
                                            If warr.Direction <> gSearchDirection Then
                                                If gItemFiveRequired And Me.BoxFiveTrainList.Contains(warr.IssueTo) Then
                                                    OverrideConflictCheck = True
                                                Else
                                                    OverrideConflictCheck = False
                                                End If
                                            Else
                                                OverrideConflictCheck = True
                                            End If
                                        End If
                                        If Not OverrideConflictCheck Then
                                            ErrorMessage = "Track Warrant Number: " & warr.AuthorityUID & vbCrLf & "DOES NOT HAVE BOX 8 CHECKED!! - EXITING"
                                            AuthorityEvent(ErrorMessage)
                                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            ClearSystemVariables()
                                            Return False
                                        Else
                                            OverrideConflictCheck = False
                                        End If
                                    ElseIf warr.CheckBoxItemsStatus(4) Then
                                        Dim OverrideCheck As Boolean
                                        Dim ReplacementIssueTo As String = String.Empty
                                        If Not IsNothing(ReplacementAuth) Then
                                            ReplacementIssueTo = ReplacementAuth.IssueTo
                                        End If
                                        If Not warr.Box5Arrival.Contains(ReplacementIssueTo) Then
                                            OverrideCheck = True
                                        End If

                                        If Me.BoxFiveTrainList.Contains(warr.IssueTo) Then
                                            OverrideCheck = True
                                        End If

                                        If Not OverrideCheck Then
                                            ErrorMessage = "Track Warrant Number: " & warr.AuthorityUID & vbCrLf & "DOES NOT HAVE BOX 8 CHECKED!! - EXITING"
                                            AuthorityEvent(ErrorMessage)
                                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            ClearSystemVariables()
                                            Return False
                                        Else
                                            OverrideCheck = False
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    Next

                    'SECOND CHECK - Make sure that there are no more then four warrants on each track
                    If comp.TrackAuthorities.Count > 3 Then
                        Dim TotalCount As Integer = comp.TrackAuthorities.Count
                        If Not IsNothing(VoidedWarrant) Then
                            If comp.TrackAuthorities.Contains(VoidedWarrant) Then
                                TotalCount = TotalCount - 1
                            End If
                        End If
                        If TotalCount > 3 Then
                            ErrorMessage = "Too Many Joint Authorities. Authority Form Only Allows Three Joint Authorities. - EXITING"
                            AuthorityEvent(ErrorMessage)
                            MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            ClearSystemVariables()
                            Return False
                        End If
                    End If
                End If
            Next comp


            '********************************************************************************
            'Dim DuplicateWarrantNumber As Boolean = False
            'Dim DebugAuthMessage As String

            'For each component in the selection collection
            For Each comp In ComponentList

                If comp.TrackAuthorities.Count > 0 Then
                    Dim IncludeAsJoint As Boolean
                    For Each warr In comp.TrackAuthorities
                        If (warr.AuthType1 = "ItemTwoToTrain") Then
                            If warr.CheckBoxItemsStatus(7) And Not Me.BoxFiveTrainList.Contains(warr.IssueTo) Then
                                If ReplacementAuthNumber <> warr.AuthorityUID Then
                                    Dim NonSignalDetected As Boolean = False
                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        NonSignalDetected = True
                                        Dim trk As Track = CType(comp, Track)
                                        If trk.BiDirectionalABS Or (trk.SingleABSWest And gSearchDirection = "LEFT") Or (trk.SingleABSEast And gSearchDirection = "RIGHT") Then
                                            NonSignalDetected = False
                                        Else
                                            NonSignalDetected = True
                                        End If
                                    Else
                                        NonSignalDetected = False
                                    End If

                                    If optJointTrainToTrain And NonSignalDetected Then
                                        JointAuthRequired = True
                                        gJointAuthRequired = True
                                        gBox8Required = True

                                        Dim ja As JointAuthorityType
                                        Dim AuthorityFound As Boolean
                                        For Each ja In Me.JointAuthoritiesFound
                                            If ja.AuthUID = warr.AuthorityUID Then
                                                AuthorityFound = True
                                            End If
                                        Next
                                        If Not AuthorityFound Then
                                            Dim jaNew As New JointAuthorityType()
                                            jaNew.AuthUID = warr.AuthorityUID
                                            Me.JointAuthoritiesFound.Add(jaNew)
                                        Else
                                            AuthorityFound = False
                                        End If
                                    End If
                                End If
                            ElseIf Me.BoxFiveTrainList.Contains(warr.IssueTo) Then
                                'do nothing
                            End If
                        ElseIf (warr.AuthType1 = "ItemFourToMOW") And warr.CheckBoxItemsStatus(5) Then
                            IncludeAsJoint = True
                            If Not IsNothing(WarrToVoid) Then
                                If warr.Box6Train.Contains(WarrToVoid.IssueTo) Then
                                    IncludeAsJoint = False
                                End If
                            End If
                        ElseIf (warr.AuthType1 = "ItemTwoFiveToTrain") And Me.BoxFiveTrainList.Contains(warr.IssueTo) Then
                            'Beep()
                        ElseIf (FirstTypeOfWarrant = "ItemFourToTrain" And warr.AuthType1 = "ItemFourToTrain") Then
                            If optJointTrainToTrain Then
                                JointAuthRequired = True
                                gJointAuthRequired = True
                                gBox8Required = True

                                Dim ja As New JointAuthorityType()
                                Dim AuthorityFound As Boolean
                                For Each ja In Me.JointAuthoritiesFound
                                    If ja.AuthUID = warr.AuthorityUID Then
                                        AuthorityFound = True
                                    End If
                                Next
                                If Not AuthorityFound Then
                                    Dim jaNew As New JointAuthorityType()
                                    jaNew.AuthUID = warr.AuthorityUID
                                    Me.JointAuthoritiesFound.Add(jaNew)
                                Else
                                    AuthorityFound = False
                                End If
                            End If
                        Else
                            JointAuthRequired = True
                            gJointAuthRequired = True
                            gBox8Required = True

                            Dim ja As JointAuthorityType
                            Dim AuthorityFound As Boolean
                            For Each ja In Me.JointAuthoritiesFound
                                If ja.AuthUID = warr.AuthorityUID Then
                                    AuthorityFound = True
                                End If
                            Next
                            If Not AuthorityFound Then
                                Dim jaNew As New JointAuthorityType()
                                jaNew.AuthUID = warr.AuthorityUID
                                Me.JointAuthoritiesFound.Add(jaNew)
                            Else
                                AuthorityFound = False
                            End If
                        End If
                        If IncludeAsJoint Then
                            JointAuthRequired = True
                            gJointAuthRequired = True
                            gBox8Required = True

                            Dim ja As JointAuthorityType
                            Dim AuthorityFound As Boolean
                            For Each ja In Me.JointAuthoritiesFound
                                If ja.AuthUID = warr.AuthorityUID Then
                                    AuthorityFound = True
                                End If
                            Next
                            If Not AuthorityFound Then
                                Dim jaNew As New JointAuthorityType()
                                jaNew.AuthUID = warr.AuthorityUID
                                Me.JointAuthoritiesFound.Add(jaNew)
                                IncludeAsJoint = False
                            Else
                                AuthorityFound = False
                                IncludeAsJoint = False
                            End If
                        Else
                            IncludeAsJoint = False
                        End If
                    Next
                End If

            Next 'component
            comp = Nothing

            'check to make sure there is no more then four joint overlapping authorities existing IN THIS SELECTION
            If JointAuthoritiesFound.Count > 3 Then
                ErrorMessage = "Too Many Joint Authorities. Authority Form Only Allows Three Joint Authorities. - EXITING"
                AuthorityEvent(ErrorMessage)
                MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                ClearSystemVariables()
                Return False
            End If



            '*************************************************************************************
            'Now add the overlapping limits for each authority that this authority laps over.
            '*************************************************************************************
            Dim jat As JointAuthorityType
            For Each jat In Me.JointAuthoritiesFound
                For Each comp In ComponentList
                    If comp.TrackAuthorities.Count > 0 Then
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            For Each warr In comp.TrackAuthorities
                                If jat.AuthUID = warr.AuthorityUID Then
                                    If gSearchDirection = "RIGHT" Then
                                        If jat.LeftLimits = "" Then
                                            jat.LeftLimits = comp.LeftLimitName
                                        End If
                                        jat.RightLimits = comp.RightLimitName
                                    Else
                                        If jat.RightLimits = "" Then
                                            jat.RightLimits = comp.RightLimitName
                                        End If
                                        jat.LeftLimits = comp.LeftLimitName
                                    End If
                                    jat.IssueToName = warr.IssueTo
                                End If
                            Next warr
                        End If
                    End If
                Next comp
            Next

            'For Each jat In Me.JointAuthoritiesFound
            '    DebugAuthMessage = DebugAuthMessage & jat.IssueToName & ","
            '    DebugAuthMessage = DebugAuthMessage & jat.AuthUID & ","
            '    DebugAuthMessage = DebugAuthMessage & jat.LeftLimits & ","
            '    DebugAuthMessage = DebugAuthMessage & jat.RightLimits & vbCrLf
            'Next
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Function ConflictCheckJointAuthoritiesForItemTwoSameTrainInABS(ByVal ComponentList As ArrayList, Optional ByVal ReplacementAuthNumber As String = Nothing, Optional ByVal WarrToVoid As SFAuthority = Nothing) As Boolean
        Try
            Dim comp As Object
            Dim warr As SFAuthority
            Dim ErrorMessage As String
            'Dim ReplacementAuth As SFAuthority = Me.FindAuthority(ReplacementAuthNumber)
            'For each component in the selection collection
            For Each comp In ComponentList
                If comp.TrackAuthorities.Count > 0 Then 'Do these checks on components that have active warrants only

                    'FIRST CHECK - Make sur that box 11 is check on each warrant
                    For Each warr In comp.TrackAuthorities
                        If FirstTypeOfWarrant <> "ItemTwoToTrain" Then
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim OverrideConflictCheck As Boolean
                                If warr.CheckBoxItemsStatus(5) Then
                                    OverrideConflictCheck = True
                                ElseIf FirstTypeOfWarrant = "ItemTwoFiveToTrain" And Me.BoxFiveTrainList.Contains(warr.IssueTo) Then
                                    OverrideConflictCheck = True
                                End If
                                If comp.BiDirectionalABS Or (gSearchDirection = "RIGHT" And comp.SingleABSEast) Or (gSearchDirection = "LEFT" And comp.SingleABSWest) Then
                                    If warr.Direction <> gSearchDirection Then
                                        If gItemFiveRequired And Me.BoxFiveTrainList.Contains(warr.IssueTo) Then
                                            OverrideConflictCheck = True
                                        ElseIf gItemFiveRequired And Not warr.IssuedToTrain And warr.CheckBoxItemsStatus(5) And warr.CheckBoxItemsStatus(7) Then
                                            OverrideConflictCheck = True
                                        Else
                                            OverrideConflictCheck = False
                                        End If
                                    Else
                                        OverrideConflictCheck = True
                                    End If
                                End If

                                If Not OverrideConflictCheck Then
                                    ErrorMessage = "Track Warrant Number: " & warr.AuthorityUID & vbCrLf & "DOES NOT HAVE BOX 8 CHECKED!! - EXITING"
                                    AuthorityEvent(ErrorMessage)
                                    MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                    ClearSystemVariables()
                                    Return False
                                Else
                                    OverrideConflictCheck = False
                                End If
                            End If
                        End If
                    Next

                    'SECOND CHECK - Make sure that there are no more then four warrants on each track
                    'If comp.TrackAuthorities.Count > 3 Then
                    '    Dim AuthCount As Integer = 0
                    '    Dim sfa As SFAuthority
                    '    For Each sfa In comp.TrackAuthorities
                    '        If sfa.CheckBoxItemsStatus(7) Then
                    '            AuthCount += 1
                    '        End If
                    '    Next

                    '    If IsNothing(VoidedWarrant) Then
                    '        For Each sfa In comp.TrackAuthorities
                    '            If sfa.AuthType1 = "ItemTwoToTrain" Then
                    '                WarrToVoid = sfa
                    '                VoidedWarrant = sfa
                    '                ForceBoxOne = True
                    '                Exit For
                    '            End If
                    '        Next
                    '    End If

                    '    Dim TotalCount As Integer = comp.TrackAuthorities.Count
                    '    If Not IsNothing(WarrToVoid) Then
                    '        If comp.TrackAuthorities.Contains(WarrToVoid) Then
                    '            If AuthCount > 0 Then
                    '                AuthCount = AuthCount - 1
                    '            End If
                    '        End If
                    '    End If
                    '    If AuthCount > 6 Then
                    '        ErrorMessage = "Too Many Joint Authorities. Authority Form Only Allows Six Joint Authorities. - EXITING"
                    '        AuthorityEvent(ErrorMessage)
                    '        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    '        ClearSystemVariables()
                    '        Return False
                    '    ElseIf comp.TrackAuthorities.Count > optOverLapAuthorityCount - 1 Then
                    '        ErrorMessage = "Too Many Overlapping Authorities. - EXITING"
                    '        AuthorityEvent(ErrorMessage)
                    '        MessageBox.Show(MainForm, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    '        ClearSystemVariables()
                    '        Return False
                    '    End If
                    'End If
                End If
            Next comp


            '********************************************************************************
            'Dim DuplicateWarrantNumber As Boolean = False
            'Dim DebugAuthMessage As String

            'For each component in the selection collection
            For Each comp In ComponentList

                If comp.TrackAuthorities.Count > 0 Then
                    Dim IncludeAsJoint As Boolean
                    For Each warr In comp.TrackAuthorities
                        If (warr.AuthType1 = "ItemTwoToTrain") And warr.Direction = gSearchDirection And Not warr.CheckBoxItemsStatus(7) Then
                            'DO NOTHING
                        ElseIf (warr.AuthType1 = "ItemTwoToTrain") And warr.Direction = gSearchDirection And warr.CheckBoxItemsStatus(7) Then
                            'DO NOTHING
                        ElseIf BoxFiveTrainList.Contains(warr.IssueTo) And FirstTypeOfWarrant = "ItemTwoFiveToTrain" And warr.AuthType1 = "ItemTwoToTrain" And warr.Direction <> gSearchDirection Then
                            'do nothing
                        ElseIf (warr.AuthType1 = "ItemTwoToTrain") And warr.Direction <> gSearchDirection Then
                            If Not IsNothing(WarrToVoid) Then
                                If Not warr.Box5Arrival.Contains(WarrToVoid.IssueTo) Then
                                    IncludeAsJoint = True
                                End If
                            Else
                                IncludeAsJoint = True
                            End If

                        ElseIf (warr.AuthType1 = "ItemFourToMOW") And warr.CheckBoxItemsStatus(5) And Not Me.LockIssueToList Then
                            IncludeAsJoint = True
                        ElseIf (warr.AuthType1 = "ItemFourToMOW") And warr.CheckBoxItemsStatus(5) And Me.LockIssueToList And warr.CheckBoxItemsStatus(7) Then
                            IncludeAsJoint = True
                        ElseIf (warr.AuthType1 = "ItemFourToMOW") And warr.CheckBoxItemsStatus(5) And Me.LockIssueToList Then
                            'do nothing
                        ElseIf (FirstTypeOfWarrant = "ItemFourToTrain" And warr.AuthType1 = "ItemFourToTrain") Then
                            If optJointTrainToTrain Then
                                JointAuthRequired = True
                                gJointAuthRequired = True
                                gBox8Required = True

                                Dim ja As New JointAuthorityType()
                                Dim AuthorityFound As Boolean
                                For Each ja In Me.JointAuthoritiesFound
                                    If ja.AuthUID = warr.AuthorityUID Then
                                        AuthorityFound = True
                                    End If
                                Next
                                If Not AuthorityFound Then
                                    Dim jaNew As New JointAuthorityType()
                                    jaNew.AuthUID = warr.AuthorityUID
                                    Me.JointAuthoritiesFound.Add(jaNew)
                                Else
                                    AuthorityFound = False
                                End If
                            End If
                        Else
                            JointAuthRequired = True
                            gJointAuthRequired = True
                            gBox8Required = True

                            Dim ja As JointAuthorityType
                            Dim AuthorityFound As Boolean
                            For Each ja In Me.JointAuthoritiesFound
                                If ja.AuthUID = warr.AuthorityUID Then
                                    AuthorityFound = True
                                End If
                            Next
                            If Not AuthorityFound Then
                                Dim jaNew As New JointAuthorityType()
                                jaNew.AuthUID = warr.AuthorityUID
                                Me.JointAuthoritiesFound.Add(jaNew)
                            Else
                                AuthorityFound = False
                            End If
