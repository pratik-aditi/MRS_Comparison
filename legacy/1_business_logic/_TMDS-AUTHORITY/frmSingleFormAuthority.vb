    Private Sub CheckToAcknowledgeSwitchPointAlerts()
        Dim al As Alert
        'Dim AlertMessage As String = sw.Name & "|" & sw.GUID.ToString & "|" & sw.TerritoryID & "|" & sw.myControlPoint.Name & "|" & auth.IssueTo & "|" & auth.AuthorityUID & "|" & LastStation
        Dim RemoveList As New ArrayList
        Try
            SyncLock TMDS.GlobalDeclarations.gSystemAlertList
                For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                    Select Case al.TypeOfAlert
                        Case ManagementClasses.Alert.AlertType.SwitchPointOpen
                            Dim data() As String = al.AlertData.Split("|")
                            If data.Length >= 7 Then
                                If Me.BoxTwelveSwitches.Contains(data(0)) Then
                                    al.AlertAcknowledged = True
                                    Dim Message As String = "SWITCH OPEN ALERT WAS ACKNOWLEDGED BY SYSTEM. SWITCH INCLUDED IN BOX 12 OF AUTHORITY:" & al.AlertGUID
                                    al.AlertAckedByPerson = Message
                                    SystemEvent(Message)
                                    gSystemAlertExists = False
                                    Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al.AlertGUID)
                                    SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                        TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                    End SyncLock
                                Else
                                    If Not IsNothing(Me.VoidedWarrant) Then
                                        Dim comp As Object
                                        For Each comp In Me.VoidedWarrant.Components
                                            If comp.GetType.ToString = gSwitchComponentName Then
                                                Dim sw As Switch = CType(comp, Switch)
                                                If sw.SwitchPointerMonitorMode Then
                                                    If Not Me.CompleteCompSelection.Contains(sw) And sw.Name = data(0) Then
                                                        al.AlertAcknowledged = True
                                                        Dim Message As String = "SWITCH OPEN ALERT WAS ACKNOWLEDGED BY SYSTEM. SWITCH INCLUDED IN BOX 12 OF AUTHORITY:" & al.AlertGUID
                                                        al.AlertAckedByPerson = Message
                                                        SystemEvent(Message)
                                                        gSystemAlertExists = False
                                                        Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al.AlertGUID)
                                                        SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                                            TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                                        End SyncLock
                                                    End If
                                                End If
                                            End If
                                        Next
                                    End If
                                End If
                            End If
                    End Select
                Next
                For Each al In RemoveList
                    TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                Next
            End SyncLock

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub ResetOrginalFlashSelection(ByVal NewSelectionList As ArrayList, ByVal LimitChangeType As String)
        Try
            Dim CloneList As ArrayList = gTrackSelectionCollection.Clone

            SyncLock gTrackSelectionCollection
                Dim comp As Object
                For Each comp In CloneList
                    If Not NewSelectionList.Contains(comp) Then
                        gTrackSelectionCollection.Remove(comp)
                        comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                        comp.FlashOn = False
                        comp.FlashComponent = False
                        comp.UpdateStatus()
                        If LimitChangeType = "TRACKZONE" Then
                            Me.PromptOnLimitsChangeFromTrackZone = True
                        Else
                            PromptOnLimitsChange = True
                            Me.PromptOnLimitsChangeFromTrackZone = False
                        End If
                    End If
                Next
            End SyncLock
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function DisplayPromptOnLimitsChange(ByVal LimitChangeType As String, Optional ByVal ShowFromLimits As Boolean = False) As Boolean
        Try
            Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)

            Dim frmMessageBox As frmMessageBox
            Dim MessageList As New ArrayList()
            If LimitChangeType = "TRACKZONE" Then
                MessageList.Add("SELECTED LIMITS HAVE BEEN SHORTENED DUE TO TRACK INTEGRITY CONDITION.")
            Else
                MessageList.Add("SELECTED LIMITS HAVE BEEN SHORTENED DUE TO SWITCH POINT CONDITION.")
            End If
            Dim ShortenLimits As String
            If Me.BoxTo2 <> "" Then
                ShortenLimits = Me.BoxTo2
            Else
                ShortenLimits = Me.BoxTo1
            End If
            Dim ShortenFromLimits As String
            If optShowTIWSShortenedLimits Then
                If ShowFromLimits Then
                    If Me.BoxTo2 <> "" Then
                        ShortenFromLimits = Me.BoxFrom2
                    Else
                        ShortenFromLimits = Me.BoxFrom1
                    End If
                    MessageList.Add("LIMITS SHORTENED FROM " & ShortenFromLimits & " TO " & ShortenLimits)
                Else
                    MessageList.Add("LIMITS SHORTENED TO " & ShortenLimits)
                End If
            End If

            MessageList.Add("")
            MessageList.Add("CONTINUE WITH THE AUTHORITY ISSUANCE?")
            frmMessageBox = New frmMessageBox()
            frmMessageBox.Owner = TMDS.SystemForms.MySystemForms.frmMainMDI
            frmMessageBox.SetMessage(MessageList, "TRACK WARRANT ALERT", True, LaunchPoint)
            frmMessageBox.ShowDialog()
            If frmMessageBox.FormFeedBack <> 6 Then
                Me.CloseForm()
                frmMessageBox.Dispose()
                frmMessageBox = Nothing
                Return False
            End If
            frmMessageBox.Dispose()
            frmMessageBox = Nothing
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Function LastSwitchCheckForSPMS() As Boolean

        Dim comp As Object
        Try
            For Each comp In Me.CompleteCompSelection
                If comp.GetType.ToString = gSwitchComponentName Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.SwitchPointerMonitorMode Then
                        If (sw.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or sw.FailState) Then
                            If Not Me.BoxTwelveSwitches.Contains(sw.Name) And Not Me.BoxThirteenSwitches.Contains(sw.Name) Then
                                Return False
                            End If
                        End If
                    End If
                End If
            Next
            PerformCheckOnAdjacentSwitches()
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Sub PerformCheckOnAdjacentSwitches()
        Try
            Dim BehindTrack As Track
            Dim FrontTrack As Track

            If gSearchDirection = "RIGHT" Then
                BehindTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gBeginTrackSelect.LeftLink)
                FrontTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gEndTrackSelect.RightLink)
                If Not IsNothing(BehindTrack) Then
                    If Not IsNothing(BehindTrack.OsComponentCollection) And BehindTrack.OStype Then
                        Dim comp As Object
                        For Each comp In BehindTrack.OsComponentCollection
                            If comp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(comp, Switch)
                                sw.CheckForExistingAuthorities()
                            End If
                        Next
                    End If
                End If
                If Not IsNothing(FrontTrack) Then
                    If Not IsNothing(FrontTrack.OsComponentCollection) And FrontTrack.OStype Then
                        Dim comp As Object
                        For Each comp In FrontTrack.OsComponentCollection
                            If comp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(comp, Switch)
                                sw.CheckForExistingAuthorities()
                            End If
                        Next
                    End If
                End If
            Else
                BehindTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gBeginTrackSelect.RightLink)
                FrontTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gEndTrackSelect.LeftLink)
                If Not IsNothing(BehindTrack) Then
                    If Not IsNothing(BehindTrack.OsComponentCollection) And BehindTrack.OStype Then
                        Dim comp As Object
                        For Each comp In BehindTrack.OsComponentCollection
                            If comp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(comp, Switch)
                                sw.CheckForExistingAuthorities()
                            End If
                        Next
                    End If
                End If
                If Not IsNothing(FrontTrack) Then
                    If Not IsNothing(FrontTrack.OsComponentCollection) And FrontTrack.OStype Then
                        Dim comp As Object
                        For Each comp In FrontTrack.OsComponentCollection
                            If comp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(comp, Switch)
                                sw.CheckForExistingAuthorities()
                            End If
                        Next
                    End If
                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub UpdateOverrideList()
        Try
            Dim ov As ZoneOverride = Nothing
            For Each ov In Me.TrackZoneOverrideList
                ov.AuthUID = Me.AuthorityNumberString
                Dim tz As TrackZone
                For Each tz In gTrackZones
                    If tz.ZoneUID = ov.ZoneUID Then
                        tz.UpdateZoneOverrideList(Nothing, Nothing, False, ov)
                    End If
                Next
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function FindTrackZoneofTheSwitch(sw As Switch) As String
        Dim trk As Track
        Try
            If sw Is Nothing Then Return Nothing
            trk = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(sw.RightLink)
            If trk IsNot Nothing AndAlso trk.TrackZoneReference IsNot Nothing Then
                Return trk.TrackZoneReference.ZoneName
            End If
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
        Return Nothing
    End Function


