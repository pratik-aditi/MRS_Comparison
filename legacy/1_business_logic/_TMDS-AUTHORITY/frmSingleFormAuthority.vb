                        Else
                            Me.dtItem10.Tag = ""
                            Me.dtItem10.Visible = False
                            Me.btnBox10.Text = ""
                        End If

                    Case "chkItem12"
                        If gBoxTwelveRequired Then
                            thisCheckBox.Checked = True
                            Me.txtItem12.Visible = True
                            Me.txtItem12.ReadOnly = True
                            Me.txtItem12.Tag = "VALIDATE"
                            Me.btnBox12.Text = "X"
                        Else
                            Me.btnBox12.Text = ""
                        End If
                    Case "chkItem13"
                        If gBoxThirteenRequired Then
                            thisCheckBox.Checked = True
                            Me.txtItem13.Visible = True
                            Me.txtItem13.ReadOnly = True
                            Me.txtItem13.Tag = "VALIDATE"
                            Me.btnBox13.Text = "X"
                            Me.CheckForBoxThirteenSituation()
                        Else
                            thisCheckBox.Checked = False
                            Me.txtItem13.Visible = False
                            Me.txtItem13.ReadOnly = False
                            Me.txtItem13.Tag = ""
                            Me.btnBox13.Text = ""
                        End If

                    Case "chkItem14"

                        If Me.Item14Forced Then
                            thisCheckBox.Checked = True
                            Me.btnBox14.Text = "X"
                            Me.txtItem14.ReadOnly = True
                        End If

                        If thisCheckBox.CheckState = CheckState.Checked Then
                            If Me.BoxFourteenVerbiageRCPS <> "" Then
                                Me.txtItem14.Text = BoxFourteenVerbiageRCPS
                            ElseIf BoxFourteenVerbiageTrackZone <> "" Then
                                Me.txtItem14.Visible = True
                                Me.txtItem14.Text = BoxFourteenVerbiageTrackZone
                                Me.txtItem14.ReadOnly = True
                                Item14Forced = True
                            Else
                                Me.txtItem14.Text = "   "
                            End If
                            Me.txtItem14.Tag = "VALIDATE"
                            Me.txtItem14.Visible = True
                            Me.txtItem14.Focus()
                            Me.btnBox14.Text = "X"
                        Else
                            Me.txtItem14.Text = ""
                            Me.txtItem14.Visible = False
                            Me.btnBox14.Text = ""
                        End If

                End Select

                If thisCheckBox.CheckState = CheckState.Checked Then
                    thisCheckBox.AccessibleDescription = "CHECKED"
                    'thisCheckBox.Tag = "VALIDATE"
                Else
                    thisCheckBox.AccessibleDescription = ""
                    'thisCheckBox.Tag = ""
                End If

                AddCheckBoxesToItemBox()

            Else
                'if the check box marked then keep it marked after the REPEAT button was selected
                If thisCheckBox.AccessibleDescription = "CHECKED" Then
                    thisCheckBox.Checked = True
                End If
            End If

            Me.CheckToEnableReadButton()

        Catch ex As Exception
            SystemException(ex.ToString)
            ClearSystemVariables()
            Me.CloseForm()
        End Try
    End Sub

    Private Sub AddCheckBoxesToItemBox()

        Try
            Dim BoxCount As Integer
            Dim LeftPoint As Integer = 215
            Dim chkItem As CheckBox
            Dim boxItem As TextBox
            For Each boxItem In Me.ChkItemBoxList
                boxItem.Visible = False
                boxItem.Text = ""
                boxItem.Left = LeftPoint
            Next

            For Each chkItem In Me.CheckItemArrayList
                If chkItem.CheckState = CheckState.Checked Then
                    BoxCount = BoxCount + 1
                    Dim txtBox As TextBox = Me.GetBoxItem(chkItem.Name)
                    txtBox.Left = LeftPoint
                    txtBox.Text = chkItem.Name.Replace("chkItem", "")
                    txtBox.Visible = True
                    LeftPoint = LeftPoint + txtBox.Width + 5
                End If
            Next
            Me.txtNumOfBoxes.Text = BoxCount

        Catch ex As Exception
            SystemException(ex.ToString)
            ClearSystemVariables()
            Me.Dispose()
        End Try

    End Sub

