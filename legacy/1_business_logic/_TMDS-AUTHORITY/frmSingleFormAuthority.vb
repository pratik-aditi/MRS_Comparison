                    Me.lvVerbiage.Items.Add(Box2Line2)
                    Me.lvVerbiage.Items.Add("                    TO " & Me.txtItem2To2.Text.ToUpper)
                    Me.lvVerbiage.Items.Add("                    ON " & Me.txtItem2Track2.Text.ToUpper)
