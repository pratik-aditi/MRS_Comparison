                            frmMessageBox.SetMessage(MessageList, "LEAVE SWITCH OPEN DIALOG", True, LaunchPoint)
                            frmMessageBox.ShowDialog()
                            If frmMessageBox.FormFeedBack = 6 Then
                                If Not sw.ControlledReverse Then
                                    sw.ControlSwitch()
                                    sw.BoxThirteenControlled = True
                                    If Not sw.UpdateProtectOpenSwitch(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                        If Not sw.ControlledReverse Then
                                            sw.ControlSwitch()
                                            sw.ControlBrotherSwitches(sw.Index, sw.ControlledReverse)
