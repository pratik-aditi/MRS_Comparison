    Dim UnknownSwitchOnLeft As Boolean = False

    Private Function ValidateTrackZonesInRoute(ByVal CompList As ArrayList, ByVal TheFirstWarrantType As String) As ArrayList
        BoxFourteenItemsTrackZone = New ArrayList
        Try
            OccupiedZoneList = GetOccupiedZones(CompList)
            OccupiedZoneListBeforeIssue = OccupiedZoneList.Clone
            If OccupiedZoneList.Count > 0 Then
                Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm
                frmMessageBox.TrackZoneCheck = True
                frmMessageBox.TrackZoneList = OccupiedZoneList.Clone
                frmMessageBox.TrackZoneOverrideList = SelectedAllZoneList
                frmMessageBox.CurrentComponentList = CompList

                MessageList.Add("THE FOLLOWING ZONES INDICATE OCCUPANCIES.")
                MessageList.Add("SELECT TO REMOVE ANY ZONES THAT ARE CURRENTLY")
                MessageList.Add("OCCUPIED BY THE TRAIN BEING ISSUED THIS AUTHORITY.")
                MessageList.Add("")

                frmMessageBox.SetMessage(MessageList, "TIWS ZONE VERIFICATION", False, LaunchPoint, "DONE")
                frmMessageBox.ShowDialog()
                MessageList.Clear()
                MessageList = Nothing
                frmMessageBox.Dispose()
                frmMessageBox = Nothing

                For Each tz As TrackZone In SelectedAllZoneList
                    If Not TrackZoneIdentifiedList.Contains(tz) Then
                        TrackZoneIdentifiedList.Add(tz)
                    End If
                Next

                Dim ValidatedCompList As New ArrayList
                SelectedZoneList = New ArrayList
                SelectedFoulingZoneList = New ArrayList
                For Each tz As TrackZone In SelectedAllZoneList
                    If tz.ZoneName.ToUpper.Contains("ZONE") Then
                        SelectedZoneList.Add(tz)
                        If Not Me.myTrainTIWSOccupacny.Contains(tz) Then Me.myTrainTIWSOccupacny.Add(tz)
                    Else
                        SelectedFoulingZoneList.Add(tz)
                    End If
                Next

                OccupiedZoneList = GetOccupiedZones(CompList, SelectedAllZoneList)



                If TheFirstWarrantType = "ItemTwoToTrain" OrElse TheFirstWarrantType = "ItemTwoToSameTrain" Then
                    ValidatedCompList = ValidateBox2TrackZone(CompList)
                Else
                    ValidatedCompList = ValidateBox4TrackZone(CompList)
                End If
                Return ValidatedCompList
            Else
                Return CompList
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return Nothing
    End Function

#Region " BOX2 "

    Private Function ValidateBox2TrackZone(ByVal CompList As ArrayList) As ArrayList
        Dim clstiwsrules As New clsTIWSRulesCheck
        Try
            Dim HasVoidAuthority As Boolean = False
            Dim TrackZoneBehindMyTrain As New ArrayList
            For Each vcomp As Object In CompList
                If vcomp.GetType.ToString = gTrackComponentName Then
                    Dim trk As Track = CType(vcomp, Track)
                    If trk.TrackAuthorities.Count > 0 Then
                        'TrackZoneBehindMyTrain = GetZonesBehindTrainInAuthority_New(trk.TrackAuthorities(0)) ' GetZonesBehindTrainInAuthority(trk.TrackAuthorities(0))
                        TrackZoneBehindMyTrain = clstiwsrules.GetZoneNamesBehindTrainInAuthority(trk.TrackAuthorities(0))
                        HasVoidAuthority = True
                        Exit For
                    End If
                End If
            Next
            'GetZonesBehindTrainInAuthority


            Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(Mid(Me.IssueTo, 1, 10))
            Dim Comp As Object
            Dim AddCompToList As Boolean = True
            Dim ShowAlertForInvalidSelection As Boolean = False
            Dim CurrentZone As TrackZone = Nothing
            Dim SelectedZoneIdentified As Boolean = False
            Dim ValidatedCompList As New ArrayList
            Dim ValidatedZone As New ArrayList
            Dim ErrorMessage As String = String.Empty
            Dim LimitStartsInNonTIWS As Boolean = False
            Dim StopProcess As Boolean = False

            ZoneListIncollection = GetTrackZoneWithinCollection(CompList)

            If Not HasVoidAuthority Then ' THis Condtion was added based on BNSF-362. Not a Safe condition.... Kind of violates BOX2 FRA Rule. 
                If TrackZoneBehindMyTrain IsNot Nothing AndAlso SelectedZoneList IsNot Nothing Then
                    If TrackZoneBehindMyTrain.Count = 0 AndAlso SelectedZoneList.Count > 0 Then
                        Dim tmpMyTrackZoneList As New ArrayList
                        Dim SelectedZone As TrackZone = SelectedZoneList(0)
                        tmpMyTrackZoneList = GetAllZonesFromCompList(CompList)
                        Dim S As String = ""
                        For Each S In tmpMyTrackZoneList
                            If S = SelectedZone.ZoneName Then
                                Exit For
                            Else
                                If Not TrackZoneBehindMyTrain.Contains(S) Then TrackZoneBehindMyTrain.Add(S)
                            End If
                        Next
                    End If
                End If
            End If


            Dim UnSelectedZonelist As New ArrayList
            For Each Comp In CompList
                If Comp.GetType.ToString = gTrackComponentName Then
                    Dim trk As Track = CType(Comp, Track)
                    If trk.AuthorityType = "TWC" AndAlso Not trk.TrackZoneIntegrityMonitoringEnabled Then
                        LimitStartsInNonTIWS = True
                    End If
                    If trk.TrackZoneIntegrityMonitoringEnabled Then
                        CurrentZone = trk.TrackZoneReference
                        If trk.Occuppied AndAlso Not trk.FoulingTrackSPMS Then
                            If OccupiedZoneList.Count = 1 Then
                                If trk.TrackZoneReference Is gBeginTrackSelect.TrackZoneReference Then
                                    If Not SelectedZoneList.Contains(trk.TrackZoneReference) Then
                                        If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                                    End If
                                End If
                                If ValidatedZone.Count > 0 Then
                                    If HasVoidAuthority Then
                                        If Not SelectedZoneList.Contains(trk.TrackZoneReference) AndAlso Not trk.TrackZoneReference Is gBeginTrackSelect.TrackZoneReference Then
                                            If Not IsNothing(TrackZoneBehindMyTrain) AndAlso TrackZoneBehindMyTrain.Contains(trk.TrackZoneReference.ZoneName.ToUpper) Then
                                                If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                                            Else
                                                AddCompToList = False
                                                Exit For
                                            End If
                                        End If
                                    Else
                                        If Not SelectedZoneList.Contains(trk.TrackZoneReference) AndAlso Not ValidatedZone.Contains(trk.TrackZoneReference) Then
                                            AddCompToList = False
                                            Exit For
                                        End If
                                    End If
                                End If

                                ''limits starts from non-tiws and enters into tiws section. one zone is down and not identified as train.
                                ''In this case limits will be shortened.
                                If SelectedZoneList.Count = 0 AndAlso LimitStartsInNonTIWS Then
                                    AddCompToList = False
                                    Exit For
                                End If
                            ElseIf OccupiedZoneList.Count > 1 Then
                                If SelectedZoneList.Count = 0 Then
                                    If trk.TrackZoneReference Is gBeginTrackSelect.TrackZoneReference Then
                                        If Not UnSelectedZonelist.Contains(trk.TrackZoneReference) Then
                                            If trk.TrackZoneReference.ZoneName.ToUpper.Contains("ZONE") Then
                                                UnSelectedZonelist.Add(trk.TrackZoneReference)
                                            End If
                                        End If
                                        If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                                    Else
                                        Dim ifAnyAdjacentZoneSelected As Boolean = False
                                        Dim AdjacentOccupiedZones As New ArrayList
                                        AdjacentOccupiedZones = GetAllContinuouslyOccupiedTrackZones(trk.TrackZoneReference, SelectedZoneList, SelectedFoulingZoneList)
                                        If AdjacentOccupiedZones.Count > 0 Then
                                            For Each adjZn As TrackZone In AdjacentOccupiedZones
                                                If UnSelectedZonelist.Contains(adjZn) Then
                                                    If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                                                    ifAnyAdjacentZoneSelected = True
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                        If Not ifAnyAdjacentZoneSelected Then
                                            If Not IsNothing(TrackZoneBehindMyTrain) AndAlso TrackZoneBehindMyTrain.Contains(trk.TrackZoneReference) Then
                                            Else
                                                Exit For
                                            End If
                                        End If
                                    End If
                                Else
                                    If SelectedZoneList.Contains(trk.TrackZoneReference) Then
                                        If SelectedZonesOutOfSequence(ZoneListIncollection, SelectedZoneList, trk.TrackZoneReference.ZoneName) Then
                                            StopProcess = True
                                            ShowAlertForInvalidSelection = True
                                            Exit For
                                        End If
                                        SelectedZoneIdentified = True
                                    Else
                                        If Not IsNothing(gBeginTrackSelect.TrackZoneReference) AndAlso trk.TrackZoneReference Is gBeginTrackSelect.TrackZoneReference Then
                                        Else
                                            Dim ifAnyAdjacentZoneSelected As Boolean = False
                                            Dim AdjacentOccupiedZones As New ArrayList
                                            AdjacentOccupiedZones = GetAllContinuouslyOccupiedTrackZones(trk.TrackZoneReference, SelectedZoneList, SelectedFoulingZoneList)
                                            If AdjacentOccupiedZones.Count > 0 Then
                                                For Each adjZn As TrackZone In AdjacentOccupiedZones
                                                    If SelectedZoneList.Contains(adjZn) Then
                                                        ifAnyAdjacentZoneSelected = True
                                                        'if zn1 is down and tw process started. while pop up is open  train moved to zn2 and zn1 picks up and
                                                        'but DS identifies zn1 as train on the popup
                                                        SelectedZoneIdentified = True
                                                        Exit For
                                                    End If
                                                Next
                                            End If
                                            If Not ifAnyAdjacentZoneSelected Then
                                                If Not IsNothing(TrackZoneBehindMyTrain) AndAlso TrackZoneBehindMyTrain.Contains(trk.TrackZoneReference.ZoneName.ToUpper) Then
                                                ElseIf trk.TrackAuthorities.Count > 0 Then
                                                    ''while issuing TW, if first zone is down and identified as train, while in middle of process if the first zone comes up and
                                                    ''second zone goes down, and comes up and thrid zone goes down and if the train is sitting in Zone3 we can continue to allow 
                                                    ''to issue and not shorten the limits if there was already an authority exists for that train.
                                                    Dim oktoproceed As Boolean = False
                                                    Dim auth As SFAuthority
                                                    For Each auth In trk.TrackAuthorities
                                                        If trk.TrackZoneReference.OccupiedTrainAuthUIDList.Contains(auth.AuthorityUID) Then
                                                            oktoproceed = True
                                                            Exit For
                                                        End If
                                                    Next
                                                    If Not oktoproceed Then
                                                        Exit For
                                                    End If
                                                Else
                                                    Exit For
                                                End If
                                            End If

                                            ''if beginning zone(zn1) is not down and two other zones(zn2,zn3) are down. if only zn3 is identified as train then limits should be shortened.
                                            If Not SelectedZoneIdentified Then
                                                If ifAnyAdjacentZoneSelected Then
                                                    Exit For
                                                End If
                                            End If

                                            If SelectedZoneIdentified Then
                                                If ifAnyAdjacentZoneSelected Then
                                                    ''if more than one zone are down in sequential order while initiating TW and if some zone are identified as train and some are not then non identified zones needs to be added to box14.
                                                    ''if one zone is down while initiating TW and then while in middle of the process, next zones goes down in sequential order then non identified zones should not be added to box14
                                                    If OccupiedZoneListBeforeIssue.Contains(trk.TrackZoneReference) Then
                                                        If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                                                    End If
                                                Else
                                                    If Not box14Comp.Contains(trk) Then box14Comp.Add(trk)
                                                End If
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        ElseIf trk.Occuppied AndAlso trk.FoulingTrackSPMS Then
                            'This has been added to shorten the limits if fouling occupancy exists.
                            'if zone is not identified and if parent is also not occupied then shorten the limits 
                            'Also remove the tracks which may have been already added and include comps upto before fouling track
                            Dim SkipFoulingCheck As Boolean = False
                            If Not IsNothing(TrackZoneBehindMyTrain) AndAlso TrackZoneBehindMyTrain.Contains(trk.TrackZoneReference.ZoneName) Then
                                SkipFoulingCheck = True
                            End If
                            'If SkipFoulingCheck Then 'this CONDITION WAS ADDED AS PART OF 362... SINCE FOULING TRACK'S ZONE ISNOT OCCUPIED AND THERE IS ZONE IDENTIFIED AS TRAIN TOO....
                            ' '' ''If Not IsNothing(SelectedFoulingZoneList) AndAlso SelectedFoulingZoneList.Count > 0 AndAlso SelectedZoneList IsNot Nothing AndAlso SelectedZoneList.Count > 0 Then
                            ' '' ''    Dim thisFoulingTracksZone As TrackZone = Nothing
                            ' '' ''    If trk.TrackZoneReference IsNot Nothing Then thisFoulingTracksZone = trk.TrackZoneReference
                            ' '' ''    If thisFoulingTracksZone IsNot Nothing Then
                            ' '' ''        If Not SelectedZoneList.Contains(thisFoulingTracksZone) Then
                            ' '' ''            StopProcess = True
                            ' '' ''            ShowAlertForInvalidSelection = True
                            ' '' ''            Exit For
                            ' '' ''        End If
                            ' '' ''    End If
                            ' '' ''End If
                            'End If
                            If Not ValidatFoulingZoneLimits(trk, SelectedFoulingZoneList, SelectedZoneList) Then
                                StopProcess = True
                                ShowAlertForInvalidSelection = True
                                Exit For
                            End If
                            If Not SkipFoulingCheck Then
                                SkipFoulingCheck = IsOkToSkipFoulingZoneLimits(trk, SelectedFoulingZoneList, SelectedZoneList)
                            End If

                            'Check if this track is behind the SelectedFTrack
                            Dim BehindFoulingTrackSwitchList As New ArrayList
                            Dim mySwitch As Switch = Nothing
                            BehindFoulingTrackSwitchList = GetFoulingTrackBehindSwitchList(CompList, SelectedFoulingZoneList)
                            mySwitch = FindFoulingTrackSwitch(trk)
                            If mySwitch IsNot Nothing AndAlso BehindFoulingTrackSwitchList IsNot Nothing AndAlso BehindFoulingTrackSwitchList.Count > 0 Then
                                If BehindFoulingTrackSwitchList.Contains(mySwitch) Then SkipFoulingCheck = True
                            End If


                            If Not SkipFoulingCheck Then
                                If Not IsNothing(SelectedFoulingZoneList) AndAlso Not SelectedFoulingZoneList.Contains(trk.TrackZoneReference) Then
                                    Dim FoulTrackParentZone As TrackZone = Nothing
                                    Dim FoulingTrackSwitch As Switch = Nothing
                                    FoulTrackParentZone = GetFoulingTrkParentZone(trk, Nothing, Nothing, FoulingTrackSwitch)
                                    If Not IsNothing(FoulTrackParentZone) Then
                                        If Not FoulTrackParentZone.IsZownOccuppied Then
                                            If (Not IsNothing(gBeginTrackSelect.OsComponentCollection) AndAlso gBeginTrackSelect.OsComponentCollection.Contains(trk)) Then
                                            Else
                                                Dim fcomplist As New ArrayList
                                                fcomplist = GetFoulingZoneConnectedTracks(trk.TrackZoneReference)
                                                If fcomplist IsNot Nothing AndAlso fcomplist.Count > 0 Then
                                                    Dim tmpcomp As Object
                                                    For Each tmpcomp In fcomplist
                                                        ValidatedCompList.Remove(tmpcomp)
                                                    Next
                                                End If
                                                Exit For
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        ElseIf Not trk.Occuppied Then
                        End If

                    End If
                ElseIf Comp.GetType.ToString = gSwitchComponentName Then
                    ''Commenting this Function Based of BNSF-341
                    'Dim AltTrack As Track = Nothing
                    'Dim SW As Switch = Nothing
                    'SW = TryCast(Comp, Switch)
                    'If SW IsNot Nothing Then
                    '    If SW.RightAltLink > 0 Then AltTrack = FindCompFromGUID(SW.RightAltLink)
                    '    If SW.LeftAltLink > 0 Then AltTrack = FindCompFromGUID(SW.LeftAltLink)
                    '    If AltTrack IsNot Nothing AndAlso AltTrack.Occuppied AndAlso AltTrack.FoulingTrackSPMS Then
                    '        Dim SkipFoulingCheck As Boolean = False
                    '        If Not IsNothing(TrackZoneBehindMyTrain) AndAlso TrackZoneBehindMyTrain.Contains(AltTrack.TrackZoneReference.ZoneName) Then
                    '            SkipFoulingCheck = True
                    '        End If
                    '        If Not ValidatFoulingZoneLimits(AltTrack, SelectedFoulingZoneList, SelectedZoneList) Then
                    '            StopProcess = True
                    '            ShowAlertForInvalidSelection = True
                    '            Exit For
                    '        End If
                    '        If Not SkipFoulingCheck Then
                    '            SkipFoulingCheck = IsOkToSkipFoulingZoneLimits(AltTrack, SelectedFoulingZoneList, SelectedZoneList)
                    '        End If
                    '        If Not SkipFoulingCheck Then
                    '            If Not IsNothing(SelectedFoulingZoneList) AndAlso Not SelectedFoulingZoneList.Contains(AltTrack.TrackZoneReference) Then
                    '                Dim FoulTrackParentZone As TrackZone = Nothing
                    '                Dim FoulingTrackSwitch As Switch = Nothing
                    '                FoulTrackParentZone = GetFoulingTrkParentZone(AltTrack, Nothing, Nothing, FoulingTrackSwitch)
                    '                If Not IsNothing(FoulTrackParentZone) Then
                    '                    If Not FoulTrackParentZone.IsZownOccuppied Then
                    '                        If (Not IsNothing(gBeginTrackSelect.OsComponentCollection) AndAlso gBeginTrackSelect.OsComponentCollection.Contains(AltTrack)) Then
                    '                        Else
                    '                            Dim fcomplist As New ArrayList
                    '                            fcomplist = GetFoulingZoneConnectedTracks(AltTrack.TrackZoneReference, FoulingTrackSwitch)
                    '                            If fcomplist IsNot Nothing AndAlso fcomplist.Count > 0 Then
                    '                                Dim tmpcomp As Object
                    '                                For Each tmpcomp In fcomplist
                    '                                    ValidatedCompList.Remove(tmpcomp)
                    '                                Next
                    '                            End If
                    '                            Exit For
                    '                        End If
                    '                    End If
                    '                End If
                    '            End If
                    '        End If
                    '    End If
                    'End If
                End If

                If AddCompToList Then
                    If Not IsNothing(CurrentZone) Then
                        If CurrentZone.ZoneName.ToUpper.Contains("ZONE") Then
                            ValidatedZone.Add(CurrentZone)
                        End If
                    End If

                    If Not ValidatedCompList.Contains(Comp) Then
                        ValidatedCompList.Add(Comp)
                    End If
                End If
            Next

            If ShowAlertForInvalidSelection Then
                ErrorMessage = "INVALID TRACK ZONE SEQUENCE DETECTED DURING ISSUANCE PROCESS! PLEASE RE-ISSUE THE AUTHORITY."
                MessageBox.Show(Me, ErrorMessage, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                If StopProcess Then
                    Return New ArrayList
                Else
                    Return Nothing
                End If
                'Return Nothing
            End If

            If ValidatedCompList.Count <> CompList.Count Then
                Me.PromptOnLimitsChangeFromTrackZone = True
            End If

            If ValidatedZone.Count > 0 Then
                For Each vzn As TrackZone In ValidatedZone
                    If vzn.ZoneName.ToUpper.Contains("ZONE") Then
                        If OccupiedZoneList.Contains(vzn) And Not SelectedZoneList.Contains(vzn) Then
                            TrackZoneIdentifiedList.Add(vzn)
                        End If
                    End If
                Next
            End If

            '************************** BEGIN CHECK FOR FOULING TRACK OCCUPANY OVER VALIDATED COMPONENTS
            Dim FoulingValidatedZone As New ArrayList
            For Each fcomp As Object In ValidatedCompList
                If fcomp.GetType.ToString = gTrackComponentName Then
                    Dim trk As Track = CType(fcomp, Track)
                    If trk.TrackZoneIntegrityMonitoringEnabled Then
                        If trk.Occuppied AndAlso trk.FoulingTrackSPMS Then
                            Dim FoulTrackParentZone As TrackZone = Nothing
                            FoulTrackParentZone = GetFoulingTrkParentZone(trk)
                            If Not SelectedFoulingZoneList.Contains(trk.TrackZoneReference) Then
                                If Not FoulingBox14Comp.Contains(fcomp) Then FoulingBox14Comp.Add(fcomp)
                            End If
                            If Not FoulingValidatedZone.Contains(trk.TrackZoneReference) Then FoulingValidatedZone.Add(trk.TrackZoneReference)
                        End If
                    End If
                End If
            Next
            If FoulingValidatedZone.Count > 0 Then
                For Each fvzn As TrackZone In FoulingValidatedZone
                    TrackZoneIdentifiedList.Add(fvzn)
                Next
            End If
            '************************** END CHECK FOR FOULING TRACK OCCUPANY OVER VALIDATED COMPONENTS
            ValidateSwitchPointsInRoute(ValidatedCompList, TrackZoneBehindMyTrain) ' RMT 370
            ValidatedCompListForBox14 = ValidatedCompList.Clone
            Return ValidatedCompList
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return Nothing
    End Function

    Private Function GetFoulingTrackBehindSwitchList(CompList As ArrayList, FoulingComps As ArrayList) As ArrayList
        Dim FTrack As Track = Nothing
        Dim Comp As Object = Nothing
        Dim FoulingTrackBehindSwitchList As New ArrayList
        Try
            If FoulingComps Is Nothing Then Return New ArrayList
            If FoulingComps.Count = 0 Then Return New ArrayList
            If SelectedFoulingZoneList Is Nothing Then Return New ArrayList
            If SelectedFoulingZoneList.Count = 0 Then Return New ArrayList
            Dim tz As TrackZone
            For Each tz In SelectedFoulingZoneList
                If FTrack IsNot Nothing Then Exit For
                If tz IsNot Nothing AndAlso tz.TrackList IsNot Nothing AndAlso tz.TrackList.Count > 0 Then
                    Dim trk As Track
                    For Each trk In tz.TrackList
                        If trk IsNot Nothing AndAlso trk.GetType.ToString = gTrackComponentName Then
                            If trk.Occuppied AndAlso trk.FoulingTrackSPMS Then
                                FTrack = trk
                                Exit For
                            End If
                        End If
                    Next
                End If
            Next



            If FTrack Is Nothing Then Return New ArrayList
            Dim FTracksw As Switch = Nothing ' TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(bcomp)
            Dim Sw As Switch = Nothing
            Dim tmpSwitchList As New ArrayList
            tmpSwitchList = TMDS.SystemUtilities.FetchData.FindSwitchesFromOSList(FTrack)
            If tmpSwitchList IsNot Nothing AndAlso tmpSwitchList.Count > 0 Then
                Dim OSW As Switch
                For Each OSW In tmpSwitchList
                    If OSW IsNot Nothing Then
                        Dim SwIdentified As Boolean = False
                        If OSW.LeftLink = FTrack.GUID Then
                            SwIdentified = True
                        ElseIf OSW.LeftAltLink = FTrack.GUID Then
                            SwIdentified = True
                        ElseIf OSW.RightLink = FTrack.GUID Then
                            SwIdentified = True
                        ElseIf OSW.RightAltLink = FTrack.GUID Then
                            SwIdentified = True
                        End If
                        If SwIdentified Then
                            FTracksw = OSW
                            Exit For
                        End If
                    End If
                Next
                If Not IsWorkAuthority AndAlso tmpSwitchList.Count > 1 AndAlso FTracksw IsNot Nothing Then
                    Select Case gSearchDirection
                        Case "LEFT"



                    End Select
                End If
            End If

            If FTracksw Is Nothing Then Return New ArrayList

            For Each Comp In CompList
                If Comp.GetType.ToString = gSwitchComponentName Then
                    If FTracksw Is Comp Then
                        Return FoulingTrackBehindSwitchList
                    Else
                        If Not FoulingTrackBehindSwitchList.Contains(Comp) Then FoulingTrackBehindSwitchList.Add(Comp)
                    End If
                End If
            Next
            Return FoulingTrackBehindSwitchList


        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
        Return New ArrayList
    End Function

    Public Function CreateBox14VerbiageForBox2(VCompList As ArrayList) As Boolean
        Try
            Dim tmpbox14Comp As New ArrayList
            Dim tmpFoulingBox14Comp As New ArrayList

            Dim comp As Object
            For Each comp In box14Comp
                If VCompList.Contains(comp) Then
                    tmpbox14Comp.Add(comp)
                End If
            Next
            box14Comp = tmpbox14Comp.Clone

            For Each comp In FoulingBox14Comp
                If VCompList.Contains(comp) Then
                    tmpFoulingBox14Comp.Add(comp)
                End If
            Next
            FoulingBox14Comp = tmpFoulingBox14Comp.Clone
            Dim FoulingTrackBehindSwitchList As New ArrayList
            FoulingTrackBehindSwitchList = GetFoulingTrackBehindSwitchList(VCompList, tmpFoulingBox14Comp)
            '************************** BEGIN BUILD BOX14 LIMITS
            Dim Box14VerbiageLength As Integer = 0
            Dim box14from As String = String.Empty
            Dim box14to As String = String.Empty
            Dim Box14Text As String = String.Empty
            If box14Comp.Count = 0 And SelectedZoneList.Count = 0 Then
                If ZoneListIncollection(0).Zonedown Then
                    For Each vcomp As Object In ZoneListIncollection(0).ZoneTrackList
                        If ValidatedCompListForBox14.Contains(vcomp) Then
                            If Not box14Comp.Contains(vcomp) Then box14Comp.Add(vcomp)
                        End If
                    Next
                End If
            End If

            If box14Comp.Count > 0 Then
                Dim PrevSeq As Integer = -1
                Dim currSeq As Integer = -1
                Dim znadded As New ArrayList
                For Each bcomp As Track In box14Comp
                    If Not znadded.Contains(bcomp.TrackZoneReference) Then
                        currSeq = GetZonesequence(ZoneListIncollection, bcomp.TrackZoneReference.ZoneName)
                        If PrevSeq <> -1 AndAlso PrevSeq + 1 <> currSeq Then
                            Dim strText As String = "(" & box14from & " TO " & box14to & ")" & Chr(10)
                            Box14Text = Box14Text & strText
                            BoxFourteenItemsTrackZone.Add(strText)
                            box14from = String.Empty
                            box14to = String.Empty
                        End If
                        PrevSeq = currSeq
                        znadded.Add(bcomp.TrackZoneReference)
                    End If
                    If box14from = String.Empty Then
                        If gSearchDirection = "RIGHT" Then
                            box14from = bcomp.LeftLimitName
                        Else
                            box14from = bcomp.RightLimitName
                        End If
                    End If
                    If gSearchDirection = "RIGHT" Then
                        box14to = bcomp.RightLimitName
                    Else
                        box14to = bcomp.LeftLimitName
                    End If
                Next

                If box14from.Trim <> String.Empty And box14to.Trim <> String.Empty Then
                    Dim strText As String = "(" & box14from & " TO " & box14to & ")" & Chr(10)
                    Box14Text = Box14Text & strText
                    BoxFourteenItemsTrackZone.Add(strText)
                End If
                If Box14Text.Trim <> String.Empty Then
                    Dim strText As String = "TID " & Box14Text
                    BoxFourteenVerbiageTrackZone = strText
                End If
                Box14VerbiageLength = Box14VerbiageLength + Len(BoxFourteenVerbiageTrackZone.Trim)
            End If

            Dim FoulingBox14Text As String = String.Empty

            If FoulingBox14Comp.Count > 0 Then
                For Each bcomp As Track In FoulingBox14Comp
                    If bcomp.FoulingTrackSPMS Then
                        'BNSF RMT 341
                        Dim sw As Switch = Nothing ' TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(bcomp)
                        Dim tmpSwitchList As New ArrayList
                        tmpSwitchList = TMDS.SystemUtilities.FetchData.FindSwitchesFromOSList(bcomp)
                        If tmpSwitchList IsNot Nothing AndAlso tmpSwitchList.Count > 1 Then
                            Dim OSW As Switch
                            For Each OSW In tmpSwitchList
                                If OSW IsNot Nothing Then
                                    Dim SwIdentified As Boolean = False
                                    If OSW.LeftLink = bcomp.GUID Then
                                        SwIdentified = True
                                    ElseIf OSW.LeftAltLink = bcomp.GUID Then
                                        SwIdentified = True
                                    ElseIf OSW.RightLink = bcomp.GUID Then
                                        SwIdentified = True
                                    ElseIf OSW.RightAltLink = bcomp.GUID Then
                                        SwIdentified = True
                                    End If
                                    If SwIdentified Then
                                        sw = OSW
                                        Exit For
                                    End If
                                End If
                            Next
                        End If
                        If sw Is Nothing Then
                            sw = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(bcomp)
                        End If

                        Dim OverrideSwInBox14 As Boolean = False

                        If FoulingTrackBehindSwitchList IsNot Nothing AndAlso FoulingTrackBehindSwitchList.Count > 0 Then
                            If FoulingTrackBehindSwitchList.Contains(sw) Then
                                OverrideSwInBox14 = True
                            End If
                        End If

                        'Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(bcomp)
                        If Not OverrideSwInBox14 Then
                            If IsNothing(sw) Then
                                Dim strText As String = "(" & bcomp.TrackZoneReference.ZoneName & ")" & Chr(10)
                                FoulingBox14Text = FoulingBox14Text & strText
                                BoxFourteenItemsTrackZone.Add(strText)
                            Else
                                Dim strText As String = "(" & sw.Name & ")" & Chr(10)
                                FoulingBox14Text = FoulingBox14Text & strText
                                BoxFourteenItemsTrackZone.Add(strText)
                            End If
                        End If
                    End If
                Next
                If FoulingBox14Text.Trim <> String.Empty Then
                    If BoxFourteenVerbiageTrackZone.Trim = String.Empty Then
                        Dim strText As String = "TID " & FoulingBox14Text
                        BoxFourteenVerbiageTrackZone = strText
                    Else
                        BoxFourteenVerbiageTrackZone = BoxFourteenVerbiageTrackZone & vbCrLf & FoulingBox14Text
                    End If
                    Box14VerbiageLength = Box14VerbiageLength + Len(FoulingBox14Text)
                End If
            End If

            If BoxFourteenVerbiageTrackZone.Trim <> String.Empty Then
                gBox14Required = True
                Item14Forced = True
                If Box14VerbiageLength > 220 Then
                    Dim LaunchPoint1 As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                    Dim frmMessageBox1 As frmMessageBox
                    Dim MessageList1 As New ArrayList()
                    frmMessageBox1 = New frmMessageBox()
                    frmMessageBox1.Owner = gBeginTrackSelect.CurrentDrawingForm
                    MessageList1.Add("THE VERBIAGE FOR ZONE PROTECTION EXCEEDS")
                    MessageList1.Add("THE TEXT LENGTH OF BOX 14. PLEASE REDUCE THE LIMITS.")
                    MessageList1.Add("")
                    frmMessageBox1.SetMessage(MessageList1, "TIWS ZONE VERIFICATION", False, LaunchPoint1)

                    frmMessageBox1.ShowDialog()
                    MessageList1.Clear()
                    MessageList1 = Nothing
                    frmMessageBox1.Dispose()
                    frmMessageBox1 = Nothing
                    Return False
                End If
                Me.txtItem14.Text = BoxFourteenVerbiageTrackZone
                Me.txtItem14.ReadOnly = True
                chkItem14.Checked = True
            End If
            '************************** END BUILD BOX14 LIMITS
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return True
    End Function

