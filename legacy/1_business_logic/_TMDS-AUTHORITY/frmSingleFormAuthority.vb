    Public Function CheckTrainPTCStatus(ByVal trn As TrainID) As Boolean
        Dim rtnState As Boolean = True
        Try
            TMDS.NetworkMessages.PTCBOSAPIMessaging.SendLocomotiveRequestMessageStatus(trn, True)
            Dim Loco As MobileTracking.Locomotive = Me.FindLocomotive(trn)
            Dim StatusCheck As Boolean = True
            Me.btnCancel.Enabled = False
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()
            If Not Loco Is Nothing Then
                Loco.RequestedStatusReceived = False
            End If
            Do While StatusCheck
                If gPTCLinkDown Then
                    StatusCheck = False
                    rtnState = False
                    Exit Do
                End If
                If CancelPTCOperation Then
                    StatusCheck = False
                    rtnState = False
                    ' Exit Do
                End If
                If Loco Is Nothing Then
                    Loco = FindLocomotive(trn)
                    If Not Loco Is Nothing Then
                        If Loco.RequestedStatusReceived Then
                            StatusCheck = False
                            Loco.RequestedStatusReceived = False
                            If Loco.CutOutState = True Then
                                rtnState = False
                                Exit Do
                            End If
                        End If
                    End If
                Else
                    If Loco.RequestedStatusReceived Then
                        StatusCheck = False
                        Loco.RequestedStatusReceived = False
                        If Loco.CutOutState = True Then
                            rtnState = False
                            Exit Do
                        End If
                    End If
                End If
                Application.DoEvents()
                Threading.Thread.Sleep(100)
            Loop

        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        Finally
            btnCancel.Enabled = True
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
        Return rtnState
    End Function

    Public Function FindLocomotive(ByVal trn As TrainID) As MobileTracking.Locomotive
        Dim loco As MobileTracking.Locomotive
        Dim LocoFound As MobileTracking.Locomotive = Nothing
        Try
            For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                If (loco.Symbol = trn.Name) Or loco.LocomotiveID = trn.IdentifingUnit Then
                    Return loco
                    Exit For
                End If
            Next
            If IsNothing(LocoFound) Then
                Return Nothing
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        Finally
            loco = Nothing
        End Try
        Return Nothing
    End Function

    Public Function CheckToVerifyPositionOnReportIssue(Optional ByVal ReplacingAuthorityList As ArrayList = Nothing, Optional ByVal UseEndTrack As Boolean = False) As Boolean
        Try
            Dim loco As MobileTracking.Locomotive
            Dim LocoFound As MobileTracking.Locomotive = Nothing
            For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                If (loco.Symbol = Me.TrainSymbol) Or loco.LocomotiveID = Mid(Me.IssueTo, 1, 10) Then
                    LocoFound = loco
                    Exit For
                End If
            Next
            If IsNothing(LocoFound) Then
                Return True
            End If

            Dim trk As Track

            Select Case UseEndTrack
                Case True
                    trk = TMDS.SystemUtilities.FetchData.FindTrackCompFromMilePost(LocoFound.EndTrackGUID, LocoFound.EndMilePost, LocoFound.EndMilePostSuffix)
                Case Else
                    trk = TMDS.SystemUtilities.FetchData.FindTrackFromPTCBlockAndMilepost(LocoFound.BlockUID & "|" & LocoFound.MilePost)
            End Select

            If IsNothing(trk) Then
                Return True
            End If

            If Not IsNothing(ReplacingAuthorityList) Then
                If ReplacingAuthorityList.Contains(trk) Then
                    Return True
                End If
            End If

            Dim FormPosition As Point = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + trk.CurrentDrawingForm.Left + 100, 500)

            If Me.CompleteCompSelection.Contains(trk) Then
                Dim frmMessageBox1 As frmMessageBox
                Dim MessageList1 As New ArrayList()
                MessageList1.Add(Me.IssueTo & " IS CURRENTLY REPORTING ITS GPS POSITION AT MP " & LocoFound.MilePost)
                MessageList1.Add("WHICH IS IN THE TRACK SELECTION TO BE RELEASED.")
                MessageList1.Add("")
                MessageList1.Add("HAVE YOU VERBALLY VERIFIED THE TRAIN IS CLEAR OF THESE LIMITS?")

                frmMessageBox1 = New frmMessageBox()
                frmMessageBox1.SetMessage(MessageList1, "TRAIN POSITION CHECK", True, FormPosition)
                frmMessageBox1.ShowDialog()
                If frmMessageBox1.FormFeedBack <> 6 Then
                    frmMessageBox1.Dispose()
                    frmMessageBox1 = Nothing
                    Return False
                End If
            End If
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            Return True
        End Try
    End Function

    Private Sub GetDirectionOfExistingAuthority(ByVal ExistingSFAIssueTO As String, ByRef Direction As String)
        Try
            Dim TerrRunsSouthToNorth As Boolean = False
            If BoxFiveTrainSFA Is Nothing Then Exit Sub
            If BoxFiveTrainSFA.Count = 0 Then Exit Sub
            Dim SFADirection As String = ""
            Dim SFA As SFAuthority
            If Not CurrentSelectedTerritory.mySubdivision Is Nothing Then
                TerrRunsSouthToNorth = CurrentSelectedTerritory.mySubdivision.SubDirection
            End If

            For Each SFA In BoxFiveTrainSFA
                If SFA.IssueTo = ExistingSFAIssueTO Then
                    SFADirection = SFA.Direction
                    Select Case SFADirection.Trim.ToUpper
                        Case "LEFT"
                            If TerrRunsSouthToNorth Then
                                Direction = "S"
                            Else
                                Direction = "W"
                            End If
                        Case "RIGHT"
                            If TerrRunsSouthToNorth Then
                                Direction = "N"
                            Else
                                Direction = "E"
                            End If
                        Case Else
                            Direction = ""
                    End Select
                    Exit For
                End If
            Next


        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Sub



