                                    End If
                                End If

                            End If
                            Exit For
                        End If
                    Next
                Next
                If AuthDeleteList.Count > 0 Then
                    MultipleAuthoritiesFound = True
                End If

            End If



            If MultipleAuthoritiesFound Then
