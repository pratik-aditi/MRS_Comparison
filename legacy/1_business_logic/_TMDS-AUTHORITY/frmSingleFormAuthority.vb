                            Loop

                        End If
                    End If

                Next



                Dim AuthDeleteList As New ArrayList
                Dim sfa As SFAuthority
                For Each sfa In AuthList
                    Dim comp As Object
                    For Each comp In sfa.Components
                        If TrackList.Contains(comp) Then
