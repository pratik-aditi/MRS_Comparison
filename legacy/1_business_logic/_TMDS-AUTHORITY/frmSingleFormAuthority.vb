            Me.RailwayName = CurrentSelectedTerritory.RailRoadName
            Me.DispName = gCurrentUser.Initials


            'Me.txtSubdivision.Text = CurrentSelectedTerritory.Subdivision.ToUpper

            If Not IsNothing(Me.thisSubdivision) Then
                If Not Me.thisSubdivision.IncludeNameInAuthorities Then
                    Me.txtSubdivision.Visible = False
                    Me.lblSub.Visible = False
                End If
                Me.txtSubdivision.Text = Me.thisSubdivision.Name
            Else
                Me.txtSubdivision.Visible = False
                Me.lblSub.Visible = False
            End If
            Me.txtAtLocation.Text = BoxFrom1

            Dim LaunchPoint As Point
            Dim TopPoint As Int32
            Dim FirstTrack As Track = Nothing
            Try
                FirstTrack = Me.FirstTrackSelection.Item(0)
                If FirstTrack.Top + 300 < FirstTrack.CurrentDrawingForm.Height Then
                    TopPoint = FirstTrack.Top + 100
                Else
                    TopPoint = 150
                End If
                LaunchPoint = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + FirstTrack.CurrentDrawingForm.Width / 2 - 100, TopPoint)
            Catch
            End Try

            Select Case Me.CurrentTimeZone
                Case "EASTERN"
                    Me.lblTimeZone.Text = "EASTERN TIME ZONE"
                Case "MOUNTAIN"
                    Me.lblTimeZone.Text = "MOUNTAIN TIME ZONE"
                Case "PACIFIC"
                    Me.lblTimeZone.Text = "PACIFIC TIME ZONE"
                Case Else
                    Me.lblTimeZone.Text = "CENTRAL TIME ZONE"
            End Select

            Me.lblDispName.Text = "DISP: " & gCurrentUser.FirstName & " " & gCurrentUser.LastName
            Select Case Me.CurrentTimeZone
                Case "EASTERN"
                    Me.lblCreateTime.Text = Format(Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor)), "HH:mm")
                    Me.lblCreateDate.Text = Format(Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor)), "dddd, MMM d yyyy")

                Case "PACIFIC"
                    Dim TimeDiff As Integer = (-2 + gThisWorkstationTimeFactor)
                    Me.lblCreateTime.Text = Format(Now.AddHours(TimeDiff), "HH:mm")
                    Me.lblCreateDate.Text = Format(Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor)), "dddd, MMM d yyyy")

                Case "MOUNTAIN"
                    Me.lblCreateTime.Text = Format(Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor)), "HH:mm")
                    Me.lblCreateDate.Text = Format(Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor)), "dddd, MMM d yyyy")

                Case Else
                    Me.lblCreateTime.Text = Format(Now.AddHours(CDbl(gThisWorkstationTimeFactor)), "HH:mm")
                    Me.lblCreateDate.Text = Format(Now.Date, "dddd, MMM d yyyy")

            End Select

            Me.txtAuthGUID.Text = Me.AuthorityNumberString
            Me.txtAuthGUID.ReadOnly = True
            Me.txtDate.Text = Me.lblCreateDate.Text  'Format(Now.Date, "MMM d, yyyy")
            Me.txtDate.ReadOnly = True
            'Me.cbIssueTo.Text = "    "
            Me.txtDISP.Text = gCurrentUser.Initials
            Me.txtCOPIED.Text = gPersonCopying
            'Me.txtGO.Text = GetGeneralOrder(CurrentSelectedTerritory.Subdivision, TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
            'Me.txtCTO.Text = GetCTO(CurrentSelectedTerritory.Subdivision, TMDS.GlobalDeclarations.gDatabaseConnectionStatic)

            gSubdivisionDirection = FindSubDivisionDirection(CurrentSelectedTerritory.Subdivision)

            'Load the "ISSUE TO" type this warrant will be issued too (Train (EAST, WEST, WORK) or Man/Equipment)
            Select Case gSearchDirection
                Case "RIGHT"
                    If gSubdivisionDirection Then
                        DirectionOfWarrant = "NORTH"
                    Else
                        DirectionOfWarrant = "EAST"
                    End If
                Case "LEFT"
                    If gSubdivisionDirection Then
                        DirectionOfWarrant = "SOUTH"
                    Else
                        DirectionOfWarrant = "WEST"
                    End If
                Case Else
                    DirectionOfWarrant = "WORK"
            End Select


            If ConflictCheckNeeded Then
                Dim StringReplacement As String = ""
                Dim NewIssueTo As String = ""
                Dim strPosition As Integer

                PerformLoadPotentialVoidAuthorities = False

                'Load the "ISSUE TO" type this warrant will be issued too (Train (EAST, WEST, WORK) or Man/Equipment)
                Select Case FirstTypeOfWarrant
                    Case "ItemTwoToTrain"
                        gWarrantType = "ItemTwoToTrain"
                        If ForceBoxOne And Not gBoxOneRequired Then
                            If IsNothing(VoidedWarrant) Then
                                If gLaunchCreateItemTwoToTrain Then
                                    VoidedWarrant = FindAuthorityFromIssueTo(gBeginTrackSelect, gTrainMenuMiscSelectedTrainID.IdentifingUnit)
                                Else
                                    VoidedWarrant = gBeginTrackSelect.TrackAuthorities(0)
                                End If

                            End If
                            If Not CheckForNeedsRollUp(VoidedWarrant, LaunchPoint) Then
                                Exit Function
                            End If


                        End If
                        If ForceBoxOne Or gBoxOneRequired Then
                            If gSearchDirection <> VoidedWarrant.Direction And VoidedWarrant.AuthType1 = "ItemTwoToTrain" Then
                                Dim frmMessageBox As frmMessageBox
                                Dim MessageList As New ArrayList()
                                frmMessageBox = New frmMessageBox()
                                frmMessageBox.Owner = gBeginTrackSelect.CurrentDrawingForm

                                MessageList.Add("CHANGING THE DIRECTION OF AN ITEM TWO")
                                MessageList.Add("TRAIN AUTHORITY IS NOT ALLOWED!")
                                MessageList.Add("")
                                frmMessageBox.SetMessage(MessageList, "DIRECTION CHECK", False, LaunchPoint)
                                frmMessageBox.ShowDialog()
                                MessageList.Clear()
                                MessageList = Nothing
                                frmMessageBox.Dispose()
                                frmMessageBox = Nothing
                                Exit Function
                            End If


                            ItemOneAuthorityToBeReplaced = VoidedWarrant
                            gBoxOneRequired = True
                            BoxEightCheckToRemoveRequirement()
                            CheckForBoxFourSixEightMOWInABS(VoidedWarrant.IssueTo)

                            Me.cbIssueTo.Text = VoidedWarrant.IssueTo
                            Me.cbIssueTo.Enabled = False
                            Me.IssueTo = Me.cbIssueTo.Text

                            Me.LoadPotentialVoidAuthorities()
                            Me.cmbItem1Void1.DropDownStyle = ComboBoxStyle.Simple
                            Me.cmbItem1Void1.Text = VoidedWarrant.AuthorityUID
                            Me.cmbItem1Void1.Enabled = False
                            Me.chkItem1.Checked = True

                            Me.CheckForForwardAuthorities()

                            Me.btnRepeat.Enabled = True
                            Me.ReInitVerbiage()
                            If Me.IssuedToTrain Then
                                LockRCPS()
                            End If
                            Me.ShowPendingLockRCPS()


                            If Me.OpposingAuthoritiesWithBoxFiveToResolve Then
                                If Not CheckForBoxFiveOpposingAuthoritiesInABS() Then
                                    'Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gBeginTrackSelect.CurrentDrawingForm.Width / 2 - 100, 150)
                                    Dim frmMessageBox As frmMessageBox
                                    Dim MessageList As New ArrayList()
