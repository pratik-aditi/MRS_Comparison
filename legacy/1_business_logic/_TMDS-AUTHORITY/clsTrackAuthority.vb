        Public Function RebuildPTCComponentsOnRollup() As Boolean
            Dim strPTCTxt() As String
            Dim S As String = ""
            Dim arrPTCtxt As New ArrayList
            Dim CurrentRollup() As String
            Dim NewstrPTCTxt As New StringBuilder

            Try
                If Not UpdateDatabaseWithPTCAuthoritySegments() Then
                    SystemEvent("PTC SEGMENTS SAVE ERROR(SFA): FAILED TO CREATE ROLLUP PTC SEGMENT FOR AUTHORITY: " & Me.AuthGUID)
                    Return False
                End If


                strPTCTxt = Me.PTCAuthorityText.Split("|")
                For Each S In strPTCTxt
                    arrPTCtxt.Add(S)
                Next

                If optEnableCPSpecificPTCOperations Then
                    'LeftLimits & "|" & RightLimits & "|" & Designation & ": " & CopiedBy & " @ " & RollUp & "|" & RollUpDirection & "|"
                    CurrentRollup = Me.CurrentRollUpEvent.Split("|")
                    Dim PTCRollupEvent As String = Space(5) & " ROLLUP EVENT FROM: "
                    If CurrentRollup.GetUpperBound(0) >= 2 Then
                        PTCRollupEvent = PTCRollupEvent & CurrentRollup(0)
                        PTCRollupEvent = PTCRollupEvent & " TO " & CurrentRollup(1)
                        arrPTCtxt.Add(String.Empty)
                        arrPTCtxt.Add(PTCRollupEvent)
                    End If
                ElseIf optEnableARRCSpecificOptions Then
                    arrPTCtxt.Add(String.Empty)
                    If Me.tmpPTCRollupAuthorityText IsNot Nothing AndAlso Me.tmpPTCRollupAuthorityText.Trim <> "" Then
                        arrPTCtxt.Add("---------------------------------------------")
                        arrPTCtxt.Add(Space(5) & Me.tmpPTCRollupAuthorityText)
                        Me.tmpPTCRollupAuthorityText = String.Empty
                    Else
                        arrPTCtxt.Add(Space(5) & Me.CurrentRollUpEvent)
                    End If
                Else
                    arrPTCtxt.Add(String.Empty)
                    arrPTCtxt.Add(Space(5) & Me.CurrentRollUpEvent)
                End If

                If arrPTCtxt IsNot Nothing AndAlso arrPTCtxt.Count > 0 Then
                    S = ""
                    For Each S In arrPTCtxt
                        With NewstrPTCTxt
                            .Append(S)
                            .Append("|")
                        End With
                    Next
                    Me.PTCAuthorityText = NewstrPTCTxt.ToString
                End If
                If Not Me.UpdatePTCTxt_Segment_Contigency_Compostion(arrPTCtxt, Me.PTCRestrictionText, Me.PTCContingencySegments) Then
                    SystemEvent("PTC VARIABLE SAVE ERROR(SFA): FAILED TO CREATE ROLLUP PTC TEXT, RESTRICTION SEGMENT, CONTIGENCY, COMPOSTION CRC FOR AUTHORITY: " & Me.AuthGUID)
                    Return False
                Else
                    SystemEvent("PTC VARIABLE SAVE ERROR(SFA): SUCCESS TO CREATE ROLLUP  PTC TEXT, RESTRICTION SEGMENT, CONTIGENCY, COMPOSTION CRC FOR AUTHORITY: " & Me.AuthGUID)
                    Return True
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                arrPTCtxt = Nothing
                NewstrPTCTxt = New StringBuilder
            End Try
        End Function

