                    Dim SendControlToField As Boolean
                    For Each comp In RollUpList
                        Me.ComponentsInSelection.Remove(comp)
                        comp.TrackAuthorities.Remove(Me)
                        comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                        comp.UpdateStatus()
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim t As Track = CType(comp, Track)
                            If t.AllowFieldBlocking Then
                                SendControlToField = True
                            End If
                        End If
                    Next

                    If SendControlToField Then
                        SendControl(RollUpList)
                    End If

                    ResetCompToCodeBrown(RollUpList)
                    Try
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If comp.IsRemoteTrack Then
                                    If Not comp.Occuppied Then
                                        SystemEvent("SendRemoveTrackAuthority - RollUpAuthority")
                                        comp.myRemoteTrack.SendRemoveTrackAuthority(Me.AuthorityUID)
                                    End If
                                End If
                            End If
                        Next

                    Catch ex As Exception
                        SystemException(ex.ToString)
                    End Try

                    Dim NewLimits As String
                    If ReleaseDirection = "RIGHT" Then
                        NewLimits = RightLimits
                    Else
                        NewLimits = RightLimits
                    End If

                    Me.UpdateDatabaseWithRollUpEvent()
                    Me.CreateReducedLimitsVerbiage()

                    If optEnableMOWMoveOnTNTRollup AndAlso Not Me.IssuedToTrain Then
                        Dim trk As Track
                        Dim RollupMOWMoveCompleted As Boolean = False
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                trk = comp
                                If trk.MOWIDs.Count > 0 Then
                                    Dim MOW As MOWID
                                    MOW = trk.MOWIDs.Item(0)
                                    If MOW.Name = IssueTo Then
                                        TrackSelected.MoveMOWIDPlace(MOW, trk, False)
                                        RollupMOWMoveCompleted = True
                                    End If
                                End If

                            End If
                        Next
                        If Not RollupMOWMoveCompleted Then
                            trk = Nothing
                            For Each comp In Me.ComponentsInSelection
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    trk = comp
                                    If trk.MOWIDs.Count > 0 Then
