        ''' <summary>
        ''' Complete rollup
        ''' </summary>
        Public Sub VETMS_CompleteRollup()
            Dim doAddAuthorityEvent As DoEventLogTrackTime
            Dim doAuthorityEvent As DoPublishTNTEvent
            Dim comp As Object
            Dim terrList As New ArrayList
            Dim tr As TacticalRoute
            Dim terrID As Int32
            Dim index As Integer
            Try
                AuthorityEventLog("VETMS_CompleteRollup:Start")
                For Each comp In PTCRollUpList
                    Select Case comp.GetType.ToString
                        Case gTrackComponentName, gSwitchComponentName
                            AuthorityEventLog("VETMS_CompleteRollup:Comp:" & comp.GUID.ToString & ":" & comp.Name & ":" & comp.FlipMe.ToString & ":" & comp.TrafficDirection)
                            Me.ComponentsInSelection.Remove(comp)
                            comp.TrackAuthorities.Remove(Me)
                            comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                            If comp.TrackAuthorities.Count = 0 Then
                                comp.TrackAuthority = False
                                comp.TrafficDirection = ""
                            End If
                            comp.UpdateStatus()
                        Case gFlipFlopComponentName, gRRXINGComponentName
                            Me.ComponentsInSelection.Remove(comp)
                    End Select
                Next
                Try
                    For Each comp In PTCRollUpList
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If comp.IsRemoteTrack Then
                                If Not comp.Occuppied Then
                                    AuthorityEventLog("SendRemoveTrackAuthority:ROLLUP")
                                    comp.myRemoteTrack.SendRemoveTrackAuthority(Me.AuthorityUID, Me.PTCAuthorityACKPending)
                                End If
                            End If
                        End If
                    Next
                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try
                If ComponentsInSelection.Count > 0 Then
                    For Each comp In ComponentsInSelection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If Not terrList.Contains(trk.TerritoryID) Then
                                terrList.Add(trk.TerritoryID)
                            End If
                        End If
                    Next
                End If
                For Each terrID In terrList
                    Select Case index
                        Case 0
                            Me.TerritoryAssignment = terrID
                            index = 1
                        Case 1
                            Me.TerritoryAssignmentSecondary = terrID
                            index = 2
                        Case 2
                            Me.TerrIDTeritary = terrID
                            index = 3
                        Case 3
                            Me.TerrIDQuadtary = terrID
                        Case Else
                    End Select
                Next
                terrList.Clear()
                If Not IsNothing(myTrain) AndAlso Not IsNothing(myTrain.myTacticalRoutesToRemove) Then
                    For Each tr In myTrain.myTacticalRoutesToRemove
                        tr.RemoveRoute()
                        myTrain.myTacticalRoutes.Remove(tr)
                    Next
                    myTrain.myTacticalRoutesToRemove.Clear()
                End If
                UpdateTacticalRouteList()
                Me.PTCRollupSuccessful = True
                Me.UpdateDatabaseWithCompList("VETMS_CompleteRollup")
                Me.PTCAuthoritySegments = PTCTrackSegmentRollupList
                Me.UpdateTrackSegments(Nothing)
                Me.UpdateDatabaseWithPTCAuthoritySegments("VETMS_CompleteRollup")
                Me.CheckToAcknowledgeAlert()
                Me.PTCTransmissionCompleted()
                If optEnableCPSpecificPTCOperations Then
                    Me.RollUpEvents.Add(PTCRollEventText)
                    Me.CurrentRollUpEvent = PTCRollEventText
                    Me.UpdateDatabaseWithRollUpEvent()
                    UpdatePTCRollupTextCRC()
                End If
                'Send event to control server and db
                doAddAuthorityEvent = New DoEventLogTrackTime(AddressOf Me.LogTheTrackTimeEvent)
                doAddAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.TrackAuthority.EventTypeTNT.UPDATE, Nothing, Nothing)
                doAuthorityEvent = New DoPublishTNTEvent(AddressOf Me.PublishTNTEventUpdate)
                doAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.TrackAuthority.EventTypeTNT.UPDATE, Nothing, Nothing)
                AuthorityEventLog("VETMS_CompleteRollup:End")
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If optEnableTNTCheckSum Then Me.UpdateOjectCRC()
                Me.PTCRollUpList = New ArrayList
                Me.PTCTrackSegmentRollupList = ""
                Me.PTCRollEventText = String.Empty
                Me.PTCReducedRollEventText = String.Empty
                doAddAuthorityEvent = Nothing
                doAuthorityEvent = Nothing
                comp = Nothing
                terrList = Nothing
                tr = Nothing
                terrID = Nothing
                index = Nothing
            End Try
        End Sub

        Public Sub VETMS_RollupRejected()
            Try

                Me.PTCRollupSuccessful = True
                ' Me.UpdateDatabaseWithCompList()
