                            End If
                        End If

                    ElseIf Me.AuthType1 = "ItemTwoToMOW" Or Me.AuthType1 = "ItemFourToMOW" Then
                        'Find a MOWID to move to Roll Up Track
                        Dim trk As Track
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                trk = comp
                                If trk.MOWIDs.Count > 0 Then
                                    Dim MOW As MOWID
                                    MOW = trk.MOWIDs.Item(0)
                                    If MOW.Name = IssueTo Then
                                        pTrackSelected.MoveMOWIDPlace(MOW, trk, False)
                                        RollUpTrack = pTrackSelected
                                    End If
                                End If

                            End If
                        Next
                        trk = Nothing
                    End If


                    If Me.MixModeAuthorityType Then
                        If Me.IssuedToTrain Then
                            MoveTrain_MOWOnRollup(RollUpList, Me.IssuedToTrain, Me.TrainSymbol, pTrackSelected)
                        Else
                            MoveTrain_MOWOnRollup(RollUpList, Me.IssuedToTrain, IssueTo, pTrackSelected)
                        End If
                        SendControl(RollUpList)
                    End If

                    If gThisWorkstation.AllowMovementPlanning And pTrackSelected.myTerritory.AllowMovementPlanning Then
                        Me.PublishSFARollUpForPlanning(RollUpList, RightLimits, LeftLimits, pTrackSelected.myControlPoint.Name)
                    End If

                    'REMOVE THE AUHTORITY FROM THE ROLLED UP TRACK PIECES AND REDRAW ANY EXISTING IDS.
                    Dim TrainBeingRolledUp As TrainID = GetTrainFromUnitID(IssueTo)

                    For Each comp In RollUpList
