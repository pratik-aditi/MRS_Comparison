#Region "STATUS UPDATES"

        Private Delegate Sub DoPublishTNTEvent(ByVal EventType As EventTypeTNT)

        ''' <summary>
        ''' Publish event for control server
        ''' </summary>
        ''' <param name="pEventType"></param>
        Public Sub PublishTNTEventUpdate(ByVal pEventType As EventTypeTNT)
            Dim messageNew As String = "DC" & Chr(6) & "TNT;"
            Dim terr As Territory
            Dim territoryAllowsPlanning As Boolean
            Dim useSecondaryterritory As Boolean
            Dim territoryFound As Boolean
            Dim message As String = "DC" & Chr(6) & "TNT;"
            Dim messBody As String = String.Empty
            Dim updateEvent As Boolean
            Dim addEvent, DeleteEvent As Boolean
            Dim secureEvent As Boolean
            Dim comp As Object
            Dim compList As String = String.Empty
            Dim veh As String
            Dim vehicles As String = String.Empty
            Dim behindTrains As String = String.Empty
            Dim bt As String
            'Dim remoteComps As String()
            'Dim localComps As String()
            'Dim remoteComp As String = String.Empty
            Try
                For Each terr In TMDS.GlobalDeclarations.ControlledTerritories
                    If terr.TerritoryID = Me.TerritoryAssignment Then
                        territoryAllowsPlanning = terr.AllowMovementPlanning
                        territoryFound = True
                        Exit For
                    End If
                Next
                If Not territoryFound Then
                    For Each terr In TMDS.GlobalDeclarations.ControlledTerritories
                        If terr.TerritoryID = Me.TerritoryAssignmentSecondary Then
                            territoryAllowsPlanning = terr.AllowMovementPlanning
                            territoryFound = True
                            Exit For
                        End If
                    Next
                    If Not territoryFound Then
                        messageNew = messageNew & "|" & Me.TerritoryAssignment.ToString
                    Else
                        messageNew = messageNew & "|" & Me.TerritoryAssignmentSecondary.ToString
                        useSecondaryterritory = True
                    End If
                Else
                    messageNew = messageNew & "|" & Me.TerritoryAssignment.ToString
                End If
                message = message & "|" & Me.TerritoryAssignment.ToString
                Select Case pEventType
                    Case EventTypeTNT.ADD
                        message = message & "|" & "CREATE"
                        messageNew = messageNew & "|" & "ADD"
                        addEvent = True
                    Case EventTypeTNT.REMOVE
                        message = message & "|" & "DELETE"
                        messageNew = messageNew & "|" & "DELETE"
                        DeleteEvent = True
                    Case EventTypeTNT.UPDATE
                        message = message & "|" & "UPDATE"
                        updateEvent = True
                    Case EventTypeTNT.SECURE
                        message = message & "|" & "SECURE"
                        secureEvent = True
                End Select
                For Each comp In Me.ComponentsInSelection
                    compList = compList & "-" & comp.GUID
                Next
                If updateEvent Then
                    messBody = messBody & "|" & Me.AuthorityUID
                    messBody = messBody & "|" & Me.OKTime
                    If optUseSingleFormAuthorityVersionMRL Then
                        If Format(UntilTime, "HH:mm") = "00:00" Then
                            messBody = messBody & "|" & "UNTIL CALLED"
                        Else
                            messBody = messBody & "|" & Me.UntilTime
                        End If
                    Else
                        messBody = messBody & "|" & Me.UntilTime
                    End If
                    If Not IsNothing(Me.VehicleAssociations) Then
                        For Each veh In Me.VehicleAssociations
                            vehicles = vehicles & "-" & veh
                        Next
                    End If
                    messBody = messBody & "|VEHICLES" & vehicles
                    messBody = messBody & "|" & Me.JointAuthority
                    'If Me.myTrain IsNot Nothing AndAlso Me.myTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain Then
                    '    localComps = compList.Split("-")
                    '    remoteComps = Me.GetComponentsFromDB().Split("|")
                    '    For Each compAux As String In remoteComps
                    '        If Not localComps.Contains(compAux) Then
                    '            remoteComp += "-" & compAux
                    '        End If
                    '    Next
                    '    messBody = messBody & "|COMPONENTS" & remoteComp & compList
                    'Else
                    messBody = messBody & "|COMPONENTS" & compList
                    'End If

                    If Me.AuthorityLimits IsNot Nothing Then
                        messBody = messBody & "|" & Me.AuthorityLimits.Length.ToString
                        messBody = messBody & "|" & Me.AuthorityLimits.Replace("|", "#")
                    Else
                        messBody = messBody & "|"
                        messBody = messBody & "|"
                    End If
                    messBody = messBody & "|" & Me.PTCStatus
                ElseIf secureEvent Then
                    messBody = messBody & "|" & Me.AuthorityUID
                    messBody = messBody & "|" & Me.AuthGUID
                    messBody = messBody & "|" & Me.MobileClientDSA
                    messBody = messBody & "|" & Me.MobileClientLastName
                    messBody = messBody & "|" & Me.MobileClientFirstName
                Else
                    messBody = messBody & "|" & Me.AuthorityUID
                    If DeleteEvent Then
                        messageNew = messageNew & "|" & Me.ReportClear
                    End If
                    messBody = messBody & "|" & Me.AuthorityDate
                    messBody = messBody & "|" & Me.AuthorityLimits
                    messBody = messBody & "|" & Me.DispatcherName
                    messBody = messBody & "|" & Me.IssueTo
                    messBody = messBody & "|" & Me.JointAuthority
                    If optUseSingleFormAuthorityVersionMRL Then
                        If Format(UntilTime, "HH:mm") = "00:00" Then
                            messBody = messBody & "|" & "UNTIL CALLED"
                        Else
                            messBody = messBody & "|" & Me.UntilTime
                        End If
                    Else
                        messBody = messBody & "|" & Me.UntilTime
                    End If
                    messBody = messBody & "|COMPONENTS" & compList
                    If Not IsNothing(Me.BehindTrains) Then
                        For Each bt In Me.BehindTrains
                            behindTrains = behindTrains & bt & "-"
                        Next
                    End If
                    If addEvent Or DeleteEvent Then
                        If DeleteEvent Then
                            messageNew = messageNew & "|" & Me.ReportClear
                        End If
                        messageNew = messageNew & "|" & Me.AuthorityUID
                        messageNew = messageNew & "|" & Me.AuthorityDate
                        messageNew = messageNew & "|" & Me.DispatcherName
                        messageNew = messageNew & "|" & Me.IssueTo
                        messageNew = messageNew & "|" & Me.JointAuthority
                        If optUseSingleFormAuthorityVersionMRL Then
                            If Format(UntilTime, "HH:mm") = "00:00" Then
                                messageNew = messageNew & "|" & "UNTIL CALLED"
                            Else
                                messageNew = messageNew & "|" & Me.UntilTime
                            End If
                        Else
                            messageNew = messageNew & "|" & Me.UntilTime
                        End If
                        messageNew = messageNew & "|COMPONENTS" & compList
                        messageNew = messageNew & "|" & behindTrains
                        messageNew = messageNew & "|" & Me.JointLimits
                        messageNew = messageNew & "|" & Me.CopiedBy
                        If Not IsNothing(Me.AuthorityLimits) Then
                            messageNew = messageNew & "|" & Me.AuthorityLimits.Length.ToString
                            messageNew = messageNew & "|" & Me.AuthorityLimits
                        Else
                            messageNew = messageNew & "|" & String.Empty
                            messageNew = messageNew & "|" & String.Empty
                        End If
                        messageNew = messageNew & "|" & Me.PTCStatus
                    End If
                End If
                message = Me.TerritoryAssignment.ToString & Chr(12) & message & messBody
                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(message)
                End SyncLock
                If addEvent Or DeleteEvent Or updateEvent Then
                    If Not useSecondaryterritory Then
                        messageNew = Me.TerritoryAssignment.ToString & Chr(12) & messageNew
                        If territoryAllowsPlanning Then
                            PublishTNTEventForPlanning(pEventType, Me.TerritoryAssignment)
                        End If
                    Else
                        'Need to view client show the license in remote desk
                        If Me.myTrain IsNot Nothing AndAlso Me.myTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain AndAlso pEventType = EventTypeTNT.UPDATE Then
                            messageNew = Me.TerritoryAssignmentSecondary.ToString & Chr(12) & messageNew & "|" & "UPDATE-REMOTE" & messBody
                        Else
                            messageNew = Me.TerritoryAssignmentSecondary.ToString & Chr(12) & messageNew
                        End If
                        If territoryAllowsPlanning Then
                            PublishTNTEventForPlanning(pEventType, Me.TerritoryAssignmentSecondary)
                        End If
                    End If
                    SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                        TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(messageNew)
                    End SyncLock
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                messageNew = Nothing
                terr = Nothing
                territoryAllowsPlanning = Nothing
                useSecondaryterritory = Nothing
                territoryFound = Nothing
                message = Nothing
                messBody = Nothing
                updateEvent = Nothing
                addEvent = Nothing
                DeleteEvent = Nothing
                secureEvent = Nothing
                comp = Nothing
                compList = Nothing
                veh = Nothing
                vehicles = Nothing
                behindTrains = Nothing
                bt = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Publish event for control server
        ''' </summary>
        ''' <param name="pEventType"></param>
        ''' <param name="pTerrUID"></param>
        Public Sub PublishTNTEventForPlanning(ByVal pEventType As EventTypeTNT, ByVal pTerrUID As Int32)
            Dim messageNew As String = "DC" & Chr(6) & "MPAR;TNT;"
            Dim comp As Object
            Dim compList As String = String.Empty
            Try
                messageNew = messageNew & "|" & pTerrUID.ToString & "|"
                Select Case pEventType
                    Case EventTypeTNT.ADD
                        messageNew = messageNew & "ADD"
                    Case EventTypeTNT.REMOVE
                        messageNew = messageNew & "DELETE"
                    Case EventTypeTNT.UPDATE
                        messageNew = messageNew & "UPDATE"
                    Case Else
                        Exit Sub
                End Select
                For Each comp In Me.ComponentsInSelection
                    compList = compList & "-" & comp.GUID
                Next
                messageNew = messageNew & "|" & Me.AuthorityUID
                messageNew = messageNew & "|" & Me.AuthorityDate
                messageNew = messageNew & "|" & TMDS.SystemUtilities.Formatting.ConvertTimeToTimeZone(Me.ComponentsInSelection, UntilTime)
                messageNew = messageNew & "|COMPONENTS" & compList
                messageNew = messageNew & "|" & Me.TrackReservationGUID
                messageNew = messageNew & "|" & Me.JointAuthority.ToString
                messageNew = messageNew & "|" & Me.AllowTrainMovementThroughLimits.ToString
                messageNew = messageNew & "|" & Me.IssueTo
                messageNew = messageNew & "|" & Me.AuthorityLimits.Replace("|", "#")
                messageNew = pTerrUID.ToString & Chr(12) & messageNew
                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(messageNew)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                messageNew = Nothing
                comp = Nothing
                compList = Nothing
            End Try
        End Sub

