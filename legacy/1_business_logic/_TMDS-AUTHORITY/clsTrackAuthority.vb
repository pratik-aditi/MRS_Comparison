        Private Function GetNumericStatus(ByVal auth As DTCAuthority) As Integer
            Try
                If IsNothing(auth) Then Exit Function
                Select Case auth.StatusOfDTC
                    Case "PENDING"
                        Return 0
                    Case "ACCEPTED"
                        Return 5
                    Case "ACTIVATED"
                        Return 6
                    Case "REPLACED OFFICE"
                        Return 10
                    Case "RELEASE"
                        Return 14
                    Case "LOCO-ACTIVATED"
                        Return 8
                    Case "REPLACE"
                        Return 11
                    Case "DELETE"
                        Return 15

                End Select
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

