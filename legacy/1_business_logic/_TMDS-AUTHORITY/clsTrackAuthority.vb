        Public Function UpdateDatabaseWithReportClear() As Boolean
            Dim strUpdateSQL As New StringBuilder
            Dim dbconn As OleDbConnection = Nothing
            Dim CommandUpdate As OleDbCommand = Nothing
            Try

                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)

                With strUpdateSQL
                    .Append("UPDATE tblAuthoritiesOtherActive")
                    .Append(" SET ")
                    .Append(" ReportClearType = '" & Me.ReportClearType.Trim.ToUpper & "'")
                    .Append(", [ReportClearTime] ='" & Me.ReportClearTime & "'")
                    .Append(", [ReportedClearBy] ='" & Me.ReportClearedBy.Trim.ToUpper & "'")
                    .Append(" WHERE AuthGUID = " & "'" & Me.AuthGUID & "'")
                End With

                CommandUpdate = New OleDbCommand(strUpdateSQL.ToString, dbconn)

                dbconn.Open()
                CommandUpdate.ExecuteNonQuery()
                Return True
            Catch ex As Exception
                GetErrorDetails(ex, " UpdateDatabaseWithReportClear:::UpdateSQL: " & strUpdateSQL.ToString)
                Return False
            Finally
                If Not dbconn Is Nothing Then
                    If dbconn.State <> ConnectionState.Closed Then dbconn.Close()
                    dbconn.Dispose()
                    dbconn = Nothing
                End If
                If Not CommandUpdate Is Nothing Then
                    CommandUpdate.Dispose()
                    CommandUpdate = Nothing
                End If
            End Try

        End Function

        Private Sub LogTrainDelayFromPSS()
            Dim DC As DelayCode
            Dim DCToUse As DelayCode = Nothing
            Dim DelayCodeToUse As String = "SO"
            Dim DelayTime As Integer = 0
            Try

                If optEnablePSSDelayUseCode IsNot Nothing AndAlso Not String.IsNullOrEmpty(optEnablePSSDelayUseCode) AndAlso optEnablePSSDelayUseCode.Trim <> "" Then
                    DelayCodeToUse = optEnablePSSDelayUseCode
                End If
                For Each DC In TMDS.GlobalDeclarations.gDelayCodeList
                    If DC.Code.Trim.ToUpper = DelayCodeToUse Then
                        DCToUse = DC
                        Exit For
                    End If
                Next
                Dim td As New TrainDelay
                td.DelayUID = Guid.NewGuid.ToString.ToUpper
                td.TrainSheetUID = Me.myTrain.ActiveTrainSheetGUID
                td.IdentifyingPointUID = Me.mySignal.myControlPoint.GUID

                If Me.mySignal.myControlPoint.UniqueName IsNot Nothing AndAlso Me.mySignal.myControlPoint.UniqueName.Trim <> "" Then
                    td.IdentifyingPointName = Me.mySignal.myControlPoint.UniqueName
                Else
                    td.IdentifyingPointName = Me.mySignal.myControlPoint.Name
                End If


                td.EventTimeStamp = Now
                td.EventTimeZone = Mid(Me.mySignal.mySubdivision.TimeZone, 1, 1)
                td.EventMilePost = Me.mySignal.myMilePostPrefix & Me.mySignal.myMilePost & Me.mySignal.myMilePostSuffix
                td.EventTrackName = Me.mySignal.Name

                If DCToUse IsNot Nothing Then
                    td.EventDelayCode = DCToUse.Code
                    td.myDelayExcused = DCToUse.DelayExcused.Trim.ToUpper
                Else
                    td.EventDelayCode = DelayCodeToUse
                    td.myDelayExcused = "YES"
                End If


                td.EventComments = gMenuPermissionToPassRedSignalText & " DELAY - AUTOMATICALLY GENERATED FROM AUTHORITY:" & Me.AuthorityNumber & " DEVICE UID: " & Me.mySignal.GUID
                td.EventDelayAmount = DelayTime
                td.RailroadUID = "NONE"

                td.ReportData = Me.myTrain.GetTrainReportDataString(td.EventDelayCode, DelayTime)
                td.myTrain = Me.myTrain
                td.myReportingPerson = gCurrentUser.FirstName & ", " & gCurrentUser.LastName
                td.myDelayEventType = TrainDelay.DelayEventType.Automatic
                td.myDelaySubEventType = TrainDelay.DelayEventSubType.TPSS
                td.myScheduleStationIndex = Me.myTrain.GetStationIndex(Me.mySignal.myControlPoint.UniqueName)
                td.myScheduleStationUID = Me.mySignal.myControlPoint.UniqueName
                td.myDeviceName = td.GetDeviceNameString(Me.mySignal)

                td.AddDelayToDatabase()



            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

