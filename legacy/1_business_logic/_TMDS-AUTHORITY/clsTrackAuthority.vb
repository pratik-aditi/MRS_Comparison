                    Me.MobileClientLastName = "NONE"
                    Me.MobileClientDSA = "NONE"
                Else
                    Me.MobileClientPIN = Me.MobileClientForeman.PIN
                    Me.MobileClientPassword = Me.MobileClientForeman.Password
                    Me.MobileClientEnabled = True
