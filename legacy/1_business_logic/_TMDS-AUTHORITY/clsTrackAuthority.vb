                                    '            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightAltLink)
                                    '        Else
                                    '            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightLink)
