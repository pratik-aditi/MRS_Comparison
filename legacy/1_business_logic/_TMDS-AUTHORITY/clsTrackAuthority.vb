#Region "VETMS-PTC MODIFY METHODS"

        Public Sub VETMS_PerformModify(ByVal theTrain As TrainID)
            Try
                PTCElectronicTransmissionInProgress = True
                Me.PTCMarkedToBeModifiedElectronically = True
                Me.PTCElectronicDeliveryCompleted = False
                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                Me.PTCTypeAuthority = True
                Me.UpdateDatabaseWithPTCAuthorityStatus("MODIFY-SENT")
                Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.MODIFY.ToString
                DoAssignComponentsForPTC(ComponentsInSelection)
                Me.PTCStatus = "MODIFY-SENT"
                Me.SetPTCAuthorityFlasherStatus("VETMS_PerformModify")
                If Not optDisableFlashingTrackForPTC Then Me.FlasherMode(True, True)
                Dim NewTrackSegmentsFromCAD As String = Me.PTCAuthoritySegments
                Me.PTCSentTimeStamp = Now

                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageModify_CTC(Me, theTrain, NewTrackSegmentsFromCAD, PTCMessageUID, True)

                TMDS.NetworkMessages.CadMessages.SendLicenseEventForWabtecOne(Me, "MODIFY")

                If Me.UpdateDatabaseWithPTCAuthorityStatus("SENT") Then
                    Me.PTCStatus = "MODIFY-SENT"
                    Dim SummItem1 As New SummaryItem("AUTHORITY", "UPDATE-PTC", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If
                VETMS_CreateTimerModifyEvent()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub VETMS_PerformModifyAgain(ByVal theTrain As TrainID)
            Try
                PTCElectronicTransmissionInProgress = True
                Me.PTCElectronicDeliveryCompleted = False
                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                Me.PTCTypeAuthority = True
                Me.UpdateDatabaseWithPTCAuthorityStatus("MODIFY-SENT")
                Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.MODIFY.ToString
                DoAssignComponentsForPTC(ComponentsInSelection)
                Dim NewTrackSegmentsFromCAD As String = Me.PTCAuthoritySegments
                Me.PTCStatus = "MODIFY-SENT"
                Me.SetPTCAuthorityFlasherStatus("VETMS_PerformModifyAgain")
                If Not optDisableFlashingTrackForPTC Then Me.FlasherMode(True, True)

                Me.PTCSentTimeStamp = Now

                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageModify_CTC(Me, theTrain, NewTrackSegmentsFromCAD, PTCMessageUID, True)
                If Me.UpdateDatabaseWithPTCAuthorityStatus("SENT") Then
                    Me.PTCStatus = "MODIFY-SENT"
                    Dim SummItem1 As New SummaryItem("AUTHORITY", "UPDATE-PTC", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If
                VETMS_CreateTimerModifyEvent()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub VETMS_CreateTimerModifyEvent()
            Try
                If Not IsNothing(myTrain) Then If myTrain.GeoFenceLegacyEnabled Then Exit Sub
                PTCModifyTimeExpired = False

                If IsNothing(PTCTimerModify) Then
                    PTCTimerModify = New Timers.Timer(gPTCTimeOutTransmissionAuthorityRollup)
                    AddHandler PTCTimerModify.Elapsed, AddressOf VETMS_CheckStatusModify
                    PTCTimerModify.Enabled = True
                Else
                    PTCTimerModify.Start()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub VETMS_CheckStatusModify(ByVal source As Object, ByVal e As Timers.ElapsedEventArgs)
            Try
                If Not PTCModifySuccessful Then
                    VETMS_GenerateAlertForFailedModify()
                    'myTrain.ClickedOnTrainForLicense = False
                End If
                PTCModifyTimeExpired = True
                VETMS_TerminatePTCTimerModify()
                ' myTrain.ClickedOnTrainForLicense = False
            Catch ex As Exception
                SystemException(ex.ToString)
                PTCRollupTimeExpired = True
            End Try
        End Sub

        Public Sub VETMS_TerminatePTCTimerModify()
            Try
                Me.PTCModifySuccessful = False
                If IsNothing(PTCTimerModify) Then Exit Sub
                RemoveHandler PTCTimerModify.Elapsed, AddressOf VETMS_CheckStatusModify
                PTCTimerModify.Enabled = False
                PTCTimerModify.Dispose()
                PTCTimerModify = Nothing
                Me.PTCMarkedToBeModifiedElectronically = False
                Me.PTCModifySuccessful = False
                Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC", Me)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Generate Alert For Failed Modify
        ''' </summary>
        Private Sub VETMS_GenerateAlertForFailedModify()
            Try
                PTCElectronicTransmissionInProgress = False
                Dim theTrain As TrainID = TrainExistsForAuthority(Me)
                Dim alertMessage As String = $"{optPTCString018} ({AuthorityUID}) | {optPTCString019} ({IssueTo}) {optPTCString023}"
                If Not CheckForAlertExtistence(Me) Then
                    AlertUtilities.CreateAlert(Alert.AlertType.VETMS_PTC_CTC_AuthorityModifyRequestFailed,
                                               alertMessage, theTrain, Nothing, Nothing, Nothing, Nothing, Me)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub VETMS_TerminatePTCModifyProcess()
            Try
                VETMS_TerminatePTCTimerModify()
                Me.PTCMarkedToBeModifiedElectronically = False
                Me.PTCModifyTimeExpired = False
                Me.PTCModifySuccessful = False
                Me.PTCAuthorityACKPending = ""
                Me.PTCAuthorityComponents = New ArrayList
                Me.UpdateDatabaseWithPTCComponents()
                Me.FlasherMode(False, True)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub VETMS_GenerateModifyFailure()
            Try
                If Not PTCRollupSuccessful Then
                    VETMS_GenerateAlertForFailedModify()
                End If
                VETMS_TerminatePTCTimerModify()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

