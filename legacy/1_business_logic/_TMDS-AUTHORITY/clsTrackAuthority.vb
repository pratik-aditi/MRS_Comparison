        Public Sub SetPTCSTatusSelectionMode()
            Try
                Select Case Me.PTCAuthorityACKPending

                    Case PTCAuthorityACKPendingStatus.ISSUE.ToString
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCIssuancePending
                        Me.PTCStatusFlashColor = ColorStatusPTCIssuancePending

                    Case PTCAuthorityACKPendingStatus.PENDINGRELEASE.ToString
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCReleasePending
                        Me.PTCStatusFlashColor = ColorStatusPTCReleasePending

                    Case PTCAuthorityACKPendingStatus.RELEASE.ToString
                        PTCStatusFlashColor = Nothing 'New SolidBrush(Color.Black)
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.Regular

                    Case PTCAuthorityACKPendingStatus.ROLLUP.ToString
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCReleaseImminent
                        Me.PTCStatusFlashColor = ColorStatusPTCReleaseImminent

                    Case PTCAuthorityACKPendingStatus.VOID.ToString
                        PTCStatusFlashColor = Nothing 'New SolidBrush(Color.Black)
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.Regular

                    Case Else
                        PTCStatusFlashColor = Nothing 'New SolidBrush(Color.Black)
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.Regular
                End Select
                If optDisableFlashingTrackForPTC Then
                    Dim comp As Object
                    For Each comp In PTCAuthorityComponents
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.SelectionMode = PTCSTatusSelectionMode
                                comp.UpdateStatus()
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If
                        End Select
                    Next
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

