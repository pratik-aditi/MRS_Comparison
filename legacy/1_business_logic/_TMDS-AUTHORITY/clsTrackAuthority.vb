#Region " FLASHER "

        Public Sub SetPTCAuthorityFlasherStatus(Optional ByVal CallingMethod As String = "")
            Try
                If CallingMethod IsNot Nothing AndAlso CallingMethod.Trim <> "" Then
                    SystemEvent("SetPTCAuthorityFlasherStatus-" & CallingMethod & ":" & Me.TrainSymbol & " AuthUID: " & Me.AuthorityUID)
                End If
                Select Case Me.PTCStatus
                    Case "RELEASE-SENT"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCReleasePending
                        Me.PTCStatusFlashColor = ColorStatusPTCReleasePending

                    Case "RELEASE-PENDING"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCReleaseImminent
                        Me.PTCStatusFlashColor = ColorStatusPTCReleaseImminent

                    Case "RELEASE-FAILED", "RELEASE-SUCCESSFUL", "RELEASE-REJECTED"
                        PTCStatusFlashColor = New SolidBrush(Color.Black)
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.Regular

                    Case "AUTHORITY-SENT", "OKTIME-SENT", "UNTILTIME-SENT"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCIssuancePending
                        Me.PTCStatusFlashColor = ColorStatusPTCIssuancePending

                    Case "AUTHORITY-DELIVERED"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCIssuanceImminent
                        Me.PTCStatusFlashColor = ColorStatusPTCIssuanceImminent

                    Case "AUTHORITY-FAILED", "AUTHORITY-ACTIVATED"
                        PTCStatusFlashColor = New SolidBrush(Color.Black)
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.Regular
                End Select

                If optDisableFlashingTrackForPTC Then
                    Dim comp As Object
                    For Each comp In PTCAuthorityComponents
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.SelectionMode = PTCSTatusSelectionMode
                                comp.UpdateStatus(Me)
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If
                        End Select
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub ResetRollupListComponents(ByVal themode As TMDS.GraphicComponent.GenericComponent.ModeSelection)
            Try
                Dim comp As Object
                For Each comp In RollUpList
                    Select Case comp.GetType.ToString
                        Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                            comp.SelectionMode = themode
                            comp.FlashComponent = True
                    End Select
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Overridable Sub FlasherMode(ByVal EnableFlasher As Boolean, Optional ByVal PTCAuthorityMode As Boolean = False)
            Dim comp As Object = Nothing
            'MutexFlasher = New Mutex(False, "SFAFlasherMode")
            Try
                'MutexFlasher.WaitOne()
                Me.FlashComponent = EnableFlasher
                Me.FlashOn = EnableFlasher
                Me.Flasher.Enabled = EnableFlasher
                Me.Flasher.Interval = 200

                If PTCAuthorityMode Then
                    Select Case EnableFlasher
                        Case True
                            For Each comp In Me.PTCAuthorityComponents
                                If Not comp.TrackAuthorities.Contains(Me) Then
                                    Select Case comp.GetType.ToString
                                        Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                            comp.PTCAuthorityPending = True
                                    End Select
                                    If Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ROLLUP.ToString Then
                                        '''''THIS IS REALLY BAD...DO NOT UNCOMMENT  'comp.TrackAuthorities.Add(Me)
                                        comp.UpdateStatus()
                                    End If
                                End If

                            Next
                        Case Else

                            For Each comp In Me.PTCAuthorityComponents
                                Select Case comp.GetType.ToString
                                    Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                        comp.PTCAuthorityPending = False
                                End Select
                                If Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ROLLUP.ToString Then
                                    '''''THIS IS REALLY BAD...DO NOT UNCOMMENT  'comp.TrackAuthorities.Remove(Me)
                                    comp.UpdateStatus()
                                ElseIf Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.VOID.ToString Then
                                    '''''THIS IS REALLY BAD...DO NOT UNCOMMENT ' comp.TrackAuthorities.Remove(Me)
                                    comp.UpdateStatus()
                                End If
                            Next
                    End Select
                End If


                If Not EnableFlasher Then
                    StopFlash = True
                    Me.Flasher.Enabled = False
                    If PTCAuthorityMode Then ClearPTCAuthoritySelectionFlash()
                    For Each comp In Me.Components
                        Select Case comp.GetType.ToString
                            Case gSwitchComponentName, gTrackComponentName
                                comp.Flasher.Interval = 250
                                comp.FlashOn = False
                                comp.FlashComponent = False
                                comp.UpdateStatus()
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If

                            Case Else
                                SyncLock comp.Graphical
                                    comp.Graphical.FillPath(comp.CurrentColorStatus, comp.GraphicalPath)
                                End SyncLock
                        End Select
                    Next
                    SystemEvent("AuthStopped1")
                End If
                SystemEvent(Me.AuthorityUID & " FlashAuthority " & Me.Flasher.Enabled.ToString & " EnableFlasher " & EnableFlasher.ToString)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Try
                    'MutexFlasher.ReleaseMutex()
                Catch ex As Exception
                End Try

            End Try
        End Sub

