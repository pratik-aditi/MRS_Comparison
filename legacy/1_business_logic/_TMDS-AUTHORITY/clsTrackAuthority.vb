                                        comp.myRemoteTrack.SendRemoveTrackAuthority(Me.AuthorityUID)
                                    End If
                                End If
                            End If
                        Next

                    Catch ex As Exception
                        SystemException(ex.ToString)
                    End Try

                    Dim NewLimits As String
                    If ReleaseDirection = "RIGHT" Then
                        NewLimits = RightLimits
                    Else
                        NewLimits = RightLimits
                    End If

                    Me.UpdateDatabaseWithRollUpEvent()
                    Me.CreateReducedLimitsVerbiage()

                    If optEnableMOWMoveOnTNTRollup AndAlso Not Me.IssuedToTrain Then
                        Dim trk As Track
                        Dim RollupMOWMoveCompleted As Boolean = False
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                trk = comp
                                If trk.MOWIDs.Count > 0 Then
                                    Dim MOW As MOWID
                                    MOW = trk.MOWIDs.Item(0)
                                    If MOW.Name = IssueTo Then
                                        TrackSelected.MoveMOWIDPlace(MOW, trk, False)
                                        RollupMOWMoveCompleted = True
                                    End If
                                End If

                            End If
                        Next
                        If Not RollupMOWMoveCompleted Then
                            trk = Nothing
                            For Each comp In Me.ComponentsInSelection
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    trk = comp
                                    If trk.MOWIDs.Count > 0 Then
                                        Dim MOW As MOWID
                                        MOW = trk.MOWIDs.Item(0)
                                        If MOW.Name = IssueTo Then
                                            TrackSelected.MoveMOWIDPlace(MOW, trk, False)
                                        End If
                                    End If

                                End If
                            Next
                        End If
                        trk = Nothing
                    End If

                    If Me.MixModeAuthorityType Then
                        If Me.IssuedToTrain Then
                            MoveTrain_MOWOnRollup(RollUpList, Me.IssuedToTrain, Me.TrainSymbol, TrackSelected)
                        Else
                            MoveTrain_MOWOnRollup(RollUpList, Me.IssuedToTrain, IssueTo, TrackSelected)
                        End If
                        Me.DoRemoveMixModeAuthorityFromComponents()
                    End If

                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock

                    Dim SummItem1 As New SummaryItem("AUTHORITY", "ADD", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If

                frmMessageBox.Dispose()
                frmMessageBox = Nothing
                ClearSelection()

            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSelection()
                Dim ErrorMessage As String = "TRACK AUTHORITY " & Me.AuthorityUID & " Not Rolled Up Properly! CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
            End Try
        End Function

        Private Sub CheckToAddAllLikeTracks(ByRef theList As ArrayList, ByVal theTrack As Track)
            Try
                Dim NextComp As Object = Nothing
                Dim Directions As New ArrayList
                Dim LoopControl As Integer
                Directions.Add("RIGHT") : Directions.Add("LEFT")
                Dim d As String
                For Each d In Directions
                    Select Case d
                        Case "RIGHT"
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(theTrack.RightLink)
                            Do
                                If IsNothing(NextComp) Then Exit Do
                                If NextComp.GetType.ToString = gTrackComponentName Then
                                    Dim trk As Track = CType(NextComp, Track)
                                    If trk.Name = theTrack.Name Then
                                        Dim Index As Integer = theList.IndexOf(theTrack)
                                        theList.Insert(Index, trk)
                                    Else
                                        Exit Do
                                    End If
                                Else
                                    Exit Do
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)

                                LoopControl += 1
                                If LoopControl >= 5 Then
                                    Exit Do
                                End If
                            Loop
                        Case "LEFT"
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(theTrack.LeftLink)

                            Do
                                If IsNothing(NextComp) Then Exit Do
                                If NextComp.GetType.ToString = gTrackComponentName Then
                                    Dim trk As Track = CType(NextComp, Track)
                                    If trk.Name = theTrack.Name Then
                                        Dim Index As Integer = theList.IndexOf(theTrack)
                                        theList.Insert(Index, trk)
                                    Else
                                        Exit Do
                                    End If
                                Else
                                    Exit Do
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)

                                LoopControl += 1
                                If LoopControl >= 5 Then
                                    Exit Do
                                End If
                            Loop

                    End Select
                Next


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckToAddOtherAuthorityToRollUpList(ByRef theRollupList As ArrayList, ByVal ReleaseDirection As String, ByVal theReleaseTrack As Track)
