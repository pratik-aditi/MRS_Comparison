                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim trk As Track = CType(comp, Track)
                                If Not IsNothing(trk.FEDList) Then
                                    Dim fd As FED
                                    For Each fd In trk.FEDList
                                        CreateFEDEvent("ROLLUP", fd)
                                    Next
                                End If
                            End If
                        End If

                        If optForceGTMEventsForTWCRollupAndReportClear And optLogGrossTonMiles Then
                            If Not IsNothing(TrainBeingRolledUp) Then
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    Dim trk As Track = CType(comp, Track)
                                    If trk.OStype Then
                                        If trk.TrainIDPlace Then
                                            trk.LogTheGTMEventManually(Track.EventTypeTrack.OSGTM, Nothing, TrainBeingRolledUp)
                                        End If
                                    Else
                                        trk.LogTheGTMEventManually(Track.EventTypeTrack.OSGTM, Nothing, TrainBeingRolledUp)
                                    End If
                                End If
                            End If
                        End If

                        'Me.Components.Remove(comp)
                        Dim c As Object
                        Dim CompClone As ArrayList = Me.Components.Clone
                        For Each c In CompClone
                            If c.GUID = comp.GUID Then
                                Me.Components.Remove(comp)
                            End If
                        Next
                        comp.TrackAuthorities.Remove(Me)
                        comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                        comp.UpdateStatus()
                        comp.InitAuthorityNumbers()
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            trk.InvalidateTrainID()
                            trk.InvalidateMOWID()
                            If trk.TrackZoneIntegrityMonitoringEnabled Then
                                Dim tz As TrackZone = trk.TrackZoneReference
                                If Not IsNothing(tz) Then
                                    If Not TrackZonesToCheck.Contains(tz) Then
                                        TrackZonesToCheck.Add(tz)
                                    End If
                                End If
                            End If
                        ElseIf comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As TMDS.SwitchComponents.Switch = CType(comp, TMDS.SwitchComponents.Switch)
                            If sw.RCPS Then
                                sw.CheckToRemoveRCPSControls()
                            ElseIf sw.SwitchPointerMonitorMode Then
                                sw.CheckToRemoveAlertFromAuthorityRelease()
                            End If
                        End If
                    Next

                    Dim NewLimits As String
                    If pReleaseDirection = "RIGHT" Then
                        NewLimits = RightLimits
                    Else
                        NewLimits = RightLimits
                    End If

                    Me.UpdateDatabaseWithRollUpEvent()
                    If optUseSingleFormAuthorityVersionMRS Then
                        Me.ClearEOT()
                    End If

                    Me.CreateReducedLimitsVerbiage()
                    GenerateScripts(Me, SimulatorScriptAction.ROLLUP)
                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock

                    Dim SummItem1 As New SummaryItem("AUTHORITY", "ADD", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                    If optAutoReleaseLicenseOnTrainMove Then
                        Dim sfaList As New ArrayList
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim theTrk As Track = CType(comp, Track)
                                If theTrk.TrackAuthorities.Count > 0 Then
                                    Dim s As Object 'SFAuthority
                                    For Each s In theTrk.TrackAuthorities
                                        If s.IssueTo = Me.IssueTo Then
                                            If Not sfaList.Contains(s) Then
                                                sfaList.Add(s)
                                            End If
                                        End If
                                    Next
                                End If
                            End If
                        Next
                        If sfaList.Count > 0 Then
                            Dim a As Object 'SFAuthority
                            For Each a In sfaList
                                If a.RemoveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                    If a.RemoveAuthorityFromComponents() Then
                                        TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(a)
                                        Dim SummItem2 As New SummaryItem("AUTHORITY", "REMOVE", a)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem2)
                                        End SyncLock
                                    End If
                                End If
                            Next
                        End If
                    End If
                    If optUseSingleFormAuthorityVersionMRS Then
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If comp.TrainIDs IsNot Nothing AndAlso comp.TrainIDs.Count > 0 Then
                                Else
                                    Dim OktoClearOcc As Boolean = True
                                    If comp.GetType.ToString = gTrackComponentName AndAlso comp.Occuppied AndAlso comp.TrackAuthorities IsNot Nothing AndAlso comp.TrackAuthorities.Count > 0 Then
                                        Dim tmpsfa As Object
                                        For Each tmpsfa In comp.TrackAuthorities
                                            If tmpsfa IsNot Nothing AndAlso tmpsfa.GetType.ToString = gSFAComponentName Then
                                                If tmpsfa IsNot Me Then
                                                    OktoClearOcc = False
                                                    Exit For
                                                End If
                                            End If
                                        Next
                                    End If
                                    If OktoClearOcc Then comp.Occuppied = False
                                    comp.UpdateStatus()
                                End If

                            End If
                        Next
                        For Each comp In Me.Components
                            If comp.GetType.ToString = gTrackComponentName AndAlso
                                comp.Occuppied = True AndAlso
                                Not RollUpList.Contains(comp) Then
                                rollupPending.Add(comp)
                            End If
                        Next
                        Me.UpdateEOT(rollupPending)
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If comp.GetType.ToString = gTrackComponentName AndAlso comp.TrackAuthorities IsNot Nothing AndAlso comp.TrackAuthorities.Count > 0 Then
                                    Dim tmpsfa As Object
                                    For Each tmpsfa In comp.TrackAuthorities
                                        If tmpsfa IsNot Nothing AndAlso tmpsfa.AuthGUID <> Me.AuthGUID Then
                                            If tmpsfa.Components4 IsNot Nothing AndAlso tmpsfa.Components4.Count > 0 Then
                                                If tmpsfa.Components4.Contains(comp) Then
                                                    comp.Occuppied = True
                                                    comp.UpdateStatus()
                                                    comp.Refresh()
                                                End If
                                            End If
                                        End If
                                    Next
                                End If
                            End If
                        Next
                    End If
                Else
                    SystemEvent(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED NO TO ROLLUP CONFIRMATION")
                    'REDRAW THE IDS IF ROLLUP IS CANCELLED TO CLEAN UP GRAPHICS
                    Me.UpdateEOT(RollUpList)
                    Me.UpdateEOTComps()
                    For Each comp In RollUpList
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If optUseSingleFormAuthorityVersionMRS Then
                                comp.Occuppied = True
                                If Not Me.Components4.Contains(comp) Then Me.Components4.Add(comp)
                            End If
                            comp.InvalidateTrainID()
                            comp.InvalidateMOWID()
                            comp.UpdateStatus()
                        End If
                    Next
                    DoAddAuthorityEvent = New DoEventLogSFA(AddressOf Me.LogTheSFAEvent)
                    DoAddAuthorityEvent.BeginInvoke(EventLogTypeSFA.PENDINGROLLUP, Nothing, Nothing)
                    DoAuthorityEvent = New DoPublishSFAEvent(AddressOf Me.PublishSFAEventUpdate)
                    DoAuthorityEvent.BeginInvoke(EventTypeSFA.PENDINGROLLUP, Nothing, Nothing)
                End If
                frmMessageBox.Dispose()
                frmMessageBox = Nothing

                If optUseSingleFormAuthorityVersionII Or optUseSingleFormAuthorityVersionCN Or optUseSingleFormAuthorityVersionMRL Or optUseSingleFormAuthorityVersionARRC OrElse optUseSingleFormAuthorityVersionNCTD Then
                    'CheckForItemFourOnlyComponents()
                    CheckForCriteriaSatifactionForOpposingSFAItemFourLimits(RollUpList)
                End If
                If gTrackIntegrityMonitoringExists Then
                    Dim tz As TrackZone
                    For Each tz In TrackZonesToCheck
                        tz.CheckToRemoveAlertFromAuthorityRelease(Me, False)
                        Dim trkToTest As Track
                        Dim ZoneExists As Boolean
                        For Each trkToTest In tz.TrackList
                            If Me.Components.Contains(trkToTest) Then
                                ZoneExists = True
                                Exit For
                            End If
                        Next
                        If Not ZoneExists Then
                            tz.UpdateZoneOverrideList(Me.AuthorityUID, Nothing, True, Nothing)
                        Else
                            ZoneExists = False
                        End If
                    Next
                End If


                ClearSelection()
                If optEnableOverviewForTWC Then
                    If Not IsNothing(gOverviewTWC) Then
                        If Me.Subdivision.Trim.ToUpper = gOverviewTWC.cmbSubs.Text.Trim.ToUpper Then
                            Dim SymboltoDelete As String = String.Empty

                            If Me.IssuedToTrain Then
                                SymboltoDelete = Mid(Me.IssueTo, 1, 10)
                            Else
                                Dim LastName() As String = Me.IssueTo.Split(",")
                                SymboltoDelete = LastName(0) & "-" & LastName(1)
                            End If

                            SyncLock gOverviewTWC.myQueue
                                'gOverviewTWC.myQueue.Enqueue("REFRESH")
                                gOverviewTWC.myQueue.Enqueue(SymboltoDelete & "|" & Me.IssuedToTrain & "|" & Me.AuthGUID.Trim)
                            End SyncLock
                        End If
                    End If
                End If

                'If optEnablePTCBOSAPIMode And (PTCTypeAuthority And TrainIsActivePTC) And gPTCTerritoryExists Then
                If optEnablePTCBOSAPIMode And RollUpYesSelected Then
                    TMDS.NetworkMessages.PTCBOSAPIMessaging.SendAuthorityRollUp(Me, RollUpList, RollUpEventPTCBOSAPIText)
                End If

                If optEnablePTCBOSAPIMode And (PTCTypeAuthority And TrainIsActivePTC) Then
                    Me.FlasherMode(True, True)
                End If

                If optUseSingleFormAuthorityVersionMRS Then
                    Dim trk As Track
                    Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(TrainSymbol)
                    trk = trn.myTrack
                    If Not trn Is Nothing AndAlso trk IsNot Nothing AndAlso optTWCOSEventType.Trim <> "" Then
                        trn.SendMRSTWCOSEvent(trk, Me.Direction) ' trn.SendTrainPositionEvent(trk, trk.myControlPoint, optTWCOSEventType.Trim.ToUpper)
                    End If

                End If
                If optEnableSFARollupReportClearPDF Then
                    Try
                        Dim docAuthority As New SFADocument()
                        Dim FileName As String = docAuthority.BuildWarrantDocument(Me)
                        If optPerformDocumentArchiving Then
                            Dim EntityUID As String
                            If Not Me.IssuedToTrain Then
                                EntityUID = Me.IssueTo
                            Else
                                EntityUID = Me.TrainSymbol
                                If EntityUID = "" Or EntityUID = "NONE" Then
                                    EntityUID = "UNKNOWN SYMBOL-IDUNIT:" & Me.IssueTo
                                End If
                            End If
                            Dim SubUID As Integer
                            If Not IsNothing(pTrackSelected.mySubdivision) Then
                                SubUID = pTrackSelected.mySubdivision.GUID
                            End If
                            Dim TerrUID As Integer = pTrackSelected.myTerritory.TerritoryID

                            TMDS.PrintForms.DocumentArchive.ArchiveTheDocument(FileName, "AUTHORITY-SFA-ROLLUP", EntityUID, TerrUID, SubUID)
                        End If
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    End Try
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSelection()
                messageListRollup.Add(optRollUpAuthorityString29 & Me.AuthorityUID)
                messageListRollup.Add(optRollUpAuthorityString30)
                messageListRollup.Add(optRollUpAuthorityString31)
                messageListRollup.Add(optRollUpAuthorityString32)
                ShowCustomMessageBox(messageListRollup, optSystemMessageString3, False, LaunchPoint, False, True, pTrackSelected.CurrentDrawingForm)
                Return False
            Finally
                EndOfWarrantFound = Nothing
                NextComp = Nothing
                CurrentComp = Nothing
                warr = Nothing
                LeftLimits = Nothing
                RightLimits = Nothing
                RollUpEventMessage = Nothing
                comp = Nothing
                OsLoggingTrack = Nothing
                EndOfAuthorityFound = Nothing
                ReportClearTimeFeedback = Nothing
                TrainIsActivePTC = Nothing
                RollUpYesSelected = Nothing
                RollupReadString = Nothing
                gHistoryMessage = Nothing
                TrackZonesToCheck = Nothing
                ReportTime = Nothing
                PTCBOSReportTime = Nothing
                FoundFlipFlop = Nothing
                DoAddAuthorityEvent = Nothing
                DoAuthorityEvent = Nothing
                rollupPending = Nothing
                messageListRollup = Nothing
            End Try
        End Function

        Private Function FoundExitTrackOfRollUpOutOfSwitch(ByVal sw As Switch, ByVal auth As SFAuthority, ByVal Direction As String, Optional RollupCompList As ArrayList = Nothing) As Track
            Try
                If Direction = "LEFT" Then
                    Dim comp As Object
                    If (Not sw.SwitchPointerMonitorMode And sw.TypeOfSwitch <> "SPM ONLY") Or (sw.SwitchPointerMonitorMode And sw.ProtectOpenSwitchEnabled) Then
                        If Not IsNothing(sw.OsComponentCollection) Then
                            For Each comp In sw.OsComponentCollection
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    Dim trk As Track = CType(comp, Track)
                                    Dim NextTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trk.LeftLink)
                                    If optEnableFXESpecificOptions AndAlso NextTrack Is Nothing Then
                                        Dim SPMSW As Object = FindCompFromGUID(trk.RightLink)
                                        If SPMSW IsNot Nothing AndAlso SPMSW.GetType.ToString = gSwitchComponentName AndAlso SPMSW.TypeOfSwitch = "SPM ONLY" Then
                                            NextTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(SPMSW.LeftLink)
                                        End If
                                    ElseIf optEnableMRSSpecificOptions AndAlso NextTrack IsNot Nothing AndAlso NextTrack.GetType.ToString = gTrackComponentName AndAlso NextTrack.NonTransverable Then
                                        NextTrack = Nothing
                                    End If
                                    If Not IsNothing(NextTrack) Then
                                        Dim sfa As SFAuthority
                                        For Each sfa In NextTrack.TrackAuthorities
                                            If sfa.AuthorityUID = auth.AuthorityUID Then
                                                If NextTrack.Name = trk.Name Then
                                                    If NextTrack.StationNumber <> trk.StationNumber Then
                                                        Return NextTrack
                                                    End If
                                                Else
                                                    Return NextTrack
                                                End If
                                            End If
                                        Next
                                    End If
                                End If
                            Next
                        End If
                    Else
                        Dim NextTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.LeftLink)
                        Return NextTrack
                    End If

                Else
                    Dim comp As Object

                    If (Not sw.SwitchPointerMonitorMode And sw.TypeOfSwitch <> "SPM ONLY") Or (sw.SwitchPointerMonitorMode And sw.ProtectOpenSwitchEnabled) Then
                        If Not IsNothing(sw.OsComponentCollection) Then
                            For Each comp In sw.OsComponentCollection
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    Dim trk As Track = CType(comp, Track)
                                    Dim NextTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trk.RightLink)
                                    If optEnableFXESpecificOptions AndAlso NextTrack Is Nothing Then
                                        Dim SPMSW As Object = FindCompFromGUID(trk.RightLink)
                                        If SPMSW IsNot Nothing AndAlso SPMSW.GetType.ToString = gSwitchComponentName AndAlso SPMSW.TypeOfSwitch = "SPM ONLY" Then
                                            NextTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(SPMSW.RightLink)
                                        End If
                                    ElseIf optEnableMRSSpecificOptions AndAlso NextTrack IsNot Nothing AndAlso NextTrack.GetType.ToString = gTrackComponentName AndAlso NextTrack.NonTransverable Then
                                        NextTrack = Nothing
                                    End If
                                    If Not IsNothing(NextTrack) Then
                                        Dim sfa As SFAuthority
                                        For Each sfa In NextTrack.TrackAuthorities
                                            If sfa.AuthorityUID = auth.AuthorityUID Then
                                                If NextTrack.Name = trk.Name Then
                                                    If NextTrack.StationNumber <> trk.StationNumber Then
                                                        Return NextTrack
                                                    End If
                                                Else
                                                    Return NextTrack
                                                End If
                                            End If
                                        Next
                                    End If
                                End If
                            Next
                        End If
                    Else
                        Dim NextTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.RightLink)
                        Return NextTrack
                    End If

                End If
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

