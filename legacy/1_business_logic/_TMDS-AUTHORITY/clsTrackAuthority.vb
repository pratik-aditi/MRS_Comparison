        ''' <summary>
        ''' Update Database With CompList
        ''' </summary>
        ''' <param name="pCallingMethod"></param>
        ''' <returns></returns>
        Public Function UpdateDatabaseWithCompList(ByVal pCallingMethod As String) As Boolean
            Dim query As String
            Dim dbConn As OleDbConnection = Nothing
            Dim dbComm As OleDbCommand = Nothing
            Dim comp As Object
            Dim compList As String = String.Empty
            Dim terrList As New ArrayList
            Dim terrID As Int32
            Dim index As Integer
            Dim trainName As String = "NONE"
            Try
                For Each comp In Me.ComponentsInSelection
                    If Not IsNothing(comp) Then
                        compList = compList & comp.GUID & "|"
                    End If
                Next
                Me.TerritoryAssignmentSecondary = 0
                Me.TerrIDTeritary = 0
                Me.TerrIDQuadtary = 0
                If compList.Count > 0 Then
                    For Each comp In ComponentsInSelection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If Not terrList.Contains(trk.TerritoryID) Then
                                terrList.Add(trk.TerritoryID)
                            End If
                        End If
                    Next
                Else
                    Return False
                End If
                For Each terrID In terrList
                    Select Case index
                        Case 0
                            Me.TerritoryAssignment = terrID
                            index = 1
                        Case 1
                            Me.TerritoryAssignmentSecondary = terrID
                            index = 2
                        Case 2
                            Me.TerrIDTeritary = terrID
                            index = 3
                        Case 3
                            Me.TerrIDQuadtary = terrID
                        Case Else
                    End Select
                Next
                dbConn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                query = "UPDATE  tblAuthoritiesActive SET "
                If Me.myTrain IsNot Nothing AndAlso Me.myTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain Then
                    query = query & "JointLimits = " & "'" & compList & "'"
                ElseIf Me.myTrain IsNot Nothing AndAlso Me.myTrain.TrainRegionStatus = TrainRegionEnum.InTrasition Then
                    query = query & "JointLimits = " & "''"
                    query = query & ",Components = " & "'" & compList & "'"
                Else
                    query = query & "Components = " & "'" & compList & "'"
                End If
                query = query & ",TerritoryAssignment = " & TerritoryAssignment
                query = query & ",TerritoryAssignmentSecondary = " & TerritoryAssignmentSecondary
                query = query & ",TerrIDTeritary = " & TerrIDTeritary
                query = query & ",TerrIDQuadtary = " & TerrIDQuadtary
                query = query & ",Direction = " & "'" & Direction & "'"
                query = query & ",AuthorityDate = " & "'" & DateTime.Now.ToString("MM/dd/yyyy HH:mm") & "'"
                query = query & " WHERE AuthGUID = '" & Me.AuthGUID & "'"
                dbComm = New OleDbCommand(query, dbConn)
                If Not IsNothing(Me.myTrain) Then
                    trainName = myTrain.Name
                End If
                AuthorityEventLog("UpdateDatabaseWithCompList:CallingMethod=" & ":" & pCallingMethod & ":Update=" & query)
                dbConn.Open()
                dbComm.ExecuteNonQuery()
                dbConn.Close()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If dbComm IsNot Nothing Then
                    dbComm.Dispose()
                    dbComm = Nothing
                End If
                If dbConn IsNot Nothing Then
                    dbConn.Dispose()
                    dbConn = Nothing
                End If
                query = Nothing
                comp = Nothing
                compList = Nothing
                terrList = Nothing
                terrID = Nothing
                index = Nothing
                trainName = Nothing
            End Try
        End Function

