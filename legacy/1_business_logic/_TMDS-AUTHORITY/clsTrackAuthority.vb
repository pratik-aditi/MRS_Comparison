        Private Delegate Sub DoEventLogDeviceBlock(ByVal EventType As EventTypeDevBlk)

        Public Sub LogTheDeviceBlockEvent(ByVal EventType As EventTypeDevBlk)
            Dim mySubDivision As Subdivision = Nothing
            Try
                Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.LastName & "," & TMDS.GlobalDeclarations.gCurrentUser.FirstName
                Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                Dim CurTerr As Territory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(Me.TerritoryAssignment)
                'Dim LogString As String = "INSERT INTO tblFunctionEvents "
                Dim LogString As String = "INSERT INTO tblSystemEvents "
                'Dim SqlFields As String = "(EventTime, Territory, Wrkstn, SysUser, DbVer, FuncType, UID, Event, SysData)"
                Dim SqlFields As String = "([EventTime], [Territory], [Wrkstn], [SysUser], [DbVer], [FuncType], [UID], [Event], [SysData])"
                Dim SqlValues As String
                Dim c As String = ", "
                Dim q As String = "'"
                Dim Message As String = String.Empty
                Message = Message & "|" & Me.AuthorityUID
                Message = Message & "|" & Me.AuthorityDate
                Message = Message & "|" & Me.AuthorityLimits
                Message = Message & "|" & Me.DispatcherName
                Message = Message & "|" & Me.IssueTo
                Message = Message & "|" & Me.BlockGUID
                Message = Message & "|" & Me.BlockNotes

                Dim comp As Object
                If Me.ComponentsInSelection IsNot Nothing AndAlso Me.ComponentsInSelection.Count > 0 Then
                    For Each comp In Me.ComponentsInSelection
                        If comp IsNot Nothing Then
                            Select Case comp.ToString
                                Case gTrackComponentName, gSwitchComponentName, gSignalComponentName
                                    mySubDivision = comp.mySubdivision
                                    Exit For
                            End Select
                        End If
                    Next
                End If
                comp = Nothing
                'Dim comp As Object
                Dim CompList As String = String.Empty
                For Each comp In Me.ComponentsInSelection
                    CompList = CompList & "-" & comp.GUID
                Next
                Message = Message & "|COMPONENTS" & CompList


                SqlValues = " VALUES (" & q & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & q & c & Me.TerritoryAssignment & c & CurWrkstn & c & q & CurUser & q & c
                SqlValues = SqlValues & q & CurTerr.Dbversion & q & c & q & "DEVICE-BLOCK" & q & c & q & Me.AuthorityUID & q & c

                Select Case EventType
                    Case EventTypeDevBlk.ADD
                        SqlValues = SqlValues & q & "ISSUED" & q & c & q
                        'SqlValues = SqlValues & Me.IssueTo & "|"
                        'SqlValues = SqlValues & Me.BlockNotes & "|"

                        'If Not Me.ComponentsInSelection Is Nothing Then
                        '    Dim comp As Object
                        '    For Each comp In Me.ComponentsInSelection
                        '        SqlValues = SqlValues & comp.GUID.ToString & ";"
                        '    Next
                        'End If
                        SqlValues = SqlValues & Message & q
                        SqlValues = SqlValues & ")"


                    Case EventTypeDevBlk.REMOVE
                        SqlValues = SqlValues & q & "REMOVE" & q & c & q & Message & q
                        SqlValues = SqlValues & ")"

                    Case EventTypeDevBlk.UPDATE
                End Select
                SyncLock TMDS.GlobalDeclarations.gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(LogString & SqlFields & SqlValues)
                End SyncLock

                Try
                    Dim docWarrant As New PrintDeviceBlockAuthority
                    Dim FileName As String = docWarrant.BuildDeviceBLKAuthorityDocument(Me, EventType)
                    If optPerformDocumentArchiving Then
                        Dim EntityUID As String
                        EntityUID = Me.IssueTo
                        Dim SubUID As Integer = 0
                        If Not IsNothing(mySubDivision) Then
                            SubUID = mySubDivision.GUID
                        End If
                        TMDS.PrintForms.DocumentArchive.ArchiveTheDocument(FileName, Me.AuthorityType.ToUpper.Trim & " - " & EventType.ToString, EntityUID, Me.TerritoryAssignment, SubUID)
                    End If
                Catch ex As Exception
                    GetErrorDetails(ex)
                End Try

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

#End Region

#Region "STATUS UPDATES"

        Private Delegate Sub DoPublishDeviceBlockEvent(ByVal EventType As EventTypeDevBlk)

        Public Sub PublishDeviceBlockEventUpdate(ByVal EventType As EventTypeDevBlk)
            Try
                Dim TerritoryAllowsPlanning As Boolean

                Dim Message As String = "DC" & Chr(6) & "DBLOCK;"

                'If this is a remote block need to check to see what territory to send
                Dim terr As Territory
                Dim TerritoryFound As Boolean
                Dim UseSecondaryterritory As Boolean
                For Each terr In TMDS.GlobalDeclarations.ControlledTerritories
                    If terr.TerritoryID = Me.TerritoryAssignment Then
                        TerritoryFound = True
                        TerritoryAllowsPlanning = terr.AllowMovementPlanning
                        Exit For
                    End If
                Next

                If Not TerritoryFound Then
                    For Each terr In TMDS.GlobalDeclarations.ControlledTerritories
                        If terr.TerritoryID = Me.TerritoryAssignmentSecondary Then
                            TerritoryFound = True
                            TerritoryAllowsPlanning = terr.AllowMovementPlanning
                            Exit For
                        End If

                    Next
                    If Not TerritoryFound Then
                        Message = Message & "|" & Me.TerritoryAssignment.ToString
                    Else
                        Message = Message & "|" & Me.TerritoryAssignmentSecondary.ToString
                        UseSecondaryterritory = True
                    End If
                Else
                    Message = Message & "|" & Me.TerritoryAssignment.ToString
                End If

                Select Case EventType
                    Case EventTypeDevBlk.ADD
                        Message = Message & "|" & "CREATE"
                    Case EventTypeDevBlk.REMOVE
                        Message = Message & "|" & "DELETE"
                    Case EventTypeDevBlk.UPDATE
                        Message = Message & "|" & "UPDATE"
                End Select

                Message = Message & "|" & Me.AuthorityUID
                Message = Message & "|" & Me.AuthorityDate
                Message = Message & "|" & Me.AuthorityLimits
                Message = Message & "|" & Me.DispatcherName
                Message = Message & "|" & Me.IssueTo
                Message = Message & "|" & Me.BlockGUID
                Message = Message & "|" & Me.BlockNotes
                Dim comp As Object
                Dim CompList As String = String.Empty
                For Each comp In Me.ComponentsInSelection
                    CompList = CompList & "-" & comp.GUID
                Next
                Message = Message & "|COMPONENTS" & CompList
                Message = Message & "|" & Me.OverrideFieldBlocking
                If Not UseSecondaryterritory Then
                    Message = Me.TerritoryAssignment.ToString & Chr(12) & Message
                    If TerritoryAllowsPlanning Then
                        PublishDeviceBlockEventForPlanning(EventType, Me.TerritoryAssignment)
                    End If
                Else
                    Message = Me.TerritoryAssignmentSecondary.ToString & Chr(12) & Message
                    If TerritoryAllowsPlanning Then
                        PublishDeviceBlockEventForPlanning(EventType, Me.TerritoryAssignmentSecondary)
                    End If
                End If
                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                End SyncLock
            Catch EX As Exception
                SystemException(EX.ToString)
            End Try
        End Sub

        Public Sub PublishDeviceBlockEventForPlanning(ByVal EventType As EventTypeDevBlk, ByVal TerrUID As Int32)
            Try
                Dim Message As String = "DC" & Chr(6) & "MPAR;DBLOCK;"
                Dim BlockData As New System.Text.StringBuilder

                Message = Message & "|" & TerrUID.ToString & "|"

                Select Case EventType
                    Case EventTypeDevBlk.ADD
                        Message = Message & "CREATE"
                    Case EventTypeDevBlk.REMOVE
                        Message = Message & "DELETE"
                    Case EventTypeDevBlk.UPDATE
                        Message = Message & "UPDATE"
                End Select

                BlockData.Append("|")
                BlockData.Append(Mid(Me.BlockGUID.Replace("-", ""), 1, 6))
                BlockData.Append("|")
                BlockData.Append(Me.IssueTo)
                BlockData.Append("|")
                BlockData.Append(Me.UntilTime)
                BlockData.Append("|")

                Dim comp As Object
                Dim CompList As String = String.Empty
                Dim Count As Integer
                Dim d As String = String.Empty
                Dim CompData As String = String.Empty
                For Each comp In Me.ComponentsInSelection

                    If Count > 0 Then
                        d = "#"
                    End If
                    Count = 1
                    If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        Dim sw As Switch = CType(comp, Switch)
                        CompData = CompData & d & sw.GUID.ToString & "-" & sw.ControlledReverse.ToString
                    Else
                        CompData = CompData & d & comp.GUID.ToString & "-NONE"
                    End If
                Next
                BlockData.Append(CompData)

                Message = Message & "|" & BlockData.ToString
                Message = Message & "|" & Me.OverrideFieldBlocking
                Message = TerrUID.ToString & Chr(12) & Message

                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                End SyncLock

                UpdateDatabaseWithBlockData(BlockData.ToString)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub UpdateDatabaseWithBlockData(ByVal BlockData As String)
            Try
                Dim Update As New System.Text.StringBuilder
                Update.Append(" UPDATE tblDeviceBlocksActive")
                Update.Append(" SET BlockData = '")
                Update.Append(BlockData)
                Update.Append("' WHERE BlockGUID = '")
                Update.Append(Me.BlockGUID)
                Update.Append("'")
                SystemDatabaseCommandToDynamic("DBLOCK:UpdateDatabaseWithBlockData", Update.ToString)

            Catch EX As Exception
                SystemException(EX.ToString)
            End Try
        End Sub

