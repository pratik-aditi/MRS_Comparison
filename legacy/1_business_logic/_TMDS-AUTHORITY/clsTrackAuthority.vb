        Private Function FindObjectTypeFromGUID(ByVal UniqueID As Int32) As Object
            'This function finds the current trackcomponent index from the global unique ID
            Try

                Dim I As Integer
                For I = 1 To UBound(TrackComponent)
                    If TrackComponent(I).GUID = UniqueID Then
                        FindObjectTypeFromGUID = TrackComponent(I)
                        Exit Function
                    End If
                Next I

                For I = 1 To UBound(SwitchComponent)
                    If SwitchComponent(I).GUID = UniqueID Then
                        FindObjectTypeFromGUID = SwitchComponent(I)
                        Exit Function
                    End If
                Next I

                For I = 1 To UBound(SignalComponent)
                    If SignalComponent(I).GUID = UniqueID Then
                        FindObjectTypeFromGUID = SignalComponent(I)
                        Exit Function
                    End If
                Next I
                Return Nothing

            Catch ex As Exception
                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
                Return Nothing
            End Try

        End Function

        Private Sub SelectionTimer_tick(ByVal sender As Object, ByVal e As EventArgs) Handles SelectionTimer.Tick

            Dim comp As Object

            Try
                If SelectionFlash Then
                    SelectionFlash = False
                Else
                    SelectionFlash = True
                End If


                For Each comp In SelectionCollection
                    SyncLock comp
                        If comp.GetType.ToString <> "TMDS.SwitchComponents.Switch" And comp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                        Else
                            comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.SummarySelectionBlocking
                            comp.FlashComponent = True
                            comp.FlashOn = SelectionFlash
                            comp.Refresh()
                        End If
                    End SyncLock

                Next
                SelectionTimer.Enabled = True
            Catch ex As Exception
                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            End Try
        End Sub

        Private Sub ClearSelection()
            Dim comp As Object

            Try
                For Each comp In SelectionCollection
                    SyncLock comp
                        If comp.GetType.ToString <> "TMDS.SwitchComponents.Switch" And comp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                            'comp.Graphical.FillPath(FlashColor, comp.GraphicalPath)
                        Else
                            comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                            comp.FlashComponent = False
                            comp.FlashOn = False
                            comp.Refresh()
                        End If
                    End SyncLock

                Next
                SelectionTimer.Enabled = False
                SelectionFlash = False
                SelectionCollection = Nothing
                SelectionCollection = New ArrayList()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

