                                End If
                            Next
                        Next
                        '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
                        'NEW VETMS PTC ROLL UP CODE 08-02-11
                        If optEnablePTCBOSVETMSMode And (PTCTypeAuthority And TrainIsActivePTC) Then
                            PTCtrn = TMDS.SystemUtilities.FetchData.FindTrainFromIssueToAuthority(Me.IssueTo)
                            Me.PTCMarkedToBeRolledUpElectronically = True
                            Me.tmpPTCRollupAuthorityText = RollUpEventText
                            VETMS_PerformRollup(PTCtrn, RollUpEventText, RollUpList)

                            Do Until PTCRollupSuccessful Or PTCRollupTimeExpired
                                Threading.Thread.Sleep(100)
                                Application.DoEvents()
                            Loop

                            If Not PTCRollupSuccessful Then
                                SystemEvent("PTC REQUEST TO RELEASE TRACK FAILED:" & Me.AuthorityUID)
                                'REDRAW THE IDS IF ROLLUP IS CANCELLED TO CLEAN UP GRAPHICS
                                For Each comp In RollUpList
                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        comp.InvalidateTrainID()
                                        comp.InvalidateMOWID()
                                    End If
                                Next
                                frmMessageBox.Dispose()
                                frmMessageBox = Nothing
                                ClearSelection()
                                VETMS_TerminatePTCRollupProcess()
                                Return False
                            Else
                                VETMS_TerminatePTCTimerRollup()
                                Me.PTCMarkedToBeRolledUpElectronically = False
                                Me.PTCRollupTimeExpired = False
                                Me.PTCRollupSuccessful = False
                            End If
                        End If
                        'NEW VETMS PTC ROLL UP CODE 08-02-11
                        '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
                    Else
                        'TrainIsActivePTC = frmMessageBox.PTCTrainStatus
                        Boolean.TryParse(frmMessageBox.PTCTrainStatus, TrainIsActivePTC)

                        'If optEnablePTCBOSAPIMode And (PTCTypeAuthority And TrainIsActivePTC) And gPTCTerritoryExists Then
                        If optEnablePTCBOSAPIMode And (PTCTypeAuthority And TrainIsActivePTC) Then
                            Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ROLLUP.ToString
                            Dim comp1 As Object
                            For Each comp1 In RollUpList
                                Me.PTCAuthorityComponents.Add(comp1)
                            Next
                            'Me.PTCAuthorityComponents = Me.RollUpList
                            'TMDS.NetworkMessages.PTCBOSAPIMessaging.SendAuthorityRollUp(Me, RollUpList)
                            Me.UpdateDatabaseWithPTCComponents()
                            'Me.FlasherMode(True, True)
