#Region "AUTHORITY ADD/REMOVE"

        Public Function RemoveActiveTrackWarrantFromComponents(ByVal dbConnection As OleDbConnection) As Boolean
            Dim comp As Object
            Dim strPosition, EngineID As String
            'Dim trk As Track
            Try
                strPosition = InStr(IssueTo, "EAST")
                If strPosition = 0 Then
                    strPosition = InStr(IssueTo, "WEST")
                    If strPosition = 0 Then
                        strPosition = InStr(IssueTo, "NORTH")
                        If strPosition = 0 Then
                            strPosition = InStr(IssueTo, "SOUTH")
                        End If
                    End If
                End If

                If strPosition > 0 Then
                    EngineID = Trim(Mid(IssueTo, 1, strPosition - 1))
                Else
                    EngineID = IssueTo
                End If

                For Each comp In SelectionComponents
                    comp.Authorities.Remove(Me)
                    comp.UpdateStatus()
                    comp.InitAuthorityNumbers()
                    'SystemForms.MySystemForms.frmDisplay.Invalidate(comp.AuthNumberRegion)
                Next

                Dim UserMessage As Integer
                Dim IDterminated As Boolean
                If Me.WarrantType = "ItemTwoToTrain" Or Me.WarrantType = "ItemFourToTrain" Then
                    For Each comp In SelectionComponents
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If comp.TrainIDs.Count > 0 Then
                                Dim trn As TrainID
                                For Each trn In comp.TrainIDs
                                    If trn.IdentifingUnit = EngineID Then
                                        Dim NextComp As Object
                                        If Direction = "RIGHT" Then
                                            NextComp = FindObjectTypeFromGUID(comp.RightLink)
                                        Else
                                            NextComp = FindObjectTypeFromGUID(comp.LeftLink)
                                        End If

                                        If Not NextComp Is Nothing Then

                                            If NextComp.AuthorityType = "NON-TWC" Then
                                                UserMessage = MsgBox("ENGINE ID " & EngineID & " FOUND FOR WARRANT. DO YOU WANT TO MOVE TO SIDING?", MsgBoxStyle.YesNo, "RELEASE TRAIN ID")
                                                If UserMessage = 6 Then
                                                    comp.MoveTrainIDPlace(trn, comp)
                                                    comp.InvalidateTrainID()
                                                    IDterminated = True
                                                End If
                                            End If
                                        End If

                                        If Not IDterminated Then
                                            Dim TrainFinalled As Boolean
                                            If optPromptToFinalTrainOnReportClear Then
                                                UserMessage = MsgBox("ENGINE ID " & EngineID & " FOUND FOR WARRANT. DO YOU WANT TO FINAL TRAIN?", MsgBoxStyle.YesNo, "RELEASE TRAIN ID")
                                                If UserMessage = 6 Then
                                                    comp.FinalTrainID(trn, TrainCollection)
                                                    comp.InvalidateTrainID()
                                                    SystemForms.MySystemForms.frmSystemSummary.UpdateTrainSummaries()
                                                    TrainFinalled = True
                                                End If
                                            End If
                                            If Not DoesWarrantExistForTrains(trn) And Not TrainFinalled Then
                                                UserMessage = MsgBox("ENGINE ID " & EngineID & " FOUND FOR WARRANT. DO YOU WANT TO RELEASE TRAIN?", MsgBoxStyle.YesNo, "RELEASE TRAIN ID")
                                                If UserMessage = 6 Then
                                                    comp.ReleaseTrainID(TrainCollection)
                                                    comp.InvalidateTrainID()
                                                    SystemForms.MySystemForms.frmSystemSummary.UpdateTrainSummaries()
                                                End If
                                                'End If
                                            End If
                                        End If
                                        Exit For
                                    End If
                                Next
                            End If
                        End If
                    Next
                ElseIf Me.WarrantType = "ItemTwoToMOW" Or Me.WarrantType = "ItemFourToMOW" Then
                    For Each comp In SelectionComponents
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Try
                                Dim mow As MOWID
                                For Each mow In comp.MOWIDs
                                    If mow.Name = Me.IssueTo Then
                                        UserMessage = MsgBox("MOW ID FOUND FOR WARRANT:" & Me.IssueTo & ". DO YOU WANT TO RELEASE MOW ID?", MsgBoxStyle.YesNo, "RELEASE MOW ID")
                                        If UserMessage = 6 Then
                                            Dim trk As Track = CType(comp, Track)
                                            trk.ReleaseMOWID(mow)
                                            trk.InvalidateMOWID()
                                            Exit For
                                        End If
                                    End If
                                Next
                            Catch ex As Exception
                                SystemException(ex.ToString)
                            End Try
                        End If
                    Next
                End If
                'SystemForms.MySystemForms.frmDisplay.Invalidate()
                Dim Message As String = "TRACK WARRANT REMOVED FROM DATABASE TRACK COMPONENTS:" & Me.WarrantNumber.ToString
                TMDS.SystemUtilities.Utilities.SystemEvent(Message)

                RemoveActiveTrackWarrantFromComponents = True
            Catch ex As Exception
                SystemException(ex.ToString)
                RemoveActiveTrackWarrantFromComponents = False
            End Try

        End Function

        Public Function AddTrackWarrantNewToSystem(ByVal frmTW As frmTrackWarrantNew, ByVal VoidedWarrantByThisOne As Warrant) As Boolean

            Try
                Dim I As Integer
                Me.RadioBlockingUsed = frmTW.RadioBlockingEnabled
                Me.CurrentTimeZone = frmTW.CurrentTimeZone
                RailRoadName = frmTW.RailwayName
                DispatcherName = frmTW.DispName
                'CreateDate = CDate(frmTW.lblCreateDate.Text)
                CreateTime = Now 'CDate(frmTW.lblCreateTime.Text)
                WarrantNumber = CInt(frmTW.txtTWnum.Text)
                Direction = frmTW.DirectionOfTheWarrant
                Subdivision = frmTW.txtSubdivision.Text
                WarrantDate = CDate(frmTW.txtDate.Text)
                WarrantType = frmTW.FirstTypeOfWarrant
                IssueTo = frmTW.txtIssueTo.Text
                AtLocation = frmTW.txtAtLocation.Text
                Box1Void = frmTW.TextBoxArrayList(1).Text
                Box2From = frmTW.TextBoxArrayList(2).Text
                Box2To = frmTW.TextBoxArrayList(3).Text
                Box2Track = frmTW.TextBoxArrayList(4).Text
                Box3From = frmTW.TextBoxArrayList(5).Text
                Box3To = frmTW.TextBoxArrayList(6).Text
                Box3Track = frmTW.TextBoxArrayList(7).Text
                Box4From = frmTW.TextBoxArrayList(8).Text
                Box4To = frmTW.TextBoxArrayList(9).Text
                Box4Track = frmTW.TextBoxArrayList(10).Text
                Box7Arrival = frmTW.TextBoxArrayList(11).Text
                Box7At = frmTW.TextBoxArrayList(12).Text
                Box9Train = frmTW.TextBoxArrayList(13).Text
                Box11From = frmTW.TextBoxArrayList(14).Text
                Box11To = frmTW.TextBoxArrayList(15).Text
                For I = 0 To 3
                    Box12JntName(I) = frmTW.TextBoxArrayList(16 + (I * 3)).Text
                    Box12FromLoc(I) = frmTW.TextBoxArrayList(17 + (I * 3)).Text
                    Box12ToLoc(I) = frmTW.TextBoxArrayList(18 + (I * 3)).Text
                    Box12Track(I) = "NONE"
                Next
                Box13MPH = Trim(frmTW.TextBoxArrayList(28).Text)
                Box13From = frmTW.TextBoxArrayList(29).Text
                Box13To = frmTW.TextBoxArrayList(30).Text
                Box13Track = frmTW.TextBoxArrayList(31).Text
                Box14MPH = Trim(frmTW.TextBoxArrayList(32).Text)
                Box14From = frmTW.TextBoxArrayList(33).Text
                Box14To = frmTW.TextBoxArrayList(34).Text
                Box14Track = frmTW.TextBoxArrayList(35).Text
                Box15MP = frmTW.TextBoxArrayList(36).Text
                Box15Loc = frmTW.TextBoxArrayList(37).Text

                Box16Bulletins = frmTW.TextBoxArrayList(38).Text()

                Box17Instructions = frmTW.TextBoxArrayList(39).Text()

                Dim BoxTwentySwitch As String
                For Each BoxTwentySwitch In frmTW.BoxTwentySwitches
                    Box20.Add(BoxTwentySwitch)
                Next

                Dim BoxTwentyOneSwitch As String
                For Each BoxTwentyOneSwitch In frmTW.BoxTwentyOneSwitches
                    Box21.Add(BoxTwentyOneSwitch)
                Next

                Box22Items = frmTW.TextBoxArrayList(43).Text
                If Trim(frmTW.TextBoxArrayList(42).Text) <> "" Then
                    If IsNumeric(frmTW.TextBoxArrayList(42).Text) Then
                        NumOfBoxesChecked = CInt(frmTW.TextBoxArrayList(42).Text)
                    Else
                        NumOfBoxesChecked = 0
                    End If
                Else
                    NumOfBoxesChecked = 0
                End If
                If NumOfBoxesChecked = 0 Then
                    ClearSystemVariables()
                    MsgBox("Error In Track Warrant Built!", MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                    Exit Function
                End If
                OKTime = CDate(frmTW.txtOKTIME.Text & " " & Format(Now, "MM/dd/yyyy"))
                GeneralOrder = frmTW.txtGO.Text
                SuperintendentNote = frmTW.txtCTO.Text
                CopiedBy = frmTW.txtCOPIED.Text
                RelayedTo = "       "
                TerritoryAssignment = frmTW.TerritoryIDAssignment

                'New Box Eleven restriction code
                Dim comp As Object
                For Each comp In frmTW.BoxElevenComponents
                    Me.BoxElevenComponents.Add(comp)
                Next
                Dim CompBoxEleven As Object
                For Each CompBoxEleven In BoxElevenComponents
                    CompBoxEleven.BoxElevenRestriction = True
                Next
                'New Box Eleven restriction code

                If frmTW.FirstTrackSelection.Count > 0 Then
                    Dim CompToAdd As Object
                    For Each CompToAdd In frmTW.FirstTrackSelection
                        SelectionComponents.Add(CompToAdd)
                    Next
                Else
                    Return False
                End If

                If Not frmTW.SecondTrackSelection Is Nothing Then
                    If frmTW.SecondTrackSelection.Count > 0 Then
                        Dim CompToAdd As Object
                        For Each CompToAdd In frmTW.SecondTrackSelection
                            SelectionComponentsSecondary.Add(CompToAdd)
                        Next
                    Else
                        Return False
                    End If

                End If

                For I = 1 To 22
                    CheckBox(I) = CInt(frmTW.CheckBoxArrayList(I).Checked)
                Next
                ''****************************************************************************************
                ''**   ADD AUTHORITY WARRANT TO TRACKS
                ''*****************************************************************************************

                Dim ThisWarrantReplacingAnother As Boolean
                If Not VoidedWarrantByThisOne Is Nothing Then
                    ThisWarrantReplacingAnother = True
                End If


                If frmTW.FirstTrackSelection.Count > 0 Then
                    Dim AddTWtoComp As Object
                    Dim WarrantFoundToInsert As Boolean
                    If ThisWarrantReplacingAnother Then
                        For Each AddTWtoComp In frmTW.FirstTrackSelection
                            If AddTWtoComp.Authorities.Count > 0 Then
                                Dim warr As Warrant
                                For Each warr In AddTWtoComp.Authorities
                                    If warr.WarrantNumber = VoidedWarrantByThisOne.WarrantNumber Then
                                        AddTWtoComp.Authorities.Insert(AddTWtoComp.Authorities.IndexOf(VoidedWarrantByThisOne), Me)
                                        AddTWtoComp.UpdateStatus()
                                        WarrantFoundToInsert = True
                                        Exit For
                                    End If
                                Next

                                If Not WarrantFoundToInsert Then
                                    AddTWtoComp.Authorities.Add(Me)
                                    AddTWtoComp.UpdateStatus()
                                Else
                                    WarrantFoundToInsert = False
                                End If
                            Else
                                AddTWtoComp.Authorities.Add(Me)
                                AddTWtoComp.UpdateStatus()
                            End If
                            If AddTWtoComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If gDisplayTrackAuthorityNumbers Then
                                    Dim trk As Track = CType(AddTWtoComp, Track)
                                    trk.InitAuthorityNumbers()
                                End If
                            End If

                        Next
                    Else
                        For Each AddTWtoComp In frmTW.FirstTrackSelection
                            AddTWtoComp.Authorities.Add(Me)
                            AddTWtoComp.UpdateStatus()
                            If AddTWtoComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If gDisplayTrackAuthorityNumbers Then
                                    Dim trk As Track = CType(AddTWtoComp, Track)
                                    trk.InitAuthorityNumbers()
                                End If
                            End If

                        Next
                    End If
                Else
                    Return False
                End If

                If Not frmTW.SecondTrackSelection Is Nothing Then
                    Dim AddTWtoComp As Object
                    Dim WarrantFoundToInsert As Boolean
                    If frmTW.SecondTrackSelection.Count > 0 Then
                        If ThisWarrantReplacingAnother Then
                            For Each AddTWtoComp In frmTW.FirstTrackSelection
                                If AddTWtoComp.Authorities.Count > 0 Then
                                    Dim warr As Warrant
                                    For Each warr In AddTWtoComp.Authorities
                                        If warr.WarrantNumber = VoidedWarrantByThisOne.WarrantNumber Then
                                            AddTWtoComp.Authorities.Insert(AddTWtoComp.Authorities.IndexOf(VoidedWarrantByThisOne), Me)
                                            AddTWtoComp.UpdateStatus()
                                            WarrantFoundToInsert = True
                                            Exit For
                                        End If
                                    Next
                                    If Not WarrantFoundToInsert Then
                                        AddTWtoComp.Authorities.Add(Me)
                                        AddTWtoComp.UpdateStatus()
                                    Else
                                        WarrantFoundToInsert = False
                                    End If
                                Else
                                    AddTWtoComp.Authorities.Add(Me)
                                    AddTWtoComp.UpdateStatus()
                                End If

                                If AddTWtoComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If gDisplayTrackAuthorityNumbers Then
                                        Dim trk As Track = CType(AddTWtoComp, Track)
                                        trk.InitAuthorityNumbers()
                                    End If
                                End If

                            Next
                        Else
                            For Each AddTWtoComp In frmTW.SecondTrackSelection
                                AddTWtoComp.Authorities.Add(Me)
                                AddTWtoComp.UpdateStatus()
                                If AddTWtoComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If gDisplayTrackAuthorityNumbers Then
                                        Dim trk As Track = CType(AddTWtoComp, Track)
                                        trk.InitAuthorityNumbers()
                                    End If
                                End If

                            Next
                        End If
                    Else
                        Return False
                    End If

                End If


                TrackWarrants.Add(Me)
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Dim ErrorMessage As String = "Error Adding Track Warrant To System. CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                SystemForms.MySystemForms.frmTrackWarrant.Close()
                ClearSystemVariables()
                Return False
            End Try
        End Function

