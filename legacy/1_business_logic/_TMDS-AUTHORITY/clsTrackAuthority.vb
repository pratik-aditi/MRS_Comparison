        Private Function UpdatePTCRollupTextCRC() As Boolean
            Dim strPTCTxt() As String
            Dim S As String = ""
            Dim arrPTCtxt As New ArrayList
            Dim NewstrPTCTxt As New StringBuilder
            Try
                strPTCTxt = Me.PTCAuthorityText.Split("|")
                For Each S In strPTCTxt
                    arrPTCtxt.Add(S)
                Next
                arrPTCtxt.Add(String.Empty)
                arrPTCtxt.Add(Me.PTCReducedRollEventText)
                If arrPTCtxt IsNot Nothing AndAlso arrPTCtxt.Count > 0 Then
                    S = ""
                    For Each S In arrPTCtxt
                        With NewstrPTCTxt
                            .Append(S)
                            .Append("|")
                        End With
                    Next
                    Me.PTCAuthorityText = NewstrPTCTxt.ToString
                End If
                Me.UpdatePTCTxt_Segment_Contigency_Compostion(arrPTCtxt, Me.PTCRestrictionText, PTCContingencySegments)
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function
