                                        sw1.ControlSwitch()
                                        sw1.UpdateSwitchPositionInDatabase(TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
                                    End If
                                    'Else
                                    '    Return False
                                    'End If
                                    'sw1.UpdateSwitchPositionInDatabase(TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
                                    If Not sw1.ApplyDeviceBlockFromSwitch("POS", optRollUpAuthorityString22 & Me.AuthorityUID) Then
