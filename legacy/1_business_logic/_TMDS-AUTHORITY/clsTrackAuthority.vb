        Public Function DeviceBlockDuplicateCheck() As Boolean
            Try
                Dim dv As DeviceBlock
                For Each dv In TMDS.GlobalDeclarations.gDeviceBlocks
                    If Trim(dv.BlockGUID) = Trim(Me.BlockGUID) Then
                        Return False
                    End If
                Next
                Return True
