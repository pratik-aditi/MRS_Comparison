                                Dim theSw As Switch
                                For Each theSw In ReverseSwitchList
                                    If theSw.ControlledReverse Then
                                        theSw.ControlSwitch()
                                        theSw.UpdateSwitchPositionInDatabase(TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
                                    End If
                                Next
                            End If
                        End If
                    End If
                    SystemEvent(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO ROLLUP CONFIRMATION")
                    'RollUpEventMessage = "TIME:" & Now & vbCrLf
                    RollUpEventMessage = RollUpEventMessage & LeftLimits & "|" & RightLimits & "|"
                    For Each comp In RollUpList
                        RollUpEventMessage = RollUpEventMessage & comp.GUID & "-"
                    Next

                    RollUpEventMessage = RollUpEventMessage & "|" & RollupReadString & "|" & PTCBOSReportTime

                    If optEnableSFARollupEventDate Then
                        RollUpEventMessage = RollUpEventMessage & "|" & Format(NewReportTime, "MM-dd-yyyy HH:mm") 'NewReportTime.ToString
                    End If

                    'RollUpEvent.Add(RollUpEventMessage)
                    SystemEvent(Me.AuthorityUID & " ROLL UP EVENT DATA:" & RollUpEventMessage)
                    Me.RollUpEvents.Add(RollUpEventMessage)
                    Me.CurrentRollUpEvent = RollUpEventMessage

                    'Find a TrainID to move to Roll Up Track
                    Dim RollUpTrn As TrainID = Nothing
                    Dim TrnFound As Boolean
                    Dim pEngineID As String

                    If Me.AuthType1 = "ItemTwoToTrain" Or Me.AuthType1 = "ItemFourToTrain" Then
                        Dim trk As Track
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                trk = comp
                                If trk.TrainIDs.Count > 0 Then
                                    Dim strPosition As Integer
                                    strPosition = InStr(IssueTo, optDirectionEast)
                                    If strPosition = 0 Then
                                        strPosition = InStr(IssueTo, optDirectionWest)
                                        If strPosition = 0 Then
                                            strPosition = InStr(IssueTo, optDirectionNorth)
                                            If strPosition = 0 Then
                                                strPosition = InStr(IssueTo, optDirectionSouth)
                                            End If
                                        End If
                                    End If

                                    If strPosition > 0 Then
                                        pEngineID = Trim(Mid(IssueTo, 1, strPosition - 1))
                                    Else
                                        pEngineID = Trim(IssueTo)
                                    End If

                                    Dim EngineMatches As Boolean
                                    Dim trn As TrainID
                                    For Each trn In trk.TrainIDs
                                        If InStrRev(trn.IdentifingUnit, pEngineID) <> 0 Then
                                            EngineMatches = True
                                            RollUpTrn = trn
                                            Exit For
                                        End If

                                    Next
                                    If Not EngineMatches AndAlso RollUpTrn Is Nothing AndAlso optUseSingleFormAuthorityVersionMRS Then
                                        For Each trn In trk.TrainIDs
                                            If InStrRev(trn.Name, pEngineID) <> 0 Then
                                                EngineMatches = True
                                                RollUpTrn = trn
                                                Exit For
                                            End If

                                        Next
                                    End If

                                    If EngineMatches Then
                                        If optEnableLogOSOnAllTWCMoves Then
                                            pTrackSelected.MoveTrainIDPlaceManual(RollUpTrn, trk, False, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic, False, False, ReportClearTimeFeedback)
                                        Else
                                            pTrackSelected.MoveTrainIDPlaceManual(RollUpTrn, trk, True, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic, False, False, ReportClearTimeFeedback)
                                        End If
                                        RollUpTrack = pTrackSelected
                                        TrnFound = True
                                        Exit For
                                    End If
                                End If
                                trk = Nothing
                            End If

                        Next

                        If Not TrnFound And Me.IssuedToTrain Then
                            Dim TrnToMove As TrainID = GetTrainFromUnitID(IssueTo) 'TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(Mid(Me.IssueTo, 1, 10))
                            If Not IsNothing(TrnToMove) Then
                                If Not TrnToMove.ReadOnlySymbol And Not optDisableTrainMovePromptOnAuthorityRelease Then
                                    Dim frmRollUpTrn As New frmMessageBox()
                                    Dim RollUpListVerb As New ArrayList()
                                    RollUpListVerb.Add("DO YOU WANT TO MOVE THE TRAIN SYMBOL?")
                                    RollUpListVerb.Add("")
                                    RollUpListVerb.Add("TRAIN: (" & TrnToMove.Name & ")")
                                    RollUpListVerb.Add("ENGINE: (" & TrnToMove.IdentifingUnit & ")")
                                    RollUpListVerb.Add("")

                                    frmRollUpTrn.Owner = pTrackSelected.CurrentDrawingForm
                                    frmRollUpTrn.SetMessage(RollUpListVerb, "MOVE TRAIN SYMBOL CONFIRMATION", True, LaunchPoint)
                                    frmRollUpTrn.ShowDialog()
                                    If frmRollUpTrn.FormFeedBack = 6 Then
                                        pTrackSelected.MoveTrainIDPlaceManual(TrnToMove, TrnToMove.myTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                                        RollUpTrack = pTrackSelected
                                    End If
                                    frmRollUpTrn.Dispose()
                                    frmRollUpTrn = Nothing
                                ElseIf optDisableTrainMovePromptOnAuthorityRelease Then
                                    If optEnableARRCSpecificOptions Then
                                        pTrackSelected.MoveTrainIDPlaceManual(TrnToMove, TrnToMove.myTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                                        RollUpTrack = pTrackSelected
                                    Else
                                        pTrackSelected.MoveTrainIDPlaceManual(TrnToMove, TrnToMove.myTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                                        RollUpTrack = pTrackSelected
                                    End If

                                End If
                            End If
                        End If

                        'Dim trn1 As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(Mid(Me.IssueTo, 1, 10))
                        Dim trn1 As TrainID = GetTrainFromUnitID(IssueTo)
                        Dim ValidOSTrack As Track = Nothing


                        If Not IsNothing(OsLoggingTrack) And Not optEnableLogOSOnAllTWCMoves Then
                            If Not IsNothing(trn1) Then
                                Dim LastOsTrackFound As Track = Nothing
                                '***COMMENTED THIS OUT TO FIX BNSF P1-4857
                                'If IsNothing(OsLoggingTrack) Then
                                For Each comp In RollUpList
                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        Dim t As Track = CType(comp, Track)
                                        If t.OStype And IsNothing(LastOsTrackFound) Then
                                            LastOsTrackFound = t
                                        End If
                                    End If
                                Next

                                If IsNothing(LastOsTrackFound) Then
                                    If OsLoggingTrack.OStype Then
                                        LastOsTrackFound = OsLoggingTrack
                                    End If
                                End If
                                Dim EntryTrack As Track = FindEntryTrack(OsLoggingTrack, trn1)
                                If Not IsNothing(LastOsTrackFound) Then
                                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessage(trn1, gCadTransmitQueue, LastOsTrackFound, EntryTrack, OsLoggingTrack, "A")
                                    trn1.OSPreviousControlPoint = LastOsTrackFound.myControlPoint
                                    trn1.OSPreviousTrack = LastOsTrackFound
                                    OsLoggingTrack.LogOsMessage(ReportClearTimeFeedback, False, trn1)
                                End If

                            End If
                        ElseIf optEnableLogOSOnAllTWCMoves Then
                            If IsNothing(RollUpTrack) Then
                                RollUpTrack = pTrackSelected
                            End If
                            If Not IsNothing(trn1) Then
                                'RollUpTrack.LogOsMessage(ReportClearTimeFeedback, False, trn1)
                                Dim IgnoreRollupOS As Boolean = False
                                If optEnableARRCSpecificOptions AndAlso trn1.myLocomotiveReport IsNot Nothing AndAlso Not String.IsNullOrEmpty(trn1.myLocomotiveReport.MilePost) Then
                                    IgnoreRollupOS = True
                                    SystemEvent("TRAIN TRACKING: TWCROLLUP - OS IGNORED -  " & Me.AuthorityUID)
                                ElseIf optEnableARRCSpecificOptions AndAlso trn1 IsNot Nothing Then

                                End If

                                If optEnableSendOSMessageFXE Then
                                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessageFXE(trn1, gCadTransmitQueue, RollUpTrack, True)
                                ElseIf optEnableSendOSMessageARRC AndAlso Not IgnoreRollupOS Then
                                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessageARRC(trn1, gMISTransmitQueue, RollUpTrack, False, ValidOSTrack, ReportTime.ToString)
                                ElseIf optEnableSendOSMessageMRL Then
                                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessageMRL(trn1, gCadTransmitQueue, RollUpTrack)
                                ElseIf optEnableSendOSMessageCN Then
                                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessageCN(trn1, gCadTransmitQueue, RollUpTrack, False)
                                Else
                                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessage(trn1, gCadTransmitQueue, RollUpTrack, Nothing, Nothing, "A")
                                End If

                                If optEnableARRCSpecificOptions AndAlso ValidOSTrack IsNot Nothing Then
                                    If Not IgnoreRollupOS Then
                                        Dim UseTrackSelectedForOS As Boolean = True
                                        If RollUpTrack.GUID <> ValidOSTrack.GUID AndAlso trn1.OSPreviousTrack IsNot Nothing AndAlso trn1.OSPreviousTrack.GUID <> ValidOSTrack.GUID Then
                                            Dim SW As Switch = Nothing
                                            Dim MyAuth As Object = Nothing
                                            Try
                                                SW = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(ValidOSTrack)
                                                If SW IsNot Nothing Then
                                                    UseTrackSelectedForOS = trn1.CheckOSEventExists(SW.Name)
                                                End If
                                                If Not UseTrackSelectedForOS Then
                                                    MyAuth = Me.FindAuthority(ValidOSTrack)
                                                    If MyAuth Is Nothing Then
                                                        UseTrackSelectedForOS = True
                                                    ElseIf MyAuth.AuthorityUID <> Me.AuthorityUID Then
                                                        UseTrackSelectedForOS = True
                                                    End If
                                                End If
                                            Catch ex As Exception
                                                UseTrackSelectedForOS = True
                                            Finally
                                                SW = Nothing
                                                MyAuth = Nothing
                                            End Try
                                        End If
                                        If UseTrackSelectedForOS Then
                                            trn1.OSPreviousControlPoint = RollUpTrack.myControlPoint
                                            trn1.OSPreviousTrack = RollUpTrack
                                            RollUpTrack.LogOsMessage(ReportClearTimeFeedback, False, trn1)
                                        Else
                                            trn1.OSPreviousControlPoint = ValidOSTrack.myControlPoint
                                            trn1.OSPreviousTrack = ValidOSTrack
                                            ValidOSTrack.LogOsMessage(ReportClearTimeFeedback, False, trn1)
                                        End If
                                    End If
                                Else
                                    trn1.OSPreviousControlPoint = RollUpTrack.myControlPoint
                                    trn1.OSPreviousTrack = RollUpTrack
                                    RollUpTrack.LogOsMessage(ReportClearTimeFeedback, False, trn1)
                                End If
                            End If
                        End If

                        If optDisableTrainMovePromptOnAuthorityRelease And ReleaseItemTwoLimits Then
