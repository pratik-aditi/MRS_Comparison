#Region "MRS SPECIFIC METHODS"

        ''' <summary>
        ''' Update Movemt Auth Text
        ''' </summary>
        ''' <param name="pCurrentTextList"></param>
        ''' <param name="pWhoCallMe"></param>
        ''' <returns></returns>
        Public Function UpdateMovementAuthorityTextForMRS(ByVal pCurrentTextList As ArrayList, Optional ByVal pWhoCallMe As String = Nothing) As Boolean
            Dim CurrentList As String = String.Empty
            Dim RemoteList As String = Nothing
            Dim CurrentListAux As String() = Nothing
            Dim RemoteListAux As String() = Nothing
            Dim theCompleteTextList As ArrayList = Nothing
            Dim NewList As New ArrayList
            Try
                If pCurrentTextList IsNot Nothing Then
                    CurrentList = pCurrentTextList(0)
                    CurrentListAux = CurrentList.Split("|")
                Else
                    AuthorityEventLog("UpdateMovementAuthorityTextForMRS:CurrentList is nothing")
                End If
                If optEnableExtendLicenseinSplitDesk And pCurrentTextList IsNot Nothing Then
                    If Me.myTrain.TrainRegionStatus = TrainRegionEnum.Local AndAlso CheckIfExistRemoteTrack(ComponentsInSelection) Then 'Local Desk with tracks in split desk
                        RemoteList = GetTextLicenseRemoteDesk(True)
                        If RemoteList <> String.Empty AndAlso RemoteList.Split("|").Count > 2 Then
                            RemoteListAux = RemoteList.Split("|")
                            NewList.Add(CurrentListAux(0) & "|" & CurrentListAux(1) & "|" & CurrentListAux(2) & "|" & RemoteListAux(RemoteListAux.Count - 2) & "|" & RemoteListAux(RemoteListAux.Count - 1))
                            theCompleteTextList = CreateAuthorityTextForMRS(NewList)
                        Else
                            theCompleteTextList = CreateAuthorityTextForMRS(pCurrentTextList)
                        End If
                    ElseIf Me.myTrain.TrainRegionStatus = TrainRegionEnum.InTrasition Then 'Train in trasition
                        RemoteList = GetTextLicenseRemoteDesk(True)
                        If RemoteList <> String.Empty AndAlso RemoteList.Split("|").Count > 2 Then
                            RemoteListAux = RemoteList.Split("|")
                            NewList.Add(RemoteListAux(0) & "|" & RemoteListAux(1) & "|" & RemoteListAux(2) & "|" & CurrentListAux(CurrentListAux.Count - 2) & "|" & CurrentListAux(CurrentListAux.Count - 1))
                            theCompleteTextList = CreateAuthorityTextForMRS(NewList)
                        Else
                            theCompleteTextList = CreateAuthorityTextForMRS(pCurrentTextList)
                        End If
                    ElseIf Me.myTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain AndAlso Me.myTrain.RemoteAction = RemoteActionEnum.NoAction Then 'Train in remote desk
                        RemoteList = GetTextLicenseRemoteDesk()
                        If RemoteList <> String.Empty AndAlso RemoteList.Split("|").Count > 2 Then
                            RemoteListAux = RemoteList.Split("|")
                            NewList.Add(RemoteListAux(0) & "|" & RemoteListAux(1) & "|" & RemoteListAux(2) & "|" & CurrentListAux(CurrentListAux.Count - 2) & "|" & CurrentListAux(CurrentListAux.Count - 1))
                            theCompleteTextList = CreateAuthorityTextForMRS(NewList)
                            'Invert text to be recorded in db
                            Dim auxList As String = RemoteList
                            RemoteList = CurrentList
                            CurrentList = auxList
                            auxList = Nothing
                        Else
                            theCompleteTextList = CreateAuthorityTextForMRS(pCurrentTextList)
                        End If
                    ElseIf Me.myTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain AndAlso Me.myTrain.RemoteAction = RemoteActionEnum.PartialCancel Then 'Train in remote desk with partial cancel
                        RemoteList = GetTextLicenseRemoteDesk()
                        If RemoteList <> String.Empty AndAlso RemoteList.Split("|").Count > 2 Then
                            NewList.Add(RemoteList)
                            theCompleteTextList = CreateAuthorityTextForMRS(NewList)
                            CurrentList = NewList(0)
                            RemoteList = Nothing
                        Else
                            theCompleteTextList = CreateAuthorityTextForMRS(pCurrentTextList)
                        End If
                    Else 'No tracks in split desk
                        theCompleteTextList = CreateAuthorityTextForMRS(pCurrentTextList)
                        CurrentList = pCurrentTextList(0)
                        RemoteList = Nothing
                    End If
                ElseIf optEnableExtendLicenseinSplitDesk AndAlso pCurrentTextList Is Nothing AndAlso Me.myTrain.TrainRegionStatus = TrainRegionEnum.Local AndAlso CheckIfExistRemoteTrack(ComponentsInSelection) Then 'end track current desk to license in split desk
                    RemoteList = GetTextLicenseRemoteDesk(True)
                    CurrentList = GetTextLicenseRemoteDesk()
                    CurrentListAux = CurrentList.Split("|")
                    If RemoteList <> String.Empty AndAlso RemoteList.Split("|").Count > 2 Then
                        RemoteListAux = RemoteList.Split("|")
                        NewList.Add(CurrentListAux(0) & "|" & CurrentListAux(1) & "|" & CurrentListAux(2) & "|" & RemoteListAux(RemoteListAux.Count - 2) & "|" & RemoteListAux(RemoteListAux.Count - 1))
                        theCompleteTextList = CreateAuthorityTextForMRS(NewList)
                    Else
                        theCompleteTextList = CreateAuthorityTextForMRS(pCurrentTextList)
                    End If
                Else 'Extend license functionality disabled
                    If pCurrentTextList Is Nothing Then
                        NewList.Add(GetTextLicenseRemoteDesk())
                        theCompleteTextList = CreateAuthorityTextForMRS(NewList)
                        CurrentList = NewList(0)
                        RemoteList = Nothing
                    Else
                        theCompleteTextList = CreateAuthorityTextForMRS(pCurrentTextList)
                        CurrentList = pCurrentTextList(0)
                        RemoteList = Nothing
                    End If
                End If

                CurrentListAux = Nothing
                RemoteListAux = Nothing
                NewList = Nothing

                If theCompleteTextList Is Nothing Then
                    Return False
                End If

                Dim AuthText As New StringBuilder
                Dim i As Integer = 0
                For Each TextLine As String In theCompleteTextList
                    If AuthText.Length = 0 Then
                        AuthText.Append(TextLine)
                        i = 1
                    Else
                        AuthText.Append("|")
                        AuthText.Append(TextLine)
                    End If
                Next
                'Update
                PTCAuthorityText = AuthText.ToString
                'Print
                AuthorityEventLog($"UpdateMovementAuthorityTextForMRS:PTCAuthorityText={PTCAuthorityText}")
                ReducedLimitsVerbiage = AuthText.ToString
                Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE", Me)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock
                Using dbConn As New OleDbConnection(gConnectionStringDynamic)
                    dbConn.Open()
                    Dim query As String = "UPDATE tblAuthoritiesActive"
                    query &= $" SET PTCAuthorityText = '{PTCAuthorityText}',"
                    query &= $" {gAuthorityLimitsCurrentDesk} = '{CurrentList}',"
                    query &= $" AuthorityLimitsRemoteDesk = '{RemoteList}'"
                    query &= $" WHERE AuthGUID = '{AuthGUID}'"
                    Using dbComm As New OleDbCommand(query, dbConn)
                        Dim rowsAffected As Integer = dbComm.ExecuteNonQuery()
                        If rowsAffected = 0 Then
                            AuthorityEventLog($"{GetCurrentMethod.Name}:No rows affected for AuthGUID={AuthGUID}")
                        End If
                    End Using
                End Using
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        ''' <summary>
        ''' Create Authority Text For MRS
        ''' </summary>
        ''' <param name="pTextBody"></param>
        ''' <returns></returns>
        Private Function CreateAuthorityTextForMRS(ByVal pTextBody As ArrayList) As ArrayList
            Dim textList As New ArrayList()
            Dim authLine As String
            Try
                If pTextBody Is Nothing OrElse pTextBody.Count = 0 Then Return Nothing
                textList.Add(Space(30) & optRailRoadName & Space(1) & optAuthString75) 'NOVA LICENÇA RECEBIDA
