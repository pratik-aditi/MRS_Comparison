        Public Function CheckIfExistRemoteTrack(ByVal pComponentsList As ArrayList) As Boolean
            Try
                'Local desk - Extend license in split desk
                Dim FoundRemoteTrak As Boolean = False
                For Each objs As Object In ComponentsInSelection
                    If objs.GetType.ToString = gTrackComponentName Then
                        Dim t As Track = CType(objs, Track)
                        If (t.AltLinkOne <> 0 AndAlso FindTrackFromGUID(t.AltLinkOne) Is Nothing) Or (t.AltLinkTwo <> 0 AndAlso FindTrackFromGUID(t.AltLinkTwo) Is Nothing) Then
                            AuthorityEventLog("CheckIfExistRemoteTrack:TrackName=" & t.Name)
                            FoundRemoteTrak = True
                            Exit For
                        End If
                    End If
                Next
                Return FoundRemoteTrak
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

