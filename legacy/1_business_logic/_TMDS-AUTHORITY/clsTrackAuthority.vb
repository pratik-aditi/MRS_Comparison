                '    '        TrackSelected = startTrack
                '    '    End If

                '    'End If
                'End If
            End If

            'If SwitchPointList IsNot Nothing AndAlso SwitchPointList.Count > 0 Then
            '    Dim tmpSwitchList As New ArrayList
            '    For Each comp In Me.ComponentsInSelection
            '        If comp.GetType.ToString = gSwitchComponentName Then
            '            If Not tmpSwitchList.Contains(comp) Then tmpSwitchList.Add(comp)
            '        End If
