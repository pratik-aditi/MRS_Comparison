#Region "VETMS-PTC ROLLUP METHODS"

        ''' <summary>
        ''' Perform Rollup
        ''' </summary>
        ''' <param name="theTrain"></param>
        ''' <param name="rollupEvent"></param>
        ''' <param name="rollupList"></param>
        ''' <param name="enableRollupConfimationTimer"></param>
        ''' <param name="replaceAllTextualContent"></param>
        ''' <param name="authTextList"></param>
        ''' <param name="isPartialCancel"></param>
        Public Sub PtcPerformRollup(theTrain As TrainID,
                                       rollupEvent As String,
                                       rollupList As ArrayList,
                                       Optional enableRollupConfimationTimer As Boolean = True,
                                       Optional replaceAllTextualContent As Boolean = False,
                                       Optional authTextList As ArrayList = Nothing,
                                       Optional isPartialCancel As Boolean = False)
            Try
                AuthorityEventLog($"{GetCurrentMethod.Name _
                                  }:Start:WhoCallMe={(New StackTrace).GetFrame(1).GetMethod.Name _
                                  }:IsPartialCancel:{isPartialCancel}")
                If Not theTrain.IsPresenceOnNetwork Then
                    AuthorityEventLog($"{GetCurrentMethod.Name}:IsPresenceOnNetwork")
                    Exit Sub
                End If
                PTCElectronicTransmissionInProgress = True
                PTCRollUpList = rollupList.Clone
                Dim disableRollup As Boolean = False
                Dim supressElectronicTransmission As Boolean = True
                Dim numSubdivis As Integer = 0
                Dim theSubdiv As Integer = 0
                Dim foundFlipFlop As Boolean = False
                Dim newList As ArrayList = ComponentsInSelection.Clone
                'Rollup list to remove
                For Each oneComponent As GenericComponent In rollupList
                    AuthorityEventLog($"{GetCurrentMethod.Name}:RemoveComp={oneComponent.GUID}:{oneComponent.Name}")
                    newList.Remove(oneComponent)
                    If TypeOf oneComponent Is Track Then
                        Dim oneTrack As Track = DirectCast(oneComponent, Track)
                        If oneTrack.OStype Then
                            supressElectronicTransmission = False
                        End If
                        If theSubdiv <> oneTrack.SubdivisionID Then
                            theSubdiv = oneTrack.SubdivisionID
                            numSubdivis += 1
                        End If
                        'It avoid bad rollup at alca
                        If oneTrack.TrackAlternativeName.Contains("DISABLEROLLUP") Then
                            AuthorityEventLog($"{GetCurrentMethod.Name}:DisableRollup={oneTrack.Name}")
                            disableRollup = True
                        End If
                    ElseIf TypeOf oneComponent Is FlipFlop Then
                        foundFlipFlop = True
                    End If
                Next
                'Print list to comps kept on train
                For Each oneComponent As GenericComponent In newList
                    AuthorityEventLog($"{GetCurrentMethod.Name}:KeepComp={oneComponent.GUID}:{oneComponent.Name}")
                Next
                'Partial cancel type
                If isPartialCancel Then
                    If supressElectronicTransmission Then
                        supressElectronicTransmission = False
                    End If
                End If
                'Change direction due to rollup
                If Not isPartialCancel AndAlso
                   foundFlipFlop Then
                    FindAuthorityDirection(foundFlipFlop,
                                           rollupList,
                                           newList)
                End If
                If supressElectronicTransmission Then
                    VETMS_CompleteRollup()
                    Exit Sub
                End If
                If Not isPartialCancel AndAlso
                   (numSubdivis > 1 Or disableRollup) Then
                    VETMS_CompleteRollup()
                    Exit Sub
                End If
                PTCMarkedToBeRolledUpElectronically = True
                'Local desk segments
                PTCTrackSegmentRollupList = FindSegmentstoRollup(theTrain, newList)
                Dim remoteSegText As String
                If optEnableExtendLicenseinSplitDesk Then
                    If String.IsNullOrWhiteSpace(PTCTrackSegmentRollupList) Then
                        AuthorityEventLog($"{GetCurrentMethod.Name}:PTCTrackSegmentRollupList is empty")
                        VETMS_CompleteRollup()
                        Exit Sub
                    End If
                    'Is partial cancel
                    If isPartialCancel Then
                        'Partial cancel going to other desk
                        If theTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain AndAlso
                           theTrain.RemoteAction = RemoteActionEnum.PartialCancel Then
                            PTCTrackSegmentRollupList = GetTrackSegmentsRemoteDesk()
                        End If
                        'Partial cancel in Remote desk
                        If theTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain AndAlso
                            theTrain.RemoteAction = RemoteActionEnum.NoAction Then
                            PTCTrackSegmentRollupList = $"{GetTrackSegmentsRemoteDesk()}|{PTCTrackSegmentRollupList}"
                        End If
                    Else
                        'Rollup in Local desk
                        If theTrain.TrainRegionStatus = TrainRegionEnum.Local AndAlso
                           isPartialCancel = False AndAlso
                           CheckIfExistRemoteTrack(ComponentsInSelection) Then
                            remoteSegText = GetTrackSegmentsRemoteDesk(True)
                            PTCAuthoritySegmentsRemoteDesk = remoteSegText
                            PTCTrackSegmentRollupList = $"{PTCTrackSegmentRollupList}|{remoteSegText}"
                        End If
                    End If
                    PTCTrackSegmentRollupList = RemoveTrackSegmentsDuplicated(PTCTrackSegmentRollupList)
                    'If doenst exist remote track is need to change the status to Local
                    If optEnableExtendLicenseinSplitDesk AndAlso
                       theTrain.thisCurrentLicense IsNot Nothing AndAlso
                       theTrain.TrainRegionStatus = TrainRegionEnum.InTrasition AndAlso
                       Not CheckIfExistRemoteTrack(ComponentsInSelection) Then
                        theTrain.TrainRegionStatus = TrainRegionEnum.Local
                        AuthorityEventLog($"{GetCurrentMethod.Name}:TrainRegionStatus=Local")
                    End If
                End If
                'Update license text
                UpdateMovementAuthorityTextForMRS(authTextList, GetCurrentMethod.Name)
                AuthorityEventLog($"{GetCurrentMethod.Name}:TrainRegionStatus={myTrain.TrainRegionStatus _
                                  }:RemoteAction={theTrain.RemoteAction _
                                  }:Segments={PTCTrackSegmentRollupList}")
                PTCElectronicDeliveryCompleted = False
                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                PTCTypeAuthority = True
                UpdateDatabaseWithPTCAuthorityStatus("ROLLUP-SENT")
                PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ROLLUP.ToString
                DoAssignComponentsForPTC(rollupList)
                PTCStatus = "RELEASE-SENT"
                SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                If Not optDisableFlashingTrackForPTC Then FlasherMode(True, True)
                PTCSentTimeStamp = Now
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageRollup_TNT(Me,
                                                                                                            theTrain,
                                                                                                            PTCTrackSegmentRollupList,
                                                                                                            rollupEvent,
                                                                                                            PTCMessageUID,
                                                                                                            replaceAllTextualContent,
                                                                                                            isPartialCancel)
                TMDS.NetworkMessages.CadMessages.SendLicenseEventForWabtecOne(Me,
                                                                              "ROLLUP",
                                                                              isPartialCancel)
                If UpdateDatabaseWithPTCAuthorityStatus("SENT") Then
                    PTCStatus = "AUTHORITY-SENT"
                    Dim summItem As New SummaryItem("AUTHORITY",
                                               "UPDATE-PTC",
                                               Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(summItem)
                    End SyncLock
                End If
                If enableRollupConfimationTimer Then VETMS_CreateTimerRollupEvent()
                If gTestPTC Then
                    PTCStatus = "AUTHORITY-ACTIVATED"
                    SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                    FlasherMode(False, True)
                    VETMS_CompleteRollup()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Check Partial CancelOver Remote Desk
        ''' </summary>
        ''' <param name="pRemoteDesk"></param>
        ''' <param name="pLocalDesk"></param>
        ''' <returns></returns>
        Private Function CheckPartialCancelOverRemoteDesk(pRemoteDesk As String, pLocalDesk As String) As String
            Dim localDeskSeg As String()
            Dim remoteDeskSeg As String()
            Dim lastSegRemoteDesk As String()
            Dim firstSegLocalDesk As String()
            Try
                '14549828352;WLAP0014;;279.2;;287;;;LINHA 1;4;FALSE|15255085325;WLAP0014;;283.383;;287;;;LINHA 1;4;FALSE
                localDeskSeg = pLocalDesk.Split("|")
                remoteDeskSeg = pRemoteDesk.Split("|")
                If localDeskSeg.Length > 1 Then
                    Return pRemoteDesk & "|" & pLocalDesk
                End If
                lastSegRemoteDesk = remoteDeskSeg.Last.Split(";")
                firstSegLocalDesk = localDeskSeg.First.Split(";")
                If lastSegRemoteDesk(1) = firstSegLocalDesk(1) AndAlso
                        lastSegRemoteDesk(8) = firstSegLocalDesk(8) AndAlso
                        lastSegRemoteDesk(5) = firstSegLocalDesk(5) Then
                    AuthorityEventLog("CheckPartialCancelOverRemoteDesk:RemoteDesk=" & pRemoteDesk)
                    Return pRemoteDesk
                Else
                    Return pRemoteDesk & "|" & pLocalDesk
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                Return pRemoteDesk & "|" & pLocalDesk
            End Try
        End Function


        ''' <summary> 
        ''' Find Authority Direction
        ''' </summary>
        Private Sub FindAuthorityDirection(pFoundFlipFlop As Boolean, pRollupList As ArrayList, pNewList As ArrayList)
            Dim comp As Object
            Dim flip As FlipFlop = Nothing
            Dim flipCount As Integer = 0
            Dim flipLastUid As Integer
            Try
                If pFoundFlipFlop Then
                    If Me.Direction = "LEFT" Then
                        AuthorityEventLog("FindAuthorityDirection:Direction changed to RIGHT")
                        Me.Direction = "RIGHT"
                    Else
                        AuthorityEventLog("FindAuthorityDirection:Direction changed to LEFT")
                        Me.Direction = "LEFT"
                    End If
                    UpdateDatabaseWithDirectionChange()
                    For Each comp In pNewList
                        If comp.GetType.ToString = gTrackComponentName OrElse comp.GetType.ToString = gSwitchComponentName Then
                            comp.FlipMe = False
                        End If
                    Next
                    Dim FlipFlopFound As Boolean = False
                    For Each comp In pNewList
                        If FlipFlopFound Then
                            If comp.GetType.ToString = gTrackComponentName OrElse comp.GetType.ToString = gSwitchComponentName Then
                                comp.FlipMe = True
                            End If
                        End If
                        If comp.GetType.ToString = gFlipFlopComponentName Then
                            flip = CType(comp, FlipFlop)
                            FlipFlopFound = True
                            AuthorityEventLog("FindAuthorityDirection:FLIPFLOP=" & comp.GUID.ToString & ":" & comp.Name)
                            If flipLastUid <> flip.GUID Then
                                flipLastUid = flip.GUID
                                flipCount += 1
                            End If
                            'This invert direction of license to next flipflop
                            If (flipCount Mod 2) = 0 Then
                                FlipFlopFound = False
                            End If
                        End If
                    Next
                End If
                For Each comp In pNewList
                    AuthorityEventLog("FindAuthorityDirection:Comp=" & comp.GUID.ToString & ":" & comp.Name & ":" & comp.FlipMe.ToString & ":" & comp.TrafficDirection)
                    comp.UpdateStatus()
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                comp = Nothing
                flip = Nothing
                flipCount = Nothing
                flipLastUid = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Find Segments to Rollup
        ''' </summary>
        ''' <param name="pTrain"></param>
        ''' <returns></returns>
        Private Function FindSegmentstoRollup(pTrain As TrainID, pNewList As ArrayList) As String
            Dim data As New ArrayList
            Dim comp As Object
            Dim firstTrack As TacticalRoute
            Dim strTrackSegmentsCurrentDesk As New StringBuilder
            Try
                If pTrain.myTacticalRoutes.Count = 0 Then
                    AuthorityEventLog("FindSegmentstoRollup:myTacticalRoutes is empty")
                    Return Nothing
                End If
                firstTrack = pTrain.myTacticalRoutes.Item(0)
                pTrain.GetTrackSegmentsForCAD(firstTrack.mySignalRoute, pNewList, data, True, "FindSegmentstoRollup")
                For Each trackSeg As String In data
                    If strTrackSegmentsCurrentDesk.Length = 0 Then
                        strTrackSegmentsCurrentDesk.Append(trackSeg)
                    Else
                        strTrackSegmentsCurrentDesk.Append("|")
                        strTrackSegmentsCurrentDesk.Append(trackSeg)
                    End If
                Next
                Return strTrackSegmentsCurrentDesk.ToString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                data = Nothing
                comp = Nothing
                firstTrack = Nothing
                strTrackSegmentsCurrentDesk = Nothing
            End Try
        End Function

