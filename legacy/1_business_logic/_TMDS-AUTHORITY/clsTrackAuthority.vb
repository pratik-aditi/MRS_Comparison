                WarrantUpdateSQL = "UPDATE " & gtblAuthActive
                WarrantUpdateSQL = WarrantUpdateSQL & " SET PTCAuthorityText = " & "'" & AuthText & "'"
                WarrantUpdateSQL = WarrantUpdateSQL & " WHERE AuthGUID = '" & Me.AuthGUID & "'" '" WHERE AuthorityUID = " & "'" & Me.AuthorityUID & "'"

                CommandUpdate = New OleDbCommand(WarrantUpdateSQL, dbconn)

                dbconn.Open()
                CommandUpdate.ExecuteNonQuery()
                dbconn.Close()
                CommandUpdate = Nothing
                dbconn = Nothing
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return False
            End Try
        End Function

        Private Function CreateAuthorityText(ByVal IncludeOKTime As Boolean) As ArrayList
            Try

                Dim LinesInAuthority() As String = Me.AuthorityLimits.Split("|")
                Dim Line As String
                Dim LineCount As Integer
                Dim CurrentAuthLine As AuthLineHolder = Nothing
                Dim CurrentAuthLine2 As AuthLineHolder = Nothing
                Dim Lines As New ArrayList
                Dim LineAadded As Boolean
                For Each Line In LinesInAuthority
                    If LineCount <> 0 Then
                        Dim NewALH As New AuthLineHolder
                        NewALH.LineNum = 0
                        NewALH.LineText.Add(Line)
                        Lines.Add(NewALH)
                        LineAadded = True
                    ElseIf InStr(Line, "-----------------") <> 0 Then
                        Exit For
                    ElseIf LineCount > 1 And InStr(Line, "[X BOX ") > 0 Then

                        CurrentAuthLine = New AuthLineHolder
                        Lines.Add(CurrentAuthLine)
                        LineAadded = True
                        Dim data() As String = Line.Split("]")
                        Dim Num As Integer = CInt(data(0).Replace("[X BOX ", ""))
                        CurrentAuthLine.LineNum = Num
                        CurrentAuthLine.LineText.Add(data(1))
                    ElseIf Not IsNothing(CurrentAuthLine) Then
                        CurrentAuthLine.LineText.Add(Line)
                    End If
                    CurrentAuthLine2 = New AuthLineHolder
                    If Not LineAadded Then
                        CurrentAuthLine2 = New AuthLineHolder
                        CurrentAuthLine2.LineNum = 0
                        CurrentAuthLine2.LineText.Add(Line)

                        Lines.Add(CurrentAuthLine2)
                    End If

                    LineCount += 1
                Next

                Dim TextList As New ArrayList()
                TextList.Add(Space(30) & optRailRoadName & " TRACK AND TIME")
                TextList.Add(" ")

                TextList.Add(Space(5) & "AUTHORITY NO: " & Me.AuthorityUID & "                DATE: " & Format(Me.AuthorityDate, "MMM-dd-yyyy"))
                TextList.Add(" ")

                TextList.Add(Space(5) & "TO: " & Me.IssueTo)
                TextList.Add(" ")

                Dim sAuthLine As String = String.Empty

                Dim AuthLine As AuthLineHolder
                For Each AuthLine In Lines

                    If AuthLine.LineNum > 0 Then
                        sAuthLine = Space(5) & "[X] " & AuthLine.LineNum & Space(1)
                    End If

                    Select Case AuthLine.LineNum
                        Case 1
                            TextList.Add(sAuthLine & Space(1) & AuthLine.LineText.Item(0))

                        Case 6, 7, 8, 11
                            Dim txt As String
                            LineCount = 0
                            For Each txt In AuthLine.LineText
                                If LineCount = 0 Then
                                    TextList.Add(sAuthLine & Space(1) & txt)
                                Else
                                    TextList.Add(Space(10) & txt)
                                End If
                                LineCount += 1
                            Next
                        Case Else
                            Dim text As String
                            For Each text In AuthLine.LineText
                                If LineCount = 0 Then
                                    TextList.Add(sAuthLine & Space(1) & text)
                                Else
                                    TextList.Add(Space(10) & text)
                                End If
                                LineCount += 1
                            Next

                    End Select
                    TextList.Add("")
                Next


                If IncludeOKTime Then
                    Dim OKstring As String = Space(5) & "OK " & Format(OKTime, "HH:mm") & ", " & TMDS.GlobalDeclarations.gCurrentUser.Initials
                    TextList.Add(OKstring)
                    Dim RTC As String = Space(5) & "DISP: " & Me.DispatcherName & "  COPIED BY:" & Me.CopiedBy
                    TextList.Add(RTC)

                End If
                Return TextList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

