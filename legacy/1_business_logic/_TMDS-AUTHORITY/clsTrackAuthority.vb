        Public Sub VETMS_PerformIssuance(ByVal theTrain As TrainID)
            Try
                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                Me.PTCMarkedToBeIssuedElectronically = True
                Me.PTCTypeAuthority = True
                If optUseSingleFormAuthorityVersionCN OrElse optEnableSpecificPTCOperationsForMetrolink OrElse optEnableKCSSpecificOptions Then
                    Me.UpdateMovementAuthorityTextForCN(True)
                    Me.UpdateDatabaseWithPTCAuthoritySegments()
                End If
                If optEnableARRCSpecificPTCOperations Then
                    Me.UpdateDatabaseWithPTCAuthoritySegments()
                End If
                Me.PTCElectronicTransmissionInProgress = True
                'Me.UpdateDatabaseWithPTCAuthoritySegments()


                If Me.UpdateDatabaseWithPTCAuthorityStatus("AUTHORITY-SENT") Then
                    Dim SummItem1 As New SummaryItem("AUTHORITY", "AUTHORITY-SENT", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If

                Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ISSUE.ToString
                Me.DoAssignComponentsForPTC(Me.Components)
                'Me.PTCAuthorityComponents = Me.Components
                Me.UpdateDatabaseWithPTCComponents()


                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageCreate_TWC(Me, theTrain, PTCMessageUID)
                Me.PTCStatus = "AUTHORITY-SENT"
                Me.SetPTCAuthorityFlasherStatus()
                If Not optDisableFlashingTrackForPTC Then Me.FlasherMode(True, True)
                VETMS_CreateTimerIssuanceEvent()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

