        ''' <summary>
        ''' Updates the duration time of a device‑block record identified by its GUID.
        ''' </summary>
        Public Sub UpdateDeviceBlockWithDurationTime()
            Try
                'Initialize the variable with the minimum valid smalldatetime value supported by the DurationTime column.
                Dim minDateValid As Date = New Date(1900,
                                                1,
                                                1,
                                                DurationTime.Hour,
                                                DurationTime.Minute,
                                                DurationTime.Second)
                If DurationTime = Date.MinValue OrElse DurationTime < minDateValid Then
                    DurationTime = minDateValid
                End If
                gRepositories.DeviceBlockRepository.UpdateDeviceBlockWithDurationTime(DurationTime, BlockGUID)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

