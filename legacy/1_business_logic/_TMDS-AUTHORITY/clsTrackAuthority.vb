                            Dim UserResponseSwitch As Integer = MessageBox.Show(TMDS.SystemForms.MySystemForms.frmMainMDI.ActiveMdiChild, SwitchMessage, "SWITCH POSITION CONFIRMATION", MessageBoxButtons.YesNo, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2)
                            If UserResponseSwitch = 6 Then
                                gHistoryMessage = "SELECTED - YES TO " & SwitchMessage & ":" & Me.WarrantNumber.ToString
                                TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                            Else
                                gHistoryMessage = "SELECTED - NO TO  " & SwitchMessage & ":" & Me.WarrantNumber.ToString
                                TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                                ClearSelection()
                                Exit Function
                            End If
                            If Not optDisablePromptSPAF Then
                                Dim SwitchFormMessage As String = "HAVE ALL EMPLOYEES COMPLETED THE SPAF AS REQUIRED?"
                                Dim UserResponseSwitchForm As Integer = MessageBox.Show(TMDS.SystemForms.MySystemForms.frmMainMDI.ActiveMdiChild, SwitchFormMessage, "SWITCH POSITION FORM CONFIRMATION", MessageBoxButtons.YesNo, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2)
                                If UserResponseSwitchForm = 6 Then
