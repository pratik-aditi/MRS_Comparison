        Public Function UpdatePTCTxt_Segment_Contigency_Compostion(ByVal TextList As ArrayList, ByVal PTCRestrictionSegments As String, ByVal PTCContigencySegments As String) As Boolean
            Dim UpdateStr As New StringBuilder
            Dim CommandUpdate As OleDbCommand = Nothing
            Dim theCompleteTextList As New ArrayList
            Dim AuthText As New StringBuilder
            Dim TextLine As String = ""
            Dim i As Integer = 0
            Try

                theCompleteTextList = TextList
                For Each TextLine In theCompleteTextList
                    If AuthText.Length = 0 Then
                        AuthText.Append(TextLine)
                        i = 1
                    Else
                        AuthText.Append("|")
                        AuthText.Append(TextLine)
                    End If
                Next
                Me.PTCAuthorityText = AuthText.ToString
                Me.PTCRestrictionText = PTCRestrictionSegments
                Me.PTCContingencySegments = PTCContigencySegments
                Me.PTCCompositionCRC = TMDS.SystemUtilities.CRCUtils.GetCRC(Nothing, Me)
                With UpdateStr
                    .Append("UPDATE " & gtblSFAActive)
                    .Append(" SET  ")
                    .Append(" PTCAuthorityText = " & "'" & PTCAuthorityText & "'")
                    .Append(" , PTCRestrictionSegments = " & "'" & Me.PTCRestrictionText & "'")
                    .Append(" , PTCContingencySegments = " & "'" & Me.PTCContingencySegments & "'")
                    .Append(" , PTCCompositionCRC = " & Me.PTCCompositionCRC)
                    .Append(" WHERE AuthGUID = " & "'" & Me.AuthGUID & "'")
                End With
                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    CommandUpdate = New OleDbCommand(UpdateStr.ToString, DbConn)
                    CommandUpdate.ExecuteNonQuery()
                    DbConn.Close()
                End Using
                Return True

            Catch ex As Exception
                GetErrorDetails(ex, "SQL Update string: " & UpdateStr.ToString)
                Return False
            Finally
                If CommandUpdate IsNot Nothing Then CommandUpdate.Dispose()
                CommandUpdate = Nothing
                UpdateStr = Nothing
                AuthText = Nothing
                theCompleteTextList = Nothing
            End Try
        End Function

