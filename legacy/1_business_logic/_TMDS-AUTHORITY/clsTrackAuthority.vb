                textList.Add(" ")
                textList.Add(" ")
                For Each authLine In pTextBody
                    textList.Add(authLine)
                Next
                Return textList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                textList = Nothing
                authLine = Nothing
            End Try
        End Function

