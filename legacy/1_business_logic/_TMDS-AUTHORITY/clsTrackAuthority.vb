                CommandInsert = New OleDbCommand(WarrantInsertSQL, dbconn)
                dbconn.Open()
                CommandInsert.ExecuteNonQuery()
                dbconn.Close()
                CommandInsert = Nothing
                dbconn = Nothing

                Dim DoAddAuthorityEvent As New DoEventLogSFA(AddressOf Me.LogTheSFAEvent)
                DoAddAuthorityEvent.BeginInvoke(EventLogTypeSFA.ADD, Nothing, Nothing)

                Dim DoAuthorityEvent As New DoPublishSFAEvent(AddressOf Me.PublishSFAEventUpdate)
                DoAuthorityEvent.BeginInvoke(EventTypeSFA.ADD, Nothing, Nothing)

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
        End Function


        Public Function UpdateTrackAuthorityStatus(Optional ByVal UpdateCopiedBy As Boolean = False) As Boolean
            Dim UpdateString As String
            Dim s As String = ","
            Dim q As String = "'"
            Dim dbconn As OleDbConnection = Nothing
            Dim CommandInsert As OleDbCommand = Nothing
            UpdateString = "UPDATE " & gtblSFAActive
            UpdateString = UpdateString & " SET AuthorityStatus = " & q & Me.AuthorityStatus & q
            If UpdateCopiedBy Then
                UpdateString = UpdateString & " ,CopiedBy=' " & Me.CopiedBy & "'"
            End If
            UpdateString = UpdateString & " WHERE AuthGUID = " & q & Me.AuthGUID & q
            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                dbconn.Open()
                CommandInsert = New OleDbCommand(UpdateString, dbconn)
                CommandInsert.ExecuteNonQuery()
                Return True
            Catch ex As Exception
                GetErrorDetails(ex, "SQL Query::" & UpdateString)
                dbconn = Nothing
            Finally
                If Not dbconn Is Nothing Then
                    If dbconn.State <> ConnectionState.Closed Then dbconn.Close()
                    dbconn.Dispose()
                    dbconn = Nothing
                End If
                If Not CommandInsert Is Nothing Then
                    CommandInsert.Dispose()
                    CommandInsert = Nothing
                End If
            End Try
        End Function

