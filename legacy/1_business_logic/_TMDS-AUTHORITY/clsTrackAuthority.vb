        Public Sub CheckToAcknowledgeAlert()
            Dim al As Alert
            Dim theList As New ArrayList
            Try
                For Each al In gSystemAlertList
                    If al IsNot Nothing AndAlso al.AlertObject IsNot Nothing AndAlso al.AlertObject.GetType.ToString = gSFAComponentName Then
                        Dim auth As TMDS.TrackAuthority.SFAuthority = CType(al.AlertObject, SFAuthority)
                        If auth.TrainSymbol = Me.TrainSymbol AndAlso auth.AuthGUID = Me.AuthGUID Then
                            Dim Message As String = "PTC ALERT WAS ACKNOWLEDGED BY SYSTEM FOR AUTHORITY:" & Me.AuthGUID
                            al.AlertAckedByPerson = Message
                            TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                            gSystemAlertExists = False
                            Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al)
                            SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                            End SyncLock
                            theList.Add(al)
                        End If

                    End If
                Next

                Threading.Thread.Sleep(1000)
                For Each al In theList
                    Dim SummItem As New SummaryItem("ALERT", "REMOVE", al)
                    SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                    End SyncLock
                    TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                Next
                gSystemAlertExists = False

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                theList = Nothing
                al = Nothing
            End Try
        End Sub

