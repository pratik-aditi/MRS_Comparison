                End If
                CopyArrayCollection(myCompList, Me.Components)
                If optEnableARRCSpecificOptions Then
                    myCompList = New ArrayList
                    Dim SidingTracks As New ArrayList
                    Dim SidingTracksNameList As New ArrayList
                    Dim s As String = ""
                    Dim trk As Track
                    For Each comp In Me.Components
                        If comp.GetType.ToString = gTrackComponentName Then
                            If (comp.EnableControlledSiding Or comp.EnableNonControlledSiding) Then
                                If Not SidingTracks.Contains(comp) Then SidingTracks.Add(comp)
                                If Not SidingTracksNameList.Contains(comp.Name) Then SidingTracksNameList.Add(comp.Name)
                            End If
                        End If
                    Next
                    If (SidingTracks IsNot Nothing AndAlso SidingTracks.Count > 0) AndAlso (SidingTracksNameList IsNot Nothing AndAlso SidingTracksNameList.Count > 0) Then
                        For Each s In SidingTracksNameList
                            If s.Trim <> "" Then
                                trk = Nothing
                                CurrentTrackName = ""
                                Dim thisList As New ArrayList
                                For Each comp In SidingTracks
                                    If comp.Name = s Then
                                        'If trk Is Nothing Then trk = comp
                                        If Not thisList.Contains(comp) Then thisList.Add(comp)
                                    End If
                                Next
                                'If trk IsNot Nothing Then

                                For Each comp In thisList
                                    trk = CType(comp, Track)
                                    Dim myTrackName As String = ""
                                    Select Case trk.TrackNameAlias.Trim.ToUpper
                                        Case "", "NOTHING", "NONE"
                                            myTrackName = trk.TrackName
                                        Case Else
                                            myTrackName = trk.TrackNameAlias
                                    End Select
                                    If CurrentTrackName = "" Then
                                        CurrentTrackName = myTrackName
                                        'CurrentTrackName = trk.TrackNameAlias
                                        Dim trackList As New ArrayList
                                        CurrentTrackList = trackList
                                        TrackSegments.Add(CurrentTrackList)
                                    End If
                                    If myTrackName = CurrentTrackName Then
                                        CurrentTrackList.Add(comp)
                                    Else
                                        CurrentTrackName = myTrackName
                                        Dim trackList As New ArrayList
                                        CurrentTrackList = trackList
                                        TrackSegments.Add(CurrentTrackList)
                                        CurrentTrackList.Add(comp)
                                    End If
                                Next
