        ''' <summary>
        ''' Remove track segments duplicated
        ''' </summary>
        ''' <param name="pTrackSegments"></param>
        ''' <returns></returns>
        Public Function RemoveTrackSegmentsDuplicated(ByVal pTrackSegments As String) As String
            Dim newList As String = String.Empty
            Dim currentSegment As String()
            Dim newSegments As String = String.Empty
            Dim currentBosName As String = String.Empty
            Dim nextBosName As String = String.Empty
            Dim currentFirstMP As String = String.Empty
            Dim nextFirstMP As String = String.Empty
            Dim currentLastMP As String = String.Empty
            Dim nextLastMP As String = String.Empty
            Dim foundChange As Boolean = False
            Dim ignoreSegment As Boolean = False
            Dim splitSegments As String()
            Dim newSeg As New ArrayList
            Dim findaux As String()
            Try
                If pTrackSegments = String.Empty Or pTrackSegments = "|" Then
                    AuthorityEventLog("RemoveTrackSegmentsDuplicated:TrackSegments is empty")
                    Return pTrackSegments
                End If
                splitSegments = pTrackSegments.Split("|")
                'remove null segments
                For Each seg As String In splitSegments
                    If seg = String.Empty Then
                        Continue For
                    End If
                    If newList = String.Empty Then
                        newList = seg
                    Else
                        newList += "|" & seg
                    End If
                Next
                splitSegments = Nothing
                splitSegments = newList.Split("|")
                For Each currentSegAux As String In splitSegments
                    currentSegment = currentSegAux.Split(";")
                    If currentSegment.Count = 0 Then
                        Continue For
                    End If
                    If currentSegment.Count < 11 Then
                        currentBosName = String.Empty
                        currentFirstMP = currentSegment(2)
                        currentLastMP = currentSegment(4)
                    Else
                        currentBosName = currentSegment(1)
                        currentFirstMP = currentSegment(3)
                        currentLastMP = currentSegment(5)
                    End If
                    ignoreSegment = False
                    'Remove mileposts duplicated
                    If currentFirstMP = currentLastMP Then
                        ignoreSegment = True
                        foundChange = True
                    End If
                    For Each find As String In newSeg
                        findaux = find.Split(";")
                        If findaux.Count < 11 Then
                            nextBosName = String.Empty
                            nextFirstMP = findaux(2)
                            nextLastMP = findaux(4)
                        Else
                            nextBosName = findaux(1)
                            nextFirstMP = findaux(3)
                            nextLastMP = findaux(5)
                        End If
                        'Check if seg is duplicated
                        If currentBosName = nextBosName AndAlso currentFirstMP = nextFirstMP AndAlso currentLastMP = nextLastMP Then
                            ignoreSegment = True
                            foundChange = True
                            Continue For
                        End If
                    Next
                    If Not ignoreSegment Then
                        newSeg.Add(currentSegAux)
                        If newSegments = String.Empty Then
                            newSegments = currentSegAux
                        Else
                            newSegments += "|" & currentSegAux
                        End If
                    End If
                Next
                If foundChange = True Then
                    AuthorityEventLog("RemoveTrackSegmentsDuplicated:Old segments:" & pTrackSegments)
                    AuthorityEventLog("RemoveTrackSegmentsDuplicated:New segments:" & newSegments)
                End If
                Return newSegments
            Catch ex As Exception
                AuthorityEventLog("RemoveTrackSegmentsDuplicated:Exception:" & pTrackSegments)
                SystemException(ex.ToString)
                Return pTrackSegments
            Finally
                newList = Nothing
                currentSegment = Nothing
                newSegments = Nothing
                currentBosName = Nothing
                nextBosName = Nothing
                currentFirstMP = Nothing
                nextFirstMP = Nothing
                currentLastMP = Nothing
                nextLastMP = Nothing
                foundChange = Nothing
                ignoreSegment = Nothing
                splitSegments = Nothing
                newSeg = Nothing
                findaux = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Update track segments
        ''' </summary>
        Public Sub UpdateTrackSegments(ByVal pCurrent As String)
            Dim currentDesk As String = pCurrent
            Dim remoteDesk As String = String.Empty
            Try
                'Current desk
                If currentDesk Is Nothing Then
                    currentDesk = FindSegmentstoRollup(Me.myTrain, Me.ComponentsInSelection)
                    AuthorityEventLog("UpdateTrackSegments:currentDesk=" & currentDesk)
                End If
                If optEnableExtendLicenseinSplitDesk Then
                    'Local Desk with tracks in split desk
                    If Me.myTrain.TrainRegionStatus <> TrainRegionEnum.RemoteTrain AndAlso CheckIfExistRemoteTrack(ComponentsInSelection) Then
                        remoteDesk = GetTrackSegmentsRemoteDesk(True)
                        'Keeping segments
                        Me.PTCAuthoritySegments = currentDesk & "|" & remoteDesk
                        Me.PTCAuthoritySegmentsCurrentDesk = currentDesk
                        Me.PTCAuthoritySegmentsRemoteDesk = remoteDesk
                    ElseIf Me.myTrain.TrainRegionStatus = TrainRegionEnum.Local AndAlso Not CheckIfExistRemoteTrack(ComponentsInSelection) Then 'Local Desk without tracks in split desk
                        Me.PTCAuthoritySegments = currentDesk
                        Me.PTCAuthoritySegmentsCurrentDesk = currentDesk
                        Me.PTCAuthoritySegmentsRemoteDesk = String.Empty
                    ElseIf Me.myTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain Then 'Remote desk
                        remoteDesk = GetTrackSegmentsRemoteDesk()
                        'Invert segments
                        Me.PTCAuthoritySegments = remoteDesk & "|" & currentDesk
                        Me.PTCAuthoritySegmentsCurrentDesk = remoteDesk
                        Me.PTCAuthoritySegmentsRemoteDesk = currentDesk
                    Else
                        Me.PTCAuthoritySegments = currentDesk
                        Me.PTCAuthoritySegmentsCurrentDesk = currentDesk
                        Me.PTCAuthoritySegmentsRemoteDesk = String.Empty
                        AuthorityEventLog("UpdateTrackSegments:Train region status not found")
                    End If
                Else
                    Me.PTCAuthoritySegments = currentDesk
                    Me.PTCAuthoritySegmentsCurrentDesk = currentDesk
                    Me.PTCAuthoritySegmentsRemoteDesk = String.Empty
                End If
                Me.PTCAuthoritySegments = Me.RemoveTrackSegmentsDuplicated(Me.PTCAuthoritySegments)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                currentDesk = Nothing
                remoteDesk = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Get Track Segments from Remote Desk
        ''' </summary>
        ''' <returns></returns>
        Public Function GetTrackSegmentsRemoteDesk(Optional getRemoteDesk As Boolean = False) As String
            Try
                Dim query As String = String.Empty
                If getRemoteDesk Then
                    query = $"SELECT PTCAuthoritySegmentsRemoteDesk 
                                    FROM tblAuthoritiesActive 
                                    WHERE AuthGUID = '{AuthGUID}'"
                Else
                    query = $"SELECT {gPTCAuthoritySegmentsCurrentDesk} 
                                    FROM tblAuthoritiesActive 
                                    WHERE AuthGUID = '{AuthGUID}'"
                End If
                Dim authoritySegments As String = Nothing
                Using dbConn As New OleDbConnection(gConnectionStringAuthority)
                    dbConn.Open()
                    Using dbComm As New OleDbCommand(query, dbConn)
                        Using dbReader As OleDbDataReader = dbComm.ExecuteReader()
                            dbReader.Read()
                            If dbReader.HasRows Then authoritySegments = dbReader.GetValue(0).ToString
                        End Using
                    End Using
                End Using
                'Split segments and add array
                Dim trackSegmentsListRemoteDesk As String = String.Empty
                Dim splitSegmentData As String() = authoritySegments.Split("|")
                For Each oneSegment As String In splitSegmentData
                    If trackSegmentsListRemoteDesk = String.Empty Then
                        trackSegmentsListRemoteDesk = oneSegment
                    Else
                        trackSegmentsListRemoteDesk += "|" & oneSegment
                    End If
                Next
                AuthorityEventLog($"{GetCurrentMethod.Name}:LocalDesk={getRemoteDesk _
                                  }:AuthGUID={AuthGUID}:Segments={trackSegmentsListRemoteDesk}")
                Return trackSegmentsListRemoteDesk
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

