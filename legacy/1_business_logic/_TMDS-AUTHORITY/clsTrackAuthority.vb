        ''' <summary>
        ''' Check To Acknowledge Alert
        ''' </summary>
        Public Sub CheckToAcknowledgeAlert()
            Dim al As Alert
            Dim message As String
            Dim summItem As SummaryItem
            Dim theList As New ArrayList
            Dim auth As OtherSpecialAuthorityType
            Try
                For Each al In gSystemAlertList
                    If al.AlertObject IsNot Nothing AndAlso al.AlertObject.GetType.ToString = "TMDS.TrackAuthority.OtherSpecialAuthorityType" Then
                        auth = CType(al.AlertObject, OtherSpecialAuthorityType)
                        If auth.TrainSymbol = Me.TrainSymbol AndAlso auth.AuthGUID = Me.AuthGUID Then
                            message = "PTC ALERT WAS ACKNOWLEDGED BY SYSTEM FOR AUTHORITY:" & Me.AuthGUID
                            al.AlertAckedByPerson = message
                            TMDS.SystemUtilities.Utilities.SystemEvent(message)
                            gSystemAlertExists = False
                            summItem = New SummaryItem("ALERT", "ACKNOWLEDGE", al)
                            SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(summItem)
                            End SyncLock
                            theList.Add(al)
                        End If
                    End If
                Next
                Threading.Thread.Sleep(1000)
                For Each al In theList
                    summItem = New SummaryItem("ALERT", "REMOVE", al)
                    SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(summItem)
                    End SyncLock
                    TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                Next
                gSystemAlertExists = False
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                al = Nothing
                message = Nothing
                summItem = Nothing
                theList = Nothing
                auth = Nothing
            End Try
        End Sub

        Public Sub AppendAuthoritySegment(ByVal theSignal As Signal)
