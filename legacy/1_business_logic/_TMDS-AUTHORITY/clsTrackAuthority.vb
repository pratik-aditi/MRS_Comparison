            End Try
        End Sub

        Private Function SetTrackAuthorityInsertCommand(ByVal dbTable As String) As String
            Dim SQLFields As String
            Dim SQLValues As String
            Dim s As String = ","
            Dim q As String = "'"
            Dim sSetTrackAuthorityInsertCommand As String = String.Empty
            Try
                'FIELDS
                SQLFields = "(AuthorityNumber, RailRoadName, DispatcherName, CreateDate, Direction, AuthorityDate"
                SQLFields = SQLFields & ", AuthorityType, IssueTo, AuthorityLimits, OKTime"
                SQLFields = SQLFields & ", UntilTime, MobileID, Components, ReportClear, TerritoryAssignment"
                SQLFields = SQLFields & ", AuthorityUID, VehicleAssocations, JointAuthority, BehindTrains, BeginMilePostLimits, EndMilePostLimits"
                SQLFields = SQLFields & ", JointLimits, TerritoryAssignmentSecondary, AuthGUID, TerrIDTeritary, TerrIDQuadtary, CopyBy, IssuedToTrain"
                SQLFields = SQLFields & ", StatusOfDTC"
                SQLFields = SQLFields & ")"


                'VALUES
                SQLValues = " VALUES ("
                SQLValues = SQLValues & q & AuthorityNumber & q & s & q & RailRoadName & q & s & q & DispatcherName & q & s & q & CreateDate & q
                If Me.WorkDirection = "" Then
                    SQLValues = SQLValues & s & q & Direction & q
                Else
                    SQLValues = SQLValues & s & q & Direction & "-" & Me.WorkDirection & q
                End If
                SQLValues = SQLValues & s & q & AuthorityDate & q & s & q & AuthorityType & q & s & q & IssueTo & q
                SQLValues = SQLValues & s & q & AuthorityLimits & q & s & q & OKTime & q & s & q & UntilTime & q & s & q & MobileID & q
                SQLValues = SQLValues & s & q
                Dim comp As Object
                For Each comp In Me.ComponentsInSelection
                    SQLValues = SQLValues & CStr(comp.GUID) & "|"
                Next
                SQLValues = SQLValues & q
                SQLValues = SQLValues & s & q & Me.ReportClear & q & s & q & Me.TerritoryAssignment & q
                SQLValues = SQLValues & s & q & Me.AuthorityUID & q
                Dim VehicleString As String = String.Empty
                Dim VehicleInsertString As String = String.Empty
                If Not VehicleAssociations Is Nothing Then
                    For Each VehicleString In Me.VehicleAssociations
                        VehicleInsertString = VehicleInsertString & VehicleString & "|"
                    Next
                End If
                SQLValues = SQLValues & s & q & VehicleInsertString & q & s & CInt(JointAuthority)

                Dim TrainString As String = String.Empty
                Dim TrainInsertString As String = String.Empty
                If Not Me.BehindTrains Is Nothing Then
                    For Each TrainString In Me.BehindTrains
                        TrainInsertString = TrainInsertString & TrainString & "|"
                    Next
                End If
                SQLValues = SQLValues & s & q & TrainInsertString & q
                SQLValues = SQLValues & s & q & BeginMilePostLimits & q & s & q & EndMilePostLimits & q & s & q & Me.JointLimits & q
                SQLValues = SQLValues & s & Me.TerritoryAssignmentSecondary & s & q & Me.AuthGUID & q
                SQLValues = SQLValues & s & Me.TerrIDTeritary & s & q & Me.TerrIDQuadtary & q & s & q & Me.CopyBy & q & s & CInt(Me.IssuedToTrain)
                SQLValues = SQLValues & s & q & Me.StatusOfDTC & q

                SQLValues = SQLValues & ")"

                sSetTrackAuthorityInsertCommand = "INSERT INTO " & dbTable & SQLFields & SQLValues
                Return sSetTrackAuthorityInsertCommand
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function AddTrackAuthorityToDB(ByVal dbConnection As OleDbConnection) As Boolean
            Dim dbconn As OleDbConnection
            Dim CommandInsert As OleDbCommand

            Try
                Dim AuthorityInsertSQL As String = SetTrackAuthorityInsertCommand(gtblAuthActiveDTC)
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                CommandInsert = New OleDbCommand(AuthorityInsertSQL, dbconn)
                dbconn.Open()
                CommandInsert.ExecuteNonQuery()
                dbconn.Close()
                CommandInsert = Nothing

                Dim DoAddAuthorityEvent As New DoEventLogdtc(AddressOf Me.LogTheDTCEvent)
                DoAddAuthorityEvent.BeginInvoke(EventTypeDTC.ADD, Nothing, Nothing)

                Dim DoAuthorityEvent As New DoPublishTNTEvent(AddressOf Me.PublishTNTEventUpdate)
                DoAuthorityEvent.BeginInvoke(EventTypeDTC.ADD, Nothing, Nothing)

                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return False

            End Try
        End Function

        Public Function RemoveActiveAuthorityFromDB(ByVal dbConnection As OleDbConnection) As Boolean
            Dim dbconn As OleDbConnection
            Dim CommandInsert As OleDbCommand
            Dim CommandDelete As OleDbCommand
            Try
                Dim AuthorityInsertSQL As String = SetTrackAuthorityInsertCommand(gtblAuthInActiveDTC)
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                CommandInsert = New OleDbCommand(AuthorityInsertSQL, dbconn)
                dbconn.Open()
                CommandInsert.ExecuteNonQuery()
                dbconn.Close()

                Dim AuthorityDeleteSQL As String = "DELETE FROM " & gtblAuthActiveDTC & " WHERE AuthorityNumber = " & Me.AuthorityNumber & " AND TerritoryAssignment = " & Me.TerritoryAssignment
                CommandDelete = New OleDbCommand(AuthorityDeleteSQL, dbconn)
                If CommandDelete.Connection.State = ConnectionState.Connecting Or CommandDelete.Connection.State = ConnectionState.Open Then
                    CommandDelete.Connection.Close()
                End If
                dbconn.Open()
                CommandDelete.ExecuteNonQuery()
                dbconn.Close()
                CommandInsert = Nothing
                CommandDelete = Nothing

                Dim DoAddAuthorityEvent As New DoEventLogdtc(AddressOf Me.LogTheDTCEvent)
                DoAddAuthorityEvent.BeginInvoke(EventTypeDTC.REMOVE, Nothing, Nothing)

                Dim DoAuthorityEvent As New DoPublishTNTEvent(AddressOf Me.PublishTNTEventUpdate)
                DoAuthorityEvent.BeginInvoke(EventTypeDTC.REMOVE, Nothing, Nothing)

                'Me.SendStatusAuthorityElectronicMessage("TMDS DELETE")
                Me.StatusOfDTC = "DELETE"
                Me.SendStatusAuthorityElectronicMessage()

                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return False
            End Try

        End Function

