        Private Function CreateInsertCommandInActiveSFAVIII(ByVal dbTable As String) As String

            Try
                Dim SQLCommand As New StringBuilder
                SQLCommand.Append("INSERT INTO tblAuthoritiesSingleFormInActive")
                SQLCommand.Append(" SELECT tblAuthoritiesSingleFormActive.* FROM tblAuthoritiesSingleFormActive")
                SQLCommand.Append(" WHERE AuthGUID = '" & Me.AuthGUID & "'")
                Return SQLCommand.ToString

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

