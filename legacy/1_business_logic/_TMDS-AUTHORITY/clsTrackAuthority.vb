        Private Delegate Sub DoSendMovementAuthorityMessage110(ByVal trn As TrainID)

        Private Function CreateAuthorityTextForCN(ByVal IncludeOKTime As Boolean) As ArrayList
            Try
                Dim TextList As New ArrayList()
                TextList.Add(Space(30) & optRailRoadName & " TRACK AUTHORITY")
                TextList.Add(" ")

                TextList.Add(Space(5) & "AUTHORITY NO: " & Me.AuthorityUID & "                DATE: " & Format(Me.AuthDate, "MMM-dd-yyyy"))
                TextList.Add(" ")

                TextList.Add(Space(5) & "TO: " & Me.IssueTo)
                TextList.Add(" ")

                TextList.Add(Space(5) & "AT: " & Me.AtLocation)
                TextList.Add(" ")

                Dim Status As Boolean
                Dim IndexCount As Integer
                Dim AuthLine As String
                For Each Status In Me.CheckBoxItemsStatus
                    IndexCount = IndexCount + 1
                    If Status Then
                        Dim CheckItem As String = String.Empty
                        AuthLine = Space(5) & "[X] "

                        If IndexCount.ToString.Length = 1 Then
                            AuthLine = AuthLine & " " & IndexCount.ToString
                        Else
                            AuthLine = AuthLine & IndexCount.ToString
                        End If
                        AuthLine = AuthLine & "."

                        Select Case IndexCount
                            Case 1
                                AuthLine = AuthLine & "TRACK AUTHORITY NUMBER: "
                                Dim void As String
                                For Each void In Me.Box1Void
                                    AuthLine = AuthLine & " " & void & "  "
                                Next
                                AuthLine = AuthLine & " IS VOID."
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")

                            Case 2
                                AuthLine = AuthLine & " PROCEED  FROM " & Me.Box2From1
                                AuthLine = AuthLine & "  TO " & Me.Box2To1
                                AuthLine = AuthLine & "  ON " & Me.Box2Track1
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")

                                If Me.Box2From2 <> "" Then
                                    Dim LineTwo As String = " PROCEED  FROM  " & Me.Box2From2
                                    LineTwo = LineTwo & "  TO " & Me.Box2To2
                                    LineTwo = LineTwo & "  ON " & Me.Box2Track2
                                    TextList.Add(Space(23) & LineTwo)
                                    LineTwo = ""
                                    TextList.Add(" ")
                                End If

                                If Me.Box2From3 <> "" Then
                                    Dim LineThree As String = " PROCEED  FROM " & Me.Box2From3
                                    LineThree = LineThree & "  TO " & Me.Box2To2
                                    LineThree = LineThree & "  ON " & Me.Box2Track3
                                    TextList.Add(Space(23) & LineThree)
                                    LineThree = ""
                                    TextList.Add(" ")
                                End If

                            Case 3
                                AuthLine = AuthLine & "CLEAR MAIN TRACK AT " & Me.ClearMainLocationOne
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 5
                                AuthLine = AuthLine & "CLEAR MAIN TRACK AT " & Me.ClearMainLocationTwo
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 6
                                AuthLine = AuthLine & " WORK  BETWEEN " & Me.Box4From1
                                AuthLine = AuthLine & "  AND " & Me.Box4To1
                                AuthLine = AuthLine & "  ON  " & Me.Box4Track1
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")

                                If Me.Box4From2 <> "" Then
                                    Dim LineTwo As String = " WORK  BETWEEN " & Me.Box4From2
                                    LineTwo = LineTwo & "  AND " & Me.Box4To2
                                    LineTwo = LineTwo & "  ON  " & Me.Box4Track2
                                    TextList.Add(Space(22) & LineTwo)
                                    LineTwo = ""
                                    TextList.Add(" ")
                                End If
                            Case 4
                                AuthLine = AuthLine & " AUTHORITY  IN  EFFECT  AFTER  ARRIVAL  OF:"
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                Dim trn As String
                                For Each trn In Me.Box5Arrival
                                    AuthLine = AuthLine & "(" & trn & ") "
                                Next
                                TextList.Add(Space(23) & AuthLine)
                                AuthLine = ""

                                AuthLine = "AT " & Me.Box5At
                                TextList.Add(Space(23) & AuthLine)
                                AuthLine = ""
                            Case 7
                                AuthLine = AuthLine & " DO NOT SET ON AHEAD OF OR PASS PRECEDING TRAIN(S):"
                                Dim trn As String
                                For Each trn In Me.Box6Train
                                    AuthLine = AuthLine & "(" & trn & ") "
                                Next
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 8
                                If Not Me.JointAbsolute Then
                                    AuthLine = "JOINT AUTHORITY" & Space(2) & "BETWEEN " & Me.Box8From1 & " AND " & Me.Box8To1
                                Else
                                    AuthLine = "JOINT AUTHORITY"
                                End If
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                                Dim lap As String
                                For Each lap In Me.Box9List
                                    If lap <> "" Then
                                        TextList.Add(Space(25) & lap)
                                    End If
                                Next

                            Case 10
                                AuthLine = AuthLine & " CLEAR BY " & Format(Me.Box10ClearBy, "HH:mm")
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 12
                                AuthLine = "THIS WARRANT REQUIRES A MEET WITH ANOTHER TRAIN(s) AT " & Me.Box11TrainMeetLocation
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")

                            Case 11
                                AuthLine = AuthLine & Space(1) & Me.Box14Instructions
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 9
                                Dim Box9Switch As String
                                For Each Box9Switch In Me.Box12Switches
                                    If Box9Switch.Trim <> "" Then
                                        Box9Switch = Box9Switch
                                        If optEnableARRCSpecificOptions Then
                                            AuthLine = AuthLine & "PROTECT AGAINST OPEN SWITCH AT " & Box9Switch
                                            TextList.Add(AuthLine)
                                        Else
                                            AuthLine = "STOP AT " & Box9Switch & " UNTIL KNOWN THE SWITCH IS IN THE NORMAL POSITION."
                                            TextList.Add(Space(23) & AuthLine)
                                        End If


                                    End If
                                Next
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 10
                                AuthLine = AuthLine & " PERMISSION TO LEAVE FOLLOWING SWITCH(ES) IN REVERSE POSITION:"
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                Dim Box13Switch As String
                                For Each Box13Switch In Me.Box13Switches
                                    If Box13Switch.Trim <> "" Then
                                        AuthLine = AuthLine & "(" & Box13Switch & "),  "
                                    End If
                                Next
                                TextList.Add(Space(23) & AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                        End Select
                    End If
                Next
                AuthLine = ""
                TextList.Add(" ")



                AuthLine = AuthLine & Space(5) & "THIS AUTHORITY HAS " & Me.NumOfBoxesChecked.ToString & " BOX(ES) MARKED:  "
                Dim Box As String
                For Each Box In Me.BoxItems.Split(",")
                    If Box <> "" Then
                        AuthLine = AuthLine & Trim(Box).Replace("[", "").Replace("]", "") & "; "
                    End If
                Next
                TextList.Add(AuthLine)
                TextList.Add(" ")

                If IncludeOKTime Then
                    Dim OKstring As String = Space(5) & "OK " & Format(OKTime, "HH:mm") & ", " & TMDS.GlobalDeclarations.gCurrentUser.Initials
                    TextList.Add(OKstring)
                    Dim RTC As String = Space(5) & "RTC: " & Me.DispName & "  COPIED BY:" & Me.CopiedBy
                    TextList.Add(RTC)

                End If
                Return TextList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function CreateAuthorityText(ByVal IncludeOKTime As Boolean) As ArrayList
            Try
                Dim TextList As New ArrayList()
                TextList.Add(Space(30) & optRailRoadName & " TRACK WARRANT FORM")
                TextList.Add(" ")

                TextList.Add(Space(5) & "TRACK WARRANT NO: " & Me.AuthorityUID & "                DATE: " & Format(Me.AuthDate, "MMM-dd-yyyy"))
                TextList.Add(" ")
                'If IncludeSubName Then
                '    TextList.Add(Space(5) & "ON SUBDIVISION: " & me.Subdivision )
                '    TextList.Add(" ")
                'End If
                TextList.Add(Space(5) & "TO: " & Me.IssueTo)
                TextList.Add(" ")

                Dim Status As Boolean
                Dim IndexCount As Integer
                Dim AuthLine As String
                For Each Status In Me.CheckBoxItemsStatus
                    IndexCount = IndexCount + 1
                    If Status Then
                        Dim CheckItem As String = String.Empty
                        AuthLine = Space(5) & "[X] "

                        If IndexCount.ToString.Length = 1 Then
                            AuthLine = AuthLine & " " & IndexCount.ToString
                        Else
                            AuthLine = AuthLine & IndexCount.ToString
                        End If
                        AuthLine = AuthLine & "."

                        Select Case IndexCount
                            Case 1
                                AuthLine = AuthLine & " VOID AUTHORITY NUMBER(s): "
                                Dim void As String
                                For Each void In Me.Box1Void
                                    AuthLine = AuthLine & " " & void & ";  "
                                Next
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")

                            Case 2
                                AuthLine = AuthLine & " PROCEED  FROM " & Me.Box2From1
                                AuthLine = AuthLine & "  TO " & Me.Box2To1
                                AuthLine = AuthLine & "  ON " & Me.Box2Track1
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")

                                If Me.Box2From2 <> "" Then
                                    Dim LineTwo As String = " PROCEED  FROM  " & Me.Box2From2
                                    LineTwo = LineTwo & "  TO " & Me.Box2To2
                                    LineTwo = LineTwo & "  ON " & Me.Box2Track2
                                    TextList.Add(Space(23) & LineTwo)
                                    LineTwo = ""
                                    TextList.Add(" ")
                                End If

                                If Me.Box2From3 <> "" Then
                                    Dim LineThree As String = " PROCEED  FROM " & Me.Box2From3
                                    LineThree = LineThree & "  TO " & Me.Box2To2
                                    LineThree = LineThree & "  ON " & Me.Box2Track3
                                    TextList.Add(Space(23) & LineThree)
                                    LineThree = ""
                                    TextList.Add(" ")
                                End If

                            Case 3
                                AuthLine = AuthLine & "CLEAR AT LAST NAMED POINT."
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 4
                                AuthLine = AuthLine & " WORK  BETWEEN " & Me.Box4From1
                                AuthLine = AuthLine & "  AND " & Me.Box4To1
                                AuthLine = AuthLine & "  ON  " & Me.Box4Track1
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")

                                If Me.Box4From2 <> "" Then
                                    Dim LineTwo As String = " WORK  BETWEEN " & Me.Box4From2
                                    LineTwo = LineTwo & "  AND " & Me.Box4To2
                                    LineTwo = LineTwo & "  ON  " & Me.Box4Track2
                                    TextList.Add(Space(22) & LineTwo)
                                    LineTwo = ""
                                    TextList.Add(" ")
                                End If
                            Case 5
                                AuthLine = AuthLine & " AUTHORITY  IN  EFFECT  AFTER  ARRIVAL  OF:"
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                Dim trn As String
                                For Each trn In Me.Box5Arrival
                                    AuthLine = AuthLine & "(" & trn & ") "
                                Next
                                TextList.Add(Space(23) & AuthLine)
                                AuthLine = ""

                                AuthLine = "AT " & Me.Box5At
                                TextList.Add(Space(23) & AuthLine)
                                AuthLine = ""
                            Case 6
                                AuthLine = AuthLine & " AUTHORITY IN EFFECT BEHIND:"
                                Dim trn As String
                                For Each trn In Me.Box6Train
                                    AuthLine = AuthLine & "(" & trn & ") "
                                Next
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 8
                                AuthLine = AuthLine & " JOINT AUTHORITY BETWEEN " & Me.Box8From1
                                AuthLine = AuthLine & "  AND " & Me.Box8To1
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 9
                                AuthLine = AuthLine & " OVERLAPS:"
                                TextList.Add(AuthLine)
                                AuthLine = ""

                                Dim lap As String
                                For Each lap In Me.Box9List
                                    If lap <> "" Then
                                        TextList.Add(Space(25) & lap)
                                    End If
                                Next
                            Case 10
                                AuthLine = AuthLine & " CLEAR BY " & Format(Me.Box10ClearBy, "HH:mm")
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 15

                            Case 14
                                AuthLine = AuthLine & Space(1) & Me.Box14Instructions
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 12
                                AuthLine = AuthLine & " BE PREPARED TO STOP AT FOLLOWING SWITCH(ES) UNTIL KNOWN TO BE IN NORMAL POSITION:"
                                TextList.Add(AuthLine)
                                AuthLine = ""

                                Dim BOX12Switch As String
                                For Each BOX12Switch In Me.Box12Switches
                                    If BOX12Switch.Trim <> "" Then
                                        AuthLine = AuthLine & "(" & BOX12Switch & "),  "
                                    End If
                                Next
                                TextList.Add(Space(23) & AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                            Case 13
                                AuthLine = AuthLine & " PERMISSION TO LEAVE FOLLOWING SWITCH(ES) IN REVERSE POSITION:"
                                TextList.Add(AuthLine)
                                AuthLine = ""
                                Dim Box13Switch As String
                                For Each Box13Switch In Me.Box13Switches
                                    If Box13Switch.Trim <> "" Then
                                        AuthLine = AuthLine & "(" & Box13Switch & "),  "
                                    End If
                                Next
                                TextList.Add(Space(23) & AuthLine)
                                AuthLine = ""
                                TextList.Add(" ")
                        End Select
                    End If
                Next
                AuthLine = ""
                TextList.Add(" ")


                AuthLine = AuthLine & Space(5) & Me.NumOfBoxesChecked.ToString & " BOX(ES) MARKED:  "
                Dim Box As String
                For Each Box In Me.BoxItems.Split(",")
                    If Box <> "" Then
                        AuthLine = AuthLine & Trim(Box).Replace("[", "").Replace("]", "") & "; "
                    End If
                Next
                TextList.Add(AuthLine)

                If IncludeOKTime Then
                    TextList.Add(Space(5) & "---------------------------------------------------------")
                    Dim OKHeader As String = Space(5) & "TRACK WARRANT " & Me.AuthorityUID & ", TO " & Me.IssueTo
                    TextList.Add(OKHeader)


                    If Me.CheckBoxItemsStatus(4) Then
                        Dim Box5Line As String = Space(5) & "WITH AFTER THE ARRIVAL OF:"
                        TextList.Add(Box5Line)

                        Dim box5Trn As String
                        Box5Line = ""
                        For Each box5Trn In Me.Box5Arrival
                            Box5Line = Box5Line & "(" & box5Trn & ") "
                        Next
                        Box5Line = "                                     " & Box5Line
                        TextList.Add(Box5Line)

                        Box5Line = ""
                        Box5Line = "                                     AT " & Me.Box5At
                        TextList.Add(Box5Line)
                    End If


                    Dim OKstring As String = Space(5) & "IS OK AT " & Format(OKTime, "HH:mm") & ", " & TMDS.GlobalDeclarations.gCurrentUser.Initials
                    TextList.Add(OKstring)

                End If
                Return TextList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub SendElectronicAuthority()
            Try
                SystemEvent("SendElectronicAuthority:" & Me.AuthorityUID & " WAS SELECTED!")
                Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIssueToAuthority(Me.IssueTo)
                If IsNothing(trn) Then SystemEvent("SendElectronicAuthority:" & Me.AuthorityUID & " - NO TRAIN FOUND.") : Exit Sub
                Me.VETMS_PerformIssuance(trn)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub PTCTransmissionCompleted()
            Try
                Me.SetPTCAuthorityFlasherStatus()
                Me.FlasherMode(False, True)

                Me.PTCAuthorityACKPending = ""
                Me.PTCAuthorityComponents = New ArrayList
                Me.UpdateDatabaseWithPTCComponents()
                VETMS_TerminatePTCTimerIssuance()
                VETMS_TerminatePTCTimerRelease()
                VETMS_TerminatePTCTimerRollup()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Me.PTCElectronicTransmissionInProgress = False
            End Try
        End Sub

