                                        End Select
                                    End If
                                End If
                            Else
                                Exit For
                            End If
                        Next



                End Select

                Dim str As New StringBuilder("RollupTracks -" & Me.AuthGUID & vbCrLf)
                For Each NextComp In TmpComplist
                    If NextComp.GetType.ToString = gTrackComponentName Then
                        str.Append(NextComp.GUID & ":" & NextComp.GetType.ToString & "  " & NextComp.AUTHORITYTYPE & vbCrLf)
                    Else
                        str.Append(NextComp.GUID & ":" & NextComp.GetType.ToString & vbCrLf)
                    End If
                Next
                SystemDiagnosticEvent(str.ToString)
                Return TmpComplist
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return Nothing
        End Function

        Public Sub PopulateSwitchList(SwitchListString As String)
            Dim sw As Switch = Nothing
            Try

                If SwitchListString IsNot Nothing AndAlso Not String.IsNullOrEmpty(SwitchListString) AndAlso SwitchListString.Trim <> "" Then
                    Dim MainData() As String = SwitchListString.Split(";")
                    Dim s As String = ""
                    If MainData.Length > 0 Then
                        For Each s In MainData
                            If s.Trim <> "" Then
                                Dim tmpdata() As String = s.Split("|")
                                If tmpdata.Length > 1 Then
                                    sw = Nothing
                                    Dim swGUID As Integer = 0
                                    Dim swState As Boolean
                                    Integer.TryParse(tmpdata(0), swGUID)
                                    Boolean.TryParse(tmpdata(1), swState)
                                    If swGUID > 0 Then
                                        sw = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(swGUID)
                                        If sw IsNot Nothing Then
                                            Dim swpt As New SwitchPoint
                                            With swpt
                                                .myName = sw.Name
                                                .mySwitch = sw
                                                .ReversePosition = swState
                                            End With
                                            If Not Me.SwitchPointList.Contains(swpt) Then Me.SwitchPointList.Add(swpt)
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                sw = Nothing
            End Try
        End Sub

