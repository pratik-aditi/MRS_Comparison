        Public Function CreateAuthoritySegmentsForPTC() As String
            Try

                Dim CurrentTrackName As String = String.Empty
                Dim comp As Object
                Dim TrackSegments As New ArrayList
                Dim CurrentTrackList As ArrayList = Nothing
                Dim IsBidirectional As Boolean
                IsBidirectional = True

                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(comp, Track)
                        'If Mid(trk.AuthorityType.Trim.ToUpper, 1, 3) <> "TWC" Then
                        If CurrentTrackName = "" Then
                            CurrentTrackName = trk.TrackName
                            Dim trackList As New ArrayList
                            CurrentTrackList = trackList
                            TrackSegments.Add(CurrentTrackList)
                        End If
                        If trk.TrackName = CurrentTrackName Then
                            CurrentTrackList.Add(comp)
                        Else
                            CurrentTrackName = trk.TrackName
                            Dim trackList As New ArrayList
                            CurrentTrackList = trackList
                            TrackSegments.Add(CurrentTrackList)
                        End If
                    Else
                        CurrentTrackList.Add(comp)
                    End If
                    'End If
                Next

                'UID;BEGIN_LIMIT;BEGIN_MILEPOST;END_LIMIT;END_MILEPOST;PREFIX;SUFFIX;TRACK NAME(SUBUID|NEXT SEGMENT|NEXT SEGMENT|...ETC
                Dim BeginPrefix As String = String.Empty
                Dim BeginMilePost As String = String.Empty
                Dim BeginSuffix As String = String.Empty
                Dim EndPrefix As String = String.Empty
                Dim EndMilePost As String = String.Empty
                Dim EndSuffix As String = String.Empty
                Dim theTrackName As String = String.Empty

                Dim Segment As New StringBuilder
                Dim theList As ArrayList
                Dim LastComp As Object = Nothing
                For Each theList In TrackSegments
                    Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(theList)
                    Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(theList)

                    Segment.Append(Format(Now, "mmssfffff"))
                    Segment.Append(";")
                    If theList.Count = 1 Then
                        If Direction = "RIGHT" Then
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitMilePost)
                            Segment.Append(";")
                        Else
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitMilePost)
                            Segment.Append(";")
                        End If
                        Segment.Append(FirstTrack.MilePostPrefix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.MilePostSuffix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.TrackName)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.SubdivisionID)
                        Segment.Append(";")
                        Segment.Append(IsBidirectional.ToString.ToUpper)


                    Else
                        If Me.Direction = "RIGHT" Then
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(LastTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(LastTrack.RightLimitMilePost)
                            Segment.Append(";")
                        Else
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(LastTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(LastTrack.LeftLimitMilePost)
                            Segment.Append(";")
                        End If
                        Segment.Append(FirstTrack.MilePostPrefix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.MilePostSuffix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.TrackName)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.SubdivisionID)
                        Segment.Append(";")
                        Segment.Append(IsBidirectional.ToString.ToUpper)

                    End If
                    Segment.Append("|")
                Next
                Return Segment.ToString

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try

        End Function

