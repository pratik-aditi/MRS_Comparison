        Private Delegate Sub DoEventLogWarrant(ByVal EventType As EventTypeWarrant)

        Public Sub LogTheWarrantEvent(ByVal EventType As EventTypeWarrant)
            Try
                Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.LastName & "," & TMDS.GlobalDeclarations.gCurrentUser.FirstName
                Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                Dim CurTerr As Territory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(Me.TerritoryAssignment)
                Dim LogString As String = "INSERT INTO tblSystemEvents "
                'Dim SqlFields As String = "(EventTime, Territory, Wrkstn, SysUser, DbVer, FuncType, UID, Event, SysData)"
                Dim SqlFields As String = "([EventTime], [Territory], [Wrkstn], [SysUser], [DbVer], [FuncType], [UID], [Event], [SysData])"
                Dim SqlValues As String
                Dim c As String = ", "
                Dim q As String = "'"
                SqlValues = " VALUES (" & q & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & q & c & Me.TerritoryAssignment & c & CurWrkstn & c & q & CurUser & q & c
                SqlValues = SqlValues & q & CurTerr.Dbversion & q & c & q & "TRACK-WARRANT" & q & c & q & Me.WarrantNumber & q & c

                Select Case EventType
                    Case EventTypeWarrant.ADD
                        SqlValues = SqlValues & q & "ISSUED" & q & c & q
                        SqlValues = SqlValues & Me.IssueTo & "|"
                        SqlValues = SqlValues & Me.WarrantType & "|"
                        SqlValues = SqlValues & Me.Direction & "|"
                        SqlValues = SqlValues & Me.WarrantDate.ToShortDateString & "|"
                        SqlValues = SqlValues & Me.WarrantGUID & "|"
                        SqlValues = SqlValues & Me.OKTime.ToLongTimeString & "|"

                        If Not IsNothing(Me.SelectionComponents) Then
                            Dim comp As Object
                            For Each comp In Me.SelectionComponents
                                SqlValues = SqlValues & comp.GUID.ToString & ";"
                            Next
                        End If
                        SqlValues = SqlValues & "|"

                        If Not IsNothing(Me.SelectionComponentsSecondary) Then
                            Dim comp As Object
                            For Each comp In Me.SelectionComponentsSecondary
                                SqlValues = SqlValues & comp.GUID.ToString & ";"
                            Next
                        End If
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"


                    Case EventTypeWarrant.REMOVE
                        SqlValues = SqlValues & q & "REMOVE" & q & c & q & Nothing & q
                        SqlValues = SqlValues & ")"

                    Case EventTypeWarrant.ROLLUP
                        SqlValues = SqlValues & q & "ROLLUP" & q & c & q

                        SqlValues = SqlValues & Me.IssueTo & "|"
                        SqlValues = SqlValues & Me.WarrantType & "|"
                        SqlValues = SqlValues & Me.Direction & "|"
                        SqlValues = SqlValues & Me.WarrantDate.ToShortDateString & "|"
                        SqlValues = SqlValues & Me.WarrantGUID & "|"
                        SqlValues = SqlValues & Me.OKTime.ToLongTimeString & "|"

                        If Not IsNothing(Me.SelectionComponents) Then
                            Dim comp As Object
                            For Each comp In Me.SelectionComponents
                                SqlValues = SqlValues & comp.GUID.ToString & ";"
                            Next
                        End If
                        SqlValues = SqlValues & "|"

                        If Not IsNothing(Me.SelectionComponentsSecondary) Then
                            Dim comp As Object
                            For Each comp In Me.SelectionComponentsSecondary
                                SqlValues = SqlValues & comp.GUID.ToString & ";"
                            Next
                        End If
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"

                    Case EventTypeWarrant.UPDATE
                End Select
                'SyncLock TMDS.GlobalDeclarations.gSystemEventLogQueue
                TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(LogString & SqlFields & SqlValues)
                'End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

