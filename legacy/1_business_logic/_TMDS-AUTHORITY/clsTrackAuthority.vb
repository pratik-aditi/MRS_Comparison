                            'TrackCount = TrackCount + 1
                        Next
                        If Not UpdateDatabaseWithRollUpEvent(dbConnection) Then
                            'Log an error
                        End If
                    Else
                        Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.DispatcherEvent, "SELECTED NO TO ROLL UP TRACK WARRANT:" & WarrantNumber, SystemEventQueue)
                    End If
                Else
                    Return False
                End If
                ClearSelection()
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSelection()
                Dim ErrorMessage As String = "Track Warrant " & WarrantNumber & " Not Rolled Up Properly! CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                Return False
            End Try
        End Function

        Private Function PerformSwitchConfirmation(ByVal ReleasingLimits As String) As Boolean
            Dim FormPosition As New Point(300, 400)
            Dim gHistoryMessage As String
            Dim CurrentWarrantItem As Warrant = Me
            Dim ReleaseOSTrack As Track
            Dim Response As Boolean
            Try
                Try
                    ReleaseOSTrack = CurrentWarrantItem.SelectionComponents(CurrentWarrantItem.SelectionComponents.Count - 1)
                    If IsNothing(ReleaseOSTrack) Then
                        FormPosition = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + 100, 500)
                    Else
                        FormPosition = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + ReleaseOSTrack.CurrentDrawingForm.Left + 100, 500)
                    End If
                Catch
                End Try
                Dim Box20Switches As String = String.Empty
                Dim str As String
                For Each str In CurrentWarrantItem.Box21
                    Box20Switches = Box20Switches & " " & str
                Next

                Dim frmMessageBox1 As frmMessageBox
                Dim MessageList1 As New ArrayList()
                MessageList1.Add("Operations Supervisor will confirm with employee reporting complete by a location on a track warrant:".ToUpper)
                MessageList1.Add(" ")
                MessageList1.Add(Me.IssueTo & " USING TRACK WARRANT " & Me.WarrantNumber)
                MessageList1.Add("COMPLETE BY " & ReleasingLimits & " AT " & Format(Now, "HH:mm") & " " & gCurrentUser.Initials & " IS THAT CORRECT?")
                MessageList1.Add(" ")
                MessageList1.Add(" ")
                MessageList1.Add("Employee will confirm with Operations Supervisor:".ToUpper)
                MessageList1.Add("That is correct, COMPLETE BY ".ToUpper & ReleasingLimits & " BY 'TEXTBOX'Occupation/Name".ToUpper)
                MessageList1.Add("")
                MessageList1.Add("Select YES to confirm that required Track Warrant Complete By confirmation process has taken place.".ToUpper)

                frmMessageBox1 = New frmMessageBox()
                frmMessageBox1.Owner = TMDS.SystemForms.MySystemForms.frmMainMDI
                frmMessageBox1.SetMessage(MessageList1, "COMPLETE BY CONFIRMATION " & Me.WarrantNumber, True, FormPosition)
                frmMessageBox1.ShowDialog()
                If frmMessageBox1.FormFeedBack = 6 Then
                    Response = True
                Else
                    gHistoryMessage = "SELECTED - NO ON THE REPORT LIMITS CLEAR ON TRACK WARRANT:" & Me.WarrantNumber
                    SystemEvent(gHistoryMessage)
                End If
                frmMessageBox1.Close()
                frmMessageBox1.Dispose()
                Return Response
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

