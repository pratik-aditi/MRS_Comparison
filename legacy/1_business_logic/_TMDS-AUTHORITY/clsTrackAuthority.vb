            Try
                Dim theSub As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(theSignal.SubdivisionID)
                If Not IsNothing(theSub) Then
                    SubUID = theSub.PTCUID
                End If

                If optUseNewComponetLoadPTCInfo Then
                    ' = theSignal.myControlPoint.PTC_SiteName '"CP FREMONT"
                    ' SiteName = theSignal.PTC_DeviceName

                    DeviceName = theSignal.PTC_DeviceName '"CP FREMONT"
                    SiteName = theSignal.myControlPoint.PTC_SiteName
                Else
                    Dim theData() As String = theSignal.PTC_DeviceName.Split("|")
                    If theData.Length > 1 Then
