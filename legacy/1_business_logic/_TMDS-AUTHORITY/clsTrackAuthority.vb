#Region "CHANGE AUTHORITY TYPE"

        Public Sub ChangeAuthorityType(ByVal ChangeToType As String, ByVal DirectionChange As String)
            Try
                Me.AuthorityType = ChangeToType
                Me.Direction = DirectionChange
                Me.StatusOfDTC = "PENDING"

                Dim comp As Object
                For Each comp In Me.ComponentsInSelection
                    comp.UpdateStatus()
                Next

                Select Case ChangeToType
                    Case "DTC-PROCEED"
                    Case "DTC-WORK"
                    Case "DTC-JOINT"
                    Case "DTC-INSPECTION"
                End Select
                UpdateDatabaseOnChangeAuthType()

                Dim SummItem As New SummaryItem("AUTHORITY", "MODIFY", Me)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock
                Me.SendCreateChangeAuthorityElectronicMessage()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

#End Region

#Region "AUTHORITY ADD/REMOVE"

        Public Sub PartialRelease(ByVal BlockList As ArrayList)
            Try

                Dim comp As Object
                For Each comp In BlockList
                    Me.ComponentsInSelection.Remove(comp)
                    comp.Authorities.Remove(Me)
                    comp.BlockAbsolute = False
                    comp.DTCAuthority = False
                    comp.TrafficDirection = ""
                    comp.ActiveTrackWarrant = False
                    comp.UpdateStatus()
                    comp.InitAuthorityNumbers()
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub CreateReducedLimitsVerbiage()
            Try
                Dim Limits() As String = Me.AuthorityLimits.Split("|")
                Dim VerbiageLimits, EachLine As String
                For Each EachLine In Limits 'I = 0 To Limits.Length - 1
                    If EachLine <> "" Then
                        VerbiageLimits = ""
                        Select Case Mid(EachLine, 1, 4)
                            Case "GRAN"
                                VerbiageLimits = EachLine.Remove(0, 8)
                                ReducedLimitsVerbiage = ReducedLimitsVerbiage & VerbiageLimits.ToUpper & "| |"
                                'LongMessage.Add(VerbiageLimits.ToUpper)
                            Case "BETW"
                                Dim datastring() As String = EachLine.Split(",")
                                If datastring.Length = 3 Then
                                    VerbiageLimits = "BETWEEN " & datastring(1)
                                ElseIf datastring.Length = 2 Then
                                    VerbiageLimits = datastring(0)
                                Else
                                    VerbiageLimits = EachLine
                                End If
                                'LongMessage.Add(VerbiageLimits.ToUpper)
                                ReducedLimitsVerbiage = ReducedLimitsVerbiage & VerbiageLimits.ToUpper & "| |"
                            Case "AND "
                                Dim datastring() As String = EachLine.Split(",")
                                If datastring.Length = 3 Then
                                    VerbiageLimits = "AND " & datastring(1)
                                ElseIf datastring.Length = 2 Then
                                    VerbiageLimits = datastring(0)
                                Else
                                    VerbiageLimits = EachLine
                                End If
                                'LongMessage.Add(VerbiageLimits.ToUpper)
                                ReducedLimitsVerbiage = ReducedLimitsVerbiage & VerbiageLimits.ToUpper & "| |"
                            Case Else
                                VerbiageLimits = EachLine
                                ReducedLimitsVerbiage = ReducedLimitsVerbiage & VerbiageLimits.ToUpper & "| |"

                        End Select

                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function RemoveActiveAuthorityFromComponents(ByVal dbConnection As OleDbConnection) As Boolean
            Dim comp As Object
            Try
                For Each comp In Me.ComponentsInSelection
                    comp.Authorities.Remove(Me)
                    comp.UpdateStatus()
                    If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Or comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.Authorities.Count = 0 Then
                            comp.BlockAbsolute = False
                            comp.DTCAuthority = False
                            comp.TrafficDirection = ""
                            comp.ActiveTrackWarrant = False
                        End If

                        comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                        comp.Flasher.Interval = 250
                        comp.FlashOn = False
                        comp.FlashComponent = False

                        comp.UpdateStatus()
                    End If

                Next

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try

        End Function

        Public Sub GetBlockCount()
            Try
                Dim comp As Object
                Dim BlockID As Int32
                Dim BlockCounter As Integer
                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.PTCBlockID <> BlockID Then
                            BlockCounter = BlockCounter + 1
                            BlockID = comp.PTCBlockID
                        End If
                    End If
                Next
                BlockCount = BlockCounter
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
