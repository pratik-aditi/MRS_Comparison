                    UserPrompt = UserPrompt & "ROLL UP CONFIRMATION TIME: " & Format(Now, "MMM-dd-yyyy  HH:mm") & vbCrLf & vbCrLf

                    UserPrompt = UserPrompt & "ROLL UP THESE LIMITS, ARE YOU SURE?"
                    RollupLimits = "FROM " & LeftLimits & " TO " & RightLimits
