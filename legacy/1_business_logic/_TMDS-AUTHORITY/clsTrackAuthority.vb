#Region "VETMS-PTC ROLLUP METHODS"

        Public Sub VETMS_PerformRollup(ByVal theTrain As TrainID, ByVal RollupEvent As String, ByVal RollupList As ArrayList, Optional ByVal EnableRollupConfimationTimer As Boolean = True)
            Try
                Dim NewTrackSegments As String = "" 'CreateAuthoritySegmentsFromRollupForPTC(RollupList)
                If gEnablePTCVETMSTrackSegmentMultipleSubs Then
                    NewTrackSegments = CreateAuthoritySegmentsFromRollupMultipleSubsForPTC(RollupList)
                Else
                    NewTrackSegments = CreateAuthoritySegmentsFromRollupForPTC(RollupList)
                End If


                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                Me.PTCTypeAuthority = True
                Me.PTCElectronicTransmissionInProgress = True
                Me.UpdateDatabaseWithPTCAuthorityStatus("ROLLUP-SENT")
                Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ROLLUP.ToString
                Me.PTCAuthorityComponents = RollupList
                Me.UpdateDatabaseWithPTCComponents()

                Me.PTCStatus = "RELEASE-SENT"
                Me.SetPTCAuthorityFlasherStatus()
                If Not optDisableFlashingTrackForPTC Then Me.FlasherMode(True, True)

                'If optEnableARRCSpecificOptions Then
                '    Me.PTCAuthorityTextAppend(RollupEvent)

                'End If

                Me.PTCSentTimeStamp = Now

                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageRollup_TWC(Me, theTrain, NewTrackSegments, RollupEvent, PTCMessageUID)
                If Me.UpdateDatabaseWithPTCAuthorityStatus("SENT") Then
                    Me.PTCStatus = "AUTHORITY-SENT"
                    Dim SummItem1 As New SummaryItem("AUTHORITY", "UPDATE-PTC", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If
                If EnableRollupConfimationTimer Then VETMS_CreateTimerRollupEvent()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub VETMS_CreateTimerRollupEvent()
            Try
                PTCRollupTimeExpired = False

                If IsNothing(PTCTimerRollup) Then
                    PTCTimerRollup = New Timers.Timer(gPTCTimeOutTransmissionAuthorityRollup)
                    AddHandler PTCTimerRollup.Elapsed, AddressOf VETMS_CheckStatusRollup
                    PTCTimerRollup.Enabled = True
                Else
                    PTCTimerRollup.Start()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub VETMS_CheckStatusRollup(ByVal source As Object, ByVal e As Timers.ElapsedEventArgs)
            Try
                If Not PTCRollupSuccessful Then
                    VETMS_GenerateAlertForFailedRollUp()
                End If
                PTCRollupTimeExpired = True
                VETMS_TerminatePTCTimerRollup()
            Catch ex As Exception
                SystemException(ex.ToString)
                PTCRollupTimeExpired = True
            End Try
        End Sub

        Public Sub VETMS_TerminatePTCTimerRollup()
            Try
                Me.PTCRollupSuccessful = False
                If IsNothing(PTCTimerRollup) Then Exit Sub
                RemoveHandler PTCTimerRollup.Elapsed, AddressOf VETMS_CheckStatusRollup
                PTCTimerRollup.Enabled = False
                PTCTimerRollup.Dispose()
                PTCTimerRollup = Nothing
                Me.PTCMarkedToBeRolledUpElectronically = False
                ' Me.PTCRollupTimeExpired = False
                Me.PTCRollupSuccessful = False

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Me.PTCElectronicTransmissionInProgress = False
            End Try
        End Sub

        Private Sub VETMS_GenerateAlertForFailedRollUp()
            Try
                Dim theTrain As TrainID = TrainExistsForAuthority(Me)
                Dim AlertMessage As String = optPTCString020 & " (" & Me.AuthorityUID & ") | " & optPTCString019 & " (" & Me.IssueTo & ") " & optPTCString023
                If Not TMDS.SystemUtilities.Utilities.CheckForAlertExtistence(Me) Then
                    TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.VETMS_PTC_TWC_AuthorityRollUpRequestFailed, AlertMessage, theTrain, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Me)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub VETMS_TerminatePTCRollupProcess()
            Try
                VETMS_TerminatePTCTimerRollup()
                Me.PTCMarkedToBeRolledUpElectronically = False
                Me.PTCRollupTimeExpired = False
                Me.PTCRollupSuccessful = False
                Me.PTCAuthorityACKPending = ""
                Me.PTCAuthorityComponents = New ArrayList
                Me.UpdateDatabaseWithPTCComponents()
                Me.tmpPTCRollupAuthorityText = String.Empty
                Me.FlasherMode(False, True)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Me.PTCElectronicTransmissionInProgress = False
            End Try
        End Sub

        Public Sub VETMS_GenerateRollupFailure()
            Try
                If Not PTCRollupSuccessful Then
                    VETMS_GenerateAlertForFailedRollUp()
                End If
                VETMS_TerminatePTCTimerRollup()

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Me.PTCElectronicTransmissionInProgress = False
            End Try
        End Sub

