        Public Function CreateAuthoritySegmentsFromRollupMultipleSubsForPTC(ByVal theRollUpList As ArrayList) As String
            Dim SubDivList As New ArrayList
            Dim SubdivID As Integer = 0
            Dim Comp As Object = Nothing
            Dim TempSegList As New StringBuilder
            Dim tempCompList As New ArrayList
            Dim strSegList As String = ""



            Try
                For Each Comp In theRollUpList
                    If Comp.GetType.ToString = gTrackComponentName Then
                        If Comp.SubdivisionID > 0 AndAlso Not SubDivList.Contains(Comp.SubdivisionID) Then
                            SubDivList.Add(Comp.SubdivisionID)
                        End If
                    End If
                Next
                If SubDivList IsNot Nothing AndAlso SubDivList.Count > 0 Then
                    For Each SubdivID In SubDivList
                        tempCompList = New ArrayList
                        strSegList = ""
                        For Each Comp In theRollUpList
                            If Comp.GetType.ToString = gTrackComponentName Then
                                If Comp.SubdivisionID > 0 AndAlso Comp.SubdivisionID = SubdivID Then
                                    If Not tempCompList.Contains(Comp) Then tempCompList.Add(Comp)
                                End If
                            End If
                        Next
                        If tempCompList IsNot Nothing AndAlso tempCompList.Count > 0 Then
                            strSegList = CreateAuthoritySegmentsFromRollupForPTCMultipleSubsForPTC(tempCompList)
                            If strSegList IsNot Nothing AndAlso Not String.IsNullOrEmpty(strSegList) AndAlso strSegList.Trim <> "" Then
                                TempSegList.Append(strSegList)
                            End If
                        End If
                    Next
                Else
                    Return String.Empty
                End If
                Return TempSegList.ToString



            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try

        End Function

