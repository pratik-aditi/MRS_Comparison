        Private Delegate Sub DoPublishTWCEvent(ByVal EventType As EventTypeTWC)

        Public Sub PublishTWCEventUpdate(ByVal EventType As EventTypeTWC)
            Try
                Dim Message As String = "DC" & Chr(6) & "TWC;"
                Message = Message & "|" & Me.TerritoryAssignment.ToString

                Select Case EventType
                    Case EventTypeTWC.ADD
                        Message = Message & "|" & "CREATE"
                    Case EventTypeTWC.REMOVE
                        Message = Message & "|" & "DELETE"
                    Case EventTypeTWC.UPDATE
                        Message = Message & "|" & "UPDATE"
                    Case EventTypeTWC.ROLLUP
                        Message = Message & "|" & "ROLLUP"
                End Select

                Message = Message & "|" & Me.WarrantGUID
                Message = Message & "|" & Me.WarrantNumber
                Message = Message & "|" & Me.WarrantDate
                Message = Message & "|" & Me.WarrantType
                Message = Message & "|" & Me.DispatcherName
                Message = Message & "|" & Me.IssueTo
                Dim comp As Object

                Dim CompList As String = String.Empty
                For Each comp In Me.SelectionComponents
                    CompList = CompList & "-" & comp.GUID
                Next
                Message = Message & "|COMPONENTS" & CompList
                Message = Message & "|" & Me.Direction

                Message = Me.TerritoryAssignment.ToString & Chr(12) & Message
                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                End SyncLock

            Catch EX As Exception
                SystemException(EX.ToString)
            End Try
        End Sub

