        Public Sub LogTheSFAEvent(ByVal pEventType As EventLogTypeSFA)
            Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.LastName & "," & TMDS.GlobalDeclarations.gCurrentUser.FirstName
            Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
            Dim CurTerr As Territory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(Me.TerrID1)
            Dim LogString As String = "INSERT INTO tblSystemEvents "
            Dim SqlFields As String = "([EventTime], [Territory], [Wrkstn], [SysUser], [DbVer], [FuncType], [UID], [Event], [SysData])"
            Dim SqlValues As String
            Dim c As String = ", "
            Dim q As String = "'"
            Dim comp As Object
            Dim CompList As String = String.Empty
            Dim veh As String
            Dim sw As String = String.Empty
            Try
                SqlValues = " VALUES (" & q & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & q & c & Me.TerrID1 & c & CurWrkstn & c & q & CurUser & q & c
                SqlValues = SqlValues & q & CurTerr.Dbversion & q & c & q & "TRACK-WARRANT" & q & c & q & Me.AuthorityUID & q & c
                Select Case pEventType
                    Case EventTypeSFA.ADD
                        SqlValues = SqlValues & q & "ISSUED" & q & c & q
                        SqlValues = SqlValues & "|" & Me.AuthorityUID
                        SqlValues = SqlValues & "|" & Me.AuthDate
                        SqlValues = SqlValues & "|" & Me.AuthorityVerbiage
                        SqlValues = SqlValues & "|" & Me.DispName
                        SqlValues = SqlValues & "|" & Me.IssueTo
                        SqlValues = SqlValues & "|" & Me.JointAuthority
                        SqlValues = SqlValues & "|" & Me.Box10ClearBy
                        For Each comp In Me.Components
                            CompList = CompList & "-" & comp.GUID
                        Next
                        SqlValues = SqlValues & "|COMPONENTS" & CompList
                        SqlValues = SqlValues & "|" & Me.JointAuthority
                        SqlValues = SqlValues & "|"
                        If Not Me.VehicleAssociations Is Nothing Then
                            For Each veh In Me.VehicleAssociations
                                SqlValues = SqlValues & veh & ";"
                            Next
                        End If
                        SqlValues = SqlValues & "|"
                        If Not IsNothing(Me.Box12Switches) Then
                            For Each sw In Me.Box12Switches
                                SqlValues = SqlValues & sw & ";"
                            Next
                            If Me.Box12Switches.Count = 0 Then
                                SqlValues = SqlValues & sw & "NO BOX 12 SWITCHES"
                            End If
                        End If
                        SqlValues = SqlValues & "|"
                        If Not IsNothing(Me.Box13Switches) Then
                            sw = String.Empty
                            For Each sw In Me.Box13Switches
                                SqlValues = SqlValues & sw & ";"
                            Next
                            If Me.Box13Switches.Count = 0 Then
                                SqlValues = SqlValues & sw & "NO BOX 13 SWITCHES"
                            End If
                        End If
                        SqlValues = SqlValues & "|" & Me.AuthType1
                        SqlValues = SqlValues & "|" & Me.Direction
                        SqlValues = SqlValues & "|" & Me.IssuedToTrain
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"
                    Case EventLogTypeSFA.REMOVE
                        SqlValues = SqlValues & q & "REMOVE" & q & c & q
                        SqlValues = SqlValues & "|" & Me.AuthorityUID
                        CompList = String.Empty
                        For Each comp In Me.Components
                            CompList = CompList & "-" & comp.GUID
                        Next
                        SqlValues = SqlValues & "|COMPONENTS" & CompList
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"
                    Case EventLogTypeSFA.ROLLUP
                        SqlValues = SqlValues & q & "ROLLUP" & q & c & q
                        SqlValues = SqlValues & "|" & Me.CurrentRollUpEvent
                        CompList = String.Empty
                        For Each comp In Me.Components
                            CompList = CompList & "-" & comp.GUID
                        Next
                        SqlValues = SqlValues & "|COMPONENTS" & CompList
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"
                    Case EventLogTypeSFA.PENDINGROLLUP
                        SqlValues = SqlValues & q & "ROLLUP" & q & c & q
                        SqlValues = SqlValues & "|" & Me.CurrentRollUpEvent
                        CompList = String.Empty
                        For Each comp In Me.Components4
                            CompList = CompList & "-" & comp.GUID
                        Next
                        SqlValues = SqlValues & "|COMPONENTS" & CompList
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"
                    Case EventTypeSFA.UPDATE
                        SqlValues = SqlValues & q & "UPDATE" & q & c & q
                        SqlValues = SqlValues & "|" & Me.AuthorityUID
                        SqlValues = SqlValues & Me.JointAuthority & "|"
                        SqlValues = SqlValues & Me.JointAuthority & "|"
                        SqlValues = SqlValues & Me.OKTime.ToShortTimeString & "|"
                        SqlValues = SqlValues & Me.Box10ClearBy.ToShortTimeString & q
                        SqlValues = SqlValues & ")"
                End Select
                SyncLock TMDS.GlobalDeclarations.gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(LogString & SqlFields & SqlValues)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

