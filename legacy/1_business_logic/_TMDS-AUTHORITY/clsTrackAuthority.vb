        Private Delegate Sub DoSendMovementAuthorityMessage110(ByVal trn As TrainID, ByVal messageUID As String)

        Private Function CreateAuthorityTextTNT(ByVal IncludeOKTime As Boolean) As ArrayList
            Try
                Dim TextList As New ArrayList()
                TextList.Add(Me.IssueTo & ", AUTHORITY NO. " & Me.AuthorityUID)
                Dim Line As String
                Dim Lines() As String = AuthorityLimits.Split("|")
                For Each Line In Lines
                    TextList.Add(Line)
                Next
                If Me.JointAuthority Then
                    If Me.JointLimits <> "" Then
                        TextList.Add("JOINT WITH")
                        Dim Joints() As String = Me.JointLimits.Split("-")
                        Dim Joint As String
                        For Each Joint In Joints
                            TextList.Add(Joint)
                        Next
                    Else
                        TextList.Add("JOINT")
                    End If
                End If

                TextList.Add("UNITL " & Format(Me.UntilTime, "HH:mm"))
                If IncludeOKTime Then
                    Dim sOKTIME As String = Me.AuthorityUID & " IS OK AT " & Format(Me.OKTime, "HH:mm") & " ," & gCurrentUser.Initials
                    TextList.Add(sOKTIME)
                End If

                Return TextList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

