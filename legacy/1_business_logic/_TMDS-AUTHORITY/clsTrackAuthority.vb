        Private Function SetTrackAuthorityInsertCommand(ByVal dbTable As String, Optional ByVal CreateNewAuthority As Boolean = False) As String
            Dim SQLFields As String
            Dim SQLValues As String
            Dim s As String = ","
            Dim q As String = "'"
            Dim sSetTrackAuthorityInsertCommand As String = String.Empty
            Try
                If CreateNewAuthority Then
                    InitMobileClientData()
                End If
                'FIELDS
                SQLFields = "(AuthorityNumber, RailRoadName, DispatcherName, CreateDate, Direction, AuthorityDate"
                SQLFields = SQLFields & ", AuthorityType, IssueTo, AuthorityLimits, OKTime"
                SQLFields = SQLFields & ", UntilTime, MobileID, Components, ReportClear, TerritoryAssignment"
                SQLFields = SQLFields & ", AuthorityUID, VehicleAssocations, JointAuthority, BehindTrains, BeginMilePostLimits, EndMilePostLimits"
                SQLFields = SQLFields & ", JointLimits, TerritoryAssignmentSecondary, AuthGUID, TerrIDTeritary, TerrIDQuadtary"
                SQLFields = SQLFields & ", LastNameEIC, FirstNameEIC, PassWordEIC, EICPIN, EICENABLED, EICDS"
                SQLFields = SQLFields & ", CopiedBy, RelayedTo"
                If optEnableTTRollupEventDisplay Then SQLFields = SQLFields & ", RollUpEvent"

                SQLFields = SQLFields & ", IssuedToTrain, TrainSymbol"
                SQLFields = SQLFields & ", LimitsInfo, BehindTrainsInfo, AuthorityStatus, VoidList, JointVerbiage,UntilTimeInfo, Box1Void"
                SQLFields = SQLFields & ", UntilReleased, NoticeTime"
                SQLFields = SQLFields & ", OverrideFieldBlocking"

                ''RMT ARRC-1910
                SQLFields = SQLFields & ", SwitchList"

                SQLFields = SQLFields & ")"


                'VALUES
                SQLValues = " VALUES ("
                SQLValues = SQLValues & q & AuthorityNumber & q & s & q & SpclToEsc(RailRoadName) & q & s & q & SpclToEsc(DispatcherName) & q & s & q & CreateDate & q
                SQLValues = SQLValues & s & q & Direction & q & s & q & AuthorityDate & q & s & q & AuthorityType & q & s & q & SpclToEsc(IssueTo) & q
                SQLValues = SQLValues & s & q & SpclToEsc(AuthorityLimits) & q & s & q & OKTime & q & s & q & UntilTime & q & s & q & MobileID & q
                SQLValues = SQLValues & s & q
                Dim comp As Object
                Dim LastTrackName As String = String.Empty
                For Each comp In Me.ComponentsInSelection
                    If optDelimitTrackTimeAuthorityComponentsWithZero Then
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim tk As Track = CType(comp, Track)
                            If LastTrackName = "" Then
                                LastTrackName = tk.TrackName
                            Else
                                If LastTrackName <> tk.TrackName Then
                                    SQLValues = SQLValues & "0|"
                                    LastTrackName = tk.TrackName
                                End If
                            End If
                        End If
                        SQLValues = SQLValues & CStr(comp.GUID) & "|"
                    Else
                        SQLValues = SQLValues & CStr(comp.GUID) & "|"
                    End If
                Next
                SQLValues = SQLValues & q
                SQLValues = SQLValues & s & q & Me.ReportClear & q & s & q & Me.TerritoryAssignment & q
                SQLValues = SQLValues & s & q & Me.AuthorityUID & q
                Dim VehicleString As String
                Dim VehicleInsertString As String = String.Empty
                If Not VehicleAssociations Is Nothing Then
                    For Each VehicleString In Me.VehicleAssociations
                        VehicleInsertString = VehicleInsertString & VehicleString & "|"
                    Next
                End If
                SQLValues = SQLValues & s & q & SpclToEsc(VehicleInsertString) & q & s & CInt(JointAuthority)

                Dim TrainString As String
                Dim TrainInsertString As String = String.Empty
                If Not Me.BehindTrains Is Nothing Then
                    For Each TrainString In Me.BehindTrains
                        TrainInsertString = TrainInsertString & TrainString & "|"
                    Next
                End If
                SQLValues = SQLValues & s & q & SpclToEsc(TrainInsertString) & q
                SQLValues = SQLValues & s & q & BeginMilePostLimits & q & s & q & EndMilePostLimits & q & s & q & SpclToEsc(Me.JointLimits) & q
                SQLValues = SQLValues & s & Me.TerritoryAssignmentSecondary & s & q & Me.AuthGUID & q
                SQLValues = SQLValues & s & Me.TerrIDTeritary & s & q & Me.TerrIDQuadtary & q

                SQLValues = SQLValues & s & q & SpclToEsc(Me.MobileClientLastName) & q & s & q & SpclToEsc(Me.MobileClientFirstName) & q
                SQLValues = SQLValues & s & q & "PRIVATE" & q & s & q & Me.MobileClientPIN & q
                SQLValues = SQLValues & s & CInt(Me.MobileClientEnabled) & s & q & Me.MobileClientDSA & q
                SQLValues = SQLValues & s & q & SpclToEsc(Me.CopiedBy) & q
                SQLValues = SQLValues & s & q & SpclToEsc(Me.RelayedTo) & q
                If optEnableTTRollupEventDisplay Then
                    Dim RollupEvents As String = String.Empty
                    Dim rollup As String = String.Empty
                    For Each rollup In Me.RollUpEvents
                        RollupEvents = RollupEvents & rollup & Chr(1)
                    Next
                    SQLValues = SQLValues & s & q & SpclToEsc(RollupEvents) & q
                End If
                Dim ToTrain As Integer
                If IssuedToTrain Then
                    ToTrain = 1
                Else
                    ToTrain = 0
                End If


                SQLValues = SQLValues & s & ToTrain & s & q & Me.TrainSymbol & q
                SQLValues = SQLValues & s & q & SpclToEsc(Me.LimitsInfo) & q & s & q & SpclToEsc(Me.BehindTrainsInfo) & q
                SQLValues = SQLValues & s & q & Me.AuthorityStatus & q & s & q & Me.AuthVoidList & q
                SQLValues = SQLValues & s & q & SpclToEsc(Me.JointVerbiage) & q


                Dim str As String = ""
                Dim Untilstr As String = ""
                If Not Me.UntilTimeInfo Is Nothing Then
                    For Each str In Me.UntilTimeInfo
                        If str.Trim <> "" Then
                            Untilstr = Untilstr & str & "|"
                        End If
                    Next
                End If

                SQLValues = SQLValues & s & q & Untilstr & q
                SQLValues = SQLValues & s & q & Me.Box1List & q

                If Me.UntilReleased Then
                    SQLValues = SQLValues & s & 1
                Else
                    SQLValues = SQLValues & s & 0
                End If
                SQLValues = SQLValues & s & NoticeTime
                Dim intOverrideFieldBlocking As Integer
                If OverrideFieldBlocking Then
                    intOverrideFieldBlocking = 1
                Else
                    intOverrideFieldBlocking = 0
                End If
                SQLValues = SQLValues & s & intOverrideFieldBlocking

                ''RMT ARRC-1910
                Dim SwitchString As String = BuildSwitchListString()
                'Dim SwitchString As New StringBuilder

                'If Me.tmpCompList IsNot Nothing AndAlso Me.tmpCompList.Count > 0 Then
                '    CopyArrayCollection(compToUse, Me.tmpCompList)
                'Else
                '    CopyArrayCollection(compToUse, Me.ComponentsInSelection)
                'End If

                'For Each comp In compToUse
                '    If comp.GetType.ToString = gSwitchComponentName Then
                '        Dim sw As Switch = Nothing
                '        sw = CType(comp, Switch)
                '        If sw IsNot Nothing Then
                '            Dim swstr As String = ""
                '            swstr = sw.GUID & "|" & sw.ControlledReverse.ToString.ToUpper & ";"
                '            Dim swpt As New SwitchPoint
                '            With swpt
                '                .myName = sw.Name
                '                .mySwitch = sw
                '                .ReversePosition = sw.ControlledReverse
                '            End With
                '            If Not Me.SwitchPointList.Contains(swpt) Then Me.SwitchPointList.Add(swpt)
                '            SwitchString.Append(swstr)
                '        End If
                '    End If
                'Next
                SQLValues = SQLValues & s & q & SwitchString.Trim & q


                SQLValues = SQLValues & ")"

                sSetTrackAuthorityInsertCommand = "INSERT INTO " & dbTable & SQLFields & SQLValues
                Return sSetTrackAuthorityInsertCommand
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                Me.tmpCompList = New ArrayList
            End Try
        End Function

        ''' <summary>
        ''' Add track auth to DB
        ''' </summary>
        ''' <param name="pDbConnection"></param>
        ''' <param name="pAuthorityExisting"></param>
        ''' <returns></returns>
        Public Function AddTrackAuthorityToDB(ByVal pDbConnection As OleDbConnection, Optional ByVal pAuthorityExisting As Boolean = False) As Boolean
            Dim dbConn As OleDbConnection = Nothing
            Dim dbComm As OleDbCommand = Nothing
            Dim query As String = ""
            Try
                If pAuthorityExisting Then
                    Me.UpdateDatabaseWithCompList("AddTrackAuthorityToDB")
                    Return True
                End If
                query = SetTrackAuthorityInsertCommand(gtblAuthActive, True)
                dbConn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                dbComm = New OleDbCommand(query, dbConn)
                dbConn.Open()
                Application.DoEvents()
                dbComm.ExecuteNonQuery()
                dbConn.Close()
                Return True
            Catch ex As Exception
                GetErrorDetails(ex, "SQL Query:" & query)
            Finally
                If dbConn IsNot Nothing Then dbConn.Dispose()
                dbConn = Nothing
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                query = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Remove active auth from DB
        ''' </summary>
        ''' <param name="pdbConnection"></param>
        ''' <returns></returns>
        Public Function RemoveActiveAuthorityFromDB(ByVal pdbConnection As OleDbConnection) As Boolean
            Dim dbConn As OleDbConnection = Nothing
            Dim dbInsert As OleDbCommand = Nothing
            Dim dbDelete As OleDbCommand = Nothing
            Dim queryInsert As String
            Dim queryDelete As String
            Dim result As Integer
            Dim doEventPlayback As DoEventLogTrackTime
            Dim doEventViewClient As DoPublishTNTEvent
            Try
                dbConn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                If Not CheckToSeeIfExistsInTheInActiveTable() Then
                    queryInsert = "INSERT INTO tblAuthoritiesInActive SELECT * FROM tblAuthoritiesActive WHERE [AuthGUID]='" & Me.AuthGUID & "'"
                    dbInsert = New OleDbCommand(queryInsert, dbConn)
                    dbConn.Open()
                    dbInsert.ExecuteNonQuery()
                    dbConn.Close()
                End If
                queryDelete = "DELETE FROM " & gtblAuthActive & " WHERE AuthorityNumber = " & Me.AuthorityNumber & " AND TerritoryAssignment = " & Me.TerritoryAssignment
                dbDelete = New OleDbCommand(queryDelete, dbConn)
                If dbDelete.Connection.State = ConnectionState.Connecting Or dbDelete.Connection.State = ConnectionState.Open Then
                    dbDelete.Connection.Close()
                End If
                dbConn.Open()
                result = dbDelete.ExecuteNonQuery()
                dbConn.Close()
                AuthorityEventLog("RemoveActiveAuthorityFromDB:Lines affected=" & result.ToString & ":Territory=" & Me.TerritoryAssignment)
                doEventPlayback = New DoEventLogTrackTime(AddressOf Me.LogTheTrackTimeEvent)
                doEventPlayback.BeginInvoke(EventTypeTNT.REMOVE, Nothing, Nothing)
                doEventViewClient = New DoPublishTNTEvent(AddressOf Me.PublishTNTEventUpdate)
                doEventViewClient.BeginInvoke(EventTypeTNT.REMOVE, Nothing, Nothing)
                UpdatePreviousAuthorityField()
                Me.Flasher.Enabled = False
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If dbConn IsNot Nothing Then dbConn.Dispose()
                dbConn = Nothing
                If dbInsert IsNot Nothing Then dbInsert.Dispose()
                dbInsert = Nothing
                If dbDelete IsNot Nothing Then dbDelete.Dispose()
                dbDelete = Nothing
                queryInsert = Nothing
                queryDelete = Nothing
