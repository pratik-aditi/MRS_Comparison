                        LocoFound = loco
                        Exit For
                    End If
                Next
                If IsNothing(LocoFound) Then
                    For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                        If (loco.Symbol = Me.TrainSymbol) Or loco.LocomotiveID = Mid(Me.IssueTo, 1, 10) Then
                            LocoFound = loco
                            Exit For
                        End If
                    Next
                End If
                If IsNothing(LocoFound) Then
                    Return True
                End If


                'Dim trk As Track
                'Select Case UseEndTrack
                '    Case True
                '        trk = TMDS.SystemUtilities.FetchData.FindTrackCompFromMilePost(LocoFound.EndTrackGUID, LocoFound.EndMilePost, LocoFound.EndMilePostSuffix)
                '        LocoMilePost = LocoFound.EndMilePost
                '    Case Else
                '        trk = TMDS.SystemUtilities.FetchData.FindTrackFromPTCBlockAndMilepost(LocoFound.BlockUID & "|" & LocoFound.MilePost)
                '        LocoMilePost = LocoFound.MilePost
                'End Select
                'If IsNothing(trk) Then
                '    Return True
                'End If

                Dim trk As Track = Nothing
                Dim trk1 As Track = Nothing
                If gPTCCheckHeadNTailEndOnReportClear Then

                    trk = TMDS.SystemUtilities.FetchData.FindTrackCompFromMilePost(LocoFound.EndTrackGUID, LocoFound.EndMilePost, LocoFound.EndMilePostSuffix)
                    LocoMilePost = LocoFound.EndMilePost

                    trk1 = TMDS.SystemUtilities.FetchData.FindTrackCompFromMilePost(LocoFound.TrackGUID, LocoFound.MilePost, LocoFound.MilePostSuffix)

                    If (IsNothing(trk) And IsNothing(trk1)) Then
                        Return True
                    End If


                ElseIf UseEndTrack Then
                    trk = TMDS.SystemUtilities.FetchData.FindTrackCompFromMilePost(LocoFound.EndTrackGUID, LocoFound.EndMilePost, LocoFound.EndMilePostSuffix)
                    LocoMilePost = LocoFound.EndMilePost
                    If IsNothing(trk) Then
                        Return True
                    End If
                Else
                    trk = TMDS.SystemUtilities.FetchData.FindTrackFromPTCBlockAndMilepost(LocoFound.BlockUID & "|" & LocoFound.MilePost)
                    LocoMilePost = LocoFound.MilePost
                    If IsNothing(trk) Then
                        Return True
                    End If
                End If

                If Not IsNothing(ReplacingAuthorityList) Then
                    If ReplacingAuthorityList.Contains(trk) Then
                        Return True
                    End If
                End If

                Dim FormPosition As Point = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + trk.CurrentDrawingForm.Left + 100, 500)

                Dim trackFound As Boolean = False
                If Not IsNothing(trk) AndAlso Me.Components.Contains(trk) Then
                    trackFound = True
                End If
                If Not IsNothing(trk1) AndAlso Me.Components.Contains(trk1) Then
                    trackFound = True
                    LocoMilePost = LocoFound.MilePost
                End If

                If trackFound Then
                    Dim frmMessageBox1 As frmMessageBox
                    Dim MessageList1 As New ArrayList()
                    MessageList1.Add(Me.IssueTo & " IS CURRENTLY REPORTING ITS GPS POSITION AT MP " & LocoMilePost)
                    MessageList1.Add("WHICH IS IN THE TRACK SELECTION TO BE RELEASED.")
                    MessageList1.Add("")
                    MessageList1.Add("HAVE YOU VERBALLY VERIFIED THE TRAIN IS CLEAR OF THESE LIMITS?")

                    frmMessageBox1 = New frmMessageBox()
                    frmMessageBox1.SetMessage(MessageList1, "TRAIN POSITION CHECK", True, FormPosition)
                    frmMessageBox1.ShowDialog()
                    If frmMessageBox1.FormFeedBack <> 6 Then
                        frmMessageBox1.Dispose()
                        frmMessageBox1 = Nothing
                        Return False
                    End If
                End If

                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            End Try
        End Function

