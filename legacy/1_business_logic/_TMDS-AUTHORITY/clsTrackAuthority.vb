                        Else
                            MoveTrain_MOWOnRollup(RollUpList, Me.IssuedToTrain, IssueTo, TrackSelected)
                        End If
                        Me.DoRemoveMixModeAuthorityFromComponents()
                    End If
                    'ARRC-1305 : added update message publishing on roll up for ViewClient to receive a rollup
                    If (optEnableARRCSpecificOptions And optEnableTNTRollUp And optRailRoadName = "ARRC") Then
                        'This part will send a control server message out on TNT rollup 
                        Dim DoAuthorityEvent As New DoPublishTNTEvent(AddressOf Me.PublishTNTEventUpdate)
                        DoAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.TrackAuthority.EventTypeTNT.UPDATE, Nothing, Nothing)

                        If optEnableTTRollupReportClearPDF Then
                            Try
                                Dim docAuthority As New TrackTimeDocument()
                                Dim FileName As String = docAuthority.BuildAuthorityDocument(Me)
                                If optPerformDocumentArchiving Then
                                    Dim EntityUID As String
                                    If Not Me.IssuedToTrain Then
                                        EntityUID = Me.IssueTo
                                    Else
                                        EntityUID = Me.TrainSymbol
                                        If EntityUID = "" Or EntityUID = "NONE" Then
                                            EntityUID = "UNKNOWN SYMBOL-IDUNIT:" & Me.IssueTo
                                        End If
                                    End If
                                    Dim SubUID As Integer
                                    If Not IsNothing(TrackSelected.mySubdivision) Then
                                        SubUID = TrackSelected.mySubdivision.GUID
                                    End If
                                    Dim TerrUID As Integer = TrackSelected.myTerritory.TerritoryID
                                    TMDS.PrintForms.DocumentArchive.ArchiveTheDocument(FileName, "AUTHORITY-CTC-ROLLUP", EntityUID, TerrUID, SubUID)
                                End If
                            Catch ex As Exception

                            End Try

                        End If
                    End If



                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock

                    Dim SummItem1 As New SummaryItem("AUTHORITY", "ADD", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If

                frmMessageBox.Dispose()
                frmMessageBox = Nothing
                ClearSelection()

            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSelection()
                Dim ErrorMessage As String = "TRACK AUTHORITY " & Me.AuthorityUID & " Not Rolled Up Properly! CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
            End Try
        End Function

