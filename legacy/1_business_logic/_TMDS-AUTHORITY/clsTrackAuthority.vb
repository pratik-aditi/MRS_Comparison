        Public Function RemoveDeviceBlockFromComponents(ByVal dbConnection As OleDbConnection, Optional ByVal BlockType As String = "DEVICE BLOCK") As Boolean
            Dim comp As Object
            Dim Message As String
            Try
                Message = vbCrLf & vbTab & BlockType & " " & Me.AuthorityUID.ToString & " REMOVED FROM THESE COMPONENTS:" & vbCrLf

                For Each comp In Me.ComponentsInSelection
                    Select Case comp.GetType.ToString
                        Case gFlipFlopComponentName, gRRXINGComponentName
                            comp.DeviceBlockRemoveFromMe(Me)
                            comp.UpdateStatus()
                            Message = Message & vbTab & comp.GetType.ToString & ":" & comp.Name & ":" & comp.GUID.ToString & vbCrLf
                        Case Else
                            comp.DeviceBlockRemoveFromMe(Me)
                            If comp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                If comp.DeviceBlocks.Count = 0 Then
                                    comp.BlockAbsolute = False
                                    comp.DeviceBlocked = False
                                End If
                            ElseIf comp.GetType.ToString = "TMDS.GraphicComponent.Device" Then
                                If comp.DeviceBlocks.Count = 0 Then
                                    comp.BlockAbsolute = False
                                    comp.DeviceBlocked = False
                                    comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                    comp.Flasher.Interval = 250
                                    comp.FlashOn = False
                                    comp.FlashComponent = False
                                    comp.UpdateStatus()
                                End If

                            ElseIf comp.DeviceBlocks.Count = 0 And comp.Authorities.Count = 0 Then
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    Dim trk As Track = CType(comp, Track)
                                    If Not trk.RemotePendingBlock Then
                                        trk.BlockAbsolute = False
                                        trk.DeviceBlocked = False
                                        trk.RemotePendingBlock = False
                                    Else
                                        trk.BlockAbsolute = False
                                        trk.DeviceBlocked = False
                                    End If
                                Else
                                    comp.BlockAbsolute = False
                                    comp.DeviceBlocked = False
                                End If
                                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Or comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                    comp.Flasher.Interval = 250
                                    comp.FlashOn = False
                                    comp.FlashComponent = False
                                    comp.UpdateStatus()
                                End If

                            End If
                            comp.UpdateStatus()
                            Message = Message & vbTab & comp.GetType.ToString & ":" & comp.Name & ":" & comp.GUID.ToString & vbCrLf
                    End Select

                Next
                BlockEvent(Message)

                ResetCompToCodeBrown(Me.ComponentsInSelection)

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                comp = Nothing
            End Try

        End Function

        Public Function AddDeviceBlockToSystem(ByVal frmDB As frmDeviceBlock, ByVal CompSelection As ArrayList, ByVal GlobalDeviceBlocks As ArrayList, Optional ByVal BlockType As String = "DEVICE BLOCK") As Boolean

            Try
                If optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then
                    Dim comp As Object
                    For Each comp In CompSelection
                        If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            'comp.failstate = False
                            comp.OverRideCodeBrown = True
                        End If
                    Next
                End If

                Dim Message As String
                Select Case BlockType
                    Case "DEVICE BLOCK"
                        AuthorityLimits = "MULTIPLE DEVICE BLOCKS"
                        BlockNotes = frmDB.txtNotes.Text
                        OKTime = Now
                        IssueTo = frmDB.txtBlockName.Text


                    Case "BLUE FLAG"
                        AuthorityLimits = "MULTIPLE BLUE FLAG BLOCKS"
                        BlockNotes = frmDB.txtNoteBF.Text
                        Me.WorkCraft = frmDB.cmbCraft.Text
                        Me.OKTime = CDate(frmDB.txtIssueDate.Text)
                        IssueTo = frmDB.cmbIssueTo.Text
                        Me.TrackName = frmDB.cmbTrack.Text

                End Select
                RailRoadName = frmDB.RailRoadName
                DispatcherName = frmDB.Disp
                AuthorityDate = Now
                AuthorityNumber = CInt(frmDB.AuthorityNumber)
                Direction = frmDB.Direction
                AuthorityType = frmDB.TrackAuthorityType
                UntilTime = CDate(frmDB.dtReleaseDate.Value.ToLongDateString & " " & frmDB.dtReleaseTime.Value.ToLongTimeString)
                'Added enabletimeexpired check to avoid alerts in system summary
                'jcosta - 7/11/17
                EnableTimeExpired = frmDB.cbxEnableAlertTime.Checked
                OverrideFieldBlocking = frmDB.DisableFieldBlocking
                '684.0 P1-EEE - Sets the create data for the device block (RPBJR)
                Me.CreateDate = Date.Now
                'END 684.0 P1-EEE

                Me.AuthorityUID = frmDB.AuthorityUID
                Me.TerritoryAssignment = frmDB.CurrentSelectedTerritory.TerritoryID

                Dim PTCBlockData As String = frmDB.PTCDevBlockData
                If PTCBlockData.Trim <> String.Empty Then
                    Dim PTCData() As String = PTCBlockData.Trim.Split("|")
                    If PTCData.GetUpperBound(0) > 1 Then
                        Select Case PTCData(0).Trim.ToUpper
                            Case "PRS"
                                Me.IsPRS = True
                                Me.PTCIssueTo = PTCData(1)
                                Me.PTCTrainGUID = PTCData(2)
                                If PTCData.GetUpperBound(0) > 2 Then Me.PTCVerbiage = PTCData(3)
                            Case "EMT"
                                Me.IsEMT = True
                                Me.PTCIssueTo = PTCData(1)
                                Me.PTCTrainGUID = PTCData(2)
                                If PTCData.GetUpperBound(0) > 2 Then Me.PTCVerbiage = PTCData(3)

                        End Select
                    End If
                End If
                frmDB.DevBlkGUID = Me.BlockGUID
                Dim TerrList As New ArrayList()

                If CompSelection.Count > 0 Then
                    Dim comp As Object
                    For Each comp In CompSelection
                        ComponentsInSelection.Add(comp)
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            'If comp.IsRemoteTrack Then
                            Dim trk As Track = CType(comp, Track)
                            If Not trk Is Nothing Then
                                If optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then trk.OverRideCodeBrown = True
                            End If

                            If Not TerrList.Contains(trk.TerritoryID) Then
                                TerrList.Add(trk.TerritoryID)
                            End If
                            trk.RemotePendingBlock = False
                            'If TerritoryAssignment <> comp.TerritoryID Then
                            '    If Me.TerritoryAssignmentSecondary = 0 Then
                            '        Me.TerritoryAssignmentSecondary = comp.TerritoryID
                            '    Else
                            '        If Me.TerritoryAssignmentSecondary <> comp.TerritoryID Then
                            '            Return False
                            '        End If
                            '    End If
                            'End If
                        End If
                    Next
                Else
                    Return False
                End If

                Dim TerrID As Int32
                Dim Index As Integer
                For Each TerrID In TerrList
                    Select Case Index
                        Case 0
                            Me.TerritoryAssignment = TerrID
                            Index = 1
                        Case 1
                            Me.TerritoryAssignmentSecondary = TerrID
                            Index = 2
                        Case 2
                            Me.TerrIDTeritary = TerrID
                            Index = 3
                        Case 3
                            Me.TerrIDQuadtary = TerrID
                        Case Else

                    End Select
                Next
                TerrList.Clear()
                TerrList = Nothing
                ''****************************************************************************************
                ''**   ADD AUTHORITY TO TRACKS
                ''*****************************************************************************************
                Message = vbCrLf & vbTab & BlockType & " " & Me.AuthorityUID.ToString & " ADDED TO THESE COMPONENTS:" & vbCrLf
                If CompSelection.Count > 0 Then
                    Dim comp As Object
                    For Each comp In CompSelection
                        comp.DeviceBlocks.Add(Me)
                        comp.BlockAbsolute = True
                        comp.DeviceBlocked = True
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            comp.RemotePendingBlock = False
                        End If
                        comp.UpdateStatus(Me)
                        Message = Message & vbTab & comp.GetType.ToString & ":" & comp.Name & ":" & comp.GUID.ToString & vbCrLf
                    Next
                Else
                    Return False
                End If
                BlockEvent(Message)
                GlobalDeviceBlocks.Add(Me)
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Dim ErrorMessage As String = "Error Adding Track Authorityt To System. CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                ClearSystemVariables()
            End Try
        End Function

        Public Function AddSwitchDeviceBlockToSystem(ByVal CompSelection As ArrayList, ByVal GlobalDeviceBlocks As ArrayList, Optional ByVal BlockType As String = "DEVICE BLOCK") As Boolean

            Try
                Dim Message As String

                Message = vbCrLf & vbTab & BlockType & " " & Me.AuthorityUID.ToString & " ADDED TO THESE COMPONENTS:" & vbCrLf
                If CompSelection.Count > 0 Then
                    Dim comp As Object
                    For Each comp In CompSelection
                        comp.DeviceBlocks.Add(Me)
                        comp.BlockAbsolute = True
                        comp.DeviceBlocked = True
                        comp.UpdateStatus()
                        Message = Message & vbTab & comp.GetType.ToString & ":" & comp.Name & ":" & comp.GUID.ToString & vbCrLf
                    Next
                Else
                    Return False
                End If
                BlockEvent(Message)
                GlobalDeviceBlocks.Add(Me)
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Dim ErrorMessage As String = "Error Adding Track Authorityt To System. CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                ClearSystemVariables()
            End Try
        End Function

        Private Sub BlockEvent(ByVal EventNote As String)

            Try
                Dim BlockEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.SystemEvent, EventNote, SystemEventQueue)
                BlockEvent = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Friend Function RefreshDeviceBlockComponents() As Boolean
            Dim comp As Object
            Try
                'Message = vbCrLf & vbTab & BlockType & " " & Me.AuthorityUID.ToString & " REMOVED FROM THESE COMPONENTS:" & vbCrLf

                For Each comp In Me.ComponentsInSelection
                    comp.UpdateStatus()
                    If comp.InvokeRequired Then
                        comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                    Else
                        comp.Refresh()
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                comp = Nothing
            End Try

        End Function

