                        RollUpEventMessage = RollUpEventMessage & "LIMITS:" & LeftLimits & "|" & RightLimits & vbCrLf & "TRACK-GUIDs:"
                        For Each comp In SelectionCollection
                            RollUpEventMessage = RollUpEventMessage & comp.GUID & "|"
                        Next
                        RollUpEvent.Add(RollUpEventMessage)

                        SysEvent = New SystemEventRecord(Now, SystemEventRecord.EventEnum.DispatcherEvent, "ROLL UP EVENT DATA:" & RollUpEventMessage, SystemEventQueue)

                        'Find a TrainID to move to Roll Up Track
