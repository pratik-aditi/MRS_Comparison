        Public Sub GetBlockIDs()
            Try
                Dim BlockID As Int32
                Dim comp As Object
                Dim LastAuthID As Int32
                Dim blk As SubAuthority = Nothing
                Dim auth As DTCAuthority = Nothing
                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If auth.IssueTo = Me.IssueTo Then
                        For Each comp In auth.ComponentsInSelection
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If comp.PTCBlockID <> BlockID Then
                                    BlockID = comp.PTCBlockID
                                    blk = New SubAuthority()
                                    blk.AuthID = auth.AuthorityNumber
                                    LastAuthID = auth.AuthorityNumber
                                    blk.BlockID = BlockID
                                    blk.SubID = comp.SubdivisionID
                                    blk.StatusID = GetNumericStatus(auth)
                                    blk.StatusOfDTC = Me.StatusOfDTC
                                    BlockIDList.Add(blk)
                                    blk.CompList.Add(comp)
                                ElseIf comp.PTCBlockID = BlockID And comp.PTCBlockID <> 0 Then
                                    blk.CompList.Add(comp)
                                End If
                            End If
                        Next

                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub UpdateBlocksStatuses(ByVal Status As String)
            Try
                Dim blk As SubAuthority
                For Each blk In Me.BlockIDList
                    blk.StatusOfDTC = Status
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub UpdateBlockStatus(ByVal BlockID As Int32, ByVal Status As String)
            Try
                Dim blk As SubAuthority
                For Each blk In Me.BlockIDList
                    If blk.BlockID = BlockID Then
                        blk.StatusOfDTC = Status
                        Exit For
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function GetNumericBlockStatus(ByVal BlockID As Int32, ByVal auth As DTCAuthority) As Integer
            Try
                Dim blk As SubAuthority
                For Each blk In auth.BlockIDList
                    If blk.BlockID = BlockID Then
                        Select Case blk.StatusOfDTC
                            Case "PENDING"
                                Return 0
                            Case "ACCEPTED"
                                Return 5
                            Case "ACTIVATED"
                                Return 6
                            Case "RELEASE"
                                Return 14
                            Case "LOCO-ACTIVATED"
                                Return 8
                            Case "REPLACE"
                                Return 11
                            Case "DELETE"
                                Return 15
                        End Select
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

