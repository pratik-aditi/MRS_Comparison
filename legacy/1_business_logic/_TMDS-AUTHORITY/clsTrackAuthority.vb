                                            AddOSComponentsToList(sw, MixModeRollupList)
                                        End If

                                    End If

                                    Dim SwitchInReverseStateOnIssue As Boolean = sw.ControlledReverse
                                    If SwitchPointList IsNot Nothing AndAlso SwitchPointList.Count > 0 Then
                                        Dim swpt As SwitchPoint = Nothing
                                        For Each swpt In SwitchPointList
                                            If swpt.mySwitch.GUID = sw.GUID Then
                                                SwitchInReverseStateOnIssue = swpt.ReversePosition
