        ''' <summary>
        ''' Send auth to BOS
        ''' </summary>
        ''' <param name="theTrain"></param>
        ''' <param name="trackSegmentsCurrentDesk"></param>
        ''' <param name="authTextListCurrentDesk"></param>
        ''' <param name="performElectronicTransmission"></param>
        Public Sub VETMS_PerformIssuance(theTrain As TrainID,
                                         trackSegmentsCurrentDesk As String,
                                         authTextListCurrentDesk As ArrayList,
                                         Optional performElectronicTransmission As Boolean = True)
            Try
                AuthorityEventLog($"{GetCurrentMethod.Name}:Starting:WhoCallMe:{(New StackTrace).GetFrame(1).GetMethod.Name}:CurrentSegments={trackSegmentsCurrentDesk}")
                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                PTCElectronicDeliveryCompleted = False
                PTCTypeAuthority = True
                'Update license text
                UpdateMovementAuthorityTextForMRS(authTextListCurrentDesk, GetCurrentMethod.Name)
                'Update license segment
                UpdateTrackSegments(trackSegmentsCurrentDesk)
                UpdateDatabaseWithPTCAuthoritySegments(GetCurrentMethod.Name)
                If UpdateDatabaseWithPTCAuthorityStatus("AUTHORITY-SENT") Then
                    Dim SummItem1 As New SummaryItem("AUTHORITY", "AUTHORITY-SENT", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If
                PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ISSUE.ToString
                DoAssignComponentsForPTC(ComponentsInSelection)
                PTCStatus = "AUTHORITY-SENT"
                SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                If Not optDisableFlashingTrackForPTC Then FlasherMode(True, True)
                If performElectronicTransmission Then
                    PTCElectronicTransmissionInProgress = True
                    PTCMarkedToBeRolledUpElectronically = False
                    AuthorityEventLog($"{GetCurrentMethod.Name}:PTCMarkedToBeRolledUpElectronically=False")
                    TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageCreate_CTC(Me,
                                                                                                                theTrain,
                                                                                                                PTCMessageUID,
                                                                                                                False,
                                                                                                                Nothing,
                                                                                                                Nothing,
                                                                                                                False)
                    VETMS_CreateTimerIssuanceEvent()
                    TMDS.NetworkMessages.CadMessages.SendTrainEventForWabtecOne(theTrain, "UPDATED")
                    TMDS.NetworkMessages.CadMessages.SendLicenseEventForWabtecOne(Me, "CREATE")
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' PERFORM REISSUANCE
        ''' </summary>
        ''' <param name="theTrain"></param>
        ''' <param name="replaceAllTextualContent"></param>
        Public Sub VETMS_PerformReIssuance(theTrain As TrainID,
                                           Optional replaceAllTextualContent As Boolean = False)
            Try
                AuthorityEventLog($"{GetCurrentMethod.Name}:Starting:WhoCallMe:{(New StackTrace).GetFrame(1).GetMethod.Name}")
                If MarkedForDelete Then Exit Sub
                PTCElectronicTransmissionInProgress = True
                PTCMarkedToBeRolledUpElectronically = False
                AuthorityEventLog($"{GetCurrentMethod.Name}:PTCMarkedToBeRolledUpElectronically=False")
                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                PTCMarkedToBeRolledUpElectronically = False
                AuthorityEventLog($"{GetCurrentMethod.Name}:PTCMarkedToBeRolledUpElectronically=False")
                PTCElectronicDeliveryCompleted = False
                PTCMarkedToBeIssuedElectronically = True
                PTCTypeAuthority = True
                If UpdateDatabaseWithPTCAuthorityStatus("AUTHORITY-SENT") Then
                    Dim SummItem1 As New SummaryItem("AUTHORITY", "AUTHORITY-SENT", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If
                PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ISSUE.ToString
                If PTCAuthorityComponents.Count = 0 Then
                    DoAssignComponentsForPTC(ComponentsInSelection)
                End If
                Dim newTrackSegmentsFromCAD As String = String.Empty
                newTrackSegmentsFromCAD = PTCAuthoritySegments
                AuthorityEventLog($"{GetCurrentMethod.Name}:Segments={newTrackSegmentsFromCAD}")
                If MarkedForDelete Then
                    FlasherMode(False, True)
                Else
                    PTCStatus = "AUTHORITY-SENT"
                    SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                    FlasherMode(True, True)
                End If
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageCreate_CTC(Me,
                                                                                                            theTrain,
                                                                                                            PTCMessageUID,
                                                                                                            PTCAuthorityBeingModified,
                                                                                                            String.Empty,
                                                                                                            newTrackSegmentsFromCAD,
                                                                                                            replaceAllTextualContent)
                VETMS_CreateTimerIssuanceEvent()
                If PTCAuthorityBeingModified Then
                    TMDS.NetworkMessages.CadMessages.SendLicenseEventForWabtecOne(Me, "MODIFY")
                Else
                    TMDS.NetworkMessages.CadMessages.SendTrainEventForWabtecOne(theTrain, "UPDATED")
                    TMDS.NetworkMessages.CadMessages.SendLicenseEventForWabtecOne(Me, "CREATE")
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub VETMS_CreateTimerIssuanceEvent()
            Try
                If Not IsNothing(myTrain) Then If myTrain.GeoFenceLegacyEnabled Then Exit Sub
                PTCIssuanceTimeExpired = False
                If IsNothing(PTCTimerIssuance) Then
                    PTCTimerIssuance = New Timers.Timer(gPTCTimeOutTransmissionAuthorityIssuance)
                    AddHandler PTCTimerIssuance.Elapsed, AddressOf VETMS_CheckStatusIssuance
                    PTCTimerIssuance.Enabled = True
                Else
                    PTCTimerIssuance.Start()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub VETMS_CheckStatusIssuance(ByVal source As Object, ByVal e As Timers.ElapsedEventArgs)
            Try
                If Not PTCIssuanceSuccessful Then
                    VETMS_GenerateAlertForFailedIssaunce()
                End If
                PTCIssuanceTimeExpired = True
                VETMS_TerminatePTCTimerIssuance()
            Catch ex As Exception
                SystemException(ex.ToString)
                PTCIssuanceTimeExpired = True
            End Try
        End Sub

        Public Sub VETMS_TerminatePTCTimerIssuance()
            Try
                Me.PTCIssuanceSuccessful = False
                If IsNothing(PTCTimerIssuance) Then Exit Sub
                RemoveHandler PTCTimerIssuance.Elapsed, AddressOf VETMS_CheckStatusIssuance
                PTCTimerIssuance.Enabled = False
                PTCTimerIssuance.Dispose()
                PTCTimerIssuance = Nothing
                Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC", Me)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' VETMS Generate Alert For Failed Issaunce
        ''' </summary>
        Private Sub VETMS_GenerateAlertForFailedIssaunce()
            Dim trn As TrainID
            Dim message As String
            Dim al As Alert
            Try
                trn = TrainExistsForAuthority(Me)
                If trn Is Nothing Then
                    AuthorityEventLog("VETMS_GenerateAlertForFailedIssaunce:Train is nothing")
                    Exit Sub
                End If
                If Not trn.IsActivePTC Then
                    AuthorityEventLog("VETMS_GenerateAlertForFailedIssaunce:Train is not active")
                    Exit Sub
                End If
                message = optPTCString021 & " (" & Me.AuthorityUID & ") | " & optPTCString019 & " (" & Me.IssueTo & ") " & optPTCString023
                If Not TMDS.SystemUtilities.Utilities.CheckForAlertExtistence(Me) Then
                    al = TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.VETMS_PTC_CTC_AuthorityIssuanceRequestFailed, message, trn, Nothing, Nothing, Nothing, Nothing, Me)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                trn = Nothing
                message = Nothing
                al = Nothing
            End Try
        End Sub

        Public Sub VETMS_GenerateIssuanceRejection()
            Try
                If Not PTCIssuanceSuccessful Then
                    VETMS_GenerateAlertForRejectedIssaunce()
                End If
                PTCIssuanceTimeExpired = True
                VETMS_TerminatePTCTimerIssuance()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub VETMS_GenerateAlertForRejectedIssaunce()
            Try
                Dim theTrain As TrainID = TrainExistsForAuthority(Me)
                Dim AlertMessage As String = optPTCString021 & " (" & Me.AuthorityUID & ") | " & optPTCString019 & " (" & Me.IssueTo & ") " & optPTCString027
                If Not TMDS.SystemUtilities.Utilities.CheckForAlertExtistence(Me) Then
                    Dim al As Alert = TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.VETMS_PTC_AuthorityIssuanceRequestRejected, AlertMessage, theTrain, Nothing, Nothing, Nothing, Nothing, Me)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Generate Issuance Failure
        ''' </summary>
        Public Sub VETMS_GenerateIssuanceFailure()
            Try
                PTCElectronicTransmissionInProgress = False
                If Not PTCIssuanceSuccessful Then VETMS_GenerateAlertForFailedIssaunce()
                VETMS_TerminatePTCTimerIssuance()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

