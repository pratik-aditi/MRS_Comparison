        Public Sub CreateFEDEvent(ByVal EventType As String, ByVal fd As FED)
            Try
                Dim EngineID As String = Mid(Me.IssueTo, 1, 10)
                Dim TrainSymbol As String = Me.TrainSymbol
                Dim Direction As String = "?"
                Dim FedEventDate As Date
                Select Case Mid(fd.myTrack.TimeZone, 1, 1)
                    Case "M"
                        FedEventDate = Now.AddHours(-1)
                    Case "P"
                        FedEventDate = Now.AddHours(-2)
                    Case Else
                        FedEventDate = Now
                End Select


                Dim EventDate As String = Format(FedEventDate, "yyyyMMddHHmmss") & Mid(fd.myTrack.TimeZone, 1, 1)
                Dim FEDUID As String = CStr(fd.FEDUID)
                Dim MainTrackName As String

                If optEnableTrackSidingBit Then
                    'NEW SIDING LOGIC CODE
                    If fd.myTrack.EnableControlledSiding Or fd.myTrack.EnableNonControlledSiding Then
                        MainTrackName = "99"
                    Else
                        Select Case fd.myTrack.TrackName.ToUpper
                            Case "MAIN", "MAIN TRACK"
                                MainTrackName = "00"
                            Case "MAIN 1", "MAIN ONE"
                                MainTrackName = "01"
                            Case "MAIN 2", "MAIN TWO"
                                MainTrackName = "02"
                            Case "MAIN 3", "MAIN THREE"
                                MainTrackName = "03"
                            Case "MAIN 4", "MAIN FOUR"
                                MainTrackName = "04"
                            Case "MAIN 5", "MAIN FIVE"
                                MainTrackName = "05"
                            Case "MAIN 6", "MAIN SIX"
                                MainTrackName = "06"
                            Case Else
                                MainTrackName = "00"
                        End Select
                    End If
                Else
                    'OLD LEGACY SIDING CODE
                    Select Case fd.myTrack.TrackName.ToUpper
                        Case "SIDING"
                            MainTrackName = "99"
                        Case "MAIN", "MAIN TRACK"
                            MainTrackName = "00"
                        Case "MAIN 1", "MAIN ONE"
                            MainTrackName = "01"
                        Case "MAIN 2", "MAIN TWO"
                            MainTrackName = "02"
                        Case "MAIN 3", "MAIN THREE"
                            MainTrackName = "03"
                        Case "MAIN 4", "MAIN FOUR"
                            MainTrackName = "04"
                        Case "MAIN 5", "MAIN FIVE"
                            MainTrackName = "05"
                        Case "MAIN 6", "MAIN SIX"
                            MainTrackName = "06"
                        Case Else
                            MainTrackName = "00"
                    End Select
                End If



                Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(EngineID)
                If Not IsNothing(trn) Then
                    TrainSymbol = trn.Name
                    Direction = Mid(trn.Direction, 1, 1)
                Else
                    If Me.Direction = "RIGHT" Then
                        Direction = "E"
                    Else
                        Direction = "W"
                    End If
                End If

                Dim FEDEvent As String = TrainSymbol.PadRight(18, " ")
                FEDEvent = FEDEvent & EngineID.PadRight(10, " ")
                FEDEvent = FEDEvent & Direction
                FEDEvent = FEDEvent & gThisWorkstation.WrkStnNumber.PadLeft(3, "0")
                Dim data() As String = Me.AuthorityUID.Split("-")
                Dim Terr As String = Trim(data(0)).PadLeft(3, "0")
                Dim AUID As String = Trim(data(1)).PadLeft(3, "0")
                FEDEvent = FEDEvent & Terr & AUID

                Select Case EventType
                    Case "REMOVE"
                        FEDEvent = FEDEvent & "V"
                    Case "ROLLUP"
                        FEDEvent = FEDEvent & "R"
                    Case "ISSUE"
                        FEDEvent = FEDEvent & "I"
                End Select
                FEDEvent = FEDEvent & EventDate
                FEDEvent = FEDEvent & "001"
                FEDEvent = FEDEvent & FEDUID.PadLeft(6, "0")
                FEDEvent = FEDEvent & MainTrackName
                TMDS.NetworkMessages.CadMessages.SendFEDEvent(FEDEvent, gCadTransmitQueue)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckToMoveTrainIntoNonTWC(Optional ByVal ReleaseTrack As Track = Nothing, Optional ByVal RemoveAuthority As Boolean = False)
            If optDisableTrainMoveOnTWCReportClear Then Exit Sub
            Dim LastTrack As Track = Nothing
            Dim SidingTrack As Track = Nothing
            Dim OSTrack As Track = Nothing
            Dim LastComp As Object
            Dim ForceMoveToMainTrack As Boolean
            Try

                If Not IsNothing(ReleaseTrack) Then
                    LastComp = ReleaseTrack
                Else
                    LastComp = Me.Components.Item(Me.Components.Count - 1)
                End If

                If LastComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(LastComp, Track)
                    If trk.OStype Then
                        Dim OsComp As Object
                        For Each OsComp In trk.OsComponentCollection ' check to see if switch is blocked
                            If OsComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                Dim sw As Switch = CType(OsComp, Switch)
                                If Not sw.ControlledReverse And sw.BlockAbsolute Then
                                    ForceMoveToMainTrack = True
                                End If
                            End If
                        Next
                        For Each OsComp In trk.OsComponentCollection
                            If OsComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If OsComp.TrainIDPlace Then
                                    OSTrack = OsComp
                                    Exit For
                                End If
                            End If
                        Next
                    Else
                        OSTrack = LastComp
                    End If
                    LastTrack = LastComp
                End If

                If Me.CheckBoxItemsStatus(2) Or (Me.CheckBoxItemsStatus(4) And Me.ShowItemFourComponents) Then
                    ForceMoveToMainTrack = False
                Else
                    ForceMoveToMainTrack = True
                End If

                'If LastTrack.OStype Then
                Dim CompToCheck As Object
                If Me.Direction = "RIGHT" Then
                    If Not IsNothing(LastTrack.OsComponentCollection) Then
                        For Each CompToCheck In LastTrack.OsComponentCollection
                            Dim trkToCheck As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CompToCheck.RightLink)
                            If Not IsNothing(trkToCheck) Then
                                If optEnableTrackSidingBit Then
                                    'NEW SIDING LOGIC CODE
                                    Dim IsSidingTrack As Boolean = False
                                    If trkToCheck.EnableNonControlledSiding Or trkToCheck.EnableControlledSiding Then IsSidingTrack = True
                                    If IsSidingTrack Or trkToCheck.AuthorityType = "YL" Or trkToCheck.AuthorityType = "NON-TWC" Then
                                        SidingTrack = trkToCheck
                                        Exit For
                                    End If
                                Else
                                    'OLD LEGACY SIDING CODE
                                    If trkToCheck.TrackName = "SIDING" Or trkToCheck.AuthorityType = "YL" Or trkToCheck.AuthorityType = "NON-TWC" Then
                                        SidingTrack = trkToCheck
                                        Exit For
                                    End If
                                End If

                            End If
                        Next
                    Else
                        Dim trkToCheck As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(LastTrack.RightLink)
                        If trkToCheck IsNot Nothing Then
                            If optEnableTrackSidingBit Then
                                'NEW SIDING LOGIC CODE
                                Dim IsSidingTrack As Boolean = False
                                If trkToCheck.EnableNonControlledSiding Or trkToCheck.EnableControlledSiding Then IsSidingTrack = True
                                If IsSidingTrack Or trkToCheck.AuthorityType = "YL" Or trkToCheck.AuthorityType = "NON-TWC" Then
                                    SidingTrack = trkToCheck
                                End If
                            Else
                                'OLD LEGACY SIDING CODE
                                If trkToCheck.TrackName = "SIDING" Or trkToCheck.AuthorityType = "YL" Or trkToCheck.AuthorityType = "NON-TWC" Then
                                    SidingTrack = trkToCheck
                                End If
                            End If
                        End If

                    End If

                Else
                    If Not IsNothing(LastTrack) Then
                        If Not IsNothing(LastTrack.OsComponentCollection) Then
                            For Each CompToCheck In LastTrack.OsComponentCollection
                                Dim trkToCheck As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CompToCheck.LeftLink)
                                If Not IsNothing(trkToCheck) Then
                                    If optEnableTrackSidingBit Then
                                        'NEW SIDING LOGIC CODE
                                        Dim IsSidingTrack As Boolean = False
                                        If trkToCheck.EnableNonControlledSiding Or trkToCheck.EnableControlledSiding Then IsSidingTrack = True
                                        If IsSidingTrack Or trkToCheck.AuthorityType = "YL" Or trkToCheck.AuthorityType = "NON-TWC" Then
                                            SidingTrack = trkToCheck
                                            Exit For
                                        End If
                                    Else
                                        'OLD LEGACY SIDING CODE
                                        If trkToCheck.TrackName = "SIDING" Or trkToCheck.AuthorityType = "YL" Or trkToCheck.AuthorityType = "NON-TWC" Then
                                            SidingTrack = trkToCheck
                                            Exit For
                                        End If
                                    End If

                                End If
                            Next
                        Else
                            Dim trkToCheck As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(LastTrack.LeftLink)
                            If trkToCheck IsNot Nothing Then
                                If optEnableTrackSidingBit Then
                                    'NEW SIDING LOGIC CODE
                                    Dim IsSidingTrack As Boolean = False
                                    If trkToCheck.EnableNonControlledSiding Or trkToCheck.EnableControlledSiding Then IsSidingTrack = True
                                    If IsSidingTrack Or trkToCheck.AuthorityType = "YL" Or trkToCheck.AuthorityType = "NON-TWC" Then
                                        SidingTrack = trkToCheck
                                    End If
                                Else
                                    'OLD LEGACY SIDING CODE
                                    If trkToCheck.TrackName = "SIDING" Or trkToCheck.AuthorityType = "YL" Or trkToCheck.AuthorityType = "NON-TWC" Then
                                        SidingTrack = trkToCheck
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If

                Dim trn As TrainID = GetTrainFromUnitID(IssueTo)
                If Not IsNothing(SidingTrack) And Not IsNothing(OSTrack) And Not ForceMoveToMainTrack Then
                    If Not IsNothing(trn) Then
                        OSTrack.MoveTrainIDPlace(trn, trn.myTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                        'OSTrack.LogOsMessage(Nothing, True, trn)
                        If optEnableSendOSMessageFXE Then
                            TMDS.NetworkMessages.CadMessages.SendTrainOSMessageFXE(trn, gCadTransmitQueue, OSTrack, True)
                        ElseIf optEnableSendOSMessageARRC Then
                            TMDS.NetworkMessages.CadMessages.SendTrainOSMessageARRC(trn, gMISTransmitQueue, OSTrack, False)
                        ElseIf optEnableSendOSMessageMRL Then
                            TMDS.NetworkMessages.CadMessages.SendTrainOSMessageMRL(trn, gCadTransmitQueue, OSTrack)
                        ElseIf optEnableSendOSMessageCN Then
                            TMDS.NetworkMessages.CadMessages.SendTrainOSMessageCN(trn, gCadTransmitQueue, OSTrack, False)
                        Else
                            TMDS.NetworkMessages.CadMessages.SendTrainOSMessage(trn, gCadTransmitQueue, OSTrack, Nothing, Nothing, "A")
                        End If
                        trn.OSPreviousControlPoint = OSTrack.myControlPoint
                        trn.OSPreviousTrack = OSTrack
                        OSTrack.LogTheOSEvent(Nothing, True, trn)
                        SidingTrack.MoveTrainIDPlace(trn, trn.myTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                    End If
                ElseIf ForceMoveToMainTrack Then
                    If Not IsNothing(trn) Then
                        Dim isOKToMove As Boolean = True
                        If optEnableARRCSpecificOptions Or optEnableMRLSpecificOptions Or optEnableCNSpecificOptions Then
                            If trn.myTrack.Indicating OrElse Mid(trn.myTrack.AuthorityType.Trim.ToUpper, 1, 3) <> "TWC" Then isOKToMove = False
                        End If


                        If isOKToMove Then
                            OSTrack.MoveTrainIDPlace(trn, trn.myTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                            OSTrack.LogOsMessage(Nothing, True, trn)
                            If RemoveAuthority Then
                                If optEnableSendOSMessageFXE Then
                                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessageFXE(trn, gCadTransmitQueue, OSTrack, True)
                                ElseIf optEnableSendOSMessageARRC Then
                                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessageARRC(trn, gMISTransmitQueue, OSTrack, False)
                                End If
                            End If
                            If Not IsNothing(SidingTrack) Then
                                If SidingTrack.AuthorityType = "YL" Then
                                    SidingTrack.MoveTrainIDPlace(trn, OSTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                End If
                            ElseIf optMoveTraintoNextAuthorityUponAuthorityRelease Then
                                Dim trk As Track = GetTrackWithExistingAuthority(trn)
                                If Not IsNothing(trk) Then
                                    trk.MoveTrainIDPlace(trn, trn.myTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                End If

                            End If
                        End If
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function RemoveAuthorityFromComponents(Optional ByVal VoidAuthority As Boolean = False) As Boolean
            Dim comp As Object
            Try
                Dim TrackZonesToCheck As ArrayList = Nothing
                If gTrackIntegrityMonitoringExists Then
                    TrackZonesToCheck = New ArrayList
                End If

                If optPostionAndOSTrainOnAuthorityReleaseWithSFAItemThreeIntoSiding And Not VoidAuthority Then
                    If (Me.CheckBoxItemsStatus(2) And Me.IssuedToTrain) Or (Me.CheckBoxItemsStatus(4) And Me.ShowItemFourComponents) Then
                        CheckToMoveTrainIntoNonTWC(Nothing, True)
                    ElseIf Me.IssuedToTrain Then
                        CheckToMoveTrainIntoNonTWC(Nothing, True)
                    End If
                End If
                If optLogOsOnTWCAuthorityRelease Then
                    If (Me.CheckBoxItemsStatus(1) And Me.IssuedToTrain) Then
                        Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(Me.Components)
                        If Not IsNothing(LastTrack) Then
                            Dim trn As TrainID = GetTrainFromUnitID(Me.IssueTo)
                            If Not IsNothing(trn) Then
                                LastTrack.LogTheOSEvent(Nothing, True, trn)
                            End If
                        End If
                    End If
                End If
                Dim TrainBeingReportedClear As TrainID = GetTrainFromUnitID(IssueTo)

                For Each comp In Me.Components
                    If optReportTrackWarrantEventByFED And Me.IssuedToTrain Then
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If Not IsNothing(trk.FEDList) Then
                                Dim fd As FED
                                For Each fd In trk.FEDList
                                    CreateFEDEvent("REMOVE", fd)
                                Next
                            End If
                        End If
                    End If
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(comp, Track)
                        If trk.TrackZoneIntegrityMonitoringEnabled Then
                            If trk.TrackZoneIntegrityMonitoringEnabled Then
                                Dim tz As TrackZone = trk.TrackZoneReference
                                If Not IsNothing(tz) Then
                                    If Not TrackZonesToCheck.Contains(tz) Then
                                        TrackZonesToCheck.Add(tz)
                                    End If
                                End If
                            End If
                        End If
                        If optUseSingleFormAuthorityVersionII OrElse optUseSingleFormAuthorityVersionCN OrElse optUseSingleFormAuthorityVersionMRL OrElse optUseSingleFormAuthorityVersionARRC OrElse optUseSingleFormAuthorityVersionNCTD Then
                            comp.OverRideLimitsForTrain = False
                        End If
                    End If

                    If optForceGTMEventsForTWCRollupAndReportClear And optLogGrossTonMiles Then
                        If Not IsNothing(TrainBeingReportedClear) Then
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim trk As Track = CType(comp, Track)
                                If trk.OStype Then
                                    If trk.TrainIDPlace Then
                                        trk.LogTheGTMEventManually(Track.EventTypeTrack.OSGTM, Nothing, TrainBeingReportedClear)
                                    End If
                                Else
                                    trk.LogTheGTMEventManually(Track.EventTypeTrack.OSGTM, Nothing, TrainBeingReportedClear)
                                End If
                            End If
                        End If
                    End If

                    comp.TrackAuthorities.Remove(Me)
                    'comp.UpdateStatus()
                    'comp.InitAuthorityNumbers()
                    If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        Dim sw As TMDS.SwitchComponents.Switch = CType(comp, TMDS.SwitchComponents.Switch)
                        If sw.RCPS Then
                            sw.CheckToRemoveRCPSControls()
                        ElseIf sw.SwitchPointerMonitorMode Then
                            sw.CheckToRemoveAlertFromAuthorityRelease()
                        End If
                    End If
                Next
                For Each comp In Me.Components
                    comp.UpdateStatus()
                    comp.InitAuthorityNumbers()
                Next


                TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(Me)
                If gTrackIntegrityMonitoringExists Then
                    Dim tz As TrackZone
                    For Each tz In TrackZonesToCheck
                        tz.CheckToRemoveAlertFromAuthorityRelease(Me, True)
                        tz.UpdateZoneOverrideList(Me.AuthorityUID, Nothing, True, Nothing)
                    Next
                End If
                If gSwitchPointMonitoringExists Then
                    Dim BehindTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(Me.Components)
                    Dim FrontTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(Me.Components)
                    PerformCheckOnAdjacentSwitches(BehindTrack, FrontTrack, Me.Direction)
                End If

                AuthorityEventLog("TRACK AUTHORITY REMOVED FROM TRACK COMPONENTS")

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try

        End Function

        ''' <summary>
        ''' Authority event log
        ''' </summary>
        ''' <param name="message">message to write in log</param>
        Public Sub AuthorityEventLog(message As String)
            Try
                SystemEvent($"{NameOf(SFAuthority)} {TrainSymbol}:{IssueTo}:{AuthorityUID}:{message}")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub PerformCheckOnAdjacentSwitches(ByVal BehindTrack As Track, ByVal FrontTrack As Track, ByVal SearchDirection As String)
            Try

                If SearchDirection = "RIGHT" Then
                    BehindTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(BehindTrack.LeftLink)
                    FrontTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FrontTrack.RightLink)
                    If Not IsNothing(BehindTrack) Then
                        If Not IsNothing(BehindTrack.OsComponentCollection) And BehindTrack.OStype Then
                            Dim comp As Object
                            For Each comp In BehindTrack.OsComponentCollection
                                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(comp, Switch)
                                    sw.CheckForExistingAuthorities()
                                End If
                            Next
                        End If
                    End If
                    If Not IsNothing(FrontTrack) Then
                        If Not IsNothing(FrontTrack.OsComponentCollection) And FrontTrack.OStype Then
                            Dim comp As Object
                            For Each comp In FrontTrack.OsComponentCollection
                                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(comp, Switch)
                                    sw.CheckForExistingAuthorities()
                                End If
                            Next
                        End If
                    End If
                Else
                    BehindTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(BehindTrack.RightLink)
                    FrontTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FrontTrack.LeftLink)
                    If Not IsNothing(BehindTrack) Then
                        If Not IsNothing(BehindTrack.OsComponentCollection) And BehindTrack.OStype Then
                            Dim comp As Object
                            For Each comp In BehindTrack.OsComponentCollection
                                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(comp, Switch)
                                    sw.CheckForExistingAuthorities()
                                End If
                            Next
                        End If
                    End If
                    If Not IsNothing(FrontTrack) Then
                        If Not IsNothing(FrontTrack.OsComponentCollection) And FrontTrack.OStype Then
                            Dim comp As Object
                            For Each comp In FrontTrack.OsComponentCollection
                                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(comp, Switch)
                                    sw.CheckForExistingAuthorities()
                                End If
                            Next
                        End If
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

