        Private Delegate Sub DoEventLogTrackTime(ByVal EventType As EventTypeTNT)

        Public Sub LogTheTrackTimeEvent(ByVal EventType As EventTypeTNT)
            Try
                Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.LastName & "," & TMDS.GlobalDeclarations.gCurrentUser.FirstName
                Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                Dim CurTerr As Territory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(Me.TerritoryAssignment)
                'Dim LogString As String = "INSERT INTO tblFunctionEvents "
                Dim LogString As String = "INSERT INTO tblSystemEvents "
                'Dim SqlFields As String = "(EventTime, Territory, Wrkstn, SysUser, DbVer, FuncType, UID, Event, SysData)"
                Dim SqlFields As String = "([EventTime], [Territory], [Wrkstn], [SysUser], [DbVer], [FuncType], [UID], [Event], [SysData])"
                Dim SqlValues As String
                Dim c As String = ", "
                Dim q As String = "'"

                If CurTerr Is Nothing Then
                    SystemEvent("LogTheTrackTimeEvent:CurTerr is nothing")
                    Exit Sub
                End If

                SqlValues = " VALUES (" & q & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & q & c & Me.TerritoryAssignment & c & CurWrkstn & c & q & CurUser & q & c
                SqlValues = SqlValues & q & CurTerr.Dbversion & q & c & q & "TRACK-TIME" & q & c & q & Me.AuthorityUID & q & c

                Select Case EventType
                    Case EventTypeTNT.ADD
                        SqlValues = SqlValues & q & "ISSUED" & q & c & q
                        SqlValues = SqlValues & "|" & Me.AuthorityUID
                        SqlValues = SqlValues & "|" & Me.AuthorityDate
                        SqlValues = SqlValues & "|" & Me.AuthorityLimits
                        SqlValues = SqlValues & "|" & Me.DispatcherName
                        SqlValues = SqlValues & "|" & Me.IssueTo
                        SqlValues = SqlValues & "|" & Me.JointAuthority
                        SqlValues = SqlValues & "|" & Me.UntilTime
                        Dim comp As Object
                        Dim CompList As String = String.Empty
                        For Each comp In Me.ComponentsInSelection
                            CompList = CompList & "-" & comp.GUID
                        Next
                        SqlValues = SqlValues & "|COMPONENTS" & CompList

                        SqlValues = SqlValues & "|" & Me.SoleAuthority

                        SqlValues = SqlValues & "|"
                        If Not Me.BehindTrains Is Nothing Then
                            Dim trn As String
                            For Each trn In Me.BehindTrains
                                SqlValues = SqlValues & trn & ";"
                            Next
                        End If

                        SqlValues = SqlValues & "|"
                        If Not Me.VehicleAssociations Is Nothing Then
                            Dim veh As String
                            For Each veh In Me.VehicleAssociations
                                SqlValues = SqlValues & veh & ";"
                            Next
                        End If

                        If Me.IssuedToMobileClient Then
                            SqlValues = SqlValues & "|ISSUED TO A MOBILE CLIENT"
                        End If

                        SqlValues = SqlValues & "|" & Me.PTCStatus
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"


                    Case EventTypeTNT.REMOVE
                        SqlValues = SqlValues & q & "REMOVE" & q & c & q
                        SqlValues = SqlValues & "|" & Me.AuthorityUID
                        If Me.ReportedClearByMobileClient Then
                            SqlValues = SqlValues & "|REPORTED CLEAR BY A MOBILE CLIENT"
                        End If
                        Dim comp As Object
                        Dim CompList As String = String.Empty
                        For Each comp In Me.ComponentsInSelection
                            CompList = CompList & "-" & comp.GUID
                        Next
                        SqlValues = SqlValues & "|COMPONENTS" & CompList
                        SqlValues = SqlValues & "|" & Me.PTCStatus
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"

                    Case EventTypeTNT.UPDATE
                        SqlValues = SqlValues & q & "UPDATE" & q & c & q
                        SqlValues = SqlValues & "|" & Me.AuthorityUID & "|"
                        SqlValues = SqlValues & Me.SoleAuthority & "|"
                        SqlValues = SqlValues & Me.JointAuthority & "|"
                        SqlValues = SqlValues & Me.OKTime.ToShortTimeString & "|"
                        SqlValues = SqlValues & Me.UntilTime.ToShortTimeString
                        Dim comp As Object
                        Dim CompList As String = String.Empty
                        For Each comp In Me.ComponentsInSelection
                            CompList = CompList & "-" & comp.GUID
                        Next
                        SqlValues = SqlValues & "|COMPONENTS" & CompList
                        SqlValues = SqlValues & "|" & Me.PTCStatus & q
                        SqlValues = SqlValues & ")"
                End Select
                SyncLock TMDS.GlobalDeclarations.gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(LogString & SqlFields & SqlValues)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

