        Private Delegate Sub DoPublishSFAEvent(ByVal EventType As EventTypeSFA)

        ''' <summary>
        ''' Publish SFA event update
        ''' </summary>
        ''' <param name="pEventType"></param>
        Public Sub PublishSFAEventUpdate(ByVal pEventType As EventTypeSFA)
            Dim MessageNew As String = "DC" & Chr(6) & "SFA;"
            Dim terr As Territory
            Dim UseSecondaryterritory As Boolean
            Dim TerritoryFound As Boolean
            Dim MessBody As String = String.Empty
            Dim UpdateEvent As Boolean
            Dim AddEvent, DeleteEvent As Boolean
            Dim SecureEvent As Boolean
            Dim comp As Object
            Dim CompList As String = String.Empty
            Dim veh As String = String.Empty
            Dim vehicles As String = String.Empty
            Dim CheckBoxes As String = String.Empty
            Dim bx As Boolean
            Dim count As Integer
            Try
                'If this is a remote block need to check to see what territory to send
                For Each terr In TMDS.GlobalDeclarations.ControlledTerritories
                    If terr.TerritoryID = Me.TerrID1 Then
                        TerritoryFound = True
                        Exit For
                    End If
                Next
                If Not TerritoryFound Then
                    For Each terr In TMDS.GlobalDeclarations.ControlledTerritories
                        If terr.TerritoryID = Me.TerrID2 Then
                            TerritoryFound = True
                            Exit For
                        End If
                    Next
                    If Not TerritoryFound Then
                        MessageNew = MessageNew & "|" & Me.TerrID1.ToString
                    Else
                        MessageNew = MessageNew & "|" & Me.TerrID2.ToString
                        UseSecondaryterritory = True
                    End If
                Else
                    MessageNew = MessageNew & "|" & Me.TerrID1.ToString
                End If
                Select Case pEventType
                    Case EventTypeSFA.ADD
                        MessageNew = MessageNew & "|" & "ADD"
                        AddEvent = True
                    Case EventTypeSFA.REMOVE
                        MessageNew = MessageNew & "|" & "DELETE"
                        DeleteEvent = True
                    Case EventTypeSFA.UPDATE
                        MessageNew = MessageNew & "|" & "UPDATE"
                        UpdateEvent = True
                    Case EventTypeSFA.SECURE
                        MessageNew = MessageNew & "|" & "SECURE"
                        SecureEvent = True
                    Case EventTypeSFA.ROLLUP
                        MessageNew = MessageNew & "|" & "ROLLUP"
                        UpdateEvent = True
                    Case EventTypeSFA.PENDINGROLLUP
                        MessageNew = MessageNew & "|" & "PENDINGROLLUP"
                        UpdateEvent = True
                End Select
                If UpdateEvent Then
                    MessBody = MessBody & "|" & Me.AuthorityUID
                    MessBody = MessBody & "|" & Me.OKTime
                    MessBody = MessBody & "|" & Me.Box10ClearBy
                    If Not IsNothing(Me.VehicleAssociations) Then
                        For Each veh In Me.VehicleAssociations
                            vehicles = vehicles & "-" & veh
                        Next
                    End If
                    MessBody = MessBody & "|VEHICLES" & vehicles
                    MessBody = MessBody & "|" & Me.JointAuthority
                    If pEventType = EventTypeSFA.PENDINGROLLUP Then
                        For Each comp In Me.Components4
                            CompList = CompList & "-" & comp.GUID
                        Next
                        MessBody = MessBody & "|COMPONENTS" & CompList
                    Else
                        For Each comp In Me.Components
                            CompList = CompList & "-" & comp.GUID
                        Next
                        MessBody = MessBody & "|COMPONENTS" & CompList
                    End If
                    If Me.AuthorityVerbiage IsNot Nothing AndAlso AuthorityVerbiage.Trim <> "" Then
                        MessBody = MessBody & "|" & Me.AuthorityVerbiage.Length.ToString
                    Else
                        MessBody = MessBody & "|0"
                    End If
                    MessBody = MessBody & "|" & Me.AuthGUID
                    MessageNew = MessageNew & MessBody
                ElseIf SecureEvent Then
                    MessBody = MessBody & "|" & Me.AuthorityUID
                    MessBody = MessBody & "|" & Me.AuthGUID
                    MessBody = MessBody & "|" & Me.MobileClientDSA
                    MessBody = MessBody & "|" & Me.MobileClientLastName
                    MessBody = MessBody & "|" & Me.MobileClientFirstName
                    MessageNew = MessageNew & MessBody
                    UpdateEvent = True
                Else
                    MessBody = MessBody & "|" & Me.AuthorityUID
                    MessBody = MessBody & "|" & Me.AuthDate
                    If Me.AuthorityVerbiage Is Nothing Then
                        MessBody = MessBody & "|"
                    Else
                        MessBody = MessBody & "|" & Me.AuthorityVerbiage.Replace("|", ":")
                    End If
                    MessBody = MessBody & "|" & Me.DispName
                    MessBody = MessBody & "|" & Me.IssueTo
                    MessBody = MessBody & "|" & Me.JointAuthority
                    MessBody = MessBody & "|" & Me.Box10ClearBy
                    For Each comp In Me.Components
                        CompList = CompList & "-" & comp.GUID
                    Next
                    MessBody = MessBody & "|COMPONENTS" & CompList
                    If AddEvent Or DeleteEvent Then
                        MessageNew = MessageNew & "|" & Me.AuthorityUID
                        If DeleteEvent Then
                            MessageNew = MessageNew & "|" & Me.ReportClearTime
                        End If
                        MessageNew = MessageNew & "|" & Me.AuthDate
                        MessageNew = MessageNew & "|" & Me.DispName
                        MessageNew = MessageNew & "|" & Me.IssueTo
                        MessageNew = MessageNew & "|" & Me.JointAuthority
                        MessageNew = MessageNew & "|" & Me.Box10ClearBy
                        MessageNew = MessageNew & "|COMPONENTS" & CompList
                        MessageNew = MessageNew & "|" & Me.AuthType1
                        MessageNew = MessageNew & "|" & Me.Direction
                        For Each bx In Me.CheckBoxItemsStatus
                            If count = 0 Then
                                If bx Then
                                    CheckBoxes = "1"
                                Else
                                    CheckBoxes = "0"
                                End If
                                count = 1
                            Else
                                If bx Then
                                    CheckBoxes = CheckBoxes & "-1"
                                Else
                                    CheckBoxes = CheckBoxes & "-0"
                                End If
                            End If
                        Next
                        MessageNew = MessageNew & "|" & ReducedLimitsVerbiage 'auth verbiage
                        MessageNew = MessageNew & "|" & Me.AtLocation
                        MessageNew = MessageNew & "|" & CheckBoxes
                        MessageNew = MessageNew & "|" & Me.NumOfBoxesChecked.ToString
                        MessageNew = MessageNew & "|" & Me.OKTime 'OKTIME
                        MessageNew = MessageNew & "|" & Me.CopiedBy 'COPYBY
                        If Me.AuthorityVerbiage Is Nothing Then
                            MessageNew = MessageNew & "|"
                        Else
                            MessageNew = MessageNew & "|" & Me.AuthorityVerbiage.Replace("|", Chr(8))
                        End If
                        MessageNew = MessageNew & "|" & Now.ToString ' ReportClearTime
                    ElseIf UpdateEvent Then
                    End If
                End If
                If AddEvent Or DeleteEvent Or UpdateEvent Then
                    If Not UseSecondaryterritory Then
                        MessageNew = Me.TerrID1.ToString & Chr(12) & MessageNew
                    Else
                        MessageNew = Me.TerrID2.ToString & Chr(12) & MessageNew
                    End If
                    MessageNew = MessageNew & Chr(10) & gWorkStationName.ToString.Trim.ToUpper
                    SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                        TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(MessageNew)
                    End SyncLock
                End If
            Catch EX As Exception
                SystemException(EX.ToString)
            Finally

            End Try
        End Sub

        Public Sub PublishSFAIssueForPlanning(ByVal TerrUID As Int32)
            Try
                Dim data As New System.Text.StringBuilder
                Dim terr As Territory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(TerrUID)
                data.Append("DC" & Chr(6) & "MPAR;TW-ISSUE;")
                data.Append("|" & TerrUID.ToString & "|")
                data.Append("W")

                If Me.IssuedToTrain Then
                    data.Append("T")
                Else
                    data.Append("M")
                End If

                Dim Auth() As String = Me.AuthorityUID.Split("-")
                If Auth.Length = 2 Then
                    data.Append(Trim(Auth(0)).PadLeft(3, "0") & Trim(Auth(1)).PadLeft(3, "0"))
                Else
                    data.Append("000000")
                End If

                data.Append("000000") 'HLCS NUM
                data.Append(Format(Me.OKTime.ToUniversalTime, "yyyyMMddHHmmss"))
                data.Append(Me.IssueTo.PadRight(30, " "))
                data.Append(Mid(terr.Subdivision, 1, 6).PadRight(6, " "))
                If Not Me.IssuedToTrain Then
                    data.Append("N")
                    data.Append(Space(18))
                Else
                    data.Append("Y")
                    data.Append(Me.TrainSymbol.PadRight(18, " "))
                End If
                data.Append(Me.Box1Void.Count.ToString)
                Dim v As String
                For Each v In Me.Box1Void
                    Dim a() As String = Me.AuthorityUID.Split("-")
                    If a.Length = 2 Then
                        data.Append(a(0).PadLeft(3, "0") & a(1).PadLeft(3, "0"))
                    Else
                        data.Append("000000")
                    End If
                Next
                Dim LineCount As Integer
                If Me.Box2From1 <> "" Then LineCount += 1 : If Me.Box2From2 <> "" Then LineCount += 1 : If Me.Box2From3 <> "" Then LineCount += 1
                data.Append(LineCount.ToString)
                Dim i As Integer
                For i = 1 To LineCount
                    If i = 1 Then
                        data.Append(Me.Box2From1.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box2To1.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box2Track1.PadRight(20, " "))
                    ElseIf i = 2 Then
                        data.Append(Me.Box2From2.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box2To2.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box2Track2.PadRight(20, " "))
                    ElseIf i = 3 Then
                        data.Append(Me.Box2From3.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box2To3.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box2Track3.PadRight(20, " "))
                    End If
                Next
                If Me.CheckBoxItemsStatus(2) Then
                    data.Append("Y")
                Else
                    data.Append("N")
                End If
                LineCount = 0
                If Me.Box4From1 <> "" Then LineCount += 1 : If Me.Box4From2 <> "" Then LineCount += 1 : If Me.Box4From3 <> "" Then LineCount += 1
                data.Append(LineCount.ToString)

                For i = 1 To LineCount
                    If i = 1 Then
                        data.Append(Me.Box4From1.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box4To1.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box4Track1.PadRight(20, " "))
                    ElseIf i = 2 Then
                        data.Append(Me.Box4From2.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box4To2.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box4Track2.PadRight(20, " "))
                    ElseIf i = 3 Then
                        data.Append(Me.Box4From3.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box4To3.PadRight(35, " "))
                        data.Append("N")
                        data.Append(Me.Box4Track3.PadRight(20, " "))
                    End If
                Next
                data.Append(Me.Box5Arrival.Count.ToString)
                Dim u As String
                For Each u In Me.Box5Arrival
                    data.Append(Mid(u, 1, 10).PadRight(10, " "))
                    Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(Mid(u, 1, 10))
                    If IsNothing(trn) Then
                        data.Append(trn.Name.PadRight(18, " "))
                    Else
                        data.Append(Space(18))
                    End If
                    data.Append(Me.Box5At.PadRight(35, " "))
                Next
                data.Append(Me.Box6Train.Count.ToString)
                For Each u In Me.Box6Train
                    data.Append(Mid(u, 1, 10).PadRight(10, " "))
                    Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(Mid(u, 1, 10))
                    If IsNothing(trn) Then
                        data.Append(trn.Name.PadRight(18, " "))
                    Else
                        data.Append(Space(18))
                    End If
                Next
                If Me.Box8From1 <> "" Then
                    data.Append("1")
                    data.Append(Me.Box8From1.PadRight(35, " "))
                    data.Append(Me.Box8To1.PadRight(35, " "))
                Else
                    data.Append("0")
                End If
                data.Append(Me.Box9List.Count.ToString)

                'BNSF  1111 BETWEEN MP 465 AND MP 463|
                For Each u In Me.Box9List
                    Dim Pos1 As Integer = InStr(u, "BETWEEN")
                    Dim Name1 As String = Mid(u, 1, Pos1 - 1)
                    Dim Name2 As String = Mid(u, Pos1 + 7)
                    Dim Pos2 As String = InStr(Name2, "AND")
                    Dim FromLoc As String = Mid(u, 1, Pos2 - 1)
                    Dim ToLoc As String = Mid(u, Pos2 + 3)
                    data.Append(Trim(Name1).PadRight(35, " "))
                    data.Append(Trim(FromLoc).PadRight(35, " "))
                    data.Append(Trim(ToLoc).PadRight(35, " "))

                Next

                If CheckBoxItemsStatus(9) Then
                    data.Append("Y")
                    data.Append(Format(Me.Box10ClearBy.ToUniversalTime, "yyyyMMddHHmmss"))
                Else
                    data.Append("N")
                End If
                data.Append("N")

                data.Append(Me.Box12Switches.Count.ToString)
                For Each u In Me.Box12Switches
                    data.Append(Mid(u, 1, 35).PadRight(35, " "))
                    Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromName(u)
                    If IsNothing(sw) Then
                        data.Append(sw.GUID.ToString.PadLeft(6, "0"))
                    Else
                        data.Append("000000")
                    End If
                Next
                data.Append(Me.Box13Switches.Count.ToString)
                For Each u In Me.Box13Switches
                    data.Append(Mid(u, 1, 35).PadRight(35, " "))
                    Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromName(u)
                    If IsNothing(sw) Then
                        data.Append(sw.GUID.ToString.PadLeft(6, "0"))
                    Else
                        data.Append("000000")
                    End If
                Next
                If Me.Box14Instructions <> "" Then
                    data.Append("1")
                    data.Append(Mid(Me.Box14Instructions, 1, 100).PadRight(100, " "))
                Else
                    data.Append("0")
                End If
                data.Append(Me.NumOfBoxesChecked.ToString.PadLeft(2, "0"))
                For Each u In Me.BoxItems.Split(",")
                    If Trim(u) <> "" Then
                        data.Append(u.PadLeft(2, "0"))
                    End If
                Next
                data.Append(Me.NumOfBoxesChecked.ToString.PadLeft(2, "0"))
                data.Append(Format(Me.OKTime.ToUniversalTime, "yyyyMMddHHmmss"))
                data.Append(gCurrentUser.Initials.PadRight(4, " "))
                data.Append(gThisWorkstation.WrkStnNumber.PadLeft(3, "0"))
                data.Append(Me.RelayedTo.PadRight(35, " "))
                data.Append(Me.CopiedBy.PadRight(35, " "))
                data.Append(Me.AtLocation.PadRight(35, " "))
                data.Append(Format(Me.AuthDate.ToUniversalTime, "yyyyMMddHHmmss"))
                data.Append(Components.Count.ToString.PadLeft(3, "0"))
                Dim comp As Object
                For Each comp In Components
                    data.Append(comp.GUID.ToString.PadLeft(6, "0"))
                Next
                data.Append("$$$")

                Dim Message As New System.Text.StringBuilder
                Message.Append(TerrUID.ToString & Chr(12) & data.ToString)
                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message.ToString)
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub PublishSFARollUpForPlanning(ByVal RollUpList As ArrayList, ByVal FromTrack As String, ByVal ToTrack As String, ByVal TrackName As String)
            Try
                Dim data As New System.Text.StringBuilder
                Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(RollUpList)

                Dim terr As Territory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(FirstTrack.TerritoryID)
                Dim TerrUID As Int32 = terr.TerritoryID
                data.Append("DC" & Chr(6) & "MPAR;TW-ROLLUP;")
                data.Append("|" & TerrUID.ToString & "|")
                data.Append("W")

                If Me.IssuedToTrain Then
                    data.Append("T")
                Else
                    data.Append("M")
                End If

                Dim Auth() As String = Me.AuthorityUID.Split("-")
                If Auth.Length = 2 Then
                    data.Append(Trim(Auth(0)).PadLeft(3, "0") & Trim(Auth(1)).PadLeft(3, "0"))
                Else
                    data.Append("000000")
                End If
                data.Append("000000") 'HLCS NUM
                data.Append(FromTrack.PadRight(35, " "))
                data.Append(ToTrack.PadRight(35, " "))
                data.Append(TrackName.PadRight(35, " "))
                data.Append(Format(Now.ToUniversalTime, "yyyyMMddHHmmss"))
                data.Append(Me.IssueTo.PadRight(30, " "))
                data.Append(Mid(terr.Subdivision, 1, 6).PadRight(6, " "))
                If Not Me.IssuedToTrain Then
                    data.Append("N")
                    data.Append(Space(18))
                Else
                    data.Append("Y")
                    data.Append(Me.TrainSymbol.PadRight(18, " "))
                End If

                Dim comp As Object
                data.Append(RollUpList.Count.ToString.PadLeft(3, "0"))
                Dim LeftOverCount As Integer = Me.Components.Count - RollUpList.Count
                data.Append(LeftOverCount.ToString.PadLeft(3, "0"))
                For Each comp In RollUpList
                    data.Append(comp.GUID.ToString.PadLeft(6, "0"))
                Next
                For Each comp In Components
                    If Not RollUpList.Contains(comp) Then
                        data.Append(comp.GUID.ToString.PadLeft(6, "0"))
                    End If
                Next

                Dim Message As New System.Text.StringBuilder
                Message.Append(TerrUID.ToString & Chr(12) & data.ToString)
                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message.ToString)
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

