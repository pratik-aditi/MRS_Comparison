        Private Sub SortTracksFromLeftToRight(ByRef CompList As ArrayList)
            Try
                Dim TempList As ArrayList = CompList.Clone
                Dim NewList As New ArrayList
                Dim LoopControl As Integer
                While TempList.Count > 0
                    Dim NextComp As Object = TempList.Item(0)
                    If NewList.Count = 0 Then
                        NewList.Add(NextComp)
                        TempList.Remove(NextComp)
                        Dim LComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        Dim RComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        If Not IsNothing(LComp) Then
                            If TempList.Contains(LComp) Then
                                NewList.Insert(0, LComp)
                                TempList.Remove(LComp)
                            End If
                        End If
                        If Not IsNothing(RComp) Then
                            If TempList.Contains(RComp) Then
                                NewList.Add(RComp)
                                TempList.Remove(RComp)
                            End If
                        End If
                    Else
                        Dim LComp As Object = NewList.Item(0)
                        Dim RComp As Object = NewList.Item(NewList.Count - 1)
                        If Not IsNothing(LComp) Then
                            Dim LefterComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(LComp.LeftLink)
                            If Not IsNothing(LefterComp) Then
                                If TempList.Contains(LefterComp) Then
                                    NewList.Insert(NewList.IndexOf(LComp), LefterComp)
                                    TempList.Remove(LefterComp)
                                End If
                            End If
                        End If
                        If Not IsNothing(RComp) Then
                            Dim RighterComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(RComp.RightLink)
                            If Not IsNothing(RighterComp) Then
                                If TempList.Contains(RighterComp) Then
                                    NewList.Insert(NewList.IndexOf(RighterComp) + 1, RighterComp)
                                    TempList.Remove(RighterComp)
                                End If
                            End If
                        End If
                    End If
                    LoopControl += 1
                    If LoopControl > 50 Then
                        Exit While
                    End If
                End While

                If NewList.Count = CompList.Count Then
                    CompList = NewList.Clone
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function GetTrackSegmentListEMT_PSS(Optional ByVal complist As ArrayList = Nothing) As String
            Dim SearchDirection As String = ""
            Dim EMTTrack As Track = Nothing
            Dim EMT_PSSCOmponents As New ArrayList
            Dim Flipme As Boolean
            Dim IsEMT As Boolean
            Dim count As Integer = 0
            Dim PreviousSubUID As Integer

            Try
                Dim CurrentTrackName As String = String.Empty
                Dim CurrentPrefix As String = String.Empty
                Dim CurrentSuffix As String = String.Empty

                Dim comp As Object
                Dim TrackSegments As New ArrayList
                Dim CurrentTrackList As ArrayList = Nothing
                Dim IsBidirectional As Boolean
                Dim IsPSSAuthType As Boolean


                If Not IsNothing(complist) Then
                    CopyArrayCollection(EMT_PSSCOmponents, complist)
                Else
                    ' CopyArrayCollection(EMT_PSSCOmponents, Me.ComponentsInSelection)
                    If Me.PTCComponentsInSelection IsNot Nothing AndAlso Me.PTCComponentsInSelection.Count > 0 AndAlso IsNothing(gSignalRouteList) AndAlso gSignalRouteList.Count = 0 Then
                        CopyArrayCollection(EMT_PSSCOmponents, Me.PTCComponentsInSelection)
                        ' CopyArrayCollection(EMT_PSSCOmponents, Me.ComponentsInSelection)
                    Else
                        CopyArrayCollection(EMT_PSSCOmponents, Me.ComponentsInSelection)
                    End If
                End If



                Select Case Me.SubType
                    Case "EMT", "ENTER-MAIN-TRACK"
                        IsBidirectional = True
                        SearchDirection = "BOTH"
                        EMTTrack = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(EMT_PSSCOmponents)
                        If optEnableCPSpecificPTCOperations Then SortTracksFromLeftToRight(EMT_PSSCOmponents)
                        If optEnableMetroLinkSpecificOptions Then SortTracksFromLeftToRight(EMT_PSSCOmponents)
                        If EMTTrack IsNot Nothing AndAlso EMTTrack.mySubdivision IsNot Nothing Then
                            SearchDirection = GetSearchableTrainDirectionBasedOnSubdivision(Me.Direction, EMTTrack.mySubdivision)
                            If optEnableARRCSpecificOptions Or optEnableMetroLinkSpecificOptions Then
                                SearchDirection = Me.Direction
                            End If
                            If SearchDirection = "RIGHT" AndAlso optEnableMetroLinkSpecificOptions Then
                                EMT_PSSCOmponents.Reverse()
                            End If

                        Else
                            SearchDirection = "RIGHT"
                        End If
                        'EMT_PSSCOmponents.Clear()
                        ' EMT_PSSCOmponents.Add(EMTTrack)
                        'TrackSegments.Clear()
                        TrackSegments.Add(EMT_PSSCOmponents)
                        '  EMT_PSSCOmponents.Clear()
                        IsEMT = True
                    Case "PSS", "PASS-RED-SIGNAL"
                        IsBidirectional = False
                        SearchDirection = Direction
                        IsPSSAuthType = True
                        'If SearchDirection = "RIGHT" AndAlso optEnableMRSSpecificPTCOperations Then
                        '    EMT_PSSCOmponents.Reverse()
                        'End If
                End Select

                ' If IsEMT Then
                If IsPSSAuthType Then

                    For Each comp In EMT_PSSCOmponents
                        If comp.GetType.ToString = gSwitchComponentName Then
                            Dim sw As Switch = CType(comp, Switch)
                            If Not IsNothing(sw) Then
                                If Not IsNothing(sw.NormalTrackTrailingPortion) Then
                                    Dim NormalTrack As Track = sw.NormalTrackTrailingPortion
                                    If IsNothing(CurrentTrackList) Then CurrentTrackList = New ArrayList
                                    If Not CurrentTrackList.Contains(NormalTrack) AndAlso Not NormalTrack.TurnOutType Then
                                        If NormalTrack.TrackNameAlias = CurrentTrackName AndAlso NormalTrack.MilePostPrefix = CurrentPrefix AndAlso NormalTrack.MilePostSuffix = CurrentSuffix Then
                                            CurrentTrackList.Add(NormalTrack)
                                        Else
                                            CurrentTrackName = NormalTrack.TrackNameAlias
                                            CurrentPrefix = NormalTrack.MilePostPrefix
                                            CurrentSuffix = NormalTrack.MilePostSuffix

                                            CurrentTrackList = New ArrayList
                                            TrackSegments.Add(CurrentTrackList)
                                            CurrentTrackList.Add(sw.NormalTrackTrailingPortion)

                                            ' Dim nextComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.NormalTrackTrailingPortion.LeftLink)

                                        End If
                                    End If
                                End If
                            End If

                        ElseIf comp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(comp, Track)
                            Dim guid As String = trk.GUID.ToString

                            If PreviousSubUID = 0 Then
                                PreviousSubUID = trk.SubdivisionID
                            End If
                            trk.FlipMe = Flipme


                            If Not trk.TurnOutType Then
                                If CurrentTrackName = "" Then
                                    CurrentTrackName = trk.TrackNameAlias
                                    CurrentPrefix = trk.MilePostPrefix
                                    CurrentSuffix = trk.MilePostSuffix
                                    Dim trackList As New ArrayList
                                    CurrentTrackList = trackList
                                    If Not CurrentTrackList.Contains(trk) Then TrackSegments.Add(CurrentTrackList)
                                End If
                                If trk.TrackNameAlias = CurrentTrackName AndAlso trk.MilePostPrefix = CurrentPrefix AndAlso trk.MilePostSuffix = CurrentSuffix AndAlso PreviousSubUID = trk.SubdivisionID Then
                                    If Not CurrentTrackList.Contains(trk) Then CurrentTrackList.Add(trk)
                                Else
                                    CurrentTrackName = trk.TrackNameAlias
                                    CurrentPrefix = trk.MilePostPrefix
                                    CurrentSuffix = trk.MilePostSuffix

                                    Dim trackList As New ArrayList
                                    CurrentTrackList = trackList
                                    TrackSegments.Add(CurrentTrackList)
                                    CurrentTrackList.Add(comp)
                                End If

                                PreviousSubUID = trk.SubdivisionID

                                If Not IsNothing(trk.OsComponentCollection) Then
                                    Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSListThatConnectsToThisTrack(trk)
                                    If Not IsNothing(sw) Then
                                        If Not IsNothing(sw.NormalTrackTrailingPortion) Then
                                            Dim NormalTrack As Track = sw.NormalTrackTrailingPortion
                                            If IsNothing(CurrentTrackList) Then CurrentTrackList = New ArrayList
                                            If Not CurrentTrackList.Contains(NormalTrack) AndAlso Not NormalTrack.TurnOutType Then
                                                If NormalTrack.TrackNameAlias = CurrentTrackName AndAlso NormalTrack.MilePostPrefix = CurrentPrefix AndAlso NormalTrack.MilePostSuffix = CurrentSuffix Then
                                                    CurrentTrackList.Add(NormalTrack)
                                                Else
                                                    CurrentTrackName = NormalTrack.TrackNameAlias
                                                    CurrentPrefix = NormalTrack.MilePostPrefix
                                                    CurrentSuffix = NormalTrack.MilePostSuffix
                                                    CurrentTrackList = New ArrayList
                                                    TrackSegments.Add(CurrentTrackList)
                                                    CurrentTrackList.Add(sw.NormalTrackTrailingPortion)
                                                End If
                                            End If
                                        End If
                                    End If
                                End If

                            Else
                                If trk.TrackNameAlias = CurrentTrackName Then
                                    If Not CurrentTrackList.Contains(trk) AndAlso Not trk.TurnOutType Then
                                        CurrentTrackList.Add(trk)
                                    End If

                                    If Not IsNothing(trk.OsComponentCollection) Then
                                        Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSListThatConnectsToThisTrack(trk)
                                        If Not IsNothing(sw) Then
                                            If Not IsNothing(sw.NormalTrackTrailingPortion) Then
                                                Dim NormalTrack As Track = sw.NormalTrackTrailingPortion
                                                If IsNothing(CurrentTrackList) Then CurrentTrackList = New ArrayList
                                                If Not CurrentTrackList.Contains(NormalTrack) AndAlso Not NormalTrack.TurnOutType Then
                                                    If NormalTrack.TrackNameAlias = CurrentTrackName AndAlso NormalTrack.MilePostPrefix = CurrentPrefix AndAlso NormalTrack.MilePostSuffix = CurrentSuffix Then
                                                        CurrentTrackList.Add(NormalTrack)
                                                    Else
                                                        CurrentTrackName = NormalTrack.TrackNameAlias
                                                        CurrentPrefix = NormalTrack.MilePostPrefix
                                                        CurrentSuffix = NormalTrack.MilePostSuffix

                                                        CurrentTrackList = New ArrayList
                                                        TrackSegments.Add(CurrentTrackList)
                                                        CurrentTrackList.Add(sw.NormalTrackTrailingPortion)
                                                    End If
                                                End If
                                            End If
                                        End If
                                    End If
                                Else

                                End If

                            End If
                        ElseIf comp.GetType.ToString = gFlipFlopComponentName Then
                            Flipme = True
                        End If
                    Next

                End If

                '   End If

                'UID;BEGIN_LIMIT;BEGIN_MILEPOST;END_LIMIT;END_MILEPOST;PREFIX;SUFFIX;TRACK NAME(SUBUID|NEXT SEGMENT|NEXT SEGMENT|...ETC
                Dim BeginPrefix As String = String.Empty
                Dim BeginMilePost As String = String.Empty
                Dim BeginSuffix As String = String.Empty
                Dim EndPrefix As String = String.Empty
                Dim EndMilePost As String = String.Empty
                Dim EndSuffix As String = String.Empty
                Dim theTrackName As String = String.Empty

                Dim Segment As New StringBuilder
                Dim FlipDirection As Boolean
                Dim theList As ArrayList
                Dim LastComp As Object = Nothing
                For Each theList In TrackSegments

                    Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(theList)
                    Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(theList)

                    If FlipDirection Then
                        If SearchDirection = "LEFT" Then
                            SearchDirection = "RIGHT"
                        Else
                            SearchDirection = "LEFT"
                        End If
                    End If
                    Segment.Append(Format(Now, "mmssfffff"))
                    Segment.Append(";")
                    If theList.Count = 1 Then
                        If SearchDirection = "RIGHT" Then
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitMilePost)
                            Segment.Append(";")
                        Else
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitMilePost)
                            Segment.Append(";")
                        End If
                        Segment.Append(FirstTrack.MilePostPrefix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.MilePostSuffix)
                        Segment.Append(";")
                        If String.IsNullOrEmpty(FirstTrack.TrackName) Then
                            Segment.Append(FirstTrack.TrackName)
                        Else
                            Select Case FirstTrack.TrackNameAlias.Trim.ToUpper
                                Case "", "NOTHING", "NONE"
                                    Segment.Append(FirstTrack.TrackName)
                                Case Else
                                    Segment.Append(FirstTrack.TrackNameAlias)
                            End Select
                        End If
                        Segment.Append(";")
                        Segment.Append(FirstTrack.SubdivisionID)
                        Segment.Append(";")
                        Segment.Append(IsBidirectional.ToString.ToUpper)


                    Else
                        If SearchDirection = "RIGHT" Then
                            Select Case Me.SubType
                                Case "EMT", "ENTER-MAIN-TRACK"
                                    Segment.Append(FirstTrack.RightLimitName)
                                    Segment.Append(";")
                                    Segment.Append(FirstTrack.RightLimitMilePost)
                                    Segment.Append(";")
                                    Segment.Append(LastTrack.LeftLimitName)
                                    Segment.Append(";")
                                    Segment.Append(LastTrack.LeftLimitMilePost)
                                    Segment.Append(";")
                                Case Else
                                    Segment.Append(FirstTrack.LeftLimitName)
                                    Segment.Append(";")
                                    If FirstTrack.FlipMe = True Then
                                    Else
                                        Segment.Append(FirstTrack.LeftLimitMilePost)
                                    End If
                                    'Segment.Append(FirstTrack.LeftLimitMilePost)
                                    Segment.Append(";")
                                    Segment.Append(LastTrack.RightLimitName)
                                    Segment.Append(";")
                                    If LastTrack.FlipMe Then
                                        Segment.Append(LastTrack.LeftLimitMilePost)
                                    Else
                                        Segment.Append(LastTrack.RightLimitMilePost)
                                    End If
                                    'Segment.Append(LastTrack.RightLimitMilePost)
                                    Segment.Append(";")
                            End Select



                        Else


                            If Not optEnableMetroLinkSpecificOptions AndAlso Not optEnableMRSSpecificPTCOperations Then
                                Segment.Append(FirstTrack.RightLimitName)
                                Segment.Append(";")
                                ' Segment.Append(FirstTrack.RightLimitMilePost)
                                Segment.Append(FirstTrack.RightLimitMilePost)
                                Segment.Append(";")
                                Segment.Append(LastTrack.LeftLimitName)
                                Segment.Append(";")
                                Segment.Append(LastTrack.LeftLimitMilePost)
                                Segment.Append(";")
                            End If



                            Select Case Me.SubType
                                Case "EMT", "ENTER-MAIN-TRACK"
                                    Segment.Append(FirstTrack.LeftLimitName)
                                    Segment.Append(";")
                                    Segment.Append(FirstTrack.LeftLimitMilePost)
                                    Segment.Append(";")
                                    Segment.Append(LastTrack.RightLimitName)
                                    Segment.Append(";")
                                    Segment.Append(LastTrack.RightLimitMilePost)
                                    Segment.Append(";")
                                Case Else
                                    Segment.Append(FirstTrack.RightLimitName)
                                    Segment.Append(";")
                                    Segment.Append(FirstTrack.RightLimitMilePost)
                                    Segment.Append(";")
                                    Segment.Append(LastTrack.LeftLimitName)
                                    Segment.Append(";")
                                    Segment.Append(LastTrack.LeftLimitMilePost)
                                    Segment.Append(";")
                            End Select


                        End If
                        Segment.Append(FirstTrack.MilePostPrefix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.MilePostSuffix)
                        Segment.Append(";")
                        If String.IsNullOrEmpty(FirstTrack.TrackName) Then
                            Segment.Append(FirstTrack.TrackName)
                        Else
                            Select Case FirstTrack.TrackNameAlias.Trim.ToUpper
                                Case "", "NOTHING", "NONE"
                                    Segment.Append(FirstTrack.TrackName)
                                Case Else
                                    Segment.Append(FirstTrack.TrackNameAlias)
                            End Select
                        End If
                        Segment.Append(";")
                        Segment.Append(FirstTrack.SubdivisionID)
                        Segment.Append(";")
                        Segment.Append(IsBidirectional.ToString.ToUpper)

                    End If
                    Segment.Append("|")

                    If DoesListContainTrackConnectedToFlipFlop(theList) Then
                        FlipDirection = True
                    End If

                Next
                Return Segment.ToString

            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty
            End Try
        End Function

        Private Function DoesListContainTrackConnectedToFlipFlop(theList As ArrayList) As Boolean
            Try
                Dim comp As Object
                For Each comp In theList
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim t As Track = CType(comp, Track)
                        If t.IsLinkToFlipFlopToRight OrElse t.IsLinkToFlipFlopToLeft Then
                            Return True
                        End If
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Function TrainExistsForAuthority(ByVal auth As OtherSpecialAuthorityType, Optional ByVal UseDirection As Boolean = True) As TrainID
            Dim trn As TrainID
            Try
                If Not optEnableCPSpecificOptions Then
                    For Each trn In TrainCollection
                        If trn.IdentifingUnit = Trim(Mid(auth.IssueTo, 1, 10)) Then
                            Return trn
                        End If
                    Next
                Else
                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(auth.TrainSymbol)
                    If trn IsNot Nothing Then Return trn
                End If

                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

