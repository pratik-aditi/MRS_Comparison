#Region "FLASHER "

        Public Overridable Sub FlasherMode(ByVal EnableFlasher As Boolean, Optional ByVal PTCAuthorityMode As Boolean = False)
            Dim comp As Object = Nothing
            Try
                If optDisableFlashingTrackForPTC AndAlso PTCAuthorityMode Then Exit Sub
                If MarkedForDelete AndAlso EnableFlasher Then
                    Me.FlashComponent = False
                    Me.FlashOn = False
                    Me.Flasher.Enabled = False
                    AuthorityEventLog("FlasherMode:AUTHORITY MARKED FOR DELETE:Flasher=" & EnableFlasher.ToString & ":PTC=" & PTCAuthorityMode.ToString)
                    Exit Sub
                End If
                Me.FlashComponent = EnableFlasher
                Me.FlashOn = EnableFlasher
                Me.Flasher.Enabled = True 'EnableFlasher
                Me.Flasher.Interval = 200
                If PTCAuthorityMode Then
                    Select Case EnableFlasher
                        Case True
                            For Each comp In Me.PTCAuthorityComponents
                                If Not comp.TrackAuthorities.Contains(Me) Then
                                    Select Case comp.GetType.ToString
                                        Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                            comp.PTCAuthorityPending = True
                                    End Select
                                    If Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ROLLUP.ToString Then
                                        comp.UpdateStatus()
                                    End If
                                End If
                            Next
                        Case Else
                            For Each comp In Me.PTCAuthorityComponents
                                Select Case comp.GetType.ToString
                                    Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                        comp.PTCAuthorityPending = False
                                End Select
                                If Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ROLLUP.ToString Then
                                    comp.UpdateStatus()
                                End If
                            Next
                    End Select
                End If
                If Not EnableFlasher Then
                    StopFlash = True
                    Me.Flasher.Enabled = False
                    Threading.Thread.Sleep(200)
                    If optEnableCPSpecificOptions Then
                        If PTCAuthorityMode Then ClearPTCAuthoritySelectionFlash()
                    Else
                        ClearPTCAuthoritySelectionFlash()
                    End If
                    For Each comp In Me.ComponentsInSelection
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.Flasher.Interval = 250
                                comp.FlashOn = False
                                comp.FlashComponent = False
                                If comp.GetType.ToString = gTrackComponentName Then
                                    If optEnableMRSSpecificOptions AndAlso Me.LicenseTypeAuthority AndAlso String.IsNullOrEmpty(comp.TrafficDirection) Then
                                        If comp.SignalStatOnMe <> Track.SignalStatus.SignalAtStop Then comp.TrafficDirection = Me.Direction
                                    End If
                                End If
                                comp.UpdateStatus()
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If

                            Case Else
                                If comp.GraphicalPath IsNot Nothing Then
                                    SyncLock comp.Graphical
                                        comp.Graphical.FillPath(comp.CurrentColorStatus, comp.GraphicalPath)
                                    End SyncLock
                                End If
                        End Select
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
            End Try
        End Sub

        ''' <summary>
        ''' Set PTC Authority Flasher Status
        ''' </summary>
        ''' <param name="pCallingMethod"></param>
        Public Sub SetPTCAuthorityFlasherStatus(ByVal pCallingMethod As String)
            Try
                AuthorityEventLog("SetPTCAuthorityFlasherStatus:CallingMehtod=" & pCallingMethod & ":PTCStatus=" & Me.PTCStatus)
                Select Case Me.PTCStatus
                    Case "RELEASE-SENT", "RELEASE-FAILED", "MODIFY-FAILED"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCReleasePending
                        Me.PTCStatusFlashColor = ColorStatusPTCReleasePending
                    Case "RELEASE-PENDING"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCReleaseImminent
                        Me.PTCStatusFlashColor = ColorStatusPTCReleaseImminent
                    Case "RELEASE-SUCCESSFUL", "RELEASE-REJECTED"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.Regular
                        Me.PTCStatusFlashColor = Nothing
                    Case "AUTHORITY-SENT", "OKTIME-SENT", "AUTHORITY-FAILED", "MODIFY-SENT"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCIssuancePending
                        Me.PTCStatusFlashColor = ColorStatusPTCIssuancePending
                    Case "AUTHORITY-DELIVERED"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.PTCIssuanceImminent
                        Me.PTCStatusFlashColor = ColorStatusPTCIssuanceImminent
                    Case "AUTHORITY-ACTIVATED"
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.Regular
                        Me.PTCStatusFlashColor = Nothing
                    Case Else
                        PTCSTatusSelectionMode = GenericComponent.ModeSelection.Regular
                        Me.PTCStatusFlashColor = Nothing
                End Select
                If optDisableFlashingTrackForPTC Then
                    For Each comp As Object In PTCAuthorityComponents
                        Select Case comp.GetType.ToString
                            Case gTrackComponentName, gSwitchComponentName
                                AuthorityEventLog("SetPTCAuthorityFlasherStatus:Comp=" & comp.GUID.ToString & ":" & comp.Name & ":" & comp.FlipMe.ToString & ":" & comp.TrafficDirection)
                                comp.SelectionMode = PTCSTatusSelectionMode
                                comp.UpdateStatus(Me)
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If
                        End Select
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub FlashAuthority(ByVal sender As System.Object, ByVal e As System.EventArgs) 'Handles tmrAuthSelection.Tick

            Dim FlashColor As SolidBrush
            Dim comp As Object
            Try
                If StopFlash Then
                    StopFlash = False
                    For Each comp In Me.ComponentsInSelection
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                comp.Flasher.Interval = 250
                                comp.FlashOn = False
                                comp.FlashComponent = False
                                comp.UpdateStatus()
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If
                            Case Else
                                SyncLock comp.Graphical
                                    comp.Graphical.FillPath(comp.CurrentColorStatus, comp.GraphicalPath)
                                End SyncLock
                        End Select
                    Next
                    Exit Sub
                End If
                If SelectionFlash Then
                    SelectionFlash = False
                    FlashColor = New SolidBrush(Color.Black)
                Else
                    SelectionFlash = True
                    FlashColor = PTCStatusFlashColor
                End If

                If Me Is Nothing Then Exit Sub
                If Me.PTCAuthorityACKPending.Trim <> "" Then
                    For Each comp In Me.PTCAuthorityComponents
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.FlashComponent = True
                                comp.SelectionMode = PTCSTatusSelectionMode
                                comp.FlashOn = SelectionFlash
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If
                            Case Else
                                SyncLock comp.Graphical
                                    comp.Graphical.FillPath(FlashColor, comp.GraphicalPath)
                                End SyncLock
                        End Select
                    Next

                ElseIf (optEnablePTCBOSVETMSMode And Me.PTCTypeAuthority) Then
                    For Each comp In Me.PTCAuthorityComponents
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.FlashComponent = True
                                comp.SelectionMode = PTCSTatusSelectionMode
                                comp.FlashOn = SelectionFlash
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If
                            Case Else
                                SyncLock comp.Graphical
                                    comp.Graphical.FillPath(FlashColor, comp.GraphicalPath)
                                End SyncLock
                        End Select
                    Next

                Else
                    For Each comp In Me.PTCAuthorityComponents
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.FlashComponent = True
                                comp.SelectionMode = SwitchComponents.Switch.ModeSelection.SummarySelectionBlocking
                                comp.FlashOn = SelectionFlash
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If
                            Case Else
                                SyncLock comp.Graphical
                                    comp.Graphical.FillPath(FlashColor, comp.GraphicalPath)
                                End SyncLock
                        End Select
                    Next
                End If

                Flasher.Enabled = True
                FlashColor = Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                comp = Nothing
            End Try

        End Sub

        Public Sub ClearPTCAuthoritySelectionFlash()
            Dim comp As Object
            Dim message As String = ""
            Try
                Flasher.Enabled = False
                If Me Is Nothing Then
                    Exit Sub
                End If
                AuthorityEventLog("ClearPTCAuthoritySelectionFlash")
                If Me.PTCAuthorityACKPending.Trim <> "" And Not optEnablePTCBOSVETMSMode Then
                    For Each comp In Me.PTCAuthorityComponents
                        Select Case comp.GetType.ToString
                            Case gSwitchComponentName, gTrackComponentName
                                comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                comp.Flasher.Interval = 250
                                comp.FlashOn = False
                                comp.FlashComponent = False
                                comp.PTCAuthorityPending = False
                                comp.UpdateStatus()
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If
                            Case Else
                                SyncLock comp.Graphical
                                    comp.Graphical.FillPath(comp.CurrentColorStatus, comp.GraphicalPath)
                                End SyncLock
                        End Select
                    Next

                    Select Case PTCAuthorityACKPending
                        Case PTCAuthorityACKPendingStatus.VOID.ToString
                            Me.PTCAuthorityACKPending = ""
                            Me.PTCAuthorityComponents = New ArrayList
                            Me.UpdateDatabaseWithPTCComponents()
                            If Me.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                If Me.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                    TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(Me)
                                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", Me)
                                    SyncLock gSummaryAuthQueue.SyncRoot
                                        gSummaryAuthQueue.Enqueue(SummItem)
                                    End SyncLock
                                    message = "AUTHORITY REMOVED FROM BOX ONE SELECTION - " & Me.AuthorityUID
                                    TMDS.SystemUtilities.Utilities.SystemEvent(message)
                                    Me.RemoveBlockingToRemoteLinkTrack(Me.ComponentsInSelection)

                                End If
                            End If
                        Case PTCAuthorityACKPendingStatus.RELEASE.ToString
                            Me.PTCAuthorityACKPending = ""
                            Me.PTCAuthorityComponents = New ArrayList
                            Me.UpdateDatabaseWithPTCComponents()
                            If Me.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                If Me.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                    TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(Me)
                                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", Me)
                                    SyncLock gSummaryAuthQueue.SyncRoot
                                        gSummaryAuthQueue.Enqueue(SummItem)
                                    End SyncLock
                                    message = "AUTHORITY REMOVED FROM REPORT CLEAR - " & Me.AuthorityUID
                                    TMDS.SystemUtilities.Utilities.SystemEvent(message)
                                End If
                                Me.RemoveBlockingToRemoteLinkTrack(Me.ComponentsInSelection)
                            End If
                        Case PTCAuthorityACKPendingStatus.ROLLUP.ToString
                            Me.PTCAuthorityACKPending = ""
                            Me.PTCAuthorityComponents = New ArrayList
                            Me.UpdateDatabaseWithPTCComponents()
                    End Select
                    Me.PTCAuthorityACKPending = ""
                    Me.PTCAuthorityComponents = New ArrayList
                Else
                    For Each comp In Me.ComponentsInSelection
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                comp.Flasher.Interval = 250
                                comp.FlashOn = False
                                comp.FlashComponent = False
                                comp.UpdateStatus()
                                If comp.InvokeRequired Then
                                    comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                Else
                                    comp.Refresh()
                                End If
                            Case Else
                                SyncLock comp.Graphical
                                    comp.Graphical.FillPath(comp.CurrentColorStatus, comp.GraphicalPath)
                                End SyncLock
                        End Select
                    Next
                    If Not IsNothing(Me.PTCAuthorityComponents) AndAlso optEnablePTCBOSVETMSMode AndAlso ComponentsInSelection.Count = 0 Then
                        For Each comp In Me.PTCAuthorityComponents
                            Select Case comp.GetType.ToString
                                Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                    comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                    comp.Flasher.Interval = 250
                                    comp.FlashOn = False
                                    comp.FlashComponent = False
                                    comp.UpdateStatus()
                                    If comp.InvokeRequired Then
                                        comp.Invoke(New MethodInvoker(AddressOf comp.Refresh))
                                    Else
                                        comp.Refresh()
                                    End If
                                Case Else
                                    SyncLock comp.Graphical
                                        comp.Graphical.FillPath(comp.CurrentColorStatus, comp.GraphicalPath)
                                    End SyncLock
                            End Select
                        Next
                    End If

                End If
                'Flasher.Enabled = True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

