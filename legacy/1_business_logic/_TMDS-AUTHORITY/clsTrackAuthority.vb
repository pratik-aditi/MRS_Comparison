        Private Function BuildSwitchListString() As String
            Dim SwitchString As New StringBuilder
            Dim compToUse As New ArrayList
            Dim Comp As Object
            Dim LastSwitch As Switch = Nothing
            Dim LastSwitchReversed As Boolean = False
            Try
                If Me.tmpCompList IsNot Nothing AndAlso Me.tmpCompList.Count > 0 Then
                    CopyArrayCollection(compToUse, Me.tmpCompList)
                Else
                    CopyArrayCollection(compToUse, Me.ComponentsInSelection)
                End If

                For Each Comp In compToUse
                    If Comp.GetType.ToString = gSwitchComponentName Then
                        Dim sw As Switch = Nothing
                        sw = CType(Comp, Switch)
                        If sw IsNot Nothing AndAlso sw.TypeOfSwitch <> "DERAIL" Then
                            Dim swstr As String = ""
                            Dim trk As Track = Nothing
                            Dim useReverse As Boolean = sw.ControlledReverse
                            If sw.ControlledReverse Then

                                If LastSwitch IsNot Nothing AndAlso LastSwitch.BrotherSwitches IsNot Nothing AndAlso LastSwitch.BrotherSwitches.Count > 0 AndAlso LastSwitch.BrotherSwitches.Contains(sw) Then
                                    swstr = sw.GUID & "|" & LastSwitchReversed.ToString & ";"
                                    useReverse = LastSwitchReversed
                                Else
                                    Select Case Me.Direction.Trim.ToUpper
                                        Case "RIGHT"
                                            trk = FindTrackFromGUID(sw.LeftLink)
                                        Case Else
                                            trk = FindTrackFromGUID(sw.RightLink)
                                    End Select
                                    If trk IsNot Nothing AndAlso trk.NonTransverable Then useReverse = False
                                    If Not useReverse Then
                                        swstr = sw.GUID & "|FALSE;"
                                    Else
                                        swstr = sw.GUID & "|TRUE;"
                                    End If
                                End If
                                LastSwitch = sw
                                LastSwitchReversed = useReverse


                            Else
                                swstr = sw.GUID & "|" & sw.ControlledReverse.ToString.ToUpper & ";"
                                LastSwitch = sw
                                LastSwitchReversed = sw.ControlledReverse
                            End If
                            Dim swpt As New SwitchPoint
                            With swpt
                                .myName = sw.Name
                                .mySwitch = sw
                                .ReversePosition = useReverse 'sw.ControlledReverse
                            End With
                            If Not Me.SwitchPointList.Contains(swpt) Then Me.SwitchPointList.Add(swpt)
                            SwitchString.Append(swstr)

                        End If
                    End If
                Next
                Return SwitchString.ToString
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                compToUse = New ArrayList
            End Try
            Return SwitchString.ToString
        End Function

#End Region

#Region "REMOTE LINKING"

        Public Function ApplyTrackAuthToRemoteLinks() As Boolean
            Try
                Dim comp As Object

                'Find FlipFlop component
                Dim FoundFlipFlop As Boolean = False
                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = gFlipFlopComponentName Then
                        FoundFlipFlop = True
                    End If
                Next

                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.IsRemoteTrack Then
                            Dim Track As Track = comp
                            Track.myRemoteTrack.SendGetTrackAuthority(Me.AuthorityUID, FoundFlipFlop)
                        End If
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Function

        Public Function UpdateTrackAuthToRemoteLinks() As Boolean
            Try
                Dim comp As Object
                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.IsRemoteTrack Then
                            comp.myRemoteTrack.SendUpdateTrackAuthority(Me.AuthorityUID)
                        End If
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Function

        ''' <summary>
        ''' Removes track?authority links from all remote tracks contained in the current selection.
        ''' </summary>
        ''' <returns>
        ''' <see cref="Boolean"/>: always <see langword="True"/> unless an exception occurs, in which case
        ''' <see langword="False"/> is returned.
        ''' </returns>
        Public Function RemoveTrackAuthFromRemoteLinks() As Boolean
            Try
                For Each track As Track In ComponentsInSelection.OfType(Of Track)
                    If track.IsRemoteTrack Then
                        If Not track.Occuppied Then
                            SystemEvent($"SendRemoveTrackAuthority - RemoveTrackAuthFromRemoteLinks - 1track={track.Name}")
                            track.myRemoteTrack.SendRemoveTrackAuthority(AuthorityUID, PTCAuthorityACKPending)
                        End If
                    End If
                    AuthorityEventLog($"RemoveTrackAuthFromRemoteLinks track={track.Name}:Authority={AuthGUID}")
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

