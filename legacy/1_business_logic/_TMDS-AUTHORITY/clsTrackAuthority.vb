        ''' <summary>
        ''' Get ack status from license
        ''' </summary>
        ''' <returns></returns>
        Public Function GetRemoteTransmissionInProgress() As Boolean
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim reader As OleDbDataReader = Nothing
            Dim Query As String = "SELECT PTCAckPending FROM tblAuthoritiesActive WHERE AuthGUID = '" & Me.AuthGUID & "'"
            Dim Status As Boolean = False
            Try
                dbconn = New OleDbConnection(gConnectionStringAuthority)
                dbconn.Open()
                dbcomm = New OleDbCommand(Query, dbconn)
                reader = dbcomm.ExecuteReader()
                If reader.HasRows Then
                    reader.Read()
                    If reader.IsDBNull(0) Then
                        Status = False
                    Else
                        If reader.GetValue(0).ToString = "" Then
                            Status = False
                        Else
                            Status = True
                        End If
                    End If
                End If
                dbconn.Close()
                dbconn = Nothing
                reader = Nothing
                dbcomm = Nothing
                AuthorityEventLog("GetRemoteTransmissionInProgress:Status=" & Status.ToString & ":AuthGUID=" & Me.AuthGUID)
                Return Status
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                dbcomm = Nothing
                reader = Nothing
            End Try
            Return False
        End Function

