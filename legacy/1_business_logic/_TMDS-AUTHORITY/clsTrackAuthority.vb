        Public Function CreateAuthoritySegmentsForPTC() As String
            Try

                AuthorityEventLog("CreateAuthoritySegmentsForPTC:Start")

                Dim CurrentTrackName As String = String.Empty
                Dim TrackSegments As New ArrayList
                Dim CurrentTrackList As ArrayList = Nothing
                Dim IsBidirectional As Boolean

                If Me.myTrain.MZEnabled Then
                    IsBidirectional = True
                Else
                    IsBidirectional = False
                End If

                Dim Segments As ArrayList = BuildTrackSegments(Nothing)

                'UID;BEGIN_LIMIT;BEGIN_MILEPOST;END_LIMIT;END_MILEPOST;PREFIX;SUFFIX;TRACK NAME(SUBUID|NEXT SEGMENT|NEXT SEGMENT|...ETC
                Dim BeginPrefix As String = String.Empty
                Dim BeginMilePost As String = String.Empty
                Dim BeginSuffix As String = String.Empty
                Dim EndPrefix As String = String.Empty
                Dim EndMilePost As String = String.Empty
                Dim EndSuffix As String = String.Empty
                Dim theTrackName As String = String.Empty
                Dim ListOfSubs As New ArrayList
                Dim bi As BackOfficeServerInstance
                Dim b As Integer
                Dim Segment As New StringBuilder
                Dim theSeg As TrackSegment
                Dim LastComp As Object = Nothing

                For Each theSeg In Segments
                    If optEnableMRSSpecificPTCOperations Then
                        For Each comp As Object In theSeg.myCompList
                            If Not ListOfSubs.Contains(comp.SubdivisionID) Then
                                ListOfSubs.Add(comp.SubdivisionID)
                            End If
                        Next
                    End If
                Next

                For Each theSeg In Segments
                    Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(theSeg.myCompList)
                    Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(theSeg.myCompList)
                    Segment.Append(Format(Now, "mmssfffff"))
                    Segment.Append(";")

                    For Each bi In gPTCBackOfficeServerList
                        For Each b In ListOfSubs
                            If b = bi.mySubdivison.GUID AndAlso FirstTrack.SubdivisionID = b Then
                                'Segment.Append(bi.myPrimaryServer.Name)
                                'Segment.Append(";")
                                If Me.myTrain.IsTestCBTC AndAlso bi.IsTestServerInstance Then
                                    Segment.Append(bi.myPrimaryServer.Name)
                                    Segment.Append(";")
                                ElseIf Not Me.myTrain.IsTestCBTC AndAlso Not bi.IsTestServerInstance Then
                                    Segment.Append(bi.myPrimaryServer.Name)
                                    Segment.Append(";")
                                End If
                            End If
                        Next
                    Next

                    If theSeg.myCompList.Count = 1 Then
                        If Direction = "RIGHT" Then
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitMilePost)
                            Segment.Append(";")
                        Else
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitMilePost)
                            Segment.Append(";")
                        End If
                        Segment.Append(FirstTrack.MilePostPrefix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.MilePostSuffix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.TrackNameAlias)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.SubdivisionID)
                        Segment.Append(";")
                        Segment.Append(IsBidirectional.ToString.ToUpper)
                    Else
                        If Me.Direction = "RIGHT" Then
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(LastTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(LastTrack.RightLimitMilePost)
                            Segment.Append(";")
                        Else
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(LastTrack.LeftLimitName)
                            Segment.Append(";")
                            Segment.Append(LastTrack.LeftLimitMilePost)
                            Segment.Append(";")
                        End If
                        Segment.Append(FirstTrack.MilePostPrefix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.MilePostSuffix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.TrackNameAlias)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.SubdivisionID)
                        Segment.Append(";")
                        Segment.Append(IsBidirectional.ToString.ToUpper)

                    End If
                    Segment.Append("|")
                    theSeg.ResetFlipTracks()
                Next
                AuthorityEventLog("CreateAuthoritySegmentsForPTC:End:NewTrackSegments=" & Segment.ToString)

                Return Segment.ToString

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try

        End Function

        ''' <summary>
        ''' Create Segments for Rollup
        ''' </summary>
        ''' <param name="pRollUpList"></param>
        ''' <param name="pTrain"></param>
        ''' <param name="pIsPartialCancel"></param>
        ''' <returns></returns>
        Public Function CreateAuthoritySegmentsFromRollupForPTC(ByVal pRollUpList As ArrayList, Optional ByVal pTrain As TrainID = Nothing, Optional ByVal pIsPartialCancel As Boolean = False) As String
            Try
                AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:Start")
                Dim CurrentTrackName As String = String.Empty
                Dim TrackSegments As New ArrayList
                Dim CurrentTrackList As ArrayList = Nothing
                Dim IsBidirectional As Boolean
                Dim i As Integer = 0
                Dim ListOfSubs As New ArrayList
                Dim bi As BackOfficeServerInstance
                Dim b As Integer
                If optEnableMRSSpecificPTCOperations Then
                    If Not IsNothing(ComponentsInSelectionForRollup) Then
                        ComponentsInSelectionForRollup.Clear()
                    End If
                    If pIsPartialCancel Then
                        ComponentsInSelectionForRollup.Clear()
                    End If
                    If Not pIsPartialCancel Then
                        ComponentsInSelectionForRollup = pRollUpList
                    End If
                End If
                Dim Segments As ArrayList = BuildTrackSegments(pRollUpList, pIsPartialCancel)
                AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:SegmentsCount=" & Segments.Count)
                'UID;BEGIN_LIMIT;BEGIN_MILEPOST;END_LIMIT;END_MILEPOST;PREFIX;SUFFIX;TRACK NAME(SUBUID|NEXT SEGMENT|NEXT SEGMENT|...ETC
                Dim BeginPrefix As String = String.Empty
                Dim BeginMilePost As String = String.Empty
                Dim BeginSuffix As String = String.Empty
                Dim EndPrefix As String = String.Empty
                Dim EndMilePost As String = String.Empty
                Dim EndSuffix As String = String.Empty
                Dim theTrackName As String = String.Empty
                Dim Segment As New StringBuilder
                Dim theSeg As TrackSegment
                Dim LastComp As Object = Nothing
                Dim Segment1 As New StringBuilder
                Dim theSeg1 As TrackSegment
                Dim comp As Object
                For Each theSeg1 In Segments
                    If optEnableMRSSpecificPTCOperations Then
                        For Each comp In theSeg1.myCompList
                            If Not ListOfSubs.Contains(comp.SubdivisionID) Then
                                ListOfSubs.Add(comp.SubdivisionID)
                            End If
                        Next
                    End If
                Next
                For Each theSeg In Segments
                    Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(theSeg.myCompList)
                    Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(theSeg.myCompList)
                    Dim FirstSegmentMileage As String = "0.00"
                    Dim RemoteTrackFound As Boolean
                    If optEnableMRSSpecificPTCOperations Then
                        If Direction = "RIGHT" Then
                            If LastTrack.GUID = 111228 Then
                                AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:R CreateAuthoritySegmentsFromRollupForPTC transistion=Setting FlipFlop Flag for Track 111228")
                                LastTrack.FlipMe = True
                            End If
                            If LastTrack.GUID = 151197 Then
                                AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:R CreateAuthoritySegmentsFromRollupForPTC transistion=Setting FlipFlop Flag for Track 151197")
                                LastTrack.FlipMe = True
                            End If
                        End If
                        If Direction = "RIGHT" Then
                            If FirstTrack.GUID = 151197 Then
                                AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:L CreateAuthoritySegmentsFromRollupForPTC transistion=Setting FlipFlop Flag for Track 151197")
                                FirstTrack.FlipMe = False
                            End If
                        End If
                    Else
                        If FirstTrack.GUID = 111228 Then
                            FirstTrack.FlipMe = False
                        End If

                        If LastTrack.GUID = 151197 Then
                            LastTrack.FlipMe = True
                        End If
                    End If
                    If Not optEnableExtendLicenseinSplitDesk Then
                        Select Case Direction
                            Case "LEFT"
                                Dim theRemoteTrack As Track
                                If FirstTrack.AltLinkTwo <> 0 Then
                                    theRemoteTrack = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(FirstTrack.AltLinkTwo)
                                    If Not IsNothing(theRemoteTrack) Then
                                        SystemEvent("L CreateAuthoritySegmentsFromRollupForPTC theRemoteTrack 1:" & theRemoteTrack.GUID & "FirstTrack.AltLinkOne" & FirstTrack.GUID)
                                    End If
                                Else
                                    theRemoteTrack = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(FirstTrack.GUID)
                                    If Not IsNothing(theRemoteTrack) Then
                                        SystemEvent("L CreateAuthoritySegmentsFromRollupForPTC theRemoteTrack 2:" & theRemoteTrack.GUID & "FirstTrack.GUID" & FirstTrack.GUID)
                                    End If
                                End If
                                If Not IsNothing(theRemoteTrack) Then
                                    Dim SegmentData As String = theRemoteTrack.myRemoteTrack.SendRequestGetRearOfTrain(Direction)
                                    RemoteTrackFound = True
                                    Dim data() As String = SegmentData.Split("-")
                                    If data.Length = 3 Then
                                        Dim NewSegment As String = data(2).Replace("|", ";")
                                        Segment.Append(Format(Now, "mmssfffffff"))
                                        Segment.Append(";")
                                        Segment.Append(NewSegment)
                                        Segment.Append("|")
                                    End If
                                    Dim TrackData() As String = data(0).Split("|")
                                    FirstSegmentMileage = TrackData(0)
                                End If
                            Case "RIGHT"
                                Dim theRemoteTrack As Track
                                If FirstTrack.AltLinkOne <> 0 Then
                                    theRemoteTrack = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(FirstTrack.AltLinkOne)
                                    If Not IsNothing(theRemoteTrack) Then
                                        SystemEvent("R CreateAuthoritySegmentsFromRollupForPTC theRemoteTrack 1:" & theRemoteTrack.GUID.ToString & "FirstTrack.AltLinkOne" & FirstTrack.GUID.ToString)
                                    End If
                                Else
                                    theRemoteTrack = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(FirstTrack.GUID)
                                    If Not IsNothing(theRemoteTrack) Then
                                        SystemEvent("R CreateAuthoritySegmentsFromRollupForPTC theRemoteTrack 2:" & theRemoteTrack.GUID.ToString & "FirstTrack.GUID" & FirstTrack.GUID.ToString)
                                    End If
                                End If
                                If Not IsNothing(theRemoteTrack) Then
                                    Dim SegmentData As String = theRemoteTrack.myRemoteTrack.SendRequestGetRearOfTrain(Direction)
                                    RemoteTrackFound = True
                                    Dim data() As String = SegmentData.Split("-")
                                    If data.Length = 3 Then
                                        Dim NewSegment As String = data(2).Replace("|", ";")
                                        Segment.Append(Format(Now, "mmssfffffff"))
                                        Segment.Append(";")
                                        Segment.Append(NewSegment)
                                        Segment.Append("|")
                                    End If
                                    Dim TrackData() As String = data(0).Split("|")
                                    FirstSegmentMileage = TrackData(0)
                                End If
                        End Select
                    End If
                    Segment.Append(Format(Now, "mmssfffff"))
                    Segment.Append(";")
                    Dim InsertBOSName As Boolean = False
                    If optEnableMRSSpecificPTCOperations Then
                        If pTrain.isSpanningAuthoirty Then
                            For Each bi In gPTCBackOfficeServerList
                                For Each b In ListOfSubs
                                    If b = bi.mySubdivison.GUID AndAlso (FirstTrack.SubdivisionID = b OrElse LastTrack.SubdivisionID = b) Then
                                        If pTrain.IsTestCBTC AndAlso bi.IsTestServerInstance Then
                                            Segment.Append(bi.myPrimaryServer.Name)
                                            Segment.Append(";")
                                            InsertBOSName = True
                                        ElseIf Not pTrain.IsTestCBTC AndAlso Not bi.IsTestServerInstance Then
                                            Segment.Append(bi.myPrimaryServer.Name)
                                            Segment.Append(";")
                                            InsertBOSName = True
                                        End If
                                    Else
                                        If Not IsNothing(pTrain) Then
                                            If Not pIsPartialCancel Then
                                                If pTrain.isSpanningAuthoirty AndAlso ListOfSubs.Count = 1 Then
                                                End If
                                            End If
                                        End If
                                    End If
                                Next
                            Next
                        End If
                    End If
                    If InsertBOSName = False Then
                        For Each bi In gPTCBackOfficeServerList
                            If ListOfSubs.Count > 0 AndAlso ListOfSubs(0) = bi.mySubdivison.GUID Then
                                If pTrain.IsTestCBTC AndAlso bi.IsTestServerInstance Then
                                    Segment.Append(bi.myPrimaryServer.Name)
                                    Segment.Append(";")
                                    Exit For
                                ElseIf Not pTrain.IsTestCBTC AndAlso Not bi.IsTestServerInstance Then
                                    Segment.Append(bi.myPrimaryServer.Name)
                                    Segment.Append(";")
                                    Exit For
                                End If
                            End If
                        Next
                    End If
                    AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:theSeg.myDirection=" & theSeg.myTrackName & "-" & theSeg.myDirection & ":theSegCount=" & theSeg.myCompList.Count)
                    If theSeg.myCompList.Count = 1 Then
                        If theSeg.myDirection = "RIGHT" Then
                            If Not RemoteTrackFound Then
                                If FirstTrack.FlipMe Then
                                    Segment.Append(FirstTrack.RightLimitMilePost)
                                Else
                                    Segment.Append(FirstTrack.LeftLimitMilePost)
                                End If
                            Else
                                Segment.Append(FirstSegmentMileage)
                            End If
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitMilePost)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            Segment.Append(FirstTrack.RightLimitMilePost)
                            Segment.Append(";")
                        Else
                            If Not RemoteTrackFound Then
                                If FirstTrack.FlipMe Then
                                    Segment.Append(FirstTrack.LeftLimitMilePost)
                                Else
                                    Segment.Append(FirstTrack.RightLimitMilePost)
                                End If
                            Else
                                If FirstSegmentMileage = "0.00" Then
                                    AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:FirstSegmentMileage is = 0" & FirstTrack.GUID.ToString)
                                    Segment.Append(FirstTrack.RightLimitMilePost)
                                Else
                                    Segment.Append(FirstSegmentMileage)
                                End If
                            End If
                            Segment.Append(";")
                            If FirstTrack.FlipMe Then
                                Segment.Append(FirstTrack.LeftLimitMilePost)
                            Else
                                Segment.Append(FirstTrack.RightLimitMilePost)
                            End If
                            Segment.Append(";")
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            If FirstTrack.FlipMe Then
                                Segment.Append(FirstTrack.RightLimitMilePost)
                            Else
                                Segment.Append(FirstTrack.LeftLimitMilePost)
                            End If
                            Segment.Append(";")
                        End If
                        Segment.Append(FirstTrack.MilePostPrefix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.MilePostSuffix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.TrackNameAlias)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.SubdivisionID)
                        Segment.Append(";")
                        Segment.Append(IsBidirectional.ToString.ToUpper)
                    Else
                        If theSeg.myDirection = "RIGHT" Then
                            Segment.Append(FirstTrack.LeftLimitName)
                            Segment.Append(";")
                            If Not RemoteTrackFound Then
                                If FirstTrack.FlipMe Then
                                    Segment.Append(FirstTrack.RightLimitMilePost)
                                Else
                                    Segment.Append(FirstTrack.LeftLimitMilePost)
                                End If
                            Else
                                If FirstSegmentMileage = "0.00" Then
                                    Segment.Append(FirstTrack.LeftLimitMilePost)
                                Else
                                    Segment.Append(FirstSegmentMileage)
                                End If
                            End If
                            Segment.Append(";")
                            Segment.Append(LastTrack.RightLimitName)
                            Segment.Append(";")
                            If LastTrack.FlipMe Then
                                If LastTrack.NormalLegOfSwitch Then
                                    Segment.Append(LastTrack.RightLimitMilePost)
                                Else
                                    Segment.Append(LastTrack.LeftLimitMilePost)
                                End If
                            Else
                                Segment.Append(LastTrack.RightLimitMilePost)
                            End If
                            Segment.Append(";")
                        Else
                            Segment.Append(FirstTrack.RightLimitName)
                            Segment.Append(";")
                            If Not RemoteTrackFound Then
                                If FirstTrack.FlipMe Then
                                    Segment.Append(FirstTrack.LeftLimitMilePost)
                                Else
                                    Segment.Append(FirstTrack.RightLimitMilePost)
                                End If
                            Else
                                If FirstTrack.FlipMe Then
                                    Segment.Append(FirstTrack.LeftLimitMilePost)
                                Else
                                    If FirstSegmentMileage = "0.00" OrElse FirstSegmentMileage = "" Then
                                        AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:FirstSegmentMileage is = 0" & FirstTrack.GUID.ToString)
                                        Segment.Append(FirstTrack.RightLimitMilePost)
                                    Else
                                        Segment.Append(FirstSegmentMileage)
                                    End If
                                End If
                            End If
                            Segment.Append(";")
                            Segment.Append(LastTrack.LeftLimitName)
                            Segment.Append(";")
                            If LastTrack.FlipMe Then
                                If LastTrack.NormalLegOfSwitch Then
                                    Segment.Append(LastTrack.LeftLimitMilePost)
                                    AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:FOUND A GAP CONDITION" & LastTrack.GUID.ToString)
                                Else
                                    Segment.Append(LastTrack.RightLimitMilePost)
                                End If
                            Else
                                Segment.Append(LastTrack.LeftLimitMilePost)
                            End If
                            Segment.Append(";")
                        End If
                        Segment.Append(FirstTrack.MilePostPrefix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.MilePostSuffix)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.TrackNameAlias)
                        Segment.Append(";")
                        Segment.Append(FirstTrack.SubdivisionID)
                        Segment.Append(";")
                        Segment.Append(IsBidirectional.ToString.ToUpper)
                    End If
                    Segment.Append("|")
                    i += 1
                    theSeg.ResetFlipTracks()
                Next
                Dim segs() As String = Segment.ToString.Split("|")
                Dim s As String
                For Each s In segs
                    If s = String.Empty Then Continue For
                    AuthorityEventLog("CreateAuthoritySegmentsFromRollupForPTC:AUTH-SEGMENT=" & s)
                Next
                Return Segment.ToString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Sub DoAssignComponentsForPTC(ByVal CompList As ArrayList)
            Try
                SyncLock Me.PTCAuthorityComponents
                    Me.PTCAuthorityComponents = CompList.Clone
                End SyncLock
                Me.UpdateDatabaseWithPTCComponents()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

