        Public Function UpdateMovementAuthorityText(ByVal IncludeOKTime As Boolean) As Boolean
            Dim WarrantUpdateSQL As String
            Dim dbconn As OleDbConnection
            Dim CommandUpdate As OleDbCommand
            Dim TextList As ArrayList
            Try
                If optEnableSpecificPTCOperationsForMetrolink Then
                    TextList = Me.CreateAuthorityText(IncludeOKTime)
                Else
                    TextList = Me.CreateAuthorityTextForCN(IncludeOKTime)
                End If

                Dim AuthText As String = String.Empty
                Dim TextLine As String
                Dim i As Integer = 0
                For Each TextLine In TextList
                    If i = 0 Then
