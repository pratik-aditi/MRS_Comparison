        Private Function CheckForDeletion() As Boolean
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim Query As String = "SELECT AuthGUID FROM tblAuthoritiesSingleFormInActive WHERE AuthGUID = '" & Me.AuthGUID & "'"
            Dim RecordExists As Boolean
            Try
                dbconn = New OleDbConnection(gConnectionStringDynamic)
                dbconn.Open()
                dbcomm = New OleDbCommand(Query, dbconn)

                If dbcomm.ExecuteNonQuery <> 0 Then
                    RecordExists = True
                End If
                dbconn.Close()
                dbconn = Nothing
                Return RecordExists
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return False
            End Try
        End Function

        Public Function RemoveAuthorityFromDB(ByVal dbConnection As OleDbConnection) As Boolean
            Dim dbconn As OleDbConnection
            Dim CommandInsert As OleDbCommand = Nothing
            Dim CommandDelete As OleDbCommand = Nothing
            Dim Message As String
            Dim SFAInsertSQL As String = String.Empty

            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                dbconn.Open()
                If optEnableARRCSpecificOptions Then
                    Dim QueryCollection As New ArrayList
                    If Not CheckForDeletion() Then
                        Dim theMove As New StringBuilder("INSERT INTO [" & gtblSFAInActive & "]  SELECT * FROM [" & gtblSFAActive & "] WHERE AuthGUID ='" & Me.AuthGUID & "'")
                        Dim theDelete As New StringBuilder("DELETE FROM [" & gtblSFAActive & "] WHERE AuthGUID ='" & Me.AuthGUID & "'")
                        With QueryCollection
                            .Add(theMove.ToString)
                            .Add(theDelete.ToString)
                        End With
                        If Not ExecuteQueryCollection(QueryCollection, gConnectionStringAuthority) Then Return False
                    Else
                        Dim theDelete As New StringBuilder("DELETE FROM [" & gtblSFAActive & "] WHERE AuthGUID ='" & Me.AuthGUID & "'")
                        With QueryCollection
                            .Add(theDelete.ToString)
                        End With
                        If Not ExecuteQueryCollection(QueryCollection, gConnectionStringAuthority) Then Return False
                    End If
                Else
                    If Not CheckForDeletion() Then
                        SFAInsertSQL = Me.CreateInsertCommandInActive(gtblSFAInActive)
                        CommandInsert = New OleDbCommand(SFAInsertSQL, dbconn)
                        CommandInsert.ExecuteNonQuery()
                        Message = "TRACK AUTHORITY INSERTED INTO INACTIVE SFA TABLE:" & Me.AuthorityUID
                        TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                    Else
                        Message = "TRACK AUTHORITY ALREADY INSERTED INTO INACTIVE SFA TABLE:" & Me.AuthorityUID
                        TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                    End If

                    Dim SFADeleteSQL As String = "DELETE FROM " & gtblSFAActive & " WHERE AuthGUID = " & "'" & Me.AuthGUID & "'"
                    CommandDelete = New OleDbCommand(SFADeleteSQL, dbconn)
                    CommandDelete.ExecuteNonQuery()
                    Message = "TRACK WARRANT DELETED FROM ACTIVE SFA TABLE:" & Me.AuthorityUID
                    TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                    dbconn.Close()
                    CommandInsert = Nothing
                    CommandDelete = Nothing
                    dbconn = Nothing
                End If


                Dim DoAddAuthorityEvent As New DoEventLogSFA(AddressOf Me.LogTheSFAEvent)
                DoAddAuthorityEvent.BeginInvoke(EventLogTypeSFA.REMOVE, Nothing, Nothing)

                Dim DoAuthorityEvent As New DoPublishSFAEvent(AddressOf Me.PublishSFAEventUpdate)
                DoAuthorityEvent.BeginInvoke(EventTypeSFA.REMOVE, Nothing, Nothing)

                UpdatePreviousAuthorityField()

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                SystemException(SFAInsertSQL)
                dbconn = Nothing
                Return False
            End Try

        End Function

