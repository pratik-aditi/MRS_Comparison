                SQLValues = SQLValues & s & q & Box2From3 & q & s & q & Box2To3 & q & s & q & Box2Track3 & q
                SQLValues = SQLValues & s & CInt(Box3Clear)
                SQLValues = SQLValues & s & q & Box4From1 & q & s & q & Box4To1 & q & s & q & Box4Track1 & q
                SQLValues = SQLValues & s & q & Box4From2 & q & s & q & Box4To2 & q & s & q & Box4Track2 & q
                SQLValues = SQLValues & s & q & Box4From3 & q & s & q & Box4To3 & q & s & q & Box4Track3 & q

