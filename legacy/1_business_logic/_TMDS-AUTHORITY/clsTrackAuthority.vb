        Private Sub SelectionTimer_tick(ByVal sender As Object, ByVal e As EventArgs) Handles SelectionTimer.Tick

            Dim comp As Object
            MutexRollup = New Mutex(False, "SelectionTimer")
            Try
                MutexRollup.WaitOne()
                If SelectionFlash Then
                    SelectionFlash = False
                Else
                    SelectionFlash = True
                End If


                For Each comp In RollUpList
                    'SyncLock comp
                    Select Case comp.GetType.ToString
                        Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                            comp.FlashOn = SelectionFlash
                            comp.Refresh()
                    End Select
                    'End SyncLock

                Next
                SelectionTimer.Enabled = True
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                MutexRollup.ReleaseMutex()
            End Try
        End Sub

        Public Sub ClearSelection()
            Dim comp As Object
            Try
                For Each comp In Me.RollUpList
                    SyncLock comp
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                comp.FlashComponent = False
                                comp.FlashOn = False
                                comp.Refresh()
                        End Select
                    End SyncLock

                Next
                SelectionTimer.Enabled = False
                SelectionFlash = False
                Me.RollUpList.Clear()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function FindEntryTrack(ByVal OStrk As Track, ByVal trn As TrainID) As Track
            Try
                Dim LoopControl As Integer
                Dim NextComp As Object
                Dim LastRefNumber As Int32

                Dim Direction As String = String.Empty '= trn.Direction

                Dim trk As Object
                If Not IsNothing(OStrk.OsComponentCollection) Then
                    For Each trk In OStrk.OsComponentCollection
                        If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If trk.TrafficDirection <> "" Then
                                Direction = trk.TrafficDirection
                                Exit For
                            End If
                        End If
                    Next
                End If

                If Direction = "" Then
                    Direction = trn.Direction
                    If Direction = "EAST" Or Direction = "NORTH" Then
                        Direction = "LEFT"
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(OStrk.RightLink)
                    Else
                        Direction = "RIGHT"
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(OStrk.LeftLink)
                    End If
                Else
                    If Direction = "LEFT" Then
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(OStrk.RightLink)
                    Else
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(OStrk.LeftLink)
                    End If
                End If
                LastRefNumber = NextComp.GUID

                Do
                    If NextComp Is Nothing Then Return Nothing
                    If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        If Direction = "LEFT" Then
                            If NextComp.ControlledReverse Then
                                If LastRefNumber = NextComp.LeftAltLink Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                End If
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        Else
                            If NextComp.ControlledReverse Then
                                If LastRefNumber = NextComp.RightAltLink Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                End If
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                        End If

                    ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If Direction = "LEFT" Then
                            If NextComp.ComponentType = "L" Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                                Return NextComp
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        Else
                            If NextComp.ComponentType = "R" Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                                Return NextComp
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                        End If
                    Else
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            'Dim trk1 As Track = CType(NextComp, Track)
                            If NextComp.OSReporting Then
                                Return NextComp
                            End If
                        End If

                        LastRefNumber = NextComp.GUID
                        If Direction = "LEFT" Then
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        Else

                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl > 20 Then
                        Return Nothing
                    End If
                Loop
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Sub CheckForCriteriaSatifactionForOpposingSFAItemFourLimits(ByVal LimitsToCheck As ArrayList)
            Try
                Dim comp As Object
                Dim auth As SFAuthority
                For Each comp In LimitsToCheck
                    If comp.TrackAuthorities.Count > 0 Then
                        For Each auth In comp.TrackAuthorities
                            If auth.Box4Components.Count > 0 Then
                                If auth.Box5Arrival.Contains(Me.IssueTo) Then
                                    Dim TrainArrivalIndex As Integer = auth.Box5Arrival.IndexOf(Me.IssueTo)
                                    Dim FirstBoxFourTrack As Track = FindFirstTrackInList(auth.Box4Components)
                                    If FirstBoxFourTrack.TrackAuthorities.Count > 0 Then
                                        Dim NewAuth As SFAuthority
                                        For Each NewAuth In FirstBoxFourTrack.TrackAuthorities
                                            If NewAuth.AuthorityUID <> Me.AuthorityUID Then
                                                If NewAuth.IssueTo = Me.IssueTo Then
                                                    Exit Sub
                                                End If
                                            End If
                                        Next
                                    End If
                                    If LimitsToCheck.Contains(FirstBoxFourTrack) Then
                                        Select Case TrainArrivalIndex
                                            Case 0
                                                auth.BoxFourTrainSatifiedOne = True
                                            Case 1
                                                auth.BoxFourTrainSatifiedTwo = True
                                            Case 2
                                                auth.BoxFourTrainSatifiedThree = True
                                        End Select
                                        If Not auth.ShowItemFourComponents Then
                                            auth.CheckToSeeIfBoxFiveTrainInSidingAlready(auth.Box4Components)
                                            auth.CheckToSeeIfBoxFiveTrainOnMainBewteenSwitchesAlready(auth.Box4Components)

                                            auth.UpdateBoxFourTrainSituation()
                                            auth.CheckToShowItemFourComponents()
                                        End If
                                        'Exit Sub
                                    End If
                                End If
                            ElseIf auth.CheckBoxItemsStatus(3) And Not auth.CheckBoxItemsStatus(1) Then
                                If auth.Box5Arrival.Contains(Me.IssueTo) Then
                                    Dim TrainArrivalIndex As Integer = auth.Box5Arrival.IndexOf(Me.IssueTo)
                                    Dim FirstBoxFourTrack As Track = FindFirstTrackInList(auth.Components)
                                    If FirstBoxFourTrack.TrackAuthorities.Count > 0 Then
                                        Dim NewAuth As SFAuthority
                                        For Each NewAuth In FirstBoxFourTrack.TrackAuthorities
                                            If NewAuth.AuthorityUID <> Me.AuthorityUID Then
                                                If NewAuth.IssueTo = Me.IssueTo Then
                                                    Exit Sub
                                                End If
                                            End If
                                        Next
                                    End If
                                    If LimitsToCheck.Contains(FirstBoxFourTrack) Then
                                        Select Case TrainArrivalIndex
                                            Case 0
                                                auth.BoxFourTrainSatifiedOne = True
                                            Case 1
                                                auth.BoxFourTrainSatifiedTwo = True
                                            Case 2
                                                auth.BoxFourTrainSatifiedThree = True
                                        End Select
                                        If Not auth.ShowItemFourComponents Then
                                            auth.CheckToSeeIfBoxFiveTrainInSidingAlready(auth.Components)
                                            auth.CheckToSeeIfBoxFiveTrainOnMainBewteenSwitchesAlready(auth.Components)

                                            auth.UpdateBoxFourTrainSituation()
                                            auth.CheckToShowItemFourComponents()
                                            'Exit Sub
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    End If
                Next


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckToSeeIfBoxFiveTrainInSidingAlready(ByVal CompList As ArrayList)
            Try
                Dim FirstTrack As Track = Me.FindFirstTrackInList(CompList)
                If IsNothing(FirstTrack) Then Exit Sub
                If FirstTrack.OStype Then
                    Dim SidingTrack As Track = Me.FindConnectingSidingTrack(FirstTrack)
                    If Not IsNothing(SidingTrack) Then
                        If SidingTrack.TrainIDs.Count > 0 Then
                            Dim trn As TrainID
                            For Each trn In SidingTrack.TrainIDs
                                If Me.Box5Arrival.Contains(trn.IdentifingUnit & " " & trn.Direction) Then
                                    Dim TrainArrivalIndex As Integer = Me.Box5Arrival.IndexOf(trn.IdentifingUnit & " " & trn.Direction)
                                    Select Case TrainArrivalIndex
                                        Case 0
                                            Me.BoxFourTrainSatifiedOne = True
                                        Case 1
                                            Me.BoxFourTrainSatifiedTwo = True
                                        Case 2
                                            Me.BoxFourTrainSatifiedThree = True
                                    End Select
                                End If
                            Next
                        End If
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckToSeeIfBoxFiveTrainOnMainBewteenSwitchesAlready(ByVal CompList As ArrayList)
            Try
                Dim FirstTrack As Track = Me.FindFirstTrackInList(CompList)
                If IsNothing(FirstTrack) Then Exit Sub
                If FirstTrack.OStype Then
                    Dim SidingTrack As Track = Me.FindConnectingMainTrack(FirstTrack)
                    If Not IsNothing(SidingTrack) Then
                        If SidingTrack.TrainIDs.Count > 0 Then
                            Dim trn As TrainID
                            For Each trn In SidingTrack.TrainIDs
                                If Me.Box5Arrival.Contains(trn.IdentifingUnit & " " & trn.Direction) Then
                                    Dim TrainArrivalIndex As Integer = Me.Box5Arrival.IndexOf(trn.IdentifingUnit & " " & trn.Direction)
                                    Select Case TrainArrivalIndex
                                        Case 0
                                            Me.BoxFourTrainSatifiedOne = True
                                        Case 1
                                            Me.BoxFourTrainSatifiedTwo = True
                                        Case 2
                                            Me.BoxFourTrainSatifiedThree = True
                                    End Select
                                End If
                            Next
                        End If
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub CheckToShowItemFourComponents()
            Try

                Dim DoNotPerformBoxFourLimitsDisplay As Boolean
                Dim i As Integer
                For i = 0 To Me.Box5Arrival.Count - 1
                    Select Case i
                        Case 0
                            If Not Me.BoxFourTrainSatifiedOne Then
                                DoNotPerformBoxFourLimitsDisplay = True
                            End If
                        Case 1
                            If Not Me.BoxFourTrainSatifiedTwo Then
                                DoNotPerformBoxFourLimitsDisplay = True
                            End If
                        Case 2
                            If Not Me.BoxFourTrainSatifiedThree Then
                                DoNotPerformBoxFourLimitsDisplay = True
                            End If
                    End Select
                Next
                If Not DoNotPerformBoxFourLimitsDisplay Then
                    Me.ShowItemFourComponents = True
                    Dim comp1 As Object
                    For Each comp1 In Me.Box4Components
                        comp1.UpdateStatus()
                    Next
                    If Me.CheckBoxItemsStatus(3) And Not Me.CheckBoxItemsStatus(1) Then
                        For Each comp1 In Me.Components
                            comp1.UpdateStatus()
                        Next
                    End If
                End If

                If Me.CheckBoxItemsStatus(2) And Me.ShowItemFourComponents Then
                    Dim FirstTrackInItemFourComponents As Track = Me.FindFirstTrackInList(Me.Box4Components)
                    If Not IsNothing(FirstTrackInItemFourComponents) Then
                        If FirstTrackInItemFourComponents.OStype Then
                            Dim comp As Object
                            For Each comp In FirstTrackInItemFourComponents.OsComponentCollection
                                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(comp, Switch)
                                    If Not sw.ControlledReverse Then
                                        If Not sw.BlockAbsolute Then
                                            sw.ControlSwitch()
                                            Dim comp1 As Object
                                            For Each comp1 In FirstTrackInItemFourComponents.OsComponentCollection
                                                If comp1.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                    comp1.InitAuthorityNumbers()
                                                End If
                                            Next
                                        End If
                                    End If
                                End If
                            Next
                        End If
                    End If
                Else
                    If Me.CheckBoxItemsStatus(3) And Not Me.CheckBoxItemsStatus(1) And Me.ShowItemFourComponents Then
                        Me.CheckToReverseSwitchOnIssuance(Me.Components)
                    End If
                End If


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Public Function FindFirstTrackInList(ByVal CompList As ArrayList) As Track
            Try
                Dim comp As Object
                For Each comp In CompList
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Return comp
                    End If
                Next
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function FindLastTrackInList(ByVal CompList As ArrayList) As Track
            Try
                Dim CompListReverse As ArrayList = CompList.Clone
                CompListReverse.Reverse()
                Dim comp As Object
                For Each comp In CompListReverse
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Return comp
                    End If
                Next
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function CheckToReverseSwitchOnIssuance(ByVal CompList As ArrayList, Optional ByVal OverrideForPOSType As Boolean = False) As Boolean
            Try
                Dim FirstTrack As Track = Me.FindFirstTrackInList(CompList)
                If Me.CheckBoxItemsStatus(3) And Not Me.ShowItemFourComponents Then
                    Return True
                End If
                If FirstTrack.OStype Then
                    Dim SidingTrack As Track = Me.FindConnectingSidingTrack(FirstTrack)
                    If Not IsNothing(SidingTrack) Then
                        Dim trn As TrainID
                        If SidingTrack.TrainIDs.Count > 0 Then
                            For Each trn In SidingTrack.TrainIDs
                                If trn.IdentifingUnit = Mid(Me.IssueTo, 1, trn.IdentifingUnit.Length) Then
                                    Dim sw As Switch = Me.FindSwitchInOS(FirstTrack)
                                    If Not sw.ControlledReverse And Not sw.BlockAbsolute Then
                                        Dim ControlTheSwitchReverse As Boolean = True
                                        If OverrideForPOSType And sw.ProtectOpenSwitchEnabled Then ControlTheSwitchReverse = False
                                        If ControlTheSwitchReverse Then
                                            sw.ControlSwitch()
                                            If Not sw.UpdateSwitchPositionInDatabaseWithFeedBack(TMDS.GlobalDeclarations.gDatabaseConnectionStatic) Then
                                                sw.ControlSwitch()
                                                Dim Message As String = sw.Name & " WAS NOT REVERSED PROPERLY. CONTACT HELP IMMMEDIATELY!"
                                                MessageBox.Show(Message, "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                                Return False
                                            End If

                                            Dim comp As Object
                                            For Each comp In FirstTrack.OsComponentCollection
                                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                    comp.InitAuthorityNumbers()
                                                End If
                                            Next
                                        End If
                                    End If
                                End If
                            Next
                        End If
                    End If
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Public Function FindSwitchInOS(ByVal Ostrk As Track) As Switch
            Try
                Dim comp As Object
                If Not IsNothing(Ostrk.OsComponentCollection) Then
                    For Each comp In Ostrk.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Return comp
                        End If
                    Next
                End If
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function FindConnectingSidingTrack(ByVal OsTrk As Track) As Track
            Try
                Dim comp As Object
                Dim LeftLinkSearch As Boolean
                If Not IsNothing(OsTrk.OsComponentCollection) Then
                    For Each comp In OsTrk.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(comp, Switch)
                            If sw.LeftAltLink <> 0 Then
                                LeftLinkSearch = True
                            End If
                        End If
                    Next
                    For Each comp In OsTrk.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If LeftLinkSearch Then
                                Dim LeftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(comp.LeftLink)
                                If Not IsNothing(LeftTrack) Then
                                    If optEnableTrackSidingBit Then
                                        'NEW SIDING LOGIC CODE
                                        If LeftTrack.EnableControlledSiding Or LeftTrack.EnableNonControlledSiding Then Return LeftTrack
                                    Else
                                        'OLD LEGACY SIDING CODE
                                        If Mid(LeftTrack.TrackName, 1, 6) = "SIDING" Then
                                            Return LeftTrack
                                        End If
                                    End If

                                End If
                            Else
                                Dim RightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(comp.RightLink)
                                If Not IsNothing(RightTrack) Then
                                    If optEnableTrackSidingBit Then
                                        'NEW SIDING LOGIC CODE
                                        If RightTrack.EnableControlledSiding Or RightTrack.EnableNonControlledSiding Then Return RightTrack
                                    Else
                                        'OLD LEGACY SIDING CODE
                                        If Mid(RightTrack.TrackName, 1, 6) = "SIDING" Then
                                            Return RightTrack
                                        End If
                                    End If

                                End If
                            End If
                        End If
                    Next
                End If
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function FindConnectingMainTrack(ByVal OsTrk As Track) As Track
            Try
                Dim comp As Object
                Dim LeftLinkSearch As Boolean
                If Not IsNothing(OsTrk.OsComponentCollection) Then
                    For Each comp In OsTrk.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(comp, Switch)
                            If sw.LeftAltLink <> 0 Then
                                LeftLinkSearch = True
                            End If
                        End If
                    Next
                    For Each comp In OsTrk.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If LeftLinkSearch Then
                                Dim LeftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(comp.LeftLink)
                                If Not IsNothing(LeftTrack) Then
                                    If Mid(LeftTrack.TrackName, 1, 4) = "MAIN" And Not LeftTrack.OStype Then
                                        Return LeftTrack
                                    End If
                                End If
                            Else
                                Dim RightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(comp.RightLink)
                                If Not IsNothing(RightTrack) Then
                                    If Mid(RightTrack.TrackName, 1, 4) = "MAIN" And Not RightTrack.OStype Then
                                        Return RightTrack
                                    End If
                                End If
                            End If
                        End If
                    Next
                End If
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub PerformCPTrainRollup()
            Dim comp As Object = Nothing
            Dim OsLoggingTrack As Track = Nothing
            Dim strRollupList As String = ""
            Dim RollUpEventMessage As String = String.Empty
            Dim RightLimits As String = String.Empty
            Dim LeftLimits As String = String.Empty
            Dim trk1 As Object = Nothing
            Dim trk2 As Object = Nothing
            Dim SwitchCollection As New ArrayList
            Dim TrnToMove As TrainID
            Try
                If String.IsNullOrEmpty(Me.PTCRollEventText) OrElse Me.PTCRollEventText.Trim = String.Empty Then
                    Dim RollUpBy As String = "NONE" ' Me.PTCRollUpBy
                    Dim Rolldate As Date


                    trk1 = Me.FindFirstTrackInList(PTCRollupCompCollection)
                    trk2 = Me.FindLastTrackInList(PTCRollupCompCollection)

                    If IsValidDate(Me.PTCRollUpTime.ToString) Then
                        Rolldate = Me.PTCRollUpTime
                    Else
                        If trk1 IsNot Nothing AndAlso trk1.GetType.ToString = gTrackComponentName Then
                            Rolldate = GenerateTime(trk1.mySubdivision)
                        ElseIf trk2 IsNot Nothing AndAlso trk1.GetType.ToString = gTrackComponentName Then
                            Rolldate = GenerateTime(trk1.mySubdivision)
                        Else
                            Rolldate = GenerateTime(Nothing)
                        End If
                    End If
                    If Not String.IsNullOrEmpty(Me.PTCRollUpBy) AndAlso Me.PTCRollUpBy.Trim <> String.Empty Then
                        RollUpBy = Me.PTCRollUpBy
                    End If

                    If PTCRollupReleaseDirection = "RIGHT" Then
                        RightLimits = trk1.LeftLimitName
                        LeftLimits = trk2.RightLimitName
                    Else
                        LeftLimits = trk1.RightLimitName
                        RightLimits = trk2.LeftLimitName
                    End If

                    If InStr(RightLimits, ",") > 0 Then
                        Dim Delimiter As Integer = InStr(RightLimits, ",")
                        RightLimits = Mid(RightLimits, 1, Delimiter - 1)
                    End If
                    If InStr(LeftLimits, ",") > 0 Then
                        Dim Delimiter As Integer = InStr(LeftLimits, ",")
                        LeftLimits = Mid(LeftLimits, 1, Delimiter - 1)
                    End If


                    If Me.Direction.Trim.ToUpper = "RIGHT" Then
                        RollUpEventMessage = RollUpEventMessage & RightLimits & "|" & LeftLimits & "|" & RollUpBy & " @ " & Rolldate.ToString & "|" & PTCRollupReleaseDirection & "|"
                    Else
                        RollUpEventMessage = RollUpEventMessage & LeftLimits & "|" & RightLimits & "|" & RollUpBy & " @ " & Rolldate.ToString & "|" & PTCRollupReleaseDirection & "|"
                    End If
                    For Each comp In PTCRollupCompCollection
                        If comp.GetType.ToString = gSwitchComponentName Then
                            If Not SwitchCollection.Contains(comp) Then SwitchCollection.Add(comp)
                        End If
                    Next
                    comp = Nothing
                    For Each comp In SwitchCollection
                        Dim OSComp As Object
                        If Not comp.OsComponentCollection Is Nothing Then
                            For Each OSComp In comp.OsComponentCollection
                                If Not PTCRollupCompCollection.Contains(OSComp) Then PTCRollupCompCollection.Add(OSComp)
                            Next
                        End If
                    Next
                    comp = Nothing



                    For Each comp In PTCRollupCompCollection
                        RollUpEventMessage = RollUpEventMessage & comp.GUID & "-"
                    Next
                    'RollUpEvent.Add(RollUpEventMessage)

                Else
                    RollUpEventMessage = Me.PTCRollEventText.Trim
                End If

                SystemEvent(Me.AuthorityUID & " ROLL UP EVENT DATA:" & RollUpEventMessage)
                Me.RollUpEvents.Add(RollUpEventMessage)
                Me.CurrentRollUpEvent = RollUpEventMessage


                TrnToMove = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(Mid(Me.IssueTo, 1, 10))
                If Not TrnToMove Is Nothing Then
                    If PTCRollupTrack.OSReporting Then OsLoggingTrack = PTCRollupTrack
                    If Not IsNothing(OsLoggingTrack) And Not optEnableLogOSOnAllTWCMoves Then
                        If Not IsNothing(TrnToMove) Then
                            Dim LastOsTrackFound As Track = Nothing
                            For Each comp In PTCRollupCompCollection
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    Dim t As Track = CType(comp, Track)
                                    If t.OStype And IsNothing(LastOsTrackFound) Then
                                        LastOsTrackFound = t
                                    End If
                                End If
                            Next
                            If IsNothing(LastOsTrackFound) Then
                                LastOsTrackFound = OsLoggingTrack
                            End If
                            Dim EntryTrack As Track = Me.FindEntryTrack(OsLoggingTrack, TrnToMove)
                            TrnToMove.OSPreviousControlPoint = OsLoggingTrack.myControlPoint
                            TrnToMove.OSPreviousTrack = OsLoggingTrack
                            OsLoggingTrack.LogOsMessage(Format(PTCRollupReleaseTime, "HH:mm:ss"), False, TrnToMove)
                        End If
                    ElseIf optEnableLogOSOnAllTWCMoves Then
                        PTCRollupTrack.LogOsMessage(Format(PTCRollupReleaseTime, "HH:mm:ss"), False, TrnToMove)
                    End If
                End If
                For Each comp In PTCRollupCompCollection
                    Me.Components.Remove(comp)
                    comp.TrackAuthorities.Remove(Me)
                    comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                    comp.UpdateStatus()
                    comp.InitAuthorityNumbers()
                    If strRollupList.Trim = "" Then
                        strRollupList = comp.guid.ToString
                    Else
                        strRollupList = strRollupList & "-" & comp.guid.ToString
                    End If
                Next

                'RollUp - TRAIN MOVE
                If Not TrnToMove Is Nothing Then
                    If Me.Components.Contains(PTCRollupTrack) Then
                        PTCRollupTrack.MoveTrainIDPlaceManual(TrnToMove, TrnToMove.myTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                    Else
                        Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(Me.Components)
                        If Not FirstTrack Is Nothing Then
                            FirstTrack.MoveTrainIDPlaceManual(TrnToMove, TrnToMove.myTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                        Else
                            PTCRollupTrack.MoveTrainIDPlaceManual(TrnToMove, TrnToMove.myTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                        End If
                    End If
                End If
                Me.UpdateDatabaseWithRollUpEvent()
                Me.CreateReducedLimitsVerbiage()


                Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", Me)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock

                Dim SummItem1 As New SummaryItem("AUTHORITY", "ADD", Me)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem1)
                End SyncLock


            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                PTCRollupTrack = Nothing
                PTCRollupCompCollection = New ArrayList
                PTCRollupReleaseDirection = ""
                comp = Nothing
                OsLoggingTrack = Nothing
                trk1 = Nothing
                trk2 = Nothing
                TrnToMove = Nothing
                SwitchCollection = New ArrayList
                Me.PTCRollEventText = String.Empty
                Me.PTCReducedRollEventText = String.Empty
            End Try
        End Sub

        Private Sub CheckToAddSidingTracksToRollUpList(ByRef theRollupList As ArrayList, ByVal ReleaseDirection As String, ByVal TrackSelected As Track)
            Try

                Dim TrackList As New ArrayList
                Dim comp As Object
                Dim tmpRollupList As New ArrayList
                CopyArrayCollection(tmpRollupList, theRollupList)
                For Each comp In tmpRollupList 'theRollupList
                    If comp.GetType.ToString = gSwitchComponentName Then
                        Dim sw As Switch = CType(comp, Switch)
                        If (sw.RightAltLink <> 0 AndAlso ReleaseDirection = "LEFT") OrElse (sw.LeftAltLink <> 0 AndAlso ReleaseDirection = "RIGHT") Then 'Or (sw.LeftAltLink <> 0 AndAlso ReleaseDirection = "LEFT") 
                            Dim theSidingTrack As Track = TMDS.SystemUtilities.FetchData.FindSidingTrackFromSwitch(sw)
                            If Not IsNothing(theSidingTrack) Then
                                If Me.Components.Contains(theSidingTrack) Then
                                    Dim SwIndex As Integer = theRollupList.IndexOf(sw)
                                    'theRollupList.Add(theSidingTrack)
                                    'If theRollupList.Contains(theSidingTrack) Then theRollupList.Remove(theSidingTrack)
                                    If Not theRollupList.Contains(theSidingTrack) Then theRollupList.Insert(SwIndex, theSidingTrack)
                                Else
                                    Dim auth As TrackAuthority = FindMixModeAuthority(theSidingTrack)
                                    If Not IsNothing(auth) Then
                                        If auth.ComponentsInSelection.Contains(theSidingTrack) Then
                                            Dim SwIndex As Integer = theRollupList.IndexOf(sw)
                                            'theRollupList.Add(theSidingTrack)
                                            ' If theRollupList.Contains(theSidingTrack) Then theRollupList.Remove(theSidingTrack)
                                            If Not theRollupList.Contains(theSidingTrack) Then theRollupList.Insert(SwIndex, theSidingTrack)
                                            CheckToAddAllLikeTracks(theRollupList, theSidingTrack)
                                        End If
                                    End If
                                End If
                            End If
                        ElseIf sw.LeftAltLink <> 0 AndAlso ReleaseDirection = "LEFT" Or sw.RightAltLink <> 0 AndAlso ReleaseDirection = "RIGHT" Then
                            Dim theSidingTrack As Track = TMDS.SystemUtilities.FetchData.FindSidingTrackFromSwitch(sw)
                            Dim tmpSidingTrackList As New ArrayList
                            tmpSidingTrackList.Add(TrackSelected)
                            CheckToAddAllLikeTracks(tmpSidingTrackList, theSidingTrack)
                            If theSidingTrack IsNot Nothing AndAlso Not tmpSidingTrackList.Contains(theSidingTrack) Then
                                Dim LeftSW As Switch = Nothing
                                Dim RightSW As Switch = Nothing
                                LeftSW = TMDS.SystemUtilities.FetchData.FindSwitchFromSidingTrack(theSidingTrack, "LEFT", False)
                                RightSW = TMDS.SystemUtilities.FetchData.FindSwitchFromSidingTrack(theSidingTrack, "RIGHT", False)
                                If LeftSW IsNot Nothing AndAlso RightSW IsNot Nothing Then
                                Else
                                    If Me.Components.Contains(theSidingTrack) Then
                                        Dim SwIndex As Integer = theRollupList.IndexOf(sw)
                                        'theRollupList.Add(theSidingTrack)
                                        'If theRollupList.Contains(theSidingTrack) Then theRollupList.Remove(theSidingTrack)
                                        If Not theRollupList.Contains(theSidingTrack) Then theRollupList.Insert(SwIndex, theSidingTrack)
                                    Else
                                        Dim auth As TrackAuthority = FindMixModeAuthority(theSidingTrack)
                                        If Not IsNothing(auth) Then
                                            If auth.ComponentsInSelection.Contains(theSidingTrack) Then
                                                Dim SwIndex As Integer = theRollupList.IndexOf(sw)
                                                'theRollupList.Add(theSidingTrack)
                                                'If theRollupList.Contains(theSidingTrack) Then theRollupList.Remove(theSidingTrack)
                                                If Not theRollupList.Contains(theSidingTrack) Then theRollupList.Insert(SwIndex, theSidingTrack)
                                                CheckToAddAllLikeTracks(theRollupList, theSidingTrack)
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        End If

                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckToAddAllLikeTracks(ByRef theList As ArrayList, ByVal theTrack As Track)
            Try
                Dim NextComp As Object = Nothing
                Dim Directions As New ArrayList
                Dim LoopControl As Integer
                Directions.Add("RIGHT") : Directions.Add("LEFT")
                Dim d As String
                For Each d In Directions
                    Select Case d
                        Case "RIGHT"
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(theTrack.RightLink)
                            Do
                                If IsNothing(NextComp) Then Exit Do
                                If NextComp.GetType.ToString = gTrackComponentName Then
                                    Dim trk As Track = CType(NextComp, Track)
                                    If trk.Name = theTrack.Name Then
                                        'If theList.Contains(trk) Then theList.Remove(trk)
                                        Dim Index As Integer = theList.IndexOf(theTrack)
                                        If Not theList.Contains(trk) Then theList.Insert(Index, trk)
                                    Else
                                        Exit Do
                                    End If
                                Else
                                    Exit Do
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)

                                LoopControl += 1
                                If LoopControl >= 5 Then
                                    Exit Do
                                End If
                            Loop
                        Case "LEFT"
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(theTrack.LeftLink)

                            Do
                                If IsNothing(NextComp) Then Exit Do
                                If NextComp.GetType.ToString = gTrackComponentName Then
                                    Dim trk As Track = CType(NextComp, Track)
                                    If trk.Name = theTrack.Name Then
                                        ' If theList.Contains(trk) Then theList.Remove(trk)
                                        Dim Index As Integer = theList.IndexOf(theTrack)
                                        theList.Insert(Index, trk)
                                    Else
                                        Exit Do
                                    End If
                                Else
                                    Exit Do
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)

                                LoopControl += 1
                                If LoopControl >= 5 Then
                                    Exit Do
                                End If
                            Loop
                    End Select
                Next


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

