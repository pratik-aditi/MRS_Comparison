#Region "VETMS-PTC RELEASE METHODS"

        Public Sub VETMS_PerformRelease(ByVal theTrain As TrainID, Optional ByVal ForceTrainStop As Boolean = False)
            Try
                PTCElectronicTransmissionInProgress = True
                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                Me.PTCElectronicDeliveryCompleted = False
                Me.PTCMarkedToBeVoidedElectronically = True
                Me.PTCTypeAuthority = True
                Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.RELEASE.ToString
                DoAssignComponentsForPTC(ComponentsInSelection)
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageVoid_CTC(Me, theTrain, PTCMessageUID, ForceTrainStop)
                Me.PTCStatus = "RELEASE-SENT"
                Me.SetPTCAuthorityFlasherStatus("VETMS_PerformRelease")
                If Me.UpdateDatabaseWithPTCAuthorityStatus(Me.PTCStatus) Then
                    AuthorityEventLog("VETMS_PerformRelease:PTCStatus=" & Me.PTCStatus)
                End If
                If Not optDisableFlashingTrackForPTC Then Me.FlasherMode(True, True)
                Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC", Me)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock
                VETMS_CreateTimerReleaseEvent()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub VETMS_PerformReleaseAgain(ByVal theTrain As TrainID)
            Try
                PTCElectronicTransmissionInProgress = True
                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                Me.PTCMarkedToBeVoidedElectronically = True
                Me.PTCTypeAuthority = True
                Me.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.RELEASE.ToString
                'Me.PTCAuthorityComponents = Me.ComponentsInSelection
                'Me.UpdateDatabaseWithPTCComponents()

                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageVoid_CTC(Me, theTrain, PTCMessageUID)
                Me.PTCStatus = "RELEASE-SENT"
