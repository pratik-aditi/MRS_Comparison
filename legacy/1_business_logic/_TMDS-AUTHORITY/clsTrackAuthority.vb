                                    '        Else
                                    '            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftLink)
                                    '        End If
                                    '    Else
                                    '        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftLink)
                                    '    End If
                                    'Else
                                    '    If sw.RightAltLink <> 0 Then
