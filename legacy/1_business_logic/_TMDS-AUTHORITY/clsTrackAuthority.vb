        Public Sub SendCreateAuthorityElectronicMessage(Optional ByVal ReplaceAuthority As Boolean = False)
            Try
                If Not Me.IssuedToTrain Then Exit Sub
                Dim MessageToSend As String = Me.IssueTo & "|" & Me.AuthorityNumber & "|"

                Dim comp As Track
                Dim BlockList As New ArrayList()
                Dim BlockID As Int32
                Dim blk As SubAuthority = Nothing

                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.PTCBlockID <> BlockID Then
                            BlockID = comp.PTCBlockID
                            blk = New SubAuthority()
                            blk.BlockID = BlockID
                            blk.SubID = comp.SubdivisionID
                            BlockList.Add(blk)
                            blk.CompList.Add(comp)
                        ElseIf comp.PTCBlockID = BlockID And comp.PTCBlockID <> 0 Then
                            blk.CompList.Add(comp)
                        End If
                    End If
                Next

                Dim blkInList As SubAuthority = Nothing
                Dim TrainType As String = String.Empty
                For Each blkInList In BlockList
                    Dim trk As Track
                    Dim MilePostOne, MilePostTwo As Decimal

                    'Get Direction
                    For Each trk In blkInList.CompList
                        Select Case Me.Direction
                            Case "RIGHT"
                                If MilePostOne = 0 Then
                                    MilePostOne = trk.LeftLimitMilePost
                                    TrainType = Me.GetTrainType(Me.IssueTo)
                                    blkInList.Speed = Me.GetTrackSpeed(trk, TrainType)
                                End If
                                MilePostTwo = trk.RightLimitMilePost
                            Case "LEFT"
                                If MilePostOne = 0 Then
                                    MilePostOne = trk.RightLimitMilePost
                                    TrainType = Me.GetTrainType(Me.IssueTo)
                                    blkInList.Speed = Me.GetTrackSpeed(trk, TrainType)
                                End If
                                MilePostTwo = trk.LeftLimitMilePost
                            Case "BOTH"
                                Select Case Me.WorkDirection
                                    Case "LEFT"
                                        If MilePostOne = 0 Then
                                            MilePostOne = trk.RightLimitMilePost
                                            TrainType = Me.GetTrainType(Me.IssueTo)
                                            If Not Me.JointAuthority Then
                                                blkInList.Speed = Me.GetTrackSpeed(trk, TrainType)
                                            Else
                                                blkInList.Speed = 30
                                            End If

                                        End If
                                        MilePostTwo = trk.LeftLimitMilePost
                                    Case "RIGHT"
                                        If MilePostOne = 0 Then
                                            MilePostOne = trk.LeftLimitMilePost
                                            TrainType = Me.GetTrainType(Me.IssueTo)
                                            If Not Me.JointAuthority Then
                                                blkInList.Speed = Me.GetTrackSpeed(trk, TrainType)
                                            Else
                                                blkInList.Speed = 30
                                            End If

                                        End If
                                        MilePostTwo = trk.RightLimitMilePost
                                End Select
                        End Select

                    Next
                    Select Case Me.Direction
                        Case "RIGHT"
                            If MilePostOne > MilePostTwo Then
                                blkInList.Direction = 1
                            Else
                                blkInList.Direction = 0
                            End If
                        Case "LEFT"
                            If MilePostOne > MilePostTwo Then
                                blkInList.Direction = 1
                            Else
                                blkInList.Direction = 0
                            End If
                        Case Else
                            Select Case Me.WorkDirection
                                Case "LEFT"
                                    If MilePostOne > MilePostTwo Then
                                        blkInList.Direction = 1
                                    Else
                                        blkInList.Direction = 0
                                    End If
                                Case "RIGHT"
                                    If MilePostOne > MilePostTwo Then
                                        blkInList.Direction = 1
                                    Else
                                        blkInList.Direction = 0
                                    End If
                                Case Else
                                    blkInList.Direction = 0
                            End Select
                    End Select

                    MilePostOne = 0
                    MilePostTwo = 0

                    'Get Speed Restrictions
                    For Each trk In blkInList.CompList
                        If trk.TrackTagLabels.Count > 0 Then
                            Dim tg As Tag
                            For Each tg In trk.TrackTagLabels
                                Dim sr As New SpeedRestriction()
                                Dim data() As String = tg.DataString.Split("|")
                                If TrainType = "PASSENGER" Then
                                    sr.Speed = CInt(data(0))
                                Else
                                    sr.Speed = CInt(data(5))
                                End If
                                sr.StartMp = CDec(data(1))
                                sr.EndMp = CDec(data(2))
                                blkInList.SpdRestList.Add(sr)
                            Next
                        End If
                    Next

                    'Get Joint Holders
                    If Me.AuthorityType = "DTC-INSPECTION" Then
                        Dim jnt As New JointHolder()
                        If Me.IssuedToTrain Then
                            jnt.HolderIDType = 1
                        End If
                        If Me.IssuedToTrain Then
                            Try
                                jnt.HolderID = CInt(Me.JointInspectionName)
                            Catch
                            End Try
                        End If
                        blkInList.JointList.Add(jnt)
                    Else

                        Dim JointList As New ArrayList()
                        For Each trk In blkInList.CompList
                            If trk.Authorities.Count > 0 Then
                                Dim auth As DTCAuthority
                                For Each auth In trk.Authorities
                                    If auth.AuthorityUID <> Me.AuthorityUID And auth.IssueTo <> Me.IssueTo Then
                                        If Not JointList.Contains(auth.AuthorityUID) Then
                                            JointList.Add(auth.AuthorityUID)
                                            Dim jnt As New JointHolder()
                                            If auth.IssuedToTrain Then
                                                jnt.HolderIDType = 1
                                            Else
                                                jnt.HolderIDType = 2
                                            End If
                                            If auth.IssuedToTrain Then
                                                jnt.HolderID = auth.IssueTo
                                            End If
                                            blkInList.JointList.Add(jnt)
                                        End If
                                    End If
                                Next
                            End If
                        Next
                    End If
                Next

                MessageToSend = MessageToSend & BlockList.Count.ToString & "|"

                For Each blkInList In BlockList
                    MessageToSend = MessageToSend & blkInList.SubID & ":" & blkInList.BlockID & ":" & blkInList.Direction & ":"
                    MessageToSend = MessageToSend & blkInList.Speed & ":" & blkInList.SpdRestList.Count & ":"
                    Dim SpeedMessage As String = ""
                    Dim sr As SpeedRestriction
                    For Each sr In blkInList.SpdRestList
                        SpeedMessage = SpeedMessage & sr.Speed & "-" & sr.StartMp & "-" & sr.EndMp & Chr(6)
                    Next
                    If SpeedMessage <> "" Then
                        MessageToSend = MessageToSend & SpeedMessage & ":"
                    End If
                    Dim DTCType As Integer

                    Select Case Me.AuthorityType
                        Case "DTC-PROCEED"
                            If Me.IssuedToTrain Then
                                DTCType = 1
                            End If

                        Case "DTC-WORK"
                            If Me.IssuedToTrain Then
                                DTCType = 3
                            End If

                        Case "DTC-JOINT"
                            DTCType = 4
                        Case "DTC-INSPECTION"
                            DTCType = 2
                    End Select

                    MessageToSend = MessageToSend & DTCType & ":"
                    MessageToSend = MessageToSend & blkInList.JointList.Count & ":"
                    Dim jt As JointHolder
                    Dim JointMessage As String = ""
                    For Each jt In blkInList.JointList
                        JointMessage = JointMessage & jt.HolderIDType & "-" & jt.HolderID & Chr(6)
                    Next
                    If JointMessage <> "" Then
                        MessageToSend = MessageToSend & JointMessage & ":"
                    End If
                    MessageToSend = MessageToSend & GetNumericStatus(Me) & ":"
                    If Not ReplaceAuthority Then
                        MessageToSend = MessageToSend & 0 & ":" & 0 & "|"
                    Else
                        MessageToSend = MessageToSend & blkInList.SubID & ":" & blkInList.BlockID & "|"
                    End If
                Next
                SystemEvent("CBTC DTC CREATE MESSAGE: " & MessageToSend)
                TMDS.NetworkMessages.CBTCMessages.SendDTCCreateMessage(MessageToSend, TMDS.GlobalDeclarations.gCadTransmitQueue)
                blkInList.JointList.Clear()
                blkInList.JointList = Nothing
                blkInList.SpdRestList.Clear()
                blkInList.SpdRestList = Nothing


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub SendStatusAuthorityElectronicMessage(Optional ByVal BlockToDelete As Int32 = 0)
            Try
                If Not Me.IssuedToTrain Then Exit Sub

                Dim MessageToSend As String = Me.IssueTo & "|"

                Dim comp As Track
                Dim BlockList As New ArrayList()
                Dim BlockID As Int32
                Dim LastAuthID As Int32
                Dim blk As SubAuthority = Nothing
                Dim auth As DTCAuthority = Nothing
                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If Trim(auth.IssueTo) = Trim(Me.IssueTo) Then
                        For Each comp In auth.ComponentsInSelection
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If comp.PTCBlockID <> BlockID Then
                                    BlockID = comp.PTCBlockID
                                    blk = New SubAuthority()
                                    blk.AuthID = auth.AuthorityNumber
                                    LastAuthID = auth.AuthorityNumber
                                    blk.BlockID = BlockID
                                    blk.SubID = comp.SubdivisionID

                                    If BlockToDelete = BlockID Then
                                        blk.StatusID = 15
                                    Else
                                        blk.StatusID = GetNumericBlockStatus(blk.BlockID, auth) 'GetNumericStatus(auth)
                                    End If

                                    BlockList.Add(blk)
                                    blk.CompList.Add(comp)
                                ElseIf comp.PTCBlockID = BlockID And LastAuthID <> auth.AuthorityNumber Then
                                    BlockID = comp.PTCBlockID
                                    blk = New SubAuthority()
                                    blk.AuthID = auth.AuthorityNumber
                                    LastAuthID = auth.AuthorityNumber
                                    blk.BlockID = BlockID
                                    blk.SubID = comp.SubdivisionID

                                    If BlockToDelete = BlockID Then
                                        blk.StatusID = 15
                                    Else
                                        blk.StatusID = GetNumericBlockStatus(blk.BlockID, auth) 'GetNumericStatus(auth)
                                    End If

                                    BlockList.Add(blk)
                                    blk.CompList.Add(comp)

                                ElseIf comp.PTCBlockID = BlockID And comp.PTCBlockID <> 0 Then
                                    blk.CompList.Add(comp)
                                End If
                            End If
                        Next

                    End If
                Next

                MessageToSend = MessageToSend & BlockList.Count.ToString & "|"

                Dim blkInList As SubAuthority
                For Each blkInList In BlockList
                    MessageToSend = MessageToSend & blkInList.AuthID & ":" & blkInList.SubID & ":" & blkInList.BlockID & ":" & blkInList.StatusID & "|"
                Next

                SystemEvent("CBTC DTC STATUS MESSAGE: " & MessageToSend)
                TMDS.NetworkMessages.CBTCMessages.SendDTCStatusMessage(MessageToSend, TMDS.GlobalDeclarations.gCadTransmitQueue)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

