        Public Function AddAuthorityToComponents() As Boolean
            Try
                Me.AuthDate = Now
                DispatcherName = gCurrentUser.Initials
                AuthorityDate = Now
                IssueTo = myTrain.IdentifingUnit

                Me.TrainSymbol = myTrain.Name
                If (optEnableARRCSpecificOptions) AndAlso myTrain IsNot Nothing AndAlso myTrain.myTrack IsNot Nothing AndAlso myTrain.myTrack.mySubdivision IsNot Nothing Then
                    AuthDate = GenerateTime(myTrain.myTrack.mySubdivision)
                Else
                    If Not Me.HasOKTime Then OKTime = Now
                End If
                If ComponentsInSelection.Count > 0 Then
                    Dim comp As Object
                    For Each comp In ComponentsInSelection
                        If comp.GetType.ToString = gTrackComponentName OrElse comp.GetType.ToString = gSwitchComponentName Then
                            If Not comp.OtherSplAuthorities.Contains(Me) Then
                                comp.OtherSplAuthorities.Add(Me)
                            End If
                            If optEnableMRSSpecificOptions Then
                                comp.SignalStatOnMe = Track.SignalStatus.SignalCleared
                                comp.TrafficDirection = Direction
                            End If
                            comp.UpdateStatus()
                        End If
                    Next
                Else
                    Return False
                End If
                gOtherSpecialAuthorityCollection.Add(Me)
                If optEnableLogTrainDelayFromPSS AndAlso Me.SubType = "PSS" AndAlso Not Me.RemoveStopTarget Then
                    LogTrainDelayFromPSS()
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Function RemoveAuthorityFromSystem(ByVal LeaveDirectionalTraffic As Boolean) As Boolean
            Try
                If Me.RemoveStopTarget Then
                    DoPSSPerformRelease(True)
                    If Me.SubType = "PSS" Then
                        Me.mySignal.IsStopTargetApplied = False
                        Me.mySignal.InvalidateSignal()
                    End If
                    Return True
                End If
                If ComponentsInSelection.Count > 0 Then
                    Dim comp As Object
                    For Each comp In ComponentsInSelection
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(comp, Track)
                            trk.OtherSplAuthorities.Remove(Me)
                            If Not LeaveDirectionalTraffic Or trk.OStype Then
                                trk.SignalStatOnMe = Track.SignalStatus.SignalAtStop
                                trk.TrafficDirection = ""
                            End If
                            trk.UpdateStatus()
                        ElseIf comp.GetType.ToString = gSwitchComponentName Then
                            comp.OtherSplAuthorities.Remove(Me)
                            comp.SignalStatOnMe = Track.SignalStatus.SignalAtStop
                            comp.TrafficDirection = ""
                            If optEnablePSSEMTAuthorityNoDeviceBlk Then
                                comp.BlockAbsolute = False
                                comp.DeviceBlocked = False
                            End If
                            comp.UpdateStatus()
                        ElseIf comp.GetType.ToString = gSignalComponentName Then
                            Dim sig As Signal = CType(comp, Signal)
                            sig.UpdateStatus()
                        End If
                    Next
                Else
                    Return False
                End If
                DoPSSPerformRelease(True)
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

