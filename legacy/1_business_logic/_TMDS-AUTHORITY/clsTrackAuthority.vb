                                If Not myCompList.Contains(comp) Then myCompList.Add(comp)
                            End If
                        Next
                        CurrentTrackName = ""

                    Else
                        CopyArrayCollection(myCompList, Me.Components)

                    End If

                End If


                For Each comp In myCompList 'Me.Components
                    If comp.GetType.ToString = gTrackComponentName AndAlso Not comp.TurnOutType Then
