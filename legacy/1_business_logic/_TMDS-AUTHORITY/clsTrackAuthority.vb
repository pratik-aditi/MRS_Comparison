#Region " PTC METHODS "

        Public Function CheckTrainPTCStatus(ByVal trn As TrainID) As Boolean
            Dim rtnStatus As Boolean = True
            TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(System.Windows.Forms.Cursors.WaitCursor)
            Try
                'If Not gPTCTerritoryExists Then Return False

                ''added as per Paul's request. 7002 not sent while rollup.
                ''7002 was not sent because train not found as  its been moved to next territory and removed from current one.
                ''so view train was created to send 7002
                If trn Is Nothing Then
                    If IsNothing(trn) Then
                        SystemEvent("NO TRAIN FOUND FOR " & Me.TrainSymbol & ". CREATING VIEW TRAIN ENTRY.")
                        trn = Me.PlaceViewTrainForPTC(Me.TrainSymbol)
                        If trn IsNot Nothing Then
                            SystemEvent("PTC VIEW TRAIN CREATED:" & Me.TrainSymbol & ".")
                            'trn = Me.TrainExistsForAuthority(Me)
                            'thisTrain = trn
                        End If
                    End If
                Else
                    'TMDS.NetworkMessages.PTCBOSAPIMessaging.SendLocomotiveRequestMessageStatus(trn, True)
                End If


                TMDS.NetworkMessages.PTCBOSAPIMessaging.SendLocomotiveRequestMessageStatus(trn, True)
                Dim Loco As MobileTracking.Locomotive = Me.FindLocomotive
                Dim StatusCheck As Boolean = True

                If Not Loco Is Nothing Then
                    Loco.RequestedStatusReceived = False
                End If
                Do While StatusCheck
                    If gPTCLinkDown Then
                        StatusCheck = False
                        rtnStatus = False
                        Exit Do
                    End If
                    If Loco Is Nothing Then
                        Loco = FindLocomotive()
                        If Not Loco Is Nothing Then
                            If Loco.RequestedStatusReceived Then
                                StatusCheck = False
                                Loco.RequestedStatusReceived = False
                                If Loco.CutOutState = True Then
                                    rtnStatus = False
                                    Exit Do
                                End If
                            End If
                        End If
                    Else
                        If Loco.RequestedStatusReceived Then
                            StatusCheck = False
                            Loco.RequestedStatusReceived = False
                            If Loco.CutOutState = True Then
                                rtnStatus = False
                                Exit Do
                            End If
                        End If
                    End If
                    Application.DoEvents()
                    Threading.Thread.Sleep(100)
                Loop

            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(System.Windows.Forms.Cursors.Default)
            End Try
            Return rtnStatus
        End Function

        Private Function PlaceViewTrainForPTC(ByVal TrainSymbol As String) As TrainID
            Try
                Dim trn As TrainID = TMDS.SystemUtilities.Utilities.RetrieveViewOnlyTrainIDFromSymbol(TrainSymbol)
                If Not IsNothing(trn) Then
                    If trn.PTCStatus = "ACTIVE" Then
                        trn.ApplyTrainAbbreviation(gTrainAbbreviation)
                        If Not DoesTrainExists(trn) Then
                            Dim SummItem As New SummaryItem("TRAIN", "POSITION", trn)
                            SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                            End SyncLock
                            TrainCollection.Add(trn)
                        End If
                        Return trn
                        'If Not TrainCollection.Contains(trn) Then
                        '    TrainCollection.Add(trn)
                        '    End If
                    End If
                    'Return True
                End If
                'Return False
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        Private Function DoesTrainExists(ByVal trnToCheck As TrainID) As Boolean
            Dim trn As TrainID = Nothing
            Try
                For Each trn In TrainCollection
                    If trn.Name = trnToCheck.Name And trn.IdentifingUnit = trnToCheck.IdentifingUnit Then
                        Return True
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False
        End Function

        Public Sub AutoRemoveAuthorityPTC()
            Try
                Dim MessageUID As String = Format(Now, "yyyyMMddHHmmssfff")
                Dim trn As TrainID = Me.TrainExistsForAuthority(Me)
                Dim TrainIsActivePTC As Boolean = True
                If Not IsNothing(trn) Then
                    If Me.PTCTypeAuthority Then
                        If trn.PTCStatus <> "ACTIVE" Then
                            TrainIsActivePTC = False
                            SystemEvent("RELEASE AUTHORITY:" & Me.AuthorityUID & ". TRAIN:" & trn.IdentifingUnit & " IS NOT PTC ACTIVE.")
                        End If
                    End If
                Else
                    TrainIsActivePTC = False
                    SystemEvent("TRAIN NOT FOUND FOR AUTHORITY:" & Me.AuthorityUID & ". TRAIN:" & Me.TrainSymbol)
                End If
                If TrainIsActivePTC Then
                    TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageVoid_TWC(Me, trn, MessageUID)
                    Me.PTCStatus = "RELEASE-SENT"
                    Me.SetPTCAuthorityFlasherStatus()
                    If Me.UpdateDatabaseWithPTCAuthorityStatus(Me.PTCStatus) Then
                        SystemEvent("PTCMessages-ProcessDeliveryConfirmation-UpdateDatabaseWithPTCTextualStatus-AUTHORITY:" & Me.AuthorityUID & " STATUS=" & Me.PTCStatus)
                    End If
                    Me.FlasherMode(True, True)
                    Me.PTCMarkedToBeVoidedElectronically = True
                    Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function TrainExistsForAuthority(ByVal auth As SFAuthority, Optional ByVal UseDirection As Boolean = True) As TrainID
            Dim trn As TrainID
            Try
                For Each trn In TrainCollection
                    If trn.IdentifingUnit = Trim(Mid(auth.IssueTo, 1, 10)) Then
                        Return trn
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Friend Sub RemoveSFAAuthorityPTC()
            Try
                If Me.RemoveSFAVIIAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                    If Me.RemoveAuthorityFromComponents(True) Then
                        TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(Me)
                        Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", Me)
                        SyncLock gSummaryAuthQueue.SyncRoot
                            gSummaryAuthQueue.Enqueue(SummItem)
                        End SyncLock
                        SystemEvent("AUTHORITY REMOVED FROM BOX ONE SELECTION - " & Me.AuthorityUID)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
