        Private Sub CheckToAddSidingTracksToRollUpList(ByRef theRollupList As ArrayList, ByVal ReleaseDirection As String, Optional ByVal theReleaseTrack As Track = Nothing)
            Dim AddedSwitch As Switch = Nothing
            Try
                Dim TrackList As ArrayList = theRollupList.Clone
                Dim comp As Object
                If theReleaseTrack IsNot Nothing AndAlso Not theReleaseTrack.TurnOutType AndAlso theReleaseTrack.OsComponentCollection IsNot Nothing AndAlso theReleaseTrack.OsComponentCollection.Count > 0 Then
                    Dim tempswlist As New ArrayList
                    tempswlist = TMDS.SystemUtilities.FetchData.GetMyOSSwitches(theReleaseTrack)
                    If tempswlist IsNot Nothing AndAlso tempswlist.Count > 0 Then
                        If tempswlist.Count = 1 Then
                            AddedSwitch = tempswlist(0)
                            If Not TrackList.Contains(tempswlist(0)) Then TrackList.Insert(0, tempswlist(0))
                        End If
                    End If
                End If
                For Each comp In TrackList
                    If comp.GetType.ToString = gSwitchComponentName Then
                        Dim sw As Switch = CType(comp, Switch)
                        If (sw.RightAltLink <> 0 AndAlso ReleaseDirection = "LEFT") OrElse (sw.LeftAltLink <> 0 AndAlso ReleaseDirection = "RIGHT") Then
                            Dim theSidingTrack As Track = TMDS.SystemUtilities.FetchData.FindSidingTrackFromSwitch(sw)
                            If Not IsNothing(theSidingTrack) Then
                                If Me.ComponentsInSelection.Contains(theSidingTrack) Then
                                    Dim SwIndex As Integer = theRollupList.IndexOf(sw)
                                    'theRollupList.Add(theSidingTrack)
                                    If AddedSwitch IsNot Nothing AndAlso AddedSwitch Is sw Then
                                        theRollupList.Insert(0, theSidingTrack)
                                    Else
                                        theRollupList.Insert(SwIndex, theSidingTrack)
                                    End If

                                    CheckToAddAllLikeTracks(theRollupList, theSidingTrack)
                                Else
                                    Dim auth As SFAuthority = FindMixModeAuthority(theSidingTrack)
                                    If Not IsNothing(auth) Then
                                        If auth.Components.Contains(theSidingTrack) Then
                                            Dim SwIndex As Integer = theRollupList.IndexOf(sw)
                                            'theRollupList.Add(theSidingTrack)
                                            theRollupList.Insert(SwIndex, theSidingTrack)
                                            CheckToAddAllLikeTracks(theRollupList, theSidingTrack)
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub AddOSComponentsToList(ByVal sw As Switch, ByRef theList As ArrayList)
            Try
                Dim comp As Object
                For Each comp In sw.OsComponentCollection
                    If comp.GetType.ToString = gTrackComponentName Then
                        If DoesContainMixModeAuthority(comp) Then
                            If Not theList.Contains(comp) Then
                                theList.Add(comp)
                            End If
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function DoesContainMixModeAuthority(ByVal theTrack As Track) As Boolean
            Try
                If theTrack.TrackAuthorities.Count = 0 Then Return False
                Dim auth As Object
                For Each auth In theTrack.TrackAuthorities
                    Select Case auth.GetType.ToString
                        Case "TMDS.TrackAuthority.TrackAuthority"
                            Dim ta As TrackAuthority = CType(auth, TrackAuthority)
                            If ta.AuthorityUID = Me.AuthorityUID Then
                                Return True
                            End If
                        Case "TMDS.TrackAuthority.SFAuthority"
                            Dim ta As SFAuthority = CType(auth, SFAuthority)
                            If ta.AuthorityUID = Me.AuthorityUID Then
                                Return True
                            End If
                    End Select
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Sub DoRemoveMixModeAuthorityFromComponents()
            Try
                Dim comp As Object
                For Each comp In MixModeRollupList
                    Dim auth As Object = FindMixModeAuthority(comp)
                    If Not IsNothing(auth) Then
                        If Not MixModeAuthorityList.Contains(auth) Then
                            MixModeAuthorityList.Add(auth)
                        End If
                        Select Case auth.GetType.ToString
                            Case "TMDS.TrackAuthority.TrackAuthority"
                                Dim a As TrackAuthority = CType(auth, TrackAuthority)
                                a.ComponentsInSelection.Remove(comp)
                                comp.TrackAuthorities.Remove(a)
                                comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                comp.UpdateStatus()
                                GenerateScripts(a, SimulatorScriptAction.SFAROLLUP)
                            Case "TMDS.TrackAuthority.SFAuthority"
                                Dim a As SFAuthority = CType(auth, SFAuthority)
                                a.Components.Remove(comp)
                                comp.TrackAuthorities.Remove(a)
                                comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                comp.UpdateStatus()
                                comp.InitAuthorityNumbers()
                                a.UpdateDatabaseWithRollUpEvent()
                                a.CreateReducedLimitsVerbiage()
                                GenerateScripts(a, SimulatorScriptAction.SFAROLLUP)
                        End Select
                    End If
                Next

                Dim ta As Object
                For Each ta In MixModeAuthorityList
                    Select Case ta.GetType.ToString
                        Case "TMDS.TrackAuthority.TrackAuthority"
                            Dim a As TrackAuthority = CType(ta, TrackAuthority)
                            If a.ComponentsInSelection.Count = 0 Then
                                DoPerformReleaseMixModeAuthority(a)
                            End If
                        Case "TMDS.TrackAuthority.SFAuthority"
                            Dim a As SFAuthority = CType(ta, SFAuthority)
                            If a.Components.Count = 0 Then
                                DoPerformReleaseMixModeAuthority(a)
                            End If
                    End Select
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindMixModeAuthority(ByVal comp As Object) As Object
            Try
                Select Case comp.GetType.ToString
                    Case gTrackComponentName
                        Dim trk As Track = CType(comp, Track)
                        If trk.TrackAuthorities.Count > 0 Then
                            Dim auth As Object
                            For Each auth In trk.TrackAuthorities
                                Select Case auth.GetType.ToString
                                    Case "TMDS.TrackAuthority.TrackAuthority"
                                        Dim t As TrackAuthority = CType(auth, TrackAuthority)
                                        If t.AuthorityUID = Me.AuthorityUID Then
                                            Return t
                                        End If
                                    Case "TMDS.TrackAuthority.SFAuthority"
                                        Dim t As SFAuthority = CType(auth, SFAuthority)
                                        If t.AuthorityUID = Me.AuthorityUID Then
                                            Return t
                                        End If
                                End Select
                            Next
                        End If
                    Case gSwitchComponentName
                        Dim sw As Switch = CType(comp, Switch)
                        If sw.TrackAuthorities.Count > 0 Then
                            Dim auth As Object
                            For Each auth In sw.TrackAuthorities
                                Select Case auth.GetType.ToString
                                    Case "TMDS.TrackAuthority.TrackAuthority"
                                        Dim t As TrackAuthority = CType(auth, TrackAuthority)
                                        If t.AuthorityUID = Me.AuthorityUID Then
                                            Return t
                                        End If
                                    Case "TMDS.TrackAuthority.SFAuthority"
                                        Dim t As SFAuthority = CType(auth, SFAuthority)
                                        If t.AuthorityUID = Me.AuthorityUID Then
                                            Return t
                                        End If
                                End Select
                            Next
                        End If
                End Select
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Sub DoPerformReleaseMixModeAuthority(ByVal auth As Object)
            Try
                Select Case auth.GetType.ToString
                    Case "TMDS.TrackAuthority.TrackAuthority"
                        Dim a As TrackAuthority = CType(auth, TrackAuthority)
                        If a.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                            If a.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                GenerateScripts(a, SimulatorScriptAction.SFAREPORTCLEAR)
                                a.RemoveTrackAuthFromRemoteLinks()
                                OtherTrackAuthorities.Remove(a)
                                Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", a)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock
                            End If
                            a.RemoveBlockingToRemoteLinkTrack(a.ComponentsInSelection)
                        End If

                    Case "TMDS.TrackAuthority.SFAuthority"
                        Dim a As SFAuthority = CType(auth, SFAuthority)

                        If a.RemoveSFAVIIAuthorityFromDB(Nothing) Then
                            If a.RemoveAuthorityFromComponents(False) Then
                                GenerateScripts(a, SimulatorScriptAction.SFAREPORTCLEAR)
                                TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(a)
                                Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", a)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock
                            End If
                        End If
                End Select


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Public Function RollUpBRCAuthority(ByRef TrackSelected As Track, ByVal ReleaseDirection As String) As Boolean
            Dim EndOfWarrantFound As Boolean = False
            Dim NextComp As Object = Nothing
            Dim CurrentComp As Object = Nothing
            Dim warr As TrackAuthority = Nothing
            Dim LeftLimits As String = String.Empty
            Dim RightLimits As String = String.Empty
            Dim RollUpEventMessage As String = String.Empty
            Dim comp As Object
            Dim TrackNameList As New ArrayList()
            Dim trackString As String = String.Empty

            If TrackSelected.NonTransverable Then
                Return False
            End If

            RollUpList.Clear()

            Try
                Dim ReportTime As String

                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.TimeZone <> "" Then
                            CurrentTimeZone = Mid(comp.TimeZone, 1, 1)
                            Exit For
                        End If
                    End If
                Next



                Select Case CurrentTimeZone
                    Case "E"
                        ReportTime = Format(Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor)), "HH:mm")
                    Case "M"
                        ReportTime = Format(Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor)), "HH:mm")
                    Case "P"
                        ReportTime = Format(Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor)), "HH:mm")
                    Case Else
                        ReportTime = Format(Now.AddHours(CDbl(gThisWorkstationTimeFactor)), "HH:mm")

                        'Case "M"
                        '    ReportTime = Format(Now.AddHours(-1), "HH:mm")
                        'Case "P"
                        '    ReportTime = Format(Now.AddHours(-2), "HH:mm")
                        'Case Else
                        '    ReportTime = Format(Now, "HH:mm")
                End Select



                Dim FirstSelectedTrack As Track = TrackSelected


                CurrentComp = TrackSelected

                CurrentComp = TrackSelected
                Dim TopPoint As Int32
                If TrackSelected.Top + 600 < TrackSelected.CurrentDrawingForm.Height Then
                    TopPoint = TrackSelected.Top + 100
                Else
                    TopPoint = 150
                End If
                Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + TrackSelected.CurrentDrawingForm.Width / 2 - 100, TopPoint)



                RollUpList.Clear()
                BRCRollUpList(ReleaseDirection, RollUpList, TrackSelected)

                For Each comp In RollUpList
                    If Not TrackNameList.Contains(comp.TrackName) Then
                        TrackNameList.Add(comp.TrackName)
                    End If
                Next


                SelectionTimer.Enabled = True

                'Assign limits of roll up
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()

                If RollUpList.Count > 0 Then

                    Dim trk1 As Object = Me.FindFirstTrackInList(RollUpList) 'RollUpList.Item(0)
                    Dim trk2 As Object = Me.FindLastTrackInList(RollUpList) 'RollUpList.Item(RollUpList.Count - 1)

                    If ReleaseDirection = "RIGHT" Then
                        RightLimits = trk1.RightLimitName
                        LeftLimits = trk2.LeftLimitName
                    Else
                        RightLimits = trk1.LeftLimitName
                        LeftLimits = trk2.RightLimitName
                    End If
                    Dim trkname As String = String.Empty
                    Dim trkIndex As Integer

                    For Each trkname In TrackNameList

                        If trkIndex = 0 Then
                            trackString = "ON " & " " & trkname
                        Else
                            trackString = trackString & " AND " & trkname
                        End If

                        trkIndex = 1
                    Next
                    If optUseReleaseVerbiageForKCS Then
                        MessageList.Add(Me.IssueTo)
                        MessageList.Add("IS RELEASING THAT PORTION OF TRACK & TIME AUTHORITY NUMBER " & Me.AuthorityUID)
                        MessageList.Add(optAuthString8 & LeftLimits & Space(1) & optAuthString9 & RightLimits)
                        MessageList.Add(trackString)
                        MessageList.Add("AT    " & ReportTime & Space(5) & Format(Now, optSystemDateTimeString) & "    (" & TMDS.GlobalDeclarations.gCurrentUser.Initials & ")")
                        MessageList.Add("")
                    Else
                        MessageList.Add(Me.IssueTo)
                        MessageList.Add("RELEASING PORTION OF TRACK & TIME AUTHORITY NUMBER: " & Me.AuthorityUID)
                        MessageList.Add(optAuthString8 & LeftLimits & Space(1) & optAuthString9 & RightLimits)
                        MessageList.Add(trackString)
                        If optUseSingleFormAuthorityVersionMRL Then
                            MessageList.Add(optAuthString10 & ReportTime)
                            MessageList.Add("")
                            MessageList.Add("IS THAT CORRECT, OVER?")
                        Else
                            MessageList.Add(optAuthString10 & "    'TIME'" & ReportTime)
                            MessageList.Add("")
                            MessageList.Add(optAuthString11)
                            MessageList.Add("")
                        End If
                    End If

                    '    MessageList.Add(Me.IssueTo)
                    'MessageList.Add(optAuthString7 & Me.AuthorityUID)
                    'MessageList.Add(optAuthString8 & LeftLimits & Space(1) & optAuthString9 & RightLimits)
                    'MessageList.Add(trackString)


                Else
                    Dim ErrorMessage As String = "TRACK AUTHORITY " & Me.AuthorityUID & " Invalid RollUp selection!"
                    MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                    ClearSelection()
                    MessageList = Nothing
                    Return False
                End If

                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = TrackSelected.CurrentDrawingForm
                LaunchPoint.Y = LaunchPoint.Y + 30
                frmMessageBox.SetMessage(MessageList, optAuthString12 & " " & Me.AuthorityUID, True, LaunchPoint, Nothing, False, False, Nothing, Nothing, False, False, False, optUseReadRepeatMessageBoxOnAuthorityRelease)
                frmMessageBox.ShowDialog()
                If frmMessageBox.FormFeedBack = 6 Then
                    SystemEvent(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO ROLLUP CONFIRMATION")
                    Dim LongMessage As New ArrayList()
                    If optEnableThirdPromptForReportClear Then
                        Dim frmMessageBox3 As New frmMessageBox()
                        LongMessage = New ArrayList()
                        'LongMessage.Add("(" & Me.AuthorityUID & ") " & optReportClear_IsReleasedAT & " (" & ReportTime & ") " & "," & " Over. Continue with release?")
                        'LongMessage.Add("")
                        LongMessage.Add(Me.IssueTo)
                        LongMessage.Add(optAuthString7 & Me.AuthorityUID)
                        LongMessage.Add(optAuthString8 & LeftLimits & Space(1) & optAuthString9 & RightLimits)
                        LongMessage.Add(trackString)
                        frmMessageBox3.SetMessage(LongMessage, "ROLLUP ACKNOWLEDGEMENT" & " - " & Me.AuthorityUID, True, LaunchPoint)
                        frmMessageBox3.ShowDialog()
                        If frmMessageBox3.FormFeedBack <> 6 Then
                            SystemEvent(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED - NO TO THE ROLLUP ACKNOWLEDGEMENT DIALOG:" & Me.AuthorityNumber)
                            ClearSelection()
                            frmMessageBox.Dispose()
                            frmMessageBox = Nothing
                            Exit Function
                        Else
                            SystemEvent(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED - YES TO THE ROLLUP ACKNOWLEDGEMENT DIALOG:" & Me.AuthorityNumber)
                        End If
                    End If


                    'RollUpEventMessage = "TIME:" & Now & vbCrLf
                    RollUpEventMessage = RollUpEventMessage & LeftLimits & "|" & RightLimits & "|"
                    For Each comp In RollUpList
                        RollUpEventMessage = RollUpEventMessage & comp.GUID & "-"
                    Next
                    SystemEvent(Me.AuthorityUID & " ROLL UP EVENT DATA:" & RollUpEventMessage)
                    Me.RollUpEvents.Add(RollUpEventMessage)
                    Me.CurrentRollUpEvent = RollUpEventMessage



                    'REMOVE THE AUHTORITY FROM THE ROLLED UP TRACK PIECES AND REDRAW ANY EXISTING IDS.
                    For Each comp In RollUpList
                        Me.ComponentsInSelection.Remove(comp)
                        comp.TrackAuthorities.Remove(Me)
                        comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                        comp.UpdateStatus()
                    Next

                    Try
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If comp.IsRemoteTrack Then
                                    comp.myRemoteTrack.SendRemoveTrackAuthority(Me.AuthorityUID)
                                End If
                            End If
                        Next

                    Catch ex As Exception
                        SystemException(ex.ToString)
                    End Try

                    Dim NewLimits As String
                    If ReleaseDirection = "RIGHT" Then
                        NewLimits = RightLimits
                    Else
                        NewLimits = RightLimits
                    End If

                    Me.UpdateDatabaseWithRollUpEvent()
                    Me.CreateReducedLimitsVerbiage()

                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock

                    Dim SummItem1 As New SummaryItem("AUTHORITY", "ADD", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If

                frmMessageBox.Dispose()
                frmMessageBox = Nothing
                ClearSelection()

            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSelection()
                Dim ErrorMessage As String = "TRACK AUTHORITY " & Me.AuthorityUID & " Not Rolled Up Properly! CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
            End Try
        End Function

        Private Sub IncludeLikeTracksForRollup(ByRef RollUpList As ArrayList)
            Try
                Dim comp As Object
                Dim CompInList As Object
                Dim RollUpListTemp As ArrayList = RollUpList.Clone
                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        For Each CompInList In RollUpListTemp
                            If CompInList.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If CompInList.LeftLimitName = comp.LeftLimitName And CompInList.RightLimitName = comp.RightLimitName And CompInList.TrackName <> comp.TrackName Then
                                    If Not RollUpList.Contains(comp) Then
                                        RollUpList.Insert(RollUpList.IndexOf(CompInList), comp)
                                        Dim swLeft As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(comp.LeftLink)
                                        Dim swRight As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(comp.RightLink)
                                        If Not IsNothing(swLeft) Then
                                            If Not RollUpList.Contains(swLeft) Then RollUpList.Insert(RollUpList.IndexOf(CompInList), swLeft)
                                        End If
                                        If Not IsNothing(swRight) Then
                                            If Not RollUpList.Contains(swRight) Then RollUpList.Insert(RollUpList.IndexOf(CompInList), swRight)
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub IncludeLikeContinousTracksForRollup(ByRef RollUpList As ArrayList)
            Try
                Dim comp As Object
                Dim CompInList As Object
                Dim RollUpClone As ArrayList = RollUpList.Clone
                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        For Each CompInList In RollUpClone
                            If CompInList.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim trk As Track = CType(comp, Track)
                                If CompInList.LeftLimitName = comp.LeftLimitName And CompInList.RightLimitName = comp.RightLimitName And CompInList.TrackName = comp.TrackName Then
                                    If Not RollUpList.Contains(comp) Then
                                        RollUpList.Add(comp)
                                        If trk.OStype Then
                                            Dim OsComp As Object
                                            If Not IsNothing(trk.OsComponentCollection) Then
                                                For Each OsComp In trk.OsComponentCollection
                                                    If Not RollUpList.Contains(OsComp) Then
                                                        RollUpList.Add(OsComp)
                                                    End If
                                                Next
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindAuthority(ByVal comp As Object) As TrackAuthority
            Try
                Dim auth As TrackAuthority
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.TrackAuthorities.Count > 0 Then
                        For Each auth In trk.TrackAuthorities
                            If auth.AuthorityUID = Me.AuthorityUID Then
                                Return auth
                            End If
                        Next
                    Else
                        Return Nothing
                    End If
                ElseIf comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.TrackAuthorities.Count > 0 Then
                        For Each auth In sw.TrackAuthorities
                            If auth.AuthorityUID = Me.AuthorityUID Then
                                Return auth
                            End If
                        Next
                    Else
                        Return Nothing
                    End If
                End If
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

