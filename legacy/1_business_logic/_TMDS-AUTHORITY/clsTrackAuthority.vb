        Public Sub GetTacticalRoutesAndBindWithTrain()
            Try
                If IsNothing(myTrain) Then
                    AuthorityEventLog("GetTacticalRoutesAndBindWithTrain-NO TRAIN-FAILED")
                    Exit Sub
                End If
                myTrain.myTacticalRoutes.Clear()

                Dim routes() As String = Me.TacticalRouteList.Split(";")
                Dim r As String
                For Each r In routes
                    Dim tr As New TacticalRoute
                    If tr.GetRoute(myTrain, r) Then
                        myTrain.myTacticalRoutes.Add(tr)
                    Else
                        AuthorityEventLog("GetTacticalRoutesAndBindWithTrain-GetRoute-FAILED")
                    End If
                Next
                Dim t As TacticalRoute
                For Each t In myTrain.myTacticalRoutes
                    If t.myStatus = "STORED ROUTE" Then
                        Dim sr As StoredRoute
                        For Each sr In t.mySignalRoute.EntrySignal.myControlPoint.StoredRoutes
                            If sr.RouteGUID = t.myStoredRouteUID Then
                                sr.myTacticalRoute = t
                                Exit For
                            End If
                        Next
                    End If
                Next

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

