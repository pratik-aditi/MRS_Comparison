        Public Function CreateRestrictionAuthoritySegmentsForPTC() As String
            Dim tmpPTCSegments As String = ""
            Dim RestrictionSeg As New StringBuilder
            Dim RSConst As String = ";JS;0;|"
            Dim RsDirectional As String = "TRUE"
            Try
                If Not Me.IsTrackWarrantEnforcementEnabled Then Return String.Empty
                If Me.PTCAuthoritySegments Is Nothing Then Return String.Empty
                If Not String.IsNullOrEmpty(Me.PTCAuthoritySegments) AndAlso Me.PTCAuthoritySegments.Trim <> "" Then
                    Dim PTCSeg() As String = Me.PTCAuthoritySegments.Split("|")
                    Dim S As String
                    For Each S In PTCSeg
                        If S.Trim <> "" Then
                            Dim Datastr() As String = S.Split(";") 'S.Trim & ";JU;0;|"
                            Dim UniqueID As String = Datastr(0)
                            Dim FromMP As String = Datastr(2)
                            Dim ToMP As String = Datastr(4)
                            Dim Prefix As String = Datastr(5)
                            Dim Suffix As String = Datastr(6)
                            Dim TrkName As String = Datastr(7)
                            Dim SubUID As String = Datastr(8)
                            With RestrictionSeg
                                .Append(UniqueID & ";") ' AuthUID or PTCID
                                .Append("" & ";") ' SubName
                                .Append(FromMP.Trim & ";")
                                .Append(Suffix.Trim & ";")
                                .Append(ToMP & ";")
                                .Append(Prefix.Trim & ";")
                                .Append(Suffix.Trim & ";")
                                .Append(TrkName & ";")
                                .Append(SubUID & ";")
                                .Append(RsDirectional)
                                .Append(RSConst)
                            End With

                        End If
                    Next
                    Return RestrictionSeg.ToString
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
            Return String.Empty
        End Function

