                                    End If
                                ElseIf NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If (NextComp.LeftLimitName = TrackSelected.LeftLimitName And NextComp.RightLimitName = TrackSelected.RightLimitName) Then
                                        'do nothing
                                        'Beep()
                                        Dim g As Int32 = NextComp.GUID
                                        'Beep()
                                    Else
                                        Dim trk As Track = CType(NextComp, Track)
                                        If Not RollUpList.Contains(trk) Then
                                            RollUpList.Add(NextComp)
                                        End If
                                    End If
                                End If

                            End If
                            CurrentComp = NextComp
                            '*****

                            If CurrentComp.RightLink <> 0 Then
                                If CurrentComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(CurrentComp, Switch)
                                    If optEnableARRCSpecificOptions AndAlso sw.TypeOfSwitch.ToUpper.Trim = "DERAIL" Then
                                        LastComp = NextComp
                                        If Flip Then
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.RightLink)
                                        End If
                                    Else
                                        If Not Flip Then
                                            NextComp = FoundExitTrackOfRollUpOutOfSwitch(sw, Me, "RIGHT", RollUpList, LastComp)
                                        Else
                                            NextComp = FoundExitTrackOfRollUpOutOfSwitch(sw, Me, "LEFT", RollUpList, LastComp)
                                        End If
                                        If IsNothing(NextComp) Then

                                            For Each comp In sw.OsComponentCollection
                                                If comp.Name = TrackSelected.Name And comp.StationNumber = TrackSelected.StationNumber Then
                                                    Exit While
                                                End If

                                                If Not RollUpList.Contains(comp) Then
                                                    RollUpList.Add(comp)
                                                End If
                                            Next
                                            Exit While
                                        ElseIf optApplyConfigurationForKCT AndAlso Not TrackSelectedOsCompList.Contains(sw) Then
                                            For Each comp In sw.OsComponentCollection
                                                If Not RollUpList.Contains(comp) Then
                                                    RollUpList.Add(comp)
                                                End If
                                            Next

                                        End If
                                    End If
                                Else
                                    LastComp = NextComp
                                    If Flip Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.RightLink)
                                    End If
                                End If

                                If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    ' do nothing
                                ElseIf FirstSelectedTrack.TrackName = NextComp.TrackName And FirstSelectedTrack.StationNumber = NextComp.StationNumber Then
                                    'do nothing
                                Else
                                    If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        Dim trk As Track = CType(NextComp, Track)
                                        If trk.OStype Then
                                            Dim OtherLikeComponenets As ArrayList = trk.OsComponentCollection '= NextComp.FindOsTracks
                                            If Not OtherLikeComponenets Is Nothing Then
                                                Dim compon As Object
                                                For Each compon In OtherLikeComponenets
                                                    If compon.TrackAuthorities.Count > 0 Then
                                                        Dim Nextwarr As TrackAuthority
                                                        For Each Nextwarr In compon.TrackAuthorities
                                                            If Nextwarr.AuthorityUID = Me.AuthorityUID Then
                                                                If Not RollUpList.Contains(compon) Then
                                                                    RollUpList.Add(compon)
                                                                End If
                                                            End If
                                                        Next
                                                    End If
                                                Next
                                            End If
                                        End If
                                    End If

                                    'If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    '    Dim OtherLikeComponenets As ArrayList = NextComp.FindOsTracks
                                    '    If Not OtherLikeComponenets Is Nothing Then
                                    '        Dim compon As Object
                                    '        For Each compon In OtherLikeComponenets
                                    '            If compon.TrackAuthorities.Count > 0 Then
                                    '                Dim Nextwarr As TrackAuthority
                                    '                For Each Nextwarr In compon.TrackAuthorities
                                    '                    If Nextwarr.AuthorityUID = Me.AuthorityUID Then
                                    '                        If Not RollUpList.Contains(compon) Then
                                    '                            RollUpList.Add(compon)
                                    '                        End If
                                    '                    End If
                                    '                Next
                                    '            End If
                                    '        Next
                                    '    End If
                                    'End If
                                End If
                            Else
                                Exit While
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                            Dim rr As RRXING = CType(NextComp, RRXING)
                            If rr.TrackName = TrackSelected.TrackName And TrackSelected.OStype Then
                                'do nothing 
                            Else

                                Dim TrackList As ArrayList = rr.FindAllTracksConnected
                                If Not IsNothing(TrackList) Then
                                    Dim compInList As Object
                                    For Each compInList In TrackList
                                        If compInList.TrackAuthorities.Count > 0 Then
                                            Dim Nextwarr As TrackAuthority
                                            For Each Nextwarr In compInList.TrackAuthorities
                                                If Nextwarr.AuthorityUID = Me.AuthorityUID Then
                                                    If Not RollUpList.Contains(compInList) Then
                                                        RollUpList.Add(compInList)
                                                    End If
                                                End If
                                            Next
                                        End If
                                    Next
                                End If
                            End If
                            If Flip Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                            Flip = True
                            Dim ff As FlipFlop = CType(NextComp, FlipFlop)
                            NextComp = ff.FindExitComponent(LastComp.GUID)
                            'NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        Else
                            If Flip Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If

                        End If

                        LoopControl = LoopControl + 1
                        If LoopControl = 150 Then
                            NextComp = Nothing
                            ClearSelection()
                            Return False
                        End If
                    End While
                    NextComp = Nothing
                    CurrentComp = Nothing
                End If

                '  IncludeLikeTracksForRollup(RollUpList)
                If RollUpList.Count = 0 Then
                    If optEnableARRCSpecificOptions Then
                        If Me.MixModeAuthorityType Then
                            CheckToAddOtherAuthorityToRollUpList(RollUpList, ReleaseDirection, TrackSelected)
                        End If
                    End If
                End If

                If RollUpList.Count = 0 Then

                    If Not IsNothing(TrackSelected.OsComponentCollection) Then
                        Dim compInList As Object
                        For Each compInList In TrackSelected.OsComponentCollection
                            If Not RollUpList.Contains(compInList) Then
                                RollUpList.Add(compInList)
                            End If
                        Next
                    End If
                    If Not RollUpList.Contains(TrackSelected) Then
                        RollUpList.Add(TrackSelected)
                    End If
                    Me.IncludeLikeContinousTracksForRollup(RollUpList)

                    Dim TerminateRollup As Boolean = True
                    If Me.ComponentsInSelection.Count = RollUpList.Count Then
                        Dim compToChk As Object
                        For Each compToChk In RollUpList
                            If Not Me.ComponentsInSelection.Contains(compToChk) Then
                                TerminateRollup = False
                                Exit For
                            End If
                        Next
                    End If
                    If TerminateRollup Then
                        If optEnableARRCSpecificOptions Then
                            gHistoryMessage = "AUTHORITY NO: " & Me.AuthorityUID & vbCrLf & " INVALID ROLLUP SEGMENT(S) OR DIRECTION SELECTED."
                            MessageBox.Show(gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            SystemEvent(gHistoryMessage)
                        End If
                        ClearSelection()
                        Return False
                    End If
                Else
                    'Commented this since the TWC components were add in the middle of CTC. 
                    'If optEnableARRCSpecificOptions AndAlso Me.MixModeAuthorityType Then
                    '    CheckToAddSidingTracksToRollUpList(RollUpList, ReleaseDirection)
                    '    CheckToAddOtherAuthorityToRollUpList(RollUpList, ReleaseDirection, TrackSelected)
                    'End If
                End If
                If optEnableARRCSpecificOptions Then
                    CheckToAddSidingTracksToRollUpList(RollUpList, ReleaseDirection)
                End If
                If optEnableARRCSpecificOptions AndAlso Me.MixModeAuthorityType Then
                    CheckToAddOtherAuthorityToRollUpList(RollUpList, ReleaseDirection, TrackSelected)
                End If
                Dim TempCompArrList As New ArrayList
                If optEnableARRCSpecificOptions Then ' OrElse optApplyConfigurationForKCT
                    FindLikeComponents(TrackSelectedOsCompList, TrackSelectedOsCompList)
                    CopyArrayCollection(TempCompArrList, RollUpList)
                    For Each comp In TempCompArrList
                        If TrackSelectedOsCompList.Contains(comp) Then
                            RollUpList.Remove(comp)
                            'gHistoryMessage = "AUTHORITY NO: " & Me.AuthorityUID & vbCrLf & " INVALID ROLLUP SEGMENT(S) OR DIRECTION SELECTED."
                            'MessageBox.Show(gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            'SystemEvent(gHistoryMessage)
                            'ClearSelection()
                            'Return False
                        End If
                    Next
                End If






                Dim TempTWCArrList As New ArrayList
                If optEnableARRCSpecificOptions AndAlso Me.MixModeAuthorityType Then
                    If RollUpList IsNot Nothing AndAlso RollUpList.Count > 0 Then
                        For Each comp In RollUpList
                            Select Case comp.GetType.ToString
                                Case gTrackComponentName, gSwitchComponentName
                                    If comp.AUTHORITYTYPE = "TWC" Then
                                        If Not TempTWCArrList.Contains(comp) Then TempTWCArrList.Add(comp)
                                    End If
                            End Select
                        Next
                    End If
                End If


                For Each comp In RollUpList
                    If Not TrackNameList.Contains(comp.TrackName) Then
                        TrackNameList.Add(comp.TrackName)
                    End If
                Next


                SelectionTimer.Enabled = True

                'Assign limits of roll up
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()




                If RollUpList.Count > 0 Then

                    Dim trk1 As Object = Me.FindFirstTrackInList(RollUpList) 'RollUpList.Item(0)
                    Dim trk2 As Object = Me.FindLastTrackInList(RollUpList) 'RollUpList.Item(RollUpList.Count - 1)
                    Dim UseFlopDirection As Boolean = False

                    If optEnableARRCSpecificOptions AndAlso Me.MixModeAuthorityType AndAlso (trk2.AuthorityType = "TWC" OrElse trk1.AuthorityType = "TWC") Then
                        Dim LObj As Object = Nothing
                        Dim RObj As Object = Nothing

                        Dim TWCConnectedRight As Boolean
                        Dim TWCConnectedLeft As Boolean
                        Dim TWCtrk1 As Object = Me.FindFirstTrackInList(TempTWCArrList)
                        Dim TWCtrk2 As Object = Me.FindFirstTrackInList(TempTWCArrList)
                        If TWCtrk1 IsNot Nothing Then LObj = FindCompFromGUID(TWCtrk1.LeftLink)
                        If TWCtrk2 IsNot Nothing Then RObj = FindCompFromGUID(TWCtrk2.RightLink)
                        For i As Integer = 1 To 10
                            If LObj Is Nothing Then
                                Exit For
                            ElseIf LObj IsNot Nothing AndAlso LObj.GetType.ToString = gTrackComponentName Then
                                If LObj.AuthorityType = "CTC" Then
                                    If RollUpList.Contains(LObj) Then
                                        TWCConnectedLeft = True
                                    End If
                                    Exit For
                                End If
                            Else
                                LObj = FindCompFromGUID(LObj.LeftLink)
                            End If
                        Next
                        If Not TWCConnectedLeft Then
                            For i As Integer = 1 To 10
                                If RObj Is Nothing Then
                                    Exit For
                                ElseIf RObj IsNot Nothing AndAlso RObj.GetType.ToString = gTrackComponentName Then
                                    If RObj.AuthorityType = "CTC" Then
                                        If RollUpList.Contains(RObj) Then
                                            TWCConnectedRight = True
                                        End If
                                        Exit For
                                    End If
                                Else
                                    RObj = FindCompFromGUID(RObj.RightLink)
                                End If
                            Next
                        End If
                        If TWCConnectedLeft OrElse TWCConnectedRight Then
                            UseFlopDirection = True
                            If TWCConnectedRight Then
                                If ReleaseDirection = "RIGHT" Then
                                    If trk1.AuthorityType = "TWC" Then
                                        RightLimits = trk1.LeftLimitName
                                        LeftLimits = trk2.LeftLimitName ' CTC track 
                                    ElseIf trk2.AuthorityType = "TWC" Then
                                        RightLimits = trk1.RightLimitName ' CTC Track
                                        LeftLimits = trk2.LeftLimitName
                                    End If
                                Else
                                    If trk1.AuthorityType = "TWC" Then
                                        RightLimits = trk1.RightLimitName
                                        LeftLimits = trk2.RightLimitName ' CTC track 
                                    ElseIf trk2.AuthorityType = "TWC" Then
                                        RightLimits = trk1.LeftLimitName ' CTC Track
                                        LeftLimits = trk2.LeftLimitName
                                    End If
                                End If
                            Else
                                If ReleaseDirection = "RIGHT" Then
                                    If trk1.AuthorityType = "TWC" Then
                                        RightLimits = trk1.RightLimitName
                                        LeftLimits = trk2.LeftLimitName ' CTC track 
                                    ElseIf trk2.AuthorityType = "TWC" Then
                                        RightLimits = trk1.RightLimitName ' CTC Track
                                        LeftLimits = trk2.RightLimitName
                                    End If
                                Else
                                    If trk1.AuthorityType = "TWC" Then
                                        RightLimits = trk1.LeftLimitName
                                        LeftLimits = trk2.RightLimitName ' CTC track 
                                    ElseIf trk2.AuthorityType = "TWC" Then
                                        RightLimits = trk1.LeftLimitName ' CTC Track
                                        LeftLimits = trk2.RightLimitName
                                    End If
                                End If
                            End If
                        End If
                    End If

                    If UseFlopDirection Then
                    Else
                        If ReleaseDirection = "RIGHT" Then
                            RightLimits = trk1.RightLimitName
                            LeftLimits = trk2.LeftLimitName
                        Else
                            RightLimits = trk1.LeftLimitName
                            LeftLimits = trk2.RightLimitName
                        End If
                    End If

                    'If ReleaseDirection = "RIGHT" Then
                    '    RightLimits = trk1.RightLimitName
                    '    LeftLimits = trk2.LeftLimitName
                    'Else
                    '    RightLimits = trk1.LeftLimitName
                    '    LeftLimits = trk2.RightLimitName
                    'End If
                    Dim trkname As String = String.Empty
                    Dim trkIndex As Integer
                    Dim trackString As String = String.Empty
                    For Each trkname In TrackNameList

                        If trkIndex = 0 Then
                            trackString = optAuthString13 & " " & trkname & optAuthString14
                        Else
                            trackString = trackString & optAuthString15 & trkname & optAuthString16
                        End If
                        trkIndex = 1
                    Next
                    If optUseReleaseVerbiageForKCS Then
                        MessageList.Add(Me.IssueTo)
                        MessageList.Add("IS RELEASING THAT PORTION OF TRACK & TIME AUTHORITY NUMBER " & Me.AuthorityUID)
                        MessageList.Add(optAuthString8 & LeftLimits & Space(1) & optAuthString9 & RightLimits)
                        MessageList.Add(trackString)
                        MessageList.Add("AT    " & ReportTime & Space(5) & Format(Now, optSystemDateTimeString) & "    (" & TMDS.GlobalDeclarations.gCurrentUser.Initials & ")")
                        MessageList.Add("")
                    Else
                        MessageList.Add(Me.IssueTo)
                        If Me.MixModeAuthorityType Then
                            MessageList.Add(optRollUpAuthorityString26 & Me.AuthorityUID)
                        Else
                            MessageList.Add(optAuthString7 & Me.AuthorityUID)
                        End If
                        MessageList.Add(optAuthString8 & LeftLimits & Space(1) & optAuthString9 & RightLimits)
                        MessageList.Add(trackString)
                        If optUseSingleFormAuthorityVersionMRL Then
                            MessageList.Add(optAuthString10 & ReportTime)
                            MessageList.Add("")
                            MessageList.Add("IS THAT CORRECT, OVER?")
                        ElseIf optUseSingleFormAuthorityVersionARRC Then
                            'MessageList.Add(optAuthString10 & "    " & ReportTime)
                            MessageList.Add("")
                            MessageList.Add(optAuthString11)
                            MessageList.Add("")
                        ElseIf optApplyConfigurationForKCT Then
                            MessageList.Add(optAuthString10 & "    " & ReportTime)
                            MessageList.Add("")
                            MessageList.Add(optAuthString11)
                            MessageList.Add("")
                        ElseIf optEnableMetroLinkSpecificOptions Then
                            MessageList.Add(optAuthString10 & "    " & ReportTime.Replace(":", ""))
                            MessageList.Add("")
                            MessageList.Add(optAuthString11)
                            MessageList.Add("")
                        Else

                            MessageList.Add(optAuthString10 & "    'TIME'" & ReportTime)
                            MessageList.Add("")
                            MessageList.Add(optAuthString11)
                            MessageList.Add("")
                        End If
                    End If
                Else
                    ClearSelection()
                    MessageList = Nothing
                    Return False
                End If

                frmMessageBox = New frmMessageBox()
                frmMessageBox.theAuth = Me
                frmMessageBox.theTrain = theTrain
                frmMessageBox.theRollUpCompList = RollUpList.Clone
                frmMessageBox.Owner = TrackSelected.CurrentDrawingForm
                LaunchPoint.Y = LaunchPoint.Y + 30
                frmMessageBox.SetMessage(MessageList, optAuthString12 & " " & Me.AuthorityUID, True, LaunchPoint, Nothing, False, False, Nothing, Nothing, False, False, False, optUseReadRepeatMessageBoxOnAuthorityRelease)
                frmMessageBox.ShowDialog()
                If frmMessageBox.FormFeedBack = 6 Then
                    SystemEvent(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO ROLLUP CONFIRMATION")
                    'RollUpEventMessage = "TIME:" & Now & vbCrLf
                    RollUpEventMessage = RollUpEventMessage & LeftLimits & "|" & RightLimits & "|"
                    For Each comp In RollUpList
                        RollUpEventMessage = RollUpEventMessage & comp.GUID & "-"
                    Next
                    If optEnableTTRollupEventDate Then
                        RollUpEventMessage = RollUpEventMessage & "|" & Format(NewReportTime, "MM-dd-yyyy HH:mm") 'NewReportTime.ToString
                    End If
                    SystemEvent(Me.AuthorityUID & " ROLL UP EVENT DATA:" & RollUpEventMessage)
                    Me.RollUpEvents.Add(RollUpEventMessage)
                    Me.CurrentRollUpEvent = RollUpEventMessage



                    'REMOVE THE AUHTORITY FROM THE ROLLED UP TRACK PIECES AND REDRAW ANY EXISTING IDS.
                    Dim SendControlToField As Boolean
                    For Each comp In RollUpList
                        Me.ComponentsInSelection.Remove(comp)
                        comp.TrackAuthorities.Remove(Me)
                        comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                        comp.UpdateStatus()
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim t As Track = CType(comp, Track)
                            If t.AllowFieldBlocking Then
                                SendControlToField = True
                            End If
                        End If
                    Next

                    If SendControlToField Then
                        SendControl(RollUpList)
                    End If

                    ResetCompToCodeBrown(RollUpList)
                    Try
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If comp.IsRemoteTrack Then
                                    If Not comp.Occuppied Then
                                        SystemEvent("SendRemoveTrackAuthority - RollUpAuthority")
                                        comp.myRemoteTrack.SendRemoveTrackAuthority(Me.AuthorityUID)
                                    End If
                                End If
                            End If
                        Next

                    Catch ex As Exception
                        SystemException(ex.ToString)
                    End Try

                    Dim NewLimits As String
                    If ReleaseDirection = "RIGHT" Then
                        NewLimits = RightLimits
                    Else
                        NewLimits = RightLimits
                    End If

                    Me.UpdateDatabaseWithRollUpEvent()
                    Me.CreateReducedLimitsVerbiage()

                    If optEnableMOWMoveOnTNTRollup AndAlso Not Me.IssuedToTrain Then
                        Dim trk As Track
                        Dim RollupMOWMoveCompleted As Boolean = False
                        For Each comp In RollUpList
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                trk = comp
                                If trk.MOWIDs.Count > 0 Then
                                    Dim MOW As MOWID
                                    MOW = trk.MOWIDs.Item(0)
                                    If MOW.Name = IssueTo Then
                                        TrackSelected.MoveMOWIDPlace(MOW, trk, False)
                                        RollupMOWMoveCompleted = True
                                    End If
                                End If

                            End If
                        Next
                        If Not RollupMOWMoveCompleted Then
                            trk = Nothing
                            For Each comp In Me.ComponentsInSelection
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    trk = comp
                                    If trk.MOWIDs.Count > 0 Then
                                        Dim MOW As MOWID
                                        MOW = trk.MOWIDs.Item(0)
                                        If MOW.Name = IssueTo Then
                                            TrackSelected.MoveMOWIDPlace(MOW, trk, False)
                                        End If
                                    End If

                                End If
                            Next
                        End If
                        trk = Nothing
                    End If

                    If Me.MixModeAuthorityType Then
                        If Me.IssuedToTrain Then
                            MoveTrain_MOWOnRollup(RollUpList, Me.IssuedToTrain, Me.TrainSymbol, TrackSelected)
                        Else
                            MoveTrain_MOWOnRollup(RollUpList, Me.IssuedToTrain, IssueTo, TrackSelected)
                        End If
                        Me.DoRemoveMixModeAuthorityFromComponents()
                    End If
                    'ARRC-1305 : added update message publishing on roll up for ViewClient to receive a rollup
                    If (optEnableARRCSpecificOptions And optEnableTNTRollUp And optRailRoadName = "ARRC") Then
                        'This part will send a control server message out on TNT rollup 
                        Dim DoAuthorityEvent As New DoPublishTNTEvent(AddressOf Me.PublishTNTEventUpdate)
                        DoAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.TrackAuthority.EventTypeTNT.UPDATE, Nothing, Nothing)

                        If optEnableTTRollupReportClearPDF Then
                            Try
                                Dim docAuthority As New TrackTimeDocument()
                                Dim FileName As String = docAuthority.BuildAuthorityDocument(Me)
                                If optPerformDocumentArchiving Then
                                    Dim EntityUID As String
                                    If Not Me.IssuedToTrain Then
                                        EntityUID = Me.IssueTo
                                    Else
                                        EntityUID = Me.TrainSymbol
                                        If EntityUID = "" Or EntityUID = "NONE" Then
                                            EntityUID = "UNKNOWN SYMBOL-IDUNIT:" & Me.IssueTo
                                        End If
                                    End If
                                    Dim SubUID As Integer
                                    If Not IsNothing(TrackSelected.mySubdivision) Then
                                        SubUID = TrackSelected.mySubdivision.GUID
                                    End If
                                    Dim TerrUID As Integer = TrackSelected.myTerritory.TerritoryID
                                    TMDS.PrintForms.DocumentArchive.ArchiveTheDocument(FileName, "AUTHORITY-CTC-ROLLUP", EntityUID, TerrUID, SubUID)
                                End If
                            Catch ex As Exception

                            End Try

                        End If
                    End If



                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock

                    Dim SummItem1 As New SummaryItem("AUTHORITY", "ADD", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem1)
                    End SyncLock
                End If

                frmMessageBox.Dispose()
                frmMessageBox = Nothing
                ClearSelection()

            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSelection()
                Dim ErrorMessage As String = "TRACK AUTHORITY " & Me.AuthorityUID & " Not Rolled Up Properly! CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
            End Try
        End Function

