#Region "EVENT LOGGING"

        Public Enum EventTypeTNT
            ADD
            UPDATE
            REMOVE
        End Enum

        Private Delegate Sub DoEventLog(eventType As EventTypeTNT)

        ''' <summary>
        ''' Send Events
        ''' </summary>
        ''' <param name="eventType"></param>
        Public Sub SendEvents(eventType As EventTypeTNT)
            Try
                Dim logEvent As New DoEventLog(AddressOf LogTheTrackTimeEvent)
                logEvent.BeginInvoke(eventType, Nothing, Nothing)
                Dim authorityEvent As New DoEventLog(AddressOf PublishTNTEventUpdate)
                authorityEvent.BeginInvoke(eventType, Nothing, Nothing)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub LogTheTrackTimeEvent(ByVal EventType As EventTypeTNT)
            Try
                Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.LastName & "," & TMDS.GlobalDeclarations.gCurrentUser.FirstName
                Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                Dim CurTerr As Territory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(Me.TerrUID)
                Dim LogString As String = "INSERT INTO tblSystemEvents "
                Dim SqlFields As String = "([EventTime], [Territory], [Wrkstn], [SysUser], [DbVer], [FuncType], [UID], [Event], [SysData])"
                Dim SqlValues As String
                Dim c As String = ", "
                Dim q As String = "'"

                If CurTerr Is Nothing Then
                    SystemEvent("LogTheTrackTimeEvent:CurTerr is nothing")
                    Exit Sub
                End If

                SqlValues = " VALUES (" & q & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & q & c & Me.TerrUID & c & CurWrkstn & c & q & CurUser & q & c
                SqlValues = SqlValues & q & CurTerr.Dbversion & q & c & q & "PSS-TIME" & q & c & q & Me.AuthorityUID & q & c

                Select Case EventType
                    Case EventTypeTNT.ADD
                        SqlValues = SqlValues & q & "CREATE" & q & c & q
                    Case EventTypeTNT.REMOVE
                        SqlValues = SqlValues & q & "DELETE" & q & c & q
                    Case EventTypeTNT.UPDATE
                        SqlValues = SqlValues & q & "UPDATE" & q & c & q
                End Select

                SqlValues = SqlValues & "|" & Me.AuthorityUID
                SqlValues = SqlValues & "|" & Me.AuthorityDate
                SqlValues = SqlValues & "|" & Me.TrainSymbol
                SqlValues = SqlValues & "|" & Me.IssueTo
                Dim comp As Object
                Dim CompList As String = String.Empty
                For Each comp In Me.ComponentsInSelection
                    CompList = CompList & "-" & comp.GUID
                Next
                SqlValues = SqlValues & "|COMPONENTS" & CompList
                SqlValues = SqlValues & "|" & Me.PTCStatus & q
                SqlValues = SqlValues & ")"

                SyncLock TMDS.GlobalDeclarations.gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(LogString & SqlFields & SqlValues)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

#End Region

#Region "STATUS UPDATES"

        Private Delegate Sub DoPublishTNTEvent(ByVal EventType As EventTypeTNT)

        Public Sub PublishTNTEventUpdate(ByVal EventType As EventTypeTNT)
            Try

                Dim Message As String = "DC" & Chr(6) & "PSS;"
                Message = Message & "|" & Me.TerrUID.ToString

                Select Case EventType
                    Case EventTypeTNT.ADD
                        Message += "|" & "CREATE"
                    Case EventTypeTNT.REMOVE
                        Message += "|" & "DELETE"
                    Case EventTypeTNT.UPDATE
                        Message += "|" & "UPDATE"
                End Select

                Message += "|" & Me.AuthorityUID
                Message += "|" & Me.AuthorityDate
                Message += "|" & Me.TrainSymbol
                Message += "|" & Me.IssueTo
                Dim comp As Object
                Dim CompList As String = String.Empty
                For Each comp In Me.ComponentsInSelection
                    CompList = CompList & "-" & comp.GUID
                Next
                Message += "|COMPONENTS" & CompList
                Message += "|" & Me.PTCStatus
                Message = Me.TerrUID.ToString & Chr(12) & Message

                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

