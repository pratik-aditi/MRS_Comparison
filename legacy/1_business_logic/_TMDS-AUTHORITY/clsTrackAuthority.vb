        Public Sub UpdateEOTComps()
            If Not optUseSingleFormAuthorityVersionMRS Then Exit Sub
            Dim compToBlock As Object = Nothing
            Dim trk As Track = Nothing
            Dim tmpRemovedCompList As New ArrayList
            Try
                ResetEOTComps()
                If Me.Components4 IsNot Nothing AndAlso Me.Components4.Count > 0 Then
                    For Each compToBlock In Me.Components4
                        If compToBlock IsNot Nothing AndAlso compToBlock.GetType.ToString = gTrackComponentName Then
                            trk = Nothing
                            trk = compToBlock
                            Dim OkToOccupy As Boolean = False
                            If trk IsNot Nothing Then
                                If trk.Indicating Then
                                ElseIf (trk.TrackAuthorities IsNot Nothing AndAlso trk.TrackAuthorities.Count > 0) Then
                                    OkToOccupy = True
                                ElseIf trk.TrainIDs IsNot Nothing AndAlso trk.TrainIDs.Count > 0 Then
                                    OkToOccupy = True
                                End If
                            End If
                            If OkToOccupy Then
                                trk.Occuppied = True
                            Else
                                trk.Occuppied = False
                                If Not tmpRemovedCompList.Contains(trk) Then tmpRemovedCompList.Add(trk)
                            End If
                            trk.UpdateStatus()
                            If trk.InvokeRequired Then
                                trk.Invoke(New MethodInvoker(AddressOf trk.Refresh))
                            Else
                                trk.Refresh()
                            End If
                        End If
                        'If compToBlock IsNot Nothing AndAlso compToBlock.GetType.ToString = gTrackComponentName AndAlso (compToBlock.TrackAuthorities IsNot Nothing AndAlso compToBlock.TrackAuthorities.Count > 0) Then
                        '    compToBlock.Occuppied = True
                        'End If
                    Next
                End If
                If tmpRemovedCompList IsNot Nothing AndAlso tmpRemovedCompList.Count > 0 Then
                    For Each compToBlock In tmpRemovedCompList
                        If Me.Components4.Contains(compToBlock) Then Me.Components4.Remove(compToBlock)
                    Next
                    UpdateEOT(Me.Components4)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                compToBlock = Nothing
            End Try
        End Sub

        Public Sub ResetEOTComps()
            Dim comp As Object = Nothing
            Dim tmpBox4Coll As New ArrayList
            Dim tmpRemovedCompList As New ArrayList
            Dim trk As Track = Nothing
            Dim LogStr As New StringBuilder(Me.IssueTo & vbCrLf)
            Try
                If Me.Components4 IsNot Nothing AndAlso Me.Components4.Count > 0 AndAlso Me.Components IsNot Nothing Then
                    If Me.Components4.Count <> Me.Components.Count Then
                        CopyArrayCollection(tmpBox4Coll, Me.Components4)
                        For Each comp In tmpBox4Coll
                            If Not Me.Components.Contains(comp) Then
                                Me.Components4.Remove(comp)
                                tmpRemovedCompList.Add(comp)
                            End If
                        Next
                    End If
                End If
                If tmpRemovedCompList IsNot Nothing AndAlso tmpRemovedCompList.Count > 0 Then
                    For Each comp In tmpRemovedCompList
                        With LogStr
                            .Append(comp.GUID & "-")
                        End With
                    Next
                    SystemDiagnosticEvent(LogStr.ToString)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                comp = Nothing
                tmpBox4Coll = Nothing
                tmpRemovedCompList = Nothing
            End Try
        End Sub

#End Region

#Region "PROCEDURES"

        Private Function GetTrainFromUnitID(ByVal UnitID As String) As TrainID
            Try

                Dim strPosition As Integer
                Dim EngineID As String
                strPosition = InStr(IssueTo, optDirectionEast)
                If strPosition = 0 Then
                    strPosition = InStr(IssueTo, optDirectionWest)
                    If strPosition = 0 Then
                        strPosition = InStr(IssueTo, optDirectionNorth)
                        If strPosition = 0 Then
                            strPosition = InStr(IssueTo, optDirectionSouth)
                        End If
                    End If
                End If

                If strPosition > 0 Then
                    EngineID = Trim(Mid(IssueTo, 1, strPosition - 1))
                Else
                    EngineID = Mid(Me.IssueTo, 1, 10)
                End If


                Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(EngineID)
                If Not IsNothing(trn) Then
                    If trn.ReadOnlySymbol Then
                        Return Nothing
                    End If
                ElseIf trn Is Nothing AndAlso optEnableMRSSpecificOptions Then
                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(EngineID)
                    If trn IsNot Nothing AndAlso trn.ReadOnlySymbol Then Return Nothing
                End If
                Return trn

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function FindAuthority(ByVal comp As Object) As SFAuthority
            Try
                Dim auth As SFAuthority
                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                    Dim trk As Track = CType(comp, Track)
                    If trk.TrackAuthorities.Count > 0 Then
                        For Each auth In trk.TrackAuthorities
                            If auth.AuthorityUID = Me.AuthorityUID Then
                                Return auth
                            End If
                        Next
                    Else
                        Return Nothing
                    End If
                ElseIf comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    Dim sw As Switch = CType(comp, Switch)
                    If sw.TrackAuthorities.Count > 0 Then
                        For Each auth In sw.TrackAuthorities
                            If auth.AuthorityUID = Me.AuthorityUID Then
                                Return auth
                            End If
                        Next
                    Else
                        Return Nothing
                    End If
                End If
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub CheckForItemFourOnlyComponents()
            Try
                Dim comp As Object
                For Each comp In Me.Components
                    If Not Me.Box4Components.Contains(comp) Then
                        Exit Sub
                    End If
                Next
                Me.ShowItemFourComponents = True

                For Each comp In Me.Box4Components
                    comp.UpdateStatus()
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Rollup warrant
        ''' </summary>
        ''' <param name="pTrackSelected"></param>
        ''' <param name="pReleaseDirection"></param>
        ''' <returns></returns>
        Public Function RollUpWarrant(ByRef pTrackSelected As Track, ByVal pReleaseDirection As String) As Boolean
            Dim EndOfWarrantFound As Boolean = False
            Dim NextComp As Object = Nothing
            Dim CurrentComp As Object = Nothing
            Dim warr As SFAuthority
            Dim LeftLimits, RightLimits As String
            Dim RollUpEventMessage As String = String.Empty
            Dim comp As Object
            Dim OsLoggingTrack As Track = Nothing
            Dim EndOfAuthorityFound As Boolean
            Dim ReportClearTimeFeedback As String = String.Empty
            Dim TrainIsActivePTC As Boolean = True
            Dim RollUpYesSelected As Boolean = False
            Dim RollupReadString As String = ""
            Dim gHistoryMessage As String = ""
            Dim TrackZonesToCheck As ArrayList = Nothing
            Dim ReportTime As Date
            Dim PTCBOSReportTime As String = ""
            Dim FoundFlipFlop As Boolean = False
            Dim DoAddAuthorityEvent As DoEventLogSFA
            Dim DoAuthorityEvent As DoPublishSFAEvent
            Dim rollupPending As New ArrayList
            Dim LaunchPoint As Point = pTrackSelected.CurrentDrawingForm.myLaunchPoint
            Dim messageListRollup As New ArrayList
            Try
                AuthorityEventLog("RollUpWarrant:TrackSelected=" & pTrackSelected.GUID & ":" & pTrackSelected.Name & ":ReleaseDirection=" & pReleaseDirection)

                If pTrackSelected.NonTransverable Then
                    Return False
                End If

                If gOptDisableTrackSelectionOnTurnOut AndAlso pTrackSelected.TurnOutType Then
                    gHistoryMessage = "AUTHORITY NO: " & Me.AuthorityUID & vbCrLf & " INVALID ROLLUP SEGMENT(S) OR DIRECTION SELECTED."
                    MessageBox.Show(gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    SystemEvent(gHistoryMessage)
                    Return False
                ElseIf gOptDisableTrackSelectionOnNonTraversable AndAlso pTrackSelected.NonTransverable Then
                    gHistoryMessage = "AUTHORITY NO: " & Me.AuthorityUID & vbCrLf & " INVALID ROLLUP SEGMENT(S) OR DIRECTION SELECTED."
                    MessageBox.Show(gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    SystemEvent(gHistoryMessage)
                    Return False
                End If

                If optEnableChkOsReportingTrackTWC Then
                    If pTrackSelected.OSReporting Then OsLoggingTrack = pTrackSelected
                Else
                    OsLoggingTrack = pTrackSelected
                End If

                If gTrackIntegrityMonitoringExists Then
                    TrackZonesToCheck = New ArrayList
                End If

                For Each comp In Me.Components
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.TimeZone <> "" Then
                            CurrentTimeZone = Mid(comp.TimeZone, 1, 1)
                            Exit For
                        End If
                    End If
                Next

                Select Case CurrentTimeZone
                    Case "E"
                        ReportTime = Now.AddHours(1 + gThisWorkstationTimeFactor)
                        'PTCBOSReportTime = Format(Now.AddHours(1 + gThisWorkstationTimeFactor).ToUniversalTime, "yyyyMMddHHmmss")
                    Case "M"
                        ReportTime = Now.AddHours(-1 + gThisWorkstationTimeFactor)
                        'PTCBOSReportTime = Format(Now.AddHours(-1 + gThisWorkstationTimeFactor).ToUniversalTime, "yyyyMMddHHmmss")
                    Case "P"
                        ReportTime = Now.AddHours(-2 + gThisWorkstationTimeFactor)
                    Case "A"
                        ReportTime = Now.AddHours(-3 + gThisWorkstationTimeFactor)
                        'PTCBOSReportTime = Format(Now.AddHours(-2 + gThisWorkstationTimeFactor).ToUniversalTime, "yyyyMMddHHmmss")
                    Case Else
                        ReportTime = Now.AddHours(gThisWorkstationTimeFactor)
                        'PTCBOSReportTime = Format(Now.AddHours(gThisWorkstationTimeFactor).ToUniversalTime, "yyyyMMddHHmmss")
                End Select

                Dim NewReportTime As Date = ReportTime
                If optEnableTimeZoneSettings AndAlso pTrackSelected IsNot Nothing AndAlso pTrackSelected.mySubdivision IsNot Nothing Then
                    NewReportTime = GenerateTime(pTrackSelected.mySubdivision)
                    ReportTime = NewReportTime ' Format(NewReportTime, "HH:mm")
                End If

                ' AS Per BNSF Removing UTC time For T+ Type on 01/20/2011
                PTCBOSReportTime = Format(ReportTime, "yyyyMMddHHmmss")

                Dim FirstSelectedTrack As Track = pTrackSelected

                Dim LoopControl As Integer
                CurrentComp = pTrackSelected

                CurrentComp = pTrackSelected
                Dim TopPoint As Int32
                If pTrackSelected.Top + 600 < pTrackSelected.CurrentDrawingForm.Height Then
                    TopPoint = pTrackSelected.Top + 100
                Else
                    TopPoint = 150
                End If

                If pReleaseDirection = "RIGHT" Then
                    If CurrentComp.LeftLink <> 0 Then
                        If CurrentComp.LeftAltLink <> 0 Then
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.LeftAltLink)
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.LeftLink)
                        End If
                    Else
                        EndOfWarrantFound = True
                    End If
                    While Not EndOfWarrantFound
                        If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Or NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then

                            If NextComp.TrackAuthorities.Count > 0 Then
                                warr = Me.FindAuthority(NextComp)
                                If IsNothing(warr) Then
                                    EndOfWarrantFound = True
                                    Exit While
                                End If

                                If warr.AuthorityUID = Me.AuthorityUID Then
                                    If NextComp.StationNumber = pTrackSelected.StationNumber And
                                       NextComp.Name = pTrackSelected.Name Then

                                    Else
                                        If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                            Dim sw As Switch = CType(NextComp, Switch)

                                            Dim IncludeSwitch As Boolean

                                            If Not IsNothing(pTrackSelected.OsComponentCollection) Then
                                                If Not pTrackSelected.OsComponentCollection.Contains(sw) Then
                                                    IncludeSwitch = True
                                                End If
                                            Else
                                                IncludeSwitch = True
                                                If sw.TypeOfSwitch = "SPM ONLY" Then
                                                    Dim rightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.RightLink)
                                                    If Not IsNothing(rightTrack) Then
                                                        If rightTrack.Name = pTrackSelected.Name And rightTrack.myControlPoint.GUID = pTrackSelected.myControlPoint.GUID Then
                                                            IncludeSwitch = False
                                                        End If
                                                    End If
                                                End If
                                            End If

                                            If IncludeSwitch Then
                                                IncludeSwitch = False
                                                If Not RollUpList.Contains(NextComp) Then
                                                    RollUpList.Add(NextComp)
                                                    AuthorityEventLog("RollUpWarrant:AddComp=" & NextComp.GUID.ToString & ":" & NextComp.Name)
                                                End If

                                                Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightLink)
                                                If Not trk Is Nothing Then
                                                    Dim OsTrack As ArrayList = trk.GetAllOSComponents(True)
                                                    If Not OsTrack Is Nothing Then
                                                        Dim trkCheck As Object
                                                        For Each trkCheck In OsTrack
                                                            If trkCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                                If trkCheck.Name = pTrackSelected.Name And trkCheck.StationNumber = pTrackSelected.StationNumber Then
                                                                    'DO NOTHING
                                                                    If IsNothing(OsLoggingTrack) Then
                                                                        If trkCheck.OSReporting Then
                                                                            OsLoggingTrack = trkCheck
                                                                        End If
                                                                    End If
                                                                Else
                                                                    If trkCheck.TrackAuthorities.Count > 0 Then
                                                                        Dim warrToCheck As Object 'SFAuthority
                                                                        For Each warrToCheck In trkCheck.TrackAuthorities
                                                                            If warrToCheck.AuthorityUID = Me.AuthorityUID Then
                                                                                If Not RollUpList.Contains(trkCheck) Then
                                                                                    RollUpList.Add(trkCheck)
                                                                                    AuthorityEventLog("RollUpWarrant:AddComp=" & trkCheck.GUID.ToString & ":" & trkCheck.Name)
                                                                                    Exit For
                                                                                End If
                                                                            End If
                                                                        Next
                                                                    End If
                                                                End If
                                                            ElseIf trkCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                                                Dim sw1 As Switch = CType(trkCheck, Switch)
                                                                If Mid(sw1.AuthorityType, 1, 3) = "TWC" Then
                                                                    If sw1.TrackAuthorities.Count > 0 Then
                                                                        Dim w As Object 'SFAuthority
                                                                        For Each w In sw1.TrackAuthorities
                                                                            If w.AuthorityUID = Me.AuthorityUID Then
                                                                                If Not RollUpList.Contains(sw1) Then
                                                                                    RollUpList.Add(sw1)
                                                                                    AuthorityEventLog("RollUpWarrant:AddComp=" & sw1.GUID.ToString & ":" & sw1.Name)
                                                                                    Exit For
                                                                                End If
                                                                            End If
                                                                        Next
                                                                        If optEnableMRSSpecificOptions AndAlso sw1.BrotherSwitches IsNot Nothing AndAlso sw1.BrotherSwitches.Count > 0 Then
                                                                            Dim tmpSW As Switch = Nothing
                                                                            For Each tmpSW In sw1.BrotherSwitches
                                                                                If tmpSW.TrackAuthorities IsNot Nothing AndAlso tmpSW.TrackAuthorities.Count > 0 Then
                                                                                    For Each w In tmpSW.TrackAuthorities
                                                                                        If w.AuthorityUID = Me.AuthorityUID Then
                                                                                            If Not RollUpList.Contains(tmpSW) Then
                                                                                                If Not pTrackSelected.OStype OrElse Not pTrackSelected.FindOsTracks.Contains(tmpSW) Then
                                                                                                    RollUpList.Add(tmpSW)
                                                                                                    AuthorityEventLog("RollUpWarrant:AddComp=" & tmpSW.GUID.ToString & ":" & tmpSW.Name)
                                                                                                Else
                                                                                                    AuthorityEventLog("RollUpWarrant:OSType:NotAdd=" & tmpSW.GUID.ToString & ":" & tmpSW.Name)
                                                                                                End If
                                                                                            End If
                                                                                            If tmpSW.OsComponentCollection IsNot Nothing AndAlso tmpSW.OsComponentCollection.Count > 0 Then
                                                                                                Dim tmpComp As Object
                                                                                                For Each tmpComp In tmpSW.OsComponentCollection
                                                                                                    If Me.Components.Contains(tmpComp) Then
                                                                                                        If Not RollUpList.Contains(tmpComp) Then
                                                                                                            If Not pTrackSelected.OStype OrElse Not pTrackSelected.FindOsTracks.Contains(tmpSW) Then
                                                                                                                RollUpList.Add(tmpComp)
                                                                                                                AuthorityEventLog("RollUpWarrant:AddComp=" & tmpComp.GUID.ToString & ":" & tmpComp.Name)
                                                                                                            Else
                                                                                                                AuthorityEventLog("RollUpWarrant:OSType:NotAdd=" & tmpComp.GUID.ToString & ":" & tmpComp.Name)
                                                                                                            End If
                                                                                                        End If
                                                                                                    End If
                                                                                                Next
                                                                                            End If
                                                                                        End If
                                                                                    Next
                                                                                End If
                                                                            Next
                                                                        End If
                                                                    End If
                                                                End If
                                                            End If
                                                        Next
                                                    End If
                                                End If
                                            End If
                                        ElseIf NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            If Not RollUpList.Contains(NextComp) Then
                                                RollUpList.Add(NextComp)
                                                AuthorityEventLog("RollUpWarrant:AddComp=" & NextComp.GUID.ToString & ":" & NextComp.Name)
                                            End If

                                            Dim ChkTrk As Track = CType(NextComp, Track)
                                            If IsNothing(OsLoggingTrack) Then
                                                If ChkTrk.OSReporting Then
                                                    OsLoggingTrack = ChkTrk
                                                End If
                                            End If
                                        End If
                                    End If
                                    CurrentComp = NextComp

                                    'Check for any component other then a track or switch
                                    If CurrentComp.GetType.ToString <> "TMDS.SwitchComponents.Switch" _
                                    And CurrentComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                        EndOfWarrantFound = True
                                        Exit While
                                    End If

                                    If CurrentComp.LeftLink <> 0 Then
                                        If CurrentComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                            Dim sw As Switch = CType(CurrentComp, Switch)

                                            NextComp = FoundExitTrackOfRollUpOutOfSwitch(sw, Me, "LEFT")
                                            If IsNothing(NextComp) Then
                                                If Not IsNothing(sw.OsComponentCollection) Then
                                                    For Each comp In sw.OsComponentCollection
                                                        If comp.Name = pTrackSelected.Name And comp.StationNumber = pTrackSelected.StationNumber Then
                                                            Exit While
                                                        End If
                                                        If Not RollUpList.Contains(comp) Then
                                                            RollUpList.Add(comp)
                                                            AuthorityEventLog("RollUpWarrant:AddComp=" & comp.GUID.ToString & ":" & comp.Name)
                                                        End If
                                                    Next
                                                End If
                                                Exit While
                                            End If
                                        Else
                                            If CurrentComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                Dim trkToCheck As Track = CType(CurrentComp, Track)
                                                If trkToCheck.LeftAltLink <> 0 Then
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(trkToCheck.LeftAltLink)
                                                    If Not IsNothing(trkToCheck.OsComponentCollection) Then
                                                        Dim CompToAdd As Object
                                                        For Each CompToAdd In trkToCheck.OsComponentCollection
                                                            If CompToAdd.TrackAuthorities.Count > 0 Then
                                                                Dim Nextwarr As Object 'SFAuthority
                                                                For Each Nextwarr In CompToAdd.TrackAuthorities
                                                                    If Nextwarr.AuthorityUID = Me.AuthorityUID Then
                                                                        If Not RollUpList.Contains(CompToAdd) Then
                                                                            RollUpList.Add(CompToAdd)
                                                                            AuthorityEventLog("RollUpWarrant:AddComp=" & CompToAdd.GUID.ToString & ":" & CompToAdd.Name)
                                                                        End If
                                                                    End If
                                                                Next
                                                            End If
                                                        Next
                                                    End If
                                                Else
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.LeftLink)
                                                End If
                                            Else
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.LeftLink)
                                            End If

                                        End If
                                        'Version 236
                                        'this code was inserted to handle leaving behind piece of warrant after a rollup through
                                        'a reverse switch with a warrant issued through it on the main and turn both.
                                        If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                            ' do nothing
                                        ElseIf FirstSelectedTrack.TrackName = NextComp.TrackName And FirstSelectedTrack.StationNumber = NextComp.StationNumber Then
                                            'do nothing
                                        Else
                                            If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                Dim OtherLikeComponenets As ArrayList = NextComp.FindOsTracks
                                                If Not OtherLikeComponenets Is Nothing Then
                                                    Dim compon As Object
                                                    For Each compon In OtherLikeComponenets
                                                        If compon.TrackAuthorities.Count > 0 Then
                                                            Dim Nextwarr As Object 'SFAuthority
                                                            For Each Nextwarr In compon.TrackAuthorities
                                                                If Nextwarr.AuthorityUID = Me.AuthorityUID Then
                                                                    If Not RollUpList.Contains(compon) Then
                                                                        If Not pTrackSelected.OStype OrElse Not pTrackSelected.FindOsTracks.Contains(compon) Then
                                                                            RollUpList.Add(compon)
                                                                            AuthorityEventLog("RollUpWarrant:AddComp=" & compon.GUID.ToString & ":" & compon.Name)
                                                                        Else
                                                                            AuthorityEventLog("RollUpWarrant:OSType:NotAdd=" & compon.GUID.ToString & ":" & compon.Name)
                                                                        End If
                                                                    End If
                                                                End If
                                                            Next
                                                        End If
                                                    Next
                                                End If
                                            End If
                                        End If
                                        'Version 236
                                    Else
                                        EndOfWarrantFound = True
                                    End If


                                    'Check for any component other then a track or switch
                                    If NextComp.GetType.ToString <> "TMDS.SwitchComponents.Switch" Then
                                        If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                            EndOfWarrantFound = True
                                        End If
                                    End If


                                Else
                                    EndOfWarrantFound = True
                                End If
                            Else
                                EndOfWarrantFound = True
                            End If
                        Else
                            'If NextComp.GetType.ToString = gFlipFlopComponentName Then
                            '    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            '    FoundFlipFlop = True
                            'Else
                            '    EndOfWarrantFound = True
                            'End If
                            EndOfWarrantFound = True
                        End If

                        LoopControl = LoopControl + 1
                        If LoopControl = gRollUpComponentCount Then
                            NextComp = Nothing
                            ClearSelection()
                            Return False
                        End If
                    End While

                    If Not IsNothing(Me.Box4Components) Then
                        Dim CompList As ArrayList = Me.Components.Clone
                        CompList.Reverse()
                        If Me.Box4Components.Contains(pTrackSelected) Then
                            Dim compToChk As Object
                            For Each compToChk In CompList
                                If Not Me.Box4Components.Contains(compToChk) Then
                                    If Not RollUpList.Contains(compToChk) Then
                                        RollUpList.Add(compToChk)
                                        AuthorityEventLog("RollUpWarrant:AddComp=" & compToChk.GUID.ToString & ":" & compToChk.Name)
                                    End If
                                End If
                            Next
                        End If
                    End If
                ElseIf pReleaseDirection = "LEFT" Then
                    If CurrentComp.RightLink <> 0 Then
                        If CurrentComp.RightAltLink <> 0 Then
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.RightAltLink)
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.RightLink)
                        End If
                    Else
                        EndOfWarrantFound = True
                    End If
                    While Not EndOfWarrantFound
                        If NextComp IsNot Nothing AndAlso NextComp.TrackAuthorities.Count > 0 Then
                            warr = Me.FindAuthority(NextComp)
                            If IsNothing(warr) Then
                                EndOfWarrantFound = True
                                Exit While
                            End If

                            If warr.AuthorityUID = Me.AuthorityUID Then
                                If NextComp.StationNumber = pTrackSelected.StationNumber And
                                   NextComp.Name = pTrackSelected.Name Then

                                Else
                                    If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                        Dim sw As Switch = CType(NextComp, Switch)
                                        Dim IncludeSwitch As Boolean
                                        If Not IsNothing(pTrackSelected.OsComponentCollection) Then
                                            If Not pTrackSelected.OsComponentCollection.Contains(sw) Then
                                                IncludeSwitch = True
                                            End If
                                        Else
                                            IncludeSwitch = True
                                            If sw.TypeOfSwitch = "SPM ONLY" Then
                                                Dim rightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.RightLink)
                                                If Not IsNothing(rightTrack) Then
                                                    If rightTrack.Name = pTrackSelected.Name And rightTrack.myControlPoint.GUID = pTrackSelected.myControlPoint.GUID Then
                                                        IncludeSwitch = False
                                                    End If
                                                End If
                                            End If
                                        End If

                                        If IncludeSwitch Then
                                            IncludeSwitch = False
                                            If Not RollUpList.Contains(NextComp) Then
                                                RollUpList.Add(NextComp)
                                                AuthorityEventLog("RollUpWarrant:AddComp=" & NextComp.GUID.ToString & ":" & NextComp.Name)
                                            End If
                                            Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightLink)
                                            If Not trk Is Nothing Then
                                                Dim OsTrack As ArrayList = trk.GetAllOSComponents(True)
                                                If Not OsTrack Is Nothing Then
                                                    Dim trkCheck As Object
                                                    For Each trkCheck In OsTrack
                                                        If trkCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                            If trkCheck.Name = pTrackSelected.Name And trkCheck.StationNumber = pTrackSelected.StationNumber Then
                                                                'DO NOTHING
                                                                If IsNothing(OsLoggingTrack) Then
                                                                    If trkCheck.OSReporting Then
                                                                        OsLoggingTrack = trkCheck
                                                                    End If
                                                                End If

                                                            Else
                                                                If trkCheck.TrackAuthorities.Count > 0 Then
                                                                    Dim warrToCheck As Object 'SFAuthority
                                                                    For Each warrToCheck In trkCheck.TrackAuthorities
                                                                        If warrToCheck.AuthorityUID = Me.AuthorityUID Then
                                                                            If Not RollUpList.Contains(trkCheck) Then
                                                                                RollUpList.Add(trkCheck)
                                                                                AuthorityEventLog("RollUpWarrant:AddComp=" & trkCheck.GUID.ToString & ":" & trkCheck.Name)
                                                                                Exit For
                                                                            End If
                                                                        End If
                                                                    Next
                                                                End If
                                                            End If
                                                        ElseIf trkCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                                            Dim sw1 As Switch = CType(trkCheck, Switch)
                                                            If Mid(sw1.AuthorityType, 1, 3) = "TWC" Then
                                                                If sw1.TrackAuthorities.Count > 0 Then
                                                                    Dim w As Object 'SFAuthority
                                                                    For Each w In sw1.TrackAuthorities
                                                                        If w.AuthorityUID = Me.AuthorityUID Then
                                                                            If Not RollUpList.Contains(sw1) Then
                                                                                RollUpList.Add(sw1)
                                                                                AuthorityEventLog("RollUpWarrant:AddComp=" & sw1.GUID.ToString & ":" & sw1.Name)
                                                                                Exit For
                                                                            End If
                                                                        End If
                                                                    Next

                                                                    If optEnableMRSSpecificOptions AndAlso sw1.BrotherSwitches IsNot Nothing AndAlso sw1.BrotherSwitches.Count > 0 Then
                                                                        Dim tmpSW As Switch = Nothing
                                                                        For Each tmpSW In sw1.BrotherSwitches
                                                                            If tmpSW.TrackAuthorities IsNot Nothing AndAlso tmpSW.TrackAuthorities.Count > 0 Then
                                                                                For Each w In tmpSW.TrackAuthorities
                                                                                    If w.AuthorityUID = Me.AuthorityUID Then
                                                                                        If Not RollUpList.Contains(tmpSW) Then
                                                                                            If Not pTrackSelected.OStype OrElse Not pTrackSelected.FindOsTracks.Contains(tmpSW) Then
                                                                                                RollUpList.Add(tmpSW)
                                                                                                AuthorityEventLog("RollUpWarrant:AddComp=" & tmpSW.GUID.ToString & ":" & tmpSW.Name)
                                                                                            Else
                                                                                                AuthorityEventLog("RollUpWarrant:OSType:NotAdd=" & tmpSW.GUID.ToString & ":" & tmpSW.Name)
                                                                                            End If
                                                                                        End If
                                                                                        If tmpSW.OsComponentCollection IsNot Nothing AndAlso tmpSW.OsComponentCollection.Count > 0 Then
                                                                                            Dim tmpComp As Object
                                                                                            For Each tmpComp In tmpSW.OsComponentCollection
                                                                                                If Me.Components.Contains(tmpComp) Then
                                                                                                    If Not RollUpList.Contains(tmpComp) Then
                                                                                                        If Not pTrackSelected.OStype OrElse Not pTrackSelected.FindOsTracks.Contains(tmpComp) Then
                                                                                                            RollUpList.Add(tmpComp)
                                                                                                            AuthorityEventLog("RollUpWarrant:AddComp=" & tmpComp.GUID.ToString & ":" & tmpComp.Name)
                                                                                                        Else
                                                                                                            AuthorityEventLog("RollUpWarrant:OSType:NotAdd=" & tmpComp.GUID.ToString & ":" & tmpComp.Name)
                                                                                                        End If
                                                                                                    End If
                                                                                                End If
                                                                                            Next
                                                                                        End If
                                                                                    End If
                                                                                Next
                                                                            End If
                                                                        Next
                                                                    End If


                                                                End If
                                                            End If
                                                        End If
                                                    Next
                                                End If
                                            End If
                                        End If
                                    ElseIf NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        If Not RollUpList.Contains(NextComp) Then
                                            RollUpList.Add(NextComp)
                                            AuthorityEventLog("RollUpWarrant:AddComp=" & NextComp.GUID.ToString & ":" & NextComp.Name)
                                        End If
                                        Dim ChkTrk As Track = CType(NextComp, Track)
                                        If IsNothing(OsLoggingTrack) Then
                                            If ChkTrk.OSReporting Then
                                                OsLoggingTrack = ChkTrk
                                            End If
                                        End If
                                    End If

                                End If
                                CurrentComp = NextComp
                                '*****

                                'Check for any component other then a track or switch
                                If CurrentComp.GetType.ToString <> "TMDS.SwitchComponents.Switch" _
                                And CurrentComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    EndOfWarrantFound = True
                                    Exit While 'add 4-18-04
                                End If

                                If CurrentComp.RightLink <> 0 Then
                                    If CurrentComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                        Dim sw As Switch = CType(CurrentComp, Switch)
                                        NextComp = FoundExitTrackOfRollUpOutOfSwitch(sw, Me, "RIGHT")
                                        If IsNothing(NextComp) Then
                                            If Not IsNothing(sw.OsComponentCollection) Then
                                                For Each comp In sw.OsComponentCollection
                                                    If comp.Name = pTrackSelected.Name And comp.StationNumber = pTrackSelected.StationNumber Then
                                                        Exit While
                                                    End If

                                                    If Not RollUpList.Contains(comp) Then
                                                        RollUpList.Add(comp)
                                                        AuthorityEventLog("RollUpWarrant:AddComp=" & comp.GUID.ToString & ":" & comp.Name)
                                                    End If
                                                Next
                                            End If
                                            Exit While
                                        End If
                                    Else
                                        If CurrentComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            Dim trkToCheck As Track = CType(CurrentComp, Track)
                                            If trkToCheck.RightAltLink <> 0 Then
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(trkToCheck.RightAltLink)
                                            Else
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.RightLink)
                                            End If
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.RightLink)
                                        End If
                                    End If

                                    'Version 236
                                    'this code was inserted to handle leaving behind piece of warrant after a rollup through
                                    'a reverse switch with a warrant issued through it on the main and turn both.
                                    If NextComp IsNot Nothing AndAlso NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                        ' do nothing
                                    ElseIf NextComp IsNot Nothing AndAlso FirstSelectedTrack.TrackName = NextComp.TrackName AndAlso FirstSelectedTrack.StationNumber = NextComp.StationNumber Then
                                        'do nothing
                                    ElseIf NextComp IsNot Nothing Then
                                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            Dim OtherLikeComponenets As ArrayList = NextComp.FindOsTracks
                                            If Not OtherLikeComponenets Is Nothing Then
                                                Dim compon As Object
                                                For Each compon In OtherLikeComponenets
                                                    If compon.TrackAuthorities.Count > 0 Then
                                                        Dim Nextwarr As Object 'SFAuthority
                                                        For Each Nextwarr In compon.TrackAuthorities
                                                            If Nextwarr.AuthorityUID = Me.AuthorityUID Then
                                                                If Not RollUpList.Contains(compon) Then
                                                                    If Not pTrackSelected.OStype OrElse Not pTrackSelected.FindOsTracks.Contains(compon) Then
                                                                        RollUpList.Add(compon)
                                                                        AuthorityEventLog("RollUpWarrant:AddComp=" & compon.GUID.ToString & ":" & compon.Name)
                                                                    Else
                                                                        AuthorityEventLog("RollUpWarrant:OSType:NotAdd=" & compon.GUID.ToString & ":" & compon.Name)
                                                                    End If
                                                                End If
                                                            End If
                                                        Next
                                                    End If
                                                Next
                                            End If
                                        End If
                                    End If
                                Else
                                    EndOfWarrantFound = True
                                End If

                                'Check for any component other then a track or switch
                                If NextComp IsNot Nothing AndAlso NextComp.GetType.ToString <> "TMDS.SwitchComponents.Switch" Then
                                    If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                        EndOfWarrantFound = True
                                    End If
                                ElseIf NextComp Is Nothing Then
                                    EndOfWarrantFound = True
                                End If


                            Else
                                EndOfWarrantFound = True
                            End If
                        Else
                            EndOfWarrantFound = True
                        End If

                        LoopControl = LoopControl + 1
                        If LoopControl = gRollUpComponentCount Then
                            NextComp = Nothing
                            ClearSelection()
                            Return False
                        End If
                    End While
                    NextComp = Nothing
                    CurrentComp = Nothing

                    If Not IsNothing(Me.Box4Components) Then
                        Dim CompList As ArrayList = Me.Components.Clone
                        CompList.Reverse()
                        If Me.Box4Components.Contains(pTrackSelected) Then
                            Dim compToChk As Object
                            For Each compToChk In CompList
                                If Not Me.Box4Components.Contains(compToChk) Then
                                    If Not RollUpList.Contains(compToChk) Then
                                        RollUpList.Add(compToChk)
                                        AuthorityEventLog("RollUpWarrant:AddComp=" & compToChk.GUID.ToString & ":" & compToChk.Name)
                                    End If
                                End If
                            Next
                        End If
                    End If

                End If

                'ROLLUP COMPONENTS GATHERED...NOW PROMPT USER
                Dim FlipFlopFound As Boolean = False
                If RollUpList.Count = 0 Then
                    If optEnableARRCSpecificOptions Then
                        If Me.MixModeAuthorityType Then
                            CheckToAddOtherAuthorityToRollUpList(RollUpList, pReleaseDirection, pTrackSelected, FlipFlopFound)
                        End If
                    End If
                End If

                'This allows rollup over alcas tracks
                If optEnableMRSSpecificOptions AndAlso pTrackSelected.AuthorityType.Contains("TWC") Then
                    For Each compAux As Object In Me.Components
                        If compAux.GetType.ToString = gFlipFlopComponentName Then
                            FoundFlipFlop = True
                            Exit For
                        End If
                    Next
                    If FoundFlipFlop Then
                        RollUpList.Clear()
                        For Each compAux As Object In Me.Components
                            If pTrackSelected = compAux Then
                                Exit For
                            End If
                            If compAux.GetType.ToString = gTrackComponentName Or
                                compAux.GetType.ToString = gSwitchComponentName Or
                                compAux.GetType.ToString = gFlipFlopComponentName Then
                                AuthorityEventLog("RollupWarrant:FLIPFLOP:AddComp=" & compAux.GUID & ":" & compAux.Name)
                                RollUpList.Add(compAux)
                            End If
                        Next
                    End If
                End If

                If RollUpList.Count = 0 Then
                    If optUseSingleFormAuthorityVersionII Or optUseSingleFormAuthorityVersionCN Or optUseSingleFormAuthorityVersionMRL Or optUseSingleFormAuthorityVersionARRC OrElse optUseSingleFormAuthorityVersionNCTD Then
                        If Me.CheckBoxItemsStatus(3) Then
                            If pTrackSelected.OStype Then
                                Dim compInList As Object
                                If Not IsNothing(pTrackSelected.OsComponentCollection) Then
                                    For Each compInList In pTrackSelected.OsComponentCollection
                                        If Not RollUpList.Contains(compInList) Then
                                            RollUpList.Add(compInList)
                                            AuthorityEventLog("RollUpWarrant:AddComp=" & compInList.GUID.ToString & ":" & compInList.Name)
                                        End If
                                    Next
                                End If
                                EndOfAuthorityFound = True
                            End If
                        Else
                            ClearSelection()
                            Return False
                        End If
                    Else
                        ClearSelection()
                        Return False
                    End If
                End If

                If optUseSingleFormAuthorityVersionARRC Then
                    If InStr(Me.AuthType1, "MOW") OrElse Me.AuthType1 = "ItemFourToTrain" Then
                        CheckToAddSidingTracksToRollUpList(RollUpList, pReleaseDirection, pTrackSelected)
                    End If
                    If Me.MixModeAuthorityType Then
                        CheckToAddOtherAuthorityToRollUpList(RollUpList, pReleaseDirection, pTrackSelected, FlipFlopFound)
                    End If
                End If

                ResetRollupListComponents(GenericComponent.ModeSelection.SummarySelectionBlocking)
                SelectionTimer.Enabled = True

                'ITEM 4 CONTINGENT RELEASE
                Dim ReleaseItemTwoLimits As Boolean
                If optUseSingleFormAuthorityVersionII Or optUseSingleFormAuthorityVersionCN Or optUseSingleFormAuthorityVersionMRL Or optUseSingleFormAuthorityVersionARRC OrElse optUseSingleFormAuthorityVersionNCTD Then
                    If Me.CheckBoxItemsStatus(3) Then
                        Dim LoopCtrl As Integer = 1
                        Dim CompToChk As Object = pTrackSelected
                        Do
                            If CompToChk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If CompToChk.Name <> pTrackSelected.Name Then
                                    If Not Me.Box4Components.Contains(pTrackSelected) And Me.Box4Components.Contains(CompToChk) Then
                                        EndOfAuthorityFound = True
                                    End If
                                    Exit Do
                                Else
                                    If Me.Components.IndexOf(pTrackSelected) + LoopCtrl > Me.Components.Count - 1 Then Exit Do
                                    CompToChk = Me.Components.Item(Me.Components.IndexOf(pTrackSelected) + LoopCtrl)
                                End If
                            Else
                                CompToChk = Me.Components.Item(Me.Components.IndexOf(pTrackSelected) + LoopCtrl)
                            End If
                            LoopCtrl += 1
                            If LoopCtrl > 50 Then
                                Exit Do
                            End If
                        Loop

                        If EndOfAuthorityFound And pTrackSelected.OStype Then
                            Dim frmMessBox As frmMessageBox
                            Dim MessList As New ArrayList()
                            MessList.Add(optRollUpAuthorityString13)
                            MessList.Add(optRollUpAuthorityString14)
                            MessList.Add(optRollUpAuthorityString15)
                            frmMessBox = New frmMessageBox()
                            frmMessBox.Owner = pTrackSelected.CurrentDrawingForm
                            'LaunchPoint.Y = LaunchPoint.Y + 30
                            frmMessBox.SetMessage(MessList, "RELEASE CONFIRMATION " & Me.AuthorityUID, True, LaunchPoint)
                            frmMessBox.ShowDialog()
                            If frmMessBox.FormFeedBack = 6 Then
                                ReleaseItemTwoLimits = True
                                If Not RollUpList.Contains(pTrackSelected) Then
                                    RollUpList.Insert(0, pTrackSelected)
                                End If

                                If Not IsNothing(pTrackSelected.OsComponentCollection) Then
                                    Dim OsComp As Object
                                    For Each OsComp In pTrackSelected.OsComponentCollection
                                        If Not RollUpList.Contains(OsComp) Then
                                            RollUpList.Insert(1, OsComp)
                                        End If
                                    Next
                                End If
                            End If
                            frmMessBox.Dispose()
                            frmMessBox = Nothing
                        End If
                    End If
                End If

                'Assign limits of roll up
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()
                Dim ReverseSwitchList As New ArrayList()
                Dim swList As New ArrayList()
                Dim RollUpEventText As String = String.Empty
                Dim RollUpEventPTCBOSAPIText As String = String.Empty
                If RollUpList.Count > 0 Then
                    Dim trk1 As Object = Me.FindFirstTrackInList(RollUpList) 'RollUpList.Item(0)
                    Dim trk2 As Object = Me.FindLastTrackInList(RollUpList) 'RollUpList.Item(RollUpList.Count - 1)
                    If FlipFlopFound Then
                        If pReleaseDirection = "RIGHT" Then
                            RightLimits = trk1.RightLimitName
                            LeftLimits = trk2.RightLimitName
                        Else
                            RightLimits = trk1.LeftLimitName
                            LeftLimits = trk2.LeftLimitName
                        End If
                    Else
                        If pReleaseDirection = "RIGHT" Then
                            RightLimits = trk1.RightLimitName
                            LeftLimits = trk2.LeftLimitName
                        Else
                            RightLimits = trk1.LeftLimitName
                            LeftLimits = trk2.RightLimitName
                        End If
                    End If
                    If optEnableCNSpecificOptions Then
                    ElseIf optEnableARRCSpecificOptions Then
                    Else
                        If InStr(RightLimits, ",") > 0 Then
                            Dim Delimiter As Integer = InStr(RightLimits, ",")
                            RightLimits = Mid(RightLimits, 1, Delimiter - 1)
                        End If
                        If InStr(LeftLimits, ",") > 0 Then
                            Dim Delimiter As Integer = InStr(LeftLimits, ",")
                            LeftLimits = Mid(LeftLimits, 1, Delimiter - 1)
                        End If
                    End If
                    If optUseSingleFormAuthorityVersionII Then
                        Dim comp1 As Object
                        Dim frmSwlist As frmSwitchList
                        For Each comp1 In RollUpList
                            If comp1.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                swList.Add(comp1)
                            End If
                        Next
                        If swList.Count > 0 Then
                            frmSwlist = New frmSwitchList()
                            'frmSwlist.Owner = Me
                            frmSwlist.Location = LaunchPoint
                            Dim sw As Switch
                            For Each sw In swList
                                frmSwlist.clbSwitchList.Items.Add(sw.Name)
                            Next
                            frmSwlist.ShowDialog()
                            Dim i As Integer
                            For i = 0 To frmSwlist.clbSwitchList.CheckedItems.Count - 1
                                ReverseSwitchList.Add(frmSwlist.clbSwitchList.CheckedItems(i))
                            Next
                        End If

                        If optUseReleaseVerbiageForKCS Then
                            MessageList.Add(Me.IssueTo)
                            MessageList.Add("IS RELEASING THAT PORTION OF TRACK WARRANT AUTHORITY NUMBER " & Me.AuthorityUID)
                            MessageList.Add(optRollUpAuthorityString2 & LeftLimits & Space(1) & optRollUpAuthorityString3 & Space(1) & RightLimits)
                            MessageList.Add("")
                            Dim strReportTime As String = Format(ReportTime, "HH:mm")
                            Dim strReportDate As String = Format(ReportTime, optSystemDateTimeString)
                            MessageList.Add("AT    " & strReportTime & Space(5) & strReportDate & "    (" & TMDS.GlobalDeclarations.gCurrentUser.Initials & ")")
                            MessageList.Add("")

                            If ReverseSwitchList.Count > 0 Then
                                Dim swstr As String
                                If Me.AuthType1 = "ItemTwoToTrain" Then
                                    MessageList.Add(optRollUpAuthorityString5)
                                Else
                                    MessageList.Add(optRollUpAuthorityString6)
                                End If
                                For Each swstr In ReverseSwitchList
                                    MessageList.Add(swstr & "'UNDERLINE'")
                                Next
                                MessageList.Add("")
                                MessageList.Add(optRollUpAuthorityString7)
                            Else
                                If Me.AuthType1 = "ItemTwoToTrain" Then
                                    MessageList.Add(optRollUpAuthorityString8)
                                Else
                                    MessageList.Add(optRollUpAuthorityString9)
                                End If

                            End If
                            MessageList.Add("")
                            MessageList.Add(optRollUpAuthorityString11 & "'COLOR-RED")
                        Else
                            MessageList.Add(Me.IssueTo)
                            If Me.MixModeAuthorityType Then
                                MessageList.Add(optRollUpAuthorityString26 & Me.AuthorityUID)
                            Else
                                MessageList.Add(optRollUpAuthorityString1 & Me.AuthorityUID)
                            End If
                            MessageList.Add(optRollUpAuthorityString2 & LeftLimits & Space(1) & optRollUpAuthorityString3 & Space(1) & RightLimits)
                            MessageList.Add("")
                            Dim strReportTime As String = Format(ReportTime, "HH:mm")
                            Dim strReportDate As String = Format(ReportTime, optSystemDateTimeString)
                            MessageList.Add(optRollUpAuthorityString4 & "       'TIME'" & strReportTime & Space(35) & strReportDate & " " & TMDS.GlobalDeclarations.gCurrentUser.Initials) ') '"        'TIME'" & ReportTime)

                            MessageList.Add("")

                            If ReverseSwitchList.Count > 0 Then
                                Dim swstr As String
                                If Me.AuthType1 = "ItemTwoToTrain" Then
                                    MessageList.Add(optRollUpAuthorityString5)
                                Else
                                    MessageList.Add(optRollUpAuthorityString6)
                                End If
                                For Each swstr In ReverseSwitchList
                                    MessageList.Add(swstr & "'UNDERLINE'")
                                Next
                                MessageList.Add("")
                                MessageList.Add(optRollUpAuthorityString7)
                            Else
                                If Me.AuthType1 = "ItemTwoToTrain" Then
                                    MessageList.Add(optRollUpAuthorityString8)
                                Else
                                    MessageList.Add(optRollUpAuthorityString9)
                                End If

                            End If

                            'MessageList.Add("AND COMPLETION OF THE SWITCH POSITION FORM 4751 HAS OCCURRED.")
                            MessageList.Add("")
                            MessageList.Add(optRollUpAuthorityString10)
                            MessageList.Add("")
                            MessageList.Add(optRollUpAuthorityString11)
                        End If
                    ElseIf optUseSingleFormAuthorityVersionARRC OrElse optUseSingleFormAuthorityVersionNCTD Then
                        Dim TrackNameList As New ArrayList

                        For Each comp In RollUpList
                            If Not TrackNameList.Contains(comp.TrackName) Then
                                TrackNameList.Add(comp.TrackName)
                            End If
                        Next
                        Dim trkname As String = String.Empty
                        Dim trackString As New StringBuilder
                        For Each trkname In TrackNameList
                            If trackString.Length = 0 Then
                                trackString.Append(optAuthString13 & " " & trkname & optAuthString14)
                            Else
                                trackString.Append(optAuthString15 & trkname & optAuthString16)
                            End If
                        Next

                        MessageList.Add(Me.IssueTo)
                        If Me.MixModeAuthorityType Then
                            MessageList.Add(optRollUpAuthorityString26 & " " & Me.AuthorityUID)
                        Else
                            MessageList.Add(optRollUpAuthorityString23 & " " & Me.AuthorityUID)
                        End If

                        MessageList.Add(optRollUpAuthorityString2 & LeftLimits & Space(1) & optRollUpAuthorityString3 & RightLimits)
                        MessageList.Add(trackString.ToString)
                        Dim strReportTime As String = Format(ReportTime, "HH:mm")
                        If Not optUseSingleFormAuthorityVersionARRC Then MessageList.Add(optRollUpAuthorityString4 & Space(1) & strReportTime & Space(2) & " (" & TMDS.GlobalDeclarations.gCurrentUser.Initials & ")") 'TIME'" & ReportTime)
                        If Me.AuthType1 = "ItemTwoToTrain" Then
                            MessageList.Add(optRollUpAuthorityString8)
                        End If
                        MessageList.Add("")
                        MessageList.Add(optRollUpAuthorityString10)
                        RollUpEventText = "TRACK ROLLUP " & optRollUpAuthorityString2 & LeftLimits & Space(1) & optRollUpAuthorityString3 & RightLimits & " AT " & strReportTime
                    ElseIf optUseSingleFormAuthorityVersionCN Then
                        MessageList.Add(Me.IssueTo)
                        MessageList.Add(optRollUpAuthorityString23 & " " & Me.AuthorityUID)
                        MessageList.Add(optRollUpAuthorityString2 & LeftLimits & Space(1) & optRollUpAuthorityString3 & RightLimits)
                        Dim strReportTime As String = Format(ReportTime, "HH:mm")
                        MessageList.Add(optRollUpAuthorityString4 & Space(1) & strReportTime & Space(2) & " (" & TMDS.GlobalDeclarations.gCurrentUser.Initials & ")")      'TIME'" & ReportTime)
                        If Me.AuthType1 = "ItemTwoToTrain" Then
                            MessageList.Add(optRollUpAuthorityString8)
                        Else
                            MessageList.Add(optRollUpAuthorityString9)
                        End If
                        MessageList.Add("")
                        MessageList.Add(optRollUpAuthorityString10)
                        RollUpEventText = "TRACK ROLLUP " & optRollUpAuthorityString2 & LeftLimits & Space(1) & optRollUpAuthorityString3 & RightLimits & " AT " & strReportTime
                    ElseIf optUseSingleFormAuthorityVersionMRS Then
                        Dim comp1 As Object
                        For Each comp1 In RollUpList
                            If comp1.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                Dim sw As Switch = CType(comp1, Switch)
                                Dim Brosw As Switch = Nothing
                                If sw.TypeOfSwitch = "SPRING" And Not sw.BlockAbsolute AndAlso sw.ControlledReverse Then
                                    ReverseSwitchList.Add(sw)
                                    'If sw.BrotherSwitches IsNot Nothing AndAlso sw.BrotherSwitches.Count > 0 Then
                                    '    For Each Brosw In sw.BrotherSwitches
                                    '        If Brosw.ControlledReverse AndAlso Not sw.BlockAbsolute AndAlso sw IsNot Brosw Then
                                    '            If Not ReverseSwitchList.Contains(Brosw) Then ReverseSwitchList.Add(Brosw)
                                    '        End If
                                    '    Next
                                    'End If
                                End If
                            End If
                        Next
                        MessageList.Add(optSystemMessageString15 & Space(1) & Me.IssueTo)
                        MessageList.Add("")
                        MessageList.Add(optSystemMessageString16)
                    ElseIf optUseSingleFormAuthorityVersionMRL Then
                        If Me.AuthType1 = "ItemTwoToTrain" Then
                            MessageList.Add(Me.IssueTo)
                            MessageList.Add("WITH TRACK WARRNT " & Me.AuthorityUID)
                            MessageList.Add("ALL PAST " & RightLimits)
                            MessageList.Add(optRollUpAuthorityString8)
                            MessageList.Add("")
                            MessageList.Add("IS THAT CORRECT, OVER?")
                        Else
                            MessageList.Add(Me.IssueTo)
                            MessageList.Add("RELEASING THAT PORTION OF TRACK WARRANT " & Me.AuthorityUID)
                            MessageList.Add(optRollUpAuthorityString2 & LeftLimits & Space(1) & optRollUpAuthorityString3 & RightLimits & " ON " & pTrackSelected.TrackName)
                            Dim strReportTime As String = Format(ReportTime, "HH:mm")
                            MessageList.Add(optRollUpAuthorityString4 & Space(1) & strReportTime & Space(2))
                            MessageList.Add(optRollUpAuthorityString9)
                            MessageList.Add("")
                            MessageList.Add("IS THAT CORRECT, OVER?")
                        End If
                    Else
                        RollupReadString = RightLimits
                        RollUpEventText = "ROLLUP EVENT: REPORTING CLEAR OF " & RightLimits
                        If Me.AuthType1 = "ItemTwoToTrain" Then
                            MessageList.Add(Me.IssueTo)
                            MessageList.Add("ON TRACK WARRANT NUMBER:" & Me.AuthorityUID)
                            'MessageList.Add("REPORTING CLEAR OF " & RightLimits)
                            MessageList.Add("RELEASING CLEAR OF " & RightLimits)
                        Else
                            MessageList.Add(Me.IssueTo)
                            MessageList.Add("RELEASING THAT PART OF TRACK WARRANT NUMBER:" & Me.AuthorityUID)
                            MessageList.Add("BETWEEN " & LeftLimits & " AND " & RightLimits)
                        End If
                        MessageList.Add("AT  'TIME'" & Format(ReportTime, "HH:mm"))
                        MessageList.Add("")
                        MessageList.Add("WITHIN NON-ABS AND DT ABS TERRITORY FOR TRAINS - ALL " & gTWCVariableName & " TERRITORY FOR MW'UNDERLINE'")
                        MessageList.Add("")
                        MessageList.Add("DISPATCHER MUST JOB BRIEF WITH EMPLOYEE RELEASING AUTHORITY")
                        MessageList.Add("INCLUDING ALL OF THE FOLLOWING INFORMATION:")
                        MessageList.Add("")
                        MessageList.Add("POSITION OF SWITCHES OPERATED AND/OR TRAVERSED WITHIN THE LIMITS BEING RELEASED")
                        MessageList.Add("ALL SWITCHES OPERATED ARE LOCKED (or NO SWITCHES OPERATED/HANDLED),")
                        MessageList.Add("POSITION OF SWITCH FORM COMPLETED (or NO ENTRIES REQUIRED).")
                        MessageList.Add("")
                        MessageList.Add("IF CORRECT, DISPATCHER MUST REPEAT THE BRIEFING INFORMATION PROVIDED AND INQUIRE ('IS THAT CORRECT?') ")
                        MessageList.Add("")
                        MessageList.Add("SELECT YES TO CONFIRM REQUIRED BRIEFING HAS OCCURRED.")
                        'RollUpEventPTCBOSAPIText = RollUpEventPTCText & 
                        If optEnablePTCBOSAPIMode Then
                            If Me.AuthType1 = "ItemTwoToTrain" Then
                                RollUpEventPTCBOSAPIText = PTCBOSReportTime & "~" & RightLimits
                            Else
                                RollUpEventPTCBOSAPIText = PTCBOSReportTime & "~" & "BETWEEN " & LeftLimits & " AND " & RightLimits
                                RollupReadString = "BETWEEN " & LeftLimits & " AND " & RightLimits
                            End If
                        End If
                    End If
                Else
                    ClearSelection()
                    MessageList = Nothing
                    Return False
                End If

                'SHOW MESSAGE BOX PROMPT TO RELEASE TRACKS
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = pTrackSelected.CurrentDrawingForm
                'LaunchPoint.Y = LaunchPoint.Y + 30
                frmMessageBox.theSFAuth = Me
                Dim PTCtrn As TrainID = Nothing
                Dim trnPTC As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIssueToAuthority(Me.IssueTo)
                If Not IsNothing(trnPTC) Then
                    If Me.PTCTypeAuthority Then
                        If trnPTC.PTCStatus <> "ACTIVE" Then
                            TrainIsActivePTC = False
                            SystemEvent("ROLLUP AUTHORITY:" & Me.AuthorityUID & ". TRAIN:" & trnPTC.IdentifingUnit & " IS NOT PTC ACTIVE.")
                        End If
                    End If
                End If
                If optEnablePTCBOSAPIMode Then
                    frmMessageBox.EMT_PRS_AuthorityVerbiage = RollUpEventPTCBOSAPIText
                    If PTCTypeAuthority And TrainIsActivePTC Then
                        If optEnableCheckTrnPTCStatusBeforeRollup Then
                            frmMessageBox.PTCTrainStatus = Me.CheckTrainPTCStatus(trnPTC)
                            If Not Me.CheckToVerifyPositionOnRollUp(True) Then
                                ClearSelection()
                                Return False
                            End If
                        End If
                        frmMessageBox.theTrain = trnPTC
                        frmMessageBox.theSFAuth = Me
                        frmMessageBox.CheckPTCTrainStatus = True
                        frmMessageBox.theRollUpCompList = RollUpList.Clone
                        frmMessageBox.isRollUpEvent = True
                    End If
                    If optReportRollupWithTimer Then
                        frmMessageBox.SetMessage(MessageList, optRollUpAuthorityString12 & Me.AuthorityUID, True, LaunchPoint, Nothing, True, False, Nothing, Nothing, False, False, False, optUseReadRepeatMessageBoxOnAuthorityRelease)
                    Else
                        frmMessageBox.SetMessage(MessageList, optRollUpAuthorityString12 & Me.AuthorityUID, True, LaunchPoint, Nothing, False, False, Nothing, Nothing, False, False, False, optUseReadRepeatMessageBoxOnAuthorityRelease)
                    End If
                ElseIf Me.PTCTypeAuthority And TrainIsActivePTC And Not optEnablePTCBOSVETMSMode Then
                    If optEnableCheckTrnPTCStatusBeforeRollup Then
                        If Not Me.CheckToVerifyPositionOnRollUp Then
                            ClearSelection()
                            Return False
                        End If
                    End If
                    TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainStatusRequest(PTCtrn)
                    TMDS.SystemForms.MySystemForms.frmMessageBox = frmMessageBox
                    PTCtrn = TMDS.SystemUtilities.FetchData.FindTrainFromIssueToAuthority(Me.IssueTo)
                    frmMessageBox.theSFAuth = Me
