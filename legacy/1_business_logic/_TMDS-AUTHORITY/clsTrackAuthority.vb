#Region "TRACK SEGMENT"

        Private Function BuildTrackSegments(ByVal RemoveList As ArrayList, Optional ByVal isPartialCancelMRS As Boolean = False) As ArrayList
            Dim tempList As ArrayList = ComponentsInSelection.Clone
            Dim SegmentList As New ArrayList
            Dim theFlipFlopTrack As Track = Nothing
            Dim FlipFlopFound As Boolean
            Dim FliopFlopNOTFound As Boolean
            Dim comp As Object
            Dim isCompFlipFlopPartOfRemoveList As Boolean
            Try
                AuthorityEventLog("BuildTrackSegments:Start")
                IsPartialCancel = isPartialCancelMRS
                If Not IsNothing(RemoveList) Then
                    For Each comp In RemoveList
                        tempList.Remove(comp)
                        AuthorityEventLog("BuildTrackSegments:RemoveList=" & comp.GUID.ToString & ":" & comp.Name & ":" & comp.FlipMe.ToString & ":" & comp.TrafficDirection)
                        'this supports licensing through a flipflop when one exists for MRS operations
                        'MRS-297
                        'check for flipflop in the remove list. if it exists then turn the license direction
                        If optEnableMRSSpecificPTCOperations Then
                            If comp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(comp, Track)
                            End If
                            Select Case comp.GetType.ToString
                                Case gTrackComponentName, gSwitchComponentName
                                    comp.FlipMe = False
                                Case gFlipFlopComponentName
                                    If Not IsPartialCancel Then
                                        FlipFlopFound = True
                                    End If
                                    isCompFlipFlopPartOfRemoveList = True
                            End Select
                        End If
                        'this supports licensing through a flipflop when one exists for MRS operations
                        'MRS-297
                    Next
                End If
                For Each comp In tempList
                    If comp.GetType.ToString = gFlipFlopComponentName Then
                        FliopFlopNOTFound = False
                        Exit For
                    Else
                        FliopFlopNOTFound = True
                    End If
                Next
                'if flipflop in remove list detected then change the license direction and be sure the remaining track components have the correct direction 
                'this supports licensing through a flipflop when one exists for MRS operations
                'MRS-297
                If optEnableMRSSpecificPTCOperations Then
                    If FlipFlopFound AndAlso isCompFlipFlopPartOfRemoveList AndAlso Not FliopFlopNOTFound Then
                        If Direction = "LEFT" Then
                            Direction = "RIGHT"
                            AuthorityEventLog("BuildTrackSegments:Direction1 changed to RIGHT due to FlipFlop")
                        Else
                            Direction = "LEFT"
                            AuthorityEventLog("BuildTrackSegments:Direction1 changed to LEFT due to FlipFlop")
                        End If
                        UpdateDatabaseWithDirectionChange()
                        For Each comp In tempList
                            If comp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(comp, Track)
                                trk.FlipMe = False
                                trk.TrafficDirection = Direction
                                trk.ApplyTraffic()
                                trk.UpdateStatus(Nothing)
                            ElseIf comp.GetType.ToString = gSwitchComponentName Then
                                Dim s As Switch = CType(comp, Switch)
                                s.FlipMe = False
                            End If
                        Next
                    ElseIf FlipFlopFound AndAlso isCompFlipFlopPartOfRemoveList AndAlso FliopFlopNOTFound Then
                        If Direction = "LEFT" Then
                            Direction = "RIGHT"
                            AuthorityEventLog("BuildTrackSegments:Direction2 changed to RIGHT due to FlipFlop")
                        Else
                            Direction = "LEFT"
                            AuthorityEventLog("BuildTrackSegments:Direction2 changed to LEFT due to FlipFlop")
                        End If
                        UpdateDatabaseWithDirectionChange()
                        For Each comp In tempList
                            If comp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(comp, Track)
                                trk.FlipMe = False
                                trk.TrafficDirection = Direction
                                trk.ApplyTraffic()
                                trk.UpdateStatus(Nothing)
                            ElseIf comp.GetType.ToString = gSwitchComponentName Then
                                Dim s As Switch = CType(comp, Switch)
                                s.FlipMe = False
                            End If
                        Next
                    End If
                End If
                If Me.myTrain.IsBIDirectional Then
                    Me.BiDirectional = True
                End If
                'this supports licensing through a flipflop when one exists for MRS operations
                'MRS-297
                'if flipflop in remove list detected then change the license direction and be sure the remaining track components have the correct direction 
                Dim FlipFlopDetected As Boolean
                Dim LoopControl As Integer
                While tempList.Count > 0
                    'remove all the turn out tracks
                    For Each comp In ComponentsInSelection
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim tk As Track = CType(comp, Track)
                            If tk.TurnOutType Then
                                tempList.Remove(tk)
                            ElseIf tk.NonTransverable Then
                                tempList.Remove(tk)
                            End If
                            If Me.IsPartialCancel Then
                                'REMOVE NONE CONTROLLED TRACK FROM LIST.
                                If Not tk.IsControlledForPTC AndAlso Not tk.IsTestForPTC Then
                                    tempList.Remove(tk)
                                    tempList.Remove(comp)
                                    Dim guid As Integer = tk.GUID
                                End If
                            End If
                        End If
                    Next
                    Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(tempList)
                    ''MRS HOT FIX
                    If IsPartialCancel Then
                        If FirstTrack Is Nothing AndAlso tempList.Count > 0 Then
                            For Each comp In tempList
                                If comp.GetType.ToString = gFlipFlopComponentName Then
                                    tempList.Remove(comp)
                                    Exit For
                                End If
                            Next
                        End If
                    End If
                    If Not IsNothing(FirstTrack) Then
                        Dim newSegment As New TrackSegment
                        newSegment.AddToList(Direction, tempList, FirstTrack, FlipFlopDetected)
                        If Not SegmentList.Contains(newSegment) Then SegmentList.Add(newSegment) 'Else Beep()
                    End If
                    If tempList IsNot Nothing AndAlso tempList.Count = 1 Then
                        If tempList(0).GetType.ToString = gFlipFlopComponentName Then
                            tempList = New ArrayList
                        End If
                    End If
                    If LoopControl > 100 Then
                        Return Nothing
                    End If
                    LoopControl += 1
                End While
                Dim oldCompList As New ArrayList
                Dim newCompList As New ArrayList
                For Each comp In Me.ComponentsInSelection
                    AuthorityEventLog("BuildTrackSegments:OldList=" & comp.GUID.ToString & ":" & comp.Name & ":" & comp.FlipMe.ToString & ":" & comp.TrafficDirection)
                    oldCompList.Add(comp)
                Next
                Dim sg As TrackSegment
                For Each sg In SegmentList
                    For Each comp In sg.myCompList
                        AuthorityEventLog("BuildTrackSegments:NewList=" & comp.GUID.ToString & ":" & comp.Name & ":" & comp.FlipMe.ToString & ":" & comp.TrafficDirection)
                        newCompList.Add(comp)
                    Next
                Next
                Return SegmentList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Class TrackSegment
            Public myCompList As New ArrayList
            Public myTrackName As String
            Public myDirection As String
            Public FlipFlopDetected As Boolean

            Public Sub AddToList(ByVal theDirection As String, ByRef RemoveList As ArrayList, ByVal theTrk As Track, ByRef FlipFlopFound As Boolean)
                Try
                    Dim Flipme As Boolean = FlipFlopFound
                    Dim Prefix As String = String.Empty
                    Dim Suffix As String = String.Empty
                    Dim PreviousTrkPrefix As String = ""
                    Dim PreviousTrkSubID As Integer
                    If Prefix <> "" Then
                        PreviousTrkPrefix = Prefix
                    End If
                    Dim myTrack As Track = Nothing
                    myTrack = FindStartingTrackInOS(theTrk, theDirection, RemoveList)
                    Dim NextComp As Object = myTrack
                    myTrackName = myTrack.TrackNameAlias
                    Prefix = myTrack.MilePostPrefix
                    Suffix = myTrack.MilePostSuffix
                    PreviousTrkSubID = myTrack.SubdivisionID
                    myDirection = theDirection
                    If myTrack.OStype Then
                        Dim mySw As Switch = Nothing
                        If theDirection = "RIGHT" Then
                            If FlipFlopFound Then
                                mySw = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(myTrack.RightLink)

                            Else
                                mySw = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(myTrack.LeftLink)
                            End If
                        ElseIf theDirection = "LEFT" Then
                            If FlipFlopFound Then
                                mySw = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(myTrack.LeftLink)

                            Else
                                mySw = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(myTrack.RightLink)

                            End If

                        End If
                        If Not IsNothing(mySw) Then
                            If Not myCompList.Contains(mySw.NormalTrackTrailingPortion) Then
                                myCompList.Add(mySw.NormalTrackTrailingPortion)
                                RemoveList.Remove(mySw.NormalTrackTrailingPortion)
                            End If
                            RemoveList.Remove(mySw)
                        End If
                    End If

                    Dim LastTrackNameAlias As String = ""
                    If theDirection = "RIGHT" Then

                        Dim lc As Integer

                        'RMT626-Track limit CRC error after a long rollup with wrong limits
                        'Change from 100 to 200
                        'jcosta-9/5/17

                        While lc < 200
                            ' If DidDirectionChange = "RIGHT" Then
                            If NextComp.GetType.ToString <> gSignalComponentName AndAlso NextComp.GetType.ToString <> gFlipFlopComponentName Then

                                If NextComp.GetType.ToString = gTrackComponentName Then
                                    Dim trk As Track = CType(NextComp, Track)
                                    trk.FlipMe = Flipme
                                    Dim myguid As Integer = trk.GUID
                                    If myguid = 159109 Then
                                        Beep()
                                    End If
                                    If LastTrackNameAlias.Trim = "" Then LastTrackNameAlias = trk.TrackNameAlias

                                    'If trk.TurnOutType Then
                                    '    Exit Sub
                                    'End If
                                    If Not trk.TurnOutType Then
                                        'If LastTrackNameAlias.Trim <> "" AndAlso LastTrackNameAlias <> trk.TrackNameAlias Then
                                        '    Exit Sub
                                        'End If
                                        If Not trk.TurnOutType AndAlso trk.TrackNameAlias <> myTrackName OrElse trk.MilePostPrefix <> Prefix OrElse trk.MilePostSuffix <> Suffix OrElse trk.SubdivisionID <> PreviousTrkSubID Then
                                            Exit Sub
                                        End If
                                    End If



                                    If RemoveList.Contains(NextComp) Then
                                        'If LastTrackNameAlias.Trim <> "" AndAlso LastTrackNameAlias <> trk.TrackNameAlias Then
                                        '    Exit Sub
                                        'End If
                                        If Not myCompList.Contains(NextComp) Then
                                            If NextComp.GetType.ToString = gTrackComponentName AndAlso NextComp.NonTransverable Then
                                                LastTrackNameAlias = NextComp.TrackNameAlias
                                                RemoveList.Remove(NextComp)
                                            Else
                                                myCompList.Add(NextComp)
                                                RemoveList.Remove(NextComp)
                                            End If

                                            If RemoveList.Count = 0 Then Exit While
                                        End If
                                    Else
                                        'If theTrk.Name = NextComp.name Then 'AndAlso theTrk.myControlPoint.AssignedTracks.Contains(NextComp) Then
                                        '    myCompList.Add(NextComp)
                                        'Else
                                        '    Exit Sub
                                        'End If

                                    End If

                                    PreviousTrkSubID = trk.SubdivisionID
                                End If
                            End If
                            If NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)
                                If sw.RightAltLink <> 0 Then


                                    If sw.ControlledReverse Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                        '**********************************************************
                                        If optEnableLicenseGenerationForPTC Then
                                            Dim BSw As Switch = Nothing
                                            If sw.BrotherSwitches IsNot Nothing AndAlso sw.BrotherSwitches.Count > 0 Then
                                                For Each BSw In sw.BrotherSwitches
                                                    If BSw IsNot sw Then Exit For
                                                Next
                                                If BSw IsNot Nothing Then
                                                    RemoveList.Remove(BSw)
                                                End If
                                            End If
                                        End If
                                        '**********************************************************
                                        If Not myCompList.Contains(sw.NormalTrackTrailingPortion) Then

                                            sw.NormalTrackTrailingPortion.NormalLegOfSwitch = True

                                            If sw.NormalTrackTrailingPortion.TrackNameAlias <> myTrackName Then
                                                Exit Sub
                                            End If

                                            'If RemoveList.Contains(sw.NormalTrackTrailingPortion.GUID = 152107) AndAlso Not sw.NormalTrackTrailingPortion.Occuppied Then

                                            'End If
                                            myCompList.Add(sw.NormalTrackTrailingPortion)
                                            RemoveList.Remove(sw.NormalTrackTrailingPortion)
                                            'End If
                                            ' myCompList.Add(sw.NormalTrackTrailingPortion)
                                            ' RemoveList.Remove(sw.NormalTrackTrailingPortion)
                                        End If
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                                Else
                                    If Flipme Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                                End If
                                RemoveList.Remove(sw)
                            Else
                                If Flipme Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)

                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                                If NextComp Is Nothing Then Exit While
                                If NextComp.GetType.ToString = gFlipFlopComponentName Then
                                    Flipme = True
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                            End If
                            lc += 1
                        End While


                    Else

                        Dim lc As Integer

                        'RMT626-Track limit CRC error after a long rollup with wrong limits
                        'Change from 100 to 200
                        'jcosta-9/5/17

                        While lc < 200

                            If RemoveList.Count = 0 Then Exit Sub

                            If NextComp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(NextComp, Track)
                                trk.FlipMe = FlipFlopFound

                                If Not trk.TurnOutType Then
                                    If trk.TrackNameAlias <> myTrackName OrElse trk.MilePostPrefix <> Prefix OrElse trk.MilePostSuffix <> Suffix OrElse trk.SubdivisionID <> PreviousTrkSubID Then
                                        Exit Sub
                                    End If
                                End If

                                If RemoveList.Contains(NextComp) Then
                                    If Not myCompList.Contains(NextComp) Then
                                        myCompList.Add(NextComp)
                                        RemoveList.Remove(NextComp)

                                    End If
                                Else
                                    'If theTrk.Name = NextComp.name Then ' AndAlso theTrk.myControlPoint.AssignedTracks.Contains(NextComp)  Then
                                    '    myCompList.Add(NextComp)
                                    'Else
                                    'Exit Sub
                                    'End If
                                End If
                            End If
                            If NextComp.GetType.ToString = gFlipFlopComponentName Then
                                If RemoveList.Contains(NextComp) Then
                                    If Not myCompList.Contains(NextComp) Then
                                        myCompList.Add(NextComp)
                                        RemoveList.Remove(NextComp)
                                    End If
                                End If

                            End If
                            If NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)

                                If sw.LeftAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                        '**********************************************************
                                        If optEnableLicenseGenerationForPTC Then
                                            Dim BSw As Switch = Nothing
                                            If sw.BrotherSwitches IsNot Nothing AndAlso sw.BrotherSwitches.Count > 0 Then
                                                For Each BSw In sw.BrotherSwitches
                                                    If BSw IsNot sw Then Exit For
                                                Next
                                                If BSw IsNot Nothing Then
                                                    RemoveList.Remove(BSw)
                                                End If
                                            End If
                                        End If
                                        '**********************************************************
                                        If Not myCompList.Contains(sw.NormalTrackTrailingPortion) Then

                                            sw.NormalTrackTrailingPortion.NormalLegOfSwitch = True

                                            If sw.NormalTrackTrailingPortion.TrackNameAlias <> myTrackName Then
                                                Exit Sub
                                            End If

                                            'If RemoveList.Contains(sw.NormalTrackTrailingPortion) AndAlso Not sw.NormalTrackTrailingPortion.Occuppied Then
                                            '    If sw.NormalTrackTrailingPortion.GUID = 152107 Then
                                            '    End If
                                            'End If


                                            'If sw.NormalTrackTrailingPortion.GUID = 152107 Then
                                            '    Beep()
                                            'End If

                                            If Flipme Then
                                                If (Not sw.NormalTrackTrailingPortion.GUID = 152107 AndAlso Not sw.ControlledReverse) Then
                                                    myCompList.Add(sw.NormalTrackTrailingPortion)
                                                    RemoveList.Remove(sw.NormalTrackTrailingPortion)
                                                End If
                                            Else
                                                myCompList.Add(sw.NormalTrackTrailingPortion)
                                                RemoveList.Remove(sw.NormalTrackTrailingPortion)
                                            End If


                                            '  End If

                                            'End If

                                            '  NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                        End If
                                    Else
                                        '   NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                        If Flipme Then
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                        End If

                                    End If

                                Else
                                    If Flipme Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                        If Not myCompList.Contains(sw.NormalTrackTrailingPortion) Then
                                            myCompList.Add(sw.NormalTrackTrailingPortion)
                                            RemoveList.Remove(sw.NormalTrackTrailingPortion)
                                        End If
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    End If

                                End If
                                RemoveList.Remove(sw)
                                'Exit Sub
                            Else
                                Dim PreviousGUID As Int32 = NextComp.GUID
                                If Flipme Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                                If NextComp.GetType.ToString = gFlipFlopComponentName Then
                                    Flipme = True
                                    If RemoveList.Contains(NextComp) Then
                                        If Not myCompList.Contains(NextComp) Then
                                            myCompList.Add(NextComp)
                                            RemoveList.Remove(NextComp)
                                        End If
                                    End If

                                    FlipFlopDetected = True
                                    FlipFlopFound = True
                                    If PreviousGUID = NextComp.LeftLink Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    End If

                                End If


                            End If

                            lc += 1
                        End While


                    End If

                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try
            End Sub

            Private Function FindStartingTrackInOS(ByVal theTrk As Track, ByVal theDirection As String, Optional CompList As ArrayList = Nothing) As Track

                Try
                    Dim FlipMe As Boolean = False
                    If IsNothing(theTrk.OsComponentCollection) Then Return theTrk
                    If theDirection = "RIGHT" Then
                        Dim lc As Integer
                        Dim NextComp As Object = theTrk
                        Dim LastComp As Object = theTrk
                        While lc < 100
                            'If FlipMe Then
                            '    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            'Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            'End If
                            If IsNothing(NextComp) Then Return theTrk
                            Select Case NextComp.GetType.ToString
                                Case gSignalComponentName
                                    If theTrk.OsComponentCollection.Contains(LastComp) Then
                                        If LastComp.GetType.ToString = gTrackComponentName AndAlso LastComp.TurnOutType Then
                                        ElseIf LastComp.GetType.ToString = gTrackComponentName AndAlso CompList.Contains(LastComp) Then
                                            Return LastComp
                                        End If
                                    End If
                                    'Return LastComp
                                Case gTrackComponentName
                                    If Not theTrk.OsComponentCollection.Contains(NextComp) Then
                                        If LastComp.GetType.ToString = gTrackComponentName AndAlso LastComp.TurnOutType Then
                                        ElseIf LastComp.GetType.ToString = gTrackComponentName AndAlso CompList.Contains(LastComp) Then
                                            Return LastComp
                                        End If
                                    End If
                                    'Then Return LastComp
                                Case gSwitchComponentName
                                    If LastComp.GetType.ToString = gTrackComponentName AndAlso LastComp.TurnOutType Then
                                    ElseIf LastComp.GetType.ToString = gTrackComponentName AndAlso CompList.Contains(LastComp) Then
                                        Return LastComp
                                    End If

                                Case gFlipFlopComponentName
                                    'Return LastComp
                                    If LastComp.GetType.ToString = gTrackComponentName AndAlso LastComp.TurnOutType Then
                                    ElseIf LastComp.GetType.ToString = gTrackComponentName AndAlso CompList.Contains(LastComp) Then
                                        Return LastComp
                                    End If
                            End Select

                            LastComp = NextComp
                        End While
                    Else
                        Dim lc As Integer
                        Dim NextComp As Object = theTrk
                        Dim LastComp As Object = theTrk
                        While lc < 100
                            'If Not FlipMe Then
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            'Else
                            'NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            'End If
                            If IsNothing(NextComp) Then Return theTrk
                            Select Case NextComp.GetType.ToString
                                Case gSignalComponentName
                                    If CompList IsNot Nothing AndAlso theTrk.OsComponentCollection.Contains(LastComp) Then
                                        If (LastComp.GetType.ToString = gTrackComponentName AndAlso Not LastComp.TurnOutType) Then
                                            Return LastComp
                                        End If
                                    Else
                                        If theTrk.OsComponentCollection.Contains(LastComp) Then
                                            Return LastComp
                                        End If
                                    End If
                                Case gTrackComponentName
                                    If CompList IsNot Nothing AndAlso theTrk.OsComponentCollection.Contains(LastComp) Then
                                        If (LastComp.GetType.ToString = gTrackComponentName AndAlso Not LastComp.TurnOutType) Then
                                            Return LastComp
                                        End If
                                    Else
                                        If theTrk.OsComponentCollection.Contains(LastComp) Then
                                            Return LastComp
                                        End If
                                    End If


                                    'If Not theTrk.OsComponentCollection.Contains(NextComp) AndAlso (LastComp.GetType.ToString = gTrackComponentName AndAlso Not LastComp.TurnOutType) Then
                                    '    Return LastComp
                                    'End If

                                Case gSwitchComponentName
                                    'If (LastComp.GetType.ToString = gTrackComponentName AndAlso Not LastComp.TurnOutType) Then Return LastComp

                                    If CompList IsNot Nothing AndAlso theTrk.OsComponentCollection.Contains(LastComp) Then
                                        If (LastComp.GetType.ToString = gTrackComponentName AndAlso Not LastComp.TurnOutType) Then
                                            Return LastComp
                                        End If
                                    Else
                                        If theTrk.OsComponentCollection.Contains(LastComp) Then
                                            Return LastComp
                                        End If
                                    End If

                                Case gFlipFlopComponentName
                                    Return LastComp
                            End Select
                            LastComp = NextComp
                        End While

                    End If
                    Return Nothing
                Catch ex As Exception
                    SystemException(ex.ToString)
                    Return Nothing
                End Try
            End Function

