        Public Function UpdateDatabaseWithPTCAuthorityStatus(ByVal Status As String) As Boolean
            Dim WarrantUpdateSQL As String = ""
            Dim dbconn As OleDbConnection = Nothing
            Dim CommandUpdate As OleDbCommand = Nothing
            Try


                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)

                WarrantUpdateSQL = "UPDATE " & gtblSFAActive
                WarrantUpdateSQL = WarrantUpdateSQL & " SET PTCAuthorityStatus = " & "'" & Status & "'"
                WarrantUpdateSQL = WarrantUpdateSQL & " WHERE AuthGUID = '" & Me.AuthGUID & "'" ' " WHERE AuthorityUID = " & "'" & Me.AuthorityUID & "'"

                CommandUpdate = New OleDbCommand(WarrantUpdateSQL, dbconn)

                dbconn.Open()
                CommandUpdate.ExecuteNonQuery()
                'dbconn.Close()
                'CommandUpdate = Nothing
                'dbconn = Nothing
                Return True
            Catch ex As Exception
                GetErrorDetails(ex, "Sql: " & WarrantUpdateSQL)
                Return False
            Finally
                If Not dbconn Is Nothing Then
                    If dbconn.State <> ConnectionState.Closed Then dbconn.Close()
                    dbconn.Dispose()
                    dbconn = Nothing
                End If
                If Not CommandUpdate Is Nothing Then
                    CommandUpdate.Dispose()
                    CommandUpdate = Nothing
                End If
                Dim SummItem1 As New SummaryItem("AUTHORITY", "UPDATE-PTC-STATUS", Me)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem1)
                End SyncLock
            End Try
        End Function

