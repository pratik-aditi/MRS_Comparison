                                        End If
                                    End If
                                End If
                                'Version 236
                            Else
                                Exit While
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                            Dim rr As RRXING = CType(NextComp, RRXING)
                            If rr.TrackName = TrackSelected.TrackName And TrackSelected.OStype Then
