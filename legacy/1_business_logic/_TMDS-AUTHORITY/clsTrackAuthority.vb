        ''' <summary>
        ''' Perform Issuance
        ''' </summary>
        ''' <param name="signal"></param>
        ''' <param name="enterTrack"></param>
        ''' <param name="exitTrack"></param>
        ''' <param name="components"></param>
        ''' <param name="stopTarget"></param>
        Public Sub VETMS_PerformIssuance(Optional signal As Signal = Nothing,
                                         Optional enterTrack As Track = Nothing,
                                         Optional exitTrack As Track = Nothing,
                                         Optional components As ArrayList = Nothing,
                                         Optional stopTarget As Boolean = False)
            Try
                AuthorityEventLog(GetCurrentMethod.Name)
                PTCMessageUID = Format(Now, "yyyyMMddHHmmssfff")
                PTCMarkedToBeIssuedElectronically = True
                PTCTypeAuthority = True
                UpdateMovementAuthorityText()
                PTCAuthoritySegments = GetTrackSegmentListEMT_PSS(components)
                If stopTarget Then PTCAuthoritySegments = GetTrackSegmentListEMT_PSS(components)
                UpdateDatabaseWithPTCAuthoritySegments()
                If UpdateDatabaseWithPTCAuthorityStatus("AUTHORITY-SENT") Then
                    Dim summaryItem As New SummaryItem("SPLAUTHORITY", "UPDATE-PTC-STATUS", Me)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(summaryItem)
                    End SyncLock
                End If
                PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ISSUE.ToString
                PTCAuthorityComponents = ComponentsInSelection.Clone
                If Not stopTarget Then UpdateDatabaseWithPTCComponents()
                PTCStatus = "AUTHORITY-SENT"
                SetPTCAuthorityFlasherStatus()
                If Not optDisableFlashingTrackForPTC Then FlasherMode(True, True)
                If signal IsNot Nothing Then
                    IsTrackWarrantEnforcementEnabled = signal.IsTrackWarrantEnforcementEnabled
                    If Not IsTrackWarrantEnforcementEnabled Then
                        AppendAuthoritySegment(signal)
                    End If
                    UpdateDatabaseWithPTCAuthoritySegments()
                End If
                Select Case SubType
                    Case "EMT"
                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_MovementAuthorityMessageCreate_EnterMainTrack(Me, myTrain, PTCMessageUID)
                    Case "PSS"
                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.SendCreateSpecialAuthorityToBOS(Me, myTrain, PTCMessageUID)
                End Select
                VETMS_CreateTimerIssuanceEvent()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

