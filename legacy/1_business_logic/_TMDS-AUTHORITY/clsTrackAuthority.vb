                    Me.MobileClientLastName = Me.MobileClientForeman.LastName
                    CreateDigitalSignature()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Generates a digital signature using PBKDF2 and HMAC-SHA256 based on <see cref="AuthGUID"/> and
        ''' <see cref="MobileClientPIN"/>.
        ''' </summary>
        ''' <remarks>
        ''' Derives a 256-bit key using <see cref="System.Security.Cryptography.Rfc2898DeriveBytes"/> with
        ''' SHA-256 and 100000 iterations, using <see cref="AuthGUID"/> as salt. The signature is computed via
        ''' <see cref="System.Security.Cryptography.HMACSHA256"/> over the GUID and encoded as an uppercase
        ''' hexadecimal string.
        ''' </remarks>
        Private Sub CreateDigitalSignature()
            Try
                If String.IsNullOrEmpty(AuthGUID) OrElse String.IsNullOrEmpty(MobileClientPIN) Then
                    MobileClientDSA = String.Empty
                    Exit Sub
                End If
                Dim salt As Byte() = System.Text.Encoding.UTF8.GetBytes(AuthGUID)
                Const pbkdf2Iterations As Integer = 100000
                Const derivedKeyLengthBytes As Integer = 32      ' 256 bits
                Const hmacOutputLengthBytes As Integer = 32      ' HMAC-SHA256 -> 32 bytes
                Dim derivedKey As Byte()
                Using kdf As New System.Security.Cryptography.Rfc2898DeriveBytes(
                    MobileClientPIN,
                    salt,
                    pbkdf2Iterations,
                    System.Security.Cryptography.HashAlgorithmName.SHA256)
                    derivedKey = kdf.GetBytes(derivedKeyLengthBytes)
                End Using
                Dim message As Byte() = System.Text.Encoding.UTF8.GetBytes(AuthGUID)
                Dim signedHash As Byte()
                Using hmac As New System.Security.Cryptography.HMACSHA256(derivedKey)
                    signedHash = hmac.ComputeHash(message)
                End Using
                Dim sb As New System.Text.StringBuilder(hmacOutputLengthBytes * 2)
                For Each bt As Byte In signedHash
                    sb.Append(bt.ToString("X2"))
                Next
                MobileClientDSA = sb.ToString()
                Array.Clear(derivedKey, 0, derivedKey.Length)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function RollUpAuthority(ByRef TrackSelected As Track, ByVal ReleaseDirection As String) As Boolean
            Dim EndOfWarrantFound As Boolean = False
            Dim NextComp As Object = Nothing
            Dim CurrentComp As Object = Nothing
            Dim warr As TrackAuthority
            Dim LeftLimits As String = String.Empty
            Dim RightLimits As String = String.Empty
            Dim RollUpEventMessage As String = String.Empty
            Dim comp As Object
            Dim TrackNameList As New ArrayList()
            Dim Flip As Boolean
            Dim gHistoryMessage As String
            Dim trn As TrainID
            Dim theTrain As TrainID = Nothing
            Dim TrackSelectedOsCompList As New ArrayList()
            If TrackSelected.NonTransverable AndAlso Not optEnableARRCSpecificOptions Then
                If Not optEnableARRCSpecificOptions Then
                    gHistoryMessage = "AUTHORITY NO: " & Me.AuthorityUID & vbCrLf & " INVALID ROLLUP SEGMENT(S) OR DIRECTION SELECTED."
                    MessageBox.Show(gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    SystemEvent(gHistoryMessage)
                End If
                Return False
            End If
            'TrackSelectedOsCompList.Add(TrackSelected)
            'TrackSelected.AddOSComponents(TrackSelectedOsCompList)
            'TrackSelected.ExtendOSComponents(TrackSelectedOsCompList)
            If optApplyConfigurationForKCT Then
                TrackSelectedOsCompList.Add(TrackSelected)
                TrackSelected.ExpandOutForComponents(TrackSelectedOsCompList)
                'TrackSelected.ExtendOSComponents(TrackSelectedOsCompList)
            ElseIf optEnableARRCSpecificOptions Then
                TrackSelectedOsCompList.Add(TrackSelected)
                TrackSelected.AddOSComponents(TrackSelectedOsCompList)
                TrackSelected.ExtendOSComponents(TrackSelectedOsCompList)
                TrackSelected.ExpandOutForComponents(TrackSelectedOsCompList)
                IncludeLikeTracksForRollup(TrackSelectedOsCompList)
                FindLikeComponents(TrackSelectedOsCompList, TrackSelectedOsCompList)
            Else
                TrackSelectedOsCompList.Add(TrackSelected)
                TrackSelected.AddOSComponents(TrackSelectedOsCompList)
                TrackSelected.ExtendOSComponents(TrackSelectedOsCompList)
            End If



            RollUpList.Clear()

            Try
                Dim ReportTime As String

                For Each comp In Me.ComponentsInSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.TimeZone <> "" Then
                            CurrentTimeZone = Mid(comp.TimeZone, 1, 1)
                            Exit For
                        End If
                    End If
                Next

                Select Case CurrentTimeZone
                    Case "E"
                        ReportTime = Format(Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor)), "HH:mm")
                    Case "M"
                        ReportTime = Format(Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor)), "HH:mm")
                    Case "P"
                        ReportTime = Format(Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor)), "HH:mm")
                    Case "A"
                        ReportTime = Format(Now.AddHours(CDbl(-3 + gThisWorkstationTimeFactor)), "HH:mm")
                    Case Else
                        ReportTime = Format(Now.AddHours(CDbl(gThisWorkstationTimeFactor)), "HH:mm")
                End Select


                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.IdentifingUnit.Trim = Me.IssueTo.Trim Then
                        'Direction = trn.Direction ' Not sure who addded this line. We should not Change the authority direction(Right or Left) based on Train's Direction North or South. -Raja. 
                        theTrain = trn
                        Exit For
                    End If
                Next

                Dim FirstSelectedTrack As Track = TrackSelected
                Dim NewReportTime As Date
                If optEnableTimeZoneSettings AndAlso FirstSelectedTrack IsNot Nothing AndAlso FirstSelectedTrack.mySubdivision IsNot Nothing Then
                    NewReportTime = GenerateTime(FirstSelectedTrack.mySubdivision)
                    ReportTime = Format(NewReportTime, "HH:mm")
                End If

                Dim LoopControl As Integer
                CurrentComp = TrackSelected

                CurrentComp = TrackSelected
                Dim TopPoint As Int32
                If TrackSelected.Top + 600 < TrackSelected.CurrentDrawingForm.Height Then
                    TopPoint = TrackSelected.Top + 100
                Else
                    TopPoint = 150
                End If
                'Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + TrackSelected.CurrentDrawingForm.Width / 2 - 100, TopPoint)
                Dim LaunchPoint As New Point(TrackSelected.CurrentDrawingForm.Left + TrackSelected.CurrentDrawingForm.Width / 2 - 100, TopPoint)
                If ReleaseDirection = "RIGHT" Then
                    Dim LastComp As Object = Nothing
                    If CurrentComp.LeftLink <> 0 Then
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.LeftLink)
                    Else
                        EndOfWarrantFound = True
                    End If
                    While Not EndOfWarrantFound
                        If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Or NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then

                            If NextComp.TrackAuthorities.Count = 0 Then
                                Exit While
                            End If

                            warr = Me.FindAuthority(NextComp)
                            If IsNothing(warr) Then
                                EndOfWarrantFound = True
                                Exit While
                            End If
                            If warr.AuthorityUID <> Me.AuthorityUID Then
                                Exit While
                            ElseIf warr.AuthorityUID = Me.AuthorityUID Then
                                If optEnableBRCSpecificChecks AndAlso NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If Not RollUpList.Contains(NextComp) Then
                                        RollUpList.Add(NextComp)
                                    End If
                                ElseIf (optEnableARRCSpecificOptions OrElse optApplyConfigurationForKCT) AndAlso NextComp.GetType.ToString = gTrackComponentName AndAlso Not TrackSelectedOsCompList.Contains(NextComp) Then
                                    If Not RollUpList.Contains(NextComp) Then RollUpList.Add(NextComp)
                                End If
                            End If
                            If NextComp.StationNumber = TrackSelected.StationNumber And
                            (NextComp.Name = TrackSelected.Name Or (NextComp.TrackName = TrackSelected.TrackName And TrackSelected.OStype And NextComp.OStype)) Then
                                'Beep()
                            ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" And
                                    TrackSelected.LeftLink = NextComp.GUID Then
                                'Beep()
                            Else
                                If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(NextComp, Switch)

                                    Dim IncludeSwitch As Boolean

                                    If Not IsNothing(TrackSelected.OsComponentCollection) Then
                                        If Not TrackSelected.OsComponentCollection.Contains(sw) Then
                                            IncludeSwitch = True
                                        End If
                                    Else
                                        IncludeSwitch = True
                                    End If

                                    If IncludeSwitch Then
                                        IncludeSwitch = False
                                        If Not RollUpList.Contains(NextComp) Then
                                            RollUpList.Add(NextComp)
                                        End If

                                        Dim OsTrack As ArrayList = sw.OsComponentCollection 'trk.GetAllOSComponents(True)
                                        If Not OsTrack Is Nothing Then
                                            Dim trkCheck As Object
                                            For Each trkCheck In OsTrack
                                                If trkCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                    If (trkCheck.Name = TrackSelected.Name Or (trkCheck.TrackName = TrackSelected.TrackName And TrackSelected.OStype And trkCheck.OStype)) And trkCheck.StationNumber = TrackSelected.StationNumber Then
                                                        'Beep()
                                                    Else
                                                        If trkCheck.TrackAuthorities.Count > 0 Then
                                                            Dim warrToCheck As TrackAuthority
                                                            For Each warrToCheck In trkCheck.TrackAuthorities
                                                                If warrToCheck.AuthorityUID = Me.AuthorityUID Then
                                                                    If Not RollUpList.Contains(trkCheck) Then
                                                                        RollUpList.Add(trkCheck)
                                                                        Exit For
                                                                    End If
                                                                End If
                                                            Next
                                                        End If
                                                    End If
                                                    Dim rr As TMDS.TrackOtherComponents.RRXING = TMDS.SystemUtilities.FetchData.FindCompRRXINGFromGUID(trkCheck.RightLink)
                                                    If Not IsNothing(rr) Then
                                                        If rr.TrackName = TrackSelected.TrackName And TrackSelected.OStype Then
                                                            'do nothing 
                                                        Else
                                                            Dim TrackList As ArrayList = rr.FindAllTracksConnected
                                                            If Not IsNothing(TrackList) Then
                                                                Dim compInList As Object
                                                                For Each compInList In TrackList
                                                                    If compInList.TrackAuthorities.Count > 0 Then
                                                                        Dim Nextwarr As TrackAuthority
                                                                        For Each Nextwarr In compInList.TrackAuthorities
                                                                            If Nextwarr.AuthorityUID = Me.AuthorityUID Then
                                                                                If Not RollUpList.Contains(compInList) Then
                                                                                    RollUpList.Add(compInList)
                                                                                End If
                                                                            End If
                                                                        Next
                                                                    End If
                                                                Next
                                                            End If
                                                        End If
                                                    End If
                                                ElseIf trkCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                                    If trkCheck.TrackName = TrackSelected.TrackName And trkCheck.StationNumber = TrackSelected.StationNumber And TrackSelected.OStype Then
                                                        'DO NOTHING
                                                    Else
                                                        If Not RollUpList.Contains(trkCheck) Then
                                                            RollUpList.Add(trkCheck)
                                                            'Exit For
                                                        End If
                                                    End If
                                                End If
                                            Next
                                        End If
                                    End If
                                    'End If

                                ElseIf NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If (NextComp.LeftLimitName = TrackSelected.LeftLimitName And NextComp.RightLimitName = TrackSelected.RightLimitName) Then
                                        'Beep()
                                    Else
                                        Dim trk As Track = CType(NextComp, Track)
                                        If Not RollUpList.Contains(trk) Then
                                            RollUpList.Add(NextComp)
                                        End If
                                    End If

                                End If
                            End If
                            CurrentComp = NextComp
                            If CurrentComp.LeftLink <> 0 Then
                                If CurrentComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(CurrentComp, Switch)
                                    If optEnableARRCSpecificOptions AndAlso sw.TypeOfSwitch.ToUpper.Trim = "DERAIL" Then
                                        LastComp = NextComp
                                        If Flip Then
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.LeftLink)
                                        End If
                                    Else
                                        If Flip Then
                                            NextComp = FoundExitTrackOfRollUpOutOfSwitch(sw, Me, "RIGHT", RollUpList, LastComp)
                                        Else
                                            NextComp = FoundExitTrackOfRollUpOutOfSwitch(sw, Me, "LEFT", RollUpList, LastComp)
                                        End If

                                        If IsNothing(NextComp) Then
                                            For Each comp In sw.OsComponentCollection
                                                If (comp.Name = TrackSelected.Name Or comp.TrackName = TrackSelected.TrackName) And comp.StationNumber = TrackSelected.StationNumber Then
                                                    Exit While
                                                End If
                                                If Not RollUpList.Contains(comp) Then
                                                    RollUpList.Add(comp)
                                                End If
                                            Next
                                            Exit While
                                        ElseIf optApplyConfigurationForKCT AndAlso Not TrackSelectedOsCompList.Contains(sw) Then
                                            For Each comp In sw.OsComponentCollection
                                                If comp.Name = TrackSelected.Name And comp.StationNumber = TrackSelected.StationNumber Then
                                                    ' Exit For
                                                End If

                                                If Not RollUpList.Contains(comp) Then
                                                    RollUpList.Add(comp)
                                                End If
                                            Next
                                        End If
                                    End If
                                Else
                                    LastComp = NextComp
                                    If Flip Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentComp.LeftLink)
                                    End If
                                End If
                                If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    ' do nothing
                                ElseIf FirstSelectedTrack.TrackName = NextComp.TrackName And FirstSelectedTrack.StationNumber = NextComp.StationNumber Then
                                    'do nothing
                                Else
                                    If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
