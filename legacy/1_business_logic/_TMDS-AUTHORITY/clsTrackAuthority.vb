        Public Sub CreateReducedLimitsVerbiage()
            Dim RollupLimitVerbiage As String = "TRACK & TIME GRANTED ON " '& BoxTrack & " TRACK||"

            Try
                If optEnableCPSpecificOptions Then
                    Dim FirstTrack As Track = Nothing
                    Dim LastTrack As Track = Nothing
                    Try
                        If Me.AuthorityType = "TT" Then
                            If Me.RollUpEvents IsNot Nothing AndAlso Me.RollUpEvents.Count > 0 Then
                                FirstTrack = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(Me.ComponentsInSelection)
                                LastTrack = TMDS.SystemUtilities.FetchData.FindLastTrackInList(Me.ComponentsInSelection)
                                Dim FromLimit As String = ""
                                Dim ToLimit As String = ""
                                Dim GrantedON As String = ""
                                If Me.Direction = "RIGHT" Then
                                    FromLimit = FirstTrack.LeftLimitName
                                    ToLimit = LastTrack.RightLimitName
                                    GrantedON = FirstTrack.TrackName
                                Else
                                    FromLimit = FirstTrack.RightLimitName
                                    ToLimit = LastTrack.LeftLimitName
                                    GrantedON = FirstTrack.TrackName
                                End If
                                RollupLimitVerbiage = RollupLimitVerbiage & GrantedON.Trim.ToUpper & "|"
                                If FromLimit.Trim.ToUpper <> ToLimit.Trim.ToUpper Then
                                    RollupLimitVerbiage = RollupLimitVerbiage & " BETWEEN " & FromLimit.Trim.ToUpper & "|"
                                    RollupLimitVerbiage = RollupLimitVerbiage & " AND " & ToLimit.Trim.ToUpper & "||"
                                Else
                                    RollupLimitVerbiage = RollupLimitVerbiage & " AT " & FromLimit.Trim.ToUpper & "||"
                                End If
                                ReducedLimitsVerbiage = RollupLimitVerbiage
                            End If
                        End If
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    Finally
                        FirstTrack = Nothing
                        LastTrack = Nothing
                    End Try
                End If


                Dim Limits() As String = Me.AuthorityLimits.Split("|")
                Dim VerbiageLimits, EachLine As String
                For Each EachLine In Limits 'I = 0 To Limits.Length - 1
                    If EachLine <> "" Then
                        VerbiageLimits = ""
                        Select Case Mid(EachLine, 1, 4)
                            Case "GRAN"
                                VerbiageLimits = EachLine.Remove(0, 8)
                                ReducedLimitsVerbiage = ReducedLimitsVerbiage & VerbiageLimits.ToUpper & "| |"
                                'LongMessage.Add(VerbiageLimits.ToUpper)
                            Case "BETW"
                                Dim datastring() As String = EachLine.Split(",")
                                If datastring.Length = 3 Then
                                    VerbiageLimits = "BETWEEN " & datastring(1)
                                ElseIf datastring.Length = 2 Then
                                    VerbiageLimits = datastring(0)
                                Else
                                    VerbiageLimits = EachLine
                                End If
                                'LongMessage.Add(VerbiageLimits.ToUpper)
                                ReducedLimitsVerbiage = ReducedLimitsVerbiage & VerbiageLimits.ToUpper & "| |"
                            Case "AND "
                                Dim datastring() As String = EachLine.Split(",")
                                If datastring.Length = 3 Then
                                    VerbiageLimits = "AND " & datastring(1)
                                ElseIf datastring.Length = 2 Then
                                    VerbiageLimits = datastring(0)
                                Else
                                    VerbiageLimits = EachLine
                                End If
                                'LongMessage.Add(VerbiageLimits.ToUpper)
                                ReducedLimitsVerbiage = ReducedLimitsVerbiage & VerbiageLimits.ToUpper & "| |"
                            Case Else
                                VerbiageLimits = EachLine
                                ReducedLimitsVerbiage = ReducedLimitsVerbiage & VerbiageLimits.ToUpper & "| |"

                        End Select

                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Create Reduced Limits Verbiage SFA
        ''' </summary>
        Public Sub CreateReducedLimitsVerbiageSFA()
            Dim Limits() As String
            Dim VerbiageLimits, EachLine As String
            Try
                Limits = Me.AuthorityLimits.Split("|")
                For Each EachLine In Limits 'I = 0 To Limits.Length - 1
                    If EachLine <> "" Then
                        VerbiageLimits = ""
                        Select Case Mid(EachLine, 1, 10)
                            Case "[X BOX  6]", "[X CAJA 6]"
                                ReducedLimitsVerbiage = ReducedLimitsVerbiage & Mid(EachLine, 11) & "-"
                        End Select
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Limits = Nothing
                VerbiageLimits = Nothing
                EachLine = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Add license to components
        ''' </summary>
        ''' <param name="pCompList"></param>
        ''' <param name="pBeginTrack"></param>
        ''' <param name="pTrain"></param>
        ''' <param name="pAuthLimitsVerbiage"></param>
        ''' <param name="pSignalRouteList"></param>
        ''' <param name="pAuthorityExists"></param>
        ''' <returns></returns>
        Public Overridable Function AddLicenseToComponents(ByVal pCompList As ArrayList, ByVal pBeginTrack As Track, ByVal pTrain As TrainID,
                                                           ByVal pAuthLimitsVerbiage As String, ByVal pSignalRouteList As ArrayList, ByVal pAuthorityExists As Boolean) As Boolean
            Dim terrList As New ArrayList
            Dim terrID As Int32
            Dim index As Integer
            Dim trk As Track
            Dim comp As Object
            Dim flip As FlipFlop = Nothing
            Dim flipCount As Integer = 0
            Dim flipLastUid As Integer
            Try
                If pAuthorityExists Then
                    ComponentsInSelection.Clear()
                End If
                Me.CreateDate = Now
                Me.mySignalRouteListForLicenseInPTC = pSignalRouteList.Clone
                If Not pAuthorityExists Then
                    AuthorityNumber = TMDS.GlobalDeclarations.gThisWorkstation.GetNextAuthorityNumber()
                    RailRoadName = "MRS"
                End If
                If AuthorityNumber <= 0 Then
                    AuthorityNumber = CInt(Format(Now, "hhmmssfff"))
                End If
                DispatcherName = gCurrentUser.Initials
                AuthorityDate = Format(Now, "MM/dd/yyyy HH:mm") ' Now
                AuthorityType = "TA"
                IssueTo = pTrain.IdentifingUnit
                OKTime = Now
                AuthorityLimits = pAuthLimitsVerbiage
                Me.AuthorityUID = AuthorityNumber.ToString
                Me.TerritoryAssignment = pBeginTrack.TerritoryID
                If pCompList.Count > 0 Then
                    For Each comp In pCompList
                        Select Case comp.GetType.ToString
                            Case gTrackComponentName, gSwitchComponentName, gFlipFlopComponentName, gSignalComponentName
                                ComponentsInSelection.Add(comp)
                        End Select
                    Next
                Else
                    Return False
                End If
                If pCompList.Count > 0 Then
                    For Each comp In pCompList
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            trk = CType(comp, Track)
                            If Not terrList.Contains(trk.TerritoryID) Then
                                terrList.Add(trk.TerritoryID)
                            End If
                        End If
                    Next
                Else
                    Return False
                End If
                For Each terrID In terrList
                    Select Case index
                        Case 0
                            Me.TerritoryAssignment = terrID
                            index = 1
                        Case 1
                            Me.TerritoryAssignmentSecondary = terrID
                            index = 2
                        Case 2
                            Me.TerrIDTeritary = terrID
                            index = 3
                        Case 3
                            Me.TerrIDQuadtary = terrID
                        Case Else
                    End Select
                Next
                terrList.Clear()
                ''****************************************************************************************
                ''**   ADD AUTHORITY TO TRACKS
                ''*****************************************************************************************
                If ComponentsInSelection.Count > 0 Then
                    'this supports licensing through a flipflop when one exists for MRS operations
                    'MRS-297
                    If optEnableMRSSpecificPTCOperations Then
                        For Each comp In ComponentsInSelection
                            'set any component that has flipme ti false
                            If comp.GetType.ToString = gTrackComponentName OrElse comp.GetType.ToString = gSwitchComponentName Then
                                comp.FlipMe = False
                            End If
                        Next
                        For Each comp In ComponentsInSelection
                            Dim FlipFlopFound As Boolean
                            If FlipFlopFound Then
                                If comp.GetType.ToString = gTrackComponentName OrElse comp.GetType.ToString = gSwitchComponentName Then
                                    comp.FlipMe = True
                                End If
                            End If
                            'If comp.GetType.ToString = gTrackComponentName Then
                            '    trk = CType(comp, Track)
                            '    If trk.IsLinkToFlipFlopToLeft OrElse trk.IsLinkToFlipFlopToRight Then
                            '        flip = TMDS.SystemUtilities.FetchData.FindFlipFlop(trk.LeftLink)
                            '        If flip Is Nothing Then
                            '            flip = TMDS.SystemUtilities.FetchData.FindFlipFlop(trk.RightLink)
                            '        End If
                            '        If flip Is Nothing Then
                            '            Continue For
                            '        End If
                            '        If Direction = "LEFT" Then
                            '            FlipFlopFound = True
                            '            AuthorityEventLog("AddLicenseToComponents:Left:FLIPFLOP=" & flip.GUID.ToString & ":" & flip.Name)
                            '            If flipLastUid <> flip.GUID Then
                            '                flipLastUid = flip.GUID
                            '                flipCount += 1
                            '            End If
                            '            'This invert direction of license to next flipflop
                            '            If (flipCount Mod 2) = 0 Then
                            '                FlipFlopFound = False
                            '            End If
                            '        Else
                            '            FlipFlopFound = True
                            '            AuthorityEventLog("AddLicenseToComponents:Right:FLIPFLOP=" & flip.GUID.ToString & ":" & flip.Name)
                            '            If flipLastUid <> flip.GUID Then
                            '                flipLastUid = flip.GUID
                            '                flipCount += 1
                            '            End If
                            '            'This invert direction of license to next flipflop
                            '            If (flipCount Mod 2) = 0 Then
                            '                FlipFlopFound = False
                            '            End If
                            '        End If
                            '    End If
                            'End If
                            If comp.GetType.ToString = gFlipFlopComponentName Then
                                flip = CType(comp, FlipFlop)
                                FlipFlopFound = True
                                AuthorityEventLog("AddLicenseToComponents:FLIPFLOP=" & comp.GUID.ToString & ":" & comp.Name)
                                If flipLastUid <> flip.GUID Then
                                    flipLastUid = flip.GUID
                                    flipCount += 1
                                End If
                                'This invert direction of license to next flipflop
                                If (flipCount Mod 2) = 0 Then
                                    FlipFlopFound = False
                                End If
                            End If
                        Next
                    End If
                    'this supports licensing through a flipflop when one exists for MRS operations
                    'MRS-297
                    For Each comp In ComponentsInSelection
                        If Not comp.TrackAuthorities.Contains(Me) Then
                            AuthorityEventLog("AddLicenseToComponents:Add=" & comp.GUID.ToString & ":" & comp.Name & ":" & comp.FlipMe.ToString & ":" & comp.TrafficDirection)
                            Try
                                comp.TrackAuthorities.Add(Me)
                            Catch ex As Exception
                                SystemException(ex.ToString)
                            End Try
                        End If
                        comp.TrackAuthority = True
                        comp.UpdateStatus()
                    Next
                Else
                    Return False
                End If
                If Not pAuthorityExists Then
                    OtherTrackAuthorities.Add(Me)
                    AuthorityEventLog("AddLicenseToComponents:FOUND FOR AUTHORITY")
                ElseIf Not OtherTrackAuthorities.Contains(Me) Then
                    OtherTrackAuthorities.Add(Me)
                    AuthorityEventLog("AddLicenseToComponents:NOT FOUND FOR AUTHORITY")
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                terrList = Nothing
                terrID = Nothing
                index = Nothing
                trk = Nothing
                comp = Nothing
                flip = Nothing
            End Try
        End Function

        Public Overridable Function AddTrackAuthorityToSystem(ByVal frmTA As frmTrackAuthority, ByVal CompSelection As ArrayList, ByVal GlobalTrackAuthorities As ArrayList) As Boolean
            Dim TrackTimeType As Boolean
            Dim FoulTimeType As Boolean
            Dim TrackPermitType As Boolean

            Try
                Dim I As Integer

                Dim TerrList As New ArrayList()
                Me.TrackReservationGUID = frmTA.TrackReservationUID
                IssuedToMobileClient = frmTA.MobileClient
                RailRoadName = frmTA.RailRoadName
                DispatcherName = frmTA.Disp
                AuthorityDate = Format(Now, "MM/dd/yyyy HH:mm")
                AuthorityNumber = CInt(frmTA.AuthorityNumber)
                Direction = frmTA.Direction
                AuthorityType = frmTA.TrackAuthorityType
                IssueTo = frmTA.IssueTo
                Me.MobileClientForeman = frmTA.MobileClientForeman
                OKTime = CDate(frmTA.OKTime)
                AuthorityLimits = frmTA.AuthorityLimitsVerbiage
                Me.AuthorityUID = frmTA.AuthorityNumberString
                Me.IssuedToTrain = frmTA.IssuedToTrain
                Me.RelayedTo = frmTA.cmbAtLoc.Text
                Me.CopiedBy = frmTA.ClearTime

                Me.NoticeTime = frmTA.nudClearTime.Value
                Me.UntilReleased = frmTA.chkUntilReleased.CheckState

                Dim TrnString As String
                If frmTA.AuthorityBehindTrains.Count > 0 Then
                    Me.BehindTrains = New ArrayList()
                End If
                For Each TrnString In frmTA.AuthorityBehindTrains
                    Me.BehindTrains.Add(TrnString)
                Next

                Dim VehString As String
                If Not frmTA.VehicleAssociations Is Nothing Then
                    If frmTA.VehicleAssociations.Count > 0 Then
                        Me.VehicleAssociations = New ArrayList()
                    End If
                    For Each VehString In frmTA.VehicleAssociations
                        Me.VehicleAssociations.Add(VehString)
                    Next
                End If
                Me.JointAuthority = frmTA.LockToJoint

                Dim JointString As String
                For Each JointString In frmTA.AuthorityJointLimits
                    JointLimits = JointLimits & JointString & "-"
                Next

                UntilTime = frmTA.UntilTime
                Me.TerritoryAssignment = frmTA.CurrentSelectedTerritory.TerritoryID

                Select Case Mid(AuthorityType, 1, 2)
                    Case "TT"
                        TrackTimeType = True
                    Case "FT"
                        FoulTimeType = True
                    Case "TP"
                        TrackPermitType = True

                    Case Else
                        TrackTimeType = True
                End Select

                If CompSelection.Count > 0 Then
                    Dim comp As Object
                    For Each comp In CompSelection
                        ComponentsInSelection.Add(comp)
                    Next
                Else
                    Return False
                End If

                Dim PublishAuthorityStatus As Boolean
                Dim PublishingTerritory As Territory = Nothing

                If CompSelection.Count > 0 Then
                    Dim comp As Object
                    For Each comp In CompSelection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If trk.myControlPoint.AllowStatusPublishing And Not PublishAuthorityStatus Then
                                PublishAuthorityStatus = True
                                If IsNothing(PublishingTerritory) Then
                                    PublishingTerritory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(trk.TerritoryID)
                                End If
                            End If
                            If Not TerrList.Contains(trk.TerritoryID) Then
                                TerrList.Add(trk.TerritoryID)
                            End If
                        End If
                    Next
                Else
                    Return False
                End If

                Dim TerrID As Int32
                Dim Index As Integer
                For Each TerrID In TerrList
                    Select Case Index
                        Case 0
                            Me.TerritoryAssignment = TerrID
                            Index = 1
                        Case 1
                            Me.TerritoryAssignmentSecondary = TerrID
                            Index = 2
                        Case 2
                            Me.TerrIDTeritary = TerrID
                            Index = 3
                        Case 3
                            Me.TerrIDQuadtary = TerrID
                        Case Else

                    End Select
                Next
                TerrList.Clear()
                TerrList = Nothing
                ''****************************************************************************************
                ''**   ADD AUTHORITY TO TRACKS
                ''*****************************************************************************************
                If CompSelection IsNot Nothing AndAlso CompSelection.Count > 0 Then
                    Dim comp As Object
                    For Each comp In CompSelection
                        If comp.GetType.ToString <> gFlipFlopComponentName Then
                            If Not comp.TrackAuthorities.Contains(Me) Then comp.TrackAuthorities.Add(Me)
                            comp.BlockAbsolute = True
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                'comp.RemotePendingBlock = False
                            End If
                            comp.TrackAndTime = TrackTimeType
                            comp.FoulTime = FoulTimeType
                            comp.TrackPermit = TrackPermitType
                            comp.UpdateStatus()
                        End If
                    Next
                Else
                    Return False
                End If

                GlobalTrackAuthorities.Add(Me)
                CreateReducedLimitsVerbiage()

                If PublishAuthorityStatus Then
                    Dim Message As String = "DC" & Chr(6) & "AUTHSTAT;"
                    Message = Message & "|" & PublishingTerritory.TerritoryID.ToString
                    Message = Message & "|ACTION=ADD"
                    Message = Message & "|GUID=" & Me.AuthorityUID
                    Message = Message & "|ISSUED=" & Format(Now, "MM-dd-yyyy HH:mm")
                    Dim TrackList As String = String.Empty
                    Dim comp As Object
                    I = 0
                    For Each comp In Me.ComponentsInSelection

                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If I = 0 Then
                                TrackList = TrackList & comp.GUID.ToString & "@" & comp.myControlPoint.GUID.ToString & "@" & trk.Name
                                I = 1
                            Else
                                TrackList = TrackList & "-" & comp.GUID.ToString & "@" & comp.myControlPoint.GUID.ToString & "@" & trk.Name
                            End If
                        End If
                    Next
                    Message = Message & "|TRKLIST=" & TrackList

                    Message = PublishingTerritory.TerritoryID.ToString & Chr(12) & Message

                    SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                        TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                    End SyncLock
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Dim ErrorMessage As String = optAuthErrorAdding '"Error Adding Track Authority To System. CALL SYSTEM ADMINISTRATOR!"
                'MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, optAuthErrorAddingMsgBox)
                ClearSystemVariables()
            End Try
        End Function

        Public Function RemoveActiveAuthorityFromComponents(ByVal dbConnection As OleDbConnection, Optional ByVal SetSignalStatusToStop As Boolean = False) As Boolean
            Dim comp As Object
            Dim PublishAuthorityStatus As Boolean
            Dim PublishingTerritory As Territory = Nothing

            Try
                For Each comp In Me.ComponentsInSelection
                    Try

                        Select Case comp.GetType.ToString
                            Case gTrackComponentName, gSwitchComponentName, gRRXINGComponentName

                                comp.TrackAuthorityRemoveFromMe(Me)
                                'comp.TrackAuthorities.Remove(Me)
                                comp.UpdateStatus()
                                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Or comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                    comp.Flasher.Interval = 250
                                    comp.FlashOn = False
                                    comp.FlashComponent = False
                                    If Me.AuthorityType = "FT" Then
                                        comp.FoulTime = False
                                    Else
                                        comp.FoulTime = False
                                    End If

                                    ' Not sure why we are resetting Track's Traffic direction for TNT authorites. So add an condition to Satisfy CP's RMT 1088
                                    If Not optEnableCPSpecificOptions Then
                                        Dim RemoveTraffic As Boolean = True
                                        If comp.GetType.ToString = gTrackComponentName Then
                                            If comp.TrainIDs.Count > 0 Then
                                                RemoveTraffic = False
                                            End If
                                        End If
                                        If RemoveTraffic Then
                                            comp.TrafficDirection = ""
                                        End If
                                    End If

                                    If SetSignalStatusToStop Then
                                        comp.SignalStatOnMe = Track.SignalStatus.SignalAtStop
                                    End If

                                    comp.UpdateStatus()

                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" And Not PublishAuthorityStatus Then
                                        Dim trk As Track = CType(comp, Track)
                                        If trk.myControlPoint.AllowStatusPublishing And Not PublishAuthorityStatus Then
                                            PublishAuthorityStatus = True
                                            If IsNothing(PublishingTerritory) Then
                                                PublishingTerritory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(trk.TerritoryID)
                                            End If
                                        End If
                                    End If
                                End If
                        End Select

                    Catch ex As Exception
                        SystemException(ex.ToString)
                    End Try
                Next

                ResetCompToCodeBrown(Me.ComponentsInSelection)


                If PublishAuthorityStatus Then
                    Dim Message As String = "DC" & Chr(6) & "AUTHSTAT;"
                    Message = Message & "|" & PublishingTerritory.TerritoryID.ToString
                    Message = Message & "|ACTION=REMOVE"
                    Message = Message & "|GUID=" & Me.AuthorityUID
                    Message = Message & "|ISSUED=" & Format(Me.OKTime, "MM-dd-yyyy HH:mm")
                    Dim TrackList As String = String.Empty
                    Dim i As Integer = 0
                    For Each comp In Me.ComponentsInSelection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If i = 0 Then
                                TrackList = TrackList & comp.GUID.ToString & "@" & comp.myControlPoint.GUID.ToString
                                i = 1
                            Else
                                TrackList = TrackList & "-" & comp.GUID.ToString & "@" & comp.myControlPoint.GUID.ToString
                            End If
                        End If
                    Next
                    Message = Message & "|TRKLIST=" & TrackList
                    Message = PublishingTerritory.TerritoryID.ToString & Chr(12) & Message

                    SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                        TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                    End SyncLock
                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try

        End Function

