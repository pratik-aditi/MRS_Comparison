                                Dim warr As SFAuthority
                                For Each warr In AddTWtoComp.TrackAuthorities
                                    If warr.AuthorityUID = VoidedWarrantByThisOne.AuthorityUID Then
                                        AddTWtoComp.TrackAuthorities.Insert(AddTWtoComp.TrackAuthorities.IndexOf(VoidedWarrantByThisOne), Me)
                                        AddTWtoComp.UpdateStatus()
                                        WarrantFoundToInsert = True
                                        Exit For
                                    End If
                                Next

                                If Not WarrantFoundToInsert Then
                                    If Not AddTWtoComp.TrackAuthorities.Contains(Me) Then
                                        AddTWtoComp.TrackAuthorities.Add(Me)
                                        AddTWtoComp.UpdateStatus()
                                    End If
                                Else
                                    WarrantFoundToInsert = False
                                End If
                            Else
                                If Not AddTWtoComp.TrackAuthorities.Contains(Me) Then
                                    AddTWtoComp.TrackAuthorities.Add(Me)
                                    AddTWtoComp.UpdateStatus()
                                End If
                            End If

                            If AddTWtoComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If gDisplayTrackAuthorityNumbers Then
                                    Dim trk As Track = CType(AddTWtoComp, Track)
                                    trk.InitAuthorityNumbers()
                                End If
                            End If
                        Next
                    Else
                        For Each AddTWtoComp In SFA.CompleteCompSelection
                            If Not AddTWtoComp.TrackAuthorities.Contains(Me) Then
                                AddTWtoComp.TrackAuthorities.Add(Me)
                            End If
                            If AddTWtoComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If gDisplayTrackAuthorityNumbers Then
                                    Dim trk As Track = CType(AddTWtoComp, Track)
                                    trk.InitAuthorityNumbers()
                                End If
                            End If
                            AddTWtoComp.UpdateStatus()
                        Next
                    End If

                    If gSwitchPointMonitoringExists Then
                        Me.CheckForAdjacentSPMS(SFA.CompleteCompSelection)
                    End If
                    If gTrackIntegrityMonitoringExists Then

                    End If
                Else
                    Return False
                End If


                If Not SFA.SecondaryCompSelection Is Nothing Then
                    Dim AddTWtoComp As Object
                    'For Each AddTWtoComp In SFA.SecondaryCompSelection
                    '    If AddTWtoComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                    '        Dim sw As Switch = CType(AddTWtoComp, Switch)
                    '        sw.BoxThirteenControlled = False
                    '    End If
                    'Next

                    Dim WarrantFoundToInsert As Boolean
                    If SFA.SecondaryCompSelection.Count > 0 Then
                        If ThisWarrantReplacingAnother Then
                            For Each AddTWtoComp In SFA.SecondaryCompSelection
                                If AddTWtoComp.TrackAuthorities.Count > 0 Then
                                    Dim warr As SFAuthority
                                    For Each warr In AddTWtoComp.TrackAuthorities
                                        If warr.AuthorityUID = VoidedWarrantByThisOne.AuthorityUID Then
                                            AddTWtoComp.Authorities.Insert(AddTWtoComp.TrackAuthorities.IndexOf(VoidedWarrantByThisOne), Me)
                                            AddTWtoComp.UpdateStatus()
                                            WarrantFoundToInsert = True
                                            Exit For
                                        End If
                                    Next
                                    If Not WarrantFoundToInsert Then
                                        AddTWtoComp.TrackAuthorities.Add(Me)
                                        AddTWtoComp.UpdateStatus()
                                    Else
                                        WarrantFoundToInsert = False
                                    End If
                                Else
                                    AddTWtoComp.TrackAuthorities.Add(Me)
                                    AddTWtoComp.UpdateStatus()
                                End If
                            Next
                        Else
                            For Each AddTWtoComp In SFA.SecondaryCompSelection
                                AddTWtoComp.TrackAuthorities.Add(Me)
                                AddTWtoComp.UpdateStatus()
                            Next
                        End If

                        If gSwitchPointMonitoringExists Then
                            Me.CheckForAdjacentSPMS(SFA.SecondaryCompSelection)
                        End If
                    Else
                        Return False
                    End If
                End If

                TMDS.GlobalDeclarations.OtherTrackAuthorities.Add(Me)
                CreateReducedLimitsVerbiage()
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Dim ErrorMessage As String = "Error Adding Track Warrant To System. CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                SystemForms.MySystemForms.frmTrackWarrant.Close()
                ClearSystemVariables()
                Return False
            Finally

            End Try
        End Function

        ''' <summary>
        ''' Add Auth To Components MRS
        ''' </summary>
        ''' <param name="pSFA"></param>
        ''' <returns></returns>
        Public Overloads Function AddAuthorityToComponentsMRS(ByVal pSFA As frmSingleAuthorityFormMRS) As Boolean
            Dim trk As Track
            Dim sw As Switch
            Dim ChangeDirection As String
            Dim sfa As SFAuthority
            Try
                With pSFA
                    Me.RailRoadName = .RailwayName
                    Me.Subdivision = ""
                    Me.TimeZone = .CurrentTimeZone
                    Me.DispName = .DispName
                    Me.Direction = .DirectionOfTheWarrant
                    Me.AuthType1 = .FirstTypeOfWarrant
                    Me.isSpecialLicense = .isTWCSpecialLicense
                    AuthDate = Now
                    OKTime = CDate("00:00")
                    TerrID1 = .CurrentSelectedTerritory.TerritoryID
                    TerrID2 = 0
                    TerrID3 = 0
                    AuthType1 = .FirstTypeOfWarrant
                    If Me.isSpecialLicense Then
                        AuthType2 = "SPECIAL LICENSE"
                    Else
                        AuthType2 = .SecondTypeOfWarrant
                    End If
                    AuthType3 = .SecondTypeOfWarrant
                    AuthorityNumber = .AuthorityNumber
                    AuthorityUID = .AuthorityNumberString
                    IssuedToTrain = .IssuedToTrain
                    IssueTo = .IssueTo
                    Me.Box1Void = .BoxOneVoid.Clone
                    Box2From1 = String.Empty
                    Box2To1 = String.Empty
                    Box2Track1 = String.Empty
                    Me.TrainSymbol = .TrainSymbol
                    For Each comp As Object In .CompleteCompSelection
                        Me.Components.Add(comp)
                    Next
                    For i As Integer = 0 To 13
                        Me.CheckBoxItemsStatus.Add(i)
                    Next
                    Me.AuthorityVerbiage = .AuthorityVerbiage
                End With
                ''****************************************************************************************
                ''**   ADD AUTHORITY WARRANT TO TRACKS
                ''*****************************************************************************************
                If pSFA.CompleteCompSelection.Count > 0 Then
                    ChangeDirection = Me.Direction
                    For Each Comp As Object In pSFA.CompleteCompSelection
                        If Not Comp.TrackAuthorities.Contains(Me) Then
                            AuthorityEventLog("AddAuthorityToComponentsMRS:AddComp=" & Comp.GUID & ":" & Comp.Name)
                            Comp.TrackAuthorities.Add(Me)
                        End If
                        If Comp.GetType.ToString = gSwitchComponentName Then
                            If gDisplayTrackAuthorityNumbers Then
                                sw = CType(Comp, Switch)
                                If Me.isSpecialLicense AndAlso sw.TrackAuthorities.Count > 1 Then
                                    sw.Occuppied = False
                                    RemoveAuhFromObj(sw, Me)
                                End If
                            End If
                        End If
                        If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If gDisplayTrackAuthorityNumbers Then
                                trk = CType(Comp, Track)
                                If Me.isSpecialLicense AndAlso trk.TrackAuthorities.Count > 1 Then
                                    If trk.TrainIDs.Count = 0 Then
                                        trk.Occuppied = False
                                    End If
                                    RemoveAuhFromObj(trk, Me)
                                End If
                                trk.TrafficDirection = ChangeDirection
                                trk.InitAuthorityNumbers()
                            End If
                        End If
                        If Comp.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                            If ChangeDirection = "LEFT" Then
                                ChangeDirection = "RIGHT"
                            Else
                                ChangeDirection = "LEFT"
                            End If
                        End If
                        Comp.UpdateStatus()
                    Next
                End If
                TMDS.GlobalDeclarations.OtherTrackAuthorities.Add(Me)
                CreateReducedLimitsVerbiage()
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                SystemForms.MySystemForms.frmTrackWarrant.Close()
                ClearSystemVariables()
                Return False
            Finally
                trk = Nothing
                sw = Nothing
                ChangeDirection = Nothing
                sfa = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Remove auth from obj
        ''' </summary>
        ''' <param name="pObject"></param>
        ''' <param name="pMySFA"></param>
        Public Sub RemoveAuhFromObj(pObject As Object, pMySFA As SFAuthority)
            Dim sfa As SFAuthority
            Dim sfaAuthorities As New ArrayList
            Try
                sfaAuthorities = pObject.TrackAuthorities.Clone()
                For Each auth As SFAuthority In sfaAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        sfa = CType(auth, SFAuthority)
                        If sfa Is pMySFA Then
                            Continue For
                        End If
                        sfa.Components.Remove(pObject)
                        sfa.Components4.Remove(pObject)
                        pObject.TrackAuthorities.Remove(sfa)
                        sfa.UpdateSFAComponents()
                        AuthorityEventLog("RemoveAuhFromObj:RemoveAuth=" & sfa.AuthorityNumber.ToString & " from track=" & pObject.GUID & ":" & pObject.Name)
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                sfa = Nothing
                sfaAuthorities = Nothing
            End Try
        End Sub

        Public Function CheckAuthoritySequence(ByVal auth As SFAuthority, ByVal FormLaunchPoint As Point) As Boolean
            Try
                Dim au As Object
                For Each au In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If au.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        'If au.IssuedToTrain Then
                        If (auth.IssuedToTrain And Mid(au.IssueTo, 1, 10) = Mid(auth.IssueTo, 1, 10)) Or (Not auth.IssuedToTrain And au.IssueTo = auth.IssueTo) Then
                            If Not au Is auth Then
                                If au.AuthDate < auth.AuthDate Then
                                    Dim frmMessageBox As frmMessageBox
                                    Dim MessageList As New ArrayList()
                                    frmMessageBox = New frmMessageBox()

                                    MessageList.Add("THIS IS NOT THE OLDEST AUTHORITY FOR")
                                    MessageList.Add("(" & au.IssueTo & ")")
                                    MessageList.Add("DO YOU WANT TO PROCEED?")

                                    frmMessageBox.SetMessage(MessageList, "AUTHORITY SEQUENCE CHECK", True, FormLaunchPoint)

                                    Dim Message As String
                                    Dim Response As Boolean
                                    frmMessageBox.ShowDialog()
                                    If frmMessageBox.FormFeedBack = 6 Then
                                        Message = "ANSERED YES TO - THIS IS NOT THE OLDEST AUTHORITY FOR " & au.ISSUETO
                                        Response = True
                                    Else
                                        Message = "ANSERED NO TO - THIS IS NOT THE OLDEST AUTHORITY FOR " & au.ISSUETO
                                        Response = False
                                    End If
                                    SystemEvent(Message)
                                    MessageList.Clear()
                                    MessageList = Nothing
                                    frmMessageBox.Dispose()
                                    frmMessageBox = Nothing
                                    Return Response
                                End If
                            End If
                        End If
                        'End If
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Sub CreateReducedLimitsVerbiage()
            Try
                If Me.Box2From1 <> "" Then
                    If Me.Box2From2 <> "" Then
                        If Me.Box2From3 <> "" Then
                            Me.ReducedLimitsVerbiage = "MULTIPLE LINES (PREVIEW FOR DETAILS) - PROCEED FROM " & Me.Box2From1 & " TO " & Me.Box2To3
                        Else
                            Me.ReducedLimitsVerbiage = "MULTIPLE LINES (PREVIEW FOR DETAILS) - PROCEED FROM " & Me.Box2From1 & " TO " & Me.Box2To2
                        End If
                    Else
                        Me.ReducedLimitsVerbiage = optAuthString1 & Space(1) & Me.Box2From1 & Space(1) & optAuthString2 & Space(1) & Me.Box2To1 & Space(1) & optAuthString3 & Space(1) & Me.Box2Track1
                    End If
                    If Me.AuthType2 = "ItemFourToTrain" Then
                        Me.ReducedLimitsVerbiage = Me.ReducedLimitsVerbiage & " ALSO (" & optAuthString4 & Space(1) & Me.Box4From1 & Space(1) & optAuthString5 & Space(1) & Me.Box4To1 & Space(1) & optAuthString6 & Space(1) & Me.Box4Track1 & ")"
                    End If
                ElseIf Me.Box2From3 <> "" And Me.Box2From1 = "" Then
                    Me.ReducedLimitsVerbiage = optAuthString1 & Space(1) & Me.Box2From3 & Space(1) & optAuthString2 & Space(1) & Me.Box2To3 & Space(1) & optAuthString3 & Space(1) & Me.Box2Track3

                ElseIf Me.Box4From1 <> "" Then

                    If Me.Box4From2 <> "" Then
                        If Me.Box4From3 <> "" Then
                            Me.ReducedLimitsVerbiage = "MULTIPLE LINES (PREVIEW FOR DETAILS) - WORK BETWEEN " & Me.Box4From1 & " AND " & Me.Box4To3
                        Else
                            Me.ReducedLimitsVerbiage = "MULTIPLE LINES (PREVIEW FOR DETAILS) - WORK BETWEEN " & Me.Box4From1 & " AND " & Me.Box4To2
                        End If
                    Else
                        Me.ReducedLimitsVerbiage = optAuthString4 & Space(1) & Me.Box4From1 & Space(1) & optAuthString5 & Space(1) & Me.Box4To1 & Space(1) & optAuthString6 & Space(1) & Me.Box4Track1
                    End If
                End If

                If Me.Box2From3 <> "" Then
                    ContinegentLimitsVerbiage = optAuthString39 & " "
                    Dim trn As String
                    For Each trn In Me.Box5Arrival
                        ContinegentLimitsVerbiage = ContinegentLimitsVerbiage & "(" & trn & ") "
                    Next
                    ContinegentLimitsVerbiage = ContinegentLimitsVerbiage & optAuthString10 & " " & Me.Box5At & " "
                    ContinegentLimitsVerbiage = ContinegentLimitsVerbiage & optAuthString1 & Space(1) & Me.Box2From3 & Space(1) & optAuthString2 & Space(1) & Me.Box2To3 & Space(1) & optAuthString3 & Space(1) & Me.Box2Track3
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckToShowItemFourLimitsOnCreation()
            Try
                Dim auth As Object
                Dim Box5Count As Integer
                Dim FirstBoxFourTrack As Track = FindFirstTrackInList(Me.Box4Components)
                Dim BoxFiveTrain As String
                For Each BoxFiveTrain In Me.Box5Arrival
                    For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                        If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                            If auth.IssueTo = BoxFiveTrain Then
                                Dim BoxFiveArrivalSatisified As Boolean
                                Dim rollUp As String
                                For Each rollUp In auth.RollUpEvents
                                    Dim RollUpEvent() As String = rollUp.Split("|")
                                    If RollUpEvent.Length = 3 Then
                                        Dim CompList() As String = RollUpEvent(2).Split("-")
                                        Dim compNum As String
                                        For Each compNum In CompList
                                            If compNum = FirstBoxFourTrack.GUID.ToString Then
                                                BoxFiveArrivalSatisified = True
                                                Exit For
                                            End If
                                        Next
                                    End If
                                Next

                                Select Case Box5Count
                                    Case 0
                                        Me.BoxFourTrainSatifiedOne = BoxFiveArrivalSatisified
                                    Case 1
                                        Me.BoxFourTrainSatifiedTwo = BoxFiveArrivalSatisified
                                    Case 2
                                        Me.BoxFourTrainSatifiedThree = BoxFiveArrivalSatisified
                                End Select

                            End If
                        End If
                    Next
                    Box5Count += 1
                Next
                If Not Me.ShowItemFourComponents Then
                    Me.CheckToSeeIfBoxFiveTrainInSidingAlready(Me.Box4Components)
                    Me.CheckToSeeIfBoxFiveTrainOnMainBewteenSwitchesAlready(Me.Box4Components)
                End If

                Me.UpdateBoxFourTrainSituation()
                Me.CheckToShowItemFourComponents()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function GetTrackWithExistingAuthority(ByVal trn As TrainID) As Track
            Try
                If IsNothing(trn) Then Return Nothing
                Dim sfa As Object
                For Each sfa In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If sfa.AuthorityUID <> Me.AuthorityUID Then
                        If trn.IdentifingUnit = Mid(sfa.IssueTo, 1, trn.IdentifingUnit.Length) Then
                            Dim trk As Track = sfa.Components(0)
                            If trk.OStype Then
                                If Not IsNothing(trk.OsComponentCollection) Then
                                    Dim comp As Object
                                    For Each comp In trk.OsComponentCollection
                                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            Dim TrkToChk As Track = CType(comp, Track)
                                            If Not TrkToChk.NonTransverable And TrkToChk.TrainIDPlace Then
                                                Return TrkToChk
                                            End If
                                        End If
                                    Next
                                End If
                            End If
                            Return trk
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Sub CheckForAdjacentSPMS(ByVal CompList As ArrayList)
            Try
                Dim TrackList As New ArrayList
                Dim SwList As New ArrayList
                Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(CompList)
                Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(CompList)

                Dim comp As Object
                If Not IsNothing(FirstTrack) Then
                    Dim LeftTk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FirstTrack.LeftLink)
                    Dim RightTk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FirstTrack.RightLink)
                    If Not IsNothing(LeftTk) Then
                        TrackList.Add(LeftTk)
                    End If
                    If Not IsNothing(RightTk) Then
                        TrackList.Add(RightTk)
                    End If
                    Dim trk As Track
                    For Each trk In TrackList
                        If trk.OStype Then
                            For Each comp In trk.OsComponentCollection
                                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    If Not Me.Components.Contains(comp) Then
                                        If Not SwList.Contains(comp) Then
                                            SwList.Add(comp)
                                        End If
                                    End If
                                End If
                            Next
                        End If
                    Next
                    Dim LeftSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(FirstTrack.LeftLink)
                    Dim RightSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(FirstTrack.RightLink)

                    If Not IsNothing(LeftSw) Then
                        If Not Me.Components.Contains(LeftSw) Then
                            If Not SwList.Contains(LeftSw) Then
                                SwList.Add(LeftSw)
                            End If
                        End If
                    End If
                    If Not IsNothing(RightSw) Then
                        If Not Me.Components.Contains(RightSw) Then
                            If Not SwList.Contains(RightSw) Then
                                SwList.Add(RightSw)
                            End If
                        End If
                    End If
                End If

                If Not IsNothing(LastTrack) Then
                    Dim LeftTk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(LastTrack.LeftLink)
                    Dim RightTk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(LastTrack.RightLink)
                    If Not IsNothing(LeftTk) Then
                        TrackList.Add(LeftTk)
                    End If
                    If Not IsNothing(RightTk) Then
                        TrackList.Add(RightTk)
                    End If
                    Dim trk As Track
                    For Each trk In TrackList
                        If trk.OStype Then
                            For Each comp In trk.OsComponentCollection
                                If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    If Not Me.Components.Contains(comp) Then
                                        If Not SwList.Contains(comp) Then
                                            SwList.Add(comp)
                                        End If
                                    End If
                                End If
                            Next
                        End If
                    Next
                    Dim LeftSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(LastTrack.LeftLink)
                    Dim RightSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(LastTrack.RightLink)

                    If Not IsNothing(LeftSw) Then
                        If Not Me.Components.Contains(LeftSw) Then
                            If Not SwList.Contains(LeftSw) Then
                                SwList.Add(LeftSw)
                            End If
                        End If
                    End If
                    If Not IsNothing(RightSw) Then
                        If Not Me.Components.Contains(RightSw) Then
                            If Not SwList.Contains(RightSw) Then
                                SwList.Add(RightSw)
                            End If
                        End If
                    End If
                End If
                Dim sw As Switch
                For Each sw In SwList
                    If sw.SwitchPointerMonitorMode Then
                        If sw.SwitchIndStatus = Switch.SwIndStatus.NoIndication Then
                            sw.CheckForExistingAuthorities()
                        End If
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function CheckToVerifyPositionOnReportClear(Optional ByVal ReplacingAuthorityList As ArrayList = Nothing, Optional ByVal UseEndTrack As Boolean = False, Optional ByVal IgnoreGPS As Boolean = False) As Boolean
            If gPTCLinkDown Then Return True
            Try
                If IgnoreGPS Then Return True
                Dim LocoMilePost As String = ""
                Dim loco As MobileTracking.Locomotive
                Dim LocoFound As MobileTracking.Locomotive = Nothing
                For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
