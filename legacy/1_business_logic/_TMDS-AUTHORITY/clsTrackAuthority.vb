#Region "PROCEDURES"

        Private Function DoesWarrantExistForTrains(ByVal trn As TrainID) As Boolean
            Dim warr As Warrant
            Try
                For Each warr In TrackWarrants
                    If (warr.IssueTo = trn.IdentifingUnit & " " & trn.Direction) And (warr.WarrantNumber <> Me.WarrantNumber) Then
                        Return True
                    End If
                Next
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function FindWarrantIndex(ByVal warr As Warrant, ByVal comp As Object) As Integer
            Dim currWarr As Warrant
            Dim i As Integer
            Try
                If comp.AuthorityCounts > 0 Then
                    For i = 0 To comp.AuthorityCounts - 1
                        currWarr = comp.Authorities(i)
                        If currWarr.WarrantNumber = warr.WarrantNumber Then
                            FindWarrantIndex = i
                            Exit Function
                        End If
                    Next i
                Else
                    FindWarrantIndex = -1
                End If
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try

        End Function

        Public Function RollUpWarrant(ByRef TrackSelected As Track, ByRef ComponentsCollection As ArrayList, ByVal dbConnection As OleDbConnection) As Boolean
            Dim EndOfWarrantFound As Boolean = False
            Dim NextComp As Object = Nothing
            Dim CurrentComp As Object = Nothing
            Dim warr As Warrant = Nothing
            Dim LeftLimits As String = String.Empty
            Dim RightLimits As String = String.Empty
            Dim UserPrompt As String = String.Empty
            Dim UserMessage As Integer
            Dim RollUpEventMessage As String = String.Empty
            Dim comp As Object
            Dim WarrantIndex As Integer
            Try
                Dim FirstSelectedTrack As Track = TrackSelected
                RollUpWarrant = True
                'SelectionCollection.Add(TrackSelected)
                Dim TotalComponents As Integer = ComponentsCollection.Count
                CurrentComp = TrackSelected


                For Each comp In ComponentsCollection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.TimeZone <> "" Then
                            CurrentTimeZone = Mid(comp.TimeZone, 1, 1)
                            Exit For
                        End If
                    End If
                Next
                Dim ReportTime As String = TMDS.SystemUtilities.Utilities.GetCurrentTimeDateFromTimeZone(CurrentTimeZone, "T")



                If Direction = "RIGHT" Then
                    If CurrentComp.LeftLink <> 0 Then
                        NextComp = FindObjectTypeFromGUID(CurrentComp.LeftLink)
                    Else
                        EndOfWarrantFound = True
                    End If
                    While Not EndOfWarrantFound
                        If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Or NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If NextComp.AuthorityCounts > 0 Then

                                'ADDED THIS IS CAPTURE WARRANT ADDED AFTER A ITEM TWO TO SAME TRAIN WITH EXISTING ITEM 2/9 TO MOW
                                WarrantIndex = FindWarrantIndex(Me, NextComp)
                                If WarrantIndex = -1 Then
                                    EndOfWarrantFound = True
                                Else
                                    warr = NextComp.Authorities(WarrantIndex)
                                End If
                                'warr = NextComp.Authorities(0)

                                If warr.WarrantNumber = WarrantNumber Then
                                    If NextComp.StationNumber = TrackSelected.StationNumber And
                                       NextComp.Name = TrackSelected.Name Then

                                    ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" And
                                           TrackSelected.LeftLink = NextComp.GUID Then
                                    Else
                                        If Not SelectionCollection.Contains(NextComp) Then
                                            SelectionCollection.Add(NextComp)
                                        End If
                                        If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                            Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightLink)
                                            If Not trk Is Nothing Then
                                                Dim OsTrack As ArrayList = trk.GetAllOSComponents(False)
                                                If Not OsTrack Is Nothing Then
                                                    Dim trkCheck As Object
                                                    For Each trkCheck In OsTrack
                                                        If trkCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                            If trkCheck.Name = TrackSelected.Name And trkCheck.StationNumber = TrackSelected.StationNumber Then
                                                                'DO NOTHING
                                                            Else
                                                                If trkCheck.Authorities.Count > 0 Then
                                                                    Dim warrToCheck As Warrant
                                                                    For Each warrToCheck In trkCheck.Authorities
                                                                        If warrToCheck.WarrantNumber = Me.WarrantNumber Then
                                                                            If Not SelectionCollection.Contains(trkCheck) Then
                                                                                SelectionCollection.Add(trkCheck)
                                                                                Exit For
                                                                            End If
                                                                        End If
                                                                    Next
                                                                End If
                                                            End If
                                                        End If
                                                    Next
                                                End If
                                            End If
                                        End If

                                    End If


                                    CurrentComp = NextComp

                                    'Check for any component other then a track or switch
                                    If CurrentComp.GetType.ToString <> "TMDS.SwitchComponents.Switch" _
                                    And CurrentComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                        EndOfWarrantFound = True
                                        Exit While 'add 4-18-04
                                    End If

                                    If CurrentComp.LeftLink <> 0 Then

                                        NextComp = FindObjectTypeFromGUID(CurrentComp.LeftLink)
                                        'Version 236
                                        'this code was inserted to handle leaving behind piece of warrant after a rollup through
                                        'a reverse switch with a warrant issued through it on the main and turn both.
                                        If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                            ' do nothing
                                        ElseIf FirstSelectedTrack.TrackName = NextComp.TrackName And FirstSelectedTrack.StationNumber = NextComp.StationNumber Then
                                            'do nothing
                                        Else
                                            If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                Dim OtherLikeComponenets As ArrayList = NextComp.FindOsTracks
                                                If Not OtherLikeComponenets Is Nothing Then
                                                    Dim compon As Object
                                                    For Each compon In OtherLikeComponenets
                                                        If compon.Authorities.Count > 0 Then
                                                            Dim Nextwarr As Warrant = compon.Authorities.Item(0)
                                                            If Nextwarr.WarrantNumber = Me.WarrantNumber Then
                                                                If Not SelectionCollection.Contains(compon) Then
                                                                    SelectionCollection.Add(compon)
                                                                End If
                                                            End If
                                                        End If
                                                    Next
                                                End If
                                            End If
                                        End If
                                        'Version 236
                                    Else
                                        EndOfWarrantFound = True
                                    End If


                                    'Check for any component other then a track or switch
                                    If NextComp.GetType.ToString <> "TMDS.SwitchComponents.Switch" Then
                                        If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                            EndOfWarrantFound = True
                                        End If
                                    End If


                                Else
                                    EndOfWarrantFound = True
                                End If
                            Else
                                EndOfWarrantFound = True
                            End If
                        Else
                            EndOfWarrantFound = True
                        End If
                        'Make sure that we do not get stuck in this loop; terminate after total number of components
                        TotalComponents = TotalComponents - 1
                        If TotalComponents = 0 Then
                            NextComp = Nothing
                            CurrentComp = Nothing
                            warr = Nothing
                            ClearSelection()
                            Exit Function
                        End If

                        warr = Nothing
                    End While

                    NextComp = Nothing
                    CurrentComp = Nothing


                ElseIf Direction = "LEFT" Then
                    If CurrentComp.RightLink <> 0 Then
                        NextComp = FindObjectTypeFromGUID(CurrentComp.RightLink)
                    Else
                        EndOfWarrantFound = True
                    End If
                    While Not EndOfWarrantFound
                        If NextComp.AuthorityCounts > 0 Then
                            'ADDED THIS IS CAPTURE WARRANT ADDED AFTER A ITEM TWO TO SAME TRAIN WITH EXISTING ITEM 2/9 TO MOW
                            WarrantIndex = FindWarrantIndex(Me, NextComp)
                            If WarrantIndex = -1 Then
                                EndOfWarrantFound = True
                            Else
                                warr = NextComp.Authorities(WarrantIndex)
                            End If
                            'warr = NextComp.Authorities(0)

                            If warr.WarrantNumber = WarrantNumber Then
                                If NextComp.StationNumber = TrackSelected.StationNumber And
                                   NextComp.Name = TrackSelected.Name Then

                                ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" And
                                       TrackSelected.RightLink = NextComp.GUID Then
                                Else
                                    If Not SelectionCollection.Contains(NextComp) Then
                                        SelectionCollection.Add(NextComp)
                                    End If
                                    If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                        Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightLink)
                                        If Not trk Is Nothing Then
                                            Dim OsTrack As ArrayList = trk.GetAllOSComponents(False)
                                            If Not OsTrack Is Nothing Then
                                                Dim trkCheck As Object
                                                For Each trkCheck In OsTrack
                                                    If trkCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                        If trkCheck.Name = TrackSelected.Name And trkCheck.StationNumber = TrackSelected.StationNumber Then
                                                            'DO NOTHING
                                                        Else
                                                            If trkCheck.Authorities.Count > 0 Then
                                                                Dim warrToCheck As Warrant
                                                                For Each warrToCheck In trkCheck.Authorities
                                                                    If warrToCheck.WarrantNumber = Me.WarrantNumber Then
                                                                        If Not SelectionCollection.Contains(trkCheck) Then
                                                                            SelectionCollection.Add(trkCheck)
                                                                            Exit For
                                                                        End If
                                                                    End If
                                                                Next
                                                            End If
                                                        End If
                                                    End If
                                                Next
                                            End If
                                        End If
                                    End If

                                End If
                                CurrentComp = NextComp
                                '*****

                                'Check for any component other then a track or switch
                                If CurrentComp.GetType.ToString <> "TMDS.SwitchComponents.Switch" _
                                And CurrentComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    EndOfWarrantFound = True
                                    Exit While 'add 4-18-04
                                End If

                                If CurrentComp.RightLink <> 0 Then

                                    NextComp = FindObjectTypeFromGUID(CurrentComp.RightLink)
                                    'Version 236
                                    'this code was inserted to handle leaving behind piece of warrant after a rollup through
                                    'a reverse switch with a warrant issued through it on the main and turn both.
                                    If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                        ' do nothing
                                    ElseIf FirstSelectedTrack.TrackName = NextComp.TrackName And FirstSelectedTrack.StationNumber = NextComp.StationNumber Then
                                        'do nothing
                                    Else
                                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            Dim OtherLikeComponenets As ArrayList = NextComp.FindOsTracks
                                            If Not OtherLikeComponenets Is Nothing Then
                                                Dim compon As Object
                                                For Each compon In OtherLikeComponenets
                                                    If compon.Authorities.Count > 0 Then
                                                        Dim Nextwarr As Warrant = compon.Authorities.Item(0)
                                                        If Nextwarr.WarrantNumber = Me.WarrantNumber Then
                                                            If Not SelectionCollection.Contains(compon) Then
                                                                SelectionCollection.Add(compon)
                                                            End If
                                                        End If
                                                    End If
                                                Next
                                            End If
                                        End If
                                    End If
                                    'Version 236
                                Else
                                    EndOfWarrantFound = True
                                End If

                                'Check for any component other then a track or switch
                                If NextComp.GetType.ToString <> "TMDS.SwitchComponents.Switch" Then
                                    If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                        EndOfWarrantFound = True
                                    End If
                                End If


                            Else
                                EndOfWarrantFound = True
                            End If
                        Else
                            EndOfWarrantFound = True
                        End If

                        'Make sure that we do not get stuck in this loop; terminate after total number of components
                        TotalComponents = TotalComponents - 1
                        If TotalComponents = 0 Then
                            NextComp = Nothing
                            CurrentComp = Nothing
                            warr = Nothing
                            ClearSelection()
                            Exit Function
                        End If
                        warr = Nothing
                    End While
                    NextComp = Nothing
                    CurrentComp = Nothing
                End If

                Dim RollupLimits As String = String.Empty
                Dim ContinueWithRollUp As Boolean
                If SelectionCollection.Count > 0 Then
                    Dim trk1 As Object = SelectionCollection.Item(0)
                    Dim trk2 As Object = SelectionCollection.Item(SelectionCollection.Count - 1)
                    'Version 236
                    If Direction = "RIGHT" Then
                        RightLimits = trk1.RightLimitName
                        LeftLimits = trk2.LeftLimitName
                    Else
                        RightLimits = trk1.LeftLimitName
                        LeftLimits = trk2.RightLimitName
                    End If
                    UserPrompt = "ROLLING UP LIMITS FOR TRACK WARRANT: " & WarrantNumber & vbCrLf & vbCrLf
                    UserPrompt = UserPrompt & "ISSUED TO: " & IssueTo & vbCrLf & vbCrLf
                    UserPrompt = UserPrompt & "FROM " & LeftLimits & " TO " & RightLimits & vbCrLf & vbCrLf
                    UserPrompt = UserPrompt & "ROLL UP CONFIRMATION TIME: " & Format(Now, "MMM-dd-yyyy  HH:mm") & vbCrLf & vbCrLf

                    UserPrompt = UserPrompt & "ROLL UP THESE LIMITS, ARE YOU SURE?"
                    RollupLimits = "FROM " & LeftLimits & " TO " & RightLimits
                    SelectionTimer.Enabled = True
                End If

                If optUseReleaseAuthorityVerbiageDME Then
                    If PerformSwitchConfirmation(RightLimits) Then
                        ContinueWithRollUp = True
                    End If
                Else
                    If SelectionCollection.Count > 0 Then
                        If FirstSelectedTrack.AuthorityType = "TWC" Then
                            Dim gHistoryMessage As String
                            Dim SwitchMessage As String = "HAVE ALL MAIN TRACK SWITCHES THAT YOU HAVE OPERATED BEEN RESTORED TO THE NORMAL POSITION?"
                            Dim UserResponseSwitch As Integer = MessageBox.Show(TMDS.SystemForms.MySystemForms.frmMainMDI.ActiveMdiChild, SwitchMessage, "SWITCH POSITION CONFIRMATION", MessageBoxButtons.YesNo, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2)
                            If UserResponseSwitch = 6 Then
                                gHistoryMessage = "SELECTED - YES TO " & SwitchMessage & ":" & Me.WarrantNumber.ToString
                                TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                            Else
                                gHistoryMessage = "SELECTED - NO TO  " & SwitchMessage & ":" & Me.WarrantNumber.ToString
                                TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                                ClearSelection()
                                Exit Function
                            End If
                            If Not optDisablePromptSPAF Then
                                Dim SwitchFormMessage As String = "HAVE ALL EMPLOYEES COMPLETED THE SPAF AS REQUIRED?"
                                Dim UserResponseSwitchForm As Integer = MessageBox.Show(TMDS.SystemForms.MySystemForms.frmMainMDI.ActiveMdiChild, SwitchFormMessage, "SWITCH POSITION FORM CONFIRMATION", MessageBoxButtons.YesNo, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2)
                                If UserResponseSwitchForm = 6 Then
                                    gHistoryMessage = "SELECTED - YES TO " & SwitchFormMessage & ":" & Me.WarrantNumber.ToString
                                    TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                                Else
                                    gHistoryMessage = "SELECTED - NO TO  " & SwitchFormMessage & ":" & Me.WarrantNumber.ToString
                                    TMDS.SystemUtilities.Utilities.SystemEvent(gHistoryMessage)
                                    ClearSelection()
                                    Exit Function
                                End If
                            End If

                        End If
                        UserMessage = MessageBox.Show(TMDS.SystemForms.MySystemForms.frmMainMDI.ActiveMdiChild, UserPrompt, "ROLL UP CONFIRMATION", MessageBoxButtons.YesNo, MessageBoxIcon.Warning)
                        If UserMessage = 6 Then
                            ContinueWithRollUp = True
                        End If
                    End If

                End If

                If SelectionCollection.Count > 0 Then
                    If ContinueWithRollUp Then
                        Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.DispatcherEvent, "SELECTED YES TO ROLL UP TRACK WARRANT:" & WarrantNumber, SystemEventQueue)
                        'create the rollup event message
                        RollUpEventMessage = "TIME:" & ReportTime & vbCrLf
                        RollUpEventMessage = RollUpEventMessage & "LIMITS:" & LeftLimits & "|" & RightLimits & vbCrLf & "TRACK-GUIDs:"
                        For Each comp In SelectionCollection
                            RollUpEventMessage = RollUpEventMessage & comp.GUID & "|"
                        Next
                        RollUpEvent.Add(RollUpEventMessage)
                        SysEvent = New SystemEventRecord(Now, SystemEventRecord.EventEnum.DispatcherEvent, "ROLL UP EVENT DATA:" & RollUpEventMessage, SystemEventQueue)
                        If Me.WarrantType = "ItemTwoToTrain" Then
                            'Find a TrainID to move to Roll Up Track
                            Dim trk As Track
                            For Each comp In SelectionCollection
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    trk = comp
                                    If trk.TrainIDs.Count > 0 Then
                                        Dim trn As TrainID
                                        Dim pEngineID As String
                                        Dim strPosition As Integer

                                        strPosition = InStr(IssueTo, "EAST")
                                        If strPosition = 0 Then
                                            strPosition = InStr(IssueTo, "WEST")
                                            If strPosition = 0 Then
                                                strPosition = InStr(IssueTo, "NORTH")
                                                If strPosition = 0 Then
                                                    strPosition = InStr(IssueTo, "SOUTH")
                                                End If
                                            End If
                                        End If

                                        If strPosition > 0 Then
                                            pEngineID = Trim(Mid(IssueTo, 1, strPosition - 1))
                                        Else
                                            pEngineID = Trim(IssueTo)
                                        End If

                                        'Version 225
                                        'added this to find engine ids within another string
                                        Dim EngineMatches As Boolean
                                        trn = trk.TrainIDs.Item(0)

                                        If InStrRev(trn.IdentifingUnit, pEngineID) <> 0 Then
                                            EngineMatches = True
                                        End If
                                        If EngineMatches Then
                                            'If trn.IdentifingUnit = pEngineID Then
                                            'Version 225
                                            TrackSelected.MoveTrainIDPlaceManual(trn, trk, False, dbConnection)
                                            RollUpTrack = TrackSelected
                                            dbConn = dbConnection
                                            RollUpTrack.LogOsMessage(Nothing, False, trn)
                                        Else
                                            Dim UserResponse As Integer = MessageBox.Show(SystemForms.MySystemForms.frmMainMDI, "DO YOU WANT TO ROLL UP TRAIN SYMBOL " & trn.Name & "?", "ROLL UP MESSAGE", MessageBoxButtons.YesNo, MessageBoxIcon.Question)
                                            If UserResponse = 6 Then
                                                TrackSelected.MoveTrainIDPlaceManual(trn, trk, False, dbConnection)
                                                RollUpTrack = TrackSelected
                                                dbConn = dbConnection
                                                RollUpTrack.LogOsMessage(Nothing, False, trn)
                                            End If
                                        End If
                                    End If
                                    trk = Nothing
                                End If
                            Next
                        ElseIf Me.WarrantType = "ItemTwoToMOW" Then
                            'Find a MOWID to move to Roll Up Track
                            Dim trk As Track
                            For Each comp In SelectionCollection
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    trk = comp
                                    If trk.MOWIDs.Count > 0 Then
                                        Dim MOW As MOWID
                                        MOW = trk.MOWIDs.Item(0)
                                        If MOW.Name = IssueTo Then
                                            TrackSelected.MoveMOWIDPlace(MOW, trk, False)
                                            RollUpTrack = TrackSelected
                                            dbConn = dbConnection
                                        End If
                                    End If

                                End If
                            Next
                            trk = Nothing
                        End If

                        'REMOVE THE AUHTORITY FROM THE ROLLED UP TRACK PIECES AND REDRAW ANY EXISTING IDS.
                        For Each comp In SelectionCollection
                            SelectionComponents.Remove(comp)
                            comp.Authorities.Remove(Me)
                            comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                            comp.UpdateStatus()
                            comp.InitAuthorityNumbers()
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                comp.InvalidateTrainID()
                                comp.InvalidateMOWID()
                            End If
                        Next
                        TrackNumbers.Clear()

                        For Each comp In SelectionComponents
                            Me.TrackNumbers.Add(comp.GUID)
                        Next
                        If Not UpdateDatabaseWithRollUpEvent(dbConnection) Then
                            'Log an error
                        End If
                    Else
                        'REDRAW THE IDS IF ROLLUP IS CANCELLED TO CLEAN UP GRAPHICS
                        For Each comp In SelectionCollection
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                comp.InvalidateTrainID()
                                comp.InvalidateMOWID()
                            End If
                        Next
                        Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.DispatcherEvent, "SELECTED NO TO ROLL UP TRACK WARRANT:" & WarrantNumber, SystemEventQueue)
                    End If
                Else
                    Return False
                End If
                ClearSelection()
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSelection()
                Dim ErrorMessage As String = "Track Warrant " & WarrantNumber & " Not Rolled Up Properly! CALL SYSTEM ADMINISTRATOR!"
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                Return False
            End Try
        End Function

        Public Function RollUpOtherWarrant(ByRef TrackSelected As Track, ByRef ComponentsCollection As ArrayList, ByVal dbConnection As OleDbConnection, ByVal OtherWarrantToRollUp As Warrant) As Boolean
            Dim EndOfWarrantFound As Boolean = False
            Dim NextComp As Object = Nothing
            Dim CurrentComp As Object = Nothing
            Dim warr As Warrant = Nothing
            Dim LeftLimits As String = String.Empty
            Dim RightLimits As String = String.Empty
            Dim UserPrompt As String = String.Empty
            Dim UserMessage As Integer
            Dim RollUpEventMessage As String = String.Empty
            Dim WarrantIndex As Integer
            Dim comp As Object
            Dim FirstSelectedTrack As Track = TrackSelected

            Try
                RollUpOtherWarrant = True
                'SelectionCollection.Add(TrackSelected)
                Dim TotalComponents As Integer = ComponentsCollection.Count
                CurrentComp = TrackSelected

                For Each comp In ComponentsCollection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.TimeZone <> "" Then
                            CurrentTimeZone = Mid(comp.TimeZone, 1, 1)
                            Exit For
                        End If
                    End If
                Next
                Dim ReportTime As String = TMDS.SystemUtilities.Utilities.GetCurrentTimeDateFromTimeZone(CurrentTimeZone, "T")


                If Direction = "RIGHT" Then
                    If CurrentComp.LeftLink <> 0 Then
                        NextComp = FindObjectTypeFromGUID(CurrentComp.LeftLink)
                    Else
                        EndOfWarrantFound = True
                    End If
                    While Not EndOfWarrantFound
                        If NextComp.AuthorityCounts > 0 Then
                            WarrantIndex = FindWarrantIndex(OtherWarrantToRollUp, NextComp)
                            If WarrantIndex = -1 Then
                                RollUpOtherWarrant = False
                                Exit Function
                            Else
                                warr = NextComp.Authorities(WarrantIndex)
                            End If

                            If warr.WarrantNumber = WarrantNumber Then
                                If NextComp.StationNumber = TrackSelected.StationNumber And
                                   NextComp.Name = TrackSelected.Name Then

                                ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" And
                                       TrackSelected.LeftLink = NextComp.GUID Then

                                Else
                                    If Not SelectionCollection.Contains(NextComp) Then
                                        SelectionCollection.Add(NextComp)
                                    End If
                                    If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                        Dim sw As Switch = CType(NextComp, Switch)
                                        Dim trk As Track
                                        If sw.LeftAltLink <> 0 Then
                                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.RightLink)
                                            trk.FindLikeTracks(SelectionCollection, TrackCollection)
                                        ElseIf sw.RightAltLink <> 0 Then
                                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.LeftLink)
                                            trk.FindLikeTracks(SelectionCollection, TrackCollection)
                                        End If
                                    End If
                                End If

                                CurrentComp = NextComp
                                If CurrentComp.LeftLink <> 0 Then
                                    NextComp = FindObjectTypeFromGUID(CurrentComp.LeftLink)
                                Else
                                    EndOfWarrantFound = True
                                End If
                            Else
                                EndOfWarrantFound = True
                            End If
                        Else
                            EndOfWarrantFound = True
                        End If

                        'Make sure that we do not get stuck in this loop; terminate after total number of components
                        TotalComponents = TotalComponents - 1
                        If TotalComponents = 0 Then
                            NextComp = Nothing
                            CurrentComp = Nothing
                            warr = Nothing
                            ClearSelection()
                            Exit Function
                        End If

                        warr = Nothing
                    End While

                    NextComp = Nothing
                    CurrentComp = Nothing


                ElseIf Direction = "LEFT" Then
                    If CurrentComp.RightLink <> 0 Then
                        NextComp = FindObjectTypeFromGUID(CurrentComp.RightLink)
                    Else
                        EndOfWarrantFound = True
                    End If
                    While Not EndOfWarrantFound
                        If NextComp.AuthorityCounts > 0 Then
                            WarrantIndex = FindWarrantIndex(OtherWarrantToRollUp, NextComp)
                            If WarrantIndex = -1 Then
                                RollUpOtherWarrant = False
                                Exit Function
                            Else
                                warr = NextComp.Authorities(WarrantIndex)
                            End If

                            If warr.WarrantNumber = WarrantNumber Then
                                If NextComp.StationNumber = TrackSelected.StationNumber And
                                   NextComp.Name = TrackSelected.Name Then

                                ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" And
                                       TrackSelected.RightLink = NextComp.GUID Then
                                Else
                                    SelectionCollection.Add(NextComp)
                                    If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                        Dim sw As Switch = CType(NextComp, Switch)
                                        Dim trk As Track
                                        If sw.LeftAltLink <> 0 Then
                                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.RightLink)
                                            trk.FindLikeTracks(SelectionCollection, TrackCollection)
                                        ElseIf sw.RightAltLink <> 0 Then
                                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.LeftLink)
                                            trk.FindLikeTracks(SelectionCollection, TrackCollection)
                                        End If
                                    End If

                                End If
                                CurrentComp = NextComp
                                If CurrentComp.RightLink <> 0 Then
                                    NextComp = FindObjectTypeFromGUID(CurrentComp.RightLink)
                                Else
                                    EndOfWarrantFound = True
                                End If
                            Else
                                EndOfWarrantFound = True
                            End If
                        Else
                            EndOfWarrantFound = True
                        End If

                        'Make sure that we do not get stuck in this loop; terminate after total number of components
                        TotalComponents = TotalComponents - 1
                        If TotalComponents = 0 Then
                            NextComp = Nothing
                            CurrentComp = Nothing
                            warr = Nothing
                            ClearSelection()
                            Exit Function
                        End If
                        warr = Nothing
                    End While
                    NextComp = Nothing
                    CurrentComp = Nothing
                End If

