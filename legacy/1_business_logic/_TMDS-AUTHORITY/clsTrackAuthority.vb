        Private Function UpdateDatabaseWithRollUpEvent(ByVal dbConnection As OleDbConnection) As Boolean
            Dim WarrantUpdateSQL As String = String.Empty
            Dim RollUpMessage As String = String.Empty
            Dim RollUpString As String = String.Empty
            Dim TrackNumberMessage As String = String.Empty
            Dim dbconn As OleDbConnection
            Dim CommandUpdate As OleDbCommand

            Try
                Dim comp As Object
                For Each comp In Me.SelectionComponents
                    TrackNumberMessage = TrackNumberMessage & comp.GUID.ToString & "|"
                Next
                'For I = 0 To 100
                '    If TrackNumbers(I) = 0 Then Exit For
                '    TrackNumberMessage = TrackNumberMessage & TrackNumbers(I) & "|"
                'Next

                For Each RollUpString In RollUpEvent
                    RollUpMessage = RollUpMessage & RollUpString.ToString & ";"
                Next

                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)

                WarrantUpdateSQL = "UPDATE " & gtblWarrantsActive
                WarrantUpdateSQL = WarrantUpdateSQL & " SET RollUpEvent = " & "'" & RollUpMessage & "',"
                WarrantUpdateSQL = WarrantUpdateSQL & " TrackNumbers = " & "'" & TrackNumberMessage & "'"
                WarrantUpdateSQL = WarrantUpdateSQL & " WHERE WarrantNum = " & "'" & pWarrantNum.ToString & "' AND TerritoryAssignmentID = " & pTerritoryAssignment

                CommandUpdate = New OleDbCommand(WarrantUpdateSQL, dbconn)

                dbconn.Open()
                CommandUpdate.ExecuteNonQuery()
                dbconn.Close()
                CommandUpdate = Nothing
                dbconn = Nothing

                Dim DoAddAuthorityEvent As New DoEventLogWarrant(AddressOf Me.LogTheWarrantEvent)
                DoAddAuthorityEvent.BeginInvoke(EventTypeWarrant.ROLLUP, Nothing, Nothing)

                Dim DoAuthorityEvent As New DoPublishTWCEvent(AddressOf Me.PublishTWCEventUpdate)
                DoAuthorityEvent.BeginInvoke(EventTypeTWC.ROLLUP, Nothing, Nothing)

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Dim ErrorMessage As String = "Database Error - Rolling Up Track Warrant. CALL SYSTEM ADMINISTRATOR!"
                dbconn = Nothing
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                Return Nothing
            End Try


        End Function

