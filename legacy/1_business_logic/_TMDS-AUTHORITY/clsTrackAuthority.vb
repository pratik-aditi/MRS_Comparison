        Public Function CheckTrainPTCStatus(ByVal trn As TrainID, ByVal SendTerrID As Boolean) As Boolean
            Dim rtnStatus As Boolean = True
            Try
                If Not gPTCTerritoryExists Then Return False
                TMDS.NetworkMessages.PTCBOSAPIMessaging.SendLocomotiveRequestMessageStatus(trn, True)
                Dim Loco As MobileTracking.Locomotive = Me.FindLocomotive
                Dim StatusCheck As Boolean = True

                If Not Loco Is Nothing Then
                    Loco.RequestedStatusReceived = False
                End If
                Do While StatusCheck
                    If gPTCLinkDown Then
                        StatusCheck = False
                        rtnStatus = False
                        Exit Do
                    End If
                    If Loco Is Nothing Then
                        Loco = FindLocomotive()
                        If Not Loco Is Nothing Then
                            If Loco.RequestedStatusReceived Then
                                StatusCheck = False
                                Loco.RequestedStatusReceived = False
                                If Loco.CutOutState = True Then
                                    rtnStatus = False
                                    Exit Do
                                End If
                            End If
                        End If
                    Else
                        If Loco.RequestedStatusReceived Then
                            StatusCheck = False
                            Loco.RequestedStatusReceived = False
                            If Loco.CutOutState = True Then
                                rtnStatus = False
                                Exit Do
                            End If
                        End If
                    End If
                    Application.DoEvents()
                    Threading.Thread.Sleep(100)
                Loop

            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
            Return rtnStatus
        End Function

        Public Function FindLocomotive() As MobileTracking.Locomotive
            Dim loco As MobileTracking.Locomotive
            Dim LocoFound As MobileTracking.Locomotive = Nothing
            Try
                For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                    If loco.LocomotiveID = Mid(Me.IssueTo, 1, 10) Then
                        Return loco
                        Exit For
                    End If
                Next
                If IsNothing(LocoFound) Then
                    Return Nothing
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                loco = Nothing
            End Try
            Return Nothing
        End Function

