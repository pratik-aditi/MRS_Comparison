        Public Sub PopulateAuthZones(Optional ForcePopulate As Boolean = False)
            Dim Comp As Object = Nothing
            Try

                If Me.IssuedToTrain Then
                    Dim Populate As Boolean = False
                    Dim HasTZ As Boolean
                    For Each Comp In Me.Components
                        If Comp.GetType.ToString = gTrackComponentName AndAlso Comp.TrackZoneIntegrityMonitoringEnabled Then
                            HasTZ = True
                            Exit For
                        End If
                    Next
                    If Not HasTZ Then Me.tmpMyTrackZoneList = New ArrayList : Exit Sub


                    If Me.tmpMyTrackZoneList Is Nothing Then
                        Populate = True
                    ElseIf Me.tmpMyTrackZoneList.Count = 0 Then
                        Populate = True
                    End If
                    If ForcePopulate Then Populate = True : Me.tmpMyTrackZoneList = New ArrayList
                    If Populate Then
                        For Each Comp In Me.Components
                            If Comp.GetType.ToString = gTrackComponentName Then
                                If Not Me.tmpMyTrackZoneList.Contains(Comp.TrackZoneReference) Then Me.tmpMyTrackZoneList.Add(Comp.TrackZoneReference)
                            End If
                        Next
                    End If
                Else
                    Me.tmpMyTrackZoneList = New ArrayList
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub
