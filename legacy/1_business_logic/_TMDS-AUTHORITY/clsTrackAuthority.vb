        Public Function UpdateDatabaseWithRollUpEvent() As Boolean
            Dim WarrantUpdateSQL As String
            Dim dbconn As OleDbConnection
            Dim CommandUpdate As OleDbCommand
            Dim Box8CompList As String = ""
            Dim HasBox8 As Boolean = False
            Try


                Dim comp As Object
                Dim CompList As String = String.Empty
                For Each comp In Components
                    If Not IsNothing(comp) Then
                        CompList = CompList & comp.GUID & "-"
                    End If

                Next
                comp = Nothing

                If optMatchBox8CompsOnRollup Then
                    If Not BoxEightRestrictionComponents Is Nothing AndAlso BoxEightRestrictionComponents.Count > 0 Then
                        Me.BoxEightRestrictionComponents.Clear()
                        HasBox8 = True
                        For Each comp In Components
                            If comp.GetType.ToString = gTrackComponentName Then
                                Box8CompList = Box8CompList & comp.GUID & "-"
                                Me.BoxEightRestrictionComponents.Add(comp)
                            End If
                        Next
                    End If
                End If




                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)

                WarrantUpdateSQL = "UPDATE " & gtblSFAActive
                WarrantUpdateSQL = WarrantUpdateSQL & " SET Components = " & "'" & CompList & "'"

                If optMatchBox8CompsOnRollup And HasBox8 Then WarrantUpdateSQL = WarrantUpdateSQL & " , BoxEightComponents = " & "'" & Box8CompList & "'"


                Dim rollup As String
                Dim RollupEvents As String = String.Empty
                For Each rollup In Me.RollUpEvents
                    RollupEvents = RollupEvents & rollup & Chr(1)
                Next
                WarrantUpdateSQL = WarrantUpdateSQL & ", RollUpEvent = " & "'" & RollupEvents & "'"
                WarrantUpdateSQL = WarrantUpdateSQL & " WHERE AuthGUID = '" & Me.AuthGUID & "'" '" WHERE AuthorityUID = " & "'" & Me.AuthorityUID & "'"
                CommandUpdate = New OleDbCommand(WarrantUpdateSQL, dbconn)

                dbconn.Open()
                CommandUpdate.ExecuteNonQuery()
                dbconn.Close()
                CommandUpdate = Nothing
                dbconn = Nothing

                Dim DoAddAuthorityEvent As New DoEventLogSFA(AddressOf Me.LogTheSFAEvent)
                DoAddAuthorityEvent.BeginInvoke(EventLogTypeSFA.ROLLUP, Nothing, Nothing)

                Dim DoAuthorityEvent As New DoPublishSFAEvent(AddressOf Me.PublishSFAEventUpdate)
                DoAuthorityEvent.BeginInvoke(EventTypeSFA.ROLLUP, Nothing, Nothing)

                If gEnablePTCVETMSRebuildTrackSegmentOnRollup Then
                    RebuildPTCComponentsOnRollup()
                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Dim ErrorMessage As String = "Database Error - Rolling Up Track Warrant. CALL SYSTEM ADMINISTRATOR!"
                dbconn = Nothing
                MsgBox(ErrorMessage, MsgBoxStyle.Critical, "SYSTEM ALERT MESSAGE")
                Return False
            End Try


        End Function

        Private Function CreateInsertCommand(ByVal dbTable As String, Optional ByVal CreateNewAuthority As Boolean = False) As String
            Dim SQLFields As String
            Dim SQLValues As String
            Dim s As String = ","
            Dim q As String = "'"

            Try

                If CreateNewAuthority Then
                    InitMobileClientData()
                End If

                SQLFields = " (AuthGUID, RailRoadName, Subdivision, TimeZone, DispName, Direction, AuthDate"
                SQLFields = SQLFields & ", TerrID1, TerrID2, TerrID3, AuthType1, AuthType2, AuthType3, AuthNum"
                SQLFields = SQLFields & ", AuthorityUID,  IssuedToTrain,  IssueTo, AtLocation, Box1Void"
                SQLFields = SQLFields & ", Box2From1, Box2To1, Box2Track1"
                SQLFields = SQLFields & ", Box2From2, Box2To2, Box2Track2"
                SQLFields = SQLFields & ", Box2From3, Box2To3,  Box2Track3, Box3Clear"
                SQLFields = SQLFields & ", Box4From1, Box4To1, Box4Track1"
                SQLFields = SQLFields & ", Box4From2, Box4To2, Box4Track2"
                SQLFields = SQLFields & ", Box4From3, Box4To3, Box4Track3"
                SQLFields = SQLFields & ", Box5Arrival, Box5At, Box6Train"
                SQLFields = SQLFields & ", Box8From, Box8To, Box8Track"
                SQLFields = SQLFields & ", Box9List, Box10ClearBy, JointAuthority"
                SQLFields = SQLFields & ", Box11MPH1, Box11From1, Box11To1, Box11Track1"
                SQLFields = SQLFields & ", Box11MPH2, Box11From2, Box11To2, Box11Track2"
                SQLFields = SQLFields & ", Box12Switches, Box13Switches, Box14Instructions"
                SQLFields = SQLFields & ", BoxItems, NumOfBoxesChecked, CopiedBy"
                SQLFields = SQLFields & ", Components, Components1, Components2, Components3, Components4, AuthorityVerbiage"
                SQLFields = SQLFields & ", Box1, Box2, Box3, Box4, Box5, Box6"
                SQLFields = SQLFields & ", Box7, Box8, Box9, Box10, Box11, Box12, Box13, Box14"
                SQLFields = SQLFields & ", BoxEightComponents, VehicleAssociations, TrainSymbol"
                SQLFields = SQLFields & ", ClearMainLocationOne, ClearMainLocationTwo, Box11TrainMeetLocation, Box4Components"
                SQLFields = SQLFields & ", BoxFourTrainSatifiedOne, BoxFourTrainSatifiedTwo, BoxFourTrainSatifiedThree"
                SQLFields = SQLFields & ", RelayedTo, RadioBlockingAuthority, JointAbsolute"
                SQLFields = SQLFields & ", LastNameEIC, FirstNameEIC, PassWordEIC, EICPIN, EICENABLED, EICDS"
                SQLFields = SQLFields & ", AuthorityStatus"

                SQLFields = SQLFields & ")"


                SQLValues = " VALUES (" & q & Me.AuthGUID & q
                SQLValues = SQLValues & s & q & RailRoadName & q & s & q & Subdivision & q & s & q & TimeZone & q
                SQLValues = SQLValues & s & q & SpclToEsc(DispName) & q & s & q & Direction & q & s & q & AuthDate & q
                SQLValues = SQLValues & s & TerrID1 & s & TerrID2 & s & TerrID3
                SQLValues = SQLValues & s & q & AuthType1 & q & s & q & AuthType2 & q & s & q & AuthType3 & q
                SQLValues = SQLValues & s & Me.AuthorityNumber
                SQLValues = SQLValues & s & q & Me.AuthorityUID & q
                SQLValues = SQLValues & s & CInt(IssuedToTrain)
                SQLValues = SQLValues & s & q & SpclToEsc(IssueTo) & q
                SQLValues = SQLValues & s & q & SpclToEsc(Me.AtLocation) & q

                Dim auth As String
                Dim VoidList As String = String.Empty
                If Not Box1Void Is Nothing Then
                    For Each auth In Me.Box1Void
                        If auth <> "" Then
                            VoidList = VoidList & auth & "|"
                        End If
                    Next
                End If
