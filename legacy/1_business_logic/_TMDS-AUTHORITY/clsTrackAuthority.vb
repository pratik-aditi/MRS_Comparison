        ''' <summary>
        ''' New with fiels
        ''' </summary>
        ''' <param name="pTrain"></param>
        ''' <param name="pTypeOfAuth"></param>
        ''' <param name="pTerritory"></param>
        ''' <param name="pCompList"></param>
        ''' <param name="pMessage"></param>
        ''' <param name="pDirection"></param>
        ''' <param name="pStopTarget"></param>
        Sub New(ByVal pTrain As TrainID, ByVal pTypeOfAuth As String, ByVal pTerritory As Territory, ByVal pCompList As ArrayList,
                ByVal pMessage As ArrayList, ByVal pDirection As String, Optional pStopTarget As Boolean = False, Optional pAuthorityData As String = Nothing)
            Dim messageList As New ArrayList
            Dim theTerr As Territory
            Dim sList As New StringBuilder
            Dim comp As Object = Nothing
            Dim s As String
            Dim theMess As New StringBuilder
            Try
                Flasher = New Windows.Forms.Timer() 'New Timers.Timer()
                Flasher.Interval = 120
                AddHandler Flasher.Tick, AddressOf Me.FlashAuthority
                Me.Direction = pDirection
                AuthGUID = Guid.NewGuid.ToString.ToUpper
                AuthDate = Now
                Me.SubType = pTypeOfAuth
                Me.RemoveStopTarget = pStopTarget
                Me.AuthorityData = pAuthorityData
                Select Case pTypeOfAuth.Trim.ToUpper
                    Case "EMT"
                        AuthorityType = "ENTER-MAIN-TRACK"
                    Case "PSS", "APB"
                        AuthorityType = "PASS-RED-SIGNAL"
                End Select
                theTerr = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(TerrUID)
                TerrUID = pTerritory.TerritoryID : myTerritory = pTerritory
                If IsNothing(theTerr) Then
                    AuthorityNumber = CInt(Format(Now, "hhmmssfff"))
                ElseIf optEnableARRCSpecificOptions Or optApplyConfigurationForKCT Then
                    AuthorityNumber = myTerritory.GetNextAuthorityNumberRange
                Else
                    AuthorityNumber = TMDS.GlobalDeclarations.gThisWorkstation.GetNextAuthorityNumber()
                End If
                Me.AuthorityUID = AuthorityNumber
                If Not IsNothing(pCompList) Then
                    ComponentsInSelection = pCompList.Clone
                    For Each comp In pCompList
                        If sList.Length = 0 Then
                            sList.Append(comp.GUID.ToString)
                        Else
                            If optEnablePSSEMTAuthorityNoDeviceBlk Then
                                sList.Append("|" & comp.GUID.ToString)
                            Else
                                sList.Append(";" & comp.GUID.ToString)
                            End If
                        End If
                    Next
                    sComponentsInSelection = sList.ToString
                End If
                If Not IsNothing(pTrain) Then
                    TrainSymbol = pTrain.Name : myTrain = pTrain : Me.IssueTo = myTrain.IdentifingUnit : Me.TrainIdentifyingUnit = myTrain.IdentifingUnit
                    If optEnableARRCSpecificOptions AndAlso myTrain IsNot Nothing AndAlso myTrain.myTrack IsNot Nothing AndAlso myTrain.myTrack.mySubdivision IsNot Nothing Then
                        AuthDate = GenerateTime(myTrain.myTrack.mySubdivision)
                    End If
                End If
                If Not IsNothing(pMessage) Then
                    messageList.Add(Space(30) & optRailRoadName & Space(1) & optAuthString75) 'NOVA LICENÇA RECEBIDA
                    messageList.Add(" ")
                    messageList.Add(Space(5) & optAuthString76 & ":" & Space(1) & Me.AuthorityUID & Space(10) & "DATA/HORA:" & Space(1) & Format(Me.AuthDate, "dd-MM-yyyy HH:mm"))
                    messageList.Add(" ")
                    messageList.Add(Space(5) & optAuthString79 & ":" & Space(1) & pTrain.IdentifingUnit & Space(15) & "PREFIXO:" & Space(1) & Me.TrainSymbol)
                    messageList.Add(" ")
                    messageList.Add(" ")
                    For Each newtext As String In pMessage
                        messageList.Add(newtext)
                    Next
                    AuthorityVerbiageList = messageList.Clone
                    For Each s In AuthorityVerbiageList
                        If theMess.Length = 0 Then
                            theMess.Append(s)
                        Else
                            theMess.Append("|" & s)
                        End If
                    Next
                    AuthorityVerbiage = theMess.ToString
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                messageList = Nothing
                theTerr = Nothing
                sList = Nothing
                comp = Nothing
                s = Nothing
                theMess = Nothing
            End Try
        End Sub

