                SQLValues = SQLValues & s & q & FoulList & q


                SQLValues = SQLValues & s & q & Box8From1 & q & s & q & Box8To1 & q & s & q & Box8Track1 & q

                Dim lap As String = String.Empty
                Dim LapList As String = String.Empty
                If Not Box9List Is Nothing Then
                    For Each lap In Me.Box9List
                        If lap <> "" Then
                            LapList = LapList & lap & "|"
                        End If
                    Next
                End If

                SQLValues = SQLValues & s & q & LapList & q
                SQLValues = SQLValues & s & q & Box10ClearBy & q
                SQLValues = SQLValues & s & q & CInt(Me.JointAuthority) & q

                SQLValues = SQLValues & s & q & Box11MPH1 & q & s & q & Box11From1 & q & s & q & Box11To1 & q & s & q & Box11Track1 & q
                SQLValues = SQLValues & s & q & Box11MPH2 & q & s & q & Box11From2 & q & s & q & Box11To2 & q & s & q & Box11Track2 & q

                Dim sw As String = String.Empty
                Dim SwList As String = String.Empty
                If Not Box12Switches Is Nothing Then
                    For Each sw In Me.Box12Switches
                        If sw <> "" Then
                            SwList = SwList & sw & "|"
                        End If
                    Next
                End If

                SQLValues = SQLValues & s & q & SwList & q

                sw = ""
                SwList = ""
                If Not Box13Switches Is Nothing Then
                    For Each sw In Me.Box13Switches
                        If sw <> "" Then
                            SwList = SwList & sw & "|"
                        End If
                    Next
                End If
                SQLValues = SQLValues & s & q & SwList & q

                SQLValues = SQLValues & s & q & Box14Instructions & q

                SQLValues = SQLValues & s & q & Me.BoxItems & q
                SQLValues = SQLValues & s & NumOfBoxesChecked

                SQLValues = SQLValues & s & q & CopiedBy & q

                Dim comp As Object
                Dim CompList As String = String.Empty
                If Not Components Is Nothing Then
                    For Each comp In Components
                        If Not IsNothing(comp) Then
                            CompList = CompList & comp.GUID & "-"
                        End If
                    Next
                End If
                SQLValues = SQLValues & s & q & CompList & q

                CompList = ""
                If Not Components1 Is Nothing Then
                    For Each comp In Components1
                        If Not IsNothing(comp) Then
                            CompList = CompList & comp.GUID & "-"
                        End If
                    Next
                End If
                SQLValues = SQLValues & s & q & CompList & q

                CompList = ""
                If Not Components2 Is Nothing Then
                    For Each comp In Components2
                        If Not IsNothing(comp) Then
                            CompList = CompList & comp.GUID & "-"
                        End If
                    Next
                End If
                SQLValues = SQLValues & s & q & CompList & q

                CompList = ""
                If Not Components3 Is Nothing Then
                    For Each comp In Components3
                        If Not IsNothing(comp) Then
                            CompList = CompList & comp.GUID & "-"
                        End If
                    Next
                End If

                SQLValues = SQLValues & s & q & CompList & q

                CompList = ""
                If Not Components4 Is Nothing Then
                    For Each comp In Components4
                        If Not IsNothing(comp) Then
                            CompList = CompList & comp.GUID & "-"
                        End If
                    Next
                End If

                SQLValues = SQLValues & s & q & CompList & q
                SQLValues = SQLValues & s & q & AuthorityVerbiage & q



                If Not Me.CheckBoxItemsStatus Is Nothing Then
                    For i As Integer = 0 To 13
                        Dim BoxStatus As Boolean = False
                        Boolean.TryParse(CheckBoxItemsStatus(i), BoxStatus)
                        Select Case BoxStatus
                            Case True
                                SQLValues = SQLValues & s & 1
                            Case Else
                                SQLValues = SQLValues & s & 0
                        End Select
                    Next
                    'For Each BoxStatus In Me.CheckBoxItemsStatus
                    '    SQLValues = SQLValues & s & CInt(BoxStatus)
                    'Next
                End If

                CompList = ""
                If Not BoxEightRestrictionComponents Is Nothing Then
                    For Each comp In Me.BoxEightRestrictionComponents
                        If Not IsNothing(comp) Then
                            CompList = CompList & comp.GUID & "-"
                        End If
                    Next
                End If

                SQLValues = SQLValues & s & q & CompList & q

                Dim veh As String = String.Empty
                Dim VehList As String = String.Empty
                If Not Me.VehicleAssociations Is Nothing Then
                    For Each veh In Me.VehicleAssociations
                        If veh <> "" Then
                            VehList = VehList & veh & "|"
                        End If
                    Next
                End If

                SQLValues = SQLValues & s & q & VehList & q

                SQLValues = SQLValues & s & q & Me.TrainSymbol & q

                SQLValues = SQLValues & s & q & Me.AuthorityStatus & q
                SQLValues = SQLValues & s & q & Me.JointWithTrain & q
                SQLValues = SQLValues & s & q & Me.JointWithMOW & q
                SQLValues = SQLValues & s & q & Me.TagInfo & q
                SQLValues = SQLValues & s & q & Me.OptionalJoint & q

                Dim JointUsed As String = ""
                Dim str As String = ""
                If Me.JointUsed IsNot Nothing AndAlso Me.JointUsed.Count > 0 Then
                    For Each str In Me.JointUsed
                        If str.Trim <> "" Then
                            If JointUsed.Trim = "" Then
                                JointUsed = str.Trim
                            Else
                                JointUsed = JointUsed & "|" & str.Trim
                            End If
                        End If
                    Next
                End If
                SQLValues = SQLValues & s & q & JointUsed & q

                'Me.JointWithTrain = .myJointWithTrain
                'Me.JointWithMOW = .myJointWithTrain
                'Me.TagInfo = .myTagInfo
                'Me.OptionalJoint = .myOptionalJoint

                SQLValues = SQLValues & ")"

                Dim InsertCommand As String = "INSERT INTO " & dbTable & SQLFields & SQLValues
                Return InsertCommand

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        ''' <summary>
        ''' Update SFA components
        ''' </summary>
        ''' <returns></returns>
        Public Function UpdateSFAComponents() As Boolean
            Dim dbconn As OleDbConnection = Nothing
            Dim CommandInsert As OleDbCommand = Nothing
            Dim UpdateString As String = String.Empty
            Dim s As String = ","
            Dim q As String = "'"
            Dim comp As Object
            Dim CompList As String = String.Empty
            Dim CompList2 As String = String.Empty
            Try
                For Each comp In Me.Components
                    If Not IsNothing(comp) Then
                        CompList = CompList & comp.GUID & "-"
                    End If
                Next
                For Each comp In Me.Components4
                    If Not IsNothing(comp) Then
                        CompList2 = CompList2 & comp.GUID & "-"
                    End If
                Next
                UpdateString = "UPDATE " & gtblSFAActive
                UpdateString = UpdateString & " SET Components = " & q & CompList & q & s
                UpdateString = UpdateString & " Components4 = " & q & CompList2 & q
                UpdateString = UpdateString & " WHERE AuthGUID = " & q & Me.AuthGUID & q
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                dbconn.Open()
                CommandInsert = New OleDbCommand(UpdateString, dbconn)
                CommandInsert.ExecuteNonQuery()
                Return True
