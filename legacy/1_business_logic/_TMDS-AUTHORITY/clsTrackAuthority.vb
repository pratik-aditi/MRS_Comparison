#Region "DATABASE"

        Public Function RemoveActiveTrackWarrantFromDB(ByVal dbConnection As OleDbConnection) As Boolean
            Dim dbconn As OleDbConnection
            Dim CommandInsert, CommandDelete As OleDbCommand
            Dim Message As String

            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)

                Dim WarrantInsertSQL As String = Me.SetTrackWarrantNewInsertCommand(IndexMe, gtblWarrantsInActive)
                CommandInsert = New OleDbCommand(WarrantInsertSQL, dbconn)

                Dim WarrantDeleteSQL As String = "DELETE FROM " & gtblWarrantsActive & " WHERE WarrantNum = " & "'" & pWarrantNum.ToString & "' AND TerritoryAssignmentID = " & pTerritoryAssignment
                CommandDelete = New OleDbCommand(WarrantDeleteSQL, dbconn)
                dbconn.Open()

                CommandInsert.ExecuteNonQuery()
                Message = "TRACK WARRANT INSERTED INTO INACTIVE WARRANT TABLE:" & Me.WarrantNumber.ToString
                TMDS.SystemUtilities.Utilities.SystemEvent(Message)

                CommandDelete.ExecuteNonQuery()
                Message = "TRACK WARRANT DELETED FROM ACTIVE WARRANT TABLE:" & Me.WarrantNumber.ToString
                TMDS.SystemUtilities.Utilities.SystemEvent(Message)


                dbconn.Close()
                CommandInsert = Nothing
                CommandDelete = Nothing
                dbconn = Nothing

                Dim DoAddAuthorityEvent As New DoEventLogWarrant(AddressOf Me.LogTheWarrantEvent)
                DoAddAuthorityEvent.BeginInvoke(EventTypeWarrant.REMOVE, Nothing, Nothing)

