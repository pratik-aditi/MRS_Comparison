        ''' <summary>
        ''' Remove device block from db
        ''' </summary>
        ''' <param name="isRemoteDatabaseLink">is Remote Database Link</param>
        ''' <returns><see langword="True"/>Device block removed, <see langword="False"/> otherwise.</returns>
        Public Function RemoveDeviceBlockFromDB(Optional isRemoteDatabaseLink As Boolean = False) As Boolean
            Try
                If Not gRepositories.DeviceBlockRepository.
                    RemoveDeviceBlock(BlockGUID,
                                      AuthorityUID,
                                      TerritoryAssignment,
                                      SetDeviceBlockInsertCommand("tmdsDatabaseDynamic..tblDeviceBlocksInActive")) Then
                    Return False
                End If
                BlockEvent($"DEVICE BLOCK REMOVE FROM DATABASE:{AuthorityUID}")
                If Not isRemoteDatabaseLink Then
                    Dim DoAddDeviceBlockEvent As New DoEventLogDeviceBlock(AddressOf LogTheDeviceBlockEvent)
                    DoAddDeviceBlockEvent.BeginInvoke(EventTypeDevBlk.REMOVE, Nothing, Nothing)
                    Dim DoDeviceBlockEvent As New DoPublishDeviceBlockEvent(AddressOf PublishDeviceBlockEventUpdate)
                    DoDeviceBlockEvent.BeginInvoke(EventTypeDevBlk.REMOVE, Nothing, Nothing)
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        ''' <summary>
        ''' Add device block to db
        ''' </summary>
        ''' <param name="isRemoteDatabaseLink">is Remote Database Link</param>
        ''' <returns><see langword="True"/>Device block added, <see langword="False"/> otherwise.</returns>
        Public Function AddDeviceBlockToDB(Optional isRemoteDatabaseLink As Boolean = False) As Boolean
            Try
                If Not gRepositories.DeviceBlockRepository.AddDeviceBlock(
                    SetDeviceBlockInsertCommand("tmdsDatabaseDynamic..tblDeviceBlocksActive")) Then
                    Return False
                End If
                BlockEvent($"DEVICE BLOCK ADDED TO DATABASE:{AuthorityUID}")
                If Not isRemoteDatabaseLink Then
                    Dim doAddDeviceBlockEvent As New DoEventLogDeviceBlock(AddressOf LogTheDeviceBlockEvent)
                    doAddDeviceBlockEvent.BeginInvoke(EventTypeDevBlk.ADD, Nothing, Nothing)
                    Dim doDeviceBlockEvent As New DoPublishDeviceBlockEvent(AddressOf PublishDeviceBlockEventUpdate)
                    doDeviceBlockEvent.BeginInvoke(EventTypeDevBlk.ADD, Nothing, Nothing)
                    If optUseDurationTimeForDeviceBlocks Then UpdateDeviceBlockWithDurationTime()
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Function SetDeviceBlockInsertCommand(ByVal dbTable As String) As String

            Dim SQLFields As String
            Dim SQLValues As String
            Dim s As String = ","
            Dim q As String = "'"
            Dim PTCBlockData As String = ""
            Dim sSetDeviceBlockInsertCommand As String = String.Empty
            Try
                If Me.IsPRS Then
                    PTCBlockData = "PRS|" & Me.PTCIssueTo & "|" & Me.PTCTrainGUID & "|" & Me.PTCVerbiage
                ElseIf Me.IsEMT Then
                    PTCBlockData = "EMT|" & Me.PTCIssueTo & "|" & Me.PTCTrainGUID & "|" & Me.PTCVerbiage
                End If



                'FIELDS
                SQLFields = "(AuthorityNumber, RailRoadName, DispatcherName, CreateDate, Direction, AuthorityDate"
                SQLFields = SQLFields & ", AuthorityType, IssueTo, AuthorityLimits, OKTime"
                SQLFields = SQLFields & ", UntilTime, MobileID, Components, ReportClear, TerritoryAssignment, BlockNotes"
                SQLFields = SQLFields & ", AuthorityUID, TerritoryAssignmentSecondary, BlockGUID"
                SQLFields = SQLFields & ", TerrIDTeritary, TerrIDQuadtary, ReportClearBy, WorkCraft, TrackName, PTCBlockData, AllowFieldBlocking"

                SQLFields = SQLFields & ")"

                'VALUES
                SQLValues = " VALUES ("
                SQLValues = SQLValues & q & AuthorityNumber & q & s & q & RailRoadName & q & s & q & DispatcherName & q & s & q & CreateDate & q
                SQLValues = SQLValues & s & q & Direction & q & s & q & AuthorityDate & q & s & q & AuthorityType & q & s & q & IssueTo & q
                SQLValues = SQLValues & s & q & AuthorityLimits & q & s & q & OKTime & q & s & q & UntilTime & q & s & q & MobileID & q
                SQLValues = SQLValues & s & q
                Dim comp As Object
                For Each comp In Me.ComponentsInSelection
                    SQLValues = SQLValues & CStr(comp.GUID) & "|"
                Next
                SQLValues = SQLValues & q
                SQLValues = SQLValues & s & q & Me.ReportClear & q & s & q & Me.TerritoryAssignment & q & s & q & SpclToEsc(Me.BlockNotes) & q & s & q & Me.AuthorityUID & q
                SQLValues = SQLValues & s & q & Me.TerritoryAssignmentSecondary & q & s & q & Me.BlockGUID & q
                SQLValues = SQLValues & s & q & Me.TerrIDTeritary & q & s & q & Me.TerrIDQuadtary & q
                SQLValues = SQLValues & s & q & Me.ReportClearBy & q & s & q & Me.WorkCraft & q & s & q & Me.TrackName & q
                Select Case Me.OverrideFieldBlocking
                    Case True
                        SQLValues = SQLValues & s & q & PTCBlockData & q & s & 0
                    Case Else
                        SQLValues = SQLValues & s & q & PTCBlockData & q & s & 1
                End Select

                SQLValues = SQLValues & ")"

                sSetDeviceBlockInsertCommand = "INSERT INTO " & dbTable & SQLFields & SQLValues
                Return sSetDeviceBlockInsertCommand
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

