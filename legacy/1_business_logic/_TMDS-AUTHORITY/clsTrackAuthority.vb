        Private Function GetTrackSpeed(ByVal trk As Track, ByVal TrainType As String) As String
            Try
                Select Case TrainType
                    Case "PASSENGER"
                        Return trk.TrackSpeeds.Item(0)
                    Case "FREIGHT"
                        Return trk.TrackSpeeds.Item(1)
                    Case "LIGHT ENG"
                        Return trk.TrackSpeeds.Item(2)
                    Case Else
                        Return "00"
                End Select

            Catch ex As Exception
                Return "00"
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function GetTrainType(ByVal IssueTo As String) As String
            Try
                Dim trn As TrainID
                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.IdentifingUnit = IssueTo Then
                        Return trn.TrainType
                    End If
                Next
                Return "00"
            Catch ex As Exception
                SystemException(ex.ToString)
                Return "00"
            End Try
        End Function
