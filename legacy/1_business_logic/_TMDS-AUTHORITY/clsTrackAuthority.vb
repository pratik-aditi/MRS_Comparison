        Private Sub AddOSComponentsToList(ByVal sw As Switch, ByRef theList As ArrayList)
            Try
                Dim comp As Object
                For Each comp In sw.OsComponentCollection
                    If comp.GetType.ToString = gTrackComponentName Then
                        If DoesContainMixModeAuthority(comp) Then
                            If Not theList.Contains(comp) Then
                                theList.Add(comp)
                            End If
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub AddOSLikeComponentsToList(ByVal sw As Switch, ByRef theList As ArrayList)
            Try
                Dim comp As Object
                Dim trk As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(sw.OsComponentCollection)

                For Each comp In sw.myControlPoint.AssignedComponenets
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim t As Track = CType(comp, Track)
                        If t.OStype AndAlso t.TrackName = trk.TrackName AndAlso t.LeftLimitName = trk.LeftLimitName AndAlso t.RightLimitName = trk.RightLimitName Then
                            If DoesContainMixModeAuthority(comp) Then
                                Dim OsSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSTrackLeg(t)
                                If Not IsNothing(OsSw) Then
                                    If Not theList.Contains(OsSw) Then
                                        theList.Add(OsSw)
                                    End If
                                End If
                                If Not theList.Contains(comp) Then
                                    theList.Add(comp)
                                End If
                            End If
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function DoesContainMixModeAuthority(ByVal theTrack As Track) As Boolean
            Try
                If theTrack.TrackAuthorities.Count = 0 Then Return False
                Dim auth As Object
                For Each auth In theTrack.TrackAuthorities
                    Select Case auth.GetType.ToString
                        Case "TMDS.TrackAuthority.TrackAuthority"
                            Dim ta As TrackAuthority = CType(auth, TrackAuthority)
                            If ta.AuthorityUID = Me.AuthorityUID Then
                                Return True
                            End If
                        Case "TMDS.TrackAuthority.SFAuthority"
                            Dim ta As SFAuthority = CType(auth, SFAuthority)
                            If ta.AuthorityUID = Me.AuthorityUID Then
                                Return True
                            End If
                    End Select
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function
        Private Function GetCTCSwitchPostionMixedAuthority(ByVal theTrack As Track, ByVal theSwitch As Switch, ByRef IsReversed As Boolean) As Boolean
            Try
                If theTrack.TrackAuthorities.Count = 0 Then Return False
                Dim auth As Object
                For Each auth In theTrack.TrackAuthorities
                    Select Case auth.GetType.ToString
                        Case "TMDS.TrackAuthority.TrackAuthority"
                            Dim ta As TrackAuthority = CType(auth, TrackAuthority)
                            If ta.AuthorityUID = Me.AuthorityUID Then
                                If ta.SwitchPointList IsNot Nothing AndAlso ta.SwitchPointList.Count > 0 Then
                                    Dim swpt As SwitchPoint = Nothing
                                    For Each swpt In ta.SwitchPointList
                                        If swpt.mySwitch.GUID = theSwitch.GUID Then
                                            IsReversed = swpt.ReversePosition
                                            Return True
                                        End If
                                    Next
                                End If
                            End If
                        Case "TMDS.TrackAuthority.SFAuthority"
                            Dim ta As SFAuthority = CType(auth, SFAuthority)
                            If ta.AuthorityUID = Me.AuthorityUID Then
                                IsReversed = theSwitch.ControlledReverse
                                Return True
                            End If
                    End Select
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Sub DoRemoveMixModeAuthorityFromComponents()
            Try
                Dim comp As Object
                For Each comp In MixModeRollupList
                    Dim auth As Object = FindMixModeAuthority(comp)
                    If Not IsNothing(auth) Then
                        If Not MixModeAuthorityList.Contains(auth) Then
                            MixModeAuthorityList.Add(auth)
                        End If
                        Select Case auth.GetType.ToString
                            Case "TMDS.TrackAuthority.TrackAuthority"
                                Dim a As TrackAuthority = CType(auth, TrackAuthority)
                                a.ComponentsInSelection.Remove(comp)
                                comp.TrackAuthorities.Remove(a)
                                comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                comp.UpdateStatus()
                                GenerateScripts(a, SimulatorScriptAction.SFAROLLUP)
                            Case "TMDS.TrackAuthority.SFAuthority"
                                Dim a As SFAuthority = CType(auth, SFAuthority)
                                a.Components.Remove(comp)
                                comp.TrackAuthorities.Remove(a)
                                comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                comp.UpdateStatus()
                                comp.InitAuthorityNumbers()
                                a.UpdateDatabaseWithRollUpEvent()
                                a.CreateReducedLimitsVerbiage()
                                GenerateScripts(a, SimulatorScriptAction.SFAROLLUP)
                        End Select
                    End If
                Next

                Dim ta As Object
                For Each ta In MixModeAuthorityList
                    Select Case ta.GetType.ToString
                        Case "TMDS.TrackAuthority.TrackAuthority"
                            Dim a As TrackAuthority = CType(ta, TrackAuthority)
                            If a.ComponentsInSelection.Count = 0 Then
                                DoPerformReleaseMixModeAuthority(a)
                            End If
                        Case "TMDS.TrackAuthority.SFAuthority"
                            Dim a As SFAuthority = CType(ta, SFAuthority)
                            If a.Components.Count = 0 Then
                                DoPerformReleaseMixModeAuthority(a)
                            End If
                    End Select
                Next
                MixModeAuthorityList.Clear()
                MixModeRollupList.Clear()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindMixModeAuthority(ByVal comp As Object) As Object
            Try
                Select Case comp.GetType.ToString
                    Case gTrackComponentName
                        Dim trk As Track = CType(comp, Track)
                        If trk.TrackAuthorities.Count > 0 Then
                            Dim auth As Object
                            For Each auth In trk.TrackAuthorities
                                Select Case auth.GetType.ToString
                                    Case "TMDS.TrackAuthority.TrackAuthority"
                                        Dim t As TrackAuthority = CType(auth, TrackAuthority)
                                        If t.AuthorityUID = Me.AuthorityUID Then
                                            Return t
                                        End If
                                    Case "TMDS.TrackAuthority.SFAuthority"
                                        Dim t As SFAuthority = CType(auth, SFAuthority)
                                        If t.AuthorityUID = Me.AuthorityUID Then
                                            Return t
                                        End If
                                End Select
                            Next
                        End If
                    Case gSwitchComponentName
                        Dim sw As Switch = CType(comp, Switch)
                        If sw.TrackAuthorities.Count > 0 Then
                            Dim auth As Object
                            For Each auth In sw.TrackAuthorities
                                Select Case auth.GetType.ToString
                                    Case "TMDS.TrackAuthority.TrackAuthority"
                                        Dim t As TrackAuthority = CType(auth, TrackAuthority)
                                        If t.AuthorityUID = Me.AuthorityUID Then
                                            Return t
                                        End If
                                    Case "TMDS.TrackAuthority.SFAuthority"
                                        Dim t As SFAuthority = CType(auth, SFAuthority)
                                        If t.AuthorityUID = Me.AuthorityUID Then
                                            Return t
                                        End If
                                End Select
                            Next
                        End If
                End Select
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Sub DoPerformReleaseMixModeAuthority(ByVal auth As Object)
            Try
                Select Case auth.GetType.ToString
                    Case "TMDS.TrackAuthority.TrackAuthority"
                        Dim a As TrackAuthority = CType(auth, TrackAuthority)
                        If a.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                            If a.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                GenerateScripts(a, SimulatorScriptAction.SFAREPORTCLEAR)
                                a.RemoveTrackAuthFromRemoteLinks()
                                OtherTrackAuthorities.Remove(a)
                                Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", a)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock
                            End If
                            a.RemoveBlockingToRemoteLinkTrack(a.ComponentsInSelection)
                        End If

                    Case "TMDS.TrackAuthority.SFAuthority"
                        Dim a As SFAuthority = CType(auth, SFAuthority)

                        If a.RemoveSFAVIIAuthorityFromDB(Nothing) Then
                            If a.RemoveAuthorityFromComponents(False) Then
                                GenerateScripts(a, SimulatorScriptAction.SFAREPORTCLEAR)
                                TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(a)
                                Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", a)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock
                            End If
                        End If
                End Select


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Private Function GetNextCTCCompForMixedMode(ByRef NextTrack As Track, ByRef Rolluplist As ArrayList) As Track
            If optEnableARRCSpecificOptions AndAlso Me.MixModeAuthorityType Then
                Dim auth As Object
                Dim TNT As TMDS.TrackAuthority.TrackAuthority = Nothing
                For Each auth In NextTrack.TrackAuthorities
                    Select Case auth.GetType.ToString
                        Case "TMDS.TrackAuthority.TrackAuthority"
                            Dim ta As TrackAuthority = CType(auth, TrackAuthority)
                            If ta.AuthorityUID = Me.AuthorityUID Then
                                TNT = ta
                                Exit For
                            End If

                    End Select
                Next
                If TNT Is Nothing Then Return NextTrack
                Dim TrackSelectedOsCompList As New ArrayList
                TrackSelectedOsCompList.Add(NextTrack)
                NextTrack.AddOSComponents(TrackSelectedOsCompList)
                NextTrack.ExtendOSComponents(TrackSelectedOsCompList)
                NextTrack.ExpandOutForComponents(TrackSelectedOsCompList)
                TMDS.SystemUtilities.FetchData.FindLikeComponents(TrackSelectedOsCompList, NextTrack.OsComponentCollection)
                Dim RtTrk As Track = Nothing
                Dim ltTrk As Track = Nothing
                Dim Comp As Object = Nothing
                Dim tmpComp As Object = Nothing
                Try
                    For Each Comp In TNT.ComponentsInSelection
                        If Comp.GetType.ToString = gTrackComponentName Then
                            If Not TrackSelectedOsCompList.Contains(Comp) Then
                                RtTrk = Nothing
                                ltTrk = Nothing
                                ltTrk = TMDS.SystemUtilities.FetchData.FindAbbutingTrack("LEFT", Comp)
                                RtTrk = TMDS.SystemUtilities.FetchData.FindAbbutingTrack("RIGHT", Comp)
                                If ltTrk IsNot Nothing AndAlso TrackSelectedOsCompList.Contains(ltTrk) Then
                                    NextTrack = ltTrk
                                    For Each tmpComp In TrackSelectedOsCompList
                                        If Not Rolluplist.Contains(tmpComp) Then Rolluplist.Add(tmpComp)
                                    Next

                                    Exit For
                                ElseIf RtTrk IsNot Nothing AndAlso TrackSelectedOsCompList.Contains(RtTrk) Then
                                    NextTrack = RtTrk
                                    For Each tmpComp In TrackSelectedOsCompList
                                        If Not Rolluplist.Contains(tmpComp) Then Rolluplist.Add(tmpComp)
                                    Next
                                    Exit For
                                End If
                            End If
                        End If
                    Next
                Catch ex As Exception
                    GetErrorDetails(ex)
                Finally
                    RtTrk = Nothing
                    ltTrk = Nothing
                End Try
            End If
            Return Nothing
        End Function

        Private Function PerformARRCRollupEvents(RollupCollection As ArrayList, trn As TrainID) As Boolean
            Dim Comp As Object = Nothing
            Dim OsReportingTracksList As New ArrayList
            Dim Te As TrainEvent = Nothing
            Dim EventCollection As New ArrayList
            Try
                For Each Comp In RollupCollection
                    If Comp IsNot Nothing AndAlso Comp.GetType.ToString = gTrackComponentName AndAlso Comp.OSReporting Then
                        If Not OsReportingTracksList.Contains(Comp) Then OsReportingTracksList.Add(Comp)
                    End If
                Next
                If trn.myEventList Is Nothing OrElse trn.myEventList.Count = 0 Then
                    trn.PerformTrainEvents()
                End If
                If trn.myEventList IsNot Nothing OrElse trn.myEventList.Count > 0 Then
                    For Each Te In trn.myEventList
                        Select Case Te.EventType.Trim.ToUpper
                            Case "TRAIN OS EVENT ARRIVAL", "TRAIN OS EVENT DEPARTURE"
                                If Te.IdentifingPointUID > 0 Then
                                    Dim Oste As New OSEventType
                                    Dim cp As ControlPoint = TMDS.SystemUtilities.FetchData.FindCPFromGUID(Te.IdentifingPointUID)
                                    If cp IsNot Nothing Then
                                        With Oste
                                            .ControlPointName = cp.Name
                                            .EventTime = Te.EventTimeStamp
                                            If Te.EventType.Trim.ToUpper = "TRAIN OS EVENT ARRIVAL" Then
                                                .ArrivalEvent = True
                                            End If
                                        End With
                                        If Not EventCollection.Contains(Oste) Then EventCollection.Add(Oste)
                                    End If
                                End If
                        End Select
                    Next
                End If




            Catch ex As Exception

            End Try
        End Function

        Friend Class OSEventType
            Public myGUID As String = Guid.NewGuid.ToString.ToUpper
            Public ControlPointName As String = String.Empty
            Public ArrivalEvent As Boolean = False
            Public EventTime As Date
        End Class

        Public Sub SendControl(ByVal CompList As ArrayList)
            Dim CompCollection As New ArrayList
            Dim comp As Object = Nothing
            Dim trk As Track = Nothing
            Dim CPLIST As New ArrayList()
            Dim cp As ControlPoint
            Try
                For Each comp In CompList
                    If comp IsNot Nothing AndAlso comp.GetType.ToString = gTrackComponentName Then
                        trk = Nothing
                        trk = TryCast(comp, Track)
                        If trk IsNot Nothing AndAlso Mid(trk.AuthorityType, 1, 3) = "CTC" Then
                            If Not CompCollection.Contains(trk) Then CompCollection.Add(trk)
                        End If
                    End If
                Next
                comp = Nothing
                trk = Nothing

                If CompCollection IsNot Nothing AndAlso CompCollection.Count > 0 Then
                Else
                    Exit Sub
                End If



                If CompCollection IsNot Nothing AndAlso CompCollection.Count > 0 Then
                    For Each comp In CompCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            trk = CType(comp, Track)
                            Dim leftSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalLeftFromGUID(trk.LeftLink)
                            Dim rightSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalRightFromGUID(trk.RightLink)

                            If Not CPLIST.Contains(trk.myControlPoint) Then
                                CPLIST.Add(trk.myControlPoint)
                            End If

                            If Not IsNothing(leftSig) Then
                                If Not CPLIST.Contains(leftSig.myControlPoint) Then
                                    CPLIST.Add(leftSig.myControlPoint)
                                End If
                            End If
                            If Not IsNothing(rightSig) Then
                                If Not CPLIST.Contains(rightSig.myControlPoint) Then
                                    CPLIST.Add(rightSig.myControlPoint)
                                End If
                            End If
                        End If
                    Next

                    For Each cp In CPLIST
                        cp.FindCodeStationToSend(cp)
                        cp.SendCodeStationControlSpecial(True)
                    Next
                End If
            Catch ex As Exception
                GetErrorDetails(ex, "SFA-SendControl")
            Finally
                CompCollection = Nothing
                comp = Nothing
                trk = Nothing
                CPLIST = Nothing
                cp = Nothing
            End Try
        End Sub

