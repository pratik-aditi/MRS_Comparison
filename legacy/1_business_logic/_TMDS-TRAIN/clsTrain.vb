        Public Sub CalculateTotalTonAndTotalLength(CallingMethod As String, Optional ByVal IgnoreRefresh As Boolean = True)
            Dim u As TrainUnit
            Dim UnitLength As Double = 0
            Dim UnitTon As Double = 0
            Dim thisTotalLength As Double = 0
            Dim thisTotalTon As Double = 0
            Dim thisTotalHPT As Double = 0
            Dim IgnoreLeadEngine As Boolean = False
            Dim OLDGrossTon As Double = Me.GrossTon
            Dim OldGrossLength As Double = Me.TotalLength
            Try
                If CallingMethod IsNot Nothing AndAlso CallingMethod.Trim <> "" Then
                    SystemDiagnosticEvent("CalculateTotalTonAndTotalLength Called by: " & CallingMethod & " For Train: " & Me.Name)
                End If
                If Me.UnitsInTrain IsNot Nothing AndAlso Me.UnitsInTrain.Count > 0 Then
                    For Each u In Me.UnitsInTrain
                        If Not String.IsNullOrEmpty(u.UnitNumber) Then
                            UnitLength = 0
                            UnitTon = 0
                            thisTotalHPT = thisTotalHPT + u.EffectiveHP
                            GetUnitLengthAndWeight(u.UnitNumber, UnitLength, UnitTon)
                            If UnitLength > 0 Then thisTotalLength = thisTotalLength + UnitLength
                            If UnitTon > 0 Then thisTotalTon = thisTotalTon + UnitTon
                        End If
                    Next
                End If
                thisTotalTon = thisTotalTon + Me.OTons
                thisTotalLength = thisTotalLength + Me.OLength

                Me.GrossTon = Math.Ceiling(thisTotalTon)
                Me.TotalLength = thisTotalLength
                Me.TotalHorsePower = thisTotalHPT
                If Not IgnoreRefresh Then
                    Dim SummItem As New SummaryItem("TRAIN", "MODIFY", Me)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                    End SyncLock
                End If
                If Double.IsInfinity(OLDGrossTon) Then OLDGrossTon = 0
                If Double.IsInfinity(Me.GrossTon) Then Me.GrossTon = 0
                If OldGrossLength <> Me.TotalLength OrElse OLDGrossTon <> Me.GrossTon Then
                    UpdateTrainGrossTonLength()
                    If optApplyTrainSheetConfigurationForARRC Then
                        If OLDGrossTon <> Me.GrossTon Then
                            Dim OGT As Double = 0 : If Not Double.IsInfinity(OLDGrossTon) Then OGT = OLDGrossTon
                            Dim ConsistChange As String = "GROSS TONS CHANGED FROM " & Space(1) & OGT.ToString & Space(1) & optTrainString8 & Space(1) & GrossTon.ToString
                            TrainEventLog("TRAIN CONSIST CHANGE:" & Me.Name & " (" & ConsistChange & ")")
                            Dim RRUID As String = "NONE"
                            If Me.myTrack IsNot Nothing Then
                                RRUID = Me.myTrack.myControlPoint.UniqueName
                                Me.AddTrainSheetEvent("CONSIST CHANGE", Now, Mid(Me.myTrack.TimeZone, 1, 1), ConsistChange, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, RRUID)
                            End If
                        End If
                        If OldGrossLength <> Me.TotalLength Then
                            Dim ConsistChange As String = "GROSS LENGTH CHANGED FROM " & Space(1) & OldGrossLength.ToString & Space(1) & optTrainString8 & Space(1) & TotalLength.ToString
                            TrainEventLog("TRAIN CONSIST CHANGE:" & Me.Name & " (" & ConsistChange & ")")
                            Dim RRUID As String = Me.myTrack.myControlPoint.UniqueName
                            Me.AddTrainSheetEvent("CONSIST CHANGE", Now, Mid(Me.myTrack.TimeZone, 1, 1), ConsistChange, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, RRUID)
                        End If
                        'Me.UpdateTrainConsistForPTC()
                    End If
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Public Function GetMyLocoMotivesLength() As Integer
            Dim u As TrainUnit
            Dim UnitLength As Double = 0
            Dim thisTotalLength As Double = 0
            Try
                If Me.UnitsInTrain IsNot Nothing AndAlso Me.UnitsInTrain.Count > 0 Then
                    For Each u In Me.UnitsInTrain
                        If Not String.IsNullOrEmpty(u.UnitNumber) Then
                            UnitLength = 0
                            GetUnitLength(u.UnitNumber, UnitLength)
                            If UnitLength > 0 Then thisTotalLength = thisTotalLength + UnitLength
                        End If
                    Next
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return thisTotalLength
        End Function

        Private Sub GetUnitLengthAndWeight(ByVal UnitID As String, ByRef UnitLength As Double, ByRef UnitTon As Double)
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim SQLQuery As String = "SELECT Length,Weight FROM tblSystemLocomotives WHERE UID='" & UnitID & "'"
            Dim ULength As Double = 0
            Dim UWeight As Double = 0
            Try
                Using DbConn As New OleDbConnection(gConnectionStringStatic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        ULength = 0
                        UWeight = 0
                        If Not dr.IsDBNull(0) Then
                            Double.TryParse(dr.GetInt32(0), ULength)
                        End If

                        If Not dr.IsDBNull(1) Then
                            Double.TryParse(dr.GetInt32(1), UWeight)
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
                If ULength > 0 Then
                    UnitLength = ULength
                End If
                If UWeight > 0 Then
                    UnitTon = Format(ConvertPoundToTons(UWeight, False), optHPTStringFormat)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Sub

        Public Sub TrainDirectionChangeCheck(ByVal theDirection As String)
            Try
                If theDirection = Me.Direction Then Exit Sub
                Dim theComponents As New ArrayList
                Dim foundFlipFlopTrack As Boolean

                If Me.myTrack.OStype Then
                    If Not IsNothing(Me.myTrack.OsComponentCollection) Then
                        theComponents = Me.myTrack.OsComponentCollection.Clone
                    Else
                        theComponents.Add(myTrack)
                    End If
                Else
                    theComponents.Add(myTrack)
                End If

                Dim Nextcomp As Object = Me.myTrack
                Dim LoopControl As Integer
                Dim NewDirection As String
                Do
                    Select Case theDirection
                        Case optDirectionNorth
                            NewDirection = "RIGHT"
                            If Nextcomp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(Nextcomp, Signal)
                                If sig.ComponentType = "R" AndAlso Not sig.AutomaticSignal Then Exit Do
                            End If

                            If Nextcomp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(Nextcomp, Switch)
                                If sw.RightAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        Nextcomp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Nextcomp.RightAltLink)
                                    Else
                                        Nextcomp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Nextcomp.RightLink)
                                    End If
                                Else
                                    Nextcomp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Nextcomp.RightLink)
                                End If
                            Else
                                Nextcomp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Nextcomp.RightLink)
                            End If
                            If Nextcomp.GetType.ToString <> gSignalComponentName Then
                                theComponents.Add(Nextcomp)
                            End If
                        Case optDirectionSouth
                            NewDirection = "LEFT"
                            If Nextcomp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(Nextcomp, Signal)
                                If sig.ComponentType = "L" AndAlso Not sig.AutomaticSignal Then Exit Do
                            End If

                            If Nextcomp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(Nextcomp, Switch)
                                If sw.RightAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        Nextcomp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Nextcomp.LeftAltLink)
                                    Else
                                        Nextcomp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Nextcomp.LeftLink)
                                    End If
                                Else
                                    Nextcomp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Nextcomp.LeftLink)
                                End If
                            Else
                                Nextcomp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Nextcomp.LeftLink)
                            End If
                            If Nextcomp.GetType.ToString <> gSignalComponentName Then
                                theComponents.Add(Nextcomp)
                            End If

                        Case Else
                            Exit Sub
                    End Select
                    LoopControl += 1
                    If LoopControl > 10 Then
                        Exit Sub
                    End If
                Loop

                For Each Nextcomp In theComponents
                    If Nextcomp.Occuppied Then
                        If Nextcomp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(Nextcomp, Track)
                            If trk.TrackAuthorities.Count > 0 Then
                                Dim auth As TrackAuthority.TrackAuthority = trk.TrackAuthorities.Item(0)
                                If auth.TrainSymbol = Me.Name Then
                                    auth.Direction = NewDirection
                                End If
                            End If
                            If trk.IsLinkToFlipFlopToRight OrElse trk.IsLinkToFlipFlopToLeft Then
                                ' Beep()
                                foundFlipFlopTrack = True
                            End If
                        End If

                        If Not foundFlipFlopTrack Then
                            Nextcomp.TrafficDirection = NewDirection
                            Nextcomp.UpdateStatus()
                        End If

                    End If


                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

