        Public Sub ConfirmDeliveryOfBulletin(ByVal theBull As SubBulletin, Optional ByVal EventInfo As String = Nothing)
            Try
                Dim EventString As String = String.Empty
                If IsNothing(EventInfo) Then
                    EventString = theBull.PTCBulletinText
                Else
                    EventString = EventInfo
                End If

                Me.AddTrainSheetEvent("BULLETIN DELIVERY", Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, "NONE")

                If optLogBulletinEventOnTrain AndAlso theBull IsNot Nothing Then
                    'CANCELING Track Bulletin No  # (4151) - FORM C
                    If Not String.IsNullOrEmpty(theBull.CancelledBulletinUID) AndAlso theBull.CancelledBulletinUID.Trim <> "" Then
                        Dim BULLData() As String = theBull.BulletinReadData.Split("|")
                        EventString = BULLData(1).Trim.Replace("<", "")
                        EventString = EventString.Replace(">", "")
                        EventString = EventString & " - Delivered"
                        'EventString = "CANCELING Track Bulletin No  # (" & theBull.CancelledBulletinUID & ")(" & theBull.mysTypeForm & ") - Delivered"
                    Else
                        EventString = "Track Bulletin No  # (" & theBull.myUID & ")(" & theBull.mysTypeForm & ") - Delivered"
                    End If
                    Me.AddTrainSheetEvent("BULLETIN EVENT", Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, "NONE")
                End If


            Catch ex As Exception
