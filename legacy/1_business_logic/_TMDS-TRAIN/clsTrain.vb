        Friend Function CheckForRestrictionConflict(ByVal myCompList As ArrayList, ByVal ThisTrainTGBO As TabularGeneralBulletin) As Boolean
            Dim tr As TrainRestriction = Nothing
            Dim HasConflict As Boolean = False
            Dim RestrictionConflicts As New ArrayList
            Try
                If Me.myRestrictionList IsNot Nothing AndAlso Me.myRestrictionList.Count > 0 Then
                    For Each tr In Me.myRestrictionList
                        If String.IsNullOrEmpty(tr.myBulletinGUID) OrElse tr.myBulletinGUID.Trim = String.Empty Then
                            If tr.IsOnTrain AndAlso OkToEnforceThisRestriction(tr, myCompList, ThisTrainTGBO) Then
                                HasConflict = True
                                'Exit For
                                If Not RestrictionConflicts.Contains(tr) Then RestrictionConflicts.Add(tr)
                            End If
                        End If
                    Next

                End If
                If HasConflict Then
                    Dim StrRestriction As New StringBuilder("CheckForRestrictionConflict: ")
                    If RestrictionConflicts IsNot Nothing AndAlso RestrictionConflicts.Count > 0 Then
                        For Each tr In RestrictionConflicts
                            With StrRestriction
                                .Append(tr.myCarUID & " - " & tr.myUID & " - " & tr.myDescription & vbCrLf)
                            End With
                        Next
                    Else
                        StrRestriction.Append("ERROR HAS NO RESTICTIONS ")
                    End If

                    TrainEventLog(Me.Name & " HAS THESE RESTRICTIONS " & vbCrLf & StrRestriction.ToString)
                Else
                    Return True
                End If

            Catch ex As Exception
                GetErrorDetails(ex, "CheckForRestrictionConflict")
                TrainEventLog("VALIDATING TRAIN RESTICTIONS ERROR. CHECK EXCEPTION LOG ")
            End Try
        End Function

