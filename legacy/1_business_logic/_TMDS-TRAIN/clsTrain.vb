        Public Function GetTrainReportDataString(ByVal DelayCode As String, ByVal DelayTime As Integer, Optional ByVal CorrelatingControlPoint As Int32 = 0, Optional ByVal RailRoadUniqueName As String = "", Optional ByVal ReportingPerson As String = "") As String
            Try
                Dim data As New System.Text.StringBuilder
                Dim EventTimePerTimeZone As Date = Now

                Select Case Mid(Me.myTrack.TimeZone, 1, 1)
                    Case "E"
                        EventTimePerTimeZone = Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor))
                    Case "M"
                        EventTimePerTimeZone = Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor))
                    Case "P"
                        EventTimePerTimeZone = Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor))
                    Case Else
                        EventTimePerTimeZone = Now.AddHours(CDbl(gThisWorkstationTimeFactor))
                End Select



                data.Append(Name & "|")
                data.Append(EventTimePerTimeZone.ToString & "|")
                data.Append(Me.OLoads & "|")
                data.Append(Me.OEmts & "|")
                data.Append(Me.OTons & "|")
                data.Append(Me.OLength & "|")
                data.Append(Me.EOTD & "|")
                data.Append(Me.GetTrainUnitString & "|")
                ''// Code added by William Groh - Commenting it out- Raja
                ''Code Begins: Added to resolve 6.1.2.1B Consist Tab
                'data.Append(Me.NumberOfAxles & "|")
                'data.Append(Me.NumberOperatingBrakes & "|")
                ''Code Ends //
                data.Append(Me.GetIdentifyingLocationNameFromLimits & "|")
                If CorrelatingControlPoint = 0 Then
                    data.Append(Me.myTrack.myControlPoint.GUID & "|")
                Else
                    data.Append(CorrelatingControlPoint & "|")
                End If
                data.Append(Me.myTrack.myControlPoint.UniqueName & "|")
                data.Append(DelayCode & "|")
                data.Append(DelayTime & "|")
                data.Append(Me.IdentifingUnit & "|")
                If RailRoadUniqueName IsNot Nothing AndAlso Not String.IsNullOrEmpty(RailRoadUniqueName) AndAlso RailRoadUniqueName.Trim <> "" Then
                    data.Append(RailRoadUniqueName & "|")
                Else
                    data.Append("NONE|")
                End If
                If optEnableDenverSpecificOptions Then data.Append(ReportingPerson & "|")
                Return data.ToString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return "NONE"
            End Try
        End Function

        Public Function TrainConsistChangeCheck(ByVal Loads As Int32, ByVal Empties As Int32, ByVal Length As Int32, ByVal Tons As Int32, Optional ByVal NumOfAxles As Int32 = 0, Optional ByVal NumOfBrakes As Int32 = 0, Optional ByVal UseRUID As Boolean = False, Optional ByVal UseEOTDHOTD As Boolean = False, Optional ByVal EOTD As String = "", Optional ByVal HOTD As String = "") As Boolean
            Try
                Dim myTrain As TrainID = Me
                Dim strEvent As New ArrayList
                Dim MakeEvent As Boolean
                If IsNothing(myTrain) Then Exit Function
                If myTrain.OLoads <> Loads AndAlso Loads > 0 Then
                    Dim ConsistChange As String = optTrainString4 & Space(1) & myTrain.OLoads & Space(1) & optTrainString8 & Space(1) & Loads
                    TrainEventLog("TRAIN CONSIST CHANGE:" & Me.Name & " (" & ConsistChange & ")")
                    strEvent.Add(ConsistChange)
                    MakeEvent = True
                End If
                If myTrain.OEmts <> Empties AndAlso Empties > 0 Then
                    Dim ConsistChange As String = optTrainString5 & Space(1) & myTrain.OEmts & Space(1) & optTrainString8 & Space(1) & Empties
                    TrainEventLog("TRAIN CONSIST CHANGE:" & Me.Name & " (" & ConsistChange & ")")
                    strEvent.Add(ConsistChange)
                    MakeEvent = True
                End If
                If myTrain.OLength <> Length AndAlso Length > 0 Then
                    Dim ConsistChange As String = optTrainString6 & Space(1) & myTrain.OLength & Space(1) & optTrainString8 & Space(1) & Length
                    TrainEventLog("TRAIN CONSIST CHANGE:" & Me.Name & " (" & ConsistChange & ")")
                    strEvent.Add(ConsistChange)
                    MakeEvent = True
                End If
                If myTrain.OTons <> Tons AndAlso Tons > 0 Then
                    Dim ConsistChange As String = optTrainString7 & Space(1) & myTrain.OTons & Space(1) & optTrainString8 & Space(1) & Tons
                    TrainEventLog("TRAIN CONSIST CHANGE:" & Me.Name & " (" & ConsistChange & ")")
                    strEvent.Add(ConsistChange)
                    MakeEvent = True
                End If

                If optEnableAxlesBrakesCounts Then
                    If myTrain.NumberOfAxles <> NumOfAxles AndAlso NumOfAxles > 0 Then
                        strEvent.Add("NUMBER OF AXLES CHANGED" & Space(1) & myTrain.NumberOfAxles & Space(1) & optTrainString8 & Space(1) & NumOfAxles)
                        MakeEvent = True
                    End If

                    If myTrain.NumberOperatingBrakes <> NumOfBrakes AndAlso NumOfBrakes > 0 Then
                        strEvent.Add("NUMBER OF BRAKES CHANGED" & Space(1) & myTrain.NumberOperatingBrakes & Space(1) & optTrainString8 & Space(1) & NumOfBrakes)
                        MakeEvent = True
                    End If
                End If

                If UseEOTDHOTD Then
                    Dim CurrentEOTD As String = ""
                    Dim CurrentHOTD As String = ""
                    If Not String.IsNullOrEmpty(myTrain.EOTD) AndAlso myTrain.EOTD.Trim <> "" Then CurrentEOTD = myTrain.EOTD
                    If Not String.IsNullOrEmpty(myTrain.HOTD) AndAlso myTrain.HOTD.Trim <> "" Then CurrentHOTD = myTrain.HOTD

                    If CurrentEOTD.ToUpper.Trim <> EOTD.ToUpper.Trim Then
                        strEvent.Add("EOTD CHANGED" & Space(1) & CurrentEOTD & Space(1) & optTrainString8 & Space(1) & EOTD.Trim)
                        MakeEvent = True
                    End If
                    If CurrentHOTD.ToUpper.Trim <> HOTD.ToUpper.Trim Then
                        strEvent.Add("HOTD CHANGED" & Space(1) & CurrentHOTD & Space(1) & optTrainString8 & Space(1) & HOTD.Trim)
                        MakeEvent = True
                    End If
                End If


                If MakeEvent Then
                    Dim str As String
                    Dim EventString As String = String.Empty
                    For Each str In strEvent
                        EventString = EventString & " -" & str
                    Next
                    Dim RRUID As String
                    If UseRUID Then
                        RRUID = myTrain.myTrack.myControlPoint.RUID
                    Else
                        RRUID = myTrain.myTrack.myControlPoint.UniqueName
                    End If
                    myTrain.AddTrainSheetEvent("CONSIST CHANGE", Now, Mid(myTrain.myTrack.TimeZone, 1, 1), EventString, myTrain.myTrack.myControlPoint.GUID.ToString, myTrain.GetIdentifyingLocationNameFromLimits, RRUID)

                End If
                Return MakeEvent
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Sub CalculateHorsePowerPerTon(Optional ByVal NewTons As Integer = 0)
            Try
                Dim u As TrainUnit
                Dim TotalHP As Int32
                For Each u In Me.UnitsInTrain
                    TotalHP = TotalHP + u.EffectiveHP
                Next
                Me.TotalEffectiveHP = TotalHP
                If (Me.OTons = 0 And NewTons <> 0) Or TotalHP = 0 Then
                    Me.HorsePowerTrailing = optHPTStringFormat
                Else
                    Dim TonsToUSe As Integer = Me.OTons
                    If NewTons <> 0 Then
                        TonsToUSe = NewTons
                    End If

                    Dim HPT As Double = TotalHP / TonsToUSe
                    Me.HorsePowerTrailing = Format(HPT, "#" & optHPTStringFormat) 'Mid(HPT.ToString.PadLeft(3, "0"), 1, 4)

                End If



                Dim SummItem As New SummaryItem("TRAIN", "MODIFY", Me)
                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub CalculateTPOB(Optional ByVal IgnoreRefresh As Boolean = False)
            Dim TTons As Double = 0
            Dim TBrakes As Double = 0
            Dim TPOB As Double = 0
            If optEnableARRCSpecificOptions Then Exit Sub
            Try
                Double.TryParse(Me.OTons, TTons)
                Double.TryParse(Me.NumberOperatingBrakes, TBrakes)
                If TTons > 0 AndAlso TBrakes > 0 Then
                    TPOB = TTons / TBrakes
                    Me.TonsPerOperativeBrake = Format(TPOB, optHPTStringFormat)

                    If Not IgnoreRefresh Then
                        Dim SummItem As New SummaryItem("TRAIN", "MODIFY", Me)
                        SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                            TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                        End SyncLock
                    End If
                End If



            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub HoursOfServiceCheck()
            Dim DateToUse As Date
            Dim HOS As String
            Try

                If optEnableShadowMode OrElse optEnableTerritoryDeskAssignmentMode Then
                    If Me.myTrack IsNot Nothing AndAlso Not Me.myTrack.IsValidTrackForOperation Then
                        Exit Sub
                    End If
                End If
                If optEnableARRCSpecificOptions Then
                    If Me.TrainInActive Then Exit Sub
                End If

                If Not Me.CheckForValidDate(Me.CrewCurrent.Engineer.HOS) Or Not Me.CheckForValidDate(Me.CrewCurrent.Conductor.HOS) Then
                    HOS = ""
                Else
                    If CDate(Me.CrewCurrent.Engineer.HOS) < CDate(Me.CrewCurrent.Conductor.HOS) Then
                        DateToUse = CDate(Me.CrewCurrent.Engineer.HOS)
                    Else
                        DateToUse = CDate(Me.CrewCurrent.Conductor.HOS)
                    End If
                    Dim TmSpan As TimeSpan = DateToUse.Subtract(DateTime.Now)
                    HOS = TmSpan.TotalHours
                End If

                If HOS <> "" Then
                    If CInt(HOS) <= 2 Then
                        Me.HOSRedEvent = True
                        Me.HOSYellowEvent = False
                        Me.HOSYellowAlertACK = False
                    ElseIf CInt(HOS) <= 4 Then
                        Me.HOSRedEvent = False
                        HOSRedAlertACK = False
                        Me.HOSYellowEvent = True
                    ElseIf CInt(HOS) > 4 Then
                        Me.HOSRedEvent = False
                        HOSRedAlertACK = False
                        Me.HOSYellowEvent = False
                        Me.HOSYellowAlertACK = False
                    End If
                Else
                    Me.HOSRedEvent = False
                    HOSRedAlertACK = False
                    Me.HOSYellowEvent = False
                    Me.HOSYellowAlertACK = False
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

