        ''' <summary>
        ''' Do Log Train Position Report From GPS
        ''' </summary>
        Public Sub DoLogTrainPositionReportFromGPS()
            Dim report As StringBuilder
            Try
                report = New StringBuilder("TRAIN POSITION : " & Me.Name)
                report.Append(" : HEADEND = " & Me.MilePostPrefix & Me.MilePost & Me.MilePostSuffix)
                report.Append(" : REAREND = " & Me.EndMilePostPrefix & Me.EndMilePost & Me.EndMilePostSuffix)
                If Not IsNothing(myLocomotiveReport) Then
                    If Not IsNothing(myLocomotiveReport.thisCurrentTrack) Then
                        report.Append(" : HEADENDTRACK = " & myLocomotiveReport.thisCurrentTrack.GUID & ":" & myLocomotiveReport.thisCurrentTrack.Name & ":" & myLocomotiveReport.thisCurrentTrack.LeftLimitMilePost & ":" & myLocomotiveReport.thisCurrentTrack.RightLimitMilePost)
                    Else
                        myHeadEndTrack = Nothing
                    End If
                    If Not IsNothing(myLocomotiveReport.EndTrack) Then
                        report.Append(" : READENDTRACK = " & myLocomotiveReport.EndTrack.GUID & ":" & myLocomotiveReport.EndTrack.Name & ":" & myLocomotiveReport.EndTrack.LeftLimitMilePost & ":" & myLocomotiveReport.EndTrack.RightLimitMilePost)
                    Else
                        myRearEndTrack = Nothing
                    End If
                Else
                    myHeadEndTrack = Nothing
                    myRearEndTrack = Nothing
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                report = Nothing
            End Try
        End Sub

#Region "AUTOMATIC CUTOUT METHODS"

        Private Delegate Sub DoCutOutTrain()

        ''' <summary>
        ''' Check Auto Cutout For Train
        ''' </summary>
        Private Sub CheckAutoCutoutForTrain()
            Try
                If mySubStatusPTC = SubStatusPTC.DISENGAGED AndAlso
                    myPreviousSubStatusPTC = SubStatusPTC.ACTIVE Then
                    AutoCutoutTrain = True
                End If
                If AutoCutoutTrain AndAlso
                    myHeadEndTrack IsNot Nothing AndAlso
                    Not myHeadEndTrack.IsMarkedToDisableAutoCutout Then
                    If myHeadEndTrack.IsEntryForPTC Then
                        TrainEventLog($"{GetCurrentMethod.Name}:Entry track found for track {myHeadEndTrack.Name}")
                        Dim cutoutEvent As New DoCutOutTrain(AddressOf PerformCutOutOfTrain)
                        cutoutEvent.BeginInvoke(Nothing, Nothing)
                        AutoCutoutTrain = False
                    End If
                    If FoundEntryTrackForMRS AndAlso
                        (myHeadEndTrack.TurnOutType OrElse
                        myHeadEndTrack.TrackName.Equals("SIDING")) Then
                        TrainEventLog($"{GetCurrentMethod.Name _
                                      }:TurnOut or siding line found for track {myHeadEndTrack.Name}")
                        Dim cutoutEvent As New DoCutOutTrain(AddressOf PerformCutOutOfTrain)
                        cutoutEvent.BeginInvoke(Nothing, Nothing)
                        AutoCutoutTrain = False
                        FoundEntryTrackForMRS = False
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Perform cutout of train
        ''' </summary>
        Private Sub PerformCutOutOfTrain()
            Try
                CancelAllLicenseForPTC(True, False)
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_CutOutCommand(Me)
                PerformCutOutPTC()
                DoUpdateCBTCStatus(False, False)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

