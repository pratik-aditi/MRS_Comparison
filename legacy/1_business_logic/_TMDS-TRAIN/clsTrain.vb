        Public Function FindStartingSignal() As Signal
            Try
                Dim SearchDirection As String = String.Empty
                Dim NextComp As Object
                Dim LoopControl As Integer

                If Me.myTrack.TrafficDirection = "RIGHT" Then
                    SearchDirection = "RIGHT"
                ElseIf Me.myTrack.TrafficDirection = "LEFT" Then
                    SearchDirection = "LEFT"
                Else
                    If Me.Direction = optDirectionEast Or Me.Direction = optDirectionNorth Then
                        SearchDirection = "RIGHT"
                    ElseIf Me.Direction = optDirectionWest Or Me.Direction = optDirectionSouth Then
                        SearchDirection = "LEFT"
                    End If
                End If
                If SearchDirection = "RIGHT" Then
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.myTrack.RightLink)

                ElseIf SearchDirection = "LEFT" Then
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.myTrack.LeftLink)
                Else
                    Return Nothing
                End If
                If SearchDirection = "RIGHT" Then
                    Do
                        If IsNothing(NextComp) Then Exit Do
                        If NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.ComponentType = "R" Then
                                Return sig
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If
                        LoopControl += 1
                        If LoopControl > 20 Then
                            Return Nothing
                        End If
                    Loop
                Else
                    Do
                        If IsNothing(NextComp) Then Exit Do
                        If NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.ComponentType = "L" Then
                                Return sig
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                        LoopControl += 1
                        If LoopControl > 20 Then
                            Return Nothing
                        End If
                    Loop

                End If
                Return Nothing
            Catch EX As Exception
                SystemException(EX.ToString)
                Return Nothing
            End Try
            Return Nothing
        End Function

        Private Sub RemoveTacticalRoutes()
            Try
                TrainEventLog("REMOVE TACTICAL ROUTE(s) FOR TRAIN <" & Me.Name & ">")
                Dim tr As TacticalRoute
                For Each tr In Me.myTacticalRoutes
                    If Not IsNothing(tr.mySignalRoute) Then
                        If Not IsNothing(tr.mySignalRoute.EntrySignal) Then
                            If Not IsNothing(tr.mySignalRoute.EntrySignal.CurrentTacticalRoute) Then
                                If tr.mySignalRoute.EntrySignal.CurrentTacticalRoute.mySignalRoute.SystemUID = tr.mySignalRoute.SystemUID Then
                                    TrainEventLog("REMOVE CURRENT TACTICAL ROUTE <" & tr.mySignalRoute.EntrySignal.CurrentTacticalRoute.mySignalRoute.SystemUID & "> FOR TRAIN <" & Me.Name & ">")
                                    tr.mySignalRoute.EntrySignal.CurrentTacticalRoute = Nothing
                                    tr.mySignalRoute.EntrySignal.ControlledByTacticalRoute = False
                                End If
                            End If
                        End If
                    End If
                    If tr.myStoredRouteUID <> "" Then
                        Dim sr As StoredRoute
                        Dim srToDelete As StoredRoute = Nothing
                        For Each sr In tr.mySignalRoute.EntrySignal.myControlPoint.StoredRoutes
                            If sr.RouteGUID = tr.myStoredRouteUID Then
                                srToDelete = sr
                                Exit For
                            End If
                        Next
                        If Not IsNothing(srToDelete) Then
                            TrainEventLog("REMOVE STORE ROUTE FROM TACTICAL TRAIN LIST <" & srToDelete.RouteGUID & "> FOR TRAIN <" & Me.Name & ">")
                            srToDelete.RemoveMe("RemoveTacticalRoutes1")
                        End If
                    End If
                Next
                Me.myTacticalRoutes.Clear()
                TrainEventLog("REMOVE TACTICAL LIST FOR TRAIN <" & Me.Name & ">")

                'also check for stored routes assign to the train but no tactical route was assigned for some reason

                Dim cp As ControlPoint
                For Each cp In TMDS.GlobalDeclarations.gControlPointCollection
                    If cp.StoredRoutes.Count > 0 Then
                        Dim sr As StoredRoute
                        Dim srToDelete As StoredRoute = Nothing
                        For Each sr In cp.StoredRoutes
                            If sr.TrainSymbolAssociation = Me.Name Then
                                srToDelete = sr
                                Exit For
                            End If
                        Next
                        If Not IsNothing(srToDelete) Then
                            TrainEventLog("REMOVE STORE ROUTE FROM COLLECTION <" & srToDelete.RouteGUID & "> FOR TRAIN <" & Me.Name & ">")
                            srToDelete.RemoveMe("RemoveTacticalRoutes")
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
                Me.myTacticalRoutes.Clear()
            End Try
        End Sub

