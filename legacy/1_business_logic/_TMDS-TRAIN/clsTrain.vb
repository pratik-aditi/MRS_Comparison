        ''' <summary>
        ''' Update Train Consist ForPTC
        ''' </summary>
        Private Sub UpdateTrainConsistForPTC()
            Dim dbComm As OleDbCommand = Nothing
            Dim dbConn As OleDb.OleDbConnection = Nothing
            Dim trainConsist As String
            Dim query As New StringBuilder
            Try
                trainConsist = GetTrainConsistString()
                'RMT655-Automatic consist request leading onboard the receive empty 
                'Need to check if train consist is empty (0;0;0;0;0;0;0)
                'jcosta-3/29/17
                If trainConsist = "" Or trainConsist.Length = 0 Or trainConsist.IndexOf("0;0;0;0;0;0;0") >= 0 Then
                    TrainEventLog("UpdateLocomotiveConsistForPTC:LOCOCONSIST STRING IS EMPTY")
                    Exit Sub
                End If
                dbConn = New OleDbConnection(gConnectionStringTrain)
                dbConn.Open()
                query.Append("UPDATE tblTrainsActive ")
                query.Append(" SET TrainConsistInformationForPTC = '" & trainConsist & "'")
                query.Append(" WHERE Symbol = '" & Me.Name & "'")
                dbComm = New OleDbCommand(query.ToString, dbConn)
                dbComm.ExecuteNonQuery()
                dbConn.Close()
                TrainEventLog("UpdateTrainConsistForPTC:TrainConsist=" & trainConsist)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dbConn IsNot Nothing Then dbConn.Dispose()
                dbConn = Nothing
                trainConsist = Nothing
                query = Nothing
            End Try
        End Sub

