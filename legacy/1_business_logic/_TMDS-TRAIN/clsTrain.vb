        Public Function CheckSubTrainSheetExists() As Boolean
            Dim CommandExec As OleDbCommand
            Dim dbconn As OleDb.OleDbConnection
            Dim dr As OleDbDataReader
            Dim ReecordExists As Boolean
            Try
                Dim UpdateString As String = "Select ActiveSubTrainSheet FROM tblTrainsActiveSubTrainSheets WHERE ActiveSubTrainSheet = '" & Me.ActiveTrainSheetGUID & "'"

                dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                dbconn.Open()
                CommandExec = New OleDbCommand(UpdateString, dbconn)
                dr = CommandExec.ExecuteReader
                While dr.Read
                    ReecordExists = True
                End While

                dbconn.Close()
                dbconn.Dispose()
                dbconn = Nothing
                Return ReecordExists
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return False
            End Try

