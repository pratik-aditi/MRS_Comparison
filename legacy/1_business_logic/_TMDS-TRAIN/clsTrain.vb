        Sub New(Optional ByVal theForeman As Foreman = Nothing)
            Try
                myForman = theForeman
                If IsNothing(myForman) Then
                    FindForeman()
                End If
                MowGUID = System.Guid.NewGuid.ToString.ToUpper
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Friend Sub FindForeman()
            Try
                Dim f As Foreman
                For Each f In gMowForemen
                    If Me.Name = f.FirstName & Space(1) & f.LastName Then
                        Me.myForman = f
                        Me.myForman.FullName = Me.Name
                        Exit For
                    End If
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Public Sub InitializeMOW()
            If IsNothing(myForman) Then
                FindForeman()
            End If
        End Sub

        Private Delegate Sub DoPublishMOWEvent(CurrentTrk As Track, ByVal EventType As EventTypeMowID)

        Public Sub SendMowEvents(CurrentTrk As Track, ByVal EventType As EventTypeMowID)
            Try
                Dim NewDoSendEvts As New DoPublishMOWEvent(AddressOf PerformMOWEventsPublish)
                NewDoSendEvts.BeginInvoke(CurrentTrk, EventType, Nothing, Nothing)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub PerformMOWEventsPublish(CurrentTrk As Track, ByVal EventType As EventTypeMowID)
            Try
                If Me.myTrack Is Nothing Then Exit Sub
                If gAssistMode AndAlso optEnableARRCSpecificOptions Then Exit Sub
                'If optEnableTerritoryDeskAssignmentMode AndAlso Me.myTrack IsNot Nothing AndAlso Not Me.myTrack.IsControlled Then Exit Sub
                Dim Message As String = "DC" & Chr(6) & "MOW;"
                Message = Message & "|" & Me.myTrack.TerritoryID.ToString
                Select Case EventType
                    Case EventTypeMowID.CREATE
                        Message = Message & "|" & "CREATE"
                    Case EventTypeMowID.MOVE
                        Message = Message & "|" & "MOVE"
                    Case EventTypeMowID.UPDATE
                        Message = Message & "|" & "UPDATE"
                    Case EventTypeMowID.RELEASE
                        Message = Message & "|" & "RELEASE"
                End Select
                Message = Message & "|" & Me.Name
                Message = Message & "|" & Me.TrackGUID
                Message = Message & "|" & MowGUID
                Message = Message & "|" & Me.DisplayText
                'Message = Message & "|" & gWorkStationName
                Message = Message & Chr(10) & gWorkStationName
                Message = Me.myTrack.TerritoryID.ToString & Chr(12) & Message
                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                End SyncLock

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

#Region "EVENT LOGGING"

        Public Enum EventTypeMowID
            CREATE
            UPDATE
            RELEASE
            MOVE
        End Enum

        Private Delegate Sub DoEventLogMowID(ByVal EventType As EventTypeMowID)

        Public Sub LogTheMowIDEvent(ByVal EventType As EventTypeMowID)
            Try
                If gAssistMode AndAlso optEnableARRCSpecificOptions Then Exit Sub
                Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.LastName & "," & TMDS.GlobalDeclarations.gCurrentUser.FirstName
                Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                Dim CurTerr As Territory
                Dim CurTrk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.TrackGUID)
                If Not CurTrk Is Nothing Then
                    CurTerr = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(CurTrk.TerritoryID)
                Else
                    Exit Sub
                End If

                Dim LogString As String = "INSERT INTO tblSystemEvents "
                Dim SqlFields As String = "([EventTime], [Territory], [Wrkstn], [SysUser], [DbVer], [FuncType], [UID], [Event], [SysData])"
                Dim SqlValues As String
                Dim c As String = ", "
                Dim q As String = "'"
                SqlValues = " VALUES (" & q & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & q & c & CurTrk.TerritoryID & c & CurWrkstn & c & q & CurUser & q & c
                SqlValues = SqlValues & q & CurTerr.Dbversion & q & c & q & "MOW-ID" & q & c & q & Me.MowGUID & q & c

                Select Case EventType
                    Case EventTypeMowID.CREATE
                        SqlValues = SqlValues & q & "CREATE" & q & c & q
                        SqlValues = SqlValues & Me.Name & "|"
                        SqlValues = SqlValues & Me.TrackGUID & "|"
                        SqlValues = SqlValues & Me.MowGUID & "|"
                        SqlValues = SqlValues & Me.DisplayText & "|"
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"

                    Case EventTypeMowID.UPDATE
                        SqlValues = SqlValues & q & "MOVE" & q & c & q
                        SqlValues = SqlValues & Me.TrackGUID & "|"
                        SqlValues = SqlValues & Me.MowGUID & "|"
                        SqlValues = SqlValues & Me.DisplayText & "|"
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"

                    Case EventTypeMowID.RELEASE
                        SqlValues = SqlValues & q & "RELEASE" & q & c & q
                        SqlValues = SqlValues & Me.Name & "|"
                        SqlValues = SqlValues & Me.TrackGUID & "|"
                        SqlValues = SqlValues & Me.MowGUID & "|"
                        SqlValues = SqlValues & Me.DisplayText & "|"
                        SqlValues = SqlValues & q
                        SqlValues = SqlValues & ")"
                End Select
                SyncLock gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(LogString & SqlFields & SqlValues)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

