        Private Sub PerformLoadWorkTasks()
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim query As StringBuilder = Nothing
            Dim HasRestrictionTaskApplied As Boolean = False
            Try
                myWorkTaskList.Clear()
                '
                query = New StringBuilder("SELECT UID, TaskCreateTime, TaskType, EntityUID, EntityGUID, TaskData, MessageVersion, MessageEdition  FROM tblSystemWorkTasksActive WHERE (EntityGUID = '" & Me.TrainGUID & "') ORDER BY TaskCreateTime")
                dbconn = New OleDbConnection(gConnectionStringTrain)
                dbconn.Open()
                dbcomm = New OleDbCommand(query.ToString, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    Dim wt As New WorkTask
                    Dim HasWTApplied As Boolean = False
                    If Not dr.IsDBNull(0) Then wt.UID = dr.GetString(0)
                    If Not dr.IsDBNull(1) Then wt.TaskCreateTime = dr.GetDateTime(1)
                    If Not dr.IsDBNull(2) Then wt.TaskType = dr.GetString(2)
                    If Not dr.IsDBNull(3) Then wt.EntityUID = dr.GetString(3)
                    If Not dr.IsDBNull(4) Then wt.EntityGUID = dr.GetString(4)
                    If Not dr.IsDBNull(5) Then wt.TaskData = dr.GetString(5)
                    If Not dr.IsDBNull(6) Then wt.MessageVersion = dr.GetInt32(6)
                    If Not dr.IsDBNull(7) Then wt.MessageEdition = dr.GetInt32(7)
                    wt.myTrain = Me
                    wt.CreateTask(HasWTApplied)
                    If HasWTApplied Then
                        wt.RemoveWorkTask()
                        If wt.TaskType.Trim.ToUpper = "TRAIN-RESTRICTION-ADDED" Then
                            HasRestrictionTaskApplied = True
                        End If
                    End If

                End While
                dbconn.Close()
                dbconn = Nothing
                If HasRestrictionTaskApplied Then
                    Dim SummItem As New TrainRefreshItem(TrainRefreshItem.TrainRefreshType.TGBO, TrainRefreshItem.TrainRefreshAction.REFRESH, "")
                    SyncLock Me.myTrainTimerRefreshQueue.SyncRoot
                        'Me.myTrainTimerRefreshQueue.Enqueue(SummItem)
                        Try
                            Dim tmp As TrainRefreshItem
                            Dim OkToAdd As Boolean = True
                            For Each tmp In Me.myTrainTimerRefreshQueue
                                If tmp.myItemAction = TrainRefreshItem.TrainRefreshAction.REFRESH AndAlso tmp.myItemAction = TrainRefreshItem.TrainRefreshType.TGBO Then
                                    OkToAdd = False
                                End If
                            Next
                            If OkToAdd Then Me.myTrainTimerRefreshQueue.Enqueue(SummItem)
                        Catch ex As Exception
                            GetErrorDetails(ex)
                        End Try
                    End SyncLock
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
        End Sub

        Private Sub ReleaseWorkTasks()
            Dim TmpWorkTask As New ArrayList
            Try
                CopyArrayCollection(TmpWorkTask, gWorkTasks)
                Dim wt As WorkTask
                For Each wt In TmpWorkTask
                    If wt.EntityGUID = Me.TrainGUID Then
                        TrainEventLog("RELEASING WORKS TASK : " & wt.EntityUID)
                        Dim SummItem As New SummaryItem("WORKTASK", "DELETE", wt)
                        SyncLock TMDS.GlobalDeclarations.gWorkTasksSummaryQueue.SyncRoot
                            TMDS.GlobalDeclarations.gWorkTasksSummaryQueue.Enqueue(SummItem)
                        End SyncLock
                        gWorkTasks.Remove(wt)
                    End If
                Next
                Me.myWorkTaskList.Clear()
                'Me.myWorkTaskList = Nothing


            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                TmpWorkTask = Nothing
            End Try
        End Sub

        Public Function ClearWorkTaskFromDB() As Boolean
            Dim SQLQueryList As New ArrayList
            Try
                Dim theMove As New StringBuilder("INSERT INTO [tblSystemWorkTasksInActive]  SELECT * FROM [tblSystemWorkTasksActive] WHERE EntityGUID ='" & Me.TrainGUID & "'")
                Dim theDelete As New StringBuilder("DELETE FROM [tblSystemWorkTasksActive] WHERE EntityGUID ='" & Me.TrainGUID & "'")
                With SQLQueryList
                    .Add(theMove.ToString)
                    .Add(theDelete.ToString)
                End With
                If Not ExecuteQueryCollection(SQLQueryList, gConnectionStringTrain) Then Return False
                ReleaseWorkTasks()

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False
        End Function

