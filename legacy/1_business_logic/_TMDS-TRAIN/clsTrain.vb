#Region "GENERAL SUPPORT METHODS"

        Public Function FindObjectTypeFromGUID(ByVal UniqueID As Int32) As Object
            'This function finds the current trackcomponent index from the global unique ID
            Try
                Dim I As Integer
                For I = 1 To UBound(TrackComponent)
                    If TrackComponent(I).GUID = UniqueID Then
                        FindObjectTypeFromGUID = TrackComponent(I)
                        Exit Function
                    End If
                Next I

                For I = 1 To UBound(SwitchComponent)
                    If SwitchComponent(I).GUID = UniqueID Then
                        FindObjectTypeFromGUID = SwitchComponent(I)
                        Exit Function
                    End If
                Next I

                For I = 1 To SignalComponent.GetUpperBound(0)
                    If SignalComponent(I).GUID = UniqueID Then
                        FindObjectTypeFromGUID = SignalComponent(I)
                        Exit Function
                    End If
                Next I
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function FindTrackFromTrainID(ByVal TrainId As String) As Track
            Try
                'This function finds the current trackcomponent index from the global unique ID
                Dim I As Integer
                For I = 1 To UBound(TrackComponent)
                    If TrackComponent(I).TrainIDs.Count > 0 Then
                        Dim trn As TrainID = TrackComponent(I).TrainIDs(0)
                        If trn.Name = TrainId Then Return TrackComponent(I)
                    End If
                Next I
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try

        End Function

