#Region "STORED ROUTE METHODS"

        Public Function DoCheckForStoreRouteExecutionOrder(ByVal TheRoute As StoredRoute) As Boolean
            Try
                If Me.myStoredRoutes.Count = 0 Then Return True
                Dim sr As StoredRoute = Me.myStoredRoutes.Item(0)
                If sr.RouteGUID = TheRoute.RouteGUID Then Return True
                Return False


            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            End Try
        End Function

