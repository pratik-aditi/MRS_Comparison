                            .Append("ONDUTY=" & OLDCrew.ConductorTrainee.OnDutyTime & " TO " & Me.CrewCurrent.ConductorTrainee.OnDutyTime & "; ")
                            .Append("HOS=" & OLDCrew.ConductorTrainee.HOS & " TO " & Me.CrewCurrent.ConductorTrainee.HOS & "; ")
                            .Append("TIEUP=" & OLDCrew.ConductorTrainee.OffDutyTime & " TO " & Me.CrewCurrent.ConductorTrainee.OffDutyTime & "; ")
                        End With
                        If Not CrewChangeEventArrayList.Contains(Str.ToString) Then CrewChangeEventArrayList.Add(Str.ToString)
                        HasChangeEvent = False
                        Str = New StringBuilder
                    End If

                End With

                If CrewChangeEventArrayList IsNot Nothing AndAlso CrewChangeEventArrayList.Count > 0 Then
                    Dim s As String
                    For Each s In CrewChangeEventArrayList
                        If s.Trim <> "" Then
                            Me.AddTrainSheetEvent("CREW CHANGE", Now, Mid(Me.myTrack.TimeZone, 1, 1), s, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, "NONE")
                        End If
                    Next
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

