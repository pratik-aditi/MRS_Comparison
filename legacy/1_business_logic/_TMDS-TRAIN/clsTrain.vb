        ''' <summary>
        ''' Cancel GeoFence Request
        ''' </summary>
        Public Sub CancelGeoFenceRequest()
            Dim removeCompleteAuthority As Boolean
            Dim auth As TrackAuthority.TrackAuthority
            Dim summary As SummaryItem
            Try
                TrainEventLog("CancelGeoFenceRequest:Execute")
                auth = Me.thisCurrentLicense
                If Me.myTacticalRoutesToRemove.Count = Me.myTacticalRoutes.Count Then
                    removeCompleteAuthority = True
                    For Each tr As TacticalRoute In Me.myTacticalRoutes
                        tr.RemoveRoute()
                    Next
                    Me.myTacticalRoutesToRemove.Clear()
                    Me.myTacticalRoutes.Clear()
                End If
                If removeCompleteAuthority Then
                    If auth.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                        If auth.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority, True) Then
                            TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(auth)
                            summary = New SummaryItem("AUTHORITY", "REMOVE", auth)
                            SyncLock gSummaryAuthQueue.SyncRoot
                                gSummaryAuthQueue.Enqueue(summary)
                            End SyncLock
                            auth.PTCStatus = "RELEASE-SUCCESSFUL"
                            auth.FlasherMode(False)
                            TrainEventLog("AUTHORITY REMOVAL FROM CANCEL LICENSE CANCEL REQUEST:AUTH=" & auth.AuthorityUID)
                        End If
                    End If
                    Me.thisCurrentLicense = Nothing
                    auth.PTCTransmissionCompleted()
                Else
                    auth.PTCStatus = "AUTHORITY-ACTIVATED"
                    auth.FlasherMode(False)
                    auth.VETMS_CompleteRollup()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                removeCompleteAuthority = Nothing
                auth = Nothing
                summary = Nothing
            End Try
        End Sub

