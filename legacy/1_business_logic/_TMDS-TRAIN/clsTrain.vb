        ''' Update Train ID Into Database
        ''' </summary>
        ''' <param name="track">track object</param>
        ''' <param name="forceSubTrainSheetUpdate">force SubTrain Sheet Update</param>
        ''' <param name="CallingMethod">Calling Method</param>
        Sub UpdateTrainIDIntoDatabase(ByRef track As Track,
                                      forceSubTrainSheetUpdate As Boolean,
                                      Optional CallingMethod As String = "")
            Try
                Dim q As String = "'"
                Dim c As String = "', "
                Dim s As String = ","
                Dim query As String = "UPDATE tblTrainsActive "
                query &= " SET EngineID = " & q & IdentifingUnit & c
                query &= "InUsed = " & q & 1 & c
                If track IsNot Nothing Then query &= "Subdivision = " & q & track.SubdivisionID & c
                If track IsNot Nothing Then query &= "TerritoryAssignmentID = " & q & track.TerritoryID & c
                query &= "TrackGUID = " & q & TrackGUID & c
                query &= "StackOrder = " & Me.StackOrder & s
                query &= "SymbolComment = " & q & SymbolComment & c
                query &= "Direction = " & q & Direction & c
                Dim components As String = String.Empty
                For Each comp As Object In Units
                    If Trim(comp) <> "" Then
                        components = components & comp.ToString & "|"
                    End If
                Next
                query &= "Units = " & q & components & c
                components = String.Empty
                query &= "UnitComment = " & q & UnitComment & c
                query &= "DepTime = " & q & DepTime & c
                query &= "ArrTime = " & q & ArrTime & c
                query &= "FinalTime = " & q & FinalTime & c
                query &= "CallTime = " & q & CallTime & c
                query &= "OLoads = " & q & OLoads & c
                query &= "OEmts = " & q & OEmts & c
                query &= "OTons = " & q & OTons & c
                query &= "OLength = " & q & OLength & c
                query &= "DLoads = " & q & DLoads & c
                query &= "DEmts = " & q & DEmts & c
                query &= "DTons = " & q & DTons & c
                query &= "DLength = " & q & DLength & c
                query &= "MaxSpd = " & q & MaxSpd & c
                query &= "TonsPerOperativeBrake = " & q & TonsPerOperativeBrake & c
                query &= "HazMat = " & CInt(HazMat) & s
                query &= "TotalHP = " & Me.TotalHorsePower & s
                query &= "ScheduleStatus = " & q & Me.ScheduleStatus & q & s
                query &= "HighWide = " & CInt(HighWide) & s
                query &= "KeyTrain = " & CInt(KeyTrain) & s
                query &= "PullerTrain = " & CInt(PullerTrain) & s
                query &= "Origin = " & q & Origin & c
                query &= "Dest = " & q & Dest & c
                query &= "EOTD = " & q & EOTD & c
                query &= "HOTD = " & q & HOTD & c
                query &= "HomeRoadCode = " & q & Me.HomeRoadCode & c
                query &= "EngName = " & q & Me.CrewCurrent.Engineer.NameOfPerson & c
                Dim TimeToUpdate As Date
                If Not Me.ValidateDate(Me.CrewCurrent.Engineer.OnDutyTime) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewCurrent.Engineer.OnDutyTime)
                End If
                query &= "EngOnDuty = " & q & TimeToUpdate & c
                If Not Me.ValidateDate(Me.CrewCurrent.Engineer.HOS) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewCurrent.Engineer.HOS)
                End If
                query &= "EngTimeUp = " & q & TimeToUpdate & c
                query &= "CondName = " & q & Me.CrewCurrent.Conductor.NameOfPerson & c
                If Not Me.ValidateDate(Me.CrewCurrent.Conductor.OnDutyTime) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewCurrent.Conductor.OnDutyTime)
                End If
                query &= "CondOnDuty = " & q & TimeToUpdate & c
                If Not Me.ValidateDate(Me.CrewCurrent.Conductor.HOS) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewCurrent.Conductor.HOS)
                End If
                query &= "CondTimeUp = " & q & TimeToUpdate & c
                query &= "EngNameRel = " & q & Me.CrewRelief.Engineer.NameOfPerson & c
                If Not Me.ValidateDate(Me.CrewRelief.Engineer.OnDutyTime) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewRelief.Engineer.OnDutyTime)
                End If
                query &= "EngOnDutyRel = " & q & TimeToUpdate & c
                If Not Me.ValidateDate(Me.CrewRelief.Engineer.HOS) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewRelief.Engineer.HOS)
                End If
                query &= "EngTimeUpRel = " & q & TimeToUpdate & c
                query &= "CondNameRel = " & q & Me.CrewRelief.Conductor.NameOfPerson & c
                If Not Me.ValidateDate(Me.CrewRelief.Conductor.OnDutyTime) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewRelief.Conductor.OnDutyTime)
                End If
                query &= "CondOnDutyRel = " & q & TimeToUpdate & c
                If Not Me.ValidateDate(Me.CrewRelief.Conductor.HOS) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewRelief.Conductor.HOS)
                End If
                query &= "CondTimeUpRel = " & q & TimeToUpdate & c
                query &= "EngNameP = " & q & Me.CrewPending.Engineer.NameOfPerson & c
                If Not Me.ValidateDate(Me.CrewPending.Engineer.OnDutyTime) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewPending.Engineer.OnDutyTime)
                End If
                query = query & "EngOnDutyP = " & q & TimeToUpdate & c
                If Not Me.ValidateDate(Me.CrewPending.Engineer.HOS) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewPending.Engineer.HOS)
                End If
                query &= "EngTimeUpP = " & q & TimeToUpdate & c
                query &= "CondNameP = " & q & Me.CrewPending.Conductor.NameOfPerson & c
                If Not Me.ValidateDate(Me.CrewPending.Conductor.OnDutyTime) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewPending.Conductor.OnDutyTime)
                End If
                query &= "CondOnDutyP = " & q & TimeToUpdate & c
                If Not ValidateDate(Me.CrewPending.Conductor.HOS) Then
                    TimeToUpdate = Now
                Else
                    TimeToUpdate = CDate(Me.CrewPending.Conductor.HOS)
                End If
                query &= "CondTimeUpP = " & q & TimeToUpdate & c
                query &= "CrewCurrent = " & q & CrewCurrentString & c
                query &= "CrewRelief = " & q & CrewReliefString & c
                query &= "CrewPending = " & q & CrewPendingString & c
                components = String.Empty
                For Each comp As Object In DelayInfo
                    If comp <> "" Then
                        components = components & comp.ToString & "|"
                    End If
                Next
                query &= "DelayInfo = " & q & components & c
                components = String.Empty
                For Each comp As Object In TrackBull
                    If comp <> "" Then
                        components = components & comp.ToString & "|"
                    End If
                Next
                query &= "TrackBull = " & q & components & c
                components = String.Empty
                For Each comp As Object In BadOrderSetOuts
                    If comp <> "" Then
                        components = components & comp.ToString & "|"
                    End If
                Next
                query &= "BadOrderSetOuts = " & q & components & c
                components = String.Empty
                For Each comp As Object In TrainSheetEvents
                    If comp <> "" Then
                        components = components & comp.ToString & "|"
                    End If
                Next
                query &= "TrainSheetEvents = " & q & components & c
                components = String.Empty
                query &= "UnitsP = " & q & components & c
                query &= "EngineIDP = " & q & components & c
                query &= "TrainLink = " & q & Me.TrainLinkedToMe & c
                query &= "TrailingHorsePower = " & q & Me.HorsePowerTrailing & c
                query &= "TrainType = " & q & Me.TrainType & c
                query &= "SpecialNote = " & CInt(Me.SpecialNotation) & s
                query &= "PseudoName = " & q & Me.PseudoName & q & s
                query &= "SubType = " & q & Me.SubType & q & s
                query &= "CBTCEquipped = " & CInt(Me.CBTCEquipped) & s
                query &= "MiscellanousInfoOne = " & q & Me.MiscInfoOne & q & s
                query &= "MiscellanousInfoTwo = " & q & Nothing & q & s
                query &= "MiscellanousInfoThree = " & q & Nothing & q & s
                query &= "CurrentGTBUID = " & Me.GTBNum & s
                query &= "HOS = " & q & CDate(Me.TrainHOS) & c
                query &= "TotalCars = " & Me.TotalCars & s
                query &= "VIA = " & q & Me.TrainVia & q & s
                query &= "Release = " & q & CDate(Me.ReleaseTime) & q & s
                query &= "ScheduleType = " & q & Me.ScheduleType & q
                If optEnableAxlesBrakesCounts Then
                    query &= s & "NumberOperatingBrakes = " & Me.NumberOperatingBrakes
                    query &= s & "NumberOfAxles = " & Me.NumberOfAxles
                End If
                If optEnableTestTrainForPTC Then
                    query &= s & "TestTrainPTC = " & q & Me.IsTestCBTC & q
                End If
                If gIsRestrictionTypesExistInDb Then
                    query &= $",TrainRestrictionTypes = '{RestrictionType}'"
                End If
                query &= $" WHERE Symbol = '{Name}'"
                GetTrainConsist()
                SystemDatabaseCommandToDynamicTrain(GetCurrentMethod.Name, query)
                TrainEventLog($"{GetCurrentMethod.Name} Train was updated")
                If forceSubTrainSheetUpdate Then UpdateSubTrainSheet(ActiveTrainSheetGUID)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

