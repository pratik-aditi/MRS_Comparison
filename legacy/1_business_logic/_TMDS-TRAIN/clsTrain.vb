                        ' Delete
                        SQLQuery.Append("DELETE FROM " & tableName & " ")
                        SQLQuery.Append("WHERE LocoConsistGUID = ?")

                        dbComm.Parameters.Add("@LocoConsistGUID", OleDbType.VarChar, 50).Value = Me.LocoConsistGUID
                        dbComm.CommandText = SQLQuery.ToString

                        rowsUpdated = dbComm.ExecuteNonQuery()
                    End Using
                    dbConn.Close()
                End Using

                ' return a value of true to inform the user the persist was successful
                Return (rowsUpdated = 1)
            Catch ex As Exception
                ' log the exception
                SystemException(ex.ToString)
                ' return a value of false to inform the user the data did not persist
                Return False
            End Try
        End Function

