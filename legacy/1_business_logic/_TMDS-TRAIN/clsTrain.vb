#Region "OS RECORD METHODS"
        Private Delegate Sub DoLoadOsRecords()

        Public Sub GetOsRecords()
            Dim errorOccured As Boolean = False
            Try
                PerformGetOsRecords()
            Catch ex As Exception
                errorOccured = True
                SystemException(ex.ToString)
            End Try

            If errorOccured Then
                Try
                    Dim NewDoLoad As New DoLoadOsRecords(AddressOf PerformGetOsRecords)
                    NewDoLoad.BeginInvoke(Nothing, Nothing)
                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try
            End If
        End Sub

        Private Sub PerformGetOsRecords()
            'Dim dbconn As OleDbConnection
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Comp As Object = Nothing
            Dim CPOsType As String = ""
            Dim GetOsRecords As String = ""
            Try
                Me.OSTimes.Clear()


                If gOptSortOSTimesDesc Then
                    GetOsRecords = " SELECT OsPoint,OsTime,SubName,TrackGUID FROM tblTrainOsEventsActive WHERE TrainSheetGUID = '" & Me.ActiveTrainSheetGUID & "' ORDER BY OsTime desc"
                Else
                    GetOsRecords = " SELECT OsPoint,OsTime,SubName,TrackGUID FROM tblTrainOsEventsActive WHERE TrainSheetGUID = '" & Me.ActiveTrainSheetGUID & "' ORDER BY OsTime"
                End If

                Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(GetOsRecords, dbconn)
                    dr = dbcomm.ExecuteReader()
                    Dim OsTime As String = String.Empty

                    While dr.Read()
                        If OsTime = "" Then
                            OsTime = Format(dr.GetDateTime(1), "HH:mm") & " (" & dr.GetString(0) & ")"
                        End If
                        If Not optEnableCPTrainsheet Then
                            Me.OSTimes.Add(dr.GetString(0) & "|" & Format(dr.GetDateTime(1), optSystemOSDateAndTimeString) & "|" & dr.GetString(2))
                        Else
                            If Not dr.IsDBNull(3) Then
                                Comp = Nothing
                                Try
                                    Comp = FindCompFromGUID(dr.GetInt32(3))
                                    If Not Comp Is Nothing Then
                                        Select Case Comp.GetType.ToString
                                            Case gTrackComponentName, gSwitchComponentName
                                                Select Case Mid(Comp.AuthorityType, 1, 3).ToUpper
                                                    Case "CTC"
                                                        CPOsType = "OS"
                                                    Case "TWC"
                                                        CPOsType = "TR"
                                                    Case Else
                                                        CPOsType = "OS"
                                                End Select
                                        End Select
                                    End If
                                Catch ex As Exception
                                    GetErrorDetails(ex)
                                End Try
                            End If
                            Me.OSTimes.Add(dr.GetString(0) & "|" & Format(dr.GetDateTime(1), optSystemOSDateAndTimeString) & "|" & dr.GetString(2) & "|" & CPOsType)
                        End If
                    End While
                    Me.LastOS = OsTime
                    dr.Close()
                    dbconn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex, GetOsRecords)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                dr = Nothing
            End Try
            If optEnableTrainMovementReporting Then
                PerformGetTrainMovements()
            End If
        End Sub

        Public Sub PerformGetTrainMovements()
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim SQLQuery As String = " SELECT EventTimeStamp,EventType, EventLocation, [UID],[EventTrackGUID] FROM tblTrainEventActiveMovements WHERE TrainSheetUID = '" & Me.ActiveTrainSheetGUID & "' order by EventTimeStamp desc"
            Try
                Me.TrnMovements.Clear()
                Using DbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        Dim strtime As String = "" 'Format(dr.GetDateTime(0), "MM-dd-yyyy HH:mm")
                        Dim strLoc As String = "" 'dr.GetString(2)
                        Dim strEvt As String = "" 'dr.GetString(1)
                        Dim EvtUID As String = "" 'dr.GetString(1)
                        Dim EvtTrackUID As String = "" 'dr.GetString(1)

                        If Not dr.IsDBNull(0) Then
                            Dim dtOSTime As Date
                            If Date.TryParse(dr.GetDateTime(0), dtOSTime) Then
                                strtime = Format(dtOSTime, optSystemOSDateAndTimeString)
                            End If
                        End If

                        If Not dr.IsDBNull(1) Then strEvt = dr.GetValue(1)
                        If Not dr.IsDBNull(2) Then
                            If gOptUsePassengerStationForOS Then
                                strLoc = dr.GetValue(2)
                            Else
                                Dim splt() As String = dr.GetValue(2).Split("|")
                                If splt.GetUpperBound(0) > 1 Then
                                    strLoc = splt(2)
                                Else
                                    strLoc = splt(0)
                                End If
                            End If

                        End If
                        If Not dr.IsDBNull(3) Then EvtUID = dr.GetString(3)
                        If Not dr.IsDBNull(4) Then EvtTrackUID = dr.GetValue(4)

                        ''If Not TrnMovementExists(strtime, strLoc, strEvt) Then
                        'Me.TrnMovements.Add(EvtUID & "|" & strtime & "|" & strLoc & "|" & strEvt & "|" & EvtTrackUID)
                        ''End If
                        If optEnableDenverSpecificOptions Then
                            Dim OsMessage As String = EvtUID & "|" & strtime & "|" & strLoc & "|" & strEvt & "|" & EvtTrackUID
                            Me.TrnMovements.Add(OsMessage)
                        Else
                            Me.TrnMovements.Add(EvtUID & "|" & strtime & "|" & strLoc & "|" & strEvt & "|" & EvtTrackUID)
                        End If

                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try

        End Sub

        Public Function DoesThisTrainHasOsRecords() As Boolean
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader
            Dim GetOsRecordSQL As String = ""
            Try
                GetOsRecordSQL = " SELECT TOP 2 [RecordGUID] FROM tblTrainOsEventsActive WHERE TrainSheetGUID = '" & Me.ActiveTrainSheetGUID & "'"
                Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(GetOsRecordSQL, dbconn)
                    dr = dbcomm.ExecuteReader()
                    If dr.HasRows Then
                        Dim NewDoLoad As New DoLoadOsRecords(AddressOf PerformGetOsRecords)
                        NewDoLoad.BeginInvoke(Nothing, Nothing)
                        Return True
                    End If

                    dbconn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex, GetOsRecordSQL)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
            End Try
        End Function

