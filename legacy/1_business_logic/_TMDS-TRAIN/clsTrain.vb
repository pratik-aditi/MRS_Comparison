        Public Sub UpdateUnitPostion(Optional ReverseOrientation As Boolean = False)
            Dim Update As New System.Text.StringBuilder
            Dim dbcomm As OleDbCommand = Nothing
            Try
                Update.Append("UPDATE tblSystemLocomotives SET UnitPosition =")
                Update.Append(Me.UnitPosition)

                If ReverseOrientation Then
                    If Me.Direction.Trim.ToUpper = "FORWARD" Then
                        Me.Direction = "BACKWARD"
                    Else
                        Me.Direction = "FORWARD"
                    End If
                    Update.Append(", Direction ='")
                    Update.Append(Me.Direction & "' ")
                End If



                Update.Append(" WHERE UID = '")
                Update.Append(Me.UnitNumber)
                Update.Append("'")

                Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(Update.ToString, dbconn)
                    dbcomm.ExecuteNonQuery()
                    dbconn.Close()
                End Using
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
            End Try
        End Sub

