        ''' <summary>
        ''' Determines whether a special license is allowed for the given track collection based on current user action.
        ''' </summary>
        ''' <param name="tracks">
        ''' Collection of <see cref="Track"/> instances to evaluate for remote or linked remote conditions.
        ''' </param>
        ''' <returns>
        ''' <see cref="Boolean"/>: <see langword="True"/> indicates a special license condition exists with at least one
        ''' remote or linked track; <see langword="False"/> indicates no applicable condition.
        ''' </returns>
        ''' <remarks>
        ''' Evaluates when <see cref="UserActionType"/> is option 6 or 7 and any track in <paramref name="tracks"/> is
        ''' remote or linked to a remote track.
        ''' </remarks>
        Public Function IsSpecialLicenseDeniedRoute(tracks As IEnumerable(Of Track)) As Boolean
            Return (UserActionType = UserActionTypeEnum.SpecialLicenseOption6 OrElse 'Bidirecional
                UserActionType = UserActionTypeEnum.SpecialLicenseOption7) AndAlso 'Intervalo de Via
                tracks.Any(Function(oneTrack) oneTrack.IsRemoteTrack OrElse oneTrack.IsLinkToRemoteTrack)
        End Function

        ''' <summary>
        ''' Menu Issue Special License
        ''' </summary>
        ''' <param name="type">Special license type</param>
        ''' <param name="isBidirectional">is bidirectional license</param>
        ''' <returns>If special license is valid, return <c>True</c>, otherwise, return <c>False</c></returns>
        Public Function MenuIssueSpecialLicense(type As String,
                                                Optional isBidirectional As Boolean = False) As Boolean
            Try
                If isBidirectional AndAlso
                    thisCurrentLicense IsNot Nothing Then
                    TrainEventLog($"{GetCurrentMethod.Name}:Normal license found")
                    InfoMessage($"{My.Resources.UserMessage1} {thisCurrentLicense.AuthorityNumber}")
                    Return False
                ElseIf thisRestrictiveLicense IsNot Nothing Then
                    TrainEventLog($"{GetCurrentMethod.Name}:Special license found")
                    InfoMessage($"{My.Resources.UserMessage1} {thisRestrictiveLicense.AuthorityNumber}")
                    Return False
                End If
                Dim specialLicenseForm As New frmPSSType()
                specialLicenseForm.Location = myTrack?.CurrentDrawingForm.myLaunchPoint
                specialLicenseForm.LoadTrainForForm(Me, type)
                If specialLicenseForm.ShowDialog() <> DialogResult.OK Then
                    TrainEventLog($"{GetCurrentMethod.Name}:User cancelled the action")
                    Return False
                End If
                If Not PtcLicenseValidationForMenus() Then
                    SystemEvent($"{GetCurrentMethod.Name}:Conflict found")
                    Return False
                End If
                gCreateLicenseTrain = Me
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        ''' <summary>
        ''' License validation for menus
        ''' </summary>
        ''' <returns>If Ok to proceed, return <c>True</c>, otherwise, return <c>False</c></returns>
        Public Function PtcLicenseValidationForMenus() As Boolean
            Try
                TrainEventLog($"{GetCurrentMethod.Name}")
                If optEnableExtendLicenseinSplitDesk AndAlso
                    TrainRegionStatus = TrainRegionEnum.RemoteTrain AndAlso
                    Not TrainCollection.Contains(Me) Then
                    TrainEventLog($"{GetCurrentMethod.Name}:Cant issue license for remote train through fast route")
                    InfoMessage("NÃO É POSSÍVEL ESTENDER LICENÇA ATRAVÉS DO MODO ROTA RÁPIDA")
                    Exit Function
                End If
                If MZEnabled Then MZEnabled = False
                If gSelectedTrainIDTrack.OStype AndAlso
                    Not gSelectedTrainIDTrack.EnableControlledSiding Then
                    TrainEventLog($"{GetCurrentMethod.Name}:OS Track License Not Allowed")
                    Exit Function
                End If
                If thisCurrentLicense IsNot Nothing Then
                    If thisCurrentLicense.PTCElectronicTransmissionInProgress Then
                        TrainEventLog($"{GetCurrentMethod.Name}:PTC Electronic Transmission In Progress")
                        Exit Function
                    End If
                    If thisCurrentLicense.NeedsElectronicTransmission Then
                        TrainEventLog($"{GetCurrentMethod.Name}:Needs Electronic Transmission")
                        Exit Function
                    End If
                Else
                    myHeadEndTrack = Nothing
                    myRearEndTrack = Nothing
                    TrainEventLog($"{GetCurrentMethod.Name}:Clear myHeadEndTrack and myRearEndTrack")
                End If
                If Not IsPresenceOnNetwork Then
                    TrainEventLog($"{GetCurrentMethod.Name}:Train DoesNot Have Network Presense")
                    Exit Function
                End If
                If String.IsNullOrWhiteSpace(IdentifingUnit) Then
                    TrainEventLog($"{GetCurrentMethod.Name}:No Identifing Unit Assigned")
                    InfoMessage($"{mstrLeadUnitCheck1} {mstrLeadUnitCheck2} {Name}")
                    Exit Function
                End If
                If myStoredRoutes IsNot Nothing AndAlso
                    myStoredRoutes.Count > 0 Then
                    Dim storedRoute As StoredRoute = myStoredRoutes.Item(myStoredRoutes.Count - 1)
                    If storedRoute IsNot Nothing Then
                        Dim lastTrack As Track = FindLastTrackInList(storedRoute.ComponentSelection)
                        If lastTrack IsNot Nothing Then
                            gSelectedTrainIDTrack = lastTrack
                            gSelectedTrainIDTrack.ClickedSendLicense = True
                            TrainEventLog($"{GetCurrentMethod.Name}:LastTrack={lastTrack.Name}")
                        End If
                    End If
                ElseIf myTacticalRoutes.Count > 0 Then
                    Dim tacticalRoute As TacticalRoute = myTacticalRoutes.Item(myTacticalRoutes.Count - 1)
                    If tacticalRoute IsNot Nothing Then
                        gSelectedTrainIDTrack = tacticalRoute.mySignalRoute.LastTrack
                        gSelectedTrainIDTrack.ClickedSendLicense = True
                        TrainEventLog($"{GetCurrentMethod.Name}:SelectedTrainIDTrack={gSelectedTrainIDTrack.Name}")
                    Else
                        TrainEventLog($"{GetCurrentMethod.Name}:No Tactical Routes 1")
                    End If
                Else
                    TrainEventLog($"{GetCurrentMethod.Name}:No Tactical Routes 2")
                    Dim lastTrack As Track = GetBeginningTrackOfEntireTrain()
                    If lastTrack IsNot Nothing Then
                        gSelectedTrainIDTrack = lastTrack
                        gSelectedTrainIDTrack.ClickedSendLicense = True
                        TrainEventLog($"{GetCurrentMethod.Name}:LastTrack={lastTrack.Name}")
                    Else
                        TrainEventLog($"{GetCurrentMethod.Name}:No Beginning Track Found")
                    End If
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

