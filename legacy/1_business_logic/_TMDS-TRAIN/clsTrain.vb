        Public Sub AddTrainSheetEvent(ByVal EventType As String, ByVal EventTimeStamp As Date, ByVal EventTimeZone As String, ByVal EventData As String, ByVal IdentifingPointUID As String, ByVal IdentifingPointName As String, ByVal RailroadUID As String, Optional UseTimeSent As Boolean = False)
            Dim q As String = "'"
            Dim s As String = ","
            Dim CurrentDateTime As Date = Now

            Try
                Dim theGUID As String = Guid.NewGuid.ToString.ToUpper
                Dim Insert As New System.Text.StringBuilder
                Insert.Append("INSERT INTO tblTrainEventActiveOther")
                Insert.Append(" (")
                Insert.Append(" EventUID, TrainSheetUID, EventType, EventTimeStamp, EventTimeZone, EventData, ")
                Insert.Append(" IdentifingPointUID, IdentifingPointName, RailroadUID, ReportData,EventCreator")
                Insert.Append(" )")
                Insert.Append(" VALUES (")
                Insert.Append(q & theGUID & q & s)
                Insert.Append(q & Me.ActiveTrainSheetGUID & q & s)
                Insert.Append(q & EventType & q & s)
                If UseTimeSent Then
                    Insert.Append(q & EventTimeStamp.ToString & q & s)
                Else
                    If optApplyTrainSheetConfigurationForARRC Then
                        If Me.myTrack IsNot Nothing AndAlso Me.myTrack.mySubdivision IsNot Nothing Then
                            CurrentDateTime = GenerateTime(Me.myTrack.mySubdivision)
                        End If
                        Insert.Append(q & CurrentDateTime.ToString & q & s)
                    Else
                        'Insert.Append(q & Now.ToString & q & s)
                        Insert.Append(q & CurrentDateTime.ToString & q & s)
                    End If
                End If

                Insert.Append(q & Mid(Me.myTrack.TimeZone, 1, 1) & q & s)
                Insert.Append(q & EventData & q & s)
                Insert.Append(q & IdentifingPointUID & q & s)
                Insert.Append(q & IdentifingPointName & q & s)
                Insert.Append(q & RailroadUID & q & s)
                Insert.Append(q & Me.GetTrainReportDataString("NONE", 0) & q)
                Insert.Append(s & q & gPreviousDispatcher & q)
                Insert.Append(" )")
                SystemDatabaseCommandToDynamicTrain("AddTrainSheetEvent", Insert.ToString)
                If UseTimeSent Then
                    AddTrainEvent(EventType, EventData, IdentifingPointName, theGUID, IdentifingPointUID, EventTimeStamp.ToString)
                Else
                    AddTrainEvent(EventType, EventData, IdentifingPointName, theGUID, IdentifingPointUID)
                End If
                If optSaveTrainEventsToEventLog Then
                    Dim EventLogString As String = "TRAIN EVENT: @" & Format(CurrentDateTime, "MM-dd-yyyy HH:mm:ss") & " - TRAIN[" & Me.Name & "] " & " - EVENT: " & EventData & " - LOCATION: " & IdentifingPointName & " - DISPATCHER: " & gCurrentUser.UserFullName
                    TrainEventLog(EventLogString)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function GetLastOSEvent(Optional ByRef LastOsPoint As String = "", Optional ByVal strFormat As String = "HH:mm") As String
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim SQLQuery As String = "SELECT OsPoint,OsTime FROM tblTrainOsEventsActive WHERE TrainSheetGUID = '" & Me.ActiveTrainSheetGUID & "' ORDER BY OsTime desc"
            Dim RtnStrOsTime As String = optTrainString21
            Try
                Using DbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        If Not dr.IsDBNull(0) AndAlso Not dr.IsDBNull(1) Then
                            Dim dtOSTime As Date
                            If Date.TryParse(dr.GetDateTime(1), dtOSTime) Then
                                RtnStrOsTime = Format(dr.GetDateTime(1), strFormat) & " (" & dr.GetString(0) & ")"
                                LastOsPoint = dr.GetString(0)
                                Exit While
                            End If
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return RtnStrOsTime
        End Function

