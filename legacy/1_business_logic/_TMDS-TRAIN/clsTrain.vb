        ''' <summary>
        ''' Fills the LocomotiveConsist collection from the database.
        ''' </summary>
        ''' <remarks>WGROH - JAN 28, 2013: CP PTC Train Sheet.</remarks>

        Public Sub GetTrainLocomotiveConsist()
            Dim recordFound As Boolean = False
            Dim SQLQuery As String = "SELECT LocoConsistGUID, UnitID, TrainGUID, TrainSheetUID, FacingDirection, Status, UnitPosition, DeadHead, PTCEquipped, Length, Weight, HorsePower, EffectiveHP, NumOfAxles, GPSEquipped FROM tblTrainLocomotiveConsistActive WHERE TrainGUID='" & Me.TrainGUID & "' ORDER BY UnitPosition"
            Try
                ' clear any curretn items
                Me.LocoCurrent.Clear()

                Using dbConn As New OleDbConnection(gConnectionStringTrain)
                    dbConn.Open()
                    Dim dbComm As New OleDbCommand(SQLQuery, dbConn)
                    Dim dr As OleDbDataReader = dbComm.ExecuteReader

                    While dr.Read
                        Dim newUnit As New TrainUnit(dr.GetString(0))
                        ' UnitID
                        If Not dr.IsDBNull(1) Then
                            newUnit.UnitNumber = dr.GetString(1)
                        End If
                        ' TrainGUID
                        If Not dr.IsDBNull(2) Then
                            newUnit.TrainGUID = dr.GetString(2)
                        End If
                        ' TrainSheetUID
                        If Not dr.IsDBNull(3) Then
                            newUnit.TrainSheetUID = dr.GetString(3)
                        End If
                        ' FacingDirection
                        If Not dr.IsDBNull(4) Then
                            newUnit.Direction = dr.GetString(4)
                        End If
                        ' Status
                        If Not dr.IsDBNull(5) Then
                            newUnit.Status = dr.GetString(5)
                        End If
                        ' UnitPosition
                        If Not dr.IsDBNull(6) Then
                            newUnit.UnitPosition = dr.GetInt32(6)
                        End If
                        ' DeadHead
                        If Not dr.IsDBNull(7) Then
                            newUnit.Deadhead = dr.GetBoolean(7)
                        End If
                        ' PTCEquipped
                        If Not dr.IsDBNull(8) Then
                            newUnit.PTCEquipped = dr.GetBoolean(8)
                        End If
                        ' Length
                        If Not dr.IsDBNull(9) Then
                            newUnit.Length = dr.GetInt32(9)
                        Else
                            newUnit.Length = -1
                        End If
                        ' Weight
                        If Not dr.IsDBNull(10) Then
                            newUnit.Weight = dr.GetInt32(10)
                        Else
                            newUnit.Weight = -1
                        End If
                        ' HorsePower
                        If Not dr.IsDBNull(11) Then
                            newUnit.TotalHP = dr.GetInt32(11)
                        Else
                            newUnit.TotalHP = -1
                        End If
                        ' EffectiveHP
                        If Not dr.IsDBNull(12) Then
                            newUnit.EffectiveHP = dr.GetInt32(12)
                        Else
                            newUnit.EffectiveHP = -1
                        End If
                        ' NumOfAxles
                        If Not dr.IsDBNull(13) Then
                            newUnit.NumOfAxles = dr.GetInt32(13)
                        End If
                        ' GPSEquipped
                        If Not dr.IsDBNull(14) Then
                            newUnit.GPSCapable = dr.GetBoolean(14)
                        End If

                        ' add the item to the collection
                        Me.LocoCurrent.Add(newUnit)
                    End While
                    dr.Close()
                    dbConn.Close()

                End Using
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub ResetUnitStatusInDB(ByVal UnitID As String, ByVal ResetStatusTo As String)
            Dim Update As New System.Text.StringBuilder
            Dim dbcomm As OleDbCommand = Nothing
            Try
                Using DbConn As New OleDbConnection(gConnectionStringStatic)
                    DbConn.Open()
                    Update.Append("UPDATE tblSystemLocomotives SET Status ='" & ResetStatusTo & "'")
                    Update.Append(" WHERE UID = '" & UnitID & "'")
                    dbcomm = New OleDbCommand(Update.ToString, DbConn)
                    dbcomm.ExecuteNonQuery()
                    DbConn.Close()
                End Using

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
            End Try
        End Sub

        Public Sub UpdateUnitValueInDB(ByVal UnitID As String, ColumnName As String, SetValue As Object)
            Dim Update As New System.Text.StringBuilder
            Dim dbcomm As OleDbCommand = Nothing
            Dim ColumnValue As String = ""
            Try
                Select Case SetValue.GetType.ToString
                    Case "System.Int16", "System.Int32", "System.Int64", "System.Integer"
                        ColumnValue = " [" & ColumnName & "]=" & SetValue
                    Case "System.Boolean"
                        ColumnValue = " [" & ColumnName & "]=" & CInt(SetValue)
                    Case "System.DateTime", "System.String"
                        ColumnValue = " [" & ColumnName & "]='" & SetValue & "'"

                End Select


                Using DbConn As New OleDbConnection(gConnectionStringStatic)
                    DbConn.Open()
                    Update.Append("UPDATE tblSystemLocomotives SET " & ColumnValue)
                    Update.Append(" WHERE UID = '" & UnitID & "'")
                    dbcomm = New OleDbCommand(Update.ToString, DbConn)
                    dbcomm.ExecuteNonQuery()
                    DbConn.Close()
                End Using

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
            End Try
        End Sub

