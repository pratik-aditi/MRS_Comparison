        Private Sub PerformProcessTrainSchedules(Optional ByVal TimeCheck As Boolean = False)
            Dim CurrentDateTime As Date = Now
            Dim AtleastOneScheduleExistsInLoadedTerritory As Boolean = False
            If ProcessingSchedulerStarted Then Exit Sub
            Try
                If Not IsNothing(Me.myTrack) Then
                    If optEnableTimeZoneSettings Then
                        CurrentDateTime = ReturnReportTime(Nothing, Me.myTrack)
                    Else
                        CurrentDateTime = GetAdjustedDateTimeByTimeZone(Me.myTrack.mySubdivision)
                    End If
                    'CurrentDateTime = ReturnReportTime(Nothing, Me.myTrack) 'GetAdjustedDateTimeByTimeZone(Me.myTrack.mySubdivision)
                End If
                ProcessingSchedulerStarted = True
                pInitalProcessingSchedulerDone = True
                If Me.myScheduleList Is Nothing Then Exit Sub
                If Me.myScheduleList.Count = 0 Then Exit Sub
                AtleastOneScheduleExistsInLoadedTerritory = HasValidScheduleInThisRoute()
                If Not AtleastOneScheduleExistsInLoadedTerritory Then Exit Sub

                If Not TimeCheck Then
                    'OS CHECK
                    If gOptUsePassengerStationForSchedule Then
                        DoTrainScheduleOnOSMovementEvent_Psgr(CurrentDateTime)
                    ElseIf optEnableTrainMovementReporting Then
                        DoTrainScheduleOnOSMovementEvent(CurrentDateTime)
                    Else
                        DoTrainScheduleOnOSEvent(CurrentDateTime)
                    End If

                Else
                    'Time Check
                    If optEnableTrainDelayOnTimeCheck Then DoTrainScheduleTimeCheck(CurrentDateTime)
                    If optEnableCalculateTrainDeviation Then DoTrainScheduleDeviationTimeCheck(CurrentDateTime)
                End If
                CreateTrainScheduleAlert()
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                ProcessingSchedulerStarted = False
            End Try
        End Sub

        Private Function HasValidScheduleInThisRoute() As Boolean
            Dim subdvn As Subdivision = Nothing
            Dim trnSch As TrainSchedule = Nothing
            Dim subStat As SubdivisionStation = Nothing
            Try
                If gOptUsePassengerStationForSchedule Then
                    Return HasValidScheduleInThisRouteUsePlatform()
                End If
                For Each subdvn In TMDS.GlobalDeclarations.ControlledSubdivisions
                    If subdvn.Stations IsNot Nothing AndAlso subdvn.Stations.Count > 0 Then
                        For Each trnSch In Me.myScheduleList
                            For Each subStat In subdvn.Stations
                                If subStat.Name.Trim.ToUpper = trnSch.myStationName.Trim.ToUpper Then
                                    Return True
                                ElseIf subStat.ReportingUID.Trim.ToUpper = trnSch.myStationName.Trim.ToUpper Then
                                    Return True
                                End If
                            Next
                        Next
                    End If
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                trnSch = Nothing
                subdvn = Nothing
                subStat = Nothing
            End Try
        End Function

        Private Function HasValidScheduleInThisRouteUsePlatform() As Boolean

            Dim trnSch As TrainSchedule = Nothing
            Dim PS As PassengerStation = Nothing
            Try

                For Each PS In gPassengerStationCollection
                    For Each trnSch In Me.myScheduleList
                        If PS.ReportingUID.Trim.ToUpper = trnSch.myStationUID.Trim.ToUpper Then
                            Return True
                        End If
                    Next
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                trnSch = Nothing
                PS = Nothing

            End Try
        End Function

        Private Sub DoTrainScheduleTimeCheck(ByVal CurrentDateTime As Date)
            Dim dtSCH As New DataTable
            Dim dvSCH As DataView
            Dim subStat As SubdivisionStation = Nothing
            Dim StationName As String = ""
            Dim myTimeIn As Date
            Dim DelayData As String = ""
            Dim DelayCODE As String = "TPD"
            Dim DelayMins As Integer = 0
            Dim DelayComments As String = ""
            Dim TrnSchGUID As String = ""
            Dim StationControlPoint As ControlPoint = Nothing
            Dim StationCPGUID As String = "NOTHING"
            Dim trnSch As TrainSchedule = Nothing
            Dim ForceStopTimer As Boolean = False
            Try
                Me.ScheduleTimer.Enabled = False
                dtSCH = TMDS.SystemUtilities.FetchData.GetTrainSchedulerDatatable(Me)
                If dtSCH IsNot Nothing AndAlso dtSCH.Rows.Count > 0 Then
                    dvSCH = New DataView(dtSCH, "Processed=0", "OrderIndex ASC", DataViewRowState.OriginalRows)
                    If dvSCH IsNot Nothing AndAlso dvSCH.Count > 0 Then
                        For i As Integer = 0 To dvSCH.Count - 1
                            StationName = ""
                            TrnSchGUID = ""
                            trnSch = Nothing
                            subStat = Nothing
                            StationName = dvSCH(i)("Station")
                            TrnSchGUID = dvSCH(i)("UID")
                            trnSch = TMDS.SystemUtilities.FetchData.FindTrainScheduleByGUID(Me, TrnSchGUID)
                            Dim strTimeIn As String = CurrentDateTime.ToShortDateString & " " & Format(dvSCH(i)("TimeIn"), "HH:mm:ss")
                            If Date.TryParse(strTimeIn, myTimeIn) AndAlso trnSch IsNot Nothing Then
                                Dim tmSpan As TimeSpan
                                tmSpan = CurrentDateTime.Subtract(myTimeIn)
                                DelayData = trnSch.myUID & "|" & trnSch.myTrainSymbol & "|" & trnSch.myStationName & "|" & myTimeIn.ToString & "|" & CurrentDateTime.ToString & "|"
                                DelayComments = "SCHEDULED TIME IN:" & myTimeIn.ToString & " - TIMECHECK: " & CurrentDateTime.ToString
                                subStat = TMDS.SystemUtilities.FetchData.FindSubdivisionStationFromName(trnSch.myStationName)
                                DelayMins = System.Math.Abs(tmSpan.TotalMinutes)
                                'DelayMins = tmSpan.Minutes
                                If subStat Is Nothing Then
                                    TrainEventLog("UNABLE TO LOCATE STATION NAME: " & Me.Name & ":" & trnSch.myStationName & " UID: " & trnSch.myUID)
                                    trnSch.myScheduleProcessedTimeStamp = CurrentDateTime
                                    trnSch.myScheduleProcessed = True
                                Else
                                    'subStat.ControlPointUID
                                    'StationControlPoint = TMDS.SystemUtilities.FetchData.FindControlPoint(subStat.ControlPointUID)
                                    'If StationControlPoint IsNot Nothing Then StationControlPointName = StationControlPoint.Name
                                    StationCPGUID = subStat.ControlPointUID.ToString
                                    If tmSpan.TotalMinutes >= (System.Math.Abs(gDelayTolerance) - 0.1) Then
                                        trnSch.myScheduleProcessedTimeStamp = CurrentDateTime
                                        trnSch.myScheduleProcessed = True
                                        trnSch.myScheduleStatus = "LATE"
                                        trnSch.myScheduleMinutesLate = DelayMins 'tmSpan.TotalMinutes
                                        DelayData = DelayData & DelayMins ' System.Math.Abs(tmSpan.TotalMinutes)
                                        Me.Schedule_LastDelayEvent = "DELAYED BY " & DelayMins & "(MINS)(" & trnSch.myStationName & ") - " & DelayComments
                                        'Me.AddTrainDelayTAGEvent(CurrentDateTime, StationCPGUID, subStat.Name, subStat.MilePost, "", DelayCODE, DelayComments, System.Math.Abs(DelayMins).ToString, optRailRoadName, DelayData, True)
                                        'TrainEvent("Train Schedule :" & Me.Name & ":" & trnSch.myStationName & " UID: " & trnSch.myUID & " TIMER CHECK - " & CurrentDateTime.ToString & " SCHEDULE TIME:" & myTimeIn.ToString)

                                        Me.AddScheduleDelay(CurrentDateTime, StationCPGUID, subStat.Name, subStat.MilePost, "", DelayCODE, DelayComments, System.Math.Abs(DelayMins).ToString, optRailRoadName, DelayData, True, trnSch.myStationName.Trim.ToUpper)
                                        TrainEventLog("Train Schedule :" & Me.Name & ":" & trnSch.myStationName & " UID: " & trnSch.myUID & " TIMER CHECK - " & CurrentDateTime.ToString & " SCHEDULE TIME:" & myTimeIn.ToString)

                                        Exit For
                                    Else
                                        TrainEventLog("Train Schedule :" & Me.Name & ":" & trnSch.myStationName & " UID: " & trnSch.myUID & " TIMER CHECK - " & CurrentDateTime.ToString & " SCHEDULE TIME:" & myTimeIn.ToString)
                                    End If
                                    ' Exit For
                                End If
                            End If
                        Next
                    Else
                        'If all my Scheduled records are processed then we can stop the timer.
                        Me.ScheduleTimer.Enabled = False
                        ForceStopTimer = True
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                trnSch = Nothing
                subStat = Nothing
                dtSCH = Nothing
                dvSCH = Nothing
                If Not ForceStopTimer Then Me.ScheduleTimer.Enabled = True
            End Try
        End Sub

        Private Sub DoTrainScheduleDeviationTimeCheck(ByVal CurrentDateTime As Date)
            Dim dtSCH As New DataTable
            Dim dvSCH As DataView
            Dim subStat As SubdivisionStation = Nothing
            Dim StationName As String = ""
            Dim myTimeIn As Date
            Dim DelayData As String = ""
            Dim DelayCODE As String = "TPD"
            Dim DelayMins As Integer = 0
            Dim DelayComments As String = ""
            Dim TrnSchGUID As String = ""
            Dim StationControlPoint As ControlPoint = Nothing
            Dim StationCPGUID As String = "NOTHING"
            Dim trnSch As TrainSchedule = Nothing
            Dim trnSchToProcess As TrainSchedule = Nothing
            Dim ForceStopTimer As Boolean = False

            Dim myOsTrack As Track = Nothing
            Dim MyStatlst As New ArrayList
            Dim DoTrainSheetSummaryRefresh As Boolean = False

            Try
                Me.ScheduleTimer.Enabled = False
                dtSCH = TMDS.SystemUtilities.FetchData.GetTrainSchedulerDatatable(Me)

                Dim str As String = ""
                If Me.TrnMovements IsNot Nothing AndAlso Me.TrnMovements.Count > 0 Then
                    trnSchToProcess = Nothing
                    str = Me.TrnMovements(0)
                    Dim OsMessage() As String = str.Split("|")
                    Dim OSTime As Date
                    Dim OSType As String = ""
                    Dim TrackGUID As Integer = 0
                    'If OsMessage.GetUpperBound(0) > 3 Then
                    Date.TryParse(OsMessage(1), OSTime)
                    OSType = OsMessage(3)
                    If OSType.Trim.ToUpper = "ON STATION" Then
                        Integer.TryParse(OsMessage(4), TrackGUID)
                        myOsTrack = Nothing
                        Dim OSDate As Date = CurrentDateTime.ToShortDateString
                        MyStatlst = New ArrayList
                        If TrackGUID > 0 Then
                            myOsTrack = FindCompFromGUID(TrackGUID)
                        End If
                        If myOsTrack IsNot Nothing Then
                            MyStatlst = TMDS.SystemUtilities.FetchData.FindSubdivisionStationsFromTrack(myOsTrack)
                        Else
                            MyStatlst = TMDS.SystemUtilities.FetchData.FetchSubdivisionStationsFromTrack_DB(TrackGUID)
                            If MyStatlst Is Nothing Then MyStatlst = New ArrayList
                        End If
                        Dim OSStationName As String = ""

                        Dim stat As SubdivisionStation
                        Dim ProcessCompleted As Boolean = False
                        Dim LastOSPointDetected As Boolean = False
                        If Not gOptUsePassengerStationForSchedule Then
                            For Each stat In MyStatlst
                                For Each trnSch In Me.myScheduleList
                                    If Not trnSch.IgnoreDeviationCalculation Then
                                        If LastOSPointDetected Then
                                            trnSchToProcess = trnSch
                                            ProcessCompleted = True
                                            Exit For
                                        End If
                                        If trnSch.myStationName.Trim.ToUpper = stat.ReportingUID.Trim.ToUpper Then
                                            LastOSPointDetected = True
                                            If trnSch Is Me.myScheduleList(Me.myScheduleList.Count - 1) Then ProcessCompleted = True
                                        End If
                                    End If

                                Next
                                If ProcessCompleted Then Exit For
                            Next
                        Else
                            Dim PS As PassengerStation = Nothing
                            Dim PSStationUID As String = ""
                            If OsMessage.GetUpperBound(0) > 3 Then
                                OSStationName = OsMessage(2)
                            End If
                            If myOsTrack IsNot Nothing AndAlso OSStationName IsNot Nothing AndAlso OSStationName.Trim <> "" Then
                                PS = TMDS.SystemUtilities.FetchData.FetchPassengerStations(OSStationName)
                                MyStatlst = New ArrayList
                                'If PS IsNot Nothing Then MyStatlst.Add(PS)
                                For Each trnSch In Me.myScheduleList
                                    If Not MyStatlst.Contains(trnSch.myStationUID.Trim.ToUpper) Then MyStatlst.Add(trnSch.myStationUID.Trim.ToUpper)
                                Next
                                For Each PSStationUID In MyStatlst
                                    If PSStationUID IsNot Nothing AndAlso PSStationUID.Trim <> "" Then
                                        For Each trnSch In Me.myScheduleList
                                            Dim IsSCHOfRightType As Boolean = False
                                            If OSType.Trim.ToUpper = "ON STATION" AndAlso trnSch.myCategory.Trim.ToUpper = "ARRIVAL" Then
                                                IsSCHOfRightType = True
                                            End If
                                            If IsSCHOfRightType Then
                                                If Not trnSch.IgnoreDeviationCalculation Then
                                                    If LastOSPointDetected Then
                                                        trnSchToProcess = trnSch
                                                        ProcessCompleted = True
                                                        Exit For
                                                    End If
                                                    If trnSch.myStationUID.Trim.ToUpper = OSStationName.Trim.ToUpper Then
                                                        'If trnSch.myStationUID.Trim.ToUpper = PS.ReportingUID.Trim.ToUpper Then
                                                        LastOSPointDetected = True
                                                        If trnSch Is Me.myScheduleList(Me.myScheduleList.Count - 1) Then ProcessCompleted = True
                                                    End If
                                                End If
                                            End If
                                        Next
                                        If ProcessCompleted Then Exit For
                                    End If
                                Next
                            End If

                        End If




                        If trnSchToProcess IsNot Nothing AndAlso Not trnSchToProcess.myScheduleProcessed AndAlso Not trnSchToProcess.IgnoreDeviationCalculation Then
                            Dim strTimeIn As String = OSDate & " " & Format(trnSchToProcess.myStationArrivalTime, "HH:mm:ss")
                            'subStat = TMDS.SystemUtilities.FetchData.FindSubdivisionStationFromName(trnSchToProcess.myStationName)
                            If gOptUsePassengerStationForSchedule Then
                                strTimeIn = trnSchToProcess.myStationArrivalTime.ToString
                            End If
                            myScheduleDeviationStation = trnSchToProcess.myStationName
                            If Date.TryParse(strTimeIn, myTimeIn) Then
                                Dim tmSpan As TimeSpan
                                tmSpan = OSTime.Subtract(myTimeIn)
                                tmSpan = CurrentDateTime.Subtract(myTimeIn)
                                If tmSpan.TotalMinutes >= (System.Math.Abs(gDelayTolerance) - 0.1) Then
                                    Me.myScheduleDeviation = tmSpan.TotalMinutes '* -1
                                Else
                                    Me.myScheduleDeviation = tmSpan.TotalMinutes
                                End If
                                DoTrainSheetSummaryRefresh = True
                                Me.myTrack.InitTrainDisplay()
                                Me.myTrack.InvalidateTrainID()
                            End If
                        End If

                        'End If
                    End If
                End If


                If DoTrainSheetSummaryRefresh Then
                    Try
                        Dim SummItem As New SummaryItem("TRAIN", "FORCE-REFRESH", Me)
                        SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                            TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                        End SyncLock
                    Catch ex As Exception
                    End Try
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                trnSch = Nothing
                subStat = Nothing
                dtSCH = Nothing
                dvSCH = Nothing
                If Not ForceStopTimer Then Me.ScheduleTimer.Enabled = True
            End Try
        End Sub

        Private Sub DoTrainScheduleOnOSEvent(ByVal CurrentDateTime As Date)
            Dim dtSCH As New DataTable
            Dim dvSCH As DataView
            Dim subStat As SubdivisionStation = Nothing
            Dim StationName As String = ""
            Dim myTimeIn As Date
            Dim DelayData As String = ""
            Dim DelayCODE As String = "TPD"
            Dim DelayMins As Integer = 0
            Dim DelayComments As String = ""
            Dim TrnSchGUID As String = ""
            Dim StationControlPoint As ControlPoint = Nothing
            Dim StationCPGUID As String = "NOTHING"
            Dim trnSch As TrainSchedule = Nothing

            Dim OSDataTable As New DataTable
            Dim dvOS As DataView
            Dim myOsTrack As Track = Nothing
            Try
                If Me.OSTimes IsNot Nothing AndAlso Me.OSTimes.Count > 0 Then
                    'Load OS from TMDS memory. Since there is a time delay(1000) before the Get's updated in the database
                    OSDataTable = GetTrainOsRecordsForSchedule()
                Else
                    OSDataTable = GetTrainOsRecordsForScheduleFromDB()
                End If

                If OSDataTable Is Nothing Then Exit Sub
                If OSDataTable.Rows.Count = 0 Then Exit Sub
                dvOS = New DataView(OSDataTable, "", "OSTIME", DataViewRowState.OriginalRows)
                dtSCH = TMDS.SystemUtilities.FetchData.GetTrainSchedulerDatatable(Me)
                If dvOS IsNot Nothing AndAlso dvOS.Count > 0 Then
                    For i As Integer = 0 To dvOS.Count - 1
                        Dim OSTime As Date
                        Dim OSPoint As String = ""
                        Dim OSDate As String = ""
                        Dim OSSub As String = ""
                        Dim TrackGUID As Integer = 0
                        myOsTrack = Nothing

                        If Date.TryParse(dvOS(i)("OSTIME"), OSTime) Then
                            OSPoint = dvOS(i)("OsPoint")
                            OSDate = OSTime.ToShortDateString
                            TrackGUID = dvOS(i)("TrackGUID")
                            OSSub = dvOS(i)("SUBNAME")
                            myOsTrack = Me.myTrack 'FindCompFromGUID(TrackGUID)

                            If dtSCH IsNot Nothing AndAlso dtSCH.Rows.Count > 0 Then
                                dvSCH = New DataView(dtSCH)
                                dvSCH.RowFilter = ""
                                dvSCH.RowFilter = "Processed=0 AND Station='" & OSPoint.Trim.ToUpper & "'"
                                If dvSCH IsNot Nothing AndAlso dvSCH.Count > 0 Then
                                    StationName = ""
                                    TrnSchGUID = ""
                                    trnSch = Nothing
                                    subStat = Nothing
                                    StationName = dvSCH(0)("Station")
                                    TrnSchGUID = dvSCH(0)("UID")
                                    trnSch = TMDS.SystemUtilities.FetchData.FindTrainScheduleByGUID(Me, TrnSchGUID)
                                    Dim strTimeIn As String = OSDate & " " & Format(dvSCH(0)("TimeIn"), "HH:mm:ss")

                                    If Date.TryParse(strTimeIn, myTimeIn) AndAlso trnSch IsNot Nothing Then

                                        Dim tmSpan As TimeSpan
                                        tmSpan = OSTime.Subtract(myTimeIn)
                                        DelayData = TrnSchGUID & "|" & Me.Name & "|" & StationName & "|" & myTimeIn.ToString & "|" & OSTime.ToString & "|"
                                        DelayComments = "SCHEDULED TIME IN:" & myTimeIn.ToString & " - OSTIME: " & OSTime.ToString
                                        subStat = TMDS.SystemUtilities.FetchData.FindSubdivisionStationFromName(trnSch.myStationName)
                                        'DelayMins = System.Math.Abs(tmSpan.TotalMinutes)
                                        DelayMins = tmSpan.TotalMinutes

                                        Dim Status As String = ""
                                        Dim SCHMins As Integer
                                        trnSch.myScheduleProcessedTimeStamp = CurrentDateTime
                                        trnSch.myScheduleProcessed = True
                                        If subStat Is Nothing Then
                                            TrainEventLog("UNABLE TO LOCATE STATION NAME: " & trnSch.myStationName & " UID: " & trnSch.myUID & ":" & Me.Name)
                                        Else
                                            StationCPGUID = subStat.ControlPointUID.ToString

                                            If tmSpan.TotalMinutes >= (System.Math.Abs(gDelayTolerance) - 0.1) Then
                                                trnSch.myScheduleStatus = "LATE"
                                                trnSch.myScheduleMinutesLate = DelayMins ' tmSpan.TotalMinutes
                                                Status = "LATE"
                                                SCHMins = tmSpan.TotalMinutes
                                                DelayData = DelayData & DelayMins 'System.Math.Abs(tmSpan.TotalMinutes)
                                                Me.Schedule_LastDelayEvent = "DELAYED BY " & DelayMins & "(MINS)(" & trnSch.myStationName & ") - " & DelayComments
                                                'Me.AddTrainDelayTAGEvent(CurrentDateTime, StationCPGUID, subStat.Name, subStat.MilePost, "", DelayCODE, DelayComments, System.Math.Abs(DelayMins).ToString, optRailRoadName, DelayData, True)

                                                Me.AddScheduleDelay(CurrentDateTime, StationCPGUID, subStat.Name, subStat.MilePost, "", DelayCODE, DelayComments, System.Math.Abs(DelayMins).ToString, optRailRoadName, DelayData, True, trnSch.myStationName.Trim.ToUpper)
                                                TrainEventLog("Train Schedule :" & Me.Name & ":" & trnSch.myStationName & " UID: " & trnSch.myUID & " OS TIME - " & OSTime.ToString & " SCHEDULE TIME:" & myTimeIn.ToString)

                                            Else

                                                trnSch.myScheduleStatus = "EARLY"
                                                trnSch.myScheduleMinutesLate = 0
                                                Status = "EARLY"
                                                SCHMins = 0
                                                TrainEventLog("Train Schedule :" & Me.Name & ":" & trnSch.myStationName & " UID: " & trnSch.myUID & " OS TIME - " & OSTime.ToString & " SCHEDULE TIME:" & myTimeIn.ToString)

                                            End If
                                        End If
                                    End If
                                Else
                                    'TrainEvent("UNABLE TO MAP OSPOINT AND STATION NAME: " & OSPoint.Trim.ToUpper & " UID: " & trnSch.myUID)
                                End If
                            End If
                        End If
                    Next
                End If
                If gDebug Then
                    For Each trnSch In Me.myScheduleList
                        TrainEventLog("TRAIN SCHEDULE::: " & trnSch.myStationName & " UID: " & trnSch.myUID & " ScheduleStatus Processed- " & trnSch.myScheduleProcessed.ToString & " ScheduleStatus Processed tIME- " & trnSch.myScheduleProcessedTimeStamp.ToString)
                    Next
                    TrainEventLog(vbCrLf)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                trnSch = Nothing
                subStat = Nothing
                dtSCH = Nothing
                dvSCH = Nothing
                OSDataTable = Nothing
                dvOS = Nothing
                myOsTrack = Nothing
            End Try
        End Sub

        Private Sub DoTrainScheduleOnOSMovementEvent(ByVal CurrentDateTime As Date)
            Dim dtSCH As New DataTable
            Dim dvSCH As DataView
            Dim subStat As SubdivisionStation = Nothing
            Dim StationName As String = ""
            Dim myTimeIn As Date
            Dim DelayData As String = ""
            Dim DelayCODE As String = "TPD"
            Dim DelayMins As Integer = 0
            Dim DelayComments As String = ""
            Dim TrnSchGUID As String = ""
            Dim StationControlPoint As ControlPoint = Nothing
            Dim StationCPGUID As String = "NOTHING"
            Dim TrainSch As TrainSchedule = Nothing

            Dim OSDataTable As New DataTable
            Dim dvOS As DataView
            Dim myOsTrack As Track = Nothing
            Dim MyStatlst As New ArrayList
            Try

                Dim str As String = ""
                If Me.TrnMovements IsNot Nothing AndAlso Me.TrnMovements.Count > 0 Then
                    ' Dim OsMessage As String = EventUID & "|" & Format(Now, "MM-dd-yyyy HH:mm") & "|" & theControlPoint.Name & "|" & EventType & "|" & theTrack.GUID
                    Dim tmpTrainMovements As New ArrayList
                    CopyArrayCollection(tmpTrainMovements, Me.TrnMovements)
                    For Each str In tmpTrainMovements
                        Dim OsMessage() As String = str.Split("|")
                        Dim OSTime As Date
                        Dim OSType As String = ""
                        Dim TrackGUID As Integer = 0
                        If OsMessage.GetUpperBound(0) > 3 Then
                            Date.TryParse(OsMessage(1), OSTime)
                            OSType = OsMessage(3)
                            If OSType.Trim.ToUpper = "ON STATION" Then
                                Integer.TryParse(OsMessage(4), TrackGUID)
                                myOsTrack = Nothing
                                Dim OSDate As Date = OSTime.ToShortDateString
                                MyStatlst = New ArrayList
                                If TrackGUID > 0 Then
                                    myOsTrack = FindCompFromGUID(TrackGUID)
                                End If
                                If myOsTrack IsNot Nothing Then
                                    MyStatlst = TMDS.SystemUtilities.FetchData.FindSubdivisionStationsFromTrack(myOsTrack)
                                End If
                                Dim stat As SubdivisionStation
                                Dim ProcessCompleted As Boolean = False
                                For Each stat In MyStatlst
                                    For Each TrainSch In Me.myScheduleList
                                        If Not TrainSch.myScheduleProcessed AndAlso TrainSch.myStationName.Trim.ToUpper = stat.ReportingUID.Trim.ToUpper Then
                                            Dim strTimeIn As String = OSDate & " " & Format(TrainSch.myStationArrivalTime, "HH:mm:ss")
                                            If Date.TryParse(strTimeIn, myTimeIn) AndAlso TrainSch IsNot Nothing Then
                                                Dim tmSpan As TimeSpan
                                                tmSpan = OSTime.Subtract(myTimeIn)
                                                DelayData = TrnSchGUID & "|" & Me.Name & "|" & StationName & "|" & myTimeIn.ToString & "|" & OSTime.ToString & "|"
                                                DelayComments = "SCHEDULED TIME IN:" & myTimeIn.ToString & " - OSTIME: " & OSTime.ToString
                                                subStat = TMDS.SystemUtilities.FetchData.FindSubdivisionStationFromName(TrainSch.myStationName)
                                                DelayMins = tmSpan.TotalMinutes
                                                StationCPGUID = stat.ControlPointUID.ToString
                                                TrainSch.myScheduleProcessedTimeStamp = CurrentDateTime
                                                TrainSch.myScheduleProcessed = True
                                                If tmSpan.TotalMinutes >= (System.Math.Abs(gDelayTolerance) - 0.1) Then
                                                    TrainSch.myScheduleStatus = "LATE"
                                                    TrainSch.myScheduleMinutesLate = DelayMins ' tmSpan.TotalMinutes
                                                    DelayData = DelayData & DelayMins 'System.Math.Abs(tmSpan.TotalMinutes)
                                                    Me.Schedule_LastDelayEvent = "DELAYED BY " & DelayMins & "(MINS)(" & TrainSch.myStationName & ") - " & DelayComments
                                                    'Me.AddTrainDelayTAGEvent(CurrentDateTime, StationCPGUID, subStat.Name, subStat.MilePost, "", DelayCODE, DelayComments, System.Math.Abs(DelayMins).ToString, optRailRoadName, DelayData, True)
                                                    Me.AddScheduleDelay(CurrentDateTime, StationCPGUID, subStat.Name, subStat.MilePost, "", DelayCODE, DelayComments, System.Math.Abs(DelayMins).ToString, optRailRoadName, DelayData, True, TrainSch.myStationName.Trim.ToUpper)
                                                    TrainEventLog("Train Schedule :" & Me.Name & ":" & TrainSch.myStationName & " UID: " & TrainSch.myUID & " OS TIME - " & OSTime.ToString & " SCHEDULE TIME:" & myTimeIn.ToString)
                                                Else
                                                    TrainSch.myScheduleStatus = "EARLY"
                                                    TrainSch.myScheduleMinutesLate = tmSpan.TotalMinutes
                                                    TrainEventLog("Train Schedule :" & Me.Name & ":" & TrainSch.myStationName & " UID: " & TrainSch.myUID & " OS TIME - " & OSTime.ToString & " SCHEDULE TIME:" & myTimeIn.ToString)
                                                End If
                                                Exit For
                                            End If
                                        End If
                                    Next
                                Next



                            End If
                        End If
                    Next
                End If
                If gDebug Then
                    For Each TrainSch In Me.myScheduleList
                        TrainEventLog("TRAIN SCHEDULE::: " & TrainSch.myStationName & " UID: " & TrainSch.myUID & " ScheduleStatus Processed- " & TrainSch.myScheduleProcessed.ToString & " ScheduleStatus Processed tIME- " & TrainSch.myScheduleProcessedTimeStamp.ToString)
                    Next
                    TrainEventLog(vbCrLf)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                TrainSch = Nothing
                subStat = Nothing
                dtSCH = Nothing
                dvSCH = Nothing
                OSDataTable = Nothing
                dvOS = Nothing
                myOsTrack = Nothing
            End Try
        End Sub

        Private Function GetTrainOsRecordsForScheduleFromDB() As DataTable
            Dim SQLQueryRecords As String = " SELECT * FROM tblTrainOsEventsActive WHERE TrainSheetGUID = '" & Me.ActiveTrainSheetGUID & "' ORDER BY OsTime DESC"
            Dim drow As DataRow
            Dim Tempdrow As DataRow
            Dim ds As New DataSet
            Dim OSDT As New DataTable
            Dim strReportData As String = ""
            Dim AddedOSPoints As New ArrayList
            Try
                OSDT = DefineOSDatatable()
                ds = GetResultDS(SQLQueryRecords, False)
                If IsValidDataset(ds) Then
                    For Each drow In ds.Tables(0).Rows
                        If Not AddedOSPoints.Contains(drow("OsPoint")) Then
                            AddedOSPoints.Add(drow("OsPoint"))
                            strReportData = ""
                            strReportData = drow("ReportData")
                            Dim OSTime As Date
                            Dim RptDataSplt() As String = strReportData.Split("|")
                            If RptDataSplt.GetUpperBound(0) > 1 Then
                                If Date.TryParse(RptDataSplt(1), OSTime) Then
                                Else
                                    OSTime = drow("OsTime")
                                End If
                            Else
                                OSTime = drow("OsTime")
                            End If

                            Tempdrow = OSDT.NewRow
                            Tempdrow("UID") = drow("RecordGUID")
                            Tempdrow("OSPOINT") = drow("OsPoint")
                            Tempdrow("TRACKGUID") = drow("TrackGUID")
                            Tempdrow("SUBNAME") = drow("SubName")
                            Tempdrow("OSTIME") = OSTime
                            OSDT.Rows.Add(Tempdrow)
                            OSDT.AcceptChanges()
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                ds = Nothing
            End Try
            Return OSDT
        End Function

        Private Function GetTrainOsRecordsForSchedule() As DataTable
