#Region "CLEARANCE CREATION"

        Private Delegate Sub PerformCreateClearanceForTrain()

        ''' <summary>
        ''' Do Create Clearance For Train
        ''' </summary>
        Public Sub DoCreateClearanceForTrain()
            Dim createClearance As PerformCreateClearanceForTrain
            Try
                createClearance = New PerformCreateClearanceForTrain(AddressOf CreateClearanceTGBO)
                createClearance.BeginInvoke(Nothing, Nothing)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                createClearance = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Create Clearance TGBO
        ''' </summary>
        Private Sub CreateClearanceTGBO()
            Dim clearance As String
            Dim tgb As TabularGeneralBulletin
            Try
                Threading.Thread.Sleep(60000)
                TrainEventLog("CreateClearanceTGBO:Create")
                clearance = Mid(Me.IdentifingUnit, 7)
                If Not CheckClearanceForTrain(clearance) Then
                    If Me.IdentifingUnit = "" Then
                        TrainEventLog("CreateClearanceTGBO:IdentifingUnit is empty")
                        Exit Sub
                    End If
                    clearance = Mid(Me.IdentifingUnit, 7)
                    tgb = CreateTabularGeneralBulletin(clearance)
                    tgb.EffectiveDate = Now
                    tgb.InsertTGBOIntoDatabase()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                clearance = Nothing
                tgb = Nothing
            End Try
        End Sub

        Public Sub DeleteClearanceTGBO()
            Try
                Dim Clearance As String = Mid(Me.IdentifingUnit, 7)
                DeleteClearanceForTrain(Clearance)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Delete Clearance For Train
        ''' </summary>
        ''' <param name="pNumberForTGBO"></param>
        Public Sub DeleteClearanceForTrain(ByVal pNumberForTGBO As String)
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim query As String = String.Empty
            Try
                TrainEventLog("DeleteClearanceForTrain:NumberForTGBO=" & pNumberForTGBO)
                query = "DELETE FROM tblSystemTabularGeneralBulletinActive WHERE UID = '" & pNumberForTGBO & "' OR IssuedTo = '" & Me.Name & "'"
                Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(query, dbconn)
                    dr = dbcomm.ExecuteReader
                    dr.Close()
                    dbconn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex, "DeleteClearanceForTrain - SQL[" & query & "]")
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                dr = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Check Clearance For Train
        ''' </summary>
        ''' <param name="pNumberForTGBO"></param>
        ''' <returns></returns>
        Public Function CheckClearanceForTrain(ByVal pNumberForTGBO As String) As Boolean
            Dim dbComm As OleDbCommand = Nothing
            Dim dbReader As OleDbDataReader = Nothing
            Dim query As String = "SELECT UID, RouteCodeUID FROM tblSystemTabularGeneralBulletinActive WHERE UID = '" & pNumberForTGBO & "' AND IssuedTo = '" & Me.Name & "'"
            Try
                CheckforLeadEngineChange(pNumberForTGBO, Me.Name)
                CheckForDupClearanceForTrain(pNumberForTGBO)
                Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    dbconn.Open()
                    dbComm = New OleDbCommand(query, dbconn)
                    dbReader = dbComm.ExecuteReader
                    While dbReader.Read
                        If Not dbReader.IsDBNull(0) Then
                            If Not dbReader.IsDBNull(1) Then
                                If UpdateRouteCode(dbReader.GetString(1)) Then
                                    Return True
                                End If
                            End If
                        Else
                            Return False
                        End If
                    End While
                    dbReader.Close()
                    dbconn.Close()
                End Using
            Catch ex As Exception
                SystemException("SQL=" & query & ":EX=" & ex.ToString)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                dbReader = Nothing
                query = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Update Route Code
        ''' </summary>
        ''' <param name="pRouteCode"></param>
        ''' <returns></returns>
        Public Function UpdateRouteCode(ByVal pRouteCode As String) As Boolean
            Dim dbComm As OleDbCommand = Nothing
            Dim myRouteCode As String = ""
            Dim query As String = ""
            Try
                Select Case Me.SubID
                    Case "4", "3" 'MRS-PG LINE AND STEEL LINE (CBTC)
                        myRouteCode = "2"
                    Case "2", "7" 'MRS-CENTRAL LINE (TWE)
                        myRouteCode = "3"
                    Case "1" 'RUMO-PORTOFER (CBTC)
                        myRouteCode = "1"
                    Case Else
                        TrainEventLog("UpdateRouteCode:NOT FOUND SUBID " & Me.SubID)
                End Select
                If myRouteCode <> pRouteCode Then
                    TrainEventLog("UpdateRouteCode:Update:myRouteCode=" & myRouteCode)
                    query = " UPDATE tblSystemTabularGeneralBulletinActive SET RouteCodeUID = '" & myRouteCode & "' WHERE IssuedTo = '" & Me.Name & "'"
                    Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                        dbconn.Open()
                        dbComm = New OleDbCommand(query, dbconn)
                        dbComm.ExecuteNonQuery()
                        dbconn.Close()
                    End Using
                    Return True
                Else
                    Return True
                End If
            Catch ex As Exception
                SystemException("SQL=" & query & ":EX=" & ex.ToString)
                Return False
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                query = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Check For Dup Clearance For Train
        ''' </summary>
        ''' <param name="pTGBO"></param>
        Private Sub CheckForDupClearanceForTrain(ByVal pTGBO As String)
            Dim dbComm As OleDbCommand = Nothing
            Dim dbReader As OleDbDataReader = Nothing
            Dim count As Integer = 0
            Dim guid As String = String.Empty
            Dim query As String = String.Empty
            Dim deleteQuery As String
            Try
                query = "SELECT SystemUID FROM tblSystemTabularGeneralBulletinActive WHERE UID = '" & pTGBO & "' OR IssuedTo = '" & Me.Name & "'"
                Try
                    Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                        dbconn.Open()
                        dbComm = New OleDbCommand(query, dbconn)
                        dbReader = dbComm.ExecuteReader
                        While dbReader.Read
                            count += 1
                            guid = dbReader.GetString(0)
                        End While
                        dbReader.Close()
                        dbconn.Close()
                    End Using
                    If count >= 1 Then
                        TrainEventLog("CheckForDupClearanceForTrain:Delete:Guid=" & guid)
                        deleteQuery = "DELETE tblSystemTabularGeneralBulletinActive WHERE SystemUID = '" & guid & "'"
                        Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                            dbconn.Open()
                            dbComm = New OleDbCommand(deleteQuery, dbconn)
                            dbComm.ExecuteNonQuery()
                            dbconn.Close()
                        End Using
                    End If
                Catch ex As Exception
                    SystemException("SQL=" & query & ":EX=" & ex.ToString)
                End Try
            Catch ex As Exception
                SystemException("SQL=" & query & ":EX=" & ex.ToString)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                dbReader = Nothing
                count = Nothing
                guid = Nothing
                query = Nothing
                deleteQuery = Nothing
            End Try
        End Sub

