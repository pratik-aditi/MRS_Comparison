        Public Function CheckForUndeliveredRestriction(ByVal myTGBO As TabularGeneralBulletin, ByVal LPoint As Object, ByVal Owner As Object) As Boolean
            Dim tr As TrainRestriction = Nothing
            Dim WT As WorkTask = Nothing
            Dim MessageList As New ArrayList()
            Dim HasCarRestriction As Boolean
            Dim HasWorkTask As Boolean
            Dim exp As TabularGeneralBulletinException
            Dim RestrictionToIgnore As New ArrayList
            Try
                DoRestrictionRefresh()
                If myTGBO Is Nothing Then Return False
                ' ThisTrainTGBO.GetExistingExceptions(BulletinCollection)
                If myTGBO.myExceptionListOfGBOs Is Nothing OrElse myTGBO.myExceptionListOfGBOs.Count = 0 Then
                    myTGBO.GetExistingExceptions(BulletinCollection)
                End If
                If Me.myRestrictionList IsNot Nothing AndAlso Me.myRestrictionList.Count > 0 Then
                    For Each tr In Me.myRestrictionList
                        If myTGBO.myExceptionListOfGBOs IsNot Nothing Then
                            For Each exp In myTGBO.myExceptionListOfGBOs
                                If exp.theGBO IsNot Nothing Then
                                    If tr.myUID = exp.theGBO.CorrelatingRestrictionUID Then
                                        If Not RestrictionToIgnore.Contains(tr) Then RestrictionToIgnore.Add(tr)
                                    End If
                                End If
                            Next
                        End If
                    Next
                    HasCarRestriction = True


                End If
                'HasCarRestriction = True
                If Me.myWorkTaskList IsNot Nothing AndAlso Me.myWorkTaskList.Count > 0 Then HasWorkTask = True
                If LPoint Is Nothing Then
                    LPoint = New Point(Me.myTrack.CurrentDrawingForm.Left + Me.myTrack.CurrentDrawingForm.Width / 2 - 100, 150)
                ElseIf LPoint.GetType.ToString <> "System.Drawing.Point" Then
                    LPoint = New Point(Me.myTrack.CurrentDrawingForm.Left + Me.myTrack.CurrentDrawingForm.Width / 2 - 100, 150)
                End If
                Dim RestrictionConflicts As New ArrayList
                Dim ShowRestrictionErrorMessage As Boolean = False
                If HasCarRestriction Then
                    For Each tr In Me.myRestrictionList
                        If tr IsNot Nothing AndAlso Not RestrictionToIgnore.Contains(tr) Then
                            If tr.myBulletinGUID Is Nothing Then
                                If Not RestrictionConflicts.Contains(tr) Then RestrictionConflicts.Add(tr)
                                ShowRestrictionErrorMessage = True
                                'MessageList = New ArrayList
                                'MessageList.Add("THIS TRAIN HAS ONE OR MORE UNDELIVERED CAR RESTRICTION(s)")
                                'MessageList.Add("THAT NEEDS DELIVERED BEFORE AUTHORITY ISSUANCE.")
                                'ShowCustomMessageBox(MessageList, "TRAIN TGBO VALIDATION", False, LPoint, False, True, Owner)
                                'Return True
                            ElseIf String.IsNullOrEmpty(tr.myBulletinGUID) OrElse tr.myBulletinGUID.Trim = String.Empty Then
                                If Not RestrictionConflicts.Contains(tr) Then RestrictionConflicts.Add(tr)
                                ShowRestrictionErrorMessage = True
                                'MessageList = New ArrayList
                                'MessageList.Add("THIS TRAIN HAS ONE OR MORE UNDELIVERED CAR RESTRICTION(s)")
                                'MessageList.Add("THAT NEEDS DELIVERED BEFORE AUTHORITY ISSUANCE.")
                                'ShowCustomMessageBox(MessageList, "TRAIN TGBO VALIDATION", False, LPoint, False, True, Owner)
                                'Return True
                            End If
                        End If
                    Next
                End If
                If ShowRestrictionErrorMessage Then
                    Try
                        Dim StrRestriction As New StringBuilder("CheckForUndeliveredRestriction: ")
                        If RestrictionConflicts IsNot Nothing AndAlso RestrictionConflicts.Count > 0 Then
                            For Each tr In RestrictionConflicts
                                With StrRestriction
                                    .Append(tr.myCarUID & " - " & tr.myUID & " - " & tr.myDescription & vbCrLf)
                                End With
                            Next
                        Else
                            StrRestriction.Append("ERROR HAS NO RESTICTIONS ")
                        End If
                        TrainEventLog(Me.Name & " HAS THESE RESTRICTIONS " & vbCrLf & StrRestriction.ToString)
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    End Try

                    MessageList = New ArrayList
                    MessageList.Add("THIS TRAIN HAS ONE OR MORE UNDELIVERED CAR RESTRICTION(s)")
                    MessageList.Add("THAT NEEDS DELIVERED BEFORE AUTHORITY ISSUANCE.")
                    ShowCustomMessageBox(MessageList, "TRAIN TGBO VALIDATION", False, LPoint, False, True, Owner)
                    Return True
                End If


                If HasWorkTask Then
                    For Each WT In Me.myWorkTaskList
                        If WT IsNot Nothing Then
                            Select Case WT.TaskType.ToUpper.Trim
                                Case "TRAIN-RESTRICTION-ADDED"
                                    TrainEventLog("TRAIN[" & Me.Name & "] HAS WORKTASK RESTRICTION ADDED " & WT.TaskData)
                                    MessageList = New ArrayList
                                    MessageList.Add("THIS TRAIN HAS ONE OR MORE CAR RESTRICTION(s) ADDED")
                                    MessageList.Add("THAT NEEDS TO BE ACCEPTED OR REJECTED BEFORE AUTHORITY ISSUANCE.")
                                    ShowCustomMessageBox(MessageList, "TRAIN TGBO VALIDATION", False, LPoint, False, True, Owner)
                                    Return True
                            End Select
                        End If
                    Next
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                tr = Nothing
                MessageList = Nothing
            End Try
        End Function

        Public Function CheckForRestrictionStatusOnPostion(ByVal LPoint As Object, ByVal Owner As Object) As Boolean
            Dim tr As TrainRestriction = Nothing
            Dim WT As WorkTask = Nothing
            Dim MessageList As New ArrayList()
            Dim HasCarRestriction As Boolean
            Dim HasWorkTask As Boolean
            Dim CurrentActiveFormCBullettins As New ArrayList
            Dim CurrentActiveBullettins As New ArrayList
            Dim myTGBO As TabularGeneralBulletin
            Dim FormCCreated As Boolean = False
            Dim AlertMessage As String = "UNDELIVERED FORM C RESTRICTION RECEIVED FOR (" & Me.Name & "). PLEASE VERIFY"
            Try
                DoRestrictionRefresh()
                myTGBO = TMDS.SystemUtilities.FetchData.FindTGBOByTrainSymbol(Me.Name)
                If myTGBO Is Nothing Then Return False
                If Me.myRestrictionList IsNot Nothing AndAlso Me.myRestrictionList.Count > 0 Then HasCarRestriction = True
                If Me.myWorkTaskList IsNot Nothing AndAlso Me.myWorkTaskList.Count > 0 Then HasWorkTask = True
                If LPoint Is Nothing Then
                    LPoint = New Point(Me.myTrack.CurrentDrawingForm.Left + Me.myTrack.CurrentDrawingForm.Width / 2 - 100, 150)
                ElseIf LPoint.GetType.ToString <> "System.Drawing.Point" Then
                    LPoint = New Point(Me.myTrack.CurrentDrawingForm.Left + Me.myTrack.CurrentDrawingForm.Width / 2 - 100, 150)
                End If

                If HasCarRestriction Then
                    For Each tr In Me.myRestrictionList
                        If tr IsNot Nothing Then
                            If tr.myBulletinGUID Is Nothing Then
                                If Not CurrentActiveFormCBullettins.Contains(tr) Then CurrentActiveFormCBullettins.Add(tr)
                            ElseIf String.IsNullOrEmpty(tr.myBulletinGUID) OrElse tr.myBulletinGUID.Trim = String.Empty Then
                                If Not CurrentActiveFormCBullettins.Contains(tr) Then CurrentActiveFormCBullettins.Add(tr)
                            End If
                        End If
                    Next
                End If
                If CurrentActiveFormCBullettins IsNot Nothing AndAlso CurrentActiveFormCBullettins.Count > 0 Then
                    For Each tr In CurrentActiveFormCBullettins
                        tr.CreateBulletin(Me)
                        'FormCCreated = True
                        AlertMessage = "UNDELIVERED FORM C RESTRICTION RECEIVED FOR (" & Me.Name & ")(" & tr.myCarUID & "). PLEASE VERIFY"
                        If optEnableARRCSpecificOptions Then
                            If Not TMDS.SystemUtilities.Utilities.CheckForAlertExtistenceByAlertData(AlertMessage) Then
                                Dim al As Alert = TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.Bulletin_FormC, AlertMessage, Me)
                            End If
                        End If
                    Next
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                tr = Nothing
                MessageList = Nothing
            End Try
        End Function

        Public Function ClearRestrictionFromDB() As Boolean
            Dim SQLQueryList As New ArrayList
            Try
                Dim theMove As New StringBuilder("INSERT INTO tblTrainEventInActiveRestrictions  SELECT * FROM tblTrainEventActiveRestrictions WHERE (EntityGUID ='" & Me.TrainGUID & "' OR EntityUID='" & Me.EntityUID & "')")
                Dim theDelete As New StringBuilder("DELETE FROM tblTrainEventActiveRestrictions WHERE (EntityGUID ='" & Me.TrainGUID & "' OR EntityUID='" & Me.EntityUID & "')")
                With SQLQueryList
                    .Add(theMove.ToString)
                    .Add(theDelete.ToString)
                End With
                If Not ExecuteQueryCollection(SQLQueryList, gConnectionStringTrain) Then Return False
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False
        End Function

        Private Sub DoRestrictionRefresh()
            Try
                If LastRestrictionRefreshAt < Now.AddMinutes(-3) Then
                    PerformTrainRestrictions(True)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

