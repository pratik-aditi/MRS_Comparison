            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub ScheduleTimerElapsedEvent(ByVal source As Object, ByVal e As ElapsedEventArgs)
            Try
                If optEnableTrainScheduleFunctions AndAlso gInitialized Then
                    If Not pInitalProcessingSchedulerDone Then
                        ProcessTrainSchedule()
                    Else
                        DoSchedulerProcess()
                    End If
                End If
                If Not optEnableTrainScheduleFunctions Then Me.ScheduleTimer.Enabled = False
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Private Sub DoSchedulerProcess()
            If Not pInitalProcessingSchedulerDone Then Exit Sub
            If SchedulerTimeScanStarted Then Exit Sub
            Dim OkToRun As Boolean = False
            Dim RunInitalProcessCheck As Boolean = False
            Try
                SchedulerTimeScanStarted = True
                If LastTrainScheduleTimerCheck.ToShortDateString > "1/1/2001" Then
                    Dim TmSpan As TimeSpan
                    TmSpan = Now.Subtract(LastTrainScheduleTimerCheck)
                    If TmSpan.Minutes >= 1 Then
                        LastTrainScheduleTimerCheck = Now
                        OkToRun = True
                    Else
                        RunInitalProcessCheck = True
                    End If
                Else
                    LastTrainScheduleTimerCheck = Now
                    RunInitalProcessCheck = True
                End If
                If OkToRun Then
                    Me.ProcessTrainScheduleTimeCheck(True)
                    LastTrainScheduleTimerCheck = Now
                End If
                SchedulerTimeScanStarted = False
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
            End Try
        End Sub

        Public Function GetTrainMovementsForSchedule() As ArrayList
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim SQLQuery As String = " SELECT EventTimeStamp,EventType, EventLocation, [UID],EventTrackGUID FROM tblTrainEventActiveMovements WHERE  [EventType]='ON STATION' AND  TrainSheetUID = '" & Me.ActiveTrainSheetGUID & "' order by EventTimeStamp desc"
            Dim TEeventsLst As New ArrayList
            Try

                Using DbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        Dim strtime As String = ""
                        Dim strLoc As String = ""
                        Dim strEvt As String = ""
                        Dim EvtUID As String = ""
                        Dim EvtTrkUID As String = ""
                        Dim EvtCPName As String = ""
                        Dim EvtCPUID As String = ""

                        If Not dr.IsDBNull(0) Then
                            Dim dtOSTime As Date
                            If Date.TryParse(dr.GetDateTime(0), dtOSTime) Then
                                'strtime = Format(dtOSTime, "MM-dd-yyyy HH:mm:ss")
                                strtime = Format(dtOSTime, optSystemOSDateAndTimeString)
                            End If
                        End If
                        If Not dr.IsDBNull(1) Then strEvt = dr.GetValue(1)
                        If Not dr.IsDBNull(2) Then
                            If Not gOptUsePassengerStationForSchedule Then
                                Dim splt() As String = dr.GetValue(2).Split("|")
                                If splt.Length > 1 Then
                                    strLoc = splt(0)
                                Else
                                    Beep()
                                End If
                            Else
                                strLoc = dr.GetValue(2)
                            End If

                        End If
                        If Not dr.IsDBNull(3) Then EvtUID = dr.GetValue(3)
                        If Not dr.IsDBNull(4) Then EvtTrkUID = dr.GetValue(4)

                        Dim TE As New TrainMoveEvents
                        With TE
                            .UID = EvtUID
                            .EventType = strEvt
                            .EventCPName = strLoc
                            Date.TryParse(strtime, .Eventdate)
                            Integer.TryParse(EvtTrkUID, .EventTrack)
                        End With
                        If Not TEeventsLst.Contains(TE) Then TEeventsLst.Add(TE)
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return TEeventsLst
        End Function

