        Public Sub UpdateTrainUnits(ByVal CallingMethod As String, Optional ByVal ForceMISTransMission As Boolean = False)
            Try

                If CallingMethod.IndexOf("frmTrainConsist.btnOK") >= 0 And Me.OLength = 0 Then
                    TrainEventLog("UpdateTrainUnits:NewSymbolFound:" & CallingMethod)
                    Exit Sub
                Else
                    TrainEventLog("UpdateTrainUnits:Others:" & CallingMethod)
                End If

                CheckForUnitChange()
                Me.GetTrainUnits()

                Dim tu As TrainUnit
                If optApplyTrainSheetConfigurationForCN Then
                    For Each tu In Me.UnitsInTrain
                        TMDS.NetworkMessages.CadMessages.SendTrainPowerChangeMessageCN(Me, tu, gCadTransmitQueue)
                    Next
                End If

                UpdateLocomotiveConsistStringInTrainSheet()

                CalculateHorsePowerPerTon()

                Me.PerformConsistDatabaseUpdatePTC()

                If optEnableARRCSpecificOptions Then
                    Me.RebuildLocomotiveConsistMISInfoString(ForceMISTransMission)
                End If
                Try
                    Me.myTrack.InvalidateTrainID()
                    Me.myTrack.InitTrainDisplay()
                    If Me.myTrack.InvokeRequired Then
                        Me.myTrack.Invoke(New MethodInvoker(AddressOf Me.myTrack.Refresh))
                    Else
                        Me.myTrack.Refresh()
                    End If
                Catch ex As Exception
                    GetErrorDetails(ex)
                End Try
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckForUnitChange()
            Try
                Dim tu As TrainUnit
                Dim extUnits As ArrayList = Me.UnitsInTrain.Clone
                Dim currunts As New ArrayList
                currunts = Me.Units.Clone
                currunts.Insert(0, Me.IdentifingUnit)

                If extUnits.Count > 0 Or currunts.Count > 0 Then
                    If extUnits.Count > 0 Then
                        Dim FirstUnit As TrainUnit = extUnits.Item(0)
                        If FirstUnit.UnitNumber <> Me.IdentifingUnit Then
                            Dim EventString As String = "LEAD UNIT CHANGED FROM " & FirstUnit.UnitNumber & " TO " & Me.IdentifingUnit
                            Me.AddTrainSheetEvent("UNIT CHANGE", Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, True)
                        End If
                    End If
                    Dim u As String = String.Empty
                    Dim utcnt As Integer = 0
                    For Each u In currunts
                        Try
                            utcnt = currunts.IndexOf(u) + 1
                            Dim UnitFound As Boolean
                            Dim FoundUnit As TrainUnit
                            Dim fntindx As Integer = 0
                            For Each tu In extUnits
                                If tu.UnitNumber = u Then
                                    UnitFound = True
                                    FoundUnit = tu
                                    fntindx = Me.UnitsInTrain.IndexOf(tu) + 1
                                    Exit For
                                End If
                            Next
                            If UnitFound Then
                                If utcnt <> fntindx Then
                                    Dim EventString As String = "UNIT POSITION CHANGED FROM " & fntindx & " TO " & utcnt & " FOR " & u
                                    Dim Zone As String = "C"
                                    If Not IsNothing(Me.myTrack) Then
                                        Zone = Mid(Me.myTrack.TimeZone, 1, 1)
                                    End If
                                    Dim CPUID As String = "NONE"
                                    If Not IsNothing(Me.myTrack.myControlPoint) Then
                                        CPUID = Me.myTrack.myControlPoint.GUID.ToString
                                    End If
                                    Me.AddTrainSheetEvent("UNIT CHANGE", Now, Zone, EventString, CPUID, Me.GetIdentifyingLocationNameFromLimits, True)
                                End If
                                UnitFound = False
                                FoundUnit = Nothing
                            Else
                                Dim EventString As String = "UNIT ADDED: " & u & " IN POSITION " & utcnt
                                Me.AddTrainSheetEvent("UNIT CHANGE", Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, True)
                                If optApplyTrainSheetConfigurationForARRC Then
                                    ResetUnitStatusInDB(u, "R")
                                End If


                            End If
                        Catch ex As Exception
                            SystemException(ex.ToString)
                        End Try
                    Next

                    For Each tu In extUnits
                        If Not IsNothing(tu) Then
                            If Not currunts.Contains(tu.UnitNumber) Then
                                Dim EventString As String = "UNIT REMOVED: " & tu.UnitNumber
                                Dim Zone As String = "C"
                                If Not IsNothing(Me.myTrack) Then
                                    Zone = Mid(Me.myTrack.TimeZone, 1, 1)
                                End If
                                Dim CPUID As String = "NONE"
                                If Not IsNothing(Me.myTrack.myControlPoint) Then
                                    CPUID = Me.myTrack.myControlPoint.GUID.ToString
                                End If
                                Me.AddTrainSheetEvent("UNIT CHANGE", Now, Zone, EventString, CPUID, Me.GetIdentifyingLocationNameFromLimits, True)
                            Else
                                TrainEventLog("CheckForUnitChange:UNIT NOT FOUND IN LIST")
                            End If
                        End If
                    Next
                Else
                    Dim EventString As String = "LEAD UNIT ADDED AS " & Me.IdentifingUnit
                    Me.AddTrainSheetEvent("UNIT CHANGE", Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, True)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Get train units
        ''' </summary>
        Public Sub GetTrainUnits()
            Dim dbConnStatic As OleDbConnection = Nothing
            Dim dbCommStatic As OleDbCommand = Nothing
            Dim drStatic As OleDbDataReader = Nothing
            Dim dbConnDynamic As OleDbConnection = Nothing
            Dim dbCommDynamic As OleDbCommand = Nothing
            Dim drDynamic As OleDbDataReader = Nothing
            Dim query As String = String.Empty
            Dim untPosition As Integer
            Dim tempIdUnit As ArrayList
            Dim newUnit As TrainUnit
            Try
                SyncLock GetTrainUnitsThreadBlock
                    TrainEventLog("GetTrainUnits:Start")
                    tempIdUnit = Me.Units.Clone
                    tempIdUnit.Insert(0, Me.IdentifingUnit)
                    Me.UnitsInTrain.Clear()
                    dbConnStatic = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                    dbConnStatic.Open()
                    dbConnDynamic = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                    dbConnDynamic.Open()
                    untPosition = 0
                    For Each u As String In tempIdUnit
                        If u <> "" Then
                            If Not DoesUnitExist(u) Then
                                TrainEventLog("GetTrainUnits:Unit=" & u)
                                untPosition = untPosition + 1
                                newUnit = New TrainUnit
                                newUnit.UnitNumber = u
                                query = "SELECT HorsePower, EffectiveHP, DPEnabled, Direction, GPSEquipped, Status, UnitPosition, Isolated, Length, Weight, NumOfAxles, [UnitCondition] FROM tblSystemLocomotives WHERE UID = '" & u & "'"
                                dbCommStatic = New OleDbCommand(query, dbConnStatic)
                                drStatic = dbCommStatic.ExecuteReader
                                While drStatic.Read
                                    If Not drStatic.IsDBNull(0) Then
                                        newUnit.TotalHP = drStatic.GetInt32(0)
                                    End If
                                    If Not drStatic.IsDBNull(1) Then
                                        newUnit.EffectiveHP = drStatic.GetInt32(1)
                                    End If
                                    If Not drStatic.IsDBNull(2) Then
                                        newUnit.DPCapable = drStatic.GetBoolean(2)
                                    End If
                                    If Not drStatic.IsDBNull(4) Then
                                        newUnit.GPSCapable = drStatic.GetBoolean(4)
                                    End If
                                    If Not drStatic.IsDBNull(5) Then
                                        newUnit.Status = drStatic.GetString(5)
                                    End If
                                    If optEnableARRCSpecificOptions OrElse optEnableSpecificOptionsForFECR OrElse optEnableMRSSpecificPTCOperations Then
                                        'ARRC USES POSITION FOR MIS.
                                        'wont use the vales from locomotive table anymore. these are stored with the train sheet now
                                        If Not drStatic.IsDBNull(3) Then
                                            newUnit.Direction = drStatic.GetString(3)
                                        End If
                                        'wont use the vales from locomotive table anymore. these are stored with the train sheet now
                                        If Not drStatic.IsDBNull(6) Then
                                            newUnit.UnitPosition = drStatic.GetInt32(6)
                                        End If
                                        If Not drStatic.IsDBNull(7) Then
                                            newUnit.Isolated = drStatic.GetBoolean(7)
                                        End If
                                    End If
                                    If Not drStatic.IsDBNull(8) Then
                                        newUnit.Length = drStatic.GetInt32(8)
                                    End If
                                    If Not drStatic.IsDBNull(9) Then
                                        newUnit.Weight = drStatic.GetInt32(9)
                                    End If
                                    If Not drStatic.IsDBNull(10) Then
                                        newUnit.NumOfAxles = drStatic.GetInt32(10)
                                    End If
                                    If Not drStatic.IsDBNull(11) Then
                                        newUnit.thisUnitCondition = drStatic.GetInt32(11)
                                    End If
                                End While
                                If Not drStatic.HasRows Then
                                    newUnit.UnitPosition = untPosition
                                End If
                                Me.UnitsInTrain.Add(newUnit)
                            End If
                        End If
                    Next
                    query = "SELECT LocoConsistData FROM tblTrainsActive WHERE Symbol = '" & Me.Name & "'"
                    dbCommDynamic = New OleDbCommand(query, dbConnDynamic)
                    drDynamic = dbCommDynamic.ExecuteReader
                    While drDynamic.Read
                        If Not drDynamic.IsDBNull(0) Then
                            TrainEventLog("GetTrainUnits:LocoConsistData=" & drDynamic.GetString(0).ToString)
                            Dim units() As String = drDynamic.GetString(0).Split(";")
                            For Each ut As String In units
                                Dim data() As String = ut.Split("|")
                                'data = unit number|T-horsepower|E-horsepower|Status|Direction|Position
                                Dim UnitNumber As String = data(0)
                                Dim TotalHP As Integer : If IsNumeric(data(1)) Then TotalHP = CInt(data(1))
                                Dim EffHP As Integer : If IsNumeric(data(2)) Then EffHP = CInt(data(2))
                                Dim Status As String = data(3)
                                Dim Direction As String = data(4)
                                Dim Position As Integer : If IsNumeric(data(5)) Then Position = CInt(data(5))
                                For Each t As TrainUnit In Me.UnitsInTrain
                                    If t.UnitNumber = UnitNumber Then
                                        If TotalHP <> 0 Then t.TotalHP = TotalHP
                                        If EffHP <> 0 Then t.EffectiveHP = EffHP
                                        If Not String.IsNullOrEmpty(Trim(Status)) Then t.Status = Status
                                        If Not String.IsNullOrEmpty(Trim(Direction)) Then t.Direction = Direction
                                        If Position <> 0 Then t.UnitPosition = Position
                                    End If
                                Next
                            Next
                        End If
                    End While
                    If Not optEnableMetroLinkSpecificOptions Then Me.UpdateLocomotiveConsistStringInTrainSheet()
                    drStatic.Close()
                    dbConnStatic.Close()
                    drDynamic.Close()
                    dbConnDynamic.Close()
                    TrainEventLog("GetTrainUnits:End")
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If dbCommStatic IsNot Nothing Then dbCommStatic.Dispose()
                If dbConnStatic IsNot Nothing Then dbConnStatic.Dispose()
                If dbCommDynamic IsNot Nothing Then dbCommDynamic.Dispose()
                If dbConnDynamic IsNot Nothing Then dbConnDynamic.Dispose()
                dbCommStatic = Nothing
                dbConnStatic = Nothing
                drStatic = Nothing
                dbCommDynamic = Nothing
                dbConnDynamic = Nothing
                drDynamic = Nothing
                query = Nothing
                untPosition = Nothing
                tempIdUnit = Nothing
                newUnit = Nothing
            End Try
        End Sub




        Private Function DoesUnitExist(ByVal UnitID As String) As Boolean
