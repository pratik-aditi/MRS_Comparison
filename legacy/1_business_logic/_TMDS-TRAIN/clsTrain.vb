        Public Function LoadTrainSchedules(Optional ByVal ForceRefreshCommand As Boolean = False) As Boolean
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Try
                If Me Is Nothing Then Return False
                'Dim SQLQuery As String = "SELECT * FROM tblTrainPlanSchedule WHERE TrainSymbol='" & Me.Name & "' and Direction='" & Me.Direction & "' ORDER BY StationScheduleIndex"
                Dim SQLQuery As String = "SELECT * FROM tblTrainPlanSchedule WHERE TrainSymbol='" & Me.Name & "' ORDER BY StationScheduleIndex"
                If optEnableARRCSpecificOptions Then
                    SQLQuery = "SELECT * FROM tblTrainPlanSchedule WHERE TrainSymbol='" & Me.Name & "' AND TrainGUID='" & Me.TrainGUID & "' ORDER BY StationScheduleIndex"
                ElseIf optEnableMetroLinkSpecificOptions Then
                    Dim Name() As String = Me.Name.Split(" ")
                    Dim Symbol As String = Name(0)
                    SQLQuery = "SELECT * FROM tblTrainPlanSchedule WHERE TrainSymbol='" & Symbol & "' ORDER BY StationScheduleIndex"
                End If
                Me.myScheduleList.Clear()
                Using DbConn As New OleDbConnection(gConnectionStringStatic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        Dim TrainSch As New TrainSchedule
                        Dim OkToAddSch As Boolean = True

                        If optEnableMetroLinkSpecificOptions Then
                            If dr.IsDBNull(7) AndAlso dr.IsDBNull(8) Then
                                TrainEventLog("Ignoring Schedule UID: " & dr.GetString(0))
                                OkToAddSch = False
                            End If

                        End If
                        If OkToAddSch Then
                            With TrainSch
                                .myTrain = Me
                                If Not dr.IsDBNull(0) Then .myUID = dr.GetString(0)
                                If Not dr.IsDBNull(1) Then .myTrainSymbol = dr.GetString(1)
                                If Not dr.IsDBNull(2) Then .myDirection = dr.GetString(2)
                                If Not dr.IsDBNull(3) Then .myCategory = dr.GetString(3)

                                If Not dr.IsDBNull(4) Then .myStationName = dr.GetString(4).Trim.ToUpper
                                If Not dr.IsDBNull(5) Then .myStationUID = dr.GetString(5)
                                If Not dr.IsDBNull(6) Then .myStationScheduleIndex = dr.GetValue(6) ' Convert.ToInt32(dr.GetByte(6))
                                If Not dr.IsDBNull(7) Then .myStationArrivalTime = dr.GetDateTime(7)

                                If Not dr.IsDBNull(8) Then .myStationDepartureTime = dr.GetDateTime(8)
                                If Not dr.IsDBNull(9) Then .myStationArrivalTrackName = dr.GetString(9)
                                If Not dr.IsDBNull(10) Then .myStationDepartureTrackName = dr.GetString(10)
                                If Not dr.IsDBNull(11) Then .myStationArrivalTrackUID = dr.GetInt32(11)

                                If Not dr.IsDBNull(12) Then .myStationDepartureTrackUID = dr.GetInt32(12)
                                If Not dr.IsDBNull(13) Then .myScheduleDependecyType = dr.GetString(13)
                                If Not dr.IsDBNull(14) Then .myScheduleDependencyData = dr.GetString(14)

                                If dr.FieldCount >= 19 Then
                                    If Not dr.IsDBNull(18) Then .CrewChangeLocation = dr.GetBoolean(18)
                                    If Not dr.IsDBNull(17) Then .WorkEventLocation = dr.GetBoolean(17)
                                End If

                                If dr.IsDBNull(7) AndAlso Not dr.IsDBNull(8) Then .IgnoreDeviationCalculation = True
                                If Not optEnableDenverSpecificOptions AndAlso Not dr.IsDBNull(7) AndAlso dr.IsDBNull(8) Then .IgnoreDeviationCalculation = True

                                'ShowAlert
                                If dr.FieldCount >= 20 Then
                                    Dim bAlert As Boolean = False
                                    If Not dr.IsDBNull(19) Then
                                        Boolean.TryParse(dr.GetBoolean(19), bAlert)
                                    End If
                                    .ShowAlert = bAlert
                                End If
                                If dr.FieldCount >= 21 Then
                                    Dim IsForeignRoadStation As Boolean = False
                                    If Not dr.IsDBNull(20) Then
                                        Boolean.TryParse(dr.GetValue(20), IsForeignRoadStation)
                                    End If
                                    .IsForeignRoadStation = IsForeignRoadStation
                                    If .IsForeignRoadStation Then
                                        Me.IsOperatingOnForiegnRoads = True
                                    End If
                                End If

                            End With
                            If Me.myScheduleList Is Nothing Then Me.myScheduleList = New ArrayList
                            If Not Me.myScheduleList.Contains(TrainSch) Then Me.myScheduleList.Add(TrainSch)
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
                If optEnableTrainScheduleFunctions Then
                    If gOptUsePassengerStationForSchedule Then
                        'UpdateTrainSchedules_PsgrInitialLoad()
                        UpdateTrainSchedules_PsgrInitialLoadOS()
                    Else
                        UpdateTrainSchedulesInitialLoad()
                        UpdateTrainSchedulesInitialLoadOS()
                        If optShowTrainScheduleColor AndAlso Not IsNothing(Me.myTrack) Then
                            Me.myTrack.InitTrainDisplay()
                        End If
                    End If

                    If Me.myScheduleList IsNot Nothing AndAlso Me.myScheduleList.Count > 0 Then Me.ScheduleTimer.Enabled = True
                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Function

        Private Sub UpdateTrainSchedulesInitialLoad()
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim TrainSch As TrainSchedule = Nothing
            Dim ScheduleUID As String = ""
            Dim strRptData As String = ""
            Dim ProcessedTime As Date
            Dim Delay As Integer = 0
            Try
                If Me.myScheduleList Is Nothing Then Exit Sub
                If Me.myScheduleList.Count = 0 Then Exit Sub
                Dim SQLQuery As String = "SELECT * FROM tblTrainEventActiveDelays WHERE EventDelayCode='TPD' AND TrainSheetUID='" & Me.ActiveTrainSheetGUID & "' ORDER BY EventTimeStamp"
                Using DbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        ScheduleUID = ""
                        strRptData = ""
                        Delay = 0
                        'strRptData = 
                        If Not dr.IsDBNull(12) Then
                            Dim RptData() As String
                            strRptData = dr.GetString(12)
                            RptData = strRptData.Split("|")
                            ScheduleUID = RptData(0)
                            If Not dr.IsDBNull(4) Then ProcessedTime = dr.GetDateTime(4)
                            If Not dr.IsDBNull(10) Then Delay = dr.GetInt32(10)
                            If Not dr.IsDBNull(9) Then Me.Schedule_LastDelayEvent = "LATE BY " & Delay & "(MINS) - " & dr.GetString(9)

                            For Each TrainSch In Me.myScheduleList
                                If TrainSch.myUID = ScheduleUID Then
                                    TrainSch.myScheduleProcessed = True
                                    TrainSch.myScheduleStatus = "LATE"
                                    TrainSch.myScheduleMinutesLate = Delay
                                    TrainSch.myScheduleProcessedTimeStamp = ProcessedTime
                                    If Not dr.IsDBNull(9) Then Me.Schedule_LastDelayEvent = "LATE BY " & Delay & "(MINS) (" & TrainSch.myStationName & ") - " & dr.GetString(9)
                                    Exit For
                                End If
                            Next
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Sub

        Private Sub UpdateTrainSchedulesInitialLoadOS()
            Dim TrainSch As TrainSchedule = Nothing
            Dim ScheduleUID As String = ""
            Dim strRptData As String = ""

            Dim Delay As Integer = 0

            Dim dtSCH As New DataTable
            Dim str As String = ""
            Dim MyStatlst As New ArrayList
            Try
                If Me.myScheduleList Is Nothing Then Exit Sub
                If Me.myScheduleList.Count = 0 Then Exit Sub
                Dim te As TrainMoveEvents
                Dim TEeventsLst As New ArrayList
                TEeventsLst = GetTrainMovementsForSchedule()
                If TEeventsLst IsNot Nothing AndAlso TEeventsLst.Count > 0 Then
                    For Each te In TEeventsLst
                        Dim OSTime As Date = te.Eventdate
                        Dim TrackGUID As Integer = te.EventTrack
                        Dim myOsTrack As Track = Nothing
                        Dim OSDate As Date = OSTime.ToShortDateString
                        MyStatlst = New ArrayList
                        If TrackGUID > 0 Then
                            myOsTrack = FindCompFromGUID(TrackGUID)
                        End If
                        If myOsTrack IsNot Nothing Then
                            MyStatlst = TMDS.SystemUtilities.FetchData.FindSubdivisionStationsFromTrack(myOsTrack)
                        Else
                            MyStatlst = TMDS.SystemUtilities.FetchData.FetchSubdivisionStationsFromTrack_DB(TrackGUID)
                            If MyStatlst Is Nothing Then MyStatlst = New ArrayList
                        End If
                        Dim stat As SubdivisionStation
                        Dim ProcessCompleted As Boolean = False
                        For Each stat In MyStatlst
                            For Each TrainSch In Me.myScheduleList
                                If Not TrainSch.myScheduleProcessed AndAlso Not TrainSch.IgnoreDeviationCalculation AndAlso TrainSch.myStationName.Trim.ToUpper = stat.ReportingUID.Trim.ToUpper Then
                                    Dim strTimeIn As String = OSDate & " " & Format(TrainSch.myStationArrivalTime, "HH:mm:ss")
                                    Dim myTimeIn As Date
                                    If Date.TryParse(strTimeIn, myTimeIn) Then
                                        Dim tmSpan As TimeSpan
                                        tmSpan = OSTime.Subtract(myTimeIn)
                                        If tmSpan.TotalMinutes >= (System.Math.Abs(gDelayTolerance) - 0.1) Then
                                            TrainSch.myScheduleProcessed = True
                                            TrainSch.myScheduleStatus = "LATE"
                                            TrainSch.myScheduleMinutesLate = tmSpan.TotalMinutes
                                            TrainSch.myScheduleProcessedTimeStamp = myTimeIn
                                            ProcessCompleted = True
                                            Exit For
                                        Else
                                            TrainSch.myScheduleProcessed = True
                                            TrainSch.myScheduleStatus = "EARLY"
                                            TrainSch.myScheduleMinutesLate = tmSpan.TotalMinutes
                                            TrainSch.myScheduleProcessedTimeStamp = myTimeIn
                                            ProcessCompleted = True
                                            Exit For
                                        End If
                                    End If
                                End If
                            Next
                            If ProcessCompleted Then Exit For
                        Next
                    Next
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally

            End Try
        End Sub

