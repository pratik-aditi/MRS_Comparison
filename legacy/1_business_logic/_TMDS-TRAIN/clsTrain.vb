                If Me.IdentifingUnit = "" OrElse Me.NumberOfAxles = 0 OrElse Me.NumberOperatingBrakes = 0 OrElse Me.OLength = 0 OrElse Me.OTons = 0 OrElse (Me.OEmts = 0 AndAlso Me.OLoads = 0) Then
