#Region "AUTO CANCEL"

        ''' <summary>
        ''' Check Auto Signal Cancellation
        ''' </summary>
        Public Sub CheckAutoSignalCancellation()
            Try
                For Each route As TacticalRoute In myTacticalRoutes
                    If Not myTacticalRoutesToRemove.Contains(route) AndAlso
                        route.mySignalRoute IsNot Nothing Then
                        If route.mySignalRoute.EntryTrack.IsTrackWarrantEnforcementEnabled AndAlso
                            route.mySignalRoute.EntrySignal.myControlPoint.Initialized AndAlso
                            route.mySignalRoute.EntrySignal.SignalIndStatus <> Signal.IndStatus.Cleared AndAlso
                            route.myStatus.Equals("CLEARED") AndAlso
                            Not route.mySignalRoute.EntrySignal.AutomaticSignal Then
                            If route.mySignalRoute.EntrySignal.IndicationStatusUpdateTimeStamp < Now.AddSeconds(-15) Then
                                'If OS track occupied the front, it isn't necessary auto cancel
                                If route.mySignalRoute.EntrySignal.SlottingOSTrack IsNot Nothing AndAlso
                                                    route.mySignalRoute.EntrySignal.SlottingOSTrack.Occuppied Then
                                    TrainEventLog($"{GetCurrentMethod.Name _
                                                  }:OSTrack={route.mySignalRoute.EntrySignal.SlottingOSTrack.Name _
                                                  }:Occuppied={route.mySignalRoute.EntrySignal.SlottingOSTrack.Occuppied}")
                                    Continue For
                                End If
                                TrainEventLog($"{GetCurrentMethod.Name _
                                              }:UpdateTimeStamp={route.mySignalRoute.EntrySignal.IndicationStatusUpdateTimeStamp.ToString("dd/MM/yy HH:mm:ss.fff") _
                                              }:SignalIndStatus={route.mySignalRoute.EntrySignal.SignalIndStatus _
                                              }:myStatus={route.myStatus _
                                              }:EntrySignal={route.mySignalRoute.EntrySignal.Name}:AUTO-CANCEL-FROM-SIGNAL-STOP")
                                PtcCancelNormalLicense(route.mySignalRoute.EntrySignal, True)
                            End If
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

