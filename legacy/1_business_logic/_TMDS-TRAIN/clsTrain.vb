#Region "MOVEMENT PLANNING"

        Public Sub StopAutoRouteCheck()
            Try
                AutoRouteCheckStop = True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub StartAutoRouteCheck()
            Try
                AutoRouteCheckStop = False
                AutoRouteCheckThread = New Threading.Thread(AddressOf DoAutoRouteCheck)
                AutoRouteCheckThread.Start()
                TrainEventLog("NEW THREAD-AutoRouteCheckThread")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub DoAutoRouteCheck()
            Try
                Do
                    If AutoRouteCheckStop Then Exit Sub
                    Threading.Thread.Sleep(15000)
                    Dim StartingSignal As Signal = FindStartingSignal()
                    If Me.myTacticalRoutes.Count = 0 Then
                        If Not IsNothing(StartingSignal) Then
                            PublishTrainAutoRouteTriggerEvent(StartingSignal.GUID.ToString)
                        End If
                    Else
                    End If
                Loop
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub TriggerAutoRoutingEvent(ByVal OriginOfCommand As String, Optional ByVal ForceTrigger As Boolean = False)
            Try
                TrainEventLog("AUTO-ROUTING TRIGGER HAS BEEN EXECUTED ACCOUNT " & OriginOfCommand & " FOR TRAIN <" & Me.Name & ">")
                If Me.myTrack.myTerritory.AllowMovementPlanning And (Me.AutomaticModeOn Or ForceTrigger) Then
                    Dim StartingSignal As Signal = FindStartingSignal()
                    If IsNothing(StartingSignal) Then
                        TrainEventLog("STARTING SIGNAL NOT FOUND. AUTO-ROUTING HAS BEEN DISABLED FOR TRAIN <" & Me.Name & ">")
                    Else
                        If StartingSignal.AutomaticModeOn Then
                            Me.RemoveAllTacticalRoutesFromDatabase()
                            Me.RemoveTacticalRoutes()
                            Me.LastAutoRouteExecutionFailure = ""
                            PublishTrainAutoRouteTriggerEvent(StartingSignal.GUID.ToString)
                        Else
                            TrainEventLog("AUTO-ROUTING NOT ENABLED FOR SIGNAL <" & StartingSignal.GUID.ToString & ">")
                        End If
                    End If
                Else
                    TrainEventLog("AUTO-ROUTING NOT ENABLED FOR TRAIN <" & Me.Name & ">")
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        'ARS-177
        Public Sub TrainClearAllRoutes()
            Try
                TrainEventLog("AUTO-ROUTING CLEAR PLAN HAS BEEN EXECUTED FOR TRAIN <" & Me.Name & ">")
                If Me.myTrack.myTerritory.AllowMovementPlanning Then
                    Dim StartingSignal As Signal = FindStartingSignal()
                    If IsNothing(StartingSignal) Then
                        TrainEventLog("STARTING SIGNAL NOT FOUND. AUTO-ROUTING HAS BEEN DISABLED FOR TRAIN <" & Me.Name & ">")
                    Else
                        If StartingSignal.AutomaticModeOn Then
                            Me.RemoveAllTacticalRoutesFromDatabase()
                            Me.RemoveTacticalRoutes()
                            Me.LastAutoRouteExecutionFailure = ""
                            PublishTrainAutoRouteTriggerEvent(StartingSignal.GUID.ToString)
                        Else
                            TrainEventLog("AUTO-ROUTING NOT ENABLED FOR SIGNAL <" & StartingSignal.GUID.ToString & ">")
                        End If
                    End If
                Else
                    TrainEventLog("AUTO-ROUTING NOT ENABLED FOR TRAIN <" & Me.Name & ">")
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub ToggleAutoRouting(ByVal AutoOn As Boolean, ByVal OriginOfCommand As String)
            Try
                If Me.myTrack.myTerritory.AllowMovementPlanning Then
                    Dim StartingSignal As Signal = FindStartingSignal()
                    If Not IsNothing(StartingSignal) Then
                        If Not StartingSignal.myControlPoint.AutomaticModeOn AndAlso AutoOn Then
                            Dim frmMessageBox As frmMessageBox
                            Dim MessageList As New ArrayList()
                            MessageList.Add("STARTING SIGNAL CONTROL POINT NOT IN AUTOMATIC MODE.")
                            MessageList.Add("")
                            frmMessageBox = New frmMessageBox()

                            Dim Location As Point = New Point(Me.myTrack.CurrentDrawingForm.Left + 300, myTrack.CurrentDrawingForm.Top + 400)
                            frmMessageBox.SetMessage(MessageList, "AUTOMATIC MODE CHECK", False, Location)
                            frmMessageBox.TopMost = True
                            frmMessageBox.Owner = Me.myTrack.CurrentDrawingForm
                            frmMessageBox.ShowDialog()
                            frmMessageBox.Dispose()
                            frmMessageBox = Nothing
                            Exit Sub
                        End If
                    End If

                    Dim KeyWord As String = "DISABLED"
                    If optOverrideSystemTrainAutomaticDisabling Then
                        If Not AutoOn Then
                            Select Case OriginOfCommand
                                Case "COMMAND", "MENU", "MAIN MENU"
                                Case Else
                                    TrainEventLog("AUTO-ROUTING OFF MODE HAS BEEN DISABLED.")
                                    Exit Sub
                            End Select
                        End If
                    End If

                    Me.AutomaticModeOn = AutoOn
                    Me.LastAutoRouteExecutionFailure = ""
                    If AutoOn Then KeyWord = "ENABLED"
                    Dim trnUpdate As String = "UPDATE tblTrainsActive SET AutomaticModeOn = " & CInt(AutoOn) & " WHERE Symbol = '" & Me.Name & "'"
                    SystemDatabaseCommandToDynamicTrain("TRAIN:ToggleAutoRouting", trnUpdate)
                    TrainEventLog("AUTO-ROUTING HAS BEEN " & KeyWord & " FROM THE " & OriginOfCommand & " FOR TRAIN <" & Me.Name & ">")
                    Me.myTrack.InitTrainDisplay()
                    Me.myTrack.InvalidateTrainID()
                    If AutoOn Then
                        If Mid(Me.myTrack.AuthorityType, 1, 3) = "TWC" Then
                            PublishTrainAutoRouteEvent(AutoOn, Me.myTrack.GUID.ToString)
                        Else
                            If IsNothing(StartingSignal) Then
                                TrainEventLog("STARTING SIGNAL NOT FOUND. AUTO-ROUTING HAS BEEN DISABLED FOR TRAIN <" & Me.Name & ">")
                            Else
                                PublishTrainAutoRouteEvent(AutoOn, StartingSignal.GUID.ToString)
                                StartAutoRouteCheck()
                            End If
                        End If
                    Else
                        StopAutoRouteCheck()
                        PublishTrainAutoRouteEvent(AutoOn, "NONE")
                        RemoveAllTacticalRoutesFromDatabase()
                        RemoveTacticalRoutes()
                        LastAutoRouteExecutionFailure = ""
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub PublishTrainAutoRouteEvent(ByVal AutoRouting As Boolean, ByVal StartingSignalUID As String)
            Try
                Dim Message As New System.Text.StringBuilder
                Message.Append("DC" & Chr(6) & "AUTOROUTEEVENT;TRAIN;")
                Message.Append("|" & Me.myTrack.TerritoryID.ToString)
                Message.Append("|" & Me.Name)
                Message.Append("|" & Me.myTrack.GUID.ToString)
                Message.Append("|" & StartingSignalUID)

                If AutoRouting Then
