#Region "SIMULATION METHODS"

        Sub StartSimulator()
            Try
                SimulateMode = True
                StartSimulation = True
                If gSimulationMode Then
                    Dim TrnTrack As Track
                    TrnTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.TrackGUID)

                    'Dim TrafficDirection As String = "RIGHTBOUND"
                    If optEnableDirectionBindNorthToEastAndSouthToWest Then
                        Select Case Me.Direction
                            Case optDirectionSouth, optDirectionWest
                                SimulatedTrafficDirection = LeftBound
                        End Select
                    Else
                        Select Case Me.Direction
                            Case optDirectionNorth, optDirectionEast
                                SimulatedTrafficDirection = LeftBound
                        End Select
                    End If

                    Select Case SimulatedTrafficDirection

                        Case RightBound
                            If Not TrnTrack Is Nothing Then
                                'TrnTrack.Occuppied = True
                                If TrnTrack.Indicating Then
                                    TrnTrack.Ind(0).BitState = True
                                Else
                                    TrnTrack.Occuppied = True
                                End If
                                TrnTrack.TrafficDirection = "RIGHT"
                                TrnTrack.ApplyIndicationChange()
                                TrnTrack.UpdateStatus()
                            End If
                        Case LeftBound
                            If Not TrnTrack Is Nothing Then
                                If TrnTrack.Indicating Then
                                    TrnTrack.Ind(0).BitState = True
                                Else
                                    TrnTrack.Occuppied = True
                                End If
                                TrnTrack.TrafficDirection = "LEFT"
                                TrnTrack.ApplyIndicationChange()
                                TrnTrack.UpdateStatus()
                            End If
                    End Select
                End If

                SimulationThread = New Threading.Thread(AddressOf SimulationLoop)
                SimulationThread.Start()
                TrainEventLog("NEW THREAD-SimulationThread")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Sub TerminateSimulation()
            Try
                If Not gSimulationMode Then Exit Sub

                If Not gTrainerMode OrElse Not gSimulationModeARS OrElse Not gSimulationModeRealTimeControl Then Exit Sub
                If Not SimulationThread Is Nothing Then
                    StartSimulation = False
                    Try
                        SimulationThread.Abort()
                        SimulationThread = Nothing
                    Catch
                    End Try

                End If
                If Me.myTrack.Indicating Then
                    If Me.myTrack.OStype Then
                        Dim comp As Object
                        For Each comp In Me.myTrack.OsComponentCollection
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                comp.LossOfShuntTimer.Interval = 10000
                                comp.Ind(0).BitState = True
                                If comp.TrackIndicationANDED Or comp.TrackIndicationORED Then
                                    If Not IsNothing(comp.Ind(1)) Then
                                        comp.Ind(1).BitState = True
                                    End If
                                End If
                            End If
                        Next

                    Else
                        Me.myTrack.Ind(0).BitState = False
                        Me.myTrack.ApplyIndicationChange()
                        Me.myTrack.UpdateStatus()
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Sub SimulationLoop()
            Try
                Do While SimulationThread.ThreadState = Threading.ThreadState.Running And StartSimulation
                    Thread.Sleep(Me.SimulationSpeed)
                    SimulateMoveTrainID()
                Loop
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Sub SimulateMoveTrainID()
            Try
                Dim LoopControl As Integer
                Dim AuthorityToMoveFound As Boolean
                Dim PreviousTrack As Track = Nothing
                Dim CompToCheck As Object
                Dim CurrentTrack As Track = Me.FindTrackFromTrainID(Me.Name)

                If CurrentTrack Is Nothing Then Exit Sub



                If Me.SimulatedTrafficDirection = RightBound Then
                    CompToCheck = Me.FindObjectTypeFromGUID(CurrentTrack.RightLink)
                ElseIf Me.SimulatedTrafficDirection = LeftBound Then
                    CompToCheck = Me.FindObjectTypeFromGUID(CurrentTrack.LeftLink)
                Else
                    Exit Sub
                End If

                If CompToCheck Is Nothing Then Exit Sub

                While Not AuthorityToMoveFound
                    If CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If CurrentTrack.Name = CompToCheck.Name And CurrentTrack.StationNumber = CompToCheck.StationNumber Then
                            If Me.SimulatedTrafficDirection = RightBound Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RightLink)
                            ElseIf Me.SimulatedTrafficDirection = LeftBound Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftLink)
                            Else
                                Exit Sub
                            End If
                        Else
                            If Mid(CompToCheck.AuthorityType, 1, 3) = "TWC" Then
                                Dim trk As Track = Nothing
                                If CompToCheck.Authorities.Count > 0 Then
                                    Dim warr As Warrant = CompToCheck.Authorities(0)
                                    If warr Is Nothing Then Exit Sub
                                    If InStrRev(warr.IssueTo, Me.IdentifingUnit) <> 0 Then
                                        MoveTrainToNextTrack(CurrentTrack, CompToCheck, False)
                                        Exit Sub
                                    Else
                                        Exit Sub
                                    End If
                                Else
                                    Exit Sub
                                End If
                            Else
                                MoveTrainToNextTrack(CurrentTrack, CompToCheck, False)
                                Exit Sub
                            End If
                        End If

                    ElseIf CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        If CompToCheck.ControlledReverse Then
                            Select Case SimulatedTrafficDirection
                                Case RightBound
                                    If CompToCheck.RightAltLink <> 0 Then
                                        CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RightAltLink)
                                    ElseIf CompToCheck.LeftAltLink <> 0 Then
                                        CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RightLink)
                                    Else
                                        Exit Sub
                                    End If

                                Case LeftBound
                                    If CompToCheck.RightAltLink <> 0 Then
                                        CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftLink)
                                    ElseIf CompToCheck.LeftAltLink <> 0 Then
                                        CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftAltLink)
                                    Else
                                        Exit Sub
                                    End If
                                Case Else
                                    Exit Sub
                            End Select

                        Else
                            If Me.SimulatedTrafficDirection = RightBound Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RightLink)
                            ElseIf Me.SimulatedTrafficDirection = LeftBound Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftLink)
                            Else
                                Exit Sub
                            End If

                        End If
                        If CompToCheck Is Nothing Then Exit Sub

                    ElseIf CompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        Dim sig As Signal = CType(CompToCheck, Signal)
                        If Me.SimulatedTrafficDirection = RightBound Then
                            If sig.AutomaticSignal Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RightLink)
                            ElseIf CompToCheck.ComponentType = "R" And (CompToCheck.SignalIndStatus = Signal.IndStatus.Cleared Or Me.SimulateTrainPassRed) Then

                                CompToCheck.SignalIndStatus = Signal.IndStatus.Stopped
                                Me.MoveTrainToNextTrack(CurrentTrack, Me.FindObjectTypeFromGUID(CompToCheck.RightLink), SimulateTrainPassRed)
                                SimulateTrainPassRed = False
                                Exit Sub
                            ElseIf CompToCheck.ComponentType = "L" Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RIGHTLink)
                            Else
                                Exit Sub
                            End If
                        ElseIf Me.SimulatedTrafficDirection = LeftBound Then
                            If sig.AutomaticSignal Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftLink)
                            ElseIf CompToCheck.ComponentType = "L" And (CompToCheck.SignalIndStatus = Signal.IndStatus.Cleared Or SimulateTrainPassRed) Then
                                CompToCheck.SignalIndStatus = Signal.IndStatus.Stopped
                                Me.MoveTrainToNextTrack(CurrentTrack, Me.FindObjectTypeFromGUID(CompToCheck.LeftLink), SimulateTrainPassRed)
                                SimulateTrainPassRed = False
                                Exit Sub
                            ElseIf CompToCheck.ComponentType = "R" Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftLink)
                            Else
                                Exit Sub
                            End If
                        Else
                            Exit Sub
                        End If
                    End If
                    LoopControl = LoopControl + 1
                    If LoopControl > 10 Then Exit Sub
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Sub ForceSimulateMoveTrainID()
            Try
                Dim LoopControl As Integer
                Dim AuthorityToMoveFound As Boolean
                Dim PreviousTrack As Track = Nothing
                Dim CompToCheck As Object = Nothing
                Dim CurrentTrack As Track = Me.FindTrackFromTrainID(Me.Name)

                If CurrentTrack Is Nothing Then Exit Sub



                If Me.SimulatedTrafficDirection = RightBound Then
                    CompToCheck = Me.FindObjectTypeFromGUID(CurrentTrack.RightLink)
                ElseIf Me.SimulatedTrafficDirection = LeftBound Then
                    CompToCheck = Me.FindObjectTypeFromGUID(CurrentTrack.LeftLink)
                Else
                    Exit Sub
                End If

                If CompToCheck Is Nothing Then Exit Sub

                While Not AuthorityToMoveFound
                    If CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If CurrentTrack.Name = CompToCheck.Name And CurrentTrack.StationNumber = CompToCheck.StationNumber Then
                            If Me.SimulatedTrafficDirection = RightBound Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RightLink)
                            ElseIf Me.SimulatedTrafficDirection = LeftBound Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftLink)
                            Else
                                Exit Sub
                            End If
                        Else
                            If Mid(CompToCheck.AuthorityType, 1, 3) = "TWC" Then
                                Dim trk As Track = Nothing
                                If CompToCheck.Authorities.Count > 0 Then
                                    Dim warr As Warrant = CompToCheck.Authorities(0)
                                    If warr Is Nothing Then Exit Sub
                                    If InStrRev(warr.IssueTo, Me.IdentifingUnit) <> 0 Then
                                        MoveTrainToNextTrack(CurrentTrack, CompToCheck, False)
                                        Exit Sub
                                    Else
                                        Exit Sub
                                    End If
                                Else
                                    Exit Sub
                                End If
                            Else
                                MoveTrainToNextTrack(CurrentTrack, CompToCheck, False)
                                Exit Sub
                            End If
                        End If

                    ElseIf CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        If CompToCheck.ControlledReverse Then
                            If Me.SimulatedTrafficDirection = RightBound Then
                                If CompToCheck.RightAltLink <> 0 Then
                                    CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RightAltLink)
                                ElseIf CompToCheck.LeftAltLink <> 0 Then
                                    CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RightLink)
                                Else
                                    Exit Sub
                                End If
                            ElseIf Me.SimulatedTrafficDirection = LeftBound Then
                                If CompToCheck.RightAltLink <> 0 Then
                                    CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftLink)
                                ElseIf CompToCheck.LeftAltLink <> 0 Then
                                    CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftAltLink)
                                Else
                                    Exit Sub
                                End If
                            Else
                                Exit Sub
                            End If
                        Else
                            If Me.SimulatedTrafficDirection = RightBound Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RightLink)
                            ElseIf Me.SimulatedTrafficDirection = LeftBound Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftLink)
                            Else
                                Exit Sub
                            End If

                        End If
                        If CompToCheck Is Nothing Then Exit Sub

                    ElseIf CompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If Me.SimulatedTrafficDirection = RightBound Then
                            If CompToCheck.ComponentType = "R" And CompToCheck.SignalIndStatus = Signal.IndStatus.Stopped Then
                                Me.MoveTrainToNextTrack(CurrentTrack, Me.FindObjectTypeFromGUID(CompToCheck.RightLink), False)
                                Exit Sub
                            ElseIf CompToCheck.ComponentType = "L" Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.RIGHTLink)
                            Else
                                Exit Sub
                            End If
                        ElseIf Me.SimulatedTrafficDirection = LeftBound Then
                            If CompToCheck.ComponentType = "L" And CompToCheck.SignalIndStatus = Signal.IndStatus.Stopped Then
                                CompToCheck.SignalIndStatus = Signal.IndStatus.Stopped
                                Me.MoveTrainToNextTrack(CurrentTrack, Me.FindObjectTypeFromGUID(CompToCheck.LeftLink), False)
                                Exit Sub
                            ElseIf CompToCheck.ComponentType = "R" Then
                                CompToCheck = Me.FindObjectTypeFromGUID(CompToCheck.LeftLink)
                            Else
                                Exit Sub
                            End If
                        Else
                            Exit Sub
                        End If
                    End If
                    LoopControl = LoopControl + 1
                    If LoopControl > 10 Then Exit Sub
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Sub MoveTrainToNextTrack(ByVal CurrentTrack As Track, ByVal NewTrack As Track, ByVal CheckPassRedSignal As Boolean, Optional UseTrackingFromGPS As Boolean = False)
            Try
                Me.FlashModeOff = True
                CurrentTrack.DrawTrainID()

                If NewTrack.OStype AndAlso CurrentTrack.OStype Then
                    If Not IsNothing(CurrentTrack.OsComponentCollection) Then
                        If CurrentTrack.OsComponentCollection.Contains(NewTrack) Then
                            Exit Sub
                        End If
                    End If
                ElseIf gSimulationMode AndAlso NewTrack.Name = CurrentTrack.Name AndAlso NewTrack.LeftLimitMilePost = CurrentTrack.LeftLimitMilePost AndAlso NewTrack.RightLimitMilePost = CurrentTrack.RightLimitMilePost Then
                    Exit Sub
                End If

                If NewTrack.Indicating Then
                    NewTrack.myControlPoint.FlashName()
                    Dim trk As Object
                    If Not NewTrack.OsComponentCollection Is Nothing Then
                        For Each trk In NewTrack.OsComponentCollection
                            If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim thisTrack As Track = CType(trk, Track)
                                If Not thisTrack.TrackZoneIntegrityMonitoringEnabled Then
                                    If trk.TrackIndicationANDED Or trk.TrackIndicationORED Then
                                        If Not IsNothing(trk.Ind(1)) Then
                                            trk.Ind(1).BitState = True
                                        End If
                                    End If
                                    trk.Occuppied = True
                                    trk.Ind(0).BitState = True
                                    trk.ApplyIndicationChange(UseTrackingFromGPS)
                                    trk.UpdateStatus()
                                End If
                            End If
                        Next
                    End If
                    If NewTrack.OStype Then
                        Me.LastSimulationSpeed = Me.SimulationSpeed
                        Me.SimulationSpeed = 5000
                    Else
                        Me.SimulationSpeed = LastSimulationSpeed
                    End If
                    If Not NewTrack.TrackZoneIntegrityMonitoringEnabled Then
                        NewTrack.Ind(0).BitState = True
                        NewTrack.ApplyIndicationChange()
                        NewTrack.UpdateStatus()
                        Dim OtherComp As Object
                        For Each OtherComp In NewTrack.Ind(0).ComponentRefCollection
                            If OtherComp.GetType.ToString = gTrackComponentName Then
                                If Not OtherComp Is NewTrack Then
                                    OtherComp.Ind(0).BitState = True
                                    If OtherComp.TrackIndicationANDED Or OtherComp.TrackIndicationORED Then
                                        If Not IsNothing(OtherComp.Ind(1)) Then
                                            OtherComp.Ind(1).BitState = True
                                        End If
                                    End If
                                    OtherComp.ApplyIndicationChange(UseTrackingFromGPS)
                                    OtherComp.UpdateStatus()
                                End If
                            End If
                        Next
                    End If
                    If Not NewTrack.TrainIDs.Contains(Me) Then
                        NewTrack.MoveTrainIDPlaceManual(Me, CurrentTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, False, False)
                    End If
                Else
                    'NewTrack.MoveTrainIDPlace(Me, CurrentTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                    NewTrack.MoveTrainIDPlaceManual(Me, CurrentTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, False, False)
                    NewTrack.Occuppied = True
                    NewTrack.UpdateStatus()
                End If


                If CheckPassRedSignal Then
                    NewTrack.CheckForTrainMoveByRedSignal(NewTrack, Me)
                End If
                If gSimulationMode Or gSimulationModeARS Then 'Added this based on ARRC-1632. Based on Ted's Recomendation. 
                    If CurrentTrack.Indicating Then
                        Dim LikeTrackCollection As ArrayList = CurrentTrack.OsComponentCollection
                        Dim trk As Object
                        CurrentTrack.myControlPoint.FlashName()
                        If Not LikeTrackCollection Is Nothing Then
                            For Each trk In LikeTrackCollection
                                If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    Dim thisTrack As Track = CType(trk, Track)
                                    If Not thisTrack.TrackZoneIntegrityMonitoringEnabled Then
                                        If trk.TrainIDs.Count = 0 Then
                                            If trk.TrackIndicationANDED Or trk.TrackIndicationORED Then
                                                If Not IsNothing(trk.Ind(1)) Then
                                                    trk.Ind(1).BitState = False
                                                End If
                                            End If
                                            Me.SimulationSpeed = Me.LastSimulationSpeed
                                            trk.LossOfShuntTimer.Interval = 5000 'Me.SimulationSpeed / 2 + 10000
                                            trk.Ind(0).BitState = False
                                            trk.ApplyIndicationChange()
                                            trk.UpdateStatus()
                                        End If
                                    End If
                                End If
                            Next
                        End If

                        If CurrentTrack.OStype Then
                            Me.SimulationSpeed = Me.LastSimulationSpeed
                            CurrentTrack.LossOfShuntTimer.Interval = 5000 'Me.SimulationSpeed / 2 + 10000
                        Else
                            CurrentTrack.LossOfShuntTimer.Interval = 5000 'Me.SimulationSpeed / 2 + 5000
                        End If
                        If Not CurrentTrack.TrackZoneIntegrityMonitoringEnabled Then
                            If CurrentTrack.TrainIDs.Count = 0 Or CurrentTrack.OStype Then
                                CurrentTrack.Ind(0).BitState = False
                                CurrentTrack.ApplyIndicationChange()
                                CurrentTrack.UpdateStatus()
                                Dim OtherComp As Object 'Track
                                For Each OtherComp In CurrentTrack.Ind(0).ComponentRefCollection
                                    If OtherComp.GetType.ToString = gTrackComponentName Then
                                        If Not OtherComp Is CurrentTrack Then
                                            OtherComp.Ind(0).BitState = False
                                            If OtherComp.TrackIndicationANDED Or OtherComp.TrackIndicationORED Then
                                                If Not IsNothing(OtherComp.Ind(1)) Then
                                                    OtherComp.Ind(1).BitState = False
                                                End If
                                            End If
                                            OtherComp.ApplyIndicationChange()
                                            OtherComp.UpdateStatus()
                                        End If
                                    End If
                                Next
                            End If
                        End If
                    Else
                        Threading.Thread.Sleep(2000)
                        If CurrentTrack.TrainIDs.Count = 0 Then
                            CurrentTrack.Occuppied = False
                            CurrentTrack.TrafficDirection = ""
                            CurrentTrack.UpdateStatus()
                        End If
                    End If
                End If
                Me.FlashModeOff = False
                NewTrack.DrawTrainID()

            Catch ex As Exception
                SystemException(ex.ToString)
                Me.FlashModeOff = False
            End Try

        End Sub

