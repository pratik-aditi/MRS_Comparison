#Region "EVENT LOGGING"

        Public Enum EventTypeTrainID
            CREATE
            UPDATE
            POSITION
            RELEASE
            FINAL
            OS
            MOVE
            MOVEMANUAL
            MODIFY
            REORDER
        End Enum

        Private Delegate Sub DoEventLogTrainID(ByVal EventType As EventTypeTrainID)

        Public Sub LogTheTrainIDEvent(ByVal EventType As EventTypeTrainID)
            Try
                Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.LastName & "," & TMDS.GlobalDeclarations.gCurrentUser.FirstName
                Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                Dim CurTerr As Territory
                Dim CurTrk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.TrackGUID)
                If Not CurTrk Is Nothing Then
                    CurTerr = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(CurTrk.TerritoryID)
                Else
                    Exit Sub
                End If

                Dim LogString As String = "INSERT INTO tblSystemEvents "
                Dim SqlFields As String = "([EventTime], [Territory], [Wrkstn], [SysUser], [DbVer], [FuncType], [UID], [Event], [SysData])"
                Dim SqlValues As String
                Dim TrainData As String = String.Empty
                Dim c As String = ", "
                Dim q As String = "'"
                SqlValues = " VALUES (" & q & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & q & c & CurTrk.TerritoryID & c & CurWrkstn & c & q & CurUser & q & c
                SqlValues = SqlValues & q & CurTerr.Dbversion & q & c & q & "TRAIN-ID" & q & c & q & Me.Name & q & c

                TrainData = TrainData & "|" & Me.TrackGUID
                TrainData = TrainData & "|" & Me.TrainGUID
                TrainData = TrainData & "|" & Me.Name
                TrainData = TrainData & "|" & Me.Direction
                TrainData = TrainData & "|" & Me.IdentifingUnit

                Select Case EventType
                    Case EventTypeTrainID.CREATE
                        SqlValues = SqlValues & q & "CREATE" & q & c & q
                        TrainData = TrainData & "|" & Me.CrewCurrent.Engineer.NameOfPerson
                        TrainData = TrainData & "|" & Me.CrewCurrent.Conductor.NameOfPerson

                    Case EventTypeTrainID.FINAL
                        SqlValues = SqlValues & q & "FINAL" & q & c & q
                        TrainData = TrainData & "|" & Me.FinalTime.ToShortTimeString

                        If optEnableReportingToMobileApplication Then
                            TMDS.NetworkMessages.iTMDSMessages.SendTrainReleaseReportMessage(Me)
                        End If

                    Case EventTypeTrainID.MODIFY
                        SqlValues = SqlValues & q & "MODIFIED" & q & c & q
                        SqlValues = SqlValues & "|" & Me.CrewCurrent.Engineer.OnDutyTime
                        SqlValues = SqlValues & "|" & Me.CrewCurrent.Engineer.OnDutyTime

                    Case EventTypeTrainID.MOVE
                        SqlValues = SqlValues & q & "MOVE" & q & c & q

                    Case EventTypeTrainID.MOVEMANUAL
                        SqlValues = SqlValues & q & "MOVE-MANUAL" & q & c & q

                    Case EventTypeTrainID.OS
                        SqlValues = SqlValues & q & "OS" & q & c & q
                        TrainData = TrainData & "|" & CurTrk.myControlPoint.Name
                        TrainData = TrainData & "|" & Now.ToShortTimeString

                    Case EventTypeTrainID.POSITION
                        SqlValues = SqlValues & q & "POSITION" & q & c & q

                    Case EventTypeTrainID.RELEASE
                        SqlValues = SqlValues & q & "RELEASE" & q & c & q

                        If optEnableReportingToMobileApplication Then
                            TMDS.NetworkMessages.iTMDSMessages.SendTrainReleaseReportMessage(Me)
                        End If

                    Case EventTypeTrainID.UPDATE
                        SqlValues = SqlValues & q & "UPDATE" & q & c & q
                End Select

                'CBTC status
                If Me.IsActivePTC Then
                    TrainData = TrainData & "|" & Me.DisplayText.ToUpper
                    TrainData = TrainData & "|" & Me.IsActivePTC.ToString.ToUpper
                Else
                    TrainData = TrainData & "|" & Me.DisplayText.ToUpper.Replace("^", "")
                    TrainData = TrainData & "|" & Me.IsActivePTC.ToString.ToUpper
                End If

                SqlValues = SqlValues & TrainData
                SqlValues = SqlValues & q
                SqlValues = SqlValues & ")"
                SyncLock gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(LogString & SqlFields & SqlValues)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

            If optEnableTrainTAG Then
                Try
                    Select Case EventType
                        Case EventTypeTrainID.MOVE
                            Dim trk As Track
                            trk = FindTrackFromGUID(Me.TrackGUID)
                            If Not trk Is Nothing Then
                                Dim tg As Tag
                                For Each tg In trk.TrackTagLabels
                                    Me.GetIdentifyingLocationNameFromLimits()
                                    Dim Delaystr() As String = tg.DelayData.Split("|")
                                    Dim EventString As String = "TRACK TAG " & tg.TagType & ": " & tg.DataString
                                    Dim RailRoadName As String = ChkStrDBNull(trk.myControlPoint.UniqueName)
                                    If optEnableConvertTrainTAGwDelayToDelayEvent = True Then
                                        If Delaystr.GetUpperBound(0) > 0 And Not (Delaystr(0).Trim.ToUpper = "NONE" Or Delaystr(0).Trim = String.Empty) Then
                                            Dim DelayCode As String = Delaystr(0).Trim.ToUpper
                                            Dim DelayComment As String = ""
                                            Dim DelayMP As String = ""
                                            Dim DelayMin As Integer = 0
                                            Dim ReportData As String = ""
                                            Dim DelayTrackName As String = trk.TrackName

                                            Dim dc As DelayCode
                                            For Each dc In TMDS.GlobalDeclarations.gDelayCodeList
                                                If DelayCode.Trim.ToUpper = dc.Code.Trim.ToUpper Then
                                                    DelayComment = "(" & GetProperStringFormatForDatabase(dc.Code.Trim.ToUpper) & ")"
                                                    Exit For
                                                End If
                                            Next
                                            If Delaystr.GetUpperBound(0) > 0 Then DelayMP = Delaystr(1).Trim
                                            If Delaystr.GetUpperBound(0) > 1 Then DelayMin = Delaystr(2).Trim
                                            If Delaystr.GetUpperBound(0) > 2 Then DelayComment = DelayComment & "-" & Delaystr(3).Trim
                                            ReportData = Me.GetTrainReportDataString(DelayCode, DelayMin) & "|" & tg.TagGuid
                                            Me.AddTrainDelayTAGEvent(Now, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, DelayMP, DelayTrackName, DelayCode, DelayComment, DelayMin, RailRoadName, ReportData)
                                            'If Not SystemForms.MySystemForms.frmTrainID Is Nothing Then SystemForms.MySystemForms.frmTrainID.LoadTrainDelays()
                                        Else
                                            'Me.AddTrainTAGEvent("TRACK TAG " & tg.TagType, Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, True, tg)
                                            Me.AddTrainTAGEvent("TRACK TAG " & tg.TagType, Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, RailRoadName, tg)
                                            If Not SystemForms.MySystemForms.frmTrainID Is Nothing Then SystemForms.MySystemForms.frmTrainID.LoadTrainEvents(Me)

                                        End If


                                    End If

                                    If optEnableConvertTrainTAGwDelayToDelayEvent = False Then
