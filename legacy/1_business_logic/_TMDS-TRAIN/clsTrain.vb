        Public Sub AddTrainWorkTask(ByVal pTaskGUID As String)
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim query As StringBuilder = Nothing
            Dim HasRestrictionTaskApplied As Boolean = False
            Try
                query = New StringBuilder("SELECT UID, TaskCreateTime, TaskType, EntityUID, EntityGUID, TaskData, MessageVersion, MessageEdition FROM tblSystemWorkTasksActive WHERE (UID = '" & pTaskGUID & "')")
                dbconn = New OleDbConnection(gConnectionStringTrain)
                dbconn.Open()
                dbcomm = New OleDbCommand(query.ToString, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    Dim wt As New WorkTask
                    Dim HasWTApplied As Boolean = False
                    If Not dr.IsDBNull(0) Then wt.UID = dr.GetString(0)
                    If Not dr.IsDBNull(1) Then wt.TaskCreateTime = dr.GetDateTime(1)
                    If Not dr.IsDBNull(2) Then wt.TaskType = dr.GetString(2)
                    If Not dr.IsDBNull(3) Then wt.EntityUID = dr.GetString(3)
                    If Not dr.IsDBNull(4) Then wt.EntityGUID = dr.GetString(4)
                    If Not dr.IsDBNull(5) Then wt.TaskData = dr.GetString(5)
                    If Not dr.IsDBNull(6) Then wt.MessageVersion = dr.GetInt32(6)
                    If Not dr.IsDBNull(7) Then wt.MessageEdition = dr.GetInt32(7)
                    wt.myTrain = Me
                    If Not String.IsNullOrEmpty(wt.TaskType) AndAlso wt.TaskType.Trim <> "" Then
                        Select Case wt.TaskType.Trim
                            Case "CONSIST-CHANGE", "CREW-CHANGE", "UNIT-CHANGE"
                                FindAndRemoveWorkTask(wt.EntityUID, wt.TaskType)
                        End Select
                    End If
                    wt.CreateTask(HasWTApplied)
                    If HasWTApplied Then
                        wt.RemoveWorkTask()
                        If wt.TaskType.Trim.ToUpper = "TRAIN-RESTRICTION-ADDED" Then
                            HasRestrictionTaskApplied = True
                        End If
                    End If
                End While
                dbconn.Close()
                If HasRestrictionTaskApplied Then
                    Dim SummItem As New TrainRefreshItem(TrainRefreshItem.TrainRefreshType.TGBO, TrainRefreshItem.TrainRefreshAction.REFRESH, "")
                    SyncLock Me.myTrainTimerRefreshQueue.SyncRoot
                        'Me.myTrainTimerRefreshQueue.Enqueue(SummItem)
                        Try
                            Dim tmp As TrainRefreshItem
                            Dim OkToAdd As Boolean = True
                            For Each tmp In Me.myTrainTimerRefreshQueue
                                If tmp.myItemAction = TrainRefreshItem.TrainRefreshAction.REFRESH AndAlso tmp.myItemAction = TrainRefreshItem.TrainRefreshType.TGBO Then
                                    OkToAdd = False
                                End If
                            Next
                            If OkToAdd Then Me.myTrainTimerRefreshQueue.Enqueue(SummItem)
                        Catch ex As Exception
                            GetErrorDetails(ex)
                        End Try
                    End SyncLock
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                dbconn = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Check to refresh train sheet summary
        ''' </summary>
        ''' <param name="pForceRefresh"></param>
        ''' <param name="pRefreshRestrinctions"></param>
        Friend Sub CheckToRefreshTrainSheetSummary(ByVal pForceRefresh As Boolean, Optional pRefreshRestrinctions As Boolean = False)
            Try
                If Not pForceRefresh Then Exit Sub
                If Not IsNothing(TMDS.SystemForms.MySystemForms.frmTrainID) Then
                    If TMDS.SystemForms.MySystemForms.frmTrainID.FormLoaded Then
                        If pRefreshRestrinctions Then
                            gTrainSheetMessageQueue.Enqueue("REFRESHTRAINRESTRICTIONS")
                        Else
                            gTrainSheetMessageQueue.Enqueue("REFRESHTRAINSHEET")
                        End If
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindAndRemoveWorkTask(ByVal pEntityUID As String, ByVal pWorkTaskType As String) As Boolean
            Dim tempWTList As New ArrayList
            Dim wt As WorkTask = Nothing
            Try
                If gWorkTasks IsNot Nothing AndAlso gWorkTasks.Count > 0 Then
                Else
                    Return True
                End If
                CopyArrayCollection(tempWTList, gWorkTasks)
                For Each wt In tempWTList
                    If wt.EntityUID.Trim = pEntityUID.Trim AndAlso wt.TaskType.ToUpper.Trim = pWorkTaskType.ToUpper.Trim Then
                        wt.RemoveWorkTask()
                        TrainEventLog("WORK TASK [" & wt.UID.Trim & "] REMOVED SINCE NEW WORKTASK TYPE [" & pWorkTaskType.ToUpper.Trim & "] RECEVIED FOR [" & wt.EntityUID & "].")
                    End If
                Next
                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                tempWTList = New ArrayList
                wt = Nothing
            End Try
        End Function

