        End Function

        Public Function GetLastOSEventFromTrainMovement(Optional ByRef LastOsPoint As String = "") As String
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim SQLQuery As String = "SELECT EventLocation,EventTimeStamp FROM tblTrainEventActiveMovements WHERE TrainSheetUID = '" & Me.ActiveTrainSheetGUID & "' ORDER BY EventTimeStamp desc"
            Dim RtnStrOsTime As String = optTrainString21
            Try

                Using DbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        If Not dr.IsDBNull(0) AndAlso Not dr.IsDBNull(1) Then
                            Dim dtOSTime As Date
                            If optEnableDenverSpecificOptions Then
                                Dim OSLoc As String = dr.GetValue(0)
                                If OSLoc IsNot Nothing AndAlso OSLoc.Trim <> "" Then
                                    Dim PS As PassengerStation = Nothing
                                    PS = TMDS.SystemUtilities.FetchData.FetchPassengerStations(OSLoc)
                                    If PS IsNot Nothing Then
                                        LastOsPoint = PS.Name.Trim.ToUpper
                                        If Date.TryParse(dr.GetDateTime(1), dtOSTime) Then
                                            RtnStrOsTime = Format(dr.GetDateTime(1), "HH:mm:ss") & " (" & LastOsPoint & ")"
                                        End If
                                    End If
                                End If
                                Exit While
                            Else
                                Dim OSLoc() As String = dr.GetString(0).Split("|")
                                If OSLoc.GetUpperBound(0) > 0 Then
                                    If OSLoc.GetUpperBound(0) > 1 Then
                                        LastOsPoint = OSLoc(2)
                                    Else
                                        LastOsPoint = OSLoc(0)
                                    End If
                                    If Date.TryParse(dr.GetDateTime(1), dtOSTime) Then
                                        RtnStrOsTime = Format(dr.GetDateTime(1), "HH:mm") & " (" & LastOsPoint & ")"
                                        Exit While
                                    End If
                                End If
                            End If
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return RtnStrOsTime
        End Function

