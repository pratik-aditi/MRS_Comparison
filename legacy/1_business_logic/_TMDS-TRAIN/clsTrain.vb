                dt.Columns.Add(col1)

                col1 = New DataColumn("Position")
                col1.DataType = System.Type.GetType("System.Int32")
                dt.Columns.Add(col1)
                'System.Int32()




            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return dt
        End Function

