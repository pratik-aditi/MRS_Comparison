#Region "RESTRICTION DELIVERY"

        Public Sub DeliverRestriction(ByVal RestrictionInformation As String)
            Try
                Dim StartMessage As Date = Now
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainStatusRequest(Me)
                Do
                    Application.DoEvents()
                    Threading.Thread.Sleep(50)
                    If StartMessage < Now.AddSeconds(-1) Then Exit Do
                Loop

                Dim data() As String = RestrictionInformation.Split("-")
                Dim Info() As String = data(1).Replace("(", "").Split(")")

                Dim theTime As String = String.Empty
                Dim TagType As String = Trim(data(0))
                Dim IsTag As Boolean
                Dim IsBulletin As Boolean
                Dim theBullType As String = String.Empty
                Dim theBullUID As String = String.Empty
                Select Case TagType
                    Case "SPEED", optTagType1
                        theTime = Trim(Info(3))
                        IsTag = True
                    Case "XING", optTagType2
                        theTime = Trim(Info(2))
                        IsTag = True
                    Case "ADVISORY", optTagType3, "CRITICAL ALERT"
                        theTime = Trim(Info(1))
                        IsTag = True
                    Case "WEATHER"
                        theTime = Trim(Info(0))
                        IsTag = True

                    Case "BULLETIN"
                        IsBulletin = True
                        If data.Length = 4 Then
                            Dim bull() As String = data(3).Replace("(", "").Split(")")
                            theBullType = Trim(data(1) & "-" & data(2))
                            theBullUID = bull(0)
                        Else
                            Dim bull() As String = data(2).Replace("(", "").Split(")")
                            theBullType = Trim(data(1))
                            theBullUID = bull(0)
                        End If

                End Select

                If IsTag Then
                    Dim theTag As Tag = Nothing
                    Dim t As Tag
                    For Each t In TrackTags
                        If CStr(t.CreateTime) = theTime Then
                            theTag = t
                            Exit For
                        End If
                    Next
                    If IsNothing(theTag) Then Exit Sub
                    DeliverTag(theTag)
                End If
                If IsBulletin Then
                    Dim theBull As SubBulletin = Nothing
                    Dim b As SubBulletin
                    For Each b In BulletinCollection
                        If b.GetBulletinType = Trim(theBullType) AndAlso b.myUID = Trim(theBullUID) Then
                            theBull = b
                            Exit For
                        End If
                    Next
                    If IsNothing(theBull) Then Exit Sub
                    If optEnableBulletinSystemEnhanced Then
                        DeliverBulletinViaBulletinHMI(theBull)
                    Else
                        DeliverBulletin(theBull)
                    End If
                    DoGBOSummaryRefresh("DeliverRestriction - Train")
                    DoTGBOSummaryRefresh("DeliverRestriction - Train")
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DeliverTag(ByVal theTag As Tag)
            Try
                If optOverrideReadRepeatForRestrictionDelivery Then
                    If Me.IsActivePTC Then
                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrackTagRestrictionMessageCreate(theTag, Me, theTag.PTCMessageUID, False, "DeliverTag")
                    Else
                        PerformDeliveryConfirmation(theTag)
                    End If
                    Exit Sub
                End If
                Dim LaunchPoint As New Point(0, 0)
                Dim frmReadRepeat As New frmReadRepeat
                frmReadRepeat.RestrictionDeliverMode = True
                frmReadRepeat.theTrain = Me
                frmReadRepeat.SetMessage(theTag.GetTextualMessageList, optTagString9, LaunchPoint, "TAG", False)
                frmReadRepeat.ShowDialog()
                If frmReadRepeat.FormFeedback = 6 Then
                    If Me.IsActivePTC Then
                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrackTagRestrictionMessageCreate(theTag, Me, theTag.PTCMessageUID, False, "DeliverTag")
                    Else
                        PerformDeliveryConfirmation(theTag)
                    End If
                End If
                frmReadRepeat.Dispose()
                frmReadRepeat = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Update track tag list
        ''' </summary>
        ''' <param name="pTag"></param>
        ''' <param name="pRemoveTag"></param>
        Public Sub UpdateTrackTagList(pTag As Tag, pRemoveTag As Boolean)
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dReader As OleDbDataReader = Nothing
            Dim Insert As New System.Text.StringBuilder
            Dim tagList As New StringBuilder
            Dim TagExists As Boolean = False
            Dim TrackTagList As New ArrayList
            Dim strTrackTag As String = Nothing
            Dim strTagListAux As String()
            Dim t, tagString, s As String
            Dim Index As Integer
            Try
                Me.TrainEventLog("UpdateTrackTagList:TagID=" & pTag.TagGuid & ":Remove=" & pRemoveTag.ToString)
                'This avoid a bad bulletin in BOS server
                If pTag.TagType.Contains(optTagType3) Or pTag.TagType.Contains(optTagType6) Then
                    Me.TrainEventLog("UpdateTrackTagList:Track tag is not a speed restriction:TagID=" & pTag.TagGuid)
                    Exit Sub
                End If
                dbconn = New OleDbConnection(gConnectionStringDynamic)
                dbconn.Open()
                'Get track tag in db
                dbcomm = New OleDbCommand("SELECT TrackTagList FROM tblSystemTabularGeneralBulletinActive WHERE IssuedTo ='" & Me.Name & "'", dbconn)
                dReader = dbcomm.ExecuteReader()
                While dReader.Read
                    If Not dReader.IsDBNull(0) Then
                        strTrackTag = dReader.GetString(0)
                    End If
                End While
                If strTrackTag IsNot Nothing Then
                    strTagListAux = strTrackTag.Split("|")
                    For Each t In strTagListAux
                        TrackTagList.Add(t)
                    Next
                End If
                tagString = pTag.TagGuid & ";" & pTag.Subdivision & ";ADD"
                For Each t In TrackTagList
                    If t = tagString Then
                        TagExists = True
                        Exit For
                    End If
                Next
                If Not TagExists Then
                    TrackTagList.Add(tagString)
                End If
                If pRemoveTag Then
                    For Each t In TrackTagList
                        If t = tagString Then
                            Index = TrackTagList.LastIndexOf(t)
                            TrackTagList.Item(Index) = pTag.TagGuid & ";" & pTag.Subdivision & ";CANCELLED"
                            Me.TrainEventLog("UpdateTrackTagList:TagID=" & pTag.TagGuid & " was cancelled")
                            Exit For
                        End If
                    Next
                End If
                For Each s In TrackTagList
                    If tagList.Length = 0 Then
                        tagList.Append(s)
                    Else
                        tagList.Append("|")
                        tagList.Append(s)
                    End If
                Next
                Me.trackTagList = TrackTagList.Clone
                'Update track tag in db
                Insert.Append("UPDATE tblSystemTabularGeneralBulletinActive")
                Insert.Append(" SET TrackTagList = '" & tagList.ToString & "'")
                Insert.Append(" WHERE IssuedTo = '" & Me.Name & "'")
                dbcomm = New OleDbCommand(Insert.ToString, dbconn)
                dbcomm.ExecuteNonQuery()
                dbconn.Close()
                dbconn.Dispose()
                Me.TrainEventLog("UpdateTrackTagList:TagList=" & Insert.ToString)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                dbconn = Nothing
                dReader = Nothing
                Insert = Nothing
                tagList = Nothing
            End Try
        End Sub

