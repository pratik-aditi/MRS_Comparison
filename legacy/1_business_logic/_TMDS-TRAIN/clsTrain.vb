                Dim u As TrainUnit
                For Each u In Me.UnitsInTrain
                    If u.UnitNumber = UnitID Then
                        Return True
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

