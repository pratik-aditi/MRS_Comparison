        Public Function CheckMyTGBOValidity(ByVal LaunchPoint As Object, ByVal CompCollection As ArrayList) As Boolean
            Dim MessageList As New ArrayList
            Dim CompList As New ArrayList
            Dim myTGBO As TabularGeneralBulletin = Nothing
            Dim LPoint As Point
            Try
                CopyArrayCollection(CompList, CompCollection)
                If LaunchPoint Is Nothing Then
                    LPoint = New Point(Me.myTrack.CurrentDrawingForm.Left + Me.myTrack.CurrentDrawingForm.Width / 2 - 100, 150)
                ElseIf LaunchPoint.GetType.ToString <> "System.Drawing.Point" Then
                    LPoint = New Point(Me.myTrack.CurrentDrawingForm.Left + Me.myTrack.CurrentDrawingForm.Width / 2 - 100, 150)
                Else
                    LPoint = LaunchPoint
                End If

                If Not CheckIfTrainHasValidTGBOForAuthority(CompList, Me.IdentifingUnit, myTGBO) Then
                    MessageList = New ArrayList
                    MessageList.Add("THIS TRAIN DOES NOT HAVE VALID " & optBulletinContainerName)
                    MessageList.Add("AUTHORITY ISSUANCE IS DENIED")
                    ShowCustomMessageBox(MessageList, "TRAIN " & optBulletinContainerName & " VALIDATION", False, LPoint, False, True, Me.myTrack.CurrentDrawingForm)
                    Return False
                ElseIf myTGBO IsNot Nothing AndAlso optEnableBulletinRouteCheck AndAlso Me.CheckForUndeliveredRestriction(myTGBO, LPoint, Me.myTrack.CurrentDrawingForm) Then
                    Return False

                ElseIf Not IsNothing(myTGBO) AndAlso optEnableBulletinRouteCheck Then
                    Dim comp As Object
                    Dim BullList As New ArrayList
                    For Each comp In CompCollection
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(comp, Track)
                            If trk.Bulletins IsNot Nothing AndAlso trk.Bulletins.Count > 0 Then
                                Dim b As SubBulletin
                                For Each b In trk.Bulletins
                                    If Not BullList.Contains(b) Then
                                        BullList.Add(b)
                                    End If
                                Next
                            End If
                        End If
                    Next
                    myTGBO.GetExistingExceptions(BulletinCollection)
                    Dim exp As TabularGeneralBulletinException
                    If myTGBO.myExceptionListOfGBOs IsNot Nothing AndAlso myTGBO.myExceptionListOfGBOs.Count > 0 Then
                        For Each exp In myTGBO.myExceptionListOfGBOs
                            If exp.theGBO.mysTypeForm.Contains("C-FORM") Then
                            ElseIf BullList IsNot Nothing AndAlso BullList.Count > 0 AndAlso BullList.Contains(exp.theGBO) Then
                                MessageList = New ArrayList
                                MessageList.Add("THIS TRAIN HAS A BULLETIN EXCEPTION")
                                MessageList.Add("THAT NEEDS DELIVERED BEFORE AUTHORITY ISSUANCE.")
                                'MessageList.Add(exp.theGBO.mysTypeForm & " - (" & exp.theGBO.myUID & ") (" & exp.theGBO.SubName & ")")
                                MessageList.Add(GetBulletinType(exp.theGBO) & " - (" & exp.theGBO.myUID & ") (" & exp.theGBO.SubName & ")")

                                ShowCustomMessageBox(MessageList, "BULLETIN VALIDATION", False, LPoint, False, True, Me.myTrack.CurrentDrawingForm)
                                'Me.CloseForm()
                                'ClearSystemVariables()
                                Return False
                            ElseIf exp.theGBO IsNot Nothing AndAlso exp.theGBO.mysTypeForm = "FORM C" AndAlso exp.theGBO.TrainSymbol = Me.Name Then
                                MessageList = New ArrayList
                                MessageList.Add("THIS TRAIN HAS ONE OR MORE FORM C BULLETIN EXCEPTION(s)")
                                MessageList.Add("THAT NEEDS DELIVERED BEFORE AUTHORITY ISSUANCE.")
                                'MessageList.Add(exp.theGBO.mysTypeForm & " - (" & exp.theGBO.myUID & ") (" & exp.theGBO.SubName & ")")
                                ShowCustomMessageBox(MessageList, "BULLETIN VALIDATION", False, LPoint, False, True, Me.myTrack.CurrentDrawingForm)
                                Return False
                            End If
                        Next
                        'Check for FORM F EXCEPTIONS
                        Dim HasFormFException As Boolean = False
                        MessageList = New ArrayList
                        MessageList.Add("THIS TRAIN HAS A BULLETIN EXCEPTION")
                        MessageList.Add("THAT NEEDS DELIVERED BEFORE AUTHORITY ISSUANCE.")
                        For Each exp In myTGBO.myExceptionListOfGBOs
                            If BulletinCollection.Contains(exp.theGBO) Then
                                Dim OkToStopProcess As Boolean = False
                                If exp.theGBO.SystemWideBulletin Then
                                    OkToStopProcess = True
                                ElseIf (exp.theGBO.GeneralInformationDOB OrElse exp.theGBO.GeneralInformationTGBO) AndAlso exp.theGBO.SubUID = Me.myTrack.mySubdivision.GUID Then
                                    OkToStopProcess = True
                                End If
                                If OkToStopProcess Then
                                    HasFormFException = True
                                    'MessageList.Add(exp.theGBO.mysTypeForm & " - (" & exp.theGBO.myUID & ") (" & exp.theGBO.SubName & ")")
                                    MessageList.Add(GetBulletinType(exp.theGBO) & " - (" & exp.theGBO.myUID & ") (" & exp.theGBO.SubName & ")")
                                    'ShowCustomMessageBox(MessageList, "BULLETIN VALIDATION", False, LPoint, False, True, Me.myTrack.CurrentDrawingForm)
                                    'Return False
                                End If
                            End If
                        Next
                        If HasFormFException Then
                            ShowCustomMessageBox(MessageList, "BULLETIN VALIDATION", False, LPoint, False, True, Me.myTrack.CurrentDrawingForm)
                            Return False
                        Else
                            MessageList = New ArrayList
                        End If
                    End If
                End If

                'Check for Undelivered RESTRICTIONS
                If Not CheckForRestrictionConflict(CompList, myTGBO) Then
                    MessageList = New ArrayList
                    MessageList.Add("THIS TRAIN HAS ONE OR MORE RESTRCITION NOT CREATED AS FORM C ")
                    MessageList.Add("AUTHORITY ISSUANCE IS DENIED")
                    ShowCustomMessageBox(MessageList, "RESTRCITION VALIDATION", False, LPoint, False, True, Me.myTrack.CurrentDrawingForm)
                    Return False
                End If
                'Check for Crew
                If Not CheckForValidCrew() Then
                    MessageList = New ArrayList
                    MessageList.Add("THIS TRAIN DOES NOT HAVE CREW DEFINED")
                    MessageList.Add("AUTHORITY ISSUANCE IS DENIED")
                    ShowCustomMessageBox(MessageList, "CREW VALIDATION", False, LPoint, False, True, Me.myTrack.CurrentDrawingForm)
                    Return False
                End If
                'Check for Work Task
                If Not CheckForWorkTask() Then
                    MessageList = New ArrayList
                    MessageList.Add("THIS TRAIN HAS ONE OR MORE WORK TASK PENDING")
                    MessageList.Add("AUTHORITY ISSUANCE IS DENIED")
                    ShowCustomMessageBox(MessageList, "WORK TASK VALIDATION", False, LPoint, False, True, Me.myTrack.CurrentDrawingForm)
                    Return False
                End If
                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                MessageList = Nothing
                LPoint = Nothing
            End Try

        End Function

#End Region

#Region " REMOVE STOP TARGET "

        Public Sub ApplyRemoveStopTarget(ByVal theSignal As Signal, ByVal theEnterTrack As Track)
            Dim EnterTrack As Track = Nothing
            Dim theExitTrack As Track = Nothing
            Dim EnTrackName As String = ""
            Dim ExTrackName As String = ""
            Dim EventMessage As String = String.Empty

            Dim EnterSignal As Signal = theSignal
            Dim comp As Object = Nothing
            Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + theSignal.CurrentDrawingForm.Width / 2 - 100, 150)
            Dim Limits As String = ""
            Dim TmpPTCComponents As New ArrayList
            Try

                CopyArrayCollection(gEntExtTrackSelection, theSignal.SignalRouteCollection)
                CopyArrayCollection(TmpPTCComponents, gEntExtTrackSelection)
                theExitTrack = TMDS.SystemUtilities.FetchData.FindLastTrackInList(gEntExtTrackSelection)
                EnTrackName = theEnterTrack.TrackName
                ExTrackName = theExitTrack.TrackName

                If theEnterTrack.TrackAlternativeName.Trim <> String.Empty Then
                    EnTrackName = theEnterTrack.TrackAlternativeName.ToUpper.Trim
                End If

                If theExitTrack.TrackAlternativeName.Trim <> String.Empty Then
                    ExTrackName = theExitTrack.TrackAlternativeName.ToUpper.Trim
                End If

                Dim dir As String = GetSignalDirection(theSignal)
                Dim MessageList As New ArrayList()
                MessageList.Add("PTC SYSTEM AND SIGNAL SYSTEM INDICATIONS AT " & theSignal.Name & " AT " & theSignal.myControlPoint.Name)
                MessageList.Add("ARE NOT CONSISTENT - PROCEED UNDER MOST RESTRICTIVE CONDITION.")
                Limits = gPermissionToRemoveStopTargetText & " PTC SYSTEM AND SIGNAL SYSTEM INDICATIONS AT " & theSignal.Name & " AT " & theSignal.myControlPoint.Name & "ARE NOT CONSISTENT - PROCEED UNDER MOST RESTRICTIVE CONDITION."

                If Me.CheckMyPTCStatus Then
                    Dim OtherAuth As New TrackAuthority.OtherSpecialAuthorityType(Me, "PSS", Me.myTrack.myTerritory, gEntExtTrackSelection, MessageList, theSignal.DefaultTraffic, True)
                    OtherAuth.AuthorityLimits = Limits
                    If OtherAuth.AddAuthorityToDatabase Then
                        If Not gOtherSpecialAuthorityCollection.Contains(OtherAuth) Then gOtherSpecialAuthorityCollection.Add(OtherAuth)

                        Dim SummItem As New SummaryItem("SPLAUTHORITY", "ADD", OtherAuth)
                        SyncLock gSummaryAuthQueue
                            gSummaryAuthQueue.Enqueue(SummItem)
                        End SyncLock
                        If optEnablePTCBOSVETMSMode Then
                            CopyArrayCollection(OtherAuth.PTCComponentsInSelection, TmpPTCComponents)
