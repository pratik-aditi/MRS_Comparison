        ''' <summary>
        ''' Does train have license
        ''' </summary>
        ''' <returns></returns>
        Public Function ChecksNewDirecitonWithLicense(pNewDirection As String) As Boolean
            Dim messageList As New ArrayList()
            Dim frmMessageBox As frmMessageBox = Nothing
            Dim trk As Track
            Try
                'checks if train is not actived
                If Not Me.IsActivePTC Then
                    Return False
                End If
                'checks licenses
                If Me.thisRestrictiveLicense Is Nothing And Me.thisCurrentLicense Is Nothing Then
                    Return False
                End If
                'checks filpflop in modify
                If gEntExtTrackSelection IsNot Nothing AndAlso gEntExtTrackSelection.Count > 0 Then
                    For Each comp As Object In gEntExtTrackSelection
                        If comp IsNot Nothing AndAlso comp.GetType.ToString = gTrackComponentName Then
                            trk = CType(comp, Track)
                            If trk.IsLinkToFlipFlopToLeft Or trk.IsLinkToFlipFlopToRight Then
                                Return False
                            End If
                        End If
                    Next
                End If
                'Get info
                If Me.thisCurrentLicense IsNot Nothing Then
                    messageList.Add(optChangeDirectionString5 & Space(1) & Me.Name & Space(1) & optChangeDirectionString6 & Space(1) & Me.thisCurrentLicense.AuthorityNumber.ToString & "!")
                    messageList.Add("")
                ElseIf Me.thisRestrictiveLicense IsNot Nothing Then
                    messageList.Add(optChangeDirectionString5 & Space(1) & Me.Name & Space(1) & optChangeDirectionString7 & Space(1) & Me.thisRestrictiveLicense.AuthorityNumber.ToString & "!")
                    messageList.Add("")
                End If
                messageList.Add(optChangeDirectionString8)
                messageList.Add("")
                messageList.Add(optChangeDirectionString9)
                messageList.Add("")
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = Me.myTrack.CurrentDrawingForm
                frmMessageBox.SetMessage(messageList, optChangeDirectionMessageHeader, True, Me.myTrack.CurrentDrawingForm.myLaunchPoint)
                TrainEventLog("ChecksNewDirecitonWithLicense:Message=" & messageList(0).ToString)
                frmMessageBox.ShowDialog()
                If frmMessageBox.FormFeedBack = 6 Then
                    TrainEventLog("ChecksNewDirecitonWithLicense:DISPATCHER:" & TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO CHANGE DIRECTION WITH LICENSE")
                    Return False
                Else
                    TrainEventLog("ChecksNewDirecitonWithLicense:DISPATCHER:" & TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED NO TO CHANGE DIRECTION WITH LICENSE")
                    Return True
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                messageList = Nothing
                If frmMessageBox IsNot Nothing Then frmMessageBox.Dispose()
                frmMessageBox = Nothing
                trk = Nothing
            End Try
        End Function

