        Friend Function OkToEnforceThisRestriction(tr As TrainRestriction, ByVal myCompList As ArrayList, ByVal ThisTrainTGBO As TabularGeneralBulletin) As Boolean
            Dim exp As TabularGeneralBulletinException
            Dim Comp As Object = Nothing
            Try
                If ThisTrainTGBO.myExceptionListOfGBOs Is Nothing OrElse ThisTrainTGBO.myExceptionListOfGBOs.Count = 0 Then ThisTrainTGBO.GetExistingExceptions(BulletinCollection)
                For Each exp In ThisTrainTGBO.myExceptionListOfGBOs
                    If exp.theGBO.CorrelatingRestrictionUID.Trim.ToUpper = tr.myUID Then
                        Select Case exp.theGBO.mysTypeForm.ToUpper.Trim
                            Case "C-FORM C"
                                If exp.theGBO.SystemWideBulletin Then
                                    Return True
                                ElseIf exp.theGBO.CompList IsNot Nothing AndAlso exp.theGBO.CompList.Count > 0 Then
                                    Dim HasOneCompInGBO As Boolean = False
                                    For Each Comp In exp.theGBO.CompList
                                        If myCompList.Contains(Comp) Then
                                            HasOneCompInGBO = True
                                            Exit For
                                        End If
                                    Next
                                    If HasOneCompInGBO Then Return True
                                End If
                        End Select
                    End If

                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function

        Friend Function CheckForBulletinExceptions(ByVal myCompList As ArrayList, ByVal ThisTrainTGBO As TabularGeneralBulletin, ByVal myParentForm As Object) As Boolean
            Dim Comp As Object = Nothing
            Dim BullList As New ArrayList
            Dim MessageList As New ArrayList
            Dim LPoint As Point = Nothing
            Dim SubDivUIDCollection As New ArrayList
            Dim CancelBulletinExpections As New ArrayList
            Dim BullUIDCollection As New ArrayList
            Dim BullExpList As New ArrayList
            Try
                If myParentForm Is Nothing Then
                    myParentForm = Me.myTrack.CurrentDrawingForm
                Else
                    LPoint = New Point(myParentForm.Left + 20, myParentForm.Top + 50)
                End If


                If myCompList IsNot Nothing AndAlso myCompList.Count > 0 Then
                    For Each Comp In myCompList
                        If Comp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(Comp, Track)
                            If trk.Bulletins.Count > 0 Then
                                Dim b As SubBulletin
                                For Each b In trk.Bulletins
                                    If Not BullList.Contains(b) Then
                                        BullList.Add(b)
                                    End If
                                Next
                            End If
                            If Not SubDivUIDCollection.Contains(trk.mySubdivision.GUID.ToString) Then SubDivUIDCollection.Add(trk.mySubdivision.GUID.ToString)
                        End If
                    Next
                End If

                ThisTrainTGBO.GetExistingExceptions(BulletinCollection)
                BullUIDCollection = TMDS.SystemUtilities.BulletinFunction.GetAllBulletinsUID(ThisTrainTGBO.BulletinListDefinitions)

                Dim HasExceptionToBeDelivered As Boolean = False
                Dim exp As TabularGeneralBulletinException
                If ThisTrainTGBO.myExceptionListOfGBOs IsNot Nothing AndAlso ThisTrainTGBO.myExceptionListOfGBOs.Count > 0 Then
                    For Each exp In ThisTrainTGBO.myExceptionListOfGBOs
                        If BullList IsNot Nothing AndAlso BullList.Count > 0 AndAlso BullList.Contains(exp.theGBO) AndAlso exp.theGBO.myType <> BulletinType.CANCEL Then
                            HasExceptionToBeDelivered = True
                            If Not BullExpList.Contains(exp.theGBO) Then BullExpList.Add(exp.theGBO)
                        ElseIf exp.theGBO IsNot Nothing AndAlso exp.theGBO.mysTypeForm = "FORM C" AndAlso exp.theGBO.TrainSymbol = Me.Name Then
                            Dim tr As TrainRestriction = Nothing
                            Dim IsValidRestriction As Boolean
                            For Each tr In Me.myRestrictionList
                                If tr.myUID = exp.theGBO.CorrelatingRestrictionUID Then
                                    IsValidRestriction = True
                                    Exit For
                                End If
                            Next
                            If IsValidRestriction Then
                                HasExceptionToBeDelivered = True
                                If Not BullExpList.Contains(exp.theGBO) Then BullExpList.Add(exp.theGBO)
                            Else
                                TrainEventLog("THIS RESTRICTION DOES NOT TO BELONG TO TRAIN OR RESTRICTION NOT FOUND IN TRAIN'S RESTRICTION LIST DROPPING RESTRICTION:" & exp.theGBO.CorrelatingRestrictionUID & "TRAIN[" & Me.Name & "]")
                            End If

                        End If
                    Next
                    'Check for FORM F EXCEPTIONS

                    MessageList = New ArrayList
                    MessageList.Add("THIS TRAIN HAS A BULLETIN EXCEPTION")
                    MessageList.Add("THAT NEEDS DELIVERED BEFORE AUTHORITY ISSUANCE.")
                    For Each exp In ThisTrainTGBO.myExceptionListOfGBOs
                        If BulletinCollection.Contains(exp.theGBO) Then
                            Dim OkToStopProcess As Boolean = False
                            If exp.theGBO.NonBlockingBulletin Then
                            ElseIf exp.theGBO.mysTypeForm = "FORM C" AndAlso exp.theGBO.TrainSymbol = Me.Name Then
                                OkToStopProcess = True
                            ElseIf exp.theGBO.SystemWideBulletin AndAlso Not exp.theGBO.mysTypeForm.Contains("C-FORM") Then
                                OkToStopProcess = True
                            ElseIf (exp.theGBO.GeneralInformationDOB OrElse exp.theGBO.GeneralInformationTGBO) AndAlso SubDivUIDCollection.Contains(exp.theGBO.SubUID.ToString) Then
                                OkToStopProcess = True
                            End If
                            If OkToStopProcess Then
                                HasExceptionToBeDelivered = True
                                If Not BullExpList.Contains(exp.theGBO) Then BullExpList.Add(exp.theGBO)
                            End If
                        End If
                    Next

                    'Dim exp As TabularGeneralBulletinException
                    For Each exp In ThisTrainTGBO.myExceptionListOfGBOs
                        Dim ValidGBOCheck As Boolean = False


                        If BullList.Contains(exp.theGBO) Then
                            Dim OkToStopProcess As Boolean = False
                            Select Case exp.theGBO.mysTypeForm.ToUpper.Trim
                                Case "C-FORM B", "C-FORM O", "C-FORM A", "C-FORM S", "C-FORM X"
                                    'CancelBulletinExpections
                                    If TMDS.SystemUtilities.BulletinFunction.CheckTGBOHasThisBulletin(BullUIDCollection, exp.theGBO.myGUID) Then
                                    ElseIf Not ThisTrainTGBO.BulletinList.Contains(exp.theGBO.myGUID) AndAlso exp.theDesignation.ToUpper.Trim = Me.Name.ToUpper.Trim AndAlso SubDivUIDCollection.Contains(exp.theGBO.SubUID.ToString) Then
                                        Dim OverrideExpAlert As Boolean = False
                                        If exp.theGBO.CompList IsNot Nothing AndAlso exp.theGBO.CompList.Count > 0 Then
                                            Dim HasOneCompInSelection As Boolean = False
                                            For Each Comp In exp.theGBO.CompList
                                                If myCompList.Contains(Comp) Then
                                                    HasOneCompInSelection = True
                                                    Exit For
                                                End If
                                            Next
                                            If Not HasOneCompInSelection Then OverrideExpAlert = True
                                        End If
                                        If Not OverrideExpAlert Then
                                            Dim BullData() As String = exp.theGBO.BulletinReadData.Split("|")
                                            Dim Limits As String = "" ' BullData(2)
                                            If BullData.Length > 1 Then
                                                Limits = BullData(2)
                                                Limits = Limits.Replace("<", "")
                                                Limits = Limits.Replace(">", "")
                                            End If
                                            'Dim ExpStr As String = exp.theGBO.mysTypeForm & " -(" & exp.theGBO.myUID & ")(" & exp.theGBO.SubName & ")"
                                            Dim ExpStr As String = GetBulletinType(exp.theGBO) & " -(" & exp.theGBO.myUID & ")(" & exp.theGBO.SubName & ")"
                                            ExpStr = ExpStr & " - (" & exp.theGBO.CancelledBulletinUID & " - " & Limits.Trim & " )"

                                            If Not CancelBulletinExpections.Contains(ExpStr) Then CancelBulletinExpections.Add(ExpStr)
                                        End If
                                    End If

                                Case "C-FORM F"
                                    Dim AddCFORMFsToList As Boolean = False
                                    If exp.theGBO.NonBlockingBulletin Then
                                    ElseIf exp.theGBO.SystemWideBulletin Then
                                        AddCFORMFsToList = True
                                    ElseIf (exp.theGBO.GeneralInformationDOB OrElse exp.theGBO.GeneralInformationTGBO) AndAlso SubDivUIDCollection.Contains(exp.theGBO.SubUID.ToString) Then
                                        AddCFORMFsToList = True
                                    End If
                                    If AddCFORMFsToList Then
                                        If TMDS.SystemUtilities.BulletinFunction.CheckTGBOHasThisBulletin(BullUIDCollection, exp.theGBO.myGUID) Then
                                        ElseIf Not ThisTrainTGBO.BulletinList.Contains(exp.theGBO.myGUID) AndAlso exp.theDesignation.ToUpper.Trim = Me.Name.ToUpper.Trim Then
                                            HasExceptionToBeDelivered = True
                                            'Dim BullData() As String = exp.theGBO.BulletinReadData.Split("|")

                                            'Dim ExpStr As String = exp.theGBO.mysTypeForm & " - (" & exp.theGBO.myUID & ") (" & exp.theGBO.SubName & ")"
                                            Dim ExpStr As String = GetBulletinType(exp.theGBO) & " - (" & exp.theGBO.myUID & ") (" & exp.theGBO.SubName & ")"

                                            'ExpStr = BullData(1) & Space(1) & BullData(2)
                                            If Not CancelBulletinExpections.Contains(ExpStr) Then CancelBulletinExpections.Add(ExpStr)
                                        End If
                                    End If



                                Case "FORM F"
                                    If exp.theGBO.NonBlockingBulletin Then
                                    ElseIf exp.theGBO.SystemWideBulletin Then
                                        OkToStopProcess = True
                                    ElseIf (exp.theGBO.GeneralInformationDOB OrElse exp.theGBO.GeneralInformationTGBO) AndAlso SubDivUIDCollection.Contains(exp.theGBO.SubUID.ToString) Then
                                        OkToStopProcess = True
                                    End If
                                Case "C-FORM C"
                                    If exp.theGBO.CompList IsNot Nothing AndAlso exp.theGBO.CompList.Count > 0 Then
                                        For Each Comp In exp.theGBO.CompList
                                            If myCompList.Contains(Comp) Then
                                                'HasExceptionToBeDelivered = True
                                                If Not CancelBulletinExpections.Contains(exp.theGBO) Then CancelBulletinExpections.Add(exp.theGBO)
                                                Exit For
                                            End If
                                        Next
                                    ElseIf exp.theGBO.SystemWideBulletin Then
                                        'HasExceptionToBeDelivered = True
                                        Dim ExpStr As String = GetBulletinType(exp.theGBO) & " - (" & exp.theGBO.myUID & ") (" & exp.theGBO.SubName & ")"
                                        If Not CancelBulletinExpections.Contains(ExpStr) Then CancelBulletinExpections.Add(ExpStr)
                                    End If
                            End Select
                            If OkToStopProcess Then
                                If TMDS.SystemUtilities.BulletinFunction.CheckTGBOHasThisBulletin(BullUIDCollection, exp.theGBO.myGUID) Then
                                ElseIf Not ThisTrainTGBO.BulletinList.Contains(exp.theGBO.myGUID) AndAlso exp.theDesignation.ToUpper.Trim = Me.Name.ToUpper.Trim Then
                                    HasExceptionToBeDelivered = True
                                    If Not BullExpList.Contains(exp.theGBO) Then BullList.Add(exp.theGBO)
                                End If
                            End If
                        End If
                    Next



                    If HasExceptionToBeDelivered Then
                        Dim sb As SubBulletin
                        For Each sb In BullExpList
                            'Dim ExpStr As String = sb.mysTypeForm & " - (" & sb.myUID & ") (" & sb.SubName & ")"
                            Dim ExpStr As String = GetBulletinType(sb) & " - (" & sb.myUID & ") (" & sb.SubName & ")"
                            MessageList.Add(ExpStr)
                        Next
                        MessageList.Add("")
                        MessageList.Add("WOULD YOU LIKE TO DELIVER THESE BULLETINS?")
                        If ShowCustomMessageBox(MessageList, "BULLETIN VALIDATION", True, LPoint, False, True, myParentForm) <> 6 Then
                            Return False
                        Else
                            For Each sb In BullExpList
                                If Not DeliverBulletinViaBulletinHMI(sb, myParentForm) Then Return False
                            Next
                        End If
                        MessageList = New ArrayList
                    End If
                End If

                If CancelBulletinExpections IsNot Nothing AndAlso CancelBulletinExpections.Count > 0 Then
                    MessageList = New ArrayList
                    MessageList.Add("THIS TRAIN HAS ONE OR MORE CANCEL BULLETIN EXCEPTION(s)")

                    MessageList.Add("")

                    Dim Str As String = ""
                    For Each Str In CancelBulletinExpections
                        MessageList.Add(Str)
                    Next
                    ShowCustomMessageBox(MessageList, "EXCEPTION INFORMATION", False, LPoint, True, True, myParentForm)
                End If


                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                CancelBulletinExpections = Nothing
                BullExpList = Nothing
                SubDivUIDCollection = Nothing
                Comp = Nothing
                BullList = Nothing
                MessageList = Nothing
                LPoint = Nothing
                BullUIDCollection = Nothing
                SubDivUIDCollection = Nothing
                SubDivUIDCollection = Nothing
            End Try

        End Function

