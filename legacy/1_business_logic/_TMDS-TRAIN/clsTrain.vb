        Public Function GetLastTrack() As Track
            Dim comp As Object
            Dim TrkCollection As New ArrayList
            Try
                For Each comp In gEntExtTrackSelection
                    TrkCollection.Add(comp)
                Next
                TrkCollection.Reverse()
                For Each comp In TrkCollection
                    If comp.GetType.ToString = gTrackComponentName Then
                        If comp.OSReporting Then Return comp
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                TrkCollection = Nothing
            End Try
            Return Nothing
        End Function

        ''' <summary>
        ''' Cancel Pass Red Signal Authority
        ''' </summary>
        ''' <param name="pForceRelease"></param>
        ''' <param name="pLeaveDirectionalTraffic"></param>
        ''' <param name="pRemoveStopTarget"></param>
        Public Function CancelPassRedSignalAuthority(Optional ByVal pForceRelease As Boolean = False, Optional ByVal pLeaveDirectionalTraffic As Boolean = False, Optional pRemoveStopTarget As Boolean = False) As Boolean
            Dim headerText As String = mstrPSSCancelTitle
            Dim frmMessageBox As frmMessageBox
            Dim messageList As New ArrayList()
            Dim releaseConfirmed As Boolean
            Try
                TrainEventLog("CancelPassRedSignalAuthority")
                If Not pForceRelease Then
                    If pRemoveStopTarget Then
                        If Not optUseEngineIDOnPSSEMTCancel Then
                            messageList.Add("CANCEL " & gPermissionToRemoveStopTargetText & " AUTHORITY FOR TRAIN -" & Space(1) & Me.Name)
                        Else
                            messageList.Add("CANCEL " & gPermissionToRemoveStopTargetText & " AUTHORITY FOR TRAIN -" & Space(1) & Me.IdentifingUnit)
                        End If
                        headerText = "CANCEL " & gPermissionToRemoveStopTargetText
                    Else
                        If Not optUseEngineIDOnPSSEMTCancel Then
                            messageList.Add("CANCELAR LICENÇA ESPECIAL PARA O TREM" & Space(1) & Me.Name)
                        Else
                            messageList.Add("CANCELAR LICENÇA ESPECIAL PARA O TREM" & Space(1) & Me.IdentifingUnit)
                        End If
                    End If
                    messageList.Add(mstrPSSCancelLine2)
                    messageList.Add("")
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = TMDS.SystemForms.MySystemForms.frmMainMDI
                    frmMessageBox.SetMessage(messageList, headerText, True, Me.myTrack.CurrentDrawingForm.myLaunchPoint)
                    frmMessageBox.ShowDialog()
                    If frmMessageBox.FormFeedBack = 6 Then
                        releaseConfirmed = True
                    End If
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                End If
                If releaseConfirmed Or pForceRelease Then
                    If Me.GeoFenceLegacyEnabled Then
                        Dim RemoveList As New ArrayList
                        Dim sa As TrackAuthority.OtherSpecialAuthorityType
                        For Each sa In gOtherSpecialAuthorityCollection
                            If sa.TrainSymbol = Me.Name And sa.SubType = "PSS" Then
                                If Me.IsActivePTC Then
                                    sa.VETMS_PerformRelease(Me)
                                Else
                                    RemoveList.Add(sa)
                                End If
                            End If
                        Next
                        For Each sa In RemoveList
                            sa.RemoveAuthorityFromSystem(pLeaveDirectionalTraffic)
                        Next
                    ElseIf optEnablePTCBOSVETMSMode AndAlso Me.IsActivePTC Then
                        Dim sa As TrackAuthority.OtherSpecialAuthorityType
                        For Each sa In gOtherSpecialAuthorityCollection
                            If sa.TrainSymbol = Me.Name And sa.SubType = "PSS" Then
                                sa.VETMS_PerformRelease(Me)
                            End If
                        Next
                    ElseIf optEnablePTCBOSVETMSMode AndAlso Not Me.IsActivePTC Then
                        Dim RemoveList As New ArrayList
                        Dim sa As TrackAuthority.OtherSpecialAuthorityType
                        For Each sa In gOtherSpecialAuthorityCollection
                            If sa.TrainSymbol = Me.Name And sa.SubType = "PSS" Then
                                RemoveList.Add(sa)
                            End If
                        Next
                        If RemoveList IsNot Nothing AndAlso RemoveList.Count > 0 Then
                            For Each sa In RemoveList
                                sa.RemoveAuthorityFromSystem(pLeaveDirectionalTraffic)
                            Next
                        End If
                    ElseIf Not Me.GeoFenceLegacyEnabled AndAlso Not Me.IsActivePTC Then
                        Dim RemoveList As New ArrayList
                        Dim sa As TrackAuthority.OtherSpecialAuthorityType
                        For Each sa In gOtherSpecialAuthorityCollection
                            If sa.TrainSymbol = Me.Name And sa.SubType = "PSS" Then
                                RemoveList.Add(sa)
                            End If
                        Next
                        For Each sa In RemoveList
                            sa.RemoveAuthorityFromSystem(pLeaveDirectionalTraffic)
                        Next
                    End If
                End If
                Return releaseConfirmed
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

