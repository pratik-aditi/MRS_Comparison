        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Function IsUnitEnabledForGPS(UnitToCheck As String) As Boolean
            Dim theUnit As TrainUnit = Nothing
            Try
                For Each theUnit In Me.UnitsInTrain
                    If theUnit.UnitNumber = UnitToCheck Then
                        If theUnit.GPSCapable Then
                            Return True
                        Else
                            Return False
                        End If

                    End If
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                theUnit = Nothing
            End Try
        End Function


