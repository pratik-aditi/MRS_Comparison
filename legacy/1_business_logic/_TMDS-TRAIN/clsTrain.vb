        Private Sub CreateTrainScheduleAlert()

            Dim dtSCH As New DataTable
            Dim IsValidToProcessAlert As Boolean = False
            Dim FinalStationName As String = ""
            Dim TimeDelay As Integer = 0
            Dim LastStation As String = ""
            Dim subStat As SubdivisionStation = Nothing
            Dim StationControlPoint As ControlPoint = Nothing
            Dim StationCPGUID As String = "NOTHING"
            Dim TrnFirstLetter As String = ""
            Dim CPName As String = ""

            Try
                dtSCH = TMDS.SystemUtilities.FetchData.GetTrainSchedulerDatatable(Me)
                If dtSCH IsNot Nothing AndAlso dtSCH.Rows.Count > 0 Then
                    Dim dv As DataView = New DataView(dtSCH, "", "OrderIndex DESC", DataViewRowState.OriginalRows)
                    If dv IsNot Nothing AndAlso dv.Count > 0 Then
                        FinalStationName = dv(0)("Station")
                        For i As Integer = 0 To dv.Count - 1
                            Dim Processed As Boolean
                            Dim ShowAlert As Boolean = False
                            'ShowAlert
                            Boolean.TryParse(dv(i)("Processed"), Processed)
                            Boolean.TryParse(dv(i)("ShowAlert"), ShowAlert)
                            If Processed AndAlso ShowAlert Then
                                TimeDelay = System.Math.Abs(dv(i)("Delay"))
                                LastStation = dv(i)("Station")
                                If TimeDelay > 0 Then IsValidToProcessAlert = True
                                Exit For
                            End If
                        Next
                        If IsValidToProcessAlert Then
                            'Dim AlertMessage As String = "TRAIN (" & Me.Name & ")| LATE AT STATION [" & LastStation & "] AND LATE BY (" & TimeDelay & ") MINUTES.|TO ITS FINAL DESTINATION (" & FinalStationName & ")."
                            'Dim AlertMessage As String = "TRAIN (" & Me.Name & ")| LATE AT STATION [" & LastStation & "] AND LATE BY (" & TimeDelay & ") MINUTES.|TO ITS FINAL DESTINATION (" & FinalStationName & ")."
                            Dim AlertMessage As String = "TRAIN (" & Me.Name & ")|DELAYED TO STATION [" & LastStation & "] BY (" & TimeDelay & ") MINUTES.|FINAL DESTINATION IS (" & FinalStationName & ")."
                            Dim al As Alert
                            For Each al In gSystemAlertList
                                If al.AlertData = AlertMessage Then
                                    Exit Sub
                                End If
                            Next
                            TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.TRAIN_SCHEDULER_ALERT, AlertMessage, Me)
                        End If
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

        End Sub

        Private Function CheckForAlertExtistence(ByVal theAlertMessage As String) As Boolean
            Try
                Dim al As Alert
