        Public Sub PerformTrainCarLoading()
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim query As New StringBuilder
            Dim Mess As New StringBuilder("******* CAR CONSIST FOR " & Me.Name & "********************")
            Try
                Me.myCarList.Clear()
                Me.myCarList = New ArrayList
                'query = New StringBuilder("SELECT UID, CarUID, CarTons, CarLength, CarAxles, CarNumOperateBrakes, LoadStatus, CarPositionIndex, CarComments, MIS_Information FROM tblTrainConsistActive WHERE RailroadUID = '" & EntityUID & "' ORDER BY CarPositionIndex")
                query = New StringBuilder("SELECT UID, CarUID, CarTons, CarLength, CarAxles, CarNumOperateBrakes, LoadStatus, CarPositionIndex, CarComments, MIS_Information FROM tblTrainConsistActive WHERE [TrainSymbol] = '" & Me.Name & "' ORDER BY CarPositionIndex")
                Using dbconn As New OleDbConnection(gConnectionStringTrain)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(query.ToString, dbconn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        Dim tc As New TrainCar

                        If Not dr.IsDBNull(0) Then tc.myUID = dr.GetString(0)
                        If Not dr.IsDBNull(1) Then tc.CarUID = dr.GetString(1)
                        If Not dr.IsDBNull(2) Then tc.CarTons = dr.GetInt32(2)
                        If Not dr.IsDBNull(3) Then tc.CarLength = dr.GetInt32(3)
                        If Not dr.IsDBNull(4) Then tc.CarAxles = dr.GetInt32(4)
                        If Not dr.IsDBNull(5) Then tc.CarNumOperateBrakes = dr.GetInt32(5)
                        If Not dr.IsDBNull(6) Then tc.LoadStatus = dr.GetString(6)
                        If Not dr.IsDBNull(7) Then tc.CarPositionIndex = dr.GetInt32(7)
                        If Not dr.IsDBNull(8) Then tc.CarComments = dr.GetString(8)
                        If Not dr.IsDBNull(9) Then tc.MISInfo = dr.GetString(9)
                        tc.myTrain = Me
                        Me.myCarList.Add(tc)
                        'SystemException(tc.CarUID)
                        Mess.Append("CAR ADDED [" & tc.CarUID & "] ")
                    End While
                    dr.Close()
                    dbconn.Close()
                End Using
                Mess.Append("**************************************************************")
                TrainEventLog(Mess.ToString)
            Catch ex As Exception
                SystemException(ex.ToString)
                'dbconn = Nothing
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                dr = Nothing
                Mess = New StringBuilder
            End Try
        End Sub

