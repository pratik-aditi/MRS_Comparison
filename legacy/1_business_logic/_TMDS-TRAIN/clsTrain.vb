        ''' <summary>
        ''' Create Tabular GeneralBulletin
        ''' </summary>
        ''' <param name="locomotiveId">locomotive Id</param>
        ''' <returns>Return a object with data for tabular general bulletin</returns>
        Private Function CreateTabularGeneralBulletin(locomotiveId As String) As TabularGeneralBulletin
            Try
                TrainEventLog($"{GetCurrentMethod.Name}:LocomotiveId={locomotiveId}")
                Dim theBulletin As New TabularGeneralBulletin With {
                    .BulletinCellRoute = .GetBulletinCellRoute("MRS-01"),
                    .CreateTime = Now,
                    .SystemUID = Guid.NewGuid.ToString.ToUpper,
                    .UID = locomotiveId,
                    .RouteCodeName = "MRS-01",
                    .TypeOfBulletin = "TRAINROUTE",
                    .IssuedTo = Name,
                    .AtSubdivisionUID = 0,
                    .AtSubdivisionName = "STEEL",
                    .TimeZone = "B",
                    .AtLocationName = "NONE",
                    .AtLocationUID = 0,
                    .EffectiveDate = Now,
                    .FaxPrintLocations = "NONE",
                    .SpecificInstuctions = "NONE",
                    .MileageRangeList = .GetMileageRanges(.BulletinCellRoute),
                    .TGBOCreator = gCurrentUser.Initials,
                    .TGBOAddress = Name,
                    .BulletinList = New ArrayList,
                    .Status = "ACTIVE",
                    .OKTime = Now
                }
                Select Case SubID
                    Case "3", "4" 'MRS-PG LINE AND STEEL LINE (CBTC)
                        'TODO - Remove hard code and use route code from database like ME. Need to changes in track DB
                        theBulletin.RouteCodeUID = "2"
                    Case "2", "7" 'MRS-CENTRAL LINE (TWE)
                        'TODO - Remove hard code and use route code from database like ME. Need to changes in track DB
                        theBulletin.RouteCodeUID = "3"
                    Case Else
                        Dim data As DataTable = gRepositories.TrainRepository.GetRouteCode(Name)
                        If data?.Rows.Count > 0 AndAlso
                            Not data.Rows(0).IsNull("RouteCode") Then
                            theBulletin.RouteCodeUID = data.Rows(0)("RouteCode").ToString
                        Else
                            TrainEventLog($"{GetCurrentMethod.Name} Route code not found")
                        End If
                End Select
                TrainEventLog($"{GetCurrentMethod.Name} Route code={theBulletin.RouteCodeUID}")
                Dim newMileageRangeList As String = String.Empty
                For Each oneMileage As MileageRange In theBulletin.MileageRangeList
                    If String.IsNullOrEmpty(newMileageRangeList) Then
                        newMileageRangeList = $"{oneMileage.myUID};{oneMileage.myName};{oneMileage.mySubdivisionUID _
                            };{oneMileage.mySubdivisionName};{oneMileage.LeftMileage};{oneMileage.LeftMileageSuffix _
                            };{oneMileage.RightMileage};{oneMileage.RightMileageSuffix _
                            };{oneMileage.LeftMileagePrefix.Trim};{oneMileage.RightMileagePrefix.Trim}"
                    Else
                        newMileageRangeList = $"{newMileageRangeList}|{oneMileage.myUID};{oneMileage.myName _
                            };{oneMileage.mySubdivisionUID};{oneMileage.mySubdivisionName};{oneMileage.LeftMileage _
                            };{oneMileage.LeftMileageSuffix};{oneMileage.RightMileage};{oneMileage.RightMileageSuffix _
                            };{oneMileage.LeftMileagePrefix.Trim};{oneMileage.RightMileagePrefix.Trim}"
                    End If
                Next
                theBulletin.MileageRangeListDefinitions = newMileageRangeList
                Return theBulletin
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
        End Function

