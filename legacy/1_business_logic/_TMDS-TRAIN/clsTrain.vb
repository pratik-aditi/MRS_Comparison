        Public Function GetRearTrack(Optional ByVal RearMP As Double = 0, Optional ByVal RearMPSuffix As String = "") As Track
            Dim HeadEnd As Double = 0.0
            Dim RearEnd As Double = 0.0
            Dim RearEndSuffix As String = ""
            Dim MyHeadRrackName As String = Me.myTrack.TrackName
            Dim MyRearTrackName As String = ""
            Dim MyCalculatedMP As Double = 0
            Dim MyCalculatedMPSuffix As String = ""
            Dim MyRearTrackCollection As New ArrayList
            Dim trk As Track = Nothing
            Dim MyRearTrack As Track = Nothing
            Dim LowMile As Boolean = False
            Try
                Double.TryParse(Me.MilePost, HeadEnd)
                If Me.OLength = 0 Then Return Nothing
                If HeadEnd = 0 Then Return Nothing
                Double.TryParse(RearMP, RearEnd)

                If Not String.IsNullOrEmpty(RearMPSuffix) Then RearEndSuffix = RearMPSuffix.Trim

                If RearEnd > 0 Then
                    MyRearTrackCollection = GetTrackList(RearEnd, RearMPSuffix, RearEnd, RearMPSuffix)
                Else
                    Select Case GetSearchableTrainDirection(Me.Direction.Trim.ToUpper)
                        Case "RIGHT"
                            If Me.myTrack.RightLimitMilePost > Me.myTrack.LeftLimitMilePost Then
                            Else
                                LowMile = True
                            End If
                        Case "LEFT"
                            If Me.myTrack.RightLimitMilePost > Me.myTrack.LeftLimitMilePost Then LowMile = True
                    End Select
                    If LowMile Then
                        MyCalculatedMP = (HeadEnd - ConvertMetersToKilometers(Me.OLength))
                    Else
                        MyCalculatedMP = (HeadEnd + ConvertMetersToKilometers(Me.OLength))
                    End If
                    If MyCalculatedMP > 0 Then
                        MyRearTrackCollection = GetTrackList(MyCalculatedMP, MyCalculatedMPSuffix, MyCalculatedMP, MyCalculatedMPSuffix)
                    Else
                        Return Nothing
                    End If

                End If

                If MyRearTrackCollection Is Nothing Then Return Nothing
                For Each trk In MyRearTrackCollection
                    If trk.Occuppied AndAlso trk.LeftLimitMilePost > 0 AndAlso trk.RightLimitMilePost > 0 Then
                        MyRearTrack = trk
                    End If
                Next
                Return MyRearTrack


            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                MyRearTrackCollection = Nothing
                trk = Nothing
            End Try
            Return Nothing
        End Function

        Public Function GetBeginningTrackOfEntireTrain() As Track
            Dim FirstTrackInBlock As Track = Me.myTrack
            Dim NextComp As Object = Me.myTrack
            Dim FoundFlipFlop As Boolean
            Dim LastComp As Object = Nothing
            Dim LoopControl As Integer
            Try
                Dim theDirection As String = String.Empty
                Select Case Me.Direction
                    Case optDirectionNorth
                        theDirection = "RIGHT"
                    Case optDirectionSouth
                        theDirection = "LEFT"
                End Select
                TrainEventLog("GetBeginningTrackOfEntireTrain:TheDirection=" & theDirection & ":NextComp=" & NextComp.GUID & ":" & NextComp.Name)
                If Not Me.GeoFenceLegacyEnabled And Not IsNothing(Me.myRearEndTrack) Then
                    TrainEventLog("GetBeginningTrackOfEntireTrain:myRearEndTrack=" & Me.myRearEndTrack.Name)
                    Return ConfirmRearEndIncudesSwitchTracks()
                End If
                Do Until LoopControl > 50

                    Select Case theDirection
                        Case "RIGHT"
                            TrainEventLog("GetBeginningTrackOfEntireTrain:R-Nextcomp=" & NextComp.GUID & ":" & NextComp.Name)

                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(NextComp, Signal)
                                If FoundFlipFlop Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If

                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)
                                If sw.LeftAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                            ElseIf NextComp.GetType.ToString = gTrackComponentName AndAlso (NextComp.IsControlledForPTC OrElse NextComp.IsEntryForPTC OrElse Me.GeoFenceLegacyEnabled OrElse NextComp.IsTestForPTC) Then
                                Dim trk As Track = CType(NextComp, Track)

                                If trk.IsRemoteTrack Then
                                    TrainEventLog("GetBeginningTrackOfEntireTrain:R-IsRemoteTrack=" & trk.GUID)
                                    Return FirstTrackInBlock
                                End If
                                If trk.OStype AndAlso trk.NonTransverable Then
                                    TrainEventLog("GetBeginningTrackOfEntireTrain:R-NonTransverable=" & trk.GUID)
                                    Return FirstTrackInBlock
                                End If
                                If Not trk.Occuppied OrElse trk.IsEntryForPTC Then
                                    TrainEventLog("GetBeginningTrackOfEntireTrain:R-NotOccuppied=" & trk.GUID)
                                    Return FirstTrackInBlock
                                ElseIf trk.Occuppied And trk.TrainIDs.Count > 0 Then
                                    Dim trn As TrainID
                                    For Each trn In trk.TrainIDs
                                        If trn.Name <> Me.Name Then
                                            If Not IsNothing(Me.myRearEndTrack) AndAlso (trk.GUID = Me.myRearEndTrack.GUID) Then
                                                TrainEventLog("GetBeginningTrackOfEntireTrain:R-HasTrain1=" & trk.GUID)
                                                Return trk
                                            Else
                                                TrainEventLog("GetBeginningTrackOfEntireTrain:R-HasTrain2=" & trk.GUID)
                                                Return FirstTrackInBlock
                                            End If
                                        End If
                                    Next
                                End If
                                FirstTrackInBlock = NextComp

                                If FoundFlipFlop Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If

                            ElseIf NextComp.GetType.ToString = gFlipFlopComponentName Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                FoundFlipFlop = True
                                Me.FoundFlipFlopForSearch = True
                            End If

                        Case "LEFT"
                            TrainEventLog("GetBeginningTrackOfEntireTrain:L-Nextcomp=" & NextComp.GUID & ":" & NextComp.Name)

                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(NextComp, Signal)

                                If FoundFlipFlop Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                                'NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)
                                If sw.RightAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            ElseIf NextComp.GetType.ToString = gTrackComponentName AndAlso (NextComp.IsControlledForPTC OrElse NextComp.IsEntryForPTC OrElse Me.GeoFenceLegacyEnabled OrElse NextComp.IsTestForPTC) Then
                                Dim trk As Track = CType(NextComp, Track)

                                If trk.IsRemoteTrack Then
                                    TrainEventLog("GetBeginningTrackOfEntireTrain:L-IsRemoteTrack=" & trk.GUID)
                                    Return FirstTrackInBlock
                                End If
                                If trk.OStype AndAlso trk.NonTransverable Then
                                    TrainEventLog("GetBeginningTrackOfEntireTrain:L-NonTransverable=" & trk.GUID)
                                    Return FirstTrackInBlock
                                End If
                                If Not trk.Occuppied OrElse trk.IsEntryForPTC Then
                                    TrainEventLog("GetBeginningTrackOfEntireTrain:L-NotOccuppied=" & trk.GUID)
                                    Return FirstTrackInBlock
                                ElseIf trk.Occuppied And trk.TrainIDs.Count > 0 Then
                                    Dim trn As TrainID
                                    For Each trn In trk.TrainIDs
                                        If trn.Name <> Me.Name Then
                                            If Not IsNothing(Me.myRearEndTrack) AndAlso (trk.GUID = Me.myRearEndTrack.GUID) Then
                                                TrainEventLog("GetBeginningTrackOfEntireTrain:R-HasTrain1=" & trk.GUID)
                                                Return trk
                                            Else
                                                TrainEventLog("GetBeginningTrackOfEntireTrain:R-HasTrain2=" & trk.GUID)
                                                Return FirstTrackInBlock
                                            End If
                                        End If
                                    Next
                                End If
                                FirstTrackInBlock = NextComp

                                If FoundFlipFlop Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If


                            ElseIf NextComp.GetType.ToString = gFlipFlopComponentName Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                FoundFlipFlop = True
                                Me.FoundFlipFlopForSearch = True
                            End If

                    End Select
                    LoopControl += 1
                Loop

                TrainEventLog("GetBeginningTrackOfEntireTrain=Nothing")

                Return Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try

        End Function

