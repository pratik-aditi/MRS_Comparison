        Public PTCTimerIssuance As Timers.Timer
        Public PTCConsistDeliverySuccessful As Boolean
        Public PTCIssuanceTimeExpired As Boolean

        Public Sub VETMS_PerformConsistUpdate()
            Try
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainConsistChange(Me, "VETMS_PerformConsistUpdate")
                VETMS_CreateTimerIssuanceEvent()
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Private Sub VETMS_CreateTimerIssuanceEvent()
            Try
                PTCIssuanceTimeExpired = False
                If IsNothing(PTCTimerIssuance) Then
                    PTCTimerIssuance = New Timers.Timer(gPTCTimeOutTransmissionAuthorityIssuance)
                    AddHandler PTCTimerIssuance.Elapsed, AddressOf VETMS_CheckStatusIssuance
                    PTCTimerIssuance.Enabled = True
                Else
                    PTCTimerIssuance.Start()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub VETMS_CheckStatusIssuance(ByVal source As Object, ByVal e As Timers.ElapsedEventArgs)
            Try
                If Not PTCConsistDeliverySuccessful Then
                    VETMS_GenerateAlertForFailedIssaunce()
                End If
                PTCIssuanceTimeExpired = True
                VETMS_TerminatePTCTimerIssuance()
            Catch ex As Exception
                SystemException(ex.ToString)
                PTCIssuanceTimeExpired = True
            End Try
        End Sub

        Public Sub VETMS_TerminatePTCTimerIssuance()
            Try
                Me.PTCConsistDeliverySuccessful = False
                If IsNothing(PTCTimerIssuance) Then Exit Sub
                PTCTimerIssuance.Stop()
                RemoveHandler PTCTimerIssuance.Elapsed, AddressOf VETMS_CheckStatusIssuance
                PTCTimerIssuance.Enabled = False
                PTCTimerIssuance.Dispose()
                PTCTimerIssuance = Nothing
                Dim SummItem As New SummaryItem("TRAIN", "FORCE-REFRESH", Nothing)
                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                End SyncLock


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub VETMS_GenerateAlertForFailedIssaunce()
            Try
                Dim AlertMessage As String = "ELECTRONIC CONSIST CHANGE TO TRAIN (" & Me.Name & ") FAILED. | PLEASE RE-TRY THE ISSUANCE REQUEST!"
                If Not CheckForAlertExtistence(AlertMessage) Then
                    Dim al As Alert = TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.VETMS_PTC_ConsistUpdateRequestFailed, AlertMessage, Me)
                End If


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub VETMS_TerminatePTCIssuanceProcess()
            Try
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub VETMS_GenerateIssuanceFailure()
            Try
                If Not PTCConsistDeliverySuccessful Then
                    VETMS_GenerateAlertForFailedIssaunce()
                End If
                VETMS_TerminatePTCTimerIssuance()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub PTCConsistTransmissionCompleted()
            Try
                If Not PTCConsistDeliverySuccessful Then
                    VETMS_GenerateAlertForFailedIssaunce()
                End If
                VETMS_TerminatePTCTimerIssuance()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

