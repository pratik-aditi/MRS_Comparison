                End With
                Dim SummItem As New SummaryItem("SPLAUTHORITY", "ADD", SplAuth)
                SyncLock gSummaryAuthQueue
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock


                If optEnableAutomaticRemovalOfPRSEMT Then
                    comp = Nothing
                    For Each comp In SplAuth.ComponentsInSelection
                        If Not comp.OtherSplAuthorities.Contains(SplAuth) Then
                            'compToBlock.DeviceBlocked = True
                            'compToBlock.BlockAbsolute = True
                            'compToBlock.BlockAbsolutePrevious = True
                            comp.SplAuthorityBlock = True
                            If optEnableTrackTimeDisplayonCodeBrown Or optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then
                                comp.OverRideCodeBrown = True
                            End If
                            comp.OtherSplAuthorities.Add(SplAuth)
                            comp.updateStatus()
                        End If
                    Next
                End If

                Return myGUID
                'frmMessageBox.theSignal = theSignal
                'frmMessageBox.theTrain = Me
                'frmMessageBox.theTrack = theEnterTrack
                'frmMessageBox.EMT_PRSCompList = gEntExtTrackSelection
                'frmMessageBox.PassRedSignal = True
                'frmMessageBox.EMT_PRSType = "PRS"
                'frmMessageBox.EMT_PRSIssueTo = Me.IdentifingUnit
                'frmMessageBox.EMT_PRSTrainGUID = Me.TrainGUID
                '3	AuthGUID	nvarchar	50	0
                '0	AuthTimeStamp	datetime	8	1
                '0	AuthType	nvarchar	25	1
                '0	AuthUID	char	10	1
                '0	TerrUID	int	4	1
                '0	Components	nvarchar	1000	1
                '0	TrainSymbol	nvarchar	25	1
                '0	IdentifingUnit	nvarchar	25	1
                '0	AuthorityVerbiage	nvarchar	2000	1
                '0	AuthorityData	nvarchar	2000	1
                '0	IssuedFromWorkstation	nvarchar	10	1



            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return String.Empty
            Finally
                comp = Nothing
            End Try
        End Function

