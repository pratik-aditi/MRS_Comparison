        Public ReadOnly Property EngineID() As String
            Get
                Dim strReturn As New StringBuilder
                If MarkCode.Trim <> String.Empty Then
                    strReturn.Append(MarkCode.Trim.PadRight(4, " "))
                End If
                If EquipmentID.Trim <> String.Empty Then
                    strReturn.Append(CInt(EquipmentID.Trim.PadLeft(5, "0")))
                End If
                Return (strReturn.ToString)
            End Get
        End Property

        Public ReadOnly Property LocomotiveDefinition() As String
            Get
                Dim strReturn As New StringBuilder
                With strReturn
                    Try
                        .Append(EngineID)
                        .Append(" ")
                        If Orientation.Trim <> String.Empty Then
                            .Append(Orientation)
                        End If
                        If MechanicalStatusCode.Trim <> String.Empty Then
                            .Append(GetCode(MechanicalStatusCode))
                        End If
                        If DeadHeadIndicator.Trim <> String.Empty Then
                            .Append(DeadHeadIndicator)
                        End If
                    Catch ex As Exception
                        SystemException(ex.ToString)
                    End Try
                End With
                Return strReturn.ToString
            End Get
        End Property

        Private Function GetCode(ByVal MSC As String) As String
            Dim RetStr As String = MSC
            Try
                If MSC <> String.Empty Then
                    Select Case MSC.ToUpper
                        Case "PARTIAL"
                            RetStr = "p"
                        Case "ISOLATED"
                            RetStr = "i"
                        Case "OKAY"
                            RetStr = "o"
                        Case "DEAD"
                            RetStr = "d"
                        Case "TRIAL"
                            RetStr = "t"
                    End Select
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return RetStr
        End Function

    End Class

