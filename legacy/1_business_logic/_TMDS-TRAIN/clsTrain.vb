        Public Sub AddTrainEvent(ByVal theType As String, ByVal theData As String, ByVal thePointUID As String, ByVal theGUID As String, IdentifingPointUID As String, Optional OsEventTime As String = "")
            Try
                Dim te As New TrainEvent
                te.myUID = theGUID
                te.EventType = theType
                te.EventData = theData
                te.IdentifingPointName = thePointUID
                Integer.TryParse(IdentifingPointUID, te.IdentifingPointUID)
                If OsEventTime.Trim <> "" Then
                    te.EventTimeStamp = CDate(OsEventTime)
                Else
                    te.EventTimeStamp = Now
                End If

                Me.myEventList.Insert(0, te)

                If optEnableARRCSpecificOptions Then
                    Dim ECount As Integer = 0
                    If te IsNot Nothing Then
                        If te.EventType.Trim.ToUpper = "TRAIN OS EVENT ARRIVAL" Then
                            MyTrainOSReportingMSGEdition = MyTrainOSReportingMSGEdition + 1
                        ElseIf te.EventType.Trim.ToUpper = "TRAIN OS EVENT DEPARTURE" Then
                            MyTrainOSReportingMSGEdition = MyTrainOSReportingMSGEdition + 1
                        End If
                    End If

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
