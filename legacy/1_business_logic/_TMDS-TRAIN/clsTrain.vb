                TrainIDUpdateSQL = TrainIDUpdateSQL & " SET TrainIsNotActive = " & CInt(Me.TrainInActive)
                TrainIDUpdateSQL = TrainIDUpdateSQL & " WHERE Symbol = " & q & Name & q
                TrainIDUpdateSQL = TrainIDUpdateSQL & " and ActiveSubTrainSheet = " & q & Me.ActiveTrainSheetGUID & q
                TrainIDUpdateSQL = TrainIDUpdateSQL & " ; "

                SystemDatabaseCommandToDynamicTrain("TRAINID:UpdateTrainActiveStatusToDB", TrainIDUpdateSQL)
                Dim EventString As String = ""

                Select Case Me.TrainInActive
                    Case True
                        EventString = "SYMBOL: " & Me.Name & " - CONTROLLING ENGINE: " & Me.IdentifingUnit.ToUpper.Trim & " - STATUS: ENGINE DE-ACTIVATED"
                    Case Else
                        EventString = "SYMBOL: " & Me.Name & " - CONTROLLING ENGINE: " & Me.IdentifingUnit.ToUpper.Trim & " - STATUS: ENGINE ACTIVATED"
                End Select
                Me.AddTrainSheetEvent("TRAIN EVENT", Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, "NONE")





            Catch ex As Exception
                GetErrorDetails(ex, "TRAINID:UpdateTrainActiveStatusToDB " & TrainIDUpdateSQL)
            End Try
        End Sub

