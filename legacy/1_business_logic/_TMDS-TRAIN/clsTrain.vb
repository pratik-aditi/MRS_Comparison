        Public Sub CleanMyAlerts()
            Dim tmpAlertsCollection As New ArrayList
            Dim tmpAlertsCollectionToRemove As New ArrayList
            Dim MessageList As New StringBuilder
            Dim al As Alert = Nothing
            Try
                CopyArrayCollection(tmpAlertsCollection, TMDS.GlobalDeclarations.gSystemAlertList)
                If tmpAlertsCollection IsNot Nothing AndAlso tmpAlertsCollection.Count > 0 Then
                    For Each al In tmpAlertsCollection
                        Dim alData() As String = al.AlertData.Split("|")
                        If al.AlertData.Contains(Me.Name) Then
                            If Not tmpAlertsCollectionToRemove.Contains(al) Then tmpAlertsCollectionToRemove.Add(al)
                        ElseIf al.AlertData.Contains(Me.IdentifingUnit) Then
                            If Not tmpAlertsCollectionToRemove.Contains(al) Then tmpAlertsCollectionToRemove.Add(al)
                        ElseIf Me.EntityUID IsNot Nothing AndAlso Not String.IsNullOrEmpty(EntityUID) AndAlso Me.EntityUID.Trim <> "" AndAlso al.AlertData.Contains(Me.EntityUID) Then
                            If Not tmpAlertsCollectionToRemove.Contains(al) Then tmpAlertsCollectionToRemove.Add(al)
                        End If
                    Next
                    If tmpAlertsCollectionToRemove IsNot Nothing AndAlso tmpAlertsCollectionToRemove.Count > 0 Then
                        MessageList.Append(" ACKNOWLEDGING ALERTS FOR TRAIN " & Me.Name & vbCrLf)
                        For Each al In tmpAlertsCollectionToRemove
                            Dim Message As String = al.TypeOfAlert.ToString & " - ALERT WAS ACKNOWLEDGED BY SYSTEM ON TRAIN RELEASE/FINAL:" & Me.Name
                            MessageList.Append(Message & vbCrLf)
                            al.AlertAckedByPerson = Message
                            gSystemAlertExists = False
                            Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al)
                            SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                            End SyncLock
                        Next
                        If MessageList IsNot Nothing AndAlso MessageList.ToString.Trim <> "" Then
                            TrainEventLog(MessageList.ToString)
                        End If
                        Threading.Thread.Sleep(1000)
                        For Each al In tmpAlertsCollectionToRemove
                            Dim SummItem As New SummaryItem("ALERT", "REMOVE", al)
                            SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                            End SyncLock
                            TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                        Next
                        gSystemAlertExists = False
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                tmpAlertsCollection = Nothing
                tmpAlertsCollectionToRemove = Nothing
                MessageList = Nothing
            End Try
        End Sub

