        ''' <summary>
        ''' Update LocoMIS Information
        ''' </summary>
        ''' <param name="theLoco">Locomotive</param>
        Public Sub UpdateLocoMISInformation(theLoco As MobileTracking.Locomotive)
            Try
                Dim query As String = $"SELECT LocomotiveMISInformation FROM tblTrainsActive WHERE Symbol = '{Name}'"
                Dim miscInfo As String = String.Empty
                Dim recordedSpeed As Integer
                Using dbConn As New OleDbConnection(gConnectionStringDynamic), dbComm As New OleDbCommand(query, dbConn)
                    dbConn.Open()
                    Using dataReader As OleDbDataReader = dbComm.ExecuteReader()
                        While dataReader.Read()
                            If Not dataReader.IsDBNull(0) Then
                                miscInfo = dataReader.GetString(0)
                                If Not String.IsNullOrEmpty(miscInfo) Then
                                    recordedSpeed = Convert.ToInt32(miscInfo.Split("|")(0))
                                    If recordedSpeed = 0 AndAlso theLoco.Speed = 0 Then
                                        Exit Sub
                                    End If
                                Else
                                    Exit Sub
                                End If
                            End If
                        End While
                    End Using
                End Using
                Dim infString As String = $"{theLoco.Speed}|{Format(Date.Now(), "yyyy-MM-dd HH:mm:ss")}|{theLoco.LocosubState}|{theLoco.MilePost}|{theLoco.EndMilePost}"
                Dim update As String = $"UPDATE tblTrainsActive
                                         Set LocomotiveMISInformation = '{infString}'
                                         WHERE Symbol = '{Name}'"
                myMISInformation = infString
                SystemDatabaseCommandToDynamicTrain($"TRAINID:{GetCurrentMethod.Name}", update.ToString)
                TMDS.NetworkMessages.CadMessages.SendTrainEventForWabtecOne(Me, "UPDATED")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub UpdatePTCAuthorityStatus(ByVal StateChange As String)
            Dim auth As Object
            Try
                'SFAuthority
                For Each auth In OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        Dim sfa As SFAuthority = CType(auth, SFAuthority)
                        If Mid(sfa.IssueTo, 1, 10) = Mid(Me.IdentifingUnit, 1, 10) And sfa.TrainSymbol = Me.Name Then
                            If StateChange = "INACTIVE" Then
                                sfa.PTCTypeAuthority = False
                                sfa.PTCStatus = "NONE"
                            Else
                                sfa.PTCTypeAuthority = True
                                'sfa.PTCStatus = "AUTHORITY-ACTIVATED"
                            End If
                            Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC", sfa)
                            SyncLock gSummaryAuthQueue.SyncRoot
                                gSummaryAuthQueue.Enqueue(SummItem)
                            End SyncLock
                            If sfa.UpdateDatabaseWithPTCTextualStatus(sfa.PTCStatus) Then
                                TrainEventLog("UpdatePTCAuthorityStatus-UpdateDatabaseWithPTCTextualStatus-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                            End If
                            If sfa.UpdateDatabaseWithPTCAuthorityStatus(sfa.PTCStatus) Then
                                TrainEventLog("UpdatePTCAuthorityStatus-UpdateDatabaseWithPTCAuthorityStatus-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                            End If
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                auth = Nothing
            End Try

        End Sub

        Private Function CheckTrainForPTCEnabled(ByVal EntryTrack As Track) As Boolean
            Try
                Dim StartMessage As Date = Now
                Dim LimitsInPTC As Boolean


                If Not Me.CBTCEquipped Then
                    Return False
                End If
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainStatusRequest(Me)

                Do
                    Application.DoEvents()
                    Threading.Thread.Sleep(50)
                    If StartMessage < Now.AddSeconds(-1) Then Exit Do
                Loop

                If Not IsCurrentTerritoryPTCEnabled(EntryTrack) Then
                    TrainEventLog("PTC TRAIN NOT FOUND. PTC LIMITS = " & LimitsInPTC.ToString.ToUpper)
                    Return False
                Else
                    TrainEventLog("PTC TRAIN STATUS = " & Me.PTCStatus)
                    If Me.PTCStatus Is Nothing Then Return False
                    Select Case Me.PTCStatus
                        Case "ACTIVE"
                            Return True
                        Case Else
                            Return False
                    End Select
                    Return Me.PTCStatus
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False
        End Function

        Private Function IsCurrentTerritoryPTCEnabled(ByVal EntryTrack As Track) As Boolean
            Dim CurrentTerritoryID As Integer = EntryTrack.TerritoryID
            Dim terr As Territory
            Try
                For Each terr In ControlledTerritories
                    If terr.TerritoryID = CurrentTerritoryID Then
                        Return terr.PTCEnabled
                        Exit For
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                terr = Nothing
            End Try
            Return False
        End Function

        Private Sub ReleaseCPPTCAuthority(ByVal FailedPTCAuthority As Object)
            Dim FailedAuth As Object = Nothing
            Dim Auth As Object = Nothing
            Dim HasFailedAuth As Boolean = False
            Try
                If FailedPTCAuthority IsNot Nothing Then
                    FailedAuth = FailedPTCAuthority
                    FailedPTCAuthority.PTCStatus = "NONE"
                    HasFailedAuth = True
                End If
                If HasFailedAuth Then
                    Select Case FailedAuth.GetType.ToString
                        Case gSFAComponentName
                        Case gTTComponentName
                            If HasFailedAuth Then
                                Dim TAT As TMDS.TrackAuthority.TrackAuthority = FailedAuth
                                Dim HasVoidedAuthority As Boolean = False
                                Dim TATVoidedAuth As TMDS.TrackAuthority.TrackAuthority = Nothing
                                If TAT.AuthVoidList.Trim <> "" Then
                                    Dim strVoid() As String = TAT.AuthVoidList.Split("|")
                                    Dim s As String
                                    For Each s In strVoid
                                        If s.Trim <> "" Then
                                            HasVoidedAuthority = True
                                            TATVoidedAuth = TMDS.SystemUtilities.FetchData.FindTNTByAuthorityGUID(s)
                                            Exit For
                                        End If
                                    Next
                                End If
                                If HasFailedAuth AndAlso TATVoidedAuth IsNot Nothing Then
                                    If PerformTNTAuthorityRemove(TATVoidedAuth, Now) Then
                                        'TATVoidedAuth.FlasherMode(False, True)
                                        TAT.AuthVoidList = ""
                                        TAT.UpdateTrackAuthorityVOIDList()
                                        TAT.AuthorityStatus = TNTAuthStatus.ACKNOWLEDGED.ToString
                                        TAT.UpdateTrackAuthorityStatus()
                                    End If
                                    ClearTNTPTCVariables(TAT)
                                ElseIf HasFailedAuth AndAlso TATVoidedAuth Is Nothing Then

                                    TAT.AuthorityStatus = TNTAuthStatus.ACKNOWLEDGED.ToString
                                    TAT.UpdateTrackAuthorityStatus()
                                    ClearTNTPTCVariables(TAT)
                                    TAT.FlasherMode(False, True)
                                End If
                            End If
                            For Each Auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                                If Auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                                    Dim TNT As TMDS.TrackAuthority.TrackAuthority = CType(Auth, TMDS.TrackAuthority.TrackAuthority)
                                    If TNT.IssuedToTrain Then
                                        If TNT.TrainSymbol = Me.Name Or TNT.IssueTo = Mid(Me.IdentifingUnit, 1, 10) Then
                                            If TNT.PTCTypeAuthority Then
                                                TNT.PTCTypeAuthority = False
                                                TNT.PTCStatus = "INACTIVE"
                                                TNT.SetPTCAuthorityFlasherStatus("ReleaseCPPTCAuthority")
                                                If TNT.UpdateDatabaseWithPTCAuthorityStatus("INACTIVE") Then
                                                    ClearTNTPTCVariables(TNT)
                                                    TNT.FlasherMode(False, True)
                                                    'Dim SummItem1 As New SummaryItem("AUTHORITY", "INACTIVE", t)
                                                    'SyncLock gSummaryAuthQueue.SyncRoot
                                                    '    gSummaryAuthQueue.Enqueue(SummItem1)
                                                    'End SyncLock
                                                End If
                                            End If
                                        End If
                                    End If
                                End If
                            Next


                        Case gOtherSplAuthorityName
                            For Each Auth In TMDS.GlobalDeclarations.gOtherSpecialAuthorityCollection
                                If Auth.GetType.ToString = gOtherSplAuthorityName Then
                                    Dim SPL As TMDS.TrackAuthority.OtherSpecialAuthorityType = CType(Auth, TMDS.TrackAuthority.OtherSpecialAuthorityType)
                                    If SPL.TrainSymbol = Me.Name Or SPL.IssueTo = Mid(Me.IdentifingUnit, 1, 10) Then
                                        If SPL.PTCTypeAuthority Then
                                            SPL.PTCTypeAuthority = False
                                            SPL.PTCStatus = "INACTIVE"
                                            SPL.SetPTCAuthorityFlasherStatus()
                                            If SPL.UpdateDatabaseWithPTCAuthorityStatus("INACTIVE") Then
                                                ClearSplAuthVariables(SPL)
                                                SPL.FlasherMode(False, True)
                                                'Dim SummItem1 As New SummaryItem("AUTHORITY", "INACTIVE", t)
                                                'SyncLock gSummaryAuthQueue.SyncRoot
                                                '    gSummaryAuthQueue.Enqueue(SummItem1)
                                                'End SyncLock
                                            End If
                                        End If
                                    End If
                                End If

                            Next


                    End Select
                End If

            Catch ex As Exception

            End Try

        End Sub

        Private Function PerformTNTAuthorityRemove(ByVal AuthorityToRemove As TrackAuthority.TrackAuthority, ByVal RClearTime As Date) As Boolean
            Dim UpdateCrew As Boolean = False
            Dim DoNonPTCRelease As Boolean = True
            Try
                Dim gHistoryMessage As String = ""
                AuthorityToRemove.ReportClear = RClearTime 'Me.ReportClear
                AuthorityToRemove.CopiedBy = "CUTOUT: " & Me.Name
                If AuthorityToRemove.UpdateTrackAuthorityReportClearTime(True) Then
                    If AuthorityToRemove.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                        If AuthorityToRemove.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                            AuthorityToRemove.FlasherMode(False)
                            TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(AuthorityToRemove)
                            Dim SummItem2 As New SummaryItem("AUTHORITY", "REMOVE", AuthorityToRemove)
                            SyncLock gSummaryAuthQueue.SyncRoot
                                gSummaryAuthQueue.Enqueue(SummItem2)
                            End SyncLock
                            TrainEventLog("AUTHORITY REMOVED MESSAGE RECEIPT: " & AuthorityToRemove.AuthorityUID)
                        End If
                    Else
                        gHistoryMessage = "SYSTEM DATABASE ERROR! PLEASE CONSIDER TRACK AUTHORITY (" & AuthorityToRemove.AuthorityUID & ") NOT REMOVED! CONTACT SYSTEM ADMINISTRATOR IMMEDIATELY!"
                        TrainEventLog(gHistoryMessage & "UNABLE TO DELETE AUTHORITY FROM DB")
                        MessageBox.Show(Me, gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Return False

                    End If
                Else
                    gHistoryMessage = "SYSTEM DATABASE ERROR! PLEASE CONSIDER TRACK AUTHORITY (" & AuthorityToRemove.AuthorityUID & ") NOT REMOVED! CONTACT SYSTEM ADMINISTRATOR IMMEDIATELY!"
                    TrainEventLog(gHistoryMessage & "UNABLE TO UPDATE DB WITH REPORT CLEAR TIME")
                    MessageBox.Show(Me, gHistoryMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    ClearSystemVariables()
                    Return False
                End If
                Return True



            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

        End Function

        Public Function CheckMyPTCStatus() As Boolean
            Dim tm As TimeSpan
            Try
                'If gSimulationMode AndAlso gDeveloperSystem Then
                '    Me.IsActivePTC = True
                '    Return True
                'End If
                If Not Me.CBTCEquipped Then Return False
                If Me.myTrack Is Nothing Then Return False
                If Me.myTrack.GUID = 0 Then Return False
                If Me.myTrack.myTerritory Is Nothing Then Return False
                If Not Me.myTrack.myTerritory.PTCEnabled Then Return False
                If Not gBOSInComm Then Return False
                tm = Now.Subtract(TimeStampPTCStatus)
                If tm.TotalSeconds < 30 Then
                    Return Me.IsActivePTC
                End If
                Dim StartMessage As Date = Now
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainStatusRequest(Me)
                Do
                    Application.DoEvents()
                    Threading.Thread.Sleep(50)
                    If StartMessage < Now.AddSeconds(-1) Then Exit Do
                Loop
                Return Me.IsActivePTC
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Me.IsActivePTC
            End Try
        End Function

        Public Function CheckMyPTCPostion() As Boolean
            Dim tm As TimeSpan
            Try
                If Not Me.CheckMyPTCStatus Then Return False
                tm = Now.Subtract(TimeStampPTCPosition)
                If tm.TotalSeconds < 30 Then
                    Return True
                End If
                Dim StartMessage As Date = Now
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainPositionRequest(Me)
                Do
                    Application.DoEvents()
                    Threading.Thread.Sleep(50)
                    If StartMessage < Now.AddSeconds(-1) Then Exit Do
                Loop
                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function

