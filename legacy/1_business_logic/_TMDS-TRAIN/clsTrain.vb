#Region "GENERAL METHODS"

        Sub New()
            Flasher = New Timers.Timer()
            Flasher.Interval = 400
            AddHandler Flasher.Elapsed, AddressOf FlashElapsedEvent
            ScheduleTimer = New Timers.Timer()
            ScheduleTimer.Interval = 10000
            AddHandler ScheduleTimer.Elapsed, AddressOf ScheduleTimerElapsedEvent
            If gEnableTrainTimerRefresh Then
                Me.TrainRefreshTimer = New Timers.Timer()
                Me.TrainRefreshTimer.Interval = 1000
                Me.TrainRefreshTimer.Enabled = True
                AddHandler Me.TrainRefreshTimer.Elapsed, AddressOf TrainRefreshTimerElapsedEvent
            End If
            TrainGUID = System.Guid.NewGuid.ToString.ToUpper
            Me.CrewList.Add(Me.CrewCurrent)
            Me.CrewList.Add(Me.CrewRelief)
            Me.CrewList.Add(Me.CrewPending)
            If gTestPTC Then
                IsActivePTC = True
                pPTCStatus = "ACTIVE"
            End If
        End Sub

        Protected Overrides Sub Finalize()
            MyBase.Finalize()
        End Sub

        Protected Overloads Sub Dispose(ByVal disposing As Boolean)
            If disposing Then
                Try
                    Flasher.Enabled = False
                    Flasher.Stop()
                    RemoveHandler Flasher.Elapsed, AddressOf FlashElapsedEvent
                    Flasher.Dispose()
                    Flasher = Nothing
                Catch
                End Try
                Try
                    ScheduleTimer.Enabled = False
                    ScheduleTimer.Stop()
                    RemoveHandler ScheduleTimer.Elapsed, AddressOf ScheduleTimerElapsedEvent
                    ScheduleTimer.Dispose()
                    ScheduleTimer = Nothing
                Catch
                End Try
                If gEnableTrainTimerRefresh Then
                    Try
                        TrainRefreshTimer.Enabled = False
                        TrainRefreshTimer.Stop()
                        RemoveHandler TrainRefreshTimer.Elapsed, AddressOf TrainRefreshTimerElapsedEvent
                        TrainRefreshTimer.Dispose()
                        TrainRefreshTimer = Nothing
                    Catch ex As Exception
                    End Try
                End If
            End If
            MyBase.Dispose(disposing)
        End Sub

        Public Sub ReleaseRefreshTimer()
            Try
                If TrainRefreshTimer IsNot Nothing Then
                    TrainRefreshTimer.Enabled = False
                    RemoveHandler TrainRefreshTimer.Elapsed, AddressOf TrainRefreshTimerElapsedEvent
                    TrainRefreshTimer.Dispose()
                    TrainRefreshTimer = Nothing
                End If
            Catch ex As Exception

            End Try
        End Sub

        Public Overloads Sub Dispose()
            ' Do not change this code.  Put cleanup code in Dispose(ByVal disposing As Boolean) above.
            Dispose(True)
            GC.SuppressFinalize(Me)
        End Sub

        Private Sub FlashElapsedEvent(ByVal source As Object, ByVal e As ElapsedEventArgs)
            Try
                If MessageAlertFlashOn Then
                    MessageAlertFlashOn = False
                Else
