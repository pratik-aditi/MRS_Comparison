        ''' <summary>
        ''' This Function is used to send OS Message to SISLOG. Based on the SFA direction 
        ''' </summary>
        ''' <param name="theTrack"></param>
        ''' <param name="TravelDirection"></param>
        ''' <remarks></remarks>
        Public Sub SendMRSTWCOSEvent(ByVal theTrack As Track, ByVal TravelDirection As String)
            If theTrack Is Nothing Then Exit Sub
            Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(theTrack)
            Dim Temptrk As Track = Nothing
            Try
                If sw Is Nothing Then
                    Temptrk = TMDS.SystemUtilities.FetchData.FindOSTrackBehindNonOsTrack(theTrack, TravelDirection)
                    If Not Temptrk Is Nothing Then sw = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(Temptrk)
                End If
                Dim SwtrkName As String = ""
                If Not IsNothing(sw) Then
                    If Not sw.TrackName Is Nothing Then SwtrkName = sw.TrackName.Trim.ToUpper
                    If Not IsNothing(Me) Then
                        Dim theEvent As String = "ENTRY"

                        Select Case TravelDirection
                            Case "RIGHT"
                                If sw.LeftAltLink <> 0 Then
                                    theEvent = "EXIT"
                                ElseIf sw.RightAltLink <> 0 Then
                                    theEvent = "ENTRY"
                                End If
                            Case "LEFT"
                                If sw.LeftAltLink <> 0 Then
                                    theEvent = "ENTRY"
                                ElseIf sw.RightAltLink <> 0 Then
                                    theEvent = "EXIT"
                                End If
                        End Select
                        If Temptrk IsNot Nothing Then
                            If Me.LastMoveEvent = Temptrk.myControlPoint.Name & ":" & theEvent Then
                                TrainEventLog("SendMRSTWCOSEvent:Duplicate:" & Me.LastMoveEvent)
                                Exit Sub
                            End If
                            Me.SendTrainPositionEvent(Temptrk, Temptrk.myControlPoint, theEvent)
                            Me.LastMoveEvent = Temptrk.myControlPoint.Name & ":" & theEvent
                        Else
                            Me.SendTrainPositionEvent(theTrack, theTrack.myControlPoint, theEvent)
                        End If
                        TrainEventLog("SendMRSTWCOSEvent:" & Me.LastMoveEvent)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                sw = Nothing
                Temptrk = Nothing
            End Try
        End Sub

