        Private Sub RemoveLicenseForTestPTC()
            Try
                Threading.Thread.Sleep(2000)
                If thisCurrentLicense.PTCMarkedToBeVoidedElectronically OrElse thisCurrentLicense.PTCMarkedToBeForcedVoidedElectronically Then
                    If thisCurrentLicense.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                        If thisCurrentLicense.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                            thisCurrentLicense.RemoveTrackAuthFromRemoteLinks()

                            TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(thisCurrentLicense)
                            Dim SummItem2 As New SummaryItem("AUTHORITY", "REMOVE", thisCurrentLicense)
                            SyncLock gSummaryAuthQueue.SyncRoot
                                gSummaryAuthQueue.Enqueue(SummItem2)
                            End SyncLock

                            thisCurrentLicense.PTCStatus = "RELEASE-SUCCESSFUL"
                            thisCurrentLicense.SetPTCAuthorityFlasherStatus("ProcessMA_2061_TNT_ReleaseMessageAction")
                            thisCurrentLicense.FlasherMode(False)
                            TrainEventLog("RemoveLicenseForTestPTC:AUTHORITY REMOVAL ACCEPTED FROM MA-2061 MESSAGE RECEIPT: " & thisCurrentLicense.AuthorityUID)
                            thisCurrentLicense.VETMS_CompleteReleaseOfTacticalRoutes()
                            If Not IsNothing(thisCurrentLicense.myTrain) Then
                                thisCurrentLicense.myTrain.thisCurrentLicense = Nothing
                            End If

                            If thisCurrentLicense.UpdateDatabaseWithPTCAuthorityStatus(thisCurrentLicense.PTCStatus) Then
                                TrainEventLog("RemoveLicenseForTestPTC:PTCMessages-ProcessDeliveryConfirmation-ProcessMA_2061_TNT_ReleaseMessageAction-AUTHORITY:" & thisCurrentLicense.AuthorityUID & " STATUS=" & thisCurrentLicense.PTCStatus)
                            End If
                            thisCurrentLicense.PTCTransmissionCompleted()
                            thisCurrentLicense = Nothing
                            Exit Sub
                        End If
                    End If
                    thisCurrentLicense.PTCTransmissionCompleted()
                    thisCurrentLicense.CheckToAcknowledgeAlert()
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try


        End Sub

