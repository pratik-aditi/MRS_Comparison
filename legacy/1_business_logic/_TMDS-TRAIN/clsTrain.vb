        Public Sub RemoveRouteOnward(ByVal theRoute As StoredRoute)
            Try

                Dim StoredRoutesToRemove As New ArrayList
                Dim TacticalRoutesToRemove As New ArrayList

                Dim sr As StoredRoute
                Dim StartRemove As Boolean
                For Each sr In Me.myStoredRoutes
                    If StartRemove Then
                        StoredRoutesToRemove.Insert(0, sr)
                    End If
                    If sr.RouteGUID = theRoute.RouteGUID Then
                        StartRemove = True
                        StoredRoutesToRemove.Add(sr)

                    End If
                Next

                Dim tr As TacticalRoute
                For Each sr In StoredRoutesToRemove
                    For Each tr In Me.myTacticalRoutes
                        If sr.myTacticalRoute.myGUID = tr.myGUID Then
                            TacticalRoutesToRemove.Insert(0, tr)
                            Exit For
                        End If
                    Next
                Next

                For Each tr In TacticalRoutesToRemove
                    Me.myTacticalRoutes.Remove(tr)
                    tr.RemoveRoute()
                Next

                For Each sr In StoredRoutesToRemove
                    Me.myStoredRoutes.Remove(sr)
                    sr.RemoveMeAndTacticalRoute()
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function VerifyRouteContiguousSelection(ByVal theRoute As ArrayList) As Boolean
            Try
                'make sure that the selection of a new route contains the ending of the old route in the current license
                If Not IsNothing(Me.thisCurrentLicense) Then
                    Dim comp As Object
                    For Each comp In theRoute
                        If thisCurrentLicense.ComponentsInSelection.Contains(comp) Then
                            Me.TrainEventLog("VerifyRouteContiguousSelection1=TRUE")
                            Return True
                        End If
                    Next
                Else
                    Me.TrainEventLog("VerifyRouteContiguousSelection2=TRUE")
                    Return True
                End If
                Me.TrainEventLog("VerifyRouteContiguousSelection=FALSE")
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Public Function DoesControlSignalExist() As Boolean
            Try
                Dim tr As TacticalRoute
                'Dim sr As SignalRoute
                For Each tr In Me.myTacticalRoutes
                    If Not tr.mySignalRoute.EntrySignal.AutomaticSignal And tr.mySignalRoute.EntrySignal.SignalIndStatus = Signal.IndStatus.Cleared Then
