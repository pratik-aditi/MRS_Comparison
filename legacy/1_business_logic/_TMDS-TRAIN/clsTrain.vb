        ''' <summary>
        ''' Menu cancel normal license
        ''' </summary>
        Public Sub MenuCancelNormalLicense(track As Track)
            Try
                If track.AuthorityType.Equals("TWC") Then
                    TrainEventLog($"{GetCurrentMethod.Name} TWC license")
                    If track.TrackAuthorities.Count = 0 Then
                        Dim signal As Signal = FindSignalConnectedToTrackTWC(track)
                        If signal IsNot Nothing Then track.DoQuickCancelRoute()
                        Exit Sub
                    End If
                    Dim authority As SFAuthority = track.TrackAuthorities.Item(0)
                    If authority Is Nothing Then Exit Sub
                    SystemForms.MySystemForms.frmReportClr = New frmReportClear With {
                            .Location = myTrack.CurrentDrawingForm.myLaunchPoint
                        }
                    SystemForms.MySystemForms.frmReportClr.LoadForm()
                    SystemForms.MySystemForms.frmReportClr.SimpleReportClearEvent(authority)
                    SystemForms.MySystemForms.frmReportClr.Dispose()
                    SystemForms.MySystemForms.frmReportClr = Nothing
                Else
                    TrainEventLog($"{GetCurrentMethod.Name} PTC license")
                    If Not DoesControlSignalExist() Then
                        PtcCancelNormalLicense(Nothing)
                    Else
                        gCreateLicenseTrain = Me
                        gCancelLicenseToTrain = True
                        UtilitiesDisplayForm.SetCursor(curCancelLicense)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Stop train command
        ''' </summary>
        ''' <param name="pDisableMessage">Disable message to confirm</param>
        Public Sub StopTrainCommand(Optional ByVal pDisableMessage As Boolean = False)
            Dim frmMessageBox As frmMessageBox
            Dim messageList As New ArrayList()
            Dim tr As TacticalRoute
            Dim doSendControls As SendControls
            Try
                TrainEventLog("StopTrainCommand:DisableMessage=" & pDisableMessage.ToString & ":WhoCallMe=" & (New System.Diagnostics.StackTrace).GetFrame(1).GetMethod.Name)
                If Not pDisableMessage Then
                    messageList.Add(optStopTrainLine1 & Space(1) & Me.Name)
                    If optStopTrainLine2.Trim <> "" Then messageList.Add(optStopTrainLine2)
                    messageList.Add(optStopTrainLine3)
                    messageList.Add("")
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = TMDS.SystemForms.MySystemForms.frmMainMDI
                    frmMessageBox.SetMessage(messageList, optStopTrainHeader, True, Me.myTrack.CurrentDrawingForm.myLaunchPoint)
                    frmMessageBox.ShowDialog()
                    If frmMessageBox.FormFeedBack <> 6 Then
                        frmMessageBox.Dispose()
                        Exit Sub
                    End If
                    frmMessageBox.Dispose()
                End If
                For Each tr In Me.myTacticalRoutes
                    If Not IsNothing(tr) Then
                        If Not IsNothing(tr.mySignalRoute.EntrySignal.CurrentTacticalRoute) Then
                            If tr.mySignalRoute.EntrySignal.CurrentTacticalRoute.mySignalRoute.SystemUID = tr.mySignalRoute.SystemUID AndAlso (tr.myStatus = "CLEARED" OrElse tr.myStatus = "PENDING") Then
                                tr.mySignalRoute.EntrySignal.myControlPoint.FlasherMode(True)
                                tr.mySignalRoute.EntrySignal.ControlSignalToStop(False, True)
                                tr.mySignalRoute.EntrySignal.CurrentTacticalRoute = Nothing
                            End If
                        End If
                    End If
                Next
                doSendControls = New SendControls(AddressOf TMDS.SystemForms.MySystemForms.frmMainMDI.SendControls)
                doSendControls.BeginInvoke(False, Nothing, Nothing)
                For Each tr In Me.myTacticalRoutes
                    Me.myTacticalRoutesToRemove.Add(tr)
                Next
                CancelAllLicenseForPTC(False, True)
                If gTestPTC Then
                    PerformLicenseRemvalWhileInTestMode()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSystemVariables()
            Finally
                frmMessageBox = Nothing
                messageList = Nothing
                tr = Nothing
                doSendControls = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Cancel All License For PTC
        ''' </summary>
        ''' <param name="forceRemoval">force removal</param>
        ''' <param name="forceTrainStop">force train stop</param>
        ''' <param name="requestVoidByMZ">request void by maneuver zone</param>
        Public Sub CancelAllLicenseForPTC(forceRemoval As Boolean,
                                          Optional forceTrainStop As Boolean = False,
                                          Optional requestVoidByMZ As Boolean = False)
            Try
                TrainEventLog($"{GetCurrentMethod.Name}:Start:ForceRemoval={forceRemoval}")
                If requestVoidByMZ Then PTCElectronicDeliveryCompleted = False
                Dim authorityId As String = String.Empty
                If thisCurrentLicense IsNot Nothing Then authorityId = thisCurrentLicense.AuthGUID
                If OtherTrackAuthorities.Contains(authToBeRemovedWithPSS) Then
                    authToBeRemovedWithPSS = Nothing
                ElseIf authToBeRemovedWithPSS IsNot Nothing Then
                    OtherTrackAuthorities.Add(authToBeRemovedWithPSS)
                    TrainEventLog($"{GetCurrentMethod.Name}:LicenseNumber={authToBeRemovedWithPSS}")
                    authToBeRemovedWithPSS = Nothing
                End If
                Dim trackAuthorityRemovalList As New List(Of TrackAuthority.TrackAuthority)
                For Each authority As TrackAuthority.TrackAuthority In
                    OtherTrackAuthorities.OfType(Of TrackAuthority.TrackAuthority)
                    If authority.IssueTo.Equals(IdentifingUnit) Then
                        TrainEventLog($"{GetCurrentMethod.Name}:LicenseNumber={authority.AuthorityNumber}")
                        If authority.PTCTypeAuthority AndAlso
                            Not forceRemoval AndAlso
                            Not GeoFenceLegacyEnabled Then
                            authority.PTCMarkedToBeForcedVoidedElectronically = forceTrainStop
                            authority.VETMS_PerformRelease(Me, forceTrainStop)
                            authority.RemoveTrackAuthFromRemoteLinks()
                            CheckTrackTagToMarkAsUnRead(authority.ComponentsInSelection)
                        Else
                            RemoveAllTacticalRoutes()
                            authority.UpdateTrackAuthorityReportClearTime()
                            authority.PTCMarkedToBeForcedVoidedElectronically = forceTrainStop
                            authority.RemoveTrackAuthFromRemoteLinks()
                            If authority.RemoveActiveAuthorityFromDB(Nothing) Then
                                If authority.RemoveActiveAuthorityFromComponents(Nothing, True) Then
                                    authority.RemoveTrackAuthFromRemoteLinks()
                                    authority.MarkedForDelete = True
                                    trackAuthorityRemovalList.Add(authority)
                                    If authority.PTCTypeAuthority Then
                                        authority.PTCStatus = "RELEASE-SUCCESSFUL"
                                        authority.UpdateDatabaseWithPTCAuthorityStatus(authority.PTCStatus)
                                        authority.PTCTransmissionCompleted()
                                        authority.CheckToAcknowledgeAlert()
                                        authority.RemoveTrackAuthFromRemoteLinks()
                                    End If
                                End If
                            End If
                            authority.RemoveTrackAuthFromRemoteLinks()
                            thisCurrentLicense = Nothing
                        End If
                    End If
                Next
                For Each authority As TrackAuthority.TrackAuthority In trackAuthorityRemovalList
                    OtherTrackAuthorities.Remove(authority)
                    Dim summaryItem As New SummaryItem("AUTHORITY", "REMOVE", authority)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(summaryItem)
                    End SyncLock
                    NetworkMessages.CadMessages.SendLicenseEventForWabtecOne(authority, "CANCEL")
                Next
                Dim specialAuthorities As List(Of OtherSpecialAuthorityType) =
                    gOtherSpecialAuthorityCollection.OfType(Of OtherSpecialAuthorityType).ToList
                Dim specialRemovalList As New List(Of OtherSpecialAuthorityType)
                For Each authority As OtherSpecialAuthorityType In specialAuthorities
                    If authority.TrainSymbol.Equals(Name) AndAlso
                        authority.SubType.Equals("PSS") AndAlso
                        forceRemoval Then
                        authority.ReportClearTime = Now
                        authority.UpdateDatabaseWithReportClear()
                        specialRemovalList.Add(authority)
                        thisRestrictiveLicense = Nothing
                        authority.RemoveAuthorityFromSystem(False)
                    End If
                Next
                For Each authority As OtherSpecialAuthorityType In specialRemovalList
                    Dim summaryItem As New SummaryItem("SPLAUTHORITY", "REMOVE", authority)
                    SyncLock gSummaryAuthQueue
                        gSummaryAuthQueue.Enqueue(summaryItem)
                    End SyncLock
                Next
                RemoveAllActiveAuthorityFromDB()
                IsBIDirectional = False
                AutoCutoutTrain = False
                RequestJointAuthForLicnese = False
                RemoveAllTacticalRoutes()
                RemoveAlertsForPTC()
                myTacticalRoutesFullfilled.Clear()
                If RemoveListForRollUps.Count > 0 Then RemoveListForRollUps.Clear()
                If SignalListForJointAuthRouteBuilding.Count > 0 Then SignalListForJointAuthRouteBuilding.Clear()
                If myTacticalRoutesFullfilled.Count > 0 Then myTacticalRoutesFullfilled.Clear()
                If ClickedOnTrainForLicense Then
                    ClickedOnTrainForLicense = False
                    IsSpecialLicense = False
                End If
                If GeoFenceLegacyEnabled OrElse
                    forceRemoval Then
                    RemoveLicenseFromAllTracks(authorityId)
                    thisCurrentLicense = Nothing
                End If
                TrainEventLog($"{GetCurrentMethod.Name}:End")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Clear Track Tag List for train
        ''' </summary>
        Public Sub ClearTrackTagListFromDB()
            Dim dbConn As OleDbConnection = Nothing
            Dim dbComm As OleDbCommand = Nothing
            Dim query As String
            Try
                TrainEventLog("ClearTrackTagListFromDB")
                dbConn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                query = "UPDATE tblSystemTabularGeneralBulletinActive SET "
                query += "TrackTagList = NULL "
                query += "WHERE IssuedTo = '" & Me.Name & "'"
                dbComm = New OleDbCommand(query, dbConn)
                If dbComm.Connection.State = ConnectionState.Connecting Or dbComm.Connection.State = ConnectionState.Open Then
                    dbComm.Connection.Close()
                End If
                dbConn.Open()
                dbComm.ExecuteNonQuery()
                dbConn.Close()
                If Me.trackTagList.Count > 0 Then
                    Me.trackTagList.Clear()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If dbConn IsNot Nothing Then dbConn.Dispose()
                dbConn = Nothing
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                query = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Method for remove all active licenses assigned with loco lead for avoid stuck licenses
        ''' </summary>
        Public Sub RemoveAllActiveAuthorityFromDB()
            Dim dbConn As OleDbConnection = Nothing
            Dim dbComm As OleDbCommand = Nothing
            Dim query As String
            Dim result As Integer
            Try
                dbConn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                'NORMAL AUTHORITY
                query = "DELETE FROM " & gtblAuthActive & " WHERE IssueTo = '" & Me.IdentifingUnit & "' OR TrainSymbol = '" & Me.Name & "'"
                dbComm = New OleDbCommand(query, dbConn)
                If dbComm.Connection.State = ConnectionState.Connecting Or dbComm.Connection.State = ConnectionState.Open Then
                    dbComm.Connection.Close()
                End If
                dbConn.Open()
                result = dbComm.ExecuteNonQuery()
                TrainEventLog("RemoveAllActiveAuthorityFromDB:Normal authority:Lines affected=" & result.ToString)
                'SPECIAL AUTHORITY
                query = "DELETE FROM " & gtblOtherSpecialAuthActive & " WHERE IdentifingUnit = '" & Me.IdentifingUnit & "' OR TrainSymbol = '" & Me.Name & "'"
                dbComm = New OleDbCommand(query, dbConn)
                result = dbComm.ExecuteNonQuery()
                TrainEventLog("RemoveAllActiveAuthorityFromDB:Special authority:Lines affected=" & result.ToString)
                dbConn.Close()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
