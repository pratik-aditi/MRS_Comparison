        Private Sub PublishTrainStatus(ByVal eventType As EventTypeTrainID, ByVal ReleaseTrain As Boolean)
            Dim Message As String
            Try
                If Not ReleaseTrain Then
                    If PublishLastTrackGUID IsNot Nothing AndAlso PublishLastTrackGUID = Me.myTrack.GUID Then Exit Sub

                End If

                If Me.myTrack.myControlPoint.AllowStatusPublishing Then

                    Message = "DC" & Chr(6) & "TRNSTAT;"
                    Message = Message & "|" & Me.myTrack.TerritoryID.ToString
                    Select Case eventType
                        Case EventTypeTrainID.POSITION
                            Message = Message & "|ACTION=ADD"
                        Case EventTypeTrainID.RELEASE, EventTypeTrainID.FINAL
                            Message = Message & "|ACTION=REMOVE"
                        Case EventTypeTrainID.MOVE, EventTypeTrainID.MOVEMANUAL
                            Message = Message & "|ACTION=MODIFY"
                        Case Else
                            Exit Sub
                    End Select

                    Message = Message & "|NAME=" & Me.Name
                    Message = Message & "|TRACK=" & Me.myTrack.GUID.ToString & "@" & Me.myTrack.myControlPoint.GUID.ToString & "@" & Me.myTrack.Name
                    'Me.myTrack.GUID.ToString
                    Message = Message & "|LENGTH=" & Me.OLength.ToString
                    Message = Message & "|TONNAGE=" & Me.OTons.ToString
                    Message = Message & "|LEAD ENGINE ID=" & Me.IdentifingUnit
                    Dim OtherUnits As String = "NONE"
                    Dim u As String
                    Dim i As Integer
                    For Each u In Me.Units
                        If u <> "" Then
                            If i = 0 Then
                                OtherUnits = u
                                i = 1
                            Else
                                OtherUnits = OtherUnits & "-" & u
                            End If
                        End If
                    Next
                    Message = Message & "|OTHER ENGINE IDS=" & OtherUnits
                    Message = Message & "|ENGINEER=" & Me.CrewCurrent.Engineer.NameOfPerson & "-" & Me.CrewCurrent.Engineer.OnDutyTime & "-" & Me.CrewCurrent.Engineer.HOS
                    Message = Message & "|CONDUCTOR=" & Me.CrewCurrent.Conductor.NameOfPerson & "-" & Me.CrewCurrent.Conductor.OnDutyTime & "-" & Me.CrewCurrent.Conductor.HOS

                    Message = Me.myTrack.TerritoryID.ToString & Chr(12) & Message

                    SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                        TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                    End SyncLock
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

