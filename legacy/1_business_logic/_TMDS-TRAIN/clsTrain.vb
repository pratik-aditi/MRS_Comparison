                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub TrainScheduleUpdate(Optional ByVal UpdateDisplay As Boolean = False)
            Try
                If Me.ScheduleStatus <> "" Then
                    Dim Schedule() As String = Me.ScheduleStatus.Split("|")
                    If Schedule.Length >= 3 Then
                        '1.		Color	1	N	-	color code 0 - white, 1 - red, 2 - green, 3 - yellow, 4 - gray, 5 - blue
                        Select Case Schedule(0)
                            Case "0"
                                ScheduleColor = Color.White
                            Case "1"
                                ScheduleColor = Color.Red
                            Case "2"
                                ScheduleColor = Color.LawnGreen
                            Case "3"
                                ScheduleColor = Color.Yellow
                            Case "4"
                                ScheduleColor = Color.Silver
                            Case "5"
                                ScheduleColor = Color.DodgerBlue 'Color.RoyalBlue
                        End Select
                        ScheduleAdherance = Trim(Schedule(1)) & " " & Trim(Schedule(2))
                    End If
                End If
                If UpdateDisplay Then
                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.TrackGUID)
                    If Not IsNothing(trk) Then
                        trk.InvalidateTrainID()
                        trk.InitTrainDisplay()
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
