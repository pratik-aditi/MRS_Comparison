        Private Sub ClearPaidMoveEventFields()
            Dim update As New StringBuilder
            Try
                Me.ArrTime = Nothing
                Me.DepTime = Nothing
                TrainVia = ""
                ReleaseTime = Nothing
                TrainHOS = Nothing
                Me.Origin = ""
                Me.Dest = ""
                update.Append(" UPDATE " & gtblTrainsActive)
                update.Append(" SET Origin = '" & Origin & "'")
                update.Append(",Dest = '" & Dest & "'")
                update.Append(",DepTime = '" & DepTime & "'")
                update.Append(",ArrTime = '" & ArrTime & "'")
                update.Append(",Release = '" & ReleaseTime & "'")
                update.Append(",HOS = '" & TrainHOS & "'")
                update.Append(",VIA = '" & TrainVia & "'")
                update.Append(",TotalCars = " & Me.TotalCars)
                update.Append(" WHERE Symbol = '" & Name & "'")

                SystemDatabaseCommandToDynamicTrain("TRAINID:ClearPaidMoveEventFields", update.ToString)
                ClearOSRecords()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub ClearOSRecords()
            Dim sqlCmd As New OleDbCommand
            Dim Query As String = ""
            Query = "INSERT INTO tblTrainOsEventsInActive SELECT * FROM tblTrainOsEventsActive WHERE TrainSheetGUID = " & "'" & Me.ActiveTrainSheetGUID & "'"
            Try
                If DatabaseCommand(Query) Then
                    Query = "DELETE FROM tblTrainOsEventsActive WHERE TrainSheetGUID = " & "'" & Me.ActiveTrainSheetGUID & "'"
                    DatabaseCommand(Query)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

