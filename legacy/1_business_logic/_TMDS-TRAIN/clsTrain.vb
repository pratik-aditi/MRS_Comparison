        Public Sub UpdateTrainActiveStatusToDB(CallingMethod As String)
            Dim TrainIDUpdateSQL As String = ""
            Dim q As String = "'"
            Dim s As String = ", "
            Try
                TrainEventLog("SYMBOL CHANGE ACTIVE CALLED BY " & CallingMethod & " FOR TRAIN NAME:" & Me.Name)
                TrainIDUpdateSQL = "UPDATE " & gtblTrainsActive
                TrainIDUpdateSQL = TrainIDUpdateSQL & " SET TrainIsNotActive = " & CInt(Me.TrainInActive)
                TrainIDUpdateSQL = TrainIDUpdateSQL & " WHERE Symbol = " & q & Name & q
                TrainIDUpdateSQL = TrainIDUpdateSQL & " and ActiveSubTrainSheet = " & q & Me.ActiveTrainSheetGUID & q
                TrainIDUpdateSQL = TrainIDUpdateSQL & " ; "

