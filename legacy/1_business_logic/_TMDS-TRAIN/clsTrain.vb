        Public Sub LinkTrainID(ByVal TrainToLink As TrainID)
            Try
                If TrainToLink.Name = Me.Name Then
                    Dim frmMessageBox As frmMessageBox
                    Dim MessageList As New ArrayList()
                    MessageList.Add(optTrainLinkString1 & TrainToLink.Name)
                    MessageList.Add(optTrainLinkString2)
                    MessageList.Add("")
                    frmMessageBox = New frmMessageBox()

                    Dim trk As Track = Me.FindTrackFromTrainID(Me.Name)
                    Dim Location As Point = New Point(trk.Left, trk.Top)
                    frmMessageBox.SetMessage(MessageList, optTrainLinkString3, False, Location)
                    frmMessageBox.TopMost = True
                    frmMessageBox.Show()
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    Exit Sub
                End If
                Me.TrainIsLinked = True
                TrainLinkedToMe = TrainToLink.Name
                myTrainIDLinkedToMe = TrainToLink
                UpdateTrainLinkInDatabase(TrainToLink.Name)
                Dim EventString As String = "TRAIN:" & TrainToLink.Name & " HAS BEEN LINKED TO THIS TRAIN (" & Me.Name & ")"
                If optEnableMetroLinkSpecificOptions Then
                    EventString = "TRAIN:" & TrainToLink.Name & " HAS BEEN LINKED TO THIS TRAIN (" & Me.Name & ")" & " TrainActiveSTS:(" & Me.ActiveTrainSheetGUID & ") " & "TrackGUID: (" & Me.TrackGUID.ToString & ") " & "ControlPoint: (" & Me.GetIdentifyingLocationNameFromLimits & ") " & "HelperUnits: (" & TrainToLink.GetTrainUnitString & ") " & "TrainUnits: (" & Me.GetTrainUnitString & ") " & "LinkIDUnit: (" & TrainToLink.IdentifingUnit & ") " & "TrainIDUnit: (" & Me.IdentifingUnit & ")"
                End If
                TrainEventLog(EventString)
                AddTrainSheetEvent("HELPER ADDED", Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString & "-" & myTrainIDLinkedToMe.TrainGUID, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, True)
                If Me.PullerTrain Then
                    AddTrainSheetEvent("PULLER ADDED", Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString & "-" & myTrainIDLinkedToMe.TrainGUID, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, True)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSystemVariables()
            End Try
        End Sub

        ''' <summary>
        ''' Remove Link TrainID
        ''' </summary>
        Public Sub RemoveLinkTrainID()
            Dim mainMessageList As ArrayList
            Dim frmMainMessageBox As frmMessageBox
            Dim newDirection As String = String.Empty
            Dim trk As Track
            Dim userMessage As String
            Dim eventString As String
            Try
                TrainEventLog("RemoveLinkTrainID:WhoCallMe=" & (New System.Diagnostics.StackTrace).GetFrame(1).GetMethod.Name)
                Me.TrainIsLinked = False
                trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.TrackGUID)
                If Not IsNothing(trk) Then
                    trk.TrafficDirection = ""
                    trk.UpdateStatus()
                End If
                Try
                    If Not IsNothing(trk) Then
                        Select Case Me.myTrainIDLinkedToMe.Direction
                            Case optDirectionEast
                                newDirection = optDirectionWest
                            Case optDirectionWest
                                newDirection = optDirectionEast
                            Case optDirectionNorth
                                newDirection = optDirectionSouth
                            Case optDirectionSouth
                                newDirection = optDirectionNorth
                        End Select
                        userMessage = "CHANGE Direction OF LINKED TRAIN?" & Me.myTrainIDLinkedToMe.Name & " FROM " & Me.myTrainIDLinkedToMe.IdentifingUnit & " " & Me.myTrainIDLinkedToMe.Direction & " TO " & Me.myTrainIDLinkedToMe.IdentifingUnit & " " & newDirection
                        mainMessageList = New ArrayList()
                        mainMessageList.Add("")
                        mainMessageList.Add(optChangeDirectionString11 & ":(" & Me.myTrainIDLinkedToMe.Name & ")?")
                        mainMessageList.Add("")
                        mainMessageList.Add(optChangeDirectionString2 & " (" & Me.myTrainIDLinkedToMe.IdentifingUnit & " " & Me.myTrainIDLinkedToMe.Direction & ")")
                        mainMessageList.Add("")
                        mainMessageList.Add(optChangeDirectionString3 & " (" & Me.myTrainIDLinkedToMe.IdentifingUnit & " " & newDirection & ")")
                        mainMessageList.Add("")
                        mainMessageList.Add(optChangeDirectionString4)
                        frmMainMessageBox = New frmMessageBox()
                        frmMainMessageBox.Owner = trk.CurrentDrawingForm
                        frmMainMessageBox.SetMessage(mainMessageList, optChangeDirectionMessageHeader, True, trk.CurrentDrawingForm.myLaunchPoint)
                        frmMainMessageBox.ShowDialog()
                        If frmMainMessageBox.FormFeedBack = 6 Then
                            TrainEventLog("DISPATCHER:" & TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO " & userMessage)
                            Me.myTrainIDLinkedToMe.Direction = newDirection
                            Me.myTrainIDLinkedToMe.UpdateTrainDirection()
                            Me.myTrainIDLinkedToMe.TrainSummaryDirectionRefresh()
                        Else
                            TrainEventLog("DISPATCHER:" & TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED NO TO " & userMessage)
                        End If
                        frmMainMessageBox.Dispose()
                        frmMainMessageBox = Nothing
                        mainMessageList = Nothing
                    End If
                Catch
                End Try
                TrainLinkedToMe = ""
                UpdateTrainLinkInDatabase("")
                eventString = "LINK HAS BEEN REMOVE BETWEEN TRAIN:" & myTrainIDLinkedToMe.Name & " AND TRAIN (" & Me.Name & ")"
                TrainEventLog(eventString)
                AddTrainSheetEvent("HELPER REMOVED", Now, Mid(Me.myTrack.TimeZone, 1, 1), eventString & "-" & myTrainIDLinkedToMe.TrainGUID, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, True)
                If Me.PullerTrain Then
                    AddTrainSheetEvent("PULLER REMOVED", Now, Mid(Me.myTrack.TimeZone, 1, 1), eventString & "-" & myTrainIDLinkedToMe.TrainGUID, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, True)
                End If
                If Not IsNothing(Me.myTrainIDLinkedToMe) Then
                    Me.myTrainIDLinkedToMe.thisHelperIsLinkedToThisTrainID = Nothing
                End If
                myTrainIDLinkedToMe = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                mainMessageList = Nothing
                frmMainMessageBox = Nothing
                newDirection = Nothing
                trk = Nothing
                userMessage = Nothing
                eventString = Nothing
            End Try
        End Sub

