        Public Sub PerformActiveTrainForPTC()
            Dim ResendSFAAuthCollection As New ArrayList
            Dim ResendTNTAuthCollection As New ArrayList
            Dim SFA As Object = Nothing
            Dim TNT As Object = Nothing 'TMDS.TrackAuthority.TrackAuthority
            Dim SPL As Object = Nothing
            Try
                'TMDS.TrackAuthority.SFAuthority '
                For Each SFA In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If SFA.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        If SFA.IssuedToTrain Then
                            If SFA.TrainSymbol = Me.Name Or SFA.IssueTo = Mid(Me.IdentifingUnit, 1, 10) Then
                                If Not String.IsNullOrEmpty(SFA.PTCAuthorityACKPending) Then
                                    If Not ResendSFAAuthCollection.Contains(SFA) Then ResendSFAAuthCollection.Add(SFA)
                                Else
                                    'If s.PTCTypeAuthority Then
                                    's.VETMS_TerminatePTCIssuanceProcess()
                                    's.VETMS_TerminatePTCReleaseProcess()
                                    SFA.PTCTypeAuthority = True
                                    SFA.PTCStatus = "ACTIVE"
                                    If SFA.UpdateDatabaseWithPTCAuthorityStatus("ACTIVE") Then
                                        Dim SummItem1 As New SummaryItem("AUTHORITY", "ACTIVE", SFA)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem1)
                                        End SyncLock
                                    End If
                                    'End If
                                End If
                            End If
                        End If
                    End If
                Next


                For Each TNT In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If TNT.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                        If TNT.IssuedToTrain Then
                            If TNT.TrainSymbol = Me.Name Or TNT.IssueTo = Mid(Me.IdentifingUnit, 1, 10) Then
                                If Not String.IsNullOrEmpty(TNT.PTCAuthorityACKPending) Then
                                    If Not ResendTNTAuthCollection.Contains(TNT) Then ResendTNTAuthCollection.Add(TNT)
                                Else
                                    'If t.PTCTypeAuthority Then
                                    TNT.PTCTypeAuthority = True
                                    TNT.PTCStatus = "ACTIVE"
                                    If TNT.UpdateDatabaseWithPTCAuthorityStatus("ACTIVE") Then
                                        Dim SummItem1 As New SummaryItem("AUTHORITY", "ACTIVE", TNT)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem1)
                                        End SyncLock
                                    End If
                                    'End If
                                End If

                            End If
                        End If
                    End If
                Next


                For Each SPL In gOtherSpecialAuthorityCollection
                    If SPL IsNot Nothing AndAlso SPL.GetType.ToString = gOtherSplAuthorityName Then
                        If Not String.IsNullOrEmpty(SPL.TrainSymbol) AndAlso Me.Name = SPL.TrainSymbol Then
                            SPL.PTCTypeAuthority = True
                            SPL.PTCStatus = "AUTHORITY-ACTIVATED"
                            If SPL.UpdateDatabaseWithPTCAuthorityStatus(SPL.PTCStatus) Then
                                Dim SummItem1 As New SummaryItem("AUTHORITY", "ACTIVE", SPL)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem1)
                                End SyncLock
                            End If
                        End If
                    End If

                Next

                Me.UpdatePTCStatus("ACTIVE")
                Me.UpdatePTCAuthorityStatus("ACTIVE")
                RemoveAlertsForPTC()

                If optEnableCPSpecificPTCOperations Then ProcessResend(ResendSFAAuthCollection, ResendTNTAuthCollection)




            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                SFA = Nothing
                TNT = Nothing
                SPL = Nothing
            End Try
        End Sub

        Public Sub PerformCutOutPTC(Optional ByVal FailedPTCAuthority As Object = Nothing)
            Try
                Dim sfa As Object
                For Each sfa In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If sfa.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        Dim s As TMDS.TrackAuthority.SFAuthority = CType(sfa, TMDS.TrackAuthority.SFAuthority)
                        If s.IssuedToTrain Then
                            If s.TrainSymbol = Me.Name Or s.IssueTo = Mid(Me.IdentifingUnit, 1, 10) Then
                                If s.PTCTypeAuthority Then
                                    s.VETMS_TerminatePTCIssuanceProcess()
                                    s.VETMS_TerminatePTCReleaseProcess()
                                    s.PTCTypeAuthority = False
                                    s.PTCStatus = "INACTIVE"
                                    If s.UpdateDatabaseWithPTCAuthorityStatus("INACTIVE") Then
                                        Dim SummItem1 As New SummaryItem("AUTHORITY", "INACTIVE", s)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem1)
                                        End SyncLock
                                    End If
                                    s.SetPTCAuthorityFlasherStatus()
                                End If
                            End If
                        End If
                    End If
                Next
                Dim ta As Object
                If optEnableCPSpecificPTCOperations Then
                    ReleaseCPPTCAuthority(FailedPTCAuthority)
                Else
                    For Each ta In TMDS.GlobalDeclarations.OtherTrackAuthorities
                        If ta.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                            Dim t As TMDS.TrackAuthority.TrackAuthority = CType(ta, TMDS.TrackAuthority.TrackAuthority)
                            If t.IssuedToTrain Then
                                If t.TrainSymbol = Me.Name Or t.IssueTo = Mid(Me.IdentifingUnit, 1, 10) Then
                                    If t.PTCTypeAuthority Then
                                        t.PTCTypeAuthority = False
                                        t.PTCStatus = "INACTIVE"
                                        If t.UpdateDatabaseWithPTCAuthorityStatus("INACTIVE") Then
                                            Dim SummItem1 As New SummaryItem("AUTHORITY", "INACTIVE", t)
                                            SyncLock gSummaryAuthQueue.SyncRoot
                                                gSummaryAuthQueue.Enqueue(SummItem1)
                                            End SyncLock
                                        End If
                                        t.SetPTCAuthorityFlasherStatus("PerformCutOutPTC")
                                    End If
                                End If
                            End If
                        End If
                    Next
                End If
                Me.UpdatePTCStatus("INACTIVE")
                Me.UpdatePTCAuthorityStatus("INACTIVE")
                'NEW CODE TO REMOVE THE LINK FROM THE LOCO REPORT AND SET HE/RE TRACKS TO NOTHING WHEN A CUTOUT IS PERFORMED
                'WAIT UNTIL NEXT POSITION REPORT TO UPDATE BECAUSE WE COULD LOSE COMM AND BE STUCK WITH THESE TRACK LINKS
                If Not IsNothing(Me.myLocomotiveReport) Then
                    Me.myLocomotiveReport.myTrainID = Nothing
                    Me.myLocomotiveReport.myTrackRearEnd = Nothing
                    Me.myLocomotiveReport.EndTrack = Nothing
                    Me.myLocomotiveReport.thisCurrentTrack = Nothing
                    Me.myLocomotiveReport.myTrackHeadEnd = Nothing
                    Me.myLocomotiveReport.Killme()
                End If
                myHeadEndTrack = Nothing
                myRearEndTrack = Nothing
                IsInTrackReleaseMode = False
                AutoCutoutTrain = False
                ClearTrackTagListFromDB()
                RemoveRestrictionDeliveryListFromDB()
                RemoveAlertsForPTC()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

