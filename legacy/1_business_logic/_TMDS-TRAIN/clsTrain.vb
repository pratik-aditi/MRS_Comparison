        Private Function GetAuthorityToVoided(ByVal CompList As ArrayList) As Object
            Try
                Dim sfa As Object
                Dim comp As Object
                For Each comp In CompList
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim trk As Track = CType(comp, Track)
                        If trk.TrackAuthorities.Count > 0 Then
                            For Each sfa In trk.TrackAuthorities
                                If sfa.IssuedToTrain AndAlso sfa.TrainSymbol = Me.Name Then
                                    Return sfa
                                End If
                            Next
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
        End Function

        Private Function GetTypeOfAuthorityToIssue(ByVal AuthorityType As String, ByVal Direction As String, ByVal CompList As ArrayList) As String
            Try
                Dim AuthorityExists As Boolean
                Dim comp As Object
                For Each comp In CompList
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim t As Track = CType(comp, Track)
                        If t.TrackAuthorities.Count > 0 Then
                            Dim a As Object
                            For Each a In t.TrackAuthorities
                                If a.IssuedToTrain AndAlso a.TrainSymbol = Me.Name Then
                                    AuthorityExists = True
                                    Exit For
                                End If
                            Next
                        End If
                    End If
                Next
                Select Case AuthorityType
                    Case "BIDIRECTIONAL"
                        If AuthorityExists Then
                            Return "ItemFourToSameTrain"
                        Else
                            Return "ItemFourToTrain"
                        End If
                    Case "DIRECTIONAL"
                        If Not AuthorityExists Then
                            Return "ItemTwoToTrain"
                        End If
                End Select
                Return Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
        End Function


        Private Function GetMethodOfOperations(ByVal CompList As ArrayList) As String
            Try
                Dim CentralitizedTrafficControlled As Boolean
                Dim TrackWarrantControlled As Boolean

                Dim comp As Object
                For Each comp In CompList
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim t As Track = CType(comp, Track)
                        If t.AuthorityType = "CTC" Then
                            CentralitizedTrafficControlled = True
                        ElseIf t.AuthorityType = "TWC" Then
                            TrackWarrantControlled = True
                        End If
                    End If
                Next

                If TrackWarrantControlled AndAlso CentralitizedTrafficControlled Then
                    Return "BOTH"
                ElseIf TrackWarrantControlled Then
                    Return "TWC"
                ElseIf CentralitizedTrafficControlled Then
                    Return "CTC"
                End If
                Return "FAILED"

            Catch ex As Exception
                GetErrorDetails(ex)
                Return String.Empty
            End Try
        End Function
