        Private Sub PerformGeoFenceReset()
            Try
                RemoveAllStoredRoutes()
                Dim tr As TacticalRoute
                For Each tr In Me.myTacticalRoutes
                    If Not IsNothing(tr) Then
                        If Not IsNothing(tr.mySignalRoute) Then
                            If Not IsNothing(tr.mySignalRoute.EntrySignal.CurrentTacticalRoute) Then
                                If tr.mySignalRoute.EntrySignal.CurrentTacticalRoute.mySignalRoute.SystemUID = tr.mySignalRoute.SystemUID AndAlso (tr.myStatus = "CLEARED" OrElse tr.myStatus = "PENDING") Then
                                    tr.mySignalRoute.EntrySignal.myControlPoint.FlasherMode(True)
                                    tr.mySignalRoute.EntrySignal.ControlSignalToStop(False, True)
                                    tr.mySignalRoute.EntrySignal.CurrentTacticalRoute = Nothing
                                End If
                            End If
                        End If
                    End If
                Next

                Dim DoSendControls As New SendControls(AddressOf TMDS.SystemForms.MySystemForms.frmMainMDI.SendControls)
                DoSendControls.BeginInvoke(False, Nothing, Nothing)


                RemoveAllTacticalRoutes()
                CancelAllLicenseForPTC(True, False)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

