        ''' <summary>
        ''' Split License Between Territories
        ''' </summary>
        ''' <param name="pTrackSegments"></param>
        ''' <returns></returns>
        Private Function SplitAuthInTerritories(ByVal pTrackSegments As ArrayList, ByVal pDirection As String) As ArrayList
            Dim newTrackSegments As New ArrayList
            Dim trk As Track
            Dim comp As Object
            Dim theList As ArrayList
            Dim currentTerritoryId As Integer = 0
            Dim lastTerritoryId As Integer = 0
            Dim newList As New ArrayList
            Dim count As Integer = 0
            Dim sgl As Signal
            Try
                TrainEventLog("SplitAuthInTerritories:Start:TrackSegments=" & pTrackSegments.Count.ToString & ":Direction=" & pDirection)
                For Each theList In pTrackSegments
                    If Not IsValidTrackList(theList) Then
                        newTrackSegments.Add(theList)
                    Else
                        currentTerritoryId = 0
                        lastTerritoryId = 0
                        newList = New ArrayList
                        count = 0
                        For Each comp In theList
                            If comp.GetType.ToString = gTrackComponentName Then
                                trk = CType(comp, Track)
                                If lastTerritoryId = 0 Then
                                    lastTerritoryId = trk.TerritoryID
                                End If
                                currentTerritoryId = trk.TerritoryID
                                newList.Add(comp)
                                count += 1 'it avoid that system creates a null array = 0
                                If lastTerritoryId <> currentTerritoryId AndAlso count < theList.Count Then
                                    TrainEventLog("SplitAuthInTerritories:FoundNewTerritory=" & currentTerritoryId.ToString)
                                    If pDirection.Contains("RIGHT") Then 'Check if next obj is a signal
                                        sgl = FindSignalFromGUID(trk.RightLink)
                                        If sgl Is Nothing Then
                                            TrainEventLog("SplitAuthInTerritories:Track=" & trk.Name & " doesnt have signal assigned in right direction")
                                            Continue For
                                        Else
                                            If HasGapInNextTrack(trk, theList, pDirection) Then
                                                Continue For
                                            End If
                                        End If
                                    Else
                                        sgl = FindSignalFromGUID(trk.LeftLink)
                                        If sgl Is Nothing Then
                                            TrainEventLog("SplitAuthInTerritories:Track=" & trk.Name & " doesnt have signal assigned in left direction")
                                            Continue For
                                        Else
                                            If HasGapInNextTrack(trk, theList, pDirection) Then
                                                Continue For
                                            End If
                                        End If
                                    End If
                                    lastTerritoryId = currentTerritoryId
                                    newTrackSegments.Add(newList.Clone)
                                    newList.Clear()
                                    newList = New ArrayList
                                End If
                            End If
                        Next
                        newTrackSegments.Add(newList)
                    End If
                Next
                TrainEventLog("SplitAuthInTerritories:End:TrackSegments=" & newTrackSegments.Count.ToString & ":Direction=" & pDirection)
                Return newTrackSegments
            Catch ex As Exception
                SystemException(ex.ToString)
                Return pTrackSegments
            Finally
                newTrackSegments = Nothing
                trk = Nothing
                comp = Nothing
                theList = Nothing
                currentTerritoryId = Nothing
                lastTerritoryId = Nothing
                newList = Nothing
                count = Nothing
                sgl = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Has Gap In Next Track
        ''' </summary>
        ''' <param name="pTrackRef"></param>
        ''' <param name="pTrackList"></param>
        ''' <param name="pDirection"></param>
        ''' <returns></returns>
        Private Function HasGapInNextTrack(ByVal pTrackRef As Track, ByVal pTrackList As ArrayList, ByVal pDirection As String) As Boolean
            Dim currentTrack As Track
            Dim nextTrack As Track
            Try
                For index As Integer = 0 To pTrackList.Count - 1
                    If pTrackList(index).GetType.ToString = gTrackComponentName AndAlso pTrackRef Is pTrackList(index) Then
                        'is there next track?
                        If (index + 2) <= pTrackList.Count Then
                            currentTrack = pTrackList(index) 'current index in loop
                            nextTrack = pTrackList(index + 1) 'next index in loop
                            If pDirection.Contains("RIGHT") Then
                                'Compare the mileposts
                                If currentTrack.RightLimitMilePost = nextTrack.LeftLimitMilePost Then
                                    Return False
                                Else
                                    TrainEventLog("HasGapInNextTrack:Found gap between the tracks " & currentTrack.Name & " and " & nextTrack.Name)
                                    Return True
                                End If
                            Else 'LEFT
                                'Compare the mileposts
                                If currentTrack.LeftLimitMilePost = nextTrack.RightLimitMilePost Then
                                    Return False
                                Else
                                    TrainEventLog("HasGapInNextTrack:Found gap between the tracks " & currentTrack.Name & " and " & nextTrack.Name)
                                    Return True
                                End If
                            End If
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                currentTrack = Nothing
                nextTrack = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Is Valid Track List
        ''' </summary>
        ''' <param name="pTrackList"></param>
        ''' <returns></returns>
        Private Function IsValidTrackList(pTrackList As ArrayList) As Boolean
            Dim newTrackSegments As New ArrayList
            Dim lastSubdivId As Integer = 0
            Dim currentSubdivId As Integer = 0
            Dim trk As Track
            Try
                For Each comp As Object In pTrackList
                    If comp.GetType.ToString = gFlipFlopComponentName Then
                        TrainEventLog("IsValidTrackList:Flipflop found:Flipflop=" & comp.GUID.ToString & ":" & comp.Name)
                        Return False 'Avoid flipflop comps
                    ElseIf comp.GetType.ToString = gTrackComponentName Then
                        trk = CType(comp, Track)
                        If lastSubdivId = 0 Then
                            lastSubdivId = trk.SubdivisionID
                        End If
                        currentSubdivId = trk.SubdivisionID
                        'If trk.IsRemoteTrack Then
                        '    TrainEventLog("IsValidTrackList:Remote track found:Track=" & trk.GUID.ToString & ":" & trk.Name)
                        '    Return False 'Avoid remote tracks
                        'End If
                        If lastSubdivId <> currentSubdivId Then
                            TrainEventLog("IsValidTrackList:Different subdivs found:Track=" & trk.GUID.ToString & ":" & trk.Name)
                            Return False 'Avoid diff subdiv
                        End If
                        If trk.TrackAlternativeName.Contains("NOSPLITAUTH") Then
                            TrainEventLog("IsValidTrackList:Nosplitauth flag found:Track=" & trk.GUID.ToString & ":" & trk.Name)
                            Return False 'flag to avoid split auth in some places
                        End If
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                newTrackSegments = Nothing
                lastSubdivId = Nothing
                currentSubdivId = Nothing
                trk = Nothing
            End Try
        End Function

        Public Function GetEndingSignalInRoute(ByVal RouteList As ArrayList) As Signal
            Dim theNextSignal As Signal
            Try
                TrainEventLog("GetEndingSignalInRoute")
                If RouteList.Count > 0 Then
                    Dim theRoute As SignalRoute = RouteList(RouteList.Count - 1)
                    Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(theRoute.ComponentList)
                    If theRoute.EntrySignal.ComponentType = "R" Then
                        theNextSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(LastTrack.RightLink)
                    Else
                        theNextSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(LastTrack.LeftLink)
                    End If
                Else
                    If Me.Direction = "RIGHT" Then
                        theNextSignal = TMDS.SystemUtilities.FetchData.FindSignalFromRightGUID(Me.myTrack.RightLink)
                    Else
                        theNextSignal = TMDS.SystemUtilities.FetchData.FindSignalFromLeftGUID(Me.myTrack.LeftLink)

                    End If
                End If

                Return theNextSignal

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function GetEndingSignalInLastRoute(ByVal tr As TacticalRoute) As Signal
            Dim theNextSignal As Signal = Nothing

            Try
                TrainEventLog("GetEndingSignalInLastRoute")

                Dim theRoute As SignalRoute = tr.mySignalRoute
                Dim LoopControl As Integer
                Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(theRoute.ComponentList)
                Dim NextComp As Object = LastTrack
                If theRoute.EntrySignal.ComponentType = "R" Then
                    Do
                        NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                        If NextComp.GetType.ToString = gSignalComponentName Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.ComponentType = "R" Then
                                theNextSignal = sig
                                Exit Do
                            End If
                        End If
                        LoopControl += 1
                        If LoopControl > 10 Then Exit Do
                    Loop
                    'theNextSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(LastTrack.RightLink)
                Else
                    Do
                        NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                        If NextComp.GetType.ToString = gSignalComponentName Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.ComponentType = "L" Then
                                theNextSignal = sig
                                Exit Do
                            End If
                        End If
                        LoopControl += 1
                        If LoopControl > 10 Then Exit Do
                    Loop
                    'theNextSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(LastTrack.LeftLink)
                End If

                Return theNextSignal

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        ''' <summary>
        ''' Get Signal Route
        ''' </summary>
        ''' <param name="pSignal"></param>
        ''' <returns></returns>
        Public Function GetSignalRoute(ByVal pSignal As Signal) As SignalRoute
            Dim theRoute As SignalRoute
            Dim comp As Object
            Dim theExitSignal As Signal = Nothing
            Try
                TrainEventLog("GetSignalRoute:Signal=" & pSignal.GUID & ":" & pSignal.Name)
                For Each comp In pSignal.SignalRouteCollection
                    If pSignal.ComponentType = "R" Then
                        Dim LeftSignal As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(comp.RightLink)
                        If Not IsNothing(LeftSignal) Then
                            theExitSignal = LeftSignal
                            Exit For
                        End If
                    ElseIf pSignal.ComponentType = "L" Then
                        Dim RightSignal As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(comp.LeftLink)
                        If Not IsNothing(RightSignal) Then
                            theExitSignal = RightSignal
                            Exit For
                        End If
                    End If
                Next
                If pSignal.Tag = "IGNORE FOR LICENSE:" & Me.Name Then
                    If IsNothing(theExitSignal) Then
                        theExitSignal = FindTheExitSignal(pSignal)
                        TrainEventLog("GetSignalRoute:Ignore For License")
                    End If
                End If
                'RMT701-CAD didn't add the signal in license
                'Need to find the exit signal
                'jcosta - 09/19/17
                If IsNothing(theExitSignal) And Not pSignal.JointControlAuthorizationEnabled Then
                    theExitSignal = FindTheExitSignal(pSignal)
                    TrainEventLog("GetSignalRoute:Find exit signal for=" & pSignal.Name)
                End If
                theRoute = FindSignalRoute(pSignal, theExitSignal)
                Return theRoute
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                theRoute = Nothing
                comp = Nothing
                theExitSignal = Nothing
            End Try
        End Function

        Private Function FindTheExitSignal(ByVal theSignal As Signal) As Signal
            Try
                Dim theDirection As String = theSignal.ComponentType
                Dim NextComp As Object = Nothing
                Dim LoopControl As Integer

                Select Case theDirection
                    Case "L"
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(theSignal.LeftLink)
                    Case Else
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(theSignal.RightLink)

                End Select


                Do Until LoopControl > 20
                    Select Case theDirection
                        Case "L"

                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(NextComp, Signal)
                                Return sig
                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)
                                If sw.LeftAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                            ElseIf NextComp.GetType.ToString = gTrackComponentName Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If

                        Case "R"

                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(NextComp, Signal)
                                Return sig
                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)
                                If sw.RightAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            ElseIf NextComp.GetType.ToString = gTrackComponentName Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                    End Select
                    LoopControl += 1
                Loop
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

