        Private Function GetLicenseVerbiage(ByVal RouteList As ArrayList) As ArrayList

            Dim theEndingSignal As Signal = GetEndingSignalInRoute(RouteList)
            Dim AuthLimitsVerbiage As New StringBuilder
            Dim AuthLimitList As New ArrayList
            Dim i As Integer = 0
            Dim checkTrackNameAlias As Boolean
            Try
                Dim sr As SignalRoute
                checkTrackNameAlias = IsLicenseOnSameTrackLine(RouteList)
                For Each sr In RouteList
                    Dim NextSignalToEnter As Signal = Nothing

                    If RouteList.IndexOf(sr) <> RouteList.Count - 1 Then

                        If checkTrackNameAlias Then
                            If i >= 1 Then
                                Continue For
                            Else
                                Dim NextRoute As SignalRoute = RouteList(RouteList.IndexOf(sr) + 1)
                                NextSignalToEnter = NextRoute.EntrySignal
                            End If

                            i += 1
                        Else
                            Dim NextRoute As SignalRoute = RouteList(RouteList.IndexOf(sr) + 1)
                            NextSignalToEnter = NextRoute.EntrySignal
                        End If



                    Else
                        NextSignalToEnter = theEndingSignal


                    End If

                    AuthLimitsVerbiage.Append(optAuthString73)
                    AuthLimitsVerbiage.Append("|")
                    AuthLimitsVerbiage.Append(sr.EntrySignal.myToolTip & Space(1) & optAuthString66 & Space(1) & sr.EntrySignal.myControlPoint.Name)
                    AuthLimitsVerbiage.Append("|")
                    AuthLimitsVerbiage.Append(optAuthString78 & Space(1) & NextSignalToEnter.myToolTip & Space(1) & optAuthString66 & Space(1) & NextSignalToEnter.myControlPoint.Name)
                    AuthLimitsVerbiage.Append("|")
                    AuthLimitsVerbiage.Append(optAuthString74 & Space(1) & sr.ExitTrack.TrackNameAlias & Space(1))
                    AuthLimitsVerbiage.Append("|")
                    AuthLimitList.Add(AuthLimitsVerbiage.ToString)
                    AuthLimitsVerbiage = New StringBuilder
                Next

                If RouteList.Count = 0 AndAlso Not IsNothing(theEndingSignal) Then
                    AuthLimitsVerbiage.Append(optAuthString73 & Space(1) & theEndingSignal.myToolTip & Space(1) & optAuthString66 & Space(1) & theEndingSignal.myControlPoint.Name)
                    AuthLimitList.Add(AuthLimitsVerbiage.ToString)
                End If

                Return AuthLimitList
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        ''' <summary>
        ''' Get License Text
        ''' </summary>
        ''' <param name="pRouteList"></param>
        ''' <returns></returns>
        Public Function GetLicenseVerbiageAbbreviated(ByVal pRouteList As ArrayList) As ArrayList
            Dim authLimitList As New ArrayList
            Dim lastRoute As SignalRoute = Nothing
            Dim exitTrack As Track = Nothing
            Dim theStartingSignal As Signal
            Dim theEndingSignal As Signal = Nothing
            Dim authLimitsVerbiage As New StringBuilder
            Dim firstRoute As SignalRoute
            Dim trainDirectionAux As String
            Try
                theStartingSignal = FindStartingSignal()
                If Not IsNothing(pRouteList) AndAlso pRouteList.Count > 0 Then
                    lastRoute = pRouteList.Item(pRouteList.Count - 1)
                    exitTrack = lastRoute.LastTrack
                    'If direction is divergent than train id is need to add the route direction
                    firstRoute = pRouteList.Item(0)
                    trainDirectionAux = IIf(Me.Direction = "SUBINDO", "RIGHT", "LEFT")
                    If firstRoute.myDirection <> trainDirectionAux Or theStartingSignal Is Nothing Or Me.myTrack.TrafficDirection <> trainDirectionAux Then
                        theStartingSignal = firstRoute.EntrySignal
                        TrainEventLog("GetLicenseVerbiageAbbreviated:First route direction divergent than train id")
                    End If
                End If
                If IsNothing(exitTrack) Then
                    theEndingSignal = FindEndingSignal(myTrack)
                    exitTrack = myTrack
                Else
                    theEndingSignal = FindEndingSignal(exitTrack)
                End If
                'NORMAL LICENSE
                If Not IsNothing(theStartingSignal) AndAlso Not IsNothing(theEndingSignal) AndAlso theStartingSignal.GUID <> theEndingSignal.GUID Then
                    authLimitsVerbiage.Append(optAuthString73)
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append(theStartingSignal.myToolTip & Space(1) & optAuthString66 & Space(1) & theStartingSignal.myControlPoint.UniqueName)
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append(optAuthString74 & Space(1) & Me.myTrack.TrackNameAlias & Space(1))
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append(optAuthString78 & Space(1) & theEndingSignal.myToolTip & Space(1) & optAuthString66 & Space(1) & theEndingSignal.myControlPoint.UniqueName)
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append(optAuthString74 & Space(1) & exitTrack.TrackNameAlias & Space(1))
                    'Check if is birectional license
                    If Me.SpecialLicenseSendReason <> Nothing And Me.IsBIDirectional = True Then
                        authLimitsVerbiage.Append("|")
                        If Me.ClickedOnSpecialLicense3 Then
                            authLimitsVerbiage.Append(optAuthString81 & Space(1) & Me.SpecialLicenseSendReason & Space(1) & optAuthString82 & Space(1) & Me.TNTExpireDate.Hour.ToString & ":" & Me.TNTExpireDate.Minute.ToString)
                        Else
                            authLimitsVerbiage.Append(optAuthString81 & Space(1) & Me.SpecialLicenseSendReason)
                        End If
                    End If
                    TrainEventLog("GetLicenseVerbiageAbbreviated:Text=" & authLimitsVerbiage.ToString)
                ElseIf theStartingSignal IsNot Nothing AndAlso theEndingSignal IsNot Nothing AndAlso theStartingSignal.GUID = theEndingSignal.GUID Then 'TRAIN ON THE SAME TRACK
                    authLimitsVerbiage.Append(optAuthString83)
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append(optAuthString84)
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append(optAuthString85)
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append("")
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append("")
                    TrainEventLog("GetLicenseVerbiageAbbreviated:TrainOnTheSameTrack:Text=" & authLimitsVerbiage.ToString)
                ElseIf Not IsNothing(theStartingSignal) Then 'OTHERS LIMITS LIKE SPLIT DESK AND NO END SIGNAL FOUND (SIDING LINES)
                    authLimitsVerbiage.Append(optAuthString73)
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append(theStartingSignal.myToolTip & Space(1) & optAuthString66 & Space(1) & theStartingSignal.myControlPoint.UniqueName)
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append(optAuthString74 & Space(1) & Me.myTrack.TrackNameAlias & Space(1))
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append("")
                    authLimitsVerbiage.Append("|")
                    authLimitsVerbiage.Append("")
                    TrainEventLog("GetLicenseVerbiageAbbreviated:Otherslimits:Text=" & authLimitsVerbiage.ToString)
                End If
                authLimitList.Add(authLimitsVerbiage.ToString)
                Return authLimitList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                authLimitList = Nothing
                lastRoute = Nothing
                exitTrack = Nothing
                theStartingSignal = Nothing
                theEndingSignal = Nothing
                authLimitsVerbiage = Nothing
                firstRoute = Nothing
                trainDirectionAux = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Extend Route To Next Signal
        ''' </summary>
        ''' <param name="lastRoute">last Route</param>
        ''' <param name="componentList">component List</param>
        Private Sub ExtendRouteToNextSignal(lastRoute As SignalRoute,
                                            ByRef componentList As ArrayList)
            Try
                If lastRoute Is Nothing Then Exit Sub
                Dim theDirection As String = lastRoute.myDirection
                Dim nextComp As Object = lastRoute.ComponentList(lastRoute.ComponentList.Count - 1)
                Dim loopControl As Integer
                Dim theList As New ArrayList
                Do Until loopControl > 10
                    Select Case theDirection
                        Case "RIGHT"
                            If nextComp.GetType.ToString = gSignalComponentName AndAlso
                                nextComp.ComponentType = "R" Then
                                TrainEventLog($"{GetCurrentMethod.Name}:Component={nextComp.guid}")
                                Exit Do
                            End If
                            If nextComp.RightLink <> 0 Then
                                nextComp = FindCompItemFromGUID(nextComp.RightLink)
                            ElseIf nextComp.AltLinkTwo <> 0 Then
                                nextComp = FindCompItemFromGUID(nextComp.AltLinkTwo)
                            End If
                        Case Else
                            If nextComp.GetType.ToString = gSignalComponentName AndAlso
                                nextComp.ComponentType = "L" Then
                                TrainEventLog($"{GetCurrentMethod.Name}:Component={nextComp.guid}")
                                Exit Do
                            End If
                            If nextComp.LeftLink <> 0 Then
                                nextComp = FindCompItemFromGUID(nextComp.LeftLink)
                            ElseIf nextComp.AltLinkOne <> 0 Then
                                nextComp = FindCompItemFromGUID(nextComp.AltLinkOne)
                            End If
                    End Select
                    Select Case nextComp.GetType.ToString
                        Case gSwitchComponentName, gTrackComponentName
                            If Not theList.Contains(nextComp) Then
                                TrainEventLog($"{GetCurrentMethod.Name}:AddList={nextComp.guid}")
                                theList.Add(nextComp)
                            End If
                    End Select
                    loopControl += 1
                Loop
                For Each oneComponent As Object In theList
                    If Not componentList.Contains(oneComponent) Then
                        If oneComponent.GetType.ToString = gTrackComponentName Then
                            Dim t As Track = CType(oneComponent, Track)
                            If Not t.IsControlledForPTC AndAlso
                                    GeoFenceEnabled AndAlso
                                    Not (IsTestCBTC AndAlso
                                    (t.IsTestForPTC OrElse gSimulationMode)) Then
                                Exit For
                            End If
                        End If
                        TrainEventLog($"{GetCurrentMethod.Name}:AddComp={oneComponent.GUID}")
                        componentList.Add(oneComponent)
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function ConfirmRearEndIncudesSwitchTracks() As Track
            Try
                TrainEventLog("ConfirmRearEndIncudesSwitchTracks")
                If Me.myRearEndTrack.OStype Then
                    Dim theSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(Me.myRearEndTrack)
                    If Not IsNothing(theSw) Then
                        If Me.Direction = optDirectionSouth Then
                            If theSw.RightAltLink <> 0 Then
                                Return theSw.NormalTrackTrailingPortion
                            Else
                                Return theSw.NormalTrackFacingPortion
                            End If
                        Else
                            If theSw.RightAltLink <> 0 Then
                                Return theSw.NormalTrackFacingPortion
                            Else
                                Return theSw.NormalTrackTrailingPortion
                            End If

                        End If
                        If Me.myRearEndTrack.GUID = theSw.NormalTrackTrailingPortion.GUID Then
                            Return theSw.NormalTrackFacingPortion
                        End If
                        Return theSw.NormalTrackTrailingPortion
                    End If
                End If
                Return Me.myRearEndTrack
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Me.myRearEndTrack
            End Try
        End Function

        ''' <summary>
        ''' Add Components That Include Train Position Up To First Route
        ''' </summary>
        ''' <param name="firstRoute">first route</param>
        ''' <param name="componentList">component list</param>
        Private Sub AddCompTrainPositionFirstRoute(firstRoute As SignalRoute,
                                                   ByRef componentList As ArrayList)
            Try
                If firstRoute Is Nothing Then Exit Sub
                TrainEventLog($"{GetCurrentMethod.Name}:EntrySignal={firstRoute.EntrySignal.Name}:Tag={firstRoute.EntrySignal.Tag}")
                Dim loopControl As Integer
                Dim compList As New ArrayList
                Dim lastComp As Object
                Dim headEndTrackFound As Boolean
                Dim theDirection As String = firstRoute.myDirection
                Dim nextComp As Object = GetBeginningTrackOfEntireTrain()
                'Need to change direction when occupying a flipflop
                If FoundFlipFlopForSearch Then
                    If theDirection = "RIGHT" Then
                        theDirection = "LEFT"
                        FoundFlipFlopForSearch = False
                    Else
                        theDirection = "RIGHT"
                        FoundFlipFlopForSearch = False
                    End If
                End If
                'Find the rigth begin track
                If nextComp Is Nothing AndAlso
                    gSelectedTrainIDTrack IsNot Nothing AndAlso
                    myTrack IsNot Nothing AndAlso
                    gSelectedTrainIDTrack <> myTrack Then
                    TrainEventLog($"{GetCurrentMethod.Name}:Get first track from gSelectedTrainIDTrack")
                    nextComp = gSelectedTrainIDTrack
                End If
                If nextComp Is Nothing Then
                    TrainEventLog($"{GetCurrentMethod.Name}:NextComp=Nothing")
                    Exit Sub
                Else
                    TrainEventLog($"{GetCurrentMethod.Name}:Nextcomp={nextComp.GUID}:{nextComp.Name}")
                    If Not IsNothing(myRearEndTrack) Then
                        If Not IsNothing(thisCurrentLicense) Then
                            If thisCurrentLicense.ComponentsInSelection.Contains(myRearEndTrack) Then
                                If Not myRearEndTrack.Occuppied Then
                                    TrainEventLog($"{GetCurrentMethod.Name}:RearEndTrackNotOccuppied")
                                End If
                            End If
                        End If
                        nextComp = ConfirmRearEndIncudesSwitchTracks()
                        TrainEventLog($"{GetCurrentMethod.Name}:ConfirmRearEndIncudesSwitchTracks:Nextcomp={nextComp.GUID}:{nextComp.Name}")
                    End If
                End If
                TrainEventLog($"{GetCurrentMethod.Name}:STep2:NextComp={nextComp.GUID}:MyTrack={myTrack.Name}")
                If nextComp.GUID = myTrack.GUID Then
                    If Not componentList.Contains(nextComp) Then
                        componentList.Add(nextComp)
                    End If
                    TrainEventLog($"{GetCurrentMethod.Name}:NextComp:myTrack={nextComp.GUID}:{nextComp.Name}")
                    Exit Sub
                End If
                Dim firstTrackInBlock As Track = nextComp
                TrainEventLog("AddCompTrainPositionFirstRoute:Step3:FirstTrackInBlock=" & nextComp.GUID & ":" & nextComp.Name & ":Direction=" & firstRoute.myDirection)
                lastComp = nextComp
                loopControl = 0
                If IsNothing(firstTrackInBlock) Then
                    TrainEventLog("AddCompTrainPositionFirstRoute:firstTrackInBlock is nothing")
                    Exit Sub
                End If
                compList.Add(firstTrackInBlock)
                nextComp = firstTrackInBlock
                Do Until loopControl > 50
                    Select Case theDirection
                        Case "RIGHT"
                            If nextComp.GetType.ToString = gSignalComponentName Then
                                Dim theSignal As Signal = DirectCast(nextComp, Signal)
                                If theSignal.GUID = firstRoute.EntrySignal.GUID Then
                                    TrainEventLog($"{GetCurrentMethod.Name}:Signal {theSignal.Name} found")
                                    Exit Do
                                End If
                                nextComp = SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightLink)
                                If nextComp.GetType.ToString = gTrackComponentName OrElse
                                    nextComp.GetType.ToString = gSwitchComponentName Then
                                    compList.Add(nextComp)
                                    TrainEventLog($"{GetCurrentMethod.Name}:Added signal name {theSignal.Name}")
                                End If
                            ElseIf nextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(nextComp, Switch)
                                If sw.TrackAuthorities.Count > 1 AndAlso sw.RightAltLink <> 0 Then
                                    nextComp = FindTrainRouteTrack(sw, "RIGHT")
                                Else
                                    If sw.RightAltLink <> 0 Then
                                        If sw.ControlledReverse Then
                                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightAltLink)
                                        Else
                                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightLink)
                                        End If
                                    Else
                                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightLink)
                                    End If
                                End If
                                compList.Add(sw)
                                If Not compList.Contains(sw.NormalTrackTrailingPortion) Then
                                    compList.Add(sw.NormalTrackTrailingPortion)
                                    TrainEventLog("AddCompTrainPositionFirstRoute:RIGHT-TRACK-TTP=" & sw.NormalTrackTrailingPortion.Name)
                                End If
                            ElseIf nextComp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(nextComp, Track)
                                If Not trk.Occuppied AndAlso headEndTrackFound Then
                                    If IsNothing(Me.myRearEndTrack) OrElse (trk.GUID <> Me.myRearEndTrack.GUID) Then
                                        TrainEventLog("AddCompTrainPositionFirstRoute:TrackUnOccFound-EXIT=" & trk.Name)
                                        Exit Do
                                    End If
                                End If
                                If Not compList.Contains(trk) OrElse headEndTrackFound Then
                                    compList.Add(trk)
                                    TrainEventLog("AddCompTrainPositionFirstRoute:RIGHT-TRACK=" & trk.Name)
                                End If
                                If Me.myHeadEndTrack IsNot Nothing AndAlso Me.myHeadEndTrack.GUID = trk.GUID Then
                                    headEndTrackFound = True
                                End If
                                nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightLink)
                            End If
                        Case Else
                            If nextComp.GetType.ToString = gSignalComponentName Then
                                Dim theSignal As Signal = DirectCast(nextComp, Signal)
                                If theSignal.GUID = firstRoute.EntrySignal.GUID Then
                                    TrainEventLog($"{GetCurrentMethod.Name}:Signal {theSignal.Name} found")
                                    Exit Do
                                End If
                                nextComp = SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                                If nextComp.GetType.ToString = gTrackComponentName OrElse
                                    nextComp.GetType.ToString = gSwitchComponentName Then
                                    compList.Add(nextComp)
                                    TrainEventLog($"{GetCurrentMethod.Name}:Added signal name {theSignal.Name}")
                                End If
                            ElseIf nextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(nextComp, Switch)
                                If sw.TrackAuthorities.Count > 1 AndAlso sw.LeftAltLink <> 0 Then
                                    nextComp = FindTrainRouteTrack(sw, "LEFT")
                                Else
                                    If sw.LeftAltLink <> 0 Then
                                        If sw.ControlledReverse Then
                                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftAltLink)
                                        Else
                                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                                        End If
                                    Else
                                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                                    End If
                                End If
                                compList.Add(sw)
                                If Not compList.Contains(sw.NormalTrackTrailingPortion) Then
                                    compList.Add(sw.NormalTrackTrailingPortion)
                                    TrainEventLog("AddCompTrainPositionFirstRoute:LEFT-TRACK-TTP=" & sw.NormalTrackTrailingPortion.Name)
                                End If
                            ElseIf nextComp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(nextComp, Track)
                                If Not trk.Occuppied AndAlso headEndTrackFound Then
                                    If IsNothing(Me.myRearEndTrack) OrElse (trk.GUID <> Me.myRearEndTrack.GUID) Then
                                        TrainEventLog("AddCompTrainPositionFirstRoute:TrackUnOccFound-EXIT=" & trk.Name)
                                        Exit Do
                                    End If
                                End If
                                If Not compList.Contains(trk) Then
                                    compList.Add(trk)
                                    TrainEventLog("AddCompTrainPositionFirstRoute:LEFT-TRACK=" & trk.Name)
                                End If
                                If Me.myHeadEndTrack IsNot Nothing AndAlso Me.myHeadEndTrack.GUID = trk.GUID Then
                                    headEndTrackFound = True
                                End If
                                nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                            End If
                    End Select
                    loopControl += 1
                Loop
                If compList.Count > 0 Then
                    Dim comp As Object
                    For Each comp In compList
                        If Not componentList.Contains(comp) Then
                            componentList.Add(comp)
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub AddComponentsThatIncludeTrainPositionUpToFirstRouteForPSS(ByVal FirstSignal As Signal, ByRef CompList As ArrayList)
            Try
                TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute:Start")

                If IsNothing(FirstSignal) Then Exit Sub

                Dim theDirection As String = String.Empty
                Select Case FirstSignal.ComponentType
                    Case "L"
                        theDirection = "LEFT"
                    Case "R"
                        theDirection = "RIGHT"
                End Select


                Dim FirstTrackInBlock As Track = Nothing
                Dim NextComp As Object
                NextComp = GetBeginningTrackOfEntireTrain() 'gSelectedTrainIDTrack 'Me.myTrack 'FirstRoute.EntryTrack

                If IsNothing(NextComp) Then
                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-NextComp=Nothing")
                    Exit Sub
                Else
                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-Nextcomp=" & NextComp.Name)

                    If Not IsNothing(Me.myRearEndTrack) Then
                        If Not IsNothing(Me.thisCurrentLicense) Then
                            If Me.thisCurrentLicense.ComponentsInSelection.Contains(Me.myRearEndTrack) Then
                                If Not Me.myRearEndTrack.Occuppied Then
                                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-RearEndTrackNotOccuppied")
                                End If
                            End If
                        End If
                        NextComp = ConfirmRearEndIncudesSwitchTracks()
                        TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-ConfirmRearEndIncudesSwitchTracks=" & NextComp.Name)

                    End If
                End If

                If NextComp.GUID = Me.myTrack.GUID Then
                    If Not CompList.Contains(NextComp) Then
                        CompList.Add(NextComp)
                    End If
                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-NextComp=myTrack=" & NextComp.Name)
                    Exit Sub
                End If

                FirstTrackInBlock = NextComp
                TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-FirstTrackInBlock=" & NextComp.Name)

                Dim LastComp As Object = NextComp
                Dim LoopControl As Integer
                Dim theList As New ArrayList
                LoopControl = 0
                If IsNothing(FirstTrackInBlock) Then Exit Sub
                theList.Add(FirstTrackInBlock)
                NextComp = FirstTrackInBlock
                Dim HeadEndTrackFound As Boolean
                Do Until LoopControl > 50
                    Select Case theDirection
                        Case "RIGHT"
                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(NextComp, Signal)
                                If sig.GUID = FirstSignal.GUID Then
                                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-SignalFound-EXIT")
                                    Exit Do
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                If NextComp.GetType.ToString = gTrackComponentName OrElse NextComp.GetType.ToString = gSwitchComponentName Then
                                    theList.Add(NextComp)
                                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRouteRIGHT-SIGNAL=" & sig.Name)
                                End If
                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)
                                If sw.TrackAuthorities.Count > 1 AndAlso sw.RightAltLink <> 0 Then
                                    NextComp = FindTrainRouteTrack(sw, "RIGHT")
                                Else
                                    If sw.RightAltLink <> 0 Then
                                        If sw.ControlledReverse Then
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                        End If
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                                End If
                                theList.Add(sw)
                                If Not theList.Contains(sw.NormalTrackTrailingPortion) Then
                                    theList.Add(sw.NormalTrackTrailingPortion)
                                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRouteRIGHT-TRACK-TTP=" & sw.NormalTrackTrailingPortion.Name)
                                End If
                            ElseIf NextComp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(NextComp, Track)
                                If Not trk.Occuppied AndAlso HeadEndTrackFound Then
                                    If IsNothing(Me.myRearEndTrack) OrElse (trk.GUID <> Me.myRearEndTrack.GUID) Then
                                        TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-TrackUnOccFound-EXIT=" & trk.Name)
                                        Exit Do
                                    End If
                                End If
                                If Not theList.Contains(trk) AndAlso HeadEndTrackFound Then
                                    theList.Add(trk)
                                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRouteRIGHT-TRACK=" & trk.Name)
                                End If
                                If Me.myHeadEndTrack IsNot Nothing AndAlso Me.myHeadEndTrack.GUID = trk.GUID Then
                                    HeadEndTrackFound = True
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If


                        Case Else
                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(NextComp, Signal)
                                If sig.GUID = FirstSignal.GUID Then
                                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-SignalFound-EXIT")
                                    Exit Do
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                If NextComp.GetType.ToString = gTrackComponentName OrElse NextComp.GetType.ToString = gSwitchComponentName Then
                                    theList.Add(NextComp)
                                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRouteLEFT-SIGNAL=" & sig.Name)
                                End If

                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)

                                If sw.TrackAuthorities.Count > 1 AndAlso sw.LeftAltLink <> 0 Then
                                    NextComp = FindTrainRouteTrack(sw, "LEFT")
                                Else
                                    If sw.LeftAltLink <> 0 Then
                                        If sw.ControlledReverse Then
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                        End If
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    End If
                                End If

                                theList.Add(sw)
                                If Not theList.Contains(sw.NormalTrackTrailingPortion) Then
                                    theList.Add(sw.NormalTrackTrailingPortion)
                                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRouteLEFT-TRACK-TTP=" & sw.NormalTrackTrailingPortion.Name)
                                End If

                            ElseIf NextComp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(NextComp, Track)
                                If Not trk.Occuppied AndAlso HeadEndTrackFound Then
                                    If IsNothing(Me.myRearEndTrack) OrElse (trk.GUID <> Me.myRearEndTrack.GUID) Then
                                        TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRoute-TrackUnOccFound-EXIT=" & trk.Name)
                                        Exit Do
                                    End If
                                End If
                                If Not theList.Contains(trk) Then
                                    theList.Add(trk)
                                    TrainEventLog("AddComponentsThatIncludeTrainPositionUpToFirstRouteLEFT-TRACK=" & trk.Name)
                                End If
                                If Me.myHeadEndTrack IsNot Nothing AndAlso Me.myHeadEndTrack.GUID = trk.GUID Then
                                    HeadEndTrackFound = True
                                End If

                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If

                    End Select

                    LoopControl += 1
                Loop

                If theList.Count > 0 Then
                    Dim comp As Object

                    For Each comp In theList
                        If Not CompList.Contains(comp) Then
                            CompList.Add(comp)
                        End If
                    Next
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindTrainRouteTrack(theSw As Switch, theDirection As String) As Track
            Try
                Dim SidingTrack As Track = TMDS.SystemUtilities.FetchData.FindSidingTrackFromSwitch(theSw)
                If theDirection = "RIGHT" Then
                    If Not IsNothing(SidingTrack) AndAlso Not IsNothing(Me.thisCurrentLicense) AndAlso Me.thisCurrentLicense.ComponentsInSelection.Contains(SidingTrack) Then
                        Return TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(theSw.RightAltLink)
                    Else
                        Return theSw.NormalTrackTrailingPortion
                    End If
                Else
                    If Not IsNothing(SidingTrack) AndAlso Not IsNothing(Me.thisCurrentLicense) AndAlso Me.thisCurrentLicense.ComponentsInSelection.Contains(SidingTrack) Then
                        Return TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(theSw.LeftAltLink)
                    Else
                        Return theSw.NormalTrackTrailingPortion
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
                Return theSw.NormalTrackTrailingPortion
            End Try
        End Function

        Public Sub ResendLicense()
            Try
                TrainEventLog("ResendLicense")

                If IsNothing(thisCurrentLicense) Then Exit Sub
                thisCurrentLicense.PTCIssuanceSuccessful = False
                thisCurrentLicense.NeedsElectronicTransmission = True
                thisCurrentLicense.CheckToAcknowledgeAlert()
                thisCurrentLicense.VETMS_PerformReIssuance(Me)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function IsLicenseOnSameTrackLine(ByVal RouteList As ArrayList) As Boolean
            Try
                Dim sr As SignalRoute
                Dim test As Boolean = True
                For Each sr In RouteList
                    If sr.EntryTrack.TrackNameAlias <> sr.ExitTrack.TrackNameAlias Then
                        Return False
                        Exit For
                    End If
                Next
                Return test
            Catch ex As Exception

            End Try
        End Function

        ''' <summary>
        ''' Get segments for local desk
        ''' </summary>
        ''' <param name="pFirstRoute"></param>
        ''' <param name="pComponentList"></param>
        ''' <param name="pSegmentList"></param>
        Public Sub GetTrackSegmentsForCAD(ByVal pFirstRoute As SignalRoute, ByVal pComponentList As ArrayList, ByRef pSegmentList As ArrayList, ByVal pIsRollup As Boolean, ByVal pWhoCallMe As String)
            Dim theDirection As String = "RIGHT"
            Dim HeadEndprefix As String = ""
            Dim suffix As String
            Dim RearEndPrefix As String = ""
            Dim PreviousTrkPrefix As String = ""
            Dim PreviousTrkSubID As Integer
            Dim count As Integer = 1
            Dim bi As BackOfficeServerInstance
            Dim SubDivIDList As New ArrayList
            Dim CurrentTrackName As String = String.Empty
            Dim comp As Object = Nothing
            Dim TrackSegments As New ArrayList
            Dim CurrentTrackList As ArrayList = Nothing
            Dim Flipme As Boolean
            Dim TrackNameForFlipFlop As String = String.Empty
            Dim TempTrackList As New ArrayList
            Dim BeginPrefix As String = String.Empty
            Dim BeginMilePost As String = String.Empty
            Dim BeginSuffix As String = String.Empty
            Dim EndPrefix As String = String.Empty
            Dim EndMilePost As String = String.Empty
            Dim EndSuffix As String = String.Empty
            Dim theTrackName As String = String.Empty
            Dim Segment As New StringBuilder
            Dim theList As ArrayList
            Dim LastComp As Object = Nothing
            Dim TNA As String = String.Empty
            Dim MPRight As String = String.Empty
            Dim MPLeft As String = String.Empty
            Dim flipLastUid As Integer = 0
            Dim flipCount As Integer = 0
            Dim foundFlipFlop As Boolean = False
            Try
                isSpanningAuthoirty = False
                If pFirstRoute.EntrySignal.ComponentType = "L" Then
                    theDirection = "LEFT"
                End If
                If Not IsNothing(Me.thisCurrentLicense) Then
                    theDirection = Me.thisCurrentLicense.Direction
                End If
                TrainEventLog("GetTrackSegmentsForCAD:Start:Direction=" & theDirection & ":EntrySignal=" & pFirstRoute.EntrySignal.Name & ":WhoCallMe=" & pWhoCallMe)
                Dim MyRearEndTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(pComponentList)
                If Not IsNothing(myTrack) Then
                    HeadEndprefix = myTrack.MilePostPrefix
                End If
                If Not IsNothing(MyRearEndTrack) Then
                    RearEndPrefix = MyRearEndTrack.MilePostPrefix
                    TrainEventLog("GetTrackSegmentsForCAD:MyRearEndTrack=" & MyRearEndTrack.GUID.ToString & ":" & MyRearEndTrack.Name)
                End If
                If Me.myLocomotiveReport IsNot Nothing Then
                    TrainEventLog("GetTrackSegmentsForCAD:DirectionOfTravel=" & Me.myLocomotiveReport.DirectionOfTravel)
                End If
                If Not IsNothing(myTrack) Then
                    suffix = myTrack.MilePostSuffix
                End If
                If HeadEndprefix <> "" Then
                    PreviousTrkPrefix = HeadEndprefix
                ElseIf RearEndPrefix <> "" Then
                    PreviousTrkPrefix = RearEndPrefix
                End If
                If Not pIsRollup Then
                    For Each comp In pComponentList
                        Select Case comp.GetType.ToString
                            Case gTrackComponentName
                                Dim trk As Track = CType(comp, Track)
                                trk.FlipMe = False
                                If trk.MilePostPrefix <> "" Then
                                    trk.HasPrefix = True
                                End If
                                If trk.sAlternateTrackNames <> Nothing Then
                                    TrackNameForFlipFlop = trk.sAlternateTrackNames.Replace("|", "")
                                End If
                            Case gSwitchComponentName
                                comp.FlipMe = False
                            Case gFlipFlopComponentName
                                foundFlipFlop = True
                                TrainEventLog("GetTrackSegmentsForCAD:FoundFlipFlop=" & comp.GUID.ToString & ":" & comp.Name)
                        End Select
                    Next
                End If
                For Each comp In pComponentList
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" AndAlso (comp.IsControlledForPTC OrElse comp.IsTestForPTC) Then
                        Dim trk As Track = CType(comp, Track)
                        If Not pIsRollup Then
                            trk.FlipMe = Flipme
                            If Not foundFlipFlop AndAlso MyRearEndTrack IsNot Nothing AndAlso MyRearEndTrack.Name = Me.myTrack.Name AndAlso Me.myTrack.Name = trk.Name Then
                                If trk.IsLinkToFlipFlopToLeft OrElse trk.IsLinkToFlipFlopToRight Then
                                    If Me.thisCurrentLicense Is Nothing AndAlso Me.myLocomotiveReport IsNot Nothing Then
                                        If Me.myLocomotiveReport.DirectionOfTravel.Contains("DECREASING") AndAlso trk.IsLinkToFlipFlopToRight Then
                                            trk.FlipMe = True  'Need for train over alca to first license
                                        ElseIf Me.myLocomotiveReport.DirectionOfTravel.Contains("INCREASING") AndAlso trk.IsLinkToFlipFlopToLeft Then
                                            trk.FlipMe = True  'Need for train over alca to first license
                                        End If
                                    End If
                                    Me.TrainInitAtFlipFlop = True 'Need for train over alca to modify license
                                End If
                            End If
                        End If
                        If Not trk.TurnOutType Then
                            If CurrentTrackName = "" Then
                                CurrentTrackName = trk.TrackNameAlias
                                Dim trackList As New ArrayList
                                CurrentTrackList = trackList
                                TrackSegments.Add(CurrentTrackList)
                            End If
                            If count = 1 Then
                                PreviousTrkPrefix = trk.MilePostPrefix
                                PreviousTrkSubID = trk.SubdivisionID
                                If Not SubDivIDList.Contains(PreviousTrkSubID) Then
                                    SubDivIDList.Add(PreviousTrkSubID)
                                End If
                            End If
                            If trk.TrackNameAlias = CurrentTrackName AndAlso (trk.MilePostPrefix = PreviousTrkPrefix) AndAlso (trk.SubdivisionID = PreviousTrkSubID) Then
                                If Not CurrentTrackList.Contains(trk) Then
                                    CurrentTrackList.Add(trk)
                                    TrainEventLog("GetTrackSegmentsForCAD:TRACK=" & trk.GUID.ToString & ":" & trk.Name & ":" & trk.FlipMe.ToString & ":" & trk.TrafficDirection & ":" & trk.TrackNameAlias)
                                End If
                            Else
                                CurrentTrackName = trk.TrackNameAlias
                                CurrentTrackList = New ArrayList
                                TrackSegments.Add(CurrentTrackList)
                                If Not CurrentTrackList.Contains(trk) Then
                                    CurrentTrackList.Add(trk)
                                    TrainEventLog("GetTrackSegmentsForCAD:TRACK=" & trk.GUID.ToString & ":" & trk.Name & ":" & trk.FlipMe.ToString & ":" & trk.TrafficDirection & ":" & trk.TrackNameAlias)
                                End If
                            End If
                            PreviousTrkPrefix = trk.MilePostPrefix
                            PreviousTrkSubID = trk.SubdivisionID
                            If Not SubDivIDList.Contains(PreviousTrkSubID) Then
                                SubDivIDList.Add(PreviousTrkSubID)
                            End If
                            count += 1
                        End If
                    ElseIf comp.GetType.ToString = gFlipFlopComponentName Then
                        If Not pIsRollup Then
                            Flipme = True
                            If flipLastUid <> comp.GUID Then
                                flipLastUid = comp.GUID
                                flipCount += 1
                            End If
                            If (flipCount Mod 2) = 0 Then
                                Flipme = False
                            End If
                            TrainEventLog("GetTrackSegmentsForCAD:FLIPFLOP=" & comp.GUID.ToString & ":" & comp.Name)
                        End If
                    End If
                    If theDirection = "LEFT" Then
                        If Me.Direction <> optDirectionSouth Then
                            If Me.myTrack.TrafficDirection = "RIGHT" Then
                                Me.Direction = optDirectionNorth
                            Else
                                Me.Direction = optDirectionSouth
                            End If
                            Me.myTrack.InvalidateTrainID()
                            Me.myTrack.InitTrainDisplay()
