#Region "LICENSE RELEASE METHODS"

        ''' <summary>
        ''' Check To Release Track Behind Train
        ''' </summary>
        ''' <param name="beginTrack">begin Track</param>
        ''' <param name="endTrack">end Track</param>
        Public Sub CheckToReleaseTrackBehindTrain(beginTrack As Track, endTrack As Track)
            Try
                If thisCurrentLicense Is Nothing Then Exit Sub
                If gCreateLicenseTrain IsNot Nothing AndAlso
                    gCreateLicenseTrain.Name = Name Then
                    TrainEventLog($"{GetCurrentMethod.Name}:TrainInLicenseMode")
                    Exit Sub
                End If
                If thisCurrentLicense.PTCElectronicTransmissionInProgress Then
                    TrainEventLog($"{GetCurrentMethod.Name}:PTCElectronicTransmissionInProgress")
                    Exit Sub
                End If
                If optEnableExtendLicenseinSplitDesk AndAlso
                    thisCurrentLicense.GetRemoteTransmissionInProgress() Then
                    TrainEventLog($"{GetCurrentMethod.Name}:RemoteTransmissionInProgress")
                    Exit Sub
                End If
                If IsBIDirectional Then
                    TrainEventLog($"{GetCurrentMethod.Name}:IsBIDirectional")
                    Exit Sub
                End If
                'Log for defect Rollup removed the license in the front of the train
                For Each oneTrack As Track In thisCurrentLicense.ComponentsInSelection.OfType(Of Track)
                    If oneTrack.IsLinkToRemoteTrack AndAlso
                        oneTrack.Occuppied Then
                        TrainEventLog($"{GetCurrentMethod.Name}:IsLinkToRemoteTrack={oneTrack.Name}")
                    End If
                Next
                Dim releasePerformed As Boolean
                If myRearEndTrack IsNot Nothing AndAlso
                    endTrack IsNot Nothing Then
                    If (IsActivePTC AndAlso
                        GeoFenceEnabled AndAlso
                        (myRearEndTrack.GUID <> endTrack.GUID)) OrElse
                        gTestPTC Then
                        myRearEndTrack = endTrack
                        TrainEventLog($"{GetCurrentMethod.Name}:1:EndTrack={endTrack.Name}")
                        PtcDoReleaseLicenseBehind(endTrack)
                        releasePerformed = True
                    ElseIf (IsActivePTC AndAlso
                        GeoFenceEnabled OrElse
                        gTestPTC) Then
                        myRearEndTrack = endTrack
                        TrainEventLog($"{GetCurrentMethod.Name}:2:EndTrack={endTrack.Name}")
                        PtcDoReleaseLicenseBehind(endTrack)
                        releasePerformed = True
                    End If
                End If
                If Not releasePerformed Then
                    If Not IsNothing(myHeadEndTrack) AndAlso
                        Not IsNothing(beginTrack) AndAlso
                        Not IsNothing(myRearEndTrack) Then
                        If IsActivePTC AndAlso
                            GeoFenceEnabled AndAlso
                            myHeadEndTrack.GUID <> beginTrack.GUID Then
                            TrainEventLog("CheckToReleaseTrackBehindTrain-HEAD:MyRearEndTrack=" & myRearEndTrack.Name)
                            PtcDoReleaseLicenseBehind(myRearEndTrack)
                        End If
                    End If
                End If
                RemoveStuckLicenseFromSystem()
                'remove any stuck licenses
                Dim StuckList As New ArrayList
                Dim trk As Track
                For Each trk In TrackCollection
                    If trk.TrackAuthorities.Count > 0 Then
                        If trk.TrackAuthorities.Contains(Me.thisCurrentLicense) Then
                            If Not thisCurrentLicense.ComponentsInSelection.Contains(trk) Then
                                StuckList.Add(trk)
                                TrainEventLog("CheckToReleaseTrackBehindTrain-STUCK-ADDCOMP=" & trk.Name & "-" & trk.GUID)
                            End If
                        End If
                    End If
                Next
                'remove pss stuck license
                If Not IsNothing(thisRestrictiveLicense) Then
                    For Each trk In TrackCollection
                        If trk.TrackAuthorities.Count > 0 Then
                            If trk.TrackAuthorities.Contains(Me.thisCurrentLicense) Then
                                If thisRestrictiveLicense.ComponentsInSelection.Contains(trk) Then
                                    StuckList.Add(trk)
                                End If
                            End If
                        End If
                    Next
                End If
                Me.PermissionToClearStuckLicensePSS = False
                If StuckList.Count > 0 Then
                    Dim comp As Object
                    For Each trk In StuckList
                        TrainEventLog("CheckToReleaseTrackBehindTrain-STUCK=" & trk.Name & "-" & trk.GUID)
                        Dim AuthList As ArrayList = trk.TrackAuthorities.Clone
                        Dim a As TrackAuthority.TrackAuthority
                        For Each a In AuthList
                            If a.AuthGUID = thisCurrentLicense.AuthGUID Then
                                If trk.OStype Then
                                    If Not IsNothing(trk.OsComponentCollection) Then
                                        For Each comp In trk.OsComponentCollection
                                            If comp.TrackAuthorities.Count > 0 Then
                                                comp.TrackAuthorities.Remove(a)
                                                comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                                If comp.TrackAuthorities.Count = 0 Then
                                                    comp.TrackAuthority = False
                                                    comp.TrafficDirection = ""
                                                End If
                                                comp.UpdateStatus()
                                            End If
                                        Next
                                    End If
                                End If
                                TrainEventLog("CheckToReleaseTrackBehindTrain-RemoveStuckLicense:Track=" & trk.Name & "-" & trk.GUID)
                                trk.TrackAuthorities.Remove(a)
                                trk.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                If trk.TrackAuthorities.Count = 0 Then
                                    trk.TrackAuthority = False
                                    trk.TrafficDirection = ""
                                End If
                                trk.UpdateStatus()
                            End If
                        Next
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub RemoveStuckLicenseFromSystem()
            Try

                If IsNothing(Me.thisCurrentLicense) Then Exit Sub

                If Not IsNothing(gCreateLicenseTrain) AndAlso gCreateLicenseTrain.Name = Me.Name Then
                    TrainEventLog("RemoveStuckLicenseFromSystem:TrainInLicenseMode")
                    Exit Sub
                End If

                If Me.thisCurrentLicense.PTCElectronicTransmissionInProgress Then
                    TrainEventLog("RemoveStuckLicenseFromSystem:PTCElectronicTransmissionInProgress=True")
                    Exit Sub
                End If
                'remove any stuck licenses
                Dim StuckList As New ArrayList
                Dim trk As Track
                For Each trk In TrackCollection
                    If trk.TrackAuthorities.Count > 0 Then
                        If trk.TrackAuthorities.Contains(Me.thisCurrentLicense) Then
                            If thisCurrentLicense.ComponentsInSelectionForRollup.Contains(trk) Then
                                StuckList.Add(trk)
                                TrainEventLog("RemoveStuckLicenseFromSystem:TrackCollection:Track=" & trk.Name & ":" & trk.GUID)
                            End If
                        End If
                    End If
                Next

                'Exit Sub
                If StuckList.Count > 0 Then
                    Dim comp As Object
                    For Each trk In StuckList
                        TrainEventLog("RemoveStuckLicenseFromSystem:StuckList:Track=" & trk.Name & ":" & trk.GUID)
                        Dim AuthList As ArrayList = trk.TrackAuthorities.Clone
                        Dim a As TrackAuthority.TrackAuthority
                        For Each a In AuthList
                            If a.AuthGUID = thisCurrentLicense.AuthGUID Then
                                If trk.OStype Then
                                    If Not IsNothing(trk.OsComponentCollection) Then
                                        For Each comp In trk.OsComponentCollection
                                            If comp.TrackAuthorities.Count > 0 Then
                                                comp.TrackAuthorities.Remove(a)
                                                comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                                If comp.TrackAuthorities.Count = 0 Then
                                                    comp.TrackAuthority = False
                                                    comp.TrafficDirection = ""
                                                End If
                                                comp.UpdateStatus()
                                            End If
                                        Next
                                    End If
                                End If

                                trk.TrackAuthorities.Remove(a)
                                trk.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                If trk.TrackAuthorities.Count = 0 Then
                                    trk.TrackAuthority = False
                                    trk.TrafficDirection = ""
                                End If
                                trk.UpdateStatus()
                            End If
                        Next
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckForRearOfTrain(ByRef RemoveList As ArrayList)
            Try
                If IsNothing(Me.myRearEndTrack) Then Exit Sub
                If Not IsNothing(Me.thisCurrentLicense) AndAlso Not Me.thisCurrentLicense.ComponentsInSelection.Contains(Me.myRearEndTrack) Then Exit Sub
                If Not RemoveList.Contains(Me.myRearEndTrack) Then Exit Sub

                Dim tempList As ArrayList = RemoveList.Clone
                Dim RearEndFound As Boolean
                Dim comp As Object
                For Each comp In tempList
                    If comp.GUID = Me.myRearEndTrack.GUID Then RearEndFound = True
                    If RearEndFound Then
                        TrainEventLog("CheckForRearOfTrainRemoveFromList:Comp=" & comp.GUID & ":" & comp.Name)
                        RemoveList.Remove(comp)
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub DoReleaseLicenseGeoFence(ByVal theOstrk As Track) 'release license behind the train
            Try
                TrainEventLog("DoReleaseLicenseGeoFence:Start")

                Dim comp As Object
                Dim CompList As New ArrayList
                Dim RemoveList As New ArrayList
                Dim tr As TacticalRoute
                If theOstrk.OStype Then
                    For Each tr In Me.myTacticalRoutes
                        If tr.mySignalRoute.ComponentList.Contains(theOstrk) Then
                            Exit For
                        Else
                            RemoveList.Add(tr)
                        End If
                    Next
                    If Me.myTacticalRoutes.Count = RemoveList.Count Then
                        RemoveList.Clear()
                    End If
                End If

                If RemoveList.Count = 0 Then
                    TrainEventLog("DoReleaseLicenseGeoFence-RemoveList=0")
                    For Each tr In Me.myTacticalRoutes
                        If tr.myStatus <> "STORED ROUTE" Then
                            Dim NoComponentsFoundInLicense As Boolean = True
                            For Each comp In tr.mySignalRoute.ComponentList
                                If thisCurrentLicense.ComponentsInSelection.Contains(comp) AndAlso theOstrk.GUID <> comp.GUID Then
                                    NoComponentsFoundInLicense = False
                                    Exit For
                                End If
                            Next
                            If NoComponentsFoundInLicense Then
                                RemoveList.Add(tr)
                            End If
                        End If
                    Next
                End If


                If RemoveList.Count > 0 Then
                    Dim RouteList As New ArrayList
                    For Each tr In RemoveList
                        RouteList.Add(tr.mySignalRoute)
                        TrainEventLog("DoReleaseLicenseGeoFence-RemoveList-AddRoute:" & tr.mySignalRoute.SystemUID)
                    Next
                    Dim sr As SignalRoute
                    For Each sr In RouteList
                        For Each comp In sr.ComponentList
                            If Not CompList.Contains(comp) Then
                                If comp.GetType.ToString = gTrackComponentName Or comp.GetType.ToString = gSwitchComponentName Then
                                    CompList.Add(comp)
                                    TrainEventLog("DoReleaseLicenseGeoFence-RemoveList-AddComp:" & comp.GUID)
                                End If
                            End If
                        Next
                    Next

                    If Not IsNothing(theOstrk.OsComponentCollection) Then
                        Dim c As Object
                        For Each c In theOstrk.OsComponentCollection
                            If Not CompList.Contains(c) Then
                                CompList.Add(c)
                                TrainEventLog("DoReleaseLicenseGeoFence-RemoveList-AddOsComp:" & c.GUID)
                            End If
                        Next
                    End If

                    If Not IsNothing(Me.thisCurrentLicense) Then
                        TrainEventLog("DoReleaseLicenseGeoFence-VETMS_CompleteRollup:" & thisCurrentLicense.AuthorityUID)
                        thisCurrentLicense.PTCRollUpList = CompList.Clone
                        thisCurrentLicense.VETMS_CompleteRollup()
                        For Each tr In RemoveList
                            tr.RemoveRoute()
                            Me.myTacticalRoutes.Remove(tr)
                            thisCurrentLicense.UpdateTacticalRouteList()
                        Next
                    End If

                End If

                If theOstrk.TrackAuthorities.Count > 0 Then
                    DoReleaseCurrentLicense(theOstrk)
                End If
                If Not IsNothing(Me.thisCurrentLicense) Then
                    If thisCurrentLicense.ComponentsInSelection.Count = 0 Then
                        TrainEventLog("DoReleaseLicenseGeoFence-NO COMPONENTS DETECTED")
                    Else
                        thisCurrentLicense.UpdateDatabaseWithCompList("DoReleaseLicenseGeoFence")
                    End If
                End If

                DoLicenseSweepBehindTrain()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoLicenseSweepBehindTrain()
            Try
                If Not IsNothing(thisCurrentLicense) Then
                    Dim theList As ArrayList = thisCurrentLicense.ComponentsInSelection.Clone
                    theList.Reverse()
                    Dim theDeleteList As New ArrayList
                    Dim StartDeletion As Boolean
                    Dim comp As Object
                    For Each comp In theList
                        If StartDeletion Then
                            If comp.GetType.ToString = gTrackComponentName Then
                                Dim t As Track = CType(comp, Track)
                                If Not t.Occuppied Then
                                    If Not theDeleteList.Contains(t) Then
                                        theDeleteList.Add(t)
                                    End If
                                End If
                            ElseIf comp.GetType.ToString = gSwitchComponentName Then
                                Dim s As Switch = CType(comp, Switch)
                                If Not s.Occuppied Then
                                    If Not theDeleteList.Contains(s) Then
                                        theDeleteList.Add(s)
                                    End If
                                End If
                            End If
                        End If

                        If comp.GUID = Me.myTrack.GUID Then
                            StartDeletion = True
                        End If
                    Next


                    If theDeleteList.Count > 0 Then
                        For Each comp In theDeleteList
                            If comp.TrackAuthorities.Count > 0 Then
                                Dim a As TrackAuthority.TrackAuthority
                                Dim AuthList As ArrayList = comp.TrackAuthorities.Clone
                                For Each a In AuthList
                                    If a.AuthGUID = thisCurrentLicense.AuthGUID Then
                                        comp.TrackAuthorities.Remove(a)
                                        comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                        If comp.TrackAuthorities.Count = 0 Then
                                            comp.TrackAuthority = False
                                            comp.TrafficDirection = ""
                                        End If
                                        comp.UpdateStatus()
                                    End If
                                Next
                            Else
                                comp.TrackAuthority = False
                                comp.TrafficDirection = ""
                                comp.UpdateStatus()
                            End If
                        Next
                        thisCurrentLicense.UpdateDatabaseWithCompList("DoLicenseSweepBehindTrain")
                    End If

                    Dim trk As Track
                    For Each trk In TrackCollection
                        If Not thisCurrentLicense.ComponentsInSelection.Contains(trk) Then
                            If trk.TrackAuthorities.Count > 0 Then
                                Dim a As TrackAuthority.TrackAuthority
                                Dim AuthList As ArrayList = trk.TrackAuthorities.Clone

                                For Each a In AuthList
                                    If a.AuthGUID = thisCurrentLicense.AuthGUID Then
                                        If trk.OStype Then
                                            If Not IsNothing(trk.OsComponentCollection) Then
                                                For Each comp In trk.OsComponentCollection
                                                    If comp.TrackAuthorities.Count > 0 Then
                                                        comp.TrackAuthorities.Remove(a)
                                                        comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                                        If comp.TrackAuthorities.Count = 0 Then
                                                            comp.TrackAuthority = False
                                                            comp.TrafficDirection = ""
                                                        End If
                                                        comp.UpdateStatus()
                                                    End If
                                                Next
                                            End If
                                        End If

                                        trk.TrackAuthorities.Remove(a)
                                        trk.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                        If trk.TrackAuthorities.Count = 0 Then
                                            trk.TrackAuthority = False
                                            trk.TrafficDirection = ""
                                        End If
                                        trk.UpdateStatus()
                                    End If
                                Next
                            End If
                        End If
                    Next

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoReleaseCurrentLicense(ByVal theOstrk As Track)
            Dim comp As Object
            Dim CompList As New ArrayList

            Try
                If IsNothing(thisCurrentLicense) Then
                    BindLicenseToTrain()
                End If
                If thisCurrentLicense IsNot Nothing AndAlso thisCurrentLicense.ComponentsInSelection IsNot Nothing AndAlso thisCurrentLicense.ComponentsInSelection.Contains(theOstrk) Then
                    For Each comp In thisCurrentLicense.ComponentsInSelection
                        If Not CompList.Contains(comp) Then
                            CompList.Add(comp)
                            TrainEventLog("DoReleaseCurrentLicense1-Comp=" & comp.GUID)
                        End If
                        If comp.GUID = theOstrk.GUID Then
                            If Not IsNothing(theOstrk.OsComponentCollection) Then
                                Dim c As Object
                                For Each c In theOstrk.OsComponentCollection
                                    If Not CompList.Contains(c) Then
                                        CompList.Add(c)
                                        TrainEventLog("DoReleaseCurrentLicense2-Comp=" & comp.GUID)
                                    End If
                                Next
                            End If
                            Exit For
                        End If
                    Next

                    For Each comp In CompList
                        thisCurrentLicense.ComponentsInSelection.Remove(comp)
                        Try
                            comp.TrackAuthorityRemoveFromMe(thisCurrentLicense)
                            comp.UpdateStatus()
                            If comp.GetType.ToString = gSwitchComponentName Or comp.GetType.ToString = gTrackComponentName Then
                                comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                comp.Flasher.Interval = 250
                                comp.FlashOn = False
                                comp.FlashComponent = False
                                comp.TrafficDirection = ""
                                comp.UpdateStatus()
                                If comp.GetType.ToString = gTrackComponentName AndAlso comp.IsRemoteTrack Then
                                    If Not comp.Occuppied Then
                                        TrainEventLog("SendRemoveTrackAuthority3")
                                        comp.myRemoteTrack.SendRemoveTrackAuthority(thisCurrentLicense.AuthorityUID)
                                    End If

                                End If
                            End If
                        Catch ex As Exception
                            SystemException(ex.ToString)
                        End Try
                    Next

                End If

                If theOstrk.TrackAuthorities.Count > 0 AndAlso thisCurrentLicense.ComponentsInSelection.Contains(theOstrk) Then
                    Dim auth As TrackAuthority.TrackAuthority
                    For Each auth In theOstrk.TrackAuthorities
                        If auth.IssueTo = Me.IdentifingUnit Then
                            Dim AuthorityComp As New ArrayList
                            CopyArrayCollection(AuthorityComp, auth.ComponentsInSelection)
                            For Each comp In AuthorityComp
                                If Not CompList.Contains(comp) Then
                                    CompList.Add(comp)
                                    TrainEventLog("DoReleaseCurrentLicense-Comp3=" & comp.GUID)
                                End If
                                If comp.GUID = theOstrk.GUID Then
                                    If Not IsNothing(theOstrk.OsComponentCollection) Then
                                        Dim c As Object
                                        For Each c In theOstrk.OsComponentCollection
                                            If Not CompList.Contains(c) Then
                                                CompList.Add(c)
                                                TrainEventLog("DoReleaseCurrentLicense4-Comp=" & comp.GUID)
                                            End If
                                        Next
                                    End If
                                    Exit For
                                End If
                            Next

                            For Each comp In CompList
                                auth.ComponentsInSelection.Remove(comp)
                                Try
                                    comp.TrackAuthorityRemoveFromMe(auth)
                                    comp.UpdateStatus()
                                    If comp.GetType.ToString = gSwitchComponentName Or comp.GetType.ToString = gTrackComponentName Then
                                        comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                        comp.Flasher.Interval = 250
                                        comp.FlashOn = False
                                        comp.FlashComponent = False
                                        comp.TrafficDirection = ""
                                        comp.UpdateStatus()
                                        If comp.GetType.ToString = gTrackComponentName AndAlso comp.IsRemoteTrack Then
                                            If Not comp.Occuppied Then
                                                TrainEventLog("SendRemoveTrackAuthority1")
                                                comp.myRemoteTrack.SendRemoveTrackAuthority(auth.AuthorityUID)
                                            End If
                                        End If

                                    End If
                                Catch ex As Exception
                                    SystemException(ex.ToString)
                                End Try

                            Next
                        End If
                    Next
                ElseIf thisCurrentLicense.ComponentsInSelection.Contains(theOstrk) OrElse theOstrk.TrackAuthorities.Contains(thisCurrentLicense) Then
                    thisCurrentLicense.ComponentsInSelection.Remove(theOstrk)
                    theOstrk.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                    theOstrk.Flasher.Interval = 250
                    theOstrk.FlashOn = False
                    theOstrk.FlashComponent = False
                    theOstrk.TrafficDirection = ""
                    theOstrk.UpdateStatus()

                    If theOstrk.IsRemoteTrack Then
                        If Not theOstrk.Occuppied Then
                            TrainEventLog("SendRemoveTrackAuthority2")
                            theOstrk.myRemoteTrack.SendRemoveTrackAuthority(thisCurrentLicense.AuthorityUID)
                        End If
                    End If

                    If theOstrk.OStype Then
                        If Not IsNothing(theOstrk.OsComponentCollection) Then
                            For Each comp In theOstrk.OsComponentCollection
                                TrainEventLog("DoReleaseCurrentLicense5-Comp=" & comp.GUID)
                                thisCurrentLicense.ComponentsInSelection.Remove(comp)
                                comp.SelectionMode = SwitchComponents.Switch.ModeSelection.Regular
                                comp.Flasher.Interval = 250
                                comp.FlashOn = False
                                comp.FlashComponent = False
                                comp.TrafficDirection = ""
                                comp.UpdateStatus()
                            Next
                        End If
                    End If
                End If
                thisCurrentLicense.UpdateDatabaseWithCompList("DoReleaseCurrentLicense")

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Public Sub DoReleaseSpecialLicenseBehindTrain(ByVal pForceRemoval As Boolean) 'release license behind the train
            Try
                TrainEventLog("DoReleaseSpecialLicenseBehindTrain")
                If Me.thisRestrictiveLicense Is Nothing Then Exit Sub
                If Not pForceRemoval Then
                    Dim EndOfTrain As Decimal
                    If IsNumeric(Me.EndMilePost) Then EndOfTrain = CDec(Me.EndMilePost)
                    Dim comp As Object
                    For Each comp In thisRestrictiveLicense.ComponentsInSelection
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(comp, Track)
                            If Not trk.Occuppied Then
                                If EndOfTrain = 0 Then
                                    Exit Sub
                                End If
                                If (EndOfTrain >= trk.LeftLimitMilePost And EndOfTrain <= trk.RightLimitMilePost) OrElse
                                   (EndOfTrain <= trk.LeftLimitMilePost And EndOfTrain >= trk.RightLimitMilePost) Then
                                    Exit Sub
                                End If
                            ElseIf trk.Occuppied Then
                                Exit Sub
                            End If
                        End If
                    Next
                End If
                CancelPassRedSignalAuthority(True, False)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

