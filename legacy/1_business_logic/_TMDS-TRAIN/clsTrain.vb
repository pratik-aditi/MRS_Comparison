        Private Function DeliverBulletinViaBulletinHMI(ByVal thisCurrentBulletin As SubBulletin, Optional ByVal myParentForm As Object = Nothing) As Boolean
            Dim frmBulletinHMI As New frmBulletinHMI
            Try
                frmBulletinHMI.theBulletin = thisCurrentBulletin
                frmBulletinHMI.LoadForm("BULLETIN-CHANGE", "READ", Me.Name, thisCurrentBulletin)
                If myParentForm Is Nothing Then
                    If Me.ReadOnlySymbol Then
                        frmBulletinHMI.Owner = TMDS.SystemForms.MySystemForms.frmSystemSummary
                        frmBulletinHMI.Location = New Point(TMDS.SystemForms.MySystemForms.frmSystemSummary.Location.X + 100, TMDS.SystemForms.MySystemForms.frmSystemSummary.Location.Y + 100)

                    Else
                        frmBulletinHMI.Owner = Me.myTrack.CurrentDrawingForm
                        frmBulletinHMI.Location = New Point(Me.myTrack.CurrentDrawingForm.Location.X + 100, Me.myTrack.CurrentDrawingForm.Location.Y + 100)
                    End If
                Else
                    frmBulletinHMI.Owner = myParentForm
                    frmBulletinHMI.Location = New Point(Me.myTrack.CurrentDrawingForm.Location.X + 100, Me.myTrack.CurrentDrawingForm.Location.Y + 100)
                End If

                frmBulletinHMI.ShowDialog()
                If frmBulletinHMI.GBOFormFeedBack <> 6 Then Return False
                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                frmBulletinHMI.Dispose()
                frmBulletinHMI = Nothing
                DoGBOSummaryRefresh("TrainMenu - DeliverBulletinViaBulletinHMI")
                DoTGBOSummaryRefresh("TrainMenu - DeliverBulletinViaBulletinHMI")
            End Try

        End Function

        Private Function SetExceptionToBeDelivered(Bull As SubBulletin) As Boolean
            Dim tgb As TabularGeneralBulletin = Nothing
            Dim tgb2 As TabularGeneralBulletin = Nothing
            Dim exp As TabularGeneralBulletinException = Nothing
            Try
                tgb = TMDS.SystemUtilities.FetchData.FindTGBOByTrainSymbol(Me.Name, True)
                If Bull.myExceptionList Is Nothing Then Return False
                If tgb Is Nothing Then Return False
                For Each exp In Bull.myExceptionList
                    If exp.theDesignation.Trim.ToUpper = Me.Name.Trim.ToUpper Then
                        tgb2 = TMDS.SystemUtilities.FetchData.FindTGBOByUID(exp.theTBGOSytemUID)
                        If tgb2 IsNot Nothing AndAlso tgb.SystemUID = tgb2.SystemUID Then
                            exp.PTCMarkedToBeIssuedElectronically = True
                            Return True
                        End If
                    End If
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function
