        Private Delegate Sub DoPublishTrainEvent(ByVal EventType As EventTypeTrainID, ByVal ShadowMode As Boolean)

        ''' <summary>
        ''' Publish train event
        ''' </summary>
        ''' <param name="pEventType"></param>
        ''' <param name="pShadowMode"></param>
        Public Sub PublishTrainEvent(ByVal pEventType As EventTypeTrainID, Optional ByVal pShadowMode As Boolean = False)
            Dim CurTerr As Territory
            Dim ReleaseTheTrain As Boolean
            Dim UpdateOnly As Boolean
            Dim OSOnly As Boolean
            Dim ReOrder As Boolean
            Dim MoveOnly As Boolean
            Dim SendAll As Boolean
            Dim CurTrk As Track
            Dim MessageMove As String
            Dim Message As String
            Dim trn As TrainID
            Dim trains As String = String.Empty
            Dim trk As Track
            Try
                If pShadowMode Then Exit Sub
                CurTrk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.TrackGUID)
                If Not CurTrk Is Nothing Then
                    CurTerr = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(CurTrk.TerritoryID)
                Else
                    Exit Sub
                End If
                MessageMove = "DC" & Chr(6) & "TRAIN;"
                MessageMove = MessageMove & "|" & CurTrk.TerritoryID.ToString
                Message = "DC" & Chr(6) & "TRAIN;"
                Message = Message & "|" & CurTrk.TerritoryID.ToString
                Select Case pEventType
                    Case EventTypeTrainID.POSITION
                        Message = Message & "|" & "POSITION"
                        SendAll = True
                    Case EventTypeTrainID.MOVE ', EventTypeTrainID.MOVEMANUAL
                        Message = Message & "|" & "MOVE"
                        MessageMove = MessageMove & "|" & "MOVE"
                        SendAll = True
                        MoveOnly = True
                    Case EventTypeTrainID.MOVEMANUAL
                        Message = Message & "|" & "MOVEMANUAL"
                        MessageMove = MessageMove & "|" & "MOVEMANUAL"
                        MoveOnly = True
                    Case EventTypeTrainID.RELEASE, EventTypeTrainID.FINAL
                        Message = Message & "|" & "RELEASE"
                        SendAll = True
                        ReleaseTheTrain = True
                    Case EventTypeTrainID.UPDATE
                        Message = Message & "|" & "UPDATE"
                        UpdateOnly = True
                    Case EventTypeTrainID.OS
                        Message = Message & "|" & "OS"
                        OSOnly = True
                    Case EventTypeTrainID.REORDER
                        Message = Message & "|" & "REORDER"
                        ReOrder = True
                End Select
                If SendAll Then
                    Message = Message & "|" & Me.TrackGUID
