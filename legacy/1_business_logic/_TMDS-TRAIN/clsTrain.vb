                CopyArrayCollection(myTempTrnSCH, myScheduleList)
                Dim ts As TrainSchedule
                For Each ts In myTempTrnSCH
                    ts.RemoveSchedule()
                    ts = Nothing
                Next
                Me.myScheduleList.Clear()
