#Region " DENVER METHODS "
        Public Function GetMyComplaintStatus() As String
            Dim IsNonComplaint As Boolean = False
            Dim IsSubStandard As Boolean = False
            Dim tc As TrainCar
            Try
                Dim u As TrainUnit
                For Each u In Me.UnitsInTrain
                    If u.thisUnitCondition = TrainUnit.UnitCondition.NONCOMPLIANT Then
                        IsNonComplaint = True
                    ElseIf u.thisUnitCondition = TrainUnit.UnitCondition.SUBSTANDARD Then
                        IsSubStandard = True
                    End If
                Next
                For Each tc In Me.myCarList
                    If tc.LoadStatus.Trim.ToUpper = TrainUnit.UnitCondition.NONCOMPLIANT.ToString.Trim.ToUpper Then
                        IsNonComplaint = True
                    ElseIf tc.LoadStatus.Trim.ToUpper = TrainUnit.UnitCondition.SUBSTANDARD.ToString.Trim.ToUpper Then
                        IsSubStandard = True
                    End If
                Next
                If IsNonComplaint Then
                    Return TrainUnit.UnitCondition.NONCOMPLIANT.ToString
                ElseIf IsSubStandard Then
                    Return TrainUnit.UnitCondition.SUBSTANDARD.ToString
                Else
                    Return TrainUnit.UnitCondition.COMPLIANT.ToString
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return String.Empty
        End Function

