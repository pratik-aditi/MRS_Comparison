                'If String.IsNullOrEmpty(Me.EntityUID) OrElse Me.EntityUID.Trim = String.Empty Then TrainEvent("DATAWARE HOUSE VALIDATION SKIPPED FOR NON MIS TRAIN " & Me.Name) : Return True
                'If String.IsNullOrEmpty(Me.HomeRoadCode) OrElse Me.HomeRoadCode.Trim = "" Then MessageList.Add(Chr(149) & Space(3) & "MISSING HOME CODE") : IsValid = False : ErrorNumber.Add("TRNVDWHV-01")
                If String.IsNullOrEmpty(Me.IdentifingUnit) OrElse Me.IdentifingUnit.Trim = "" Then MessageList.Add(Chr(149) & Space(3) & "MISSING ENGINE ID") : IsValid = False : ErrorNumber.Add("TRNVDWHV-02")

                Dim TGBOEvent As New ArrayList
                TGBOEvent = TMDS.SystemUtilities.TrainFunction.GetTrainEvents(Me, "TGBO EVENT")
                If TGBOEvent IsNot Nothing AndAlso TGBOEvent.Count > 0 Then
                Else
                    TrainEventLog("DATAWARE HOUSE VALIDATION SKIPPED. NO TGBO EVENT FOUND ")
                    Return True
                End If


                If Me.OTons = 0 Then MessageList.Add(Chr(149) & Space(3) & "MISSING TONS") : IsValid = False : ErrorNumber.Add("TRNVDWHV-03")
                If Me.OLength = 0 Then MessageList.Add(Chr(149) & Space(3) & "MISSING Length") : IsValid = False : ErrorNumber.Add("TRNVDWHV-04")


                If String.IsNullOrEmpty(Me.Direction) OrElse Me.Direction.Trim = "" Then MessageList.Add(Chr(149) & Space(3) & "MISSING DIRECTION") : IsValid = False : ErrorNumber.Add("TRNVDWHV-05")
                If String.IsNullOrEmpty(Me.Origin) OrElse Me.Origin.Trim = "" Then MessageList.Add(Chr(149) & Space(3) & "MISSING ORIGIN") : IsValid = False : ErrorNumber.Add("TRNVDWHV-06")
                If String.IsNullOrEmpty(Me.Dest) OrElse Me.Dest.Trim = "" Then MessageList.Add(Chr(149) & Space(3) & "MISSING DESTINATION") : IsValid = False : ErrorNumber.Add("TRNVDWHV-07")



                Dim dArrTime As Date
                Dim dDepTime As Date
                Dim dSCHArrTime As Date
                Dim dSCHDepTime As Date
                Dim HP As Integer = 0
                Integer.TryParse(Me.TotalEffectiveHP, HP)
                If HP = 0 Then MessageList.Add(Chr(149) & Space(3) & "MISSING HP") : IsValid = False : ErrorNumber.Add("TRNVDWHV-08")

                If Date.TryParse(Me.SchTimeArrival, dSCHArrTime) Then
                    If Not IsValidDate(dSCHArrTime.ToShortDateString) Then
                        MessageList.Add(Chr(149) & Space(3) & "MISSING SCHEDULED ARRIVAL TIME") : ErrorNumber.Add("TRNVDWHV-09")
                        IsValid = False
                    Else
                        If dSCHArrTime.Hour = 0 AndAlso dSCHArrTime.Minute = 0 Then
                            MessageList.Add(Chr(149) & Space(3) & "INVALID SCHEDULED ARRIVAL TIME") : ErrorNumber.Add("TRNVDWHV-10")
                            IsValid = False
                        End If
                    End If
                Else
                    MessageList.Add(Chr(149) & Space(3) & "MISSING SCHEDULED ARRIVAL TIME") : ErrorNumber.Add("TRNVDWHV-11")
                    IsValid = False
                End If
                ' 
                If Date.TryParse(Me.SchTimeDeparture, dSCHDepTime) Then
                    If Not IsValidDate(dSCHDepTime.ToShortDateString) Then
                        MessageList.Add(Chr(149) & Space(3) & "MISSING SCHEDULED DEPARTURE TIME") : ErrorNumber.Add("TRNVDWHV-12")
                        IsValid = False
                    Else
                        If dSCHDepTime.Hour = 0 AndAlso dSCHDepTime.Minute = 0 Then
                            MessageList.Add(Chr(149) & Space(3) & "INVALID SCHEDULED DEPARTURE TIME") : ErrorNumber.Add("TRNVDWHV-13")
                            IsValid = False
                        End If
                    End If
                Else
                    MessageList.Add(Chr(149) & Space(3) & "MISSING SCHEDULED DEPARTURE TIME") : ErrorNumber.Add("TRNVDWHV-14")
                    IsValid = False
                End If


                If Date.TryParse(Me.ArrTime, dArrTime) Then
                    If Not IsValidDate(dArrTime.ToShortDateString) Then
                        MessageList.Add(Chr(149) & Space(3) & "MISSING ARRIVAL TIME") : ErrorNumber.Add("TRNVDWHV-15")
                        IsValid = False
                    Else
                        If dArrTime.Hour > 0 OrElse dArrTime.Minute > 0 Then
                        Else
                            MessageList.Add(Chr(149) & Space(3) & "MISSING ARRIVAL TIME") : ErrorNumber.Add("TRNVDWHV-16")
                            IsValid = False
                        End If
                    End If
                Else
                    MessageList.Add(Chr(149) & Space(3) & "MISSING ARRIVAL TIME") : ErrorNumber.Add("TRNVDWHV-17")
                    IsValid = False
                End If

                If Date.TryParse(Me.DepTime, dDepTime) Then
                    If Not IsValidDate(dDepTime.ToShortDateString) Then
                        MessageList.Add(Chr(149) & Space(3) & "MISSING DEPARTURE TIME") : ErrorNumber.Add("TRNVDWHV-18")
                        IsValid = False
                    Else
                        If dDepTime.Hour > 0 OrElse dDepTime.Minute > 0 Then
                        Else
                            MessageList.Add(Chr(149) & Space(3) & "MISSING DEPARTURE TIME") : ErrorNumber.Add("TRNVDWHV-19")
                            IsValid = False
                        End If
                    End If

                Else
                    MessageList.Add(Chr(149) & Space(3) & "MISSING DEPARTURE TIME") : ErrorNumber.Add("TRNVDWHV-20")
                    IsValid = False
                End If

                If dSCHDepTime > dArrTime Then
                    MessageList.Add(Chr(149) & Space(3) & " ACTUAL ARRIVAL TIME IS BEFORE SCHEDULED DEPARTURE TIME ")
                    ErrorNumber.Add("TRNVDWHV-21")
                    IsValid = False
                End If

                If dDepTime > dArrTime Then
                    MessageList.Add(Chr(149) & Space(3) & " ACTUAL ARRIVAL TIME IS BEFORE ACTUAL DEPARTURE TIME ")
                    ErrorNumber.Add("TRNVDWHV-21")
                    IsValid = False
                End If


                If CheckIfTrainHasActiveEnrouteReport(Me.Name) Then
                    MessageList.Add(Chr(149) & Space(3) & "TRAIN HAS ONE OR MORE ACTIVE ENROUTE FAILURE EVENT")
                    ErrorNumber.Add("TRNVDWHV-22")
                    IsValid = False
                End If


                MessageList2 = New ArrayList
                If dSCHDepTime = dDepTime Then
                    MessageList2.Add(Chr(149) & Space(3) & "TRAIN'S  DEPATURE DATETIME IS SAME AS SCHEDULED DEPARTURE DATETIME")
                    ErrorNumber.Add("TRNVDWHV-23")
                End If
                If dSCHArrTime = dArrTime Then
                    MessageList2.Add(Chr(149) & Space(3) & "TRAIN'S  ARRIVAL DATETIME IS SAME AS SCHEDULED ARRIVAL DATETIME")
                    ErrorNumber.Add("TRNVDWHV-24")
                End If
                If IsValid Then
                    Dim ErrNoString As New StringBuilder
                    Dim s As String = ""
                    If ErrorNumber IsNot Nothing AndAlso ErrorNumber.Count > 0 Then
                        For Each s In ErrorNumber
                            ErrNoString.Append(s & ", ")
                        Next
                    End If
                    TrainEventLog(Me.Name & " DATAWARE HOUSE VALIDATION ERROR CODES" & ErrNoString.ToString)
                End If

                If MessageList2 IsNot Nothing AndAlso MessageList2.Count > 0 Then
                    MessageList2.Add("")
                    MessageList2.Add("DO YOU WANT TO PROCEED?")


                    If ShowCustomMessageBox(MessageList2, "DATAWARE HOUSE VALIDATION", True, LaunchPoint, False, True, FormObject, False, "") <> 6 Then
                        Return False
                    End If
                End If

                If Not IsValid Then
                    If FinallingTrain Then
                        MessageList.Insert(0, "TRAIN CANNOT BE FINALED BECAUSE:")
                        MessageList.Insert(1, "")
                        MessageList.Add("")
                    Else
                        MessageList.Insert(0, "TRAIN CANNOT BE RELEASED BECAUSE:")
                        MessageList.Insert(1, "")
                        MessageList.Add("")
                    End If
                    ShowCustomMessageBox(MessageList, "DATAWARE HOUSE VALIDATION", False, LaunchPoint, False, True, FormObject)
                    Dim ErrNoString As New StringBuilder
                    Dim s As String = ""
                    If ErrorNumber IsNot Nothing AndAlso ErrorNumber.Count > 0 Then
                        For Each s In ErrorNumber
                            ErrNoString.Append(s & ", ")
                        Next
                    End If
                    TrainEventLog(Me.Name & " DATAWARE HOUSE VALIDATION ERROR CODES" & ErrNoString.ToString)
                    Return False
                End If
                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                MessageList = Nothing
                LaunchPoint = Nothing
                MessageList2 = Nothing
            End Try
            Return False
        End Function


