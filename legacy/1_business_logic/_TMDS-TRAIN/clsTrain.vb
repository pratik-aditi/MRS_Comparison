#Region " TIMER TRAIN REFRESH "
        Private Delegate Sub DoLoadTrainRefresh()
        Public pStopProcessingTrainTimerRefresh As Boolean
        Public ProcessingTrainTimerRefreshStarted As Boolean
        Dim LastTrainTimerRefreshTimerCheck As Date = Now
        Private TrainTimerRefreshScanStarted As Boolean = False
        Public myTrainTimerRefreshQueue As Queue = Queue.Synchronized(New Queue())

        Public Sub LoadTrainTimerRefresh()
            Try
                If Not gEnableTrainTimerRefresh Then Exit Sub
                Dim NewDoLoad As New DoLoadTrainSchedule(AddressOf PerformTrainTimerRefresh)
                NewDoLoad.BeginInvoke(Nothing, Nothing)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
        Private Sub PerformTrainTimerRefresh()
            Dim myTrainTGBOCollection As New ArrayList
            If ProcessingTrainTimerRefreshStarted Then Exit Sub
            Dim CurrentDateTime As Date = Now
            Try
                ProcessingTrainTimerRefreshStarted = True
                Dim TempTimerRefreshQueue As Queue = Nothing
                Dim QueueTempControl As Integer
                SyncLock myTrainTimerRefreshQueue
                    If myTrainTimerRefreshQueue.Count > 0 Then
                        TempTimerRefreshQueue = myTrainTimerRefreshQueue.Clone
                        myTrainTimerRefreshQueue.Clear()
                    End If
                End SyncLock


                If Not IsNothing(TempTimerRefreshQueue) Then
                    Dim TGBORefreshCompleted As Boolean = False
                    While TempTimerRefreshQueue.Count <> 0
                        Dim SumItem As TrainRefreshItem = CType(TempTimerRefreshQueue.Dequeue, TrainRefreshItem)
                        Select Case SumItem.myItemType
                            Case TrainRefreshItem.TrainRefreshType.TGBO
                                If SumItem.myItemAction = TrainRefreshItem.TrainRefreshAction.REFRESH Then
                                    If CurrentDateTime.AddMinutes(-1) > SumItem.myItemDate Then
                                        'If Not TGBORefreshCompleted Then
                                        '    TGBORefreshCompleted = True
                                        myTrainTGBOCollection = TMDS.SystemUtilities.FetchData.FindAllTGBOsByTrainSymbol(Me.Name)
                                        Dim tgb As TabularGeneralBulletin = Nothing
                                        For Each tgb In myTrainTGBOCollection
                                            If tgb IsNot Nothing Then tgb.PerformBulletinSortForCompare(True)
                                        Next
                                        myTrainTGBOCollection = Nothing
                                        tgb = Nothing
                                        'End If

                                    Else
                                        SyncLock myTrainTimerRefreshQueue.SyncRoot
                                            Try
                                                Dim tmp As TrainRefreshItem
                                                Dim OkToAdd As Boolean = True
                                                For Each tmp In Me.myTrainTimerRefreshQueue
                                                    If tmp.myItemAction = TrainRefreshItem.TrainRefreshAction.REFRESH AndAlso tmp.myItemAction = TrainRefreshItem.TrainRefreshType.TGBO Then
                                                        OkToAdd = False
                                                    End If
                                                Next
                                                If OkToAdd Then Me.myTrainTimerRefreshQueue.Enqueue(SumItem)
                                            Catch ex As Exception
                                                GetErrorDetails(ex)
                                            End Try
                                            'myTrainTimerRefreshQueue.Enqueue(SumItem)
                                        End SyncLock
                                    End If
                                End If
                        End Select
                        QueueTempControl = QueueTempControl + 1
                        If QueueTempControl > 100 Then
                            Exit Sub
                        End If
                    End While

                End If



            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                ProcessingTrainTimerRefreshStarted = False
            End Try
        End Sub

        Private Sub TrainRefreshTimerElapsedEvent(ByVal source As Object, ByVal e As ElapsedEventArgs)
            Try
                If gEnableTrainTimerRefresh AndAlso gInitialized Then
                    LoadTrainTimerRefresh()
                End If
                If Not gEnableTrainTimerRefresh Then Me.TrainRefreshTimer.Enabled = False
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

