        Private Function GetTrainConsistString() As String
            Try
                Dim FirstUnit As TrainUnit = Nothing
                If Me.UnitsInTrain.Count > 0 Then
                    FirstUnit = Me.UnitsInTrain(0)
                    If Not IsNothing(FirstUnit) Then
                        Me.LeadUnitOrientation = FirstUnit.Direction
                    End If
                End If
                Dim Consist As New StringBuilder
                If Me.TrainType = "" Then Me.TrainType = "FREIGHT"
                Consist.Append(Me.TrainType)
                Consist.Append(";")
                Consist.Append(Me.LeadUnitOrientation)
                Consist.Append(";")
                Consist.Append(Me.OTons)
                Consist.Append(";")
                Consist.Append(Me.NumberOfAxles)
                Consist.Append(";")
                Consist.Append(Me.NumberOperatingBrakes)
                Consist.Append(";")
                If optEnableARRCSpecificOptions AndAlso Me.TotalLength > 0 Then
                    Consist.Append(Me.TotalLength)
                Else
                    Consist.Append(Me.OLength)
                End If
                Consist.Append(";")
                Consist.Append(Me.OLoads)
                Consist.Append(";")
                Consist.Append(Me.OEmts)
                Consist.Append(";")
                Consist.Append(Me.MaxSpd)
                Return Consist.ToString

            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty

            End Try
        End Function

        Private Function GetLocoConsistString() As String
            Try
                Dim Consist As New StringBuilder
                Dim u As TrainUnit
                For Each u In Me.UnitsInTrain
                    If Consist.Length <> 0 Then
                        Consist.Append("|")
                    End If
                    Consist.Append(u.UnitNumber)
                    Consist.Append(";")
                    Consist.Append(u.UnitPosition)
                    Consist.Append(";")
                    Consist.Append(u.Weight)
                    Consist.Append(";")
                    Dim LocoStatus As String = "RUN"

                    If optEnableMetroLinkSpecificOptions Then
                        If u.UnitPosition = 2 AndAlso u.EffectiveHP = 0 Then
                            LocoStatus = "ISOLATE"
                        Else
                            LocoStatus = "RUN"
                        End If
                    Else
                        If u.Isolated OrElse u.EffectiveHP = 0 Then
                            LocoStatus = "ISOLATE"
                        End If
                    End If



                    Consist.Append(LocoStatus)
                    Consist.Append(";")
                    Consist.Append(u.Length)
                    Consist.Append(";")
                    '  If Not optEnableMetroLinkSpecificOptions Then
                    Consist.Append(u.EffectiveHP)
                    ' Else
                    '   Consist.Append(u.TotalHP)
                    '   End If

                Next
                Return Consist.ToString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty
            End Try
        End Function

