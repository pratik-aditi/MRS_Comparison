        Public Function CreateBulletinsFromTrainRestrictions(ByVal frmOwner As Form, ByRef RestrictionBullNumbers As ArrayList) As Boolean
            Try
                RestrictionBullNumbers = New ArrayList
                DoRestrictionRefresh()
                If Me.myRestrictionList.Count = 0 Then Return True
                Dim MessageList As New ArrayList
                MessageList.Add("TRAIN SYMBOL - " & Me.Name & " HAS " & Me.myRestrictionList.Count & " CAR RESTRICTIONS")
                MessageList.Add("")
                MessageList.Add("CAR RESTRICTIONS LIST:")
                Dim tr As TrainRestriction
                For Each tr In myRestrictionList
                    MessageList.Add(tr.myCarUID & Space(15 - tr.myCarUID.Count) & "(" & tr.mySpeedLimit.ToString.PadLeft(2, "0") & ") (" & tr.myTypeOfRestriction & ") (" & tr.myMilePostBegin & " TO " & tr.myMilePostEnd & ") (" & tr.TrackName & ")")
                Next
                MessageList.Add("")
                MessageList.Add("ACTIVATE RESTRICTIONS?")

                Dim LaunchPoint As New Point(frmOwner.Location.X + 20, frmOwner.Location.Y + 200)
                Dim frmMessageBox As frmMessageBox
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = frmOwner
                'frmMessageBox.SetMessage(MessageList, "SYSTEM MESSAGE", True, LaunchPoint)
                frmMessageBox.SetMessage(MessageList, "SYSTEM MESSAGE", True, LaunchPoint, Nothing, False, False, Nothing, Nothing, False, Nothing, False, True, False, False, False, False, Nothing, True)
                frmMessageBox.ShowDialog()
                If frmMessageBox.FormFeedBack <> 6 Then
                    Return False
                Else
                    Dim BullList As New ArrayList

                    For Each tr In myRestrictionList
                        Dim errMSg As String = String.Empty
                        If Not tr.CreateBulletin(Me, False, errMSg) Then
                            Dim MessageList1 As New ArrayList
                            MessageList1.Add("BULLETIN NOT CREATED FOR TRAIN RESTRICTION.")
                            MessageList1.Add(tr.myCarUID & Space(15 - tr.myCarUID.Count) & "(" & tr.mySpeedLimit.ToString.PadLeft(2, "0") & ") (" & tr.myTypeOfRestriction & ") (" & tr.myMilePostBegin & " TO " & tr.myMilePostEnd & ") (" & tr.TrackName & ")")
                            MessageList1.Add("")
                            'MessageList.Add("CALL ADMINISTRATOR!!")
                            If Not String.IsNullOrEmpty(errMSg) AndAlso errMSg.Trim <> "" Then MessageList1.Add("ERROR MSG: " & errMSg)
                            MessageList1.Add("DO YOU WANT TO PROCEED WITH OTHER RESTRICTIONS?")
                            If ShowCustomMessageBox(MessageList1, "CREATE FORM-C ERROR", True, LaunchPoint, True, True, frmOwner) <> 6 Then
                                Return False
                            Else
                                Dim ErrorMsg As String = tr.myCarUID & Space(15 - tr.myCarUID.Count) & "(" & tr.mySpeedLimit.ToString.PadLeft(2, "0") & ") (" & tr.myTypeOfRestriction & ") (" & tr.myMilePostBegin & " TO " & tr.myMilePostEnd & ") (" & tr.TrackName & ")(" & tr.myUID & ")"
                                TrainEventLog("FORM-C CREATE FAILED FOR RESTRICTION: " & ErrorMsg)
                            End If
                        End If
                    Next
                End If
                frmMessageBox.Dispose()
                frmMessageBox = Nothing
                For Each tr In myRestrictionList
                    If tr.myBulletinGUID IsNot Nothing AndAlso Not String.IsNullOrEmpty(tr.myBulletinGUID) AndAlso tr.myBulletinGUID.Trim <> "" Then
                        If RestrictionBullNumbers.Contains(tr.myBulletinGUID) Then RestrictionBullNumbers.Add(tr.myBulletinGUID)
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

