        Public Sub UpdateFinalTime()
            Dim dbComm As OleDbCommand = Nothing
            Dim Update As New System.Text.StringBuilder
            Try
                Dim FinalDate As Date = Now
                If Me.myTrack IsNot Nothing Then
                    FinalDate = ReturnReportTime(Nothing, Me.myTrack)
                Else
                    If TMDS.GlobalDeclarations.ControlledSubdivisions IsNot Nothing AndAlso TMDS.GlobalDeclarations.ControlledSubdivisions.Count > 0 Then
                        FinalDate = GenerateTime(TMDS.GlobalDeclarations.ControlledSubdivisions(0))
                    End If
                End If
                Dim TrainIDUpdateSQL As String = ""
                Using DBConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    DBConn.Open()
                    Update.Append("UPDATE tblTrainsActive ")
                    Update.Append(" SET [FinalTime] = '" & FinalDate.ToString & "'")
                    Update.Append(" WHERE [TrainGUID] = " & "'" & Me.TrainGUID & "'")
                    dbComm = New OleDbCommand(Update.ToString, DBConn)
                    dbComm.ExecuteNonQuery()

                    Update = New StringBuilder
                    Update.Append("UPDATE tblTrainsActiveSubTrainSheets ")
                    Update.Append(" SET [FinalTime] = '" & FinalDate.ToString & "'")
                    Update.Append(" WHERE [TrainGUID] = " & "'" & Me.TrainGUID & "' AND ActiveSubTrainSheet='" & Me.ActiveTrainSheetGUID & "'")
                    dbComm = New OleDbCommand(Update.ToString, DBConn)
                    dbComm.ExecuteNonQuery()
                    DBConn.Close()
                End Using

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
            End Try
        End Sub

        Public Function UpdateTrainArrivalDepartureIntoDatabase(cblRecordArrival As Boolean) As Boolean
            Dim Update As New System.Text.StringBuilder
            Dim UpdateSubSheet As New System.Text.StringBuilder
            Dim QueryCollection As New ArrayList
            Try
                Update.Append("UPDATE tblTrainsActive ")
                If cblRecordArrival Then
                    Update.Append(" SET ArrTime = '" & Me.ArrTime & "'")
                    Update.Append(",Origin = '" & Me.Origin & "'")
                Else
                    Update.Append(" SET DepTime = '" & Me.DepTime & "'")
                    Update.Append(",Dest = '" & Me.Dest & "'")
                End If

                Update.Append(" WHERE Symbol = " & "'" & Name & "'")
                QueryCollection.Add(Update.ToString)

                UpdateSubSheet.Append(Update.ToString)
                UpdateSubSheet.Append(" AND ActiveSubTrainSheet = '" & Me.ActiveTrainSheetGUID & "'")
                QueryCollection.Add(UpdateSubSheet.ToString)

                If Not ExecuteQueryCollection(QueryCollection, gConnectionStringTrain) Then
                    Return False
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return True
        End Function

