                For Each mess In theMessage
                    If Message.Length = 0 Then
                        Message.Append(mess)
                    Else
                        Message.Append("|")
                        Message.Append(mess)
                    End If
                Next
                query.Append("'") : query.Append(Message.ToString) : query.Append("',")

                Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(theSwitch.SubdivisionID)
                Dim SubName As String = "UNASSIGNED"
                If Not IsNothing(subdvn) Then
                    SubName = subdvn.Abbreviation 'subdvn.Name
                End If

                Dim data As New StringBuilder
                data.Append(SubName) : data.Append("|") : data.Append(theSwitch.GUID) : data.Append("|") : data.Append(theSwitch.MilePost) : data.Append("|") : data.Append(theSwitch.MilePostSuffix) : data.Append("|") : data.Append(theTrack.GUID) : data.Append("|") : data.Append(Mid(trn.Direction, 1, 1))

                query.Append("'") : query.Append(data.ToString) : query.Append("',")
                query.Append("'") : query.Append(gThisWorkstation.WrkStnNumber) : query.Append("',")
                query.Append("'") : query.Append(AuthorityLimits) : query.Append("',")
                query.Append("'") : query.Append(DBLKGUID) : query.Append("',")
