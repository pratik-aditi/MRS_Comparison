        Public Sub PerformLoadTrainDelays()
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim query As String = "SELECT * FROM tblTrainEventActiveDelays WHERE TrainSheetUID = '" & Me.ActiveTrainSheetGUID & "' ORDER BY EventTimeStamp DESC"
            Try
                'If Me.myDelayList IsNot Nothing Then
                Me.myDelayList.Clear()
                'Else
                '    Me.myDelayList = ArrayList.Synchronized(New ArrayList)
                'End If

                Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(query, dbconn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        Dim td As New TrainDelay
                        If Not dr.IsDBNull(0) Then td.DelayUID = dr.GetString(0)
                        If Not dr.IsDBNull(1) Then td.TrainSheetUID = dr.GetString(1)
                        If Not dr.IsDBNull(2) Then td.IdentifyingPointUID = dr.GetString(2)
                        If Not dr.IsDBNull(3) Then td.IdentifyingPointName = dr.GetString(3)
                        If Not dr.IsDBNull(4) Then td.EventTimeStamp = dr.GetDateTime(4)
                        If Not dr.IsDBNull(5) Then td.EventTimeZone = dr.GetString(5)
                        If Not dr.IsDBNull(6) Then td.EventMilePost = dr.GetString(6)
                        If Not dr.IsDBNull(7) Then td.EventTrackName = dr.GetString(7)
                        If Not dr.IsDBNull(8) Then td.EventDelayCode = dr.GetString(8)
                        If Not dr.IsDBNull(9) Then td.EventComments = dr.GetString(9)
                        If Not dr.IsDBNull(10) Then td.EventDelayAmount = dr.GetInt32(10)
                        If Not dr.IsDBNull(11) Then td.RailroadUID = dr.GetString(11)
                        If Not dr.IsDBNull(12) Then td.ReportData = dr.GetString(12)
                        If Not dr.IsDBNull(13) Then td.myReportingPerson = dr.GetString(13)
                        If Not dr.IsDBNull(14) Then td.myDelayEventType = td.GetDelayEventType(dr.GetString(14))
                        If Not dr.IsDBNull(15) Then td.myDelaySubEventType = td.GetDelaySubEventType(dr.GetString(15))
                        If Not dr.IsDBNull(16) Then td.myScheduleStationIndex = dr.GetInt32(16)
                        If Not dr.IsDBNull(17) Then td.myScheduleStationUID = dr.GetString(17)
                        If dr.FieldCount >= 21 Then
                            If Not dr.IsDBNull(18) Then td.myDeviceName = dr.GetString(18)
                            If Not dr.IsDBNull(19) Then td.myDeviceUID = dr.GetString(19)
                            If Not dr.IsDBNull(20) Then td.IdentifyingPointMilepost = dr.GetString(20)
                        End If
                        If dr.FieldCount >= 22 Then
                            If Not dr.IsDBNull(21) Then td.EventDelayDescription = dr.GetString(21)
                        End If
                        If dr.FieldCount >= 24 Then
                            If Not dr.IsDBNull(23) Then td.myDelayExcused = dr.GetValue(23)
                        End If
                        If dr.FieldCount >= 25 Then
                            If Not dr.IsDBNull(24) Then td.myReportNumber = dr.GetValue(24)
                        End If
                        td.myTrain = Me
                        Me.myDelayList.Add(td)

                    End While
                    dr.Close()
                    dbconn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex, "PerformLoadTrainDelays - SQL[" & query & "]")
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Sub

