#Region "Train Abbreviation"
        Sub ReleaseTrainAbbreviation(ByVal AbbrevCollection As ArrayList)
            Dim abbr As TrainIDAbbreviation
            Try
                For Each abbr In AbbrevCollection
                    If abbr.AbbrID = Me.Abbreviation Then
                        abbr.InUsed = False
                        Exit For
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Sub ApplyTrainAbbreviation(ByVal AbbrevCollection As ArrayList)
            Dim abbr As TrainIDAbbreviation
            Try
                If Me.Abbreviation = "" Then
                    For Each abbr In AbbrevCollection
                        If abbr.TrainDirection = Me.Direction And Not abbr.InUsed Then
                            abbr.InUsed = True
                            Me.Abbreviation = abbr.AbbrID
                            Exit For
                        End If
                    Next
                Else
                    For Each abbr In AbbrevCollection
                        If abbr.AbbrID = Me.Abbreviation Then
                            abbr.InUsed = False
                            Exit For
                        End If
                    Next

                    For Each abbr In AbbrevCollection
                        If abbr.TrainDirection = Me.Direction And Not abbr.InUsed Then
                            abbr.InUsed = True
                            Me.Abbreviation = abbr.AbbrID
                            Exit For
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
