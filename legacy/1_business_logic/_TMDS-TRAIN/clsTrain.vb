        Private Sub RemoveAlertsForPTC()
            Try
                Dim ListOfAlerts As New ArrayList
                Dim al As Alert
                For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                    If Not IsNothing(al.AlertObject) Then
                        Dim AlertObjectType As String = al.AlertObject.GetType.ToString
                        Select Case AlertObjectType
                            Case "TMDS.TrackAuthority.TrackAuthority"
                                Dim auth As TrackAuthority.TrackAuthority = CType(al.AlertObject, TrackAuthority.TrackAuthority)
                                If auth.TrainSymbol = Me.Name Then
                                    ListOfAlerts.Add(al)
                                End If
                            Case "TMDS.TrackAuthority.SFAuthority"
                                Dim auth As TrackAuthority.SFAuthority = CType(al.AlertObject, TrackAuthority.SFAuthority)
                                If auth.TrainSymbol = Me.Name Then
                                    ListOfAlerts.Add(al)
                                End If
                            Case "TMDS.TrainComponents.TrainID"
                                Dim trn As TrainID = CType(al.AlertObject, TrainID)
                                If trn.Name = Me.Name Then
                                    ListOfAlerts.Add(al)
                                End If
                        End Select
                    End If
                Next
                For Each al In ListOfAlerts
                    al.AlertAcknowledged = True
                    'TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)

                    Dim SummItem As New SummaryItem("ALERT", "REMOVE", al)
                    SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                    End SyncLock
                Next
                gSystemAlertExists = False

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Update status
        ''' </summary>
        ''' <param name="pStateChange"></param>
        Public Sub UpdatePTCStatus(ByVal pStateChange As String)
            Dim update As New System.Text.StringBuilder
            Try
                Me.PTCStatus = pStateChange
                update.Append("UPDATE tblTrainsActive ")
                update.Append(" Set PTCStatus  = '" & Me.PTCStatus & "'")
                update.Append(" WHERE Symbol = " & "'" & Name & "'")
