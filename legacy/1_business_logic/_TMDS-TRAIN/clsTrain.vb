        ''' <summary>
        ''' PTC Sub Status
        ''' </summary>
        ''' <returns>Return sub status from PTC onboard</returns>
        Public Property PTCSubStatus() As String
            Get
                Return pPTCSubStatus
            End Get
            Set(ByVal Value As String)
                pPTCSubStatus = Value
                Select Case pPTCSubStatus
                    Case "DISENGAGED"
                        mySubStatusPTC = SubStatusPTC.DISENGAGED
                        If optEnableAutomaticCutoutFromActiveToDisengagedState Then
                            CheckAutoCutoutForTrain()
                        End If
                    Case "ACTIVE"
                        mySubStatusPTC = SubStatusPTC.ACTIVE
                    Case "CUTOUT"
                        mySubStatusPTC = SubStatusPTC.CUTOUT
                        AutoCutoutTrain = False
                    Case "SELFTEST"
                        mySubStatusPTC = SubStatusPTC.SELFTEST
                    Case "INITIALIZING"
                        mySubStatusPTC = SubStatusPTC.INITIALIZING
                        AutoCutoutTrain = False
                    Case "SWITCHING"
                        mySubStatusPTC = SubStatusPTC.SWITCHING
                    Case Else
                        mySubStatusPTC = SubStatusPTC.UNKNOWN
                End Select
                myPreviousSubStatusPTC = mySubStatusPTC
            End Set
        End Property

        Public ReadOnly Property CPName() As String
            Get
                Dim RetStr As String = Me.Name
                If optEnableCPTrainsheet Then
                    If Not GhostTrain Then
                        If Me.Name.Contains("$") Then
                            Dim arr() As String = Me.Name.Split("$")
                            If arr.Length > 0 Then
                                RetStr = arr(0)
                            End If
                        End If
                    Else
                        RetStr = "G" & Space(1) & Me.Name
                    End If
                End If
                Return RetStr
            End Get
        End Property

