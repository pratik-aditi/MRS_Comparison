        Public Property Direction() As String
            Get
                Return pDirection
            End Get
            Set(ByVal Value As String)
                Dim DirectionChangeDetected As Boolean
                If Value <> pDirection Then
                    DirectionChangeDetected = True
                End If
                pDirection = Value
                Dim ShadowMode As Boolean
                If Not IsNothing(Me.myTrack) Then
                    ShadowMode = myTrack.IsShadowMode
                End If

                If DirectionChangeDetected And Not (gAssistMode OrElse ShadowMode) Then
                    Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf Me.PublishTrainEvent)
                    PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, False, Nothing, Nothing)
                    If Me.GeoFenceLegacyEnabled Then
                        Me.ResetGeoFence(True)
                    End If
                End If

            End Set

        End Property

        Public Property IdentifingUnit() As String
            Get
                Return pIdentifingUnit
            End Get
            Set(ByVal Value As String)
                Dim PublishEvent As Boolean
                If Value <> pIdentifingUnit Then
                    PublishEvent = True
                End If
                pIdentifingUnit = Value
                Dim ShadowMode As Boolean
                If Not IsNothing(Me.myTrack) Then
                    ShadowMode = myTrack.IsShadowMode
                End If

                If PublishEvent And Not (gAssistMode OrElse ShadowMode) Then
                    Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf Me.PublishTrainEvent)
                    PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, False, Nothing, Nothing)
                End If
            End Set

        End Property

