#Region "TRAIN DELAY GENERATION"

        Public Sub CheckToGenerateTrainDelayFromBulletins()
            Try
                Dim sb As SubBulletin
                For Each sb In Me.myTrack.Bulletins
                    Select Case sb.myType
                        Case BulletinType.SPEED
                            If Not DoesSpeedRestrictionEventExist(sb) Then
                                If optEnableShadowMode Then
                                    If Me.myTrack.IsValidTrackForOperation Then
                                        GenerateTrainDelayFromSpeedRestriction(sb)
                                    End If
                                Else
                                    GenerateTrainDelayFromSpeedRestriction(sb)
                                End If
                            End If
                    End Select
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function DoesSpeedRestrictionEventExist(ByVal sb As SubBulletin) As Boolean
            Try
                Dim te As TrainEvent
                For Each te In Me.myEventList
                    Select Case te.EventType.ToUpper.Trim
                        Case "TRAIN DELAY", "TRAIN-DELAY-SR"
                            If InStr(te.EventData, "BULLETIN:" & sb.BullUID) > 0 Then
                                Return True
                            End If
                    End Select
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Sub GenerateTrainDelayFromSpeedRestriction(ByVal sb As SubBulletin)
            '            The current slow order code is as follows:
            '- Regular Speed
            '- Restricted Speed
            '- Slow Order Start Milepost
            '- Slow Order Stop Milepost
            '- Train Length

            'Given the above, the calculation is currently being done as follows:
            '=====================
            'Slow Order Length = Abs(Start Milepost - End Milepost) or 0.10 for Slide Zone
            'Slow Order Speed = Restricted speed or 15 for Slide Zone
            'Acceleration = (Regular Speed - Restricted Speed) * 0.125 or (Regular Speed - 15) * 0.125 for Slide Zone

            'Slow Order Time = (Slow Order Length + Train Length) / Slow Order Speed + (Acceleration*2) / (Restricted Speed + Regular Speed)) * 60 (to convert it to minutes)
            'Normal time = (Slow Order Length + Train Length + Acceleration) / Regular Speed
            '                     * 60 (to convert it to minutes)

            'It then averages those times and finds the sum total of the lost time from the slow order. The average of those slow order times is what shows up on the Velocity Performance Summary report.
            '=====================
            Dim SObldr As New StringBuilder
            Try
                '*******************************************************************************************************
                Dim myTrainLengthInMiles As Double = Me.OLength * 0.000189394
                Dim SlowOrderLength As Double = Math.Abs(CDbl(sb.MilePostEnd) - CDbl(sb.MilePostBegin))
                If SlowOrderLength = 0 Then SlowOrderLength = 0.1
                Dim RegularSpeed As Integer = Me.myTrack.myTrackSpeedMax
                Dim SlowOrderSpeed As Integer = 0
                SlowOrderSpeed = sb.SpeedFrght

                If Me.TrainType = "PASSENGER" Then
                    SlowOrderSpeed = sb.SpeedPassg
                End If
                If sb.myTypeForm = BulletinFormType.FORMS Then
                    myTrainLengthInMiles = 0
                End If


                Dim Acceleration As Double = 0
                Acceleration = ((RegularSpeed - SlowOrderSpeed) * 0.125)

                With SObldr
                    .Append("BULLETIN UID: " & sb.BullUID & ", ")
                    .Append("Train Length: " & myTrainLengthInMiles & ", ")
                    .Append("Slow Order Length: " & SlowOrderLength & ", ")
                    .Append("Track Speed: " & RegularSpeed & ", ")
                    .Append("Slow Order Speed: " & SlowOrderSpeed & ", ")
                    .Append("Acceleration: " & Acceleration & ", ")
                End With
                If SlowOrderSpeed > RegularSpeed Then
                    SObldr.Append("BULLETIN SPEED IS GREATER THAN TRACK SPEED")
                    Me.TrainEventLog("SLOW ORDER: " & Me.Name & "  SO DETAILS:" & SObldr.ToString)
                    Exit Sub
                End If
                'NormalTime
                Dim NormalTime As Double = 0
                NormalTime = ((SlowOrderLength + myTrainLengthInMiles + Acceleration) / RegularSpeed) * 60
                Dim SlowOrderTime As Double = 0
                Dim SlowOrderTimePart1 As Double = 0
                Dim SlowOrderTimePart2 As Double = 0
                'SlowOrderTimePart1 = ((SlowOrderLength + myTrainLengthInMiles) / SlowOrderSpeed)
                'SlowOrderTimePart2 = (Acceleration) / ((RegularSpeed + SlowOrderSpeed) / 2)
                'SlowOrderTime = (SlowOrderTimePart1 + SlowOrderTimePart2) / 60
                SlowOrderTimePart1 = ((SlowOrderLength + myTrainLengthInMiles) / SlowOrderSpeed)
                SlowOrderTimePart2 = (Acceleration) / ((RegularSpeed + SlowOrderSpeed) / 2)
                SlowOrderTime = (SlowOrderTimePart1 + SlowOrderTimePart2) * 60
                Dim LostTime As Integer = 0
                'LostTime = NormalTime - SlowOrderTime
                'ARRC-1370
                LostTime = SlowOrderTime - NormalTime

                With SObldr
                    .Append("NormalTime: " & NormalTime & ", ")
                    .Append("SlowOrderTime: " & SlowOrderTime & ", ")
                    .Append("LostTime: " & LostTime)
                End With
                Me.TrainEventLog("SLOW ORDER: " & Me.Name & "  SO DETAILS:" & SObldr.ToString)
                If LostTime > 0 Then
                    If optEnableDenverSpecificOptions Then LostTime = 0
                    LogTrainDelayFromSpeedRestriction(LostTime, sb)

                    Dim TrainEvent As String = "TRAIN DELAYED FROM SPEED RESTRICTION. BULLETIN:" & sb.myUID & " - " & LostTime.ToString.PadLeft(3, "0") & " MINUTES DELAY @ MP:" & sb.MilePostBeginPrefix & sb.MilePostBegin & sb.MilePostBeginSuffix
                    LogTrainEventFromSpeedRestriction(TrainEvent)
                Else

                End If
                '********************************************************************************************************
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub LogTrainDelayFromSpeedRestriction(ByVal DelayTime As Integer, ByVal theBull As SubBulletin)
            Try
                Dim td As New TrainDelay
                td.DelayUID = Guid.NewGuid.ToString.ToUpper
                td.TrainSheetUID = Me.ActiveTrainSheetGUID
                td.IdentifyingPointUID = Me.myTrack.myControlPoint.GUID
                td.IdentifyingPointName = Me.myTrack.myControlPoint.UniqueName
                td.EventTimeStamp = Now
                td.EventTimeZone = Mid(Me.myTrack.TimeZone, 1, 1)
                td.EventMilePost = theBull.MilePostBeginPrefix & theBull.MilePostBegin & theBull.MilePostBeginSuffix
                td.EventTrackName = myTrack.TrackName

                If optEnableARRCSpecificOptions AndAlso theBull.mysTypeForm = "FORM S" Then
                    td.EventDelayCode = "SZ"
                ElseIf optEnableDenverSpecificOptions Then
                    td.IdentifyingPointName = Me.myTrack.myControlPoint.Name
                    Dim DC As DelayCode = Nothing
                    'cschock: DENVER need to get saved delay code value if it has one
                    'DC = GetDelayCodeByCode("SO")
                    'td.EventDelayCode = "SO"
                    If theBull.myDelayCode IsNot Nothing AndAlso theBull.myDelayCode.Trim <> "" Then
                        DC = GetDelayCodeByCode(theBull.myDelayCode)
                        td.EventDelayCode = theBull.myDelayCode
                    Else
                        DC = GetDelayCodeByCode("SO")
                        td.EventDelayCode = "SO"
                    End If
                    'cschock: DENVER the excused value can be different than the default for delay code
                    If theBull.DelayExcused IsNot Nothing AndAlso theBull.DelayExcused.Trim <> "" Then
                        td.myDelayExcused = theBull.DelayExcused
                    ElseIf DC IsNot Nothing Then
                        td.myDelayExcused = DC.DelayExcused
                    Else
                        td.myDelayExcused = ""
                    End If
                Else
                    td.EventDelayCode = "MW"
                End If

                'td.EventDelayCode = "MW"
                td.EventComments = "TRACK SPEED RESTRICTION - AUTOMATICALLY GENERATED FROM TRAIN MOVEMENT BULLETIN:" & theBull.myUID & " [" & GetBulletinType(theBull) & "]"
                'td.EventComments = "TRACK SPEED RESTRICTION - AUTOMATICALLY GENERATED FROM TRAIN MOVEMENT BULLETIN:" & theBull.myUID & " [" & theBull.mysTypeForm & "]"
                td.EventDelayAmount = DelayTime
                td.RailroadUID = "NONE"
                'td.ReportData = Me.GetTrainReportDataString("MW", DelayTime)
                td.ReportData = Me.GetTrainReportDataString(td.EventDelayCode, DelayTime)
                td.myTrain = Me
                td.myReportingPerson = gCurrentUser.FirstName & ", " & gCurrentUser.LastName
                td.myDelayEventType = TrainDelay.DelayEventType.Automatic
                td.myDelaySubEventType = TrainDelay.DelayEventSubType.SO
                td.myScheduleStationIndex = GetStationIndex(Me.myTrack.myControlPoint.UniqueName)
                td.myScheduleStationUID = Me.myTrack.myControlPoint.UniqueName
                td.myDeviceName = td.GetDeviceNameString(Me.myTrack)
                If Not optEnableDenverSpecificOptions Then td.myReportNumber = theBull.myUID
                td.AddDelayToDatabase()
                If optEnableTrainFunctionalityARRC Then
                    TMDS.NetworkMessages.CadMessages.SendTrainDelayARRC(Me, td, gMISTransmitQueue)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub LogTrainEventFromSpeedRestriction(ByVal EventString As String)
            Try
                Me.AddTrainSheetEvent("TRAIN-DELAY-SR", Now, Mid(Me.myTrack.TimeZone, 1, 1), EventString, Me.myTrack.myControlPoint.GUID.ToString, Me.GetIdentifyingLocationNameFromLimits, "NONE")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function GetStationIndex(ByVal IdentifingPointName As String) As Integer
            Try
                Dim ts As TrainSchedule
                If Me.myScheduleList.Count > 0 Then
                    For Each ts In Me.myScheduleList
                        If ts.myStationName = IdentifingPointName Then
                            Return ts.myStationScheduleIndex
                        End If
                    Next
                End If
                Return 0
            Catch ex As Exception
                SystemException(ex.ToString)
                Return 0
            End Try
        End Function

        Public Function GetStationUniqueName(ByVal IdentifingPointName As String) As String
            Try
                Dim cp As ControlPoint
                For Each cp In gControlPointCollection
                    If cp.Name = IdentifingPointName Then
                        Return cp.UniqueName
                    End If
                    If cp.UniqueName = IdentifingPointName Then
                        Return IdentifingPointName
                    End If
                Next
                Return IdentifingPointName
            Catch ex As Exception
                SystemException(ex.ToString)
                Return IdentifingPointName
            End Try
        End Function
