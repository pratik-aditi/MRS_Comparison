        ''' <summary>
        ''' Retrieves the record from tblSystemLocomotives which corresponds to the locomotive object.
        ''' Updates the data in the object to what is stored in the table.
        ''' </summary>
        ''' <returns>Returns True if a record is found.</returns>
        Public Function CheckUnitNumberInSystemLocomotivesTable(ByVal getData As Boolean) As Boolean
            Dim recordFound As Boolean = False
            Dim SQLQuery As String = "SELECT Length, Weight, PTCEquipped, HorsePower, EffectiveHP, NumOfAxles, GPSEquipped, Status FROM tblSystemLocomotives WHERE UID='" & Me.UnitNumber & "'"
            Try
                Using dbConn As New OleDbConnection(gConnectionStringStatic)
                    dbConn.Open()
                    Dim dbComm As New OleDbCommand(SQLQuery, dbConn)
                    Dim dr As OleDbDataReader = dbComm.ExecuteReader

                    While dr.Read
                        If getData Then
                            ' Length
                            If Not dr.IsDBNull(0) Then
                                Me.Length = dr.GetInt32(0)
                            Else
                                Me.Length = -1
                            End If
                            ' Weight
                            If Not dr.IsDBNull(1) Then
                                Me.Weight = dr.GetInt32(1)
                            Else
                                Me.Weight = -1
                            End If
                            ' PTCEquipped
                            If Not dr.IsDBNull(2) Then
                                Me.PTCEquipped = dr.GetBoolean(2)
                            Else
                                Me.PTCEquipped = False
                            End If
                            ' TotalHP
                            If Not dr.IsDBNull(3) Then
                                Me.TotalHP = dr.GetInt32(3)
                            Else
                                Me.TotalHP = -1
                            End If
                            ' EffectiveHP
                            If Not dr.IsDBNull(4) Then
                                Me.EffectiveHP = dr.GetInt32(4)
                            Else
                                Me.EffectiveHP = -1
                            End If
                            ' NumOfAxles
                            If Not dr.IsDBNull(5) Then
                                Me.NumOfAxles = dr.GetInt32(5)
                            End If
                            ' GPSEquipped
                            If Not dr.IsDBNull(6) Then
                                Me.GPSCapable = dr.GetBoolean(6)
                            Else
                                Me.GPSCapable = False
                            End If
                            ' Status
                            If Not dr.IsDBNull(7) Then
                                Me.Status = dr.GetString(7)
                            Else
                                Me.Status = String.Empty
                            End If
                        End If

                        recordFound = True
                    End While

                    dr.Close()
                    dbConn.Close()
                End Using

                Return recordFound
            Catch ex As Exception
                GetErrorDetails(ex)
                Return False
            End Try
        End Function

        ''' <summary>
        ''' Persists the data to the database.
        ''' </summary>
        ''' <returns>Boolean value if save is succesful.</returns>
        Public Function Save() As Boolean
            Try
                Dim rowsUpdated As Integer = 0
                Dim primaryKey As String = Me.LocoConsistGUID
                Using dbConn As New OleDbConnection(gConnectionStringTrain)
                    dbConn.Open()
                    Using dbComm As New OleDbCommand()
                        dbComm.Connection = dbConn
                        dbComm.CommandType = CommandType.Text

                        Dim tableName As String = "tblTrainLocomotiveConsistActive"
                        Dim SQLQuery As New StringBuilder
                        ' determine if we are doing an Update or an Insert
                        If primaryKey = String.Empty Then
                            ' Insert
                            SQLQuery.Append("INSERT INTO " & tableName & " ")
                            SQLQuery.Append("(UnitID, TrainGUID, TrainSheetUID, FacingDirection, Status, UnitPosition, ConsistPosition, DeadHead, PTCEquipped, Length, Weight, HorsePower, EffectiveHP, NumOfAxles, GPSEquipped, Isolated, LocoConsistGUID) ")
                            SQLQuery.Append("VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)")

                            ' add the new primary key
                            primaryKey = Guid.NewGuid.ToString
                        Else
                            ' Update
                            SQLQuery.Append("UPDATE " & tableName & " ")
                            SQLQuery.Append("SET ")
                            SQLQuery.Append("UnitID = ?, ")
                            SQLQuery.Append("TrainGUID = ?, ")
                            SQLQuery.Append("TrainSheetUID = ?, ")
                            SQLQuery.Append("FacingDirection = ?, ")
                            SQLQuery.Append("Status = ?, ")
                            SQLQuery.Append("UnitPosition = ?, ")
                            SQLQuery.Append("ConsistPosition = ?, ")
                            SQLQuery.Append("DeadHead = ?, ")
                            SQLQuery.Append("PTCEquipped = ?, ")
                            SQLQuery.Append("Length = ?, ")
                            SQLQuery.Append("Weight = ?, ")
                            SQLQuery.Append("HorsePower = ?, ")
                            SQLQuery.Append("EffectiveHP = ?, ")
                            SQLQuery.Append("NumOfAxles = ?, ")
                            SQLQuery.Append("GPSEquipped = ?, ")
                            SQLQuery.Append("Isolated = ? ")
                            SQLQuery.Append("WHERE LocoConsistGUID = ?")
                        End If

                        ' using parameters for the following reasons:
                        ' 1. it is a best practice to combat SQL Injection and other SQL attacks,
                        ' 2. it ensures type safety of the data when persisting thus avoiding data persisting errors.
                        With dbComm.Parameters
                            .Add("@UnitID", OleDbType.VarChar, 15).Value = Me.UnitNumber
                            .Add("@TrainGUID", OleDbType.VarChar, 50).Value = Me.TrainGUID
                            .Add("@TrainSheetUID", OleDbType.VarChar, 50).Value = Me.TrainSheetUID
                            .Add("@FacingDirection", OleDbType.VarChar, 1).Value = Me.Direction
                            .Add("@Direction", OleDbType.VarChar, 10).Value = Me.Orientation
                            .Add("@Status", OleDbType.VarChar, 50).Value = Me.Status
                            .Add("@UnitPosition", OleDbType.Integer).Value = Me.UnitPosition
                            .Add("@UnitPosition", OleDbType.Integer).Value = Me.ConsistPosition
                            .Add("@DeadHead", OleDbType.Boolean).Value = Me.Deadhead
                            .Add("@PTCEquipped", OleDbType.Boolean).Value = Me.PTCEquipped
                            .Add("@Length", OleDbType.Integer).Value = IIf(Me.Length > 0, Me.Length, System.DBNull.Value)
                            .Add("@Weight", OleDbType.Integer).Value = IIf(Me.Weight > 0, Me.Weight, System.DBNull.Value)
                            .Add("@HorsePower", OleDbType.Integer).Value = IIf(Me.TotalHP >= 0, Me.TotalHP, System.DBNull.Value)
                            .Add("@EffectiveHP", OleDbType.Integer).Value = IIf(Me.EffectiveHP >= 0, Me.EffectiveHP, System.DBNull.Value)
                            .Add("@NumOfAxles", OleDbType.Integer).Value = Me.NumOfAxles
                            .Add("@GPSEquipped", OleDbType.Boolean).Value = Me.GPSCapable
                            .Add("@Isolated", OleDbType.Boolean).Value = Me.Isolated
                            .Add("@LocoConsistGUID", OleDbType.VarChar, 50).Value = primaryKey
                        End With

                        dbComm.CommandText = SQLQuery.ToString
                        rowsUpdated = dbComm.ExecuteNonQuery()
                    End Using
                    dbConn.Close()
                End Using

                ' return a value of true to inform the user the persist was successful
                Return (rowsUpdated = 1)
            Catch ex As Exception
                ' log the exception
                SystemException(ex.ToString)
                ' return a value of false to inform the user the data did not persist
                Return False
            End Try
        End Function

        ''' <summary>
        ''' Deletes the corresponding record from the database.
        ''' </summary>
        ''' <returns>Boolean value if delete is succesful.</returns>
        Public Function Delete() As Boolean
            Try
                Dim rowsUpdated As Integer = 0
                Using dbConn As New OleDbConnection(gConnectionStringTrain)
                    dbConn.Open()
                    Using dbComm As New OleDbCommand()
                        dbComm.Connection = dbConn
                        dbComm.CommandType = CommandType.Text

                        Dim tableName As String = "tblTrainLocomotiveConsistActive"
