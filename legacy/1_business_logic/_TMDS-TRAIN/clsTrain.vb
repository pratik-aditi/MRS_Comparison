        Public Function GetIdentifyingLocationNameFromLimits() As String
            Try
                Dim LocationName As String = String.Empty
                If Mid(Me.myTrack.AuthorityType, 1, 3) = "CTC" Then
                    LocationName = Me.myTrack.myControlPoint.Name
                Else
                    Select Case Direction
                        Case optDirectionEast, optDirectionNorth
                            LocationName = Me.myTrack.LeftLimitName
                        Case optDirectionSouth, optDirectionWest
                            LocationName = Me.myTrack.RightLimitName
                        Case Else
                            LocationName = Me.myTrack.myControlPoint.Name
                    End Select
                End If
                Return LocationName
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return String.Empty
        End Function

