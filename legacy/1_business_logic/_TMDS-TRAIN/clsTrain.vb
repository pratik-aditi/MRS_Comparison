#Region "ROUTE SEARCH METHODS"

        Public Function SearchRouteToNextStopSignal(ByVal CurrentTrack As Track) As Track
            Try
                If IsNothing(CurrentTrack) Then Return Nothing
                Dim theDirection As String = String.Empty
                Dim NextComp As Object = Nothing

                Select Case Me.Direction
                    Case "SOUTH", "WEST"
                        theDirection = "LEFT"
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentTrack.LeftLink)
                    Case "NORTH", "EAST"
                        theDirection = "RIGHT"
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CurrentTrack.RightLink)
                    Case Else
                        If optEnableARRCSpecificOptions Then
                            Return CurrentTrack
                        End If
                End Select
                If theDirection = "" Then Return Nothing

                Dim LoopControl As Integer
                Dim LastTrack As Track = CurrentTrack

                Do Until LoopControl > 100
                    Select Case theDirection
                        Case "RIGHT"
                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(NextComp, Signal)
                                If sig.ComponentType = "R" AndAlso Not (sig.SignalCtlStatus = Signal.CtlStatus.RequestedClear OrElse sig.SignalCtlStatus = Signal.CtlStatus.RequestedClear) Then
                                    If gOptDisableSignalControlOnManualOperateMode AndAlso NextComp IsNot Nothing Then
                                        If Not gMaintenanceMode Then
                                            If Not ValidateManualOperateMode(NextComp.myControlPoint) Then
                                                TrainEventLog("QUICK ROUTE SELECTION NOT OPERATONAL BECAUSE THE CONTROL POINT " & NextComp.myControlPoint.Name & " IS CURRENTLY IN MAINTENANCE MODE")
                                                MessageBox.Show("QUICK ROUTE  SELECTION NOT OPERATONAL BECAUSE THE CONTROL POINT." & vbCrLf & NextComp.myControlPoint.Name & " IS CURRENTLY IN MAINTENANCE MODE", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                                Return Nothing
                                            Else
                                                Return LastTrack
                                            End If
                                        End If
                                    ElseIf optEnableKCSSpecificOptions Then
                                        Return LastTrack
                                    End If
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)
                                If sw.RightAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightAltLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightLink)
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightLink)
                                End If
                            Else
                                If NextComp.GetType.ToString = gTrackComponentName Then LastTrack = NextComp
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        Case Else
                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim sig As Signal = CType(NextComp, Signal)
                                If sig.ComponentType = "L" AndAlso Not (sig.SignalCtlStatus = Signal.CtlStatus.RequestedClear OrElse sig.SignalCtlStatus = Signal.CtlStatus.RequestedClear) Then
                                    'Return LastTrack
                                    If gOptDisableSignalControlOnManualOperateMode AndAlso NextComp IsNot Nothing Then
                                        If Not gMaintenanceMode Then
                                            If Not ValidateManualOperateMode(NextComp.myControlPoint) Then
                                                TrainEventLog("QUICK ROUTE SELECTION NOT OPERATONAL BECAUSE THE CONTROL POINT " & NextComp.myControlPoint.Name & " IS CURRENTLY IN MAINTENANCE MODE")
                                                MessageBox.Show("QUICK ROUTE  SELECTION NOT OPERATONAL BECAUSE THE CONTROL POINT." & vbCrLf & NextComp.myControlPoint.Name & " IS CURRENTLY IN MAINTENANCE MODE", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                                Return Nothing
                                            Else
                                                Return LastTrack
                                            End If
                                        End If
                                    ElseIf optEnableKCSSpecificOptions Then
                                        Return LastTrack
                                    End If
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                Dim sw As Switch = CType(NextComp, Switch)
                                If sw.LeftAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftAltLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftLink)
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftLink)
                                End If
                            Else
                                If NextComp.GetType.ToString = gTrackComponentName Then LastTrack = NextComp
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.leftLink)
                            End If
                    End Select
                    LoopControl += 1
                Loop

                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

