        Public Function UpdateTrainID() As TrainID
            Dim TrainFetch As String
            Dim dr As OleDbDataReader
            Dim DatabaseCommand As OleDbCommand
            Dim trk As Track = Nothing
            Dim I As Integer
            Dim CompCollection As ArrayList = Nothing
            Dim CompToCheck As Object = Nothing
            Dim q As String = "'"
            Dim DataString() As String
            Dim trn As TrainID = Me
            Dim dbconn As OleDbConnection
            TrainFetch = "SELECT * FROM " & gtblTrainsActive
            TrainFetch = TrainFetch & " WHERE Symbol = " & q & trn.Name & q
            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                DatabaseCommand = New OleDbCommand(TrainFetch, dbconn)
                dbconn.Open()
                dr = DatabaseCommand.ExecuteReader()
                While dr.Read()
                    With trn
                        Dim UpdateActiveTrainSheet As Boolean
                        If Not dr.IsDBNull(77) Then
                            If Trim(dr.GetString(77)) <> "" Then
                                .ActiveTrainSheetGUID = dr.GetString(77)
                            Else
                                UpdateActiveTrainSheet = True
                                .ActiveTrainSheetGUID = Guid.NewGuid.ToString.ToUpper
                            End If
                        Else
                            UpdateActiveTrainSheet = True
                            .ActiveTrainSheetGUID = Guid.NewGuid.ToString.ToUpper
                        End If

                        .Name = dr.GetString(0)
                        .IdentifingUnit = dr.GetString(1)
                        .SymbolComment = dr.GetString(7)
                        .Direction = dr.GetString(8)

                        .TrackGUID = dr.GetInt32(5)
                        If Not dr.IsDBNull(3) Then
                            If dr.GetString(3) = "" Then
                                .SubID = 0
                            Else
                                .SubID = dr.GetString(3)
                            End If
                        End If

                        'Apply OS Times to Train
                        'Dim Conversion As Boolean
                        'If Not dr.IsDBNull(6) Then
                        '    If dr.GetString(6) <> "NONE" Or Trim(dr.GetString(6)) <> "" Then
                        '        trn.DoConvertOsRecords(dr.GetString(6))
                        '        Conversion = True
                        '    End If
                        'End If
                        'If Not Conversion Then
                        trn.GetOsRecords()
                        'End If

                        'Apply Units to Train
                        If Not dr.IsDBNull(10) Then
                            Dim unitData() As String = dr.GetString(10).Split("|")
                            Dim un As String
                            For Each un In unitData
                                If Trim(un) <> "" Then
                                    If Not .Units.Contains(un) Then
                                        .Units.Add(un)
                                    End If
                                End If
                            Next
                        End If
                        .UnitComment = dr.GetString(11)
                        .DepTime = dr.GetDateTime(12)
                        .ArrTime = dr.GetDateTime(13)
                        .FinalTime = dr.GetDateTime(14)

                        Dim Lds As Integer = dr.GetInt32(15)
                        Dim Emt As Integer = dr.GetInt32(16)
                        Dim Tons As Integer = dr.GetInt32(17)
                        Dim Len As Integer = dr.GetInt32(18)
                        Dim HasConsitChange As Boolean
                        Dim OLDGrossTon As Double = 0
                        Dim ChangedGrossTon As Double = 0

                        If Me.TrainConsistChangeCheck(Lds, Emt, Len, Tons, True) Then
                            If optEnableARRCSpecificOptions Then
                                HasConsitChange = True
                                CalculateHorsePowerPerTon()
                                Double.TryParse(Me.HorsePowerTrailing, OLDGrossTon)
                            End If
                        End If
                        .OLoads = Lds
                        .OEmts = Emt
                        .OTons = Tons
                        .OLength = Len
                        .DLoads = dr.GetInt32(19)
                        .DEmts = dr.GetInt32(20)
                        .DTons = dr.GetInt32(21)
                        .DLength = dr.GetInt32(22)
                        .MaxSpd = dr.GetInt32(23)
                        '.HorsePowerTrailing = dr.GetInt32(24)
                        .TonsPerOperativeBrake = dr.GetInt32(25)
                        .HazMat = dr.GetBoolean(26)
                        .HighWide = dr.GetBoolean(27)
                        .Origin = dr.GetString(28)
                        .Dest = dr.GetString(29)
                        .EOTD = dr.GetString(30)
                        .HOTD = dr.GetString(31)
                        If dr.FieldCount >= 88 Then
                            If Not dr.IsDBNull(84) Then '84
                                .CrewCurrentString = dr.GetString(84)
                            Else
                                .CrewCurrentString = .CrewCurrent.CreateCrewString
                            End If

                            If Not dr.IsDBNull(85) Then
                                .CrewReliefString = dr.GetString(85)
                            Else
                                .CrewReliefString = .CrewRelief.CreateCrewString
                            End If

                            If Not dr.IsDBNull(86) Then
                                .CrewPendingString = dr.GetString(86)
                            Else
                                .CrewPendingString = .CrewPending.CreateCrewString
                            End If
                        End If
                        trn.CrewCurrent.ApplyCrewString(trn.CrewCurrentString)
                        trn.CrewPending.ApplyCrewString(trn.CrewPendingString)
                        trn.CrewRelief.ApplyCrewString(trn.CrewReliefString)

                        'Apply Delays to Train
                        If dr.GetString(38) <> "" Then
                            DataString = dr.GetString(38).Split(Chr(124))
                            For I = 0 To DataString.GetUpperBound(0)
                                If Not .DelayInfo.Contains(DataString(I)) Then
                                    .DelayInfo.Add(DataString(I))
                                End If
                            Next
                        End If

                        'Apply Bulletins to Train
                        If dr.GetString(39) <> "" Then
                            DataString = dr.GetString(39).Split(Chr(124))
                            For I = 0 To DataString.GetUpperBound(0)
                                If Not .TrackBull.Contains(DataString(I)) Then
                                    .TrackBull.Add(DataString(I))
                                End If

                            Next
                        End If

                        'Apply Setouts to Train
                        If dr.GetString(40) <> "" Then
                            DataString = dr.GetString(40).Split(Chr(124))
                            For I = 0 To DataString.GetUpperBound(0)
                                If Not .BadOrderSetOuts.Contains(DataString(I)) Then
                                    .BadOrderSetOuts.Add(DataString(I))
                                End If
                            Next
                        End If

                        'Apply Train Sheet Events to Train
                        If dr.GetString(47) <> "" Then
                            DataString = dr.GetString(47).Split(Chr(124))
                            For I = 0 To DataString.GetUpperBound(0)
                                If Not .TrainSheetEvents.Contains(DataString(I)) Then
                                    .TrainSheetEvents.Add(DataString(I))
                                End If
                            Next
                        End If

                        .HelperTrain = dr.GetBoolean(56)
                        .KeyTrain = dr.GetBoolean(57)
                        .TrainGUID = dr.GetString(58)

                        If Not dr.IsDBNull(76) Then
                            .PTCStatus = dr.GetValue(76)
                        End If

                        If Not dr.IsDBNull(59) Then
                            .TotalHorsePower = dr.GetInt32(59)
                        End If

                        If Not dr.IsDBNull(60) Then
                            .ScheduleStatus = dr.GetString(60)
                            .TrainScheduleUpdate(True)
                        End If
                        If dr.FieldCount >= 62 Then
                            If Not dr.IsDBNull(61) Then
                                .TrainLinkedToMe = dr.GetString(61)
                            End If
                        End If

                        If dr.FieldCount >= 63 Then
                            If Not dr.IsDBNull(62) Then
                                .HorsePowerTrailing = dr.GetString(62)
                            End If
                        End If

                        If dr.FieldCount >= 65 Then
                            If Not dr.IsDBNull(64) Then
                                .TrainType = dr.GetString(64).Trim.ToUpper
                            End If
                        End If

                        If dr.FieldCount >= 66 Then
                            If Not dr.IsDBNull(65) Then
                                .SpecialNotation = dr.GetBoolean(65)
                            End If
                        End If


                        If dr.FieldCount >= 67 Then
                            If Not dr.IsDBNull(66) Then
                                .PseudoName = dr.GetString(66)
                            End If
                        End If

                        If dr.FieldCount >= 68 Then
                            If Not dr.IsDBNull(67) Then
                                .SubType = dr.GetString(67)
                            End If
                        End If

                        If dr.FieldCount >= 101 Then
                            If Not dr.IsDBNull(100) Then
                                .HomeRoadCode = dr.GetString(100)
                            End If
                        End If

                        If dr.FieldCount >= 103 Then
                            If Not dr.IsDBNull(102) Then
                                .AutomaticModeOn = dr.GetBoolean(102)
                            End If
                        End If

                        If dr.FieldCount >= 104 Then
                            If Not dr.IsDBNull(103) Then
                                .PriorityCode = dr.GetString(103)
                            End If
                        End If

                        If dr.FieldCount >= 105 Then
                            If Not IsDBNull(dr("PullerTrain")) Then
                                .PullerTrain = dr.GetBoolean(104)
                            End If
                        End If
                        If dr.FieldCount >= 120 Then
                            If Not dr.IsDBNull(119) Then .TGBONumber = dr.GetString(119)
                            If Not dr.IsDBNull(120) Then .TGBOStatus = dr.GetString(120)
                        End If

                        If dr.FieldCount >= 128 Then
                            If Not dr.IsDBNull(125) Then
                                .EntityUID = dr.GetString(125)
                            End If
                            If Not dr.IsDBNull(126) Then
                                .NumberOperatingBrakes = dr.GetInt32(126)
                            End If
                            If Not dr.IsDBNull(127) Then
                                .NumberOfAxles = dr.GetInt32(127)
                            End If
                        End If
                        If dr.FieldCount >= 130 Then
                            If Not dr.IsDBNull(130) Then
                                .TrainInActive = dr.GetBoolean(130)
                            End If
                        End If
                        If dr.FieldCount >= 132 Then
                            Dim dtDep As Date
                            Dim dtArr As Date
                            If Not dr.IsDBNull(131) Then
                                If Date.TryParse(dr.GetDateTime(131), dtDep) Then
                                    If dtDep.Year > 2000 Then .SchTimeDeparture = Format(dtDep, optSystemDateAndTimeString)
                                End If
                            End If
                            If Not dr.IsDBNull(132) Then
                                If Date.TryParse(dr.GetDateTime(132), dtArr) Then
                                    If dtArr.Year > 2000 Then .SchTimeArrival = Format(dtArr, optSystemDateAndTimeString)
                                End If
                            End If
                        End If
                        If dr.FieldCount >= 135 Then
                            If Not dr.IsDBNull(135) Then
                                .LocomotiveConsistInfoString_MIS = dr.GetString(135)
                            End If
                        End If
                        If dr.FieldCount >= 143 Then
                            If Not dr.IsDBNull(143) Then
                                .myMISInformation = dr.GetValue(143)
                            End If
                        End If

                        If dr.FieldCount >= 152 Then
                            If Not dr.IsDBNull(151) Then
                                .ScheduleType = dr.GetValue(151).Trim.ToUpper
                            End If
                        End If
                        .TypeOfID = "TRAIN"


                        If HasConsitChange AndAlso optApplyTrainSheetConfigurationForARRC Then
                            CalculateHorsePowerPerTon()
                            Dim NewGrossTon As Double
                            Double.TryParse(Me.HorsePowerTrailing, NewGrossTon)
                            trn.UpdateTrainUnits("Trainid.UpdateTrainID", True)
                        End If

                        If UpdateActiveTrainSheet Then
                            trn.UpdateTrainSheetGuid(True)
                        End If
                        If optApplyTrainSheetConfigurationForCN OrElse optEnableSpecificOptionsForFECR Then trn.UpdateTrainUnits("Trainid.UpdateTrainID")

                    End With
                    dbconn.Close()
                    Return trn
                End While
                DatabaseCommand = Nothing
                dbconn.Close()
                dbconn = Nothing
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return Nothing
            End Try
        End Function

