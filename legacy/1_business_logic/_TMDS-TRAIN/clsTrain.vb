        Public Sub PublishTrainCommand(ByVal EventType As EventTypeTrainID, Optional ByVal ShadowMode As Boolean = False)
            Try
                If ShadowMode Then Exit Sub
                Dim CurTerr As Territory
                Dim CurTrk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.TrackGUID)
                If Not CurTrk Is Nothing Then
                    CurTerr = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(CurTrk.TerritoryID)
                Else
                    Exit Sub
                End If

                Dim UpdateOnly As Boolean = False
                Dim OSOnly As Boolean = False
                Dim ReOrder As Boolean = False
                Dim MoveOnly As Boolean = False
                Dim SendAll As Boolean = True

                Dim Message As String = "AC" & Chr(6) & "TRAINCOMMAND;"
                Message = Message & "|" & CurTrk.TerritoryID.ToString

                Select Case EventType
                    Case EventTypeTrainID.POSITION
                        Message = Message & "|" & "POSITION"
                    Case EventTypeTrainID.MOVE ', EventTypeTrainID.MOVEMANUAL
                        Message = Message & "|" & "MOVE"
                    Case EventTypeTrainID.MOVEMANUAL
                        Message = Message & "|" & "MOVEMANUAL"
                    Case EventTypeTrainID.RELEASE, EventTypeTrainID.FINAL
                        Message = Message & "|" & "RELEASE"
                    Case EventTypeTrainID.UPDATE
                        Message = Message & "|" & "UPDATE"
                    Case EventTypeTrainID.OS
                        Message = Message & "|" & "OS"
                    Case EventTypeTrainID.REORDER
                        Message = Message & "|" & "REORDER"
                        SendAll = False
                        ReOrder = True
                End Select

                If SendAll Then
                    Message = Message & "|" & Me.Name
                    Message = Message & "|" & Me.TrackGUID
                    Message = Message & "|" & Guid.NewGuid.ToString.ToUpper

                ElseIf ReOrder Then
                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CInt(Me.TrackGUID))
                    If Not IsNothing(trk) Then
                        Message = Message & "|" & Me.Name
                        Message = Message & "|" & Me.TrackGUID
                        Message = Message & "|" & Guid.NewGuid.ToString.ToUpper

                        Dim trn As TrainID
                        Dim trains As String = String.Empty
                        For Each trn In trk.TrainIDs
                            trains = trains & Chr(8) & trn.Name
                        Next
                        Message = Message & "|TRAINS" & trains
                    End If

                End If

                Message = CurTrk.TerritoryID.ToString & Chr(12) & Message
                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                End SyncLock

                SyncLock TMDS.GlobalDeclarations.gConfirmationQueue
                    'TMDS.GlobalDeclarations.gConfirmationQueue.Enqueue(Message)
                End SyncLock


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

