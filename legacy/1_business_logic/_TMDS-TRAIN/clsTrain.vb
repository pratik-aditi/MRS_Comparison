                pGeoFenceLegacyEnabled = Value
                Me.TrainEventLog("GeoFenceLegacyEnabled=" & Value.ToString)
            End Set
        End Property

        Public Property GF_MessageUID() As String

            Get
                If Trim(pGF_MessageUID) = "" Then
                    pGF_MessageUID = Format(Now, "HHmmssfff")
                    Me.MiscInfoTwo = pGF_MessageUID
                    UpdateGeoFenceBinding()
                End If
                Return pGF_MessageUID
            End Get
            Set(ByVal Value As String)
                If Value = "" Then
                    pGF_MessageUID = Format(Now, "HHmmssfff")
                    Me.MiscInfoTwo = pGF_MessageUID
                    UpdateGeoFenceBinding()
                Else
                    pGF_MessageUID = Value
                End If
                Me.TrainEventLog("GF_MessageUID=" & Value)
            End Set

        End Property

