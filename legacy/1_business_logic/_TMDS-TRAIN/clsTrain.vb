        ''' <summary>
        ''' Get presence network from db
        ''' </summary>
        ''' <param name="pUnitID"></param>
        Public Function GetRemotePresenceNetwork(ByVal pUnitID As String) As Boolean
            Dim dbComm As OleDbCommand = Nothing
            Dim dbReader As OleDbDataReader = Nothing
            Dim SQL As String = "SELECT IsPresenceOnNetwork FROM tblSystemLocomotives WHERE UID='" & pUnitID & "'"
            Dim PresenceStatus As Boolean = False
            Try
                Using DbConn As New OleDbConnection(gConnectionStringStatic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQL, DbConn)
                    dbReader = dbComm.ExecuteReader
                    While dbReader.Read
                        If Not dbReader.IsDBNull(0) Then
                            If Convert.ToBoolean(dbReader.GetValue(0).ToString) Then
                                PresenceStatus = True
                            End If
                        End If
                    End While
                    dbReader.Close()
                    DbConn.Close()
                    dbReader = Nothing
                    dbComm = Nothing
                End Using
                Return PresenceStatus
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dbReader IsNot Nothing Then dbReader = Nothing
            End Try
            Return False
        End Function

