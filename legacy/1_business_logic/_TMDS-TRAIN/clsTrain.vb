                        Dim cwprsn As New CrewPerson(crw(1))
                        With cwprsn
                            .NameOfPerson = crw(0)
                            .OnDutyTime = crw(2)
                            .HOS = crw(3)
                            .OffDutyTime = crw(4)
                            Boolean.TryParse(crw(5), .NoticeGiven)
