        Public Sub CheckToReleaseGTB()
            Try
                Dim theTGBO As TabularGeneralBulletin = TMDS.SystemUtilities.FetchData.FindTGBOByTrainSymbol(Me.Name, True)
                If IsNothing(theTGBO) Then Exit Sub
                Dim LaunchPt As New Point(100, 100)


                Dim OkToProceed As Boolean
                If theTGBO.TrainSymbolList.Count = 0 AndAlso theTGBO.IssuedTo = Me.Name Then
                    OkToProceed = True
                ElseIf theTGBO.TrainSymbolList.Count > 0 Then
                    Dim trnName As String = theTGBO.TrainSymbolList.Item(theTGBO.TrainSymbolList.Count - 1)
                    If trnName = Me.Name Then
                        OkToProceed = True
                    End If
                End If
                Dim MessageList As New ArrayList
                MessageList.Add("THIS TRAIN (" & Me.Name & ") APPEARS TO BE THE LAST TO USE THIS GTB (" & theTGBO.UID & ")")
                MessageList.Add("WOULD YOU LIKE TO RELEASE THE GTB?")
                If OkToProceed Then
                    Dim ContinuePrompt As Integer = ShowCustomMessageBox(MessageList, "GTB RELEASE CHECK", True, LaunchPt, False, True, Me.myTrack.CurrentDrawingForm, False, Nothing, Nothing, True)
                    If ContinuePrompt = 6 Then
                        Dim frmBulletinHMI As New frmBulletinHMI
                        frmBulletinHMI.theTGBO = theTGBO
                        frmBulletinHMI.LoadForm(theTGBO.TypeOfBulletin, "RELEASE", Nothing, Nothing, theTGBO)
                        frmBulletinHMI.Owner = Me.myTrack.CurrentDrawingForm
                        frmBulletinHMI.StartPosition = FormStartPosition.CenterScreen
                        frmBulletinHMI.ShowDialog()
                        frmBulletinHMI.Dispose()
                        frmBulletinHMI = Nothing
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

