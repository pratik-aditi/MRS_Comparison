#Region "GEO-FENCE BINDING METHODS"

        Public Sub UpdateGeoFenceBinding()
            Dim update As New System.Text.StringBuilder
            Try
                update.Append("UPDATE tblTrainsActive ")
                update.Append(" Set MiscellanousInfoOne  = '" & Me.MiscInfoOne & "',")
                update.Append(" MiscellanousInfoTwo  = '" & Me.MiscInfoTwo & "',")
                update.Append(" ScheduleStatus  = '" & Me.PermissiveMode.ToString.ToUpper & "'")
                update.Append(" WHERE Symbol = " & "'" & Name & "'")
                SystemDatabaseCommandToDynamicTrain("UpdateGeoFenceBinding-TRAINID:UpdateGeoFenceBinding", update.ToString)
                TrainEventLog("UpdateGeoFenceBinding:Update=" & update.ToString)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                update = Nothing
            End Try
        End Sub

        Public Sub UpdateGeoFenceCapable()

            Dim Update As New System.Text.StringBuilder
            Try
                Update.Append("UPDATE tblTrainsActive ")
                Update.Append(" Set CBTCEquipped  = '" & Me.CBTCEquipped & "'")
                Update.Append(" WHERE Symbol = " & "'" & Name & "'")
                SystemDatabaseCommandToDynamicTrain("UpdateGeoFenceCapable-TRAINID:UpdateGeoFenceBinding", Update.ToString)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Do Update GeoFence Status
        ''' </summary>
        ''' <param name="geoFenceEnable">geofence enable</param>
        ''' <param name="initialization">initialization</param>
        Public Sub DoUpdateGeoFenceStatus(geoFenceEnable As Boolean, initialization As Boolean)
            Try
                Dim myStatus As String
                If geoFenceEnable Then
                    myStatus = "ACTIVE"
                    GeoFenceLegacyEnabled = True
                    GeoFenceEnabled = True
                    CBTCEquipped = True
                    MiscInfoOne = GF_BindingLocoUID
                    MiscInfoTwo = GF_MessageUID
                    IsPresenceOnNetwork = True
                    SetPresenceNetwork()
                    TrainEventLog($"{GetCurrentMethod.Name}:Enable={GF_BindingLocoUID}:{GF_MessageUID}")
                Else
                    GeoFenceEnabled = False
                    GeoFenceLegacyEnabled = False
                    GF_BindingLocoUID = String.Empty
                    GF_MessageUID = String.Empty
                    MiscInfoOne = String.Empty
                    MiscInfoTwo = String.Empty
                    myStatus = String.Empty
                End If
                If Not initialization Then
                    UpdateGeoFenceBinding()
                    UpdateGeoFenceCapable()
                    UpdatePTCStatus(myStatus)
                End If
                myTrack.InitTrainDisplay()
                myTrack.InvalidateTrainID()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Do update CBTC status
        ''' </summary>
        ''' <param name="isPtcActived">if train is with onboard actived</param>
        ''' <param name="isInitializing">if train is initializing</param>
        Public Sub DoUpdateCBTCStatus(isPtcActived As Boolean,
                                      isInitializing As Boolean)
            Try
                If isPtcActived = GeoFenceEnabled Then Exit Sub
                TrainEventLog($"{GetCurrentMethod.Name}:WhoCallMe={(New StackTrace).GetFrame(1).GetMethod.Name}")
                Dim myStatus As String
                If isPtcActived Then
                    myStatus = "ACTIVE"
                    GeoFenceEnabled = True
                    CBTCEquipped = True
                    IsPresenceOnNetwork = True
                    SetPresenceNetwork()
                Else
                    GeoFenceEnabled = False
                    GF_BindingLocoUID = String.Empty
                    GF_MessageUID = String.Empty
                    MiscInfoOne = String.Empty
                    MiscInfoTwo = String.Empty
                    myStatus = "INACTIVE"
                    CancelAllLicenseForPTC(True, False)
                    ClickedOnTrainForLicense = False
                End If
                FoundEntryTrackForMRS = False
                If Not isInitializing Then
                    UpdateGeoFenceBinding()
                    UpdateGeoFenceCapable()
                    UpdatePTCStatus(myStatus)
                End If
                If myTrack IsNot Nothing Then
                    myTrack.InitTrainDisplay()
                    myTrack.InvalidateTrainID()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

