                TrainFetch = "SELECT Subdivision FROM tblCompControlPoints "
                TrainFetch = TrainFetch & " WHERE Name = '" & OriginName & "' AND UniqueID = " & OriginNumber
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                dbconn.Open()
                dbcomm = New OleDbCommand(TrainFetch, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    SubdvnNumber = dr.GetInt32(0)
                End While
                dr.Close()
                TrainFetch = "SELECT Name FROM tblSystemSubDivisions WHERE UID = " & SubdvnNumber
                dbcomm = New OleDbCommand(TrainFetch, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    SubName = dr.GetString(0)
                End While
                dr.Close()
                dbconn.Close()
                dbconn = Nothing
                Return SubName

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return Nothing
            End Try
        End Function
    End Class

