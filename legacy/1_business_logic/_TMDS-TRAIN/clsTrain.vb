#Region "ENTER MAIN TRACK & PASS STOP SIGNAL(PRS) "

        ''' <summary>
        ''' Get comp list from signal
        ''' </summary>
        ''' <param name="pEnterSignal"></param>
        ''' <param name="pExitSignal"></param>
        ''' <returns></returns>
        Private Function GetCompListFromSignal(ByVal pEnterSignal As Signal, ByVal pExitSignal As Signal, Optional pExitTrack As Track = Nothing) As ArrayList
            Dim theList As New ArrayList
            Dim sr As SignalRoute
            Dim theRoute As SignalRoute = Nothing
            Dim comp As Object
            Try
                TrainEventLog("GetCompListFromSignal:EnterSignal=" & pEnterSignal.GUID.ToString & ":" & pEnterSignal.Name & ":ExitSignalUID=" & pExitSignal.GUID & ":" & pExitSignal.Name)
                For Each sr In gSignalRouteList
                    If sr.EntrySignal IsNot Nothing AndAlso sr.ExitSignal IsNot Nothing Then
                        If (sr.EntrySignal.GUID = pEnterSignal.GUID And sr.ExitSignal.GUID = pExitSignal.GUID) OrElse
                            (sr.EntrySignal.AutomaticSignal AndAlso sr.EntrySignal.GUID = pEnterSignal.GUID) OrElse
                            (sr.EntrySignal.GUID = pEnterSignal.GUID AndAlso
                            sr.ComponentList.Count > 0 AndAlso
                            sr.ComponentList(sr.ComponentList.Count - 1).GetType.ToString = gSignalComponentName AndAlso
                            pExitTrack IsNot Nothing AndAlso
                            sr.ComponentList.Contains(pExitTrack)) Then 'Special condition when doesnt exist track after exit signal
                            theRoute = sr
                            Exit For
                        End If
                    End If
                Next
                If Not IsNothing(theRoute) Then
                    For Each comp In theRoute.ComponentList
                        Try
                            Select Case comp.GetType.ToString
                                Case gFlipFlopComponentName, gRRXINGComponentName
                                Case Else
                                    If comp.AuthorityType IsNot Nothing AndAlso comp.AuthorityType.ToString.Trim.ToUpper.Contains("CTC") Then
                                        If comp.GUID <> pExitSignal.GUID Then
                                            'RMT662-Special licenses are including entry tracks over license
                                            'Need to remove entry track in PSS licenses
                                            'jcosta-4/25/17
                                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" AndAlso comp.IsControlledForPTC = False Then
                                                TrainEventLog("GetCompListFromSignal:Remove=" & comp.GUID & ":" & comp.Name)
                                                Continue For
                                            End If
                                            theList.Add(comp)
                                            TrainEventLog("GetCompListFromSignal:Add=" & comp.GUID & ":" & comp.Name)
                                        End If
                                    Else
                                        Exit For
                                    End If
                            End Select
                        Catch ex As Exception
                            GetErrorDetails(ex)
                        End Try
                    Next
                    If theRoute.myExitTracks IsNot Nothing AndAlso theRoute.myExitTracks.Count > 0 Then
                        For Each comp In theRoute.myExitTracks
                            Try
                                Select Case comp.GetType.ToString
                                    Case gFlipFlopComponentName, gRRXINGComponentName
                                    Case Else
                                        If comp.AuthorityType IsNot Nothing AndAlso comp.AuthorityType.ToString.Trim.ToUpper.Contains("CTC") Then
                                            If comp.GUID <> pExitSignal.GUID Then
                                                If Not theList.Contains(comp) Then theList.Add(comp)
                                            End If
                                        Else
                                            Exit For
                                        End If
                                End Select
                            Catch ex As Exception
                                GetErrorDetails(ex)
                            End Try
                        Next
                    End If
                End If
                'RMT662-Special licenses are including entry tracks over license
                'Need to remove entry track in PSS licenses
                'jcosta-4/25/17
                If theRoute IsNot Nothing Then
                    If theRoute.EntryTrack.IsControlledForPTC = True Then
                        theList.Insert(0, theRoute.EntryTrack)
                        TrainEventLog("GetCompListFromSignal:EntryTrackAddedUID:" & theRoute.EntryTrack.GUID & ":" & Me.Name)
                    Else
                        TrainEventLog("GetCompListFromSignal:EntryTrackNotAddedUID:" & theRoute.EntryTrack.GUID & ":" & Me.Name)
                    End If
                End If
                Return theList
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                theList = Nothing
                sr = Nothing
                theRoute = Nothing
                comp = Nothing
            End Try
            Return Nothing
        End Function

        ''' <summary>
        ''' Show Dialog To Pass Red Signal MRS
        ''' </summary>
        ''' <param name="pSignal"></param>
        ''' <param name="pEnterTrack"></param>
        ''' <param name="pExitTrack"></param>
        ''' <param name="pRemoteRequest"></param>
        Public Sub ShowDialogToPassRedSignal_MRS(ByVal pSignal As Object, ByVal pEnterTrack As Track, ByVal pExitTrack As Track, ByVal pRemoteRequest As Boolean)
            Dim switchesOnHand As Boolean
            Dim enterTrack As Track = Nothing
            Dim enTrackName As String = ""
            Dim exTrackName As String = ""
            Dim eventMessage As String = String.Empty
            Dim frmReadRepeat As New frmReadRepeat()
            Dim exitSignal As Signal
            Dim enterSignal As Signal = pSignal
            Dim messageList As New ArrayList()
            Dim authorityData As String = String.Empty
            Try
                TrainEventLog("ShowDialogToPassRedSignal_MRS:Start")
                enTrackName = pEnterTrack.TrackNameAlias
                exTrackName = pExitTrack.TrackNameAlias
                frmReadRepeat.theSignal = pSignal
                frmReadRepeat.theTrain = Me
                frmReadRepeat.theTrack = pEnterTrack
                frmReadRepeat.EMT_PRSCompList = gEntExtTrackSelection
                frmReadRepeat.PassRedSignal = True
                frmReadRepeat.EMT_PRSType = "PRS"
                frmReadRepeat.EMT_PRSIssueTo = Me.IdentifingUnit
                frmReadRepeat.EMT_PRSTrainGUID = Me.TrainGUID
                frmReadRepeat.EMT_PRSControlPointName = pSignal.myControlPoint.Name
                enterTrack = gEntryTrack
                exitSignal = FindExitSignal(pSignal, pExitTrack)
                Select Case PSSHandeOperationRequiredNOOption
                    Case 6
                        messageList.Add(optAuthString65 & Space(1) & Mid(Me.IdentifingUnit, 1, 10) & Space(1) & optAuthString66 & Space(1) & pSignal.myControlPoint.Name)
                        messageList.Add(optAuthString67)
                        messageList.Add(optAuthString80)
                        messageList.Add(optAuthString68)
                        messageList.Add(optAuthString69)
                        messageList.Add(optAuthString70 & Space(1) & enTrackName & Space(1) & optAuthString71 & Space(1) & exTrackName)
                        messageList.Add(optAuthString81 & Space(1) & Me.SpecialLicenseSendReason.ToString)
                        switchesOnHand = True
                    Case Else
                        messageList.Add(optAuthString65 & Space(1) & Mid(Me.IdentifingUnit, 1, 10) & Space(1) & optAuthString66 & Space(1) & pSignal.myControlPoint.Name)
                        messageList.Add(optAuthString67)
                        messageList.Add(optAuthString80)
                        messageList.Add(optAuthString69)
                        messageList.Add(optAuthString70 & Space(1) & enTrackName & Space(1) & optAuthString71 & Space(1) & exTrackName)
                        messageList.Add(optAuthString81 & Space(1) & Me.SpecialLicenseSendReason.ToString)
                End Select
                If Me.SpecialLicenseSendReason <> "" Then
                    Me.SpecialLicenseSendReason = String.Empty
                End If
                If Not enterSignal.RequestJointAuthForPSS Then
                    Dim s As String = ""
                    For Each s In messageList
                        eventMessage = eventMessage & s.Trim & vbCrLf
                    Next
                    frmMessageBox.EMT_PRS_PTCVerbiage = messageList
                    PSSHandeOperationRequiredNOOption = 0
                    frmMessageBox.EMT_PRSVerbiage = messageList
                    If optEnableApplyDeviceBlockFirstPRS_EMT Then
                        frmMessageBox.ApplyEMT_PRSDeviceBlock()
                    End If
                End If
                If frmMessageBox.EMT_PRSBlockFeedBack = 6 Then
                    If Not enterSignal.RequestJointAuthForPSS Then
                        Dim PTCStatus As Boolean = False
                        Dim frmMessageBox1 As New frmMessageBox()
                        messageList.Add("DESEJA CONTINUAR?")
                        messageList.Add("")
                        frmMessageBox1.SetMessage_PSS(messageList, optAuthString56, True, Me.myTrack.CurrentDrawingForm.myLaunchPoint, Nothing, False, False, "", Nothing, PTCStatus, "PASS RED SIGNAL")
                        frmMessageBox1.ShowDialog()
                        If frmMessageBox1.FormFeedBack <> 6 Then
                            TrainEventLog("CLICKED - CANCEL PSS AUTHORIZATION")
                            Exit Sub
                        Else
                            TrainEventLog("CLICKED - ISSUE PSS AUTHORIZATION")
                        End If
                        messageList.RemoveAt(messageList.Count - 2)
                        eventMessage = vbCrLf & "DISPATCHER(" & gCurrentUser.Initials & ") SELECTED YES TO : " & vbCrLf & eventMessage
                    End If
                    If enterSignal.JointControlAuthorizationEnabled AndAlso Not enterSignal.RequestJointAuthForPSS Then
                        enterSignal.SendJoinAuthorizationRequest(Me, True)
                        enterSignal.gJointLicenseForTrainTrain = Me
                        Me.RequestJointAuthForPSSEntryTrack = pEnterTrack
                        Me.RequestJointAuthForPSSExitTrack = pExitTrack
                        enterSignal.RequestJointAuthForPSS = True
                        TrainEventLog("ShowDialogToPassRedSignal_MRS:gJointLicenseForTrainTrain:AddTrainID")
                        Exit Sub
                    End If
                    If enterSignal.RequestJointAuthForPSS Then
                        Me.RequestJointAuthForPSSEntryTrack = Nothing
                        Me.RequestJointAuthForPSSExitTrack = Nothing
                        enterSignal.RequestJointAuthForPSS = False
                    End If
                    If Me.IsActivePTC AndAlso (Me.GeoFenceLegacyEnabled OrElse Me.GeoFenceEnabled) Then
                        Dim theCompList As New ArrayList
                        Dim theCompListFromSignal As ArrayList = GetCompListFromSignal(enterSignal, exitSignal, pExitTrack)
                        If theCompListFromSignal.Count = 0 Then
                            TrainEventLog("ShowDialogToPassRedSignal_MRS:theCompListFromSignal is empty")
                            Exit Sub
                        End If
                        Dim comp As Object
                        'For PSS TWE
                        If enterSignal.IsTrackWarrantEnforcementEnabled Then
                            AddComponentsThatIncludeTrainPositionUpToFirstRouteForPSS(pSignal, theCompList)
                            For Each comp In theCompListFromSignal
                                If Not theCompList.Contains(comp) Then
                                    theCompList.Add(comp)
                                End If
                            Next
                        Else
                            CopyArrayCollection(theCompList, theCompListFromSignal)
                        End If
                        If enterSignal IsNot Nothing AndAlso exitSignal IsNot Nothing Then
                            authorityData = enterSignal.Name & "|" & exitSignal.Name
                        End If
                        Dim OtherAuth As New TrackAuthority.OtherSpecialAuthorityType(Me, "PSS", Me.myTrack.myTerritory, theCompList, messageList, pSignal.DefaultTraffic, False, authorityData)
                        If OtherAuth.AddAuthorityToDatabase Then
                            If OtherAuth.AddAuthorityToComponents Then
                                If optEnableAllowSwitchAlignmentWithPassStopSignalInCodeFailure Then
                                    DoSwitchAlignmentForPassStopSignal(theCompListFromSignal)
                                End If
                                'Send track tag list for onboard
                                PtcSendBulletins(theCompList)
                                'Issue special authority
                                OtherAuth.VETMS_PerformIssuance(enterSignal, pEnterTrack, pExitTrack, theCompList)
                                Me.thisRestrictiveLicense = OtherAuth
                                Me.IsSpecialLicense = True
                                Dim SummItem As New SummaryItem("SPLAUTHORITY", "ADD", OtherAuth)
                                SyncLock gSummaryAuthQueue
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock
                                TrainEventLog("ShowDialogToPassRedSignal_MRS:TrainID=" & OtherAuth.myTrain.Name & ":LocoID=" & OtherAuth.IssueTo & ":AuthNumber=" & OtherAuth.AuthorityNumber & ":Limits=" & OtherAuth.PTCAuthoritySegments & ":CompList=" & OtherAuth.sComponentsInSelection)
                                TMDS.NetworkMessages.CadMessages.SendSpecialLicenseEventForWabtecOne(OtherAuth, "CREATE")
                            End If
                        End If
                    Else
                        If optEnableAllowSwitchAlignmentWithPassStopSignalInCodeFailure Then DoSwitchAlignmentForPassStopSignal(gEntExtTrackSelection)
                        Dim AuthGUID As String = InsertIntoDatabaseOtherAuthorityPRS(pSignal, gEntExtTrackSelection, frmReadRepeat.EMT_PRS_PTCVerbiage, Nothing, switchesOnHand, frmReadRepeat.EMT_PRS_AuthorityVerbiage, frmReadRepeat.EMT_PRSBlockGUID, "PSS", frmReadRepeat.EMT_PRSAuthNum)
                        If Not optEnablePSSEMTAuthorityNoDeviceBlk AndAlso AuthGUID.Trim <> "" Then
                            Dim devblk As TMDS.TrackAuthority.DeviceBlock
                            For Each devblk In TMDS.GlobalDeclarations.gDeviceBlocks
                                If devblk.BlockGUID = frmReadRepeat.EMT_PRSBlockGUID Then
                                    Dim BlockData As String
                                    BlockData = "PRS|" & devblk.PTCIssueTo & "|" & devblk.PTCTrainGUID & "|" & devblk.PTCVerbiage & "|" & AuthGUID
                                    devblk.SPLAuthGUID = AuthGUID
                                    devblk.UpdateDeviceBlockPTCBlockDataWithSPLAuthID(BlockData)
                                    Exit For
                                End If
                            Next
                        End If
                    End If
                Else
                    eventMessage = vbCrLf & "DISPATCHER(" & gCurrentUser.Initials & ") SELECTED NO TO : " & vbCrLf & eventMessage
                End If
                TrainEventLog("ShowDialogToPassRedSignal_MRS:" & eventMessage)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                switchesOnHand = Nothing
                enterTrack = Nothing
                enTrackName = Nothing
                exTrackName = Nothing
                eventMessage = Nothing
                exitSignal = Nothing
                enterSignal = Nothing
                messageList = Nothing
                frmReadRepeat.Close()
                If Not frmReadRepeat.IsDisposed Then frmReadRepeat.Dispose()
                frmReadRepeat = Nothing
                authorityData = Nothing
                ClearSystemVariables()
            End Try
        End Sub

        Private Sub DoSwitchAlignmentForPassStopSignal(theList As ArrayList)
            Try
                Dim comp As Object
                For Each comp In theList
                    If comp.GetType.ToString = gSwitchComponentName Then
                        Dim sw As Switch = CType(comp, Switch)
                        If Not sw.ControlledReverse AndAlso theList.Contains(sw.ReverseTrackTrailingPortion) Then
                            sw.IsSwitch(TMDS.GlobalDeclarations.gDatabaseConnectionStatic, True, Nothing)
                        ElseIf sw.ControlledReverse AndAlso theList.Contains(sw.NormalTrackTrailingPortion) Then
                            sw.IsSwitch(TMDS.GlobalDeclarations.gDatabaseConnectionStatic, True, Nothing)
                        End If

                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

