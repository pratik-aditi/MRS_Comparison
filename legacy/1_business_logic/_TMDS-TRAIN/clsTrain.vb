        ''' <summary>
        ''' Cancel all stored routes
        ''' </summary>
        Public Sub DoCancelAllStoredRoutes()
            Try
                TrainEventLog(GetCurrentMethod.Name)
                StoredRouteCancellationInProgress = True
                Dim routeRemoveList As New ArrayList
                For Each controlPoint As ControlPoint In gControlPointCollection
                    Dim tempList As ArrayList = controlPoint.StoredRoutes.Clone
                    For Each storedRoute As StoredRoute In tempList
                        If Not String.IsNullOrWhiteSpace(storedRoute.TrainSymbolAssociation) AndAlso
                            storedRoute.TrainSymbolAssociation.Equals(Name) Then
                            For Each taticalRoute As TacticalRoute In myTacticalRoutes
                                If taticalRoute.mySignalRoute.EntrySignal.GUID = storedRoute.EntrySignal.GUID Then
                                    routeRemoveList.Add(taticalRoute)
                                End If
                            Next
                            NetworkMessages.CadMessages.SendStoredRouteEventForWabtecOne(storedRoute, "CANCELLED")
                            storedRoute.RemoveMe(GetCurrentMethod.Name)
                        End If
                    Next
                Next
                myStoredRoutes.Clear()
                For Each taticalRoute As TacticalRoute In routeRemoveList
                    If taticalRoute IsNot Nothing Then
                        taticalRoute.RemoveRoute()
                        myTacticalRoutes.Remove(taticalRoute)
                    End If
                Next
                SLFAEnabled = False
                SLFATrackList.Clear()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                StoredRouteCancellationInProgress = False
            End Try
        End Sub

