        Private Function CheckForOsTrackOccuppancyBeforeRelease(ByVal theTrack As Track) As Boolean
            Try
                If Not theTrack.OStype Then Return True
                If Me.myTacticalRoutes.Count = 0 Then Return True
                Dim tr As TacticalRoute
                For Each tr In Me.myTacticalRoutes
                    If tr.mySignalRoute.ComponentList.Contains(theTrack) Then
                        Dim comp As Object
                        For Each comp In tr.mySignalRoute.ComponentList
                            If comp.GetType.ToString = gTrackComponentName Then
                                Dim t As Track = CType(comp, Track)
                                If t.OStype AndAlso Not theTrack.OsComponentCollection.Contains(t) AndAlso t.Occuppied AndAlso Not t.EnableControlledSiding Then
                                    Return False
                                End If
                            End If
                        Next
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function
