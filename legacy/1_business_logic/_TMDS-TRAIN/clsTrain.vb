        Public Function GetTAGReportDataString(ByVal Tag As Tag) As String
            Try
                Dim data As New System.Text.StringBuilder
                Dim EventTimePerTimeZone As Date = Now

                Select Case Mid(Me.myTrack.TimeZone, 1, 1)
                    Case "E"
                        EventTimePerTimeZone = Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor))
                    Case "M"
                        EventTimePerTimeZone = Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor))
                    Case "P"
                        EventTimePerTimeZone = Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor))
                    Case Else
                        EventTimePerTimeZone = Now.AddHours(CDbl(gThisWorkstationTimeFactor))
                End Select



                data.Append(Name & "|")
                data.Append(EventTimePerTimeZone.ToString & "|")
                data.Append(Tag.TerritoryID & "|")
                data.Append(Tag.TrackGuid & "|")
                data.Append(Tag.TagGuid & "|")
                data.Append(Tag.TagType & "|")
                data.Append(Tag.CreateTime & "|")
                data.Append(Tag.DataString & "|")
                data.Append(Tag.Restriction & "|")
                data.Append(Tag.Direction & "|")
                data.Append(Tag.TrackGuid & "|")
                Return data.ToString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return "NONE"
            End Try
        End Function

