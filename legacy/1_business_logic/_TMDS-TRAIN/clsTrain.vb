                        Dim OSType As String = ""
                        Dim TrackGUID As Integer = 0
                        Dim OSStationName As String = ""
                        If OsMessage.GetUpperBound(0) > 3 Then
                            Date.TryParse(OsMessage(1), OSTime)
                            OSStationName = OsMessage(2)
                            OSType = OsMessage(3)

                            Integer.TryParse(OsMessage(4), TrackGUID)
                            myOsTrack = Nothing
                            Dim OSDate As Date = OSTime.ToShortDateString
                            If TrackGUID > 0 Then
                                myOsTrack = FindCompFromGUID(TrackGUID)
                            End If
                            Dim ProcessCompleted As Boolean = False
                            PS = TMDS.SystemUtilities.FetchData.FetchPassengerStations(OSStationName)
                            If PS IsNot Nothing Then
                                For Each TrainSch In Me.myScheduleList

                                    Dim IsSCHOfRightType As Boolean = False
                                    If OSType.Trim.ToUpper = "ON STATION" AndAlso TrainSch.myCategory.Trim.ToUpper = "ARRIVAL" Then
                                        IsSCHOfRightType = True
                                    ElseIf OSType.Trim.ToUpper = "OFF STATION" AndAlso TrainSch.myCategory.Trim.ToUpper = "DEPARTURE" Then
                                        IsSCHOfRightType = True
                                    End If

                                    If IsSCHOfRightType AndAlso Not TrainSch.myScheduleProcessed AndAlso TrainSch.myStationUID.Trim.ToUpper = OSStationName.Trim.ToUpper Then 'OSStationName
                                        Dim strTimeIn As String = ""
                                        Select Case TrainSch.myCategory.Trim.ToUpper
                                            Case "ARRIVAL"
                                                strTimeIn = TrainSch.myStationArrivalTime.ToString
                                            Case Else
                                                strTimeIn = TrainSch.myStationDepartureTime.ToString
                                        End Select

                                        If Date.TryParse(strTimeIn, myTimeIn) AndAlso TrainSch IsNot Nothing AndAlso IsValidDate(strTimeIn) Then
                                            Dim tmSpan As TimeSpan
                                            tmSpan = OSTime.Subtract(myTimeIn)
                                            DelayData = TrnSchGUID & "|" & Me.Name & "|" & OSStationName & "|" & myTimeIn.ToString & "|" & OSTime.ToString & "|"
                                            If OSType.Trim.ToUpper = "ON STATION" Then
                                                DelayComments = "SCHEDULED TIME IN:" & myTimeIn.ToString & " - OSTIME: " & OSTime.ToString
                                            Else
                                                DelayComments = "SCHEDULED TIME OUT:" & myTimeIn.ToString & " - OSTIME: " & OSTime.ToString
                                            End If

                                            DelayMins = tmSpan.TotalMinutes
                                            If myOsTrack IsNot Nothing Then
                                                StationCPGUID = myOsTrack.myControlPoint.GUID.ToString
                                            End If

                                            TrainSch.myScheduleProcessedTimeStamp = CurrentDateTime
                                            TrainSch.myScheduleProcessed = True
                                            Select Case TrainSch.myCategory.Trim.ToUpper
                                                Case "ARRIVAL"
                                                    TrainSch.myStationActualArrivalTime = OSTime
                                                Case Else
                                                    TrainSch.myStationActualDepartureTime = OSTime
                                            End Select
                                            If tmSpan.TotalMinutes >= (System.Math.Abs(gDelayTolerance) - 0.1) Then
                                                TrainSch.myScheduleStatus = "LATE"
                                                TrainSch.myScheduleMinutesLate = DelayMins ' tmSpan.TotalMinutes
                                                DelayData = DelayData & DelayMins 'System.Math.Abs(tmSpan.TotalMinutes)
                                                Me.Schedule_LastDelayEvent = "DELAYED BY " & DelayMins & "(MINS)(" & TrainSch.myStationName & ") - " & DelayComments
                                                'Me.AddTrainDelayTAGEvent(CurrentDateTime, StationCPGUID, subStat.Name, subStat.MilePost, "", DelayCODE, DelayComments, System.Math.Abs(DelayMins).ToString, optRailRoadName, DelayData, True)
                                                Me.AddScheduleDelay(CurrentDateTime, OSStationName, OSStationName, PS.MilePost, "", DelayCODE, DelayComments, System.Math.Abs(DelayMins).ToString, optRailRoadName, DelayData, True, TrainSch.myStationName.Trim.ToUpper)
                                                TrainEventLog("Train Schedule :" & Me.Name & ":" & TrainSch.myStationName & " UID: " & TrainSch.myUID & " OS TIME - " & OSTime.ToString & " SCHEDULE TIME:" & myTimeIn.ToString)
                                            Else
                                                TrainSch.myScheduleStatus = "EARLY"
                                                TrainSch.myScheduleMinutesLate = tmSpan.TotalMinutes
                                                TrainEventLog("Train Schedule :" & Me.Name & ":" & TrainSch.myStationName & " UID: " & TrainSch.myUID & " OS TIME - " & OSTime.ToString & " SCHEDULE TIME:" & myTimeIn.ToString)
                                            End If
                                            Me.myScheduleDeviation = tmSpan.TotalMinutes
                                            Me.myScheduleDeviationStation = OSStationName.Trim.ToUpper
                                            If optShowTrainScheduleColor AndAlso Not IsNothing(Me.myTrack) Then
                                                Me.myTrack.InitTrainDisplay()
                                                Dim SummItem As New SummaryItem("TRAIN", "FORCE-REFRESH", Me)
                                                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                                                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                                                End SyncLock
                                            End If
                                            Exit For
                                        End If
                                    End If
                                Next
                            End If
                        End If
                    Next
                End If
                If gDebug Then
                    For Each TrainSch In Me.myScheduleList
                        TrainEventLog("TRAIN SCHEDULE::: " & TrainSch.myStationName & " UID: " & TrainSch.myUID & " ScheduleStatus Processed- " & TrainSch.myScheduleProcessed.ToString & " ScheduleStatus Processed tIME- " & TrainSch.myScheduleProcessedTimeStamp.ToString)
                    Next
                    TrainEventLog(vbCrLf)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                TrainSch = Nothing

                myOsTrack = Nothing
            End Try
        End Sub

        Private Sub UpdateTrainSchedules_PsgrInitialLoadOS()
            Dim TrainSch As TrainSchedule = Nothing
            Dim ScheduleUID As String = ""
            Dim strRptData As String = ""

            Dim Delay As Integer = 0

            Dim dtSCH As New DataTable
            Dim str As String = ""
            Dim MyStatlst As New ArrayList
            Try
                If Me.myScheduleList Is Nothing Then Exit Sub
                If Me.myScheduleList.Count = 0 Then Exit Sub
                Dim te As TrainMoveEvents
                Dim TEeventsLst As New ArrayList
                TEeventsLst = GetTrainMovementsForSchedule()
                TEeventsLst.Reverse()
                If TEeventsLst IsNot Nothing AndAlso TEeventsLst.Count > 0 Then

                    For Each te In TEeventsLst
                        Dim PS As PassengerStation = Nothing
                        Dim OSTime As Date = te.Eventdate
                        Dim TrackGUID As Integer = te.EventTrack
                        Dim myOsTrack As Track = Nothing
                        Dim OSDate As Date = OSTime.ToShortDateString
                        MyStatlst = New ArrayList
                        If TrackGUID > 0 Then
                            myOsTrack = FindCompFromGUID(TrackGUID)
                        End If
                        If myOsTrack IsNot Nothing Then
                            PS = TMDS.SystemUtilities.FetchData.FetchPassengerStations(te.EventCPName)
                        End If

                        Dim ProcessCompleted As Boolean = False
                        For Each TrainSch In Me.myScheduleList
                            Dim IsSCHOfRightType As Boolean = False
                            If te.EventType.Trim.ToUpper = "ON STATION" AndAlso TrainSch.myCategory.Trim.ToUpper = "ARRIVAL" Then
                                IsSCHOfRightType = True
                            ElseIf te.EventType.Trim.ToUpper = "OFF STATION" AndAlso TrainSch.myCategory.Trim.ToUpper = "DEPARTURE" Then
                                IsSCHOfRightType = True
                            End If
                            If IsSCHOfRightType AndAlso Not TrainSch.myScheduleProcessed AndAlso TrainSch.myStationUID.Trim.ToUpper = PS.ReportingUID.Trim.ToUpper Then
                                Dim myTimeIn As Date
                                Select Case TrainSch.myCategory.Trim.ToUpper
                                    Case "ARRIVAL"
                                        myTimeIn = TrainSch.myStationArrivalTime
                                        TrainSch.myStationActualArrivalTime = OSTime
                                    Case Else
                                        myTimeIn = TrainSch.myStationDepartureTime
                                        TrainSch.myStationActualDepartureTime = OSTime
                                End Select
                                If Date.TryParse(myTimeIn, Nothing) AndAlso ValidateDate(myTimeIn) Then
                                    Dim tmSpan As TimeSpan
                                    tmSpan = OSTime.Subtract(myTimeIn)
                                    Me.myScheduleDeviation = tmSpan.TotalMinutes
                                    Me.myScheduleDeviationStation = PS.ReportingUID.Trim.ToUpper
                                    If tmSpan.TotalMinutes >= (System.Math.Abs(gDelayTolerance) - 0.1) Then
                                        TrainSch.myScheduleProcessed = True
                                        TrainSch.myScheduleStatus = "LATE"
                                        TrainSch.myScheduleMinutesLate = tmSpan.TotalMinutes
                                        TrainSch.myScheduleProcessedTimeStamp = myTimeIn
                                        ProcessCompleted = True
                                        Exit For
                                    Else
                                        TrainSch.myScheduleProcessed = True
                                        TrainSch.myScheduleStatus = "EARLY"
                                        TrainSch.myScheduleMinutesLate = tmSpan.TotalMinutes
                                        TrainSch.myScheduleProcessedTimeStamp = myTimeIn
                                        ProcessCompleted = True
                                        Exit For
                                    End If
                                End If
                            End If
                        Next

                    Next

                End If
                If optShowTrainScheduleColor AndAlso Not IsNothing(Me.myTrack) Then
                    Me.myTrack.InitTrainDisplay()
                    Dim SummItem As New SummaryItem("TRAIN", "FORCE-REFRESH", Me)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                    End SyncLock
                    Me.myTrack.Refresh()
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
            End Try
        End Sub

