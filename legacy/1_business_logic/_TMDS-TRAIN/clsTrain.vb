        ''' <summary>
        ''' Get all locomotive consist string
        ''' </summary>
        ''' <returns></returns>
        Private Function GetAllLocomotiveConsistString() As String
            Dim consist As New StringBuilder
            Dim unit As TrainUnit
            Try
                For Each unit In Me.UnitsInTrain
                    If consist.Length <> 0 Then
                        consist.Append(";")
                    End If
                    consist.Append(unit.UnitNumber)
                    consist.Append("|")
                    consist.Append(unit.TotalHP)
                    consist.Append("|")
                    consist.Append(unit.EffectiveHP)
                    consist.Append("|")
                    consist.Append(unit.Status)
                    consist.Append("|")
                    consist.Append(unit.Direction)
                    consist.Append("|")
                    consist.Append(unit.UnitPosition)
                Next
                Return consist.ToString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty
            Finally
                consist = Nothing
                unit = Nothing
            End Try
        End Function

