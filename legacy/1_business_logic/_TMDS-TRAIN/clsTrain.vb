        Public Function GetSubNameFromOrigin() As String
            Dim dbconn As OleDbConnection
            Try
                Dim OriginName As String = String.Empty
                Dim OriginNumber As Integer
                Dim TrainFetch As String
                Dim SubName As String = String.Empty
                Dim dr As OleDbDataReader
                Dim dbcomm As OleDbCommand
                Dim SubdvnNumber As Int32
                Dim data() As String = Me.Origin.Split("(")
                If data.Length > 1 Then
                    OriginName = Trim(data(0))
                    Dim sNumber As String = data(1).Replace(")", "")
                    If IsNumeric(sNumber) Then
