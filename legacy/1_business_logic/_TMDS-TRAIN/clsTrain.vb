        Public Function IsSignalCleared() As Boolean
            Try
                'If Not Me.IsActivePTC Then Return False
                Dim SignalToCheck As Signal = Nothing
                Select Case Me.Direction
                    Case optDirectionEast, optDirectionNorth
                        SignalToCheck = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.myTrack.RightLink)
                    Case optDirectionSouth, optDirectionWest
                        SignalToCheck = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.myTrack.LeftLink)
                End Select
                If Not IsNothing(SignalToCheck) Then
                    If SignalToCheck.SignalIndStatus = Signal.IndStatus.Cleared Then
                        gPermissionToRemoveStopTargetSignal = SignalToCheck
                        Return True
                    ElseIf gSimulationMode AndAlso SignalToCheck.SignalStatus = Signal.BulbStatus.ClearStatus Then
                        gPermissionToRemoveStopTargetSignal = SignalToCheck
                        Return True
                    End If
                End If
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

