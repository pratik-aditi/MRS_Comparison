        Public Function GetUnitsInTrainSortedString() As String
            Dim tu As TrainUnit = Nothing
            Dim extUnits As ArrayList = Me.UnitsInTrain.Clone
            Dim trnUnitDt As DataTable
            Dim Tempdrow As DataRow
            Dim strUnitString As String = ""
            Try
                If extUnits IsNot Nothing Then
                    trnUnitDt = DefineTrainUnitDatatable()
                    For Each tu In extUnits
                        If tu IsNot Nothing AndAlso tu.UnitNumber.Trim.ToUpper <> Me.IdentifingUnit.Trim.ToUpper Then
                            Tempdrow = trnUnitDt.NewRow
                            Tempdrow("UnitID") = tu.UnitNumber
                            Tempdrow("Position") = tu.UnitPosition
                            trnUnitDt.Rows.Add(Tempdrow)
                            trnUnitDt.AcceptChanges()
                        End If
                    Next
                    If trnUnitDt IsNot Nothing AndAlso trnUnitDt.Rows.Count > 0 Then
                        Dim dv As DataView = New DataView(trnUnitDt)
                        dv.Sort = "Position"
                        If dv.Count > 0 Then
                            For i As Integer = 0 To dv.Count - 1
                                If strUnitString.Trim = "" Then
                                    strUnitString = dv(i)("UnitID")
                                Else
                                    strUnitString = strUnitString & ", " & dv(i)("UnitID")
                                End If
                            Next
                        End If
                    End If
                    Return strUnitString
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return String.Empty
        End Function
