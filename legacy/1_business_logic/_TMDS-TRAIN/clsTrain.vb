                Dim DelayTime As Integer = System.Math.Abs(DelayMinutes)
                Dim theReportTime As Date = ReportTime
                Dim IdentifingPointName As String = Me.myTrack.myControlPoint.Name
                Dim IdentifyingPointUID As String = Me.myTrack.myControlPoint.GUID

                Dim td As New TrainDelay
                td.DelayUID = Guid.NewGuid.ToString.ToUpper
                td.TrainSheetUID = Me.ActiveTrainSheetGUID
                td.IdentifyingPointUID = IdentifyingPointUID
                td.IdentifyingPointName = IdentifingPointName
                td.EventTimeStamp = theReportTime
                td.EventTimeZone = Mid(Me.myTrack.TimeZone, 1, 1)
                td.EventMilePost = DelayMP
                td.EventTrackName = Me.myTrack.TrackName
                td.EventDelayCode = DelayCode
                td.EventComments = DelayDesc
                td.EventDelayAmount = DelayTime
                td.RailroadUID = "NONE"
                td.ReportData = Me.GetTrainReportDataString(DelayCode, DelayTime)
                td.myTrain = Me
                td.myReportingPerson = gCurrentUser.FirstName & ", " & gCurrentUser.LastName
                td.myDelayEventType = DEventType
                ' td.myDelaySubEventType = "" ' GetIncidentDelayCode(cmbTypeOfReport.Text)
                Dim RRUniqueName As String = Me.GetStationUniqueName(IdentifingPointName)

                If RRUniqueName IsNot Nothing AndAlso Not String.IsNullOrEmpty(RRUniqueName) AndAlso RRUniqueName.Trim <> "" Then
                    td.myScheduleStationIndex = Me.GetStationIndex(RRUniqueName)
                Else
                    td.myScheduleStationIndex = Me.GetStationIndex(IdentifingPointName)
                End If
                'td.myScheduleStationIndex = thisTrain.GetStationIndex(RRUniqueName)

                td.myScheduleStationUID = Me.GetStationUniqueName(IdentifingPointName)
                td.myDeviceName = td.GetDeviceNameString(Me.myTrack)
                td.AddDelayToDatabase()


                Return td.DelayUID
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function
