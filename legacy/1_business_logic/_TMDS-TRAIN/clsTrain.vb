        Friend Function GetSystemLocomotiveFromDB(ByVal UnitNumber As String) As WorkTask.clsEngineSet
            Dim SQLQuery As New StringBuilder
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing

            Try
                'SQLQuery = New StringBuilder("Select * From tblSystemLocomotives Where UID = '" & UnitNumber & "'")
                SQLQuery = New StringBuilder
                With SQLQuery
                    .Append("SELECT ")
                    .Append("[UID], TypeOfLocomotive, Direction, HorsePower, EffectiveHP, UnitCondition, UnitPosition, [Length], [Weight], DPSequenceNumber, ")
                    .Append("Isolated, DPCapable, DPEnabled, TwoWayETD, GPSEquipped, CurrentOrigin, CurrentDestination, UnitBehindCarNumber, [Status]")
                    .Append(" FROM tblSystemLocomotives  ")
                    .Append(" Where UID = '" & UnitNumber & "'")
                End With

                Using DbConn As New OleDbConnection(gConnectionStringStatic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery.ToString, DbConn)
                    dr = dbComm.ExecuteReader
                    If dr.HasRows Then
                        Dim clsEng As New WorkTask.clsEngineSet
                        While dr.Read
                            With clsEng
                                If Not dr.IsDBNull(0) Then .UnitID = dr.GetValue(0)
                                If Not dr.IsDBNull(1) Then .LocoType = dr.GetValue(1)
                                If Not dr.IsDBNull(2) Then .Direction = dr.GetValue(2)
                                If Not dr.IsDBNull(3) Then .HPtotal = dr.GetValue(3)
                                If Not dr.IsDBNull(4) Then .HPEffective = dr.GetValue(4)
                                If Not dr.IsDBNull(5) Then .UnitCond = dr.GetValue(5)
                                If Not dr.IsDBNull(6) Then .UnitPosition = dr.GetValue(6)
                                If Not dr.IsDBNull(7) Then .Length = dr.GetValue(7)
                                If Not dr.IsDBNull(8) Then .Weight = dr.GetValue(8)
                                If Not dr.IsDBNull(9) Then .DPSequenceNumber = dr.GetValue(9)
                                If Not dr.IsDBNull(10) Then Boolean.TryParse(dr.GetValue(10), .UnitIsol)
                                If Not dr.IsDBNull(11) Then Boolean.TryParse(dr.GetValue(11), .UnitDPCapable)
                                If Not dr.IsDBNull(12) Then Boolean.TryParse(dr.GetValue(12), .UnitDPEnabled)
                                If Not dr.IsDBNull(13) Then Boolean.TryParse(dr.GetValue(13), .ETDTW)
                                If Not dr.IsDBNull(13) Then Boolean.TryParse(dr.GetValue(14), .GPS)
                                If Not dr.IsDBNull(14) Then .FullOriginStation = dr.GetValue(15)
                                If Not dr.IsDBNull(15) Then .FullDestStation = dr.GetValue(16)
                                If Not dr.IsDBNull(16) Then .UnitBehindCarNumber = dr.GetValue(17)
                                If Not dr.IsDBNull(17) Then .Status = dr.GetValue(18)
                            End With
                        End While
                        Return clsEng
                    End If




                    dr.Close()
                    DbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex, "SQL QUERY>>>" & SQLQuery.ToString)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return Nothing
        End Function

        Friend Sub GetMyTrainMISInfo(MessageUID As Integer, ByRef MessageVersion As Integer, ByRef MessageEdition As Integer, ByRef GroupIndex As Integer, ByRef GroupCount As Integer)
            Try
                MessageVersion = 1
                MessageEdition = 1
                GroupIndex = 1
                GroupCount = 1
                If MessageUID = 0 Then Exit Sub
                If String.IsNullOrEmpty(Me.myMISInformation) OrElse Me.myMISInformation.Trim = "" Then Exit Sub
                Dim myMISInfoSplit() As String = Me.myMISInformation.Split(Chr(1))
                Dim Data() As String
                Select Case MessageUID
                    Case 3000
                        If myMISInfoSplit.Length >= 0 Then
                            Data = myMISInfoSplit(0).Split("|")
                            If Data.GetUpperBound(0) >= 0 Then Integer.TryParse(Data(0), MessageVersion)
                            If Data.GetUpperBound(0) >= 1 Then Integer.TryParse(Data(1), MessageEdition)
                            If Data.GetUpperBound(0) >= 2 Then Integer.TryParse(Data(2), GroupIndex)
                            If Data.GetUpperBound(0) >= 3 Then Integer.TryParse(Data(3), GroupCount)
                        End If
                    Case 3100
                        If myMISInfoSplit.Length >= 1 Then
                            Data = myMISInfoSplit(1).Split("|")
                            If Data.GetUpperBound(0) >= 0 Then Integer.TryParse(Data(0), MessageVersion)
                            If Data.GetUpperBound(0) >= 1 Then Integer.TryParse(Data(1), MessageEdition)
                            If Data.GetUpperBound(0) >= 2 Then Integer.TryParse(Data(2), GroupIndex)
                            If Data.GetUpperBound(0) >= 3 Then Integer.TryParse(Data(3), GroupCount)
                        End If
                    Case 3130
                        If myMISInfoSplit.Length >= 2 Then
                            Data = myMISInfoSplit(2).Split("|")
                            If Data.GetUpperBound(0) >= 0 Then Integer.TryParse(Data(0), MessageVersion)
                            If Data.GetUpperBound(0) >= 1 Then Integer.TryParse(Data(1), MessageEdition)
                            If Data.GetUpperBound(0) >= 2 Then Integer.TryParse(Data(2), GroupIndex)
                            If Data.GetUpperBound(0) >= 3 Then Integer.TryParse(Data(3), GroupCount)
                        End If
                End Select
            Catch ex As Exception
                GetErrorDetails(ex, "GetMyTrainMISInfo")
            End Try
        End Sub

        Friend Sub UpdateMyTrainMISInfo(MessageUID As Integer, ByVal myMessageVersion As Integer, ByVal myMessageEdition As Integer, ByVal myGroupIndex As Integer, ByVal myGroupCount As Integer)
            Try
                Dim MessageVersion3000 As Integer = 1
                Dim MessageEdition3000 As Integer = 1
                Dim GroupIndex3000 As Integer = 1
                Dim GroupCount3000 As Integer = 1

                Dim MessageVersion3100 As Integer = 1
                Dim MessageEdition3100 As Integer = 1
                Dim GroupIndex3100 As Integer = 1
                Dim GroupCount3100 As Integer = 1

                Dim MessageVersion3130 As Integer = 1
                Dim MessageEdition3130 As Integer = 1
                Dim GroupIndex3130 As Integer = 1
                Dim GroupCount3130 As Integer = 1

                Dim Msg3000 As String = "" ' 
                Dim Msg3100 As String = ""
                Dim Msg3130 As String = ""
                If MessageUID = 0 Then Exit Sub

                GetMyTrainMISInfo(3000, MessageVersion3000, MessageEdition3000, GroupIndex3000, GroupCount3000)
                GetMyTrainMISInfo(3100, MessageVersion3100, MessageEdition3100, GroupIndex3100, GroupCount3100)
                GetMyTrainMISInfo(3130, MessageVersion3130, MessageEdition3130, GroupIndex3130, GroupCount3130)

                Select Case MessageUID
                    Case 3000
                        MessageVersion3000 = myMessageVersion
                        MessageEdition3000 = myMessageEdition
                        GroupIndex3000 = myGroupIndex
                        GroupCount3000 = myGroupCount
                    Case 3100
                        MessageVersion3100 = myMessageVersion
                        MessageEdition3100 = myMessageEdition
                        GroupIndex3100 = myGroupIndex
                        GroupCount3100 = myGroupCount
                    Case 3130
                        MessageVersion3130 = myMessageVersion
                        MessageEdition3130 = myMessageEdition
                        GroupIndex3130 = myGroupIndex
                        GroupCount3130 = myGroupCount
                End Select

                Msg3000 = MessageVersion3000 & "|" & MessageEdition3000 & "|" & GroupIndex3000 & "|" & GroupCount3000
                Msg3100 = MessageVersion3100 & "|" & MessageEdition3100 & "|" & GroupIndex3100 & "|" & GroupCount3100
                Msg3130 = MessageVersion3130 & "|" & MessageEdition3130 & "|" & GroupIndex3130 & "|" & GroupCount3130

                Me.myMISInformation = Msg3000.Trim & Chr(1) & Msg3100 & Chr(1) & Msg3130
                Me.UpdateTrainMISInformationIntoDatabase()

            Catch ex As Exception
                GetErrorDetails(ex, "UpdateMyTrainMISInfo")
            End Try
        End Sub

