#Region " PROCESS PTC AUTHORITY ON RELOAD "

        Private Sub ProcessResend(ByVal SFACollection As ArrayList, ByVal TNTCollection As ArrayList)
            Dim SFA As TMDS.TrackAuthority.SFAuthority = Nothing
            Dim TNT As TMDS.TrackAuthority.TrackAuthority = Nothing
            Dim VoidList As New ArrayList
            Dim HasNewLeadEngine As Boolean = False
            Dim ReportClearList As New ArrayList
            Dim RollupList As New ArrayList
            Dim tempArray As New ArrayList
            If Me.PendingLeadEngine.Trim <> "" Then HasNewLeadEngine = True

            Try
                '********* SFA ***********************

                If SFACollection IsNot Nothing AndAlso SFACollection.Count > 0 Then
                    For Each SFA In SFACollection
                        VoidList = New ArrayList
                        If optDisableFlashingTrackForPTC Then SFA.FlasherMode(False, True)
                        Select Case SFA.PTCAuthorityACKPending.ToString.ToUpper.Trim
                            Case PTCAuthorityACKPendingStatus.ISSUE.ToString.ToUpper.Trim
                                If Not SFA.Box1Void Is Nothing AndAlso SFA.Box1Void.Count > 0 Then
                                    Dim BoxOne As String
                                    For Each BoxOne In SFA.Box1Void
                                        Dim VoidSFA As TMDS.TrackAuthority.SFAuthority
                                        VoidSFA = TMDS.SystemUtilities.FetchData.FindSFA(BoxOne)
                                        If Not VoidSFA Is Nothing Then
                                            VoidList.Add(VoidSFA)
                                        End If
                                    Next
                                End If
                                SFA.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ISSUE.ToString
                                SFA.PTCAuthorityComponents = SFA.Components.Clone
                                SFA.UpdateDatabaseWithPTCComponents()
                                If Not optDisableFlashingTrackForPTC Then SFA.FlasherMode(True, True)
                                Dim ProcessAuthIssueMessage As New DoProcessSFAAuthorityIssue(AddressOf PerformPTCSFAIssue)
                                ProcessAuthIssueMessage.BeginInvoke(SFA, Me, VoidList, HasNewLeadEngine, False, Nothing, Nothing)

                            Case PTCAuthorityACKPendingStatus.ROLLUP.ToString.ToUpper.Trim
                                If Not RollupList.Contains(SFA) Then RollupList.Add(SFA)
                            Case PTCAuthorityACKPendingStatus.RELEASE.ToString.ToUpper.Trim
                                If Not ReportClearList.Contains(SFA) Then ReportClearList.Add(SFA)
                            Case "NONE"
                                'Authority has been Delivered sucessfully but void failed.
                                If Not SFA.Box1Void Is Nothing AndAlso SFA.Box1Void.Count > 0 Then
                                    Dim BoxOne As String
                                    For Each BoxOne In SFA.Box1Void
                                        Dim VoidSFA As TMDS.TrackAuthority.SFAuthority
                                        VoidSFA = TMDS.SystemUtilities.FetchData.FindSFA(BoxOne)
                                        If Not VoidSFA Is Nothing Then
                                            VoidList.Add(VoidSFA)
                                        End If
                                    Next
                                    If Not optDisableFlashingTrackForPTC Then SFA.FlasherMode(True, True)
                                    Dim ProcessAuthIssueMessage As New DoProcessSFAAuthorityIssue(AddressOf PerformPTCSFAIssue)
                                    ProcessAuthIssueMessage.BeginInvoke(SFA, Me, VoidList, HasNewLeadEngine, True, Nothing, Nothing)
                                End If
                        End Select
                    Next
                End If
                If ReportClearList IsNot Nothing AndAlso ReportClearList.Count > 0 Then
                    Try
                        tempArray = New ArrayList
                        tempArray = TMDS.SystemUtilities.FetchData.GetSortedSFAAuthorityList(ReportClearList)
                        If tempArray IsNot Nothing AndAlso tempArray.Count > 0 Then
                            Dim ProcessAuthReleaseMessage As New DoProcessMultipleAuthorityRelease(AddressOf PerformPTCMultipleAuthorityRelease)
                            ProcessAuthReleaseMessage.BeginInvoke(tempArray, Me, Nothing, Nothing)
                        Else
                            Dim ProcessAuthReleaseMessage As New DoProcessMultipleAuthorityRelease(AddressOf PerformPTCMultipleAuthorityRelease)
                            ProcessAuthReleaseMessage.BeginInvoke(ReportClearList, Me, Nothing, Nothing)
                        End If
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    End Try
                End If
                tempArray = New ArrayList

                If RollupList IsNot Nothing AndAlso RollupList.Count > 0 Then
                    For Each SFA In RollupList
                        Try
                            Dim ProcessMultipleAuthRollUPMessage As New DoProcessMultipleAuthorityRollUp(AddressOf PerformPTCMultipleAuthorityReleaseRollUp)
                            ProcessMultipleAuthRollUPMessage.BeginInvoke(SFA, tempArray, Me, Nothing, Nothing)
                        Catch ex As Exception
                            GetErrorDetails(ex)
                        End Try
                    Next
                End If


            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                SFA = Nothing
                TNT = Nothing
            End Try

            '********* SFA ***********************

            '********* TNT ***********************

            Try
                tempArray = New ArrayList
                ReportClearList = New ArrayList

                If TNTCollection IsNot Nothing AndAlso TNTCollection.Count > 0 Then
                    For Each TNT In TNTCollection
                        VoidList = New ArrayList
                        If optDisableFlashingTrackForPTC Then SFA.FlasherMode(False, True)
                        Select Case TNT.PTCAuthorityACKPending.ToString.ToUpper.Trim
                            Case PTCAuthorityACKPendingStatus.ISSUE.ToString.ToUpper.Trim
                                If TNT.AuthVoidList.Trim <> String.Empty Then
                                    Dim strVoid() As String = TNT.AuthVoidList.Split("|")
                                    Dim s As String
                                    For Each s In strVoid
                                        If s.Trim <> "" Then
                                            Dim VoidTNT As TMDS.TrackAuthority.TrackAuthority = Nothing
                                            VoidTNT = TMDS.SystemUtilities.FetchData.FindTNTByAuthorityGUID(s)
                                            If VoidTNT IsNot Nothing Then VoidList.Add(VoidTNT)
                                        End If
                                    Next
                                End If
                                TNT.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ISSUE.ToString
                                TNT.PTCAuthorityComponents = TNT.ComponentsInSelection.Clone
                                TNT.UpdateDatabaseWithPTCComponents()
                                If Not optDisableFlashingTrackForPTC Then TNT.FlasherMode(True, True)
                                Dim ProcessAuthIssueMessage As New DoProcessTNTAuthorityIssue(AddressOf PerformPTCTNTIssue)
                                ProcessAuthIssueMessage.BeginInvoke(TNT, Me, VoidList, HasNewLeadEngine, False, Nothing, Nothing)


                            Case PTCAuthorityACKPendingStatus.ROLLUP.ToString.ToUpper.Trim
                                'If Not RollupList.Contains(SFA) Then RollupList.Add(TNT)
                            Case PTCAuthorityACKPendingStatus.MODIFY.ToString.ToUpper.Trim
                                TNT.VETMS_PerformModify(Me)
                            Case PTCAuthorityACKPendingStatus.RELEASE.ToString.ToUpper.Trim
                                'If Not ReportClearList.Contains(TNT) Then ReportClearList.Add(TNT)
                                TNT.VETMS_PerformRelease(Me)



                            Case "NONE"
                                ''Authority has been Delivered sucessfully but void failed.

                                If TNT.AuthVoidList.Trim <> String.Empty Then
                                    Dim strVoid() As String = TNT.AuthVoidList.Split("|")
                                    Dim s As String
                                    For Each s In strVoid
                                        If s.Trim <> "" Then
                                            Dim VoidTNT As TMDS.TrackAuthority.TrackAuthority = Nothing
                                            VoidTNT = TMDS.SystemUtilities.FetchData.FindTNTByAuthorityGUID(s)
                                            If VoidTNT IsNot Nothing Then VoidList.Add(VoidTNT)
                                        End If
                                    Next
                                End If
                                TNT.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.ISSUE.ToString
                                TNT.PTCAuthorityComponents = TNT.ComponentsInSelection.Clone
                                TNT.UpdateDatabaseWithPTCComponents()
                                If Not optDisableFlashingTrackForPTC Then TNT.FlasherMode(True, True)
                                Dim ProcessAuthIssueMessage As New DoProcessTNTAuthorityIssue(AddressOf PerformPTCTNTIssue)
                                ProcessAuthIssueMessage.BeginInvoke(TNT, Me, VoidList, HasNewLeadEngine, True, Nothing, Nothing)
                        End Select
                    Next
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                SFA = Nothing
                TNT = Nothing
            End Try
            '********* TNT ***********************


        End Sub

#End Region

#End Region

#Region "BNSF BOS API MESSAGES"

        Private Function InsertIntoDatabaseOtherAuthorityPRS(ByVal theSignal As Object, ByVal TrackList As ArrayList, ByVal theMessage As ArrayList, ByVal theSignalRoute As SignalRoute, ByVal SwitchesInHand As Boolean, ByVal AuthorityLimits As String, ByVal DBLKGUID As String, ByVal SubType As String, ByVal ExitTrackUID As String) As String
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim query As New StringBuilder
            Dim comp As Object = Nothing
            Try
                Dim NoOfMilliSecs As Integer = 4
                NoOfMilliSecs = 10 - theSignal.GUID.ToString.Trim.Length
                Dim PSSAuthUID As String = theSignal.GUID.ToString.Trim
                'Dim milliStr As String = ""
                'For i As Integer = 1 To NoOfMilliSecs
                '    milliStr = milliStr.Trim & "f"
                'Next
                'PSSAuthUID = PSSAuthUID & Format(Date.Now, milliStr)


                query.Append("INSERT INTO tblAuthoritiesOtherActive (AuthGUID, AuthTimeStamp, AuthType, AuthUID, TerrUID, Components, TrainSymbol, IdentifingUnit, AuthorityVerbiage, AuthorityData, IssuedFromWorkstation, AuthorityLimits, ReferenceDBlockGUID, SubType) ")
                query.Append("VALUES (")
                Dim myGUID As String = Guid.NewGuid.ToString.ToUpper
                Dim AuthDate As Date = Now
                query.Append("'") : query.Append(myGUID) : query.Append("',")
                query.Append("'") : query.Append(AuthDate) : query.Append("',")
                query.Append("'") : query.Append("PASS-RED-SIGNAL") : query.Append("',")
                'query.Append("'") : query.Append(theSignal.GUID.ToString) : query.Append("',")
                query.Append("'") : query.Append(PSSAuthUID.Trim) : query.Append("',")
                query.Append("'") : query.Append(theSignal.TerritoryID) : query.Append("',")

                Dim CompList As New StringBuilder
                For Each comp In TrackList
                    If CompList.Length = 0 Then
                        CompList.Append(comp.GUID)
                    Else
                        CompList.Append("|")
                        CompList.Append(comp.GUID)
                    End If
                Next
                query.Append("'") : query.Append(CompList.ToString) : query.Append("',")

                Dim trn As TrainID = Me
                Dim TrnName As String
                If Not IsNothing(trn) Then
                    TrnName = trn.Name
                Else
                    TrnName = "NONE"
                End If
                'If Not IsNothing(trn) Then
                '    query.Append("'") : query.Append(trn.Name) : query.Append("',")
                'Else
                '    query.Append("'") : query.Append("NONE") : query.Append("',")
                'End If
                query.Append("'") : query.Append(TrnName) : query.Append("',")
                query.Append("'") : query.Append(trn.IdentifingUnit) : query.Append("',")
                Dim mess As String
                Dim Message As New StringBuilder
                For Each mess In theMessage
                    If Message.Length = 0 Then
                        Message.Append(mess)
                    Else
                        Message.Append("|")
                        Message.Append(mess)
                    End If
                Next
                query.Append("'") : query.Append(Message.ToString) : query.Append("',")

                Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(theSignal.SubdivisionID)
                Dim SubName As String = "UNASSIGNED"
                If Not IsNothing(subdvn) Then
                    SubName = subdvn.Abbreviation
                End If

                Dim data As New StringBuilder
                Dim SignalRouteUID As String = "000000"

                If SubType.Trim.ToUpper = "PSS" Then
                    If Not IsNothing(theSignalRoute) Then
                        SignalRouteUID = theSignalRoute.SystemUID
                    End If
                    data.Append(SubName) : data.Append("|") : data.Append(theSignal.GUID) : data.Append("|") : data.Append(SignalRouteUID) : data.Append("|") : data.Append(SwitchesInHand.ToString.ToUpper)
                Else
                    data.Append(SubName) : data.Append("|") : data.Append(theSignal.GUID) : data.Append("|") : data.Append(ExitTrackUID.Trim) : data.Append("|") : data.Append(SwitchesInHand.ToString.ToUpper)
                End If


                query.Append("'") : query.Append(data.ToString) : query.Append("',")
                query.Append("'") : query.Append(gThisWorkstation.WrkStnNumber) : query.Append("',")
                query.Append("'") : query.Append(AuthorityLimits) : query.Append("',")
                query.Append("'") : query.Append(DBLKGUID) : query.Append("',")
                query.Append("'") : query.Append(SubType) : query.Append("'")


                query.Append(")")
                dbconn = New OleDbConnection(gConnectionStringAuthority)
                dbconn.Open()
                dbcomm = New OleDbCommand(query.ToString, dbconn)
                dbcomm.ExecuteNonQuery()
                dbconn.Close()
                dbconn = Nothing



                Dim SplAuth As New TrackAuthority.OtherSpecialAuthorityType
                With SplAuth
                    SplAuth.AuthGUID = myGUID
                    SplAuth.AuthDate = AuthDate
                    SplAuth.AuthorityType = "PASS-RED-SIGNAL"
                    SplAuth.AuthorityUID = PSSAuthUID ' theSignal.GUID.ToString
                    SplAuth.TerrUID = theSignal.TerritoryID
                    For Each comp In TrackList
                        SplAuth.ComponentsInSelection.Add(comp)
                    Next
                    'SplAuth.ComponentsInSelection = TrackList
                    SplAuth.TrainSymbol = TrnName
                    SplAuth.IssueTo = trn.IdentifingUnit
                    SplAuth.AuthorityVerbiage = Message.ToString
                    SplAuth.AuthorityData = data.ToString
                    SplAuth.WrksStn = gThisWorkstation.WrkStnNumber
                    SplAuth.AuthorityLimits = AuthorityLimits
                    SplAuth.DBlkGUID = DBLKGUID
                    SplAuth.SubType = SubType
                    'SplAuth.DBlkAuthorityUID = DBlkAuthUID
                    If Not gOtherSpecialAuthorityCollection.Contains(SplAuth) Then gOtherSpecialAuthorityCollection.Add(SplAuth)

                    Dim SummItem As New SummaryItem("SPLAUTHORITY", "ADD", SplAuth)
                    SyncLock gSummaryAuthQueue
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock

                    If optEnableAutomaticRemovalOfPRSEMT Then
                        comp = Nothing
                        For Each comp In SplAuth.ComponentsInSelection
                            If Not comp.OtherSplAuthorities.Contains(SplAuth) Then
                                'compToBlock.DeviceBlocked = True
                                'compToBlock.BlockAbsolute = True
                                'compToBlock.BlockAbsolutePrevious = True
                                comp.SplAuthorityBlock = True
                                If optEnableTrackTimeDisplayonCodeBrown Or optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then
                                    comp.OverRideCodeBrown = True
                                End If
                                comp.OtherSplAuthorities.Add(SplAuth)
                                comp.updateStatus()
                            End If
                        Next
                    Else
                        comp = Nothing
                        For Each comp In SplAuth.ComponentsInSelection
                            If Not comp.OtherSplAuthorities.Contains(SplAuth) Then
                                comp.SplAuthorityBlock = True
                                If optEnableTrackTimeDisplayonCodeBrown Or optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then
                                    comp.OverRideCodeBrown = True
                                End If
                                comp.OtherSplAuthorities.Add(SplAuth)
                                comp.updateStatus()
                            End If
                        Next
                    End If

                End With


                Return myGUID
                'frmMessageBox.theSignal = theSignal
                'frmMessageBox.theTrain = Me
                'frmMessageBox.theTrack = theEnterTrack
                'frmMessageBox.EMT_PRSCompList = gEntExtTrackSelection
                'frmMessageBox.PassRedSignal = True
                'frmMessageBox.EMT_PRSType = "PRS"
                'frmMessageBox.EMT_PRSIssueTo = Me.IdentifingUnit
                'frmMessageBox.EMT_PRSTrainGUID = Me.TrainGUID
                '3	AuthGUID	nvarchar	50	0
                '0	AuthTimeStamp	datetime	8	1
                '0	AuthType	nvarchar	25	1
                '0	AuthUID	char	10	1
                '0	TerrUID	int	4	1
                '0	Components	nvarchar	1000	1
                '0	TrainSymbol	nvarchar	25	1
                '0	IdentifingUnit	nvarchar	25	1
                '0	AuthorityVerbiage	nvarchar	2000	1
                '0	AuthorityData	nvarchar	2000	1
                '0	IssuedFromWorkstation	nvarchar	10	1



            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return String.Empty
            Finally
                comp = Nothing
            End Try
        End Function

