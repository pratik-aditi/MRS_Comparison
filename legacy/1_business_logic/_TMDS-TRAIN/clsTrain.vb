        ''' <summary>
        ''' Find exit signal
        ''' </summary>
        ''' <param name="entrySignal">Entry Signal - First Signal On Route</param>
        ''' <param name="exitTrack">Exit Track - Last Track On Route</param>
        ''' <returns>Exit Signal For Special License</returns>
        Private Function FindExitSignal(entrySignal As Signal,
                                        exitTrack As Track) As Signal
            Try
                Dim theDirection As String = EntrySignalDirection(entrySignal)
                Dim nextComponent As GenericComponent = FindNextComponent(theDirection, exitTrack)
                TrainEventLog($"{GetCurrentMethod.Name}:EntrySignal:{entrySignal.GUID _
                                                      }:ExitTrack:{exitTrack.GUID _
                                                      }:Direction:{theDirection _
                                                      }:NextComponent:{nextComponent}")
                Return If(TypeOf (nextComponent) IsNot Signal,
                          SearchForSignal(nextComponent, theDirection),
                          nextComponent)
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        ''' <summary>
        ''' Find Next Component
        ''' </summary>
        ''' <param name="theDirection">Entry Signal (First Signal on Route) Component Direction</param>
        ''' <param name="exitTrack">Last Track on Route</param>
        ''' <returns>Next Component After ExitTrack Based On EntrySignal Component Direction</returns>
        Private Function FindNextComponent(theDirection As String, exitTrack As Track) As GenericComponent
            Try
                Return If(theDirection.Equals("RIGHT", StringComparison.CurrentCultureIgnoreCase),
                          FindCompItemFromGUID(exitTrack.LeftLink),
                          FindCompItemFromGUID(exitTrack.RightLink))
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        ''' <summary>
        ''' Entry Signal Direction
        ''' </summary>
        ''' <param name="entrySignal">Entry Signal - First Signal on Route</param>
        ''' <returns>Direction of Entry Signal</returns>
        Private Function EntrySignalDirection(entrySignal As Signal) As String
            Try
                Return If(entrySignal.ComponentType.Equals("R", StringComparison.CurrentCultureIgnoreCase) OrElse
                          entrySignal.ComponentType.Equals("D", StringComparison.CurrentCultureIgnoreCase), "RIGHT", "LEFT")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        ''' <summary>
        ''' Search For Exit Signal
        ''' </summary>
        ''' <param name="nextComponent"></param>
        ''' <param name="theDirection"></param>
        ''' <returns>Next Signal Component In Searching Direction</returns>
        Private Function SearchForSignal(nextComponent As GenericComponent,
                                         theDirection As String) As Signal
            Try
                Return If(theDirection.Equals("RIGHT", StringComparison.CurrentCultureIgnoreCase),
                          SearchForSignalRight(nextComponent),
                          SearchForSignalLeft(nextComponent))
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        ''' <summary>
        ''' Search For Signal Left
        ''' </summary>
        ''' <param name="nextComponent">Initial Component For Searching</param>
        ''' <returns>Returns Signal When Entry Signal Direction Is Right</returns>
        Private Function SearchForSignalLeft(nextComponent As GenericComponent) As Signal
            Try
                Dim loopControl As Integer = 0
                While loopControl <= 20
                    If TypeOf (nextComponent) Is Signal Then
                        TrainEventLog($"{GetCurrentMethod.Name}:Signal:{nextComponent.GUID}")
                        Return DirectCast(nextComponent, Signal)
                    End If
                    nextComponent = FindCompItemFromGUID(nextComponent.RightLink)
                    loopControl += 1
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        ''' <summary>
        ''' Search For Signal Right
        ''' </summary>
        ''' <param name="nextComponent">Initial Component For Searching</param>
        ''' <returns>Returns Signal When Entry Signal Direction Is Left</returns>
        Private Function SearchForSignalRight(nextComponent As GenericComponent) As Signal
            Try
                Dim loopControl As Integer = 0
                While loopControl <= 20
                    If TypeOf (nextComponent) Is Signal Then
                        TrainEventLog($"{GetCurrentMethod.Name}:Signal:{nextComponent.GUID}")
                        Return DirectCast(nextComponent, Signal)
                    End If
                    nextComponent = FindCompItemFromGUID(nextComponent.LeftLink)
                    loopControl += 1
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        ''' <summary>
        ''' Find Signal Route
        ''' </summary>
        ''' <param name="pEntrySignal"></param>
        ''' <param name="pExitSignal"></param>
        ''' <returns></returns>
        Private Function FindSignalRoute(ByVal pEntrySignal As Signal, ByVal pExitSignal As Signal) As SignalRoute
            Dim srArray As New ArrayList
            Dim sr As SignalRoute
            Try
                For Each sr In gSignalRouteList
                    If Not IsNothing(sr.EntrySignal) Then
                        If sr.EntrySignal.GUID = pEntrySignal.GUID Then
                            If Not IsNothing(sr.ComponentList) AndAlso sr.ComponentList.Count > 0 Then
                                If sr.ComponentList.Contains(pExitSignal) Then
                                    'Return sr
                                    srArray.Add(sr)
                                End If
                            End If
                        End If
                    End If
                Next
                If srArray.Count = 0 Then
                    For Each sr In gSignalRouteList
                        If Not IsNothing(sr.EntrySignal) Then
                            If sr.EntrySignal.GUID = pEntrySignal.GUID Then
                                If Not IsNothing(sr.ComponentList) AndAlso sr.ComponentList.Count > 0 Then
                                    If pEntrySignal.HoldingSignal Then
                                        Return sr
                                    ElseIf sr.EntrySignal.AutomaticSignal Then
                                        Return sr
                                    End If
                                End If
                            End If
                        End If
                    Next
                End If
                If srArray.Count > 1 Then
                    sr = SortDupeSignalRoute(srArray)
                    If sr Is Nothing Then
                        Return srArray(0)
                    Else
                        Return sr
                    End If
                Else
                    Return srArray(0)
                End If
                If pEntrySignal Is Nothing Then
                    TrainEventLog("FindSignalRoute:Entry Route is nothing")
                End If
                If pExitSignal Is Nothing Then
                    TrainEventLog("FindSignalRoute:Exit Route is nothing")
                End If
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                srArray = Nothing
                sr = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Sort Dupe Signal Route
        ''' </summary>
        ''' <param name="pSrArray"></param>
        ''' <returns></returns>
        Private Function SortDupeSignalRoute(pSrArray As ArrayList) As SignalRoute
            Dim sr As SignalRoute
            Dim comp As Object
            Dim foundSR As Boolean
            Try
                TrainEventLog("SortDupeSignalRoute:NumberOfRoutes=" & pSrArray.Count.ToString)
                For Each sr In pSrArray
                    foundSR = True
                    For Each comp In sr.ComponentList
                        If comp.GetType.ToString = gSwitchComponentName Then
                            If Not gEntExtTrackSelection.Contains(comp) Then
                                foundSR = False
                                Exit For
                            End If
                        End If
                    Next
                    If foundSR = True Then
                        Return sr
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                sr = Nothing
                comp = Nothing
                foundSR = Nothing
            End Try
        End Function

