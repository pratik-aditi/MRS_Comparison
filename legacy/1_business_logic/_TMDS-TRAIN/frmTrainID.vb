    Private Sub AddOnOffReleaseEvent(ByVal IsOnRelease As Boolean, ByVal Designation As String, ByVal DesignationName As String, ByVal ONOFFReleaseDateControl As TextBox, ByVal ONOFFReleaseTimeControl As TextBox, Optional ByVal IsNewEntry As Boolean = False, Optional ByVal HOSDateControl As TextBox = Nothing, Optional ByVal HOSTimeControl As TextBox = Nothing)
        Dim clsOnReleaseEvent As New OnOFFReleaseTimeEvent
        Try
            If CurrentTrain IsNot Nothing AndAlso Not gPositionTrainID Then
                OnOFFReleaseCrewString = BuildOnOffReleaseString()
            End If

            With clsOnReleaseEvent
                .IsOnRelease = IsOnRelease
                .Designation = Designation
                .DesignationName = DesignationName
                If Not IsNewEntry Then
                    If IsOnRelease Then
                        .ONOFFReleaseStr = ONOFFReleaseDateControl.Tag & " " & ONOFFReleaseTimeControl.Tag & " -TO " & ONOFFReleaseDateControl.Text & " " & ONOFFReleaseTimeControl.Text
                    Else
                        .ONOFFReleaseStr = ONOFFReleaseDateControl.Tag & " " & ONOFFReleaseTimeControl.Tag & " -TO " & ONOFFReleaseDateControl.Text & " " & ONOFFReleaseTimeControl.Text
                        If HOSDateControl IsNot Nothing AndAlso HOSTimeControl IsNot Nothing Then
                            If IsValidDateString(HOSDateControl.Text) AndAlso IsValidTimestr(HOSTimeControl.Text) Then
                                .HOSStr = " - HOS " & HOSDateControl.Text & " " & HOSTimeControl.Text
                            End If
                        End If
                    End If
                Else
                    If IsOnRelease Then
                        .ONOFFReleaseStr = ONOFFReleaseDateControl.Text & " " & ONOFFReleaseTimeControl.Text
                    Else
                        .ONOFFReleaseStr = ONOFFReleaseDateControl.Text & " " & ONOFFReleaseTimeControl.Text
                        If HOSDateControl IsNot Nothing AndAlso HOSTimeControl IsNot Nothing Then
                            If IsValidDateString(HOSDateControl.Text) AndAlso IsValidTimestr(HOSTimeControl.Text) Then
                                .HOSStr = " - HOS " & HOSDateControl.Text & " " & HOSTimeControl.Text
                            End If
                        End If
                    End If
                End If
                .IsNewEntry = IsNewEntry
            End With
            OnOFFReleaseTimeCollection.Add(clsOnReleaseEvent)
            ONOFFReleaseDateControl.Tag = ONOFFReleaseDateControl.Text
            ONOFFReleaseTimeControl.Tag = ONOFFReleaseTimeControl.Text

        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Sub

    Private Sub WriteOnOffReleaseEventToDB(ByVal clsOnReleaseEvent As OnOFFReleaseTimeEvent)
        Dim TimeChangeEvent As New StringBuilder
        Try
            If Not optApplyTrainSheetConfigurationForARRC Then Exit Sub
            If clsOnReleaseEvent Is Nothing Then Exit Sub
            If Not clsOnReleaseEvent.IsNewEntry Then
                With TimeChangeEvent
                    If clsOnReleaseEvent.IsOnRelease Then
                        .Append(clsOnReleaseEvent.Designation & ": " & Space(1) & clsOnReleaseEvent.DesignationName & Space(1))
                        .Append(" -ON RELEASE DATE TIME CHANGED FROM- ")
                        .Append(clsOnReleaseEvent.ONOFFReleaseStr)
                    Else
                        .Append(clsOnReleaseEvent.Designation & ": " & Space(1) & clsOnReleaseEvent.DesignationName & Space(1))
                        .Append(" -OFF RELEASE DATE TIME CHANGED FROM- ")
                        .Append(clsOnReleaseEvent.ONOFFReleaseStr)
                        If Not String.IsNullOrEmpty(clsOnReleaseEvent.HOSStr) Then
                            .Append(clsOnReleaseEvent.HOSStr)
                        End If
                    End If
                End With
                If clsOnReleaseEvent.IsOnRelease Then
                    Me.AddTrainSheetEvent("ON RELEASE CHANGE", TimeChangeEvent.ToString, CurrentTrain.myTrack.myControlPoint.GUID.ToString, CurrentTrain.GetIdentifyingLocationNameFromLimits, CurrentTrain.myTrack.myControlPoint.UniqueName, True, clsOnReleaseEvent.CreateTime)
                Else
                    Me.AddTrainSheetEvent("OFF RELEASE CHANGE", TimeChangeEvent.ToString, CurrentTrain.myTrack.myControlPoint.GUID.ToString, CurrentTrain.GetIdentifyingLocationNameFromLimits, CurrentTrain.myTrack.myControlPoint.UniqueName, True, clsOnReleaseEvent.CreateTime)
                End If
            Else
                With TimeChangeEvent
                    If clsOnReleaseEvent.IsOnRelease Then
                        .Append(clsOnReleaseEvent.Designation & ": " & Space(1) & clsOnReleaseEvent.DesignationName & Space(1))
                        .Append(" - ")
                        .Append(clsOnReleaseEvent.ONOFFReleaseStr)
                    Else
                        .Append(clsOnReleaseEvent.Designation & ": " & Space(1) & clsOnReleaseEvent.DesignationName & Space(1))
                        .Append(" - ")
                        .Append(clsOnReleaseEvent.ONOFFReleaseStr)
                        If Not String.IsNullOrEmpty(clsOnReleaseEvent.HOSStr) Then
                            .Append(clsOnReleaseEvent.HOSStr)
                        End If
                    End If
                End With
                If clsOnReleaseEvent.IsOnRelease Then
                    Me.AddTrainSheetEvent("ON RELEASE ADD", TimeChangeEvent.ToString, CurrentTrain.myTrack.myControlPoint.GUID.ToString, CurrentTrain.GetIdentifyingLocationNameFromLimits, CurrentTrain.myTrack.myControlPoint.UniqueName, True, clsOnReleaseEvent.CreateTime)
                Else
                    Me.AddTrainSheetEvent("OFF RELEASE ADD", TimeChangeEvent.ToString, CurrentTrain.myTrack.myControlPoint.GUID.ToString, CurrentTrain.GetIdentifyingLocationNameFromLimits, CurrentTrain.myTrack.myControlPoint.UniqueName, True, clsOnReleaseEvent.CreateTime)
                End If
            End If
            FormEvent("WriteOnOffReleaseEventToDB:" & TimeChangeEvent.ToString)
