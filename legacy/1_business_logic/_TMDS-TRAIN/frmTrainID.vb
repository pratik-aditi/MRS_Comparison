                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = Me
                frmMessageBox.SetMessage(MessageList, mstrTrainString11, True, Me.Location)
                frmMessageBox.TopMost = True
                frmMessageBox.ShowDialog()

                If frmMessageBox.FormFeedBack = 6 Then
                    Dim OLDCurrentCrew As TrainCrew = Nothing
                    Dim ReliefCrewEvent As New ArrayList()
                    If Not optEnableARRCSpecificOptions Then
                        ReliefCrewEvent.Add(optTrainString9 & Space(1) & optTrainString10 & CurrentTrain.CrewCurrent.Engineer.NameOfPerson & Space(1) & optTrainString12 & Space(1) & CurrentTrain.CrewCurrent.Engineer.OnDutyTime & Space(1) & optTrainString13 & Space(1) & CurrentTrain.CrewCurrent.Engineer.HOS)
                        ReliefCrewEvent.Add(optTrainString9 & Space(1) & optTrainString11 & CurrentTrain.CrewCurrent.Conductor.NameOfPerson & Space(1) & optTrainString12 & Space(1) & CurrentTrain.CrewCurrent.Conductor.OnDutyTime & Space(1) & optTrainString13 & Space(1) & CurrentTrain.CrewCurrent.Conductor.HOS)
                        Dim str As String
                        For Each str In ReliefCrewEvent
                            AddTrainSheetEvent("CREW CHANGE", str, CurrentTrain.myTrack.myControlPoint.GUID.ToString, CurrentTrain.GetIdentifyingLocationNameFromLimits, CurrentTrain.myTrack.myControlPoint.UniqueName)
                            CurrentTrain.HOSRedAlertACK = False
                            CurrentTrain.HOSYellowAlertACK = False
                        Next
                    Else
                        OLDCurrentCrew = CurrentTrain.CrewCurrent
                    End If

                    If optApplyTrainSheetConfigurationForARRC AndAlso SwapTrain IsNot Nothing Then 'CMV ARRC-673 Moved code from event handler from btnCrewSwap to btnApplyReliefCrew
                        Dim CrewEvent, SwapCrewEvent As String

                        CrewEvent = "SWAP CREW EVENT REPLACED THIS RELIEF CREW:( ENG=" & CurrentTrain.CrewCurrent.Engineer.NameOfPerson & " ONDUTY=" & CurrentTrain.CrewCurrent.Engineer.OnDutyTime & " HOS=" & CurrentTrain.CrewCurrent.Engineer.HOS & "  TIEUP=" & CurrentTrain.CrewCurrent.Engineer.OffDutyTime
                        CrewEvent = CrewEvent & " COND=" & CurrentTrain.CrewCurrent.Conductor.NameOfPerson & " ONDUTY=" & CurrentTrain.CrewCurrent.Conductor.OnDutyTime & " HOS=" & CurrentTrain.CrewCurrent.Conductor.HOS & "  TIEUP=" & CurrentTrain.CrewCurrent.Conductor.OffDutyTime & ",  LOCATION=" & CurrentTrain.GetIdentifyingLocationNameFromLimits & " )" ' ARRC-673 Added this so location gets saved in swap record and shows up when PDF is printed
                        Me.AddTrainSheetEvent("CREW SWAP", CrewEvent, CurrentTrain.myTrack.myControlPoint.GUID.ToString, CurrentTrain.GetIdentifyingLocationNameFromLimits, CurrentTrain.myTrack.myControlPoint.UniqueName)

                        If SwapTrain.CrewCurrent Is Nothing Then
                            SwapCrewEvent = "SWAP CREW EVENT REPLACED THIS RELIEF CREW:( ENG=NONE" & Space(1) & "ONDUTY=NONE" & Space(1) & "HOS=NONE" & Space(1) & "TIEUP=NONE"
                            SwapCrewEvent = SwapCrewEvent & Space(1) & "COND=NONE" & Space(1) & "ONDUTY=NONE" & Space(1) & "HOS=NONE" & Space(1) & "TIEUP=NONE" & Space(1) & ",  LOCATION=" & SwapTrain.GetIdentifyingLocationNameFromLimits & " )"
                        Else
                            SwapCrewEvent = "SWAP CREW EVENT REPLACED THIS RELIEF CREW:( ENG=" & SwapTrain.CrewCurrent.Engineer.NameOfPerson & " ONDUTY=" & SwapTrain.CrewCurrent.Engineer.OnDutyTime & " HOS=" & CurrentTrain.CrewCurrent.Engineer.HOS & "  TIEUP=" & CurrentTrain.CrewCurrent.Engineer.OffDutyTime
                            SwapCrewEvent = SwapCrewEvent & " COND=" & CurrentTrain.CrewCurrent.Conductor.NameOfPerson & " ONDUTY=" & CurrentTrain.CrewCurrent.Conductor.OnDutyTime & " HOS=" & SwapTrain.CrewCurrent.Conductor.HOS & "  TIEUP=" & SwapTrain.CrewCurrent.Conductor.OffDutyTime & ",  LOCATION=" & SwapTrain.GetIdentifyingLocationNameFromLimits & " )" 'ARRC-673 Added this so location gets saved in swap record and shows up when PDF is printed
                        End If
                        Me.AddTrainSheetEvent("CREW SWAP", SwapCrewEvent, SwapTrain.myTrack.myControlPoint.GUID.ToString, SwapTrain.GetIdentifyingLocationNameFromLimits, SwapTrain.myTrack.myControlPoint.UniqueName, True, Now, SwapTrain)

                        Me.ApplyReliefCrewFromFormSwap(SwapTrain) ' ARRC-673 Added this to apply the relief crew to the swap train object instead of overwriting the current train crew controls on the form with the current crew from the swap train.
                    End If

                    Me.ApplyCrewFromForm(CurrentTrain)
                    CurrentTrain.CrewReliefString = CurrentTrain.CrewRelief.CreateCrewString()
                    CurrentTrain.CrewCurrent = CurrentTrain.CrewRelief
                    CurrentTrain.CrewRelief = New TrainCrew()
                    CurrentTrain.CrewReliefString = CurrentTrain.CrewRelief.CreateCrewString()
                    CurrentTrain.CrewCurrentString = CurrentTrain.CrewCurrent.CreateCrewString()
                    ResetCurrentCrewReleaseOnOff()
                    Me.ApplyCurrentCrew(CurrentTrain)
                    Me.ApplyReliefCrew(CurrentTrain)
                    If optApplyTrainSheetConfigurationForARRC Then
                        TMDS.NetworkMessages.CadMessages.SendTrainCrewEventARRC(CurrentTrain, gMISTransmitQueue, True, "MODIFY")
                        CurrentTrain.RecordCrewChangeEvent(OLDCurrentCrew)
                        LoadTrainEvents(CurrentTrain)
                    End If

                    If optEnableMessagingEDI Then
                        TMDS.NetworkMessages.CadMessages.SendTrainCrewUpdateEDI(CurrentTrain)
                    End If
                End If

            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        Finally
            MessageList = Nothing
        End Try

    End Sub

