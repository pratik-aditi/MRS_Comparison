    Private Sub cmbWOCStations_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles cmbWOCStations.SelectedIndexChanged
        Try
            Dim LaunchPoint As New Point(Me.Location.X + 100, Me.Location.Y + 100)
            Dim SelectedList As New ArrayList
            Dim frmMessageBox As frmMessageBox
            Dim MessageList As New ArrayList()
            MessageList.Add("CONFIRM TO COMPLETE WORK ORDER(s).")
            MessageList.Add("AT STATION:" & cmbWOCStations.Text)
            Dim lv As ListViewItem
            For Each lv In lvWorkOrders.Items
                If lv.Selected Then
                    SelectedList.Add(lv.Text)
                    MessageList.Add("CAR UID:" & lv.SubItems(2).Text)
                End If
            Next
            MessageList.Add("")
            MessageList.Add("ARE YOU SURE?")
            frmMessageBox = New frmMessageBox()
            frmMessageBox.Owner = Me
            frmMessageBox.SetMessage(MessageList, "WORK ORDER COMPLETE CONFIRMATION", True, LaunchPoint)
            frmMessageBox.TopMost = True
            frmMessageBox.ShowDialog()
            If frmMessageBox.FormFeedBack = 6 Then
                Dim stat() As String = cmbWOCStations.Text.Split("-")
                Dim StationUID As String = stat(1)
                Dim StationIndex As String = stat(0)
                If IsNothing(CurrentTrain) Then Exit Sub
                Dim wo As WorkOrder
                Dim ErrMsg As String = ""
                For Each wo In CurrentTrain.myWorkOrderList
                    ErrMsg = ""
                    If SelectedList.Contains(wo.myUID) Then
                        'wo.CompleteWorkOrder()
                        'wo.WorkComepleted = True
                        'TMDS.NetworkMessages.CadMessages.SendTrainWorkOrderChangeARRC(CurrentTrain, wo, False, String.Empty, String.Empty, StationIndex, StationUID, gCadTransmitQueue)

                        If wo.myEventType.ToUpper.Trim <> "P" Then
                            If Not CancelFormCBasedOnWorkOrder(wo) Then Exit Sub
                        End If



                        If wo.CompleteWorkOrder_New(ErrMsg) Then
                            wo.WorkComepleted = True
                            Dim ReferenceGUID As String = Guid.NewGuid.ToString
                            TMDS.NetworkMessages.CadMessages.SendTrainWorkOrderChangeARRC(CurrentTrain, wo, False, String.Empty, String.Empty, StationIndex, StationUID, gMISTransmitQueue, ReferenceGUID)
                            TMDS.NetworkMessages.CadMessages.SendTrainEngineSetEventARRC(CurrentTrain, gMISTransmitQueue, "MODIFY", False, StationUID, False, ReferenceGUID)
                            'TMDS.NetworkMessages.CadMessages.SendTrainDataWarehouseEventARRC(CurrentTrain, gCadTransmitQueue, "MODIFY")   'Commented Based On RMT ARRC-1432
                            'SendForcedConsistUpdate = True
                        Else
                            MessageList = New ArrayList
                            With MessageList
                                .Add("ERROR APPLYING WORK ORDER[CAR UID:" & wo.myCarUID & "].")
                                .Add("PLEASE CONTACT SYSTEM ADMINISTRATOR")
                            End With

                            If Not String.IsNullOrEmpty(ErrMsg) AndAlso ErrMsg.Trim <> "" Then
                                MessageList.Add("")
                                MessageList.Add("ERRROR MSG:")
                                MessageList.Add(ErrMsg)
                            End If
                            ShowCustomMessageBox(MessageList, "SYSTEM MESSAGE", False, LaunchPoint, True, True, Me)
                        End If
                    End If
                Next
                LoadWorkOrders(CurrentTrain)
            End If
            frmMessageBox.Dispose()
            frmMessageBox = Nothing

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function OKToShowWorkOrderMenu(ByVal WorkOrderGUID As String, ByVal trn As TrainID) As Boolean

        Dim wo As WorkOrder
        Try
            For Each wo In trn.myWorkOrderList
                If WorkOrderGUID.ToUpper.Trim = wo.myUID.ToUpper.Trim Then
                    If wo.WorkComepleted Then
                        Return False
                    ElseIf wo.WorkDeleted Then
                        Return False
                    Else
                        Return True
                    End If
                End If
            Next
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try


    End Function

    Private Function CancelFormCBasedOnWorkOrder(ByVal wo As WorkOrder) As Boolean
        Dim LaunchPoint As New Point(Me.Location.X + 100, Me.Location.Y + 100)
        Dim MessageList As New ArrayList()
        Try
            Dim tr As TrainRestriction
            If CurrentTrain.myRestrictionList IsNot Nothing AndAlso CurrentTrain.myRestrictionList.Count > 0 Then
                For Each tr In CurrentTrain.myRestrictionList
                    If tr.myCarUID.ToUpper.Trim = wo.myCarUID.ToUpper.Trim AndAlso Not String.IsNullOrEmpty(tr.myBulletinGUID) AndAlso tr.myBulletinGUID.Trim <> "" Then
                        If Not tr.RemoveGBO(Me) Then
                            MessageList = New ArrayList
                            With MessageList
                                .Add("FORMC NOT CANCELLED FOR [" & wo.myCarUID.ToUpper.Trim & "].")
                            End With
                            ShowCustomMessageBox(MessageList, "SYSTEM MESSAGE", False, LaunchPoint, True, True, Me)
                            Return False
                        End If
                    End If
                Next
            End If
            Return True
        Catch ex As Exception
            GetErrorDetails(ex)
        Finally
            LaunchPoint = Nothing
            MessageList = Nothing
        End Try
    End Function

