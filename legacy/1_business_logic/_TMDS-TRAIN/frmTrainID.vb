                    trn.LoadTrainDelays()

                    .TypeOfID = "TRAIN"
                End With
                dbconn.Close()
                dbconn = Nothing
                Return trn
            End While
            dbconn.Close()
            dbconn = Nothing
            Return Nothing
        Catch ex As Exception
            SystemException(ex.ToString)
            dbconn = Nothing
