            Dim SelectedList As New ArrayList
            Dim frmMessageBox As frmMessageBox
            Dim MessageList As New ArrayList()
            MessageList.Add("CONFIRM TO DELETE WORK ORDER(s).")
            MessageList.Add("AT STATION:" & cmbWODStations.Text)
            Dim lv As ListViewItem
            For Each lv In lvWorkOrders.Items
                If lv.Selected Then
                    SelectedList.Add(lv.Text)
                    MessageList.Add("CAR UID:" & lv.SubItems(2).Text)
                End If
            Next
            MessageList.Add("")
            MessageList.Add("ARE YOU SURE?")
