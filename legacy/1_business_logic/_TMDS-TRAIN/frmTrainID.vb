#Region "TRAIN SCHEDULE"

    Private Sub LoadTrainSchedules(ByVal trn As TrainID)
        Try
            If optApplyTrainSheetConfigurationForDenver Then
                LoadTrainSchedulesDenver(trn)
                Exit Sub
            End If

            Dim lvItem As ListViewItem
            lvSchedule.Items.Clear()
            Dim ts As TrainSchedule
            Dim StationArrivalTime As String = ""
            Dim StationDepartureTime As String = ""

            For Each ts In trn.myScheduleList
                StationArrivalTime = Format(ts.myStationArrivalTime, "HH:mm")
                StationDepartureTime = Format(ts.myStationDepartureTime, "HH:mm")
                lvItem = New ListViewItem(ts.myUID)
                lvItem.SubItems.Add(ts.myDirection)
                lvItem.SubItems.Add(ts.myStationName)
                lvItem.SubItems.Add(StationArrivalTime)
                lvItem.SubItems.Add(StationDepartureTime)
                If optEnableNCTDSpecificOptions OrElse optEnableSpecificOptionsForMetrolink Then
                    lvItem.SubItems.Add(ts.myStationArrivalTrackName & " TO " & ts.myStationDepartureTrackName)

                Else
                    If ts.CrewChangeLocation Then
                        lvItem.SubItems.Add("Y")
                    Else
                        lvItem.SubItems.Add("N")
                    End If
                    If ts.WorkEventLocation Then
                        lvItem.SubItems.Add("Y")
                    Else
                        lvItem.SubItems.Add("N")
                    End If
                End If
                Dim DependencyData As String = "NONE"
                If Not String.IsNullOrEmpty(ts.myScheduleDependencyData) Then
                    DependencyData = ts.myScheduleDependencyData
                End If
                lvItem.SubItems.Add(DependencyData)
                lvSchedule.Items.Add(lvItem)
            Next
            lvSchedule.Refresh()
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

