                If Tu.UnitNumber = CurrentTrain.IdentifingUnit Then
                    LeadEnginePostion = Tu.UnitPosition
                    LeadEngineID = CurrentTrain.IdentifingUnit
                Else
                    If Tu.UnitPosition > LastEnginePostion Then
                        LastEnginePostion = Tu.UnitPosition
                        LastEngineID = Tu.UnitNumber
                    End If
                End If
            Next
            'tmpTrain = CurrentTrain
            For Each Tu In CurrentTrain.UnitsInTrain
                If Tu.UnitNumber = LeadEngineID Then
                    Tu.UnitPosition = LastEnginePostion
                    Tu.UpdateUnitPostion(True)
                ElseIf Tu.UnitNumber = LastEngineID Then
                    Tu.UnitPosition = LeadEnginePostion
                    CurrentTrain.IdentifingUnit = LastEngineID
                    CurrentTrain.UpdateIdentifingUnit(False, True)
