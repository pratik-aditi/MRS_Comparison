    Private Sub mnuUnitMod_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles mnuUnitMod.Click
        Try
            If CurrentTrain Is Nothing Then
                FormEvent("TRAIN ID NOT FOUND - MODIFY UNIT")
                Exit Sub
            End If

            Dim UnitNumber As String = String.Empty
            If Me.cmbUnitID.Focused Then
                UnitNumber = Me.cmbUnitID.Text
            End If

            If UnitNumber = "" Then
                Dim lv As ListViewItem
                For Each lv In Me.lvUnits.Items
                    If lv.Selected Then
                        UnitNumber = lv.Text
                        Exit For
                    End If
                Next
            End If
            If UnitNumber IsNot Nothing AndAlso UnitNumber.Trim <> "" Then
            Else
                FormEvent("INVALID UNIT NUMBER")
                Exit Sub
            End If
            'If UnitNumber = "" Then Exit Sub
            Dim TrainUnit As New frmTrainUnit
            If TrainUnit.ApplyProperties(CurrentTrain, UnitNumber, True) Then
                TrainUnit.Owner = Me
                TrainUnit.TopMost = True
                TrainUnit.Location = New Point(Me.Location.X + 100, Me.Location.Y + 100)
                TrainUnit.ShowDialog()
                TrainUnitHasbeenModified = TrainUnit.HasConsistChange
                HorsePowerPerTonChange = True
            Else
                FormEvent("ERROR OPENING UNIT NUMBER " & UnitNumber)
            End If
            TrainUnit.Dispose()
            TrainUnit = Nothing
            RefreshUnitProperties()
            If optApplyTrainSheetConfigurationForARRC Or optApplyTrainSheetConfigurationForDenver Then
                CurrentTrain.CalculateHorsePowerPerTon()
                CurrentTrain.CalculateTPOB(True)
                CurrentTrain.CalculateTotalTonAndTotalLength(True)
                With CurrentTrain
                    Try
                        If .HorsePowerTrailing.Trim <> String.Empty And IsNumeric(.HorsePowerTrailing) Then
                            If IsNumeric(.HorsePowerTrailing) Then
                                If CInt(.HorsePowerTrailing) > 99 Then
                                    Me.txtHPT.Text = CInt(.HorsePowerTrailing)
                                Else
                                    Me.txtHPT.Text = Format(CDbl(.HorsePowerTrailing), "#" & optHPTStringFormat)
                                End If
                            Else
                                Me.txtHPT.Text = optHPTStringFormat
                            End If
                        Else
                            Me.txtHPT.Text = optHPTStringFormat
                        End If
                    Catch ex As Exception
                        SystemException(ex.ToString)
                    End Try
                    If .TotalHorsePower > 99999 Then
                        Me.nudTHP.Value = 99999
                    Else
                        Me.nudTHP.Value = .TotalHorsePower
                    End If
                    If .TonsPerOperativeBrake > 99999 Then
                        Me.nudTOPB.Value = 99999
                    Else
                        Me.nudTOPB.Value = .TonsPerOperativeBrake
                    End If
                End With
            End If
            If optEnableDenverSpecificOptions AndAlso CurrentTrain IsNot Nothing Then Me.Text = "TRIP CAR -" & CurrentTrain.Name & " -  " & CurrentTrain.GetMyComplaintStatus
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
