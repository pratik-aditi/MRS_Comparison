    Private Function CheckTrainSymbolForMLTypeTrain(ByRef TrainSymbol As String) As Boolean
        Try
            If TrainSymbol.Length > 10 Then Return False
            Dim trimLEN As Integer = 2
            Dim last2Digits As String = TrainSymbol.Substring(TrainSymbol.Length - trimLEN, 2)
            Dim lastDigit As String = TrainSymbol.Substring(TrainSymbol.Length - 1, 1).PadLeft(2, "0")
            If Not IsNumeric(last2Digits) Then
                trimLEN = 1
                last2Digits = TrainSymbol.Substring(TrainSymbol.Length - trimLEN, 1).PadLeft(2, "0")
            End If
            Dim FirstSection As String = TrainSymbol.Substring(0, TrainSymbol.Length - trimLEN)
            Dim noofstars As Integer = 10 - (TrainSymbol.Length)

            If IsNumeric(last2Digits) AndAlso last2Digits <= 31 Then
                TrainSymbol = FirstSection & New String(" ", noofstars) & last2Digits
            ElseIf IsNumeric(last2Digits) AndAlso last2Digits > 31 Then
                FirstSection = TrainSymbol.Substring(0, TrainSymbol.Length - 1)
                TrainSymbol = FirstSection & New String(" ", noofstars) & lastDigit
            End If

            Return True
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try

    End Function

    Private Function FormatTrainSymbolForCN(ByRef TrainSymbol As String) As Boolean
        Try
            Dim SymbolArray As New ArrayList()
            Dim ch As String

            TrainSymbol = TrainSymbol.ToUpper
            TrainSymbol = TrainSymbol.Replace(" ", "")
            TrainSymbol = Me.ValidateSymbolCharacters(TrainSymbol)

            For Each ch In TrainSymbol
                SymbolArray.Add(ch)
            Next

            Dim sDate As String = SymbolArray.Item(SymbolArray.Count - 2) & SymbolArray.Item(SymbolArray.Count - 1)
            If Not CheckForValidDate(sDate) Then
                Return False
            End If

            If IsNumeric(SymbolArray.Item(0)) Then
                Return False
            End If

            Dim Count As Integer = SymbolArray.Count
            Dim Index As Integer = Count - 2
            Dim NumChr As Integer = 10 - SymbolArray.Count
            Dim i As Integer
            For i = 1 To NumChr
                SymbolArray.Insert(Index, " ")
            Next

            Dim ReplacementSymbol As String = String.Empty
            Count = 0
            For Each ch In SymbolArray
                Count += 1
                If Count > 10 Then Exit For
                ReplacementSymbol = ReplacementSymbol & ch
            Next
            TrainSymbol = ReplacementSymbol
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Function FormatTrainSymbolForMRS(ByRef TrainSymbol As String) As Boolean
        Dim SymbolArray As New ArrayList()
        Dim ch As String
        Dim I As Integer
        Try
            TrainSymbol = TrainSymbol.ToUpper
            TrainSymbol = TrainSymbol.Replace(" ", "")
            TrainSymbol = Me.ValidateSymbolCharacters(TrainSymbol)

            If optRailRoadName.Contains("MRS") Then
                For Each ch In TrainSymbol
                    SymbolArray.Add(ch)
                Next
                If SymbolArray.Count > 7 Then
                    Return False
                End If
                For I = 0 To 2
                    If IsNumeric(SymbolArray.Item(I)) Then
                        Return False
                    End If
                Next
                For I = 3 To 6
                    If Not IsNumeric(SymbolArray.Item(I)) Then
                        Return False
                    End If
                Next
            ElseIf optRailRoadName.Contains("RUMO") Then
                For Each ch In TrainSymbol
                    SymbolArray.Add(ch)
                Next
                If SymbolArray.Count > 3 Then
                    Return False
                End If
                For I = 0 To 0
                    If IsNumeric(SymbolArray.Item(I)) Then
                        Return False
                    End If
                Next
                For I = 1 To 2
                    If Not IsNumeric(SymbolArray.Item(I)) Then
                        Return False
                    End If
                Next
            ElseIf optRailRoadName.Contains("TLSA") Then
                TrainSymbol = Me.FormatPrefixTLSA(TrainSymbol)
                For Each ch In TrainSymbol
                    SymbolArray.Add(ch)
                Next
                If SymbolArray.Count > 5 Then
                    Return False
                End If
                For I = 0 To 0
                    If IsNumeric(SymbolArray.Item(I)) Then
                        Return False
                    End If
                Next
                For I = 2 To 4
                    If Not IsNumeric(SymbolArray.Item(I)) Then
                        Return False
                    End If
                Next
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        Finally
            SymbolArray.Clear()
            SymbolArray = Nothing
            ch = Nothing
            I = Nothing
        End Try
    End Function

