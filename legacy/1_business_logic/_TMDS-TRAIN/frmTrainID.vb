    Private Sub LoadTrainCars(ByVal trn As TrainID)
        Try
            If optApplyTrainSheetConfigurationForDenver Then
                LoadTrainUnitsInConsistTab(trn)
                Exit Sub
            End If
            Dim lv As ListViewItem
            If lvCarConsist IsNot Nothing AndAlso lvCarConsist.IsHandleCreated Then
                lvCarConsist.Invoke(Sub() lvCarConsist.Items.Clear())
            Else
                lvCarConsist.Items.Clear()
            End If

            '
            If trn Is Nothing Then Exit Sub
            Dim tc As TrainCar
            ThisCarTrain = trn
            For Each tc In trn.myCarList
                lv = New ListViewItem(tc.myUID)
                lv.SubItems.Add(tc.CarUID)
                lv.SubItems.Add(tc.CarPositionIndex.ToString.PadLeft(3, "0"))
                lv.SubItems.Add(tc.CarLength)
                lv.SubItems.Add(tc.CarTons)
                lv.SubItems.Add(tc.CarAxles)
                lv.SubItems.Add(tc.CarNumOperateBrakes)
                lv.SubItems.Add(tc.LoadStatus)
                lvCarConsist.Items.Add(lv)
            Next
            If lvCarConsist IsNot Nothing AndAlso lvCarConsist.IsHandleCreated Then
                lvCarConsist.Invoke(Sub() lvCarConsist.Refresh())
            Else
                lvCarConsist.Refresh()
            End If
            '

            If trn.myCarList IsNot Nothing AndAlso trn.myCarList.Count > 1 Then
                btnApplyPostion.Enabled = True
                btnConsistUp.Enabled = True
                btnConsistDown.Enabled = True
            Else
                btnApplyPostion.Enabled = False
                btnConsistUp.Enabled = False
                btnConsistDown.Enabled = False
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub LoadTrainUnitsInConsistTab(ByVal trn As TrainID)
        Try

            Dim lv As ListViewItem
            lvCarConsist.Items.Clear()
            If trn Is Nothing Then Exit Sub
            If trn.UnitsInTrain Is Nothing Then Exit Sub
            If trn.UnitsInTrain.Count = 0 Then Exit Sub
            Dim tu As TrainUnit
            For Each tu In trn.UnitsInTrain
                If Not IsNothing(tu) Then
                    lv = New ListViewItem(tu.UnitNumber.Trim)
                    lv.SubItems.Add(tu.UnitNumber.Trim)

                    Dim Status As String = ""
                    Status = tu.Status
                    If optEnableDenverSpecificOptions Then
                        Select Case tu.thisUnitCondition
                            Case 1, 0
                                Status = TrainUnit.UnitCondition.COMPLIANT.ToString
                            Case 2
                                Status = TrainUnit.UnitCondition.SUBSTANDARD.ToString
                            Case 3
                                Status = TrainUnit.UnitCondition.NONCOMPLIANT.ToString
                        End Select
                    End If
                    lv.SubItems.Add(Status)
                    lvCarConsist.Items.Add(lv)
                End If
            Next
            btnApplyPostion.Visible = False
            btnConsistUp.Visible = False
            btnConsistDown.Visible = False
            lvCarConsist.Refresh()



        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

