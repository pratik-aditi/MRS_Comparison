    Private Sub cmbSubTrainSheet_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles cmbSubTrainSheet.SelectedIndexChanged
        Try
            If LockcmbSubTrainSheet <> "" Then
                Exit Sub
            End If
            LockcmbSubTrainSheet = "LOCKED"
            Me.Cursor = System.Windows.Forms.Cursors.WaitCursor
            Dim TrainSheetLoaded As Boolean
            Dim ReadOnlyTrain As Boolean
            Dim ActiveTrain As TrainID = Nothing

            If Trim(Me.cmbSubTrainSheet.Text) = "" Then Exit Sub
            Dim data() As String = Me.cmbSubTrainSheet.Text.Split(">")
            If data.Length < 2 Then Exit Sub
            Dim subData() As String = data(1).Split("(")
            Dim CreateDate As String = subData(0)
            Dim TrainSheetGuid As String = TMDS.SystemUtilities.TrainFunction.RetrieveSubTrainGUID(CurrentTrain.Name, CDate(CreateDate))

            If Not IsNothing(Me.CurrentTrain) Then
                If Me.CurrentTrain.ActiveTrainSheetGUID = TrainSheetGuid Then
                    TrainSheetLoaded = True
                    ReadOnlyTrain = Me.CurrentTrain.ReadOnlySymbol
                    ActiveTrain = Me.CurrentTrain
                End If
            End If

            If Not IsNothing(Me.PositionedTrain) Then
                If Me.PositionedTrain.ActiveTrainSheetGUID = TrainSheetGuid Then
                    TrainSheetLoaded = True
                    ReadOnlyTrain = Me.PositionedTrain.ReadOnlySymbol
                    ActiveTrain = Me.PositionedTrain
                End If
            End If

            If Not TrainSheetLoaded Then
                SubTrainSheetTrain = TMDS.SystemUtilities.TrainFunction.RetrieveTrainPropertiesFromSubTrainSheet(Me.CurrentTrain.Name, TrainSheetGuid)
                SubTrainSheetTrain.GetOsRecords()
                Me.ClearPropertiesOnForm(False)
                If Not IsNothing(SubTrainSheetTrain) Then
                    Me.ApplyTrainPropertiesToForm(SubTrainSheetTrain)
                End If
                If Not ReadOnlyTrain And Not ViewTrainMode Then
                    Me.btnActiveSubTrainSheet.Enabled = True
                Else
                    Me.btnActiveSubTrainSheet.Enabled = False
                End If
            Else
                SubTrainSheetTrain = Nothing
                Me.ClearPropertiesOnForm(False)
                If Not IsNothing(ActiveTrain) Then
                    Me.ApplyTrainPropertiesToForm(ActiveTrain)
                End If

                Me.btnActiveSubTrainSheet.Enabled = False
            End If

            Me.Cursor = System.Windows.Forms.Cursors.Default
            LockcmbSubTrainSheet = ""
            Me.btnCreateSubTrainSheet.Focus()
        Catch ex As Exception
            SystemException(ex.ToString)
            Me.Cursor = System.Windows.Forms.Cursors.Default
            LockcmbSubTrainSheet = ""
        End Try
    End Sub

    Private Sub btnActiveSubTrainSheet_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnActiveSubTrainSheet.Click
        Try
            If Trim(Me.cmbSubTrainSheet.Text) = "" Then Exit Sub
            Dim data() As String = Me.cmbSubTrainSheet.Text.Split(">")
            If data.Length < 2 Then Exit Sub
            Dim subData() As String = data(1).Split("(")
            Dim CreateDate As String = subData(0)
            Dim TrainSheetGuid As String = TMDS.SystemUtilities.TrainFunction.RetrieveSubTrainGUID(CurrentTrain.Name, CDate(CreateDate))
            If IsNothing(CurrentTrain) Then Exit Sub
            If TMDS.SystemUtilities.TrainFunction.CheckForSymbolOnOtherDesk(Me.CurrentTrain) Then
                Dim frmMessageBox As frmMessageBox
                Dim MessageList As New ArrayList()
                MessageList.Add("THIS TRAIN SYMBOL EXISTS ON ANOTHER DESK.")
                MessageList.Add("ARE YOU SURE YOU WANT TO CHANGE THE ACTIVE TRAIN SHEET?")
                MessageList.Add("")
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = Me
                frmMessageBox.SetMessage(MessageList, "TRAIN SYMBOL CHECK!", True, Me.Location)
                frmMessageBox.TopMost = True
                frmMessageBox.ShowDialog()
                If frmMessageBox.FormFeedBack = 6 Then
                    CurrentTrain.ReplaceSubTrainSheet(CurrentTrain.ActiveTrainSheetGUID, TrainSheetGuid)
                    TMDS.SystemUtilities.TrainFunction.UpdateTrainFromSubTrainSheetActivation(CurrentTrain, TrainSheetGuid)
                    CurrentTrain.myTrack.UpDateTrainIDPosition(CurrentTrain)
                    LoadSubTrainSheetsInToComboBox()
                    Dim SummItem1 As New SummaryItem("TRAIN", "FORCE-REFRESH", CurrentTrain)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem1)
                    End SyncLock
                End If
                frmMessageBox.Dispose()
                frmMessageBox = Nothing
            Else
                CurrentTrain.ReplaceSubTrainSheet(CurrentTrain.ActiveTrainSheetGUID, TrainSheetGuid)
                TMDS.SystemUtilities.TrainFunction.UpdateTrainFromSubTrainSheetActivation(CurrentTrain, TrainSheetGuid)
                CurrentTrain.myTrack.UpDateTrainIDPosition(CurrentTrain)
                LoadSubTrainSheetsInToComboBox()
                Dim SummItem1 As New SummaryItem("TRAIN", "FORCE-REFRESH", CurrentTrain)
                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem1)
                End SyncLock
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

