    Private Function CheckForAuthorities(ByVal EngUnit As String, ByVal trn As TrainID) As Boolean
        Dim Auth As Object = Nothing
        Dim AuthList As New ArrayList
        Dim SplAuthList As New ArrayList
        Dim SplAuth As TMDS.TrackAuthority.OtherSpecialAuthorityType
        Dim MessageList As New ArrayList()
        Try
            If trn.CheckMyPTCStatus Then
                MessageList = New ArrayList
                With MessageList
                    .Add("THIS LEAD LOCOMOTIVE IS PTC ACTIVE")
                    .Add("FLIP ENGINE POSTION IS DENIED")
                    .Add("")
                End With
                ShowCustomMessageBox(MessageList, "SYSTEM WARNING SYSTEM", False, Me.Location, False, True, Me)
                Return False
            End If
            For Each Auth In OtherTrackAuthorities
                If Auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                    If InStr(Auth.IssueTo, EngUnit) <> 0 Then
                        If Not AuthList.Contains(Auth.AuthorityUID) Then AuthList.Add(Auth.AuthorityUID)
                    End If
                ElseIf Auth.GetType.ToString = gTTComponentName Then
                    If InStr(Auth.IssueTo, EngUnit) <> 0 Then
                        'AuthList.Add(sf)
                        If Not AuthList.Contains(Auth.AuthorityUID) Then AuthList.Add(Auth.AuthorityUID)
                    End If
                End If
            Next
            If AuthList.Count > 1 Then
                MessageList = New ArrayList
                With MessageList
                    .Add("MORE THAN ONE AUTHORITY EXISTS FOR THIS LEAD LOCOMOTIVE")
                    .Add("FLIP ENGINE POSTION IS DENIED")
                    .Add("")
                End With
                ShowCustomMessageBox(MessageList, "SYSTEM WARNING SYSTEM", False, Me.Location, False, True, Me)
                Return False
            End If
            For Each SplAuth In gOtherSpecialAuthorityCollection
                If SplAuth IsNot Nothing AndAlso SplAuth.IssueTo = EngUnit Then
                    MessageList = New ArrayList
                    With MessageList
                        .Add("ONE OR MORE PSS/EMT EXISTS FOR THIS LEAD LOCOMOTIVE")
                        .Add("FLIP ENGINE POSTION IS DENIED")
                        .Add("")
                    End With
                    ShowCustomMessageBox(MessageList, "SYSTEM WARNING SYSTEM", False, Me.Location, False, True, Me)
                    Return False
                End If
            Next

            If AuthList.Count = 0 Then
                Return True
            Else
                MessageList = New ArrayList
                Dim str As String
                For Each str In AuthList
                    MessageList.Add("TRACK AUTHORITY:" & str)
                Next
                MessageList.Add("EXISTING TRACK AUTHORITIES FOUND FOR LOCOMOTIVE ID:" & EngUnit)
                MessageList.Add("")
                MessageList.Add("CONTINUE WITH ENGINE FLIP?")
                If ShowCustomMessageBox(MessageList, "SYSTEM WARNING SYSTEM", True, Me.Location, False, True, Me) <> 6 Then
                    Return False
                Else
                    Return True
                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Function GetFlipedUnitsList(CurrentUnitList As ArrayList) As ArrayList
        Dim FlippedUnitList As New ArrayList(CurrentUnitList)
        Dim intArr As New List(Of Integer)
        Try



            For Each str As String In CurrentUnitList
                Dim tmpArr() As String = str.Split("|")
                intArr.Add(tmpArr(1))
            Next

            Dim pivot As Integer = intArr(intArr.Count - 1)
            FlippedUnitList(0) = FlippedUnitList(0) & "|" & pivot

            For i As Integer = 0 To intArr.Count - 2
                pivot = pivot - (intArr(i + 1) - intArr(i))
                FlippedUnitList(i + 1) = FlippedUnitList(i + 1) & "|" & pivot
            Next

            Return FlippedUnitList

        Catch ex As Exception
            GetErrorDetails(ex)

        End Try
        Return CurrentUnitList
    End Function

