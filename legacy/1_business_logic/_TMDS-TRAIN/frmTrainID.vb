    Private Sub DatabaseCommand(ByVal CommandString As String, ByRef dbConnection As OleDbConnection)
        Dim CommandInsert As New OleDbCommand(CommandString, dbConnection)
        Try
            CommandInsert.Connection.Open()
            CommandInsert.ExecuteNonQuery()
            dbConnection.Close()
            CommandInsert.Dispose()
            CommandInsert = Nothing
        Catch ex As Exception
            SystemException(ex.ToString)
            dbConnection.Close()
        Finally
            dbConnection.Close()
        End Try

    End Sub

    Private Sub CheckIdentifingUnitForETMS()
        Dim dbcomm As OleDbCommand
        Dim dr As OleDbDataReader
        Dim dbconn As OleDb.OleDbConnection
        Dim Query As String = "Select PTCEquipped FROM tblSystemLocomotives WHERE UID = '" & Me.cmbUnitID.Text & "'"
        Try
            dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
            dbcomm = New OleDbCommand(Query, dbconn)
            dbconn.Open()

            dr = dbcomm.ExecuteReader()
            While dr.Read
                If dr.IsDBNull(0) Then
                    Me.chkCBTCEquipped.Checked = False
                Else
                    Me.chkCBTCEquipped.Checked = CBool(dr.GetBoolean(0))
                End If

                Exit While
            End While
            dbconn.Close()
            dbconn = Nothing

        Catch ex As Exception
            Me.ExceptionEvent(ex.ToString)
            dbconn = Nothing
        End Try
    End Sub

    ''' <summary>
    ''' Apply train information
    ''' </summary>
    ''' <param name="pTrain"></param>
    ''' <returns></returns>
    Private Function ApplyTrainInformation(ByRef pTrain As TrainID) As Boolean
        Dim trainExists As Boolean
        Dim trk As Track
        Dim actTrn As ActiveTrn
        Try
            If gPTCTerritoryExists Then
                CheckIdentifingUnitForETMS()
            End If
            ApplyTrainPropertiesFromForm(pTrain)
            pTrain.CreateCrewStrings()
            If gPositionTrainID Then
                For Each actTrn In Me.ActiveTrains
                    If actTrn.Symbol = pTrain.Name Then
                        trainExists = True
                        Exit For
                    End If
                Next
                If trainExists Then
                    pTrain.DoUpdateTrainIDIntoDatabase(TrackRef, False)
                    If Not pTrain.CheckSubTrainSheetExists Then
                        pTrain.PerformCreateNewTrainSheetRecord()
                    End If
                Else
                    pTrain.CrewCurrent.ApplyCrewString(pTrain.CrewCurrentString)
                    pTrain.CrewRelief.ApplyCrewString(pTrain.CrewReliefString)
                    pTrain.CrewPending.ApplyCrewString(pTrain.CrewPendingString)
                    pTrain.InsertNewTrainIDIntoDatabase(TrackRef, gtblTrainsActive)
                    If optApplyTrainSheetConfigurationForMRL Then DisableTonCalulationOnCreate = True
                End If
            ElseIf gModifyTrainID Or Me.ViewTrainMode Then
                pTrain.DoUpdateTrainIDIntoDatabase(TrackRef)
            ElseIf gCreateTrain Then
                pTrain.CrewCurrent.ApplyCrewString(pTrain.CrewCurrentString)
                pTrain.CrewRelief.ApplyCrewString(pTrain.CrewReliefString)
                pTrain.CrewPending.ApplyCrewString(pTrain.CrewPendingString)
                pTrain.InsertNewTrainIDIntoDatabase(gtblTrainsActive)
            End If
            If gSimulationMode Then
                trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(pTrain.TrackGUID)
                If Not trk Is Nothing Then
                    trk.Occuppied = True
                    trk.SignalStatOnMe = TrackComponents.Track.SignalStatus.SignalAtStop
                    trk.UpdateStatus()
                End If
            End If
            If CurrentTrain.ConsistChange Then
                CurrentTrain.ConsistSent = True
                pTrain.PerformConsistDatabaseUpdatePTC()
            End If
            Return True
        Catch ex As Exception
            Me.ExceptionEvent(ex.ToString)
        Finally
            trainExists = Nothing
            trk = Nothing
            actTrn = Nothing
        End Try
    End Function

