    Private Sub LoadOSTimes(ByVal trn As TrainID)
        Dim Tempdrow As DataRow
        Dim OSDT As New DataTable
        Dim OS As String
        Dim OsString() As String
        Dim item As ListViewItem
        Try
            If optEnableDenverSpecificOptions Then Exit Sub
            OSDT = TMDS.SystemUtilities.DefineDataTables.DefineOSDatatable()
            lvOS.Items.Clear()
            For Each OS In trn.OSTimes
                OsString = OS.Split("|")
                ' Me.OSTimes.Add(OsPoint & "|" & OsTime & "|" & SubName
                If OsString.Length >= 3 Then
                    Dim OSTime As Date
                    Date.TryParse(OsString(1), OSTime)
                    Tempdrow = OSDT.NewRow
                    Tempdrow("OSPOINT") = OsString(0)
                    Tempdrow("SUBNAME") = OsString(2)
                    If optEnableTrainFunctionalityARRC Then
                        Tempdrow("OSTIME") = Format(OSTime, optSystemDateTimeFormat3)
                    Else
                        Tempdrow("OSTIME") = OSTime
                    End If
                    OSDT.Rows.Add(Tempdrow)
                    OSDT.AcceptChanges()
                End If
            Next

            If OSDT IsNot Nothing AndAlso OSDT.Rows.Count > 0 Then
                Dim dv As DataView = New DataView(OSDT)
                If optEnableCNSpecificOptions Then dv.Sort = "OSTIME DESC"
                If dv.Count > 0 Then
                    For i As Integer = 0 To dv.Count - 1
                        Dim OSTM As String = dv(i)("OSTIME")
                        Dim SubName As String = dv(i)("SUBNAME")
                        item = New ListViewItem(OSTM)
                        Me.lvOS.Items.Add(item)
                        item.SubItems.Add(dv(i)("OSPOINT"))
                        If optEnablePortugueseResourceLanguageFile Then
                            If SubName.Trim.ToUpper = "NOT AVAILABLE" Then item.SubItems.Add(mstrTrainID_NotAvailable)
                        Else
                            item.SubItems.Add(SubName)
                        End If
                        item = Nothing
                    Next
                End If
            End If


        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Sub

