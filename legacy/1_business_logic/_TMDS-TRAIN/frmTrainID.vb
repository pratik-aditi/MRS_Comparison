    Private Sub DoCrewSwapToReliefCrew()
        Try

            Dim MessageList As New ArrayList()
            If Not IsNothing(Me.SwapTrain) Then
                Dim TrainName, NameOfSwapTrain As String
                If optApplyTrainSheetConfigurationForKCS Then
                    NameOfSwapTrain = Me.SwapTrain.PseudoName
                    TrainName = Me.CurrentTrain.PseudoName
                Else
                    NameOfSwapTrain = Me.SwapTrain.Name
                    TrainName = Me.CurrentTrain.Name
                End If
                If SwapTrain.ReadOnlySymbol Then
                    MessageList.Add("CANNOT UPDATE A VIEWED TRAIN FROM ANOTHER DESK.")
                    ShowCustomMessageBox(MessageList, "TRANSFER CREW CHECK", False, Nothing, False, True, Me, True, "OK", Nothing, True)
                    Exit Sub
                End If


                Dim frmMessageBox As frmMessageBox
                MessageList.Add(mstrTrainString1)
                MessageList.Add(mstrTrainString2 & NameOfSwapTrain)
                MessageList.Add(mstrTrainString2 & TrainName)
                MessageList.Add("")
                MessageList.Add(mstrTrainString3)
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = Me
                frmMessageBox.SetMessage(MessageList, mstrTrainString4, True, New Point(Me.Left + 50, Me.Top + 50))
                frmMessageBox.TopMost = True
                frmMessageBox.ShowDialog()
                If frmMessageBox.FormFeedBack = 6 Then


                    SwapTrain.CrewReliefString = CurrentTrain.CrewCurrent.CreateCrewString()
                    SwapTrain.CrewRelief.ApplyCrewString(SwapTrain.CrewReliefString)
                    SwapTrain.UpdateTrainIDIntoDatabase(Me.SwapTrain.myTrack, True, "DOCrewSwapToReliefCrew")

                    CurrentTrain.CrewReliefString = SwapTrain.CrewCurrent.CreateCrewString()
                    CurrentTrain.CrewRelief.ApplyCrewString(CurrentTrain.CrewReliefString)
                    CurrentTrain.UpdateTrainIDIntoDatabase(Me.CurrentTrain.myTrack, True, "DOCrewSwapToReliefCrew")
                    ApplyReliefCrew(CurrentTrain)
                End If
                frmMessageBox = Nothing
                MessageList = Nothing

            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
