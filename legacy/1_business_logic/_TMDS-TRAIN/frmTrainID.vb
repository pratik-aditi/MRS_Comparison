                    ElseIf Me.tbcTrain.SelectedTab Is tbOSTimes Then
                        setControls.AddRange(New Object() {lvOS, btnOK, btnCancel, btnPrint})
                    ElseIf Me.tbcTrain.SelectedTab Is tbComments Then
                        setControls.AddRange(New Object() {lvCommentsTrain, lvCommentsUnit, btnOK, btnCancel, btnPrint})
                    ElseIf Me.tbcTrain.SelectedTab Is tbDelays Then
                        setControls.AddRange(New Object() {lvDelays, btnOK, btnCancel, btnPrint})
                    ElseIf Me.tbcTrain.SelectedTab Is tbEvents Then
                        setControls.AddRange(New Object() {lvEvents, btnOK, btnCancel, btnPrint})
                    End If
                End If
                ' remove any non-visible controls
                setControls = RemoveNonVisibleAndDisabledControls(setControls)

                ' get all the controls on the tab
                Dim lstControls As ArrayList = GetTabControls(Me.tbcTrain.SelectedTab.Controls)
                lstControls.Sort(New CompareControlIndexes)

                '' now add the controls not in the list already
                'For Each ctrl As Control In lstControls
                '    If Not setControls.Contains(ctrl) Then setControls.Add(ctrl)
                'Next

                ' since we are explicitly adding the controls we are tabbing through,
                ' then set all other visible controls to not have a TabStop
                For Each ctrl As Control In lstControls
                    If Not setControls.Contains(ctrl) Then
                        ctrl.TabStop = False
                    End If
                Next

                ' select the next control either forwards or backwards
                Dim index As Integer = 0
                If setControls.Contains(Me.ActiveControl) Then
                    ' we are dealing with a control within the set
                    index = GetIndex(forward, setControls, setControls.IndexOf(Me.ActiveControl))
                    setControls(index).select()
                Else
                    ' we are dealing with a control outside of the set 
                    ' so try a custom tab, if not then default the tab
                    If Not SelectCustomControl() Then setControls(index).select()
                End If

                ' finally return the value that the control has been selected so ignore the implicit TAB command
                Return True
            End If
        Else
            Return MyBase.ProcessTabKey(forward)
        End If
    End Function

    ''' <summary>
    ''' Selects a custom control based upon the Selected Tab and Active Control.
    ''' </summary>
    ''' <returns>Boolean value to determine if a contro was selected.</returns>
    ''' <remarks>WGROH - Nov 13, 2012 - Added for BRC Tab order request.</remarks>
    Private Function SelectCustomControl() As Boolean
        Dim selected As Boolean = False
        If Me.tbcTrain.SelectedTab Is Me.tbCrew Then
            Select Case Me.ActiveControl.Name
                Case Me.cmbEngR.Name
                    Me.txtTimeOnER.TabStop = True
                    Me.txtTimeOnER.Select()
                    selected = True
                Case Me.txtTimeOnER.Name
                    Me.txtDateOnER.TabStop = True
                    Me.txtDateOnER.Select()
                    selected = True
                Case Me.txtDateOnER.Name
                    Me.cmbCondR.TabStop = True
                    Me.cmbCondR.Select()
                    selected = True
                Case Me.cmbCondR.Name
                    Me.txtTimeOnCR.TabStop = True
                    Me.txtTimeOnCR.Select()
                    selected = True
                Case Me.txtTimeOnCR.Name
                    Me.txtDateOnCR.TabStop = True
                    Me.txtDateOnCR.Select()
                    selected = True
                Case Me.txtDateOnCR.Name
                    Me.btnApplyReliefCrew.TabStop = True
                    Me.btnApplyReliefCrew.Select()
                    selected = True
            End Select
        End If
        Return selected
    End Function

    Public Sub ResetTabOrder(ByRef ctrls As Control.ControlCollection)
        Try
            For Each ctrl As Control In ctrls
                If ctrl.TabStop = True Then
                    FormEvent("ResetTabOrder:" & ctrl.Name)
                    ctrl.TabIndex = 0
                End If
                If ctrl.HasChildren Then
                    ResetTabOrder(ctrl.Controls)
                End If
            Next
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Sub

