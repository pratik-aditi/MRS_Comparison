    Private Sub cmbOtherUnits_KeyDown(ByVal sender As System.Object, ByVal e As System.Windows.Forms.KeyEventArgs) Handles cmbOtherUnits.KeyDown
        Try
            Dim lv As ListViewItem

            If cmbOtherUnits.Text Is Nothing Then Exit Sub
            'If IsNothing(CurrentTrain) Then Exit Sub
            If cmbOtherUnits.Text.Trim <> "" Then
                If e.KeyCode = Keys.Enter Then

                    Dim ApplyStandardFormatting As Boolean = True
                    If optFormatEngineIDRuleFXE Then
                        ApplyStandardFormatting = False
                    End If
                    If optRailRoadName = "NCTD" OrElse optRailRoadName = "NCTD-PTC" Then ApplyStandardFormatting = False

                    If optFormatEngineIDRuleFXE Then
                        If Mid(Trim(Me.cmbOtherUnits.Text), 1, 2).ToUpper = "HR" Or
                           Mid(Trim(Me.cmbOtherUnits.Text), 1, 1).ToUpper = "V" Or
                           Mid(Trim(Me.cmbOtherUnits.Text), 1, 3).ToUpper = "FXE" Then
                            Me.cmbOtherUnits.Text = ""
                            Me.cmbOtherUnits.Focus()
                        ElseIf Not IsNumeric(Mid(Trim(Me.cmbOtherUnits.Text), 1, 1)) Then
                            ApplyStandardFormatting = True
                        End If
                    End If

                    If ApplyStandardFormatting Then
                        Dim Engine As String = Trim(cmbOtherUnits.Text.ToUpper)
                        If CheckEngineIDFormatting(Engine) Then
                            Me.cmbOtherUnits.Text = Engine
                        Else
                            Me.cmbOtherUnits.Text = ""
                        End If
                    End If

                    If Not optAllowTrainUnitDuplication Then
                        If Me.cmbOtherUnits.Text.Replace(" ", "").ToUpper <> Me.cmbUnitID.Text.Replace(" ", "").ToUpper Then
                            For Each lv In Me.lvUnits.Items
                                If lv.Text = Me.cmbOtherUnits.Text Then
                                    cmbOtherUnits.Text = ""
                                    Me.cmbOtherUnits.Focus()
                                    Exit Sub
                                End If
                            Next
                            If cmbOtherUnits.Text.Trim <> "" Then
                                lvUnits.Items.Add(cmbOtherUnits.Text.ToUpper)
                            End If
                            If optApplyTrainSheetConfigurationForARRC Then CurrentTrain.CalculateTotalTonAndTotalLength("frmTrainID_SaveModifyTrn2")
                        End If
                    Else
                        If cmbOtherUnits.Text.Trim <> "" Then
                            lvUnits.Items.Add(cmbOtherUnits.Text.ToUpper)
                        End If
                        If (optApplyTrainSheetConfigurationForARRC Or optApplyTrainSheetConfigurationForDenver) AndAlso Not IsNothing(CurrentTrain) Then
                            CurrentTrain.CalculateHorsePowerPerTon()
                            CurrentTrain.CalculateTPOB()
                            CurrentTrain.CalculateTotalTonAndTotalLength("frmTrainID_SaveModifyTrn3")
                        End If

                    End If

                    cmbOtherUnits.Text = ""
                    LastOtherUnits = String.Empty
                    For Each lv In lvUnits.Items
                        LastOtherUnits = LastOtherUnits & lv.Text & "|"
                    Next
                    Dim CurrentOtherUnits As String = String.Empty
                    If Not IsNothing(CurrentTrain) Then
                        Dim u As String
                        For Each u In CurrentTrain.Units
                            CurrentOtherUnits = CurrentOtherUnits & u & "|"
                        Next
                    End If

                    If CurrentOtherUnits <> LastOtherUnits Then ConsistChangeEventDetected = True


                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

