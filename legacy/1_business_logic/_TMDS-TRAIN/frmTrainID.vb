    Public Function GetFinalTrainFromDatabase(ByVal dbConnection As OleDbConnection, ByVal TrainID As String, ByVal FinalTime As Date) As TrainID
        Dim TrainFetch As String
        Dim dr As OleDbDataReader
        Dim DatabaseCommand As OleDbCommand
        Dim trn As TrainID
        Dim I As Integer
        Dim DataString() As String


        Try
            TrainFetch = "SELECT * FROM " & gtblTrainsInActive
            TrainFetch = TrainFetch & " WHERE Symbol = '" & TrainID & "'"
            TrainFetch = TrainFetch & " AND FinalTime = " & gQueryTimeDelimiter & FinalTime & gQueryTimeDelimiter
            DatabaseCommand = New OleDbCommand(TrainFetch, dbConnection)
            dbConnection.Open()
            dr = DatabaseCommand.ExecuteReader()
            While dr.Read()
                trn = New TrainID()
                With trn
                    .Name = dr.GetString(0)
                    .DisplayText = .Name
                    .IdentifingUnit = dr.GetString(1)
                    .TrackGUID = dr.GetInt32(5)

                    'Apply OS Times to Train
                    If Not dr.IsDBNull(6) Then
                        If Trim(dr.GetString(6)) <> "" Then
                            DataString = dr.GetString(6).Split(Chr(59))
                            For I = 0 To DataString.GetUpperBound(0) - 1
                                .OSTimes.Add(DataString(I) & ";")
                            Next
                        End If
                    End If
                    .SymbolComment = dr.GetString(7)
                    .Direction = dr.GetString(8)

                    '.ApplyTrainAbbreviation(gTrainAbbreviation)
                    If Not dr.IsDBNull(9) Then
                        .CallTime = dr.GetDateTime(9)
                    End If
                    'Apply Units to Train
                    If dr.GetString(10) <> "" Then
                        DataString = dr.GetString(10).Split(Chr(124))
                        For I = 0 To DataString.GetUpperBound(0)
                            .Units.Add(DataString(I))
                        Next
                    End If
                    .UnitComment = dr.GetString(11)
                    .DepTime = dr.GetDateTime(12)
                    .ArrTime = dr.GetDateTime(13)
                    .FinalTime = dr.GetDateTime(14)
                    .OLoads = dr.GetInt32(15)
                    .OEmts = dr.GetInt32(16)
                    .OTons = dr.GetInt32(17)
                    .OLength = dr.GetInt32(18)
                    .DLoads = dr.GetInt32(19)
                    .DEmts = dr.GetInt32(20)
                    .DTons = dr.GetInt32(21)
                    .DLength = dr.GetInt32(22)
                    .MaxSpd = dr.GetInt32(23)
                    .HorsePowerTrailing = dr.GetString(62)
                    .TonsPerOperativeBrake = dr.GetInt32(25)
                    .HazMat = dr.GetBoolean(26)
                    .HighWide = dr.GetBoolean(27)
                    .Origin = dr.GetString(28)
                    .Dest = dr.GetString(29)
                    .EOTD = dr.GetString(30)
                    .HOTD = dr.GetString(31)
                    If dr.FieldCount >= 82 Then
                        If Not dr.IsDBNull(78) Then
                            .CrewCurrentString = dr.GetString(78)
                        Else
                            .CrewCurrentString = .CrewCurrent.CreateCrewString
                        End If

                        If Not dr.IsDBNull(79) Then
                            .CrewReliefString = dr.GetString(79)
                        Else
                            .CrewReliefString = .CrewRelief.CreateCrewString
                        End If

                        If Not dr.IsDBNull(80) Then
                            .CrewPendingString = dr.GetString(80)
                        Else
                            .CrewPendingString = .CrewPending.CreateCrewString
                        End If
                    End If
                    trn.CrewCurrent.ApplyCrewString(trn.CrewCurrentString)
                    trn.CrewPending.ApplyCrewString(trn.CrewPendingString)
                    trn.CrewRelief.ApplyCrewString(trn.CrewReliefString)


                    'Apply Delays to Train
                    If dr.GetString(38) <> "" Then
                        DataString = dr.GetString(38).Split(Chr(124))
                        For I = 0 To DataString.GetUpperBound(0)
                            .DelayInfo.Add(DataString(I))
                        Next
                    End If

                    'Apply Bulletins to Train
                    If dr.GetString(39) <> "" Then
                        DataString = dr.GetString(39).Split(Chr(124))
                        For I = 0 To DataString.GetUpperBound(0)
                            .TrackBull.Add(DataString(I))
                        Next
                    End If

                    'Apply Setouts to Train
                    If dr.GetString(40) <> "" Then
                        DataString = dr.GetString(40).Split(Chr(124))
                        For I = 0 To DataString.GetUpperBound(0)
                            .BadOrderSetOuts.Add(DataString(I))
                        Next
                    End If


                    'Apply Train Sheet Events to Train
                    If dr.GetString(47) <> "" Then
                        DataString = dr.GetString(47).Split(Chr(124))
                        For I = 0 To DataString.GetUpperBound(0)
                            .TrainSheetEvents.Add(DataString(I))
                        Next
                    End If
                    If dr.FieldCount >= 137 Then
                        If Not dr.IsDBNull(136) Then Double.TryParse(dr.GetValue(136), .GrossTon)
                        If Not dr.IsDBNull(137) Then Double.TryParse(dr.GetValue(137), .TotalLength)
                    End If
                    If dr.FieldCount >= 141 Then
                        If Not dr.IsDBNull(138) Then .TrainHOS = dr.GetDateTime(138)
                        If Not dr.IsDBNull(139) Then Integer.TryParse(dr.GetValue(139), .TotalCars)
                        If Not dr.IsDBNull(140) Then .TrainVia = dr.GetString(140)
                        If Not dr.IsDBNull(141) Then .ReleaseTime = dr.GetDateTime(141)
                    End If

                    .TypeOfID = "TRAIN"
                End With
                Return trn
            End While
            DatabaseCommand.Dispose()
            DatabaseCommand = Nothing
            Return Nothing
        Catch ex As Exception
            SystemException(ex.ToString)
            dbConnection.Close()
            Return Nothing
        Finally
            dbConnection.Close()
        End Try
    End Function

