    Private Sub LoadTrainComments()
        Dim dbcomm As OleDbCommand
        Dim dbconn As OleDbConnection
        Dim dr As OleDbDataReader
        'Dim query As String = "SELECT EventLocation,EventTimeStamp,EventComments,CommentUID FROM tblTrainEventActiveComments WHERE TrainSheetUID = '" & Me.CurrentTrain.ActiveTrainSheetGUID & "' AND EventType = 'TRAIN' ORDER BY EventTimeStamp"
        Try
            If OptEnableTrainCommentSaveOnPostion AndAlso (gCreateTrain OrElse gPositionTrainID) AndAlso CurrentTrain Is Nothing AndAlso myTrainCommentsList IsNot Nothing AndAlso myTrainCommentsList.Count > 0 Then
                Dim clsTC As clsTrainComments = Nothing
                For Each clsTC In myTrainCommentsList
                    If clsTC IsNot Nothing AndAlso Not String.IsNullOrEmpty(clsTC.DataItems) AndAlso clsTC.TypeOfComment.ToUpper.Trim = "TRAIN" Then
                        Dim data() As String = clsTC.DataItems.Split("|")
                        If data.Length = 3 Then
                            Dim lv As New ListViewItem(data(0))

                            lv.SubItems.Add(data(1))
                            lv.SubItems.Add(data(2))
                            Me.lvCommentsTrain.Items.Add(lv)
                        End If
                    End If
                Next
                Exit Sub
            End If
            If CurrentTrain Is Nothing Then Exit Sub
            Dim query As String = "SELECT EventLocation,EventTimeStamp,EventComments,CommentUID FROM tblTrainEventActiveComments WHERE TrainSheetUID = '" & Me.CurrentTrain.ActiveTrainSheetGUID & "' AND EventType = 'TRAIN' ORDER BY EventTimeStamp"
            dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
            dbconn.Open()
            dbcomm = New OleDbCommand(query, dbconn)
            dr = dbcomm.ExecuteReader
            While dr.Read
                If Not dr.IsDBNull(0) And Not dr.IsDBNull(1) And Not dr.IsDBNull(2) Then
                    Dim lv As New ListViewItem
                    lv.Text = dr.GetString(0)
                    If optEnableTrainFunctionalityARRC Then
                        lv.SubItems.Add(Format(dr.GetDateTime(1), optSystemDateTimeFormat3))
                    Else
                        lv.SubItems.Add(Format(dr.GetDateTime(1), optSystemDateTimeFormat4))
                    End If
                    lv.SubItems.Add(dr.GetString(2))
                    lv.SubItems.Add(dr.GetString(3))
                    Me.lvCommentsTrain.Items.Add(lv)
                End If
            End While
            dbconn.Close()
            dbconn = Nothing
            Me.lvCommentsTrain.Refresh()

        Catch ex As Exception
            SystemException(ex.ToString)
            dbconn = Nothing
        End Try
    End Sub

    Private Sub LoadTrainUnitComments()
        Dim dbcomm As OleDbCommand
        Dim dbconn As OleDbConnection
        Dim dr As OleDbDataReader
        Try
            If OptEnableTrainCommentSaveOnPostion AndAlso (gCreateTrain OrElse gPositionTrainID) AndAlso CurrentTrain Is Nothing AndAlso myTrainCommentsList IsNot Nothing AndAlso myTrainCommentsList.Count > 0 Then
                Dim clsTC As clsTrainComments = Nothing
                For Each clsTC In myTrainCommentsList

                    If clsTC IsNot Nothing AndAlso Not String.IsNullOrEmpty(clsTC.DataItems) AndAlso (clsTC.TypeOfComment.ToUpper.Trim = "UNIT" OrElse clsTC.TypeOfComment.ToUpper.Trim = "UNITFAIL") Then
                        Dim data() As String = clsTC.DataItems.Split("|")
                        If data.Length = 3 Then
                            Dim lv As New ListViewItem(data(0))

                            lv.SubItems.Add(data(1))
                            lv.SubItems.Add(data(2))
                            Me.lvCommentsTrain.Items.Add(lv)
                        End If
                    End If
                Next
                Exit Sub
            End If
            If CurrentTrain Is Nothing Then Exit Sub
            Dim query As String = "SELECT EventLocation,EventTimeStamp,EventComments,EntityUID,CommentUID FROM tblTrainEventActiveComments WHERE TrainSheetUID = '" & Me.CurrentTrain.ActiveTrainSheetGUID & "' AND EventType in ('UNIT','UNITFAIL') ORDER BY EventTimeStamp"
            dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
            dbconn.Open()
            dbcomm = New OleDbCommand(query, dbconn)
            dr = dbcomm.ExecuteReader
            While dr.Read
                If Not dr.IsDBNull(0) And Not dr.IsDBNull(1) And Not dr.IsDBNull(2) Then
                    Dim lv As New ListViewItem
                    lv.Text = dr.GetString(3)
                    lv.SubItems.Add(dr.GetString(0))
                    If optEnableTrainFunctionalityARRC Then
                        lv.SubItems.Add(Format(dr.GetDateTime(1), optSystemDateTimeFormat3))
                    Else
                        lv.SubItems.Add(Format(dr.GetDateTime(1), optSystemDateTimeFormat4))
                    End If
                    lv.SubItems.Add(dr.GetString(2))
                    lv.SubItems.Add(dr.GetString(4))
                    Me.lvCommentsUnit.Items.Add(lv)
                End If
            End While
            dbconn.Close()
            dbconn = Nothing
            If optEnableTrainUnitColor = True Then UpdateTrainUnitColorComments()
        Catch ex As Exception
            SystemException(ex.ToString)
            dbconn = Nothing
        End Try
    End Sub

    Private Sub DeleteComment()
        Dim dbcomm As OleDbCommand
        Dim dbconn As OleDbConnection
        Dim query As String '= "SELECT EventLocation,EventTimeStamp,EventComments, EntityUID FROM tblTrainEventActiveComments WHERE TrainSheetUID = '" & Me.CurrentTrain.ActiveTrainSheetGUID & "' AND EventType in ('UNIT','UNITFAIL') ORDER BY EventTimeStamp"
        Try
            Dim lv As ListViewItem
            Dim FoundItem As ListViewItem = Nothing
            Dim TrainComments As Boolean
            Dim CommentUID As String = String.Empty
            For Each lv In Me.lvCommentsTrain.Items
                If lv.Selected Then
                    FoundItem = lv
                    TrainComments = True
                    CommentUID = lv.SubItems(3).Text
                    Exit For
                End If
            Next
            If IsNothing(FoundItem) Then
                For Each lv In Me.lvCommentsUnit.Items
                    If lv.Selected Then
                        FoundItem = lv
                        CommentUID = lv.SubItems(4).Text
                        Exit For
                    End If
                Next
            End If
            If IsNothing(FoundItem) Then Exit Sub

            query = "DELETE FROM tblTrainEventActiveComments WHERE CommentUID ='" & CommentUID & "'"
            dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
            dbconn.Open()
            dbcomm = New OleDbCommand(query, dbconn)
            dbcomm.ExecuteNonQuery()
            dbconn.Close()
            dbconn = Nothing
            If TrainComments Then
                lvCommentsTrain.Items.Remove(FoundItem)
                lvCommentsTrain.Refresh()
            Else
                lvCommentsUnit.Items.Remove(FoundItem)
                lvCommentsUnit.Refresh()
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
            dbconn = Nothing
        End Try
    End Sub
#End Region

#Region "TRAIN SHEET EVENTS"

    Private Sub AddTrainSheetEvent(ByVal EventType As String, ByVal EventData As String, ByVal IdentifingPointUID As String, ByVal IdentifingPointName As String, ByVal RailroadUID As String, Optional ByVal UseThisEventTime As Boolean = False, Optional ByVal EventTimeToUse As Date = Nothing, Optional trn As TrainID = Nothing)
        Dim q As String = "'"
        Dim s As String = ","
        Dim EventForThisTrain As TrainID = CurrentTrain
        Dim EvtTimeStamp As Date = Now
        Try
            If trn IsNot Nothing Then
                EventForThisTrain = trn
            End If
            If EventForThisTrain Is Nothing Then
                Exit Sub
            End If
            If UseThisEventTime AndAlso IsValidDate(EventTimeToUse) Then
                EvtTimeStamp = EventTimeToUse
            End If
            Dim theGUID As String = Guid.NewGuid.ToString.ToUpper
            Dim Insert As New System.Text.StringBuilder
            Insert.Append("INSERT INTO tblTrainEventActiveOther")
            Insert.Append(" (")
            Insert.Append(" EventUID, TrainSheetUID, EventType, EventTimeStamp, EventTimeZone, EventData, ")
            Insert.Append(" IdentifingPointUID, IdentifingPointName, RailroadUID, ReportData")
            Insert.Append(" )")
            Insert.Append(" VALUES (")
            Insert.Append(q & theGUID & q & s)
            Insert.Append(q & EventForThisTrain.ActiveTrainSheetGUID & q & s)
            Insert.Append(q & EventType & q & s)
            Insert.Append(q & EvtTimeStamp.ToString & q & s)
            Insert.Append(q & Mid(EventForThisTrain.myTrack.TimeZone, 1, 1) & q & s)
            Insert.Append(q & EventData & q & s)
            Insert.Append(q & IdentifingPointUID & q & s)
            Insert.Append(q & IdentifingPointName & q & s)
            Insert.Append(q & RailroadUID & q & s)
            Insert.Append(q & EventForThisTrain.GetTrainReportDataString("NONE", 0) & q)
            Insert.Append(" )")
            EventForThisTrain.AddTrainEvent(EventType, EventData, IdentifingPointName, theGUID, IdentifingPointUID)
            SystemDatabaseCommandToDynamicTrain("AddTrainSheetEvent", Insert.ToString)
            If optSaveTrainEventsToEventLog Then
                FormEvent("AddTrainSheetEvent:TRAIN EVENT: @" & Format(EvtTimeStamp, "MM-dd-yyyy HH:mm:ss") & " - TRAIN[" & EventForThisTrain.Name & "] " & " - EVENT: " & EventData & " - LOCATION: " & IdentifingPointName & " - DISPATCHER: " & gCurrentUser.UserFullName)
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

