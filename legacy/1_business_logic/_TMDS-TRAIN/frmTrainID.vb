    ''' <summary>
    ''' Fiters the passed list of controls which have the following properties:
    ''' Visible = True
    ''' Enabled = True
    ''' </summary>
    ''' <param name="controls">ArrayList of controls to filter.</param>
    ''' <returns>Filtered list of controls.</returns>
    ''' <remarks>WGROH - Nov 7, 2012 - Added for BRC Tab order request.</remarks>
    Private Function RemoveNonVisibleAndDisabledControls(ByVal controls As ArrayList) As ArrayList
        Dim setControls As ArrayList = controls
        For Each ctrl As Control In controls
            If Not ctrl.Visible OrElse Not ctrl.Enabled Then
                setControls.Remove(ctrl)
                setControls = RemoveNonVisibleAndDisabledControls(setControls)
                Exit For
            End If
        Next
        Return setControls
    End Function

    ''' <summary>
    ''' Filters a list of controls on the passed tab which have the following properties:
    ''' TabStop = True
    ''' Visible = True
    ''' Enabled = True
    ''' </summary>
    ''' <param name="ctrls">Control collection to filter.</param>
    ''' <returns>Filtered list of controls.</returns>
    ''' <remarks>WGROH - Nov 7, 2012 - Added for BRC Tab order request.</remarks>
    Private Function GetTabControls(ByVal ctrls As Control.ControlCollection) As ArrayList
        Dim controlList As New ArrayList
        Try
            For Each ctrl As Control In ctrls
                If ctrl.HasChildren Then
                    controlList.AddRange(GetTabControls(ctrl.Controls))
                ElseIf ctrl.TabStop AndAlso ctrl.Visible AndAlso ctrl.Enabled Then
                    controlList.Add(ctrl)
                End If
            Next
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
        Return controlList
    End Function

    ''' <summary>
    ''' Returns the index of the next control in the passed list, either forward or backward.
    ''' </summary>
    ''' <param name="forward">boolean value to move either forward or backward.</param>
    ''' <param name="controls">List of controls to move through.</param>
    ''' <param name="currentIndex">Index of the current control.</param>
    ''' <remarks>WGROH - Nov 7, 2012 - Added for BRC Tab order request.</remarks>
    Private Function GetIndex(ByVal forward As Boolean, ByVal controls As ArrayList, ByVal currentIndex As Integer) As Integer
        Dim tabIndex As Integer
        If forward Then
            If currentIndex = controls.Count - 1 Then
                tabIndex = 0
            Else
                tabIndex = currentIndex + 1
            End If

        Else
            If currentIndex = 0 Then
                tabIndex = controls.Count - 1
            Else
                tabIndex = currentIndex - 1
            End If

        End If
        Return tabIndex
    End Function

    ''' <summary>
    ''' Overrides the Tab Key function on the form to customize the control tabbing settings.
    ''' </summary>
    ''' <param name="forward">Indicates of the movement is forward or backward.</param>
    ''' <returns>Boolean value indicating if the control has been selected.</returns>
    ''' <remarks>WGROH - Nov 7, 2012 - Added for BRC Tab order request.</remarks>
    Protected Overrides Function ProcessTabKey(ByVal forward As Boolean) As Boolean
        If optOverrideTabOrder Then

            If TypeOf Me.ActiveControl Is TabControl Then
                Dim setControls As New ArrayList

                ' set the list of tab pages we are using
                setControls.AddRange(Me.tbcTrain.TabPages)

                ' select the next tab page either forwards or backwards
                Dim index As Integer = GetIndex(forward, setControls, setControls.IndexOf(Me.tbcTrain.SelectedTab))
                Me.tbcTrain.SelectTab(index)

                ' finally return the value that the tab page has been selected so ignore the implicit TAB command
                Return True

            ElseIf Me.tbcTrain.SelectedTab Is tbTrainInfo OrElse Me.tbcTrain.SelectedTab Is tbCrew OrElse Me.tbcTrain.SelectedTab Is tbComp _
            OrElse Me.tbcTrain.SelectedTab Is tbTrainMovements OrElse Me.tbcTrain.SelectedTab Is tbComments OrElse Me.tbcTrain.SelectedTab Is tbDelays _
            OrElse Me.tbcTrain.SelectedTab Is tbEvents OrElse Me.tbcTrain.SelectedTab Is tbOSTimes Then
                Dim setControls As New ArrayList

                If optEnableBRCSpecificChecks Then
