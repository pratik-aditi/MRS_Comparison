    'HomeRoadCodeList
    Private Function LoadHomeRoadCodeList() As Boolean
        Dim ds As New DataSet
        Dim drow As DataRow = Nothing
        Try
            Me.cmbHomeRoad.Items.Clear()
            Me.cmbHomeRoad.Items.Add("")
            ds = GetResultDS("Select * from tblSystemHomeRoadCode ", True)
            If IsValidDataset(ds) Then
                For Each drow In ds.Tables(0).Rows
                    'HomeRoadCode
                    With Me.cmbHomeRoad.Items
                        .Add(drow("HomeRoadCode"))
                    End With
                Next
            End If
            If optApplyTrainSheetConfigurationForNMRX Then
                If Me.cmbHomeRoad.Text = "" Then
                    Me.cmbHomeRoad.Text = "NMRX"
                End If
            ElseIf optApplyTrainSheetConfigurationForBRC Then
                If Me.cmbHomeRoad.Text = "" Then
                    Me.cmbHomeRoad.Text = ""
                End If
                Me.cmbHomeRoad.DropDownStyle = ComboBoxStyle.DropDownList
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        Finally
            ds = Nothing
        End Try
        Return True
    End Function

    'LoadOtherDeskInfo
    Private Function LoadOtherDeskInfo() As Boolean
        Dim drow As DataRow = Nothing
        Try
            dsOtherWorkstation = New DataSet
            Me.cmbSendViewTrain.Items.Clear()
            Dim SQLQuery As String = "Select * from tblSystemWorkstations where type='Dispatcher' and WrkstnName<>'" & gWorkStationName & "' "
            If (gPositionTrainID OrElse gCreateTrain) Then
            Else
                SQLQuery = "Select * from tblSystemWorkstations WHERE PublishScreenShotView=1 AND Type='Dispatcher' and WrkstnName<>'" & gWorkStationName & "' "
            End If
            dsOtherWorkstation = GetResultDS(SQLQuery, True)
            If IsValidDataset(dsOtherWorkstation) Then
                For Each drow In dsOtherWorkstation.Tables(0).Rows
                    With Me.cmbSendViewTrain.Items
                        .Add(drow("WrkstnName"))
                    End With
                Next
            End If
            Me.cmbSendViewTrain.Items.Insert(0, "SELECT")
            cmbSendViewTrain.SelectedIndex = 0
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        Finally
        End Try
        Return True
    End Function

