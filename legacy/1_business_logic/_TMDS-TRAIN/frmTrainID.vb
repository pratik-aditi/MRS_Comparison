    Private Function CheckForValidCharacter(ByVal ChrsToCheck As ArrayList) As Boolean
        Try
            Dim chr As String
            For Each chr In ChrsToCheck
                Select Case chr.ToUpper
                    Case "A", "B", "C", "D", "E", "F", "I", "J", "K", "L", "M", "N", "H", "G", "O", "P", "R", "S", "T", "Q", "U", "V", "W", "X", "Y", "Z", " "
                    Case 1, 2, 3, 4, 5, 6, 7, 8, 9, 0
                    Case Else
                        Return False
                End Select
            Next
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Private Function ValidateSymbolCharacters(ByVal TrainSymbol As String) As String
        Try
            Dim chr As String
            Dim NewString As New System.Text.StringBuilder
            For Each chr In TrainSymbol
                Select Case chr.ToUpper
                    Case "A", "B", "C", "D", "E", "F", "I", "J", "K", "L", "M", "N", "H", "G", "O", "P", "R", "S", "T", "Q", "U", "V", "W", "X", "Y", "Z", " "
                        NewString.Append(chr)
                    Case 1, 2, 3, 4, 5, 6, 7, 8, 9, 0
                        NewString.Append(chr)
                End Select
            Next
            Return NewString.ToString
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function

    ''' <summary>
    ''' Format TLSA prefix by adding - in the second prefix position
    ''' </summary>
    ''' <param name="prefix"></param>
    ''' <returns></returns>
    Private Function FormatPrefixTLSA(ByRef prefix As String) As String
        Try
            prefix.Trim()
            If prefix.Length > 0 Then
                prefix = prefix.Insert(1, "-")
            End If
            Return prefix
        Catch ex As Exception
            SystemException(ex.ToString)
            Return Nothing
        End Try
    End Function
    Private Function FormatTrainSymbol(ByRef TrainSymbol As String) As Boolean
        Try
            Dim SymbolArray As New ArrayList()
            Dim ch As String

            TrainSymbol = TrainSymbol.ToUpper
            TrainSymbol = TrainSymbol.Replace(" ", "")
            For Each ch In TrainSymbol
                SymbolArray.Add(ch)
            Next
            If SymbolArray.Count = 0 Then
                Return False
            End If

            Dim TrainType As String = SymbolArray.Item(0)

            'Check for second character as space. No space, then add one
            If SymbolArray.Item(1) <> " " Then
                SymbolArray.Insert(1, " ")
            End If

            'Check for the last character if not a foriegn train
            'If (SymbolArray.Item(SymbolArray.Count - 1) <> "A") And (SymbolArray.Item(SymbolArray.Count - 1) <> "S") And (SymbolArray.Item(SymbolArray.Count - 1) <> "T") And (TrainType <> "F") And (TrainType <> "U") Then
            If (SymbolArray.Item(SymbolArray.Count - 1) <> "A") And (IsNumeric(SymbolArray.Item(SymbolArray.Count - 1))) And (TrainType <> "F") Then
                SymbolArray.Add("A")
            ElseIf (IsNumeric(SymbolArray.Item(SymbolArray.Count - 1))) And (TrainType = "F") Then
                If IsNumeric(SymbolArray.Item(2)) Then
                    SymbolArray.Add("A")
                Else
                    SymbolArray.Add(SymbolArray.Item(2))
                End If
            ElseIf (IsNumeric(SymbolArray.Item(SymbolArray.Count - 1))) And (TrainType = "U") Then
                SymbolArray.Add("A")
            End If

            'Check for tenth character as space. No space, then add one
            If SymbolArray.Item(SymbolArray.Count - 4) <> " " Then
                SymbolArray.Insert(SymbolArray.Count - 3, " ")
            End If


            Select Case TrainType
                Case "F"
                    If SymbolArray.Count < 13 Then
                        Dim CharsNeeded As Integer = 13 - SymbolArray.Count
                        Dim I As Integer
                        For I = 1 To CharsNeeded
                            SymbolArray.Insert(SymbolArray.Count - 5, " ")
                        Next
                    ElseIf SymbolArray.Count > 13 Then
                        Return False
                    End If

                    If (Not IsNumeric(SymbolArray.Item(8))) Or (Not IsNumeric(SymbolArray.Item(10))) Or (Not IsNumeric(SymbolArray.Item(11))) Then
                        Return False
                    End If

                    If SymbolArray.Item(8) = 0 Then
                        Return False
                    End If
                    If SymbolArray.Item(10) > 3 Then
                        Return False
                    End If

                    Dim j As Integer
                    For j = 1 To SymbolArray.Count
                        Select Case j
                            Case 1, 2, 10, 4, 5, 6, 7, 8

                            Case 3, 9, 11, 12
                                If Trim(SymbolArray(j - 1)) = "" Then
                                    Return False
                                End If
                            Case 13
                                SymbolArray(12) = SymbolArray(2)
                            Case Else
                                Return False

                        End Select
                    Next

                    If Not CheckForValidDate(SymbolArray(10) & SymbolArray(11)) Then
                        Return False
                    End If

                Case "A", "T"

                    If SymbolArray.Count < 13 Then
                        Dim CharsNeeded As Integer = 13 - SymbolArray.Count
                        Dim I As Integer
                        For I = 1 To CharsNeeded
                            SymbolArray.Insert(SymbolArray.Count - 5, " ")
                        Next
                    ElseIf SymbolArray.Count > 13 Then
                        Return False
                    End If

                    If (Not IsNumeric(SymbolArray.Item(8))) Or (Not IsNumeric(SymbolArray.Item(10))) Or (Not IsNumeric(SymbolArray.Item(11))) Then
                        Return False
                    End If
                    If TrainType = "A" And SymbolArray.Item(8) = 0 Then
                        Return False
                    End If
                    If SymbolArray.Item(10) > 3 Then
                        Return False
                    End If

                    Dim j As Integer
                    For j = 1 To SymbolArray.Count
                        Select Case j
                            Case 1, 2, 10, 4, 5, 6, 7, 8

                            Case 3, 9, 11, 12
                                If Trim(SymbolArray(j - 1)) = "" Then
                                    Return False
                                End If
                            Case 13
                                If SymbolArray(j - 1) = "" Then
                                    Return False
                                ElseIf SymbolArray(j - 1).ToString.ToUpper <> "D" Then
                                    If SymbolArray(j - 1).ToString.ToUpper <> "R" Then
                                        If TrainType = "T" Then
                                            Return False
                                        End If
                                    End If
                                End If
                            Case Else
                                Return False

                        End Select
                    Next

                    If Not CheckForValidDate(SymbolArray(10) & SymbolArray(11)) Then
                        Return False
                    End If

                Case "Y", "R", "L"

                    If SymbolArray.Count < 13 Then
                        Return False
                    End If

                    Dim j As Integer
                    For j = 1 To SymbolArray.Count
                        Select Case j
                            Case 1, 2, 10, 13, 11, 12

                            Case 3, 4, 5
                                If IsNumeric(SymbolArray(j - 1)) Or SymbolArray(j - 1) = " " Then
                                    Return False
                                End If

                            Case 6, 7, 8
                                If Not IsNumeric(SymbolArray(j - 1)) Then
                                    Return False
                                End If

                            Case 9
                                If Not IsNumeric(SymbolArray(j - 1)) Then
                                    Return False
                                Else
                                    If SymbolArray(j - 1) = 0 Then
                                        Return False
                                    End If
                                End If
                            Case Else
                                Return False

                        End Select
                    Next

                    If SymbolArray.Item(10) > 3 Then
                        Return False
                    End If


                    If Not CheckForValidDate(SymbolArray(10) & SymbolArray(11)) Then
                        Return False
                    End If

                Case "C", "E", "U"
                    If SymbolArray.Count < 13 Then
                        Return False
                    Else
                        If SymbolArray(8) = 0 And SymbolArray(10) = 0 And SymbolArray(11) = 0 Then
                            Return False
                        End If
                    End If

                    Dim j As Integer
                    For j = 1 To SymbolArray.Count
                        Select Case j
                            Case 1, 2, 10
                            Case 3, 4, 5, 6, 7, 8
                                If IsNumeric(SymbolArray(j - 1)) Or SymbolArray(j - 1) = " " Then
                                    Return False
                                End If

                            Case 9, 11, 12
                                If TrainType <> "U" Then
                                    If Not IsNumeric(SymbolArray(j - 1)) Then
                                        Return False
                                    End If
                                    'If SymbolArray(11) = 0 Then
                                    '    Return False
                                    'End If
                                Else
                                    If Not IsNumeric(SymbolArray(8)) Then
                                        Return False
                                    End If
                                End If
                            Case 13
                                If TrainType = "U" And SymbolArray(j - 1) = "T" Then
                                    If Not IsNumeric(SymbolArray(8)) And Not IsNumeric(SymbolArray(10)) And Not IsNumeric(SymbolArray(11)) Then
                                        Return False
                                    End If

                                    'If SymbolArray(11) = 0 Then
                                    '    Return False
                                    'End If

                                ElseIf TrainType = "U" And SymbolArray(j - 1) <> "T" Then
                                    'If IsNumeric(SymbolArray(9 - 1)) Or IsNumeric(SymbolArray(11 - 1)) Or IsNumeric(SymbolArray(12 - 1)) Then
                                    '    Return False
                                    'End If

                                    If Not CheckForValidDate(SymbolArray(10) & SymbolArray(11)) Then
                                        Return False
                                    End If

                                    If SymbolArray(8) = 0 Then
                                        Return False
                                    End If

                                End If
                            Case Else
                                Return False
                        End Select
                    Next


                Case "N", "I"
                    Return False

                Case Else
                    If SymbolArray.Count < 13 Then
                        Return False
                    End If

                    Dim j As Integer
                    For j = 1 To SymbolArray.Count
                        Select Case j
                            Case 1, 2, 10, 13, 11, 12

                            Case 3, 4, 5, 6, 7, 8
                                If IsNumeric(SymbolArray(j - 1)) Or SymbolArray(j - 1) = " " Then
                                    Return False
                                End If

                            Case 9
                                If Not IsNumeric(SymbolArray(j - 1)) Then
                                    Return False
                                Else
                                    If SymbolArray(j - 1) = 0 Then
                                        Return False
                                    End If
                                End If
                            Case Else
                                Return False

                        End Select
                    Next

                    If SymbolArray.Item(10) > 3 Then
                        Return False
                    End If

                    If Not CheckForValidDate(SymbolArray(10) & SymbolArray(11)) Then
                        Return False
                    End If

            End Select


            If Not CheckForValidCharacter(SymbolArray) Then
                Return False
            End If


            Dim ReplacementSymbol As String = String.Empty
            For Each ch In SymbolArray
                ReplacementSymbol = ReplacementSymbol & ch
            Next
            'Me.TextBox1.Text = ReplacementSymbol
            TrainSymbol = ReplacementSymbol
            Return True

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    Private Function CheckTrainSymbolForBNSFTypeTrain(ByRef TrainSymbol As String) As Boolean
