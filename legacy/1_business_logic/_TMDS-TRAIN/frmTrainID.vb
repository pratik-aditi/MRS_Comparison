                            If IsValidTimestr(OffReleaseTime) Then txtTimeRelOffC.Text = OffReleaseTime : txtTimeRelOffC.Tag = OffReleaseTime Else txtTimeRelOffC.Text = "hhmm"
                            If IsValidDateString(OffReleaseDate) Then txtDateRelOffC.Text = OffReleaseDate : txtDateRelOffC.Tag = OffReleaseDate Else txtDateRelOffC.Text = "mmddyy"
