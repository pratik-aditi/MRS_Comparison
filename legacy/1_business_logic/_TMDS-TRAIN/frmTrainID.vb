#Region "FORM TIMERS"

    Private Sub tmrMessageProcessor_Tick(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles tmrMessageProcessor.Tick
        Try
            Dim tempQueue As Queue = Nothing
            SyncLock gTrainSheetMessageQueue
                If gTrainSheetMessageQueue.Count > 0 Then
                    tempQueue = gTrainSheetMessageQueue.Clone
                    gTrainSheetMessageQueue.Clear()
                End If
            End SyncLock

            If Not IsNothing(tempQueue) Then
                While tempQueue.Count > 0
                    Dim Message As String = tempQueue.Dequeue
                    Dim CurrenrTabPage As TabPage = tbcTrain.SelectedTab
                    Select Case Message
                        Case "REFRESHTRAINSHEET"
                            ClearPropertiesOnForm(False, False, False)
                            ApplyTrainPropertiesToForm(CurrentTrain)
                        Case "REFRESHTRAINRESTRICTIONS"
                            LoadTrainRestrictions(CurrentTrain)
                    End Select
                    If CurrenrTabPage IsNot Nothing Then tbcTrain.SelectTab(CurrenrTabPage)
                End While

            End If

            tmrMessageProcessor.Enabled = True
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

