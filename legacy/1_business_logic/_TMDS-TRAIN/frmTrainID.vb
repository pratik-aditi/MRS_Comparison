    Sub PositionTrain(ByRef TrackReference As Track, ByVal FormLocation As Point)
        Dim warr As Warrant
        Dim strPosition As Integer
        Dim EngineId As String = String.Empty
        Dim TrainIDFound As Boolean
        Try
            Me.Location = FormLocation
            Dim LeftPosition As Integer = TMDS.SystemForms.MySystemForms.frmMainMDI.Left + TrackReference.CurrentDrawingForm.Left
            Dim LoadPoint As New Point(LeftPosition) '+ FormLocation.X, FormLocation.Y)
            'Me.Location = LoadPoint
            TrackRef = TrackReference
            Application.DoEvents()
            GetActiveTrainSymbols()
            GetTrainUnits()
            Me.cmbTrainID.DropDownStyle = ComboBoxStyle.DropDown
            If TrackReference.Authorities.Count > 0 Then
                warr = TrackReference.Authorities(0)
                strPosition = InStr(warr.IssueTo, "EAST")
                If strPosition = 0 Then
                    strPosition = InStr(warr.IssueTo, "WEST")
                    If strPosition = 0 Then
                        strPosition = InStr(warr.IssueTo, "NORTH")
                        If strPosition = 0 Then
                            strPosition = InStr(warr.IssueTo, "SOUTH")
                            If strPosition <> 0 Then
                                cmbDirection.Text = "SOUTH"
                            Else
                                cmbDirection.Text = "EAST"
                            End If
                        Else
                            cmbDirection.Text = "NORTH"
                        End If
                    Else
                        cmbDirection.Text = "WEST"
                    End If
                Else
                    cmbDirection.Text = "EAST"
                End If
                If strPosition > 0 Then
                    EngineId = Trim(Mid(warr.IssueTo, 1, strPosition - 1))
                Else
                    EngineId = warr.IssueTo
                End If
                Dim trn As ActiveTrn
                For Each trn In Me.ActiveTrains
                    If trn.EngineID = EngineId Then
                        Me.cmbTrainID.Text = trn.Symbol
                        TrainIDFound = True
                        Exit For
                    End If
                Next
            End If
            If Not TrainIDFound Then
                Me.cmbUnitID.Text = EngineId
                Me.lblAuxVeh.Text = String.Empty
            End If
            SetFormValues()
            Try
                If gPositionTrainID Then
                    Me.cmbTrainID.Text = optTrainString19 '"ENTER SYMBOL"
                    Me.cmbDirection.Text = "NONE"
                    Me.tbcTrain.SelectedIndex = 0
                    If optEnableCNSpecificOptions Then
                        cmbTrainID.Select()
                        cmbTrainID.SelectAll()
                        cmbTrainID.Focus()
                    End If
                    Me.gbSubTrainSheet.Enabled = False
                End If
            Catch
            End Try
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub SetFormValues()
        Try
            If optCreateTrainTimes Then
                Me.dtDepTime.Text = Format(Now, "hh:mm")
                Me.dtArrTime.Text = Format(Now, "hh:mm")
            End If
            If optEnableARRCSpecificOptions Then
                Me.dtArrDate.Value = CDate("1/1/1900")
                Me.dtDepDate.Value = CDate("1/1/1900")
            Else
                Me.dtArrDate.Value = Now
                Me.dtDepDate.Value = Now
            End If



        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

    Sub ApplyTrainPropertiesFromForm(ByRef pTrain As TrainID)

        Dim item As ListViewItem
        Dim TrainUnitChangeDetected As Boolean
        Try
            If IsNothing(pTrain) Then
                Exit Sub
            End If

            With pTrain
                ApplyCrewFromForm(pTrain)

                If gSimulationMode And .SimulateMode Then
                    If Me.chkSimulate.Checked = False Then
                        pTrain.TerminateSimulation()
                        Me.lblSim.Visible = False
                        Me.nudSimSpeed.Visible = False
                        pTrain.SimulateMode = False
                        Me.chkSimulate.Visible = False
                    Else
                        pTrain.SimulationSpeed = Me.nudSimSpeed.Value * 1000
                    End If
                End If

                .Name = Me.cmbTrainID.Text
                .PseudoName = Me.txtPseudoName.Text

                If .IdentifingUnit <> Me.cmbUnitID.Text Then
                    TrainUnitChangeDetected = True
                End If

                .IdentifingUnit = Me.cmbUnitID.Text

                If .Direction <> Me.cmbDirection.Text Then
                    .Direction = Me.cmbDirection.Text
                Else
                    .Direction = Me.cmbDirection.Text
                End If

                .EOTD = Me.txtEOTD.Text
                .HOTD = Me.txtHOTD.Text

                If IsNumeric(Me.txtHPT.Text) Then
                    If Not HorsePowerPerTonChange Then
                        .HorsePowerTrailing = Me.txtHPT.Text ' Format(Me.txtHPT.Text, "0.00")
                    End If
                Else
                    .HorsePowerTrailing = 0.0
                End If

                If IsNumeric(Me.nudTHP.Text) Then
                    .TotalHorsePower = Me.nudTHP.Text
                Else
                    .TotalHorsePower = 0
                End If

                If IsNumeric(Me.nudTOPB.Text) Then
                    .TonsPerOperativeBrake = Me.nudTOPB.Text
                End If

                If IsNumeric(Me.nudMaxSpd.Text) Then
                    .MaxSpd = Me.nudMaxSpd.Text
                End If

                .HazMat = Me.chkHaz.CheckState
                .HighWide = Me.chkHIGH.CheckState
                .KeyTrain = Me.chkKey.CheckState
                .HelperTrain = Me.chkBoxHelper.CheckState
                .PullerTrain = Me.chkPuller.CheckState
                .SpecialNotation = Me.chkNote.CheckState

                Try
                    If .Units.Count <> Me.lvUnits.Items.Count Then
                        TrainUnitChangeDetected = True
                    End If
                    For Each item In Me.lvUnits.Items
                        If Not .Units.Contains(item.Text) Then
                            TrainUnitChangeDetected = True
                        End If
                    Next
                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try

                .Units.Clear()

                For Each item In Me.lvUnits.Items
                    If Not .Units.Contains(item) Then
                        .Units.Add(item.Text)
                    End If
                Next

                .Origin = Me.cmbOrg.Text
                .DepTime = CheckDate(Me.dtDepDate.Value.ToLongDateString, Me.dtDepTime.Text)

                If IsNumeric(Me.nudEmpO.Text) Then
                    .OEmts = Me.nudEmpO.Text
                End If
                If IsNumeric(Me.nudLenO.Text) Then
                    .OLength = Me.nudLenO.Text
                End If
                If IsNumeric(Me.nudLoadO.Text) Then
                    .OLoads = Me.nudLoadO.Text
                End If
                If IsNumeric(Me.nudTonO.Text) Then
                    .OTons = Me.nudTonO.Text
                End If

                .Dest = Me.cmbDes.Text
                .ArrTime = CheckDate(Me.dtArrDate.Value.ToLongDateString, Me.dtArrTime.Text)

                If IsNumeric(Me.nudEmpD.Text) Then
                    .DEmts = Me.nudEmpD.Text
                End If
                If IsNumeric(Me.nudLenD.Text) Then
                    .DLength = Me.nudLenD.Text
                End If
                If IsNumeric(Me.nudLoadD.Text) Then
                    .DLoads = Me.nudLoadD.Text
                End If
                If IsNumeric(Me.nudTonD.Text) Then
                    .DTons = Me.nudTonD.Text
                End If

                If IsNumeric(Me.nudAxles.Value) Then
                    .NumberOfAxles = Me.nudAxles.Value
                End If

                If IsNumeric(Me.nudBrakes.Value) Then
                    .NumberOperatingBrakes = Me.nudBrakes.Value
                End If

                .TrainType = Me.cmbTrainType.Text
                .SubType = Me.cmbSubType.Text
                .CBTCEquipped = Me.chkCBTCEquipped.Checked
                .IsTestCBTC = Me.chkTestCBTC.Checked
                .MiscInfoOne = Me.txtMiscInfo.Text
                .HomeRoadCode = Me.cmbHomeRoad.Text

                If IsNumeric(Me.cmbGTB.Text) Then
                    If .GTBNum <> CInt(Me.cmbGTB.Text) Then
                        UpdateTrainSheetRoute(CInt(Me.cmbGTB.Text), pTrain)
                    End If
                    .GTBNum = CInt(Me.cmbGTB.Text)
                End If

                .TrainHOS = Me.dtTrainHOS.Value
                .TotalCars = Me.nudTotalCars.Value
                .TrainVia = Me.txtVia.Text
                .ReleaseTime = Me.dtTrnReleaseTime.Value

                If TrainUnitChangeDetected Or IdentifingUnitChanged Then
                    Dim PerformUnitUpdate As New DoUpdateTrainUnitInformation(AddressOf pTrain.UpdateTrainUnits)
                    If optApplyTrainSheetConfigurationForCN OrElse optApplyTrainSheetConfigurationForMRS Then
                        PerformUnitUpdate.BeginInvoke("frmTrainConsist.ApplyTrainPropertiesFromForm", False, Nothing, Nothing)
                    ElseIf optApplyTrainSheetConfigurationForARRC Then
                        PerformUnitUpdate.BeginInvoke("frmTrainConsist.ApplyTrainPropertiesFromForm", True, Nothing, Nothing)
                    Else
                        PerformUnitUpdate.BeginInvoke("frmTrainConsist.ApplyTrainPropertiesFromForm", False, Nothing, Nothing)
                    End If
                    If optEnableAutoGenerateClearance Then
                        pTrain.DoCreateClearanceForTrain()
                    End If

                    If gModifyTrainID Then
                        If optEnableMessagingEDI Then
                            TMDS.NetworkMessages.CadMessages.SendTrainUnitUpdateEDI(pTrain)
                        End If
                    End If

                End If

            End With
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub UpdateTrainSheetRoute(ByVal GTBUID As Int32, ByVal trn As TrainID)
        Dim FetchTrnRte As String = "SELECT TrnShtRoute Name FROM tblSystemBulletinsGeneral WHERE UID = " & GTBUID
        Dim DatabaseCommand As OleDbCommand
        Dim DataReader As OleDbDataReader
        Dim dbconn As OleDb.OleDbConnection
        Dim TrnShtRte As String = "NONE"

        Try
            dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
            DatabaseCommand = New OleDbCommand(FetchTrnRte, dbconn)
            dbconn.Open()
            DataReader = DatabaseCommand.ExecuteReader()
            While DataReader.Read()
                TrnShtRte = DataReader.GetString(0)
            End While
            DatabaseCommand = Nothing
            dbconn.Close()
            dbconn = Nothing

            If TrnShtRte <> "NONE" Then
                Dim Update As String = "UPDATE tblTrainsActive SET TrainSheetRoute = '" & TrnShtRte & "' WHERE Symbol = '" & trn.Name & "'"
                SystemDatabaseCommandToDynamicTrain("TRAINSUMMARY:UpdateTrainSheetRoute", Update)
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub ApplyCrewFromForm(ByVal trn As TrainID)
        Try
            ApplyCurrentCrewFromForm(trn)
            ApplyReliefCrewFromForm(trn)
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

