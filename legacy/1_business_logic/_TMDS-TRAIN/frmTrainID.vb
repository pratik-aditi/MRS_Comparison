    Private Sub PopulateOnOffReleaseString(ByVal OnOffReleaseString As String)
        Dim OnReleaseString As New StringBuilder
        Dim spltOnOffReleaseString() As String
        Dim S As String = ""
        Dim Designation As String = ""
        Dim OnRelTm As String = ""
        Dim OnReleaseDate As String = ""
        Dim OffReleaseTime As String = ""
        Dim OffReleaseDate As String = ""

        Try
            If OnOffReleaseString.Trim = "" Then Exit Sub
            '<Designation>|<OnRelTm>|<OnReleaseDate>|<OffReleaseTime>|<OffReleaseDate>;<Designation>|<OnRelTm>|<OnReleaseDate>|<OffReleaseTime>|<OffReleaseDate>;
            spltOnOffReleaseString = OnOffReleaseString.Split(";")
            If spltOnOffReleaseString.GetUpperBound(0) > 0 Then
                For Each S In spltOnOffReleaseString
                    Dim subSplt() As String = S.Split("|")
                    Designation = ""
                    OnRelTm = ""
                    OnReleaseDate = ""
                    OffReleaseTime = ""
                    OffReleaseDate = ""
                    If subSplt.GetUpperBound(0) > 0 Then Designation = subSplt(0).Trim.ToUpper
                    If subSplt.GetUpperBound(0) > 1 Then OnRelTm = subSplt(1).Trim
                    If subSplt.GetUpperBound(0) > 2 Then OnReleaseDate = subSplt(2).Trim
                    If subSplt.GetUpperBound(0) > 3 Then OffReleaseTime = subSplt(3).Trim
                    If subSplt.GetUpperBound(0) >= 4 Then OffReleaseDate = subSplt(4).Trim
                    Select Case Designation.Trim.ToUpper
                        Case "ENGINEER"
                            If IsValidTimestr(OnRelTm) Then txtTimeRelOnE.Text = OnRelTm : txtTimeRelOnE.Tag = OnRelTm Else txtTimeRelOnE.Text = "hhmm"
