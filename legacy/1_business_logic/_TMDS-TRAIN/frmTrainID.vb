    Private Function CheckDateTime(ByVal StringToTest As String) As String
        Try
            Try
                If IsValidDate(StringToTest) Then
                    Dim TestDate As Date = CDate(StringToTest)
                    Return StringToTest
                End If

            Catch
                Return "NONE"
            End Try
        Catch ex As Exception
            SystemException(ex.ToString)
            Return "NONE"
        End Try
        Return "NONE"
    End Function

    ''' <summary>
    ''' Apply Train Properties To Form
    ''' </summary>
    ''' <param name="train"></param>
    ''' <param name="retreievSubTrainSheets"></param>
    Sub ApplyTrainPropertiesToForm(train As TrainID,
                                   Optional retreievSubTrainSheets As Boolean = False)
        Try
            If train Is Nothing Then
                If String.IsNullOrWhiteSpace(txtPseudoName.Text) Then txtPseudoName.Text = cmbTrainID.Text
                Exit Sub
            End If
            SystemEvent($"{GetCurrentMethod.Name} Train={train.Name}")
            With train
                ApplyCurrentCrew(train)
                ApplyReliefCrew(train)
                If optEnableTrainRestrictionFunctions Then train.PerformTrainRestrictions()
                If gSimulationMode And train.SimulateMode Then
                    chkSimulate.Visible = True
                    lblSim.Visible = True
                    nudSimSpeed.Visible = True
                    nudSimSpeed.Value = train.SimulationSpeed / 1000
                    If train.SimulateMode Then chkSimulate.Checked = True
                End If
                cmbTrainID.Text = .Name
                If Not optApplySystemSummaryConfigurationForBRC Then
                    If String.IsNullOrWhiteSpace(train.PseudoName) AndAlso
                        Not optApplyTrainSheetConfigurationForKCS Then
                        Try
                            Dim eng() As String = train.IdentifingUnit.Split(" ")
                            Dim EngNum As String = String.Empty
                            If eng.Length > 2 Then
                                EngNum = eng(eng.Length - 1).TrimStart
                            End If
                            Dim TrainName As String = Mid(.Name, 1, 1) & Mid(.Name, 6, 1) & Mid(.Name, 7, 1) & Mid(.Name, 8, 1) & EngNum
                            txtPseudoName.Text = TrainName '.Name
                        Catch
                        End Try
                    Else
                        If String.IsNullOrWhiteSpace(train.PseudoName) Then
                            txtPseudoName.Text = cmbTrainID.Text
                        Else
                            txtPseudoName.Text = .PseudoName
                        End If
                    End If
                Else
                    txtPseudoName.Text = .PseudoName
                End If
                cmbUnitID.Text = FindAuxVeihID(.IdentifingUnit)
                If optEnablePTCOperations AndAlso .IsActivePTC Then
                    cmbUnitID.DropDownStyle = ComboBoxStyle.Simple
                    cmbUnitID.BackColor = Color.LightGreen
                End If
                If Not String.IsNullOrWhiteSpace(.Direction) Then cmbDirection.Text = .Direction
                Me.txtEOTD.Text = .EOTD
                Me.txtHOTD.Text = .HOTD
                Me.nudMaxSpd.Text = .MaxSpd
                Me.chkHaz.Checked = .HazMat
                Me.chkKey.Checked = .KeyTrain
                Me.chkNote.Checked = .SpecialNotation
                Me.chkPuller.Checked = .PullerTrain
                Me.chkBoxHelper.Checked = .HelperTrain
                Me.chkHIGH.Checked = .HighWide
                For Each unit As Object In .Units
                    If Not String.IsNullOrWhiteSpace(unit) Then lvUnits.Items.Add(unit)
                Next
                RefreshUnitProperties()
                If optEnableTrainUnitColor = True Then UpdateTrainUnitColor()
                Me.cmbOrg.Text = .Origin
                Me.cmbTrainOrg.Text = .Origin
                Me.cmbDes.Text = .Dest
                cmbTrainDest.Text = .Dest
                Me.dtDepTime.Text = Format(.DepTime, "HH:mm")
                Try
                    dtDepDate.Value = .DepTime.ToShortDateString
                Catch
                End Try
                If .OEmts > 0 Then
                    If .OEmts <= Me.nudEmpO.Maximum Then
                        Me.nudEmpO.Text = .OEmts
                    End If
                    If .OEmts <= Me.nudEmpties.Maximum Then
                        Me.nudEmpties.Text = .OEmts
                    End If
                End If
                If .OLength > 0 Then
                    If .OLength <= Me.nudLenO.Maximum Then
                        Me.nudLenO.Text = .OLength
                    End If
                    If .OEmts <= Me.nudLength.Maximum Then
                        Me.nudLength.Text = .OLength
                    End If
                End If
                If .OLoads > 0 Then
                    If .OLoads <= Me.nudLoadO.Maximum Then
                        Me.nudLoadO.Text = .OLoads
                    End If
                    If .OLoads <= Me.nudLoads.Maximum Then
                        Me.nudLoads.Text = .OLoads
                    End If
                End If
                If .OTons > 0 Then
                    If .OTons <= Me.nudTonO.Maximum Then
                        Me.nudTonO.Text = .OTons
                    End If
                    If .OTons <= Me.nudTons.Maximum Then
                        Me.nudTons.Text = .OTons
                    End If
                End If
                Try
                    If .DEmts > 0 AndAlso .DEmts <= Me.nudEmpD.Maximum Then Me.nudEmpD.Text = .DEmts
                    If .DLength > 0 AndAlso .DLength <= Me.nudLenD.Maximum Then Me.nudLenD.Text = .DLength
                    If .DLoads > 0 AndAlso .DLoads <= Me.nudLoadD.Maximum Then Me.nudLoadD.Text = .DLoads
                    If .DTons > 0 AndAlso .DTons <= Me.nudTonD.Maximum Then Me.nudTonD.Text = .DTons
                    If .NumberOfAxles > 0 AndAlso .NumberOfAxles <= Me.nudAxlesAlt.Maximum Then Me.nudAxlesAlt.Text = .NumberOfAxles
                    If .NumberOperatingBrakes > 0 AndAlso .NumberOperatingBrakes <= Me.nudBrakesAlt.Maximum Then Me.nudBrakesAlt.Text = .NumberOperatingBrakes
                    If .NumberOfAxles > 0 AndAlso .NumberOfAxles <= Me.nudAxles.Maximum Then Me.nudAxles.Text = .NumberOfAxles
                    If .NumberOfAxles > 0 AndAlso .NumberOfAxles <= Me.nudAxlesAlt.Maximum Then Me.nudAxlesAlt.Text = .NumberOfAxles
                    If .NumberOperatingBrakes > 0 AndAlso .NumberOperatingBrakes <= Me.nudBrakes.Maximum Then Me.nudBrakes.Text = .NumberOperatingBrakes
                    If .NumberOperatingBrakes > 0 AndAlso .NumberOperatingBrakes <= Me.nudBrakesAlt.Maximum Then Me.nudBrakesAlt.Text = .NumberOperatingBrakes
                Catch ex As Exception
                End Try
                cmbDes.Text = .Dest
                cmbTrainDest.Text = .Dest
                txtGrossTons.Text = .GrossTon
                txtTotalLength.Text = .TotalLength
                dtArrTime.Text = Format(.ArrTime, "HH:mm")
                Try
                    dtArrDate.Value = .ArrTime.ToShortDateString
                Catch
                End Try
                train.GetOsRecords()
                AddOsTimes(train)
                If IsNumeric(.HorsePowerTrailing) AndAlso Not Double.IsInfinity(.HorsePowerTrailing) Then
                    txtHPT.Text = Format(CDbl(.HorsePowerTrailing), "#" & optHPTStringFormat)
                Else
                    txtHPT.Text = optHPTStringFormat
                End If
                If IsNumeric(.TotalHorsePower) Then
                    If .TotalHorsePower > 99999 Then
                        Me.nudTHP.Value = 99999
                    Else
                        Me.nudTHP.Value = .TotalHorsePower
                    End If
                End If
                If IsNumeric(.TonsPerOperativeBrake) Then
                    If .TonsPerOperativeBrake > 99999 Then
                        Me.nudTOPB.Value = 99999
                    Else
                        Me.nudTOPB.Value = .TonsPerOperativeBrake
                    End If
                End If
                Try
                    cmbTrainType.Text = .TrainType
                Catch
                End Try
                Try
                    cmbSubType.Text = .SubType
                Catch
                End Try
                Try
                    cmbScheduleType.Text = .ScheduleType
                Catch
                End Try
                If IsValidDate(.TrainHOS) Then
                    Try
                        Me.dtTrainHOS.Value = .TrainHOS
                    Catch ex As Exception
                    End Try
                End If
                Me.nudTotalCars.Value = .TotalCars
                Me.txtVia.Text = .TrainVia
                If IsValidDate(.ReleaseTime) Then
                    Try
                        Me.dtTrnReleaseTime.Value = .ReleaseTime
                    Catch ex As Exception
                    End Try
                End If
                If IsValidDate(.CallTime) Then
                    Try
                        dtAnounceTime.Text = Format(.CallTime, "HH:mm")
                        dtAnounceDate.Value = Format(.CallTime, "MM/dd/yyyy")
                    Catch ex As Exception
                    End Try
                End If
                chkCBTCEquipped.Checked = .CBTCEquipped
                chkTestCBTC.Checked = .IsTestCBTC
                If IsValidDate(.DepTime) Then
                    Try
                        Me.dtDepDateAlt.Value = Me.dtDepDate.Value
                        Me.dtDepTimeAlt.Text = Me.dtDepTime.Text
                    Catch ex As Exception
                    End Try
                End If
                Try
                    Dim bull As String
                    For Each bull In .TrackBull
                        If bull <> "" Then
                            Me.lvBulletins.Items.Add(bull)
                        End If
                    Next
                Catch
                End Try
                txtMiscInfo.Text = .MiscInfoOne
                cmbHomeRoad.Text = .HomeRoadCode
                Dim index As Integer = cmbRestrictionType.FindString(train.RestrictionType)
                cmbRestrictionType.SelectedIndex = If(index < 0, 0, index)
                cmbGTB.Text = .TGBONumber
                txtSchDepTime.Text = .SchTimeDeparture
                txtSchArrTime.Text = .SchTimeArrival
            End With
            If retreievSubTrainSheets Then
                RetreiveSubTrainSheet(train)
            End If
            If optDisableModifyTrain Then
                RemoveHandler cmbTrainID.Leave, AddressOf cmbTrainID_Leave
                DisableModifyEdit()
            End If
            If optEnableWorkOrderFunctions Then
                LoadWorkOrders(train)
            End If
            If optEnableTrainRestrictionFunctions Then
                LoadTrainRestrictions(train)
            End If
            If optEnableTrainScheduleFunctions Then
                If optEnableARRCSpecificOptions Then
                    train.LoadTrainSchedules()
                End If
                LoadTrainSchedules(train)
            End If
            If optEnableTrainCarFunctions Then
                If optEnableARRCSpecificOptions Then
                    train.PerformTrainCarLoading()
                End If
                LoadTrainCars(train)
            End If
            If optEnableTrainEventFunctions Then
                LoadTrainEvents(train)
            End If
            LoadTrainDelays(train)
            If train.GeoFenceLegacyEnabled Then
                If optApplyTrainSheetConfigurationForMRS Then
                    If nudMaxSpd.Value > 50 Then
                        chkForceEmptySpeed.Checked = True
                        nudMaxSpd.Value = 70
                    ElseIf train.GeoFenceLegacyEnabled Then
                        nudMaxSpd.Value = 50
                    End If
                End If
            End If
            If train.IsActivePTC Then cmbTrainType.Enabled = False
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub DisableModifyEdit()
        Try
            Try
                Dim mi As MenuItem
                For Each mi In Me.ContextMenu.MenuItems
                    mi.Enabled = False
                Next
            Catch
            End Try

            Dim comp As Object
            comp = Nothing
            For Each comp In gbTrainID.Controls

                Select Case comp.name.ToString
                    Case "cmbDirection", "txtPseudoName"
                    Case Else
                        comp.Enabled = False
                End Select
            Next
            comp = Nothing
            For Each comp In gbOtherUnits.Controls
                comp.Enabled = False
            Next
            comp = Nothing
            For Each comp In gbOtherinfo.Controls
                comp.Enabled = False
            Next
            comp = Nothing
            For Each comp In gbSubTrainSheet.Controls
                comp.Enabled = False
            Next


            btnTrainConsistMessageUpdate.Enabled = False
            btnTrainUnitMessageUpdate.Enabled = False
            btnRelease.Enabled = False
            btnFinal.Enabled = False

            comp = Nothing
            For Each comp In gbCrewCurrent.Controls
                comp.Enabled = False
            Next
            comp = Nothing
            For Each comp In gbCrewRelief.Controls
                comp.Enabled = False
            Next
            comp = Nothing
            For Each comp In gbOrigin.Controls
                comp.Enabled = False
            Next
            comp = Nothing
            For Each comp In gbDestiniation.Controls
                comp.Enabled = False
            Next
            comp = Nothing
            lvOS.Enabled = False
            cmOS.Enabled = False
            lvBulletins.Enabled = False
            cmComment.Enabled = False
            lvCommentsTrain.Enabled = False
            lvCommentsUnit.Enabled = False
            lvDelays.Enabled = False
            cmDelay.Enabled = False
            lvEvents.Enabled = False



            Me.btnCancel.Enabled = True

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function GetCurrentTrainUnitsColor(ByVal UnitName As String) As Color

        Dim tu As TrainUnit
        Try
            For Each tu In CurrentTrain.UnitsInTrain
                If tu.UnitNumber = UnitName Then
                    If Not IsNothing(tu.UnitStatusColor) Then
                        Return tu.UnitStatusColor
                    End If
                    Exit For
                End If
            Next
            Return Nothing
        Catch ex As Exception

        End Try

    End Function

    Private Sub UpdateTrainUnitColor()
        Dim LvColor As Color = Nothing

        Dim lvSubItmds As ListViewItem
        For Each lvSubItmds In lvUnits.Items
            Try
                LvColor = GetCurrentTrainUnitsColor(lvSubItmds.Text)
                If Not IsNothing(LvColor) Then
                    lvSubItmds.UseItemStyleForSubItems = False
                    lvSubItmds.ForeColor = LvColor
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        Next
        LvColor = Nothing
    End Sub

