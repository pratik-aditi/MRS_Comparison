            '    lvItem.SubItems.Add(ts.myStationName)
            '    lvItem.SubItems.Add("D")
            '    lvItem.SubItems.Add(StationDepartureTime)
            '    lvScheduleDenver.Items.Add(lvItem)

            'Next
            lvScheduleDenver.Refresh()
        Catch ex As Exception
            SystemException(ex.ToString)
        Finally
            PS = Nothing
            ts = Nothing
            lvItem = Nothing
        End Try
