                                                            btnCrewSwap, btnCrewXferTO, btnCrewView, cmbTrainList,
                                                            cmbEngR, txtTimeOnER, txtDateOnER, txtTimeHosER, txtDateHosER,
                                                            cmbCondR, txtTimeOnCR, txtDateOnCR, txtTimeHosCR, txtDateHosCR,
                                                            cmbCond2R, txtTimeOnC2R, txtDateOnC2R, txtTimeHosC2R, txtDateHosC2R, txtTimeOffC2R, txtDateOffC2R,
                                                            cmbBrkR, txtTimeOnBR, txtDateOnBR, txtTimeHosBR, txtDateHosBR, txtTimeOffBR, txtDateOffBR,
                                                            cmbBrk2R, txtTimeOnB2R, txtDateOnB2R, txtTimeHosB2R, txtDateHosB2R, txtTimeOffB2R, txtDateOffB2R,
                                                            cmbEngTrneeR, txtTimeOnETR, txtDateOnETR, txtTimeHosETR, txtDateHosETR, txtTimeOffETR, txtDateOffETR,
                                                            cmbCondTrneeR, txtTimeOnCTR, txtDateOnCTR, txtTimeHosCTR, txtDateHosCTR, txtTimeOffCTR, txtDateOffCTR,
