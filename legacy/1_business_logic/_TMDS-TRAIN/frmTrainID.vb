    Private Sub btnOK_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnOK.Click
        Dim train As TrainID = Nothing
        Dim UseSecondaryPlacement As Boolean = False
        Dim MessageList As New ArrayList()
        Dim query As String = String.Empty
        Dim locoLeadDuplicated As String = String.Empty
        Dim dbReader As OleDbDataReader
        Dim dbComm As OleDbCommand
        Dim dbConn As OleDbConnection = TMDS.GlobalDeclarations.gDatabaseConnectionTrain
        Try
            FormEvent("CLICKED - BUTTON OK")
            If ViewTrainMode AndAlso optEnableUpdateDataFromViewTrainModify And IsNothing(SubTrainSheetTrain) Then
                ApplyReliefCrewFromForm(CurrentTrain)
                CurrentTrain.CrewReliefString = CurrentTrain.CrewRelief.CreateCrewString()
                CurrentTrain.UpdateReliefCrewFromViewTrain()
                Me.CloseForm()
                Exit Sub
            ElseIf ViewTrainMode AndAlso Not optEnableUpdateDataFromViewTrainModify Then
                Me.CloseForm()
                Exit Sub
            End If
            If Trim(Me.cmbTrainID.Text) = gTrainNotFound Or Trim(Me.cmbTrainID.Text) = "PREFIXO INCORRETO" Or Trim(Me.cmbTrainID.Text) = "INVALID DATE.." Then
                Me.cmbTrainID.Focus()
                Exit Sub
            End If
            If Me.cmbTrainID.Text = optTrainString19 Or Me.cmbTrainID.Text = mstrTrainString17 Or Me.cmbTrainID.Text = mstrTrainSymbolFormatErrorMessage Then
                Me.cmbTrainID.Focus()
                Exit Sub
            End If
            If optPerformTrainTonsCheck Then
                If Me.nudTonO.Value = 0 Then
                    MessageBox.Show(Me, "TRAIN TONANGE IS REQUIRED TO BE MORE THEN ZERO", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Exit Sub
                End If
            End If
            If optApplyTrainSheetConfigurationForBRC Then
                If cmbDirection.Text.Trim.ToUpper = "NONE" Then
                    Dim dr As DialogResult = MessageBox.Show(Me, "DIRECTION IS SET TO NONE." & vbCrLf & "IS THIS CORRECT?", "SYSTEM MESSAGE", MessageBoxButtons.YesNo, MessageBoxIcon.Warning)
                    If dr = Windows.Forms.DialogResult.No Then
                        cmbDirection.Focus()
                        cmbDirection.SelectAll()
                        Exit Sub
                    End If
                End If
                If cmbTrainType.Text.Trim = "" Then
                    Dim dr As DialogResult = MessageBox.Show(Me, "TRAIN TYPE IS LEFT BLANK." & vbCrLf & "IS THIS CORRECT?", "SYSTEM MESSAGE", MessageBoxButtons.YesNo, MessageBoxIcon.Warning)
                    If dr = Windows.Forms.DialogResult.No Then
                        cmbTrainType.Focus()
                        cmbTrainType.SelectAll()
                        Exit Sub
                    End If
                End If
            End If
            If optTrainTypeRequired Then
                If Not optApplyTrainSheetConfigurationForBRC AndAlso Trim(Me.cmbTrainType.Text) = "" Then
                    MessageBox.Show(Me, "TRAIN TYPE IS A REQUIRED FIELD", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Me.cmbTrainType.Focus()
                    Exit Sub
                End If
            End If
            If optEnableRoadCode And Not ViewTrainMode Then
                If Trim(Me.cmbHomeRoad.Text) = "" Then
                    MessageBox.Show(Me, "HOME ROAD CODE IS A REQUIRED FIELD", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Me.cmbHomeRoad.Focus()
                    Exit Sub
                End If
            End If
            If optCheckAlphaNumericPsesudoTrnName Then
                Select Case Me.txtPseudoName.Text.Trim
                    Case String.Empty
                        MessageBox.Show(Me, "TRAIN PSEUDO NAME IS A REQUIRED FIELD", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Me.txtPseudoName.Focus()
                        Exit Sub
                    Case Else
                        If checkAlphaNumeric(Me.txtPseudoName.Text.Trim) = False Then
                            MessageBox.Show(Me, "TRAIN PSEUDO NAME SHOULD BE ALPHA NUMERIC", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            Me.txtPseudoName.Focus()
                            Exit Sub
                        End If
                End Select
            End If
            If Trim(Me.cmbTrainID.Text) = "" Then
                MessageList = New ArrayList()
                MessageList.Add("TRAIN SYMBOL CANNOT BE BLANK")
                MessageList.Add("")
                ShowCustomMessageBox(MessageList, optTrainPositionString9, False, Me.Location, True, True, Me)
                Me.cmbTrainID.Focus()
                Exit Sub
            ElseIf cmbUnitID.Text.Trim.Length < 5 Then
                MessageList = New ArrayList()
                MessageList.Add(optTrainPositionString11)
                MessageList.Add(String.Empty)
                ShowCustomMessageBox(MessageList, optSystemMessageString3, False, Me.Location, True, True, Me)
                Me.cmbUnitID.Focus()
                Exit Sub
            ElseIf gPositionTrainID Then
                Me.Cursor = System.Windows.Forms.Cursors.WaitCursor

                Dim TrainAction As Integer = Me.CheckForTrainUse
                Select Case TrainAction
                    Case 0
                        Me.Cursor = System.Windows.Forms.Cursors.Default
                        Me.CloseForm()
                        Exit Sub
                    Case 1
                        Me.Cursor = System.Windows.Forms.Cursors.Default
                        Exit Sub
                    Case 2
                        ' keep on going this code
                        Try
                            If Not IsNothing(Me.PositionedTrain) Then
                                Me.cmbTrainID.Text = Me.PositionedTrain.Name
                            End If
                        Catch
                        End Try
                    Case 3
                        ' keep on going this code
                        UseSecondaryPlacement = True
                        Try
                            If Not IsNothing(Me.PositionedTrain) Then
                                Me.cmbTrainID.Text = Me.PositionedTrain.Name
                            End If
                        Catch
                        End Try
                End Select
                Me.Cursor = System.Windows.Forms.Cursors.Default
            End If
            If optEnableDisallowDuplicateEngineIDsToTrains Then
                Try
                    'Check if exist loco lead duplicate in the db. If so, show to dipatcher the symbol and control point assigned
                    'jcosta - 07/10/17
                    query = "SELECT TOP 1 TA.Symbol, CP.Name "
                    query += "FROM tmdsDatabaseDynamic.DBO.tblTrainsActive TA LEFT JOIN tmdsDatabaseStatic.dbo.tblCompTracks CT ON TA.TrackGUID = CT.UID "
                    query += "LEFT JOIN tmdsDatabaseStatic.dbo.tblCompControlPoints CP ON CT.ControlPoint = CP.UID "
                    query += "WHERE EngineID like '" & Me.cmbUnitID.Text & "' "
                    query += "AND TA.Symbol <> '" & Me.cmbTrainID.Text & "' "
                    query += "ORDER BY CP.Name DESC "
                    dbComm = New OleDbCommand(query, dbConn)
                    If dbConn.State = ConnectionState.Closed Then
                        dbConn.Open()
                    End If
                    dbReader = dbComm.ExecuteReader()
                    If dbReader.HasRows Then
                        While dbReader.Read()
                            locoLeadDuplicated = dbReader.GetString(0).ToString
                            If IsDBNull(dbReader.GetValue(1)) OrElse dbReader.GetString(1).ToString = String.Empty Then
                                locoLeadDuplicated += " NO PÁTIO DESCONHECIDO "
                            Else
                                locoLeadDuplicated += " NO PÁTIO " & dbReader.GetString(1).ToString & " "
                            End If
                        End While
                    End If
                    If dbConn.State = ConnectionState.Open Then
                        dbConn.Close()
                    End If
                    If locoLeadDuplicated <> String.Empty Then
                        MessageList = New ArrayList()
                        MessageList.Add("LOCOMOTIVA COMANDANTE [" & Me.cmbUnitID.Text & "] NÃO PODE SER INSERIDA, ")
                        MessageList.Add("POIS ESTÁ COM A MESMA LOCO COMANDANTE DO TREM " & locoLeadDuplicated & "!")
                        MessageList.Add("FAVOR ALTERAR A LOCOMOTIVA COMANDANTE OU REMOVER DO TREM " & locoLeadDuplicated)
                        FormEvent("LOCOMOTIVA COMANDANTE [" & Me.cmbUnitID.Text & "] NÃO PODE SER INSERIDA, POIS ESTÁ COM A MESMA LOCO COMANDANTE DO TREM " & locoLeadDuplicated)
                        ShowCustomMessageBox(MessageList, "LOCOMOTIVA DUPLICADA", False, Me.Location, True, True, Me)
                        Me.cmbUnitID.Focus()
                        Exit Sub
                    End If
                Catch ex As Exception
                    Me.ExceptionEvent(ex.ToString)
                End Try
            End If
            If gPositionTrainID Then
                If Not SavePositionTrain(UseSecondaryPlacement, train) Then Exit Sub
            ElseIf gModifyTrainID And Not ViewTrainMode Then
                If Not SaveModifyTrain() Then Exit Sub
            ElseIf gCreateTrain Then
                If Not SaveCreateTrain(train) Then Exit Sub
            ElseIf Me.ViewTrainMode Then
                If Not SaveViewTrain() Then Exit Sub
            ElseIf Me.ModifySysTrainMode Then
                ViewSystemTrn.UpdateTrainIDPendingCrewIntoDatabase(TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                ViewSystemTrn = Nothing
            End If
            If gPositionTrainID AndAlso optEnableLoadTrainSchedule AndAlso CurrentTrain IsNot Nothing Then
                CurrentTrain.LoadTrainSchedule()
            End If
            'If optApplyTrainSheetConfigurationForMRS AndAlso gPositionTrainID Then
            If optApplyTrainSheetConfigurationForMRS Then 'Request consist to save or modify
                If Not IsNothing(CurrentTrain) Then
                    TMDS.NetworkMessages.CadMessages.SendTrainConsistRequestForMRS(CurrentTrain, gCadTransmitQueue)
                ElseIf Not IsNothing(train) Then
                    TMDS.NetworkMessages.CadMessages.SendTrainConsistRequestForMRS(train, gCadTransmitQueue)
                End If
            End If
            'Send event for WabtecOne
            If Not IsNothing(train) Then
                TMDS.NetworkMessages.CadMessages.SendTrainEventForWabtecOne(train, "CREATED")
            ElseIf Not IsNothing(CurrentTrain) Then
                TMDS.NetworkMessages.CadMessages.SendTrainEventForWabtecOne(CurrentTrain, "UPDATED")
            End If
            Try
                Dim SummItem As New SummaryItem("TRAIN", "FORCE-REFRESH", Nothing)
                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                End SyncLock
            Catch ex As Exception
            End Try
            Me.CloseForm()
        Catch ex As Exception
            Me.Cursor = System.Windows.Forms.Cursors.Default
            Me.ExceptionEvent(ex.ToString)
            Me.CloseForm()
        Finally
            MessageList = Nothing
            dbConn = Nothing
            dbComm = Nothing
            dbReader = Nothing
        End Try
    End Sub

