    Private Delegate Sub DoLoadGTB(ByVal trn As TrainID)

    Private Sub LoadGTB(ByVal trn As TrainID)
        Dim dbconn As OleDbConnection
        Dim dbcomm As OleDbCommand
        Dim dr As OleDbDataReader

        Try
            Dim Query As String = "SELECT UID FROM tblSystemBulletinsGeneral WHERE Symbol = '" & trn.Name & "'"
            dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringBulletin)
            dbcomm = New OleDbCommand(Query, dbconn)
            dbconn.Open()
            dr = dbcomm.ExecuteReader
            While dr.Read
                If Not dr.IsDBNull(0) Then
                    If Not Me.cmbGTB.Items.Contains(dr.GetInt32(0)) Then
                        Me.cmbGTB.Items.Add(dr.GetInt32(0))
                    End If
                End If
            End While
            dbconn.Close()
            dbconn = Nothing
        Catch ex As Exception
            dbconn = Nothing
            Me.ExceptionEvent(ex.ToString)
        End Try
    End Sub

