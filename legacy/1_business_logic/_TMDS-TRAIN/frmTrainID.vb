    ''' <summary>
    ''' Set restriction types from config file
    ''' </summary>
    Private Sub SetRestrictionTypes()
        Try
            Dim configurationAppSettings As New AppSettingsReader()
            Dim trainRestrictionTypes As String() = DirectCast(configurationAppSettings.GetValue("TRAINRESTRICTIONTYPES", GetType(String)), String).Split(";")
            If trainRestrictionTypes.Count = 0 OrElse
                String.IsNullOrEmpty(trainRestrictionTypes(0)) Then
                cmbRestrictionType.Items.Add(optPTCDefaultRestrictionType)
                Exit Sub
            End If
            For Each restrictionType As String In trainRestrictionTypes
                cmbRestrictionType.Items.Add(restrictionType)
            Next
        Catch ex As Exception
            cmbRestrictionType.Items.Add(optPTCDefaultRestrictionType)
