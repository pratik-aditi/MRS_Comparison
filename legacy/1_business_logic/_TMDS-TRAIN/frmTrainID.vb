    Private Function IsValidTimestr(ByVal TimeStr As String) As Boolean
        Try
            If TimeStr.Trim = "" Then Return False
            If Date.TryParse(TimeStr, Nothing) Then Return True
        Catch ex As Exception
            GetErrorDetails(ex)
            Return False
        End Try
    End Function

    Function IsValidDateString(ByVal dtStr As String) As Boolean
        Try
            If dtStr.Trim = "" Then Return False
            If Date.TryParse(dtStr, Nothing) Then Return True
        Catch ex As Exception
            GetErrorDetails(ex)
            Return False
        End Try
    End Function

    Private Function ValidateReleaseOnOffDate(ByVal OnDateCntrl As TextBox, ByVal OnTimeCntrl As TextBox, ByVal OffDateCntrl As TextBox, ByVal OffTimeCntrl As TextBox) As Boolean
        Dim RDatestr As String = ""
        Dim ROnDate As Date
        Dim ROFFDate As Date
        Dim strRONDateTime As String = ""
        Dim strROFFDateTime As String = ""

        Try
            If IsValidDateString(OnDateCntrl.Text) AndAlso IsValidTimestr(OnTimeCntrl.Text) AndAlso IsValidDateString(OffDateCntrl.Text) AndAlso IsValidTimestr(OffTimeCntrl.Text) Then
                strROFFDateTime = OffDateCntrl.Text & " " & OffTimeCntrl.Text
                strRONDateTime = OnDateCntrl.Text & " " & OnTimeCntrl.Text
                strRONDateTime = Format(CDate(strRONDateTime), "MM-dd-yy HH:mm")
                strROFFDateTime = Format(CDate(strROFFDateTime), "MM-dd-yy HH:mm")
                If Date.TryParse(strROFFDateTime, ROFFDate) Then
                    If Date.TryParse(strRONDateTime, ROnDate) Then
                        Dim tmspan As TimeSpan = ROFFDate.Subtract(ROnDate)
                        If tmspan.TotalHours < 4 Then
                            Return False
                        Else
                            Return True
                        End If
                    End If
                End If
            End If
            Return True
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Function

