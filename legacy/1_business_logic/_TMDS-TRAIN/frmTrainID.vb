    ''' <summary>
    ''' Save Position Train
    ''' </summary>
    ''' <param name="useSecondaryPlacement"></param>
    ''' <param name="train">train object</param>
    ''' <returns></returns>
    Private Function SavePositionTrain(useSecondaryPlacement As Boolean,
                                      ByRef train As TrainID) As Boolean
        Try
            FormEvent($"{GetCurrentMethod.Name} Start")
            Dim newTrackRef As Track = TrackRef
            train = Nothing
            If optDisallowTrainIdPlacementOnTrackWithAuthorityOfOtherTrain AndAlso
                TrackRef.TrackAuthorities.Count > 0 Then
                For Each sfa As SFAuthority In TrackRef.TrackAuthorities.OfType(Of SFAuthority)
                    If Mid(sfa.IssueTo, 1, 10) <> cmbUnitID.Text Then
                        Dim message As New ArrayList() From {optTrainPositionString1,
                            optTrainPositionString2,
                            String.Empty}
                        Using frmMessageBox As New frmMessageBox()
                            frmMessageBox.Owner = Me
                            frmMessageBox.SetMessage(message,
                                                     optTrainPositionString9,
                                                     False,
                                                     New Point(Location.X + 100, Location.Y + 100))
                            frmMessageBox.TopMost = True
                            frmMessageBox.ShowDialog()
                        End Using
                        cmbTrainID.Focus()
                        Exit Function
                    End If
                Next
            End If
            Dim components As ArrayList = TrackRef.CollectComponentsOfLikeTracks()
            If components IsNot Nothing Then
                For Each CompToCheck As Object In components
                    If Not CompToCheck.Indicating Then
                        CompToCheck.Occuppied = True
                        CompToCheck.UpdateStatus()
                    End If
                    If TypeOf CompToCheck Is Switch Then
                        If CompToCheck.RightAltLink <> 0 Then
                            newTrackRef = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CompToCheck.LeftLink)
                        Else
                            newTrackRef = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CompToCheck.RightLink)
                        End If
                    End If
                Next
            End If
            TrackRef = newTrackRef
            If PositionedTrain Is Nothing Then
                train = New TrainID()
                train.DisplayEngineID = gDisplayEngineID
                train.IdentifingUnit = cmbUnitID.Text
                train.Name = cmbTrainID.Text
                train.TrainType = cmbTrainType.Text
                train.PseudoName = txtPseudoName.Text
                train.ActiveTrainSheetGUID = Guid.NewGuid.ToString.ToUpper
                train.RestrictionType = cmbRestrictionType.Text
            Else
                train = PositionedTrain
            End If
            CurrentTrain = train
            If CurrentTrain?.IsActivePTC AndAlso
                ActiveTrains?.OfType(Of ActiveTrn).
                Any(Function(theTrain) theTrain.Symbol.EqualsIgnoreCase(CurrentTrain.Name) AndAlso
                theTrain.InUse = 0) Then
                FormEvent($"{GetCurrentMethod.Name} Planned train {CurrentTrain.Name} is activated")
                If Not CurrentTrain.YesNoMessage(My.Resources.UserMessage3, , Me) Then Return False
            End If
            train.TrackGUID = TrackRef.GUID
            train.myTrack = newTrackRef
            train.SubID = newTrackRef.SubdivisionID
            train.TypeOfID = "TRAIN"
            train.ApplyTrainAbbreviation(gTrainAbbreviation)
            newTrackRef.AddTrainID(train)
            train.StackOrder = newTrackRef.TrainIDs.IndexOf(train)
            If Not newTrackRef.Indicating Then newTrackRef.Occuppied = True
            newTrackRef.UpdateStatus()
            CheckForConsistChangeOnTrainPTC()
            If CurrentTrain.ConsistChange Then
                If optEnablePTCBOSVETMSMode AndAlso
                    CurrentTrain.IsActivePTC Then
                    TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainConsistChange(CurrentTrain, GetCurrentMethod.Name)
                End If
                CurrentTrain.ConsistChange = False
            End If
            ApplyTrainInformation(train)
            If Not (gAssistMode OrElse train.myTrack.IsShadowMode) Then
                TMDS.NetworkMessages.CadMessages.SendTrainSymbolMove(train, gCadTransmitQueue, Nothing, newTrackRef, "D")
                Dim LogThisEvent As New DoEventLogTrainID(AddressOf train.LogTheTrainIDEvent)
                LogThisEvent.BeginInvoke(TrainID.EventTypeTrainID.POSITION, Nothing, Nothing)
                Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf train.PublishTrainEvent)
                PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.POSITION, Nothing, Nothing)
            End If
            If optEnableSendViewTrainOnPosition AndAlso
                (gPositionTrainID OrElse gCreateTrain) Then
                If cmbSendViewTrain.Text.Trim.ToUpper <> "SELECT" Then
                    NetworkMessages.CadMessages.SendViewTrainSymbolCreateOnOtherDesk(CurrentTrain,
                                                                                          gCadTransmitQueue,
                                                                                          cmbSendViewTrain.Text,
                                                                                          GetCurrentMethod.Name)
                End If
            End If
            If optEnableFlashTrainForHighWide OrElse
                optEnableFlashTrainForKey Then
                If CurrentTrain.HighWide OrElse
                    CurrentTrain.KeyTrain Then
                    CurrentTrain.EnableNotificationFlash(True)
                Else
                    CurrentTrain.EnableNotificationFlash(False)
                End If
            End If
            If gAssistMode AndAlso
                Not (gMaintenanceMode OrElse train.myTrack.IsShadowMode) Then
                Dim CommandThisEvent As New DoPublishTrainCommand(AddressOf train.PublishTrainCommand)
                CommandThisEvent.BeginInvoke(TrainID.EventTypeTrainID.POSITION, Nothing, Nothing)
            End If
            If optEnableCalculateHorsePerTon AndAlso
                Not DisableTonCalulationOnCreate Then
                train.CalculateHorsePowerPerTon(nudTonO.Value)
            End If
            Dim summary As New SummaryItem("TRAIN", "POSITION", train)
            SyncLock gSummaryTrainQueue.SyncRoot
                gSummaryTrainQueue.Enqueue(summary)
            End SyncLock
            Dim PerformUnitUpdate As New DoUpdateTrainUnitInformation(AddressOf train.UpdateTrainUnits)
            PerformUnitUpdate.BeginInvoke("frmTrainConsist.btnOK", False, Nothing, Nothing)
            If gSimulationMode Then train.ClearOsReports()
            If OptEnableTrainCommentSaveOnPostion AndAlso
                myTrainCommentsList IsNot Nothing AndAlso
                myTrainCommentsList.Count > 0 Then
                Dim clsTC As clsTrainComments = Nothing
                For Each clsTC In myTrainCommentsList
                    clsTC.myTrain = CurrentTrain
                    clsTC.AddCommentToDatabase()
                Next
            End If
            newTrackRef.InitTrainDisplay()
            newTrackRef.InitTrainDisplay()
            newTrackRef.InvalidateTrainID()
            FormEvent($"{GetCurrentMethod.Name} TRAIN ID {train.Name} POSITION ON TRACK {train.TrackGUID}")
            If optEnableNeedOccupancyToPositionMoveTrainElseDeviceBlock AndAlso
                newTrackRef.AuthorityType.EqualsIgnoreCase("CTC") AndAlso
                Not newTrackRef.Occuppied AndAlso
                newTrackRef.Indicating Then
                newTrackRef.ApplyDeviceBlockForTrainSymbol(CurrentTrain)
            End If
            If optEnableWorkOrderFunctions Then train.LoadWorkOrders()
            If optEnableMisrouteProtection Then train.LoadTrainPlan()
            If optEnablePTCBOSVETMSMode Then
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainStatusRequest(train)
            End If
            If optEnableAutoGenerateClearance And train.OLength > 0 Then
                train.DoCreateClearanceForTrain()
            End If
            If optEnableMessagingEDI Then
                NetworkMessages.CadMessages.SendTrainFullUpdateEDI(CurrentTrain)
            End If
            DoCheckForCrewChangeEvents()
            DoCheckForConsistChangeEvents()
            Dim publishThisEventUpdate As New DoPublishTrainEvent(AddressOf train.PublishTrainEvent)
            publishThisEventUpdate.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)
            FormEvent($"{GetCurrentMethod.Name} End")
            Return True
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Function

    Private Function SaveModifyTrain() As Boolean
        Dim MessageList As New ArrayList
        Try
            Dim OldConsist As String = CurrentTrain.OLoads & "|" & CurrentTrain.OEmts & "|" & CurrentTrain.OLength & "|" & CurrentTrain.OTons
            Dim NewConsist As String = Me.nudLoadO.Value.ToString & "|" & Me.nudEmpO.Value.ToString & "|" & Me.nudLenO.Value.ToString & "|" & Me.nudTonO.Value.ToString
            Dim CurrentEngineState As Boolean = CurrentTrain.TrainInActive
            Dim ChangeEngineToInactive As Boolean = CurrentTrain.TrainInActive
            Dim OLDGrossTon As Double = 0 ' CurrentTrain.HorsePowerTrailing
            Double.TryParse(CurrentTrain.HorsePowerTrailing, OLDGrossTon)
            Dim SendCREWMISMessage As Boolean = False
            CheckForConsistChangeOnTrainPTC()
            Dim ConsistChange As Boolean
            Dim UseRUID As Boolean
            If optApplyTrainSheetConfigurationForCN Then
                UseRUID = True
            End If
            If optEnableCalculateHorsePerTon Then
                CurrentTrain.CalculateHorsePowerPerTon(nudTonO.Value)
            End If
            If Me.CurrentTrain.TrainConsistChangeCheck(Me.nudLoadO.Value, Me.nudEmpO.Value, Me.nudLenO.Value, Me.nudTonO.Value, Me.nudAxles.Value, nudBrakes.Value, UseRUID) Then
                ConsistChange = True
            End If
            If optAllowTrafficChangeOnTrainDirectionChange Then
                CurrentTrain.TrainDirectionChangeCheck(cmbDirection.Text)
            End If
            If Not IsNothing(Me.SubTrainSheetTrain) Then
                ApplyTrainPropertiesFromForm(SubTrainSheetTrain)
                SubTrainSheetTrain.CreateCrewStrings()
                SubTrainSheetTrain.UpdateTrainIDIntoSubTrainSheetTable(SubTrainSheetTrain.ActiveTrainSheetGUID)
                SubTrainSheetTrain = Nothing
            Else
                Dim TrainModified As Boolean
                Dim RedrawTrain As Boolean
                Dim PseudoChanged As Boolean
                If CurrentTrain.IdentifingUnit <> Me.cmbUnitID.Text Then
                    IdentifingUnitChanged = True
                    CurrentTrain.IdentifingUnit = Me.cmbUnitID.Text
                    TrainModified = True
                    RedrawTrain = True
                End If
                If CurrentTrain.SpecialNotation <> Me.chkNote.Checked Then
                    RedrawTrain = True
                End If
                If CurrentTrain.Direction <> Me.cmbDirection.Text Then
                    Dim SummItem1 As New SummaryItem("TRAIN", "RELEASE", CurrentTrain)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem1)
                    End SyncLock
                    CurrentTrain.ReleaseTrainAbbreviation(gTrainAbbreviation)
                    CurrentTrain.Direction = Me.cmbDirection.Text
                    CurrentTrain.ApplyTrainAbbreviation(gTrainAbbreviation)
                    TrainModified = True
                    Dim SummItem2 As New SummaryItem("TRAIN", "POSITION", CurrentTrain)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem2)
                    End SyncLock
                    If optShowTrainSymbolColorScheme1 Or optShowTrainSymbolColorScheme2 Then
                        RedrawTrain = True
                    End If
                End If

                If optCreatePseudoSymbol Then
                    Select Case CurrentTrain.Direction
                        Case optDirectionNorth
                            Me.txtPseudoName.Text = CurrentTrain.IdentifingUnit & Space(1) & "N"
                        Case optDirectionSouth
                            Me.txtPseudoName.Text = CurrentTrain.IdentifingUnit & Space(1) & "S"
                        Case Else
                            Me.txtPseudoName.Text = CurrentTrain.IdentifingUnit
                    End Select
                End If
                If CurrentTrain.PseudoName <> Me.txtPseudoName.Text Then
                    CurrentTrain.PseudoName = Me.txtPseudoName.Text
                    TrainModified = True
                    RedrawTrain = True
                    PseudoChanged = True
                End If
                If CurrentTrain.TrainType <> Me.cmbTrainType.Text Then
                    CurrentTrain.TrainType = Me.cmbTrainType.Text
                    TrainModified = True
                End If
                If CurrentTrain.SubType <> Me.cmbSubType.Text Then
                    CurrentTrain.SubType = Me.cmbSubType.Text
                    TrainModified = True
                End If
                If String.IsNullOrWhiteSpace(CurrentTrain.RestrictionType) OrElse
                    Not CurrentTrain.RestrictionType.Equals(cmbRestrictionType.Text) Then
                    CurrentTrain.RestrictionType = cmbRestrictionType.Text
                    TrainModified = True
                End If
                If CurrentTrain.HelperTrain <> Me.chkBoxHelper.Checked Then
                    CurrentTrain.HelperTrain = Me.chkBoxHelper.Checked
                    TrainModified = True
                End If
                If CurrentTrain.HighWide <> Me.chkHIGH.Checked Then
                    CurrentTrain.HighWide = Me.chkHIGH.Checked
                    TrainModified = True
                End If
                If CurrentTrain.CBTCEquipped <> Me.chkCBTCEquipped.Checked Then
                    CurrentTrain.CBTCEquipped = Me.chkCBTCEquipped.Checked
                    TrainModified = True
                    CurrentTrain.TrainCBTCCutInUpdate(True)
                End If
                If CurrentTrain.KeyTrain <> Me.chkKey.Checked Then
                    CurrentTrain.KeyTrain = Me.chkKey.Checked
                    TrainModified = True
                End If
                If CurrentTrain.HomeRoadCode <> Me.cmbHomeRoad.Text Then
                    CurrentTrain.HomeRoadCode = Me.cmbHomeRoad.Text
                    TrainModified = True
                End If
                If CurrentTrain.PullerTrain <> Me.chkPuller.Checked Then
                    CurrentTrain.PullerTrain = Me.chkPuller.Checked
                    TrainModified = True
                End If
                If CurrentTrain.TrainHOS <> Me.dtTrainHOS.Value Then
                    CurrentTrain.TrainHOS = Me.dtTrainHOS.Value
                    TrainModified = True
                End If
                If CurrentTrain.TotalCars <> Me.nudTotalCars.Value Then
                    CurrentTrain.TotalCars = Me.nudTotalCars.Value
                    TrainModified = True
                End If
                If CurrentTrain.TrainVia.Trim.ToUpper <> Me.txtVia.Text.Trim.ToUpper Then
                    CurrentTrain.TrainVia = Me.txtVia.Text.Trim.ToUpper
                    TrainModified = True
                End If
                If CurrentTrain.ReleaseTime <> Me.dtTrnReleaseTime.Value Then
                    CurrentTrain.ReleaseTime = Me.dtTrnReleaseTime.Value
                    TrainModified = True
                End If
                If Not (gAssistMode OrElse CurrentTrain.myTrack.IsShadowMode) Then
                    If Me.ApplyTrainInformation(CurrentTrain) Then
                        TMDS.NetworkMessages.CadMessages.SendTrainSymbolModified(CurrentTrain, gCadTransmitQueue)
                    End If
                    Dim LogThisEvent As New DoEventLogTrainID(AddressOf CurrentTrain.LogTheTrainIDEvent)
                    LogThisEvent.BeginInvoke(TrainID.EventTypeTrainID.MODIFY, Nothing, Nothing)
                    Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf CurrentTrain.PublishTrainEvent)
                    PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)
                    If CurrentTrain.ConsistChange Then
                        If optEnablePTCBOSVETMSMode And CurrentTrain.IsActivePTC Then
                            If optEnableARRCSpecificOptions Then
                                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainConsistChange(CurrentTrain, "SaveModifyTrain1")
                            ElseIf Not CurrentTrain.ConsistSent Then
                                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainConsistChange(CurrentTrain, "SaveModifyTrain2")
                            End If
                        End If
                        CurrentTrain.ConsistChange = False
                    End If
                End If
                Dim SummItem As New SummaryItem("TRAIN", "MODIFY", CurrentTrain)
                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                End SyncLock
                If gAssistMode And Not (gMaintenanceMode OrElse CurrentTrain.myTrack.IsShadowMode) Then
                    Me.ApplyTrainInformation(CurrentTrain)
                    Dim CommandThisEvent As New DoPublishTrainCommand(AddressOf CurrentTrain.PublishTrainCommand)
                    CommandThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)
                End If
                If RedrawTrain OrElse TrainModified Then
                    TrackRef.InvalidateTrainID()
                    TrackRef.InitTrainDisplay()
                    TrackRef.InvalidateTrainIDMessageDisplay()
                End If
                If optEnableFlashTrainForHighWide Or optEnableFlashTrainForKey Then
                    If CurrentTrain.HighWide Or CurrentTrain.KeyTrain Then
                        CurrentTrain.EnableNotificationFlash(True)
                    Else
                        CurrentTrain.EnableNotificationFlash(False)
                    End If
                End If
                If PseudoChanged And optDisplayPseudoTrainAsMainIdentifer Then
                    Dim SummItem1 As New SummaryItem("TRAIN", "FORCE-REFRESH", CurrentTrain)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem1)
                    End SyncLock
                End If
                TMDS.NetworkMessages.WorkStationMessages.SendUpdateSymbolEventToSecondaryHolder(CurrentTrain.Name, gCadTransmitQueue)
                Dim ConsistUpdateSent As Boolean = False
                If ConsistChange Then
                    If optApplyTrainSheetConfigurationForFXE Then
                        TMDS.NetworkMessages.CadMessages.SendTrainConsistChange(CurrentTrain, gCadTransmitQueue)
                    ElseIf optApplyTrainSheetConfigurationForARRC Or optApplyTrainSheetConfigurationForDenver Then
                        CurrentTrain.CalculateTotalTonAndTotalLength("frmTrainID_SaveModifyTrn1")
                        CurrentTrain.CalculateTPOB()
                        CurrentTrain.CalculateHorsePowerPerTon()
                        If optApplyTrainSheetConfigurationForARRC Then
                            TMDS.NetworkMessages.CadMessages.SendTrainEngineSetEventARRC(CurrentTrain, gMISTransmitQueue, "MODIFY")
                            'Commented Based On RMT ARRC-1432
                            ConsistUpdateSent = True
                        End If
                    ElseIf optApplyTrainSheetConfigurationForFECR Then
                        TMDS.NetworkMessages.CadMessages.SendTrainConsistChangeMessageFECR(CurrentTrain, NewConsist, gCadTransmitQueue)
                    ElseIf optApplyTrainSheetConfigurationForCN Then
                        TMDS.NetworkMessages.CadMessages.SendTrainConsistChangeMessageCN(CurrentTrain, OldConsist, NewConsist, gCadTransmitQueue)
                        CurrentTrain.CalculateHorsePowerPerTon(nudTonO.Value)
                    ElseIf optEnableMessagingEDI AndAlso CurrentTrain.IsOperatingOnForiegnRoads Then
                        TMDS.NetworkMessages.CadMessages.SendTrainConsistUpdateEDI(CurrentTrain)
                    End If
                End If
                If Not ConsistUpdateSent AndAlso SendForcedConsistUpdate AndAlso optApplyTrainSheetConfigurationForARRC Then
                    TMDS.NetworkMessages.CadMessages.SendTrainEngineSetEventARRC(CurrentTrain, gMISTransmitQueue, "MODIFY", False, "", True, SendForcedConsistUpdateGUID)
                End If
                If TrainModified AndAlso gPTCTerritoryExists AndAlso CurrentTrain IsNot Nothing Then TMDS.NetworkMessages.PTCBOSAPIMessaging.SendLocomotiveRequestMessageStatus(CurrentTrain)
                If CrewChangeEventArrayList IsNot Nothing AndAlso CrewChangeEventArrayList.Count > 0 Then
                    Dim STR As String
                    For Each STR In CrewChangeEventArrayList
                        If STR.Trim <> "" Then
                            CurrentTrain.AddTrainSheetEvent("CREW CHANGE", Now, Mid(CurrentTrain.myTrack.TimeZone, 1, 1), STR, CurrentTrain.myTrack.myControlPoint.GUID.ToString, CurrentTrain.GetIdentifyingLocationNameFromLimits, "NONE")
                        End If
                    Next
                End If
                Dim NewGrossTon As Double
                Double.TryParse(CurrentTrain.HorsePowerTrailing, NewGrossTon)
                If Double.IsInfinity(OLDGrossTon) Then OLDGrossTon = 0
                If OLDGrossTon <> NewGrossTon AndAlso Not optEnableARRCSpecificOptions Then  'ARRC-consist
                    Dim OGT As Double = 0 : If Not Double.IsInfinity(OLDGrossTon) Then OGT = OLDGrossTon
                    Dim strConsistChange As String = "GROSS TONS CHANGED FROM " & Space(1) & OGT.ToString & Space(1) & optTrainString8 & Space(1) & CurrentTrain.HorsePowerTrailing.ToString
                    FormEvent("SavePostionTrain:TRAIN CONSIST CHANGE:" & CurrentTrain.Name & " (" & strConsistChange & ")")
                    Dim RRUID As String = CurrentTrain.myTrack.myControlPoint.UniqueName
                    CurrentTrain.AddTrainSheetEvent("CONSIST CHANGE", Now, Mid(CurrentTrain.myTrack.TimeZone, 1, 1), strConsistChange, CurrentTrain.myTrack.myControlPoint.GUID.ToString, CurrentTrain.GetIdentifyingLocationNameFromLimits, RRUID)
                End If
                If SendCREWMISMessage Then
                    TMDS.NetworkMessages.CadMessages.SendTrainCrewEventARRC(CurrentTrain, gMISTransmitQueue, True, "MODIFY")
                End If
                DoCheckForCrewChangeEvents()
                DoCheckForConsistChangeEvents()
            End If
            Return True
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Function

    Private Function SaveCreateTrain(ByRef train As TrainID) As Boolean
        Dim ForceDeactiveEngine As Boolean
        Try

            train = New TrainID()
            train.DisplayEngineID = gDisplayEngineID
            train.IdentifingUnit = Me.cmbUnitID.Text
            train.Name = Me.cmbTrainID.Text
            train.TrainType = Me.cmbTrainType.Text
            train.PseudoName = Me.txtPseudoName.Text
            train.ActiveTrainSheetGUID = Guid.NewGuid.ToString.ToUpper

            train.TypeOfID = "TRAIN"
            Me.ApplyTrainInformation(train)
            Dim RedrawTrain As Boolean
            If optApplyTrainSheetConfigurationForARRC Then
                Dim LaunchPoint As New Point(Me.Location.X + 100, Me.Location.Y + 300)
                Dim ErrorMsg As New ArrayList
                If Not CheckIfLeadEngineIsReferencedInOtherAuthorities(ErrorMsg, ForceDeactiveEngine, True) Then ShowCustomMessageBox(ErrorMsg, "Lead Engine Validation", False, LaunchPoint, True, True, Me)
                If Not ForceDeactiveEngine AndAlso Not CheckForDupEngineID(cmbUnitID.Text, True, False, True, ForceDeactiveEngine) Then Exit Function
                ActivateDeActivateEngine(train, RedrawTrain, ForceDeactiveEngine)
            End If

            Dim LogThisEvent As New DoEventLogTrainID(AddressOf train.LogTheTrainIDEvent)
            LogThisEvent.BeginInvoke(TrainID.EventTypeTrainID.CREATE, Nothing, Nothing)
            If optEnableSendViewTrainOnPosition AndAlso (gPositionTrainID Or gCreateTrain) Then
                If Me.cmbSendViewTrain.Text.Trim.ToUpper <> "SELECT" Then
                    TMDS.NetworkMessages.CadMessages.SendViewTrainSymbolCreateOnOtherDesk(train, gCadTransmitQueue, Me.cmbSendViewTrain.Text, "SaveCreateTrain")
                End If
            End If
            If RedrawTrain Then
                TrackRef.InvalidateTrainID()
                TrackRef.InitTrainDisplay()
                TrackRef.InvalidateTrainIDMessageDisplay()
            End If
            Return True
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Function

