    Private Sub mnuTrainRestrictionRemove_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles mnuTrainRestrictionRemove.Click
        Dim MSG As New ArrayList
        Try
            If IsNothing(CurrentSelectedRestriction) Then Exit Sub
            If Not String.IsNullOrEmpty(CurrentSelectedRestriction.myBulletinGUID) AndAlso CurrentSelectedRestriction.myBulletinGUID.Trim <> "" Then
                Dim sb As SubBulletin = TMDS.SystemUtilities.FetchData.FindBulletinByGUID(CurrentSelectedRestriction.myBulletinGUID)
                If sb IsNot Nothing Then
                    Dim frmBulletinHMI As New frmBulletinHMI
                    frmBulletinHMI.theBulletin = sb
                    frmBulletinHMI.BulletinCancelFromTrainSheet = True
                    frmBulletinHMI.LoadForm("BULLETIN-CHANGE", "CANCEL", Nothing, sb)
                    If Not SetFormPropertiesGBO(frmBulletinHMI) Then Exit Sub
                End If
            End If



            If Not CurrentSelectedRestriction.DeleteRestriction() Then
                MsgBox("RESTRICTION NOT REOMVED. PLEASE CONTACT SYSTEM ADMINISTRATOR. ERROR:1201")
                Exit Sub
            Else
                With MSG
                    .Add("RESTRICTION DELETED.")
                    .Add("PLEASE VERIFY AND ADJUST THE CONSIST")
                End With
                ShowCustomMessageBox(MSG, "SYSTEM MESSAGE", False, New Point(Me.Location.X + 100, Me.Location.Y + 100), True, True, Me)
                CurrentTrain.LoadTrainRestrictions()

                If Not IsNothing(TMDS.SystemForms.MySystemForms.frmTrainID) Then
                    If TMDS.SystemForms.MySystemForms.frmTrainID.FormLoaded Then
                        gTrainSheetMessageQueue.Enqueue("REFRESHTRAINRESTRICTIONS")
                    End If
                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        Finally
            MSG = Nothing
        End Try
    End Sub

    Private Sub LoadTrainRestrictions(ByVal trn As TrainID)
        Dim SystemWide As Boolean = False
        Try

            Dim lv As ListViewItem
            lvRestrictions.Items.Clear()
            Dim tr As TrainRestriction

            If trn Is Nothing Then Exit Sub
            If trn.myRestrictionList Is Nothing Then Exit Sub
            For Each tr In trn.myRestrictionList
                lv = New ListViewItem(tr.myUID)
                lv.SubItems.Add(tr.myClearanceUID)
                lv.SubItems.Add(tr.myCarUID)
                lv.SubItems.Add(tr.myTypeOfRestriction)
                If tr.IsOnTrain Then
                    lv.SubItems.Add("Y")
                Else
                    lv.SubItems.Add("N")
                End If
                Dim BMp As Double = 0
                Dim EMp As Double = 0
                Dim Spd As Integer = 0
                Double.TryParse(tr.myMilePostBegin, BMp)
                Double.TryParse(tr.myMilePostEnd, EMp)
                Integer.TryParse(tr.mySpeedLimit, Spd)
                SystemWide = False
                If BMp = 0 AndAlso EMp = 0 AndAlso Spd = 0 Then
                    SystemWide = True
                End If
                If SystemWide Then
                    lv.SubItems.Add("(" & tr.myDescription & ") (" & tr.TrackName & ")")
                Else
                    lv.SubItems.Add("(" & tr.myDescription & ") (" & tr.myMilePostBegin & " TO " & tr.myMilePostEnd & ") (" & tr.mySpeedLimit.ToString.PadLeft(2, "0") & " MPH) (" & tr.TrackName & ")")
                End If

                lv.SubItems.Add(tr.myInstructions)
                If tr.myBulletinGUID <> "" Then
                    If DoesBulletinExistInTGBO(trn, tr.myBulletinGUID) Then
                        lv.BackColor = Color.LightGreen
                    Else
                        lv.BackColor = Color.Yellow
                    End If
                Else
                    lv.BackColor = Color.MistyRose
                End If
                lvRestrictions.Items.Add(lv)
            Next
            lvRestrictions.Refresh()
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function DoesBulletinExistInTGBO(ByVal trn As TrainID, ByVal BullUID As String) As Boolean
        Try
            Dim t As TabularGeneralBulletin
            For Each t In gTabularGeneralBulletins
                If t.IssuedTo = trn.Name Then
                    If InStr(t.ExceptionListDefinitions, BullUID) <> 0 Then
                        Return TMDS.SystemUtilities.TrainFunction.IsBulletinExceptionDelivered(t.SystemUID, BullUID)
                    End If


                    If InStr(t.BulletinListDefinitions, BullUID) <> 0 Then Return True

                End If
            Next
            Return False
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Sub lvRestrictions_SelectedIndexChanged(ByVal sender As Object, ByVal e As System.EventArgs) Handles lvRestrictions.SelectedIndexChanged
        Try
            Dim lv As ListViewItem
            Dim lvSelected As ListViewItem = Nothing
            CurrentSelectedRestriction = Nothing

            For Each lv In lvRestrictions.Items
                If lv.Selected Then
                    lvSelected = lv
                    Exit For
                End If
            Next
            If IsNothing(lvSelected) Then Exit Sub

            Dim tr As TrainRestriction
            For Each tr In CurrentTrain.myRestrictionList
                If tr.myUID = lvSelected.SubItems(0).Text Then
                    CurrentSelectedRestriction = tr
                    Exit For
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Function SetFormPropertiesGBO(ByVal frmBulletinHMI As frmBulletinHMI) As Boolean
        Dim Feedback As Boolean = False
        Try
            frmBulletinHMI.Owner = SystemForms.MySystemForms.frmTrainID
            frmBulletinHMI.Location = New Point(SystemForms.MySystemForms.frmTrainID.Location.X + 100, SystemForms.MySystemForms.frmTrainID.Location.Y + 100)
            frmBulletinHMI.ShowDialog()
            If frmBulletinHMI.BulletinFormFeedback = 6 Then Feedback = True
            frmBulletinHMI.Dispose()
        Catch ex As Exception
            GetErrorDetails(ex)
            Return False
        Finally
            frmBulletinHMI = Nothing
        End Try
        Return Feedback
    End Function

