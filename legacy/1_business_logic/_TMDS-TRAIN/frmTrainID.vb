    Private Sub TimeTextBox_Focus(ByVal sender As System.Object, ByVal e As System.EventArgs)
        Dim txt As TextBox = Nothing
        Try
            txt = TryCast(sender, TextBox)
            If txt IsNot Nothing Then
                txt.SelectAll()
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub TimeTextBox_Leave(ByVal sender As System.Object, ByVal e As System.EventArgs)
        Dim txt As TextBox = Nothing
        Try
            txt = TryCast(sender, TextBox)
            If txt IsNot Nothing Then
                FormatTime(txt)
                If Not ValidateTime(txt) Then
                    txt.Text = "hhmm"
                    txt.SelectAll()
                    txt.Focus()
                End If
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub LoadTrackRRName()
        Dim s As String = ""
        Try
            Me.cmbTrainOrg.Items.Clear()
            Me.cmbTrainDest.Items.Clear()
            Me.cmbOrg.Items.Clear()
            Me.cmbDes.Items.Clear()
            If gTrackRRName IsNot Nothing AndAlso gTrackRRName.Count > 0 Then
                gTrackRRName.Sort()
                For Each s In gTrackRRName
                    If s IsNot Nothing AndAlso s.Trim <> "" Then
                        If Not cmbTrainOrg.Items.Contains(s.Trim.ToUpper) Then cmbTrainOrg.Items.Add(s.Trim.ToUpper)
                        If Not cmbTrainDest.Items.Contains(s.Trim.ToUpper) Then cmbTrainDest.Items.Add(s.Trim.ToUpper)
                        If Not cmbOrg.Items.Contains(s.Trim.ToUpper) Then cmbOrg.Items.Add(s.Trim.ToUpper)
                        If Not cmbDes.Items.Contains(s.Trim.ToUpper) Then cmbDes.Items.Add(s.Trim.ToUpper)
                    End If
                Next
                With Me.cmbTrainOrg
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
                With Me.cmbTrainDest
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

