                                                            cmbBrk, txtTimeOnB, txtDateOnB, txtTimeHosB, txtDateHosB, txtTimeOffB, txtDateOffB,
                                                            cmbBrk2, txtTimeOnB2, txtDateOnB2, txtTimeHosB2, txtDateHosB2, txtTimeOffB2, txtDateOffB2,
                                                            cmbEngTrnee, txtTimeOnET, txtDateOnET, txtTimeHosET, txtDateHosET, txtTimeOffET, txtDateOffET,
