    Private Function CheckForTrainUse() As Integer
        Dim terr As Territory
        Dim TrainIDOnThisDesk As Boolean
        Dim ActTrn As ActiveTrn
        Try
            For Each ActTrn In Me.ActiveTrains
                'For I = 0 To ActiveTrain.GetUpperBound(0)
                If (ActTrn.Symbol = cmbTrainID.Text And ActTrn.InUse = 1 And ActTrn.InUseTwo = 1) Or
                   (ActTrn.Symbol = cmbTrainID.Text And ActTrn.InUse = 1 And Not optEnableSecondaryTrainPlacement) Or
                   (ActTrn.Symbol = cmbTrainID.Text And ActTrn.InUse = 1 And ActTrn.InUseTwo = 0 And optEnableSecondaryTrainPlacement And Mid(Me.TrackRef.AuthorityType, 1, 3) <> "TWC") Or
                   (ActTrn.Symbol = cmbTrainID.Text And ActTrn.InUse = 0 And ActTrn.InUseTwo = 1 And optEnableSecondaryTrainPlacement And Mid(Me.TrackRef.AuthorityType, 1, 3) <> "TWC") Then
                    For Each terr In ControlledTerritories
                        If terr.TerritoryID <> 0 Then
                            If (terr.TerritoryID = ActTrn.Territory) And (ActTrn.Territory <> 0) Or (terr.TerritoryID = ActTrn.TerritoryTwo) And (ActTrn.Territory <> 0) Then
                                TrainIDOnThisDesk = True
                            End If
                        End If
                    Next
                    If optEnableShadowMode AndAlso optEnableTerritoryDeskAssignmentMode Then
                        Dim trn As TrainID
                        trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(ActTrn.Symbol)
                        If trn IsNot Nothing Then
                            If Not trn.myTrack.IsValidTrackForOperation Then TrainIDOnThisDesk = False
                        End If
                    End If


                    'If TrainIDOnThisDesk AndAlso Not Ac Then
                    If Not TrainIDOnThisDesk Then
                        If Not optShowTrainSymbolRequestMenu Then
                            Dim TerritoryName As String = TMDS.SystemUtilities.FetchData.FindTerritoryNameOfPositionTrainSymbol(ActTrn.Territory)

                            'UserMessage = MsgBox("TRAIN SYMBOL:" & ActTrn.Symbol & " CURRENTLY IN USE ON TERRITORY ID:" & ActTrn.Territory.ToString & vbCrLf & "REQUEST TO USE THIS ID?", MsgBoxStyle.YesNo)
                            Dim frmMessageBox As frmMessageBox
                            Dim MessageList As New ArrayList()
                            MessageList.Add(mstrTrainString16 & ActTrn.Symbol)
                            MessageList.Add(mstrTrainString17 & Space(1) & TerritoryName)
                            MessageList.Add("")
                            frmMessageBox = New frmMessageBox()
                            frmMessageBox.Owner = Me
                            frmMessageBox.SetMessage(MessageList, mstrTrainString18, False, Me.Location)
                            'frmMessageBox.TopMost = True
                            frmMessageBox.ShowDialog()

                            Me.btnOK.Enabled = False
                            ClearPropertiesOnForm(False, False)
                            Me.cmbTrainID.Text = ActTrn.Symbol
                            Me.LoadActiveTrainIDsIntoList()
                            Me.cmbTrainID.Focus()
                        Else
                            Dim frmMessageBox As frmMessageBox
                            Dim MessageList As New ArrayList()
                            MessageList.Add(mstrTrainString16 & ActTrn.Symbol)
                            Dim DeskName As String = TMDS.SystemUtilities.FetchData.FindDeskOfPositionTrainSymbol(ActTrn.Territory)
                            If DeskName = "" Then
                                MessageList.Add(mstrTrainString19)
                            Else
                                MessageList.Add(mstrTrainString20 & DeskName)
                            End If
                            MessageList.Add("")
                            MessageList.Add(mstrTrainString21)
                            MessageList.Add("")
                            frmMessageBox = New frmMessageBox()
                            frmMessageBox.Owner = Me
                            frmMessageBox.SetMessage(MessageList, mstrTrainString22, True, Me.Location)
                            frmMessageBox.ShowDialog()
                            If frmMessageBox.FormFeedBack = 6 Then
                                TMDS.NetworkMessages.WorkStationMessages.SendRequestSymbolEvent(Me.cmbTrainID.Text & "|" & Me.TrackRef.GUID.ToString & "|" & TMDS.GlobalDeclarations.gWorkStationName, gCadTransmitQueue)
                                Return 0
                            Else
                                Me.btnOK.Enabled = False
                                ClearPropertiesOnForm(False, False)
                                Me.cmbTrainID.Text = ActTrn.Symbol
                                Me.LoadActiveTrainIDsIntoList()
                                Me.cmbTrainID.Focus()
                            End If

                        End If
                        Return 1
                    Else

                        Dim UserResponse As Integer = MessageBox.Show(Me, mstrTrainString23, mstrTrainString24, MessageBoxButtons.YesNo, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2)
                        If UserResponse = 6 Then
                            Dim train As TrainID = FindTrainID(ActTrn.Symbol)
                            If IsNothing(train) Then
                                train = Me.TrackRef.RetrieveTrainID(ActTrn.Symbol, False)
                            End If
                            Dim PreviousTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(train.TrackGUID)
                            Me.TrackRef.MoveTrainIDPlaceManual(train, PreviousTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                            PreviousTrack.InvalidateTrainID()
                            'Else
                        End If
                        Return 0
                    End If
                Else
                    If optEnableSecondaryTrainPlacement Then
                        If ActTrn.Symbol = cmbTrainID.Text And ActTrn.InUse = 1 And ActTrn.InUseTwo = 0 Then
                            Me.btnOK.Enabled = True
                            Return 3
                        End If
                    Else

                    End If
                End If
            Next
            'PositionedTrain = RetrieveTrainProperties(cmbTrainID.Text)
            'ApplyTrainPropertiesToForm(PositionedTrain)
            Me.btnOK.Enabled = True
            Return 2
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Function

