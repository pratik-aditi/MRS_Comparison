    Private Function GetValidCrewName(ByVal CrewName As String) As String

        Try
            Select Case CrewName.ToUpper.Trim
                Case "", "----", "NONE", "---", "--", "-"
                    Return String.Empty
                Case Else
                    Return CrewName.ToUpper.Trim
            End Select
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
        Return String.Empty
    End Function

