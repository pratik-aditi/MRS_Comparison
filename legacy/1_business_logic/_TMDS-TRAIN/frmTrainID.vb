    Private Function IsActivateEngineisValid(ByVal NewEngineID As String, ByRef ExistingTrainSymbol As String, ByVal ExistTrnEngineInactive As Boolean) As Boolean
        Try
            If NewEngineID.Trim = "" Then Return True
            'Dim ExistTrnEngineInactive As Boolean
            Dim ExistTrnSymbol As String = GetTrainWithLeadLocomotive(NewEngineID, "", cmbTrainID.Text, ExistTrnEngineInactive)
            Dim ExtTrn As TrainID = Nothing
            If ExistTrnSymbol <> String.Empty Then
                ExistingTrainSymbol = ExistTrnSymbol
                'ExtTrn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(ExistTrnSymbol)
                'If ExtTrn Is Nothing Then
                '    Return False
                'End If
                'ExistingTrain = ExtTrn
                If Not CurrentTrain.TrainInActive And ExistTrnEngineInactive Then
                    Return True
                ElseIf CurrentTrain.TrainInActive And ExistTrnEngineInactive Then
                    Return True
                End If
                If CurrentTrain IsNot Nothing Then
                    If ExistTrnSymbol.ToUpper.Trim = CurrentTrain.Name.ToUpper.Trim Then Return True
                End If
                If TMDS.SystemUtilities.FetchData.IsTrainReferencedInAuthorites(ExistTrnSymbol) Then Return False
            ElseIf ExistTrnSymbol.Trim = String.Empty Then
                Return True
            End If


            Return False
        Catch ex As Exception
            GetErrorDetails(ex)
        Finally

        End Try
    End Function

    Private Function ActivateDisableEngine(ByVal CurrentTrain As TrainID, ByRef ExistingTrain As TrainID, ByVal IsActivateMode As Boolean) As Boolean
        Dim trn As TrainID = Nothing
        Dim LaunchPoint As New Point(Me.Location.X + 100, Me.Location.Y + 300)
        Dim ErrorMsg As New ArrayList
        Dim EngineReferencedInAuthority As Boolean
        Dim ExistTrnSymbol As String = String.Empty
        Dim ExistTrnEngineInactive As Boolean
        Dim DoTrainDisplayRefresh As Boolean
        Dim SendDataWareHouseMsg As Boolean
        Dim EventData As String = ""
        Try
            If Me.chkDiasbleEngine.Checked AndAlso Not IsActivateMode Then
                CheckIfThisTrainIsReferencedInOtherAuthorities(ErrorMsg, EngineReferencedInAuthority)
                If EngineReferencedInAuthority Then
                    ShowCustomMessageBox(ErrorMsg, "Engine Validation", False, LaunchPoint, True, True, Me)
                    Me.chkDiasbleEngine.Checked = False
                    Return False
                Else
                    CurrentTrain.TrainInActive = True
                    CurrentTrain.UpdateTrainActiveStatusToDB("CHANGE ACTIVE STATUS-ActivateDisableEngine TrainID-A05(TRUE)")
                    DoTrainDisplayRefresh = True
                    FormEvent("Engine Deactivated: " & CurrentTrain.IdentifingUnit & " Symbol:" & CurrentTrain.Name & " WorkStation: " & gWorkStationName & " Dispatcher: " & gCurrentUser.UserFullName)

                End If
            ElseIf Me.chkActivateEngine.Checked AndAlso IsActivateMode Then
                If IsActivateEngineisValid(CurrentTrain.IdentifingUnit, ExistTrnSymbol, ExistTrnEngineInactive) Then
                    If Not String.IsNullOrEmpty(ExistTrnSymbol) AndAlso ExistTrnSymbol.Trim <> "" AndAlso ExistTrnEngineInactive Then
                        ErrorMsg = New ArrayList
                        With ErrorMsg
                            .Add(ExistTrnSymbol & " IS IN ACTIVE STATE ")
                            .Add("PLEASE DE-ACTIVATE IN ORDER TO ACTIVATE THIS ENGINE")
                            .Add("REQUEST DENIED ")
                            ShowCustomMessageBox(ErrorMsg, "Engine Validation", False, LaunchPoint, True, True, Me)
                            Me.chkActivateEngine.Checked = False
                            Return False
                        End With
                    Else
                        CurrentTrain.TrainInActive = False
                        CurrentTrain.UpdateTrainActiveStatusToDB("CHANGE ACTIVE STATUS-ActivateDisableEngine TrainID-A06(FALSE)")
                        DoTrainDisplayRefresh = True
                        SendDataWareHouseMsg = True
                        FormEvent("Engine Activated: " & CurrentTrain.IdentifingUnit & " Symbol:" & CurrentTrain.Name & " WorkStation: " & gWorkStationName & " Dispatcher: " & gCurrentUser.UserFullName)
                    End If
                Else
                    ErrorMsg = New ArrayList
                    With ErrorMsg
                        .Add(ExistTrnSymbol & " HAS ONE OR MORE AUTHORITIES ")
                        .Add(cmbUnitID.Text & " CANNOT BE ACTIVATED")
                        .Add("REQUEST DENIED ")
                        ShowCustomMessageBox(ErrorMsg, "Engine Validation", False, LaunchPoint, True, True, Me)
                        Me.chkActivateEngine.Checked = False
                        Return False
                    End With
                End If
            End If
            Try
                If DoTrainDisplayRefresh Then
                    CurrentTrain.myTrack.InvalidateTrainID()
                    CurrentTrain.myTrack.InitTrainDisplay()
                    If SendDataWareHouseMsg AndAlso optApplyTrainSheetConfigurationForARRC Then
                        TMDS.NetworkMessages.CadMessages.SendTrainEngineSetEventARRC(CurrentTrain, gMISTransmitQueue, "MODIFY")
                        'TMDS.NetworkMessages.CadMessages.SendTrainDataWarehouseEventARRC(CurrentTrain, gCadTransmitQueue, "MODIFY")   'Commented Based On RMT ARRC-1432
                    End If
                End If
            Catch ex As Exception
            End Try

            Return True
        Catch ex As Exception
            GetErrorDetails(ex)
            MessageBox.Show("ENGINE CANNOT ACTIVATED OR DISABLE AT THIS TIME." & vbCrLf & " PLEASE CONTACT SYSTEM ADMINISTRATOR!", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Return False
        End Try
    End Function

    Private Function CheckIfThisTrainIsReferencedInOtherAuthorities(ByRef ErrorMessage As ArrayList, ByRef HasAuthReferenced As Boolean) As Boolean
        ErrorMessage = New ArrayList
        Dim Auth As Object = Nothing
        Dim ExstAuth As New ArrayList()
        Dim ReturnAuthListAuth As New ArrayList
        Dim S As String = ""
        Dim AuthString As String = ""
        Try
            If CurrentTrain Is Nothing Then Return True
            If String.IsNullOrEmpty(CurrentTrain.IdentifingUnit) Then Return True
            For Each Auth In OtherTrackAuthorities
                Select Case Auth.GetType.ToString
                    Case gSFAComponentName
                        S = ""
                        If Auth.Box5Arrival IsNot Nothing AndAlso Auth.Box5Arrival.Count > 0 Then
                            For Each S In Auth.Box5Arrival
                                If S.Contains(CurrentTrain.IdentifingUnit) Then
                                    If Not ExstAuth.Contains(Auth) Then ExstAuth.Add(Auth)
                                End If
                            Next
                        End If

                        If Auth.IssuedToTrain AndAlso Auth.IssueTo.Contains(CurrentTrain.IdentifingUnit) Then
                            If Not ExstAuth.Contains(Auth) Then ExstAuth.Add(Auth)
                        End If
                    Case gTTComponentName
                        If Auth.AuthorityType = "TT" Then
                            If Auth.JointAuthority Then
                                If Not String.IsNullOrEmpty(Auth.AuthorityLimits) AndAlso Auth.AuthorityLimits.Contains(CurrentTrain.IdentifingUnit) Then
                                    If Not ExstAuth.Contains(Auth) Then ExstAuth.Add(Auth)
                                End If
                            End If

                            If Auth.BehindTrains IsNot Nothing AndAlso Auth.BehindTrains.Count > 0 Then
                                For Each S In Auth.BehindTrains
                                    If S.Contains(CurrentTrain.IdentifingUnit) Then
                                        If Not ExstAuth.Contains(Auth) Then ExstAuth.Add(Auth)
                                    End If
                                Next
                            End If
                        End If
                End Select
            Next
            If ExstAuth IsNot Nothing AndAlso ExstAuth.Count > 0 Then
                For Each Auth In ExstAuth
                    Dim strAuthNum As String = ""
                    Select Case Auth.GetType.ToString
                        Case gSFAComponentName
                            strAuthNum = gTWCVariableName & ":" & Space(2) & Auth.AuthorityUID
                            If Not ReturnAuthListAuth.Contains(strAuthNum) Then ReturnAuthListAuth.Add(strAuthNum)
                        Case gTTComponentName
                            strAuthNum = Auth.AuthorityType.trim & ":" & Space(2) & Auth.AuthorityUID
                            If Not ReturnAuthListAuth.Contains(strAuthNum) Then ReturnAuthListAuth.Add(strAuthNum)
                            'Case gOtherSplAuthorityName
                            '    strAuthNum = Auth.SubType.Trim.ToUpper & Space(2) & Auth.AuthorityNumber
                            '    If Not ReturnAuthListAuth.Contains(strAuthNum) Then ReturnAuthListAuth.Add(strAuthNum)
                    End Select
                Next
            End If
            S = ""
            If ReturnAuthListAuth IsNot Nothing AndAlso ReturnAuthListAuth.Count > 0 Then
                ErrorMessage.Add("Train is referenced in the following authority/authorities:")
                Dim Counter As Integer = 0
                AuthString = ""
                For Each S In ReturnAuthListAuth
                    If S.Trim <> "" Then
                        If AuthString.Trim <> "" Then
                            AuthString = AuthString & ", " & S
                            Counter = Counter + 1
                        Else
                            AuthString = S
                            Counter = Counter + 1
                        End If
                    End If
                    If Counter > 6 Then
                        ErrorMessage.Add(AuthString)
                        AuthString = ""
                        Counter = 0
                    End If
                Next
                ErrorMessage.Add(AuthString)
                ErrorMessage.Add("This Engine cannot be set to De-Activated State.")
                ErrorMessage.Add(" ")
                HasAuthReferenced = True
                Return False
            End If
            Return True

        Catch ex As Exception
            Return False
            GetErrorDetails(ex, "ERROR CODE(LE1144)")
        Finally
            Auth = Nothing
            ExstAuth = New ArrayList
            ReturnAuthListAuth = New ArrayList
        End Try
    End Function

    Private Function CheckForDuplicateEngineID(ByVal NewEngineID As String, ByVal SetEngineToInactive As Boolean) As Boolean
        Dim LongMessage As New ArrayList
        Dim LaunchPoint As New Point(Me.Location.X + 100, Me.Location.Y + 300)
        Dim Feedback As Integer = 0
        Try
            If NewEngineID.Trim = "" Then Return True
            Dim ExistTrnEngineInactive As Boolean
            Dim ExistTrnSymbol As String = GetTrainWithLeadLocomotive(NewEngineID, "", cmbTrainID.Text, ExistTrnEngineInactive)
            If ExistTrnSymbol <> String.Empty Then
                If CurrentTrain IsNot Nothing Then
                    If ExistTrnSymbol.ToUpper.Trim = CurrentTrain.Name.ToUpper.Trim Then Return True
                End If
                If Not ExistTrnEngineInactive AndAlso Not SetEngineToInactive Then
                    LongMessage.Add(" THE SELECTED LEAD LOCOMOTIVE IS ALREADY ASSOCIATED WITH <" & ExistTrnSymbol & ">  ")
                    LongMessage.Add(" EXISTING LEAD ENGINE IS IN ACTIVE STATE ")
                    LongMessage.Add(" LEAD LOCOMOTIVE CHANGES IS NOT VALID. ")
                    LongMessage.Add(" ")
                    ShowCustomMessageBox(LongMessage, "DUPLICATE LEAD LOCOMOTIVE" & " - " & NewEngineID, False, LaunchPoint, True, True, Me)
                    cmbUnitID.Focus()
                    cmbUnitID.Select()
                    cmbUnitID.SelectAll()
                    Return False
                ElseIf TMDS.SystemUtilities.FetchData.IsTrainReferencedInAuthorites(ExistTrnSymbol) AndAlso Not SetEngineToInactive Then
                    LongMessage.Add(" THE SELECTED LEAD LOCOMOTIVE ASSOCIATED WITH <" & ExistTrnSymbol & ">  ")
                    LongMessage.Add(" HAS AUTHORITY REFERENCED  ")
                    LongMessage.Add(" LEAD LOCOMOTIVE CHANGES IS NOT VALID. ")
                    LongMessage.Add(" ")
                    ShowCustomMessageBox(LongMessage, "DUPLICATE LEAD LOCOMOTIVE" & " - " & NewEngineID, False, LaunchPoint, True, True, Me)
                    cmbUnitID.Focus()
                    cmbUnitID.Select()
                    cmbUnitID.SelectAll()
                    Return False
                End If
            End If
            Return True
        Catch ex As Exception
            GetErrorDetails(ex)
        Finally
            LongMessage = Nothing
            LaunchPoint = Nothing
        End Try
    End Function

    Private Function CheckForGPSFlagsOnEngineID(ByVal NewEngineID As String) As Boolean
        Dim LongMessage As New ArrayList
        Dim LaunchPoint As New Point(Me.Location.X + 100, Me.Location.Y + 300)
        Dim Feedback As Integer = 0
        Dim SQLQuery As String = "Select GPSEquipped FROM tblSystemLocomotives WHERE UID = '" & NewEngineID & "'"
        Dim dbcomm As OleDbCommand
        Dim dr As OleDbDataReader
        Dim GPSActive As Boolean
        Try
            If NewEngineID.Trim = "" Then Return True
            '  dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)



            Using DbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                DbConn.Open()
                dbcomm = New OleDbCommand(SQLQuery, DbConn)
                dr = dbcomm.ExecuteReader
                If dr.HasRows Then
                    While dr.Read
                        If dr.IsDBNull(0) Then
                            GPSActive = False
                        Else
                            GPSActive = CBool(dr.GetBoolean(0))
                        End If
                    End While
                End If
                dr.Close()
                DbConn.Close()
            End Using
            If Not GPSActive Then
                With LongMessage
                    '.Add("GPS tracking on Modify Engine form is unchecked.")
                    .Add("GPS on this Engine has been Disabled")
                    .Add("Do you want to proceed?")
                End With
                If ShowCustomMessageBox(LongMessage, "Lead Engine GPS Check", True, LaunchPoint, False, True, Me) <> 6 Then Return False
            End If

            Return True
        Catch ex As Exception
            GetErrorDetails(ex)
        Finally
            LongMessage = Nothing
            LaunchPoint = Nothing
        End Try
    End Function

