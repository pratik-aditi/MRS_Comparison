    Private Sub GetActiveTrainSymbols()
        Dim SymbolFetch As String
        Dim dr As OleDbDataReader
        Dim DatabaseCommand As OleDbCommand = Nothing
        Dim dbconn As OleDb.OleDbConnection = Nothing
        Dim activetrain As ActiveTrn
        Try
            dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
            SymbolFetch = "SELECT Symbol, EngineID, InUsed, TerritoryAssignmentID, SecondaryInUsed, SecondaryTerrID FROM " & gtblTrainsActive
            DatabaseCommand = New OleDbCommand(SymbolFetch, dbconn)
            dbconn.Open()
            dr = DatabaseCommand.ExecuteReader()
            While dr.Read()
                'IF THE SYMBOL IS NOT IN USE THEN ASSIGN IT TO THIS STRUCTURE
                'If Not TrainIDExists(dr.GetString(0)) Then
                activetrain = New ActiveTrn()
                activetrain.Symbol = dr.GetString(0)
                If Not dr.IsDBNull(1) Then
                    activetrain.EngineID = dr.GetString(1)
                End If
                If Not dr.IsDBNull(2) Then activetrain.InUse = dr.GetInt32(2)
                If Not dr.IsDBNull(3) Then activetrain.Territory = dr.GetInt32(3)
                If Not dr.IsDBNull(4) And Not dr.IsDBNull(5) Then
                    activetrain.InUseTwo = dr.GetInt32(4)
                    activetrain.TerritoryTwo = dr.GetInt32(5)
                End If
                If Not ActiveTrains.Contains(activetrain) Then
                    ActiveTrains.Add(activetrain)
                Else
                    activetrain = Nothing
                End If
            End While
            DatabaseCommand = Nothing
            dbconn.Close()
        Catch ex As Exception
            Me.ExceptionEvent(ex.ToString)
        Finally
            If Not IsNothing(dbconn) Then
                dbconn.Close()
                dbconn = Nothing
            End If
        End Try

        Try
            LoadActiveTrainIDsIntoList()
        Catch ex As Exception
            Me.ExceptionEvent(ex.ToString)
            dbconn = Nothing
        End Try


    End Sub

    Private Sub LoadActiveTrainIDsIntoList()
        Try
            Dim trn As ActiveTrn
            For Each trn In Me.ActiveTrains
                Application.DoEvents()
                If optShowEngineIDWithSymbol Then
                    Me.cmbTrainID.Items.Add(trn.Symbol & " (" & trn.EngineID & ")")
                Else
                    Me.cmbTrainID.Items.Add(trn.Symbol)
                End If
            Next

        Catch ex As Exception
            Me.ExceptionEvent(ex.ToString)
        End Try
    End Sub

    Private Function TrainIDExists(ByVal TrnId As String) As Boolean
        Dim trn As TrainID
        Try
            For Each trn In TrainCollection
                If TrnId = trn.Name Then
                    Return True
                    Exit Function
                End If
            Next
        Catch ex As Exception
            Me.ExceptionEvent(ex.ToString)
        End Try
    End Function

