            MessageList.Add(mstrCreateSubTrainSheet02)
            MessageList.Add("")
            frmMessageBox.SetMessage(MessageList, mstrCreateSubTrainSheet03, True, LaunchPoint)
            frmMessageBox.ShowDialog()
            Me.Cursor = System.Windows.Forms.Cursors.WaitCursor

            Dim trn As New TrainID()
            Dim NewCallTime As Date = Now
            Dim NewCallTimeString As String = String.Empty
            If Not IsNothing(Me.CurrentTrain) Then
                trn.TrainGUID = Me.CurrentTrain.TrainGUID
                If NewCallTime = CurrentTrain.CallTime Then
                    NewCallTime = Now.AddMinutes(1)
                    NewCallTimeString = Format(NewCallTime, "MM-dd-yy HH:mm:ss.fff")
                End If
            ElseIf Not IsNothing(Me.PositionedTrain) Then
                If NewCallTime = PositionedTrain.CallTime Then
                    NewCallTime = Now.AddMinutes(1)
                    NewCallTimeString = Format(NewCallTime, "MM-dd-yy HH:mm:ss.fff")
                End If
                trn.TrainGUID = Me.PositionedTrain.TrainGUID
            End If
            trn.ActiveTrainSheetGUID = Guid.NewGuid.ToString.ToUpper
            If frmMessageBox.FormFeedBack = 6 Then
                Me.ApplyTrainPropertiesFromForm(trn)
                trn.CreateCrewStrings()
                trn.CrewCurrent.ApplyCrewString(trn.CrewCurrentString)
                trn.CrewRelief.ApplyCrewString(trn.CrewReliefString)
                trn.CrewPending.ApplyCrewString(trn.CrewPendingString)
                TMDS.SystemUtilities.TrainFunction.InsertNewTrainSheetIntoDatabase(trn, NewCallTimeString)
                If Not IsNothing(Me.CurrentTrain) Then
                    TMDS.SystemUtilities.TrainFunction.RetrieveSubTrainSheets(CurrentTrain)
                ElseIf Not IsNothing(Me.PositionedTrain) Then
                    TMDS.SystemUtilities.TrainFunction.RetrieveSubTrainSheets(PositionedTrain)
                End If
                LoadSubTrainSheetsInToComboBox()
            End If
            trn = Nothing
            MessageList.Clear()
            MessageList = Nothing
            frmMessageBox.Dispose()
            frmMessageBox = Nothing
            Me.Cursor = System.Windows.Forms.Cursors.Default


        Catch ex As Exception
            SystemException(ex.ToString)
            Me.Cursor = System.Windows.Forms.Cursors.Default

        End Try
    End Sub

