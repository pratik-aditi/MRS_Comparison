    Sub CopyTrainPropertiesToForm(ByVal trn As TrainID)
        Dim comp As Object
        Try
            If IsNothing(trn) Then
                Exit Sub
            End If

            With trn
                If gSimulationMode And trn.SimulateMode Then
                    Me.chkSimulate.Visible = True
                    Me.lblSim.Visible = True
                    Me.nudSimSpeed.Visible = True
                    Me.nudSimSpeed.Value = trn.SimulationSpeed / 1000
                    If trn.SimulateMode Then Me.chkSimulate.Checked = True
                End If
                Me.cmbTrainID.Text = optTrainString19
                Me.cmbTrainID.Enabled = True

                If Not optApplyTrainSheetConfigurationForBRC Then
                    If trn.PseudoName = "" Then
                        Try
                            Dim eng() As String = trn.IdentifingUnit.Split(" ")
                            Dim EngNum As String = String.Empty
                            If eng.Length > 2 Then
                                EngNum = eng(eng.Length - 1).TrimStart
                            End If
                            Dim TrainName As String = Mid(.Name, 1, 1) & Mid(.Name, 6, 1) & Mid(.Name, 7, 1) & Mid(.Name, 8, 1) & EngNum
                            Me.txtPseudoName.Text = TrainName '.Name
                        Catch
                        End Try
                    Else
                        Me.txtPseudoName.Text = .PseudoName
                    End If
                Else
                    Me.txtPseudoName.Text = .PseudoName
                End If

                Me.cmbUnitID.Text = .IdentifingUnit
                If .Direction <> "" Then
                    Me.cmbDirection.Text = .Direction
                End If
                Me.txtEOTD.Text = .EOTD
                Me.txtHOTD.Text = .HOTD
                Me.nudMaxSpd.Text = .MaxSpd
                Me.chkHaz.Checked = .HazMat
                Me.chkKey.Checked = .KeyTrain
                Me.chkNote.Checked = .SpecialNotation
                Me.chkPuller.Checked = .PullerTrain

                Me.chkBoxHelper.Checked = .HelperTrain

                Me.chkHIGH.Checked = .HighWide
                For Each comp In .Units
                    Me.lvUnits.Items.Add(comp)
                Next

                Me.cmbOrg.Text = .Origin
                Me.cmbTrainOrg.Text = .Origin


                Me.dtDepTime.Text = Format(.DepTime, "HH:mm")

                Try
                    Me.dtDepDate.Value = .DepTime.ToShortDateString
                Catch
                End Try
                If IsValidDate(.DepTime) Then
                    Me.dtDepDateAlt.Value = Me.dtDepDate.Value
                    Me.dtDepTimeAlt.Text = Me.dtDepTime.Text
                End If
                If optApplyConfigurationForKCT AndAlso IsValidDate(.ArrTime) Then
                    Me.dtArrDateAlt.Value = .ArrTime.ToShortDateString
                    Me.dtArrTimeAlt.Text = Format(.ArrTime, "HH:mm")
                End If
                Me.nudEmpO.Text = .OEmts
                Me.nudLenO.Text = .OLength
                Me.nudLoadO.Text = .OLoads
                Me.nudTonO.Text = .OTons
                Me.txtGrossTons.Text = .GrossTon
                Me.txtTotalLength.Text = .TotalLength
                Me.cmbDes.Text = .Dest
                Me.cmbTrainDest.Text = .Dest
                Me.dtArrTime.Text = Format(.ArrTime, "HH:mm")
                Try
                    Me.dtArrDate.Value = .ArrTime.ToShortDateString
                Catch
                End Try
                Me.nudEmpD.Text = .DEmts
                Me.nudLenD.Text = .DLength
                Me.nudLoadD.Text = .DLoads
                Me.nudTonD.Text = .DTons
                If optApplyConfigurationForKCT Then
                    nudLoads.Value = .OLoads
                    nudEmpties.Value = .OEmts
                    nudTons.Value = .OTons
                    nudLength.Value = .OLength
                    nudAxlesAlt.Value = .NumberOfAxles
                    nudBrakesAlt.Value = .NumberOperatingBrakes
                End If

                ApplyCurrentCrew(trn)
                ApplyReliefCrew(trn)

                '  Me.txtHPT.Text = .HorsePowerTrailing
                If .HorsePowerTrailing.Trim <> String.Empty And IsNumeric(.HorsePowerTrailing) Then
                    If CInt(.HorsePowerTrailing) > 99 Then
                        Me.txtHPT.Text = CInt(.HorsePowerTrailing)
                    Else
                        Me.txtHPT.Text = Format(CInt(.HorsePowerTrailing), optHPTStringFormat)
                    End If

                Else
                    Me.txtHPT.Text = "0"
                End If

                If .TotalHorsePower > 99999 Then
                    Me.nudTHP.Value = 99999
                Else
                    Me.nudTHP.Value = .TotalHorsePower
                End If

                If .TonsPerOperativeBrake > 99999 Then
                    Me.nudTOPB.Value = 99999
                Else
                    Me.nudTOPB.Value = .TonsPerOperativeBrake
                End If

                Try
                    Me.cmbTrainType.Text = .TrainType
                Catch
                End Try

                Try
                    Me.cmbSubType.Text = .SubType
                Catch
                End Try

                If IsValidDate(.TrainHOS) Then
                    Try
                        Me.dtTrainHOS.Value = .TrainHOS
                    Catch ex As Exception
                    End Try
                End If

                Me.nudTotalCars.Value = .TotalCars
                Me.txtVia.Text = .TrainVia
                If IsValidDate(.ReleaseTime) Then Me.dtTrnReleaseTime.Value = .ReleaseTime
                'Me.dtTrnReleaseTime.Value = .ReleaseTime
                If IsValidDate(.CallTime) Then
                    dtAnounceTime.Text = Format(.CallTime, "HHmm")
                    dtAnounceDate.Value = Format(.CallTime, "MM/dd/yyyy")
                End If

                Me.chkCBTCEquipped.Checked = .CBTCEquipped
                Me.txtSchDepTime.Text = .SchTimeDeparture
                Me.txtSchArrTime.Text = .SchTimeArrival
                Try
                    Dim bull As String
                    For Each bull In .TrackBull
                        If bull <> "" Then
                            Me.lvBulletins.Items.Add(bull)
                        End If
                    Next
                Catch
                End Try

            End With
            Dim tp As TabPage
            tp = Me.tbcTrain.TabPages.Item(Me.tbcTrain.TabPages.IndexOf(tbTrainInfo))
            Me.tbcTrain.SelectedTab = tp
            Me.cmbTrainID.Focus()
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Sub AddOsTimes(ByVal trn As TrainID)
        Try
            If optEnableDenverSpecificOptions Then Exit Sub
            Dim OS As String
            Dim OsString() As String
            Dim item As ListViewItem
            lvOS.Items.Clear()
            If optEnableCNSpecificOptions Then
                LoadOSTimes(trn)
            Else
                Dim OSTimes As New ArrayList
                OSTimes = trn.OSTimes

                If optEnableBRCSpecificChecks Then
                    OSTimes = FilterOSTimes(trn.OSTimes)
                End If
                If optEnableTrainMovementReporting Then
                    AddTrainMovements(trn)
                Else
                    For Each OS In OSTimes
                        OsString = OS.Split("|")
                        If OsString.Length >= 3 Then
                            Dim strOSTime As String = OsString(1)
                            If optEnableTrainFunctionalityARRC Then
                                strOSTime = Format(CDate(strOSTime), optSystemDateTimeFormat3)
                            End If
                            item = New ListViewItem(strOSTime)
                            Me.lvOS.Items.Add(item)
                            item.SubItems.Add(OsString(0))

                            If optEnablePortugueseResourceLanguageFile Then
                                If OsString(2).Trim.ToUpper = "NOT AVAILABLE" Then item.SubItems.Add(mstrTrainID_NotAvailable)
                            Else
                                item.SubItems.Add(OsString(2))
                            End If
                            item = Nothing
                        End If
                    Next
                End If

            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        If optEnableTrainMovementReporting Then
            AddTrainMovements(trn)
        End If
    End Sub

    Private Function AddTrainMovements(ByVal trn As TrainID) As Boolean
        Try
            'trn.PerformGetTrainMovements()
            lvTrnMovements.Items.Clear()
            If trn.TrnMovements.Count > 0 Then
                Dim OS As String
                Dim OsString() As String
                Dim item As ListViewItem
                lvTrnMovements.Items.Clear()
                For Each OS In trn.TrnMovements
                    OsString = OS.Split("|")
                    item = New ListViewItem(OsString(0))

                    item.SubItems.Add(OsString(1))
                    item.SubItems.Add(OsString(2))
                    item.SubItems.Add(OsString(3))
                    Me.lvTrnMovements.Items.Add(item)
                    item = Nothing
                Next
            End If
            Return True
        Catch ex As Exception
            SystemException(ex.ToString)
            Return False
        End Try
    End Function

    Private Function FilterOSTimes(ByRef OSTimes As ArrayList) As ArrayList
        Dim returnArray As New ArrayList
        Dim OS As String
        Try
            If OSTimes.Count > 0 Then
                For Each OS In OSTimes
                    If Not returnArray.Contains(OS) Then
                        returnArray.Add(OS)
                    End If
                Next
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return returnArray
    End Function

