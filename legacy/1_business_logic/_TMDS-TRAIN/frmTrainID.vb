    ''' <summary>
    ''' Modify Train
    ''' </summary>
    ''' <param name="pTrack"></param>
    ''' <param name="pLocation"></param>
    ''' <param name="pTrainIDPosition"></param>
    ''' <returns></returns>
    Overloads Function ModifyTrain(ByVal pTrack As Track, ByVal pLocation As Point, ByVal pTrainIDPosition As Integer) As Boolean
        Try
            FormEvent("ModifyTrain:1:Track=" & pTrack.Name & ":TrainPosition=" & pTrainIDPosition.ToString)
            Dim IsValidEdiatbleTrain As Boolean = True
            Me.Location = pLocation
            TrackRef = pTrack
            GetTrainUnits()
            Me.cmbTrainID.Enabled = False
            If optEnableCNSpecificOptions Then
                cmbUnitID.Select()
                cmbUnitID.SelectAll()
                cmbUnitID.Focus()
            End If
            If pTrack.TrainIDs.Count > 0 Then
                CurrentTrain = pTrack.TrainIDs(pTrainIDPosition)
                If optEnableShadowMode AndAlso optEnableTerritoryDeskAssignmentMode AndAlso (CurrentTrain.myTrack IsNot Nothing AndAlso Not CurrentTrain.myTrack.IsValidTrackForOperation) Then IsValidEdiatbleTrain = False
                ExistingEngineID = CurrentTrain.IdentifingUnit
                If optEnableShadowMode OrElse optEnableTerritoryDeskAssignmentMode Then DoTrainEventsForceRefresh(CurrentTrain)
                If CurrentTrain IsNot Nothing AndAlso optEnableTrainEventFunctions AndAlso optApplyTrainSheetConfigurationForARRC Then
                    CurrentTrain.LoadTrainEvents()
                End If
                ApplyTrainPropertiesToForm(CurrentTrain, True)
                If optEnablePTCBOSVETMSMode Then
                    TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainStatusRequest(CurrentTrain)
                End If
                If CurrentTrain IsNot Nothing AndAlso CurrentTrain IsNot Nothing AndAlso optApplyTrainSheetConfigurationForARRC Then
                    btnFlipConsistPosition.Visible = True
                    If CurrentTrain.UnitsInTrain IsNot Nothing AndAlso CurrentTrain.UnitsInTrain.Count > 1 Then
                        btnFlipConsistPosition.Enabled = True
                    Else
                        btnFlipConsistPosition.Enabled = False
                    End If
                    If CurrentTrain IsNot Nothing AndAlso CurrentTrain.TrainInActive Then
                        Me.Text = Me.Text & " - DE-ACTIVATED ENGINE "
                    Else
                        Me.Text = Me.Text & " - ACTIVE ENGINE "
                    End If
                End If
                If Not IsValidEdiatbleTrain Then Me.LockViewTrainProperties()
                Me.Text = Me.Text & " (" & CurrentTrain.Name & ")"
                If optEnableDenverSpecificOptions Then Me.Text = "TRIP CAR -" & CurrentTrain.Name & " -  " & CurrentTrain.GetMyComplaintStatus
                Return True
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    ''' <summary>
    ''' Modify Train
    ''' </summary>
    ''' <param name="pTrack"></param>
    ''' <param name="pLocation"></param>
    ''' <param name="pTrainIDPosition"></param>
    ''' <param name="pTrainPosition"></param>
    ''' <param name="pReadyOnlyMode"></param>
    ''' <returns></returns>
    Overloads Function ModifyTrain(ByVal pTrack As Track, ByVal pLocation As Point, ByVal pTrainIDPosition As Integer, ByVal pTrainPosition As Integer, Optional ByVal pReadyOnlyMode As Boolean = False) As Boolean
        Try
            FormEvent("ModifyTrain:2:Track=" & pTrack.Name & ":TrainPosition=" & pTrainIDPosition.ToString)
            Dim IsValidEdiatbleTrain As Boolean = True
            Dim FarRightPosition As Int32 = TMDS.SystemForms.MySystemForms.frmMainMDI.Left + pTrack.CurrentDrawingForm.Left + pTrack.CurrentDrawingForm.Width
            Dim NewLeftPosition As Int32 = TMDS.SystemForms.MySystemForms.frmMainMDI.Left + pTrack.CurrentDrawingForm.Left + pTrack.CurrentDrawingForm.Width - Me.Width - 50 ' TrackReference.CurrentDrawingForm.Width
            Me.Location = pLocation
            TrackRef = pTrack
            GetTrainUnits()
            Me.cmbTrainID.Enabled = False
            If pTrack.TrainIDs.Count > 0 Then
                CurrentTrain = pTrack.TrainIDs(pTrainPosition)
                If optEnableShadowMode AndAlso optEnableTerritoryDeskAssignmentMode AndAlso (CurrentTrain.myTrack IsNot Nothing AndAlso Not CurrentTrain.myTrack.IsValidTrackForOperation) Then IsValidEdiatbleTrain = False
                ExistingEngineID = CurrentTrain.IdentifingUnit
                If Not IsValidEdiatbleTrain Then DoTrainEventsForceRefresh(CurrentTrain)
                ApplyTrainPropertiesToForm(CurrentTrain, True)
                If optEnablePTCBOSVETMSMode Then
                    TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainStatusRequest(CurrentTrain)
                End If
                If optApplyTrainSheetConfigurationForARRC Then
                    btnFlipConsistPosition.Visible = True
                    If CurrentTrain IsNot Nothing AndAlso CurrentTrain.UnitsInTrain IsNot Nothing AndAlso CurrentTrain.UnitsInTrain.Count > 1 Then
                        btnFlipConsistPosition.Enabled = True
                    Else
                        btnFlipConsistPosition.Enabled = False
                    End If
                    If CurrentTrain IsNot Nothing AndAlso CurrentTrain.TrainInActive Then
                        Me.Text = Me.Text & " - DE-ACTIVATED ENGINE "
                    Else
                        Me.Text = Me.Text & " - ACTIVE ENGINE "
                    End If
                End If
                If Not IsValidEdiatbleTrain Then Me.LockViewTrainProperties()
                Me.Text = Me.Text & " (" & CurrentTrain.Name & ")"
                If optEnableDenverSpecificOptions Then Me.Text = "TRIP CAR -" & CurrentTrain.Name & " -  " & CurrentTrain.GetMyComplaintStatus
                Return True
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Function

    ''' <summary>
    ''' Modify Train
    ''' </summary>
    ''' <param name="pLocation"></param>
    ''' <param name="pTrain"></param>
    ''' <returns></returns>
    Overloads Function ModifyTrain(ByVal pLocation As Point, ByVal pTrain As String) As Boolean
        Try
            FormEvent("ModifyTrain:3:Train=" & pTrain)
            Me.Location = pLocation
            Me.cmbTrainID.Enabled = False
            ViewTrainMode = True
            CurrentTrain = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(pTrain)
            If IsNothing(CurrentTrain) Then
                CurrentTrain = TMDS.SystemUtilities.FetchData.FindTrainFromPseudoName(pTrain)
            End If
            If Not IsNothing(CurrentTrain) Then
                TrackRef = CurrentTrain.myTrack
                ExistingEngineID = CurrentTrain.IdentifingUnit
                CurrentTrain.GetOsRecords()
                Threading.Thread.Sleep(20)
                ApplyTrainPropertiesToForm(CurrentTrain, True)
                If optLockTrainPropertiesForViewOnlyTrains Then
                    Me.LockViewTrainProperties()
                    If optEnableCNSpecificOptions Then
                        ModifyTrain = False
                        If CurrentTrain.OSTimes IsNot Nothing AndAlso CurrentTrain.OSTimes.Count > 0 Then
                        Else
                            If lvOS.Items.Count = 0 Then
                                CurrentTrain.GetOsRecords()
                                AddOsTimes(CurrentTrain)
                            End If
                        End If
                    End If
                    If optApplyTrainSheetConfigurationForARRC Then
                        If CurrentTrain IsNot Nothing AndAlso CurrentTrain.TrainInActive Then
                            Me.Text = Me.Text & " - DE-ACTIVATED ENGINE "
                        Else
                            Me.Text = Me.Text & " - ACTIVE ENGINE "
                        End If
                        btnFlipConsistPosition.Visible = True
                        If CurrentTrain IsNot Nothing AndAlso CurrentTrain.UnitsInTrain IsNot Nothing AndAlso CurrentTrain.UnitsInTrain.Count > 1 Then
                            btnFlipConsistPosition.Enabled = True
                        Else
                            btnFlipConsistPosition.Enabled = False
                        End If
                    End If
                End If
                Me.Text = Me.Text & " (" & CurrentTrain.Name & ")"
                If optEnableDenverSpecificOptions Then Me.Text = "TRIP CAR -" & CurrentTrain.Name & " -  " & CurrentTrain.GetMyComplaintStatus
                If optEnablePTCBOSVETMSMode Then
                    TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainStatusRequest(CurrentTrain)
                End If
                Return True
            Else
                Return False
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Function

