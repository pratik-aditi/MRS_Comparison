    Function FormatTime(ByRef tb As TextBox) As Boolean
        Try
            If tb.TextLength < 4 And tb.Text <> "NONE" And tb.Text <> "----" Then
                tb.Text = "----"
                tb.Focus()
                FormatTime = False
            ElseIf tb.Text <> "NONE" And tb.Text <> "----" Then
                FormatTime = True
                If InStr(tb.Text, ":") = 0 Then
                    tb.Text = Mid(tb.Text, 1, 2) & ":" & Mid(tb.Text, 3, 2)
                End If
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Function

    Function FormatDate(ByRef tb As TextBox) As Boolean
        Try

            If tb.TextLength < 6 And tb.Text <> "NONE" And tb.Text <> "----" Then
                tb.Text = "----"
                tb.Focus()
                FormatDate = False
            ElseIf tb.Text <> "NONE" And tb.Text <> "----" Then
                FormatDate = True
                If InStr(tb.Text, "-") = 0 Then
                    tb.Text = Mid(tb.Text, 1, 2) & "-" & Mid(tb.Text, 3, 2) & "-" & Mid(tb.Text, 5, 2)
                End If
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Function

