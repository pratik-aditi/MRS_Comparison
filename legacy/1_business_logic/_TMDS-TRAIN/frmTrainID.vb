    Private Sub ApplyNewOffReleaseTime(ByRef OffReleaseTime As TextBox, ByVal OffReleasedate As TextBox, ByVal OnReleaseTmTxtbx As TextBox, ByVal OnReleasedateTxtbx As TextBox, ByRef HOSTmTxtbx As TextBox, ByRef HOSdateTxtbx As TextBox)
        Dim tb As TextBox = Nothing
        Dim strHosTime As String = ""
        Dim strHosdate As String = ""
        Dim ROnDate As Date
        Try
            tb = CType(OffReleaseTime, TextBox)
            If tb.Tag IsNot Nothing AndAlso tb.Tag.ToString.Trim <> "" Then
                Dim ROnDatestr As String = OnReleasedateTxtbx.Text & " " & OnReleaseTmTxtbx.Text
                If Date.TryParse(ROnDatestr, ROnDate) Then
                    Dim RoffDatestr As String = OffReleasedate.Text
                    If Date.TryParse(RoffDatestr, Nothing) Then
                        Dim newROffDatestr As String = RoffDatestr & " " & tb.Text
                        Dim newROffDate As Date
                        If Date.TryParse(newROffDatestr, newROffDate) Then
                            Dim tmSpan As TimeSpan = newROffDate.Subtract(ROnDate)
                            If tmSpan.TotalHours < 4 Then
                                MsgBox("Invalid OFF Release Time")
                                tb.Select()
                                tb.SelectAll()
                                tb.Focus()
                                Exit Sub
                            End If
                            Dim sTime As String = Format(CDate(tb.Text), "HH:mm")

                            Dim HosDate As Date = GetHOSDate(OnReleaseTmTxtbx.Name, False)
                            HosDate = HosDate.AddHours(tmSpan.TotalHours)
                            'If tb.Tag = sTime Then
                            '    HosDate = newROffDate.AddHours(10)
                            'Else
                            '    HosDate = newROffDate.AddHours(12)
                            'End If
                            If Format(HosDate, "HH:mm") = "00:00" Then HosDate = HosDate.AddMinutes(1)
                            strHosTime = Format(HosDate, "HH:mm")
                            strHosdate = Format(HosDate, "MM-dd-yy")
                            HOSTmTxtbx.Text = strHosTime
                            HOSdateTxtbx.Text = strHosdate
                        End If
                    End If
                End If
            End If
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Sub

