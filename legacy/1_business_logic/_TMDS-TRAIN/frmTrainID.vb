    Private Sub DoTrainEventsForceRefresh(trn As TrainID)
        Try
            trn.GetOsRecords()
            If optEnableWorkOrderFunctions Then
                trn.LoadWorkOrders()
            End If
            If optEnableTrainRestrictionFunctions Then
                trn.PerformTrainRestrictions(True)
            End If
            If optEnableLoadTrainSchedule Then
                trn.LoadTrainSchedule()
            End If

            If optEnableTrainCarFunctions Then
                trn.LoadTrainCars()
            End If

            If optEnableTrainEventFunctions Then
                trn.LoadTrainEvents()
            End If

            If optEnableWorkTaskFunctions Then
                trn.LoadWorkTasks()
            End If
            trn.LoadTrainDelays()
        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Sub

