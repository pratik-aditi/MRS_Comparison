    Private Sub GetEngineers()
        Dim FetchEngineID As String = "SELECT * FROM " & gtblEngineers & " ORDER BY LastName"
        Dim DatabaseCommand As OleDbCommand
        Dim DataReader As OleDbDataReader
        Dim dbconn As OleDb.OleDbConnection

        Try
            dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
            DatabaseCommand = New OleDbCommand(FetchEngineID, dbconn)
            dbconn.Open()
            DataReader = DatabaseCommand.ExecuteReader()
            While DataReader.Read()
                If DataReader.FieldCount >= 2 Then
                    If Not DataReader.IsDBNull(1) And Not DataReader.IsDBNull(2) Then
                        If Not optFlopEngineerNameWhenLoading Then
                            Me.cmbEng.Items.Add(DataReader.GetString(2) & ", " & DataReader.GetString(1))
                            Me.cmbEngR.Items.Add(DataReader.GetString(2) & ", " & DataReader.GetString(1))
                        Else
                            Me.cmbEng.Items.Add(DataReader.GetString(1) & ", " & DataReader.GetString(2))
                            Me.cmbEngR.Items.Add(DataReader.GetString(1) & ", " & DataReader.GetString(2))
                        End If

                    ElseIf DataReader.IsDBNull(2) Then
                        Me.cmbEng.Items.Add(DataReader.GetString(1))
                        Me.cmbEngR.Items.Add(DataReader.GetString(1))
                    End If
                End If
            End While
            DatabaseCommand = Nothing
            dbconn.Close()
            If optApplyTrainSheetConfigurationForARRC Then
                Dim Item As String
                For Each Item In cmbEng.Items
                    With Me.cmbCond2R.Items
                        .Add(Item)
