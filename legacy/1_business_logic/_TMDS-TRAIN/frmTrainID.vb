    Dim ConsistChangeEventDetected As Boolean

    Private Sub DoCheckForConsistChangeEvents()
        Try
            If optEnableTrainConsistRecursiveUpdateToLinkedTrains AndAlso ConsistChangeEventDetected Then
                If IsNothing(CurrentTrain) Then Exit Sub
                Dim theTrainList As New ArrayList
                Dim dbconn As OleDbConnection = Nothing
                Dim dbcomm As OleDbCommand = Nothing
                Dim dr As OleDbDataReader = Nothing
                If String.IsNullOrEmpty(Trim(CurrentTrain.ConsistCodeUID)) Then Exit Sub
                Dim Query As String = "Select Symbol FROM tblTrainsActive WHERE (ConsistCodeUID = '" & CurrentTrain.ConsistCodeUID & "') AND (InUsed = 0) AND (DepTime > '" & CurrentTrain.DepTime & "') ORDER BY DepTime"
                Try
                    dbconn = New OleDbConnection(gConnectionStringDynamic)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(Query, dbconn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        If Not dr.IsDBNull(0) Then
                            If Not theTrainList.Contains(dr.GetString(0)) AndAlso CurrentTrain.Name <> dr.GetString(0) Then
                                theTrainList.Add(dr.GetString(0))
                            End If
                        End If
                    End While
                    If theTrainList.Count = 0 Then Exit Sub

                    Dim TrainList As New StringBuilder
                    Dim MessageList As New ArrayList
                    MessageList.Add("A TRAIN CONSIST CHANGE EVENT HAS BEEN DETECTED.")
                    MessageList.Add("THESE TRAINS BELOW ARE CURRENTLY LINK TO THIS TRAIN (" & CurrentTrain.Name & ")")

                    Dim t As String
                    For Each t In theTrainList
                        If Trim(t) <> "" Then
                            If TrainList.Length = 0 Then
                                TrainList.Append(t)
                            Else
                                TrainList.Append(", " & t)
                            End If
                        End If
                    Next
                    MessageList.Add(TrainList.ToString)
                    MessageList.Add("")
                    MessageList.Add("WOULD YOU LIKE TO APPLY THESE CONSIST CHANGES TO THESE TRAIN(S)?")
                    MessageList.Add("")

                    Dim ResultCode As Integer = ShowCustomMessageBox(MessageList, "CONSIST CHANGE CHECK", True, Nothing, False, True, Me, False, Nothing, Nothing, True)
                    If ResultCode = 6 Then
                        ApplyConsistChangesToTrainList(theTrainList)
                    End If

                Catch ex As Exception
                    GetErrorDetails(ex)
                Finally
                    dbconn.Close()
                    dbconn = Nothing
                    dbcomm = Nothing
                    dr = Nothing
                End Try
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

    Private Sub ApplyConsistChangesToTrainList(TrainList As ArrayList)
        Try
            Dim t As String
            For Each t In TrainList
                Dim trn As TrainID = TMDS.SystemUtilities.TrainFunction.RetrieveTrainProperties(t)
                If Not IsNothing(trn) Then

                    trn.IdentifingUnit = CurrentTrain.IdentifingUnit
                    trn.Units = CurrentTrain.Units.Clone
                    trn.OEmts = CurrentTrain.OEmts
                    trn.OLength = CurrentTrain.OLength
                    trn.OTons = CurrentTrain.OTons
                    trn.OLoads = CurrentTrain.OLoads
                    trn.NumberOfAxles = CurrentTrain.NumberOfAxles
                    trn.NumberOperatingBrakes = CurrentTrain.NumberOperatingBrakes
                    trn.UpdateTrainConsist()
                    trn.UpdateIdentifingUnit()
                    trn.UpdateOtherUnits()
                    trn.PerformConsistDatabaseUpdatePTC()
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub


