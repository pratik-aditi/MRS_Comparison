    Private Sub LoadWorkOrders(ByVal trn As TrainID)
        Try

            Dim lv As ListViewItem
            lvWorkOrders.Items.Clear()
            Dim wo As WorkOrder

            For Each wo In trn.myWorkOrderList
                lv = New ListViewItem(wo.myUID)
                Dim OKTime As Date = wo.myTimeStamp
                If wo.WorkComepleted OrElse wo.WorkDeleted Then OKTime = wo.WorkOKTime
                lv.SubItems.Add(wo.myEventType)
                lv.SubItems.Add(wo.myCarUID)
                'lv.SubItems.Add(Format(wo.myTimeStamp, "MMdd HHmm"))
                lv.SubItems.Add(Format(OKTime, "MMdd HHmm"))
                lv.SubItems.Add(wo.myStationName)
                lv.SubItems.Add(wo.myCarReasonForEvent.ToUpper)
                lv.SubItems.Add("STATUS=" & wo.myCarLoadStatus & " LEN=" & wo.myCarLength.ToString.PadLeft(3, "0") & " TONS=" & wo.myCarTons.ToString.PadLeft(3, "0") & " NOB=" & wo.myCarNumOfBrakes.ToString.PadLeft(3, "0") & " NOA=" & wo.myCarNumOfAxles.ToString.PadLeft(3, "0"))
                lvWorkOrders.Items.Add(lv)
                If wo.WorkComepleted Then
                    lv.BackColor = Color.LightGreen
                ElseIf wo.WorkDeleted Then
                    lv.BackColor = Color.Red
                End If
            Next
            lvWorkOrders.Refresh()
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

