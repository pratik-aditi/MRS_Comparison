    Private Sub FormatOnTime(ByRef sender As TextBox, ByRef Name As ComboBox, ByRef OnDate As TextBox, ByRef hosTime As TextBox, ByRef hosDate As TextBox, ByVal TimeExists As Boolean)
        Dim UserMessage As String
        Dim UserResponse As Integer
        Try
            Dim tb As TextBox = CType(sender, TextBox)
            If Name.Text = "" Then Exit Sub
            FormatTime(tb)
            If Not ValidateTime(tb) And tb.Text <> "NONE" And tb.Text <> "----" Then
                tb.Text = "----"
                tb.Focus()
                SendKeys.Send("{Home}+{End}")
            Else
                If optEnableAutoTimeIncrementingForCrewHOS Then
                    If CInt(Now.Hour.ToString) > CInt(Mid(tb.Text, 1, 2)) Then
                        OnDate.Text = Format(Now.AddDays(1), "MM-dd-yy")
                    Else
                        OnDate.Text = Format(Now, "MM-dd-yy")
                    End If
                Else
                    If optApplyTrainSheetConfigurationForBRC Then
                        Dim NewBRCOnDate As String = GetBRCValidDates(sender.Text)
                        If NewBRCOnDate.Trim <> "" Then OnDate.Text = NewBRCOnDate
                    End If
                    'If IsDate(OnDate.Text) AndAlso CDate(OnDate.Text) > Now.ToShortDateString AndAlso optApplyTrainSheetConfigurationForBRC Then
                    If IsDate(OnDate.Text) AndAlso optApplyTrainSheetConfigurationForBRC Then
                        OnDate.Text = Format(CDate(OnDate.Text), "MM-dd-yy")
                    Else
                        OnDate.Text = Format(Now, "MM-dd-yy")
                    End If


                End If

                If TimeExists Then
                    If optEnablePromptForCrewChange Then
                        UserMessage = optTrainString17
                        UserResponse = MessageBox.Show(Me, UserMessage, optTrainString18, MessageBoxButtons.YesNo, MessageBoxIcon.Question)
                    End If
                    If UserResponse = 6 Or Not optEnablePromptForCrewChange Then
                        If Not Me.CheckForValidTime(tb.Text) Then
                            tb.Text = Format(Now, "HH:mm")
                        End If
                        If Not Me.CheckForValidTrainDateTime(OnDate.Text) Then
                            OnDate.Text = Format(Now, "MM-dd-yy")
                        End If




                        Dim tDate As Date = CDate(OnDate.Text & " " & tb.Text)
                        Dim nDate As Date = tDate.Add(New TimeSpan(optHOSDefaultTime, 0, 0))
                        If Format(nDate, "HH:mm") = "00:00" Then nDate.AddMinutes(1)
                        hosTime.Text = Format(nDate, "HH:mm")
                        hosDate.Text = Format(nDate, "MM-dd-yy")

                        If optEnableTrainSheetCrewCNTabOrder Then
                            'Select Case tb.Name
                            '    Case "txtTimeOnE"
                            '        Me.cmbCond.Focus()
                            '    Case "txtTimeOnER"
                            '        Me.cmbCondR.Focus()
                            'End Select
                        ElseIf optApplyTrainSheetConfigurationForBRC Then
                        ElseIf optApplyTrainSheetConfigurationForARRC Then
                        ElseIf Not optEnableTrainSheetCrewSequentialTabOrder Then
                            'Me.cmbCond.Focus()
                            If tb.Name.Substring(tb.Name.Trim.Length - 1, 1).Trim.ToUpper = "R" Then
                                Me.cmbCondR.Focus()
                            Else
                                Me.cmbCond.Focus()
                            End If
                        End If



                    End If
                Else
                    If Not Me.CheckForValidTime(tb.Text) Then
                        tb.Text = Format(Now, "HH:mm")
                    End If
                    If Not Me.CheckForValidTrainDateTime(OnDate.Text) Then
                        OnDate.Text = Format(Now, "MM-dd-yy")
                    End If
                    Dim tDate As Date = CDate(OnDate.Text & " " & tb.Text)
                    Dim nDate As Date = tDate.Add(New TimeSpan(optHOSDefaultTime, 0, 0))
                    If Format(nDate, "HH:mm") = "00:00" Then nDate.AddMinutes(1)


                    hosTime.Text = Format(nDate, "HH:mm")
                    hosDate.Text = Format(nDate, "MM-dd-yy")
                End If
                If optEnableDateControlForOnDutyDate Then
                    Select Case OnDate.Name
                        Case "txtDateOnE"
                            If Date.TryParse(txtDateOnE.Text, Nothing) Then dtOnDutyE.Value = CDate(txtDateOnE.Text)
                            If Date.TryParse(txtDateOnC.Text, Nothing) Then dtOnDutyC.Value = CDate(txtDateOnC.Text)
                        Case "txtDateOnC"
                            If Date.TryParse(txtDateOnC.Text, Nothing) Then dtOnDutyC.Value = CDate(txtDateOnC.Text)
                    End Select
                End If
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

