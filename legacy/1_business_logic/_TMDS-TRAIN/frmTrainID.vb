    Private Sub LoadEngineersByType()
        Dim dbComm As OleDbCommand = Nothing
        Dim dr As OleDbDataReader = Nothing
        Dim EngineerTrainee As New ArrayList
        Dim Engineer As New ArrayList
        Try
            Dim FetchEngineer As String = "SELECT UID, FirstName, LastName, UseType FROM " & gtblEngineers & " ORDER BY LastName"
            Using DbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                DbConn.Open()
                dbComm = New OleDbCommand(FetchEngineer, DbConn)
                dr = dbComm.ExecuteReader
                While dr.Read
                    Dim UserType As String = ""
                    Dim FirstName As String = ""
                    Dim LastName As String = ""
                    Dim Name As String = ""

                    If Not dr.IsDBNull(1) Then FirstName = dr.GetValue(1)
                    If Not dr.IsDBNull(2) Then LastName = dr.GetValue(2)
                    If Not dr.IsDBNull(3) Then UserType = dr.GetValue(3)
                    If Not optFlopEngineerNameWhenLoading Then
                        Name = LastName.ToUpper.Trim & ", " & FirstName.ToUpper.Trim
                    Else
                        Name = FirstName.ToUpper.Trim & ", " & LastName.ToUpper.Trim
                    End If

                    Select Case UserType.ToUpper.Trim
                        Case "ENG TRAINEE"
                            If Not EngineerTrainee.Contains(Name) Then EngineerTrainee.Add(Name)
                        Case "ENGINEER"
                            If Not Engineer.Contains(Name) Then Engineer.Add(Name)
                    End Select
                End While
                dr.Close()
                DbConn.Close()
            End Using
            If optApplyTrainSheetConfigurationForARRC Then
                Dim Item As String
                For Each Item In Engineer
                    Me.cmbEng.Items.Add(Item)
                    Me.cmbCond2.Items.Add(Item)
                    Me.cmbEngR.Items.Add(Item)
                    Me.cmbCond2R.Items.Add(Item)
                Next
                For Each Item In EngineerTrainee
                    Me.cmbEngTrnee.Items.Add(Item)
                    Me.cmbEngTrneeR.Items.Add(Item)
                Next
                With Me.cmbEng
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
                With Me.cmbEngR
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
                With Me.cmbCond2
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
                With Me.cmbCond2R
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
                With Me.cmbEngTrnee
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
                With Me.cmbEngTrneeR
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
            End If

        Catch ex As Exception
            GetErrorDetails(ex)
        Finally
            If dbComm IsNot Nothing Then dbComm.Dispose()
            dbComm = Nothing
            If dr IsNot Nothing Then dr = Nothing
        End Try
    End Sub

