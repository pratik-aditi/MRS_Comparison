    Private Sub CalculateFormPosition(ByVal PickPoint As Point)
        Try
            Dim BottomPosition As Int32 = Me.Height + PickPoint.Y
            Dim RightPosition As Int32 = Me.Width + PickPoint.X

            If BottomPosition >= SystemForms.MySystemForms.frmMainMDI.Height Then
                Me.Top = SystemForms.MySystemForms.frmMainMDI.Height - Me.Height - 20
            Else
                Me.Top = PickPoint.Y
            End If

            If PickPoint.X <= 1024 Then
                If RightPosition >= 1024 Then
                    Me.Left = 1024 - Me.Width - 20
                Else
                    Me.Left = PickPoint.X
                End If
            ElseIf PickPoint.X <= 2048 Then
                If RightPosition >= 2048 Then
                    Me.Left = 2048 - Me.Width - 20
                Else
                    Me.Left = PickPoint.X
                End If
            ElseIf PickPoint.X <= 3072 Then
                If RightPosition >= 3072 Then
                    Me.Left = 1024 - Me.Width - 20
                Else
                    Me.Left = PickPoint.X
                End If
            ElseIf PickPoint.X <= 4096 Then
                If RightPosition >= 4096 Then
                    Me.Left = 4096 - Me.Width - 20
                Else
                    Me.Left = PickPoint.X
                End If
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Private Sub btnPrint_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnPrint.Click
        Try
            FormEvent("CLICKED - BUTTON PRINT")
            If CurrentTrain Is Nothing Then Exit Sub
            Dim docTrn As New TMDS.PrintForms.TrainDocument()
            Dim FileName As String = docTrn.BuildTrainDocument(CurrentTrain)
            If System.IO.File.Exists(FileName) Then
                Dim startInfo As New ProcessStartInfo(FileName)
                startInfo.UseShellExecute = True
                Process.Start(startInfo)
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

    Function ValidateTime(ByRef tb As TextBox) As Boolean
        Try
            If Date.TryParse(tb.Text, Nothing) Then
                Dim sTime As String = Format(CDate(tb.Text), "HH:mm")
                'dTime = CDate(Now.Date & " " & sTime)
                If sTime = "00:00" Then
                    ValidateTime = False
                    'tb.Text = "HHMM"
                Else
                    ValidateTime = True
                End If
            Else
                ValidateTime = False
            End If
        Catch
            ValidateTime = False
        End Try
    End Function

    Function myValidateDate(ByRef tb As TextBox) As Boolean
        Try
            Dim sdate As String = Format(CDate(tb.Text), "mm-dd-yy")
            myValidateDate = True
        Catch
            myValidateDate = False
        End Try
    End Function

    Private Function CheckDate(ByVal DateStringToTest As String, ByVal TimeStringToTest As String) As Date
        Try
            If TimeStringToTest.ToUpper = "HHMM" Then
                TimeStringToTest = Now.TimeOfDay.ToString
            Else
                Dim TestDate As Date = CDate(DateStringToTest & " " & TimeStringToTest)
                CheckDate = TestDate
            End If

        Catch ex As Exception
            SystemException(ex.ToString)
            CheckDate = Now
        End Try
    End Function

