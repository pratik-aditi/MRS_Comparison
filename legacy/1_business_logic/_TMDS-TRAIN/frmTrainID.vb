    ''' <summary>
    ''' Check For Consist Change On Train PTC
    ''' </summary>
    Private Sub CheckForConsistChangeOnTrainPTC()
        Try
            Dim consistChange As Boolean = False
            If CurrentTrain.CBTCEquipped OrElse
                CurrentTrain.IsActivePTC Then
                If CurrentTrain.OLength <> nudLenO.Value OrElse
                    CurrentTrain.OLoads <> nudLoadO.Value OrElse
                    CurrentTrain.OEmts <> nudEmpO.Value OrElse
                    CurrentTrain.OTons <> nudTonO.Value OrElse
                    CurrentTrain.MaxSpd <> nudMaxSpd.Value OrElse
                    CurrentTrain.NumberOfAxles <> nudAxles.Value OrElse
                    CurrentTrain.NumberOperatingBrakes <> nudBrakes.Value OrElse
                    lvUnits.Items.Count <> CurrentTrain.Units.Count OrElse
                    (Not String.IsNullOrWhiteSpace(CurrentTrain.RestrictionType) AndAlso
                    Not CurrentTrain.RestrictionType.Equals(cmbRestrictionType.Text)) Then
                    consistChange = True
                End If
                For Each unit As ListViewItem In lvUnits.Items
                    If Not CurrentTrain.Units.Contains(unit.Text) Then
                        consistChange = True
                        Exit For
                    End If
                Next
                If lvUnits.Items.Count = CurrentTrain.Units.Count Then
                    For Index As Integer = 0 To lvUnits.Items.Count - 1
                        If lvUnits.Items.Item(Index).Text <> CurrentTrain.Units.Item(Index).ToString Then
                            consistChange = True
                            Exit For
                        End If
                    Next
                End If
                SystemEvent($"{GetCurrentMethod.Name} ConsistChange={consistChange}")
                CurrentTrain.ConsistChange = consistChange
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

