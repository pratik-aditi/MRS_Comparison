    ''' <summary>
    ''' Find auxiliary vehicle for fill in the lblAuxVeh label
    ''' </summary>
    ''' <param name="vehicle">id to find in database</param>
    ''' <param name="ignoreAuxiliaryVehicle">ignore to update the aux vehicle field</param>
    ''' <returns>Return a locomotive id valid found in database</returns>
    Private Function FindAuxVeihID(vehicle As String, Optional ignoreAuxiliaryVehicle As Boolean = False) As String
        Try
            lblAuxVeh.Text = String.Empty
            Dim newVehicle As String = vehicle
            If newVehicle.Contains("MRS") Then newVehicle = $"MRS{Space(3)}{newVehicle.TrimEnd.Remove(0, 3).TrimStart}"
            Dim data As DataTable = gRepositories.TrainRepository.GetAuxiliaryVehicleByName(newVehicle)
            If data?.Rows.Count > 0 Then
                If Not ignoreAuxiliaryVehicle Then lblAuxVeh.Text = data.Rows(0)("AuxiliaryVehicleIdentifier").ToString
                Return data.Rows(0)("UID").ToString
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
        Return vehicle
    End Function

