    ''' <summary>
    ''' Form load
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    Private Sub frmTrainID_Load(ByVal sender As System.Object,
                                ByVal e As System.EventArgs) Handles MyBase.Load
        Dim pagesToRemove As New ArrayList()
        Dim pagesToAdd As New ArrayList
        Dim pagesOrder As New ArrayList
        Try
            FormEvent($"{GetCurrentMethod.Name}:Start")
            If FormLoaded Then Exit Sub
            FormLoaded = True
            If optEnableViewSubTrainSheets Then gbSubTrainSheet.Enabled = True
            Select Case optRailRoadEnumName
                Case RailRoadName.MRS
                    For Each tabPage As TabPage In tbcTrain.TabPages
                        Select Case tabPage.Text
                            Case "OS Events", "Bulletins", "Composition", "Work Orders", "Train Restrictions",
                                 "Train Schedule", "Restrictions", "Schedule"
                                pagesToRemove.Add(tabPage)
                        End Select
                    Next
                Case RailRoadName.RUMO
                    For Each tabPage As TabPage In tbcTrain.TabPages
                        Select Case tabPage.Text
                            Case "OS Events", "Bulletins", "Composition", "Work Orders", "Train Restrictions",
                                 "Train Schedule", "Restrictions", "Schedule", "Comments", "OS Times", "Delays",
                                 "Events", "COMENTÁRIOS", "EVENTOS", "DEMORAS", "CIRCULAÇÃO NOS PÁTIOS"
                                pagesToRemove.Add(tabPage)
                        End Select
                    Next
                Case Else
                    For Each tabPage As TabPage In tbcTrain.TabPages
                        Select Case tabPage.Text.ToUpper.Trim
                            Case "OS Events", "BULLETINS", "WORK ORDERS", "TRAIN RESTRICTIONS", "TRAIN SCHEDULE",
                                 "SCHEDULE", "RESTRICTIONS"
                                pagesToRemove.Add(tabPage)
                        End Select
                    Next
            End Select
            If pagesToRemove.Count > 0 Then
                For Each tabPage As TabPage In pagesToRemove
                    tbcTrain.TabPages.Remove(tabPage)
                Next
            End If
            If pagesToAdd.Count > 0 Then
                For Each tabPage As TabPage In pagesToAdd
                    tbcTrain.TabPages.Add(tabPage)
                Next
            End If
            For Each subdivision As Subdivision In ControlledSubdivisions
                For Each station As SubdivisionStation In subdivision.Stations
                    If Not cmbOrg.Items.Contains(station.Name) Then cmbOrg.Items.Add(station.Name)
                    If Not cmbTrainOrg.Items.Contains(station.Name) Then cmbTrainOrg.Items.Add(station.Name)
                    If Not cmbDes.Items.Contains(station.Name) Then cmbDes.Items.Add(station.Name)
                    If Not cmbTrainDest.Items.Contains(station.Name) Then cmbTrainDest.Items.Add(station.Name)
                Next
            Next
            tbcTrain.SelectedTab = tbcTrain.TabPages.Item(tbcTrain.TabPages.IndexOf(tbTrainInfo))
            If optShowFinalTrainButtonOnSummary Then btnFinal.Visible = True
            If optShowReleaseTrainButtonOnSummary Then btnRelease.Visible = True
            If optTrainTypeRequired Then
                lblTrainType.Visible = True
                cmbTrainType.Visible = True
                lblSubType.Visible = True
                cmbSubType.Visible = True
            End If
            If optCBTCEnabled OrElse
                gPTCTerritoryExists Then
                If Not optForceDisablePTCEquippedBox Then
                    chkCBTCEquipped.Visible = True
                    btnActiveSubTrainSheet.Enabled = True
                End If
            End If
            If optEnableRoadCode Then
                lblHomeRoad.Visible = True
                cmbHomeRoad.Visible = True
            End If
            If optUseResourceCultureFile Then LoadResourceFile()
            If optDisableDestinationGroupBoxOnTrainSummary Then gbDestiniation.Visible = False
            If optApplyTrainSheetConfigurationForMRS Then
                ApplyTrainSheetConfigurationMRS()
            ElseIf optApplyTrainSheetConfigurationForRUMO Then
                ApplyTrainSheetConfigurationRUMO()
            End If
            mnuUnitSwap.Visible = optEnableMoveUnits
            If optEnableLoadTrainEng_Cond Then
                GetEngineers()
                GetConductors()
            End If
            If OptEnableTrainDelayModify Then mnuDelayModify.Visible = True
            SetFocusOnTrainSheet()
            FormEvent($"{GetCurrentMethod.Name}:End")
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

