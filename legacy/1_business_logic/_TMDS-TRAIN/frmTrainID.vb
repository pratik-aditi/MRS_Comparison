    Private Sub RELEASE_ONTime_Leave(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles txtTimeRelOnE.Leave, txtTimeRelOnC.Leave, txtTimeRelOnC2.Leave, txtTimeRelOnB.Leave, txtTimeRelOnB2.Leave, txtTimeRelOnET.Leave, txtTimeRelOnCT.Leave
        Dim ValidTime As Boolean = False
        Dim tb As TextBox = Nothing
        Try
            tb = CType(sender, TextBox)
            FormatTime(sender)
            ValidTime = ValidateTime(sender)
            If Not ValidateTime(sender) And (sender.TEXT <> "NONE" And sender.TEXT <> "----") Then
                sender.Text = "----"
                sender.Focus()
                sender.SelectAll()
            End If
            If Not ValidTime Then Exit Sub
            Dim RDatestr As String = Now.ToShortDateString & " " & sender.Text
            Dim ROnDate As Date
            Dim ROFFDate As Date
            Dim HOSDate As Date
            Dim strROFFTime As String = ""
            Dim strROFFDate As String = ""
            Dim strHosTime As String = ""
            Dim strHosdate As String = ""
            If Date.TryParse(RDatestr, ROnDate) Then
                ROFFDate = ROnDate.AddHours(4)
                If Format(ROFFDate, "HH:mm") = "00:00" Then ROFFDate = ROFFDate.AddMinutes(1)
                strROFFTime = Format(ROFFDate, "HH:mm")
                strROFFDate = Format(ROFFDate, "MM-dd-yy")
                HOSDate = GetHOSDate(tb.Name, True)
                'HOSDate = ROFFDate.AddHours(10)
                If Format(HOSDate, "HH:mm") = "00:00" Then HOSDate = HOSDate.AddMinutes(1)
                strHosTime = Format(HOSDate, "HH:mm")
                strHosdate = Format(HOSDate, "MM-dd-yy")

                If sender.Name = "txtTimeRelOnE" Then
                    If txtTimeRelOnE.Tag Is Nothing OrElse txtTimeRelOnE.Tag.ToString.Trim = "" Then
                        ApplyEngineerOnReleaseData(txtTimeRelOnE.Text, Format(ROnDate, "MM-dd-yy"), strROFFTime, strROFFDate, strHosTime, strHosdate)
                    Else
                        AddOnOffReleaseEvent(True, ReleaseDesignation.ENGINEER.ToString, cmbEng.Text, txtDateRelOnE, txtTimeRelOnE)
                    End If
                ElseIf sender.Name = "txtTimeRelOnC" Then
                    If txtTimeRelOnC.Tag Is Nothing OrElse txtTimeRelOnC.Tag.ToString.Trim = "" Then
                        ApplyEngineerOnReleaseData(txtTimeRelOnC.Text, Format(ROnDate, "MM-dd-yy"), strROFFTime, strROFFDate, strHosTime, strHosdate)
                    Else
                        ApplyEngineerOnReleaseData(txtTimeRelOnC.Text, Format(ROnDate, "MM-dd-yy"), strROFFTime, strROFFDate, strHosTime, strHosdate)
                        ApplyOnReleaseDataOthers(tb, tb.Text, Format(ROnDate, "MM-dd-yy"), strROFFTime, strROFFDate, strHosTime, strHosdate)
                        'AddOnOffReleaseEvent(True, ReleaseDesignation.ENGINEER.ToString, cmbEng.Text, txtDateRelOnE, txtTimeRelOnE)
                    End If

                Else
                    ApplyOnReleaseDataOthers(tb, tb.Text, Format(ROnDate, "MM-dd-yy"), strROFFTime, strROFFDate, strHosTime, strHosdate)
                End If

            End If


        Catch ex As Exception
            SystemException(ex.ToString)
        Finally
            tb = Nothing
        End Try
    End Sub

    Private Sub ApplyEngineerOnReleaseData(ByVal ROnTime As String, ByVal ROnDate As String, ByVal ROffTime As String, ByVal ROffDate As String, ByVal HOSTime As String, ByVal HOSDate As String)
        Dim DesgName As String = ""
        Try

            'If Not IsValidTimestr(txtTimeRelOnE.Text.Trim) Then
            txtTimeRelOnE.Text = ROnTime
            txtDateRelOnE.Text = ROnDate
            txtTimeRelOffE.Text = ROffTime
            txtDateRelOffE.Text = ROffDate
            txtTimeHosE.Text = HOSTime
            txtDateHosE.Text = HOSDate
