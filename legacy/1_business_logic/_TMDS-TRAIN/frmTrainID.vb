    Private m_SortingColumn As ColumnHeader

    Private Sub lvWorkOrders_ColumnClick(ByVal sender As Object, ByVal e As System.Windows.Forms.ColumnClickEventArgs) Handles lvWorkOrders.ColumnClick
        Try
            Dim new_sorting_column As ColumnHeader = lvWorkOrders.Columns(e.Column)
            ' Figure out the new sorting order.
            Dim sort_order As System.Windows.Forms.SortOrder
            If m_SortingColumn Is Nothing Then
                sort_order = SortOrder.Ascending
            Else
                ' See if this is the same column.
                If new_sorting_column.Equals(m_SortingColumn) Then
                    ' Same column. Switch the sort order.
                    If m_SortingColumn.Tag.StartsWith(">") Then
                        sort_order = SortOrder.Descending
                    Else
                        sort_order = SortOrder.Ascending
                    End If
                Else
                    ' New column. Sort ascending.
                    sort_order = SortOrder.Ascending
                End If

                ' Remove the old sort indicator.
                'm_SortingColumn.Text = m_SortingColumn.Text.Substring(2)
            End If

            ' Display the new sort order.
            m_SortingColumn = new_sorting_column
            If sort_order = SortOrder.Ascending Then
                m_SortingColumn.Tag = ">"
            Else
                m_SortingColumn.Tag = "<"
            End If

            ' Create a comparer.

            Me.lvWorkOrders.ListViewItemSorter = New ListViewComparer(e.Column, sort_order)

            ' Sort.
            Me.lvWorkOrders.Sort()

        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Sub
