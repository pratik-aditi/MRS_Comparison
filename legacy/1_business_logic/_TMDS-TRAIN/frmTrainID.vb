    Public Sub LoadTrainDelays(ByVal trn As TrainID)
        Try
            If optEnableARRCSpecificOptions Then
                trn.PerformLoadTrainDelays()
            End If

            Me.lvDelays.Items.Clear()
            Dim td As TrainDelay
            For Each td In trn.myDelayList
                Dim lv As New ListViewItem
                lv.Text = td.DelayUID
                lv.SubItems.Add(td.IdentifyingPointName)
                If optEnableTrainFunctionalityARRC Then
                    lv.SubItems.Add(Format(td.EventTimeStamp, optSystemDateTimeFormat3))
                Else
                    lv.SubItems.Add(Format(td.EventTimeStamp, optSystemDateTimeFormat1))
                End If
                lv.SubItems.Add(td.EventDelayAmount)
                lv.SubItems.Add(td.EventComments)
                If optEnableTrainFunctionalityARRC Then
                    lv.SubItems.Add(td.EventMilePost)
                ElseIf optApplyTrainSheetConfigurationForDenver Then
                    lv.SubItems.Add(td.EventMilePost) ' MILEPOST
                    lv.SubItems.Add(td.myDelayExcused) ' EXCUSED
                    lv.SubItems.Add(td.myReportNumber)
                End If

                Me.lvDelays.Items.Add(lv)
            Next
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

