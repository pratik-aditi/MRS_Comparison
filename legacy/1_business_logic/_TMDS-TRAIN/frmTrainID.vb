    Private Function GetHOSDate(ByVal tbName As String, Optional ByVal Add4Hours As Boolean = False) As Date
        Dim HosStr As String = ""
        Dim CrewStr As String = ""
        Dim Crewdt As Date
        Dim CrewDate As String = "" ' txtDateOnE.Text
        Dim CrewTime As String = "" ' txtTimeOnE.Text
        Try
            ' 'txtTimeRelOnE.Leave, txtTimeRelOnC.Leave, txtTimeRelOnC2.Leave, txtTimeRelOnB.Leave, txtTimeRelOnB2.Leave, txtTimeRelOnET.Leave, txtTimeRelOnCT.Leave

            Select Case tbName
                Case "txtTimeRelOnE"
                    CrewDate = txtDateOnE.Text
                    CrewTime = txtTimeOnE.Text
                    CrewStr = CrewDate & " " & CrewTime
                Case "txtTimeRelOnC"
                    CrewDate = txtDateOnC.Text
                    CrewTime = txtTimeOnC.Text
                    CrewStr = CrewDate & " " & CrewTime
                Case "txtTimeRelOnC2"
                    CrewDate = txtDateOnC2.Text
                    CrewTime = txtTimeOnC2.Text
                    CrewStr = CrewDate & " " & CrewTime
                Case "txtTimeRelOnB"
                    CrewDate = txtDateOnB.Text
                    CrewTime = txtTimeOnB.Text
                    CrewStr = CrewDate & " " & CrewTime
                Case "txtTimeRelOnB2"
                    CrewDate = txtDateOnB2.Text
                    CrewTime = txtTimeOnB2.Text
                    CrewStr = CrewDate & " " & CrewTime
                Case "txtTimeRelOnET"
                    CrewDate = txtDateOnET.Text
                    CrewTime = txtTimeOnET.Text
                    CrewStr = CrewDate & " " & CrewTime
                Case "txtTimeRelOnCT"
                    CrewDate = txtDateOnCT.Text
                    CrewTime = txtTimeOnCT.Text
                    CrewStr = CrewDate & " " & CrewTime

            End Select
            Date.TryParse(CrewStr, Crewdt)
            If Add4Hours Then
                Return Crewdt.AddHours(16)
            Else
                Return Crewdt.AddHours(12)
            End If

        Catch ex As Exception

        End Try
    End Function

