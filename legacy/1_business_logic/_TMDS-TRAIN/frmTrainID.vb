    Private Function GetBRCValidDates(ByVal TimeString As String) As String
        Dim EnteredDate As Date
        Dim TimeExists As Boolean = False
        EnteredDate = Format(Now, "MM-dd-yy")

        Dim EnteredTime As String = TimeString
        Dim HOSOnDutyDateTime As Date
        Try
            If TimeString.Length < 4 AndAlso TimeString.Trim.ToUpper <> "NONE" AndAlso TimeString.Trim <> "----" Then Return String.Empty
            Dim strDate As String = EnteredDate & Space(1) & EnteredTime
            If Not Date.TryParse(strDate, Nothing) Then Return String.Empty
            HOSOnDutyDateTime = Format(CDate(EnteredDate & Space(1) & EnteredTime), "MM-dd-yy HH:mm")
            Dim HoursDifference As Integer
            Dim tms As TimeSpan = Now.Subtract(HOSOnDutyDateTime)
            HoursDifference = tms.Hours
            If HoursDifference >= 12 Then
                'txtDateOnE.Text = Format(Now.AddDays(+1), "MM-dd-yy")
                Return Format(Now.AddDays(+1), "MM-dd-yy")
            ElseIf HoursDifference <= -12 Then
                Return Format(Now.AddDays(-1), "MM-dd-yy")
            Else
                Return Format(Now, "MM-dd-yy")
            End If
        Catch ex As Exception
            GetErrorDetails(ex)
        Finally

        End Try
        Return String.Empty
    End Function

