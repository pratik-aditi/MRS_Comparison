    Private Function GetAlphaPart() As String
        Dim EngineID As String = cmbUnitID.Text
        Dim returnString As String = String.Empty
        Dim s As String = ""
        Try
            For i As Integer = 1 To EngineID.Length - 1
                s = ""
                s = Mid(EngineID, i, 1)
                If Not IsNumeric(s) Or s.Trim = "" Then
                    returnString = returnString & s
                Else
                    Exit For
                End If

            Next
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

        Return returnString
    End Function

