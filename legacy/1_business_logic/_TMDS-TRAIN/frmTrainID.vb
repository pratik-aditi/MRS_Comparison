    Private Sub UpdateCarConsistMove()

        Try
            Dim lv As ListViewItem
            For Each lv In lvCarConsist.Items
                If lv IsNot Nothing Then
                    Dim tc As TrainCar = FindTrainCar(lv.Text)
                    Dim CarCurrentIndex As Integer = lv.Index + 1
                    If tc.CarPositionIndex <> CarCurrentIndex Then
                        Dim Str As String = "CAR[" & tc.CarUID & "] POSTION MOVED FROM " & tc.CarPositionIndex & " TO " & CarCurrentIndex
                        tc.CarPositionIndex = CarCurrentIndex
                        tc.UpdateCarPostion()
                        AddTrainSheetEvent("CAR-POSTION-CHANGE", Str, CurrentTrain.myTrack.myControlPoint.GUID.ToString, CurrentTrain.GetIdentifyingLocationNameFromLimits, CurrentTrain.myTrack.myControlPoint.UniqueName)
                    End If
                End If
            Next
        Catch ex As Exception
            GetErrorDetails(ex)
        Finally
            LoadTrainCars(ThisCarTrain)
        End Try
    End Sub

