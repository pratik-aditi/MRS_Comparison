    Private Function GetToolTip(ByVal unitName As String) As String
        Dim tooltip As String = String.Empty
        Try
            If IsNothing(CurrentTrain) Then Return tooltip
            Dim u As TrainUnit
            Dim theUnit As TrainUnit = Nothing
            For Each u In CurrentTrain.UnitsInTrain
                If u.UnitNumber = unitName Then
                    theUnit = u
                    Exit For
                End If
            Next

            If IsNothing(theUnit) Then Return tooltip

            tooltip = "(" & theUnit.UnitNumber & ") (" & theUnit.TotalHP & ") (" & theUnit.Status & ") (" & theUnit.UnitPosition & ")"
            If theUnit.DPCapable Then tooltip = tooltip & " (DP)"
            If theUnit.GPSCapable Then tooltip = tooltip & " (GPS)"


        Catch ex As Exception
            SystemException(ex.ToString)
            Return String.Empty
        End Try

        Return tooltip
    End Function

