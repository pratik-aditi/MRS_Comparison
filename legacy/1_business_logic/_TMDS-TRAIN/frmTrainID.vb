    Private Sub DoCheckForCrewChangeEvents()
        Try
            If optEnableTrainCrewRecursiveUpdateToLinkedTrains AndAlso CrewChangeEventDetected Then
                If IsNothing(CurrentTrain) Then Exit Sub
                Dim theTrainList As New ArrayList
                Dim dbconn As OleDbConnection = Nothing
                Dim dbcomm As OleDbCommand = Nothing
                Dim dr As OleDbDataReader = Nothing
                If String.IsNullOrEmpty(CurrentTrain.CrewCodeUID) Then Exit Sub
                Dim Query As String = "SELECT Symbol FROM tblTrainsActive WHERE (CrewCodeUID = '" & CurrentTrain.CrewCodeUID & "') AND (InUsed = 0) AND (DepTime > '" & CurrentTrain.DepTime & "') ORDER BY DepTime"
                Try
                    dbconn = New OleDbConnection(gConnectionStringDynamic)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(Query, dbconn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        If Not dr.IsDBNull(0) Then
                            If Not theTrainList.Contains(dr.GetString(0)) AndAlso CurrentTrain.Name <> dr.GetString(0) Then
                                theTrainList.Add(dr.GetString(0))
                            End If
                        End If
                    End While
                    If theTrainList.Count = 0 Then Exit Sub

                    Dim TrainList As New StringBuilder
                    Dim MessageList As New ArrayList
                    MessageList.Add("A CREW CHANGE EVENT HAS BEEN DETECTED.")
                    MessageList.Add("THESE TRAINS BELOW ARE CURRENTLY LINK TO THIS TRAIN (" & CurrentTrain.Name & ")")

                    Dim t As String
                    For Each t In theTrainList
                        If Trim(t) <> "" Then
                            If TrainList.Length = 0 Then
                                TrainList.Append(t)
                            Else
                                TrainList.Append(", " & t)
                            End If
                        End If
                    Next
                    MessageList.Add(TrainList.ToString)
                    MessageList.Add("")
                    MessageList.Add("WOULD YOU LIKE TO APPLY THESE CREW CHANGES TO THESE TRAIN(S)?")
                    MessageList.Add("")

                    Dim ResultCode As Integer = ShowCustomMessageBox(MessageList, "CREW CHANGE CHECK", True, Nothing, False, True, Me, False, Nothing, Nothing, True)
                    If ResultCode = 6 Then
                        ApplyCrewChangesToTrainList(theTrainList)
                    End If

                Catch ex As Exception
                    GetErrorDetails(ex)
                Finally
                    dbconn.Close()
                    dbconn = Nothing
                    dbcomm = Nothing
                    dr = Nothing
                End Try
            End If
        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

    Private Sub ApplyCrewChangesToTrainList(TrainList As ArrayList)
        Try
            Dim t As String
            For Each t In TrainList
                Dim trn As TrainID = TMDS.SystemUtilities.TrainFunction.RetrieveTrainProperties(t)
                If Not IsNothing(trn) Then
                    trn.CrewCurrentString = CurrentTrain.CrewCurrent.CreateCrewString()
                    trn.CrewCurrent.ApplyCrewString(trn.CrewCurrentString)
                    trn.UpdateCurrentCrew()
                End If
            Next

        Catch ex As Exception
            SystemException(ex.ToString)
        End Try

    End Sub

