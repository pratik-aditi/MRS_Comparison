    Private Function ValidDateArrivalDepartureTime(LaunchPoint As Point) As Boolean
        Dim MessageList As New ArrayList
        Try
            Dim ArrDate As Date = CDate(dtArrDate.Value.ToShortDateString & " " & dtArrTime.Text)
            Dim depDate As Date = CDate(dtDepDate.Value.ToShortDateString & " " & dtDepTime.Text)
            If IsValidDate(ArrDate.ToString) Then
                If Not IsValidDate(depDate.ToString) Then
                    MessageList.Add("INVALID DEPARTURE DATE")
                ElseIf depDate > ArrDate Then
                    MessageList.Add("INVALID DEPARTURE DATE")
                End If
            End If

            If MessageList IsNot Nothing AndAlso MessageList.Count > 0 Then
                ShowCustomMessageBox(MessageList, "ARRIVAL-DEPARTURE TIME VALIDATION", False, LaunchPoint, True, True, Me)
                Return False
            End If
            Return True


        Catch ex As Exception
            GetErrorDetails(ex)
        End Try
    End Function

