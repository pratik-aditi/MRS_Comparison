    Private Function IsValidCrewTime(ByVal strDate As TextBox, ByVal strTime As TextBox) As Boolean
        Dim TimeString As String = ""
        Dim EnterDateTime As Date
        Try
            TimeString = Format(CDate(strDate.Text & Space(1) & strTime.Text), "MM-dd-yy HH:mm")
            If Date.TryParse(TimeString, EnterDateTime) Then
                Return True
            End If

        Catch ex As Exception
            GetErrorDetails(ex)
            Return False
        End Try

    End Function


    Private Function RecordCrewChangeEvent(ByVal trn As TrainID) As Boolean
        Dim HasChangeEvent As Boolean = False
        Dim Str As New StringBuilder
        Dim ReturnValue As Boolean = False
        Try
            With trn.CrewCurrent

                If GetValidCrewName(.Conductor.NameOfPerson) <> GetValidCrewName(Me.cmbCond.Text) Then HasChangeEvent = True Else HasChangeEvent = False
                If .Conductor.OnDutyTime <> CheckDateTime(Me.txtDateOnC.Text & " " & Me.txtTimeOnC.Text) Then HasChangeEvent = True
                If .Conductor.HOS <> CheckDateTime(Me.txtDateHosC.Text & " " & Me.txtTimeHosC.Text) Then HasChangeEvent = True
                If .Conductor.OffDutyTime <> CheckDateTime(Me.txtDateOffC.Text & " " & Me.txtTimeOffC.Text) Then HasChangeEvent = True
                If HasChangeEvent Then
                    ReturnValue = True
                    Str = New StringBuilder
                    With Str
                        .Append("CREW CHANGE EVENT:( COND=" & trn.CrewCurrent.Conductor.NameOfPerson & " TO " & Me.cmbCond.Text & "; ")
                        .Append("ONDUTY=" & trn.CrewCurrent.Conductor.OnDutyTime & " TO " & CheckDateTime(Me.txtDateOnC.Text & " " & Me.txtTimeOnC.Text) & "; ")
                        .Append("HOS=" & trn.CrewCurrent.Conductor.HOS & " TO " & CheckDateTime(Me.txtDateHosC.Text & " " & Me.txtTimeHosC.Text) & "; ")
                        .Append("TIEUP=" & trn.CrewCurrent.Conductor.OffDutyTime & " TO " & CheckDateTime(Me.txtDateOffC.Text & " " & Me.txtTimeOffC.Text) & "; ")
                    End With
                    If Not CrewChangeEventArrayList.Contains(Str.ToString) Then CrewChangeEventArrayList.Add(Str.ToString)
                    HasChangeEvent = False
                    Str = New StringBuilder
                End If

                HasChangeEvent = False
                If GetValidCrewName(.Engineer.NameOfPerson.ToUpper.Trim) <> GetValidCrewName(Me.cmbEng.Text.ToUpper.Trim) Then HasChangeEvent = True Else HasChangeEvent = False
                If .Engineer.OnDutyTime <> CheckDateTime(Me.txtDateOnE.Text & " " & Me.txtTimeOnE.Text) Then HasChangeEvent = True
