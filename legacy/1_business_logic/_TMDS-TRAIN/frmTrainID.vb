    Private Sub cmbTrainID_Leave(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles cmbTrainID.Leave
        Try
            cmbTrainID.Text = cmbTrainID.Text.ToUpper
            If optFormatTrainSymbolRuleOne Then
                Dim OrginalSym As String = Me.cmbTrainID.Text
                If Not Me.cmbTrainID.Text = "" Then
                    Dim trndata1() As String = cmbTrainID.Text.Split("(")
                    Dim TrainName1 As String = String.Empty
                    If trndata1.Length >= 1 Then
                        TrainName1 = trndata1(0).TrimEnd
                    End If
                    If Me.cmbTrainID.Text = optTrainString19 Or Me.cmbTrainID.Text = mstrTrainSymbolFormatErrorMessage Then
                        Exit Sub
                    Else
                        If Not CheckTrainSymbolForBNSFTypeTrain(TrainName1) Then
                            Me.cmbTrainID.Text = mstrTrainSymbolFormatErrorMessage
                            Me.cmbTrainID.Focus()
                            Exit Sub
                        End If
                        If Not Me.FormatTrainSymbol(TrainName1) Then '(Me.cmbTrainID.Text) Then
                            'Dim UserResponse As Integer = MessageBox.Show(Me, "TRAIN SYMBOL IS FORMATTED INCORRECTLY.", "TRAIN SYMBOL FORMAT CHECK", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            'Me.cmbTrainID.Text = "ENTER SYMBOL"
                            Me.cmbTrainID.Text = mstrTrainSymbolFormatErrorMessage
                            Me.cmbTrainID.Focus()
                            Exit Sub
                        Else
                            Me.cmbTrainID.Text = TrainName1
                        End If
                    End If
                End If
            ElseIf optFormatTrainSymbolRuleCN Then
                Dim OrginalSym As String = Me.cmbTrainID.Text
                If Not Me.cmbTrainID.Text = "" Then
                    Dim trndata1() As String = cmbTrainID.Text.Split("(")
                    Dim TrainName1 As String = String.Empty
                    If trndata1.Length >= 1 Then
                        TrainName1 = trndata1(0).TrimEnd
                    End If
                    If Me.cmbTrainID.Text = optTrainString19 Or Me.cmbTrainID.Text = mstrTrainSymbolFormatErrorMessage Then
                        Exit Sub
                    Else
                        If Not Me.FormatTrainSymbolForCN(TrainName1) Then
                            'Me.cmbHomeRoad.Text = ""
                            'Me.cmbTrainID.Text = Me.ValidateSymbolCharacters(Me.cmbTrainID.Text)
                            Me.cmbTrainID.Text = "INVALID DATE.."
                            Me.cmbTrainID.Focus()
                        Else
                            Me.cmbTrainID.Text = TrainName1
                            If Not CheckTrainSymbolForCNTypeTrain(Me.cmbTrainID.Text) Then
                                ' Me.cmbHomeRoad.Text = ""
                                Me.cmbTrainID.Text = Me.ValidateSymbolCharacters(Me.cmbTrainID.Text)
                            Else
                                Me.cmbTrainID.Text = TrainName1
                                Me.cmbHomeRoad.Text = "CN"
                            End If
                        End If
                        If gPositionTrainID OrElse gCreateTrain Then Me.txtPseudoName.Text = TrainName1
                    End If
                End If
            ElseIf optFormatTrainSymbolRuleMRS Then
                Dim OrginalSym As String = Me.cmbTrainID.Text
                If Not Me.cmbTrainID.Text = "" Then
                    Dim trndata1() As String = cmbTrainID.Text.Split("(")
                    Dim TrainName1 As String = String.Empty
                    If trndata1.Length >= 1 Then
                        TrainName1 = trndata1(0).TrimEnd
                    End If
                    If Me.cmbTrainID.Text = optTrainString19 Or Me.cmbTrainID.Text = mstrTrainSymbolFormatErrorMessage Then
                        Exit Sub
                    Else
                        If Not Me.FormatTrainSymbolForMRS(TrainName1) Then
                            Me.cmbTrainID.Text = "PREFIXO INCORRETO"
                            Me.cmbTrainID.Focus()
                        Else
                            Me.cmbTrainID.Text = TrainName1
                            Me.txtPseudoName.Text = Me.cmbTrainID.Text
                        End If
                    End If
                End If
            ElseIf optFormatTrainSymbolRuleML Then
                Dim OrginalSym As String = Me.cmbTrainID.Text
                If Not CheckTrainSymbolForMLTypeTrain(Me.cmbTrainID.Text) Then
                    Me.cmbTrainID.Text = "PREFIXO INCORRETO"
                    Me.cmbTrainID.Focus()
                    Exit Sub
                End If
            End If


            If Me.CurrentSymbol IsNot Nothing AndAlso Me.CurrentSymbol.ToUpper.Trim <> Me.cmbTrainID.Text.ToUpper.Trim AndAlso Not CopyTrainMode Then
                If Not optApplyConfigurationForKCT Then ClearPropertiesOnForm(False, False, False)
            End If
            Me.CurrentSymbol = Me.cmbTrainID.Text
            cmbTrainID.Text = FormatProperStringForDatabase(cmbTrainID.Text.ToUpper)

            Dim trndata() As String = cmbTrainID.Text.Split("(")
            Dim TrainName As String = String.Empty
            If trndata.Length >= 1 Then
                TrainName = trndata(0).TrimEnd
            End If

            If CopyTrainMode Then
                If optApplyTrainSheetConfigurationForBRC Then
                    cmbUnitID.Focus()
                    cmbUnitID.Select()
                    cmbUnitID.SelectAll()
                End If
                Exit Sub
            End If

            PositionedTrain = RetrieveTrainProperties(TrainName)
            Try
                Me.Cursor = Cursors.WaitCursor
                If optEnableARRCSpecificOptions Then
                    Threading.Thread.Sleep(500)
                    If PositionedTrain IsNot Nothing Then PositionedTrain.GetTrainUnits()
                End If
            Catch ex As Exception
            Finally
                Me.Cursor = Cursors.Default
            End Try
            If optDisableCreateTrain Then
                If PositionedTrain Is Nothing Then
                    Me.cmbTrainID.Text = "SYMBOL NOT FOUND - START OVER" 'mstrTrainSymbolFormatErrorMessage
                    Me.cmbTrainID.Focus()
                    Exit Sub
                End If
            End If

            ApplyTrainPropertiesToForm(PositionedTrain, True)

            If optApplyTrainSheetConfigurationForBRC Then
                If Me.ActiveControl IsNot Nothing AndAlso Me.ActiveControl.GetType.ToString = "System.Windows.Forms.TabControl" Then Exit Sub
                cmbUnitID.Focus()
                cmbUnitID.Select()
                cmbUnitID.SelectAll()
            End If


        Catch ex As Exception
            SystemException(ex.ToString)
        End Try
    End Sub

