                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
                With Me.cmbEngR
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
                With Me.cmbCond2R
                    .AutoCompleteMode = AutoCompleteMode.SuggestAppend
                    .AutoCompleteSource = AutoCompleteSource.ListItems
                End With
            End If
        Catch ex As Exception
            Me.ExceptionEvent(ex.ToString)
            dbconn = Nothing
