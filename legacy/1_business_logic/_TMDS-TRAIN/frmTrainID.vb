#Region " NUMERIC CONTROL KEY PRESS EVENT  [CONSIST] "
    Private Sub nud_KeyPress(sender As Object, e As KeyPressEventArgs) Handles nudAxles.KeyPress, nudBrakes.KeyPress, nudLoadO.KeyPress, nudEmpO.KeyPress, nudTonO.KeyPress, nudLenO.KeyPress
        Dim myCurrentValue As String = ""
        Dim nd As System.Windows.Forms.NumericUpDown = Nothing
        Try
            If DisableConsistNumericCntrlValidation Then Exit Sub
            If sender Is Nothing Then Exit Sub
            If sender.GetType.ToString <> "System.Windows.Forms.NumericUpDown" Then
                Exit Sub
            Else
                nd = sender
            End If
            If nd Is Nothing Then Exit Sub
            If Not (Char.IsDigit(e.KeyChar) Or (e.KeyChar = Convert.ToChar(Keys.Back)) Or (e.KeyChar = Convert.ToChar(Keys.Delete))) Then
                e.Handled = True
                Exit Sub
            ElseIf e.KeyChar = "." Then
                e.Handled = True
                Exit Sub
            End If
            myCurrentValue = nd.Text.ToString.Trim
            myCurrentValue = myCurrentValue & e.KeyChar.ToString.Trim
            Dim tmpValue As Integer
            Integer.TryParse(myCurrentValue.Trim, tmpValue)
            If tmpValue > nd.Maximum Then
                e.Handled = True
                Exit Sub
            End If
        Catch ex As Exception
            GetErrorDetails(ex)
        Finally
            nd = Nothing
        End Try
    End Sub
#End Region

