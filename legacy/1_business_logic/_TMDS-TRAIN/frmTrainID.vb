    Private Sub SetFocusOnTrainSheet()
        Try
            Me.gbTrainID.Focus()
            If gModifyTrainID Then
                Me.cmbUnitID.Focus()
                Me.cmbUnitID.Select()
                Me.cmbUnitID.SelectAll()
            ElseIf Not ModifySysTrainMode Then
                If Me.txtPseudoName.Text.Trim = String.Empty Then Me.txtPseudoName.Text = "ENTER SYMBOL"
