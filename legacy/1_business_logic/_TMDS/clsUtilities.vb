        Public Shared Function FindSignalFromLeftGUID(ByVal UniqueID As Int32, Optional ByVal CompType As String = Nothing, Optional ByVal ValidateSignalAgainstTraffic As Boolean = True, Optional TrafficDirection As String = "") As Signal
            'This function finds the current trackcomponent index from the global unique ID
            Try
                Dim SearchComplete As Boolean
                Dim LoopControl As Integer
                Dim nextComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(UniqueID)
                If IsNothing(nextComp) Then Return Nothing
                Do While Not SearchComplete
                    If IsNothing(nextComp) Then Return Nothing

                    If nextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If CompType = "" Then
                            'Return nextComp
                            Dim sig As Signal = CType(nextComp, Signal)
                            If sig IsNot Nothing AndAlso ValidateSignalAgainstTraffic AndAlso Not String.IsNullOrEmpty(TrafficDirection) AndAlso TrafficDirection.Trim <> "" Then
                                Select Case sig.ComponentType
                                    Case "R", "D"
                                        Return sig
                                    Case Else
                                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                                End Select
                            ElseIf sig IsNot Nothing Then
                                Return nextComp
                            End If
                        Else
                            Dim sig As Signal = CType(nextComp, Signal)
                            If sig.ComponentType = CompType Then
                                Return sig
                            Else
                                nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                            End If

                        End If
                    ElseIf nextComp.GetType.ToString = gSwitchComponentName Then
                        Dim sw As Switch = CType(nextComp, Switch)
                        If sw.LeftAltLink <> 0 Then
                            If sw.ControlledReverse Then
                                nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftAltLink)
                            Else
                                nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                            End If
                        Else
                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                        End If
                    ElseIf nextComp.GetType.ToString = gTrackComponentName Then
                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)

                    Else
                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                    End If
                    LoopControl += 1
                    If LoopControl > 10 Then
                        Return Nothing
                    End If
                Loop
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindSignalFromRightGUID(ByVal UniqueID As Int32, Optional ByVal CompType As String = Nothing, Optional ByVal ValidateSignalAgainstTraffic As Boolean = True, Optional TrafficDirection As String = "") As Signal
            'This function finds the current trackcomponent index from the global unique ID
            Try
                Dim SearchComplete As Boolean
                Dim LoopControl As Integer
                Dim nextComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(UniqueID)
                If IsNothing(nextComp) Then
                    Return Nothing
                End If
                Do While Not SearchComplete
                    If nextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If CompType = "" Then
                            'Return nextComp
                            Dim sig As Signal = CType(nextComp, Signal)
                            If sig IsNot Nothing AndAlso ValidateSignalAgainstTraffic AndAlso Not String.IsNullOrEmpty(TrafficDirection) AndAlso TrafficDirection.Trim <> "" Then
                                Select Case sig.ComponentType
                                    Case "L", "U"
                                        Return nextComp
                                    Case Else
                                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                                End Select
                            ElseIf sig IsNot Nothing Then
                                Return nextComp
                            End If
                        Else
                            Dim sig As Signal = CType(nextComp, Signal)
                            If sig.ComponentType = CompType Then
                                Return sig
                            Else
                                nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightLink)
                            End If
                        End If

                        Return nextComp
                    ElseIf nextComp.GetType.ToString = gSwitchComponentName Then
                        Dim sw As Switch = CType(nextComp, Switch)
                        If sw.RightAltLink <> 0 Then
                            If sw.ControlledReverse Then
                                nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightAltLink)
                            Else
                                nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightLink)
                            End If
                        Else
                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightLink)
                        End If
                    ElseIf nextComp.GetType.ToString = gTrackComponentName Then
                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightLink)
                        'Else
                        '    nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RightLink)
                    End If
                    LoopControl += 1
                    If LoopControl > 10 Then
                        Return Nothing
                    End If
                Loop
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

