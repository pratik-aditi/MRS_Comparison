                    mr = FindMileageRange(Flag2BeginMP, "", SB.FlagMilePostBeginSuffix2, SB.FlagMilePostBegin2SubUID)
                    'If mr IsNot Nothing Then If Not BullMRList.Contains(mr) Then BullMRList.Add(mr)
                    If FirstMR IsNot Nothing AndAlso FirstMR.myUID = mr.myUID Then
                    Else
                        If mr IsNot Nothing Then If Not BullFlagMRList.Contains(mr) Then BullFlagMRList.Add(mr)
                    End If
                End If

                mr = Nothing
                If Flag2EndMP > 0 Then
                    mr = FindMileageRange(Flag2EndMP, "", SB.FlagMilePostEndSuffix2, SB.FlagMilePostEnd2SubUID)
                    ' If mr IsNot Nothing Then If Not BullMRList.Contains(mr) Then BullMRList.Add(mr)
                    If FirstMR IsNot Nothing AndAlso FirstMR.myUID = mr.myUID Then
                    Else
                        If mr IsNot Nothing Then If Not BullFlagMRList.Contains(mr) Then BullFlagMRList.Add(mr)
                    End If
                End If

                mr = Nothing
                If Flag3BeginMP > 0 Then
                    mr = FindMileageRange(Flag3BeginMP, "", SB.FlagMilePostBeginSuffix3, SB.FlagMilePostBegin3SubUID)
                    If FirstMR IsNot Nothing AndAlso FirstMR.myUID = mr.myUID Then
                    Else
                        If mr IsNot Nothing Then If Not BullFlagMRList.Contains(mr) Then BullFlagMRList.Add(mr)
                    End If
                    'If mr IsNot Nothing Then If Not BullMRList.Contains(mr) Then BullMRList.Add(mr)
                End If

                mr = Nothing
                If Flag3EndMP > 0 Then
                    mr = FindMileageRange(Flag3EndMP, "", SB.FlagMilePostEndSuffix3, SB.FlagMilePostEnd3SubUID)
                    'If mr IsNot Nothing Then If Not BullMRList.Contains(mr) Then BullMRList.Add(mr)
                    If FirstMR IsNot Nothing AndAlso FirstMR.myUID = mr.myUID Then
                    Else
