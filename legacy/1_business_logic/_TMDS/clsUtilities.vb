        Public Shared Function FindSubdivisionFromDB(ByVal SubUID As Int32) As Subdivision
            Dim SubFetch As String
            Dim subdvn As Subdivision = Nothing
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing

            Try
                SubFetch = "SELECT * FROM tblSystemSubDivisions WHERE UID = " & SubUID
                Using DbConn As New OleDbConnection(gConnectionStringStatic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SubFetch, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read()
                        Application.DoEvents()

                        subdvn = New Subdivision()
                        If Not dr.IsDBNull(1) Then
                            subdvn.Name = dr.GetString(1)
                        End If
                        If Not dr.IsDBNull(2) Then
                            subdvn.RailRoadName = dr.GetString(2)
                        End If
                        If Not dr.IsDBNull(3) Then
                            subdvn.BeginLimit = dr.GetString(3)
                        End If

                        If Not dr.IsDBNull(4) Then
                            subdvn.EndLimit = dr.GetString(4)
                        End If
                        subdvn.SubDirection = dr.GetBoolean(7)
                        If Not dr.IsDBNull(8) Then
                            subdvn.LongName = dr.GetString(8)
                        End If
                        If Not dr.IsDBNull(9) Then
                            Try
                                subdvn.TimeTableInEffect = CDate(dr.GetString(9))
                            Catch
                            End Try
                        End If
                        If dr.FieldCount >= 11 Then
                            If Not dr.IsDBNull(10) Then
                                subdvn.TimeZone = dr.GetString(10)
                            End If
                        End If
                        If dr.FieldCount >= 12 Then
                            If Not dr.IsDBNull(11) Then
                                subdvn.BranchType = dr.GetBoolean(11)
                            End If
                        End If

                        If dr.FieldCount >= 13 Then
                            If Not dr.IsDBNull(12) Then
                                subdvn.IncludeNameInAuthorities = dr.GetBoolean(12)
                            End If
                        End If

                        If dr.FieldCount >= 18 Then
                            If Not dr.IsDBNull(17) Then
                                subdvn.Abbreviation = dr.GetString(17)
                            End If
                        End If

                        If dr.FieldCount >= 22 Then
                            If Not dr.IsDBNull(21) Then
                                subdvn.RadioBlockingAllowed = dr.GetBoolean(21)
                            End If
                        End If

                        If dr.FieldCount >= 19 Then
                            If Not dr.IsDBNull(18) Then
                                subdvn.PTCUID = dr.GetInt32(18)
                            End If
                        End If

                        If dr.FieldCount >= 23 Then
                            If Not dr.IsDBNull(22) Then
                                subdvn.WeatherDataDesignation = dr.GetString(22)
                            End If
                        End If

                        If dr.FieldCount >= 58 Then
                            If Not dr.IsDBNull(57) Then
                                subdvn.OfficeUID = dr.GetInt32(57)
                            End If
                        End If
                        If dr.FieldCount >= 59 Then
                            If Not dr.IsDBNull(58) Then
                                subdvn.ZoneUID = dr.GetInt32(58)
                            End If
                        End If

                        subdvn.GUID = dr.GetInt32(0)
                        If dr.FieldCount >= 85 Then
                            If Not dr.IsDBNull(84) Then
                                Boolean.TryParse(dr.GetValue(84), subdvn.DisableMileageRangeCheck)
                            End If
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
                Return subdvn
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Function

