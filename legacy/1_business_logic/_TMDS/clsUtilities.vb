        Public Shared Function FindLastTrackCTCInList(ByVal CompList As ArrayList, Optional IgnoreNonTraversable As Boolean = False) As Track
            Try
                Dim CompListReverse As ArrayList = CompList.Clone
                CompListReverse.Reverse()
                Dim comp As Object
                For Each comp In CompListReverse
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If IgnoreNonTraversable Then
                            If Not comp.NonTransverable AndAlso Mid(comp.AuthorityType, 1, 3) = "CTC" Then Return comp
                        Else
                            If Mid(comp.AuthorityType, 1, 3) = "CTC" Then Return comp
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindLastTrackInListFromNonTWC(ByVal CompList As ArrayList) As Track
            Try
                Dim CompListReverse As ArrayList = CompList.Clone
                CompListReverse.Reverse()
                Dim comp As Object
                Dim EOS As Boolean

                If optEnableTrackSidingBit Then
                    'NEW SIDING LOGIC CODE
                    If gEndTrackSelect.EnableControlledSiding Or gEndTrackSelect.EnableNonControlledSiding Then
                        EOS = True
                    End If
                Else
                    'OLD LEGACY SIDING CODE
                    If gEndTrackSelect.TrackName = "SIDING" Then
                        EOS = True
                    End If
                End If

                For Each comp In CompListReverse
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If EOS Then
                            If gSearchDirection = "LEFT" Then
                                Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gEndTrackSelect.RightLink)
                                If Not IsNothing(trk) Then
                                    Return trk
                                Else
                                    Return gEndTrackSelect
                                End If
                            Else
                                Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(gEndTrackSelect.LeftLink)
                                If Not IsNothing(trk) Then
                                    Return trk
                                Else
                                    Return gEndTrackSelect
                                End If
                            End If
                        Else
                            Return comp
                        End If

                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindTrackZoneFromOSList(ByVal OsTrack As Track) As TrackZone
            Try
                If IsNothing(OsTrack) Then Return Nothing
                If IsNothing(OsTrack.OsComponentCollection) Then Return Nothing
                Dim comp As Object
                For Each comp In OsTrack.OsComponentCollection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(comp, Track)
                        If Not trk Is OsTrack Then
                            If Not IsNothing(trk.TrackZoneReference) Then
                                Return trk.TrackZoneReference
                            End If
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

