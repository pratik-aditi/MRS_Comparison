        Public Shared Sub LoadSubBulletinRecords(ByVal terr As Territory)
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Query As String = "SELECT * FROM tblSystemBulletins WHERE TerrUID = " & terr.TerritoryID & " OR RestrictionSubName = '" & terr.mySubdivision.Abbreviation & "'"

            Try
                dbconn = New OleDbConnection(gConnectionStringBulletin)
                dbconn.Open()
                dbcomm = New OleDbCommand(Query, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    Dim DisplayBull As Boolean = True
                    Dim TypeOfBull As String = String.Empty


                    If Not dr.IsDBNull(2) Then TypeOfBull = dr.GetString(2)
                    Select Case TypeOfBull
                        Case "C"
                            DisplayBull = False
                    End Select
                    If TypeOfBull = "A" Or TypeOfBull = "B" Or TypeOfBull = "C" Then
                        Dim sb As New SubBulletin
                        If Not dr.IsDBNull(0) Then sb.myGUID = dr.GetString(0)
                        If Not dr.IsDBNull(2) Then sb.theType = dr.GetString(2)
                        If Not dr.IsDBNull(3) Then sb.EffectTime = dr.GetDateTime(3)
                        If Not dr.IsDBNull(5) Then sb.SubUID = dr.GetString(5)
                        If Not dr.IsDBNull(8) Then sb.BullUID = dr.GetString(8)
                        If Not dr.IsDBNull(9) Then sb.MilePostBegin = dr.GetString(9)
                        If Not dr.IsDBNull(10) Then sb.MilePostEnd = dr.GetString(10)
                        If Not dr.IsDBNull(11) Then sb.TrackType = dr.GetString(11)
                        If Not dr.IsDBNull(12) Then sb.TrackName = dr.GetString(12)
                        If Not dr.IsDBNull(13) Then sb.MessageTrnFrght = dr.GetString(13)
                        If Not dr.IsDBNull(15) Then sb.MessageTrnPassg = dr.GetString(15)
                        If Not dr.IsDBNull(14) Then sb.SpeedFrght = dr.GetInt32(14)
                        If Not dr.IsDBNull(16) Then sb.SpeedPassg = dr.GetInt32(16)
                        If Not dr.IsDBNull(17) Then sb.Owner = Trim(dr.GetString(17))
                        If Not dr.IsDBNull(19) Then sb.TerrUID = dr.GetInt32(19)
                        If Not dr.IsDBNull(21) Then sb.Cause = Trim(dr.GetString(21)).ToUpper

                        Dim sCompList As String = String.Empty
                        If Not dr.IsDBNull(20) Then sCompList = dr.GetString(20)
                        If DisplayBull Then
                            Dim comps() As String = sCompList.Split("-")
                            Dim c As String
                            For Each c In comps
                                If IsNumeric(c) Then
                                    Dim comp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CInt(c))
                                    If Not IsNothing(comp) Then
                                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            Dim trk As Track = CType(comp, Track)
                                            trk.Bulletins.Add(sb)
                                            sb.CompList.Add(trk)
                                            If sb.theType = "A" And Not trk.HatchItWorkZone Then
                                                trk.HatchItSpeed = True
                                            ElseIf sb.theType = "F" And Not trk.HatchItWorkZone Then
                                                trk.HatchItInformational = True
                                            Else
                                                trk.HatchItWorkZone = True
                                            End If
                                            trk.RefreshRemotely()

                                            If trk.OStype Then
                                                Dim OsComp As Object
                                                For Each OsComp In trk.OsComponentCollection
                                                    If OsComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                        If Not OsComp.TurnOutType Then
                                                            If Not OsComp.Bulletins.Contains(sb) Then
                                                                OsComp.Bulletins.Add(sb)
                                                                sb.CompList.Add(OsComp)
                                                                If sb.theType = "A" And Not trk.HatchItWorkZone Then
                                                                    OsComp.HatchItSpeed = True
                                                                ElseIf sb.theType = "F" And Not trk.HatchItWorkZone Then
                                                                    OsComp.HatchItInformational = True
                                                                Else
                                                                    OsComp.HatchItWorkZone = True
                                                                End If
                                                                OsComp.RefreshRemotely()

                                                            End If
                                                        End If
                                                    Else
                                                        If Not OsComp.Bulletins.Contains(sb) Then
                                                            sb.CompList.Add(OsComp)
                                                            If sb.theType = "A" And Not trk.HatchItWorkZone Then
                                                                OsComp.HatchItSpeed = True
                                                            ElseIf sb.theType = "F" And Not trk.HatchItWorkZone Then
                                                                OsComp.HatchItInformational = True
                                                            Else
                                                                OsComp.HatchItWorkZone = True
                                                            End If
                                                            OsComp.RefreshRemotely()
                                                        End If
                                                    End If
                                                Next
                                            End If
                                        Else
                                            Dim sw As Switch = CType(comp, Switch)
                                            sw.Bulletins.Add(sb)
                                            sb.CompList.Add(sw)

                                            If sb.theType = "A" And Not sw.HatchItWorkZone Then
                                                sw.HatchItSpeed = True
                                            ElseIf sb.theType = "F" And Not sw.HatchItWorkZone Then
                                                sw.HatchItInformational = True
                                            Else
                                                sw.HatchItWorkZone = True
                                            End If
                                            sw.RefreshRemotely()
                                        End If
                                    End If
                                End If
                            Next
                        End If

                        If Not TMDS.GlobalDeclarations.BulletinCollection.Contains(sb) Then
                            TMDS.GlobalDeclarations.BulletinCollection.Add(sb)
                            Dim SummItem As New SummaryItem("SUB-BULLETIN", "ADD", sb, "Utils_AddGBO")
                            SyncLock gSubBulletinsMessageSummaryQueue.SyncRoot
                                gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                            End SyncLock
                        End If
                    End If
                End While
                dbconn.Close()
                dbconn = Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
        End Sub

