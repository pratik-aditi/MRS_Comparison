        Friend Shared Function GetForemanFromDB_ByGUID(GUID As String) As MOWID
            Dim dr As OleDbDataReader = Nothing
            Dim dbComm As New OleDbCommand
            Dim MOWFetch As String = "SELECT * FROM " & gtblMOWActive & " WHERE MowGUID='" & GUID & "'"
            Try
                If GUID.Trim = "" Then Return Nothing
                Using dbConn As New OleDbConnection(gConnectionStringDynamic)
                    dbConn.Open()
                    dbComm = New OleDbCommand(MOWFetch, dbConn)
                    dr = dbComm.ExecuteReader()
                    If dr.HasRows Then
                        While dr.Read()
                            Dim mow As New MOWID
                            With mow
                                .Name = dr.GetString(0)
                                .DisplayText = .Name
                                .TrackGUID = dr.GetInt32(3)
                                .Subdivision = dr.GetString(1)
                                .MowGUID = dr.GetString(4)
                                If dr.FieldCount >= 5 Then
                                    If Not dr.IsDBNull(5) Then
                                        .DisplayText = dr.GetString(5).Trim.ToUpper
                                    End If
                                End If
                            End With
                            mow.FindForeman()
                            Return mow
                        End While
                        dr.Close()
                        dbConn.Close()
                    End If
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return Nothing

        End Function

