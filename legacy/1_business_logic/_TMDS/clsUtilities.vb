        Private Shared Function DatabaseCommand(ByRef CommandString As String) As Boolean
            Dim CommandExec As OleDbCommand
            Dim dbconn As OleDb.OleDbConnection

            Try
                dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                CommandExec = New OleDbCommand(CommandString, dbconn)
                If CommandExec.Connection.State = ConnectionState.Open Then
                    CommandExec.Connection.Close()
                End If
                CommandExec.Connection.Open()
                CommandExec.ExecuteNonQuery()
                dbconn.Close()
                CommandExec.Dispose()
                CommandExec = Nothing
                dbconn = Nothing
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                SystemException("QUERY EXPRESSION ERROR:" & CommandString)
                dbconn = Nothing
                Return False
            End Try
        End Function

        Public Shared Function ValidateDate(ByVal DateString As String) As Boolean
            Try
                If DateString = "NONE" Or DateString = "" Then
                    Return False
                End If
                Try
                    Dim TestDate As Date = CDate(DateString)
                    Return True
                Catch
                    Return False
                End Try
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Shared Function CheckForSymbolOnOtherDesk(ByVal trn As TrainID) As Boolean
            Dim TrainFetch As String
            Dim dr As OleDbDataReader
            Dim DatabaseCommand As OleDbCommand
            Dim q As String = "'"
            Dim dbconn As OleDb.OleDbConnection

            TrainFetch = "SELECT TrackGUID,SecondaryTrackGUID FROM tblTrainsActive "
            TrainFetch = TrainFetch & " WHERE Symbol = " & q & trn.Name & q

            Try
                dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                DatabaseCommand = New OleDbCommand(TrainFetch, dbconn)
                dbconn.Open()
                dr = DatabaseCommand.ExecuteReader()
                While dr.Read()
                    If Not dr.IsDBNull(0) Then
                        If dr.GetInt32(0) <> 0 And dr.GetInt32(0) <> trn.myTrack.GUID Then
                            Return True
                        End If
                    End If
                    If Not dr.IsDBNull(1) Then
                        If dr.GetInt32(1) <> 0 And dr.GetInt32(1) <> trn.myTrack.GUID Then
                            Return True
                        End If
                    End If
                End While
                DatabaseCommand.Dispose()
                DatabaseCommand = Nothing
                dbconn.Close()
                dbconn = Nothing
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
        End Function
