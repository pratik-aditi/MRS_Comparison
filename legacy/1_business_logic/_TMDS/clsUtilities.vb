        End Sub

        Public Shared Function GetNextTrack(CurrentTrack As Track, Direction As String) As Track
            Dim I As Integer = 0
            Dim NextComp As Object = Nothing
            Try
                If CurrentTrack Is Nothing Then Return Nothing
                Select Case Direction.Trim.ToUpper
                    Case "RIGHT"
                        NextComp = FindCompFromGUID(CurrentTrack.RightLink)
                    Case Else
                        NextComp = FindCompFromGUID(CurrentTrack.LeftLink)
                End Select
                For I = 0 To 5
                    If NextComp IsNot Nothing AndAlso NextComp.GetType.ToString = gTrackComponentName Then
                        Return NextComp
                    Else
                        Select Case Direction.Trim.ToUpper
                            Case "RIGHT"
                                NextComp = FindCompFromGUID(NextComp.RightLink)
                            Case Else
                                NextComp = FindCompFromGUID(NextComp.LeftLink)
                        End Select
                    End If

                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return Nothing
        End Function

