        Shared Function FormatDateString(ByVal DateString As String) As String
            Try
                '200411111345C

                Dim sYear As String = Mid(DateString, 1, 4)
                Dim sMonth As String = Mid(DateString, 5, 2)
                Dim sDay As String = Mid(DateString, 7, 2)
                Dim sHour As String = Mid(DateString, 9, 2)
                Dim sMinute As String = Mid(DateString, 11, 2)
                Dim sZone As String = Mid(DateString, 13, 1)
                Try
                    Dim DateTimeToReturn As Date = CDate(sMonth & "-" & sDay & "-" & sYear & " " & sHour & ":" & sMinute)
                    Return sMonth & "-" & sDay & "-" & sYear & " " & sHour & ":" & sMinute
                Catch
                    Return "NONE"
                End Try

            Catch ex As Exception
                SystemException(ex.ToString)
                Return "NONE"
            End Try
        End Function

        Shared Function FormatAlphaNumericOnly(ByVal str As String) As String
            Try
                Dim ch As String

                Dim NewString As String = String.Empty
                str = str.ToUpper
                For Each ch In str
                    If Not IsNumeric(ch) Then
                        If Not IsAlpha(ch) Then
                            If Not ch = " " Then
                                Return NewString
                            End If
                        Else
                            NewString = NewString & ch
                        End If
                    Else
                        NewString = NewString & ch
                    End If
                Next
                Return NewString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Shared Function IsAlpha(ByVal Str As String) As Boolean
            Try
                Dim AlphaString As String = "ABCDEFGHIJKLMNOPQNRSTUVWXYZ"
                Dim ch As String
                For Each ch In AlphaString
                    If Str.ToUpper = ch Or Str = " " Then
                        Return True
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Shared Function CheckEngineIDFormatting(ByRef EngineToCheck As String) As String

            Try

                Dim c As String
                Dim NumericFound As Boolean
                Dim AlphaFound As Boolean
                Dim UnitID As String = String.Empty
                Dim AlphaPart As String = String.Empty
                Dim NumericPart As String = String.Empty
                EngineToCheck = TMDS.SystemUtilities.Formatting.FormatProperEngineStringForDatabase(EngineToCheck)
                EngineToCheck = EngineToCheck.Replace(" ", "")
                For Each c In EngineToCheck
                    If IsNumeric(c) Then
                        NumericFound = True
                        NumericPart = NumericPart & c
                    Else
                        If Not NumericFound Then
                            AlphaPart = AlphaPart & c
                            If c <> " " Then
                                AlphaFound = True
                            End If
                        End If
                    End If
                Next

                If Not NumericFound Then
                    Return False
                End If
                If Not AlphaFound Then
                    Return False
                End If
                Dim SpaceNeeded As Integer = 10 - (AlphaPart.Length + NumericPart.Length)
                If SpaceNeeded < 0 Then
                    Return False
                End If
                UnitID = AlphaPart.ToUpper & Space(SpaceNeeded) & NumericPart
                Return UnitID

            Catch ex As Exception
                SystemException(ex.ToString)
                Return EngineToCheck
            End Try
        End Function

        Shared Function ConvertTimeToTimeZone(ByVal CompList As ArrayList, ByVal CurrentTime As Date) As Date
            Try
                Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(CompList)
                If IsNothing(FirstTrack) Then Return CurrentTime
                Dim CurrentTimeZone As String = FirstTrack.TimeZone
                Dim NewTime As Date
                Select Case Mid(CurrentTimeZone, 1, 1)
                    Case "M"
                        NewTime = CurrentTime.AddHours(1)
                    Case "P"
                        NewTime = CurrentTime.AddHours(2)
                    Case Else
                        NewTime = CurrentTime
                End Select
                Return NewTime
            Catch ex As Exception
                Return CurrentTime
            End Try
        End Function
