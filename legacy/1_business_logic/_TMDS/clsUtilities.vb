#Region "TRAIN ID FUNCTIONS"

    Class TrainFunction

        Public Shared Sub RemoveLocomotive(ByVal trn As TrainID)
            If trn Is Nothing Then Exit Sub
            Dim loco As MobileTracking.Locomotive = Nothing
            Dim LocFound As MobileTracking.Locomotive = Nothing

            Try
                For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                    If loco.LocomotiveID = trn.IdentifingUnit Then
                        LocFound = loco
                        Exit For
                    End If
                Next
                If LocFound Is Nothing Then Exit Sub

                Dim SummItem As New SummaryItem("LOCOMOTIVE", "REMOVE", loco)
                SyncLock gLocomotiveSummaryQueue.SyncRoot
                    gLocomotiveSummaryQueue.Enqueue(SummItem)
                End SyncLock

                TMDS.GlobalDeclarations.gLocomotiveCollection.Remove(loco)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try


        End Sub

