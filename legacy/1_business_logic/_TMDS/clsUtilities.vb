#Region " BULLETIN RELATED FETCH "
        Public Shared Function FindBulletinCellByName(ByVal BCName As String) As BulletinCell
            Dim BC As BulletinCell = Nothing
            Try
                If BCName.Trim = "" Then Return Nothing
                If gBulletinCellRouteList.Count = 0 Then Return Nothing
                For Each BC In gBulletinCellRouteList
                    If BC.myName.ToUpper.Trim = BCName.ToUpper.Trim Then Return BC
                Next
                BC = Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                BC = Nothing
            End Try
            Return BC
        End Function

        Public Shared Function FindBulletinCellByID(ByVal BCID As Integer) As BulletinCell
            Dim BC As BulletinCell = Nothing
            Try
                If BCID = 0 Then Return Nothing
                If gBulletinCellRouteList.Count = 0 Then Return Nothing
                For Each BC In gBulletinCellRouteList
                    If BC.myUID = BCID Then Return BC
                Next
                BC = Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                BC = Nothing
            End Try
            Return BC
        End Function

        Public Shared Function FindTGBOByTrainSymbol(ByVal TrainSymbol As String, Optional GetActiveTGBOOnly As Boolean = False) As TabularGeneralBulletin
            Dim TGBO As TabularGeneralBulletin = Nothing
            Try
                If TrainSymbol.Trim = "" Then Return Nothing
                If gTabularGeneralBulletins.Count = 0 Then Return Nothing
                For Each TGBO In gTabularGeneralBulletins
                    If GetActiveTGBOOnly Then
                        If optEnableMultipeTrainListingsInGTB Or optEnableConductorTGBO Then
                            If (TGBO.IssuedTo = TrainSymbol OrElse TGBO.TrainSymbolList.Contains(TrainSymbol)) AndAlso TGBO.Status.ToUpper.Trim = "ACTIVE" Then Return TGBO
                        Else
                            If TGBO.IssuedTo = TrainSymbol AndAlso TGBO.Status.ToUpper.Trim = "ACTIVE" Then Return TGBO
                        End If

                    Else
                        If optEnableMultipeTrainListingsInGTB Or optEnableConductorTGBO Then
                            If (TGBO.IssuedTo = TrainSymbol OrElse TGBO.TrainSymbolList.Contains(TrainSymbol)) Then Return TGBO
                        Else
                            If TGBO.IssuedTo = TrainSymbol Then Return TGBO
                        End If

                    End If
                Next
                TGBO = Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                TGBO = Nothing
            End Try
            Return TGBO
        End Function
        Public Shared Function FindAllTGBOsByTrainSymbol(ByVal TrainSymbol As String) As ArrayList
            Dim TGBO As TabularGeneralBulletin = Nothing
            Dim TGBOCollection As New ArrayList
            Try
                If TrainSymbol.Trim = "" Then Return Nothing
                If gTabularGeneralBulletins.Count = 0 Then Return Nothing
                For Each TGBO In gTabularGeneralBulletins
                    If optEnableMultipeTrainListingsInGTB Or optEnableConductorTGBO Then
                        If TGBO.IssuedTo = TrainSymbol OrElse TGBO.TrainSymbolList.Contains(TrainSymbol) Then
                            If Not TGBOCollection.Contains(TGBO) Then TGBOCollection.Add(TGBO)
                        End If
                    Else
                        If TGBO.IssuedTo = TrainSymbol Then
                            If Not TGBOCollection.Contains(TGBO) Then TGBOCollection.Add(TGBO)
                        End If
                    End If

                Next
                TGBO = Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                TGBO = Nothing
            End Try
            Return TGBOCollection
        End Function

        Public Shared Function GetAllBulletinsForTGBO(ByVal TGBO As TabularGeneralBulletin) As ArrayList
            Dim sb As SubBulletin = Nothing
            Dim SubBullCollection As New ArrayList
            Dim TGBOBullString As String()
            Dim s As String
            Try
                If TGBO Is Nothing Then Return Nothing
                If TGBO.BulletinListDefinitions.Trim = "" Then Return Nothing

                TGBOBullString = TGBO.BulletinListDefinitions.Split("|")
                For Each s In TGBOBullString
                    If s.Trim <> "" Then
                        Dim sSplt() As String = s.Split(";")
                        If sSplt.GetUpperBound(0) > 0 Then
                            For Each sb In TMDS.GlobalDeclarations.BulletinCollection
                                If sb.myGUID = sSplt(0) Then
                                    If Not SubBullCollection.Contains(sb) Then SubBullCollection.Add(sb)
                                End If
                            Next
                        End If
                    End If
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
                SubBullCollection = Nothing
            End Try
            Return SubBullCollection
        End Function

        Public Shared Function FindBulletinByGUID(ByVal GUID As String) As SubBulletin
            Dim sb As SubBulletin = Nothing
            Try
                If GUID.Trim = "" Then Return Nothing
                If optEnableCancelFormOTrainSpecific Then
                    For Each sb In TMDS.GlobalDeclarations.BulletinCollection
                        If sb.CancelledBulletinGUID = GUID Then
                            Return sb
                            Exit For
                        End If
                    Next
                End If
                For Each sb In TMDS.GlobalDeclarations.BulletinCollection
                    If sb.myGUID = GUID OrElse sb.CancelledBulletinGUID = GUID Then
                        Return sb
                        Exit For
                    End If
                Next
                sb = Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                sb = Nothing
            End Try
            Return sb
        End Function

        Public Shared Function GetCPFormatedSubBulletinType(ByVal bull As SubBulletin) As String
            Dim TypeOfBull As String = ""
            Try
                TypeOfBull = "MISC"
                Select Case bull.mysTypeForm
                    Case "FORM D"
                        TypeOfBull = "FORM D - SPEED RESTRICTION"
                    Case "FORM B"
                        TypeOfBull = "FORM B – TRACK WORK"
                    Case "FORM X"
                        TypeOfBull = "CROSSING"
                    Case "FORM F"
                        TypeOfBull = "FLAGMAN"
                    Case "FORM O"
                        If bull.TrackOutOfSevice Then
                            TypeOfBull = "TRACK OOS"
                        ElseIf bull.TrackBlocked Then
                            TypeOfBull = "BLOCKED WITH EQUIPMENT"
                        Else
                            TypeOfBull = "TRK BLK/OOS"
                        End If
                    Case "FORM TT"
                        TypeOfBull = "TIME TABLE CHANGE"
                    Case "FORM FF"
                        TypeOfBull = "INFORMATION"

                End Select
            Catch ex As Exception
                GetErrorDetails(ex)
                TypeOfBull = ""
            End Try
            Return TypeOfBull
        End Function

        Public Shared Function GetCPFormatedSubBulletinStatus(ByVal bull As SubBulletin, ByRef ColorCode As Color, Optional ByVal TrainSymbol As String = "") As String
            Dim BullStatus As String = ""
            Try
                Select Case bull.myStatus
                    Case "EXCEPTIONS"
                        Dim exp As TabularGeneralBulletinException
                        Dim HasTBBlock As Boolean = False
                        For Each exp In bull.myExceptionList
                            'If exp.theDesignation = "" Then

                            'End If
                            If (exp.ProtectionType = "TB BLOCKED") Then
                                HasTBBlock = True
                                Exit For
                            ElseIf (exp.ProtectionType = "DELIVERED" AndAlso exp.HandlingType.Trim.ToUpper = "UNACKNOWLEDGED") Then
                                HasTBBlock = True
                                Exit For
                            End If

                        Next
                        If HasTBBlock Then
                            ColorCode = Color.Yellow
                        Else
                            ColorCode = Color.Red
                        End If
                        If bull.CancelledBulletin Then
                            BullStatus = "CANCELLED"
                            'ColorCode = Color.Red
                        ElseIf bull.ConfirmationData = "" Then
                            BullStatus = "ACTIVATED - NC"
                            'ColorCode = Color.Red
                        Else
                            BullStatus = "ACTIVATED"
                            'ColorCode = Color.Red
                        End If

                    Case "ACTIVATED"
                        If bull.ConfirmationData = "" Then
                            BullStatus = bull.myStatus & " - NC"
                            ColorCode = Color.LightGoldenrodYellow
                        Else
                            BullStatus = bull.myStatus
                            ColorCode = Color.LightGreen
                        End If
                    Case Else
                        BullStatus = bull.myStatus
                        ColorCode = Color.White
                End Select
            Catch ex As Exception
                GetErrorDetails(ex)
                BullStatus = ""
            End Try
            Return BullStatus
        End Function

