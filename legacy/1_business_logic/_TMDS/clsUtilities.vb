        Public Shared Function FindSubAbbrvNameOfViewTrainSymbol(ByVal SubUID As Int32) As String
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Query As String = String.Empty
            Dim SubAbbrvName As String = String.Empty
            Try
                Query = "SELECT SubdivisionAbbreviation FROM tblSystemSubDivisions WHERE UID = " & SubUID
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                dbcomm = New OleDbCommand(Query, dbconn)
                dbconn.Open()
                dr = dbcomm.ExecuteReader
                While dr.Read
                    If Not dr.IsDBNull(0) Then
