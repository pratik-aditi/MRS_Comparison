        Friend Shared Sub GetMyControllingControlPoints(DeskName As String)
            Dim strSQL1 As String = String.Empty
            Dim strSQL2 As New StringBuilder("SELECT ControlPointAssignments FROM tblTerritoryControlPointAssignments WHERE UID IN")
            Dim dr As OleDbDataReader = Nothing
            Dim dbcomm As New OleDbCommand
            Dim TerrCPAssignementstr As String = ""
            Dim ControlPointString As String = ""
            Dim CPUID As Integer = 0
            Try
                gMyControllingControlPtGUID = New ArrayList
                strSQL1 = "SELECT TerritoryControlPointList FROM tblTerritoryDeskAssignments  WHERE DeskAssignmentName = '" & DeskName.Trim & "'"
                Using DbConn As New OleDbConnection(gConnectionStringStatic)
                    DbConn.Open()
                    dbcomm = New OleDbCommand(strSQL1, DbConn)
                    dr = dbcomm.ExecuteReader
                    If dr.HasRows Then
                        While dr.Read
                            If Not dr.IsDBNull(0) Then TerrCPAssignementstr = dr.GetValue(0)
                        End While
                    End If
                    dr.Close()

                    If Not String.IsNullOrEmpty(TerrCPAssignementstr) AndAlso TerrCPAssignementstr.Trim <> "" Then
                        Dim CPAssignementstrdata() As String = TerrCPAssignementstr.Split(";")
                        If CPAssignementstrdata.Length > 0 Then
                            strSQL2.Append(" ( ")
                            For i As Integer = 0 To CPAssignementstrdata.Length - 1
                                If i = 0 Then
                                    strSQL2.Append("'" & CPAssignementstrdata(i) & "'")
                                Else
                                    strSQL2.Append(",'" & CPAssignementstrdata(i) & "'")
                                End If
                            Next
                            strSQL2.Append(" ) ")
                            dbcomm = New OleDbCommand(strSQL2.ToString, DbConn)
                            dr = dbcomm.ExecuteReader
                            If dr.HasRows Then
                                While dr.Read()
                                    ControlPointString = ""
                                    If Not dr.IsDBNull(0) Then ControlPointString = dr.GetString(0)
                                    If Not String.IsNullOrEmpty(ControlPointString) AndAlso ControlPointString.Trim <> "" Then
                                        Dim ControlPointStringData() As String = ControlPointString.Split(";")

                                        For i As Integer = 0 To ControlPointStringData.Length - 1
                                            CPUID = 0
                                            Integer.TryParse(ControlPointStringData(i), CPUID)
                                            If CPUID > 0 AndAlso Not gMyControllingControlPtGUID.Contains(CPUID) Then gMyControllingControlPtGUID.Add(CPUID)
                                        Next
                                    End If
                                End While
                            End If
                            dr.Close()
                        End If
                    End If
                End Using

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Sub

