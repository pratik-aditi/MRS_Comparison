        Public Shared Sub RemoveSubBulletin(ByVal BullUID As String)
            Try


                Dim sb As SubBulletin
                Dim sbFound As SubBulletin = Nothing
                For Each sb In BulletinCollection
                    If sb.BullUID = BullUID Then
                        sbFound = sb
                        Exit For
                    End If
                Next
                If Not IsNothing(sbFound) Then
                    Dim comp As Object
                    For Each comp In sbFound.CompList
                        comp.Bulletins.Remove(sbFound)
                        If comp.Bulletins.Count = 0 Then
                            comp.HatchItWorkZone = False
                            comp.HatchItSpeed = False
                        Else
                            Dim FormBFound As Boolean
                            For Each sb In comp.Bulletins
                                If sb.theType = "B" Then
                                    FormBFound = True
                                End If
                            Next

                            If FormBFound Then
                                comp.HatchItWorkZone = True
                                comp.HatchItSpeed = False
                            Else
                                comp.HatchItWorkZone = False
                                comp.HatchItSpeed = True
                            End If
                        End If

                        comp.RefreshRemotely()
                    Next

                    TMDS.GlobalDeclarations.BulletinCollection.Remove(sbFound)
                    Dim SummItem As New SummaryItem("SUB-BULLETIN", "REMOVE", sbFound, "Utils_RemoveGBO")
                    SyncLock gSubBulletinsMessageSummaryQueue.SyncRoot
                        gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                    End SyncLock
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

