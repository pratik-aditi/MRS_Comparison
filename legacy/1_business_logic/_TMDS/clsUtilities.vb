                            dv.Sort = "LeftMP"
                            If dv IsNot Nothing AndAlso dv.Count > 0 Then
                                LinkedTrkSegements = New ArrayList
                                PTCSegements = New ArrayList
                                TrkUIDCollection = New ArrayList
                                Dim SearchDirection As String = ""
                                AliasTrkName = ""
                                AliasTrkName = dv(0)("TrkNameAlias")
                                For I As Integer = 0 To dv.Count - 1
                                    If AliasTrkName.ToUpper.Trim = dv(I)("TrkNameAlias").ToString.ToUpper.Trim Then
                                        If Not TrkUIDCollection.Contains(dv(I)("UID")) Then TrkUIDCollection.Add(dv(I)("UID"))
                                    End If
                                Next
                                trk = Nothing
                                RightComp = Nothing
                                LeftComp = Nothing
                                trk = FindCompFromGUID(TrkUIDCollection(0))
                                RightComp = FindCompFromGUID(trk.RightLink)
                                LeftComp = FindCompFromGUID(trk.LeftLink)
                                If RightComp.GetType.ToString <> gTrackComponentName Then
                                    For K As Integer = 0 To 5
                                        If RightComp Is Nothing Then Exit For
                                        Select Case RightComp.GetType.ToString
                                            Case gTrackComponentName
                                                Exit For
                                            Case Else
                                                RightComp = FindCompFromGUID(RightComp.RightLink)
                                        End Select
                                    Next
                                End If
                                If LeftComp.GetType.ToString <> gTrackComponentName Then
                                    If LeftComp Is Nothing Then Exit For
                                    Select Case LeftComp.GetType.ToString
                                        Case gTrackComponentName
                                            Exit For
                                        Case Else
                                            LeftComp = FindCompFromGUID(LeftComp.LeftLink)
                                    End Select
                                End If

                                If RightComp IsNot Nothing AndAlso TrkUIDCollection.Contains(RightComp.GUID) Then
                                    SearchDirection = "RIGHT"
                                ElseIf LeftComp IsNot Nothing AndAlso TrkUIDCollection.Contains(LeftComp.GUID) Then
                                    SearchDirection = "LEFT"
                                Else
                                    SearchDirection = "NONE"
                                End If

                                For I As Integer = 0 To dv.Count - 1
                                    Dim TrackNameToCheck As String = ""
                                    If isAlltrackTB Then
                                        TrackNameToCheck = dv(I)("TrkNameAlias")
                                    Else
                                        TrackNameToCheck = dv(I)("FormattedTrkName")
                                    End If
                                    If S.ToUpper.Trim = TrackNameToCheck.ToUpper.Trim AndAlso TrkUIDCollection.Contains(dv(I)("UID")) Then
                                        Select Case SearchDirection.Trim.ToUpper
                                            Case "LEFT"
                                                trk = Nothing
                                                trk = FindCompFromGUID(dv(I)("UID"))
                                                If LinkedTrkSegements.Contains(trk) Then
                                                ElseIf TrkUIDCollection.Contains(trk.LeftLink) Then
                                                    If Not LinkedTrkSegements.Contains(trk) Then LinkedTrkSegements.Add(trk)
                                                    If trk IsNot Nothing AndAlso trk.OsComponentCollection IsNot Nothing AndAlso trk.OsComponentCollection.Count > 0 Then
                                                        comp = Nothing
                                                        If trk.OsComponentCollection IsNot Nothing AndAlso trk.OsComponentCollection.Count > 0 Then
                                                            For Each comp In trk.OsComponentCollection
                                                                If TrkUIDCollection.Contains(comp.GUID) Then
                                                                    If Not LinkedTrkSegements.Contains(comp) Then LinkedTrkSegements.Add(comp)
                                                                End If
                                                            Next
                                                        End If
                                                        comp = Nothing
                                                    End If
                                                Else
                                                    comp = Nothing
                                                    comp = FindCompFromGUID(trk.LeftLink)
                                                    If trk IsNot Nothing AndAlso trk.OsComponentCollection IsNot Nothing AndAlso trk.OsComponentCollection.Count > 0 AndAlso trk.OsComponentCollection.Contains(comp) Then
                                                        If Not LinkedTrkSegements.Contains(trk) Then LinkedTrkSegements.Add(trk)
                                                        NextComp = Nothing
                                                        If trk.OsComponentCollection IsNot Nothing AndAlso trk.OsComponentCollection.Count > 0 Then
                                                            For Each NextComp In trk.OsComponentCollection
                                                                If TrkUIDCollection.Contains(NextComp.GUID) Then
                                                                    If Not LinkedTrkSegements.Contains(NextComp) Then LinkedTrkSegements.Add(NextComp)
                                                                End If
                                                            Next
                                                        End If
                                                        NextComp = Nothing
                                                        comp = Nothing
                                                    End If
                                                    For J As Integer = 0 To 20
                                                        If comp Is Nothing Then Exit For
                                                        Select Case comp.GetType.ToString
                                                            Case gTrackComponentName
                                                                If comp.TrackNameAlias.ToUpper.Trim = AliasTrkName.ToUpper Then
                                                                    If Not LinkedTrkSegements.Contains(trk) Then LinkedTrkSegements.Add(trk)
                                                                    Exit For
                                                                ElseIf trk IsNot Nothing AndAlso trk.OsComponentCollection IsNot Nothing AndAlso trk.OsComponentCollection.Count > 0 AndAlso trk.OsComponentCollection.Contains(comp) Then
                                                                    If Not LinkedTrkSegements.Contains(trk) Then LinkedTrkSegements.Add(trk)
                                                                    Exit For
                                                                Else
                                                                    Dim pTC As New PTCCPTrackSegements
                                                                    With pTC
                                                                        .TrackName = AliasTrkName
                                                                        CopyArrayCollection(.CompCollection, LinkedTrkSegements)
                                                                    End With
                                                                    PTCSegements.Add(pTC)
                                                                    LinkedTrkSegements = New ArrayList
                                                                    Exit For
                                                                End If
                                                            Case Else
                                                                comp = FindCompFromGUID(comp.LeftLink)
                                                        End Select
                                                    Next
                                                End If
                                            Case "RIGHT"
                                                trk = Nothing
                                                trk = FindCompFromGUID(dv(I)("UID"))
                                                If LinkedTrkSegements.Contains(trk) Then
                                                ElseIf TrkUIDCollection.Contains(trk.RightLink) Then
                                                    If Not LinkedTrkSegements.Contains(trk) Then LinkedTrkSegements.Add(trk)
                                                    comp = Nothing
                                                    If trk.OsComponentCollection IsNot Nothing AndAlso trk.OsComponentCollection.Count > 0 Then
                                                        For Each comp In trk.OsComponentCollection
                                                            If TrkUIDCollection.Contains(comp.GUID) Then
                                                                If Not LinkedTrkSegements.Contains(comp) Then LinkedTrkSegements.Add(comp)
                                                            End If
                                                        Next
                                                    End If

                                                    comp = Nothing
                                                Else
                                                    comp = Nothing
                                                    comp = FindCompFromGUID(trk.RightLink)
                                                    If trk IsNot Nothing AndAlso trk.OsComponentCollection IsNot Nothing AndAlso trk.OsComponentCollection.Count > 0 AndAlso trk.OsComponentCollection.Contains(comp) Then
                                                        If Not LinkedTrkSegements.Contains(trk) Then LinkedTrkSegements.Add(trk)
                                                        NextComp = Nothing
                                                        If trk.OsComponentCollection IsNot Nothing AndAlso trk.OsComponentCollection.Count > 0 Then
                                                            For Each NextComp In trk.OsComponentCollection
                                                                If TrkUIDCollection.Contains(NextComp.GUID) Then
                                                                    If Not LinkedTrkSegements.Contains(NextComp) Then LinkedTrkSegements.Add(NextComp)
                                                                End If
                                                            Next
                                                        End If
                                                        NextComp = Nothing
                                                        comp = Nothing
                                                    End If
                                                    For J As Integer = 0 To 20
                                                        If comp Is Nothing Then Exit For
                                                        Select Case comp.GetType.ToString
                                                            Case gTrackComponentName
                                                                If comp.TrackNameAlias.ToUpper.Trim = AliasTrkName.ToUpper Then
                                                                    If Not LinkedTrkSegements.Contains(trk) Then LinkedTrkSegements.Add(trk)
                                                                    Exit For
                                                                ElseIf trk IsNot Nothing AndAlso trk.OsComponentCollection IsNot Nothing AndAlso trk.OsComponentCollection.Count > 0 AndAlso trk.OsComponentCollection.Contains(comp) Then
                                                                    If Not LinkedTrkSegements.Contains(trk) Then LinkedTrkSegements.Add(trk)
                                                                    Exit For
                                                                Else
                                                                    Dim pTC As New PTCCPTrackSegements
                                                                    With pTC
                                                                        .TrackName = AliasTrkName
                                                                        CopyArrayCollection(.CompCollection, LinkedTrkSegements)
                                                                    End With
                                                                    PTCSegements.Add(pTC)
                                                                    LinkedTrkSegements = New ArrayList
                                                                    Exit For
                                                                End If
                                                            Case Else
                                                                comp = FindCompFromGUID(comp.RightLink)
                                                        End Select
                                                    Next
                                                End If
                                            Case "NONE"
                                                trk = Nothing
                                                trk = FindCompFromGUID(dv(I)("UID"))
                                                If Not LinkedTrkSegements.Contains(trk) Then LinkedTrkSegements.Add(trk)
                                                Dim pTC As New PTCCPTrackSegements
                                                With pTC
                                                    .TrackName = AliasTrkName
                                                    CopyArrayCollection(.CompCollection, LinkedTrkSegements)
                                                End With
                                                PTCSegements.Add(pTC)
                                                LinkedTrkSegements = New ArrayList

                                        End Select
                                    End If
                                Next
                                If LinkedTrkSegements IsNot Nothing AndAlso LinkedTrkSegements.Count > 0 Then
                                    Dim MpTC As New PTCCPTrackSegements
                                    With MpTC
                                        .TrackName = AliasTrkName
                                        CopyArrayCollection(.CompCollection, LinkedTrkSegements)
                                    End With
                                    PTCSegements.Add(MpTC)
                                End If
                                LinkedTrkSegements = New ArrayList

                                Dim iPTC As PTCCPTrackSegements = Nothing
                                For Each iPTC In PTCSegements
                                    If iPTC IsNot Nothing Then
                                        Firsttrk = Nothing
                                        Lasttrk = Nothing
                                        PTCTrkName = ""
                                        BeginMilePost = ""
                                        EndMilePost = ""
                                        PTCTrkName = AliasTrkName
                                        Firsttrk = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(iPTC.CompCollection)
                                        Lasttrk = TMDS.SystemUtilities.FetchData.FindLastTrackInList(iPTC.CompCollection)
                                        Dim MPDirection As String = ""
                                        Dim HighMile As Decimal
                                        Dim LowMile As Decimal
                                        Dim TKCollection As New ArrayList
                                        If Not TKCollection.Contains(Firsttrk) Then TKCollection.Add(Firsttrk)
                                        If Not TKCollection.Contains(Lasttrk) Then TKCollection.Add(Lasttrk)
                                        GetLowHighMilesInLimits(TKCollection, LowMile, HighMile, Nothing, Nothing, True)
                                        MPDirection = GetVETMSMilePostDirection(Firsttrk, AuthDirection)
                                        If MPDirection = "A" Then
                                            BeginMilePost = LowMile
                                            EndMilePost = HighMile
                                        Else
                                            BeginMilePost = HighMile
                                            EndMilePost = LowMile
                                        End If

                                        With SegmentString
                                            If Not FirstLoop Then
                                                .Append("|")
                                            End If
                                            .Append(MyUID)
                                            .Append(";")
                                            .Append(thisSubdivision.Name)
                                            .Append(";")
                                            .Append(BeginMilePost)
                                            .Append(";")
                                            .Append(String.Empty)
                                            .Append(";")
                                            .Append(EndMilePost) '.Append(EndMilePost)
                                            .Append(";")
                                            .Append(MilePostBeginPrefix)
                                            .Append(";")
                                            .Append(MilePostEndPrefix)
                                            .Append(";")
                                            .Append(PTCTrkName)
                                            .Append(";")
                                            .Append(thisSubdivision.GUID)
                                            .Append(";")
                                            .Append(True.ToString.ToUpper)
                                            .Append(";")
                                            .Append(SegType.Trim)
                                            .Append(";")
                                            .Append(SegSpeed)
                                            .Append(";")
                                            .Append(Entity.Trim)
                                            FirstLoop = False
                                        End With

                                    End If
                                Next
                            Else
                                With SegmentString
                                    If Not FirstLoop Then
                                        .Append("|")
                                    End If
                                    .Append(MyUID)
                                    .Append(";")
                                    .Append(thisSubdivision.Name)
                                    .Append(";")
                                    .Append(MilePostBegin)
                                    .Append(";")
                                    .Append(String.Empty)
                                    .Append(";")
                                    .Append(MilePostEnd)
                                    .Append(";")
                                    .Append(MilePostBeginPrefix)
                                    .Append(";")
                                    .Append(MilePostEndPrefix)
                                    .Append(";")
                                    .Append(S.ToUpper.Trim)
                                    .Append(";")
                                    .Append(thisSubdivision.GUID)
                                    .Append(";")
                                    .Append(True.ToString.ToUpper)
                                    .Append(";")
                                    .Append(SegType.Trim)
                                    .Append(";")
                                    .Append(SegSpeed)
                                    .Append(";")
                                    .Append(Entity.Trim)
                                End With
                            End If
                        End If

                    Next
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
                SegmentString = New StringBuilder
            Finally
                dtTrack = Nothing
                MyTrackCollection = Nothing
                drow = Nothing
                trk = Nothing
                comp = Nothing
                RightComp = Nothing
                LeftComp = Nothing
                Firsttrk = Nothing
                Lasttrk = Nothing
                LinkedTrkSegements = Nothing
                PTCSegements = Nothing
                TrkUIDCollection = Nothing
            End Try
        End Sub

        Public Shared Sub GetLowHighMilesInLimits(ByVal CompList As ArrayList, ByRef LowMP As Decimal, ByRef HighMP As Decimal,
                                                  Optional ByRef LowMileTrack As Track = Nothing, Optional ByRef HighMileTrack As Track = Nothing, Optional ByVal IgnoreTurnOutTracks As Boolean = False,
                                                  Optional ByRef LowMPPrefix As String = "", Optional ByRef LowMPSuffix As String = "", Optional ByRef HighMPPrefix As String = "", Optional ByRef HighMPSuffix As String = "")
            Try
                LowMP = 0
                HighMP = 0
                Dim comp As Object
                For Each comp In CompList
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim OkToProcess As Boolean = True
                        Dim trk As Track = DirectCast(comp, Track)
                        If IgnoreTurnOutTracks AndAlso trk.TurnOutType Then OkToProcess = False
                        If OkToProcess Then
                            If LowMP = 0 Then
                                LowMP = trk.LeftLimitMilePost
                                LowMileTrack = comp
                            End If
                            If trk.LeftLimitMilePost < LowMP Then
                                LowMP = trk.LeftLimitMilePost
                                LowMileTrack = comp
                            End If
                            If trk.RightLimitMilePost < LowMP Then
                                LowMP = trk.RightLimitMilePost
                                LowMileTrack = comp
                            End If

                            If trk.LeftLimitMilePost > HighMP Then
                                HighMP = trk.LeftLimitMilePost
                                HighMileTrack = comp
                            End If
                            If trk.RightLimitMilePost > HighMP Then
                                HighMP = trk.RightLimitMilePost
                                HighMileTrack = comp
                            End If
                        End If
                    End If
                Next

                If LowMileTrack IsNot Nothing Then
                    LowMPPrefix = LowMileTrack.MilePostPrefix
                    LowMPSuffix = LowMileTrack.MilePostSuffix
                End If
                If HighMileTrack IsNot Nothing Then
                    HighMPPrefix = HighMileTrack.MilePostPrefix
                    HighMPSuffix = HighMileTrack.MilePostSuffix
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Public Shared Function SplitVETMSTrackSegments(ByVal TrackCollection As ArrayList, ByVal AuthDirection As String,
                                                       Optional ByVal pBeginMile As Decimal = 0, Optional ByVal pEndMile As Decimal = 0,
                                                       Optional ByVal isBulletin As Boolean = False) As ArrayList
            Dim MileBegin As Decimal = 0
            Dim MileEnd As Decimal
            Dim TotalMP As Decimal
            Dim SegmentSplit As Integer = gEnablePTCVETMSTrackSegmentSplitMiles
            Dim TrackSegmentCollection As New ArrayList
            Dim AddedTrackSegmentCollection As New ArrayList
            Dim TrackList As New ArrayList

            Dim TrackSegmentList As New ArrayList
            Dim TempBeginMP As Decimal = 0
            Dim TempEndMP As Decimal = 0

            Dim MilepostDirection As String = String.Empty
            Dim HighMile As Decimal
            Dim LowMile As Decimal
            Try
                If isBulletin Then
                    MileBegin = pBeginMile
                    MileEnd = pEndMile
                    MilepostDirection = "A"
                    AuthDirection = ""
                    HighMile = pBeginMile
                    LowMile = pEndMile

                Else
                    Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(TrackCollection)
                    Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(TrackCollection)

                    Select Case AuthDirection.ToUpper.Trim
                        Case "RIGHT"
                            If FirstTrack.LeftLimitMilePost > FirstTrack.RightLimitMilePost Then
                                MilepostDirection = "D"
                            Else
                                MilepostDirection = "A"
                            End If
                        Case Else
                            If FirstTrack.LeftLimitMilePost > FirstTrack.RightLimitMilePost Then
                                MilepostDirection = "A"
                            Else
                                MilepostDirection = "D"
                            End If
                    End Select

                    GetLowHighMilesInLimits(TrackCollection, LowMile, HighMile)
                    If MilepostDirection = "A" Then
                        MileBegin = LowMile
                        MileEnd = HighMile
                    Else
                        MileBegin = HighMile
                        MileEnd = LowMile
                    End If
                End If

                TotalMP = Math.Abs(HighMile - LowMile)

                Dim NoOfSegMent As Integer = Math.Abs(Math.Floor(TotalMP / SegmentSplit))
                Dim y As Integer = 0
                Dim LastBitOfSegment As Integer = 0

                If NoOfSegMent > 0 Then
                    y = TotalMP Mod SegmentSplit
                    If y > 0 Then
                        If y > 3 Then
                            NoOfSegMent = NoOfSegMent + 1
                        Else
                            LastBitOfSegment = y
                        End If
                    End If
                End If

                If NoOfSegMent = 0 And TotalMP < SegmentSplit Then
                    If isBulletin Then
                        Dim SplitSeg As New clsPTCVETMSTrackSegmentSplit
                        With SplitSeg
                            .CreateDate = Now
                            .BeginMP = pBeginMile
                            .EndMP = pEndMile
                            CopyArrayCollection(.TrackCollection, TrackCollection)
                        End With
                        TrackSegmentList.Add(SplitSeg)
                        Return TrackSegmentList
                    Else
                        NoOfSegMent = 1
                    End If
                End If

                If TotalMP > 0 And TotalMP < 1 And NoOfSegMent = 0 Then
                    NoOfSegMent = 1
                End If

                CopyArrayCollection(TrackList, TrackCollection)
                TempBeginMP = MileBegin

                If gDebug Then SystemEvent("TRACING MP :" & MileBegin.ToString & ";" & MileEnd.ToString)

                Dim i As Integer = 1
                While i <= NoOfSegMent

                    If MilepostDirection = "D" Then
                        If TotalMP < SegmentSplit Then
                            TempEndMP = MileEnd
                        ElseIf Math.Abs(MileEnd - TempEndMP) < SegmentSplit And i = NoOfSegMent Then
                            TempEndMP = MileEnd
                        Else
                            TempEndMP = (TempBeginMP - SegmentSplit)
                            If i = NoOfSegMent AndAlso LastBitOfSegment > 0 Then
                                TempEndMP = MileEnd
                            End If
                        End If
                    Else
                        If TotalMP < SegmentSplit Then
                            TempEndMP = MileEnd
                        ElseIf Math.Abs(MileEnd - TempEndMP) < SegmentSplit And i = NoOfSegMent Then
                            TempEndMP = MileEnd
                        Else
                            TempEndMP = (TempBeginMP + SegmentSplit)
                            If i = NoOfSegMent AndAlso LastBitOfSegment > 0 Then
                                TempEndMP = MileEnd
                            End If
                        End If
                    End If

                    If gDebug Then SystemEvent("TRACING TEMPMP :" & TempBeginMP.ToString & ";" & TempEndMP.ToString)

                    TrackSegmentCollection = New ArrayList
                    Dim tcomp As Object
                    Dim trk As Track

                    For Each tcomp In TrackList
                        If tcomp.GetType.ToString = gTrackComponentName Then
                            trk = DirectCast(tcomp, Track)
                            If TMDS.SystemUtilities.FetchData.BetweenNumbers(TempBeginMP, TempEndMP, trk.LeftLimitMilePost, trk.RightLimitMilePost) _
                            AndAlso Not AddedTrackSegmentCollection.Contains(trk) Then
                                If gDebug Then SystemEvent("TRACING ADDING TRACKS TO SEGMENT :" & i.ToString & ";" & trk.GUID.ToString & ";" & trk.Name.ToString & ";" & trk.LeftLimitMilePost.ToString & ";" & trk.RightLimitMilePost.ToString)
                                If Not AddedTrackSegmentCollection.Contains(trk) Then AddedTrackSegmentCollection.Add(trk)
                                If Not TrackSegmentCollection.Contains(trk) Then TrackSegmentCollection.Add(trk)
                            End If
                        End If
                    Next

                    tcomp = Nothing
                    trk = Nothing
                    Dim AddedTrkColl As New ArrayList
                    AddedTrkColl = TrackSegmentCollection.Clone

                    For Each trk In AddedTrkColl
                        If Not isBulletin Then
                            If trk.OStype AndAlso trk.OsComponentCollection.Count > 0 Then
                                Dim oscomp As Object
                                For Each oscomp In trk.OsComponentCollection
                                    If TrackList.Contains(oscomp) Then
                                        If Not AddedTrackSegmentCollection.Contains(oscomp) Then
                                            AddedTrackSegmentCollection.Add(oscomp)
                                        End If
                                        If Not TrackSegmentCollection.Contains(oscomp) Then
                                            If gDebug Then SystemEvent("TRACING ADDING OS TRACKS TO SEGMENT :" & i.ToString & ";" & trk.GUID.ToString & ";" & trk.Name.ToString & ";" & trk.LeftLimitMilePost.ToString & ";" & trk.RightLimitMilePost.ToString)
                                            TrackSegmentCollection.Add(oscomp)
                                            If (AuthDirection.ToUpper.Trim = "LEFT" And MilepostDirection = "A") Then
                                                If trk.LeftLimitMilePost > TempEndMP Then
                                                    TempEndMP = trk.LeftLimitMilePost
                                                End If
                                            ElseIf (AuthDirection.ToUpper.Trim = "RIGHT" And MilepostDirection = "D") Then
                                                If trk.RightLimitMilePost > TempEndMP Then
                                                    TempEndMP = trk.LeftLimitMilePost
                                                End If
                                            ElseIf (AuthDirection.ToUpper.Trim = "RIGHT" And MilepostDirection = "A") Then
                                                If trk.RightLimitMilePost < TempEndMP Then
                                                    TempEndMP = trk.LeftLimitMilePost
                                                End If
                                            ElseIf (AuthDirection.ToUpper.Trim = "LEFT" And MilepostDirection = "D") Then
                                                If trk.LeftLimitMilePost < TempEndMP Then
                                                    TempEndMP = trk.LeftLimitMilePost
                                                End If
                                            End If
                                        End If
                                    End If
                                Next
                            End If
                        End If
                    Next

                    If TrackSegmentCollection IsNot Nothing AndAlso TrackSegmentCollection.Count > 0 Then
                        Dim SplitSeg As New clsPTCVETMSTrackSegmentSplit
                        With SplitSeg
                            .CreateDate = Now
                            .BeginMP = TempBeginMP
                            .EndMP = TempEndMP
                            CopyArrayCollection(.TrackCollection, TrackSegmentCollection)
                        End With
                        TrackSegmentList.Add(SplitSeg)
                    End If
                    TempBeginMP = TempEndMP
                    i = i + 1
                End While
                Return TrackSegmentList
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return Nothing
        End Function

        Public Shared Function GetVETMSLowHighMilesInOsCollection(ByVal OSTrack As Track, ByVal ReturnLowMP As Boolean) As Double
            Dim LowMP As Double = 0
            Dim HighMP As Double = 0
            Dim ReturnMP As Double = 0
            Dim OSCollection As New ArrayList
            Dim Comp As Object = Nothing
            Try
                For Each Comp In OSTrack.OsComponentCollection
                    If Comp.GetType.ToString = gTrackComponentName AndAlso Not Comp.TurnOutType Then
                        If Not OSCollection.Contains(Comp) Then OSCollection.Add(Comp)
                    End If
                Next

                GetLowHighMilesInLimits(OSCollection, LowMP, HighMP)
                If ReturnLowMP Then
                    ReturnMP = LowMP
                Else
                    ReturnMP = HighMP
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                OSCollection = Nothing
                Comp = Nothing
            End Try
            Return ReturnMP
        End Function

        Public Shared Sub GetMilePostFromTrackLimit(ByRef BeginMP As Decimal, ByRef EndMP As Decimal, ByVal FromLimit As String, ByVal ToLimit As String, ByVal LowToHigh As Boolean,
                                              ByRef RestrictionComponents As ArrayList, ByVal AuthorityComponents As ArrayList, ByVal AuthorityDirection As String)
            Dim Comp As Object = Nothing
            Dim LeftMPFound As Boolean = False
            Dim RightMPFound As Boolean = False
            Dim FromMP As Decimal = 0
            Dim ToMP As Decimal = 0
            Dim HasSameLimits As Boolean = False
            Dim AddCompsToRestrictionArray As Boolean = False
            Dim tmpComp As Object = Nothing
            Try
                RestrictionComponents = New ArrayList
                If FromLimit.ToUpper.Trim = ToLimit.ToUpper.Trim Then HasSameLimits = True

                For Each Comp In AuthorityComponents
                    If Comp.GetType.ToString = gTrackComponentName Then
                        Select Case AuthorityDirection.ToUpper.Trim
                            Case "RIGHT"
                                If Not LeftMPFound AndAlso Comp.LeftLimitName.ToUpper.Trim = FromLimit.ToUpper.Trim Then
                                    'FromMP = Comp.LeftLimitMilePost
                                    'LeftMPFound = True
                                    If Comp.OsComponentCollection IsNot Nothing AndAlso Comp.OsComponentCollection.Count > 0 Then
                                        FromMP = TMDS.SystemUtilities.FetchData.GetVETMSLowHighMilesInOsCollection(Comp, False)
                                        tmpComp = Nothing
                                        For Each tmpComp In Comp.OsComponentCollection
                                            If Not RestrictionComponents.Contains(tmpComp) Then RestrictionComponents.Add(tmpComp)
                                        Next
                                    Else
                                        FromMP = Comp.RightLimitMilePost
                                    End If
                                    LeftMPFound = True
                                    AddCompsToRestrictionArray = True
                                    If Not RestrictionComponents.Contains(Comp) Then RestrictionComponents.Add(Comp)
                                End If
                                If Not RightMPFound AndAlso Comp.RightLimitName.ToUpper.Trim = ToLimit.ToUpper.Trim Then
                                    'ToMP = Comp.RightLimitMilePost
                                    'RightMPFound = True
                                    If Comp.OsComponentCollection IsNot Nothing AndAlso Comp.OsComponentCollection.Count > 0 Then
                                        ToMP = TMDS.SystemUtilities.FetchData.GetVETMSLowHighMilesInOsCollection(Comp, True)
                                        tmpComp = Nothing
                                        For Each tmpComp In Comp.OsComponentCollection
                                            If Not RestrictionComponents.Contains(tmpComp) Then RestrictionComponents.Add(tmpComp)
                                        Next
                                    Else
                                        ToMP = Comp.LeftLimitMilePost
                                    End If
                                    RightMPFound = True
                                    AddCompsToRestrictionArray = True
                                    If Not RestrictionComponents.Contains(Comp) Then RestrictionComponents.Add(Comp)
                                End If
                                If RightMPFound AndAlso LeftMPFound Then Exit For
                                If AddCompsToRestrictionArray AndAlso Not RestrictionComponents.Contains(Comp) Then RestrictionComponents.Add(Comp)
                                If HasSameLimits Then
                                    If RightMPFound And Not LeftMPFound Then
                                        FromMP = ToMP
                                        Exit For
                                    ElseIf Not RightMPFound And LeftMPFound Then
                                        ToMP = FromMP
                                        Exit For
                                    End If
                                End If
                            Case "LEFT"
                                If Not RightMPFound AndAlso Comp.RightLimitName.ToUpper.Trim = FromLimit.ToUpper.Trim Then
                                    'FromMP = Comp.RightLimitMilePost
                                    'RightMPFound = True
                                    If Comp.OsComponentCollection IsNot Nothing AndAlso Comp.OsComponentCollection.Count > 0 Then
                                        FromMP = TMDS.SystemUtilities.FetchData.GetVETMSLowHighMilesInOsCollection(Comp, True)
                                        tmpComp = Nothing
                                        For Each tmpComp In Comp.OsComponentCollection
                                            If Not RestrictionComponents.Contains(tmpComp) Then RestrictionComponents.Add(tmpComp)
                                        Next
                                    Else
                                        FromMP = Comp.RightLimitMilePost
                                    End If
                                    RightMPFound = True
                                    AddCompsToRestrictionArray = True
                                    If Not RestrictionComponents.Contains(Comp) Then RestrictionComponents.Add(Comp)
                                End If
                                If Not LeftMPFound AndAlso Comp.LeftLimitName.ToUpper.Trim = ToLimit.ToUpper.Trim Then
                                    If Comp.OsComponentCollection IsNot Nothing AndAlso Comp.OsComponentCollection.Count > 0 Then
                                        ToMP = TMDS.SystemUtilities.FetchData.GetVETMSLowHighMilesInOsCollection(Comp, False)
                                        LeftMPFound = True
                                        tmpComp = Nothing
                                        For Each tmpComp In Comp.OsComponentCollection
                                            If Not RestrictionComponents.Contains(tmpComp) Then RestrictionComponents.Add(tmpComp)
                                        Next
                                    Else
                                        ToMP = Comp.LeftLimitMilePost
                                        LeftMPFound = True
                                    End If
                                    AddCompsToRestrictionArray = True
                                    If Not RestrictionComponents.Contains(Comp) Then RestrictionComponents.Add(Comp)
                                End If
                                If RightMPFound AndAlso LeftMPFound Then Exit For
                                If AddCompsToRestrictionArray AndAlso Not RestrictionComponents.Contains(Comp) Then RestrictionComponents.Add(Comp)
                                If HasSameLimits Then
                                    If RightMPFound And Not LeftMPFound Then
                                        ToMP = FromMP
                                        If AddCompsToRestrictionArray AndAlso Not RestrictionComponents.Contains(Comp) Then RestrictionComponents.Add(Comp)
                                        Exit For
                                    ElseIf Not RightMPFound And LeftMPFound Then
                                        FromMP = ToMP
                                        If AddCompsToRestrictionArray AndAlso Not RestrictionComponents.Contains(Comp) Then RestrictionComponents.Add(Comp)
                                        Exit For
                                    End If
                                End If
                        End Select
                    End If
                Next
                If LowToHigh Then
                    If FromMP > ToMP Then
                        BeginMP = ToMP
                        EndMP = FromMP
                    Else
                        BeginMP = FromMP
                        EndMP = ToMP
                    End If
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                Comp = Nothing
            End Try


        End Sub

