        ''' <summary>
        ''' This function gets the controlling signal when the track has traffic direction OR 
        ''' If search direction specified then it returns left or right signal based on search direction.
        ''' </summary>
        ''' <param name="TrackToSearch"></param>
        ''' <param name="SearchDirection"></param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared Function FindMyControllingSignal(ByVal TrackToSearch As Track, Optional ByVal SearchDirection As String = "") As Signal
            'This function finds the Controlling Signal when the track has traffic direction or Specify Search direction to find Left or Right Signal.
            If TrackToSearch Is Nothing Then Return Nothing
            Dim TDirection As String = TrackToSearch.TrafficDirection
            Dim NextComp As Object = TrackToSearch
            If SearchDirection.Trim <> "" Then TDirection = SearchDirection
            Dim AltTrack As Object = Nothing
            Dim SearchedComponents As New ArrayList
            Try
                For i As Integer = 1 To 50
                    Select Case TDirection
                        Case "RIGHT"
                            NextComp = FindCompFromGUID(NextComp.LeftLink)
                            If NextComp.GetType.ToString = gSignalComponentName AndAlso Not NextComp.MakeInvisible AndAlso Not NextComp.AutomaticSignal Then
                                'If NextComp.ComponentType = "L" Or NextComp.ComponentType = "U" Then
                                If NextComp.ComponentType = "R" Or NextComp.ComponentType = "D" Then
                                    Return NextComp
                                End If
                                If Not SearchedComponents.Contains(NextComp) Then SearchedComponents.Add(NextComp)
                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                If NextComp.TypeOfSwitch <> "SPM ONLY" Then
                                    AltTrack = Nothing
                                    If NextComp.RightAltLink > 0 Then AltTrack = FindCompFromGUID(NextComp.RightAltLink)
                                    If NextComp.LeftAltLink > 0 Then AltTrack = FindCompFromGUID(NextComp.LeftAltLink)
                                    If Not AltTrack.NonTransverable Then
                                        If Not SearchedComponents.Contains(AltTrack) Then NextComp = AltTrack
                                    End If
                                End If
                            End If
                            If Not SearchedComponents.Contains(NextComp) Then SearchedComponents.Add(NextComp)
                        Case "LEFT"
                            NextComp = FindCompFromGUID(NextComp.RightLink)
                            If NextComp.GetType.ToString = gSignalComponentName AndAlso Not NextComp.MakeInvisible AndAlso Not NextComp.AutomaticSignal Then
                                'If NextComp.ComponentType = "R" Or NextComp.ComponentType = "D" Then
                                If NextComp.ComponentType = "L" Or NextComp.ComponentType = "U" Then
                                    Return NextComp
                                End If
                                If Not SearchedComponents.Contains(NextComp) Then SearchedComponents.Add(NextComp)
                            ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                                If NextComp.TypeOfSwitch <> "SPM ONLY" Then
                                    AltTrack = Nothing
                                    If NextComp.RightAltLink > 0 Then AltTrack = FindCompFromGUID(NextComp.RightAltLink)
                                    If NextComp.LeftAltLink > 0 Then AltTrack = FindCompFromGUID(NextComp.LeftAltLink)
                                    'If Not AltTrack.NonTransverable Then NextComp = AltTrack
                                    If Not AltTrack.NonTransverable Then
                                        If Not SearchedComponents.Contains(AltTrack) Then NextComp = AltTrack
                                    End If
                                End If
                            End If
                            If Not SearchedComponents.Contains(NextComp) Then SearchedComponents.Add(NextComp)
                    End Select
                Next

                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                AltTrack = Nothing
                SearchedComponents = Nothing
            End Try
        End Function

        Public Shared Function FindMySignalRoute(ByVal Sig As Signal, Optional ByVal ExitOnNonTransverable As Boolean = False, Optional ByRef ExitSignal As Signal = Nothing) As ArrayList
            Dim EndOfRouteFound As Boolean
            Dim CompToCheck As Object
            Dim SearchRight As Boolean
            Dim FlipFlopFound As Boolean
            Dim DirectionOfRoute As String
            Dim NextReferenceGUID, LastReferenceGUID As Int32
            Dim SignalRoute As New ArrayList()
            Dim LoopControl As Integer

            Try
                If Sig Is Nothing Then Return Nothing
                'set the direction of the search
                If Sig.ComponentType = "R" Or Sig.ComponentType = "D" Then
                    SearchRight = True
                    DirectionOfRoute = "RIGHT"
                Else
                    DirectionOfRoute = "LEFT"
                End If

                'init the first link to valid
                If SearchRight Then
                    NextReferenceGUID = Sig.RightLink
                Else
                    NextReferenceGUID = Sig.LeftLink
                End If

                'begin the validation search
                While Not EndOfRouteFound
                    CompToCheck = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextReferenceGUID) 'FindObjectTypeFromGUID(NextReferenceGUID)
                    If CompToCheck Is Nothing Then Return Nothing
                    Select Case CompToCheck.GetType.ToString
                        Case "TMDS.SwitchComponents.Switch"
                            If FlipFlopFound Then CompToCheck.FlipMe = True

                            'check to see if switch is CTC operations
                            If CompToCheck.AuthorityType <> "CTC" Then
                                Return SignalRoute
                            End If


                            'check request position of switch
                            If SearchRight And CompToCheck.RightAltLink <> 0 Then
                                If Not CompToCheck.FlipOperations Then
                                    If Not CompToCheck.ControlledReverse Then
                                        NextReferenceGUID = CompToCheck.RightLink
                                    Else
                                        NextReferenceGUID = CompToCheck.RightAltLink
                                    End If
                                Else
                                    If CompToCheck.ControlledReverse Then
                                        NextReferenceGUID = CompToCheck.RightLink
                                    Else
                                        NextReferenceGUID = CompToCheck.RightAltLink
                                    End If

                                End If
                            ElseIf Not SearchRight And CompToCheck.LeftAltLink <> 0 Then
                                If Not CompToCheck.FlipOperations Then
                                    If Not CompToCheck.ControlledReverse Then
                                        NextReferenceGUID = CompToCheck.LeftLink
                                    Else
                                        NextReferenceGUID = CompToCheck.LeftAltLink
                                    End If
                                Else
                                    If CompToCheck.ControlledReverse Then
                                        NextReferenceGUID = CompToCheck.LeftLink
                                    Else
                                        NextReferenceGUID = CompToCheck.LeftAltLink
                                    End If
                                End If

                            ElseIf LastReferenceGUID = CompToCheck.LeftLink And SearchRight Then
                                If Not CompToCheck.FlipOperations Then
                                    If CompToCheck.ControlledReverse Then
                                        Return Nothing
                                    Else
                                        NextReferenceGUID = CompToCheck.RightLink
                                    End If
                                Else
                                    If Not CompToCheck.ControlledReverse Then
                                        Return Nothing
                                    Else
                                        NextReferenceGUID = CompToCheck.RightLink
                                    End If
                                End If
                            ElseIf LastReferenceGUID = CompToCheck.LeftAltLink And SearchRight Then
                                If Not CompToCheck.FlipOperations Then
                                    If Not CompToCheck.ControlledReverse Then
                                        Return Nothing
                                    Else
                                        NextReferenceGUID = CompToCheck.RightLink
                                    End If
                                Else
                                    If CompToCheck.ControlledReverse Then
                                        Return Nothing
                                    Else
                                        NextReferenceGUID = CompToCheck.RightLink
                                    End If
                                End If
                            ElseIf LastReferenceGUID = CompToCheck.RightLink And Not SearchRight Then
                                If Not CompToCheck.FlipOperations Then
                                    If CompToCheck.ControlledReverse Then
                                        Return Nothing
                                    Else
                                        NextReferenceGUID = CompToCheck.LeftLink
                                    End If
                                Else
                                    If Not CompToCheck.ControlledReverse Then
                                        Return Nothing
                                    Else
                                        NextReferenceGUID = CompToCheck.LeftLink
                                    End If
                                End If

                            ElseIf LastReferenceGUID = CompToCheck.RightAltLink And Not SearchRight Then

                                If Not CompToCheck.FlipOperations Then
                                    If Not CompToCheck.ControlledReverse Then
                                        Return Nothing
                                    Else
                                        NextReferenceGUID = CompToCheck.LeftLink
                                    End If
                                Else
                                    If CompToCheck.ControlledReverse Then
                                        Return Nothing
                                    Else
                                        NextReferenceGUID = CompToCheck.LeftLink
                                    End If
                                End If
                            End If

                            'if component passes the validation test, then add it to the collection
                            If Not SignalRoute.Contains(CompToCheck) Then
                                SignalRoute.Add(CompToCheck)
                            End If
                        Case "TMDS.SignalComponents.Signal"

                            If Not FlipFlopFound Then
                                'if same direction signal found, then end of route found
                                If CompToCheck.DefaultTraffic = Sig.DefaultTraffic Then
                                    ExitSignal = CompToCheck
                                    Return SignalRoute
                                End If
                            Else
                                'if same direction signal found, then end of route found
                                If CompToCheck.DefaultTraffic <> Sig.DefaultTraffic Then
                                    ExitSignal = CompToCheck
                                    Return SignalRoute
                                End If
                            End If
                            'setup the next component to validate
                            LastReferenceGUID = CompToCheck.GUID
                            If SearchRight Then
                                NextReferenceGUID = CompToCheck.RightLink
                            Else
                                NextReferenceGUID = CompToCheck.LeftLink
                            End If

