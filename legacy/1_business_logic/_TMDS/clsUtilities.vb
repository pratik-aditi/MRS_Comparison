        Public Shared Sub RefreshSubBulletins()
            Try
                BulletinCollection.Clear()
                Dim trk As Track
                For Each trk In TrackCollection
                    trk.HatchItSpeed = False
                    trk.HatchItWorkZone = False
                    trk.HatchItInformational = False
                    trk.HatchItFormO = False
                    trk.Bulletins.Clear()
                    trk.RefreshRemotely()
                Next
                Dim sw As Switch
                For Each sw In SwitchCollection
                    sw.HatchItSpeed = False
                    sw.HatchItWorkZone = False
                    sw.HatchItInformational = False
                    sw.HatchItFormO = False
                    sw.Bulletins.Clear()
                    sw.RefreshRemotely()
                Next
                Dim sbdvn As Subdivision
                For Each sbdvn In ControlledSubdivisions
                    RemoveSubBulletinsFromSubdivision(sbdvn.Abbreviation)
                Next

                For Each sbdvn In ControlledSubdivisions
                    TMDS.NetworkMessages.CadMessages.RequestBulletinsForSubdivision(sbdvn.Abbreviation, gCadTransmitQueue)
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

