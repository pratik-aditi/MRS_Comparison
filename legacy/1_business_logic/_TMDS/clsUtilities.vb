        ''' <summary>
        ''' Generic Function to return a list of records from the dynamic database based upon the passed SQL Query.
        ''' Returns a DataTable representing a logical separation of the Data Access from the Business Layer.
        ''' </summary>
        ''' <param name="sqlQuery">The string to query the database.</param>
        ''' <returns>Datatable with the records.</returns>
        ''' <remarks>WGROH:  Added for KCS Bulletin Filter</remarks>
        Public Shared Function GetDynamicSQLData(ByVal sqlQuery As String) As DataTable
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim table As New DataTable
            Dim row As DataRow
            Dim isFirstRecord As Boolean = True

            Try
                ' If gConnectionStringDynamic is Nothing then 
                Using dbConn As New OleDbConnection(gConnectionStringDynamic)
                    dbConn.Open()
                    dbcomm = New OleDbCommand(sqlQuery, dbConn)
                    dr = dbcomm.ExecuteReader
                    If dr.HasRows Then
                        While dr.Read()
                            If isFirstRecord Then
                                For i As Integer = 0 To dr.FieldCount - 1
                                    table.Columns.Add(dr.GetName(i), dr.GetFieldType(i))
                                Next
                            End If
                            row = table.NewRow
                            For i As Integer = 0 To dr.FieldCount - 1
                                row(i) = dr.GetValue(i)
                            Next
                            table.Rows.Add(row)
                            isFirstRecord = False
                        End While
                        dr.Close()
                    End If

                    dbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try

            Return table
        End Function

