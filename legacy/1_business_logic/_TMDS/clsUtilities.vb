        Public Shared Function FindMyPSSExitSignal(ByVal SearchDirection As String, ByVal ExitTrack As Track) As Signal
            Dim NextComp As Object = Nothing
            Try
                Select Case SearchDirection.Trim.ToUpper
                    Case "RIGHT", "R", "D"
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitTrack.RightLink)
                        For i As Integer = 0 To 10
                            If NextComp Is Nothing Then Return Nothing
                            Select Case NextComp.GetType.ToString
                                Case gSignalComponentName
                                    If NextComp.ComponentType = "R" Or NextComp.ComponentType = "D" Then
                                        Return NextComp
                                    End If
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                Case Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End Select
                        Next
                    Case Else
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitTrack.LeftLink)
                        For i As Integer = 0 To 10
                            If NextComp Is Nothing Then Return Nothing
                            Select Case NextComp.GetType.ToString
                                Case gSignalComponentName
                                    If NextComp.ComponentType = "R" Or NextComp.ComponentType = "D" Then
                                        Return NextComp
                                    End If
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                Case Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End Select
                        Next
                End Select


                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                NextComp = Nothing
            End Try
        End Function

        Public Shared Function FindSignalRoute(ByVal EntrySignal As Signal, ByRef ExitSignal As Signal) As SignalRoute
            Try
                Dim sr As SignalRoute
                For Each sr In gSignalRouteList
                    If sr.EntrySignal.GUID = EntrySignal.GUID AndAlso sr.ExitSignal.GUID = ExitSignal.GUID Then
                        Return sr
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindStoredRoute(ByVal RouteGUID As String) As StoredRoute
            Dim cp As ControlPoint
            Dim Sr As StoredRoute
            Try
                For Each cp In TMDS.GlobalDeclarations.gControlPointCollection
                    If cp IsNot Nothing AndAlso cp.StoredRoutes IsNot Nothing AndAlso cp.StoredRoutes.Count > 0 Then
                        For Each Sr In cp.StoredRoutes
                            If Sr.RouteGUID = RouteGUID Then Return Sr
                        Next
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

