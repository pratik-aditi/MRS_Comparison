                    .Append("  [TrainSymbol]='" & TGBOIssuedTo & "' AND [CancelledBulletinGUID]='" & BULLGUID & "'")
                End With
                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    dbcomm = New OleDbCommand(Query.ToString, DbConn)
                    dr = dbcomm.ExecuteReader
                    If dr.HasRows Then
                        Return True
                    Else
                        dr.Close()
                        dr = Nothing
                        dbcomm = New OleDbCommand(QueryInactive.ToString, DbConn)
                        dr = dbcomm.ExecuteReader
                        If dr.HasRows Then
                            Return True
                        Else
                            Return False
                        End If
                    End If
                    dr.Close()
                    DbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                dr = Nothing
                Query = Nothing
                QueryInactive = Nothing
            End Try


            Return False
        End Function

#Region " MILEAGE RANGE FUNCTIONS "
        Public Shared Function FindMileageRange(ByVal MilePost As String, ByVal Prefix As String, ByVal Suffix As String, Optional ByVal SubUID As Integer = 0) As MileageRange

            Dim mr As MileageRange
            Try
                For Each mr In TMDS.GlobalDeclarations.gMileageRangeList
                    If mr.LeftMileagePrefix = Prefix AndAlso mr.LeftMileageSuffix = Suffix Then
                        If (mr.LeftMileage >= CDec(MilePost) And mr.RightMileage <= CDec(MilePost)) OrElse (mr.LeftMileage <= CDec(MilePost) And mr.RightMileage >= CDec(MilePost)) Then
                            Return mr
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindMileageRangeByUID(ByVal MRUID As String) As MileageRange
            Dim mr As MileageRange
            Try
                If String.IsNullOrEmpty(MRUID) Then Return Nothing
                If MRUID.Trim = "" Then Return Nothing
                For Each mr In TMDS.GlobalDeclarations.gMileageRangeList
                    If mr.myUID.Trim.ToUpper = MRUID.Trim.ToUpper Then
                        Return mr
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

