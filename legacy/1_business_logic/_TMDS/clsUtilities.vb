        Public Shared Function GetDateTimeVerbiage(ByVal FromDate As Date, ByVal ToDate As Date, ByVal UseOnlyFromDate As Boolean, ByVal IsDailyWrkZoneTB As Boolean) As ArrayList
            Dim ReturnArr As New ArrayList
            Dim strEffectiveDateTime As String
            Try
                strEffectiveDateTime = ""
                Dim FormatedFromTime As String = Format(FromDate, "HHmm")
                Dim FormatedToTime As String = Format(ToDate, "HHmm")
                Dim Fromdatestring As String = ""
                Dim Todatestring As String = ""
                Dim sFromDtTime As String = ""
                Dim sToDtTime As String = ""
                Dim HasFromDateTime As Boolean = False
                Dim HasToDateTime As Boolean = False
                Dim HasToDiffDay As Boolean = False
                Dim HasToDiffYear As Boolean = False
                Dim HasToDiffMonth As Boolean = False
                Dim HasFromnToDateTime As Boolean = False
                Dim dateEffectiveDateTimestring As String = ""

                Select Case FormatedFromTime.Trim.ToUpper
                    Case "HHMM", ""
                        Return Nothing
                    Case Else
                        HasFromDateTime = True
                        Try
                            strEffectiveDateTime = Format(CDate(FromDate), "MM-dd-yyyy HH:mm")
                        Catch ex As Exception
                            GetErrorDetails(ex)
                        End Try

                End Select
                Select Case FormatedToTime.Trim.ToUpper
                    Case "HHMM", ""
                    Case Else
                        HasToDateTime = True
                End Select
                If HasFromDateTime And HasToDateTime Then HasFromnToDateTime = True

                If HasFromnToDateTime Then
                    If FromDate.Day <> ToDate.Day Then HasToDiffDay = True
                    If FromDate.Year <> ToDate.Year Then HasToDiffYear = True
                    If FromDate.Month <> ToDate.Month Then HasToDiffMonth = True
                End If

                If IsDailyWrkZoneTB Then
                    ReturnArr.Add("Effective " & Format(FromDate, "MMMM d "))
                    ReturnArr.Add("Daily From " & FormatedFromTime & " Until " & FormatedToTime)
                ElseIf UseOnlyFromDate Then
                    ReturnArr.Add("Effective " & Format(FromDate, "MMMM d ") & " From " & FormatedFromTime)
                ElseIf HasFromnToDateTime AndAlso (HasToDiffDay Or HasToDiffYear Or HasToDiffMonth) Then
                    If HasToDiffYear Then
                        ReturnArr.Add("On " & Format(FromDate, "MMMM d yyyy") & " From " & FormatedFromTime)
                        ReturnArr.Add("Until " & Format(ToDate, "MMMM d yyyy") & " At " & FormatedToTime)

                    Else
                        ReturnArr.Add("On " & Format(FromDate, "MMMM d ") & " From " & FormatedFromTime)
                        ReturnArr.Add("Until " & Format(ToDate, "MMMM d ") & " At " & FormatedToTime)
                    End If
                Else
                    If Not HasFromnToDateTime Then
                        ReturnArr.Add("Effective " & Format(FromDate, "MMMM d ") & " From " & FormatedFromTime)
                    ElseIf HasFromDateTime And HasToDateTime Then
                        ReturnArr.Add("On " & Format(FromDate, "MMMM d "))
                        ReturnArr.Add("From " & FormatedFromTime & " Until " & FormatedToTime)
                    End If
                End If
                Return ReturnArr
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try


        End Function

        Public Shared Function GetAllBulletinsUID(ByVal BulletinList As String) As ArrayList
            Dim BullUIDCollection As New ArrayList
            If BulletinList IsNot Nothing Then
                Dim BullStr() As String = BulletinList.Split("|")
                Dim TempS As String
                For Each TempS In BullStr
                    Dim SubSplit() As String = TempS.Split(";")
                    If SubSplit.GetUpperBound(0) > 0 Then
                        If Not BullUIDCollection.Contains(SubSplit(0)) Then BullUIDCollection.Add(SubSplit(0))
                    End If
                Next
            End If
            Return BullUIDCollection
        End Function

