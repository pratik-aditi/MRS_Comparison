                '    While Not OSTrackFound
                '        If ValidOSTrack.OStype Then Exit While
                '        Select Case trn.Direction
                '            Case optDirectionNorth
                '                ValidOSTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CurrentTrack.LeftLink)
                '            Case optDirectionSouth
                '                ValidOSTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CurrentTrack.RightLink)
                '        End Select
                '        LoopControl += 1
                '        If LoopControl > 10 Then
                '            Return False
                '        End If
                '    End While
                'Else
                '    NextTrack = CurrentTrack
                'End If

                If optEnableARRCSpecificOptions AndAlso ValidOSTrack IsNot Nothing Then
                    Dim UseTrackSelectedForOS As Boolean = True
                    If CurrentTrack.GUID <> ValidOSTrack.GUID AndAlso trn.OSPreviousTrack IsNot Nothing AndAlso trn.OSPreviousTrack.GUID <> ValidOSTrack.GUID Then
                        SW = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(ValidOSTrack)
                        If SW IsNot Nothing Then
                            UseTrackSelectedForOS = trn.CheckOSEventExists(SW.Name)
                        End If
                    End If
                    If UseTrackSelectedForOS Then
                        trn.OSPreviousControlPoint = CurrentTrack.myControlPoint
