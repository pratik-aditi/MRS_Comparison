        Public Shared Sub SystemNetworkException(message As String)
            Try
                If String.IsNullOrWhiteSpace(message) Then Exit Sub
                Using newEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.NetworkExceptionEvent,
                                                        message, SystemEventQueue)
