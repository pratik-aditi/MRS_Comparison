            'Dim QueryInactive As String = "SELECT SystemUID FROM tblSystemTabularGeneralBulletinExceptionInActive WHERE [TabularBulletinUID]='" & TGBOGUID & "' AND [BulletinUID]='" & BULLGUID & "'"
            Dim Query As New StringBuilder
