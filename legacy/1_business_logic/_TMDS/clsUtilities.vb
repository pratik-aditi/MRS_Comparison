        Public Shared Function FinalSystemTrain(ByVal trn As TrainID) As Boolean
            Dim DeleteQuery As New ArrayList
            Try
                DeleteQuery = CleanUpDatabaseRecords(trn)
                If DeleteQuery IsNot Nothing AndAlso DeleteQuery.Count > 0 AndAlso ExecuteQueryCollection(DeleteQuery, gConnectionStringDynamic) Then
                    Dim theDelete As New StringBuilder("DELETE FROM tblTrainPlanSchedule WHERE UID = '" & trn.TrainGUID & "'")
                    'RemovePlan Schedule
                    SystemDatabaseCommandToStatic("RemoveRestriction-theDelete", theDelete.ToString)
                    Return True
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function

        Private Shared Sub ReleaseTGBO(ByVal theTrain As TrainID)
            Try
                Dim myCurrentTGBO As TMDS.GeneralBulletins.TabularGeneralBulletin
                For Each myCurrentTGBO In gTabularGeneralBulletins
                    If myCurrentTGBO.IssuedTo = theTrain.Name AndAlso myCurrentTGBO.TypeOfBulletin = "TGBO-TRAIN" Then
                        If myCurrentTGBO.RemoveFromDatabase Then
                            SystemEvent("RemoveFromDatabase:Train=" & theTrain.Name & ":WhoCallMe=" & (New System.Diagnostics.StackTrace).GetFrame(1).GetMethod.Name)
                            myCurrentTGBO.RemoveExceptionsFromGBO()
                            myCurrentTGBO.RemoveTrainSpecificBulletins()
                            myCurrentTGBO.UnAssignFromTrain()
                            TMDS.NetworkMessages.TGBOMessages.SendDeleteTGBO(myCurrentTGBO, gBCMTransmitQueue)
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Private Shared Function CleanUpDatabaseRecords(ByVal train As TrainID) As ArrayList
            Dim DeleteQuery As New ArrayList
            Try

                If optEnableARRCSpecificOptions AndAlso train IsNot Nothing Then
                    If Not train.ValidateDataWareHouseValues(True) Then
                        Return Nothing
                    ElseIf train.TrainType = "YARD" Then
                        ReleaseTGBO(train)
                    End If
                End If

                If optEnableARRCSpecificOptions Then
                    train.UpdateFinalTime()
                End If

                Dim Query As String = "INSERT INTO tblTrainsInActive SELECT * FROM tblTrainsActive WHERE Symbol = " & "'" & train.Name & "'"
                DeleteQuery.Add(Query)
                Query = "DELETE FROM tblTrainsActive WHERE Symbol = " & "'" & train.Name & "'"
                DeleteQuery.Add(Query)

                Dim TrainSheetList As ArrayList = GetSubTrainSheets(train)
                If IsNothing(TrainSheetList) Then TrainSheetList = New ArrayList()
                If Not TrainSheetList.Contains(train.ActiveTrainSheetGUID) Then
                    TrainSheetList.Add(train.ActiveTrainSheetGUID)
                End If
                Dim TrainSheetGuid As String
                For Each TrainSheetGuid In TrainSheetList

                    Query = "INSERT INTO tblTrainsInActiveSubTrainSheets SELECT * FROM tblTrainsActiveSubTrainSheets WHERE ActiveSubTrainSheet = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)
                    Query = "DELETE FROM tblTrainsActiveSubTrainSheets WHERE ActiveSubTrainSheet = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)


                    Query = "INSERT INTO tblTrainOsEventsInActive SELECT * FROM tblTrainOsEventsActive WHERE TrainSheetGUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)
                    Query = "DELETE FROM tblTrainOsEventsActive WHERE TrainSheetGUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)


                    Query = "INSERT INTO tblTrainEventInActiveComments SELECT * FROM tblTrainEventActiveComments WHERE TrainSheetUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)
                    Query = "DELETE FROM tblTrainEventActiveComments WHERE TrainSheetUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)


                    Query = "INSERT INTO tblTrainEventInActiveDelays SELECT * FROM tblTrainEventActiveDelays WHERE TrainSheetUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)
                    Query = "DELETE FROM tblTrainEventActiveDelays WHERE TrainSheetUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)

                    Query = "INSERT INTO tblTrainEventInActiveOther SELECT * FROM tblTrainEventActiveOther WHERE TrainSheetUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)
                    Query = "DELETE FROM tblTrainEventActiveOther WHERE TrainSheetUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)

                    Query = "INSERT INTO tblTrainEventInActiveMovements SELECT * FROM tblTrainEventActiveMovements WHERE TrainSheetUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)
                    Query = "DELETE FROM tblTrainEventActiveMovements WHERE TrainSheetUID = " & "'" & TrainSheetGuid & "'"
                    DeleteQuery.Add(Query)

                Next

                'Remove Restriction
                Dim theMove As New StringBuilder("INSERT INTO tblTrainEventInActiveRestrictions  SELECT * FROM tblTrainEventActiveRestrictions WHERE EntityGUID ='" & train.TrainGUID & "'")
                Dim theDelete As New StringBuilder("DELETE FROM tblTrainEventActiveRestrictions WHERE EntityGUID ='" & train.TrainGUID & "'")
                With DeleteQuery
                    .Add(theMove.ToString)
                    .Add(theDelete.ToString)
                End With

                'Remove WorkOrders
                Query = "INSERT INTO tblTrainEventInActiveWorkOrders  SELECT * FROM tblTrainEventActiveWorkOrders WHERE EntityGUID = '" & train.TrainGUID & "'"
                DeleteQuery.Add(Query)
                Query = "DELETE FROM tblTrainEventActiveWorkOrders WHERE EntityGUID = '" & train.TrainGUID & "'"
                DeleteQuery.Add(Query)

                'Remove Consist
                Query = "INSERT INTO tblTrainConsistInActive  SELECT * FROM tblTrainConsistActive WHERE TrainGUID = '" & train.TrainGUID & "'"
                DeleteQuery.Add(Query)
                Query = "DELETE FROM tblTrainConsistActive WHERE TrainGUID = '" & train.TrainGUID & "'"
                DeleteQuery.Add(Query)

                'Remove WorkTask
                Query = "INSERT INTO [tblSystemWorkTasksInActive]  SELECT * FROM [tblSystemWorkTasksActive] WHERE EntityGUID ='" & train.TrainGUID & "'"
                DeleteQuery.Add(Query)
                Query = "DELETE FROM [tblSystemWorkTasksActive] WHERE EntityGUID ='" & train.TrainGUID & "'"
                DeleteQuery.Add(Query)

                Query = "INSERT INTO tblPlanningTacticalRoutesInActive SELECT * FROM tblPlanningTacticalRoutesActive WHERE TrainSymbol = '" & train.Name & "'"
                DeleteQuery.Add(Query)
                Query = "DELETE FROM tblPlanningTacticalRoutesActive WHERE TrainSymbol = '" & train.Name & "'"
                DeleteQuery.Add(Query)

                'ARS-174
                Query = "INSERT INTO tblPlanningMovementPlansInActive SELECT * FROM tblPlanningMovementPlansActive WHERE TrainSymbol = '" & train.Name & "'"
                DeleteQuery.Add(Query)
                Query = "DELETE FROM tblPlanningMovementPlansActive WHERE TrainSymbol = '" & train.Name & "'"
                DeleteQuery.Add(Query)

                Return DeleteQuery


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        Public Shared Function GetSubTrainSheets(ByVal trn As TrainID) As ArrayList
            Dim dbconn As OleDbConnection
            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                Dim dbcomm As New OleDbCommand("Select ActiveSubTrainSheet FROM tblTrainsActiveSubTrainSheets WHERE symbol = '" & trn.Name & "'", dbconn)
                Dim SubList As New ArrayList()
                Dim dr As OleDbDataReader
                dbconn.Open()
                dr = dbcomm.ExecuteReader
                While dr.Read
                    If Not dr.IsDBNull(0) Then
                        SubList.Add(dr.GetString(0))
                    End If
                End While
                dbconn.Close()
                dbconn = Nothing
                Return SubList
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return Nothing
            End Try
        End Function

        Public Shared Function IsBulletinExceptionDelivered(ByVal TGBOUID As String, BulletinUID As String) As Boolean
            Dim query As String = "  SELECT [SystemUID] FROM [tblSystemTabularGeneralBulletinExceptionInactive] WHERE TabularBulletinUID='" & TGBOUID & "' AND  [BulletinUID]='" & BulletinUID & "'"
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Try
                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(query, DbConn)
                    dr = dbComm.ExecuteReader
                    If dr.HasRows Then Return True
                    dr.Close()
                    DbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                dr = Nothing
            End Try
        End Function

        Public Shared Function CheckIfTrainExists(trnToCheck As TrainID) As Boolean
            Dim tmpTrn As TrainID = Nothing
            Try
                If trnToCheck Is Nothing Then Return False
                If TrainCollection Is Nothing Then Return False
                If TrainCollection.Count = 0 Then Return False
                For Each tmpTrn In TrainCollection
                    If tmpTrn.TrainGUID = trnToCheck.TrainGUID Then Return True
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function

    End Class
