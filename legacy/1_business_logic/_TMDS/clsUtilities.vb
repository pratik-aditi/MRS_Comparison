    Public Class RemoteCommands

        Public Shared Function PerformRemoteLogOn(ByVal LogonNameString As String) As Boolean

            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDb.OleDbDataReader = Nothing
            Dim dbconn As OleDbConnection = Nothing
            Try
                Dim I As Integer
                Dim DispName(2) As String
                Dim sTemp As String = String.Empty
                Dim ch As String

                For I = 1 To Len(LogonNameString)
                    ch = Mid(LogonNameString, I, 1)
                    If ch <> "," And ch <> "{" Then
                        sTemp = sTemp & ch
                    ElseIf ch = "{" Then
                        DispName(1) = Trim(sTemp)
                        DispName(2) = Mid(LogonNameString, I + 1, 3)
                    ElseIf ch = "," Then
                        DispName(0) = sTemp
                        sTemp = ""
                    End If
                Next

                Dim Query As String = "SELECT UID, PIN, UseType FROM " & gtblUsers & " WHERE (FirstName = '" & DispName(1) & "') AND (LastName = '" & DispName(0) & "')"
                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                dbcomm = New OleDbCommand(Query, dbconn)
                dr = dbcomm.ExecuteReader()
                While dr.Read()
                    If Not dr.IsDBNull(0) Then gCurrentUser.UserGUID = dr.GetString(0)
                    If Not dr.IsDBNull(1) Then gCurrentUser.PIN = dr.GetString(1)
                    If Not dr.IsDBNull(2) Then gCurrentUser.UserType = dr.GetString(2)
                    Exit While
                End While
                dr.Close()
                dbconn.Close()
                dbconn = Nothing
                gCurrentUser.FirstName = DispName(1)
                gCurrentUser.LastName = DispName(0)
                gCurrentUser.Initials = DispName(2)
                gCurrentUser.Initials = gCurrentUser.Initials.Replace("}", "")
                If optUseFirstLastNameFormat Then
                    gCurrentUser.UserFullName = gCurrentUser.FirstName & ", " & gCurrentUser.LastName & " {" & gCurrentUser.Initials & "}"
                Else
                    gCurrentUser.UserFullName = gCurrentUser.LastName & ", " & gCurrentUser.FirstName & " {" & gCurrentUser.Initials & "}"
                End If

                TMDS.NetworkMessages.CadMessages.SendUserLogonMessageToCAD(gCurrentUser, gCadTransmitQueue)
                TMDS.NetworkMessages.CadMessages.SendUserLogonMessage(gCurrentUser, gCadTransmitQueue)

                gPreviousDispatcher = LogonNameString

                Dim rc As New RemoteCommand("UpdateDispatcherLoginDisplay", Nothing, Nothing)
                gSystemManagementServiceMessageQueue.Enqueue(rc)

                TMDS.SystemUtilities.UtilitiesDisplayForm.DoLogin(True)
                gSystemLoggedIn = True
                If (gPreviousDispatcherEvent = "LOGOFF" Or gPreviousDispatcherEvent = "TRANSFER") And gSystemLoggedIn Then
                    gCurrentUser.LogDispatcherEvent("ONDUTY", ControlledTerritories)
                End If
                TMDS.NetworkMessages.CadMessages.SendAssociateUserToMachine()
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return False
            End Try

        End Function

