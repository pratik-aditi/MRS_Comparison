        Public Shared Sub SortSwitchesByMilePost(ByRef mySwitchCollection As ArrayList, Optional ByVal SortAscending As Boolean = True)
            Dim sw As Switch = Nothing
            Dim tempSwitchArray As New ArrayList
            Dim TempDt As New DataTable
            Dim dvSW As New DataView
            Dim col1 As DataColumn
            Dim MilePost As Double = 0
            Try
                If mySwitchCollection Is Nothing Then Exit Sub
                If mySwitchCollection.Count = 0 Then Exit Sub
                col1 = New DataColumn("SWGUID")
                col1.DataType = System.Type.GetType("System.String")
                TempDt.Columns.Add(col1)

                col1 = New DataColumn("MilePost")
                col1.DataType = System.Type.GetType("System.Double")
                col1.DefaultValue = 0
                TempDt.Columns.Add(col1)

                For Each sw In mySwitchCollection
                    MilePost = 0
                    Dim drow As DataRow = TempDt.NewRow
                    Double.TryParse(sw.MilePost, MilePost)
                    drow("SWGUID") = sw.GUID
                    drow("MilePost") = MilePost
                    TempDt.Rows.Add(drow)
                    TempDt.AcceptChanges()
                Next

                If TempDt IsNot Nothing AndAlso TempDt.Rows.Count > 0 Then
                    dvSW = New DataView(TempDt)
                    dvSW.RowFilter = ""
                    If SortAscending Then
                        dvSW.Sort = "MilePost"
                    Else
                        dvSW.Sort = "MilePost DESC"
                    End If
                    If dvSW IsNot Nothing AndAlso dvSW.Count > 0 Then
                        Dim SwUID As Integer = 0
                        For i As Integer = 0 To dvSW.Count - 1
                            SwUID = 0
                            sw = Nothing
                            Integer.TryParse(dvSW(i)("SWGUID"), SwUID)
                            If SwUID > 0 Then
                                sw = FindCompFromGUID(SwUID)
                                If Not tempSwitchArray.Contains(sw) Then tempSwitchArray.Add(sw)
                            End If
                        Next
                    End If
                End If
                If tempSwitchArray IsNot Nothing AndAlso tempSwitchArray.Count > 0 Then
                    CopyArrayCollection(mySwitchCollection, tempSwitchArray)
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                TempDt = Nothing
                dvSW = Nothing
                tempSwitchArray = Nothing
                sw = Nothing
            End Try

        End Sub

        Public Shared Function FindSwitchFromSidingTrackBasedOnDirection(ByVal SidingTrack As Track, ByVal SearchDirection As String) As Switch
            Dim comp As Object = Nothing
            Try
                If IsNothing(SidingTrack) Then Return Nothing
                If String.IsNullOrEmpty(SearchDirection.Trim) Then Return Nothing
                Select Case SearchDirection.ToUpper.Trim
                    Case "RIGHT", "R"
                        comp = FindCompFromGUID(SidingTrack.RightLink)
                    Case "LEFT", "L"
                        comp = FindCompFromGUID(SidingTrack.LeftLink)
                End Select

                For i As Integer = 0 To 5
                    If comp.GetType.ToString = gTrackComponentName AndAlso comp.OsComponentCollection IsNot Nothing AndAlso comp.OsComponentCollection.Count > 0 Then
                        Return FindSwitchFromOSList(comp)
                    Else
                        Select Case SearchDirection.ToUpper.Trim
                            Case "RIGHT", "R"
                                comp = FindCompFromGUID(comp.RightLink)
                            Case "LEFT", "L"
                                comp = FindCompFromGUID(comp.LeftLink)
                        End Select
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindSwitchFromSidingTrack(ByVal SidingTrack As Track, ByVal SearchDirection As String, ByVal BeginningOfRoute As Boolean) As Switch
            Dim comp As Object = Nothing
            Try
                If IsNothing(SidingTrack) Then Return Nothing
                If String.IsNullOrEmpty(SearchDirection.Trim) Then Return Nothing
                Select Case SearchDirection.ToUpper.Trim
                    Case "RIGHT", "R"
                        If BeginningOfRoute Then
                            comp = FindCompFromGUID(SidingTrack.RightLink)
                        Else
                            comp = FindCompFromGUID(SidingTrack.LeftLink)
                        End If
                    Case "LEFT", "L"
                        If BeginningOfRoute Then
                            comp = FindCompFromGUID(SidingTrack.LeftLink)
                        Else
                            comp = FindCompFromGUID(SidingTrack.RightLink)
                        End If

                End Select

                For i As Integer = 0 To 5
                    If comp.GetType.ToString = gTrackComponentName AndAlso comp.OsComponentCollection IsNot Nothing AndAlso comp.OsComponentCollection.Count > 0 Then
                        Return FindSwitchFromOSList(comp)
                    Else
                        Select Case SearchDirection.ToUpper.Trim
                            Case "RIGHT", "R"
                                If BeginningOfRoute Then
                                    comp = FindCompFromGUID(comp.RightLink)
                                Else
                                    comp = FindCompFromGUID(comp.LeftLink)
                                End If

                            Case "LEFT", "L"
                                If BeginningOfRoute Then
                                    comp = FindCompFromGUID(comp.LeftLink)
                                Else
                                    comp = FindCompFromGUID(comp.RightLink)
                                End If

                        End Select
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindSidingTrackFromSwitch(ByVal theSw As Switch, Optional theDirection As String = Nothing) As Track
            Try
                Dim NextComp As Object = Nothing
                Dim DirectionToSearch As String = "RIGHT"
                If theSw.RightAltLink <> 0 Then
                    NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(theSw.RightAltLink)
                Else
                    NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(theSw.LeftAltLink)
                    DirectionToSearch = "LEFT"
                End If
                Dim LoopControl As Integer
                Select Case DirectionToSearch
                    Case "RIGHT"
                        Do
                            If IsNothing(NextComp) Then Exit Do
                            If NextComp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(NextComp, Track)
                                If trk.EnableControlledSiding Then
                                    Return trk
                                End If
                            End If
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            LoopControl += 1
                            If LoopControl >= 10 Then
                                Exit Do
                            End If
                        Loop
                    Case "LEFT"
                        Do
                            If IsNothing(NextComp) Then Exit Do
                            If NextComp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(NextComp, Track)
                                If trk.EnableControlledSiding Then
                                    Return trk
                                End If
                            End If
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)

                            LoopControl += 1
                            If LoopControl >= 10 Then
                                Exit Do
                            End If
                        Loop

                End Select


                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindFirstTrackFromSwitch(ByVal TheSwitch As Switch, ByVal SearchDirection As String) As Track
            Dim OsTrackFound As Boolean = False
            Dim Comp As Object = Nothing
            Dim ReturnTrack As Track = Nothing
            Dim LastComp As Track = Nothing
            Try

                Select Case SearchDirection.Trim.ToUpper
                    Case "LEFT"
                        If TheSwitch.ControlledReverse AndAlso TheSwitch.LeftAltLink <> 0 Then
                            Comp = FindCompFromGUID(TheSwitch.LeftAltLink)
                        Else
                            Comp = FindCompFromGUID(TheSwitch.LeftLink)
                        End If

                        For i As Integer = 1 To 20
                            If Comp Is Nothing Then Return Nothing
                            If TheSwitch.OsComponentCollection IsNot Nothing AndAlso TheSwitch.OsComponentCollection.Count > 0 Then
                                If TheSwitch.OsComponentCollection.Contains(Comp) Then
                                    If Comp.GetType.ToString = gTrackComponentName Then
                                        LastComp = Comp
                                    End If
                                    Comp = FindCompFromGUID(Comp.LeftLink)

                                ElseIf Comp.GetType.ToString = gTrackComponentName AndAlso Not TheSwitch.OsComponentCollection.Contains(Comp) Then
                                    ReturnTrack = LastComp
                                    Exit For
                                Else
                                    Comp = FindCompFromGUID(Comp.LeftLink)
                                End If
                            End If
                        Next
                    Case "RIGHT"
                        If TheSwitch.ControlledReverse AndAlso TheSwitch.RightAltLink <> 0 Then
                            Comp = FindCompFromGUID(TheSwitch.RightAltLink)
                        Else
                            Comp = FindCompFromGUID(TheSwitch.RightLink)
                        End If

                        For i As Integer = 1 To 20
                            If Comp Is Nothing Then Return Nothing
                            If TheSwitch.OsComponentCollection IsNot Nothing AndAlso TheSwitch.OsComponentCollection.Count > 0 Then
                                If TheSwitch.OsComponentCollection.Contains(Comp) Then
                                    Comp = FindCompFromGUID(Comp.RightLink)
                                ElseIf Comp.GetType.ToString = gTrackComponentName AndAlso Not TheSwitch.OsComponentCollection.Contains(Comp) Then
                                    ReturnTrack = Comp
                                    Exit For
                                Else
                                    Comp = FindCompFromGUID(Comp.RightLink)
                                End If
                            End If
                        Next
                End Select
                Comp = Nothing
                Return ReturnTrack

            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindSwitchesFromOSList(ByVal OsTrack As Track) As ArrayList
            Dim tmpSWCollection As New ArrayList
            Try
                If IsNothing(OsTrack) Then Return Nothing
                If IsNothing(OsTrack.OsComponentCollection) Then Return Nothing
