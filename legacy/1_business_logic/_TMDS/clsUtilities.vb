                    p.SetValue(m_obj, info.GetDouble(p.Name), Nothing)
                ElseIf p.PropertyType Is GetType(String) Then
                    p.SetValue(m_obj, info.GetString(p.Name), Nothing)
                    ' ignore for now
                Else
                End If
            Next
