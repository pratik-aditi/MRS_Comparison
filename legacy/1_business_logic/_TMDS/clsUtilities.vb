        Public Shared Function FindTrackFromPTCBlockAndMilepost(ByVal BlockUID As String) As Track

            Try
                Dim data() As String = BlockUID.Split("|")
                Dim BlkUID As Int32 = CInt(data(0))
                Dim Milepost As Double = CDbl(data(1))
                Dim trk As Track
                For Each trk In TrackCollection
                    If trk.PTCBlockID = BlkUID Then
                        If (trk.LeftLimitMilePost >= Milepost And trk.RightLimitMilePost <= Milepost) Or (trk.LeftLimitMilePost <= Milepost And trk.RightLimitMilePost >= Milepost) Then
                            Return trk
                        End If
                    End If
                Next


                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindTrackCompFromMilePost(ByVal TrackGUID As Integer, ByVal Milepost As Decimal, ByVal MilePostSuffix As String) As Object
            'This function finds the current trackcomponent using Milepost
            Dim trk As Track
            Dim comp As Object
            Try

                For Each trk In TrackCollection
                    If trk.GUID = TrackGUID Then
                        If (trk.LeftLimitMilePost >= Milepost And trk.RightLimitMilePost <= Milepost) Or (trk.LeftLimitMilePost <= Milepost And trk.RightLimitMilePost >= Milepost) Then
                            Return trk
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                trk = Nothing
                comp = Nothing
            End Try
        End Function

        Public Shared Function FindTrackFromMilePost(ByVal Milepost As Decimal, ByVal MilePostSuffix As String, Optional TrackNameAlias As String = Nothing) As Object
            'This function finds the current trackcomponent using Milepost
            Dim trk As Track
            Dim comp As Object
            Dim UseTrackNameAlias As Boolean
            If Not String.IsNullOrEmpty(TrackNameAlias) Then UseTrackNameAlias = True
            Try
                If Milepost = 0 Then Return Nothing
                For Each trk In TrackCollection
                    'If (trk.LeftLimitMilePost >= Milepost And trk.RightLimitMilePost <= Milepost) Or (trk.LeftLimitMilePost <= Milepost And trk.RightLimitMilePost >= Milepost) Then
                    '    Return trk
                    'End If
                    If trk.LeftLimitMilePost = 0 AndAlso trk.RightLimitMilePost = 0 Then
                        'SystemEvent("BAD MILEPOST FOUND: " & trk.GUID)
                    Else
                        Dim MileageDifference As Int32 = 0

                        If trk.LeftLimitMilePost > trk.RightLimitMilePost Then
                            MileageDifference = trk.LeftLimitMilePost - trk.RightLimitMilePost
                        Else
                            MileageDifference = trk.RightLimitMilePost - trk.LeftLimitMilePost
                        End If
                        Dim NameMatch As Boolean = True
                        If UseTrackNameAlias AndAlso trk.TrackNameAlias.ToUpper <> TrackNameAlias.ToUpper Then
                            NameMatch = False
                        End If

                        If MileageDifference < 20 AndAlso NameMatch Then
                            If BetweenNumbers(Milepost, trk.LeftLimitMilePost, trk.RightLimitMilePost) Then
                                Return trk
                            End If
                        End If
                    End If

                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                trk = Nothing
                comp = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Find track from milepost PreFix and Suffix
        ''' </summary>
        ''' <param name="milepost">milepost in question</param>
        ''' <param name="milePostSuffix">suffix milepost</param>
        ''' <param name="milePostPrefix">prefix milepost</param>
        ''' <param name="trackName">track name in question</param>
        ''' <param name="returnSidingTrackOnly">return especific type of track</param>
        ''' <param name="usePTCTrackName">use PTC track name</param>
        ''' <param name="subdivisionPTCUID">subdivision in question</param>
        ''' <returns>returns the found track object</returns>
        Public Shared Function FindTrackFromMilePost_PreFixSuffix(milepost As Decimal,
                                                                  milePostSuffix As String,
                                                                  milePostPrefix As String,
                                                                  trackName As String,
                                                                  returnSidingTrackOnly As Boolean,
                                                                  Optional usePTCTrackName As Boolean = False,
                                                                  Optional subdivisionPTCUID As Integer = 0) As Object
            Try
                Dim theTrack As Track = Nothing
                Dim hasPreFix As Boolean = Not milePostSuffix.IsNullOrWhiteSpace OrElse
                            Not milePostPrefix.IsNullOrWhiteSpace
                For Each oneTrack As Track In TrackCollection
                    Dim TPre As String = String.Empty
                    Dim TSuf As String = String.Empty
                    If Not oneTrack.MilePostPrefix.IsNullOrWhiteSpace Then TPre = oneTrack.MilePostPrefix
                    If Not oneTrack.MilePostSuffix.IsNullOrWhiteSpace Then TSuf = oneTrack.MilePostSuffix
                    If BetweenNumbers(milepost, oneTrack.LeftLimitMilePost, oneTrack.RightLimitMilePost) AndAlso
                        (TPre.Trim.EqualsIgnoreCase(milePostPrefix.Trim) AndAlso
                        TSuf.Trim.EqualsIgnoreCase(milePostSuffix.Trim)) Then
                        Dim ignoreSubdivisionUID As Boolean = False
                        Dim subdivisionFound As Boolean = False
                        If subdivisionPTCUID = 0 Then
                            ignoreSubdivisionUID = True
                        ElseIf oneTrack.mySubdivision IsNot Nothing AndAlso
                            subdivisionPTCUID = oneTrack.mySubdivision.PTCUID Then
                            subdivisionFound = True
                        End If
                        If ignoreSubdivisionUID OrElse subdivisionFound Then
                            If returnSidingTrackOnly Then
                                If trackName.EqualsIgnoreCase("SIDING") Then
                                    theTrack = oneTrack
                                End If
                            ElseIf usePTCTrackName Then
                                If Not trackName.IsNullOrWhiteSpace AndAlso
                                    oneTrack.TrackNameAlias.Trim.EqualsIgnoreCase(trackName.Trim) Then
                                    theTrack = oneTrack
                                End If
                            Else
                                If Not trackName.IsNullOrWhiteSpace AndAlso
                                    oneTrack.TrackName.Trim.EqualsIgnoreCase(trackName.Trim) Then
                                    theTrack = oneTrack
                                ElseIf trackName.IsNullOrWhiteSpace Then
                                    theTrack = oneTrack
                                End If
                            End If
                        End If
                    End If
                    If theTrack IsNot Nothing Then
                        If theTrack.LeftLimitMilePost = 0 AndAlso
                            theTrack.RightLimitMilePost = 0 AndAlso
                            usePTCTrackName AndAlso
                            Not trackName.IsNullOrWhiteSpace AndAlso
                            oneTrack.TrackNameAlias.Trim.EqualsIgnoreCase(trackName.Trim) Then
                            theTrack = Nothing
                        Else
                            Return theTrack
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        Public Shared Function FindTrackFromMilePostWithTrackName(ByVal Milepost As Decimal, ByVal MilePostSuffix As String, ByVal MilePostPrefix As String, ByVal TrackName As String, SubdivisionPTCUID As Int32) As Object
            'This function finds the current trackcomponent using Milepost
            Dim trk As Track
            Dim comp As Object
            Try
                Dim TrackNameUpper As String = TrackName.ToUpper
                If Milepost = 0 Then Return Nothing
                For Each trk In TrackCollection
                    If (trk.LeftLimitMilePost >= Milepost And trk.RightLimitMilePost <= Milepost And trk.TrackNameAlias = TrackNameUpper And trk.MilePostPrefix = MilePostPrefix) Or (trk.LeftLimitMilePost <= Milepost And trk.RightLimitMilePost >= Milepost And trk.TrackNameAlias = TrackNameUpper And trk.MilePostPrefix = MilePostPrefix) Then

                        Dim IgnoreSubdivisionUID As Boolean = False
                        Dim SubdivisionFound As Boolean = False
                        If SubdivisionPTCUID = 0 Then
                            IgnoreSubdivisionUID = True
                        ElseIf SubdivisionPTCUID = trk.mySubdivision.PTCUID Then
                            SubdivisionFound = True
                        End If
                        If IgnoreSubdivisionUID OrElse SubdivisionFound Then
                            Return trk
                        End If

                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                trk = Nothing
                comp = Nothing
            End Try
        End Function

        Public Shared Function FindAllTracksFromMilePost(ByVal FromMilepost As Decimal, ByVal ToMilepost As Decimal, ByVal FromMPSuffix As String, ByVal ToMPSuffix As String, ByVal FromMPPrefix As String, ByVal ToMPPrefix As String, Optional ByVal IncludeOnlyMainTypeTracks As Boolean = False, Optional SubdivisionGUID As Integer = 0) As ArrayList ', Optional ByVal UseMR As Boolean = False
            'This function finds the current trackcomponent using Milepost
            Dim TrackList As New ArrayList
            Dim trk As Track
            Dim comp As Object
            Try

                For Each trk In TrackCollection
                    If trk IsNot Nothing Then
                        Dim OkToValidateTrk As Boolean = True
                        If IncludeOnlyMainTypeTracks Then
                            OkToValidateTrk = IsMainTypeTrack(trk)
                            'If trk.AuthorityType.ToUpper.Trim.Contains("TWC") OrElse trk.AuthorityType.ToUpper.Trim.Contains("CTC") Then
                            'Else
                            '    OkToValidateTrk = False
                            'End If
                        End If
                        If SubdivisionGUID <> 0 AndAlso trk.mySubdivision IsNot Nothing Then
                            If trk.mySubdivision.GUID <> SubdivisionGUID Then OkToValidateTrk = False
                        End If
                        If OkToValidateTrk AndAlso ((trk.MilePostPrefix.ToUpper.Trim = FromMPPrefix.ToUpper.Trim AndAlso trk.MilePostSuffix.ToUpper.Trim = FromMPSuffix.ToUpper.Trim) OrElse (trk.MilePostPrefix.ToUpper.Trim = ToMPPrefix.ToUpper.Trim AndAlso trk.MilePostSuffix.ToUpper.Trim = ToMPSuffix.ToUpper.Trim)) Then
                            If (trk.LeftLimitMilePost >= FromMilepost AndAlso trk.RightLimitMilePost <= ToMilepost) OrElse (trk.LeftLimitMilePost >= ToMilepost AndAlso trk.RightLimitMilePost <= FromMilepost) Then
                                If Not TrackList.Contains(trk) Then TrackList.Add(trk)
                            ElseIf (trk.LeftLimitMilePost >= FromMilepost AndAlso trk.RightLimitMilePost <= FromMilepost) OrElse (trk.LeftLimitMilePost <= FromMilepost AndAlso trk.RightLimitMilePost >= FromMilepost) Then
                                If Not TrackList.Contains(trk) Then TrackList.Add(trk)
                            ElseIf (trk.LeftLimitMilePost <= FromMilepost AndAlso trk.RightLimitMilePost >= FromMilepost) OrElse (trk.LeftLimitMilePost <= ToMilepost AndAlso trk.RightLimitMilePost >= ToMilepost) Then
                                If Not TrackList.Contains(trk) Then TrackList.Add(trk)

                            ElseIf (trk.LeftLimitMilePost >= ToMilepost AndAlso trk.RightLimitMilePost <= ToMilepost) OrElse (trk.LeftLimitMilePost <= ToMilepost AndAlso trk.RightLimitMilePost >= ToMilepost) Then
                                If Not TrackList.Contains(trk) Then TrackList.Add(trk)
                            ElseIf FromMilepost = ToMilepost Then
                                If (trk.LeftLimitMilePost >= ToMilepost AndAlso trk.RightLimitMilePost <= ToMilepost) OrElse (trk.LeftLimitMilePost <= ToMilepost AndAlso trk.RightLimitMilePost >= ToMilepost) Then
                                    If Not TrackList.Contains(trk) Then TrackList.Add(trk)
                                End If
                            End If
                        End If
                    End If
                Next
                trk = Nothing
                If gDebug Then
                    For Each trk In TrackList
                        'SystemEvent("Tracks Found Within MilePost From MP " & FromMilepost & " To MP " & ToMilepost & " TrackGuid " & trk.GUID.ToString & vbTab & "LeftMP: " & trk.LeftLimitMilePostPrefix & trk.LeftLimitMilePost & trk.LeftLimitMilePostSuffix & vbTab & vbTab & "Right MP: " & trk.RightLimitMilePostPrefix & trk.RightLimitMilePost & trk.RightLimitMilePostSuffix)
                    Next
                End If
                Return TrackList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                trk = Nothing
                comp = Nothing
            End Try
        End Function

