        Public Shared Sub UpdateTrainIDs()
            Dim trn As TrainID
            Dim trk As Track
            Dim frm As frmDisplay
            Try
                For Each frm In TMDS.GlobalDeclarations.gDisplayFormCollection
                    If gDisplayEngineID Then
                        For Each trn In TrainCollection
                            trn.DisplayEngineID = gDisplayEngineID
                            trn.DisplayAbbreviation = False
                            trn.DisplayPseudoName = False
                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trn.TrackGUID)
                            If Not trk Is Nothing Then
                                trk.InvalidateTrainID()
                                trk.InitTrainDisplay()
                                trk.Draw(frm.CreateGraphics)
                            End If
                        Next
                    ElseIf gDisplaySymbol Then
                        For Each trn In TrainCollection
                            trn.DisplayPseudoName = False
                            trn.DisplayEngineID = False
                            trn.DisplayAbbreviation = False
                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trn.TrackGUID)
                            If Not trk Is Nothing Then
                                trk.InvalidateTrainID()
                                trk.InitTrainDisplay()
                                trk.Draw(frm.CreateGraphics)
                            End If
                        Next
                    ElseIf gDisplayPseudo Then
                        For Each trn In TrainCollection
                            trn.DisplayPseudoName = True
                            trn.DisplayEngineID = False
                            trn.DisplayAbbreviation = False
                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trn.TrackGUID)
                            If Not trk Is Nothing Then
                                trk.InvalidateTrainID()
                                trk.InitTrainDisplay()
                                trk.Draw(frm.CreateGraphics)
                            End If
                        Next
                    ElseIf gDisplayAbbrev Then
                        For Each trn In TrainCollection
                            trn.DisplayPseudoName = False
                            trn.DisplayEngineID = False
                            trn.DisplayAbbreviation = True
                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trn.TrackGUID)
                            If Not trk Is Nothing Then
                                trk.InvalidateTrainID()
                                trk.InitTrainDisplay()
                                trk.Draw(frm.CreateGraphics)
                            End If
                        Next
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                trn = Nothing
                trk = Nothing
                frm = Nothing
            End Try
        End Sub

