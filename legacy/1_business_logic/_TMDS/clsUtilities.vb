            Dim ReportClearTimeFeedback As String = Now.ToString
            Dim SW As Switch = Nothing
            Try
                If CurrentTrack.TrackAuthorities Is Nothing Then Return False
                If CurrentTrack.TrackAuthorities.Count = 0 Then Return False
                For Each Auth In CurrentTrack.TrackAuthorities
                    If Auth.GetType.ToString = gSFAComponentName Then
                        If Auth.TrainSymbol = trn.Name Then
                            Select Case Auth.AuthType1
                                Case gSFAAuthorityTypeItem2
