        Public Shared Function FindTrackItemFromGUID(ByVal UniqueID As Int32) As Object
            'This function finds the current trackcomponent index from the global unique ID
            Dim I As Integer
            Try
                For I = 1 To UBound(TrackComponent)
                    If TrackComponent(I).GUID = UniqueID Then
                        FindTrackItemFromGUID = TrackComponent(I)
                        Exit Function
                    End If
                Next I
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        ''' <summary>
        ''' Find remote train
        ''' </summary>
        ''' <param name="pLocoId"></param>
        ''' <returns></returns>
        Public Shared Function FindTrainFromAuthority(ByVal pLocoId As String) As TrainID
            Dim comp As Object
            Dim auth As TrackAuthority.TrackAuthority = Nothing
            Try
                For Each comp In OtherTrackAuthorities
                    If comp.GetType.ToString = gTTComponentName AndAlso comp.IssueTo = pLocoId Then
                        auth = CType(comp, TrackAuthority.TrackAuthority)
                        If auth.myTrain IsNot Nothing Then
                            Return auth.myTrain
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                comp = Nothing
                auth = Nothing
            End Try
        End Function

        Public Shared Function FindTrackItemFromGUIDAndLoopToRight(ByVal UID As Int32) As Object
            Try
                Dim comp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(UID)
                Dim LoopControl As Integer
                Do
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Return comp
                    End If
                    comp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(comp.RightLink)
                    LoopControl += 1
                    If LoopControl > 2 Then
                        Return Nothing
                    End If
                Loop
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

