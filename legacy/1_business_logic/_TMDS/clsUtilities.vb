                                If Not dr.IsDBNull(23) Then sb.MilePostEndSuffix = Trim(dr.GetString(23)).ToUpper
                                If Not dr.IsDBNull(24) Then sb.mysTypeForm = Trim(dr.GetString(24)).ToUpper
                                Select Case sb.mysTypeForm
                                    Case "FORMA"
                                        sb.myTypeForm = BulletinFormType.FORMA
                                    Case "FORMB"
