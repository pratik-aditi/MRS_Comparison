        Public Shared Function GetLastOrFirstAuthorityIssued(IssuedToTrain As Boolean, ByVal IssuedToName As String, Optional ByVal FirstAuthority As Boolean = False) As Object
            Dim Auth As Object = Nothing
            Dim TempDt As New DataTable
            Dim dvAuth As New DataView
            Dim col1 As DataColumn
            Try
                col1 = New DataColumn("GUID")
                col1.DataType = System.Type.GetType("System.String")
                TempDt.Columns.Add(col1)

                col1 = New DataColumn("AuthDate")
                col1.DataType = System.Type.GetType("System.DateTime")
                TempDt.Columns.Add(col1)

                If OtherTrackAuthorities IsNot Nothing AndAlso OtherTrackAuthorities.Count > 0 Then
                    For Each Auth In OtherTrackAuthorities
                        If Auth IsNot Nothing Then
                            Select Case Auth.GetType.ToString
                                Case gSFAComponentName
                                    If Auth.TrainSymbol IsNot Nothing AndAlso IssuedToTrain AndAlso Auth.TrainSymbol.Trim.ToUpper = IssuedToName.Trim.ToUpper Then
                                        Dim drow As DataRow = TempDt.NewRow
                                        drow("GUID") = Auth.AuthGUID
                                        drow("AuthDate") = Auth.AuthDate
                                        TempDt.Rows.Add(drow)
                                        TempDt.AcceptChanges()
                                    ElseIf Auth.IssueTo.Trim.ToUpper = IssuedToName.Trim.ToUpper Then
                                        Dim drow As DataRow = TempDt.NewRow
                                        drow("GUID") = Auth.AuthGUID
                                        drow("AuthDate") = Auth.AuthDate
                                        TempDt.Rows.Add(drow)
                                        TempDt.AcceptChanges()
                                    End If
                                Case gTTComponentName
                                    If Auth IsNot Nothing Then
                                        If Auth.TrainSymbol IsNot Nothing AndAlso IssuedToTrain AndAlso Auth.TrainSymbol.Trim.ToUpper = IssuedToName.Trim.ToUpper Then
                                            Dim drow As DataRow = TempDt.NewRow
                                            drow("GUID") = Auth.AuthGUID
                                            drow("AuthDate") = Auth.AuthorityDate
                                            TempDt.Rows.Add(drow)
                                            TempDt.AcceptChanges()
                                        ElseIf Auth.IssueTo.Trim.ToUpper = IssuedToName.Trim.ToUpper Then
                                            Dim drow As DataRow = TempDt.NewRow
                                            drow("GUID") = Auth.AuthGUID
                                            drow("AuthDate") = Auth.AuthorityDate
                                            TempDt.Rows.Add(drow)
                                            TempDt.AcceptChanges()
                                        End If
                                    End If
                            End Select
                        End If
                    Next
                End If
                Auth = Nothing
                If TempDt IsNot Nothing AndAlso TempDt.Rows.Count > 0 Then
                    dvAuth = New DataView(TempDt)
                    dvAuth.RowFilter = ""
                    If FirstAuthority Then
                        dvAuth.Sort = "AuthDate"
                        Auth = FindSFAByGUID(dvAuth(0)("GUID"))
                        For Each Auth In OtherTrackAuthorities
                            If Auth.AuthGUID = dvAuth(0)("GUID") Then
                                Return Auth
                            End If
                        Next
                    Else
                        dvAuth.Sort = "AuthDate DESC"
                        For Each Auth In OtherTrackAuthorities
                            If Auth.AuthGUID = dvAuth(0)("GUID") Then
                                Return Auth
                            End If
                        Next
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            Finally
                Auth = Nothing
                TempDt = Nothing
                dvAuth = Nothing
            End Try
            Return Nothing
        End Function

        Friend Shared Function RetrieveSFAVIIRecords(ByVal AuthGUID As String) As TrackAuthority.SFAuthority
            Dim AuthorityFetch As String = ""
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseCommand As OleDbCommand = Nothing
            Dim auth As TrackAuthority.SFAuthority = Nothing

            Try
                AuthorityFetch = "SELECT * FROM " & gtblSFAActive
                AuthorityFetch = AuthorityFetch & " WHERE AuthGUID = '" & AuthGUID & "'"
                Using dbConn As New OleDbConnection(gConnectionStringAuthority)
                    dbConn.Open()
                    DatabaseCommand = New OleDbCommand(AuthorityFetch, dbConn)
                    dr = DatabaseCommand.ExecuteReader()
                    While dr.Read()
                        auth = New TrackAuthority.SFAuthority()
                        auth.AuthGUID = dr.GetString(0)
                        auth.RailRoadName = dr.GetString(1)
                        auth.Subdivision = dr.GetString(2)
                        auth.TimeZone = dr.GetString(3)
                        auth.DispName = dr.GetString(4)
                        auth.Direction = dr.GetString(5)
                        auth.AuthDate = dr.GetDateTime(6)
                        auth.TerrID1 = dr.GetInt32(7)
                        auth.TerrID2 = dr.GetInt32(8)
                        auth.TerrID3 = dr.GetInt32(9)

                        auth.AuthType1 = dr.GetString(10)
                        auth.AuthType2 = dr.GetString(11)
                        auth.AuthType3 = dr.GetString(12)

                        auth.AuthorityNumber = dr.GetInt32(13)
                        auth.AuthorityUID = dr.GetString(14)
                        auth.IssuedToTrain = dr.GetBoolean(15)

                        auth.IssueTo = dr.GetString(16)
                        auth.AtLocation = dr.GetString(17)
                        Dim BoxVoid() As String = dr.GetString(18).Split("|")
                        Dim BoxOne As String
                        For Each BoxOne In BoxVoid
                            If BoxOne <> "" Then
                                auth.Box1Void.Add(BoxOne)
                            End If
                        Next
                        auth.Box2From1 = dr.GetString(19)
                        auth.Box2To1 = dr.GetString(20)
                        auth.Box2Track1 = dr.GetString(21)
                        auth.Box2From2 = dr.GetString(22)
                        auth.Box2To2 = dr.GetString(23)
                        auth.Box2Track2 = dr.GetString(24)
                        auth.Box2From3 = dr.GetString(25)
                        auth.Box2To3 = dr.GetString(26)
                        auth.Box2Track3 = dr.GetString(27)

                        auth.Box3Clear = dr.GetBoolean(28)

                        If Not dr.IsDBNull(97) Then
                            auth.Box4To1 = dr.GetString(97)
                        End If
                        If Not dr.IsDBNull(98) Then
                            auth.Box4From1 = dr.GetString(98)
                        End If
                        If Not dr.IsDBNull(99) Then
                            auth.Box4Track1 = dr.GetString(99)
                        End If
                        If Not dr.IsDBNull(100) Then
                            auth.Box4To2 = dr.GetString(100)
                        End If
                        If Not dr.IsDBNull(101) Then
                            auth.Box4From2 = dr.GetString(101)
                        End If
                        If Not dr.IsDBNull(102) Then
                            auth.Box4Track2 = dr.GetString(102)
                        End If
                        If Not dr.IsDBNull(103) Then
                            auth.Box4To3 = dr.GetString(103)
                        End If
                        If Not dr.IsDBNull(104) Then
                            auth.Box4From3 = dr.GetString(104)
                        End If
                        If Not dr.IsDBNull(105) Then
                            auth.Box4Track3 = dr.GetString(105)
                        End If


                        If Not dr.IsDBNull(107) Then
                            Dim AfterArrival() As String = dr.GetString(107).Split("|")
                            Dim BoxFive As String
                            For Each BoxFive In AfterArrival
                                If BoxFive <> "" Then
                                    auth.Box5Arrival.Add(BoxFive)
                                End If
                            Next
                        End If

                        If Not dr.IsDBNull(108) Then auth.Box5At = dr.GetString(108)

                        If Not dr.IsDBNull(109) Then
                            Dim BehindTrain() As String = dr.GetString(109).Split("|")
                            Dim BoxSix As String
                            For Each BoxSix In BehindTrain
                                If BoxSix <> "" Then
                                    auth.Box6Train.Add(BoxSix)
                                End If
                            Next
                        End If

                        auth.Box8To1 = dr.GetString(41)
                        auth.Box8From1 = dr.GetString(42)
                        auth.Box8Track1 = dr.GetString(43)

                        If Not dr.IsDBNull(110) Then
                            Dim Joint() As String = dr.GetString(110).Split("|")
                            Dim BoxNine As String
                            For Each BoxNine In Joint
                                If BoxNine <> "" Then
                                    auth.Box9List.Add(BoxNine)
                                End If
                            Next
                        End If

                        If Not dr.IsDBNull(111) Then auth.Box10ClearBy = dr.GetDateTime(111)

                        If Not dr.IsDBNull(68) Then
                            Dim RollEvents() As String = dr.GetString(68).Split(Chr(1))
                            Dim roll As String
                            For Each roll In RollEvents
                                If roll <> "" Then
                                    auth.RollUpEvents.Add(roll)
                                End If
                            Next
                        End If

                        Dim POS() As String = dr.GetString(54).Split("|")
                        Dim Box12 As String
                        For Each Box12 In POS
                            If Box12 <> "" Then
                                auth.Box12Switches.Add(Box12)
                            End If
                        Next

                        Dim PLO() As String = dr.GetString(55).Split("|")
                        Dim Box13 As String
                        For Each Box13 In PLO
                            If Box13 <> "" Then
                                auth.Box13Switches.Add(Box13)
                            End If
                        Next

                        If Not dr.IsDBNull(112) Then auth.Box14Instructions = dr.GetString(112)

                        If Not dr.IsDBNull(57) Then auth.BoxItems = dr.GetString(57)
                        If Not dr.IsDBNull(58) Then auth.NumOfBoxesChecked = CInt(dr.GetString(58))
                        If Not dr.IsDBNull(59) Then
                            auth.OKTime = dr.GetDateTime(59)
                        End If
                        If Not dr.IsDBNull(95) Then auth.ClearMainLocationOne = dr.GetString(95)
                        If Not dr.IsDBNull(96) Then auth.ClearMainLocationTwo = dr.GetString(96)
                        If Not dr.IsDBNull(113) Then auth.Box11TrainMeetLocation = dr.GetString(113)
                        If Not dr.IsDBNull(114) Then auth.BoxFourTrainSatifiedOne = dr.GetBoolean(114)
                        If Not dr.IsDBNull(115) Then auth.BoxFourTrainSatifiedTwo = dr.GetBoolean(115)
                        If Not dr.IsDBNull(116) Then auth.BoxFourTrainSatifiedThree = dr.GetBoolean(116)

                        If dr.FieldCount >= 118 Then
                            If Not dr.IsDBNull(117) Then
                                auth.RelayedTo = dr.GetString(117)
                            End If
                        End If

                        If Not dr.IsDBNull(106) Then
                            Dim Box4Contingent() As String = dr.GetString(106).Split("-")
                            Dim compGUID As String
                            For Each compGUID In Box4Contingent
                                If IsNumeric(compGUID) Then
