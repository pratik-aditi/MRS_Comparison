                                                    sw.HatchItSpeed = True
                                                ElseIf sb.mysTypeForm = "FORMF" And Not sw.HatchItWorkZone Then
                                                    sw.HatchItInformational = True
                                                ElseIf sb.mysTypeForm = "FORMB" Then
                                                    sw.HatchItWorkZone = True
                                                ElseIf sb.mysTypeForm = "FORM O" And Not sw.HatchItWorkZone Then
                                                    sw.HatchItFormO = True
                                                End If
                                            End If
                                        End If
                                    End If
                                Next
                            End If

                            sb.thisSubdivision = Subdvn
                            If Not Subdvn.BulletinList.Contains(sb) Then Subdvn.BulletinList.Add(sb)
                            If Not TMDS.GlobalDeclarations.BulletinCollection.Contains(sb) Then TMDS.GlobalDeclarations.BulletinCollection.Add(sb)

                            If Not IsNothing(sb.myExceptionList) Then
                                If sb.myExceptionList.Count > 0 Then
                                    ReLoadBulletinExceptionOtherInformation(sb)
                                End If
                            End If
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using

                Dim SummItem As New SummaryItem("SUB-BULLETIN", "REFRESH", Nothing, "Utils_ReloadSubGBO")
                SyncLock gSubBulletinsMessageSummaryQueue.SyncRoot
                    gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                End SyncLock

                'If HasNewBull AndAlso optApplyKCSBulletinConfiguration Then
