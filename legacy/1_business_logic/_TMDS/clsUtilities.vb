        Public Shared Sub RetrieveSubTrainSheets(ByRef trn As TrainID)
            Dim TrainFetch As String
            Dim dr As OleDbDataReader
            Dim DatabaseCommand As OleDbCommand
            Dim q As String = "'"
            Dim dbconn As OleDb.OleDbConnection


            Try
                TrainFetch = "SELECT ActiveSubTrainSheet,CallTime,Origin FROM tblTrainsActiveSubTrainSheets "
                TrainFetch = TrainFetch & " WHERE Symbol = " & q & trn.Name & q

                dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringTrain)
                DatabaseCommand = New OleDbCommand(TrainFetch, dbconn)
                dbconn.Open()
                dr = DatabaseCommand.ExecuteReader()
                trn.SubTrainSheets.Clear()

                While dr.Read()
                    Dim NewSubSheet As New SubTrainSheet()
                    If Not dr.IsDBNull(0) And Not dr.IsDBNull(1) Then
                        NewSubSheet.myGuid = dr.GetString(0)
                        NewSubSheet.myCreateTime = dr.GetDateTime(1)
                        If Not dr.IsDBNull(2) Then
                            NewSubSheet.Origin = dr.GetString(2)
                        End If
                        trn.SubTrainSheets.Add(NewSubSheet)
                    End If
                End While
                DatabaseCommand.Dispose()
                DatabaseCommand = Nothing
                dbconn.Close()
                dbconn = Nothing

                Dim ss As SubTrainSheet
                For Each ss In trn.SubTrainSheets
                    If Not ss.CheckCreateTime Then
                        ss.UpdateCreateTimeInSubTrainSheetTable()
                        If ss.myGuid = trn.ActiveTrainSheetGUID Then
                            ss.UpdateCreateTimeInActiveTrainSheetTable()
                        End If
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
        End Sub

        Public Shared Function RetrieveSubTrainGUID(ByRef trnName As String, ByVal CreateTime As Date) As String
