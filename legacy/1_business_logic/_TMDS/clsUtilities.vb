                                If Not dr.IsDBNull(83) Then sb.ActivatedTime = Trim(dr.GetDateTime(83))
                                If Not dr.IsDBNull(84) Then sb.DateExceptionList = Trim(dr.GetString(84))
                                If Not dr.IsDBNull(85) Then sb.CrossingProtectionItem = Trim(dr.GetString(85))
                                If Not dr.IsDBNull(86) Then sb.CrossingProtectionReason = Trim(dr.GetString(86))
                                If Not dr.IsDBNull(87) Then sb.CrossingName = Trim(dr.GetString(87))
                                If Not dr.IsDBNull(88) Then sb.CrossingDOT = Trim(dr.GetString(88))
                                If Not dr.IsDBNull(89) Then sb.BulletinReadData = Trim(dr.GetString(89))

                            End If
                            If dr.FieldCount >= 97 Then
                                If Not dr.IsDBNull(90) Then sb.CancelledBulletin = Trim(dr.GetBoolean(90))
                                If Not dr.IsDBNull(91) Then sb.CancelledByPerson = Trim(dr.GetString(91))
                                If Not dr.IsDBNull(92) Then sb.CancelledTimeStamp = Trim(dr.GetDateTime(92))
                                If Not dr.IsDBNull(93) Then sb.TrackBlocked = Trim(dr.GetBoolean(93))
                                If Not dr.IsDBNull(94) Then sb.TrackOutOfSevice = Trim(dr.GetBoolean(94))
                                If Not dr.IsDBNull(95) Then sb.GeneralInformationTGBO = Trim(dr.GetBoolean(95))
                                If Not dr.IsDBNull(96) Then sb.GeneralInformationDOB = Trim(dr.GetBoolean(96))
                            End If
                            If dr.FieldCount >= 98 Then
                                'BulletinInitialedByList
                                Dim IniList As String = ""
                                Dim IniListSplt() As String
                                Dim s As String = ""
                                If Not dr.IsDBNull(97) Then IniList = Trim(dr.GetString(97))
                                If IniList.Trim <> "" Then
                                    IniListSplt = IniList.Split("|")
                                    For Each s In IniListSplt
                                        If s.Trim <> "" Then
                                            If Not sb.myInitialedList.Contains(s.Trim) Then sb.myInitialedList.Add(s.Trim)
                                        End If
                                    Next

                                End If
                            End If
                            If dr.FieldCount >= 104 Then
                                If Not dr.IsDBNull(101) Then sb.MilePostBeginPrefix = Trim(dr.GetString(101))
                                If Not dr.IsDBNull(102) Then sb.MilePostEndPrefix = Trim(dr.GetString(102))
                                If Not dr.IsDBNull(103) Then sb.HeadEndRestrictionOnly = Trim(dr.GetBoolean(103))
                                If Not dr.IsDBNull(100) Then sb.PTCBulletinText = dr.GetString(100)
                            End If

                            If dr.FieldCount >= 108 Then
                                If Not dr.IsDBNull(106) Then sb.SystemWideBulletin = dr.GetBoolean(106)
                                If Not dr.IsDBNull(107) Then sb.NonBlockingBulletin = dr.GetBoolean(107)
                                If sb.SystemWideBulletin Or sb.NonBlockingBulletin Then sb.NonDisplayed = True
                            End If
                            If dr.FieldCount >= 109 Then
                                If Not dr.IsDBNull(108) Then sb.CorrelatingRestrictionUID = dr.GetString(108)
                            End If
                            If dr.FieldCount >= 113 Then
                                If Not dr.IsDBNull(110) Then sb.OnBoardCRC = dr.GetValue(110)
                                If Not dr.IsDBNull(111) Then sb.CancelledBulletinUID = dr.GetValue(111)
                                If Not dr.IsDBNull(112) Then sb.CancelledBulletinGUID = dr.GetValue(112)
                                If Not dr.IsDBNull(113) Then sb.CancelledBulletinCRC = dr.GetValue(113)
                            End If
                            If dr.FieldCount >= 115 Then
                                If Not dr.IsDBNull(114) Then Boolean.TryParse(dr.GetValue(114), sb.CrossingOnNonControlledTrack)
                            End If
                        End If

                        Dim sCompList As String = String.Empty
                        If Not dr.IsDBNull(20) Then sCompList = dr.GetString(20)
                        If gDisplayBulletinsOnTrack And Not sb.TrainSpecific Then
                            Dim comps() As String = sCompList.Split("-")
                            Dim c As String
                            For Each c In comps
                                If IsNumeric(c) Then
                                    Dim comp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CInt(c))
                                    If Not IsNothing(comp) Then
                                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            Dim trk As Track = CType(comp, Track)
                                            If optEnableBulletinSubTypes And optEnableDisplayBulletinsOnTracks Then
                                                If trk.Bulletins IsNot Nothing AndAlso Not trk.Bulletins.Contains(sb) Then
                                                    trk.Bulletins.Add(sb)
                                                End If
                                            End If
                                            If Not sb.CompList.Contains(trk) Then
                                                sb.CompList.Add(trk)
                                            End If
                                            If sb.mysType = "SPEED RESTRICTION" AndAlso Not trk.HatchItWorkZone Then
                                                trk.HatchItSpeed = True
                                            ElseIf sb.mysType = "MISC" AndAlso sb.myTypeForm = BulletinFormType.FORMTC AndAlso Not trk.HatchItWorkZone AndAlso Not sb.NonDisplayed Then
                                                If optEnableHatchForTrackConditionMessageTypeBulletins Then
                                                    trk.HatchItInformational = True
                                                End If
                                            ElseIf sb.mysType = "MISC" AndAlso Not trk.HatchItWorkZone AndAlso Not sb.NonDisplayed Then
                                                trk.HatchItInformational = True
                                            ElseIf sb.mysType = "WORKZONE" Then
                                                Select Case sb.mysTypeForm
                                                    Case "FORM O"
                                                        'trk.HatchItSpeed = True
                                                        trk.HatchItFormO = True
                                                    Case Else
                                                        trk.HatchItWorkZone = True
                                                End Select
                                            End If

                                            If Not optUseCompBulletinsTracksListOnReLoad AndAlso trk.OStype AndAlso trk.OsComponentCollection IsNot Nothing Then
                                                Dim OsComp As Object
                                                For Each OsComp In trk.OsComponentCollection
                                                    If OsComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                        If Not OsComp.TurnOutType Then
                                                            If Not OsComp.Bulletins Is Nothing Then
                                                                If Not OsComp.Bulletins.Contains(sb) Then
                                                                    If Not OsComp.Bulletins.Contains(sb) Then
                                                                        OsComp.Bulletins.Add(sb)
                                                                    End If
                                                                    If Not sb.CompList.Contains(OsComp) Then
                                                                        sb.CompList.Add(OsComp)
                                                                    End If
                                                                    If sb.mysType = "SPEED RESTRICTION" AndAlso Not trk.HatchItWorkZone Then
                                                                        OsComp.HatchItSpeed = True
                                                                    ElseIf sb.mysType = "MISC" AndAlso Not trk.HatchItWorkZone AndAlso Not sb.NonDisplayed Then
                                                                        OsComp.HatchItInformational = True
                                                                    ElseIf sb.mysType = "WORKZONE" Then
                                                                        Select Case sb.mysTypeForm
                                                                            Case "FORM O"
                                                                                OsComp.HatchItSpeed = True
                                                                            Case Else
                                                                                OsComp.HatchItWorkZone = True
                                                                        End Select
                                                                    End If
                                                                End If
                                                            End If
                                                        End If
                                                    Else
                                                        If Not OsComp.Bulletins Is Nothing Then
                                                            If Not OsComp.Bulletins.Contains(sb) Then
                                                                sb.CompList.Add(OsComp)
                                                                If sb.mysType = "SPEED RESTRICTION" And Not trk.HatchItWorkZone Then
                                                                    OsComp.HatchItSpeed = True
                                                                ElseIf sb.mysType = "MISC" AndAlso Not trk.HatchItWorkZone AndAlso Not sb.NonDisplayed Then
                                                                    OsComp.HatchItInformational = True
                                                                ElseIf sb.mysType = "WORKZONE" Then
                                                                    Select Case sb.mysTypeForm
                                                                        Case "FORM O"
                                                                            OsComp.HatchItSpeed = True
                                                                        Case Else
                                                                            OsComp.HatchItWorkZone = True
                                                                    End Select
                                                                End If
                                                            End If
                                                        End If
                                                    End If
                                                Next
                                            End If
                                        Else
                                            Dim sw As Switch = CType(comp, Switch)
                                            If Not sw.Bulletins.Contains(sb) Then
                                                sw.Bulletins.Add(sb)
                                            End If
                                            sb.CompList.Add(sw)
                                            If sb.mysType = "SPEED RESTRICTION" And Not sw.HatchItWorkZone Then
                                                sw.HatchItSpeed = True
                                            ElseIf sb.mysType = "MISC" AndAlso Not sw.HatchItWorkZone AndAlso Not sb.NonDisplayed Then
                                                sw.HatchItInformational = True
                                            ElseIf sb.mysType = "WORKZONE" Then
                                                Select Case sb.mysTypeForm
                                                    Case "FORM O"
                                                        sw.HatchItFormO = True
                                                    Case Else
                                                        sw.HatchItWorkZone = True
                                                End Select
                                            End If
                                        End If
                                    End If
                                End If
                            Next
                        End If

                        sb.thisSubdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromDB(sb.SubdivisionFromUID)
                        'sb.DoCheckToEnableSlideZoneDisplay()
                        'If Not subdvn.BulletinList.Contains(sb) Then subdvn.BulletinList.Add(sb)
                        'If Not TMDS.GlobalDeclarations.BulletinCollection.Contains(sb) Then TMDS.GlobalDeclarations.BulletinCollection.Add(sb)

                        'If Not IsNothing(sb.myExceptionList) Then
                        '    If sb.myExceptionList.Count > 0 Then
                        '        LoadBulletinExceptionOtherInformation(sb)
                        '    End If
                        'End If
                    End If
                End While

                'Dim SummItem As New SummaryItem("SUB-BULLETIN", "REFRESH", Nothing)
                'SyncLock gSubBulletinsMessageSummaryQueue.SyncRoot
                '    gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                'End SyncLock

                dbconn.Close()
                dbconn = Nothing

                Return sb


            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing

            End Try
            Return Nothing
        End Function

        Private Shared Function GetMileageRanges(ByVal sb As SubBulletin) As ArrayList

            Dim Ranges As New ArrayList

            Try
                Dim mr As MileageRange
                For Each mr In gMileageRangeList
                    If Not String.IsNullOrEmpty(sb.MileRangeGUID1) Then
                        If mr.myUID = sb.MileRangeGUID1 Then
                            If Not Ranges.Contains(mr) Then
                                Ranges.Add(mr)
                            End If
                        End If
                        If mr.myUID = sb.MileRangeGUID2 Then
                            If Not Ranges.Contains(mr) Then
                                Ranges.Add(mr)
                            End If
                        End If
                        If mr.myUID = sb.MileRangeGUID3 Then
                            If Not Ranges.Contains(mr) Then
                                Ranges.Add(mr)
                            End If
                        End If
                        If mr.myUID = sb.MileRangeGUID4 Then
                            If Not Ranges.Contains(mr) Then
                                Ranges.Add(mr)
                            End If
                        End If
                    End If
                Next
                Return Ranges
            Catch exp As Exception
                GetErrorDetails(exp)
                Return Nothing
            End Try
        End Function

        Friend Shared Function GetTGBOByGUID(ByVal GUID As String, ByVal IsOnOtherDesk As Boolean, ByVal CallingMethod As String) As TabularGeneralBulletin
            Dim Query As New StringBuilder
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim tgbo As TabularGeneralBulletin = Nothing
            Try
                SystemEvent("GetTGBOByGUID CALLED BY: " & CallingMethod & "TGBO GUID:" & GUID)
                Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringBulletin)
                    dbconn.Open()
                    Query = New System.Text.StringBuilder
                    Query.Append("SELECT * FROM tblSystemTabularGeneralBulletinActive WHERE SystemUID = '" & GUID & "'")
                    dbComm = New OleDbCommand(Query.ToString, dbconn)
                    dr = dbComm.ExecuteReader
                    While dr.Read()
                        Application.DoEvents()
                        tgbo = New TabularGeneralBulletin()
                        With tgbo
                            If Not dr.IsDBNull(0) Then .SystemUID = dr.GetString(0)
                            If Not dr.IsDBNull(1) Then .UID = dr.GetString(1)
                            If Not dr.IsDBNull(2) Then .RouteCodeUID = dr.GetString(2)
                            If Not dr.IsDBNull(3) Then .RouteCodeName = dr.GetString(3)
                            If Not dr.IsDBNull(4) Then .TypeOfBulletin = dr.GetString(4)
                            If Not dr.IsDBNull(5) Then .IssuedTo = dr.GetString(5)
                            If Not dr.IsDBNull(6) Then .AtSubdivisionUID = dr.GetInt32(6)
                            If Not dr.IsDBNull(7) Then .AtSubdivisionName = dr.GetString(7)
                            If Not dr.IsDBNull(8) Then .AtLocationUID = dr.GetString(8)
                            If Not dr.IsDBNull(9) Then .AtLocationName = dr.GetString(9)
                            If Not dr.IsDBNull(10) Then .EffectiveDate = dr.GetDateTime(10)
                            If Not dr.IsDBNull(11) Then .TimeZone = dr.GetString(11)
                            If Not dr.IsDBNull(12) Then .FaxPrintLocations = dr.GetString(12)
                            If Not dr.IsDBNull(13) Then .SpecificInstuctions = dr.GetString(13)
                            If Not dr.IsDBNull(14) Then .BulletinListDefinitions = dr.GetString(14)
                            If Not dr.IsDBNull(15) Then .Status = dr.GetString(15)
                            If Not dr.IsDBNull(16) Then .ExceptionListDefinitions = dr.GetString(16)
                            If Not dr.IsDBNull(17) Then .MileageRangeListDefinitions = dr.GetString(17)
                            If Not dr.IsDBNull(18) Then .CreateTime = dr.GetDateTime(18)
                            If dr.FieldCount >= 20 Then
                                If Not dr.IsDBNull(19) Then .DocumentGUID = dr.GetString(19)
                            End If
                            If dr.FieldCount >= 31 Then
                                If Not dr.IsDBNull(20) Then .SubDesignation = dr.GetString(20)
                                If Not dr.IsDBNull(21) Then .DeliveryMethod = dr.GetString(21)
                                If Not dr.IsDBNull(22) Then .DeviceLocation = dr.GetString(22)
                                If Not dr.IsDBNull(23) Then .ReleaseTime = dr.GetDateTime(23)
                                If Not dr.IsDBNull(24) Then .ReleaseReason = dr.GetString(24)
                                If Not dr.IsDBNull(25) Then .CancelTime = dr.GetDateTime(25)
                                If Not dr.IsDBNull(26) Then .CancelOccupation = dr.GetString(26)
                                If Not dr.IsDBNull(27) Then .CancelPerson = dr.GetString(27)
                                If Not dr.IsDBNull(28) Then .AcknowledgeTime = dr.GetDateTime(28)
                                If Not dr.IsDBNull(29) Then .AcknowledgeOccupation = dr.GetString(29)
                                If Not dr.IsDBNull(30) Then .AcknowledgePerson = dr.GetString(30)
                            End If
                            If dr.FieldCount >= 32 Then
                                If Not dr.IsDBNull(31) Then .TGBOAddress = dr.GetString(31)
                            End If
                            If dr.FieldCount >= 33 Then
                                If Not dr.IsDBNull(32) Then .TGBOCreator = dr.GetString(32)
                            End If
                            If dr.FieldCount >= 34 Then
                                If Not dr.IsDBNull(33) Then .UIDString = dr.GetString(33)
                            End If
                            If dr.FieldCount >= 35 Then
                                If Not dr.IsDBNull(34) Then .OKTime = dr.GetDateTime(34)
                            End If
                            If dr.FieldCount >= 39 Then
                                If Not dr.IsDBNull(35) Then .TGBOPrefix = dr.GetString(35)
                                If Not dr.IsDBNull(36) Then .TGBOAddressIncludesSymbol = dr.GetBoolean(36)
                                If Not dr.IsDBNull(37) Then .TGBOAddressIncludesEngineID = dr.GetBoolean(37)
                                If Not dr.IsDBNull(38) Then .TGBOAddressIncludesMultiSymbol = dr.GetBoolean(38)
                            End If
                            If dr.FieldCount >= 43 Then
                                If Not dr.IsDBNull(41) Then .sTrainSymbolList = dr.GetString(41) : .AssignTrainSymbolList()
                            End If
                            If dr.FieldCount >= 44 Then
                                If Not dr.IsDBNull(43) Then .sTrackTagList = dr.GetString(43) : .AssignTrackTagList()
                            End If
                            If dr.FieldCount >= 45 Then
                                If Not dr.IsDBNull(44) Then .mySortString = dr.GetValue(44)
                            End If
                            If IsOnOtherDesk Then
                                .OnOtherDesk = True
                            Else
                                .LoadedForThisDesk = True
                            End If
                            .BulletinCellRoute = GetBulletinCellRoute(.RouteCodeName)

                        End With
                        If Not gTabularGeneralBulletins.Contains(tgbo) Then gTabularGeneralBulletins.Add(tgbo)
                        'Dim SummItem As New SummaryItem("TGBO", "REFRESH", tgbo)
                        'SyncLock gSubBulletinsMessageSummaryQueue.SyncRoot
                        '    gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                        'End SyncLock
                        DoTGBOSummaryRefresh(CallingMethod)
                    End While
                End Using


            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return Nothing

        End Function

