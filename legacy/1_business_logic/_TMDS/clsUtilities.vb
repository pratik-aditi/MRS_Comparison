        Public Shared Function RetrieveSubdivisionTimeZone(ByRef SubUID As Int32) As String
            Dim SubTimeZone As String = String.Empty
            Dim dr As OleDbDataReader
            Dim dbcomm As OleDbCommand = Nothing
            Dim dbconn As OleDbConnection = Nothing
            Dim Query As New System.Text.StringBuilder

            Dim sb As Subdivision
            For Each sb In ControlledSubdivisions
                If sb.GUID = SubUID Then
                    Return sb.TimeZone
                End If
            Next


            Query.Append("SELECT  TimeZone FROM tblSystemSubDivisions WHERE UID = " & SubUID)
            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                dbcomm = New OleDbCommand(Query.ToString, dbconn)
                dbconn.Open()
                dr = dbcomm.ExecuteReader()
                While dr.Read()
                    If Not dr.IsDBNull(0) Then
                        SubTimeZone = dr.GetString(0)
                    End If

                End While
                dbconn.Close()
                Return SubTimeZone
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return Nothing
            End Try
        End Function

