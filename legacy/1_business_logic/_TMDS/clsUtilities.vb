                    End Select
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return True
            'CTC
            'TWC
            'DTC
            'YL
            'RL
            'TWC-BABS
            'TWC-ABSW
            'TWC-ABSE
            'NON-TWC
            'CTC-OTHER
            'CTC-PSEUD
            'OTHER
            'SHELF


        End Function


        ''' <summary>
        ''' This Function Retrives Subdivision Station name from the Track 
        ''' </summary>
        ''' <param name="trk"></param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared Function FindStationFromTrack(ByVal trk As Track) As String
            Try
                Dim stat As SubdivisionStation
                For Each stat In trk.mySubdivision.Stations
                    If stat.MilePost <> String.Empty AndAlso trk.myControlPoint.GUID = stat.ControlPointUID Then
                        If (trk.LeftLimitMilePost >= CDbl(stat.MilePost) And trk.RightLimitMilePost <= CDbl(stat.MilePost)) Or (trk.LeftLimitMilePost <= CDbl(stat.MilePost) And trk.RightLimitMilePost >= CDbl(stat.MilePost)) Then
                            Return stat.Name
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return String.Empty
        End Function

