        Public Shared Sub RemoveTWCComponents(ByRef CompList As ArrayList)
            Dim tmpArray As New ArrayList
            Dim FilteredComps As New ArrayList
            Dim Comp As Object = Nothing
            Try
                CopyArrayCollection(tmpArray, CompList)
                For Each Comp In tmpArray
                    If Comp.GetType.ToString = gTrackComponentName Then
                        If Mid(Comp.AuthorityType.Trim.ToUpper, 1, 3) <> "TWC" Then
                            If Not FilteredComps.Contains(Comp) Then FilteredComps.Add(Comp)
                        End If
                    Else
                        If Not FilteredComps.Contains(Comp) Then FilteredComps.Add(Comp)
                    End If
                Next
                If FilteredComps IsNot Nothing AndAlso FilteredComps.Count > 0 Then
                    CopyArrayCollection(CompList, FilteredComps)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

        End Sub

