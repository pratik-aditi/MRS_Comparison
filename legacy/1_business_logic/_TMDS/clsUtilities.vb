        ''' <summary>
        ''' This function takes in a string and removes any characters that could be used for a SQL injection attack. (RCW)
        ''' </summary>
        ''' <param name="input_text"></param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared Function CheckStringForSQLInjection(ByVal input_text As String) As String

            'Replace each character with blankosity (or, in the case of an apostrophe; quotation)
            input_text = input_text.Replace("--", "")
            input_text = input_text.Replace(";", "")
            input_text = input_text.Replace("/*", "")
            input_text = input_text.Replace("*/", "")
            input_text = input_text.Replace("@", "")
            input_text = input_text.Replace("'", "")

            Return input_text

        End Function

        Public Shared Function LimitText(ByVal input_text As String, ByVal all_caps As Boolean, ByVal limit_type As LimitType) As String

            Dim charactersAllowed As String = ""
            Dim limitTextReturn As String = ""
            'This is a list of characters that can be in the text box

            Select Case limit_type

                Case LimitType.LETTERS_NUMBERS_CHARS_SPACE
                    charactersAllowed = " abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-.1234567890"
                Case LimitType.LETTERS_NUMBERS_SPACE
                    charactersAllowed = " abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
                Case LimitType.LETTERS_NUMBERS
                    charactersAllowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
                Case LimitType.LETTERS_ONLY
                    charactersAllowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
                Case LimitType.NUMBERS_ONLY
                    charactersAllowed = "1234567890"

            End Select

            'Just grabbing a local copy of what's already in txtSearch
            Dim mainText As String = input_text
            'This is the current letter we are analyzing
            Dim currentLetter As String

            'Iterates through all characters in the textbox and verifies their legitimacy - this includes pasting
            For x As Integer = 0 To input_text.Length - 1
                currentLetter = input_text.Substring(x, 1)
                If charactersAllowed.Contains(currentLetter) = False Then
                    'An invalid character was found, so replace it with an empty value
                    mainText = mainText.Replace(currentLetter, String.Empty)
                End If
            Next

            'After all characters have been verified and changed, update the final string
            If all_caps Then
                limitTextReturn = mainText.ToUpper()
            Else
                limitTextReturn = mainText
            End If

            Return limitTextReturn

        End Function

