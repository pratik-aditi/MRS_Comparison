                        If optEnablePTCBOSAPIMode Or optEnablePTCBOSVETMSMode Then
                            If dr.FieldCount >= 44 Then
                                If Not dr.IsDBNull(43) Then
                                    auth.PTCAuthorityACKPending = dr.GetString(43)
                                    If auth.PTCAuthorityACKPending.Trim <> "" Then
                                        If Not dr.IsDBNull(44) Then
                                            Dim PTCComps As String = dr.GetString(44)
