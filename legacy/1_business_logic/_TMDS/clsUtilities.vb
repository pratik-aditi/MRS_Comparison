        Public Shared Sub AddAuthorityToSelectionList(ByVal auth As TMDS.TrackAuthority.SFAuthority)
            Try
                Dim comp As Object
                SyncLock gCurrentAuthorityList
                    For Each comp In auth.Components
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If Not trk.NonTransverable Then
                                If Not gCurrentAuthorityList.Contains(comp) Then
                                    gCurrentAuthorityList.Add(comp)
                                End If
                            End If
                        Else
                            If Not gCurrentAuthorityList.Contains(comp) Then
                                gCurrentAuthorityList.Add(comp)
                            End If
                        End If
                    Next
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Sub ClearCurrentAuthorityListSelection()
            Dim comp As Object
            Try
                gCurrentAuthorityFlash = False
                gCurrentAuthorityFlashShow = False
                SyncLock gCurrentAuthorityList
                    For Each comp In gCurrentAuthorityList
                        Select Case comp.GetType.ToString
                            Case "TMDS.SwitchComponents.Switch", "TMDS.TrackComponents.Track"
                                comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                comp.FlashComponent = False
                                comp.FlashOn = False
                                comp.Refresh()
                        End Select

                    Next
                    gCurrentAuthorityList.Clear()
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Function TrackWarrantItemTwoStartValidation() As Boolean

            Try
                Dim ItemSevenTypeWarrant As Boolean = gBeginTrackSelect.ItemFiveCheck(gSearchDirection)
                If ItemSevenTypeWarrant Then
                    Return False
                End If

                Dim comp As Object
                Dim StartingInItemFourMOWFound As Boolean
                For Each comp In gTrackSelectionCollection
                    If comp.TrackAuthorities.Count > 0 Then
                        Dim warrToCheck As TMDS.TrackAuthority.SFAuthority
                        For Each warrToCheck In comp.TrackAuthorities
                            If warrToCheck.AuthType1 <> "ItemTwoToTrain" Then
                                If Not warrToCheck.CheckBoxItemsStatus(7) And warrToCheck.CheckBoxItemsStatus(5) Then
                                    If Not warrToCheck.Box6Train.Contains(gTrainMenuMiscSelectedTrainID.IdentifingUnit & " " & gTrainMenuMiscSelectedTrainID.Direction) Then
                                        Return False
                                    End If
                                ElseIf Not warrToCheck.CheckBoxItemsStatus(7) Then
                                    Return False
                                End If
                                If warrToCheck.AuthType1 = "ItemFourToMOW" Then
                                    If Not StartingInItemFourMOWFound Then
                                        If Not gBeginTrackSelect.TrackAuthorities.Count > 0 Then
                                            Return False
                                        Else
                                            Dim auth As TMDS.TrackAuthority.SFAuthority
                                            For Each auth In gBeginTrackSelect.TrackAuthorities
                                                If auth.AuthType1 = "ItemFourToMOW" And auth.CheckBoxItemsStatus(7) Or auth.CheckBoxItemsStatus(5) Then
                                                    StartingInItemFourMOWFound = True
                                                    Exit For
                                                End If
                                            Next
                                            If Not StartingInItemFourMOWFound Then
                                                Return False
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    End If
                Next
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSystemVariables()
                Return False
            End Try
        End Function

        Public Shared Function TrackWarrantItemFourStartValidation() As Boolean

            Try
                Dim ItemSevenTypeWarrant As Boolean = gBeginTrackSelect.ItemFiveCheck(gSearchDirection)
                If ItemSevenTypeWarrant Then
                    Return False
                End If

                Dim comp As Object
                Dim StartingInItemFourMOWFound As Boolean
                For Each comp In gTrackSelectionCollection
                    If comp.TrackAuthorities.Count > 0 Then
                        Dim warrToCheck As TMDS.TrackAuthority.SFAuthority
                        For Each warrToCheck In comp.TrackAuthorities
                            If warrToCheck.AuthType1 = "ItemFourToTrain" Or warrToCheck.AuthType1 = "ItemFourToMOW" Or (warrToCheck.AuthType1 = "ItemTwoToTrain" And warrToCheck.CheckBoxItemsStatus(7)) Then
                                If warrToCheck.AuthType1 = "ItemFourToMOW" Then
                                    If Not StartingInItemFourMOWFound Then
                                        If Not gBeginTrackSelect.TrackAuthorities.Count > 0 Then
                                            Return False
                                        Else
                                            Dim auth As TMDS.TrackAuthority.SFAuthority
                                            For Each auth In gBeginTrackSelect.TrackAuthorities
                                                If auth.AuthType1 = "ItemFourToMOW" And auth.CheckBoxItemsStatus(7) Then
                                                    StartingInItemFourMOWFound = True
                                                    Exit For
                                                End If
                                            Next
                                            If Not StartingInItemFourMOWFound Then
                                                Return False
                                            End If
                                        End If
                                    End If
                                End If

                            Else
                                Dim OverRideExit As Boolean
                                If Mid(warrToCheck.IssueTo, 1, gTrainMenuMiscSelectedTrainID.IdentifingUnit.Length) = gTrainMenuMiscSelectedTrainID.IdentifingUnit Then
                                    OverRideExit = True
                                End If
                                If Not OverRideExit Then
                                    Return False
                                Else
                                    OverRideExit = False
                                End If
                            End If
                        Next
                    End If
                Next
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                ClearSystemVariables()
                Return False
            End Try
        End Function

        Public Shared Function DetermineArrivalDepartureEvent(ByVal OsTrk As Track, ByVal Trn As TrainID) As String
            Try
                Dim PreviousCPGUID As Int32
                If IsNothing(OsTrk) Then
                    Return "A"
                End If
                If Not IsNothing(Trn.OSPreviousControlPoint) Then
                    PreviousCPGUID = Trn.OSPreviousControlPoint.GUID
                End If


                If OsTrk.TrafficDirection <> "" Then
                    Trn.TrackingDirection = OsTrk.TrafficDirection
                End If
                Dim thisCP As ControlPoint = OsTrk.myControlPoint
                Dim OtherCP As ControlPoint = Nothing
                Dim cp As ControlPoint
                For Each cp In TMDS.GlobalDeclarations.gControlPointCollection
                    If cp.UniqueName = thisCP.UniqueName And cp.GUID <> PreviousCPGUID Then
                        OtherCP = cp
                        Exit For
                    End If
                Next

                If IsNothing(OtherCP) Then
                    Return "A"
                End If
                If IsNothing(OsTrk.OsComponentCollection) Then
                    Return "A"
                End If
                If Not IsNothing(Trn.OSPreviousControlPoint) Then

                    If Trn.OSPreviousControlPoint.UniqueName <> OtherCP.UniqueName Then
                        Return "A"
                    ElseIf Trn.OSPreviousControlPoint.UniqueName = OtherCP.UniqueName And OtherCP.GUID <> Trn.OSPreviousControlPoint.GUID Then
                        Return "D"
                    Else
                        Return "A"
                    End If
                Else
                    Dim comp As Object
                    Dim sw As Switch = Nothing
                    For Each comp In OsTrk.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            sw = comp
                            Exit For
                        End If
                    Next
                    If IsNothing(sw) Then
                        Return "A"
                    End If
                    If Trn.TrackingDirection = "" Then
                        Return "A"
                    End If
                    If sw.RightAltLink <> 0 And Trn.TrackingDirection = "RIGHT" Then
                        Return "A"
                    ElseIf sw.RightAltLink <> 0 And Trn.TrackingDirection = "LEFT" Then
                        Return "D"
                    ElseIf sw.LeftAltLink <> 0 And Trn.TrackingDirection = "LEFT" Then
                        Return "A"
                    Else
                        Return "D"
                    End If
                End If

                Return "A"
            Catch ex As Exception
                SystemException(ex.ToString)
                Return "A"
            End Try
        End Function

        Public Shared Function FindTrainStationIndex(ByVal OsTrk As Track, ByVal Trn As TrainID, Optional ByRef SchArrDateTime As Date = Nothing, Optional ByRef SchDepDateTime As Date = Nothing) As String
            Try
                Dim ts As TrainSchedule
                For Each ts In Trn.myScheduleList
                    If ts.myStationName = OsTrk.myControlPoint.UniqueName Then
                        SchArrDateTime = ts.myStationArrivalTime
                        SchDepDateTime = ts.myStationDepartureTime
                        Return ts.myStationScheduleIndex.ToString
                    End If
                Next
                Return "0"
            Catch ex As Exception
                SystemException(ex.ToString)
                Return "0"
            End Try
        End Function


