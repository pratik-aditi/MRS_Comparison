                            End If
                        End If
                        If dr.FieldCount >= 151 Then
                            If Not dr.IsDBNull(151) Then
                                .ScheduleType = dr.GetValue(151)
                            End If
                        End If
                        .TypeOfID = "TRAIN"
                    End With
                End While
                DatabaseCommand = Nothing
                dbconn.Close()
                dbconn = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
