        Public Shared Function GetWorkOrderFromDBbyGUID(ByVal Guid As String, Optional ByVal MyTrain As TrainID = Nothing) As WorkOrder
            If Guid.Trim = "" Then Return Nothing
            Dim wo As WorkOrder = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Try
                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    Dim SQLQuery As String = "SELECT  UID, EventTimeStamp, WorkOrderEvents, WorkOrderCompleted,WorkOrderDeleted,OKTime FROM tblTrainEventActiveWorkOrders WHERE UID = '" & Guid & "' ORDER BY EventTimeStamp"
                    dbcomm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        wo = New WorkOrder
                        Dim WorkOrderData As String = String.Empty
                        If Not dr.IsDBNull(0) Then wo.myUID = dr.GetString(0)
                        If Not dr.IsDBNull(1) Then wo.myTimeStamp = dr.GetDateTime(1)
                        If Not dr.IsDBNull(2) Then WorkOrderData = dr.GetString(2)
                        If Not dr.IsDBNull(3) Then wo.WorkComepleted = dr.GetBoolean(3)
                        If Not dr.IsDBNull(4) Then wo.WorkDeleted = dr.GetBoolean(4)
                        If Not dr.IsDBNull(5) Then Date.TryParse(dr.GetDateTime(5), wo.WorkOKTime)
                        wo.myTrain = MyTrain
                        Dim data() As String = WorkOrderData.Split("|")
                        With wo
                            .myEventType = data(0)
                            .myStationScheduleIndex = CInt(data(1))
                            .myStationName = data(2)
                            .myCarReasonForEvent = data(3)
                            .myCarUID = data(4).Trim & data(5).Trim
                            .myCarLength = CInt(data(6))
                            .myCarTons = CInt(data(7))
                            .myCarLoadStatus = data(8)
                            .myCarNumOfAxles = CInt(data(10))
                            .myCarNumOfBrakes = CInt(data(9))
                        End With

                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return wo
        End Function

