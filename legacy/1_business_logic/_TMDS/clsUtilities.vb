        Public Shared Function GetNextTrackBeyondSignal(ByVal Direction As String, ByVal thisTrk As Track) As Track
            Try
                If Direction = "RIGHT" Then
                    Dim sig As Signal = TMDS.SystemUtilities.FetchData.FindSignalRightFromGUID(thisTrk.RightLink)
                    If Not IsNothing(sig) Then
                        Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sig.RightLink)
                        Return trk
                    Else
                        Return Nothing
                    End If
                Else
                    Dim sig As Signal = TMDS.SystemUtilities.FetchData.FindSignalLeftFromGUID(thisTrk.LeftLink)
                    If Not IsNothing(sig) Then
                        Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sig.LeftLink)
                        Return trk
                    Else
                        Return Nothing
                    End If
                End If
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindLikeCompInCPForBlueFlag(ByVal cp As ControlPoint, ByVal trk As Track) As ArrayList
            'This function finds the current trackcomponent index from the global unique ID
            Dim comp As Object

            Dim CompList As New ArrayList()
            Try
                For Each comp In cp.AssignedComponenets
                    Select Case comp.GetType.ToString
                        Case "TMDS.TrackComponents.Track"
                            If comp.Name = trk.Name Then
                                If Not CompList.Contains(comp) Then
                                    CompList.Add(comp)
                                End If
                            End If
                        Case "TMDS.SwitchComponents.Switch"
                            If comp.Name = trk.Name Then
                                If Not CompList.Contains(comp) Then
                                    CompList.Add(comp)
                                End If
                            End If
                    End Select
                Next
                Dim swList As New ArrayList()

                For Each comp In CompList
                    Dim LeftSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(comp.LeftLink)
                    Dim RightSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(comp.RightLink)
                    If Not IsNothing(LeftSw) Then
                        If Not swList.Contains(LeftSw) Then
                            swList.Add(LeftSw)
                        End If
                    End If

                    If Not IsNothing(RightSw) Then
                        If Not swList.Contains(RightSw) Then
                            swList.Add(RightSw)
                        End If
                    End If
                Next

                For Each comp In swList
                    CompList.Add(comp)
                Next

                Return CompList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindLikeOSCompInCP(ByVal cp As ControlPoint, ByVal trk As Track) As ArrayList
            'This function finds the current trackcomponent index from the global unique ID
            Dim comp As Object
            If Not trk.OStype Then
                Return Nothing
            End If
            Dim CompList As New ArrayList()
            Try
                For Each comp In cp.AssignedComponenets
                    Select Case comp.GetType.ToString
                        Case "TMDS.TrackComponents.Track"
                            If comp.TrackName = trk.TrackName Then
                                Dim tk As Track = CType(comp, Track)
                                If Mid(tk.AuthorityType, 1, 3) = "TWC" Then
                                    If tk.Name = trk.Name Then
                                        If Not CompList.Contains(comp) Then
                                            CompList.Add(comp)
                                        End If
                                    End If
                                Else
                                    Dim ContinueToAddComponent As Boolean = True
                                    If optAllowDeviceBlockOnSameNamedTrackOnly And comp.Name <> trk.Name Then
                                        ContinueToAddComponent = False
                                    End If
                                    If ContinueToAddComponent Then
                                        If comp.OStype Then
                                            If Not CompList.Contains(comp) Then
                                                CompList.Add(comp)
                                                Dim LeftSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(comp.LeftLink)
                                                Dim RightSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(comp.RightLink)
                                                If Not IsNothing(LeftSw) Then
                                                    If Not CompList.Contains(LeftSw) Then
                                                        CompList.Add(LeftSw)
                                                    End If
                                                End If
                                                If Not IsNothing(RightSw) Then
                                                    If Not CompList.Contains(RightSw) Then
                                                        CompList.Add(RightSw)
                                                    End If
                                                End If

                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        Case "TMDS.SwitchComponents.Switch"
                            If comp.TrackName = trk.TrackName Then
                                Dim sw As Switch = CType(comp, Switch)
                                If sw.TypeOfSwitch <> "SPM ONLY" Then
                                    If Mid(sw.AuthorityType, 1, 3) = "TWC" Then
                                        If sw.RightLink = trk.GUID Then
                                            If Not CompList.Contains(comp) Then
                                                CompList.Add(comp)
                                            End If
                                        End If
                                    Else
                                        If Not optAllowDeviceBlockOnSameNamedTrackOnly Then
                                            If Not CompList.Contains(comp) Then
                                                CompList.Add(comp)
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                    End Select
                Next
                Return CompList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

