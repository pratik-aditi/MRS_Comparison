            Dim NextComp As Object = Nothing

            Dim Firsttrk As Track = Nothing
            Dim Lasttrk As Track = Nothing
            Dim RightComp As Object = Nothing
            Dim LeftComp As Object = Nothing


            Dim LinkedTrkSegements As New ArrayList
            Dim PTCSegements As New ArrayList
            Dim TrkUIDCollection As New ArrayList
            Dim isAlltrackTB As Boolean = False
            Try
                Decimal.TryParse(MilePostBegin, LowMP)
                Decimal.TryParse(MilePostEnd, HighMP)
                Dim tempArray As New Collection
                For Each comp In AuthComponents
                    Dim compSort As New clsCompSort
                    Select Case comp.GetType.ToString
                        Case gTrackComponentName
                            If Not comp.TurnOutType Then
                                With compSort
                                    .myUID = comp.GUID
                                    .MilePost = comp.LeftLimitMilePost
                                    .myType = gTrackComponentName
                                    tempArray.Add(compSort)
                                End With
                            End If
                        Case gSwitchComponentName
                            'With compSort
                            '    .myUID = comp.GUID
                            '    .MilePost = comp.MilePost
                            '    .myType = gSwitchComponentName
                            '    tempArray.Add(compSort)
                            'End With
                    End Select
                Next
                SortCollection(tempArray, "MilePost", False)
                Dim compSort1 As clsCompSort
                For Each compSort1 In tempArray
                    For Each comp In AuthComponents
                        If comp.GUID = compSort1.myUID Then
                            If Not MyTrackCollection.Contains(comp) Then MyTrackCollection.Add(comp)
                            Exit For
                        End If
                    Next
                Next



                dtTrack = DefineDataTables.DefinePTCTracktable()
                If MyTrackCollection IsNot Nothing AndAlso MyTrackCollection.Count > 0 Then
                    For Each trk In MyTrackCollection
                        If trk IsNot Nothing AndAlso Not trk.TurnOutType Then
                            drow = dtTrack.NewRow

                            drow("UID") = trk.GUID
                            drow("TrkName") = trk.TrackName.ToUpper.Trim
                            Select Case trk.TrackNameAlias.ToUpper.Trim
                                Case "", "NOTHING", "NONE"
                                    drow("TrkNameAlias") = trk.TrackName.ToUpper.Trim
                                    If Not MyAllTrackNames.Contains(trk.TrackName.ToUpper.Trim) Then MyAllTrackNames.Add(trk.TrackName.ToUpper.Trim)
                                Case Else
                                    drow("TrkNameAlias") = trk.TrackNameAlias.ToUpper.Trim
                                    If Not MyAllTrackNames.Contains(trk.TrackNameAlias.ToUpper.Trim) Then MyAllTrackNames.Add(trk.TrackNameAlias.ToUpper.Trim)
                            End Select


                            drow("FormattedTrkName") = trk.TrackName.ToUpper.Replace("TRACK", "").Trim
                            If trk.sAlternateTrackNames.Trim <> "" Then
                                Dim names() As String = trk.sAlternateTrackNames.Split("|")
                                If names.GetUpperBound(0) > 0 Then
                                    drow("AltTrackNames") = names(0).ToUpper.Trim
                                    drow("FormattedTrkName") = names(0).ToUpper.Trim
                                End If

                            End If
                            drow("LeftMP") = trk.LeftLimitMilePost
                            drow("RightMP") = trk.RightLimitMilePost
                            drow("LeftLink") = trk.LeftLink
                            drow("RightLink") = trk.RightLink
                            If trk.EnableNonControlledSiding Then
                                drow("IsMain") = False
                            End If
                            dtTrack.Rows.Add(drow)
                            dtTrack.AcceptChanges()
                        End If
                    Next
                Else
                    SegmentString = New StringBuilder
                    Exit Sub
                End If

                Dim TrkNames() As String = theTrackName.Split("|")

                If theTrackName.ToUpper.Trim = "ALL TRACKS" Then
                    Dim Alltrks As String = ""
                    Dim FirstAll As Boolean = True
                    isAlltrackTB = True
                    For Each S In MyAllTrackNames
                        If S.Trim <> "" Then
                            If FirstAll Then
                                Alltrks = S.Trim
                                FirstAll = False
                            Else
                                Alltrks = Alltrks & "|" & S.Trim
                            End If
                        End If
                    Next
                    TrkNames = Alltrks.Split("|")
                End If

                PTCTrkName = theTrackName
                If TrkNames IsNot Nothing Then
                    For Each S In TrkNames
                        If S.Trim <> "" Then
                            Dim dv As DataView = New DataView(dtTrack)
                            dv.RowFilter = ""
                            If Not isAlltrackTB Then
