        Public Shared Function BetweenNumbers(ByVal LowMP As Decimal, ByVal LowMPPrefix As String, ByVal LowMPSuffix As String,
                                              ByVal HighMP As Decimal, ByVal HighMPPrefix As String, ByVal HighMPSuffix As String,
