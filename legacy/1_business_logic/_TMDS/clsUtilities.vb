#Region "DATABASE EVENT LOG METHODS"

    Public Class AdministrativeEvent

        Public Shared Sub LogAdminEvent(EventData As String, EventType As String, EventSubType As String, MethodName As String)
            Try
                If Not optEnableAdminEventLogging Then Exit Sub
                Dim Insert As New StringBuilder
                With Insert
                    .Append(" INSERT INTO tblSystemAdminEvents")
                    .Append(" (")
                    .Append(" EventTimeStamp, EventType, EventSubType, EventNodeUID, EventNodeName, EventNodeType, EventUserUID, EventData")
                    .Append(" )")
                    .Append(" VALUES")
                    .Append(" (")
                    .Append(" '" & Now & "'")
                    .Append(", '" & EventType & "'")
                    .Append(", '" & EventSubType & "'")
                    .Append(", " & gThisWorkstation.WrkStnNumber)
                    .Append(", '" & gThisWorkstation.Name & "'")
                    .Append(", 'DISPATCHER WORKSTATION'")
                    .Append(", '" & SpclToEsc(gCurrentUser.UserFullName) & "'")
                    .Append(", '" & SpclToEsc(EventData) & "'")
                    .Append(" )")

                End With

                Dim AdminEvent As New DatabaseItem(MethodName, Insert.ToString)

                SyncLock gDatabaseAdminEventQueue
                    gDatabaseAdminEventQueue.Enqueue(AdminEvent)
                End SyncLock

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

        End Sub

    End Class
#End Region

#Region "APPLICATION EXCEPTION TRACKING"

    Public Class ApplicationExceptionTrace

        Public Shared Sub LogApplicationException(theException As String)
            Try
                Dim ExceptionFound As Boolean
                SyncLock gApplicationExceptionList
                    Dim ae As ApplicationException
                    For Each ae In gApplicationExceptionList
                        If ae.myExceptionString = theException Then
                            ExceptionFound = True
                            ae.myCounter += 1
                            ae.myTimeStamp = Now
                            If ae.myCounter = gApplicationExceptionThreshold Then
                                TMDS.SystemUtilities.AdministrativeEvent.LogAdminEvent(theException, "EXCEPTION", "EXCESSIVE", "LogApplicationExceptionToDatabase")
                            End If
                        End If
                    Next
                    If Not ExceptionFound Then
                        Dim exp As New ApplicationException
                        exp.myTimeStamp = Now
                        exp.myCounter = 1
                        exp.myExceptionString = theException
                        gApplicationExceptionList.Add(exp)
                    End If

                End SyncLock
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Public Shared Sub PrintApplicationExceptionList()
            Try
                SyncLock gApplicationExceptionList
                    Dim ae As ApplicationException
                    For Each ae In gApplicationExceptionList
                        SystemEvent("APP-EXP: <Count=" & ae.myCounter.ToString.PadLeft(3, "0") & "> <" & ae.myExceptionString & ">")
                    Next
                End SyncLock

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

    End Class
