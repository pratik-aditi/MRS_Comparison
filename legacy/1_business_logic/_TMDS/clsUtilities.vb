        Friend Shared Function CheckIfTNTExistsInDB(ByVal AuthGUID As String) As Boolean
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Try
                Dim SQLQuery As String = "Select AuthGUID from tblAuthoritiesActive where  AuthGUID = '" & AuthGUID & "'"
                SystemEvent("CheckIfTNTExistsInDB:SQL=" & SQLQuery)
                Using dbconn As New OleDbConnection(gConnectionStringDynamic)
                    dbconn.Open()
                    dbComm = New OleDbCommand(SQLQuery, dbconn)
                    dr = dbComm.ExecuteReader
                    If dr.HasRows Then Return True
                    dr.Close()
                    dbconn.Close()

                End Using
                Return False
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                dr = Nothing
            End Try
        End Function

