                        ''RMT ARRC-1910
                        'If dr.FieldCount >= 66 Then
                        '    If Not dr.IsDBNull(65) Then
                        '        Dim TempSwitchStr As String = ""
                        '        TempSwitchStr = dr.GetValue(65)
                        '        If Not String.IsNullOrEmpty(TempSwitchStr) AndAlso TempSwitchStr.Trim <> "" Then
