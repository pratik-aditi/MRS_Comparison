        Public Shared Sub GetHighLow_MilepostFromCollection(ByRef HighMile As Decimal, ByRef HighMilePreFix As String, ByRef HighMileSufFix As String, ByRef LowMile As Decimal,
                                                      ByRef LowMilePreFix As String, ByRef LowMileSufFix As String, CompCollection As ArrayList)
            Try
                Dim tempArray As New Collection
                Dim Comp As Object = Nothing
                Dim Med As New ArrayList

                For Each Comp In CompCollection
                    Dim compSort As New clsCompSort
                    Select Case Comp.GetType.ToString
                        Case gTrackComponentName
                            Med.Add(Comp.GUID & "|" & Comp.LeftLimitMilePost & "|" & Comp.RightLimitMilePost)
                            'If Not Comp.TurnOutType Then
                            With compSort
                                .myUID = Comp.GUID
                                .MilePost = Comp.LeftLimitMilePost
                                .myType = gTrackComponentName
                                .Suffix = Comp.MilePostSuffix.ToUpper.Trim
                                .Prefix = Comp.MilePostPrefix.ToUpper.Trim
                                tempArray.Add(compSort)
                            End With
                            compSort = New clsCompSort
                            With compSort
                                .myUID = Comp.GUID
                                .MilePost = Comp.RightLimitMilePost
                                .myType = gTrackComponentName
                                .Suffix = Comp.MilePostSuffix.ToUpper.Trim
                                .Prefix = Comp.MilePostPrefix.ToUpper.Trim
                                tempArray.Add(compSort)
                            End With
                            'End If
                        Case gSwitchComponentName
                    End Select
                Next
                SortCollection(tempArray, "MilePost", False)
                Dim FirstMP As clsCompSort
                Dim LastMP As clsCompSort
                FirstMP = tempArray(1)
                LastMP = tempArray(tempArray.Count)

                HighMile = FirstMP.MilePost
                HighMilePreFix = FirstMP.Prefix.Trim
                HighMileSufFix = FirstMP.Suffix.Trim

                LowMile = LastMP.MilePost
                LowMileSufFix = LastMP.Suffix.Trim
                LowMilePreFix = LastMP.Prefix.Trim


            Catch ex As Exception

            End Try
        End Sub

