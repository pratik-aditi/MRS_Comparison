        Public Shared Function GetFirstOrLastSFAAuthority(ByVal trn As TrainID, Optional ByVal FirstAuthority As Boolean = True) As TMDS.TrackAuthority.SFAuthority
            Dim SFA As TMDS.TrackAuthority.SFAuthority = Nothing
            Dim Auth As Object = Nothing
            Dim TempDt As New DataTable
            Dim dvSFA As New DataView
            Dim col1 As DataColumn
            Try
                col1 = New DataColumn("SFAGUID")
                col1.DataType = System.Type.GetType("System.String")
                TempDt.Columns.Add(col1)

                col1 = New DataColumn("SFADate")
                col1.DataType = System.Type.GetType("System.DateTime")
                TempDt.Columns.Add(col1)


                For Each Auth In OtherTrackAuthorities
                    If Auth.GetType.ToString = gSFAComponentName Then
                        If Auth.TrainSymbol.Trim.ToUpper = trn.Name.Trim.ToUpper Then
                            Dim drow As DataRow = TempDt.NewRow
                            drow("SFAGUID") = Auth.AuthGUID
                            drow("SFADate") = Auth.AuthDate
                            TempDt.Rows.Add(drow)
                            TempDt.AcceptChanges()
                        End If
                    End If
                Next
                If TempDt IsNot Nothing AndAlso TempDt.Rows.Count > 0 Then
                    dvSFA = New DataView(TempDt)
                    dvSFA.RowFilter = ""
                    If FirstAuthority Then
                        dvSFA.Sort = "SFADate"
                        SFA = FindSFAByGUID(dvSFA(0)("SFAGUID"))
                    Else
                        dvSFA.Sort = "SFADate DESC"
                        SFA = FindSFAByGUID(dvSFA(0)("SFAGUID"))
                    End If
                Else
                    If FirstAuthority AndAlso SFA IsNot Nothing Then
                        SFA = GetFirstTWCAuthority(trn.Name)
                    Else
                        SFA = GetLastTWCAuthority(trn.Name)
                    End If
                End If
                Return SFA
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            Finally
                Auth = Nothing
                TempDt = Nothing
                dvSFA = Nothing
            End Try
            Return Nothing
        End Function

        ''' <summary>
        ''' GET THE LAST SFA AUTHORITY BASED ON TRAIN SYMBOL
        ''' </summary>
        ''' <param name="pSymbol"></param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared Function GetLastTWCAuthority(ByVal pSymbol As String) As TMDS.TrackAuthority.SFAuthority
            Dim LastSfa As TMDS.TrackAuthority.SFAuthority = Nothing
            Dim SFA As TMDS.TrackAuthority.SFAuthority = Nothing
            Dim Auth As Object = Nothing
            Dim ThisTrainsAuthorities As New ArrayList
            Try
                SystemEvent("GetLastTWCAuthority:Train=" & pSymbol)
                For Each Auth In OtherTrackAuthorities
                    If Auth IsNot Nothing AndAlso Auth.GetType.ToString = gSFAComponentName Then
                        If Auth.TrainSymbol IsNot Nothing AndAlso Auth.TrainSymbol.Trim.ToUpper = pSymbol.Trim.ToUpper Then
                            If Not ThisTrainsAuthorities.Contains(Auth) Then ThisTrainsAuthorities.Add(Auth)
                        End If
                    End If
                Next
                If ThisTrainsAuthorities Is Nothing Then Return Nothing
                If ThisTrainsAuthorities.Count = 0 Then Return Nothing
                If ThisTrainsAuthorities.Count = 1 Then Return ThisTrainsAuthorities(0)
                For i As Integer = 0 To ThisTrainsAuthorities.Count + 1
                    For Each SFA In ThisTrainsAuthorities
                        If LastSfa Is Nothing Then
                            LastSfa = SFA
                        Else
                            If LastSfa.AuthDate < SFA.AuthDate Then
                                LastSfa = SFA
                            End If
                        End If
                    Next
                Next
                Return LastSfa
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            Finally
                SFA = Nothing
                Auth = Nothing
                ThisTrainsAuthorities = Nothing
            End Try
            Return Nothing
        End Function

