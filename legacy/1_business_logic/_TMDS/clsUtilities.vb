        ''' <summary>
        ''' Creates the SQL String and calls the Retrieval Function for the database.
        ''' </summary>
        ''' <param name="SubName">Flag to determine what to filter.</param>
        ''' <returns>Generic List of SubBulletin.</returns>
        ''' <remarks>WGROH:  Added for KCS Bulletin Filter</remarks>
        Public Shared Function LoadSubBulletinsBySubName(ByVal SubName As String) As System.Collections.Generic.List(Of SubBulletin)
            Dim subBulletinList As New System.Collections.Generic.List(Of SubBulletin)
            Dim MissingSBQueryBldr As New StringBuilder
            MissingSBQueryBldr.Append("SELECT RestrictionSubName, RestrictionUID, SubType, RestrictionDate, MilePostBegin, MilePostEnd, TrackName, TimeFrom, TimeUntil, Comments, RestrictionData FROM tblSystemBulletins")

            ' load only the bulletins for the selected subdivision
            If SubName <> String.Empty Then MissingSBQueryBldr.Append(" WHERE RestrictionSubName = '" & SubName & "'")

            Try
                Dim table As DataTable = TMDS.SystemUtilities.DefineDataTables.GetDynamicSQLData(MissingSBQueryBldr.ToString)
                Dim subBulletin As SubBulletin

                For Each row As DataRow In table.Rows
                    subBulletin = New SubBulletin()

                    With subBulletin
                        ' subdivision Name
                        .SubName = row("RestrictionSubName")
                        ' bulletin UID
                        .myUID = row("RestrictionUID")
                        ' bulletin Type
                        .mysTypeForm = row("SubType")
                        ' bulletin Effective Date
                        .EffectTime = row("RestrictionDate")
                        ' bulletin Information
                        .MilePostBegin = row("MilePostBegin")
                        .MilePostEnd = row("MilePostEnd")
                        .TrackName = row("TrackName")
                        .TimeFrom = row("TimeFrom")
                        .TimeUntil = row("TimeUntil")
                        .Comments = row("Comments")

                        Dim data() As String = row("RestrictionData").ToString.Split("|")
                        If data.Length >= 1 Then .Location = data(0)
                    End With

                    subBulletinList.Add(subBulletin)
                Next


            Catch ex As Exception
                GetErrorDetails(ex)

            End Try

            Return subBulletinList
        End Function

