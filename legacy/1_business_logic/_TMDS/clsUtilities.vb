                                                                    If sb.mysTypeForm = "FORMA" And Not trk.HatchItWorkZone Then
                                                                        OsComp.HatchItSpeed = True
                                                                    ElseIf sb.mysTypeForm = "FORMF" And Not trk.HatchItWorkZone Then
                                                                        OsComp.HatchItInformational = True
                                                                    ElseIf sb.mysTypeForm = "FORMB" Then
                                                                        OsComp.HatchItWorkZone = True
                                                                    ElseIf sb.mysTypeForm = "FORM O" Then
                                                                        OsComp.HatchItFormO = True
                                                                    End If
                                                                End If
                                                            End If
                                                        End If
                                                    Next
