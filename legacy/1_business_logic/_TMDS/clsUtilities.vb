                    dbconn.Dispose()
                End If
                If Not dr Is Nothing Then
                    dr.Close()
                    dr = Nothing
                End If
                If Not dbcomm Is Nothing Then
                    dbcomm.Dispose()
                    dbcomm = Nothing
                End If
            End Try
        End Function

        Public Shared Function FetchSubdivisionStationsFromTrack_DB(ByVal TrackGUID As String) As ArrayList
            Dim subdvn As Subdivision = Nothing
            Dim Stat As SubdivisionStation = Nothing
            Dim StationList As New Generic.List(Of TMDS.ManagementClasses.SubdivisionStation)
            Dim tmpArraylist As New ArrayList
            Dim dr As OleDbDataReader = Nothing
            Dim DBComm As OleDbCommand = Nothing
            Try
                Dim iTrackGUID As Integer = 0
                Integer.TryParse(TrackGUID, iTrackGUID)
                If iTrackGUID > 0 Then
                    Dim SQLQuery As String = "SELECT  [UID],[ControlPoint],[Name],[Type],[OrderIndex],[ReportingUID] FROM [tblSystemSubdivisionStations] where ControlPoint IN (SELECT ControlPoint FROM [tblCompTracks] WHERE UID=" & iTrackGUID & ")"

                    Using dbConn As New OleDbConnection(gConnectionStringStatic)
                        dbConn.Open()
                        DBComm = New OleDbCommand(SQLQuery, dbConn)
                        dr = DBComm.ExecuteReader
                        If dr.HasRows Then
                            While dr.Read
                                Dim nStat As New SubdivisionStation
                                With nStat
                                    .GUID = dr.GetValue(0)
                                    .ControlPointUID = dr.GetValue(1)
                                    .Name = dr.GetValue(2)
                                    .TypeOp = dr.GetValue(3)
                                    .OrderIndex = dr.GetValue(4)
                                    .ReportingUID = dr.GetValue(5)
                                End With
                                StationList.Add(nStat)
                            End While
                            dr.Close()
                            dbConn.Close()
                        End If
                    End Using



                End If
                If StationList IsNot Nothing AndAlso StationList.Count > 1 Then
                    StationList.Sort(Function(x, y) x.OrderIndex.CompareTo(y.OrderIndex))
                End If
                If StationList IsNot Nothing AndAlso StationList.Count > 0 Then
                    For Each Stat In StationList
                        If Not tmpArraylist.Contains(Stat) Then tmpArraylist.Add(Stat)
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If DBComm IsNot Nothing Then DBComm.Dispose()
                DBComm = Nothing
                dr = Nothing
            End Try
            Return tmpArraylist
        End Function

        Public Shared Function FindSubdivisionStationsFromTrack(ByVal Trk As Track) As ArrayList
            Dim subdvn As Subdivision = Nothing
            Dim Stat As SubdivisionStation = Nothing
            Dim StationList As New Generic.List(Of TMDS.ManagementClasses.SubdivisionStation)
            Dim tmpArraylist As New ArrayList
            Try
                If Trk IsNot Nothing AndAlso Trk.myControlPoint.mySubdivisionStation IsNot Nothing Then
                    For Each subdvn In TMDS.GlobalDeclarations.ControlledSubdivisions
                        If subdvn.Stations IsNot Nothing AndAlso subdvn.Stations.Count > 0 Then
                            For Each Stat In subdvn.Stations
                                If Stat.ControlPointUID = Trk.myControlPoint.GUID Then
                                    If Not StationList.Contains(Stat) Then StationList.Add(Stat)
                                End If
                            Next
                        End If
                    Next
                End If
                If StationList IsNot Nothing AndAlso StationList.Count > 1 Then
                    StationList.Sort(Function(x, y) x.OrderIndex.CompareTo(y.OrderIndex))
                End If
                If StationList IsNot Nothing AndAlso StationList.Count > 0 Then
                    For Each Stat In StationList
                        If Not tmpArraylist.Contains(Stat) Then tmpArraylist.Add(Stat)
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return tmpArraylist
        End Function

        Public Shared Function FindCntrlPointFromSubdivisionStation(ByVal StatName As String) As String
            Dim subdvn As Subdivision = Nothing
            Dim Stat As SubdivisionStation = Nothing
            Try
                For Each subdvn In TMDS.GlobalDeclarations.ControlledSubdivisions
                    If subdvn.Stations IsNot Nothing AndAlso subdvn.Stations.Count > 0 Then
                        For Each Stat In subdvn.Stations
                            If Stat.Name.Trim.ToUpper = StatName.Trim.ToUpper OrElse Stat.ReportingUID.Trim.ToUpper = StatName.Trim.ToUpper Then
