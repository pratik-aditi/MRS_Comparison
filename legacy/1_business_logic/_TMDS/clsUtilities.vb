        Public Shared Function GetTGBOMileageRanges(tgb As TabularGeneralBulletin) As ArrayList
            Dim mr As MileageRange = Nothing
            Dim TGBOMr As New MileageRange
            Dim TGBOMRList As New ArrayList
            '   '1052;MCCOMB;21;MCCOMB;737;;727.2;;;|1096;YAZOO;15;YAZOO;218.6;;120;;;
            'mr.myUID & ";" & mr.myName & ";" & mr.mySubdivisionUID & ";" & mr.mySubdivisionName & ";" & mr.LeftMileage & ";" & mr.LeftMileageSuffix & ";" & mr.RightMileage & ";" & mr.RightMileageSuffix & ";" & mr.LeftMileagePrefix.Trim & ";" & mr.RightMileagePrefix.Trim
            Try
                Dim ranges() As String = tgb.MileageRangeListDefinitions.Split("|")
                Dim range As String
                For Each range In ranges
                    Dim data() As String = range.Split(";")
                    If data IsNot Nothing AndAlso data.Length > 8 Then
                        mr = Nothing
                        mr = FindMileageRangeByUID(data(0))
                        If mr IsNot Nothing Then
                            TGBOMr = New MileageRange
                            With TGBOMr
                                .myUID = mr.myUID
                                .mySubdivisionUID = mr.mySubdivisionUID
                                .mySubdivisionName = mr.mySubdivisionName
                                Double.TryParse(data(4), .LeftMileage)
                                Double.TryParse(data(6), .RightMileage)
                                .RightMileageSuffix = data(7).Trim
                                .LeftMileageSuffix = data(5).Trim
                                .LeftMileagePrefix = data(8).Trim
                                .RightMileageSuffix = data(9).Trim
                            End With
                            If TGBOMr IsNot Nothing Then
                                If Not TGBOMRList.Contains(TGBOMr) Then TGBOMRList.Add(TGBOMr)
                            End If
                        End If
                    End If
                Next
                If TGBOMRList IsNot Nothing AndAlso TGBOMRList.Count > 0 Then Return TGBOMRList
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return Nothing
        End Function


