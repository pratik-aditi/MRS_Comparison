                                            auth.SetPTCSTatusSelectionMode()
                                        End If
                                    End If
                                End If
                            End If
                        End If

                        If dr.FieldCount >= 46 Then
                            If Not dr.IsDBNull(45) Then
                                'String format TBD 
                                auth.LimitsInfo = dr.GetString(45)
                            End If
                        End If

                        If dr.FieldCount >= 47 Then
                            If Not dr.IsDBNull(46) Then
                                'Symbol|EngineID|Direction|Location;
                                auth.BehindTrainsInfo = dr.GetString(46)
                            End If
                        End If
                        If dr.FieldCount >= 48 Then
