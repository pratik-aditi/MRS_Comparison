        Public Shared Function FetchSystemWideBulletin() As ArrayList
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim SWB As New ArrayList
            Try
                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    dbcomm = New OleDbCommand("SELECT * FROM tblsystemBulletins WHERE SystemWideBulletin=1 and SubType='FORM F' ORDER BY RestrictionDate", DbConn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read

                        Dim TypeOfBull As String = String.Empty
                        Dim LoadBulletin As Boolean = True


                        Dim sb As New SubBulletin
                        sb.thisSubdivision = Nothing
                        If Not dr.IsDBNull(0) Then sb.myGUID = dr.GetString(0)
                        If Not dr.IsDBNull(1) Then sb.myUID = dr.GetInt32(1)
                        If Not dr.IsDBNull(2) Then sb.theType = dr.GetString(2)
                        Dim createDate As Date
                        If Not dr.IsDBNull(3) Then
                            Date.TryParse(dr.GetDateTime(3), createDate)
                            sb.Created = createDate
                        End If


                        Select Case sb.theType
                            Case "CANCEL"
                                sb.myType = BulletinType.CANCEL
                                sb.mysType = "CANCEL"
                            Case "SPEED", "SPEED RESTRICTION"
                                sb.myType = BulletinType.SPEED
                                sb.mysType = "SPEED"
                            Case "WORKZONE"
                                sb.myType = BulletinType.WORKZONE
                                sb.mysType = "WORKZONE"
                            Case "INFORMATIONAL"
                                sb.myType = BulletinType.INFORMATIONAL
                                sb.mysType = "INFORMATIONAL"
                            Case "CONDITION"
                                sb.myType = BulletinType.CONDITION
                                sb.mysType = "CONDITION"
                        End Select
                        If Not dr.IsDBNull(3) Then sb.EffectTime = dr.GetDateTime(3)
                        If Not dr.IsDBNull(3) Then sb.Created = dr.GetDateTime(3)
                        If Not dr.IsDBNull(5) Then sb.SubName = dr.GetString(5)
                        If Not dr.IsDBNull(6) Then sb.myData = dr.GetString(6)
                        If Not dr.IsDBNull(7) Then sb.myDataSupplement = dr.GetString(7)
                        If Not dr.IsDBNull(8) Then sb.BullUID = dr.GetString(8)
                        If Not dr.IsDBNull(9) Then sb.MilePostBegin = dr.GetString(9)
                        If Not dr.IsDBNull(10) Then sb.MilePostEnd = dr.GetString(10)
                        If Not dr.IsDBNull(11) Then sb.TrackType = dr.GetString(11)
                        If Not dr.IsDBNull(12) Then sb.TrackName = dr.GetString(12)
                        If Not dr.IsDBNull(13) Then sb.MessageTrnFrght = dr.GetString(13)
                        If Not dr.IsDBNull(15) Then sb.MessageTrnPassg = dr.GetString(15)
                        If Not dr.IsDBNull(14) Then sb.SpeedFrght = dr.GetInt32(14)
                        If Not dr.IsDBNull(16) Then sb.SpeedPassg = dr.GetInt32(16)
                        If Not dr.IsDBNull(17) Then sb.Creator = Trim(dr.GetString(17))
                        If Not dr.IsDBNull(19) Then sb.TerrUID = dr.GetInt32(19)
                        If Not dr.IsDBNull(21) Then sb.Cause = Trim(dr.GetString(21)).ToUpper
                        If Not dr.IsDBNull(21) Then sb.Instructions = Trim(dr.GetString(21)) '.ToUpper


                        If dr.FieldCount >= 33 Then
                            If Not dr.IsDBNull(22) Then sb.MilePostBeginSuffix = Trim(dr.GetString(22)).ToUpper
                            If Not dr.IsDBNull(23) Then sb.MilePostEndSuffix = Trim(dr.GetString(23)).ToUpper
                            If Not dr.IsDBNull(24) Then sb.mysTypeForm = Trim(dr.GetString(24)).ToUpper
                            Select Case sb.mysTypeForm
                                Case "FORMA"
                                    sb.myTypeForm = BulletinFormType.FORMA
                                Case "FORMB"
                                    sb.myTypeForm = BulletinFormType.FORMB
                                    Dim data() As String = sb.myData.Split("|")
                                    If data.Length >= 3 Then
                                        sb.Action = data(0)
                                        sb.Foreman = data(1)
                                        sb.Gang = data(2)
                                    End If
                                Case "FORMC"
                                    sb.myTypeForm = BulletinFormType.FORMC
                                Case "FORMTC"
                                    sb.myTypeForm = BulletinFormType.FORMTC
                                    Dim data() As String = sb.myData.Split("|")
                                    If data.Length >= 2 Then
                                        sb.Location = data(0)
                                        sb.PersonPostingBulletin = data(1)
                                    End If
                                Case "1102"
                                    sb.myTypeForm = BulletinFormType.FORMB
                                    If sb.myData <> "" Then
                                        Dim data() As String = sb.myData.Split("|")
                                        If data.Length >= 3 Then
                                            sb.Foreman = data(1)
                                        End If
                                    End If
                                Case "1103"
                                    sb.myTypeForm = BulletinFormType.FORMA
                                Case "C-1102", "C-1103", "C-MISC"
                                    sb.myTypeForm = BulletinFormType.CANCEL
                                Case "MISC"
                                    sb.myTypeForm = BulletinFormType.FORMTC

                                Case "FORM D"
                                    sb.myTypeForm = BulletinFormType.FORMA
                                Case "FORM X"
                                    sb.myTypeForm = BulletinFormType.FORMX
                                    Dim data() As String = sb.myData.Split("|")
                                    If data.Length >= 3 Then
                                        sb.Action = data(0)
                                        sb.Foreman = data(1)
                                        sb.Gang = data(2)
                                    End If
                                Case "FORM F"
                                    sb.myTypeForm = BulletinFormType.FORMF
                                    sb.SystemWideBulletin = True
                                    Dim data() As String = sb.myData.Split("|")
                                    If data.Length >= 3 Then
                                        sb.Action = data(0)
                                        sb.Foreman = data(1)
                                        sb.Gang = data(2)
                                    End If
                                Case "FORM O"
                                    sb.myTypeForm = BulletinFormType.FORMO
                                    Dim data() As String = sb.myData.Split("|")
                                    If data.Length >= 3 Then
                                        sb.Action = data(0)
                                        sb.Foreman = data(1)
                                        sb.Gang = data(2)
                                    End If
                                Case "FORM TT"
                                    sb.myTypeForm = BulletinFormType.FORMTT
                                Case "FORM FF"
                                    sb.myTypeForm = BulletinFormType.FORMFF

                            End Select

                            If Not dr.IsDBNull(25) Then sb.SubUID = Trim(dr.GetString(25)).ToUpper
                            If Not dr.IsDBNull(26) Then sb.FlagData = Trim(dr.GetString(26)).ToUpper
                            Dim Flags() As String = sb.FlagData.Split("|")
                            Dim f As String
                            Dim FlagCount As Integer = 0
                            Try
                                For Each f In Flags
                                    Dim data() As String = f.Split(";")
                                    FlagCount += 1
                                    If FlagCount = 1 Then
                                        If data.Length = 2 Then
                                            sb.FlagMilePostBegin1 = data(0)
                                            sb.FlagMilePostBeginSuffix1 = data(1)
                                        End If
                                    ElseIf FlagCount = 2 Then
                                        If data.Length = 2 Then
                                            sb.FlagMilePostEnd1 = data(0)
                                            sb.FlagMilePostEndSuffix1 = data(1)
                                        End If
                                    End If
                                Next
                            Catch ex As Exception
                                GetErrorDetails(ex)
                            End Try


                            If Not dr.IsDBNull(27) Then sb.Comments = Trim(dr.GetString(27)).ToUpper
                            If Not dr.IsDBNull(28) Then sb.Direction = Trim(dr.GetString(28)).ToUpper
                            If Not dr.IsDBNull(29) Then sb.TimeFrom = Trim(dr.GetDateTime(29)).ToUpper
                            If Not dr.IsDBNull(30) Then sb.TimeUntil = Trim(dr.GetDateTime(30)).ToUpper
                            If Not dr.IsDBNull(31) Then sb.Daily = Trim(dr.GetBoolean(31)).ToUpper
                            If Not dr.IsDBNull(32) Then sb.DisplayIndex = Trim(dr.GetByte(32)).ToUpper

                            'If Not dr.IsDBNull(33) Then sb.EffectTime = Trim(dr.GetDateTime(33))
                            If Not dr.IsDBNull(34) Then sb.CorrelatingTagUID = Trim(dr.GetString(34))

                            If Not dr.IsDBNull(35) Then sb.FlagMilePostBegin1SubUID = Trim(dr.GetInt32(35))
                            If Not dr.IsDBNull(36) Then sb.FlagMilePostBegin1 = Trim(dr.GetDouble(36))
                            If Not dr.IsDBNull(37) Then sb.FlagMilePostBeginSuffix1 = Trim(dr.GetString(37))

                            If Not dr.IsDBNull(38) Then sb.FlagMilePostEnd1SubUID = Trim(dr.GetInt32(38))
                            If Not dr.IsDBNull(39) Then sb.FlagMilePostEnd1 = Trim(dr.GetDouble(39))
                            If Not dr.IsDBNull(40) Then sb.FlagMilePostEndSuffix1 = Trim(dr.GetString(40))

                            '************************************** FLAG DATA BEGIN***************************
                            ProcessBullFlagDataRead(dr, sb, "BulletinFunction_FetchSystemWideBulletin")
                            '************************************** FLAG DATA END***************************

                            If dr.FieldCount >= 55 Then
                                If Not dr.IsDBNull(53) Then sb.myStatus = Trim(dr.GetString(53))
                                If Not dr.IsDBNull(54) Then sb.ConfirmationData = Trim(dr.GetString(54))
                            End If

                            If dr.FieldCount >= 60 Then
                                If Not dr.IsDBNull(55) Then sb.MileRangeGUID1 = Trim(dr.GetString(55))
                                If Not dr.IsDBNull(56) Then sb.MileRangeGUID2 = Trim(dr.GetString(56))
                                If Not dr.IsDBNull(57) Then sb.MileRangeGUID3 = Trim(dr.GetString(57))
                                If Not dr.IsDBNull(58) Then sb.MileRangeGUID4 = Trim(dr.GetString(58))
                                Dim ExceptionList As String = String.Empty
                                If Not dr.IsDBNull(59) Then ExceptionList = Trim(dr.GetString(59))
                                sb.myExceptionList = CreateExceptionList(ExceptionList, sb)
                            End If
                            If dr.FieldCount >= 89 Then '67 to 84

                                If Not dr.IsDBNull(66) Then sb.SubdivisionFromUID = Trim(dr.GetInt32(66))
                                If Not dr.IsDBNull(67) Then sb.SubdivisionFromName = Trim(dr.GetString(67))
                                If Not dr.IsDBNull(68) Then sb.SubdivisionFromUID = Trim(dr.GetInt32(68))
                                If Not dr.IsDBNull(69) Then sb.SubdivisionFromName = Trim(dr.GetString(69))

                                If Not dr.IsDBNull(70) Then sb.PersonRequesting = Trim(dr.GetString(70))

                                If Not dr.IsDBNull(71) Then sb.DispatchPointFromUID = Trim(dr.GetInt32(71))
                                If Not dr.IsDBNull(72) Then sb.DispatchPointFromName = Trim(dr.GetString(72))
                                If Not dr.IsDBNull(73) Then sb.DispatchPointToUID = Trim(dr.GetInt32(73))
                                If Not dr.IsDBNull(74) Then sb.DispatchPointToName = Trim(dr.GetString(74))

                                If Not dr.IsDBNull(75) Then sb.TrackNameList = Trim(dr.GetString(75))
                                If Not dr.IsDBNull(76) Then sb.FlagDisplayInfo = Trim(dr.GetString(76))
                                If Not dr.IsDBNull(77) Then sb.TrainMessageExpedite = Trim(dr.GetString(77))
