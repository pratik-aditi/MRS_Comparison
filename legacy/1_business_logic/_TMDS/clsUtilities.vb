                            End Select
                        End If
                    End If
                Next
                If optEnableSendOSMessageARRC Then
                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessageARRC(trn, gMISTransmitQueue, CurrentTrack, False, ValidOSTrack)
                End If
                'If Not CurrentTrack.OStype Then
