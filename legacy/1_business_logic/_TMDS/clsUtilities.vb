        ''' <summary>
        ''' This function finds the current trackcomponent index from the global unique ID
        ''' </summary>
        ''' <param name="pUID"></param>
        ''' <returns></returns>
        Public Shared Function FindTrainFromIDUnit(ByVal pUID As String) As TrainID
            Dim trn As TrainID
            Dim engineID As String
            Try
                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If optEnableCNSpecificOptions Then
                        engineID = trn.IdentifingUnit.Replace(" ", "")
                        pUID = pUID.Replace(" ", "")
                        pUID = pUID.ToUpper()
                        If Not trn.TrainInActive AndAlso engineID = Trim(pUID) AndAlso Trim(trn.IdentifingUnit) <> "" Then
                            Return trn
                        Else
                            If Not trn.TrainInActive AndAlso trn.IdentifingUnit = Trim(pUID) AndAlso Trim(trn.IdentifingUnit) <> "" Then
                                Return trn
                            End If
                        End If
                    Else
                        If Not trn.TrainInActive AndAlso Trim(trn.IdentifingUnit) <> "" AndAlso trn.IdentifingUnit = Trim(pUID) Then
                            Return trn
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                trn = Nothing
                engineID = Nothing
            End Try
        End Function

