#Region "BULLETION FUNCTIONS"
    Class BulletinFunction

        Public Shared Function LoadSubdivisionReferencedBulletinRecords(ByVal SubName As String) As Boolean
            Dim BulletinFetch As String
            Dim dr As OleDbDataReader
            Dim dbcomm As OleDbCommand
            Dim dbconn As OleDbConnection
            Dim bull As Bulletin
            Dim i As Integer
            Dim LineItems() As String = Nothing
            Dim DataItems() As String = Nothing

            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringBulletin)
                BulletinFetch = "SELECT * FROM " & gtblBullActive
                BulletinFetch = BulletinFetch & " WHERE Subdivision = '" & SubName & "'"
                BulletinFetch = BulletinFetch & " ORDER BY BulletinNumber;"
                dbcomm = New OleDbCommand(BulletinFetch, dbconn)
                dbconn.Open()
                dr = dbcomm.ExecuteReader()
                While dr.Read()
                    If Not CheckForBulletinDupicates(dr.GetInt32(1).ToString) Then
                        bull = New Bulletin()
                        With bull
                            .OnlyRead = True
                            .Type = dr.GetString(0)
                            .BullNumber = dr.GetInt32(1)
                            .BullDate = dr.GetDateTime(2)
                            .AtLocation = dr.GetString(3)
                            .Subdivision = dr.GetString(4)
                            .NumOfLines = dr.GetInt32(5)
                            .NumOfComms = dr.GetInt32(6)
                            .Dispatcher = dr.GetString(7)
                            .BulletinVoids = dr.GetString(8)
                            .BulletinVoidBy = dr.GetString(9)
                            .TerritoryID = dr.GetInt32(10)

                            If Trim(dr.GetString(11)) <> "" Then
                                LineItems = dr.GetString(11).Split(Chr(124))
                            End If

                            'Create Line items
                            Select Case .Type
                                Case "FORMA"
                                    Dim LineItemA As LineItemTypeA = Nothing
                                    For i = 0 To LineItems.GetUpperBound(0) - 1
                                        DataItems = LineItems(i).Split(Chr(59))
                                        If DataItems.GetUpperBound(0) >= 13 Then
                                            LineItemA.ItemNumber = DataItems(0)
                                            LineItemA.FromMP = DataItems(1)
                                            LineItemA.FromMPSuffix = DataItems(2)
                                            LineItemA.ToMP = DataItems(3)
                                            LineItemA.ToMPSuffix = DataItems(4)
                                            LineItemA.TrackType = DataItems(5)
                                            LineItemA.MaxFrghtSpd = DataItems(6)
                                            LineItemA.MaxPassSpd = DataItems(7)
                                            LineItemA.FlagMP1 = DataItems(8)
                                            LineItemA.FlagMP1Suffix = DataItems(9)
                                            LineItemA.FlagMP2 = DataItems(10)
                                            LineItemA.FlagMP2Suffix = DataItems(11)
                                            LineItemA.Comments = DataItems(12)
                                        End If
                                        bull.LineItems.Add(LineItemA)
                                        LineItemA = Nothing
                                        DataItems = Nothing
                                    Next

                                Case "FORMB"
                                    Dim LineItemB As LineItemTypeB = Nothing
                                    For i = 0 To LineItems.GetUpperBound(0) - 1
                                        DataItems = LineItems(i).Split(Chr(59))
                                        If DataItems.GetUpperBound(0) = 17 Then
                                            LineItemB.ItemNumber = DataItems(0)
                                            LineItemB.FromMP = DataItems(1)
                                            LineItemB.FromMPSuffix = DataItems(2)
                                            LineItemB.ToMP = DataItems(3)
                                            LineItemB.ToMPSuffix = DataItems(4)
                                            LineItemB.FromTime = DataItems(5)
                                            LineItemB.ToTime = DataItems(6)
                                            LineItemB.TrackType = DataItems(7)
                                            LineItemB.FlagMP1 = DataItems(8)
                                            LineItemB.FlagMP1Suffix = DataItems(9)
                                            LineItemB.FlagMP2 = DataItems(10)
                                            LineItemB.FlagMP2Suffix = DataItems(11)
                                            LineItemB.ForemanName = DataItems(12)
                                            LineItemB.MOWCrew = DataItems(13)
                                            LineItemB.Action = DataItems(14)
                                            LineItemB.Comments = DataItems(15)
                                            LineItemB.EffectiveDate = DataItems(16)
                                        End If
                                        bull.LineItems.Add(LineItemB)
                                        LineItemB = Nothing
                                        DataItems = Nothing
                                    Next
                                Case "FORMC"
                                    Dim LineItemC As LineItemTypeC = Nothing
                                    For i = 0 To LineItems.GetUpperBound(0) - 1
                                        DataItems = LineItems(i).Split(Chr(59))
                                        If DataItems.GetUpperBound(0) = 4 Then
                                            LineItemC.ItemNumber = DataItems(0)
                                            LineItemC.MilePost = DataItems(1)
                                            LineItemC.MPSuffix = DataItems(2)
                                            LineItemC.Comments = DataItems(3)
                                        End If
                                        bull.LineItems.Add(LineItemC)
                                        LineItemC = Nothing
                                        DataItems = Nothing
                                    Next

                                Case "FORMTC"
                                    Dim LineItemTC As LineItemTypeTC = Nothing
                                    For i = 0 To LineItems.GetUpperBound(0) - 1
                                        DataItems = LineItems(i).Split(Chr(59))
                                        If DataItems.GetUpperBound(0) = 6 Then
                                            LineItemTC.ItemNumber = DataItems(0)
                                            LineItemTC.MilePost = DataItems(1)
                                            LineItemTC.MPSuffix = DataItems(2)
                                            LineItemTC.PostingPerson = DataItems(3)
                                            LineItemTC.Location = DataItems(4)
                                            LineItemTC.Comments = DataItems(5)
                                        End If
                                        bull.LineItems.Add(LineItemTC)
                                        LineItemTC = Nothing
                                        DataItems = Nothing
                                    Next
                                Case "FORMR"
                                    Dim LineItemR As LineItemTypeR = Nothing
                                    For i = 0 To LineItems.GetUpperBound(0) - 1
                                        DataItems = LineItems(i).Split(Chr(59))
                                        If DataItems.GetUpperBound(0) >= 4 Then
                                            LineItemR.ItemNumber = DataItems(0)
                                            LineItemR.MilePost = DataItems(1)
                                            LineItemR.MPSuffix = DataItems(2)
                                            LineItemR.Comments = DataItems(3)
                                        End If
                                        bull.LineItems.Add(LineItemR)
                                    Next

                            End Select

                        End With
                        If Not BulletinCollection.Contains(bull) Then BulletinCollection.Add(bull)
                    End If

                End While
                dbconn.Close()
                dbconn = Nothing
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return False
            End Try
        End Function

