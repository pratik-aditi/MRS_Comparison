                                End With
                                SystemEvent($"{GetCurrentMethod.Name}:Train={symbol}")
                                Return train
                            End While
                        End Using
                    End Using
                End Using
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

