                Dim frm As frmDisplay
                Dim PrimScreen As Screen = System.Windows.Forms.Screen.PrimaryScreen
                Dim NumOfScreens As Integer = TMDS.GlobalDeclarations.gDisplayFormCollection.Count
                Dim PositionFactor As Int32 = 1600  'PrimScreen.WorkingArea.Width
                If optAllow1920x1200ResolutionUse Then
                    If PrimScreen.WorkingArea.Width > 1600 And PrimScreen.WorkingArea.Width <= 1920 Then
                        PositionFactor = 1920
                    End If
                ElseIf optAllow2560x1600ResolutionUse Then
                    If PrimScreen.WorkingArea.Width > 1920 And PrimScreen.WorkingArea.Width <= 3840 Then
                        PositionFactor = 3840
                    ElseIf PrimScreen.WorkingArea.Width > 1920 And PrimScreen.WorkingArea.Width <= 2880 Then
                        PositionFactor = 2880
                    End If
                End If
                Dim AbsoluteScreenNumber As Integer = 1
                If NumOfScreens > 1 Then
                    'SystemEvent("NumOfScreens:" & NumOfScreens.ToString)
                    If NumOfScreens > (Screen.AllScreens.Length - 1) Then
                        AbsoluteScreenNumber = Screen.AllScreens.Length - 1
                    Else
                        AbsoluteScreenNumber = NumOfScreens
                    End If


                    If optSizeMainFormBasedOnPosition Then
                        If TMDS.SystemForms.MySystemForms.frmMainMDI.Left <= 3200 And TMDS.SystemForms.MySystemForms.frmMainMDI.Left > 1600 Then
                            AbsoluteScreenNumber = Screen.AllScreens.Length - 1
                        ElseIf TMDS.SystemForms.MySystemForms.frmMainMDI.Left <= 4800 And TMDS.SystemForms.MySystemForms.frmMainMDI.Left > 3200 Then
                            AbsoluteScreenNumber = Screen.AllScreens.Length - 2
                        ElseIf TMDS.SystemForms.MySystemForms.frmMainMDI.Left <= 6400 And TMDS.SystemForms.MySystemForms.frmMainMDI.Left > 4800 Then
                            AbsoluteScreenNumber = Screen.AllScreens.Length - 3
                        End If
                    End If
                    If AbsoluteScreenNumber <= 0 Then
                        AbsoluteScreenNumber = 1
                    End If

                    TMDS.SystemForms.MySystemForms.frmMainMDI.Width = AbsoluteScreenNumber * PositionFactor '(PrimScreen.AllScreens.Length - 1) * PositionFactor
                    'SystemEvent("MAINWIDTH:" & TMDS.SystemForms.MySystemForms.frmMainMDI.Width.ToString)
                Else
                    SystemEvent("NumOfScreens:" & NumOfScreens.ToString)
                    TMDS.SystemForms.MySystemForms.frmMainMDI.Width = 1 * PositionFactor
                    SystemEvent("MAINWIDTH:" & TMDS.SystemForms.MySystemForms.frmMainMDI.Width.ToString)
                End If

                Dim Index As Integer
                For Each frm In TMDS.GlobalDeclarations.gDisplayFormCollection
                    frm.Top = 0
                    If Index * PositionFactor < TMDS.SystemForms.MySystemForms.frmMainMDI.Width Then 'PrimScreen.WorkingArea.Width Then
                        frm.Left = Index * PositionFactor
                        Index = Index + 1
                    Else
                        'frm.Left = Index * PositionFactor
                        frm.Left = (Index - 1) * PositionFactor
                        frm.SendToBack()
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

