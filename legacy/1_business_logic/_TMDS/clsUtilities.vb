                    mr = FindMileageRange(Flag1EndMP, "", SB.FlagMilePostEndSuffix1, SB.FlagMilePostEnd1SubUID)
                    'If mr IsNot Nothing Then If Not BullMRList.Contains(mr) Then BullMRList.Add(mr)
