                        '    End If
                        '    If optEnableTrackTimeDisplayonCodeBrown OrElse optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then
                        '        comp.OverRideCodeBrown = True
                        '    End If
                        '    comp.UpdateStatus()
                        'Next

                        'OtherTrackAuthorities.Add(auth)
                        auth.CreateReducedLimitsVerbiage()
                        If optEnableLicenseGenerationForPTC Then
                            If dr.FieldCount >= 58 Then
