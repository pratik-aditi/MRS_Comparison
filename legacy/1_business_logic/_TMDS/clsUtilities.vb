                                    If Not dr.IsDBNull(68) Then sb.SubdivisionFromUID = Trim(dr.GetInt32(68))
                                    If Not dr.IsDBNull(69) Then sb.SubdivisionFromName = Trim(dr.GetString(69))

                                    If Not dr.IsDBNull(70) Then sb.PersonRequesting = Trim(dr.GetString(70))

