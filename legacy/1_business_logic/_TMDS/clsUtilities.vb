        Friend Shared Function ValidateTime_KeyPress(ByVal sender As Object, ByVal e As System.Windows.Forms.KeyPressEventArgs) As Boolean
            Dim txt As TextBox = Nothing
            Try
                txt = TryCast(sender, TextBox)
                If txt Is Nothing Then Return True
                If Not (Char.IsNumber(e.KeyChar) Or (e.KeyChar = Convert.ToChar(Keys.Back)) Or (e.KeyChar = Convert.ToChar(Keys.Delete))) Then
                    Return True
                ElseIf (e.KeyChar.ToString = ".") Then
                    Return True
                Else
                    Dim H1 As String = ""
                    Dim H2 As String = ""
                    Dim M1 As String = ""
                    Dim M2 As String = ""
                    Dim counter As Integer = 0
                    Dim tmChar As Char() '= tb.Text.ToCharArray
                    Dim tb As RichTextBox = sender
                    tmChar = tb.Text.ToCharArray
                    Dim c As Char
                    For Each c In tmChar
                        Select Case counter
                            Case 0
                                H1 = c.ToString
                            Case 1
                                H2 = c.ToString
                            Case 2
                                M1 = c.ToString
                            Case 3
                                M2 = c.ToString
                        End Select
                        counter = counter + 1
                    Next

                    Select Case tb.Text.Length
                        Case 0
                            If e.KeyChar = Convert.ToChar(Keys.D0) Or e.KeyChar = Convert.ToChar(Keys.D1) Or e.KeyChar = Convert.ToChar(Keys.D2) Then
                            Else
                                Return True
                            End If
                        Case 1
                            If (Char.IsNumber(e.KeyChar)) Then
                                If Not String.IsNullOrEmpty(H1) Then
                                    Select Case CInt(H1)
                                        Case 2
                                            Select Case CInt(e.KeyChar.ToString)
                                                Case 0, 1, 2, 3
                                                Case Else
                                                    Return True
                                            End Select
                                        Case Else

                                    End Select
                                End If
                            End If
                        Case 2
                            If (Char.IsNumber(e.KeyChar)) Then
                                Select Case CInt(e.KeyChar.ToString)
                                    Case 0, 1, 2, 3, 4, 5
                                    Case Else
                                        Return True
                                End Select
                            End If
                        Case 3
                            If (Char.IsNumber(e.KeyChar)) Then
                                If CInt(e.KeyChar.ToString) = 0 Then
                                    If CInt(tb.Text) = 0 Then
                                        Return True
                                    End If

                                End If
                            End If
                    End Select
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function

        Friend Shared Function JointControlCheck(CompCollection As ArrayList) As Boolean
            Dim HasValidTrackCollection As Boolean = True
            Dim Comp As Object = Nothing
            Dim Count As Integer = 0
            Try

                If CompCollection IsNot Nothing AndAlso CompCollection.Count > 0 Then
                    For Each Comp In CompCollection
                        Select Case Comp.GetType.ToString
                            Case gTrackComponentName
                                Dim Trk As Track = TryCast(Comp, TMDS.TrackComponents.Track)
                                If optEnableTerritoryDeskAssignmentMode AndAlso Not Trk.IsValidTrackForOperation() Then
