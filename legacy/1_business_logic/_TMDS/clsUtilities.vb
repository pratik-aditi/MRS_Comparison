        Friend Shared Function FindLikeComponents(ByRef TrackSelection As ArrayList, ByVal OSCompList As ArrayList) As Boolean
            Dim myTrackOSCollection As New ArrayList
            Try
                Dim comp, CompToCompare As Object
                Dim CompList As New ArrayList()
                Dim AddComp As Boolean
                CopyArrayCollection(myTrackOSCollection, OSCompList)
                For Each comp In OSCompList 'Me.EntireTrackSelection 
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.OStype And Not comp.RouteBlockingEnabled Then
                            AddComp = True
                            For Each CompToCompare In CompList
                                'If Not CompList.Contains(comp) Then
                                If comp.StationNumber = CompToCompare.StationNumber _
                                And comp.TrackName = CompToCompare.TrackName _
                                And comp.Name = CompToCompare.Name Then
                                    AddComp = False
                                    Exit For
                                End If
                                'Else
                                'AddComp = False
                                'Exit For
                                'End If
                            Next
                            If AddComp Then
                                If Not CompList.Contains(comp) Then
                                    CompList.Add(comp)
                                End If
                            End If
                        End If
                    End If
                Next

                Dim cpList As New ArrayList()
                For Each comp In CompList
                    Dim cp As ControlPoint = TMDS.SystemUtilities.FetchData.FindCPFromGUID(comp.StationNumber)
                    If Not cp Is Nothing Then
                        If Not cpList.Contains(cp) Then
                            cpList.Add(cp)
                        End If
                    End If
                Next

                For Each comp In CompList
                    Dim cpTocheck As ControlPoint
                    For Each cpTocheck In cpList
                        Dim compTocheck As Object
                        For Each compTocheck In cpTocheck.AssignedComponenets
                            If compTocheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If compTocheck.OStype And Not compTocheck.RouteBlockingEnabled Then
                                    If Not myTrackOSCollection.Contains(compTocheck) Then
                                        If (compTocheck.TrackName = comp.TrackName And compTocheck.TrackName <> "") _
                                        And (compTocheck.StationNumber = comp.StationNumber) _
                                        And (compTocheck.AllowTrackTime Or compTocheck.AllowTrackPermit) And (compTocheck.OStype And comp.OStype) And
                                            (compTocheck.RightLimitName = comp.RightLimitName And compTocheck.LeftLimitName = comp.LeftLimitName) Then
                                            If Not OSCompList.Contains(compTocheck) Then
                                                If Not TrackSelection.Contains(compTocheck) Then TrackSelection.Insert(TrackSelection.IndexOf(comp), compTocheck)
                                            End If

                                            Dim swRight As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(compTocheck.RightLink)
                                            Dim swLeft As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(compTocheck.LeftLink)
                                            If Not swRight Is Nothing Then
                                                If Not TrackSelection.Contains(swRight) Then
                                                    TrackSelection.Add(swRight)
                                                End If
                                            End If
                                            If Not swLeft Is Nothing Then
                                                If Not TrackSelection.Contains(swLeft) Then
                                                    TrackSelection.Add(swLeft)
                                                End If
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    Next
                Next


                For Each comp In CompList
                    If Not TrackSelection.Contains(comp) Then
                        TrackSelection.Add(comp)
                    End If
                Next

                CompList.Clear()
                CompList = Nothing
                cpList.Clear()
                cpList = Nothing
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Friend Shared Function GetTrackInfoFromDB(ByVal GUID As Int32) As Track
            Dim dr As OleDbDataReader
            Dim dbCommand As OleDbCommand
            Dim dbConn As OleDbConnection
            Dim FetchTrack As String = "SELECT * FROM tblCompTracks WHERE UID = " & GUID
            Dim RemoteTrack As New Track()
            Try

                dbConn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                dbCommand = New OleDbCommand(FetchTrack, dbConn)
                dbConn.Open()
                dr = dbCommand.ExecuteReader()
                While dr.Read()

                    RemoteTrack.IsRemoteTrack = True
                    RemoteTrack.GUID = dr.GetInt32(0)
                    RemoteTrack.StationNumber = dr.GetInt32(1)
                    RemoteTrack.Name = dr.GetString(2)
                    RemoteTrack.ComponentType = dr.GetString(3)
                    RemoteTrack.LX = dr.GetInt16(4)
                    RemoteTrack.LY = dr.GetInt16(5)
                    RemoteTrack.RX = dr.GetInt16(6)
                    RemoteTrack.RY = dr.GetInt16(7)
                    RemoteTrack.LeftLink = dr.GetInt32(8)
                    RemoteTrack.RightLink = dr.GetInt32(9)

                    RemoteTrack.LeftAltLink = dr.GetInt32(10)
                    RemoteTrack.RightAltLink = dr.GetInt32(11)
                    RemoteTrack.AltLinkOne = dr.GetInt32(12)
                    RemoteTrack.AltLinkTwo = dr.GetInt32(13)
                    RemoteTrack.CodelineNumber = dr.GetInt32(14)
                    RemoteTrack.LeftLimitMilePost = dr.GetDouble(23)
                    RemoteTrack.RightLimitMilePost = dr.GetDouble(24)
                    RemoteTrack.AuthorityType = dr.GetString(25)

                    'added to allow 
                    Select Case Mid(RemoteTrack.ComponentType, 2)
                        Case "R"
                            RemoteTrack.ItemSevenAllowedOnRightLimits = True
                            RemoteTrack.ComponentType = "T"
                        Case "L"
                            RemoteTrack.ItemSevenAllowedOnLeftLimits = True
                            RemoteTrack.ComponentType = "T"
                        Case "&"
                            RemoteTrack.TrackIndicationANDED = True
                            RemoteTrack.TrackIndicationORED = False
                        Case "+"
                            RemoteTrack.TrackIndicationANDED = False
                            RemoteTrack.TrackIndicationORED = True
                    End Select

                    'simulation mode
                    RemoteTrack.SimulateMode = gSimulationMode
                    If Mid(RemoteTrack.AuthorityType, 1, 3) = "CTC" Then
                        gCTCTerritoryFound = True
                    ElseIf RemoteTrack.AuthorityType = "TWC-BABS" Then
                        RemoteTrack.AuthorityType = Mid(RemoteTrack.AuthorityType, 1, 3)
                        RemoteTrack.BiDirectionalABS = True
                    ElseIf RemoteTrack.AuthorityType = "TWC-ABSW" Then
                        RemoteTrack.AuthorityType = Mid(RemoteTrack.AuthorityType, 1, 3)
                        RemoteTrack.SingleABSWest = True
                    ElseIf RemoteTrack.AuthorityType = "TWC-ABSE" Then
                        RemoteTrack.AuthorityType = Mid(RemoteTrack.AuthorityType, 1, 3)
                        RemoteTrack.SingleABSEast = True
                    ElseIf RemoteTrack.AuthorityType = "SHELF" Then
                        RemoteTrack.IsShelfTrack = True
                    End If

                    If Not RemoteTrack.Ind(0) Is Nothing Then
                        RemoteTrack.Indicating = True
                    ElseIf Mid(RemoteTrack.AuthorityType, 1, 3) = "CTC" Then
                        RemoteTrack.Indicating = True

                    Else
                        RemoteTrack.FailState = False
                    End If

                    If Not RemoteTrack.SimulateMode And RemoteTrack.Indicating Then
                        RemoteTrack.FailState = True
                    End If

                    RemoteTrack.TrackName = dr.GetString(26)
                    RemoteTrack.LeftLimitName = dr.GetString(27)
                    RemoteTrack.RightLimitName = dr.GetString(28)
                    RemoteTrack.TerritoryID = dr.GetInt32(29)
                    RemoteTrack.SubdivisionID = dr.GetInt32(30)
                    RemoteTrack.SlottingTrack = dr.GetBoolean(31)
                    RemoteTrack.TrackLength = dr.GetInt32(32)
                    RemoteTrack.AllowBlocking = dr.GetBoolean(33)
                    RemoteTrack.AllowFieldBlocking = dr.GetBoolean(34)
                    RemoteTrack.AllowFoulTime = dr.GetBoolean(35)
                    RemoteTrack.AllowTrackPermit = dr.GetBoolean(36)
                    RemoteTrack.AllowTrackTime = dr.GetBoolean(37)
                    RemoteTrack.AllowTraffic = dr.GetBoolean(38)

                    If RemoteTrack.AllowFieldBlocking Then
                        'RemoteTrack.TempCodeStationBitBuild(dr.GetString(40), RemoteTrack.FBK, CtlIndBits, gCtlIndBitMapNumber, CodeServerClient.BitPosition.BitType.INDICATION)
                        'RemoteTrack.TempCodeStationBitBuild(dr.GetString(39), RemoteTrack.FBZ, CtlIndBits, gCtlIndBitMapNumber, CodeServerClient.BitPosition.BitType.CONTROL)
                    End If
                    RemoteTrack.TimeZone = dr.GetString(41)
                    RemoteTrack.OSReporting = dr.GetBoolean(45)
                    If Not dr.IsDBNull(46) Then
                        RemoteTrack.GraphicalGroupID = dr.GetByte(46)
                    End If
                    If Not dr.IsDBNull(47) Then
                        RemoteTrack.ScreenRegionID = dr.GetByte(47)
                    End If

                    If dr.FieldCount >= 100 Then
                        If Not dr.IsDBNull(99) Then
                            Dim TrackNameAlias As String = dr.GetString(99)
                            Select Case Trim(TrackNameAlias)
                                Case "NOTHING", "NONE", ""
                                    TrackNameAlias = RemoteTrack.TrackName
                            End Select
                            RemoteTrack.TrackNameAlias = TrackNameAlias
                        End If
                    End If
                    If dr.FieldCount >= 114 Then
                        If Not dr.IsDBNull(113) Then
                            RemoteTrack.TypeOfPTC = dr.GetString(113)
                        End If
                    End If


                    gComponentsCollection.Add(RemoteTrack)
                    TrackCollection.Add(RemoteTrack)
                    dbConn.Close()
                    dbConn = Nothing
                    dr = Nothing
                    dbCommand = Nothing
                    SystemEvent(" TRACK INFO RETREIVED:" & RemoteTrack.Name & ":" & RemoteTrack.GUID.ToString & ":" & RemoteTrack.StationNumber.ToString)
                    Return RemoteTrack
                End While
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function GetFiedlBlockingComponents(ByVal CompList As ArrayList) As ArrayList
            Dim FBComponents As New ArrayList
            Dim Comp As Object = Nothing
            Try
                For Each Comp In CompList
                    If Comp IsNot Nothing Then
                        Select Case Comp.GetType.ToString
                            Case gSwitchComponentName, gTrackComponentName
                                If Comp.AllowFieldBlocking Then
                                    If Not FBComponents.Contains(Comp) Then FBComponents.Add(Comp)
                                End If
                        End Select
                    End If
                Next
                Return FBComponents
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function


