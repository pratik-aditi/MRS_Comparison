        Public Shared Function FindTGBOByUID(ByVal TGBOUID As String) As TabularGeneralBulletin
            Dim TGBO As TabularGeneralBulletin = Nothing
            Try
                If TGBOUID.Trim = "" Then Return Nothing
                If gTabularGeneralBulletins.Count = 0 Then Return Nothing
                For Each TGBO In gTabularGeneralBulletins
                    If TGBO.SystemUID = TGBOUID Then Return TGBO
                Next
                TGBO = Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                TGBO = Nothing
            End Try
            Return TGBO
