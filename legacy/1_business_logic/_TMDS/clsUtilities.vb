        ''' <summary>
        ''' Find Previous Track Other Then Me
        ''' </summary>
        ''' <param name="track">track object</param>
        ''' <param name="direction">direction to check</param>
        ''' <returns>Return track found</returns>
        Public Shared Function FindPreviousTrackOtherThenMe(track As Track, direction As String) As Track
            Try
                Dim nextComponent As GenericComponent
                If direction.IsRight Then
                    nextComponent = FindCompItemFromGUID(track.LeftLink)
                Else
                    nextComponent = FindCompItemFromGUID(track.RightLink)
                End If
                If TypeOf nextComponent Is Track Then
                    Dim theTrack As Track = DirectCast(nextComponent, Track)
                    If Not theTrack.Name.EqualsIgnoreCase(track.Name) Then Return theTrack
                End If
                Dim loopControl As Integer
                Dim lastTrack As Track = Nothing
                Do
                    If direction.IsRight Then
                        If TypeOf nextComponent Is Switch Then
                            Dim switch As Switch = DirectCast(nextComponent, Switch)
                            If switch.ControlledReverse AndAlso
                                switch.LeftAltLink <> 0 Then
                                nextComponent = FindCompItemFromGUID(nextComponent.LeftAltLink)
                            Else
                                nextComponent = FindCompItemFromGUID(nextComponent.LeftLink)
                            End If
                        ElseIf TypeOf nextComponent Is Track Then
                            Dim theTrack As Track = DirectCast(nextComponent, Track)
                            If theTrack.NonTransverable Then Return Nothing
                            If Not theTrack.Name.EqualsIgnoreCase(track.Name) Then Return theTrack
                            lastTrack = theTrack
                            nextComponent = FindCompItemFromGUID(nextComponent.LeftLink)
                        ElseIf TypeOf nextComponent Is Signal Then
                            Dim signal As Signal = DirectCast(nextComponent, Signal)
                            If signal.DefaultTraffic = direction Then
                                If Not IsNothing(lastTrack) AndAlso
                                    lastTrack.OSReporting AndAlso lastTrack.SlottingTrack Then
                                    Return Nothing
                                End If
                            End If
                            nextComponent = FindCompItemFromGUID(nextComponent.LeftLink)
                        Else
                            nextComponent = FindCompItemFromGUID(nextComponent.LeftLink)
                        End If
                    Else
                        If TypeOf nextComponent Is Switch Then
                            Dim switch As Switch = DirectCast(nextComponent, Switch)
                            If switch.ControlledReverse AndAlso
                                switch.RightAltLink <> 0 Then
                                nextComponent = FindCompItemFromGUID(nextComponent.RightAltLink)
                            Else
                                nextComponent = FindCompItemFromGUID(nextComponent.RightLink)
                            End If
                        ElseIf TypeOf nextComponent Is Track Then
                            Dim theTrack As Track = DirectCast(nextComponent, Track)
                            If theTrack.NonTransverable Then Return Nothing
                            If Not theTrack.Name.EqualsIgnoreCase(track.Name) Then Return theTrack
                            lastTrack = theTrack
                            nextComponent = FindCompItemFromGUID(nextComponent.RightLink)
                        ElseIf TypeOf nextComponent Is Signal Then
                            Dim signal As Signal = DirectCast(nextComponent, Signal)
                            If signal.DefaultTraffic.EqualsIgnoreCase(direction) AndAlso
                                lastTrack IsNot Nothing AndAlso
                                lastTrack.OSReporting AndAlso
                                lastTrack.SlottingTrack Then
                                Return Nothing
                            End If
                            nextComponent = FindCompItemFromGUID(nextComponent.RightLink)
                        Else
                            nextComponent = FindCompItemFromGUID(nextComponent.RightLink)
                        End If
                    End If
                    If loopControl > 10 Then Return Nothing
                    loopControl += 1
                Loop
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        Public Shared Function CanTrafficBeRemoved(ByVal theMeTrack As Track, ByVal theDirection As String) As Boolean
            Try
                SystemEvent("TRACE CANTRAFFICBEREMOVED1" & theMeTrack.GUID.ToString & ":" & theDirection)
                Dim NextComp As Object
                Dim LastTrack As Track = theMeTrack
                If theDirection = "RIGHT" Then
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(theMeTrack.LeftLink)
                Else
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(theMeTrack.RightLink)
                End If

                If NextComp.GetType.ToString = gTrackComponentName Then
                    Dim trk As Track = CType(NextComp, Track)
                    If trk.Name <> theMeTrack.Name Then
                        If (trk.Occuppied AndAlso trk.OStype) AndAlso Not (trk.Ind(0) Is theMeTrack.Ind(0)) Then
                            SystemEvent("TRACE CANTRAFFICBEREMOVED2:" & trk.GUID & ";" & trk.Name)
                            Return False
                        End If
                    End If
                End If

                Dim LoopControl As Integer
                Do
                    If IsNothing(NextComp) Then
                        SystemEvent("TRACE CANTRAFFICBEREMOVED-NextComp=nothing")
                        Return True
                    End If
                    If theDirection = "RIGHT" Then
                        SystemEvent("TRACE CANTRAFFICBEREMOVED-RIGHT" & NextComp.GUID.ToString & ":" & NextComp.NAME)

                        If NextComp.GetType.ToString = gSwitchComponentName Then
                            Dim sw As Switch = CType(NextComp, Switch)
                            If sw.ControlledReverse AndAlso sw.LeftAltLink <> 0 Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                        ElseIf NextComp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(NextComp, Track)
                            If theMeTrack.myControlPoint.AssignedComponenets.Contains(trk) AndAlso Not trk.NonTransverable AndAlso trk.Name <> theMeTrack.Name AndAlso trk.Occuppied AndAlso trk.OStype AndAlso trk.TrafficDirection = theMeTrack.TrafficDirection AndAlso Not (trk.Ind(0) Is theMeTrack.Ind(0)) Then
                                SystemEvent("TRACE CANTRAFFICBEREMOVED-RIGHT1" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                Return False
                            ElseIf Not trk.NonTransverable AndAlso trk.Name <> theMeTrack.Name AndAlso Not trk.Occuppied AndAlso trk.TrafficDirection = "" AndAlso trk.SignalStatOnMe = Track.SignalStatus.SignalAtStop Then
                                SystemEvent("TRACE CANTRAFFICBEREMOVED-RIGHT2" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                Return True
                            ElseIf trk.NonTransverable Then
                                SystemEvent("TRACE CANTRAFFICBEREMOVED-RIGHT3" & NextComp.GUID.ToString & ":" & NextComp.NAME)

                                Return True
                            End If
                            LastTrack = trk
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        ElseIf NextComp.GetType.ToString = gSignalComponentName Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.DefaultTraffic = theDirection Then
                                If Not IsNothing(LastTrack) Then
                                    If LastTrack.OStype AndAlso LastTrack.SlottingTrack AndAlso LastTrack.Occuppied Then
                                        SystemEvent("TRACE CANTRAFFICBEREMOVED-RIGHT4" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                        Return True
                                    ElseIf theMeTrack.OStype AndAlso theMeTrack.SlottingTrack AndAlso theMeTrack.OsComponentCollection IsNot Nothing AndAlso theMeTrack.OsComponentCollection.Count > 0 AndAlso theMeTrack.OsComponentCollection.Contains(LastTrack) AndAlso Not LastTrack.NonTransverable Then
                                        SystemEvent("TRACE CANTRAFFICBEREMOVED-RIGHT4.1" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                        Return True
                                    ElseIf Not LastTrack.OStype Then
                                        'IF THE SIGNAL IS INDICATE ONLY / CLEARED AND IF THE TRACK CONNECTING TO IT IS NOT OSTYPE NOR OSSLOTTING THEN DO NOT CLEAR TRAFFIC
                                        If sig.SignalIndStatus = Signal.IndStatus.Cleared AndAlso Not sig.MakeInvisible Then
                                            SystemEvent("TRACE CANTRAFFICBEREMOVED-RIGHT5" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                            Return False
                                        End If
                                    End If
                                End If
                            End If
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                    Else
                        SystemEvent("TRACE CANTRAFFICBEREMOVED-LEFT" & NextComp.GUID.ToString & ":" & NextComp.NAME)

                        If NextComp.GetType.ToString = gSwitchComponentName Then
                            Dim sw As Switch = CType(NextComp, Switch)
                            If sw.ControlledReverse AndAlso sw.RightAltLink <> 0 Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        ElseIf NextComp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(NextComp, Track)
                            If theMeTrack.myControlPoint.AssignedComponenets.Contains(trk) AndAlso Not trk.NonTransverable AndAlso trk.Name <> theMeTrack.Name AndAlso trk.Occuppied AndAlso trk.OStype AndAlso trk.TrafficDirection = theMeTrack.TrafficDirection AndAlso Not (trk.Ind(0) Is theMeTrack.Ind(0)) Then
                                SystemEvent("TRACE CANTRAFFICBEREMOVED-LEFT1" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                Return False
                            ElseIf Not trk.NonTransverable AndAlso trk.Name <> theMeTrack.Name AndAlso Not trk.Occuppied AndAlso trk.TrafficDirection = "" AndAlso trk.SignalStatOnMe = Track.SignalStatus.SignalAtStop Then
                                SystemEvent("TRACE CANTRAFFICBEREMOVED-LEFT2" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                Return True
                            ElseIf trk.NonTransverable Then
                                SystemEvent("TRACE CANTRAFFICBEREMOVED-LEFT3" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                Return True
                            End If
                            LastTrack = trk
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        ElseIf NextComp.GetType.ToString = gSignalComponentName Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.DefaultTraffic = theDirection Then
                                If Not IsNothing(LastTrack) Then
                                    If LastTrack.OStype AndAlso LastTrack.SlottingTrack AndAlso LastTrack.Occuppied Then
                                        SystemEvent("TRACE CANTRAFFICBEREMOVED-LEFT4" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                        Return True
                                    ElseIf theMeTrack.OStype AndAlso theMeTrack.SlottingTrack AndAlso theMeTrack.OsComponentCollection IsNot Nothing AndAlso theMeTrack.OsComponentCollection.Count > 0 AndAlso theMeTrack.OsComponentCollection.Contains(LastTrack) AndAlso Not LastTrack.NonTransverable Then
                                        SystemEvent("TRACE CANTRAFFICBEREMOVED-LEFT4.1" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                        Return True
                                    ElseIf Not LastTrack.OStype Then
                                        'IF THE SIGNAL IS INDICATE ONLY / CLEARED AND IF THE TRACK CONNECTING TO IT IS NOT OSTYPE NOR OSSLOTTING THEN DO NOT CLEAR TRAFFIC
                                        If sig.SignalIndStatus = Signal.IndStatus.Cleared AndAlso Not sig.MakeInvisible Then
                                            SystemEvent("TRACE CANTRAFFICBEREMOVED-LEFT5" & NextComp.GUID.ToString & ":" & NextComp.NAME)
                                            Return False
                                        End If
                                    End If
                                End If
                            End If
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If
                    End If
                    LoopControl += 1
                    If LoopControl > 100 Then
                        SystemEvent("TRACE CANTRAFFICBEREMOVED-CHECK REACHED MAX LIMIT")
                        Return True
                    End If
                Loop

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            End Try
        End Function

        Public Shared Function FindFlipFlop(ByVal GUID As Int32) As FlipFlop
            'This function finds the current trackcomponent index from the global unique ID
            Dim ff As Object
            Try
                For Each ff In TMDS.GlobalDeclarations.gComponentsCollection
                    If ff.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" And ff.GUID = GUID Then
                        Return ff
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Shared Function FindFlipFlopLoopToLeft(ByVal GUID As Int32) As FlipFlop
            'This function finds the current trackcomponent index from the global unique ID
            Dim ff As Object
            Dim Count As Integer
            Try
                ff = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(GUID)
                Do
                    If ff.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                        Return ff
                    End If
                    ff = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ff.LeftLink)
                    Count += 1
                    If Count > 3 Then
                        Return Nothing
                    End If
                Loop
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

