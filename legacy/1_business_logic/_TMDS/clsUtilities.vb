        Public Shared Function GetValidTrackToOS(ByVal trn As TrainID, ByVal CurrentTrack As Track) As Boolean
            Dim TrainOnSFAAuthority As TMDS.TrackAuthority.SFAuthority = Nothing
            Dim Auth As TMDS.TrackAuthority.SFAuthority = Nothing
            Dim ValidOSTrack As Track = Nothing
            'Dim OSTrackFound As Boolean
