        Public Shared Function FindAllTracksFromMilePostByMileageRange(ByVal FromMilepost As Decimal, ByVal ToMilepost As Decimal, ByVal FromMPSuffix As String, ByVal ToMPSuffix As String,
                                                                       ByVal FromMPPrefix As String, ByVal ToMPPrefix As String, ByVal SubDivisionName As String, ByRef FirstMR As MileageRange, ByRef LastMR As MileageRange,
                                                                       Optional ByVal IncludeOnlyDispatchableTracks As Boolean = False, Optional ByVal UseValidSubsOnly As Boolean = False) As ArrayList ', Optional ByVal UseMR As Boolean = False
            'This function finds the current trackcomponent using Milepost
            Dim TrackList As New ArrayList
            Dim trk As Track
            Dim comp As Object
            Dim MR As MileageRange = Nothing
            Dim ValidMilageRanges As New ArrayList
            Dim mySubdivisionlist As New ArrayList

            Dim ValidMP As Boolean = False
            Try
                Dim MainHighMile As Double
                Dim MainLowMile As Double
                Dim MainHighMilePrefix As String = String.Empty
                Dim MainLowMilePrefix As String = String.Empty
                Dim MainHighMileSuffix As String = String.Empty
                Dim MainLowMileSuffix As String = String.Empty
                If CDbl(FromMilepost) > CDbl(ToMilepost) Then
                    MainHighMile = CDbl(FromMilepost)
                    MainLowMile = CDbl(ToMilepost)
                    MainHighMilePrefix = FromMPPrefix
                    MainHighMileSuffix = FromMPSuffix
                    MainLowMilePrefix = ToMPPrefix
                    MainLowMileSuffix = ToMPSuffix
                Else
                    MainHighMile = CDbl(ToMilepost)
                    MainLowMile = CDbl(FromMilepost)
                    MainHighMilePrefix = ToMPPrefix
                    MainHighMileSuffix = ToMPSuffix
                    MainLowMilePrefix = FromMPPrefix
                    MainLowMileSuffix = FromMPSuffix
                End If
                Dim CuspMileLow As Decimal = 0.00001
                If optEnableARRCSpecificOptions Then
                    MainLowMile = CuspMileLow + MainLowMile
                    MainHighMile = MainHighMile - CuspMileLow
                End If



                For Each MR In TMDS.GlobalDeclarations.gMileageRangeList
                    If MR.mySubdivisionName = SubDivisionName Then
                        If Not ValidMilageRanges.Contains(MR) Then ValidMilageRanges.Add(MR)
                        'mySubdivisionlist
                        Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromName(SubDivisionName)
                        If subdvn IsNot Nothing AndAlso Not mySubdivisionlist.Contains(subdvn) Then mySubdivisionlist.Add(subdvn)
                        subdvn = Nothing
                    End If
                Next
                For Each MR In ValidMilageRanges
                    If ((MR.RightMileagePrefix.ToUpper.Trim = FromMPPrefix AndAlso MR.RightMileageSuffix.ToUpper.Trim = FromMPSuffix) _
                             OrElse (MR.LeftMileagePrefix.ToUpper.Trim = ToMPPrefix.ToUpper.Trim AndAlso MR.LeftMileageSuffix.ToUpper.Trim = ToMPSuffix.ToUpper.Trim)) Then

                        Dim HighMile As Double
                        Dim LowMile As Double
                        Dim HighMilePrefix As String = String.Empty
                        Dim LowMilePrefix As String = String.Empty
                        Dim HighMileSuffix As String = String.Empty
                        Dim LowMileSuffix As String = String.Empty
                        If CDbl(MR.RightMileage) > CDbl(MR.LeftMileage) Then
                            HighMile = CDbl(MR.RightMileage)
                            LowMile = CDbl(MR.LeftMileage)
                            HighMilePrefix = MR.RightMileagePrefix.Trim
                            HighMileSuffix = MR.RightMileageSuffix.Trim
                            LowMilePrefix = MR.LeftMileagePrefix.Trim
                            LowMileSuffix = MR.LeftMileageSuffix.Trim
                        Else
                            HighMile = CDbl(MR.LeftMileage)
                            LowMile = CDbl(MR.RightMileage)
                            HighMilePrefix = MR.LeftMileagePrefix.Trim
                            HighMileSuffix = MR.LeftMileageSuffix.Trim
                            LowMilePrefix = MR.RightMileagePrefix.Trim
                            LowMileSuffix = MR.RightMileageSuffix.Trim
                        End If
                        ValidMP = BetweenNumbers1(LowMile, LowMilePrefix, LowMileSuffix, HighMile, HighMilePrefix, HighMileSuffix, MainLowMile, MainLowMilePrefix, MainLowMileSuffix)
                        If Not ValidMP Then
                            ValidMP = BetweenNumbers1(LowMile, LowMilePrefix, LowMileSuffix, HighMile, HighMilePrefix, HighMileSuffix, MainHighMile, MainHighMilePrefix, MainHighMileSuffix)
                        End If
                        If ValidMP Then
                            FirstMR = MR
                            Exit For
                        End If
                    End If
                Next
                For Each MR In ValidMilageRanges
                    If ((MR.RightMileagePrefix.ToUpper.Trim = FromMPPrefix AndAlso MR.RightMileageSuffix.ToUpper.Trim = FromMPSuffix) _
                             OrElse (MR.LeftMileagePrefix.ToUpper.Trim = ToMPPrefix.ToUpper.Trim AndAlso MR.LeftMileageSuffix.ToUpper.Trim = ToMPSuffix.ToUpper.Trim)) Then

                        Dim HighMile As Double
                        Dim LowMile As Double
                        Dim HighMilePrefix As String = String.Empty
                        Dim LowMilePrefix As String = String.Empty
                        Dim HighMileSuffix As String = String.Empty
                        Dim LowMileSuffix As String = String.Empty
                        If CDbl(MR.RightMileage) > CDbl(MR.LeftMileage) Then
                            HighMile = CDbl(MR.RightMileage)
                            LowMile = CDbl(MR.LeftMileage)
                            HighMilePrefix = MR.RightMileagePrefix.Trim
                            HighMileSuffix = MR.RightMileageSuffix.Trim
                            LowMilePrefix = MR.LeftMileagePrefix.Trim
                            LowMileSuffix = MR.LeftMileageSuffix.Trim
                        Else
                            HighMile = CDbl(MR.LeftMileage)
                            LowMile = CDbl(MR.RightMileage)
                            HighMilePrefix = MR.LeftMileagePrefix.Trim
                            HighMileSuffix = MR.LeftMileageSuffix.Trim
                            LowMilePrefix = MR.RightMileagePrefix.Trim
                            LowMileSuffix = MR.RightMileageSuffix.Trim
                        End If
                        ValidMP = BetweenNumbers1(LowMile, LowMilePrefix, LowMileSuffix, HighMile, HighMilePrefix, HighMileSuffix, MainHighMile, MainHighMilePrefix, MainHighMileSuffix)
                        If ValidMP Then
                            LastMR = MR
                            Exit For
                        End If
                    End If
                Next
                Dim MissingMRCollection As New ArrayList
                If FirstMR IsNot Nothing AndAlso LastMR IsNot Nothing AndAlso Not FirstMR Is LastMR Then
                    Dim SearchDirection As String = ""
                    Dim NextMR As MileageRange = Nothing
                    'Do Right Search
                    If FirstMR.RightLinkage > 0 Then NextMR = GetMileageRangeFromUID(FirstMR.RightLinkage)
                    If NextMR IsNot Nothing Then
                        For i As Integer = 0 To 10
                            If NextMR Is Nothing Then Exit For
                            If NextMR Is LastMR Then
                                SearchDirection = "RIGHT"
                                If Not MissingMRCollection.Contains(NextMR) Then MissingMRCollection.Add(NextMR)
                                Exit For
                            Else
                                If NextMR IsNot LastMR AndAlso Not MissingMRCollection.Contains(NextMR) Then MissingMRCollection.Add(NextMR)
                                NextMR = GetMileageRangeFromUID(NextMR.RightLinkage)
                            End If
                        Next
                    End If
                    If SearchDirection.Trim = String.Empty Then
                        MissingMRCollection = New ArrayList
                        NextMR = Nothing
                        If FirstMR.LeftLinkage > 0 Then NextMR = GetMileageRangeFromUID(FirstMR.LeftLinkage)
                        If NextMR IsNot Nothing Then
                            For i As Integer = 0 To 10
                                If NextMR Is Nothing Then Exit For
                                If NextMR Is LastMR Then
                                    SearchDirection = "LEFT"
                                    If Not MissingMRCollection.Contains(NextMR) Then MissingMRCollection.Add(NextMR)
                                    Exit For
                                Else
                                    If NextMR IsNot LastMR AndAlso Not MissingMRCollection.Contains(NextMR) Then MissingMRCollection.Add(NextMR)
                                    NextMR = GetMileageRangeFromUID(NextMR.LeftLinkage)
                                End If
                            Next
                        End If
                    End If
                    If SearchDirection.Trim <> String.Empty Then
                        If Not MissingMRCollection.Contains(FirstMR) Then MissingMRCollection.Insert(0, FirstMR)
                        If MissingMRCollection IsNot Nothing AndAlso MissingMRCollection.Count > 1 Then
                            MR = Nothing
                            Dim TempTrackList As New ArrayList
                            Dim FinalTrackList As New ArrayList
                            Dim MRTrack As Object = Nothing
                            For Each MR In MissingMRCollection
                                If gDebug Then
                                    SystemEvent("MileageRange GUID: " & MR.myUID)
                                End If
                                Dim HighMile As Double
                                Dim LowMile As Double
                                Dim HighMilePrefix As String = String.Empty
                                Dim LowMilePrefix As String = String.Empty
                                Dim HighMileSuffix As String = String.Empty
                                Dim LowMileSuffix As String = String.Empty
                                If CDbl(MR.RightMileage) > CDbl(MR.LeftMileage) Then
                                    HighMile = CDbl(MR.RightMileage)
                                    LowMile = CDbl(MR.LeftMileage)
                                    HighMilePrefix = MR.RightMileagePrefix.Trim
                                    HighMileSuffix = MR.RightMileageSuffix.Trim
                                    LowMilePrefix = MR.LeftMileagePrefix.Trim
                                    LowMileSuffix = MR.LeftMileageSuffix.Trim
                                Else
                                    HighMile = CDbl(MR.LeftMileage)
                                    LowMile = CDbl(MR.RightMileage)
                                    HighMilePrefix = MR.LeftMileagePrefix.Trim
                                    HighMileSuffix = MR.LeftMileageSuffix.Trim
                                    LowMilePrefix = MR.RightMileagePrefix.Trim
                                    LowMileSuffix = MR.RightMileageSuffix.Trim
                                End If

                                If MR Is FirstMR Then
                                    TempTrackList = FindAllTracksFromMilePost(MainLowMile, HighMile, MainLowMileSuffix, HighMileSuffix, MainLowMilePrefix, HighMilePrefix)
                                ElseIf MR Is LastMR Then
                                    TempTrackList = FindAllTracksFromMilePost(LowMile, MainHighMile, LowMileSuffix, MainHighMileSuffix, LowMilePrefix, MainHighMilePrefix)
                                Else
                                    TempTrackList = FindAllTracksFromMilePost(LowMile, HighMile, LowMileSuffix, HighMileSuffix, LowMilePrefix, HighMilePrefix)
                                End If




                                If TempTrackList IsNot Nothing AndAlso TempTrackList.Count > 0 Then
                                    For Each MRTrack In TempTrackList
                                        If MRTrack.GetType.ToString = gTrackComponentName Then
                                            If Not FinalTrackList.Contains(MRTrack) Then FinalTrackList.Add(MRTrack)
                                        End If
                                    Next
                                End If
                                TempTrackList = New ArrayList
                            Next
                            If FinalTrackList IsNot Nothing AndAlso FinalTrackList.Count > 0 Then
                                CopyArrayCollection(TrackList, FinalTrackList)
                            End If
                            If gDebug Then
                                For Each trk In TrackList
                                    SystemEvent("Tracks Found Within MilePost From MP " & FromMilepost & " To MP " & ToMilepost & " TrackGuid " & trk.GUID.ToString & vbTab & "LeftMP: " & trk.LeftLimitMilePostPrefix & trk.LeftLimitMilePost & trk.LeftLimitMilePostSuffix & vbTab & "Right MP: " & trk.RightLimitMilePostPrefix & trk.RightLimitMilePost & trk.RightLimitMilePostSuffix)
                                Next
                            End If
                        End If
                    End If
                    If MissingMRCollection IsNot Nothing AndAlso MissingMRCollection.Count > 0 Then
                        For Each MR In MissingMRCollection
                            If MR IsNot Nothing Then
                                Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromName(MR.mySubdivisionName)
                                If subdvn IsNot Nothing AndAlso Not mySubdivisionlist.Contains(subdvn) Then mySubdivisionlist.Add(subdvn)
                                subdvn = Nothing
                            End If
                        Next
                    End If

                Else

                    If optEnableARRCSpecificOptions Then
                        'MainLowMile = CuspMileLow + MainLowMile
                        'MainHighMile = MainHighMile - CuspMileLow
                        TrackList = FindAllTracksFromMilePost(MainLowMile, MainHighMile, MainLowMileSuffix, MainHighMileSuffix, MainLowMilePrefix, MainHighMilePrefix, False)
                    Else
                        TrackList = FindAllTracksFromMilePost(FromMilepost, ToMilepost, FromMPSuffix, ToMPSuffix, FromMPPrefix, ToMPPrefix, False)
                    End If

                End If
                If gDebug Then
                    For Each trk In TrackList
                        SystemEvent("Tracks Found Within MilePost From MP " & FromMilepost & " To MP " & ToMilepost & " TrackGuid " & trk.GUID.ToString & vbTab & "LeftMP: " & trk.LeftLimitMilePostPrefix & trk.LeftLimitMilePost & trk.LeftLimitMilePostSuffix & vbTab & vbTab & "Right MP: " & trk.RightLimitMilePostPrefix & trk.RightLimitMilePost & trk.RightLimitMilePostSuffix)
                    Next
                End If
                If IncludeOnlyDispatchableTracks Then
                    Dim tempArray As New ArrayList
                    'CopyArrayCollection(tempArray, TrackList)
                    For Each trk In TrackList
                        If trk IsNot Nothing AndAlso trk.GetType.ToString = gTrackComponentName AndAlso IsMainTypeTrack(trk) Then
                            If Not tempArray.Contains(trk) Then tempArray.Add(trk)
                        End If
                    Next
                    'If tempArray IsNot Nothing AndAlso tempArray.Count > 0 Then
                    CopyArrayCollection(TrackList, tempArray)
                    'End If

                End If
                If UseValidSubsOnly AndAlso mySubdivisionlist IsNot Nothing AndAlso mySubdivisionlist.Count > 0 Then
                    Dim tmptracks As New ArrayList
                    For Each trk In TrackList
                        If mySubdivisionlist.Contains(trk.mySubdivision) Then
                            If Not tmptracks.Contains(trk) Then tmptracks.Add(trk)
                        End If
                    Next
                    CopyArrayCollection(TrackList, tmptracks)
                End If
                Return TrackList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                trk = Nothing
                comp = Nothing
            End Try
        End Function

        Public Shared Function FilterTracksByMilePostAndName(ByVal TrackList As ArrayList, ByVal MPlow As Decimal, ByVal MPhigh As Decimal, ByVal MPDirection As String, ByVal TrackName As String) As ArrayList
            Dim NewTrackList As New ArrayList
            Dim trk As Track = Nothing
            Dim CuspMileLow As Decimal = MPlow + 0.00001
            Dim Dither As Decimal = 0.00001
            Dim TempTrackList As New ArrayList
            Try
                trk = Nothing
                For Each trk In TrackList
                    If BetweenNumbers(CuspMileLow, MPhigh, trk.LeftLimitMilePost, trk.RightLimitMilePost) Then
                        If Not TempTrackList.Contains(trk) Then TempTrackList.Add(trk)
                    End If
                Next


                If Not String.IsNullOrEmpty(TrackName) AndAlso TrackName.ToUpper.Trim <> "ALL TRACKS" Then
                    Dim TKName As String = ""
                    Dim AltTKName As String = ""
                    Dim S As String = ""
                    Dim TK() As String
                    TK = TrackName.Split("|")
                    For Each S In TK
                        If S.Trim <> "" Then
                            For Each trk In TempTrackList
                                TKName = String.Empty
                                AltTKName = String.Empty
                                If Not String.IsNullOrEmpty(trk.sAlternateTrackNames) AndAlso trk.sAlternateTrackNames.Trim <> "" Then
                                    Dim names() As String = trk.sAlternateTrackNames.Split("|")
                                    If names.GetUpperBound(0) > 0 Then
                                        AltTKName = names(0).ToUpper.Trim
                                    End If
                                End If
                                If Not String.IsNullOrEmpty(trk.TrackNameAlias) AndAlso Not trk.TurnOutType Then
                                    Select Case trk.TrackNameAlias.ToUpper.Trim
                                        Case "NOTHING", ""
                                            TKName = trk.TrackName.ToUpper.Trim
                                        Case Else
                                            TKName = trk.TrackNameAlias.ToUpper.Trim
                                    End Select
                                Else
                                    TKName = trk.TrackName.ToUpper.Trim
                                End If
                                If TKName.ToUpper.Trim = S.ToUpper.Trim AndAlso Not trk.TurnOutType Then
                                    If Not NewTrackList.Contains(trk) Then NewTrackList.Add(trk)
                                ElseIf Not String.IsNullOrEmpty(AltTKName) AndAlso AltTKName.ToUpper.Trim = S.ToUpper.Trim AndAlso Not trk.TurnOutType Then
                                    If Not NewTrackList.Contains(trk) Then NewTrackList.Add(trk)
                                End If
                            Next
                        End If
                    Next


                Else
                    CopyArrayCollection(NewTrackList, TempTrackList)
                End If
                Return NewTrackList



            Catch ex As Exception
                GetErrorDetails(ex)
            Finally

            End Try
            Return Nothing
        End Function

        Public Shared Function BetweenNumbers(ByVal LowMP As Decimal, ByVal HighMP As Decimal, ByVal LMPToCheck As Decimal, ByVal RMPToCheck As Decimal) As Boolean
            Try
                If (LMPToCheck >= LowMP AndAlso LMPToCheck <= HighMP) OrElse (LMPToCheck >= HighMP AndAlso LMPToCheck <= LowMP) Then
                    Return True
                End If
                If (RMPToCheck >= LowMP AndAlso RMPToCheck <= HighMP) OrElse (RMPToCheck >= HighMP AndAlso RMPToCheck <= LowMP) Then
                    Return True
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return False
        End Function

        Public Shared Function BetweenNumbers(ByVal MPToCheck As Decimal, ByVal LMPToCheck As Decimal, ByVal RMPToCheck As Decimal) As Boolean
