                                              ByVal RMPToCheck As Decimal, ByVal RMPToCheckPrefix As String, ByVal RMPToCheckSuffix As String) As Boolean
            Try
                If (LMPToCheck >= LowMP AndAlso LMPToCheck <= HighMP) OrElse (LMPToCheck >= HighMP AndAlso LMPToCheck <= LowMP) Then
