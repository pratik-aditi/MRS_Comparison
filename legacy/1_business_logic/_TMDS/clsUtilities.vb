        Public Shared Function GetTrainSchedulerDatatable(ByVal trn As TrainID) As DataTable
            Dim dtSCH As New DataTable
            Dim trnSch As TrainSchedule = Nothing
            Try
                If trn.myScheduleList Is Nothing Then Return dtSCH
                If trn.myScheduleList.Count = 0 Then Return dtSCH
                dtSCH = TMDS.SystemUtilities.DefineDataTables.DefineScheduleDatatable
                For Each trnSch In trn.myScheduleList
                    With trnSch
                        Dim drow As DataRow = dtSCH.NewRow
                        drow("UID") = .myUID
                        drow("Direction") = .myDirection
                        drow("Symbol") = .myTrainSymbol
                        drow("Station") = .myStationName.ToUpper.Trim
                        drow("TimeIn") = .myStationArrivalTime
                        drow("TimeOut") = .myStationDepartureTime
                        drow("OrderIndex") = .myStationScheduleIndex
                        drow("Category") = .myCategory
                        drow("DependencyType") = .myScheduleDependecyType
                        drow("DependencyData") = .myScheduleDependencyData
                        drow("Processed") = .myScheduleProcessed
                        If .myScheduleProcessed Then
                            drow("ProcessedTime") = .myScheduleProcessedTimeStamp
                            drow("Status") = .myScheduleStatus
                            drow("Delay") = .myScheduleMinutesLate
                        End If
                        drow("ShowAlert") = .ShowAlert
                        dtSCH.Rows.Add(drow)
                        dtSCH.AcceptChanges()
                    End With
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return dtSCH

        End Function

        Public Shared Function FetchTrainRestrictionByGUID(ByVal GUID As String, ByVal trn As TrainID) As TrainRestriction
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim tr As New TrainRestriction
            Dim SQLQuery As String = ""
            Try
                SQLQuery = "SELECT UID, RestrictionCreateTime, RestrictionData, SubUID, BulletinGUID, TrackName,CarUID  FROM tblTrainEventActiveRestrictions WHERE UID='" & GUID & "'"
                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    dbcomm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        Dim RestrictionData As String = String.Empty
                        If Not dr.IsDBNull(0) Then tr.myUID = dr.GetString(0)
                        If Not dr.IsDBNull(1) Then tr.myTimeStamp = dr.GetDateTime(1)
                        If Not dr.IsDBNull(2) Then RestrictionData = dr.GetString(2)
                        If Not dr.IsDBNull(3) Then tr.mySubUID = dr.GetInt32(3)
                        If Not dr.IsDBNull(4) Then tr.myBulletinGUID = dr.GetString(4)
                        If Not dr.IsDBNull(5) AndAlso dr.GetString(5).Trim <> "" Then tr.TrackName = dr.GetString(5)
                        If Not dr.IsDBNull(6) Then tr.myCarUID = dr.GetString(6)
                        tr.myTrain = trn
                        tr.CreateRestriction(RestrictionData)
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
                Return tr


            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return Nothing
        End Function

        Public Shared Function IsTrainReferencedInAuthorites(ByVal TrainName As String) As Boolean
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim HasActiveAuthority As Boolean

            Try

                Dim SQLQuery As String = "SELECT TrainSymbol FROM tblAuthoritiesActive  WHERE TrainSymbol='" & TrainName & "'"
                Using dbConn As New OleDbConnection(gConnectionStringDynamic)
                    dbConn.Open()
                    dbcomm = New OleDbCommand(SQLQuery, dbConn)
                    dr = dbcomm.ExecuteReader
                    If dr.HasRows Then
                        HasActiveAuthority = True
                    End If
                    dr.Close()
                    If Not HasActiveAuthority Then
                        dbcomm = Nothing
                        SQLQuery = "SELECT TrainSymbol FROM tblAuthoritiesSingleFormActive  WHERE TrainSymbol='" & TrainName & "'"
                        dbcomm = New OleDbCommand(SQLQuery, dbConn)
                        dr = dbcomm.ExecuteReader
                        If dr.HasRows Then HasActiveAuthority = True
                    End If
                    If Not HasActiveAuthority Then
                        dbcomm = Nothing
                        SQLQuery = "SELECT TrainSymbol FROM tblAuthoritiesOtherActive  WHERE TrainSymbol='" & TrainName & "'"
                        dbcomm = New OleDbCommand(SQLQuery, dbConn)
                        dr = dbcomm.ExecuteReader
                        If dr.HasRows Then HasActiveAuthority = True
                    End If
                    dbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return HasActiveAuthority
        End Function

        ''' <summary>
        ''' Get System Train From Database
        ''' </summary>
        ''' <param name="symbol">symbol assigned</param>
        ''' <param name="UseInactive">use inactive table</param>
        ''' <returns>Return train object</returns>
        Friend Shared Function GetSystemTrainFromDatabase(symbol As String,
                                                          Optional UseInactive As Boolean = False) As TrainID
            Try
                Dim index As Integer
                Dim dataString() As String
                Using dbConn As New OleDbConnection(gConnectionStringTrain)
                    dbConn.Open()
                    Dim query As String = $"SELECT * 
                                                FROM {If(Not UseInactive, gtblTrainsActive, gtblTrainsInActive)} 
                                                WHERE Symbol = '{symbol}'"
                    Using dbComm As New OleDbCommand(query, dbConn)
                        Using dr As OleDbDataReader = dbComm.ExecuteReader()
                            While dr.Read()
                                Dim train As New TrainID()
                                With train
                                    .Name = dr.GetString(0)
                                    .DisplayText = .Name
                                    .IdentifingUnit = dr.GetString(1)
                                    .TrackGUID = dr.GetInt32(5)
                                    If Not dr.IsDBNull(6) Then
                                        If Trim(dr.GetString(6)) <> "" Then
                                            dataString = dr.GetString(6).Split(Chr(59))
                                            For index = 0 To dataString.GetUpperBound(0) - 1
                                                .OSTimes.Add(dataString(index) & ";")
                                            Next
                                        End If
                                    End If
                                    .SymbolComment = dr.GetString(7)
                                    .Direction = dr.GetString(8)
                                    If Not dr.IsDBNull(9) Then .CallTime = dr.GetDateTime(9)
                                    If Not dr.IsDBNull(10) Then
                                        Dim units As String() = dr.GetString(10).Split(Chr(124))
                                        For index = 0 To units.GetUpperBound(0)
                                            .Units.Add(units(index))
                                        Next
                                    End If
                                    .UnitComment = dr.GetString(11)
                                    .DepTime = dr.GetDateTime(12)
                                    .ArrTime = dr.GetDateTime(13)
                                    .FinalTime = dr.GetDateTime(14)
                                    .OLoads = dr.GetInt32(15)
                                    .OEmts = dr.GetInt32(16)
                                    .OTons = dr.GetInt32(17)
                                    .OLength = dr.GetInt32(18)
                                    .DLoads = dr.GetInt32(19)
                                    .DEmts = dr.GetInt32(20)
                                    .DTons = dr.GetInt32(21)
                                    .DLength = dr.GetInt32(22)
                                    .MaxSpd = dr.GetInt32(23)
                                    .HorsePowerTrailing = dr.GetString(62)
                                    .TonsPerOperativeBrake = dr.GetInt32(25)
                                    .HazMat = dr.GetBoolean(26)
                                    .HighWide = dr.GetBoolean(27)
                                    .Origin = dr.GetString(28)
                                    .Dest = dr.GetString(29)
                                    .EOTD = dr.GetString(30)
                                    .HOTD = dr.GetString(31)
                                    If dr.FieldCount >= 82 Then
                                        If Not dr.IsDBNull(78) Then
                                            .CrewCurrentString = dr.GetString(78)
                                        Else
                                            .CrewCurrentString = .CrewCurrent.CreateCrewString
                                        End If
                                        If Not dr.IsDBNull(79) Then
                                            .CrewReliefString = dr.GetString(79)
                                        Else
                                            .CrewReliefString = .CrewRelief.CreateCrewString
                                        End If
                                        If Not dr.IsDBNull(80) Then
                                            .CrewPendingString = dr.GetString(80)
                                        Else
                                            .CrewPendingString = .CrewPending.CreateCrewString
                                        End If
                                    End If
                                    train.CrewCurrent.ApplyCrewString(train.CrewCurrentString)
                                    train.CrewPending.ApplyCrewString(train.CrewPendingString)
                                    train.CrewRelief.ApplyCrewString(train.CrewReliefString)
                                    If dr.GetString(38) <> "" Then
                                        dataString = dr.GetString(38).Split(Chr(124))
                                        For index = 0 To dataString.GetUpperBound(0)
                                            .DelayInfo.Add(dataString(index))
                                        Next
                                    End If
                                    If dr.GetString(39) <> "" Then
                                        dataString = dr.GetString(39).Split(Chr(124))
                                        For index = 0 To dataString.GetUpperBound(0)
                                            .TrackBull.Add(dataString(index))
                                        Next
                                    End If
                                    If dr.GetString(40) <> "" Then
                                        dataString = dr.GetString(40).Split(Chr(124))
                                        For index = 0 To dataString.GetUpperBound(0)
                                            .BadOrderSetOuts.Add(dataString(index))
                                        Next
                                    End If
                                    If dr.GetString(47) <> "" Then
                                        dataString = dr.GetString(47).Split(Chr(124))
                                        For index = 0 To dataString.GetUpperBound(0)
                                            .TrainSheetEvents.Add(dataString(index))
                                        Next
                                    End If
                                    If dr.FieldCount >= 65 Then
                                        If Not dr.IsDBNull(64) Then
                                            .TrainType = dr.GetString(64)
                                        End If
                                    End If
                                    If dr.FieldCount >= 120 Then
                                        If Not dr.IsDBNull(119) Then .TGBONumber = dr.GetString(119)
                                        If Not dr.IsDBNull(120) Then .TGBOStatus = dr.GetString(120)
                                    End If
                                    If dr.FieldCount >= 128 Then
                                        If Not dr.IsDBNull(125) Then
                                            .EntityUID = dr.GetString(125)
                                        End If
                                        If Not dr.IsDBNull(126) Then
                                            .NumberOperatingBrakes = dr.GetInt32(126)
                                        End If
                                        If Not dr.IsDBNull(127) Then
                                            .NumberOfAxles = dr.GetInt32(127)
                                        End If
                                    End If
                                    If dr.FieldCount >= 129 Then
                                        If Not dr.IsDBNull(128) Then
                                            .CrewReleaseString = dr.GetString(128)
                                        End If
                                    End If
                                    If dr.FieldCount >= 137 Then
                                        If Not dr.IsDBNull(136) Then Double.TryParse(dr.GetValue(136), .GrossTon)
                                        If Not dr.IsDBNull(137) Then Double.TryParse(dr.GetValue(137), .TotalLength)
                                    End If
                                    If dr.FieldCount >= 141 Then
                                        If Not dr.IsDBNull(138) Then .TrainHOS = dr.GetDateTime(138)
                                        If Not dr.IsDBNull(139) Then Integer.TryParse(dr.GetValue(139), .TotalCars)
                                        If Not dr.IsDBNull(140) Then .TrainVia = dr.GetString(140)
                                        If Not dr.IsDBNull(141) Then .ReleaseTime = dr.GetDateTime(141)
                                    End If
                                    If dr.FieldCount >= 151 Then If Not dr.IsDBNull(151) Then .ScheduleType = dr.GetValue(151)
                                    If optEnableWorkOrderFunctions Then train.LoadWorkOrders()
                                    If optEnableTrainRestrictionFunctions Then train.LoadTrainRestrictions()
                                    If optEnableLoadTrainSchedule Then train.LoadTrainSchedule()
                                    If optEnableTrainCarFunctions Then train.LoadTrainCars()
                                    If optEnableTrainEventFunctions Then train.LoadTrainEvents()
                                    If optEnableWorkTaskFunctions Then train.LoadWorkTasks()
                                    train.LoadTrainDelays()
                                    .TypeOfID = "TRAIN"
                                    If dr.FieldCount >= 161 AndAlso
                                        Not dr.IsDBNull(160) Then
                                        .RestrictionType = dr.GetString(dr.GetOrdinal("TrainRestrictionTypes"))
                                    End If
                                End With
                                Return train
                            End While
                        End Using
                    End Using
                End Using
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        Friend Shared Function RetriveInActiveTrainCarConsist(ByVal trn As TrainID) As ArrayList
            Dim tmpArray As New ArrayList
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim query As StringBuilder = Nothing
            Try
                If trn Is Nothing Then Return Nothing
                query = New StringBuilder("SELECT UID, CarUID, CarTons, CarLength, CarAxles, CarNumOperateBrakes, LoadStatus, CarPositionIndex, CarComments, MIS_Information FROM tblTrainConsistInActive WHERE RailroadUID = '" & trn.EntityUID & "' ORDER BY CarPositionIndex")
                Using dbconn As New OleDbConnection(gConnectionStringTrain)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(query.ToString, dbconn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        Dim tc As New TrainCar
                        If Not dr.IsDBNull(0) Then tc.myUID = dr.GetString(0)
                        If Not dr.IsDBNull(1) Then tc.CarUID = dr.GetString(1)
                        If Not dr.IsDBNull(2) Then tc.CarTons = dr.GetInt32(2)
                        If Not dr.IsDBNull(3) Then tc.CarLength = dr.GetInt32(3)
                        If Not dr.IsDBNull(4) Then tc.CarAxles = dr.GetInt32(4)
                        If Not dr.IsDBNull(5) Then tc.CarNumOperateBrakes = dr.GetInt32(5)
                        If Not dr.IsDBNull(6) Then tc.LoadStatus = dr.GetString(6)
                        If Not dr.IsDBNull(7) Then tc.CarPositionIndex = dr.GetInt32(7)
                        If Not dr.IsDBNull(8) Then tc.CarComments = dr.GetString(8)
                        If Not dr.IsDBNull(9) Then tc.MISInfo = dr.GetString(9)
                        tc.myTrain = trn
                        If Not tmpArray.Contains(tc) Then tmpArray.Add(tc)
                    End While
                    dr.Close()
                    dbconn.Close()
                End Using

            Catch ex As Exception
                GetErrorDetails(ex, "RetriveInActiveTrainCarConsist: " & trn.Name & " GUID: " & trn.TrainGUID & vbTab & query.ToString)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return tmpArray
        End Function

