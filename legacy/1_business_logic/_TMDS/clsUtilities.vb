        ''' <summary>
        ''' This Function Retrives Subdivision Station name from MilePost 
        ''' </summary>
        ''' <param name="Milepost"></param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared Function FindStationFromMilePost(ByVal MilePost As Decimal) As String
            Dim subdvn As Subdivision = Nothing
            Dim stat As SubdivisionStation = Nothing
            Try
                For Each subdvn In TMDS.GlobalDeclarations.ControlledSubdivisions
                    For Each stat In subdvn.Stations
                        If stat.MilePost <> String.Empty And stat.ControlPointUID > 0 Then
                            If (MilePost >= CDbl(stat.MilePost) And MilePost <= CDbl(stat.MilePost)) Then
                                Return stat.Name
                            End If
                        End If
                    Next
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return String.Empty
        End Function

        Public Shared Function FindTrackLeftMilePostFromLeftLimitName(ByVal LeftLimitName As String) As Double
            Dim trk As Track
            Try
                For Each trk In TrackCollection
                    If trk.LeftLimitName.Trim.ToUpper = LeftLimitName.Trim.ToUpper Then
                        Return trk.LeftLimitMilePost
                    End If
                Next
                Return 0
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                trk = Nothing
            End Try

        End Function

