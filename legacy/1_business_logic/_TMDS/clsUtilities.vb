#Region " CRC UTILITIES "

    Class CRCUtils

        Public Shared Function GetObjectCRC(ByVal ObjectToCompute As Object) As Int64
            Dim MessageCRC As Int64
            Dim ObjectToByte() As Byte
            Try
                Dim ms As New MemoryStream()
                Dim bf As New BinaryFormatter()
                bf.Serialize(ms, New GeneralSerializableAdapter(ObjectToCompute))
                ObjectToByte = ms.ToArray()
                GetCRC31(ObjectToByte, 0, MessageCRC)
                Return MessageCRC
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

        End Function

        Private Shared Sub CalculateObjectCRC31(ByVal obj As Object, ByRef ObjectToByte As Byte())
            'Dim ObjectToByte() As Byte
            Dim m As System.IO.MemoryStream = Nothing
            Dim writer As BinaryWriter = Nothing
            Try

                m = New MemoryStream()

                writer = New BinaryWriter(m)

                'use reflection to get the list of public Fields
                For Each finfo As FieldInfo In obj.GetType().GetFields()

                    'here im checking if the field is an obj of custom class or .net datatype

                    If (finfo.FieldType.IsPrimitive Or finfo.FieldType Is GetType(String) Or finfo.FieldType Is GetType(DateTime)) Then
                        ' If Fieldtype.Assembly.FullName.StartsWith("mscorlib") And Not (finfo Is Nothing) Then
                        Try
                            writer.Write(finfo.GetValue(obj).ToString())
                        Catch ex As Exception
                            Throw ex
                        End Try
                        'End If
                    Else
                        'means its a custom class, so use recursion to get into the variable
                        Try
                            CalculateObjectCRC31(finfo.GetValue(obj), ObjectToByte)
                        Catch ex As Exception

                        End Try


                    End If
                Next

                'use reflection to get the list of Properties
                For Each pinfo As PropertyInfo In obj.GetType().GetProperties()


                    Dim propertytype As Type
                    propertytype = pinfo.GetType()

                    'here check is the property is an obj of  custom class or .Net datatype
                    If (pinfo.PropertyType.IsPrimitive Or pinfo.PropertyType Is GetType(String) Or pinfo.PropertyType Is GetType(DateTime)) Then
                        Dim temp As String
                        temp = pinfo.GetValue(obj, Nothing).ToString()
                        writer.Write(temp)
                    Else
                        CalculateObjectCRC31(pinfo.GetValue(obj, Nothing), ObjectToByte)
                    End If


                Next
                ObjectToByte = m.ToArray()


            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

        End Sub

        Public Shared Function GetCRC(ByVal trn As TrainID, ByVal Authority As Object) As Int64
            Dim mySCAC As String = ""
            Dim TypeOfAuthority As String = ""
            Dim ByteList As New ArrayList
            Dim AuthUID As String = ""
            Dim TA As Object = Nothing
            Dim S As String = ""
            Dim AuthoritySubdvnList As New ArrayList
            Dim AuthorityOKTime As Date
            Dim AuthorityPTCTrackSegment As String = ""
            Dim AuthorityPTCText As String = ""
            Dim AuthorityPTCRestriction As String = ""
            Dim AuthorityPTCContingencySegments As String = ""
            Dim AuthorityCRCText As String = ""
            Dim MessageCRC As Int64
            Dim MessageToSend() As Byte
            Try
                'Dim SFA As TMDS.TrackAuthority.SFAuthority = Nothing
                'Dim TNT As TMDS.TrackAuthority.TrackAuthority = Nothing
                'Dim SPL As TMDS.TrackAuthority.OtherSpecialAuthorityType = Nothing
                Dim TB As TMDS.GeneralBulletins.SubBulletin = Nothing
                'If trn Is Nothing Then Return String.Empty
                If Authority Is Nothing Then Return String.Empty
                Select Case Authority.GetType.ToString
                    Case gSFAComponentName
                        TypeOfAuthority = "TWC"
                        TA = CType(Authority, TMDS.TrackAuthority.SFAuthority)
                        AuthUID = TA.AuthorityNumber
                        AuthorityOKTime = TA.OKTime
                        With TA
                            AuthorityPTCTrackSegment = .PTCAuthoritySegments
                            AuthorityPTCText = .PTCAuthorityText
                            AuthorityPTCRestriction = .PTCRestrictionText
                            AuthorityPTCContingencySegments = .PTCContingencySegments
                        End With

                    Case gTTComponentName
                        TypeOfAuthority = "TNT"
                        TA = CType(Authority, TMDS.TrackAuthority.TrackAuthority)
                        AuthUID = TA.AuthorityNumber
                        AuthorityOKTime = TA.OKTime
                        With TA
                            AuthorityPTCTrackSegment = .PTCAuthoritySegments
                            AuthorityPTCText = .PTCAuthorityText
                            AuthorityPTCRestriction = .PTCRestrictionText
                            AuthorityPTCContingencySegments = .PTCContingencySegments
                        End With

                    Case gOtherSplAuthorityName
                        TypeOfAuthority = Authority.SubType.ToUpper.Trim
                        TA = CType(Authority, TMDS.TrackAuthority.OtherSpecialAuthorityType)
                        AuthUID = TA.AuthorityNumber
                        AuthorityOKTime = TA.OKTime
                        With TA
                            AuthorityPTCTrackSegment = .PTCAuthoritySegments
                            AuthorityPTCText = .PTCAuthorityText
                            AuthorityPTCRestriction = .PTCRestrictionText
                        End With

                    Case gSubBulletinName
                        TypeOfAuthority = "TB"
                        TA = CType(Authority, TMDS.GeneralBulletins.SubBulletin)
                        AuthUID = TA.BullUID
                        With TA
                            AuthorityPTCTrackSegment = .PTCAuthoritySegments
                            AuthorityPTCText = .PTCBulletinText
                        End With
                End Select

                If AuthorityPTCTrackSegment.Trim <> String.Empty Then AuthorityCRCText = AuthorityPTCTrackSegment.Trim
                If AuthorityPTCText.Trim <> String.Empty Then AuthorityCRCText = AuthorityCRCText.Trim & AuthorityPTCText.Trim
                If AuthorityPTCRestriction.Trim <> String.Empty Then AuthorityCRCText = AuthorityCRCText.Trim & AuthorityPTCRestriction.Trim
                If AuthorityPTCContingencySegments.Trim <> String.Empty Then AuthorityCRCText = AuthorityCRCText.Trim & AuthorityPTCContingencySegments.Trim
                ConvertStringToBytesAddToList(AuthorityCRCText.Trim, ByteList)

                ReDim MessageToSend(0)
                ReDim MessageToSend(ByteList.Count - 1)
                Dim bt As Byte
                Dim b As Integer = 0
                For Each bt In ByteList
                    MessageToSend(b) = bt
                    b += 1
                Next
                If Not GetCRC31(MessageToSend, AuthUID, MessageCRC) Then
                    Return 0
                Else
                    Return MessageCRC
                End If



            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

            Return 0
        End Function

        Public Shared Function GetCRC(ByVal CRCtext As String) As Int64
            Dim ByteList As New ArrayList
            Dim MessageCRC As Int64
            Dim MessageToSend() As Byte
            Try

                ConvertStringToBytesAddToList(CRCtext.Trim, ByteList)

                ReDim MessageToSend(0)
                ReDim MessageToSend(ByteList.Count - 1)
                Dim bt As Byte
                Dim b As Integer = 0
                For Each bt In ByteList
                    MessageToSend(b) = bt
                    b += 1
                Next
                If Not GetCRC31(MessageToSend, 0, MessageCRC) Then
                    Return 0
                Else
                    Return MessageCRC
                End If



            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

            Return 0
        End Function

#Region " PRIVATE AND SUPPORTING METHODS "

        Private Shared Sub ConvertFromNumberToBytesAddToList(ByVal NumToConvert As Int64, ByVal NumOfBytes As Integer, ByRef ByteList As ArrayList)
            Try
                Dim HexNum As String = Hex(NumToConvert).PadLeft(NumOfBytes * 2, "0")
                Dim I As Integer
                For I = 1 To NumOfBytes
                    Dim hex1 As String = Mid(HexNum, 2 * I - 1, 2)
                    Dim bt1 As Byte = CByte("&H" & hex1)
                    ByteList.Add(bt1)
                Next

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Private Shared Function ConvertFromBytesToNumber(ByVal ByteList() As Byte) As Int64
            Try
                Dim HexString As String = String.Empty
                Dim I As Integer
                For I = 0 To ByteList.Length - 1
                    HexString = HexString & Hex(ByteList(I)).PadLeft(2, "0")
                Next
                'Dim sum As Integer = CInt("&h" & Hex(bt1).PadLeft(2, "0") & Hex(bt2).PadLeft(2, "0"))
                Return CLng("&H" & HexString)
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function

        Private Shared Sub ConvertStringToBytesAddToList(ByVal StringToAdd As String, ByRef ByteList As ArrayList)
            Try
                Dim c As String
                For Each c In StringToAdd
                    ByteList.Add(Asc(c))
                Next

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Private Shared Function GetUTCString(ByVal TimeString As String) As String
            Try
                '20070710160000
                Dim yr As String = Mid(TimeString, 1, 4)
                Dim mth As String = Mid(TimeString, 5, 2)
                Dim dy As String = Mid(TimeString, 7, 2)
                Dim hr As String = Mid(TimeString, 9, 2)
                Dim mn As String = Mid(TimeString, 11, 2)
                Dim ss As String = Mid(TimeString, 13, 2)
                Dim UTCtime As Date = CDate(yr & "-" & mth & "-" & dy & " " & hr & ":" & mn & ":" & ss).ToUniversalTime
                Dim UTCString As String = Format(UTCtime, "yyyyMMddHHmmss")
                Return UTCString
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Now
            End Try
        End Function

        Private Shared Sub GetSelectedSubDivisionUID(ByVal ComponentsInSelection As ArrayList, ByRef SubDivisionList As ArrayList)
            SubDivisionList = New ArrayList
            Dim Comp As Track = Nothing
            Dim PTCUID As Integer = 0
            Try
                For Each Comp In ComponentsInSelection
                    PTCUID = 0
                    If Comp.mySubdivision IsNot Nothing Then
                        Integer.TryParse(Comp.mySubdivision.PTCUID, PTCUID)
                        If PTCUID > 0 Then
                            If Not SubDivisionList.Contains(PTCUID) Then SubDivisionList.Add(PTCUID)
                        End If
                    End If
                Next

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try


        End Sub

        Private Shared Function GetCRC31(ByVal ByteList() As Byte, ByVal AuthorityNumber As String, ByRef MessageCRC As Int64) As Boolean
            Dim DataCRCTxt As String = ""
            Try
                Dim CRCList As ArrayList = CRCUtilities.ApplyCRC31(ByteList)
                Dim CRCBytes(3) As Byte

                CRCBytes(0) = CRCList(0)
                CRCBytes(1) = CRCList(1)
                CRCBytes(2) = CRCList(2)
                CRCBytes(3) = CRCList(3)

                MessageCRC = ConvertFromBytesToNumber(CRCBytes)
                DataCRCTxt = "[" & Hex(CRCList(0)).ToString.PadRight(2, "0") & "]" & "[" & Hex(CRCList(1)).ToString.PadRight(2, "0") & "]" & "[" & Hex(CRCList(2)).ToString.PadRight(2, "0") & "]" & "[" & Hex(CRCList(3)).ToString.PadRight(2, "0") & "]"
                SystemInformationEvent(AuthorityNumber & "-CRC:" & MessageCRC)
                SystemInformationEvent(AuthorityNumber & "-CRC[DATA]:" & DataCRCTxt)

                If MessageCRC = 0 Then
                    Return False
                Else
                    Return True
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
                Return False
            End Try
        End Function

#End Region


    End Class

