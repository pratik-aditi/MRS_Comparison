        Public Shared Function GetLogicalSwitchFromMultipleOSSwitches(ByVal OsTrack As Track, ByVal DirectionOfTravel As String) As Switch
            Dim comp As Object = Nothing
            Dim SwitchList As New ArrayList
            Dim SwitchToReturn As Switch = Nothing
            Try
                If OsTrack.OsComponentCollection IsNot Nothing AndAlso OsTrack.OsComponentCollection.Count > 0 Then
                    For Each comp In OsTrack.OsComponentCollection
                        If comp.GetType.ToString = gSwitchComponentName Then
                            If comp.TypeOfSwitch.Trim.ToUpper <> "DERAIL" Then
                                If Not SwitchList.Contains(comp) Then SwitchList.Add(comp)
                            End If
                        End If
                    Next
                End If
                If SwitchList IsNot Nothing AndAlso SwitchList.Count > 0 Then
                    If SwitchList.Count = 1 Then
                        SwitchToReturn = SwitchList(0)
                    Else
                        For Each comp In SwitchList
                            Select Case DirectionOfTravel.Trim.ToUpper
                                Case "RIGHT", "R"
                                    If comp.RightAltLink > 0 Then SwitchToReturn = comp : Exit For
                                Case "LEFT", "L"
                                    If comp.LeftAltLink > 0 Then SwitchToReturn = comp : Exit For
                            End Select
                        Next
                    End If

                End If

            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
            Return SwitchToReturn
        End Function

        Public Shared Function FindTrackFromSwitch(ByVal TheSwitch As Switch, ByVal SearchDirection As String) As Track
            Dim OsTrackFound As Boolean = False
            Dim Comp As Object = Nothing
            Dim ReturnTrack As Track = Nothing
            Try

                Select Case SearchDirection.Trim.ToUpper
                    Case "LEFT"
                        If TheSwitch.ControlledReverse AndAlso TheSwitch.LeftAltLink <> 0 Then
                            Comp = FindCompFromGUID(TheSwitch.LeftAltLink)
                        Else
                            Comp = FindCompFromGUID(TheSwitch.LeftLink)
                        End If

                        For i As Integer = 1 To 20
                            If Comp Is Nothing Then Return Nothing
                            If TheSwitch.OsComponentCollection IsNot Nothing AndAlso TheSwitch.OsComponentCollection.Count > 0 Then
                                If TheSwitch.OsComponentCollection.Contains(Comp) Then
                                    Comp = FindCompFromGUID(Comp.LeftLink)
                                ElseIf Comp.GetType.ToString = gTrackComponentName AndAlso Not TheSwitch.OsComponentCollection.Contains(Comp) Then
                                    ReturnTrack = Comp
                                    Exit For
                                Else
                                    Comp = FindCompFromGUID(Comp.LeftLink)
                                End If
                            End If
                        Next
                    Case "RIGHT"
                        If TheSwitch.ControlledReverse AndAlso TheSwitch.RightAltLink <> 0 Then
                            Comp = FindCompFromGUID(TheSwitch.RightAltLink)
                        Else
                            Comp = FindCompFromGUID(TheSwitch.RightLink)
                        End If

                        For i As Integer = 1 To 20
                            If Comp Is Nothing Then Return Nothing
                            If TheSwitch.OsComponentCollection IsNot Nothing AndAlso TheSwitch.OsComponentCollection.Count > 0 Then
                                If TheSwitch.OsComponentCollection.Contains(Comp) Then
                                    Comp = FindCompFromGUID(Comp.RightLink)
                                ElseIf Comp.GetType.ToString = gTrackComponentName AndAlso Not TheSwitch.OsComponentCollection.Contains(Comp) Then
                                    ReturnTrack = Comp
                                    Exit For
                                Else
                                    Comp = FindCompFromGUID(Comp.RightLink)
                                End If
                            End If
                        Next
                End Select
                Comp = Nothing
                Return ReturnTrack

            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
        End Function

