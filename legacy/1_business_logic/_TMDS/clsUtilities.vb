        Public Shared Sub GetTGBOBullListForNonControlledSub(CallingMethod As String, ByRef BullList As ArrayList, ByRef mrc As MileageRangeBulletinContainer, ThisSub As Subdivision, mr As MileageRange, Optional TGBO As TabularGeneralBulletin = Nothing)
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Query As System.Text.StringBuilder = Nothing
            Try
                If ThisSub Is Nothing Then
                    SystemEvent("GETTGBOBULLLISTFORNONCONTROLLEDSUB CALLED BY: " & CallingMethod & "-SUBDIVISION USED:NOT SUBDIVISION FOUND")
                    Exit Sub
                Else
                    SystemEvent("GETTGBOBULLLISTFORNONCONTROLLEDSUB CALLED BY: " & CallingMethod & "-SUBDIVISION USED:" & ThisSub.Name)
                End If

                Using dbconn As New OleDbConnection(gConnectionStringBulletin)
                    dbconn.Open()
                    Query = New System.Text.StringBuilder
                    Query.Append("SELECT SystemUID, SubdivisionUID, TerrUID, RestrictionUID, MilePostBegin, MilePostEnd, SubType, [TrainSymbol] FROM tblSystemBulletins ")
                    Query.Append("WHERE MileRangeGUID1 = '" & mr.myUID & "' OR ")
                    Query.Append(" MileRangeGUID2 = '" & mr.myUID & "' OR ")
                    Query.Append(" MileRangeGUID3 = '" & mr.myUID & "' OR ")
                    Query.Append(" MileRangeGUID4 = '" & mr.myUID & "'")


                    dbcomm = New OleDbCommand(Query.ToString, dbconn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        Dim OKToAddBull As Boolean = True
                        Try
                            If TGBO IsNot Nothing AndAlso TGBO.TypeOfBulletin = "TGBO-TRAIN" Then
                                'SubType <> N'FORM C
                                If Not dr.IsDBNull(6) AndAlso Not dr.IsDBNull(7) Then
                                    If dr.GetValue(6).ToString.Trim.ToUpper = "FORM C" Then
                                        If TGBO.IssuedTo.Trim.ToUpper = dr.GetValue(7).ToString.Trim.ToUpper Then
                                            SystemEvent("GetTGBOBullListForNonControlledSub1:" & TGBO.IssuedTo & ":" & dr.GetValue(7))
                                        Else
                                            OKToAddBull = False
                                        End If
                                    End If
                                End If
                            End If
                        Catch ex As Exception
                            GetErrorDetails(ex)
                        End Try
                        If OKToAddBull Then
                            If Not dr.IsDBNull(0) Then
                                Dim strBullList As String = dr.GetString(0) & ";" & mr.myName
                                If Not BullList.Contains(strBullList) Then
                                    SystemEvent("GetTGBOBullListForNonControlledSub2:" & strBullList)
                                    BullList.Add(strBullList)
                                End If
                                If Not mrc.myBulletinListOfUIDs.Contains(dr.GetString(0)) Then mrc.myBulletinListOfUIDs.Add(dr.GetString(0))
                            End If
                            If Not dr.IsDBNull(1) Then If IsNumeric(dr.GetString(1)) Then mrc.SubUID = CInt(dr.GetString(1))
                            Dim subdvn As Subdivision
                            For Each subdvn In ControlledSubdivisions
                                If subdvn.GUID = mrc.SubUID Then
                                    mrc.ZoneUID = subdvn.ZoneUID
                                End If
                            Next
                            'If mrc.ZoneUID = 0 Then
                            '    mrc.ZoneUID = GetZoneUIDFromSubdivionUID(mrc.SubUID)
                            'End If
                        End If


                    End While
                    dr.Close()

                    Query = New System.Text.StringBuilder
                    Query.Append("SELECT SystemUID, SubdivisionUID, TrainSpecific, TrainSymbol  FROM tblSystemBulletins ")
                    Query.Append("WHERE RestrictionSubName = '" & ThisSub.Name & "'")
                    Query.Append(" AND (GeneralInformationDOB=1 OR GeneralInformationTGBO=1 ) AND (TrainSpecific=0)")
                    dbcomm = New OleDbCommand(Query.ToString, dbconn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        If Not dr.IsDBNull(0) Then
                            Dim strBullList As String = dr.GetString(0) & ";" & mr.myName
                            If Not BullList.Contains(strBullList) AndAlso Not CheckForDuplicatesOnOtherMileageRange(dr.GetString(0), BullList) Then
                                Dim TrainSpecific As Boolean = False
                                Dim TrainSymbol As String = String.Empty
                                If Not dr.IsDBNull(2) AndAlso Not dr.IsDBNull(3) Then
                                    TrainSpecific = dr.GetBoolean(2)
                                    TrainSymbol = dr.GetString(3)
                                End If
                                Dim AddBulletin As Boolean = True
                                Try
                                    If TrainSpecific AndAlso TrainSymbol.Trim.ToUpper <> TGBO.IssuedTo.Trim.ToUpper Then
                                        AddBulletin = False
                                    End If
                                Catch ex As Exception
                                    GetErrorDetails(ex)
                                End Try

                                If AddBulletin Then
                                    SystemEvent("GetTGBOBullListForNonControlledSub3:" & strBullList)
                                    BullList.Add(strBullList)
                                End If
                            End If
                            If Not mrc.myBulletinListOfUIDs.Contains(dr.GetString(0)) Then mrc.myBulletinListOfUIDs.Add(dr.GetString(0))
                        End If
                        If Not dr.IsDBNull(1) Then If IsNumeric(dr.GetString(1)) Then mrc.SubUID = CInt(dr.GetString(1))
                        Dim subdvn As Subdivision
                        If mrc.ZoneUID = 0 Then
                            For Each subdvn In ControlledSubdivisions
                                If subdvn.GUID = mrc.SubUID Then
                                    mrc.ZoneUID = subdvn.ZoneUID
                                End If
                            Next
                        End If
                    End While
                    dr.Close()
                    dbconn.Close()
                End Using

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                dr = Nothing
            End Try
        End Sub

        Private Shared Function CheckForDuplicatesOnOtherMileageRange(uid As String, bullList As ArrayList) As Boolean
            Try
                Dim s As String
                For Each s In bullList
                    Dim data() As String = s.Split(";")
                    If uid = data(0) Then
                        Return True
                    End If
                Next
                Return False
            Catch ex As Exception
                GetErrorDetails(ex)
                Return False
            End Try

        End Function

        Public Shared Sub ReInitateTGBOExceptionList(CallingMethod As String)
            Dim tgb As TabularGeneralBulletin
            Try
                SystemEvent("ReInitateTGBOExceptionList CALLED BY: " & CallingMethod)

                For Each tgb In gTabularGeneralBulletins
                    tgb.CheckForExistingExceptions(BulletinCollection)
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                DoTGBOSummaryRefresh("ReInitateTGBOExceptionList")
            End Try
        End Sub

