        Public Shared Function FindLinkTripTrain(ByVal trn As TrainID) As TrainID
            Try
                If IsNothing(trn) Then Return Nothing
                Dim trip As TripSchedule
                Dim TrainNameToFind As String = Trim(Mid(trn.Name, 1, trn.Name.Length - 2))
                Dim TrainName As String = String.Empty
                Dim TripSchedules As ArrayList = LoadTrips()
                Dim TripDate As Date = Now
                For Each trip In TripSchedules
                    If trip.TripLinkSymbol = TrainNameToFind Then
                        If TrainName = "" Then
                            TrainName = trip.Symbol
                            TripDate = trip.DepartureTime
                        Else
                            If trip.DepartureTime < TripDate Then
                                Dim t As TrainID
                                For Each t In TrainCollection
                                    If t.Name = trip.Symbol Then
                                        TrainName = trip.Symbol
                                        TripDate = trip.DepartureTime
                                        Exit For
                                    End If
                                Next
                            End If
                        End If
                    End If
                Next
                Dim tn As TrainID
                For Each tn In TrainCollection
                    If Trim(Mid(tn.Name, 1, trn.Name.Length - 2)) = TrainName Then
                        Return tn
                    End If
                Next


            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
            Return Nothing
        End Function

        Private Shared Function LoadTrips() As ArrayList
            Dim dbCommand As OleDbCommand
            Dim dbconn As OleDbConnection
            Dim dr As Data.OleDb.OleDbDataReader

            Dim TripSchedules As New ArrayList()
            Dim QueryString As String = "Select * From tblTrainsScheduleTripLinks"

            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                dbCommand = New OleDbCommand(QueryString, dbconn)
                dbconn.Open()

                dr = dbCommand.ExecuteReader
                While dr.Read
                    Dim ts As New TripSchedule()
                    If Not dr.IsDBNull(0) Then ts.TripGuid = dr.GetString(0)
                    If Not dr.IsDBNull(1) Then ts.Symbol = dr.GetString(1)
                    If Not dr.IsDBNull(2) Then ts.Origin = dr.GetString(2)
                    If Not dr.IsDBNull(3) Then
                        Date.TryParse(dr.GetValue(3), ts.DepartureTime)
                        'ts.DepartureTime = dr.GetDateTime(3)
                    End If
                    If Not dr.IsDBNull(4) Then ts.Destination = dr.GetString(4)
                    If Not dr.IsDBNull(5) Then
                        Date.TryParse(dr.GetValue(5), ts.ArrivalTime)
                        'If Not dr.IsDBNull(5) Then ts.ArrivalTime = dr.GetDateTime(5)
                    End If
                    If Not dr.IsDBNull(6) Then ts.Direction = dr.GetString(6)
                    If Not dr.IsDBNull(7) Then ts.TripLinkSymbol = dr.GetString(7)
                    If Not dr.IsDBNull(8) Then ts.PositionTrackGuid = dr.GetString(8)
                    TripSchedules.Add(ts)
                End While
                dbconn.Close()
                dbCommand.Dispose()
                dbCommand = Nothing
                dbconn = Nothing
                Return TripSchedules
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
            Return TripSchedules
        End Function

