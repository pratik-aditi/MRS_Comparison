        Public Shared Function GetTGBODirection(ByVal trn As TrainID) As String
            Dim MyTrainTerritory As Territory = Nothing
            Dim MyTrainSubdivision As Subdivision = Nothing
            Dim MytrainTrack As Track = Nothing
            Dim MyTrainDirection As String = ""
            Try
                If trn Is Nothing Then Return String.Empty
                MytrainTrack = trn.myTrack
                MyTrainTerritory = trn.myTrack.myTerritory
                MyTrainSubdivision = trn.myTrack.mySubdivision
                MyTrainDirection = trn.Direction
                If MytrainTrack Is Nothing Or MyTrainTerritory Is Nothing Or MyTrainSubdivision Is Nothing Then
                    If String.IsNullOrEmpty(MyTrainDirection) Then Return "RIGHT"
                    Select Case MyTrainDirection.Trim.ToUpper
                        Case optDirectionEast.Trim.ToUpper, optDirectionSouth.Trim.ToUpper, "RIGHT"
                            Return "RIGHT"
                        Case optDirectionNorth.Trim.ToUpper, optDirectionWest.Trim.ToUpper, "LEFT"
                            Return "LEFT"
                        Case Else
                            Return "RIGHT"
                    End Select
                End If
                If MyTrainTerritory IsNot Nothing Then
                    If optFlipNorthSouthDirection Then
                        If MyTrainTerritory.FlipDirection Then
                            Select Case MyTrainDirection.Trim.ToUpper
                                Case optDirectionEast.Trim.ToUpper, optDirectionSouth.Trim.ToUpper, "RIGHT"
                                    Return "RIGHT"
                                Case optDirectionNorth.Trim.ToUpper, optDirectionWest.Trim.ToUpper, "LEFT"
                                    Return "LEFT"
                                Case Else
                                    Return "RIGHT"
                            End Select
                        Else
                            Select Case MyTrainDirection.Trim.ToUpper
                                Case optDirectionEast.Trim.ToUpper, optDirectionSouth.Trim.ToUpper, "RIGHT"
                                    Return "LEFT"
                                Case optDirectionNorth.Trim.ToUpper, optDirectionWest.Trim.ToUpper, "LEFT"
                                    Return "RIGHT"
                                Case Else
                                    Return "LEFT"
                            End Select
                        End If
                    Else
                        If MyTrainTerritory.FlipDirection Then
                            Select Case MyTrainDirection.Trim.ToUpper
                                Case optDirectionEast.Trim.ToUpper, optDirectionSouth.Trim.ToUpper, "RIGHT"
                                    Return "LEFT"
                                Case optDirectionNorth.Trim.ToUpper, optDirectionWest.Trim.ToUpper, "LEFT"
                                    Return "RIGHT"
                                Case Else
                                    Return "LEFT"
                            End Select
                        Else
                            Select Case MyTrainDirection.Trim.ToUpper
                                Case optDirectionEast.Trim.ToUpper, optDirectionSouth.Trim.ToUpper, "RIGHT"
                                    Return "RIGHT"
                                Case optDirectionNorth.Trim.ToUpper, optDirectionWest.Trim.ToUpper, "LEFT"
                                    Return "LEFT"
                                Case Else
                                    Return "RIGHT"
                            End Select
                        End If
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return String.Empty
        End Function

#Region " RELOAD SUB-BULLETIN RECORDS "

        Public Shared Sub LoadMissingSubBulletins(Optional ByVal thisSubdivision As Subdivision = Nothing)
            Dim Subdvn As Subdivision = Nothing
            Dim SQLQuery As String = ""
            Try
                If thisSubdivision Is Nothing Then
                    For Each Subdvn In ControlledSubdivisions
                        SQLQuery = CreateSBSelectQuery(Subdvn)
                        If Not String.IsNullOrEmpty(SQLQuery) Then
                            ReLoadSubBulletinRecordsBySubdivision(SQLQuery, Subdvn)
                        End If
                    Next
                Else
                    For Each Subdvn In ControlledSubdivisions
                        If thisSubdivision.GUID = Subdvn.GUID Then
                            SQLQuery = CreateSBSelectQuery(Subdvn)
                            If Not String.IsNullOrEmpty(SQLQuery) Then
                                ReLoadSubBulletinRecordsBySubdivision(SQLQuery, Subdvn)
                            End If
                            Exit For
                        End If
                    Next

                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try




        End Sub

        Private Shared Function CreateSBSelectQuery(ByVal Subdvn As Subdivision) As String
            Dim sb As SubBulletin
            Dim S As String = ""
            Dim BullNumberArray As New ArrayList
            Dim MissingSBQueryBldr As New StringBuilder
            Dim FirstLoop As Boolean = True
            Try
                For Each sb In TMDS.GlobalDeclarations.BulletinCollection
                    If sb.SubUID = Subdvn.GUID Then
                        If Not BullNumberArray.Contains(sb.myGUID) Then BullNumberArray.Add(sb.myGUID)
                    End If
                Next
                If BullNumberArray IsNot Nothing AndAlso BullNumberArray.Count > 0 Then
                    With MissingSBQueryBldr
                        .Append("SELECT * FROM tblSystemBulletins WHERE")
                        .Append(" SubdivisionUID = " & Subdvn.GUID)
                        .Append(" AND SystemUID NOT IN (")
                        For Each S In BullNumberArray
                            If S.Trim <> "" Then
                                If FirstLoop Then
                                    .Append("'" & S & "'")
                                    FirstLoop = False
                                Else
                                    .Append(",'" & S & "'")
                                End If
                            End If
                        Next
                        .Append(" )")
                    End With
                Else
                    With MissingSBQueryBldr
                        .Append("SELECT * FROM tblSystemBulletins WHERE")
                        .Append(" SubdivisionUID = " & Subdvn.GUID)
                    End With
                End If
            Catch ex As Exception

            End Try
            Return MissingSBQueryBldr.ToString
        End Function


        Private Shared Sub ReLoadSubBulletinRecordsBySubdivision(ByVal SQLQuery As String, ByVal Subdvn As Subdivision)
            Dim dbcomm As OleDbCommand = Nothing
