        Private Shared Function FindTrainSheetTable(ByVal TrainSheetGuid As String) As String
            Dim TrainFetch As String
            Dim dbconn As OleDbConnection
            Dim dbcomm As OleDbCommand
            Dim dr As OleDbDataReader
            Dim DatabaseTable As String = String.Empty
            TrainFetch = "SELECT ActiveSubTrainSheet FROM tblTrainsActiveSubTrainSheets "
            TrainFetch = TrainFetch & " WHERE ActiveSubTrainSheet = '" & TrainSheetGuid & "'"
            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                dbcomm = New OleDbCommand(TrainFetch, dbconn)
                dbconn.Open()
                dr = dbcomm.ExecuteReader()
                While dr.Read
                    If Not dr.IsDBNull(0) Then
                        If TrainSheetGuid = dr.GetString(0) Then
                            DatabaseTable = "tblTrainsActiveSubTrainSheets"
                            Exit While
                        End If
                    End If
                End While
                dbconn.Close()
                dbconn = Nothing
                Return DatabaseTable

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

