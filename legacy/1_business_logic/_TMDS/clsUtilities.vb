        Public Shared Function IsLastOSInCP(ByVal trk As Track) As Boolean
            Try
                Dim i As Integer
                Dim nextcomp As Object
                Select Case trk.TrafficDirection
                    Case "RIGHT"
                        nextcomp = FindCompFromGUID(trk.RightLink)
                        For i = 1 To 50
                            If nextcomp Is Nothing Then Exit For
                            If nextcomp.GetType.ToString = gTrackComponentName Then
                                Dim otrk As Track = DirectCast(nextcomp, Track)
                                If otrk.Name <> trk.Name Then
                                    If otrk.OStype Then
                                        If otrk.myControlPoint.GUID = trk.myControlPoint.GUID AndAlso otrk.Ind(0).ControlPoint = trk.Ind(0).ControlPoint Then
                                            Return False
                                        Else
                                            Return True
                                        End If
                                    End If
                                End If
                                If otrk.myControlPoint.GUID <> trk.myControlPoint.GUID Then
                                    Return True
                                End If
                                nextcomp = FindCompFromGUID(nextcomp.RightLink)
                            ElseIf nextcomp.GetType.ToString = gSwitchComponentName Then
                                Dim osw As Switch = DirectCast(nextcomp, Switch)
                                If osw.ControlledReverse Then
                                    nextcomp = FindCompFromGUID(osw.RightAltLink)
                                Else
                                    nextcomp = FindCompFromGUID(osw.RightLink)
                                End If
                            Else
                                nextcomp = FindCompFromGUID(nextcomp.RightLink)
                            End If
                        Next
                    Case "LEFT"
                        nextcomp = FindCompFromGUID(trk.LeftLink)
                        For i = 1 To 50
                            If nextcomp Is Nothing Then Exit For
                            If nextcomp.GetType.ToString = gTrackComponentName Then
                                Dim otrk As Track = DirectCast(nextcomp, Track)
                                If otrk.Name <> trk.Name Then
                                    If otrk.OStype And otrk.TrainIDPlace Then
                                        If otrk.myControlPoint.GUID = trk.myControlPoint.GUID AndAlso otrk.Ind(0).ControlPoint = trk.Ind(0).ControlPoint Then
                                            Return False
                                        Else
                                            Return True
                                        End If
                                    End If
                                End If
                                If otrk.myControlPoint.GUID <> trk.myControlPoint.GUID Then
                                    Return True
                                End If
                                nextcomp = FindCompFromGUID(nextcomp.LeftLink)
                            ElseIf nextcomp.GetType.ToString = gSwitchComponentName Then
                                Dim osw As Switch = DirectCast(nextcomp, Switch)
                                If osw.ControlledReverse Then
                                    nextcomp = FindCompFromGUID(osw.LeftAltLink)
                                Else
                                    nextcomp = FindCompFromGUID(osw.LeftLink)
                                End If
                            Else
                                nextcomp = FindCompFromGUID(nextcomp.LeftLink)
                            End If
                        Next
                End Select
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return True
        End Function

        Public Shared Function CheckIfRouteTraversesAcrossSwitch(ByVal SW As Switch, ByVal CompList As ArrayList) As Boolean
            Dim comp As Object = Nothing
            Dim LeftTrack As Track = Nothing
            Dim LeftAbuttingTrack As Track = Nothing
            Dim RightTrack As Track = Nothing
            Dim RightAbuttingTrack As Track = Nothing
            Try
                If SW Is Nothing Then Return False
                If CompList Is Nothing Then Return False
                If CompList.Count = 0 Then Return False

                LeftTrack = FindCompFromGUID(SW.LeftLink)
                RightTrack = FindCompFromGUID(SW.RightLink)

                If LeftTrack IsNot Nothing Then
                    LeftAbuttingTrack = FindCompFromGUID(LeftTrack.LeftLink)
                    If LeftAbuttingTrack.GetType.ToString <> gTrackComponentName Then
                        For i As Integer = 0 To 10
                            LeftAbuttingTrack = FindCompFromGUID(LeftAbuttingTrack.LeftLink)
                            If LeftAbuttingTrack.GetType.ToString = gTrackComponentName Then Exit For
                        Next
                    End If
                End If
                If RightTrack IsNot Nothing Then
                    RightAbuttingTrack = FindCompFromGUID(RightTrack.RightLink)
                    If RightAbuttingTrack.GetType.ToString <> gTrackComponentName Then
                        For i As Integer = 0 To 10
                            RightAbuttingTrack = FindCompFromGUID(RightAbuttingTrack.RightLink)
                            If RightAbuttingTrack.GetType.ToString = gTrackComponentName Then Exit For
                        Next
                    End If
                End If

                If RightAbuttingTrack IsNot Nothing AndAlso LeftAbuttingTrack IsNot Nothing Then
                    If CompList.Contains(LeftAbuttingTrack) AndAlso CompList.Contains(RightAbuttingTrack) Then Return True
                Else
                    Return False
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                LeftTrack = Nothing
                LeftAbuttingTrack = Nothing
                RightTrack = Nothing
                RightAbuttingTrack = Nothing
            End Try

        End Function

        Public Shared Function CheckForAlertExtistence(ByVal AuthorityAlertToCheck As Object) As Boolean
            Dim TypeOfObject As String = ""
            Dim al As Alert
            Try
                Select Case AuthorityAlertToCheck.GetType.ToString
                    Case gTTComponentName
                        TypeOfObject = "TNT"
                    Case gSFAComponentName
                        TypeOfObject = "TWC"
                    Case gOtherSplAuthorityName
                        TypeOfObject = "SPL"
                    Case gTabularGeneralBulletinException
                        TypeOfObject = "TGBOEXP"
                    Case Else

                End Select
                For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                    If al.PTCAlert Then
                        Select Case TypeOfObject.ToUpper.Trim
                            Case "TNT"
                                If al.AlertObject.GetType.ToString = gTTComponentName Then
                                    Dim auth As TMDS.TrackAuthority.TrackAuthority = CType(al.AlertObject, TMDS.TrackAuthority.TrackAuthority)
                                    If auth.TrainSymbol = AuthorityAlertToCheck.TrainSymbol AndAlso auth.AuthGUID = AuthorityAlertToCheck.AuthGUID Then
                                        If Not al.AlertAcknowledged Then
                                            Return True
                                        End If
                                    End If
                                End If
                            Case "TWC"
                                If al.AlertObject.GetType.ToString = gSFAComponentName Then
                                    Dim auth As TMDS.TrackAuthority.SFAuthority = CType(al.AlertObject, TMDS.TrackAuthority.SFAuthority)
                                    If auth.TrainSymbol = AuthorityAlertToCheck.TrainSymbol AndAlso auth.AuthGUID = AuthorityAlertToCheck.AuthGUID Then
                                        If Not al.AlertAcknowledged Then
                                            Return True
                                        End If
                                    End If
                                End If
                            Case "SPL"
                                If al.AlertObject.GetType.ToString = gOtherSplAuthorityName Then
                                    Dim auth As TMDS.TrackAuthority.OtherSpecialAuthorityType = CType(al.AlertObject, TMDS.TrackAuthority.OtherSpecialAuthorityType)
                                    If auth.TrainSymbol = AuthorityAlertToCheck.TrainSymbol AndAlso auth.AuthGUID = AuthorityAlertToCheck.AuthGUID Then
                                        If Not al.AlertAcknowledged Then
                                            Return True
                                        End If
                                    End If
                                End If
                            Case "TGBOEXP"
                                If al.AlertObject.GetType.ToString = gTabularGeneralBulletinException Then
                                    Dim exp As TabularGeneralBulletinException = CType(al.AlertObject, TabularGeneralBulletinException)
                                    If exp.SystemUID = AuthorityAlertToCheck.SystemUID Then
                                        If Not al.AlertAcknowledged Then
                                            Return True
                                        End If
                                    End If
                                End If
                        End Select
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                al = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Check For Alert Extistence By Alert Data
        ''' </summary>
        ''' <param name="pData"></param>
        ''' <param name="pIgnoreAckedAlerts"></param>
        ''' <returns></returns>
        Public Shared Function CheckForAlertExtistenceByAlertData(ByVal pData As String, Optional pIgnoreAckedAlerts As Boolean = True) As Boolean
            Dim al As Alert
            Try
                For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                    If Not String.IsNullOrEmpty(al.AlertData) AndAlso al.AlertData.Trim <> "" Then
                        If al.AlertData.ToUpper.Trim = pData.ToUpper.Trim Then
                            If pIgnoreAckedAlerts AndAlso al.AlertAcknowledged Then
                                Return True
                            ElseIf Not al.AlertAcknowledged Then
                                Return True
                            End If
                        End If
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                al = Nothing
            End Try
        End Function

