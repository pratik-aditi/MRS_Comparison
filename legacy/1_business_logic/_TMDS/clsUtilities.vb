        Public Shared Function GetTrainCrewDataView(ByVal trn As TrainID) As DataView
            Dim TempDt As New DataTable
            Dim col1 As DataColumn
            Dim CrewString() As String = Nothing
            Dim CrewName As String = ""
            Dim Craft As String = ""
            Dim CrewView As New DataView
            Try
                col1 = New DataColumn("Craft")
                col1.DataType = System.Type.GetType("System.String")
                TempDt.Columns.Add(col1)

                col1 = New DataColumn("Name")
                col1.DataType = System.Type.GetType("System.String")
                TempDt.Columns.Add(col1)

                If String.IsNullOrEmpty(trn.CrewCurrentString) Then Return Nothing
                CrewString = trn.CrewCurrentString.Split(";")
                If CrewString IsNot Nothing AndAlso CrewString.Length > 0 Then
                    Dim Crstr As String = ""
                    For Each Crstr In CrewString
                        Dim CrewSplit() As String = Crstr.Split("|")
                        If CrewSplit.GetUpperBound(0) > 1 Then
                            CrewName = ""
                            Craft = ""
                            CrewName = CrewSplit(0).ToString
                            Craft = CrewSplit(1).ToString
                            Select Case CrewName.Trim.ToUpper
                                Case "", "NONE"
                                    CrewName = String.Empty
                            End Select
                            Dim drow As DataRow = TempDt.NewRow
                            drow("Name") = CrewName.Trim.ToUpper
                            drow("Craft") = Craft.Trim.ToUpper
                            TempDt.Rows.Add(drow)
                            TempDt.AcceptChanges()
                        End If
                    Next
                End If
                'Return TempDt
                If TempDt IsNot Nothing Then
                    If TempDt.Rows.Count > 0 Then
                        CrewView = New DataView(TempDt)
                    End If
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally

            End Try
            Return CrewView
        End Function

