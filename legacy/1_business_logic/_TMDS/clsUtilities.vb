        Friend Shared Function RetrieveTNTFromDB(ByVal AuthNumber As String, IssuedTo As String) As TrackAuthority.TrackAuthority
            Dim AuthorityFetch As String = ""
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseCommand As OleDbCommand = Nothing
            Dim auth As TrackAuthority.TrackAuthority = Nothing

            Try
                AuthorityFetch = "SELECT * FROM " & gtblAuthActive
                AuthorityFetch = AuthorityFetch & " WHERE  AuthorityUID='" & AuthNumber & "' and IssueTo='" & IssuedTo & "'"
                Using dbConn As New OleDbConnection(gConnectionStringAuthority)
                    dbConn.Open()
                    DatabaseCommand = New OleDbCommand(AuthorityFetch, dbConn)
                    dr = DatabaseCommand.ExecuteReader()
                    While dr.Read()
                        auth = New TrackAuthority.TrackAuthority()

                        auth.AuthorityNumber = dr.GetInt32(0)
                        auth.RailRoadName = dr.GetString(1)
                        auth.DispatcherName = dr.GetString(2)
                        auth.CreateDate = dr.GetDateTime(3)
                        auth.Direction = dr.GetString(4)
                        auth.AuthorityDate = dr.GetDateTime(5)
                        auth.AuthorityType = dr.GetString(6)
                        auth.IssueTo = dr.GetString(7)
                        auth.AuthorityLimits = dr.GetString(8)
                        auth.OKTime = dr.GetDateTime(9)
                        auth.UntilTime = dr.GetDateTime(10)
                        auth.MobileID = dr.GetInt32(11)

                        Dim GUIDs() As String = dr.GetString(12).Split("|")
                        SystemEvent("TRACK AUTHORITY CHECK-" & "COMPONENT STRING RETRIEVED FROM DATABASE:" & dr.GetString(12))
                        Dim strGUID As String

                        For Each strGUID In GUIDs
                            If IsNumeric(strGUID) Then
                                Dim compToBlock As Object = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(CInt(strGUID))
                                If Not IsNothing(compToBlock) Then
                                    auth.ComponentsInSelection.Add(compToBlock)
                                    SystemEvent("TRACK AUTHORITY CHECK-" & "ASSOCIATING COMPONENT:" & strGUID & " WITH AUTHORITY:" & auth.AuthorityNumber)
                                Else
                                    Dim logMessage As String = "TRACK AUTHORITY CHECK-" & "ERROR ASSOCIATING COMPONENT:" & strGUID & " WITH AUTHORITY:" & auth.AuthorityNumber
                                    SystemEvent(logMessage)
                                End If
                            End If
                        Next

                        If auth.ComponentsInSelection.Count = 0 Then
                            Return Nothing
                        End If
                        If Not dr.IsDBNull(13) Then
                            Dim Rdate As Date
                            If Date.TryParse(dr.GetDateTime(13), Rdate) Then
                                If IsValidDate(Rdate.ToString) Then
                                    auth.ReportClear = dr.GetDateTime(13)
                                End If
                            End If
                        End If

                        auth.TerritoryAssignment = dr.GetInt32(14)
                        auth.AuthorityUID = dr.GetString(15)
                        If Not dr.IsDBNull(16) Then
                            Dim VehicleList() As String = dr.GetString(16).Split("|")
                            Dim veh As String
                            For Each veh In VehicleList
                                If veh.Trim <> "" Then
                                    If auth.VehicleAssociations Is Nothing Then
                                        auth.VehicleAssociations = New ArrayList()
                                    End If
                                    auth.VehicleAssociations.Add(veh)
                                End If
                            Next
                        End If
                        auth.JointAuthority = dr.GetBoolean(17)
                        Dim TrainList() As String = dr.GetString(18).Split("|")
                        auth.BehindTrains = New ArrayList()

                        For i As Integer = 0 To TrainList.GetUpperBound(0)
                            auth.BehindTrains.Add(TrainList(i))
                        Next

                        auth.BeginMilePostLimits = dr.GetInt32(19)
                        auth.BeginMilePostLimits = dr.GetInt32(20)
                        auth.JointLimits = dr.GetString(21).Replace("|", "-")

                        If dr.FieldCount >= 23 Then
                            If Not dr.IsDBNull(22) Then
