        Public Shared Function GetPendingTGBODetails(ByVal IssuedTo As String, ByRef BullListCollection As ArrayList, ByRef ExecptionList As ArrayList) As Boolean
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Try
                Dim s As String = ""
                Dim SQLQuery As String = "SELECT [Status], BulletinList, ExceptionList  FROM [tblSystemTabularGeneralBulletinActive] where TypeOfBulletin='TGBO-TRAIN' And IssuedTo='" & IssuedTo & "' AND Status ='PENDING'"
                Using dbConn As New OleDbConnection(gConnectionStringDynamic)
                    dbConn.Open()
                    dbcomm = New OleDbCommand(SQLQuery, dbConn)
                    dr = dbcomm.ExecuteReader
                    If dr.HasRows Then
                        While dr.Read
                            If Not dr.IsDBNull(0) Then
                                Select Case dr(0).ToString.Trim.ToUpper
                                    Case "PENDING", "UNACKNOWLEDGED"
                                        If Not dr.IsDBNull(1) Then BullListCollection = TMDS.SystemUtilities.BulletinFunction.GetAllBulletinsUID(dr.GetString(1))
                                        Dim ExpList As String = ""
                                        If Not dr.IsDBNull(2) Then ExpList = dr.GetString(2)
                                        If Not String.IsNullOrEmpty(ExpList) AndAlso ExpList.Trim <> "" Then
                                            Dim ExpStr() As String = ExpList.Split("|")
                                            If ExpStr IsNot Nothing AndAlso ExpStr.Length > 0 Then
                                                For Each s In ExpStr
                                                    If s.Trim <> "" Then
                                                        Dim Subsplt() As String = s.Split(";")
                                                        Dim GUID As String = ""
                                                        Dim Action As String = ""
                                                        GUID = Subsplt(0)
                                                        Action = Subsplt(1)
                                                        If Action.ToUpper.Trim = "ADD" Then
                                                            Dim trBull As SubBulletin = TMDS.SystemUtilities.FetchData.FindBulletinByGUID(GUID)
                                                            If trBull Is Nothing Then
                                                                trBull = TMDS.SystemUtilities.FetchData.GetInactiveSubBulletinRecordsByGUID(GUID)
                                                            End If
                                                            If trBull IsNot Nothing Then
                                                                If Not ExecptionList.Contains(trBull.myGUID) Then ExecptionList.Add(trBull.myGUID)
                                                            End If
                                                        End If
                                                    End If
                                                Next
                                            End If
                                        End If
                                        Return True
                                End Select
                            End If
                        End While
                    End If
                    dr.Close()
                    dbConn.Close()
                End Using




            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try


        End Function

        Friend Shared Function GetBulletinVerbiage(ByVal Bull As SubBulletin) As ArrayList
            Dim VerbiageArray As New ArrayList
            Try
                Dim TextSplt As String() = Bull.BulletinReadData.Split("|")
                Dim S As String = ""
                For Each S In TextSplt
                    Dim str As String = S.Replace("<", "")
                    str = str.Replace(">", "")
                    VerbiageArray.Add(str)
                Next
                Return VerbiageArray
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return Nothing
        End Function

        Friend Shared Function CheckIfSwitchIsInBulletinLimits(sw As Switch) As Boolean
            Try
                If sw Is Nothing Then Return False
                Dim SWMP As Double = 0 ' sw.MilePost
                Dim SWMPprefix As String = sw.MilePostSuffix
                Dim SWMPSuffix As String = sw.MilePostPrefix
                Double.TryParse(sw.MilePost, SWMP)
                Dim LowMP As Double = 0
                Dim HighMP As Double = 0

                If SWMP = 0 Then Return False
                Dim bull As SubBulletin
                For Each bull In TMDS.GlobalDeclarations.BulletinCollection
                    LowMP = 0
                    HighMP = 0
                    Select Case bull.mysTypeForm.Trim.ToUpper
                        Case "FORM B"
                            LowMP = bull.MilePostBegin
                            HighMP = bull.MilePostEnd
                            Double.TryParse(bull.MilePostBegin, LowMP)
                            Double.TryParse(bull.MilePostEnd, HighMP)
                            If Not String.IsNullOrEmpty(bull.ConfirmationData) AndAlso bull.ConfirmationData.Trim <> "" Then
                                If TMDS.SystemUtilities.FetchData.BetweenNumbers(SWMP, LowMP, HighMP) Then Return True
                            End If
                    End Select
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
                Return True
            End Try
        End Function

