        Public Sub GetObjectData(ByVal info As System.Runtime.Serialization.SerializationInfo, ByVal context As System.Runtime.Serialization.StreamingContext) Implements System.Runtime.Serialization.ISerializable.GetObjectData
            Dim FieldTypeList As New ArrayList
            Dim FieldValues As New ArrayList
            Dim s As String = ""
            Dim Varstr As String = ""
            Dim strFieldValues As New StringBuilder
            Dim VariableCollection As New ArrayList
            Dim ArrObj As Object = Nothing
            Dim Datastr As New StringBuilder
            Try
                Select Case m_obj.GetType.ToString
                    Case gTTComponentName
                        CopyArrayCollection(VariableCollection, gTNTCheckSumVariables)
                    Case gSFAComponentName
                        CopyArrayCollection(VariableCollection, gSFACheckSumVariables)
                End Select
                info.AddValue("class", m_obj.[GetType]().FullName)
                Dim allFI As FieldInfo() = m_obj.[GetType]().GetFields((BindingFlags.Public Or BindingFlags.Instance))
                s = "class" & " = " & m_obj.[GetType]().FullName
                If gDebug Then FieldValues.Add(s)
                s = ""
                For Each Varstr In VariableCollection
                    For Each F As FieldInfo In allFI
                        If F.Name.ToUpper.Trim = Varstr.ToUpper.Trim Then
                            Select Case F.FieldType.ToString.ToUpper.Trim
                                Case "SYSTEM.STRING", "SYSTEM.INT32", "SYSTEM.DATETIME", "SYSTEM.BOOLEAN", "SYSTEM.INT64"
                                    Datastr.Append(F.GetValue(m_obj).ToString.Trim)
                                Case "SYSTEM.COLLECTIONS.ARRAYLIST"
                                    ArrObj = Nothing
                                    Dim ArrValue As String = ""
                                    If F.GetValue(m_obj) IsNot Nothing Then
                                        For Each ArrObj In F.GetValue(m_obj)
                                            Select Case ArrObj.GetType.ToString.ToUpper.Trim
                                                Case "SYSTEM.STRING"
                                                    If ArrObj.ToString.Trim <> "" Then
                                                        Datastr.Append(ArrObj)
                                                    End If
                                            End Select
                                        Next
                                    End If
                                Case "SYSTEM.DRAWING.SOLIDBRUSH", "TMDS.GRAPHICCOMPONENT.GENERICCOMPONENT+MODESELECTION", "SYSTEM.TIMERS.TIMER", "TMDS.TRAINCOMPONENTS.TRAINID", "TMDS.MANAGEMENTCLASSES.FOREMAN"
                                    'Not required for Calculation OBJECT CRC
                            End Select
                            'If gDebug Then If Not FieldTypeList.Contains(F.FieldType.ToString.ToUpper.Trim) Then FieldTypeList.Add(F.FieldType.ToString.ToUpper.Trim)
                            Exit For
                        End If
                    Next
                Next

                info.AddValue("DATA", Datastr.ToString.ToUpper.Trim)
                If gDebug Then
                    SystemInformationEvent("DATA: " & Datastr.ToString.ToUpper.Trim)
                End If



            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                FieldTypeList = Nothing
                FieldValues = Nothing
                strFieldValues = Nothing
            End Try
        End Sub

        Public ReadOnly Property Obj() As Object
            Get
                Return m_obj
            End Get
        End Property

        Private Function IsValidVariableForCRC(ByVal VariableCollection As ArrayList, ByVal VariableName As String) As Boolean
            Dim s As String = ""
            Try
                For Each s In VariableCollection
                    If s.ToUpper.Trim = VariableName.ToUpper.Trim Then
                        Return True
                    End If
                Next

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function

    End Class

