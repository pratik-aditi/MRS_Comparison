        Private Shared Sub GetLastTBDate()
            Dim TempDt As New DataTable
            Dim col1 As DataColumn
            Dim sb As SubBulletin = Nothing
            Dim dvBull As New DataView

            Dim BullTypes As New ArrayList
            Dim s As String
            Try
                With BullTypes
                    .Add("FORM D")
                    .Add("FORM B")
                    .Add("FORM X")
                    .Add("FORM F")
                    .Add("FORM O")
                    .Add("FORM TT")
                    .Add("FORM FF")
                End With

                col1 = New DataColumn("BullType")
                col1.DataType = System.Type.GetType("System.String")
                TempDt.Columns.Add(col1)
                col1 = New DataColumn("BullDate")
                col1.DataType = System.Type.GetType("System.DateTime")
                TempDt.Columns.Add(col1)

                If TMDS.GlobalDeclarations.BulletinCollection IsNot Nothing AndAlso TMDS.GlobalDeclarations.BulletinCollection.Count > 0 Then
                    For Each sb In TMDS.GlobalDeclarations.BulletinCollection
                        If sb IsNot Nothing Then
                            Dim drow As DataRow = TempDt.NewRow
                            Select Case sb.mysTypeForm
                                Case "FORM TT", "FORM FF"
                                    drow("BullType") = "FORM FF"
                                    drow("BullDate") = sb.EffectTime
                                    TempDt.Rows.Add(drow)
                                    TempDt.AcceptChanges()
                                Case Else
                                    drow("BullType") = sb.mysTypeForm
                                    drow("BullDate") = sb.EffectTime
                                    TempDt.Rows.Add(drow)
                                    TempDt.AcceptChanges()
                            End Select
                        End If
                    Next

                    If TempDt IsNot Nothing AndAlso TempDt.Rows.Count > 0 Then
                        For Each s In BullTypes
                            Dim LDate As Date
                            If s.Trim <> "" Then
                                dvBull = New DataView(TempDt)
                                dvBull.RowFilter = ""
                                dvBull.RowFilter = "BullType='" & s & "'"
                                dvBull.Sort = "BullDate DESC"
                                If dvBull.Count > 0 Then
                                    LDate = dvBull(0)("BullDate")
                                    Select Case s
                                        Case "FORM D"
                                            LastSpeed2TBEvent = LDate
                                        Case "FORM B"
                                            LastWork1TBEvent = LDate
                                        Case "FORM X"
                                            LastXingTBEvent = LDate
                                        Case "FORM F"
                                            LastWork2TBEvent = LDate
                                        Case "FORM O"
                                            LastInfo1TBEvent = LDate
                                        Case "FORM TT"

                                        Case "FORM FF"
                                            LastInfo2TBEvent = LDate
                                    End Select
                                End If
                            End If
                        Next
                    End If

                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                TempDt = Nothing
                dvBull = Nothing
                sb = Nothing
                col1 = Nothing
            End Try
        End Sub

        Private Shared Function ReLoadBulletinExceptionOtherInformation(ByVal bull As SubBulletin) As Boolean
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Query As System.Text.StringBuilder = Nothing
            Dim exp As TabularGeneralBulletinException
            Try
                Using DbConn As New OleDbConnection(gConnectionStringBulletin)
                    DbConn.Open()
                    For Each exp In bull.myExceptionList
                        Query = New System.Text.StringBuilder
                        Query.Append("SELECT * FROM tblSystemTabularGeneralBulletinExceptionActive WHERE SystemUID = '" & exp.SystemUID & "'")
                        dbcomm = New OleDbCommand(Query.ToString, DbConn)
                        dr = dbcomm.ExecuteReader()
                        While dr.Read()
                            With exp
                                If Not dr.IsDBNull(7) Then .Status = dr.GetString(7)
                                If Not dr.IsDBNull(8) Then .ProtectionType = dr.GetString(8)
                                If Not dr.IsDBNull(9) Then .HandlingType = dr.GetString(9)
                                If Not dr.IsDBNull(10) Then .InitialsOfMitigator = dr.GetString(10)
                                If Not dr.IsDBNull(11) Then .SubDesignation = dr.GetString(11)
                                If dr.FieldCount > 13 Then If Not dr.IsDBNull(14) Then .OKTime = Trim(dr.GetDateTime(14))
                                If dr.FieldCount > 14 Then If Not dr.IsDBNull(15) Then .theCancelledBy = dr.GetString(15)
                                If dr.FieldCount > 15 Then If Not dr.IsDBNull(16) Then .theCancelDate = Trim(dr.GetDateTime(16))
                                If dr.FieldCount > 16 Then If Not dr.IsDBNull(17) Then .CancelledBulletinGUID = Trim(dr.GetValue(17))
                            End With
                        End While
                    Next
                    dr.Close()
                    DbConn.Close()
                End Using


                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
                Return False
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Function

        Private Shared Function CreateExceptionList(ByVal sExceptions As String, ByVal b As SubBulletin) As ArrayList
            Dim ExcepList As New ArrayList
            Try

                If Trim(sExceptions) = "" Then Return ExcepList
                Dim Exceps() As String = sExceptions.Split("|")
                Dim e As String
                For Each e In Exceps
                    Dim data() As String = e.Split(";")
                    If data.Length >= 5 Then
                        Dim ex As New TabularGeneralBulletinException
                        If Not optEnableTGBOOperationsForCP Then
                            With ex
                                ex.SystemUID = data(0)
                                ex.theDesignation = data(1)
                                ex.theTBGOSytemUID = data(2)
                                ex.theTGBORouteCodeName = data(3)
                                ex.theTBGOUID = data(4)
                                ex.theGBOUID = b.myGUID
                                ex.theGBO = b
                                ex.theSubdivision = b.thisSubdivision
                                If b.thisSubdivision IsNot Nothing Then ex.theSubUID = b.thisSubdivision.GUID
                            End With
                        Else
                            ex = GetInactiveSubBulletinExceptionByGUID(data(0))
                            If ex IsNot Nothing Then
                                ex.theTBGOUID = data(4)
                            End If
                        End If
                        If ex IsNot Nothing Then
                            If Not ExcepList.Contains(ex) Then ExcepList.Add(ex)
                        End If

                    End If
                Next
                Return ExcepList
            Catch exp As Exception
                GetErrorDetails(exp)
                Return Nothing
            End Try
        End Function

        Private Shared Function CheckSubBulletinExistsInArray(ByVal BulletinArray As ArrayList, ByVal SubBullGUID As String) As Boolean
            Dim SubBull As Object
            Try
                For Each SubBull In BulletinArray
                    If SubBull.GetType.ToString = gSubBulletinName Then
                        If SubBull.myGUID = SubBullGUID Then
                            Return True
                            Exit For
                        End If
                    End If
                Next
            Catch ex As Exception
                TMDS.SystemUtilities.Utilities.SystemException(ex.ToString)
            End Try
            Return False
        End Function

