        Public Shared Function FindSFAByTracknIssueTo(ByVal trk As Track, ByVal IssueTo As String, ByVal trn As TrainID) As TMDS.TrackAuthority.SFAuthority
            If trk Is Nothing Then Return Nothing
            Dim Auth As Object = Nothing
            Dim CheckForTrainAuthOnly As Boolean = False

            Try
                If trn IsNot Nothing Then CheckForTrainAuthOnly = True
                If trk.TrackAuthorities IsNot Nothing AndAlso trk.TrackAuthorities.Count > 0 Then
                    For Each Auth In trk.TrackAuthorities
                        If Auth.GetType.ToString = gSFAComponentName Then
                            If CheckForTrainAuthOnly AndAlso Auth.IssuedToTrain Then
                                If Auth.TrainSymbol = trn.Name Then Return Auth
                            Else
                                If Auth.IssueTo = IssueTo Then Return Auth
                            End If
                        End If
                    Next
                Else
                    Return Nothing
                End If
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function


