                                'IssueToName|FirstLimit|SecondLimit;
                                auth.JointVerbiage = dr.GetString(49)
                            End If
                        End If
                        If dr.FieldCount >= 51 Then
                            If Not dr.IsDBNull(50) Then
                                'IssueToName|FirstLimit|SecondLimit;
                                Dim StrUntilTime() As String = dr.GetString(50).Trim.Split("|")
                                Dim s As String
                                For Each s In StrUntilTime
                                    If s.Trim <> "" Then
                                        auth.UntilTimeInfo.Add(s)
                                    End If
                                Next
                                auth.UntilTimeCount = auth.UntilTimeInfo.Count
                            End If
                        End If
                        If dr.FieldCount >= 52 Then
                            If Not dr.IsDBNull(51) Then
                                auth.Box1List = dr.GetString(51)
                            End If
                        End If

                        If dr.FieldCount >= 56 Then
                            If Not dr.IsDBNull(38) Then auth.PTCAuthorityText = dr.GetString(38)
                            If Not dr.IsDBNull(52) Then auth.PTCAuthoritySegments = dr.GetString(52)
                            If Not dr.IsDBNull(53) Then auth.PTCRestrictionText = dr.GetString(53)
                            If Not dr.IsDBNull(54) Then auth.PTCCompositionCRC = dr.GetInt64(54)
                            If Not dr.IsDBNull(55) Then auth.PTCContingencySegments = dr.GetString(55)
