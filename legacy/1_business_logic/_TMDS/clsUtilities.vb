        Public Shared Function CheckIfBulletinDeliveredToTrain(ByVal SBGUID As String, ByVal TrainName As String) As Boolean
            Dim sb As SubBulletin = Nothing
            Dim exp As TabularGeneralBulletinException = Nothing
            Try
                If SBGUID.Trim = "" Then Return False
                If TrainName.Trim = "" Then Return False
                sb = FindBulletinByGUID(SBGUID)
                If sb Is Nothing Then Return False
                If sb.myExceptionList IsNot Nothing AndAlso sb.myExceptionList.Count > 0 Then
                    For Each exp In sb.myExceptionList
                        If exp.theDesignation = TrainName Then
                            If exp.ProtectionType.Trim.ToUpper <> "DELIVERED" Then
                                Return False
                            Else
                                Return True
                            End If
                        End If
                    Next
                Else
                    Return True
                End If

                sb = Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                sb = Nothing
            End Try
            Return False
        End Function

