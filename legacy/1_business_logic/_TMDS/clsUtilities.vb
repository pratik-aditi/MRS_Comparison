                If exitTrack Is Nothing Then Return Nothing
                Select Case EntrySignal.ComponentType
                    Case "L", "U"
                        If FindEntrySignal Then
                            Direction = "LEFT"
                        Else
                            Direction = "RIGHT"
                        End If

                    Case "R", "D"
                        'Direction = "LEFT"
                        If FindEntrySignal Then
                            Direction = "RIGHT"
                        Else
                            Direction = "LEFT"
                        End If
                End Select

                nextComp = exitTrack
                Do Until SignalFound

                    If Direction = "LEFT" Then
                        If nextComp Is Nothing Then
                            Return Nothing
                        End If
                        If nextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            If nextComp.ComponentType = "R" Or nextComp.ComponentType = "D" Then
                                Return Nothing
                            ElseIf nextComp.ComponentType = "L" Or nextComp.ComponentType = "U" Then
                                Return nextComp
                            End If
                        End If

                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                        If nextComp.GetType.ToString = gFlipFlopComponentName Then
                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RIGHTLink)
                            Direction = "RIGHT"
                        End If
                    End If

                    If Direction = "RIGHT" Then
                        If nextComp Is Nothing Then
                            Return Nothing
                        End If
                        If nextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            If nextComp.ComponentType = "R" Or nextComp.ComponentType = "D" Then
                                Return nextComp
                            ElseIf nextComp.ComponentType = "L" Or nextComp.ComponentType = "U" Then
                                Return Nothing
                            End If
                        End If
                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.RIGHTLink)

                        If nextComp.GetType.ToString = gFlipFlopComponentName Then
                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextComp.LeftLink)
                            Direction = "LEFT"
                        End If

                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl > 15 Then
                        Return Nothing
                    End If
                Loop
                Return Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
        End Function

