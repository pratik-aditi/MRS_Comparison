        Public Shared Function DoesTrainHasActiveTGBO(ByVal TrainName As String) As Integer
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim HasActiveTGBO As Boolean
            Dim HasPendingTGBO As Boolean
            Dim ReturnInt As Integer = 0
            Try

                Dim SQLQuery As String = "SELECT [Status] FROM [tblSystemTabularGeneralBulletinActive] where TypeOfBulletin='TGBO-TRAIN' And IssuedTo='" & TrainName & "'"
                Using dbConn As New OleDbConnection(gConnectionStringDynamic)
                    dbConn.Open()
                    dbcomm = New OleDbCommand(SQLQuery, dbConn)
                    dr = dbcomm.ExecuteReader
                    If dr.HasRows Then
                        While dr.Read
                            If Not dr.IsDBNull(0) Then
                                Select Case dr(0).ToString.Trim.ToUpper
                                    Case "ACTIVE", "ACKNOWLEDGED"
                                        HasActiveTGBO = True
                                    Case "PENDING", "UNACKNOWLEDGED"
                                        HasPendingTGBO = True
                                End Select
                            End If
                        End While
                    End If
                    dr.Close()
                    dbConn.Close()
                End Using

                If HasActiveTGBO AndAlso HasPendingTGBO Then
                    ReturnInt = 3
                ElseIf HasActiveTGBO AndAlso Not HasPendingTGBO Then
                    ReturnInt = 2
                ElseIf Not HasActiveTGBO AndAlso HasPendingTGBO Then
                    ReturnInt = 1
                End If


            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return ReturnInt

        End Function

