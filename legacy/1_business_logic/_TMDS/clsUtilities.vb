                '        If Subdvn.GetKCSGTBNumber >= Subdvn.GTBNumber Then
                '            Dim GTBNO As Integer = Subdvn.GTBNumber
                '            If GTBNO >= Subdvn.GTBRange + Subdvn.GTBFactor Then
                '                GTBNO = Subdvn.GTBRange
                '            Else
