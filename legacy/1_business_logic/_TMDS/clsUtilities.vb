        Public Shared Function FindOSTrackBehindNonOsTrack(ByVal TheTrack As Track, ByVal SearchDirection As String) As Track
            Dim OsTrackFound As Boolean = False
            Dim Comp As Object = Nothing
            Try
                Select Case SearchDirection
                    Case "LEFT"
                        Comp = FindCompFromGUID(TheTrack.RightLink)
                        For i As Integer = 1 To 20
                            If Comp Is Nothing Then Return Nothing
                            If gDebug AndAlso Comp IsNot Nothing Then SystemEvent("FindOSTrackBehindNonOsTrack (" & SearchDirection.Trim.ToUpper & ")-  " & Comp.GetType.ToString & " : " & Comp.guid)

                            If Comp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(Comp, Track)
                                If Comp.OsComponentCollection IsNot Nothing AndAlso Comp.OsComponentCollection.Count > 0 And trk.OStype Then
                                    If gDebug AndAlso Comp IsNot Nothing Then SystemEvent("FindOSTrackBehindNonOsTrack (" & SearchDirection.Trim.ToUpper & ")- OS COMP FOUND " & Comp.GetType.ToString & " : " & Comp.guid)
                                    Return Comp
                                Else
                                    Comp = FindCompFromGUID(Comp.RightLink)
                                End If
                            Else
                                Comp = FindCompFromGUID(Comp.RightLink)
                            End If
                        Next
                    Case "RIGHT"
                        Comp = FindCompFromGUID(TheTrack.LeftLink)
                        For i As Integer = 1 To 20
                            If Comp Is Nothing Then Return Nothing
                            If gDebug AndAlso Comp IsNot Nothing Then SystemEvent("FindOSTrackBehindNonOsTrack (" & SearchDirection.Trim.ToUpper & ")-  " & Comp.GetType.ToString & " : " & Comp.guid)
                            If Comp.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(Comp, Track)
                                If Comp.OsComponentCollection IsNot Nothing AndAlso Comp.OsComponentCollection.Count > 0 And trk.OStype Then
                                    If gDebug AndAlso Comp IsNot Nothing Then SystemEvent("FindOSTrackBehindNonOsTrack (" & SearchDirection.Trim.ToUpper & ")- OS COMP FOUND " & Comp.GetType.ToString & " : " & Comp.guid)
                                    Return Comp
                                Else
                                    Comp = FindCompFromGUID(Comp.LeftLink)
                                End If
                            Else
                                Comp = FindCompFromGUID(Comp.LeftLink)
                            End If
                        Next
                End Select
                Comp = Nothing
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
            Return Comp
        End Function

        Public Shared Function IsMainTypeTrack(ByVal Trk As Track) As Boolean

            Try
                If Trk Is Nothing Then Return True
                If Trk.EnableControlledSiding Then
                    Return True
                Else
                    Select Case Trk.AuthorityType.ToUpper.Trim
                        Case "YL", "RL", "SHELF", "CTC-OTHER", "CTC-PSEUD", "NON-TWC", "OTHER", "NON-TWC"
