        Public Shared Function FindFEDFromName(ByVal FedName As String) As FED
            Dim FD As FED
            Try
                For Each FD In DetectorCollection
                    If FD.Name.Trim.ToUpper = FedName.Trim.ToUpper Then
                        Return FD
