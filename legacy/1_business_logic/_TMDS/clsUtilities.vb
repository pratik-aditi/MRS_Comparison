                                    sb.myType = BulletinType.CONDITION
                                    sb.mysType = "CONDITION"
                            End Select
                            If Not dr.IsDBNull(3) Then sb.EffectTime = dr.GetDateTime(3)
                            If Not dr.IsDBNull(3) Then sb.Created = dr.GetDateTime(3)
                            If Not dr.IsDBNull(5) Then sb.SubName = dr.GetString(5)
                            If Not dr.IsDBNull(6) Then sb.myData = dr.GetString(6)
                            If Not dr.IsDBNull(7) Then sb.myDataSupplement = dr.GetString(7)
                            If Not dr.IsDBNull(8) Then sb.BullUID = dr.GetString(8)
                            If Not dr.IsDBNull(9) Then sb.MilePostBegin = dr.GetString(9)
                            If Not dr.IsDBNull(10) Then sb.MilePostEnd = dr.GetString(10)
                            If Not dr.IsDBNull(11) Then sb.TrackType = dr.GetString(11)
                            If Not dr.IsDBNull(12) Then sb.TrackName = dr.GetString(12)
                            If Not dr.IsDBNull(13) Then sb.MessageTrnFrght = dr.GetString(13)
                            If Not dr.IsDBNull(15) Then sb.MessageTrnPassg = dr.GetString(15)
                            If Not dr.IsDBNull(14) Then sb.SpeedFrght = dr.GetInt32(14)
                            If Not dr.IsDBNull(16) Then sb.SpeedPassg = dr.GetInt32(16)
                            If Not dr.IsDBNull(17) Then sb.Creator = Trim(dr.GetString(17))
                            If Not dr.IsDBNull(19) Then sb.TerrUID = dr.GetInt32(19)
                            If Not dr.IsDBNull(21) Then sb.Cause = Trim(dr.GetString(21)).ToUpper
