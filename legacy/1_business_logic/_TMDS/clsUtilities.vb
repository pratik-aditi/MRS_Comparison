        Public Shared Function GetCurrentTimeDateFromTimeZone(ByVal TimeZone As String, ByVal TypeOfString As String) As String
            Try
                Dim CurrentTime As String
                Dim CurrentDate As String
                Select Case TimeZone
                    Case "E"
                        CurrentTime = Format(Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor)), "HH:mm")
                        CurrentDate = Format(Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor)), "dddd, MMM d yyyy")
                    Case "P"
                        Dim TimeDiff As Integer = (-2 + gThisWorkstationTimeFactor)
                        CurrentTime = Format(Now.AddHours(TimeDiff), "HH:mm")
                        CurrentDate = Format(Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor)), "dddd, MMM d yyyy")

                    Case "M"
                        CurrentTime = Format(Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor)), "HH:mm")
                        CurrentDate = Format(Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor)), "dddd, MMM d yyyy")

                    Case Else
                        CurrentTime = Format(Now.AddHours(CDbl(gThisWorkstationTimeFactor)), "HH:mm")
                        CurrentDate = Format(Now.Date, "dddd, MMM d yyyy")
                End Select

                Select Case TypeOfString
                    Case "D"
                        Return CurrentDate
                    Case "T"
                        Return CurrentTime
                    Case Else
                        Return CurrentDate & " " & CurrentTime
                End Select
                Return String.Empty
            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty
            End Try
        End Function

