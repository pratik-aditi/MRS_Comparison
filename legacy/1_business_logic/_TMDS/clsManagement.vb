        Public mySubdivision As Subdivision
        Public LeftMileage As Double
        Public LeftMileageSuffix As String = String.Empty

        Public RightMileagePrefix As String = String.Empty
        Public LeftMileagePrefix As String = String.Empty

        Public RightMileage As Double
        Public RightMileageSuffix As String = String.Empty
        Public LeftLinkage As Int32 = 0
        Public LeftLinkageAlt As Int32 = 0
        Public RightLinkage As Int32 = 0
        Public RightLinkageAlt As Int32 = 0
        Public HideAsSelection As Boolean
        Public ControlledByThisDesk As Boolean
        Public myDescription As String = ""
        Public myBulletinZone As BulletinZone

        Public Sub AssignSubdivision()
            Try
                Dim s As Subdivision
                For Each s In ControlledSubdivisions
                    If s.GUID = Me.mySubdivisionUID Then
                        Me.mySubdivision = s
                        Exit Sub
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub AssignBulletinZone(ByVal AssignmentMethod As String)
            Try
                Dim ListPosition As Integer = gMileageRangeList.Count
                Dim bz As BulletinZone
                If IsNothing(myBulletinZone) Then
                    For Each bz In gBulletinZoneList
                        Dim bzs As BulletinZoneSubdivision
                        For Each bzs In bz.mySubdivisionAssignments
                            If bzs.mySubName = mySubdivisionName OrElse bzs.mySubUID = mySubdivisionUID Then
                                myBulletinZone = bz
                                SystemEvent(ListPosition.ToString.PadLeft(2, "0") & ":" & AssignmentMethod & "-BULLETIN ZONE ASSIGNMENT MADE TO MILERANGE (" & Me.myName & ") FROM ZONE (" & bz.ZoneName & ")")
                                Exit Sub
                            End If
                        Next
                    Next
                    SystemEvent("NO BULLETIN ZONE ASSIGNMENT MADE TO MILERANGE:" & Me.myName)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
    End Class

    Public Class MileageRangeBulletinContainer
        Public myMileageRange As MileageRange
        Public myBulletinList As New ArrayList
        Public myBulletinListOfUIDs As New ArrayList
        Public DesendingMileage As Boolean
        Public ZoneUID As Int32 = 0
        Public SubUID As Int32 = 0
        Public myTempBulletinList As New ArrayList
        Public myTempBulletinListOfUIDs As New ArrayList
        Public SubName As String = ""

        Public Function GetAndSortBulletins() As Boolean
            Dim TempList As New ArrayList
            Try
                If myMileageRange.LeftMileage > myMileageRange.RightMileage Then
                    DesendingMileage = True
                End If
                Dim uid As String
                For Each uid In myBulletinListOfUIDs
                    Dim bull As SubBulletin = GetBulletin(uid)
                    If Not IsNothing(bull) Then
                        If Not bull.GeneralInformationTGBO AndAlso Not bull.SystemWideBulletin Then
                            TempList.Add(bull)
                        End If
                    Else
                        Return False
                    End If
                Next
                Dim BulletinCount As Integer = TempList.Count
                Dim LoopControl As Integer
                Do Until myBulletinList.Count = BulletinCount
                    Dim sb As SubBulletin
                    Dim bullToRemove As SubBulletin = Nothing
                    Dim HighestMileage As Double
                    For Each sb In TempList
                        If Not DesendingMileage Then
                            If Not String.IsNullOrEmpty(sb.MilePostBegin) AndAlso sb.MilePostBegin.Trim <> "" Then
                                If sb.MilePostBegin >= HighestMileage Then
                                    bullToRemove = sb
                                    HighestMileage = sb.MilePostBegin
                                End If
                            End If
                        Else
                            If Not String.IsNullOrEmpty(sb.MilePostEnd) AndAlso sb.MilePostEnd.Trim <> "" Then
                                If sb.MilePostEnd >= HighestMileage Then
                                    bullToRemove = sb
                                    HighestMileage = sb.MilePostEnd
                                End If
                            End If
                        End If
                    Next
                    If Not IsNothing(bullToRemove) Then
                        myBulletinList.Add(bullToRemove)
                        TempList.Remove(bullToRemove)
                    End If

                    HighestMileage = 0
                    LoopControl += 1
                    If LoopControl > 200 Then
                        Return False
                    End If
                Loop

                If Not DesendingMileage Then
                    TempList.Clear()
                    Dim i As Integer
                    Dim Count As Integer = myBulletinList.Count - 1
                    For i = 0 To Count
                        TempList.Add(myBulletinList.Item(myBulletinList.Count - 1))
                        myBulletinList.RemoveAt(myBulletinList.Count - 1)
                    Next

                    myBulletinList.Clear()
                    Dim b As SubBulletin
                    For Each b In TempList
                        myBulletinList.Add(b)
                    Next
                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Function GetAndSortBulletinsToTempCompareList() As Boolean
            Dim TempList As New ArrayList
            Try
                If myMileageRange.LeftMileage > myMileageRange.RightMileage Then
                    DesendingMileage = True
                End If
                Dim uid As String
                For Each uid In myTempBulletinListOfUIDs
                    Dim bull As SubBulletin = GetBulletin(uid)
                    If Not IsNothing(bull) Then
                        TempList.Add(bull)
                    Else
                        Return False
                    End If
                Next
                Dim BulletinCount As Integer = TempList.Count
                Dim LoopControl As Integer
                Do Until myTempBulletinList.Count = BulletinCount
                    Dim sb As SubBulletin
                    Dim bullToRemove As SubBulletin = Nothing
                    Dim HighestMileage As Double
                    For Each sb In TempList
                        If Not DesendingMileage Then
                            If sb.MilePostBegin >= HighestMileage Then
                                bullToRemove = sb
                                HighestMileage = sb.MilePostBegin
                            End If
                        Else
                            If sb.MilePostEnd >= HighestMileage Then
                                bullToRemove = sb
                                HighestMileage = sb.MilePostEnd
                            End If
                        End If
                    Next

                    myTempBulletinList.Add(bullToRemove)
                    TempList.Remove(bullToRemove)
                    HighestMileage = 0
                    LoopControl += 1
                    If LoopControl > 200 Then
                        Return False
                    End If
                Loop

                If Not DesendingMileage Then
                    TempList.Clear()
                    Dim i As Integer
                    Dim Count As Integer = myTempBulletinList.Count - 1
                    For i = 0 To Count
                        TempList.Add(myBulletinList.Item(myTempBulletinList.Count - 1))
                        myTempBulletinList.RemoveAt(myTempBulletinList.Count - 1)
                    Next

                    myTempBulletinList.Clear()
                    Dim b As SubBulletin
                    For Each b In TempList
                        myTempBulletinList.Add(b)
                    Next
                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Function GetBulletin(ByVal SystemUID As String) As SubBulletin
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Query As String = "SELECT * FROM tblSystemBulletins WHERE SystemUID = '" & SystemUID & "'"
            Dim sb As SubBulletin = Nothing


            Try
                dbconn = New OleDbConnection(gConnectionStringBulletin)
                dbconn.Open()
                dbcomm = New OleDbCommand(Query, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    sb = New SubBulletin

                    If Not dr.IsDBNull(0) Then sb.myGUID = dr.GetString(0)
                    If Not dr.IsDBNull(1) Then sb.myUID = dr.GetInt32(1)
                    If Not dr.IsDBNull(2) Then sb.theType = dr.GetString(2)
                    Select Case sb.theType
                        Case "CANCEL"
                            sb.myType = BulletinType.CANCEL
                            sb.mysType = "CANCEL"
                        Case "SPEED"
                            sb.myType = BulletinType.SPEED
                            sb.mysType = "SPEED"
                        Case "WORKZONE"
                            sb.myType = BulletinType.WORKZONE
                            sb.mysType = "WORKZONE"
                        Case "INFORMATIONAL"
                            sb.myType = BulletinType.INFORMATIONAL
                            sb.mysType = "INFORMATIONAL"
                        Case "CONDITION"
                            sb.myType = BulletinType.CONDITION
                            sb.mysType = "CONDITION"
                    End Select
                    If Not dr.IsDBNull(3) Then sb.EffectTime = dr.GetDateTime(3)
                    If Not dr.IsDBNull(3) Then sb.Created = dr.GetDateTime(3)
                    If Not dr.IsDBNull(5) Then sb.SubName = dr.GetString(5)
                    If Not dr.IsDBNull(6) Then sb.myData = dr.GetString(6)
                    If Not dr.IsDBNull(7) Then sb.myDataSupplement = dr.GetString(7)
                    If Not dr.IsDBNull(8) Then sb.BullUID = dr.GetString(8)
                    If Not dr.IsDBNull(9) Then sb.MilePostBegin = dr.GetString(9)
                    If Not dr.IsDBNull(10) Then sb.MilePostEnd = dr.GetString(10)
                    If Not dr.IsDBNull(11) Then sb.TrackType = dr.GetString(11)
                    If Not dr.IsDBNull(12) Then sb.TrackName = dr.GetString(12)
                    If Not dr.IsDBNull(13) Then sb.MessageTrnFrght = dr.GetString(13)
                    If Not dr.IsDBNull(15) Then sb.MessageTrnPassg = dr.GetString(15)
                    If Not dr.IsDBNull(14) Then sb.SpeedFrght = dr.GetInt32(14)
                    If Not dr.IsDBNull(16) Then sb.SpeedPassg = dr.GetInt32(16)
                    If Not dr.IsDBNull(17) Then sb.Creator = Trim(dr.GetString(17))
                    If Not dr.IsDBNull(19) Then sb.TerrUID = dr.GetInt32(19)
                    If Not dr.IsDBNull(21) Then sb.Cause = Trim(dr.GetString(21)).ToUpper
                    If Not dr.IsDBNull(21) Then sb.Instructions = Trim(dr.GetString(21)).Trim


                    If dr.FieldCount >= 33 Then
                        If Not dr.IsDBNull(22) Then sb.MilePostBeginSuffix = Trim(dr.GetString(22)).ToUpper
                        If Not dr.IsDBNull(23) Then sb.MilePostEndSuffix = Trim(dr.GetString(23)).ToUpper
                        If Not dr.IsDBNull(24) Then sb.mysTypeForm = Trim(dr.GetString(24)).ToUpper
                        Select Case sb.mysTypeForm
                            Case "FORMA"
                                sb.myTypeForm = BulletinFormType.FORMA
                            Case "FORMB"
                                sb.myTypeForm = BulletinFormType.FORMB
                                Dim data() As String = sb.myData.Split("|")
                                If data.Length >= 3 Then
                                    sb.Action = data(0)
                                    sb.Foreman = data(1)
                                    sb.Gang = data(2)
                                End If
                            Case "FORMC"
                                sb.myTypeForm = BulletinFormType.FORMC
                            Case "FORMTC"
                                sb.myTypeForm = BulletinFormType.FORMTC
                                Dim data() As String = sb.myData.Split("|")
                                If data.Length >= 2 Then
                                    sb.Location = data(0)
                                    sb.PersonPostingBulletin = data(1)
                                End If
                            Case "1102"
                                sb.myTypeForm = BulletinFormType.FORMB
                                If sb.myData <> "" Then
                                    Dim data() As String = sb.myData.Split("|")
                                    If data.Length >= 3 Then
                                        sb.Foreman = data(1)
                                    End If
                                End If
                            Case "1103"
                                sb.myTypeForm = BulletinFormType.FORMA
                            Case "C-1102", "C-1103", "C-MISC"
                                sb.myTypeForm = BulletinFormType.CANCEL


                        End Select

                        If Not dr.IsDBNull(25) Then sb.SubUID = Trim(dr.GetString(25)).ToUpper
                        If Not dr.IsDBNull(26) Then sb.FlagData = Trim(dr.GetString(26)).ToUpper
                        Dim Flags() As String = sb.FlagData.Split("|")
                        Dim f As String
                        Dim FlagCount As Integer = 0
                        For Each f In Flags
                            Dim data() As String = f.Split(";")
                            FlagCount += 1
                            If FlagCount = 1 Then
                                If data.Length = 2 Then
                                    sb.FlagMilePostBegin1 = data(0)
                                    sb.FlagMilePostBeginSuffix1 = data(1)
                                ElseIf data.Length = 5 Then
                                    sb.FlagMilePostBegin1 = data(0)
                                    sb.FlagMilePostBeginSuffix1 = data(1)
                                    sb.FlagMilePostBeginPrefix1 = data(2)
                                End If
                            ElseIf FlagCount = 2 Then
                                If data.Length = 2 Then
                                    sb.FlagMilePostEnd1 = data(0)
                                    sb.FlagMilePostEndSuffix1 = data(1)
                                ElseIf data.Length = 5 Then
                                    sb.FlagMilePostEnd1 = data(0)
                                    sb.FlagMilePostEndSuffix1 = data(1)
                                    sb.FlagMilePostEndPrefix1 = data(2)
                                End If
                            End If
                        Next
                        If Not dr.IsDBNull(27) Then sb.Comments = Trim(dr.GetString(27)).ToUpper
                        If Not dr.IsDBNull(28) Then sb.Direction = Trim(dr.GetString(28)).ToUpper
                        If Not dr.IsDBNull(29) Then sb.TimeFrom = Trim(dr.GetDateTime(29)).ToUpper
                        If Not dr.IsDBNull(30) Then sb.TimeUntil = Trim(dr.GetDateTime(30)).ToUpper
                        If Not dr.IsDBNull(31) Then sb.Daily = Trim(dr.GetBoolean(31)).ToUpper
                        If Not dr.IsDBNull(32) Then sb.DisplayIndex = Trim(dr.GetByte(32)).ToUpper

                        'If Not dr.IsDBNull(33) Then sb.EffectTime = Trim(dr.GetDateTime(33))
                        If Not dr.IsDBNull(34) Then sb.CorrelatingTagUID = Trim(dr.GetString(34))

                        If Not dr.IsDBNull(35) Then sb.FlagMilePostBegin1SubUID = Trim(dr.GetInt32(35))
                        If Not dr.IsDBNull(36) Then sb.FlagMilePostBegin1 = Trim(dr.GetDouble(36))
                        If Not dr.IsDBNull(37) Then sb.FlagMilePostBeginSuffix1 = Trim(dr.GetString(37))

                        If Not dr.IsDBNull(38) Then sb.FlagMilePostEnd1SubUID = Trim(dr.GetInt32(38))
                        If Not dr.IsDBNull(39) Then sb.FlagMilePostEnd1 = Trim(dr.GetDouble(39))
                        If Not dr.IsDBNull(40) Then sb.FlagMilePostEndSuffix1 = Trim(dr.GetString(40))

                        '************************************** FLAG DATA BEGIN***************************
                        ProcessBullFlagDataRead(dr, sb, "MileageRangeBulletinContainer-GetBulletin")
                        '************************************** FLAG DATA END***************************

                        If dr.FieldCount >= 55 Then
                            If Not dr.IsDBNull(53) Then sb.myStatus = Trim(dr.GetString(53))
                            If Not dr.IsDBNull(54) Then sb.ConfirmationData = Trim(dr.GetString(54))
                        End If

                        If dr.FieldCount >= 60 Then
                            If Not dr.IsDBNull(55) Then sb.MileRangeGUID1 = Trim(dr.GetString(55))
                            If Not dr.IsDBNull(56) Then sb.MileRangeGUID2 = Trim(dr.GetString(56))
                            If Not dr.IsDBNull(57) Then sb.MileRangeGUID3 = Trim(dr.GetString(57))
                            If Not dr.IsDBNull(58) Then sb.MileRangeGUID4 = Trim(dr.GetString(58))
                            Dim ExceptionList As String = String.Empty
                            If Not dr.IsDBNull(59) Then ExceptionList = Trim(dr.GetString(59))
                        End If

                        If dr.FieldCount >= 89 Then
                            If Not dr.IsDBNull(70) Then sb.PersonRequesting = Trim(dr.GetString(70))
                            If Not dr.IsDBNull(76) Then sb.FlagDisplayInfo = Trim(dr.GetString(76))
                            If Not dr.IsDBNull(79) Then sb.TrainSpecific = Trim(dr.GetBoolean(79))
                            If Not dr.IsDBNull(80) Then sb.TrainSymbol = Trim(dr.GetString(80))
                            If Not dr.IsDBNull(81) Then sb.BulletinComments = Trim(dr.GetString(81))
                            If Not dr.IsDBNull(82) Then sb.ReasonCode = Trim(dr.GetValue(82))
                            If Not dr.IsDBNull(85) Then sb.CrossingProtectionItem = Trim(dr.GetString(85))
                            If Not dr.IsDBNull(86) Then sb.CrossingProtectionReason = Trim(dr.GetString(86))
                            If Not dr.IsDBNull(87) Then sb.CrossingName = Trim(dr.GetString(87))
                            If Not dr.IsDBNull(88) Then sb.CrossingDOT = Trim(dr.GetString(88))
                            If Not dr.IsDBNull(89) Then sb.BulletinReadData = Trim(dr.GetString(89))
                        End If
                        If dr.FieldCount >= 97 Then
                            If Not dr.IsDBNull(90) Then sb.CancelledBulletin = Trim(dr.GetBoolean(90))
                            If Not dr.IsDBNull(91) Then sb.CancelledByPerson = Trim(dr.GetString(91))
                            If Not dr.IsDBNull(92) Then sb.CancelledTimeStamp = Trim(dr.GetDateTime(92))
                            If Not dr.IsDBNull(93) Then sb.TrackBlocked = Trim(dr.GetBoolean(93))
                            If Not dr.IsDBNull(94) Then sb.TrackOutOfSevice = Trim(dr.GetBoolean(94))
                            If Not dr.IsDBNull(95) Then sb.GeneralInformationTGBO = Trim(dr.GetBoolean(95))
                            If Not dr.IsDBNull(96) Then sb.GeneralInformationDOB = Trim(dr.GetBoolean(96))
                        End If
                        If dr.FieldCount >= 102 Then
                            If Not dr.IsDBNull(101) Then sb.MilePostBeginPrefix = dr.GetString(101).ToUpper.Trim
                            If Not dr.IsDBNull(102) Then sb.MilePostEndPrefix = dr.GetString(102).ToUpper.Trim
                        End If
                        If dr.FieldCount >= 104 Then
                            If Not dr.IsDBNull(103) Then sb.HeadEndRestrictionOnly = Trim(dr.GetBoolean(103))
                            If Not dr.IsDBNull(100) Then sb.PTCBulletinText = dr.GetString(100)
                        End If
                        If dr.FieldCount >= 108 Then
                            If Not dr.IsDBNull(106) Then sb.SystemWideBulletin = dr.GetBoolean(106)
                            If Not dr.IsDBNull(107) Then sb.NonBlockingBulletin = dr.GetBoolean(107)
                            If sb.SystemWideBulletin Or sb.NonBlockingBulletin Then sb.NonDisplayed = True
                        End If
                        If dr.FieldCount >= 109 Then
                            If Not dr.IsDBNull(108) Then sb.CorrelatingRestrictionUID = dr.GetString(108)
                        End If
                        If dr.FieldCount >= 113 Then
                            If Not dr.IsDBNull(110) Then sb.OnBoardCRC = dr.GetValue(110)
                            If Not dr.IsDBNull(111) Then sb.CancelledBulletinUID = dr.GetValue(111)
                            If Not dr.IsDBNull(112) Then sb.CancelledBulletinGUID = dr.GetValue(112)
                            If Not dr.IsDBNull(113) Then sb.CancelledBulletinCRC = dr.GetValue(113)
                        End If

                        If dr.FieldCount >= 115 Then
                            If Not dr.IsDBNull(114) Then Boolean.TryParse(dr.GetValue(114), sb.CrossingOnNonControlledTrack)
                            If Not dr.IsDBNull(116) Then sb.MobileID = dr.GetValue(116)
                        End If

                    End If


                End While
                dbconn.Close()
                dbconn = Nothing
                Return sb
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return Nothing
            End Try
        End Function

        Public Function ParseBulletinsOutOfTheRange(ByRef BullContainer As ArrayList) As Boolean
            Dim DescendingFromLeftToRight As Boolean
            Dim TempList As New ArrayList
            Dim FlipMilePost As Boolean = False
            Try
                If myMileageRange.LeftMileage > myMileageRange.RightMileage Then
                    DescendingFromLeftToRight = True
                    FlipMilePost = True
                End If

                Dim bc As BulletinContainer
                For Each bc In BullContainer
                    If myMileageRange.mySubdivisionUID = bc.SubdivisionUID Then
                        Dim MileageFrom As Double = CDbl(bc.MilePostBegin)
                        Dim MileageTo As Double = CDbl(bc.MilePostEnd)
                        If FlipMilePost Then
                            MileageFrom = CDbl(bc.MilePostEnd)
                            MileageTo = CDbl(bc.MilePostBegin)
                        End If
                        If DescendingFromLeftToRight Then
                            If MileageFrom <= myMileageRange.LeftMileage And MileageFrom >= myMileageRange.RightMileage Then
                                If Not TempList.Contains(bc) Then
                                    TempList.Add(bc)
                                    SystemEvent("ParseBulletinsOutOfTheRange-BULLETIN ADDED1:" & bc.RestrictionUID & " FROM:" & bc.MilePostBegin & " TO:" & bc.MilePostEnd & " SUBUID:" & bc.SubdivisionUID & " GUID:" & bc.SystemUID)
                                End If
                            ElseIf (myMileageRange.LeftMileage <= MileageFrom And myMileageRange.LeftMileage >= MileageTo) And
                                   (myMileageRange.RightMileage <= MileageFrom And myMileageRange.RightMileage >= MileageTo) Then
                                If Not TempList.Contains(bc) Then
                                    TempList.Add(bc)
                                    SystemEvent("ParseBulletinsOutOfTheRange-BULLETIN ADDED2:" & bc.RestrictionUID & " FROM:" & bc.MilePostBegin & " TO:" & bc.MilePostEnd & " SUBUID:" & bc.SubdivisionUID & " GUID:" & bc.SystemUID)
                                End If
                            ElseIf MileageTo <= myMileageRange.LeftMileage And MileageTo >= myMileageRange.RightMileage Then
                                If Not TempList.Contains(bc) Then
                                    TempList.Add(bc)
                                    SystemEvent("ParseBulletinsOutOfTheRange-BULLETIN ADDED3:" & bc.RestrictionUID & " FROM:" & bc.MilePostBegin & " TO:" & bc.MilePostEnd & " SUBUID:" & bc.SubdivisionUID & " GUID:" & bc.SystemUID)
                                End If
                            Else
                                SystemEvent("ParseBulletinsOutOfTheRange-BULLETIN DELETED1:" & bc.RestrictionUID & " FROM:" & bc.MilePostBegin & " TO:" & bc.MilePostEnd & " SUBUID:" & bc.SubdivisionUID & " GUID:" & bc.SystemUID)
                            End If
                        Else
                            If MileageFrom >= myMileageRange.LeftMileage And MileageFrom <= myMileageRange.RightMileage Then
                                If Not TempList.Contains(bc) Then
                                    TempList.Add(bc)
                                    SystemEvent("ParseBulletinsOutOfTheRange-BULLETIN ADDED4:" & bc.RestrictionUID & " FROM:" & bc.MilePostBegin & " TO:" & bc.MilePostEnd & " SUBUID:" & bc.SubdivisionUID & " GUID:" & bc.SystemUID)
                                End If

                            ElseIf (myMileageRange.LeftMileage >= MileageFrom And myMileageRange.LeftMileage <= MileageTo) And
                                   (myMileageRange.RightMileage >= MileageFrom And myMileageRange.RightMileage <= MileageTo) Then
                                If Not TempList.Contains(bc) Then
                                    TempList.Add(bc)
                                    SystemEvent("ParseBulletinsOutOfTheRange-BULLETIN ADDED4:" & bc.RestrictionUID & " FROM:" & bc.MilePostBegin & " TO:" & bc.MilePostEnd & " SUBUID:" & bc.SubdivisionUID & " GUID:" & bc.SystemUID)
                                End If

                            ElseIf MileageTo >= myMileageRange.LeftMileage And MileageTo <= myMileageRange.RightMileage Then
                                If Not TempList.Contains(bc) Then
                                    TempList.Add(bc)
                                    SystemEvent("ParseBulletinsOutOfTheRange-BULLETIN ADDED5:" & bc.RestrictionUID & " FROM:" & bc.MilePostBegin & " TO:" & bc.MilePostEnd & " SUBUID:" & bc.SubdivisionUID & " GUID:" & bc.SystemUID)
                                End If
                            Else
                                SystemEvent("ParseBulletinsOutOfTheRange-BULLETIN DELETED2:" & bc.RestrictionUID & " FROM:" & bc.MilePostBegin & " TO:" & bc.MilePostEnd & " SUBUID:" & bc.SubdivisionUID & " GUID:" & bc.SystemUID)
                            End If
                        End If
                    End If
                Next

                BullContainer = TempList
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

