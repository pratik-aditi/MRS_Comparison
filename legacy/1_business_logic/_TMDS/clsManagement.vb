#Region "TRAIN PLAN"

    Public Class TrainPlan
        Public myTrainPlanString As String
        Public mySignalRouteList As New ArrayList
        Public myTrainSymbol As String

        Public Sub RetrieveTrainPlan()
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim query As StringBuilder = Nothing
            Dim Plan As String = String.Empty
            Try
                query = New StringBuilder("SELECT TrainPlan FROM tblTrainMovementPlans WHERE (TrainSymbol = '" & myTrainSymbol & "')")
                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                dbcomm = New OleDbCommand(query.ToString, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    If Not dr.IsDBNull(0) Then myTrainPlanString = dr.GetString(0)
                End While
                dbconn.Close()
                dbconn = Nothing
                If Trim(myTrainPlanString) = "" Then
                    SystemEvent("NO TRAIN PLAN FOUND:" & myTrainSymbol)
                    Exit Sub
                End If
                myTrainPlanString = myTrainPlanString.Replace(">", "")

                Dim routes() As String = myTrainPlanString.Split("<")
                Dim r As String
                For Each r In routes
                    If Trim(r) <> "" Then
                        Dim data() As String = r.Split("(")
                        Dim SignalRouteGUID As String = data(0).Replace(")", "")
                        mySignalRouteList.Add(SignalRouteGUID)

                        Dim d As String
                        If data.Count > 1 Then
                            Dim deps() As String = data(1).Split(")")
                            For Each d In deps
                                d = d.Replace(")", "")
                            Next
                        End If
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
        End Sub

    End Class
