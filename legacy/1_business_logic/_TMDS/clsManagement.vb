        Public Shared Sub ProcessTrainSymbolModify(ByVal messageToProcess As String)

            Try
                DebugEvent("ProcessTrainSymbolModify:" & messageToProcess)

                Dim DataString() As String = messageToProcess.Split(";")
                If DataString.Length >= 7 Then
                    Dim Symbol As String = DataString(1)
                    Dim UnitID As String = DataString(2)
                    Dim NewSymbol As String = DataString(3)
                    Dim trn As TrainID
                    Dim TrnFound As TrainID = Nothing
                    Dim SymbolChanges As Boolean
                    Dim UnitChanges As Boolean
                    Dim Response As String

                    For Each trn In TMDS.GlobalDeclarations.TrainCollection
                        If trn.Name = Symbol Then
                            TrnFound = trn
                            Exit For
                        End If
                    Next
                    If Not TrnFound Is Nothing Then
                        If TrnFound.Name <> NewSymbol Then
                            SymbolChanges = True
                        End If
                        Dim IdentifingUnitTrimmed As String = String.Empty
                        Dim UnitIDTrimmed As String = String.Empty

                        If TrnFound.IdentifingUnit <> "" Then
                            IdentifingUnitTrimmed = TrnFound.IdentifingUnit.Replace(" ", "")
                        End If
                        If UnitID <> "" Then
                            UnitIDTrimmed = UnitID.Replace(" ", "")
                        End If
                        If IdentifingUnitTrimmed <> UnitIDTrimmed Then
                            UnitChanges = True
                        End If

                        'If TrnFound.IdentifingUnit <> UnitID Then
                        '    UnitChanges = True
                        'End If
                        If SymbolChanges Or UnitChanges Then
                            TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.TrainSymbolChange, messageToProcess, TrnFound, Nothing)
                        End If
                    Else
                        Response = Symbol.PadRight(18, " ") & "N"
                        TMDS.NetworkMessages.CadMessages.SendSymbolModifyResponse(Response, gCadTransmitQueue)
                        Exit Sub
                    End If

                End If
                DebugEvent("TRAIN MODIFY MESSAGE PROCESSED FROM COMMUNICATION CHANNEL:" & messageToProcess)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

