        Public Sub RemoveWorkTask(Optional ByVal DeletedByDispatcher As Boolean = False)
            Dim SQLQueryList As New ArrayList
            Try
                If gAssistMode Then Exit Sub
                Dim theMove As New StringBuilder("INSERT INTO tblSystemWorkTasksInActive  SELECT * FROM tblSystemWorkTasksActive WHERE UID = '" & UID & "'")
                Dim theDelete As New StringBuilder("DELETE FROM tblSystemWorkTasksActive WHERE UID = '" & UID & "'")
                With SQLQueryList
                    .Add(theMove.ToString)
                    .Add(theDelete.ToString)
                End With
                If ExecuteQueryCollection(SQLQueryList, gConnectionStringTrain) Then
                    myTrain.myWorkTaskList.Remove(Me)
                    'SystemDatabaseCommandToDynamicTrain("RemoveWorkTask-theMove", theMove.ToString)
                    'SystemDatabaseCommandToDynamicTrain("RemoveWorkTask-theDelete", theDelete.ToString)
                    gWorkTasks.Remove(Me)
                    Dim SummItem As New SummaryItem("WORKTASK", "DELETE", Me)
                    SyncLock TMDS.GlobalDeclarations.gWorkTasksSummaryQueue.SyncRoot
                        TMDS.GlobalDeclarations.gWorkTasksSummaryQueue.Enqueue(SummItem)
                    End SyncLock
                    If DeletedByDispatcher AndAlso myTrain IsNot Nothing Then
                        Dim RRUniqueName As String = myTrain.GetStationUniqueName(myTrain.myTrack.myControlPoint.Name)
                        Dim EvtStr As String = Me.TaskDetails & " - Deleted by Dispatcher[" & gCurrentUser.UserFullName & "]"
                        myTrain.AddTrainSheetEvent("WORK-TASK-DELETED", Now, Mid(myTrain.myTrack.TimeZone, 1, 1), EvtStr, myTrain.myTrack.myControlPoint.GUID.ToString, myTrain.GetIdentifyingLocationNameFromLimits, RRUniqueName)
                    End If
                End If


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub CreateTask(ByRef RemoveWorkTask As Boolean)
            Dim ShowWTinTaskWindow As Boolean = True
            Dim AlertMessage As String = ""
            Dim ShowAlertForConsist As Boolean = False
            Dim ShowAlertForCrewRequest As Boolean = False
            Try
                If gAssistMode Then Exit Sub
                Dim data() As String = Me.TaskData.Split("|")

                Select Case TaskType
                    Case "IETMS-AUTHORITY-ISSUANCE-REQUEST"
                        TaskName = "REQUEST NEW AUTHORITY FROM TRAIN CREW"
                        TaskDetails = "NEW AUTHORITY REQUEST FROM TRAIN (" & Me.myTrain.Name & ") EMPLOYEE (" & data(5) & ")"
                        AlertMessage = "NEW AUTHORITY REQUEST FROM TRAIN CREW FOR (" & Me.myTrain.Name & "). PLEASE VERIFY"
                        ShowAlertForCrewRequest = True

                    Case "IETMS-AUTHORITY-EXTENSION-REQUEST"
                        TaskName = "REQUEST AUTHORITY TIME EXTENSION FROM TRAIN CREW"
