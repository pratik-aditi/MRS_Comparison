        Public Shared Sub ProcessBulletinChangeEvent(ByVal message As String)
            Try
                Dim theMessage As String = message.Replace(Chr(4), "")
                Dim data() As String = theMessage.Split(";")
                Dim mess() As String = data(1).Split("|")
                'message = "BULLETINCHANGEEVENT;"
                'message = message & EventType & "|" & SubName & "|" & BullNumber
                If mess(0) = "ADD" Then
                    Dim subdvn As Subdivision
                    For Each subdvn In TMDS.GlobalDeclarations.ControlledSubdivisions
                        If subdvn.Name = mess(1) Then
                            If TMDS.SystemUtilities.BulletinFunction.AddSubdivisionBulletinRecords(mess(1), CInt(mess(2))) Then
                                TMDS.SystemUtilities.BulletinFunction.UpdateSummary()
                            End If
                        End If
                    Next
                ElseIf mess(0) = "REMOVE" Then
                    Dim bull As Bulletin
                    Dim BulletinToDelete As Bulletin = Nothing
                    For Each bull In TMDS.GlobalDeclarations.BulletinCollection
                        If bull.BullNumber = CInt(mess(2)) Then
                            BulletinToDelete = bull
                            Exit For
                        End If
                    Next
                    TMDS.GlobalDeclarations.BulletinCollection.Remove(BulletinToDelete)
                    TMDS.SystemUtilities.BulletinFunction.UpdateSummary()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Sub ProcessBulletinUpdateEvent(ByVal messageToProcess As String)
            Try
                SystemEvent("ProcessBulletinUpdateEvent:" & messageToProcess)
                If optEnableBulletinSubTypes And optEnableDisplayBulletinsOnTracks Then
                    Dim data() As String = messageToProcess.Split(";")
                    Dim BullUID As String = data(1)
                    Dim Action As String = data(2)
                    Dim sb As SubBulletin
                    Dim BulletinExists As Boolean
                    For Each sb In TMDS.GlobalDeclarations.BulletinCollection
                        If sb.myUID = BullUID Then
                            BulletinExists = True
                        End If
                    Next
                    If BulletinExists Then
                        SystemEvent("BULLETIN EXISTS:" & messageToProcess)
                    Else
                        Select Case Action
                            Case "ADD"
                                SystemEvent("RETRIEVING BULLETIN:" & messageToProcess)
                                TMDS.SystemUtilities.BulletinFunction.RetrieveSubBulletin(BullUID)
                            Case "REMOVE"
                                SystemEvent("REMOVE BULLETIN:" & messageToProcess)
                                TMDS.SystemUtilities.BulletinFunction.RemoveSubBulletin(BullUID)
                        End Select
                    End If
                Else
                    SystemEvent("ProcessBulletinUpdateEvent is Disabled!")
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

