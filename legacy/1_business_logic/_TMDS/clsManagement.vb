        Public Sub ApplyTerritoryAssignments()
            Try
                Dim Item As String
                If WrkStnTerritoryAssignmentString IsNot Nothing Then
                    For Each Item In WrkStnTerritoryAssignmentString
                        Dim Assignment() As String = Item.Split("|")
                        If Assignment.Length > 0 Then
                            If IsNumeric(Assignment(0)) Then
                                If Not WrkStnTerritoryAssignments.Contains(Assignment(0)) Then
                                    If Assignment(0) <> "" Then
                                        WrkStnTerritoryAssignments.Add(Assignment(0))
                                    End If
                                End If
                            End If
                        End If
                    Next
                End If
            Catch
            End Try
        End Sub

        Public Sub ApplyConsoleAssignments()
            Try
