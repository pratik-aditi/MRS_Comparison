        Public Function RollUpTWC(ByVal WarrantNumber As String, ByVal Components As String) As Boolean
            Try
                If optEnableTerritoryDeskAssignmentMode Then
                    If Not CheckForShadowMode(Components) Then Exit Function
                End If
                Dim comp As Object
                Dim auth As TMDS.TrackAuthority.Warrant = Nothing
                Dim AuthToDelete As TMDS.TrackAuthority.Warrant = Nothing
                For Each auth In TMDS.GlobalDeclarations.TrackWarrants
                    If auth.WarrantNumber = WarrantNumber Then
                        AuthToDelete = auth
                        Exit For
                    End If
                Next

                If IsNothing(AuthToDelete) Then
                    Return False
                End If
                Dim CompToDelete As New ArrayList()
                Dim DeleteList As New ArrayList()

                Dim GUIDs() As String = Components.Split("-")
                Dim strGUID As String

                Dim AddToList As Boolean
                For Each comp In AuthToDelete.SelectionComponents

                    For Each strGUID In GUIDs
                        If IsNumeric(strGUID) Then
                            AddToList = True
                            If comp.GUID = CInt(strGUID) Then
                                AddToList = False
                                Exit For
                            End If
                        End If
                    Next

                    If AddToList Then
                        DeleteList.Add(comp.GUID.ToString)
                    End If

                Next

                For Each strGUID In DeleteList
                    If IsNumeric(strGUID) Then
                        Dim compToBlock As Object = FindComponent(CInt(strGUID))
                        If Not compToBlock Is Nothing Then
                            CompToDelete.Add(compToBlock)
                        End If
                    End If
                Next

                For Each comp In CompToDelete
                    comp.ActiveTrackWarrant = False
                    comp.TrafficDirection = ""
                    comp.Authorities.Remove(auth)
                    comp.UpdateStatus()
                Next
                Dim SummItem As New SummaryItem("AUTHORITY", "REFRESH", Nothing)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

