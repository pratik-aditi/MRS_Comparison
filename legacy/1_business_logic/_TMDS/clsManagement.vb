        Private Function GetSystemLocomotiveInsertString(ByVal ES As clsEngineSet) As String
            Dim InsertString As String
            Dim SQLFields As String
            Dim SQLValues As String
            Dim s As String = ","
            Dim q As String = "'"
            Try
                SQLFields = "("
                SQLFields = SQLFields & " UID, TypeOfLocomotive, Direction, HorsePower, EffectiveHP, UnitCondition, UnitPosition, Length, Weight, DPSequenceNumber, "
                SQLFields = SQLFields & "Isolated, DPCapable, DPEnabled, TwoWayETD, GPSEquipped, CurrentOrigin, CurrentDestination, UnitBehindCarNumber, Status"
                SQLFields = SQLFields & ")"

                SQLValues = " VALUES ("
                SQLValues = SQLValues & q & ES.UnitID & q & s
                SQLValues = SQLValues & q & ES.LocoType & q & s
                SQLValues = SQLValues & q & ES.Direction & q & s
                SQLValues = SQLValues & ES.HPtotal & s
                SQLValues = SQLValues & ES.HPEffective & s
                SQLValues = SQLValues & q & ES.UnitCond & q & s
                SQLValues = SQLValues & ES.UnitPosition & s
                SQLValues = SQLValues & ES.Length & s
                SQLValues = SQLValues & ES.Weight & s
                SQLValues = SQLValues & ES.DPSequenceNumber & s
                SQLValues = SQLValues & CInt(ES.UnitIsol) & s
                SQLValues = SQLValues & CInt(ES.UnitDPCapable) & s
                SQLValues = SQLValues & CInt(ES.UnitDPEnabled) & s
                SQLValues = SQLValues & CInt(ES.ETDTW) & s
                SQLValues = SQLValues & CInt(ES.GPS) & s
                SQLValues = SQLValues & q & ES.FullOriginStation & q & s
                SQLValues = SQLValues & q & ES.FullDestStation & q & s
                SQLValues = SQLValues & q & ES.UnitBehindCarNumber & q & s
                SQLValues = SQLValues & q & ES.Status & q
                SQLValues = SQLValues & ")"

                InsertString = "INSERT INTO tblSystemLocomotives " & SQLFields & SQLValues

                Return InsertString
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
        End Function




