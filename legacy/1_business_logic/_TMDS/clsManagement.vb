        Private Shared Sub ProcessMA_1053_PSS_ReleaseMessageResponse(ByVal MessageResponse As String, ByVal auth As TrackAuthority.OtherSpecialAuthorityType, Fullfilled As Boolean)
            Try
                If auth.PTCMarkedToBeVoidedElectronically OrElse Fullfilled Then
                    Select Case MessageResponse
                        Case "FAILED"
                            auth.PTCStatus = "RELEASE-FAILED"
                            auth.SetPTCAuthorityFlasherStatus()
                            auth.CheckToAcknowledgeAlert()
                            auth.PTCTransmissionCompleted()

                            If auth.DoRemoveAuthority Then
                                SystemEvent("AUTHORITY REMOVAL FORCED FROM MA-2061 MESSAGE RECEIPT: " & auth.AuthorityUID)
                            End If
                            auth = Nothing
                        Case "DELIVERED"
                            auth.PTCStatus = "RELEASE-PENDING"
                            auth.SetPTCAuthorityFlasherStatus()
                        Case "ACCEPTED"
                            If auth.DoRemoveAuthority Then
                                auth.PTCStatus = "RELEASE-SUCCESSFUL"
                                auth.FlasherMode(False)
                                SystemEvent("AUTHORITY REMOVAL ACCEPTED FROM MA-2061 MESSAGE RECEIPT: " & auth.AuthorityUID)
                                auth.PTCTransmissionCompleted()
                                auth.CheckToAcknowledgeAlert()
                            End If

                            'Send event to control server and db
                            'If auth IsNot Nothing Then
                            '    Dim DoAddAuthorityEvent As New DoEventLogTrackTimePSS(AddressOf auth.LogTheTrackTimeEvent)
                            '    DoAddAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.OtherSpecialAuthorityType.EventTypeTNT.REMOVE, Nothing, Nothing)
                            '    Dim DoAuthorityEvent As New DoPublishTNTEventPSS(AddressOf auth.PublishTNTEventUpdate)
                            '    DoAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.OtherSpecialAuthorityType.EventTypeTNT.REMOVE, Nothing, Nothing)
                            'End If

                    End Select
                    If auth.UpdateDatabaseWithPTCAuthorityStatus(auth.PTCStatus) Then
                        SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_1053_TNT_ReleaseMessageResponse-AUTHORITY:" & auth.AuthorityUID & " STATUS=" & auth.PTCStatus)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub ProcessMA_1054_PSS_ReleaseMessageResponse(ByVal MessageResponse As String, ByVal auth As TrackAuthority.OtherSpecialAuthorityType)
            Dim OkToProceed As Boolean = False
            Try
                If optProcessPTCPSSEMT_FulfillmentMessage Or optEnableAutomaticRemovalOfStopTarget Then
                    If optProcessPTCPSSEMT_FulfillmentMessage Then
                        If auth.PTCMarkedToBeVoidedElectronically Then OkToProceed = True
                    ElseIf optEnableAutomaticRemovalOfStopTarget AndAlso Not optProcessPTCPSSEMT_FulfillmentMessage Then
                        If auth IsNot Nothing AndAlso auth.RemoveStopTarget Then
                            OkToProceed = True
                        End If
                    End If
                End If

                If Not OkToProceed Then Exit Sub
                'If auth.PTCMarkedToBeVoidedElectronically Then
                Select Case MessageResponse
                    Case "FAILED"
                        auth.PTCStatus = "RELEASE-FAILED"
                        auth.SetPTCAuthorityFlasherStatus()
                        auth.CheckToAcknowledgeAlert()
                        auth.PTCTransmissionCompleted()

                        If auth.DoRemoveAuthority Then
                            SystemEvent("AUTHORITY REMOVAL FORCED FROM MA-2061 MESSAGE RECEIPT: " & auth.AuthorityUID)
                        End If
                        auth = Nothing
                    Case "DELIVERED"
                        auth.PTCStatus = "RELEASE-PENDING"
                        auth.SetPTCAuthorityFlasherStatus()
                    Case "ACCEPTED"
                        If auth.DoRemoveAuthority Then
                            auth.PTCStatus = "RELEASE-SUCCESSFUL"
                            auth.FlasherMode(False)
                            SystemEvent("AUTHORITY REMOVAL ACCEPTED FROM MA-2054 MESSAGE RECEIPT: " & auth.AuthorityUID & " " & gPermissionToRemoveStopTargetText & " - REMOVED ")
                            auth.PTCTransmissionCompleted()
                            auth.CheckToAcknowledgeAlert()
                        End If
                End Select
                If auth.UpdateDatabaseWithPTCAuthorityStatus(auth.PTCStatus) Then
                    SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_1053_TNT_ReleaseMessageResponse-AUTHORITY:" & auth.AuthorityUID & " STATUS=" & auth.PTCStatus)
                End If
                'End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

