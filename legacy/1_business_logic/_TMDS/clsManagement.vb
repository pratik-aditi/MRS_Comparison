        Public Sub GetSignalRoutes()
            Dim SQLFetchInformation As String = "SELECT  * FROM tblSystemSignalRoutes WHERE TerrUID = " & Me.TerritoryID & "  ORDER BY CPUID,[EntrySignal],[Priority] "
            'and [SystemUID]='72C174F398'  
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            'Dim dbconn As OleDbConnection = Nothing
            Try
                If gSignalRouteList Is Nothing Then gSignalRouteList = ArrayList.Synchronized(New ArrayList())
                Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(SQLFetchInformation, dbconn)
                    dr = dbcomm.ExecuteReader()
                    While dr.Read()
                        If Not dr.IsDBNull(0) And Not dr.IsDBNull(2) And Not dr.IsDBNull(3) And Not dr.IsDBNull(4) And Not dr.IsDBNull(5) And Not dr.IsDBNull(6) Then
                            Dim Priority As Integer = 0
                            If Not dr.IsDBNull(7) Then Priority = dr.GetInt32(7)
                            Dim sr As New SignalRoute(dr.GetString(0), dr.GetInt32(2), dr.GetInt32(3), dr.GetString(4), dr.GetInt32(5), dr.GetInt32(6), Priority)
                            'If Not gSignalRouteList.Contains(sr) Then gSignalRouteList.Add(sr)
                            If Not CheckSrInCollection(dr.GetString(0)) Then
                                'SyncLock gSignalRouteList
                                gSignalRouteList.Add(sr)
                                'End SyncLock

                            End If
                        End If
                    End While
                    dr.Close()
                    dbconn.Close()
                End Using
            Catch ex As Exception
                'SystemException(ex.ToString)
                GetErrorDetails(ex, "GetSignalRoutes")
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Sub

