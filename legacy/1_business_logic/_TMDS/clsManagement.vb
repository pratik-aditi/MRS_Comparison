        Public Shared Sub AlertPlannedTrains(ByVal pMessageToProcess As String)
            Dim dataMsg() As String
            Dim strSymbol As String = Nothing
            Dim strMessage As String = Nothing
            Dim strMessageType As String = Nothing
            Dim trn As TrainID = Nothing
            Dim trnFound As TrainID = Nothing
            Dim al As Alert = Nothing
            Try
                SystemEvent("AlertPlannedTrains:" & pMessageToProcess)

                dataMsg = pMessageToProcess.Split(";")
                strSymbol = dataMsg(1)
                strMessage = dataMsg(2)
                strMessageType = dataMsg(3)

                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.Name = strSymbol Then
                        trnFound = trn
                        Exit For
                    End If
                Next

                If trnFound IsNot Nothing Then
                    al = TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.PlannedTrains, strMessage, trnFound)
                Else
                    trnFound = New TrainID
                    al = TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.PlannedTrains, strMessage, trnFound)
                End If

                Select Case strMessageType
                    Case "ERROR"
                        al.Critical = True
                        al.RedAlert = True
                    Case "ALERT"
                        al.Critical = False
                        al.RedAlert = False
                    Case Else
                        al.Critical = False
                        al.RedAlert = False
                End Select

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                dataMsg = Nothing
                strSymbol = Nothing
                strMessage = Nothing
                strMessageType = Nothing
                trn = Nothing
                trnFound = Nothing
                al = Nothing
            End Try
        End Sub

