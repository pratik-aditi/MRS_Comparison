#Region "TNT MESSAGES"

        Private Delegate Sub DoEventLogTrackTime(ByVal EventType As TMDS.TrackAuthority.TrackAuthority.EventTypeTNT)
        Private Delegate Sub DoPublishTNTEvent(ByVal EventType As TMDS.TrackAuthority.TrackAuthority.EventTypeTNT)

        ''' <summary>
        ''' Create Message Response
        ''' </summary>
        ''' <param name="message">message received</param>
        ''' <param name="authority">Authority</param>
        Private Shared Sub ProcessMA_1051_TNT_CreateMessageResponse(message As String,
                                                                    authority As TrackAuthority.TrackAuthority)
            Try
                If String.IsNullOrWhiteSpace(message) Then
                    SystemEvent($"{GetCurrentMethod.Name}:Message is null")
                    Exit Sub
                End If
                If authority Is Nothing Then
                    SystemEvent($"{GetCurrentMethod.Name}:Authority is nothing")
                    Exit Sub
                End If
                Select Case message
                    Case "FAILED"
                        If authority.PTCMarkedToBeRolledUpElectronically Then
                            authority.PTCStatus = "RELEASE-FAILED"
                            authority.VETMS_GenerateRollupFailure()
                        ElseIf authority.PTCMarkedToBeModifiedElectronically Then
                            authority.PTCStatus = "MODIFY-FAILED"
                            authority.VETMS_GenerateModifyFailure()
                        Else
                            authority.PTCStatus = "AUTHORITY-FAILED"
                            authority.VETMS_GenerateIssuanceFailure()
                            authority.SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                        End If
                    Case "DELIVERED"
                        If authority.PTCMarkedToBeRolledUpElectronically Then
                            authority.PTCStatus = "RELEASE-PENDING"
                            authority.ResetRollupListComponents(GenericComponent.ModeSelection.PTCReleaseImminent)
                        ElseIf authority.PTCMarkedToBeModifiedElectronically Then
                            authority.PTCStatus = "AUTHORITY-ACTIVATED"
                            authority.PTCModifySuccessful = True
                            authority.CheckToAcknowledgeAlert()
                            authority.SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                            authority.VETMS_TerminatePTCModifyProcess()
                        Else
                            authority.PTCStatus = "AUTHORITY-DELIVERED"
                            authority.PTCIssuanceSuccessful = True
                            authority.CheckToAcknowledgeAlert()
                            authority.SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                        End If
                    Case "ACCEPTED"
                        If authority.PTCMarkedToBeRolledUpElectronically Then
                            authority.PTCStatus = "AUTHORITY-ACTIVATED"
                            authority.SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                            authority.FlasherMode(False, True)
                            authority.VETMS_CompleteRollup()
                        Else
                            'Release PSS when normal auth is diff of activated
                            If authority.myTrain IsNot Nothing Then
                                If authority.myTrain.IsActivePTC AndAlso
                                    authority.myTrain.GeoFenceEnabled AndAlso
                                    Not authority.PTCStatus.Equals("AUTHORITY-ACTIVATED") Then
                                    If authority.myTrain.thisRestrictiveLicense IsNot Nothing Then
                                        authority.myTrain.DoReleaseSpecialLicenseBehindTrain(True)
                                    End If
                                End If
                            End If
                            authority.PtcConfirmLicense()
                        End If
                        Dim doAddAuthorityEvent As New DoEventLogTrackTime(AddressOf authority.LogTheTrackTimeEvent)
                        doAddAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.TrackAuthority.EventTypeTNT.UPDATE, Nothing, Nothing)
                        Dim doAuthorityEvent As New DoPublishTNTEvent(AddressOf authority.PublishTNTEventUpdate)
                        doAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.TrackAuthority.EventTypeTNT.UPDATE, Nothing, Nothing)
                End Select
                If authority.UpdateDatabaseWithPTCAuthorityStatus(authority.PTCStatus) Then
                    SystemEvent($"{GetCurrentMethod.Name}:Authority {authority.AuthorityUID _
                                } updated with status {authority.PTCStatus}")
                End If
                Dim summaryItem As New SummaryItem("AUTHORITY", "UPDATE-PTC", authority)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(summaryItem)
                End SyncLock
                TMDS.NetworkMessages.CadMessages.SendLicenseEventForWabtecOne(authority, "MODIFY")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Create Message Action
        ''' </summary>
        ''' <param name="message">message received</param>
        ''' <param name="authority">normal authority assigned</param>
        Private Shared Sub ProcessMA_2061_TNT_CreateMessageAction(message As String,
                                                                  authority As TrackAuthority.TrackAuthority)
            Try
                If String.IsNullOrWhiteSpace(message) Then
                    SystemEvent($"{GetCurrentMethod.Name}:Message is null")
                    Exit Sub
                End If
                If authority Is Nothing Then
                    SystemEvent($"{GetCurrentMethod.Name}:Authority is nothing")
                    Exit Sub
                End If
                Select Case message
                    Case "ACCEPTED"
                        If authority.PTCMarkedToBeRolledUpElectronically Then
                            authority.PTCStatus = "AUTHORITY-ACTIVATED"
                            authority.SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                            authority.FlasherMode(False, True)
                            authority.VETMS_CompleteRollup()
                        Else
                            authority.PtcConfirmLicense()
                        End If
                    Case "REJECTED"
                        authority.PTCStatus = "AUTHORITY-FAILED"
                        authority.VETMS_GenerateIssuanceRejection()
                        authority.SetPTCAuthorityFlasherStatus(GetCurrentMethod.Name)
                        authority.FlasherMode(False)
                        If authority.PTCMarkedToBeRolledUpElectronically Then authority.VETMS_RollupRejected()
                End Select
                If authority.UpdateDatabaseWithPTCAuthorityStatus(authority.PTCStatus) Then
                    SystemEvent($"{GetCurrentMethod.Name}:Authority {authority.AuthorityUID _
                                } updated with status {authority.PTCStatus}")
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub ProcessMA_1053_TNT_ReleaseMessageResponse(ByVal MessageResponse As String, ByVal auth As TrackAuthority.TrackAuthority)
            Try
                If auth.PTCMarkedToBeVoidedElectronically OrElse auth.PTCMarkedToBeForcedVoidedElectronically Then
                    Select Case MessageResponse
                        Case "FAILED"
                            auth.PTCStatus = "RELEASE-FAILED"
                            auth.SetPTCAuthorityFlasherStatus("ProcessMA_1053_TNT_ReleaseMessageResponse")
                            auth.VETMS_GenerateReleaseFailure()
                        Case "DELIVERED"
                            auth.PTCStatus = "RELEASE-PENDING"
                            auth.SetPTCAuthorityFlasherStatus("ProcessMA_1053_TNT_ReleaseMessageResponse-2")
                        Case "ACCEPTED"
                            If auth.PTCMarkedToBeVoidedElectronically OrElse auth.PTCMarkedToBeForcedVoidedElectronically Then
                                If auth.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                    If auth.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                        TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(auth)
                                        Dim SummItem2 As New SummaryItem("AUTHORITY", "REMOVE", auth)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem2)
                                        End SyncLock

                                        auth.PTCStatus = "RELEASE-SUCCESSFUL"
                                        auth.SetPTCAuthorityFlasherStatus("ProcessMA_1053_TNT_ReleaseMessageResponse-3")
                                        auth.FlasherMode(False)
                                        SystemEvent("AUTHORITY REMOVAL ACCEPTED FROM MA-2061 MESSAGE RECEIPT: " & auth.AuthorityUID)
                                        auth.VETMS_CompleteReleaseOfTacticalRoutes()
                                        If Not IsNothing(auth.myTrain) Then
                                            auth.myTrain.thisCurrentLicense = Nothing
                                        End If

                                        If auth.UpdateDatabaseWithPTCAuthorityStatus(auth.PTCStatus) Then
                                            SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_2061_TNT_ReleaseMessageAction-AUTHORITY:" & auth.AuthorityUID & " STATUS=" & auth.PTCStatus)
                                        End If
                                        auth.PTCTransmissionCompleted()
                                        auth = Nothing
                                        Exit Sub
                                    End If
                                End If
                                auth.PTCTransmissionCompleted()
                                auth.CheckToAcknowledgeAlert()

                                If optEnableMRSSpecificOptions Then
                                    If auth.myTrain.MZEnabled OrElse auth.myTrain.IsBIDirectional Then
                                        auth.myTrain.PTCElectronicDeliveryCompleted = True
                                    End If
                                End If
                            End If
                    End Select
                    If auth.UpdateDatabaseWithPTCAuthorityStatus(auth.PTCStatus) Then
                        SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_1053_TNT_ReleaseMessageResponse-AUTHORITY:" & auth.AuthorityUID & " STATUS=" & auth.PTCStatus)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub ProcessMA_2061_TNT_ReleaseMessageAction(ByVal MessageResponse As String, ByVal auth As TrackAuthority.TrackAuthority)
            Try

                Select Case MessageResponse
                    Case "ACCEPTED"
                        If auth.PTCMarkedToBeVoidedElectronically OrElse auth.PTCMarkedToBeForcedVoidedElectronically Then
                            If auth.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                If auth.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                    auth.RemoveTrackAuthFromRemoteLinks()

                                    TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(auth)
                                    Dim SummItem2 As New SummaryItem("AUTHORITY", "REMOVE", auth)
                                    SyncLock gSummaryAuthQueue.SyncRoot
                                        gSummaryAuthQueue.Enqueue(SummItem2)
                                    End SyncLock

                                    auth.PTCStatus = "RELEASE-SUCCESSFUL"
                                    auth.SetPTCAuthorityFlasherStatus("ProcessMA_2061_TNT_ReleaseMessageAction")
                                    auth.FlasherMode(False)
                                    SystemEvent("AUTHORITY REMOVAL ACCEPTED FROM MA-2061 MESSAGE RECEIPT: " & auth.AuthorityUID)
                                    auth.VETMS_CompleteReleaseOfTacticalRoutes()
                                    If Not IsNothing(auth.myTrain) Then
                                        auth.myTrain.thisCurrentLicense = Nothing
                                    End If

                                    If auth.UpdateDatabaseWithPTCAuthorityStatus(auth.PTCStatus) Then
                                        SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_2061_TNT_ReleaseMessageAction-AUTHORITY:" & auth.AuthorityUID & " STATUS=" & auth.PTCStatus)
                                    End If
                                    auth.PTCTransmissionCompleted()
                                    auth = Nothing
                                    Exit Sub
                                End If
                            End If
                            auth.PTCTransmissionCompleted()
                            auth.CheckToAcknowledgeAlert()
                        End If
                    Case "REJECTED", "FAILED"
                        auth.PTCStatus = "RELEASE-FAILED"
                        auth.SetPTCAuthorityFlasherStatus("ProcessMA_2061_TNT_ReleaseMessageAction-2")
                        auth.FlasherMode(False)
                        SystemEvent("AUTHORITY REMOVAL REJECTED FROM MA-1061 MESSAGE RECEIPT: " & auth.AuthorityUID)
                        If auth.UpdateDatabaseWithPTCAuthorityStatus(auth.PTCStatus) Then
                            SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_2061_TNT_ReleaseMessageAction-AUTHORITY:" & auth.AuthorityUID & " STATUS=" & auth.PTCStatus)
                        End If
                End Select


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
