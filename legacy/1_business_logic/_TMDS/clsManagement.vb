        Public Sub AddDelayToDatabase()
            Dim q As String = "'"
            Dim s As String = ","
            Try
                If DelayUID = String.Empty Then DelayUID = Guid.NewGuid.ToString.ToUpper
                Dim Insert As New StringBuilder
                Insert.Append("INSERT INTO tblTrainEventActiveDelays")
                Insert.Append(" (")
                Insert.Append(" DelayUID, TrainSheetUID, IdentifyingPointUID, IdentifyingPointName, EventTimeStamp,")
                Insert.Append(" EventTimeZone, EventMilePost, EventTrackName, EventDelayCode, EventComments, EventDelayAmount, RailroadUID, ReportData,")
                Insert.Append(" ReportingPerson, DelayEventType, DelayEventSubType, ScheduleStationIndex, ScheduleStationUID,")
                Insert.Append(" DeviceName, DeviceUID, IdentifyingPointMilePost, EventDelayDescription, [Excused], [ReportUID]")
                Insert.Append(" )")
                Insert.Append(" VALUES (")
                Insert.Append(q & DelayUID & q & s)
                Insert.Append(q & myTrain.ActiveTrainSheetGUID & q & s)
                Insert.Append(q & IdentifyingPointUID & q & s)
                Insert.Append(q & IdentifyingPointName & q & s)
                If optEnableARRCSpecificOptions Then
                    Insert.Append(q & EventTimeStamp.ToString & q & s)
                Else
                    Insert.Append(q & Now.ToString & q & s)
                End If

                Insert.Append(q & Mid(myTrain.myTrack.TimeZone, 1, 1) & q & s)
                Insert.Append(q & EventMilePost & q & s)
                Insert.Append(q & EventTrackName & q & s)
                Insert.Append(q & EventDelayCode & q & s)
                Insert.Append(q & EventComments & q & s)
                Insert.Append(EventDelayAmount & s)
                Insert.Append(q & RailroadUID & q & s)
                'Insert.Append(q & myTrain.GetTrainReportDataString(EventDelayCode, EventDelayAmount) & q & s)
                If optEnableDenverSpecificOptions Then
                    Insert.Append(q & myTrain.GetTrainReportDataString(EventDelayCode, EventDelayAmount, 0, "", myTrain.CrewCurrent.Engineer.NameOfPerson) & q & s)
                Else
                    Insert.Append(q & myTrain.GetTrainReportDataString(EventDelayCode, EventDelayAmount) & q & s)
                End If
                Insert.Append(q & myReportingPerson & q & s)
                Insert.Append(q & myDelayEventType.ToString & q & s)
                Insert.Append(q & myDelaySubEventType.ToString & q & s)
                Insert.Append(myScheduleStationIndex & s)
                Insert.Append(q & myScheduleStationUID & q & s)
                Insert.Append(q & myDeviceName & q & s)
                Insert.Append(q & myDeviceUID & q & s)
                Insert.Append(q & IdentifyingPointMilepost & q & s)
                Insert.Append(q & EventDelayDescription.Trim & q & s)
                Insert.Append(q & myDelayExcused.Trim & q & s)
                Insert.Append(q & myReportNumber.Trim & q)
                Insert.Append(" )")

                If optEnableARRCSpecificOptions Then
                    ExecuteQuery(Insert.ToString, gConnectionStringTrain)
                Else
                    SystemDatabaseCommandToDynamicTrain("AddDelayToDatabase", Insert.ToString)
                End If

                myTrain.myDelayList.Add(Me)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

