        ''' <summary>
        ''' Get next auth number
        ''' </summary>
        ''' <returns></returns>
        Public Function GetNextAuthorityNumber() As Int32
            Dim unique As Boolean = False
            Dim loopControl As Integer
            Dim performUpdateAuthorityNumber As DoUpdateAuthorityNumber
            Try
                If Not optDisableDateRangeFunctionForAuthorityNumber Then
                    If Me.LastGetAuthorityEvent.Date < Now.Date.AddDays(-1) Then
                        Me.UpdateAuthorityEvent()
                        Me.LastGetAuthorityEvent = Now
                        CurrentAuthorityNumber = Me.AuthorityNumberRange
                    ElseIf optEnableCPSpecificOptions AndAlso Me.LastGetAuthorityEvent.Date <= Now.Date.AddDays(-1) Then
                        Me.UpdateAuthorityEvent()
                        CheckForPreviousDayLowestNumber()
                        Me.LastGetAuthorityEvent = Now
                        CurrentAuthorityNumber = Me.AuthorityNumberRange
                    End If
                End If

                While Not unique
                    If CurrentAuthorityNumber >= Me.AuthorityNumberFactor + Me.AuthorityNumberRange Then
                        CurrentAuthorityNumber = Me.AuthorityNumberRange + 1
                    Else
                        If CurrentAuthorityNumber = 0 Then
                            CurrentAuthorityNumber = Me.AuthorityNumberRange
                        ElseIf CurrentAuthorityNumber < Me.AuthorityNumberRange Then
                            CurrentAuthorityNumber = Me.AuthorityNumberRange
                        Else
                            CurrentAuthorityNumber = CurrentAuthorityNumber + 1
                        End If
                        If Me.PreviousAuthorityNumberReleased = CurrentAuthorityNumber Then
                            CurrentAuthorityNumber = CurrentAuthorityNumber + 1
                            If CurrentAuthorityNumber >= Me.AuthorityNumberFactor + Me.AuthorityNumberRange Then
                                CurrentAuthorityNumber = Me.AuthorityNumberRange + 1
                            ElseIf CurrentAuthorityNumber < Me.AuthorityNumberRange Then
                                CurrentAuthorityNumber = Me.AuthorityNumberRange + 1
                            End If
                        End If
                    End If

                    If CurrentAuthorityNumber < Me.AuthorityNumberRange Then
                        CurrentAuthorityNumber = Me.AuthorityNumberFactor + Me.AuthorityNumberRange - 10
                    End If

                    If CheckAllAuthorityTypeNumbers(CurrentAuthorityNumber) Then
                        performUpdateAuthorityNumber = New DoUpdateAuthorityNumber(AddressOf Me.UpdateAuthorityNumber)
                        performUpdateAuthorityNumber.BeginInvoke(Nothing, Nothing)
                        Return CurrentAuthorityNumber
                    End If

                    loopControl = loopControl + 1
                    If loopControl >= Me.AuthorityNumberFactor Then
                        SystemException("GetNextAuthorityNumber:Failed on LoopControl:CurrentAuthorityNumber=" & CurrentAuthorityNumber)
                        Return 0
                    End If
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                unique = Nothing
                loopControl = Nothing
                performUpdateAuthorityNumber = Nothing
            End Try
        End Function

        Public Function GetNextTroubleTicketNumber() As Int32
            Try
                Dim Unique As Boolean = False
                Dim LoopControl As Integer

                While Not Unique
                    If TroubleTicketReferenceNumberCurrent >= Me.TroubleTicketReferenceNumberFactor + Me.TroubleTicketReferenceNumberRange Then
                        TroubleTicketReferenceNumberCurrent = Me.TroubleTicketReferenceNumberRange + 1
                    Else
                        If TroubleTicketReferenceNumberCurrent = 0 Then
                            TroubleTicketReferenceNumberCurrent = Me.TroubleTicketReferenceNumberRange
                        ElseIf TroubleTicketReferenceNumberCurrent < Me.TroubleTicketReferenceNumberRange Then
                            TroubleTicketReferenceNumberCurrent = Me.TroubleTicketReferenceNumberRange
                        Else
                            TroubleTicketReferenceNumberCurrent = TroubleTicketReferenceNumberCurrent + 1
                        End If
                        If Me.PreviousAuthorityNumberReleased = TroubleTicketReferenceNumberCurrent Then
                            TroubleTicketReferenceNumberCurrent = TroubleTicketReferenceNumberCurrent + 1
                            If TroubleTicketReferenceNumberCurrent >= Me.TroubleTicketReferenceNumberFactor + Me.TroubleTicketReferenceNumberRange Then
                                TroubleTicketReferenceNumberCurrent = Me.TroubleTicketReferenceNumberRange + 1
                            ElseIf TroubleTicketReferenceNumberCurrent < Me.TroubleTicketReferenceNumberRange Then
                                TroubleTicketReferenceNumberCurrent = Me.TroubleTicketReferenceNumberRange + 1
                            End If
                        End If
                    End If
                    If optUseTroubleReportingEnhanced Then
                        If CheckAllIncidentTicketNumbers(TroubleTicketReferenceNumberCurrent) Then
                            Dim PerformUpdateNumber As New DoUpdateTroubleTicketNumber(AddressOf Me.UpdateTroubleTicketNumber)
                            PerformUpdateNumber.BeginInvoke(Nothing, Nothing)
                            Return TroubleTicketReferenceNumberCurrent
                        End If
                    Else
                        If CheckAllTroubleTicketNumbers(TroubleTicketReferenceNumberCurrent) Then
                            Dim PerformUpdateNumber As New DoUpdateTroubleTicketNumber(AddressOf Me.UpdateTroubleTicketNumber)
                            PerformUpdateNumber.BeginInvoke(Nothing, Nothing)
                            Return TroubleTicketReferenceNumberCurrent
                        End If
                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl >= Me.TroubleTicketReferenceNumberFactor Then
                        SystemException("GetNextTroubleTicketNumber Failed on LoopControl. TroubleTicketReferenceNumberCurrent=" & TroubleTicketReferenceNumberCurrent)
                        Return 0
                    End If
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Public Sub UpdateTroubleTicketNumber()
            Dim dbConn As OleDbConnection = Nothing
            Dim CommandUpdate As OleDbCommand = Nothing
            Dim RetryCount As Integer
            Dim SQLUpdateNumber As String = String.Empty
            Try
                SystemEvent("Attempting UpdateTroubleTicketNumber:" & SQLUpdateNumber)
                Try
                    Do While RetryCount < 3
                        SQLUpdateNumber = "UPDATE tblSystemWorkStations SET CurrentTTNumber = " & (Me.TroubleTicketReferenceNumberCurrent) & " WHERE WrkStnName = '" & Me.Name & "'"
                        dbConn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                        If dbConn.State <> ConnectionState.Open Then dbConn.Open()
                        CommandUpdate = New OleDbCommand(SQLUpdateNumber, dbConn)
                        CommandUpdate.ExecuteNonQuery()
                        RetryCount = 3
                        Threading.Thread.Sleep(1000)
                    Loop
                Catch ex As Exception
                    SystemException(ex.ToString)
                    RetryCount += 1
                End Try
                SystemEvent("Successful UpdateTroubleTicketNumber:" & SQLUpdateNumber)
            Catch ex As Exception
                SystemEvent("Failed UpdateTroubleTicketNumber:" & SQLUpdateNumber)
                SystemException(ex.ToString)
            Finally
                If Not dbConn Is Nothing Then
                    If dbConn.State = ConnectionState.Open Then dbConn.Close()
                    dbConn.Dispose()
                    dbConn = Nothing
                End If
                If Not CommandUpdate Is Nothing Then
                    CommandUpdate.Dispose()
                    CommandUpdate = Nothing
                End If
            End Try
        End Sub

