        Private Function ApplyWorkOrder(Optional ByVal DeletedWorkOrder As Boolean = False, Optional ByVal pForm As Object = Nothing) As Boolean
            Dim dbcomm As OleDbCommand = Nothing
            Dim dbconn As OleDb.OleDbConnection = Nothing
            Dim StationUID As String = ""
            Dim StationIndex As String = ""
            Dim myCarUID As String = ""
            Try
                If DeletedWorkOrder AndAlso myTrain IsNot Nothing Then
                    Dim data() As String = TaskData.Split("|")
                    StationIndex = data(1)
                    StationUID = data(2)
                    myCarUID = data(4).Trim & data(5).Trim
                    Dim tr As TrainRestriction
                    If myTrain.myRestrictionList IsNot Nothing AndAlso myTrain.myRestrictionList.Count > 0 Then
                        For Each tr In myTrain.myRestrictionList
                            If tr.myCarUID.ToUpper.Trim = myCarUID.ToUpper.Trim AndAlso Not String.IsNullOrEmpty(tr.myBulletinGUID) AndAlso tr.myBulletinGUID.Trim <> "" Then
                                If Not tr.RemoveGBO(pForm) Then
                                    Return False
                                End If
                            End If
                        Next
                    End If
                End If


                dbconn = New OleDbConnection(gConnectionStringTrain)
                dbconn.Open()
                Dim Update As New StringBuilder
                Dim NewWorkOrderGUID As String = Guid.NewGuid.ToString.ToUpper
                Update.Append("INSERT INTO tblTrainEventActiveWorkOrders(UID, EventTimeStamp, WorkOrderEvents, EntityUID, EntityGUID, WorkOrderDeleted) ")
                Update.Append("VALUES ( ")
                Update.Append("'" & NewWorkOrderGUID & "',")
                Update.Append("'" & Now & "',")
                Update.Append("'" & SpclToEsc(TaskData) & "',")
                Update.Append("'" & EntityUID & "',")
                Update.Append("'" & EntityGUID & "',")
                Select Case DeletedWorkOrder
                    Case True
                        Update.Append(1)
                    Case Else
                        Update.Append(0)
                End Select

                Update.Append(")")

                dbcomm = New OleDbCommand(Update.ToString, dbconn)
                dbcomm.ExecuteNonQuery()
                dbconn.Close()
                dbconn = Nothing
                myTrain.RefreshTrainWokOrder()
                If DeletedWorkOrder AndAlso myTrain IsNot Nothing Then
                    Dim Wo As WorkOrder = TMDS.SystemUtilities.FetchData.GetWorkOrderFromDBbyGUID(NewWorkOrderGUID, myTrain)
                    TMDS.NetworkMessages.CadMessages.SendTrainWorkOrderChangeARRC(myTrain, Wo, True, String.Empty, String.Empty, StationIndex, StationUID, gMISTransmitQueue)

                    'TMDS.NetworkMessages.CadMessages.SendTrainConsistChangeARRC(myTrain, gCadTransmitQueue)
                    TMDS.NetworkMessages.CadMessages.SendTrainEngineSetEventARRC(myTrain, gMISTransmitQueue, "MODIFY", False, StationUID)
                    'TMDS.NetworkMessages.CadMessages.SendTrainDataWarehouseEventARRC(myTrain, gCadTransmitQueue, "MODIFY")  'Commented Based On RMT ARRC-1432
                    Dim EvtStr As String = Me.TaskDetails & " - Deleted by Dispatcher[" & gCurrentUser.UserFullName & "]"
                    myTrain.AddTrainSheetEvent("WORK-TASK-DELETED", Now, Mid(myTrain.myTrack.TimeZone, 1, 1), EvtStr, myTrain.myTrack.myControlPoint.GUID.ToString, myTrain.GetIdentifyingLocationNameFromLimits, StationUID)

                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try

        End Function

