        Public Function CreateRestriction(ByVal theRestriction As String) As Boolean
            Try
                '.1	SpeedRestrictionsExist	1a	Y	Y/N (The number of speed restrictions will be in GroupCount, above.) 
                '.2	ClearanceUID	10a	Y	Format: AA-YY-NNNN AA: NB northbound, SB southbound  YY:             Year()
                'NNNN: Internal sequence number, with leading zeros
                '.3	CarInitial	4a	Y	Railroad Car Initials 
                '.4	CarNumber	6n	Y	6 digit Car Number 
                '.5	TypeOfRestriction	2a	Y	HW - High Wide EW - Excessive Weight ED - Excessive Dimension  OT(-Other)
                '.6	Instructions	320a	N	Special Handling for Restriction (except on first record)
                '.7	OnTrain	1a	Y	Y/N. In the current Consist; would be "N" for scheduled pickups only. 
                '.8	Description	40a	N	Short description
                '.9	MilePostBegin	9a	N	PXXX.XXS
                '.10	MilePostEnd	9a	N	PXXX.XXS
                '.11	SpeedLimit	3n	N	Maximum speed permitted, MPH

                Dim data() As String = theRestriction.Split("|")
                If Trim(data(0)) = "Y" Then IsRestricting = True
                myClearanceUID = data(1)
                myCarUID = data(2) & data(3)
                myTypeOfRestriction = data(4)
                myInstructions = data(5)
                If Trim(data(6)) = "Y" Then IsOnTrain = True
                myDescription = data(7)
                myMilePostBegin = data(8)
                myMilePostEnd = data(9)
                If IsNumeric(data(10)) Then mySpeedLimit = CInt(data(10))
                If data.Length >= 12 Then
                    If data(11).ToUpper.Trim <> "" Then TrackName = data(11)
                End If
                myTrain.myRestrictionList.Add(Me)

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Sub RemoveRestriction()
            Try
                Dim theMove As New StringBuilder("INSERT INTO tblTrainEventInActiveRestrictions  SELECT * FROM tblTrainEventActiveRestrictions WHERE UID = '" & myUID & "'")
                Dim theDelete As New StringBuilder("DELETE FROM tblTrainEventActiveRestrictions WHERE UID = '" & myUID & "'")
                myTrain.myRestrictionList.Remove(Me)
                SystemDatabaseCommandToDynamicTrain("RemoveRestriction-theMove", theMove.ToString)
                SystemDatabaseCommandToDynamicTrain("RemoveRestriction-theDelete", theDelete.ToString)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function DeleteRestriction() As Boolean
            Dim SQLQueryCollection As New ArrayList
            Try
                Dim theMove As New StringBuilder("INSERT INTO tblTrainEventInActiveRestrictions  SELECT * FROM tblTrainEventActiveRestrictions WHERE UID = '" & myUID & "'")
                Dim theDelete As New StringBuilder("DELETE FROM tblTrainEventActiveRestrictions WHERE UID = '" & myUID & "'")
                With SQLQueryCollection
                    .Add(theMove.ToString)
                    .Add(theDelete.ToString)
                End With
                If ExecuteQueryCollection(SQLQueryCollection, gConnectionStringDynamic) Then
                    myTrain.myRestrictionList.Remove(Me)
                Else
                    Return False
                End If


            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                SQLQueryCollection = Nothing
            End Try
            Return True
        End Function

