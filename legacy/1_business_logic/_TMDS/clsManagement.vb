        Private Sub ApplyRestriction(Optional ByVal CreateFormC As Boolean = False)
            Dim dbcomm As OleDbCommand = Nothing
            Dim dbconn As OleDb.OleDbConnection = Nothing
            Dim RestrictionUID As String = Guid.NewGuid.ToString.ToUpper
            Dim MyTGBO As TabularGeneralBulletin = Nothing
            Try
                'Y|NB-12-012|ARR|12961|HW|Will clear Curry to Whittier with the following restrictions. Place car near Locomotive with restrictions.|Y |Bridge 86.6 Bird Creek|86.62|86.65|10|
                Dim d() As String = TaskData.Split("|")
                Dim RestUID As String = Trim(d(1))
                Dim EntityUID As String = String.Empty
                If String.IsNullOrEmpty(myTrain.EntityUID) Then
                    EntityUID = myTrain.TrainGUID
                Else
                    EntityUID = myTrain.EntityUID
                End If
                Dim CarUID As String = d(2).Trim & d(3).Trim
                If Not DoesRestrictionExist(TaskData) Then
                    dbconn = New OleDbConnection(gConnectionStringTrain)
                    dbconn.Open()
                    Dim Update As New StringBuilder
                    Update.Append("INSERT INTO tblTrainEventActiveRestrictions(UID, RestrictionCreateTime, RestrictionType, RestrictionUID, EntityUID, EntityGUID, RestrictionData, TrackName,CarUID) ")
                    Update.Append("VALUES ( ")
                    'Update.Append("'" & Guid.NewGuid.ToString.ToUpper & "',")
                    Update.Append("'" & RestrictionUID & "',")
                    Update.Append("'" & Now & "',")
                    Update.Append("'CAR-RESTRICTION',")
                    Update.Append("'" & RestUID & "',")
                    'Update.Append("'" & myTrain.EntityUID & "',")
                    Update.Append("'" & EntityUID & "',")
                    Update.Append("'" & myTrain.TrainGUID & "',")
                    Update.Append("'" & SpclToEsc(TaskData) & "',")
                    Update.Append("'All Tracks',")
                    Update.Append("'" & CarUID.Trim & "'")
                    Update.Append(")")

                    dbcomm = New OleDbCommand(Update.ToString, dbconn)
                    dbcomm.ExecuteNonQuery()
                    dbconn.Close()
                    dbconn = Nothing

                    'myTrain.RefreshTrainRestriction()

                    If myTrain IsNot Nothing Then
                        MyTGBO = TMDS.SystemUtilities.FetchData.FindTGBOByTrainSymbol(myTrain.Name)
                        Dim myTrainTGBOCollection As New ArrayList
                        myTrainTGBOCollection = TMDS.SystemUtilities.FetchData.FindAllTGBOsByTrainSymbol(Me.myTrain.Name)
                        If CreateFormC AndAlso myTrainTGBOCollection IsNot Nothing AndAlso myTrainTGBOCollection.Count > 0 Then
                            Dim tr As TrainRestriction = TMDS.SystemUtilities.FetchData.FetchTrainRestrictionByGUID(RestrictionUID, myTrain)
                            If Not String.IsNullOrEmpty(tr.myBulletinGUID) AndAlso tr.myBulletinGUID.Trim <> "" Then
                            Else
                                tr.CreateBulletin(myTrain, True)
                            End If

                        End If
                    End If
                    myTrain.PerformTrainRestrictions(True)
                Else
                    SystemEvent("Restriciton Exists-" & UID & ":" & TaskData)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try

        End Sub

        Private Function DoesRestrictionExist(ByVal RestrictionData As String) As Boolean
            Dim query As StringBuilder
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim thisEntityUID As String = ""
            Try
                'Y|NB-13-005|ARR|12648|HW|Will clear Whittier to Fairbanks.  Do NOT couple to SD70MAC or another excessive weight car with restrictions.|Y|Bridge 68.4 Peterson Creek|68.38|68.40|10|
                'Y|NB-13-005|ARR|12648|HW||Y|Bridge 86.6 Bird Creek|86.62|86.65|10|
                If Me.myTrain IsNot Nothing Then
                    thisEntityUID = Me.myTrain.EntityUID
                Else
                    thisEntityUID = EntityUID.Trim
                End If


                Dim data() As String = RestrictionData.Split("|")
                Dim RestrictionUID As String = data(1).Trim
                Dim CarUID As String = data(2).Trim & data(3).Trim
                Dim TskData As String = data(4).Trim & data(5).Trim & data(6).Trim & data(7).Trim
                query = New StringBuilder("SELECT EntityUID,RestrictionData FROM tblTrainEventActiveRestrictions WHERE (EntityUID = N'" & thisEntityUID.Trim & "') AND (RestrictionUID= N'" & RestrictionUID.Trim & "' AND CarUID= N'" & CarUID.Trim & "')")
                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    dbcomm = New OleDbCommand(query.ToString, DbConn)
                    dr = dbcomm.ExecuteReader
                    If dr.HasRows Then
                        While dr.Read
                            Dim trData As String = ""
                            If Not dr.IsDBNull(1) Then trData = dr.GetString(1).Trim
                            If Not String.IsNullOrEmpty(trData) AndAlso trData.Trim <> "" Then
                                If trData.Trim.ToUpper = RestrictionData.Trim.ToUpper Then Return True
                                Dim splTrData() As String = trData.Split("|")
                                If splTrData.GetUpperBound(0) > 6 Then
                                    Dim tempData As String = splTrData(4).Trim & splTrData(5).Trim & splTrData(6).Trim & splTrData(7).Trim
                                    If tempData.Trim.ToUpper = TskData.Trim.ToUpper Then Return True
                                End If
                            End If
                        End While
                    End If
                    dr.Close()
                    DbConn.Close()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Function

        Private Function DoesBulletinExistInTGBO(ByVal trn As TrainID, ByVal BullUID As String) As Boolean
            Try
                Dim t As TabularGeneralBulletin
                For Each t In gTabularGeneralBulletins
                    If t.IssuedTo = trn.Name Then
                        If InStr(t.ExceptionListDefinitions, BullUID) <> 0 Then Return True
                        If InStr(t.BulletinListDefinitions, BullUID) <> 0 Then Return True

                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function



