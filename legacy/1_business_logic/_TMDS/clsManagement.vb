        Public Shared Sub ProcessAuthorityStatusReport(ByVal messageToProcess As String)
            Try
                SystemEvent("ProcessAuthorityStatusReport:" & messageToProcess)
                Dim trn As TrainID = Nothing
                Dim TrainFound As TrainID = Nothing

                Dim Message() As String = messageToProcess.Split(Chr(4))
                Dim data() As String = Message(0).Split(",")
                If data.Length >= 5 Then
                    Dim AuthNum As Int32 = CInt(data(5))
                    Dim SubID As Int32 = CInt(data(3))
                    Dim auth As TrackAuthority.DTCAuthority = Nothing
                    Dim AuthFound As TrackAuthority.DTCAuthority = Nothing
                    For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                        If auth.AuthorityNumber = AuthNum Then
                            AuthFound = auth
                            Exit For
                        End If
                    Next
                    Dim LocoID As String = data(0)
                    For Each trn In TMDS.GlobalDeclarations.TrainCollection
                        If trn.IdentifingUnit = LocoID Then
                            TrainFound = trn
                            Exit For
                        End If
                    Next

                    Select Case CInt(data(6))
                        Case 8 'LOCOMOTIVE ACTIVATED
                            AuthFound.StatusOfDTC = "LOCO-ACTIVATED"
                            AuthFound.UpdateStatus()

                            AuthFound.UpdateBlocksStatuses("LOCO-ACTIVATED")

                            Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE", AuthFound)
                            SyncLock gSummaryAuthQueue.SyncRoot
                                gSummaryAuthQueue.Enqueue(SummItem)
                            End SyncLock

                        Case 4 'OFFICE ACCEPTED
                            AuthFound.StatusOfDTC = "ACCEPTED"
                            AuthFound.UpdateStatus()
                            AuthFound.UpdateBlocksStatuses("ACCEPTED")

                            AuthFound.SendStatusAuthorityElectronicMessage()

                            Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE", AuthFound)
                            SyncLock gSummaryAuthQueue.SyncRoot
                                gSummaryAuthQueue.Enqueue(SummItem)
                            End SyncLock

                            Threading.Thread.Sleep(2000)

                            AuthFound.StatusOfDTC = "ACTIVATED"
                            AuthFound.UpdateStatus()
                            AuthFound.UpdateBlocksStatuses("ACTIVATED")

                            AuthFound.SendStatusAuthorityElectronicMessage()

                            Dim SummItem1 As New SummaryItem("AUTHORITY", "UPDATE", AuthFound)
                            SyncLock gSummaryAuthQueue.SyncRoot
                                gSummaryAuthQueue.Enqueue(SummItem1)
                            End SyncLock
                        Case 10
                            AuthFound.StatusOfDTC = "REPLACED OFFICE"
                            AuthFound.UpdateStatus()
                            AuthFound.UpdateBlocksStatuses("REPLACED OFFICE")

                        Case 11, 13
                            If AuthFound.MarkedForDeletion Then
                                Dim AuthToActivate As DTCAuthority = Nothing
                                Dim comp As Object
                                For Each comp In AuthFound.ComponentsInSelection
                                    If comp.Authorities.Count > 0 Then
                                        Dim dtc As DTCAuthority
                                        For Each dtc In comp.Authorities
                                            If dtc.AuthorityUID <> AuthFound.AuthorityUID Then
                                                AuthToActivate = dtc
                                                Exit For
                                            End If
                                        Next
                                    End If
                                    If Not IsNothing(AuthToActivate) Then
                                        Exit For
                                    End If
                                Next

                                If Not IsNothing(AuthToActivate) Then
                                    AuthToActivate.StatusOfDTC = "ACCEPTED"
                                    AuthToActivate.UpdateBlocksStatuses("ACCEPTED")
                                End If

                                AuthFound.StatusOfDTC = "DELETE"
                                AuthFound.UpdateBlocksStatuses("DELETE")
                                'AuthFound.SendStatusAuthorityElectronicMessage()

                                AuthFound.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority)
                                AuthFound.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority)

                                OtherTrackAuthorities.Remove(AuthFound)

                                Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", AuthFound)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock
                            Else
                                AuthFound.UpdateBlockStatus(CInt(data(4)), "RELEASE")
                                Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE", AuthFound)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock

                                TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.AuthorityReleaseRequest, messageToProcess, TrainFound)
                                AuthFound.SendStatusAuthorityElectronicMessage()
                                AuthFound.ReleaseRequestReceived = True

                            End If
                        Case 17
                            TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.AuthorityDeletedConfirmation, messageToProcess, TrainFound)
                            AuthFound.ReleaseRequestReceived = True
                            If Not IsNothing(TMDS.SystemForms.MySystemForms.frmReportClr) Then
                                If TMDS.SystemForms.MySystemForms.frmReportClr.DTCMode Then
                                    If Not IsNothing(TMDS.SystemForms.MySystemForms.frmReportClr.CurrentDTCItem) Then
                                        If TMDS.SystemForms.MySystemForms.frmReportClr.CurrentDTCItem.AuthorityNumber = AuthFound.AuthorityNumber Then
                                            If Not IsNothing(TMDS.SystemForms.MySystemForms.frmPending) Then
                                                TMDS.SystemForms.MySystemForms.frmPending.tmrPending.Stop()
                                                TMDS.SystemForms.MySystemForms.frmPending.tmrPending.Enabled = False
                                                TMDS.SystemForms.MySystemForms.frmPending.Close()
                                            End If
                                        End If

                                    End If
                                Else
                                    If AuthFound.MarkedForDeletion Then
                                        Dim comp As Track
                                        Dim AuthToRelease As DTCAuthority = Nothing
                                        Dim CompToReference As Track = Nothing
                                        Dim CompsToReview As ArrayList = AuthFound.ComponentsInSelection.Clone
                                        For Each comp In CompsToReview
                                            If comp.Authorities.Count > 1 Then
                                                Dim dtc As DTCAuthority
                                                For Each dtc In comp.Authorities
                                                    If dtc.AuthorityUID = AuthFound.AuthorityUID Then
                                                        AuthToRelease = dtc
                                                        CompToReference = comp
                                                        Exit For
                                                    End If
                                                Next
                                            End If
                                            If Not IsNothing(AuthToRelease) Then
                                                Dim BlockList As ArrayList = Nothing
                                                AuthToRelease.GetBlockListFromID(CompToReference.PTCBlockID, CompToReference.SubdivisionID, BlockList)
                                                AuthToRelease.PartialRelease(BlockList)
                                                AuthToRelease = Nothing
                                            End If
                                        Next
                                        AuthFound.StatusOfDTC = "DELETE"
                                        AuthFound.UpdateBlocksStatuses("DELETE")
                                        AuthFound.SendStatusAuthorityElectronicMessage()

                                        AuthFound.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority)
                                        AuthFound.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority)

                                        OtherTrackAuthorities.Remove(AuthFound)

                                        Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", AuthFound)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem)
                                        End SyncLock

                                    Else
                                        AuthFound.UpdateBlockStatus(CInt(data(4)), "RELEASE")
                                        Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE", AuthFound)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem)
                                        End SyncLock

                                        TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.AuthorityReleaseRequest, messageToProcess, TrainFound)
                                        'AuthFound.SendStatusAuthorityElectronicMessage("TMDS RELEASE")
                                        'AuthFound.StatusOfDTC = "RELEASE"
                                        'AuthFound.SendStatusAuthorityElectronicMessage()
                                        AuthFound.ReleaseRequestReceived = True
                                    End If
                                End If

                            Else
                                If AuthFound.MarkedForDeletion Then
                                    Dim comp As Track
                                    Dim AuthToRelease As DTCAuthority = Nothing
                                    Dim CompToReference As Track = Nothing
                                    Dim CompsToReview As ArrayList = AuthFound.ComponentsInSelection.Clone
                                    For Each comp In CompsToReview
                                        If comp.Authorities.Count > 1 Then
                                            Dim dtc As DTCAuthority
                                            For Each dtc In comp.Authorities
                                                If dtc.AuthorityUID = AuthFound.AuthorityUID Then
                                                    AuthToRelease = dtc
                                                    CompToReference = comp
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                        If Not IsNothing(AuthToRelease) Then
                                            Dim BlockList As ArrayList = Nothing
                                            AuthToRelease.GetBlockListFromID(CompToReference.PTCBlockID, CompToReference.SubdivisionID, BlockList)
                                            AuthToRelease.PartialRelease(BlockList)
                                            AuthToRelease = Nothing
                                        End If
                                    Next
                                    AuthFound.StatusOfDTC = "DELETE"
                                    AuthFound.UpdateBlocksStatuses("DELETE")
                                    AuthFound.SendStatusAuthorityElectronicMessage()

                                    AuthFound.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority)
                                    AuthFound.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority)

                                    OtherTrackAuthorities.Remove(AuthFound)

                                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", AuthFound)
                                    SyncLock gSummaryAuthQueue.SyncRoot
                                        gSummaryAuthQueue.Enqueue(SummItem)
                                    End SyncLock

                                Else
                                    AuthFound.UpdateBlockStatus(CInt(data(4)), "RELEASE")
                                    Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE", AuthFound)
                                    SyncLock gSummaryAuthQueue.SyncRoot
                                        gSummaryAuthQueue.Enqueue(SummItem)
                                    End SyncLock

                                    TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.AuthorityReleaseRequest, messageToProcess, TrainFound)
                                    AuthFound.ReleaseRequestReceived = True
                                End If


                            End If
                    End Select
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

