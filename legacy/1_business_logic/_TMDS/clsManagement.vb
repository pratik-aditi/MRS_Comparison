                For Each s In exceps
                    If Trim(s) <> "" Then
                        TGBOExceptionsDelivered.Add(s)
                    End If
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub


        Private Function GetExceptionString() As String
            Try
                Dim s As New StringBuilder
                Dim e As String
                For Each e In TGBOExceptionsDelivered
                    If s.Length = 0 Then
                        s.Append(e)
                    Else
                        s.Append("|" & e)
                    End If
                Next
                sTGBOExceptionsDelivered = s.ToString
                Return s.ToString
            Catch ex As Exception
                GetErrorDetails(ex)
                Return String.Empty
            End Try
        End Function

        Public Function GetTGBOAssignmentFromDB() As String
            Dim dr As OleDbDataReader = Nothing
            Dim dbComm As New OleDbCommand
            Dim SQLQuery As New StringBuilder
            Try
                With SQLQuery
                    .Append("SELECT TGBOUIDAssignment FROM " & gtblForemen)
                    .Append("  WHERE LastName = '" & Me.LastName & "' AND FirstName = '" & Me.FirstName & "'")
                End With
                Using dbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                    dbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery.ToString, dbConn)
                    dr = dbComm.ExecuteReader()
                    While dr.Read()
                        If Not dr.IsDBNull(0) Then
                            Me.TGBOUIDAssignment = dr.GetValue(0)
                        End If
                    End While
                    dr.Close()
                    dbConn.Close()
                End Using
                Return Me.TGBOUIDAssignment
            Catch ex As Exception
                GetErrorDetails(ex, "GetTGBOAssignmentFromDB: SQLSTRING: " & SQLQuery.ToString)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
            Return String.Empty
        End Function

