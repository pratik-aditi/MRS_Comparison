#Region "AUTO-ROUTER"

    Public Class SignalRoute
        Public SystemUID As String
        Public EntrySignal As Signal
        Public ExitSignal As Signal
        Public ComponentList As New ArrayList()
        Public SwitchList As New ArrayList()
        Public strSwitchList As String
        Public thisTerritory As Territory
        Public myControlPoint As ControlPoint
        Public myDirection As String = ""
        Public EntryTrack As Track
        Public ExitTrack As Track
        Public LastTrack As Track
        Public IsControlledForPTC As Boolean
        'MANUAL ROUTE GENERATION LIST FOR DEPENDENEICES (RouteDependency)
        Public myDependencies As New ArrayList
        Public myPriority As Integer = 0
        Public ValidSignalRoute As Boolean = True
        Public HasFlipFlop As Boolean = False
        Public HasSameDirectionExitSignal As Boolean = False
        Public myExitTracks As New ArrayList()
        Public tmpProcessAsStoredRoute As Boolean = False
        Public IsValidForPSS As Boolean = True
        Public TrueExitSignal As Signal

        Sub New(ByVal myUID As String, ByVal myEnterSig As Int32, ByVal myExitSig As Int32, ByVal sSwitchList As String, ByVal myTerrUID As Int32, ByVal myCPUID As Int32, Optional ByVal Priority As Integer = 0)
            Try
                SystemUID = myUID.ToUpper.Trim
                EntrySignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(myEnterSig)
                ExitSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(myExitSig)
                strSwitchList = sSwitchList
                thisTerritory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(myTerrUID)
                myControlPoint = TMDS.SystemUtilities.FetchData.FindControlPoint(myCPUID)
                myPriority = Priority
                CreateSwitchList()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Get Entry Track
        ''' </summary>
        ''' <param name="pDirection"></param>
        ''' <returns></returns>
        Private Function GetEntryTrack(ByVal pDirection As String) As Boolean
            Dim CompToGet As Object = Nothing
            Try
                If pDirection = "LEFT" Then
                    CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(EntrySignal.RightLink)
                    If CompToGet IsNot Nothing AndAlso CompToGet.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CompToGet.RightLink)
                    End If
                Else
                    CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(EntrySignal.LeftLink)
                    If CompToGet IsNot Nothing AndAlso CompToGet.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CompToGet.LeftLink)
                    End If
                End If
                If CompToGet IsNot Nothing AndAlso CompToGet.GetType.ToString = gTrackComponentName Then
                    Me.EntryTrack = CompToGet
                End If
                If Me.EntryTrack IsNot Nothing AndAlso (Me.EntryTrack.IsControlledForPTC OrElse Me.EntryTrack.IsEntryForPTC OrElse Me.EntryTrack.IsTestForPTC) Then IsControlledForPTC = True
                If IsNothing(Me.EntryTrack) Then Return False
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Function GetExitTrack(ByVal Direction As String) As Boolean
            Try
                Dim CompToGet As Object = Nothing
                Dim FirstComp As Object = Nothing
                'Dim FlipIt As Boolean
                If Direction = "RIGHT" Then
                    CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitSignal.RightLink)
                    If CompToGet.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If CompToGet.RightLink = 0 Then
                            CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitSignal.LeftLink)
                        Else
                            CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CompToGet.RightLink)
                        End If

                    End If
                Else
                    CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitSignal.LeftLink)
                    If CompToGet.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        'CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CompToGet.LeftLink)
                        If CompToGet.LeftLink = 0 Then
                            CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitSignal.RightLink)
                        Else
                            CompToGet = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CompToGet.LeftLink)
                        End If
                    End If
                End If
                If CompToGet.GetType.ToString = gTrackComponentName Then
                    Me.ExitTrack = CompToGet
                End If
                If IsNothing(Me.ExitTrack) Then Return False
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        ''' <summary>
        ''' Create Component List New
        ''' </summary>
        Sub CreateComponentListNew()
            Try
                Dim tmpDirection As String = myDirection
                Dim tmpLastTrack As Track = Nothing
                Dim LoopControl As Integer = 0
                Dim NextComp As Object = EntrySignal
                ComponentList.Add(EntrySignal)
                Dim Direction As String = String.Empty
                myExitTracks = New ArrayList
                If EntrySignal Is Nothing Then
                    ValidSignalRoute = False
                    SystemException($"BAD SIGNAL ROUTE-EntrySignal:{SystemUID}")
                    Exit Sub
                End If
                If EntrySignal.ComponentType.Equals("L") OrElse
                    EntrySignal.ComponentType.Equals("U") Then
                    Direction = "LEFT"
                    NextComp = SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                Else
                    Direction = "RIGHT"
                    NextComp = SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                End If
                Direction = GetSignalDirection(EntrySignal)
                myDirection = Direction
                If Not GetEntryTrack(myDirection) Then
                    ValidSignalRoute = False
                    ComponentList.Clear()
                    Exit Sub
                End If
                'Enable restriction for TWE automatic signals near the split desk
                If optEnableMRSSpecificPTCOperations Then
                    EntrySignal.IsTrackWarrantEnforcementEnabled = EntryTrack.IsTrackWarrantEnforcementEnabled
                End If
                If ExitSignal Is Nothing Then
                    FindRouteToExitSignal(myDirection)
                    If ExitSignal Is Nothing Then
                        ValidSignalRoute = False
                        SystemEvent($"BAD SIGNAL ROUTE-ExitSignal:{SystemUID}")
                    Else
                        PrintRoute()
                    End If
                    Exit Sub
                End If
                If Not GetExitTrack(myDirection) Then
                    ComponentList.Clear()
                    ValidSignalRoute = False
                    SystemException($"BAD SIGNAL ROUTE-GetExitTrack:{SystemUID}")
                    Exit Sub
                End If
                If ExitTrack IsNot Nothing Then
                    If Not myExitTracks.Contains(ExitTrack) Then myExitTracks.Add(ExitTrack)
                End If
                GenerateComponents(NextComp, Direction, tmpDirection, tmpLastTrack)
                If ComponentList Is Nothing Then
                    ValidSignalRoute = False
                    SystemException($"BAD SIGNAL ROUTE-Unable to Generate Components:{SystemUID}")
                    Exit Sub
                End If
                If ComponentList.Count = 0 Then
                    ValidSignalRoute = False
                    SystemException($"BAD SIGNAL ROUTE-Unable to Generate Components:{SystemUID}")
                    Exit Sub
                End If
                Dim FlipMe As Boolean = False
                LoopControl = 0
                NextComp = ComponentList.Item(ComponentList.Count - 1) 'ExitTrack
                Dim PreviousGUID As Int32 = NextComp.GUID
                LoopControl = 0
                NextComp = ComponentList(ComponentList.Count - 1)
                Dim AddTracks As Boolean
                If Direction.Equals("LEFT") AndAlso
                    NextComp.LeftLink = 0 AndAlso
                    NextComp.AltLinkOne <> 0 Then AddTracks = True
                If Direction.Equals("RIGHT") AndAlso
                    NextComp.RightLink = 0 AndAlso
                    NextComp.AltLinkTwo <> 0 Then AddTracks = True
                While AddTracks
                    If Direction.Equals("LEFT") Then
                        If NextComp.LeftLink = 0 Then
                            If NextComp.AltLinkOne <> 0 Then
                                NextComp = SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.AltLinkOne)
                            Else
                                Exit While
                            End If
                        Else
                            NextComp = SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                    Else
                        If NextComp.RightLink = 0 Then
                            If NextComp.AltLinkTwo <> 0 Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.AltLinkTwo)
                            Else
                                Exit While
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If
                    End If
                    If NextComp IsNot Nothing Then
                        If NextComp.GetType.ToString = gSignalComponentName AndAlso
                            (NextComp.ComponentType = EntrySignal.ComponentType OrElse
                            NextComp.AutomaticSignal) Then
                            Exit While
                        Else
                            If Not ComponentList.Contains(NextComp) Then ComponentList.Add(NextComp)
                        End If
                    Else
                        Exit While
                    End If
                    LoopControl += 1
                    If LoopControl > 10 Then
                        Exit While
                    End If
                End While
                LastTrack = SystemUtilities.FetchData.FindLastTrackInList(ComponentList)
                'one more check tomake sure the track pieces in the route in fact set to PTC CONTROL
                For Each oneComponent As Object In ComponentList
                    If oneComponent.GetType.ToString = gTrackComponentName Then
                        Dim theTrack As Track = DirectCast(oneComponent, Track)
                        If Not theTrack.IsControlledForPTC AndAlso theTrack.OStype Then
                            ValidSignalRoute = False
                            IsControlledForPTC = False
                        End If
                    End If
                Next
                GenerateExitTracks()
                If EntrySignal IsNot Nothing AndAlso
                    ComponentList IsNot Nothing AndAlso
                    ComponentList.Count > 0 Then
                    IsValidForPSS = EntrySignal.CheckForInValidRoute(ComponentList)
                End If
                PrintRoute()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub GenerateComponents(ByRef NextComp As Object, Direction As String, ByRef tmpDirection As String, ByRef tmpLastTrack As Track)
            Dim LoopControl As Integer = 0
            Try
                Dim FlipMe As Boolean
                tmpDirection = Direction
                If Direction = "LEFT" Then
                    Do
                        If IsNothing(NextComp) Then Me.ComponentList.Clear() : Exit Sub
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            tmpLastTrack = NextComp
                            Dim trk1 As Track = Nothing
                            trk1 = TryCast(NextComp, Track)
                            If trk1 IsNot Nothing AndAlso trk1.AuthorityType <> "CTC" Then
                                Exit Do
                            End If
                            If Me.ComponentList.Contains(EntrySignal) AndAlso Me.ComponentList.Contains(ExitSignal) Then
                                Exit Do
                            End If
                            ComponentList.Add(NextComp)
                            If FlipMe Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(NextComp, Switch)
                            Select Case sw.TypeOfSwitch
                                Case "NORMAL", "SPRING"
                                    If sw.IndicateOnly Then
                                        If Not ComponentList.Contains(sw) Then
                                            ComponentList.Add(sw)
                                        End If
                                        If FlipMe Then
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                        End If
                                    Else
                                        Dim mySwitchRoute As SwitchPoint = FindSwitchRoute(sw)
                                        If IsNothing(mySwitchRoute) Then Me.ComponentList.Clear() : Exit Sub
                                        ComponentList.Add(sw)
                                        If mySwitchRoute.ReversePosition Then
                                            If FlipMe Then
                                                If sw.RightAltLink <> 0 Then
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                                Else
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                                End If
                                            Else
                                                If sw.LeftAltLink <> 0 Then
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                                Else
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                                End If
                                            End If

                                        Else
                                            If FlipMe Then
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                            Else
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                            End If
                                        End If
                                    End If

                                Case "DERAIL", "ELECTRIC LOCK"
                                    If Not ComponentList.Contains(sw) Then
                                        ComponentList.Add(sw)
                                    End If
                                    If FlipMe Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    End If
                                Case Else
                                    If Not ComponentList.Contains(NextComp) Then
                                        ComponentList.Add(sw)
                                    End If
                                    If FlipMe Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    End If
                            End Select
                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                            ComponentList.Add(NextComp)
                            Dim ExitGUID As Integer
                            Dim RR As RRXING = TryCast(NextComp, RRXING)
                            ExitGUID = RR.FindExitGUID(tmpLastTrack.GUID)
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitGUID)

                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                            ComponentList.Add(NextComp)
                            Dim ExitGUID As Integer
                            TMDS.SystemUtilities.FetchData.DoFlipSearch(tmpLastTrack, tmpDirection, NextComp, ExitGUID)
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitGUID)

                            If FlipMe Then
                                FlipMe = False
                            Else
                                FlipMe = True : Me.HasFlipFlop = True
                            End If



                        ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.AutomaticSignal Then
                            Else
                                If sig.GUID = ExitSignal.GUID Then
                                    If Not ComponentList.Contains(ExitSignal) Then ComponentList.Add(ExitSignal)
                                    Exit Do
                                End If
                            End If


                            If FlipMe Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                        End If

                        LoopControl += 1
                        If LoopControl > 100 Then
                            Exit Do
                        End If
                    Loop
                Else
                    Do
                        If IsNothing(NextComp) Then
                            Me.ComponentList.Clear()
                            Exit Sub
                        End If

                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            tmpLastTrack = NextComp
                            Dim trk1 As Track = Nothing
                            trk1 = TryCast(NextComp, Track)
                            If trk1 IsNot Nothing AndAlso trk1.AuthorityType <> "CTC" Then
                                Exit Do
                            End If
                            If Me.ComponentList.Contains(EntrySignal) AndAlso Me.ComponentList.Contains(ExitSignal) Then
                                Exit Do
                            End If

                            If Not ComponentList.Contains(NextComp) Then
                                ComponentList.Add(NextComp)
                            End If

                            If FlipMe Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(NextComp, Switch)
                            Select Case sw.TypeOfSwitch
                                Case "NORMAL", "SPRING"
                                    If sw.IndicateOnly Then
                                        If Not ComponentList.Contains(NextComp) Then
                                            ComponentList.Add(sw)
                                        End If
                                        If FlipMe Then
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                        End If
                                    Else
                                        Dim mySwitchRoute As SwitchPoint = FindSwitchRoute(sw)
                                        If IsNothing(mySwitchRoute) Then Me.ComponentList.Clear() : Exit Sub
                                        ComponentList.Add(sw)
                                        If mySwitchRoute.ReversePosition Then
                                            If FlipMe Then
                                                If sw.LeftAltLink <> 0 Then
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                                Else
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                                End If
                                            Else
                                                If sw.RightAltLink <> 0 Then
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                                Else
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                                End If
                                            End If
                                        Else
                                            If Not ComponentList.Contains(NextComp) Then
                                                ComponentList.Add(sw)
                                            End If
                                            If FlipMe Then
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                            Else
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                            End If
                                        End If
                                    End If

                                Case "DERAIL", "ELECTRIC LOCK"
                                    If Not ComponentList.Contains(NextComp) Then
                                        ComponentList.Add(sw)
                                    End If
                                    If FlipMe Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                                Case Else
                                    If FlipMe Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                            End Select


                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                            ComponentList.Add(NextComp)
                            Dim ExitGUID As Integer
                            Dim RR As RRXING = TryCast(NextComp, RRXING)
                            ExitGUID = RR.FindExitGUID(tmpLastTrack.GUID)
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitGUID)


                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                            ComponentList.Add(NextComp)
                            Dim ExitGUID As Integer
                            TMDS.SystemUtilities.FetchData.DoFlipSearch(tmpLastTrack, tmpDirection, NextComp, ExitGUID)
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitGUID)
                            If FlipMe Then
                                FlipMe = False
                            Else
                                FlipMe = True : Me.HasFlipFlop = True
                            End If

                        ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If Not sig.AutomaticSignal Then
                                If sig.GUID = ExitSignal.GUID Then
                                    If Not ComponentList.Contains(ExitSignal) Then ComponentList.Add(ExitSignal)
                                    Exit Do
                                End If
                            End If
                            'NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            If FlipMe Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        End If

                        LoopControl += 1
                        If LoopControl > 100 Then
                            Exit Do
                        End If
                    Loop
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Private Sub GenerateExitTracks()
            Dim NextComp As Object = Nothing
            Dim FlipMe As Boolean = False
            Dim ExitSignalReached As Boolean = False
            Dim ExtTrackCollection As New ArrayList
            Dim tmpDirection As String = Me.myDirection
            Dim tmpLastTrack As Track = Nothing
            Try
                Select Case Me.myDirection
                    Case "RIGHT"
                        If Me.HasFlipFlop Then
                            tmpDirection = "LEFT"
                        End If
                    Case "LEFT"
                        If Me.HasFlipFlop Then tmpDirection = "RIGHT"
                End Select

                Select Case tmpDirection 'myDirection
                    Case "RIGHT"
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.ExitSignal.LeftLink)
                    Case Else
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.ExitSignal.RightLink)
                End Select

                If Me.HasFlipFlop Then
                    FlipMe = True
                    Select Case myDirection
                        Case "RIGHT"
                            tmpDirection = "LEFT"
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.ExitSignal.RightLink)
                        Case Else
                            tmpDirection = "RIGHT"
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.ExitSignal.LeftLink)
                    End Select
                End If
                If NextComp IsNot Nothing AndAlso NextComp.GetType.ToString = gTrackComponentName Then
                    If Not ExtTrackCollection.Contains(NextComp) Then ExtTrackCollection.Add(NextComp)
                End If
                If Not HasFlipFlop AndAlso GetSignalDirection(EntrySignal) = GetSignalDirection(ExitSignal) Then
                    Me.HasSameDirectionExitSignal = True
                    If Not Me.myExitTracks.Contains(NextComp) Then Me.myExitTracks.Add(NextComp)
                    Exit Sub
                ElseIf HasFlipFlop AndAlso GetSignalDirection(EntrySignal) <> GetSignalDirection(ExitSignal) Then
                    Me.HasSameDirectionExitSignal = True
                    If Not Me.myExitTracks.Contains(NextComp) Then Me.myExitTracks.Add(NextComp)
                    Exit Sub
                End If

                For I As Integer = 0 To Me.ComponentList.Count + 10
                    If NextComp Is Nothing Then Exit For
                    Select Case tmpDirection 'myDirection

                        Case "RIGHT"
                            Select Case NextComp.GetType.ToString
                                Case gTrackComponentName
                                    tmpLastTrack = NextComp
                                    If ExitSignalReached Then
                                        If Not ExtTrackCollection.Contains(NextComp) Then ExtTrackCollection.Add(NextComp)
                                    End If
                                    Dim TRK As Track = Nothing
                                    If Not NextComp.Indicating Then
                                        Exit For
                                    End If
                                    If FlipMe Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                                Case gSwitchComponentName
                                    Dim sw As Switch = TryCast(NextComp, Switch)
                                    Select Case sw.TypeOfSwitch
                                        Case "NORMAL", "SPRING"
                                            Dim mySwitchRoute As SwitchPoint = FindSwitchRoute(sw)
                                            'If IsNothing(mySwitchRoute) Then Exit For
                                            If mySwitchRoute IsNot Nothing Then
                                                If mySwitchRoute.ReversePosition Then
                                                    If FlipMe Then
                                                        If sw.LeftAltLink <> 0 Then
                                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                                        Else
                                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                                        End If
                                                    Else
                                                        If sw.RightAltLink <> 0 Then
                                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                                        Else
                                                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                                        End If
                                                    End If
                                                Else
                                                    If FlipMe Then
                                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                                    Else
                                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                                    End If
                                                End If
                                            Else
                                                If FlipMe Then
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                                Else
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                                End If
                                            End If

                                        Case Else
                                            If FlipMe Then
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                            Else
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                            End If
                                    End Select



                                Case gRRXINGComponentName
                                    Dim ExitGUID As Integer
                                    Dim RR As RRXING = TryCast(NextComp, RRXING)
                                    ExitGUID = RR.FindExitGUID(tmpLastTrack.GUID)
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitGUID)


                                Case gFlipFlopComponentName


                                    Dim ExitGUID As Integer
                                    TMDS.SystemUtilities.FetchData.DoFlipSearch(tmpLastTrack, tmpDirection, NextComp, ExitGUID)
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitGUID)
                                    If FlipMe Then
                                        FlipMe = False
                                    Else
                                        FlipMe = True
                                    End If


                                Case gSignalComponentName
                                    Dim sig As Signal = CType(NextComp, Signal)
                                    If Not sig.AutomaticSignal Then
                                        If sig Is Me.ExitSignal Then
                                            ExitSignalReached = True
                                        ElseIf ExitSignalReached AndAlso tmpDirection = GetSignalDirection(sig, FlipMe) Then
                                            'If tmpDirection = GetSignalDirection(sig, FlipMe) Then
                                            Exit For
                                            'End If
                                        End If
                                    End If
                                    If FlipMe Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                            End Select
                        Case "LEFT"
                            ' Using Not operator to make it easier from Right Search
                            Select Case NextComp.GetType.ToString
                                Case gTrackComponentName
                                    tmpLastTrack = NextComp
                                    If ExitSignalReached Then
                                        If Not ExtTrackCollection.Contains(NextComp) Then ExtTrackCollection.Add(NextComp)
                                    End If
                                    If Not NextComp.Indicating Then
                                        Exit For
                                    End If
                                    If Not FlipMe Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                                Case gSwitchComponentName
                                    Dim sw As Switch = CType(NextComp, Switch)
                                    Select Case sw.TypeOfSwitch
                                        Case "NORMAL", "SPRING"
                                            Dim mySwitchRoute As SwitchPoint = FindSwitchRoute(sw)
                                            If IsNothing(mySwitchRoute) Then Exit For
                                            If mySwitchRoute.ReversePosition Then
                                                If Not FlipMe Then
                                                    If sw.LeftAltLink <> 0 Then
                                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                                    Else
                                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                                    End If
                                                Else
                                                    If sw.RightAltLink <> 0 Then
                                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                                    Else
                                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                                    End If
                                                End If
                                            Else
                                                If Not FlipMe Then
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                                Else
                                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                                End If
                                            End If
                                        Case Else
                                            If Not FlipMe Then
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                            Else
                                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                            End If
                                    End Select


                                Case gRRXINGComponentName
                                    Dim ExitGUID As Integer
                                    Dim RR As RRXING = TryCast(NextComp, RRXING)
                                    ExitGUID = RR.FindExitGUID(tmpLastTrack.GUID)
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitGUID)


                                Case gFlipFlopComponentName

                                    Dim ExitGUID As Integer
                                    TMDS.SystemUtilities.FetchData.DoFlipSearch(tmpLastTrack, tmpDirection, NextComp, ExitGUID)
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitGUID)
                                    If FlipMe Then
                                        FlipMe = False
                                    Else
                                        FlipMe = True : Me.HasFlipFlop = True
                                    End If

                                Case gSignalComponentName
                                    Dim sig As Signal = CType(NextComp, Signal)
                                    If Not sig.AutomaticSignal Then
                                        If sig Is Me.ExitSignal Then
                                            ExitSignalReached = True
                                        ElseIf ExitSignalReached AndAlso tmpDirection = GetSignalDirection(sig) Then
                                            Exit For
                                        End If
                                    End If
                                    If Not FlipMe Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                            End Select
                    End Select

                Next
                If ExtTrackCollection IsNot Nothing AndAlso ExtTrackCollection.Count > 0 Then
                    If Me.myExitTracks Is Nothing Then Me.myExitTracks = New ArrayList
                    'CopyArrayCollection(Me.myExitTracks, ExtTrackCollection)
                    For Each NextComp In ExtTrackCollection
                        If Not Me.myExitTracks.Contains(NextComp) Then
                            Me.myExitTracks.Add(NextComp)
                        End If
                    Next
                Else
                    SystemEvent("UNABLE TO DETERMINE EXIT TRACK: " & Me.SystemUID)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Private Sub GenerateExitTracksKCT()
            Dim NextComp As Object = Nothing
            Dim FlipMe As Boolean = False
            Dim ExitSignalReached As Boolean = False
            Dim ExtTrackCollection As New ArrayList
            Dim tmpDirection As String = Me.myDirection
            Dim tmpLastTrack As Track = Nothing
            Try

                Select Case Me.myDirection
                    Case "RIGHT"
                        If Me.HasFlipFlop Then
                            tmpDirection = "LEFT"
                        End If
                    Case "LEFT"
                        If Me.HasFlipFlop Then tmpDirection = "RIGHT"
                End Select
                FlipMe = Me.HasFlipFlop



                Select Case tmpDirection
                    Case "RIGHT"
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.ExitSignal.LeftLink)
                    Case Else
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.ExitSignal.RightLink)
                End Select

                For i As Integer = 0 To 3
                    If NextComp Is Nothing Then Exit For
                    Select Case NextComp.GetType.ToString
                        Case gTrackComponentName
                            If Not ExtTrackCollection.Contains(NextComp) Then ExtTrackCollection.Add(NextComp)
                            Me.ExitTrack = NextComp
                            Exit For
                        Case Else
                            Select Case myDirection
                                Case "RIGHT"
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                Case Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End Select
                    End Select
                Next
                If ExtTrackCollection IsNot Nothing AndAlso ExtTrackCollection.Count > 0 Then
                    CopyArrayCollection(Me.myExitTracks, ExtTrackCollection)
                Else
                    SystemEvent("UNABLE TO DETERMINE EXIT TRACK: " & Me.SystemUID)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        ''' <summary>
        ''' Create Component List
        ''' </summary>
        Sub CreateComponentList()
            Try
                Dim LoopControl As Integer
                Dim NextComp As Object = EntrySignal
                ComponentList.Add(EntrySignal)
                Dim Direction As String = String.Empty
                If EntrySignal Is Nothing Then
                    SystemException($"BAD SIGNAL ROUTE-EntrySignal:{SystemUID}")
                    Exit Sub
                End If
                If EntrySignal.ComponentType = "L" Then
                    Direction = "LEFT"
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                Else
                    Direction = "RIGHT"
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                End If
                myDirection = Direction
                If Not GetEntryTrack(myDirection) Then
                    ComponentList.Clear()
                    Exit Sub
                End If
                'Enable restriction for TWE automatic signals near the split desk
                If optEnableMRSSpecificPTCOperations Then
                    EntrySignal.IsTrackWarrantEnforcementEnabled = EntryTrack.IsTrackWarrantEnforcementEnabled
                End If
                If IsNothing(ExitSignal) Then
                    FindRouteToExitSignal(myDirection)
                    If IsNothing(ExitSignal) Then
                        SystemEvent($"BAD SIGNAL ROUTE-ExitSignal:{SystemUID}")
                    Else
                        PrintRoute()
                    End If
                    Exit Sub
                End If
                If Not GetExitTrack(myDirection) Then
                    ComponentList.Clear()
                    SystemException($"BAD SIGNAL ROUTE-GetExitTrack:{SystemUID}")
                    Exit Sub
                End If
                Dim FlipMe As Boolean
                If Direction = "LEFT" Then
                    Do
                        If IsNothing(NextComp) Then ComponentList.Clear() : Exit Sub
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            ComponentList.Add(NextComp)
                            If ComponentList.Contains(EntrySignal) AndAlso ComponentList.Contains(ExitSignal) Then
                                Exit Do
                            End If
                            If FlipMe Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(NextComp, Switch)
                            Dim mySwitchRoute As SwitchPoint = FindSwitchRoute(sw)
                            If IsNothing(mySwitchRoute) Then ComponentList.Clear() : Exit Sub
                            ComponentList.Add(sw)
                            If mySwitchRoute.ReversePosition Then
                                If sw.LeftAltLink <> 0 Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                            ComponentList.Add(NextComp)
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                            ComponentList.Add(NextComp)
                            FlipMe = True
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.ComponentType = EntrySignal.ComponentType Then
                                Exit Do
                            ElseIf FlipMe AndAlso sig.ComponentType = ExitSignal.ComponentType Then
                                Exit Do
                            End If
                            ComponentList.Add(ExitSignal)
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                        LoopControl += 1
                        If LoopControl > 100 Then
                            Exit Do
                        End If
                    Loop
                Else
                    Do
                        If IsNothing(NextComp) Then
                            Me.ComponentList.Clear()
                            Exit Sub
                        End If
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If Me.ComponentList.Contains(EntrySignal) AndAlso ComponentList.Contains(ExitSignal) Then
                                Exit Do
                            End If
                            If Not ComponentList.Contains(NextComp) Then ComponentList.Add(NextComp)
                            If FlipMe Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(NextComp, Switch)
                            Dim mySwitchRoute As SwitchPoint = FindSwitchRoute(sw)
                            If IsNothing(mySwitchRoute) Then ComponentList.Clear() : Exit Sub
                            ComponentList.Add(sw)
                            If mySwitchRoute.ReversePosition Then
                                If sw.RightAltLink <> 0 Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                            ComponentList.Add(NextComp)
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                            ComponentList.Add(NextComp)
                            FlipMe = True
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.ComponentType = EntrySignal.ComponentType Then
                                Exit Do
                            ElseIf FlipMe AndAlso sig.ComponentType = ExitSignal.ComponentType Then
                                Exit Do
                            End If
                            If Not ComponentList.Contains(ExitSignal) Then ComponentList.Add(ExitSignal)
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If
                        LoopControl += 1
                        If LoopControl > 100 Then
                            Exit Do
                        End If
                    Loop
                End If
                FlipMe = False
                LoopControl = 0
                NextComp = ComponentList.Item(ComponentList.Count - 1) 'ExitTrack
                Dim PreviousGUID As Int32 = NextComp.GUID
                Do
                    If Direction = "LEFT" Then
                        If IsNothing(NextComp) Then Exit Do
                        If NextComp.LeftLink = 0 Then
                            Exit Do
                        Else
                            PreviousGUID = NextComp.GUID
                            If FlipMe Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                            If NextComp.GetType.ToString = gFlipFlopComponentName Then
                                FlipMe = True
                                If Not ComponentList.Contains(NextComp) Then ComponentList.Add(NextComp)
                                If PreviousGUID = NextComp.LeftLink Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                            End If
                        End If
                    Else
                        If IsNothing(NextComp) Then Exit Do
                        If NextComp.RightLink = 0 Then
                            Exit Do
                        Else
                            PreviousGUID = NextComp.GUID
                            If Not FlipMe Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                            If NextComp.GetType.ToString = gFlipFlopComponentName Then
                                FlipMe = True
                                If Not ComponentList.Contains(NextComp) Then ComponentList.Add(NextComp)
                                If PreviousGUID = NextComp.RightLink Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            End If
                        End If
                    End If
                    If NextComp.GetType.ToString = gSignalComponentName AndAlso (NextComp.ComponentType = EntrySignal.ComponentType OrElse NextComp.AutomaticSignal) Then
                        Exit Do
                    ElseIf FlipMe AndAlso NextComp.GetType.ToString = gSignalComponentName AndAlso (NextComp.ComponentType = ExitSignal.ComponentType OrElse NextComp.AutomaticSignal) Then
                        Exit Do
                    Else
                        If Not ComponentList.Contains(NextComp) Then ComponentList.Add(NextComp)
                    End If
                    LoopControl += 1
                    If LoopControl > 10 Then
                        Exit Do
                    End If
                Loop
                LoopControl = 0
                NextComp = ComponentList(ComponentList.Count - 1)
                Dim AddTracks As Boolean
                If Direction = "LEFT" AndAlso NextComp.LeftLink = 0 AndAlso NextComp.AltLinkOne <> 0 Then AddTracks = True
                If Direction = "RIGHT" AndAlso NextComp.RightLink = 0 AndAlso NextComp.AltLinkTwo <> 0 Then AddTracks = True
                While AddTracks
                    If Direction = "LEFT" Then
                        If NextComp.LeftLink = 0 Then
                            If NextComp.AltLinkOne <> 0 Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.AltLinkOne)
                            Else
                                Exit While
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                    Else
                        If NextComp.RightLink = 0 Then
                            If NextComp.AltLinkTwo <> 0 Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.AltLinkTwo)
                            Else
                                Exit While
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If
                    End If
                    If Not IsNothing(NextComp) Then
                        If NextComp.GetType.ToString = gSignalComponentName AndAlso (NextComp.ComponentType = EntrySignal.ComponentType OrElse NextComp.AutomaticSignal) Then
                            Exit While
                        Else
                            If Not ComponentList.Contains(NextComp) Then ComponentList.Add(NextComp)
                        End If
                    Else
                        Exit While
                    End If
                    LoopControl += 1
                    If LoopControl > 10 Then
                        Exit While
                    End If
                End While
                LastTrack = TMDS.SystemUtilities.FetchData.FindLastTrackInList(Me.ComponentList)
                'one more check tomake sure the track pieces in the route in fact set to PTC CONTROL
                Dim comp As Object
                For Each comp In Me.ComponentList
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim trk As Track = CType(comp, Track)
                        If Not trk.IsControlledForPTC AndAlso trk.OStype AndAlso Not trk.IsTestForPTC Then
                            IsControlledForPTC = False
                        End If
                    End If
                Next
                PrintRoute()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Print Route
        ''' </summary>
        Private Sub PrintRoute()
            Dim comp As Object
            Try
                SystemEvent("================================================")
                SystemEvent("SIGNAL ROUTE:" & Me.SystemUID)
                SystemEvent("ENTRY SIGNAL:" & Me.EntrySignal.ComponentType & ":" & Me.EntrySignal.Name & ":" & Me.EntrySignal.GUID)
                SystemEvent("EXIT SIGNAL:" & Me.ExitSignal.ComponentType & ":" & Me.ExitSignal.Name & ":" & Me.ExitSignal.GUID)
                SystemEvent("ENTRY TRACK:" & Me.EntryTrack.Name & ":" & Me.EntryTrack.GUID)
                SystemEvent("EXIT TRACK:" & Me.ExitTrack.Name & ":" & Me.ExitTrack.GUID)
                For Each comp In Me.ComponentList
                    SystemEvent(comp.GetType.ToString & comp.Name & ":" & comp.GUID)
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                comp = Nothing
            End Try
        End Sub

        Private Function FindSwitchRoute(ByVal sw As Switch) As SwitchPoint
            Try
                Dim sp As SwitchPoint
                For Each sp In SwitchList
                    If sp.mySwitch IsNot Nothing AndAlso sp.mySwitch.GUID = sw.GUID Then
                        Return sp
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Sub CreateSwitchList()
            Try
                Dim s As String
                Dim SwList() As String = strSwitchList.Split("|")
                For Each s In SwList
                    If s <> "" Then
                        Dim data() As String = s.Split(";")
                        '350224;SWITCH;TRUE
                        Dim sr As New SwitchPoint
                        sr.mySwitch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(CInt(data(0)))
                        If sr.mySwitch IsNot Nothing Then
                            sr.ReversePosition = CBool(data(2))
                            sr.myName = data(1)
                            Me.SwitchList.Add(sr)
                        Else
                            SystemEvent(">>UNABLE TO DETERMINE SWITCH[" & data(0) & "] SIGNAL ROUTE GUID: " & Me.SystemUID)
                        End If

                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub FindRouteToExitSignal(ByVal Direction As String)
            Try
                Dim AddTracks As Boolean = True
                Dim NextComp As Object = EntrySignal
                Dim LoopControl As Integer

                While AddTracks
                    If Direction = "LEFT" Then
                        If NextComp.LeftLink = 0 Then
                            If NextComp.AltLinkOne <> 0 Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.AltLinkOne)
                            Else
                                Exit While
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                    Else
                        If NextComp.RightLink = 0 Then
                            If NextComp.AltLinkTwo <> 0 Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.AltLinkTwo)
                            Else
                                Exit While
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If

                    End If
                    If Not IsNothing(NextComp) Then
                        If NextComp.GetType.ToString = gSignalComponentName Then
                            ExitSignal = NextComp
                            If Not ComponentList.Contains(NextComp) Then ComponentList.Add(NextComp)
                            Exit While
                        Else
                            If Not ComponentList.Contains(NextComp) Then ComponentList.Add(NextComp)
                        End If
                    Else
                        Exit While
                    End If

                    LoopControl += 1
                    If LoopControl > 10 Then
                        Exit While
                    End If
                End While
                LastTrack = TMDS.SystemUtilities.FetchData.FindLastTrackInList(Me.ComponentList)
                If IsNothing(ExitTrack) Then ExitTrack = LastTrack
                If IsNothing(EntryTrack) Then
                    If Direction = "LEFT" Then
                        Dim nextobj As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(EntrySignal.RightLink)
                        If nextobj.GetType.ToString = gSignalComponentName Then
                            EntryTrack = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextobj.RightLink)
                        Else
                            EntryTrack = nextobj
                        End If
                    Else
                        Dim nextobj As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(EntrySignal.LeftLink)
                        If nextobj.GetType.ToString = gSignalComponentName Then
                            EntryTrack = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(nextobj.LeftLink)
                        Else
                            EntryTrack = nextobj
                        End If
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub AddDependencyToRoute(ByRef theList As ArrayList)
            Try
                Dim dp As RouteDependency

                For Each dp In theList
                    myDependencies.Add(dp)
                Next
                theList.Clear()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
