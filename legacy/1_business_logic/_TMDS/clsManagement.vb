                If Me.myTrain IsNot Nothing AndAlso Me.myTrain.myTrack IsNot Nothing AndAlso Me.myTrain.myTrack.mySubdivision IsNot Nothing Then OKTime = GenerateTime(Me.myTrain.myTrack.mySubdivision)
                Dim theUpdate As New StringBuilder("UPDATE tblTrainEventActiveWorkOrders SET WorkOrderCompleted = 1, OKTime='" & OKTime.ToString & "' WHERE UID = '" & myUID & "'")

                Dim Loads As Integer = myTrain.OLoads
                Dim Emts As Integer = myTrain.OEmts
                Dim Tons As Int32
                Dim Length As Integer
                Dim NumOpBrakes As Integer
                Dim NumOfAxles As Integer
                Dim DeleteEvent As Boolean = False


                Select Case myEventType.ToUpper.Trim
                    Case "P"
                        DeleteEvent = False
                    Case Else
                        DeleteEvent = True
                End Select

                If Not DeleteEvent Then
                    Tons = myTrain.OTons + myCarTons
                    Length = myTrain.OLength + myCarLength
                    NumOpBrakes = myTrain.NumberOperatingBrakes + myCarNumOfBrakes
                    NumOfAxles = myTrain.NumberOfAxles + myCarNumOfAxles
                    Select Case myCarLoadStatus.Trim.ToUpper
                        Case "E"
                            Emts = Emts + 1
                        Case Else
                            Loads = Loads + 1
                    End Select
                Else
                    Tons = myTrain.OTons - myCarTons
                    Length = myTrain.OLength - myCarLength
                    NumOpBrakes = myTrain.NumberOperatingBrakes - myCarNumOfBrakes
                    NumOfAxles = myTrain.NumberOfAxles - myCarNumOfAxles
                    Select Case myCarLoadStatus.Trim.ToUpper
                        Case "E"
                            Emts = Emts - 1
                        Case Else
                            Loads = Loads - 1
                    End Select
                End If



                Dim ConsistString As String = GetConsistUpdateSQLString(Loads, Emts, Tons, Length, NumOpBrakes, NumOfAxles)
                SQLStringCollection.Add(theUpdate.ToString)
                SQLStringCollection.Add(ConsistString)

                If Not DeleteEvent Then
                    Dim TC As New TrainCar
                    With TC
                        .myTrain = myTrain
                        .myUID = Guid.NewGuid.ToString.ToUpper
                        .CarUID = myCarUID
                        .CarTons = myCarTons
                        .CarLength = myCarLength
                        .CarAxles = myCarNumOfAxles
                        .CarNumOperateBrakes = myCarNumOfBrakes
                        .LoadStatus = myCarLoadStatus
                        .RailroadUID = Me.myTrain.EntityUID
                        '.GetNextCarPostion(.CarPositionIndex)
                        .CarPositionIndex = 1
                    End With

                    CarSQLString = TC.GetInsertSQLString
                    If CarSQLString IsNot Nothing AndAlso Not String.IsNullOrEmpty(CarSQLString) AndAlso CarSQLString.Trim <> "" Then
                        If Not SQLStringCollection.Contains(CarSQLString) Then SQLStringCollection.Add(CarSQLString)
                    Else
                        Return False
                    End If
                    Dim UpdateCarPostionSQLString As New ArrayList
                    If TC.GetUpdateCarPostion(UpdateCarPostionSQLString) Then
                        S = String.Empty
                        If UpdateCarPostionSQLString IsNot Nothing AndAlso UpdateCarPostionSQLString.Count > 0 Then
                            For Each S In UpdateCarPostionSQLString
                                If Not SQLStringCollection.Contains(S) Then SQLStringCollection.Add(S)
                            Next
                        End If
                    Else
                        Return False
                    End If


                Else
                    Dim tc As TrainCar

                    For Each tc In myTrain.myCarList
                        If tc.CarUID.ToUpper.Trim = myCarUID.ToUpper.Trim Then
                            tcToDelete = tc
                            Exit For
                        End If
                    Next
                    If tcToDelete IsNot Nothing Then
                        S = String.Empty
                        Dim CarDeleteSQLList As New ArrayList
                        CarDeleteSQLList = tcToDelete.GetDeleteString
                        If CarDeleteSQLList IsNot Nothing AndAlso CarDeleteSQLList.Count > 0 Then
                            For Each S In CarDeleteSQLList
                                If Not SQLStringCollection.Contains(S) Then SQLStringCollection.Add(S)
                            Next
                        Else
                            ErrrorMessage = "UNABLE TO FIND TO CAR WITH UID [" & myCarUID & "] COMPLETE SETOUT WORK ORDER PROCESS STOPPED. "
                            SystemEvent("UNABLE TO FIND TO CAR WITH UID [" & myCarUID & "] COMPLETE SETOUT WORK ORDER PROCESS STOPPED. ")
                            Return False
                        End If
                    Else
                        ErrrorMessage = "UNABLE TO FIND TO CAR WITH UID [" & myCarUID & "] COMPLETE SETOUT WORK ORDER PROCESS STOPPED. "
                        SystemEvent("UNABLE TO FIND TO CAR WITH UID [" & myCarUID & "] COMPLETE SETOUT WORK ORDER PROCESS STOPPED. ")
                        Return False
                    End If
                End If

                If Not ExecuteQueryCollection(SQLStringCollection, gConnectionStringDynamic) Then Return False
                Me.myTrain.OEmts = Emts
                Me.myTrain.OLength = Length
                Me.myTrain.OLoads = Loads
                Me.myTrain.OTons = Tons
                Me.myTrain.NumberOfAxles = NumOfAxles
                Me.myTrain.NumberOperatingBrakes = NumOpBrakes
                myTrain.CalculateHorsePowerPerTon(Tons)
                myTrain.RefreshCarConsist(True)
                myTrain.PerformConsistDatabaseUpdatePTC()
                Me.WorkComepleted = True
                Me.WorkOKTime = OKTime
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Function GetConsistUpdateSQLString(ByVal Loads As Integer, ByVal Emts As Integer, ByVal Tons As Int32, ByVal Length As Integer, ByVal NumOpBrakes As Integer, ByVal NumOfAxles As Integer) As String
            Dim Update As New StringBuilder
            Try


                Me.myTrain.TrainConsistChangeCheck(Loads, Emts, Length, Tons, NumOfAxles, NumOpBrakes, False)
                Update.Append("UPDATE tblTrainsActive ")
                Update.Append(" SET OLoads = " & Loads)
                Update.Append(", OEmts = " & Emts)
                Update.Append(", OTons = " & Tons)
                Update.Append(", OLength = " & Length)
                Update.Append(", NumberOperatingBrakes = " & NumOpBrakes)
                Update.Append(", NumberOfAxles = " & NumOfAxles)
                Update.Append(" WHERE EntityUID = '" & Me.myTrain.EntityUID & "'")
                Return Update.ToString
            Catch ex As Exception
                GetErrorDetails(ex, "SQL QUERY: " & Update.ToString)
            End Try
            Return Nothing
        End Function

    End Class
