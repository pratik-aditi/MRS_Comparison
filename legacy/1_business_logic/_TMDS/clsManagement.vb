        Public Function RollUpSFA(ByVal AuthUID As String, ByVal Components As String) As Boolean
            Try
                If optEnableTerritoryDeskAssignmentMode Then
                    If Not CheckForShadowMode(Components) Then Exit Function
                End If
                Dim comp As Object
                Dim auth As Object = Nothing 'TMDS.TrackAuthority.SFAuthority
                Dim AuthToDelete As Object = Nothing 'TMDS.TrackAuthority.SFAuthority
                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        If auth.AuthorityUID = AuthUID Then
                            AuthToDelete = auth
                            Exit For
                        End If
                    End If
                Next

                If IsNothing(AuthToDelete) Then
                    Return False
                End If
                Dim CompToDelete As New ArrayList()
                Dim DeleteList As New ArrayList()

                Dim GUIDs() As String = Components.Split("-")
                Dim strGUID As String

                Dim AddToList As Boolean
                For Each comp In AuthToDelete.Components

                    For Each strGUID In GUIDs
                        If IsNumeric(strGUID) Then
                            AddToList = True
                            If comp.GUID = CInt(strGUID) Then
                                AddToList = False
                                Exit For
                            End If
                        End If
                    Next

                    If AddToList Then
                        DeleteList.Add(comp.GUID.ToString)
                    End If

                Next

                For Each strGUID In DeleteList
                    If IsNumeric(strGUID) Then
                        Dim compToBlock As Object = FindComponent(CInt(strGUID))
                        If Not compToBlock Is Nothing Then
                            CompToDelete.Add(compToBlock)
                        End If
                    End If
                Next

                For Each comp In CompToDelete
                    comp.ActiveTrackWarrant = False
                    comp.TrafficDirection = ""
                    comp.TrackAuthorities.Remove(auth)

                    If gDisplayTrackAuthorityNumbers Then
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(comp, Track)
                            trk.InitAuthorityNumbers()
                        End If
                    End If

                    comp.UpdateStatus()
                Next
                Dim SummItem As New SummaryItem("AUTHORITY", "REFRESH", Nothing)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

