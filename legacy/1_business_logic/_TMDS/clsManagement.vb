        Public Sub InitializationControlPointAssignments()
            Try
                Dim theList() As String = Me.ControlPointAssignments.Split(";")
                Dim u As String
                Dim cp As ControlPoint

                For Each u In theList
                    If IsNumeric(u) Then
                        For Each cp In gControlPointCollection
                            If cp.GUID = CInt(u) Then
                                Me.ControlPointAssignmentList.Add(cp)
                                Exit For
                            End If
                        Next
                    End If
                Next
                GetControllingStatusForControlPoints()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub GetControllingStatusForControlPoints()
            Dim query As String
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim dbconn As OleDbConnection
            Dim cp As ControlPoint
            Dim theList As New ArrayList

            Try
                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                For Each cp In ControlPointAssignmentList
                    query = "SELECT ControllingWorkstation, ControllingWorkStationIPString FROM tblCompControlPoints WHERE UID = " & cp.GUID
                    dbcomm = New OleDbCommand(query, dbconn)
                    dr = dbcomm.ExecuteReader()
                    While dr.Read()
                        Dim cps As New ControlPointStatus
                        cps.myControlPoint = cp
                        If ForceLoadMyControllingControlPoints AndAlso gMyControllingControlPtGUID IsNot Nothing AndAlso gMyControllingControlPtGUID.Count Then
                            If gMyControllingControlPtGUID.Contains(cp.GUID) Then
                                cps.myControllingWorkstation = ""
                                cps.myControllingWorkStationIPString = ""
                            Else
                                If Not dr.IsDBNull(0) Then cps.myControllingWorkstation = dr.GetString(0)
                                If Not dr.IsDBNull(1) Then cps.myControllingWorkStationIPString = dr.GetString(1)
                            End If
                        Else
                            If Not dr.IsDBNull(0) Then cps.myControllingWorkstation = dr.GetString(0)
                            If Not dr.IsDBNull(1) Then cps.myControllingWorkStationIPString = dr.GetString(1)
                        End If

                        theList.Add(cps)
                    End While
                Next

                dbconn.Close()
                dbconn = Nothing

                Dim c As ControlPointStatus
                For Each c In theList
                    If c.myControllingWorkstation = gWorkStationName OrElse String.IsNullOrEmpty(c.myControllingWorkstation) Then
                        c.myControllingWorkstation = gWorkStationName
                        c.myControllingWorkStationIPString = gThisWorkstation.IpAddress
                        c.myControlPoint.IsShadowMode = False
                        c.myControlPoint.IsControlled = True
                        'c.myControlPoint.ControllingWorkstation = gWorkStationName
                        c.myControlPoint.ControllingWorkStationIPString = gThisWorkstation.IpAddress
                        c.myControlPoint.UpdateControlPointStatus(True)
                    Else
                        c.myControlPoint.IsShadowMode = True
                        c.myControlPoint.IsControlled = False
                    End If
                    c.myControlPoint.UpdateStatus()
                Next

                For Each cp In Me.myControlPoints
                    cp.SetShadowModeForComponents()
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try

        End Sub

