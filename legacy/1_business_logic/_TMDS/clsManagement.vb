        Public Function RemoveJournalFromDB(ByVal GUID As String) As Boolean
            Dim dbconn As OleDbConnection = Nothing
            Dim CommandInsert As OleDbCommand = Nothing
            Dim CommandDelete As OleDbCommand = Nothing
            Try
                Dim JournalInsertSQL As String = "INSERT INTO tblJournalEntriesInActive SELECT * FROM tblJournalEntriesActive WHERE UID='" & GUID & "'"
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                CommandInsert = New OleDbCommand(JournalInsertSQL, dbconn)
                dbconn.Open()
                CommandInsert.ExecuteNonQuery()
                dbconn.Close()

                Dim AuthorityDeleteSQL As String = "DELETE FROM " & gtblJournalActive & " WHERE UID = '" & GUID & "'"
                CommandDelete = New OleDbCommand(AuthorityDeleteSQL, dbconn)
                If CommandDelete.Connection.State = ConnectionState.Connecting Or CommandDelete.Connection.State = ConnectionState.Open Then
                    CommandDelete.Connection.Close()
                End If
                dbconn.Open()
                CommandDelete.ExecuteNonQuery()
                'dbconn.Close()
                'CommandInsert = Nothing
                'CommandDelete = Nothing

                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                'dbconn = Nothing
            Finally
                If Not dbconn Is Nothing Then
                    If dbconn.State = ConnectionState.Open Then dbconn.Close()
                    dbconn.Dispose()
                    dbconn = Nothing
                End If
                If Not CommandInsert Is Nothing Then
                    CommandInsert.Dispose()
                    CommandInsert = Nothing
                End If
                If Not CommandDelete Is Nothing Then
                    CommandDelete.Dispose()
                    CommandDelete = Nothing
                End If
            End Try

        End Function


