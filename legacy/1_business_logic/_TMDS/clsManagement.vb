        Public Shared Sub ProcessLocomotiveStatus(ByVal data As String)
            Dim trk As Object = Nothing
            Dim Endtrk As Object = Nothing
            If Not gInitialized Then Exit Sub
            Try
                'Locomotive Status [7001] (BOS  TO Disp)
                'This message is used to report locomotive status for a locomotive on a train in the system.
                'ID Field                   Size  (Bytes) Type Value Description
                '1. Message Type            2 N 70 Status type message
                '2. Message Sub Type        2 N 01 Locomotive Status sub-type
                '3. Message Version         2 N 01 message version id
                '4. Date Time Stamp         14 Z YYYYMMDDHHMMSS
                '5. Message Sequence Number 6 N Unique sequence number returned in acknowledge(Message)
                '6. Symbol                  18 S - train symbol-if associated with unit.
                '7. Locomotive ID           10 U - Unit authority issued to
                '8. Current Authority       6 N
                '9. Head End GUID           6 G
                '10. GUID Head End Milepost 8 M XXXX.XXX
                '11. GUID Head End Milepost Modifier 1              A()
                '12. Rear End GUID          6 G
                '13. GUID Rear End Milepost 8 M XXXX.XXX
                '14. GUID Rear End Milepost Modifier 1              A()
                '15. Speed                  3 N
                '16. Direction              1 A - train symbol direction of move
                '17. Locomotive State       1 N 0 = Unknown
                '       1 = Controlling/Cut-in
                '       2 = Cut-out Non-controlling
                '18. Locomotive SubState 2 N State:
                '       0 = Unknown
                '       1 = Self Test
                '       2 = Initializing
                '       3 = Disengaged
                '       4 = Cut out
                '       5 = Active
                '       6 = Braking
                '       7 = Stopped
                '       8 = Failed
                '       9 = Reverse (etms)
                '       10 = Trailing (etms)
                '       11 = Sleeping (etms)
                '19. Locomotive is PTC Capable 1 Y 
                '       Y - locomotive is capable for PTC
                '       N - locomotive is not capable for PTC
                '20. Locomotive is On PTC Territory 1 Y 
                '       Y:locomotive is on PTC territory
                '       N:locomotive is off of PTC territory
                '21. Tracking Enabled 1 Y 
                '       Y:Dispatch should move ID
                '       N:Dispatch should not move ID
                '22. Locomotive is Out of Comm 1 Y Y:Locomotive is out of comm.
                '23. Locomotive is Out of Comm Minutes 3 N Number of minutes locomotive has been out of communication with office
                '24. Last Init Status 2 N 0 = no error
                '       1 = GTB error
                '       2 = Max Speed error
                '       3 = Train Sheet error
                '       4 = Login error
                '       5 = Data Set error
                '       6 = Time out
                '       7 = Non Comm error
                '       8 = Brake test error
                '       9 = failed Departure Test
                '       10 = Configuration Error
                '       11 = No init has been attempted
                '       99 = Unknown
                '******************************************************************
                'ACTION ITEMS:
                '1) PARSE THIS MESSAGE TO LOCAL VARIABLES
                '2) FIND A LOCOMOTIVE OBJECT FROM gLocomotiveCollection using FindLocomotive
                '3) ASSIGN MESSAGE VALUES TO OBJECT FROM MESSAGE
                '4) UPDATE THE SYSTEM SUMMARY USING A "New SummaryItem("LOCOMOTIVE", Action, Me)"
                '5) NEW DATA FROM MESSAGE SHOULD BE REFELCTED IN THE LOCOMOTIVE TRACK TAB IN THE SYSTEM SUMMARY
                '******************************************************************
                Dim StatusDate As Date = GetDateFromUTC(Mid(data, 1, 14))
                Dim Symbol As String = Mid(data, 21, 18)
                Dim LocoUID As String = Trim(Mid(data, 39, 10))
                Dim CurrentAuth As String = Trim(Mid(data, 49, 6))
                Dim StartTrackGUID As String = Trim(Mid(data, 55, 6))
                Dim StartTrackMP As String = Trim(Mid(data, 61, 8))
                Dim StartTrackMPSuffix As String = Trim(Mid(data, 69, 1))
                Dim ENDTrackGUID As String = Trim(Mid(data, 70, 6))
                Dim ENDTrackGUIDMP As String = Trim(Mid(data, 76, 8))
                Dim ENDTrackGUIDMPSuffix As String = Trim(Mid(data, 84, 1))
                Dim LocoSubDivision As String = Trim(Mid(data, 85, 6))
                Dim Speed As String = Mid(data, 91, 3)
                Dim Direction As String = Mid(data, 94, 1)
                Dim LocoState As String = Mid(data, 95, 1)
                Dim LocoSubState As String = Mid(data, 96, 2)
                Dim LocoPTCEnabled As String = Mid(data, 98, 1)
                Dim LocoOnPTCTerr As String = Mid(data, 99, 1)
                Dim TrackingEnabled As String = Mid(data, 100, 1)
                Dim LocoOutOfComm As String = Mid(data, 101, 1)
                Dim LocoOutOfCommMins As String = Mid(data, 102, 3)
                Dim LocoStatusID As String = Mid(data, 105, 2)

                'Dim Loco As MobileTracking.Locomotive = FindLocomotive(LocoUID)
                SystemEvent(" TEST LOG - 7001 RECEIVED ON " & gWorkStationName)
                '41	12/7/2010	 	ETMS turn train different loco, tracking tab info not correct - JARED Requested
                Dim Loco As MobileTracking.Locomotive = FindLocomotive(LocoUID, Symbol)
                If IsNothing(Loco) Then
                    SystemEvent(" 7001 ERROR : LOCOMOTIVE IS NOTHING. EXITING FUNCTION")
                    Exit Sub
                End If

                With Loco
                    .ReportTime = StatusDate
                    .Symbol = Symbol.Trim
                    .LocomotiveID = LocoUID.Trim
                    'With .myTrainID
                    '    .Name = Symbol
                    '    .IdentifingUnit = LocoUID
                    '    .Speed = CInt(Speed)
                    '    .TrackGUID = CInt(StartTrackGUID)
                    '    .Direction = Direction.Trim
                    'End With
                    '.myTrainID.IdentifingUnit = LocoUID

                    '.DirectionOfTravel = "" 'Direction.Trim

                    Select Case Direction.Trim.ToUpper
                        Case "E"
                            .DirectionOfTravel = "EAST"
                        Case "W"
                            .DirectionOfTravel = "WEST"
                        Case "S"
                            .DirectionOfTravel = "SOUTH"
                        Case "N"
                            .DirectionOfTravel = "NORTH"
                        Case ""
                            .DirectionOfTravel = ""
                    End Select
                    'StartTrackGUID = ""
                    'LocoSubDivision = ""
                    'StartTrackMP = ""
                    'ENDTrackGUIDMP = ""

                    If StartTrackGUID.Trim <> "" Then trk = FindCompFromGUID(CInt(StartTrackGUID))

                    'trk = FindTrackCompFromMilePost(CDec(StartTrackMP), StartTrackMPSuffix)
                    If Not trk Is Nothing Then
                        If trk.GetType.ToString = gTrackComponentName Then
                        Else
                            trk = Nothing
                        End If
                    End If

                    If Not trk Is Nothing Then
                        If TrackingEnabled.Trim.ToUpper = "Y" Then PositionTrain(trk, Symbol.Trim)
                        .thisCurrentTrack = trk
                        .TrackGUID = trk.GUID 'CInt(StartTrackGUID)
                        .TrackName = trk.TrackName ' FindCompFromGUID(162108).TrackName
                        '.Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionNameFromUID(trk.SubdivisionID)
                    Else
                        .TrackName = ""
                        Dim TrkGUID As Integer = 0
                        If Integer.TryParse(StartTrackGUID, TrkGUID) Then
                            If TrkGUID > 0 Then
                                GetTrackNameFromDB(TrkGUID, .TrackName)
                            End If
                        End If

                    End If
                    .Subdivision = LocoSubDivision

                    If ENDTrackGUID.Trim <> "" Then Endtrk = FindCompFromGUID(CInt(ENDTrackGUID))
                    If Not Endtrk Is Nothing AndAlso Endtrk.GetType.ToString = gTrackComponentName Then
                        .EndTrack = Endtrk
                        .EndTrackGUID = Endtrk.GUID 'CInt(StartTrackGUID)
                    End If


                    .myTrainID = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(Loco.Symbol)
                    .MilePost = StartTrackMP
                    .MilePostSuffix = StartTrackMPSuffix
                    .EndMilePost = ENDTrackGUIDMP
                    .EndMilePostSuffix = ENDTrackGUIDMPSuffix
                    .Speed = CInt(Speed)
                    '.DirectionOfTravel = Direction.Trim
                    .CutInState = False
                    .CutOutState = False
                    Select Case CInt(LocoState)
                        Case 0
                            .CutInState = False
                            .CutOutState = False
                        Case 1
                            .CutInState = True
                        Case 2
                            .CutOutState = True
                    End Select

                    ' Dim LastStatus As String = .rsubState.ToString.ToUpper
                    .LocosubState = CInt(LocoSubState)
                    .rLocosubState = CInt(LocoSubState)

                    If LocoPTCEnabled.Trim.ToUpper = "Y" Then .PTCCapable = True Else .PTCCapable = False
                    If LocoOnPTCTerr.Trim.ToUpper = "Y" Then .OnPTCTerritory = True Else .OnPTCTerritory = False
                    If TrackingEnabled.Trim.ToUpper = "Y" Then .TrackingEnabled = True Else .TrackingEnabled = False
                    If LocoOutOfComm.Trim.ToUpper = "Y" Then .OutOfComm = True Else .OutOfComm = False
                    .OutOfCommMins = CInt(LocoOutOfCommMins.Trim)
                    .LocoStatusID = CInt(LocoStatusID)
                    .rLocoStatus = CInt(LocoStatusID)
                    .RequestedStatusReceived = True

                    If .PTCCapable And .OnPTCTerritory And .LocoStatusID = 11 Then
                        .LocomotiveIDColor = Color.Blue
                    ElseIf CInt(LocoState) = 1 And .PTCCapable Then
                        .LocomotiveIDColor = Color.Lime
                    ElseIf CInt(LocoSubState) = 4 And .PTCCapable Then
                        .LocomotiveIDColor = Color.Red
                        RemovePTCStatusFromAuthorities(Loco)
                    ElseIf .OutOfComm And .PTCCapable Then
                        .LocomotiveIDColor = Color.Yellow
                    ElseIf Not .PTCCapable Then
                        .LocomotiveIDColor = Color.Black
                    End If
                End With

                If Not Loco.myTrainID Is Nothing Then
                    SystemEvent(" TEST LOG - TRAIN FOUND " & Loco.myTrainID.Name)
                    'Loco.myTrainID.TrainIDColor = Loco.LocomotiveIDColor
                    With Loco.myTrainID
                        'If Not .ReadOnlySymbol Then
                        If Loco.LocomotiveID = .IdentifingUnit Then
                            .TrainIDColor = Loco.LocomotiveIDColor
                        End If
                        If Loco.PTCCapable And Loco.OutOfComm Then
                            .ShowFailure = True
                        Else
                            .ShowFailure = False
                        End If
                        .Speed = Loco.Speed
                        If Loco.PTCCapable And .PTCStatus = "ACTIVE" Then
                        Else
                            If Loco.PTCCapable Then
                                .PTCStatus = "ACTIVE"
                                .UpdatePTCStatus("ACTIVE")
                            Else
                                .PTCStatus = "INACTIVE"
                                .UpdatePTCStatus("INACTIVE")
                            End If

                        End If

                        'End If
                    End With

                    Dim SummItem2 As New SummaryItem("TRAIN", "UPDATE", Loco.myTrainID)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem2)
                    End SyncLock


                    If Loco.PTCCapable Then
                        Dim SummItem As New SummaryItem("LOCOMOTIVE", "LOCO-STATUS", Loco)
                        SyncLock gLocomotiveSummaryQueue.SyncRoot
                            gLocomotiveSummaryQueue.Enqueue(SummItem)
                        End SyncLock
                    End If

                    'End If
                Else
                    SystemEvent(" TEST LOG - TRAIN NOT FOUND ")
                    'COMMENTED BY SARA BASED ON HMI SECTION 2.19 for issue 5061
                    'If Loco.PTCCapable Then
                    '    Dim SummItem As New SummaryItem("LOCOMOTIVE", "LOCO-STATUS", Loco)
                    '    SyncLock gLocomotiveSummaryQueue.SyncRoot
                    '        gLocomotiveSummaryQueue.Enqueue(SummItem)
                    '    End SyncLock
                    'End If
                End If

                Dim LocoSubStatus As Integer = 0
                Integer.TryParse(Loco.LocosubState.Trim, LocoSubStatus)
                If LocoSubState = 4 Then SystemEvent(" 7001 LOCO SUB STATE : CUTOUT")
                If Loco.CutOutState Or LocoSubState = 4 Then
                    Dim Auth As Object = Nothing
                    Try
                        For Each Auth In OtherTrackAuthorities
                            If Not Auth Is Nothing Then
                                Select Case Auth.GetType.ToString
                                    Case gSFAComponentName
                                        'If Auth.PTCAuthorityACKPending.Trim = PTCAuthorityACKPendingStatus.ROLLUP.ToString Then
                                        If Auth.PTCAuthorityACKPending.Trim <> String.Empty Then
                                            If Mid(Auth.IssueTo, 1, 10) = Mid(Loco.LocomotiveID, 1, 10) Then

                                                Auth.FlasherMode(False, True)
                                                Auth.PTCAuthorityACKPending = ""
                                            End If
                                        End If
                                    Case gTTComponentName
                                        If Auth.PTCAuthorityACKPending.Trim <> String.Empty Then
                                            If Mid(Auth.IssueTo, 1, 10) = Mid(Loco.LocomotiveID, 1, 10) Then
                                                Auth.FlasherMode(False, True)
                                            End If
                                        End If
                                End Select
                            End If
                        Next
                        Auth = Nothing
                        For Each Auth In TMDS.GlobalDeclarations.gOtherSpecialAuthorityCollection
                            If Not Auth Is Nothing AndAlso Auth.GetType.ToString = gOtherSplAuthorityName Then
                                If Mid(Auth.IssueTo, 1, 10) = Mid(Loco.LocomotiveID, 1, 10) Then
                                    If Auth.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.PENDINGRELEASE.ToString Then
                                        Auth.FlasherMode(False, True)
                                        Auth.DoPSSPerformRelease()
                                    End If
                                End If
                            End If
                        Next

                    Catch ex As Exception
                        GetErrorDetails(ex)
                    Finally
                        Auth = Nothing
                    End Try
                End If



                If LocoSubStatus = 4 Then
                    Dim Auth As Object = Nothing
                    Try
                        For Each Auth In OtherTrackAuthorities
                            If Not Auth Is Nothing Then
                                Select Case Auth.GetType.ToString
                                    Case gSFAComponentName
                                        'If Auth.PTCAuthorityACKPending.Trim = PTCAuthorityACKPendingStatus.ROLLUP.ToString Then
                                        If Auth.PTCAuthorityACKPending.Trim = String.Empty Then
                                            If Mid(Auth.IssueTo, 1, 10) = Mid(Loco.LocomotiveID, 1, 10) Then
                                                If Auth.PTCTypeAuthority Then SystemEvent(" 7001 LOCO SUB STATE : CUTOUT. CONVERTING AUTHORITY NO:" & Auth.AuthorityUID & " TO NON-PTC")
                                                Auth.PTCStatus = "NONE"
                                                Auth.UpdateDatabaseWithPTCAuthorityStatus("NONE")
                                                Auth.PTCTypeAuthority = False
                                                Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC-STATUS", Auth)
                                                SyncLock gSummaryAuthQueue.SyncRoot
                                                    gSummaryAuthQueue.Enqueue(SummItem)
                                                End SyncLock
                                            End If
                                        End If
                                    Case gTTComponentName
                                        If Auth.PTCAuthorityACKPending.Trim = String.Empty Then
                                            If Mid(Auth.IssueTo, 1, 10) = Mid(Loco.LocomotiveID, 1, 10) Then
                                                If Auth.PTCTypeAuthority Then SystemEvent(" 7001 LOCO SUB STATE : CUTOUT. CONVERTING AUTHORITY NO:" & Auth.AuthorityUID & " TO NON-PTC")
                                                Auth.PTCStatus = "NONE"
                                                Auth.UpdateDatabaseWithPTCAuthorityStatus("NONE")
                                                Auth.PTCTypeAuthority = False
                                                Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC-STATUS", Auth)
                                                SyncLock gSummaryAuthQueue.SyncRoot
                                                    gSummaryAuthQueue.Enqueue(SummItem)
                                                End SyncLock
                                            End If
                                        End If
                                End Select
                            End If
                        Next
                        If Loco.CutOutState Then
                            ProcessNAcknowledgeCutOutTrainAlerts(Symbol, String.Empty)
                        End If
                        'Auth = Nothing
                        'For Each Auth In TMDS.GlobalDeclarations.gOtherSpecialAuthorityCollection
                        '    If Not Auth Is Nothing AndAlso Auth.GetType.ToString = gOtherSplAuthorityName Then
                        '        If Mid(Auth.IssueTo, 1, 10) = Mid(Loco.LocomotiveID, 1, 10) Then
                        '            If Auth.PTCAuthorityACKPending.ToString.Trim = "" Then
                        '                Auth.PTCStatus = "NONE"
                        '                Auth.UpdateDatabaseWithPTCAuthorityStatus("NONE")
                        '                Auth.PTCTypeAuthority = False
                        '                Dim SummItem As New SummaryItem("SPLAUTHORITY", "UPDATE-PTC-STATUS", Auth)
                        '                SyncLock gSummaryAuthQueue.SyncRoot
                        '                    gSummaryAuthQueue.Enqueue(SummItem)
                        '                End SyncLock
                        '            End If
                        '        End If
                        '    End If
                        'Next

                    Catch ex As Exception
                        GetErrorDetails(ex)
                    Finally
                        Auth = Nothing
                    End Try
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                trk = Nothing
                Endtrk = Nothing
            End Try
        End Sub

        Public Shared Sub ProcessLocomotiveInitStatus(ByVal data As String)
            If Not gInitialized Then Exit Sub
            Try
                'Locomotive Init Status [7003] (BOS to Disp)
                'This message is used to report Init status progression.
                'ID                                 Field Size (Bytes)      Type Value             Description
                '1. Message Type                    2                       N 70 Status type message
                '2. Message Sub Type                2                       N 03 Locomotive Init Status sub-type
                '3. Message Version                 2                       N 01 message version id
                '4. Message Sequence Number         6                       N Unique sequence number used to acknowledge receipt of message
                '5. Symbol                          18                      S - train symbol
                '6. Locomotive ID                   10                      U - Locomotive Initializing
                '7. Loco Init Mode                  1                       A                 
                '       I â€“ in ETMS init
                '       C â€“ in Crew Interaction
                '       P â€“ poll registration
                '       S â€“ state of controlling requested
                '       E â€“ end of init
                '8. Loco Authorized to Init         1 Y
                '9. Loco Configuration Approved     1 Y
                '10. Crew has Logged On             1 Y
                '11. Loco Has Registered for Poll   1 Y
                '12. All datasets Confirmed         1 Y
                '13. Init has Timed Out             1 Y
                '14. Init Has Error                 1 Y
                '15. Last Init Date Time            14 Z
                'Following is Progression of data items in Init
                '16. Count of Movement Authorities  2   N
                '17. Sent Movement Authorities      2 N
                '18. Count of Restrictions          2 N
                '19. Sent Restrictions              2 N
                '20. Count of Work Zones            2 N
                '21. Sent Work Zones                2 N
                '22. Consist Sent                   1 Y
                'Error Description from Init
                '23. Init Error Code 2 N 0 = no error following error fields blank
                '       1 = GTB error
                '       2 = Max Speed error
                '       3 = Train Sheet error
                '       4 = Login error
                '       5 = Data Set error
                '       6 = Time out
                '       7 = Non Comm error
                '       8 = Brake test error
                '       9 = failed Departure Test
                '       10 = Configuration Error
                '       11 = Failed Init
                '24. Init Error Sub Code            1           N           0 = no error
                '25. Init Error Text Length         2           N           Number of bytes in error text following
                '26. Init Error Text Description    *           A           Description of error if possible

                '******************************************************************
                'ACTION ITEMS:
                '1) PARSE THIS MESSAGE TO LOCAL VARIABLES
                '2) FIND A LOCOMOTIVE OBJECT FROM gLocomotiveCollection using FindLocomotive
                '3) ASSIGN MESSAGE VALUES TO OBJECT FROM MESSAGE
                '4) UPDATE THE SYSTEM SUMMARY USING A "New SummaryItem("LOCOMOTIVE", Action, Me)"
                '5) NEW DATA FROM MESSAGE SHOULD BE REFELCTED IN THE LOCOMOTIVE TRACK TAB IN THE SYSTEM SUMMARY
                '******************************************************************

                Dim Symbol As String = Mid(data, 7, 18)
                Dim LocoUID As String = Trim(Mid(data, 25, 10))
                'Dim Loco As MobileTracking.Locomotive = FindLocomotive(LocoUID)
                '41	12/7/2010	 	ETMS turn train different loco, tracking tab info not correct - JARED Requested
                Dim Loco As MobileTracking.Locomotive = FindLocomotive(LocoUID, Symbol)


                Dim InitMode As String = Mid(data, 35, 1)
                Dim LocoApproved As String = Mid(data, 36, 1)
                Dim CrewLogged As String = Mid(data, 37, 1)
                Dim LocoRegistered As String = Mid(data, 38, 1)
                Dim DataSetConfirmed As String = Mid(data, 39, 1)
                Dim InitTimeOut As String = Mid(data, 40, 1)
                Dim InitError As String = Mid(data, 41, 1)
                Dim InitDate As Date = GetDateFromUTC(Mid(data, 43, 14))
                Dim AuthCount As Integer = CInt(Mid(data, 57, 2))
                Dim AuthSentCount As Integer = CInt(Mid(data, 59, 2))
                Dim RestrictionCount As Integer = CInt(Mid(data, 61, 2))
                Dim RestrictionSentCount As Integer = CInt(Mid(data, 63, 2))
                Dim MOWAuthCount As Integer = CInt(Mid(data, 65, 2))
                Dim MOWAuthSentCount As Integer = CInt(Mid(data, 67, 2))
                Dim ConsitsSent As String = Mid(data, 69, 1)
                Dim InitErrorCode As String = Mid(data, 70, 2)

                Dim intInitErrorCode As Integer = 0
                Integer.TryParse(InitErrorCode, intInitErrorCode)
                Select Case intInitErrorCode
                    Case 99, 7
                        TMDS.SystemUtilities.Utilities.SystemEvent("INVALID INIT CODE(" & InitErrorCode & ") DATA:: " & data)
                        Exit Sub
                End Select


                With Loco
                    .isLocoInitMessageRecvd = True
                    .Symbol = Symbol.Trim
                    .LocomotiveID = LocoUID
                    'If CInt(InitErrorCode) = 0 Then
                    '    .LocoInitStatusID = ""
                    'Else
                    .LocoInitStatusID = CInt(InitErrorCode)
                    'End If
                    .rLocoInitStatus = CInt(InitErrorCode)
                End With

                Dim SummItem As New SummaryItem("LOCOMOTIVE", "LOCO-STATUS", Loco)
                SyncLock gLocomotiveSummaryQueue.SyncRoot
                    gLocomotiveSummaryQueue.Enqueue(SummItem)
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Sub ProcessMessageStatus(ByVal data As String)
            Dim authObj As Object = Nothing
            If Not gInitialized Then Exit Sub
            Try

                'Message Delivery Confirmation Status [7004](BOS Dispatcher)
                'This message is used to report confirmation and status of message delivery for a train symbol.
                'ID Field                               Size (Bytes)        Type Value              Description
                '1. Message Type 2 N 70 Status type message
                '2. Message Sub Type 2 N 04 Delivery Confirmation sub-type
                '3. Message Version 2 N 01 message version id
                '4. Message Sequence Number 6 N Unique sequence number used to
                'acknowledge receipt of message
                '5. Type of Status Reporting 2 N 
                '   1 = Track Warrant
                '   2 = TAT
                '   3 = Tag
                '   4 = Authority to enter main track
                '   5 = Authority to pass red signal
                '   6 = Text message (future)
                '   7 = Speed Restriction ( form A)
                '   8 = Work Zone (form B)
                '   9 = Consist
                '   10 = Critical message (future)
                '6. Action 1 A I = status from issue
                '   R = status from release or void
                '   M = status from modify or roll-up
                '   N = new or updated
                '   D = delete - this data item has been deleted()
                '7. Symbol 18 S - train symbol
                '8. Locomotive ID 10 U-Unit message delivered to
                '9. ID Number 6 N Identifying number of item reporting
                '10. ID Date Time Stamp 14 Z
                '11. PTC Confirmation Status 1 N 
                '   1 = confirm receive in PTC server
                '   2 = waiting response
                '   3 = data error
                '   4 = non PTC message
                '   5 = out of comm
                '12. Prompt Dispatcher 1 Y Flag to say to prompt dispatcher for error
                '13. Send Attempt Count 2 N Count of tries to send message
                '14. Last Send Date Time 14 Z Last attempt to send
                '15. Retry Time Limit 4 N 0-9999 seconds-timeout value before prompting dispatcher again
                '16. Text Confirmation Flag 1 Y Flag to indicate if text data delivery is confirmed in this message
                '17. Text Crew Action 1 N Action from crew
                '   1 = no crew action required
                '   2 = crew acknowledge with no response
                '   3 = crew acknowledge with response
                '   4 = crew approval / disapproval
                '18. Text(Acknowledgement Indication 2 N 
                '   0 = no attempt to send
                '   1 = acknowledged-was delivered
                '   2 = nak - crc failure
                '   3 = nak-other reasons
                '   4 = not delivered-out of comm
                '   5 = not delivered-not cut-in
                '   6 = data error
                '   7 = waiting response
                '   9 = non PTC
                '19. Authority Confirmation Flag 1 Y Flag to indicate if authority delivery is confirmed in this message
                '20. Authority Crew Action 1 N Action from crew
                '   1 = no crew action required
                '   2 = crew acknowledge with no response
                '   3 = crew acknowledge with response
                '   4 = crew approval / disapproval
                '21.Authority(Acknowledgement Indication  2 N 
                '   0 = no attempt to send
                '   1 = acknowledged-was delivered
                '   2 = nak - crc failure
                '   3 = nak-other reasons
                '   4 = not delivered-out of comm
                '   5 = not delivered-not cut-in
                '   6 = data error
                '   7 = waiting response
                '   9 = non PTC
                '22.Authority(Activation Confirmation 1 Y
                '' OLD ---- 23. Error Description Length 2 N 0-150 Number of bytes in error description(Message)
                ' NEW  ---- 23. Error Description Length 3 N 0-150 Number of bytes in error description(Message)
                '24. Error Description * A Text describing an error
                '25. Date time Stamp 14 Z YYYYMMDDHHMMSS


                Dim SeqNo As String = Mid(data, 1, 6)
                Dim StatusRep As String = Mid(data, 7, 2)
                Dim Action As String = Trim(Mid(data, 9, 1))
                Dim Symbol As String = Trim(Mid(data, 10, 18))
                Dim LocoUID As String = Trim(Mid(data, 28, 10))
                Dim IDNumber As String = Trim(Mid(data, 38, 10))
                Dim IDDate As String = Trim(Mid(data, 48, 14))
                Dim PTCConfStatus As String = Trim(Mid(data, 62, 1))
                Dim PrompDisp As String = Trim(Mid(data, 63, 1))
                Dim SendAttmpCnt As String = Trim(Mid(data, 64, 2))
                Dim LastSentDate As String = Trim(Mid(data, 66, 14))
                Dim strRetryTimeLimit As String = Trim(Mid(data, 80, 4))
                Dim TextConfFlag As String = Trim(Mid(data, 84, 1))
                Dim TextCrewAction As String = Trim(Mid(data, 85, 1))
                Dim TextAckInd As String = Trim(Mid(data, 86, 2))
                Dim AuthConfFlag As String = Trim(Mid(data, 88, 1))
                Dim AuthCrewAction As String = Trim(Mid(data, 89, 1))
                Dim AuthAckInd As String = Trim(Mid(data, 90, 2))
                Dim AuthActconf As String = Trim(Mid(data, 92, 1))
                Dim ErrDescLen As Integer = 0
                Dim ErrDesc As String = String.Empty
                Dim MsgDatetime As String '= Trim(Mid(data, data.Length - 14, 14))

                Dim TerrCnt As Integer
                Dim TerrID As New ArrayList
                Dim TagType As String = String.Empty
                Dim TagFromMP As String = String.Empty
                Dim TagFromMPMod As String = String.Empty
                Dim TagToMP As String = String.Empty
                Dim TagToMPMod As String = String.Empty

                ErrDescLen = Trim(Mid(data, 93, 3))
                If IsNumeric(ErrDescLen) Then
                    If ErrDescLen > 0 Then
                        ErrDesc = Trim(Mid(data, 96, ErrDescLen))
                    End If
                End If
                Dim pos As Integer = (96 + ErrDescLen)
                MsgDatetime = Trim(Mid(data, pos, 14))
                pos = pos + 14

                TerrCnt = Trim(Mid(data, pos, 2))
                pos = pos + 2

                If IsNumeric(TerrCnt) Then
                    If TerrCnt > 0 Then
                        Dim k As Integer
                        For k = 0 To TerrCnt - 1
                            TerrID.Add(Trim(Mid(data, pos, 3)))
                            pos = pos + 3
                        Next
                    End If
                End If




                Dim PTCStatus As String = "NONE" 'String.Empty
                Dim AuthMsgID As String = String.Empty

                Dim RetryTimeLimit As String = "0"
                Dim RetryTime As Integer = 0
                If Integer.TryParse(strRetryTimeLimit, RetryTime) Then
                    If RetryTime > 0 Then
                        RetryTimeLimit = (RetryTime / 60).ToString
                    End If
                End If

                Dim OKToAlert As Boolean = False
                If Not PrompDisp Is Nothing Then
                    Select Case PrompDisp.Trim.ToUpper
                        Case "Y"
                            OKToAlert = True
                    End Select
                End If


                Dim StatusReporting As Integer = 0
                If Integer.TryParse(StatusRep, StatusReporting) Then
                    If StatusReporting > 0 Then
                        StatusRep = StatusReporting.ToString
                    End If
                End If
                If OKToAlert And StatusRep = 3 Then
                    TagType = Trim(Mid(data, pos, 1))
                    pos = pos + 1

                    TagFromMP = Trim(Mid(data, pos, 8))
                    pos = pos + 8

                    TagFromMPMod = Trim(Mid(data, pos, 1))
                    pos = pos + 1

                    TagToMP = Trim(Mid(data, pos, 8))
                    pos = pos + 8

                    TagToMPMod = Trim(Mid(data, pos, 1))
                    pos = pos + 1
                End If

                TextAckInd = CInt(TextAckInd)
                Select Case TextAckInd
                    Case 1
                        PTCStatus = "TEXT-DELIVERED"
                    Case 2
                        PTCStatus = "TEXT-FAILED CRC"
                    Case 3
                        PTCStatus = "TEXT-FAILED - NAK"
                    Case 4
                        PTCStatus = "NON-COMM"
                    Case 5
                        PTCStatus = "NONE"
                    Case 6
                        PTCStatus = "TEXT DATA ERROR"
                    Case 7
                        PTCStatus = "SENDING TEXT"
                    Case 9
                        PTCStatus = "NONE"
                End Select

                If TextConfFlag.Trim.ToUpper = "Y" Then
                    PTCStatus = "TEXT CONFIRMED"
                End If

                AuthAckInd = CInt(AuthAckInd)
                Select Case AuthAckInd
                    Case 1
                        PTCStatus = "AUTHORITY-DELIVERED"
                    Case 2
                        PTCStatus = "AUTHORITY FAILED CRC"
                    Case 3
                        PTCStatus = "AUTHORITY-FAILED - NAK"
                    Case 4
                        PTCStatus = "NON-COMM"
                    Case 5
                        PTCStatus = "NONE"
                    Case 6
                        PTCStatus = "AUTHORITY DATA ERROR"
                    Case 7
                        PTCStatus = "SENDING AUTHORITY"
                    Case 9
                        PTCStatus = "NONE"
                End Select

                If AuthActconf.Trim.ToUpper = "Y" Then
                    PTCStatus = "AUTHORITY-ACTIVATED"
                End If

                'If PTCStatus.Trim = "" Then
                If CInt(PTCConfStatus.Trim) = 1 And TextConfFlag = "N" And CInt(TextCrewAction) = 1 And CInt(TextAckInd) = 0 And
                AuthConfFlag.Trim = "N" And AuthCrewAction = "1" And CInt(AuthAckInd) = 0 And AuthActconf.Trim = "N" Then
                    PTCStatus = "SENDING"
                End If

                'End If

                'Authority Messages
                If ((StatusRep = 1) Or (StatusRep = 2) Or (StatusRep = 4) Or (StatusRep = 5)) Then
                    Dim authuid As String = ""
                    Try
                        AuthMsgID = IDNumber.Substring(IDNumber.Length - 6)
                        authuid = CInt(Mid(AuthMsgID, 1, 3)) & " - " & CInt(Mid(AuthMsgID, 4, 3))
                    Catch ex As Exception
                    End Try
                    Dim Auth As TrackAuthority.TrackAuthority = TMDS.SystemUtilities.FetchData.FindAuthority(authuid)
                    Dim SFAAuth As TrackAuthority.SFAuthority = TMDS.SystemUtilities.FetchData.FindSFA(authuid)
                    ' commented based on BNSF-27
                    'Dim OthSplAuth As TrackAuthority.OtherSpecialAuthorityType = TMDS.SystemUtilities.FetchData.FindSpecialAuthority(IDNumber)
                    Dim OthSplAuth As TrackAuthority.OtherSpecialAuthorityType = TMDS.SystemUtilities.FetchData.FindSpecialAuthority(IDNumber, Symbol)

                    Dim isTrackPermit As Boolean = False

                    Dim AuthObjType As String = String.Empty

                    'If Not IsNothing(Auth) And PTCStatus <> String.Empty Then
                    If Not IsNothing(Auth) Then
                        authObj = Auth
                        Auth.PTCStatus = PTCStatus
                        Select Case PTCStatus.Trim.ToUpper
                            Case "NONE"
                                Auth.PTCTypeAuthority = False
                            Case Else
                                Auth.PTCTypeAuthority = True
                        End Select


                        Auth.UpdateDatabaseWithPTCAuthorityStatus(PTCStatus)
                        AuthObjType = "TWC"
                        If Mid(Auth.AuthorityType, 1, 2) = "TP" Then
                            isTrackPermit = True
                        End If
                        Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC-STATUS", Auth)
                        SyncLock gSummaryAuthQueue.SyncRoot
                            gSummaryAuthQueue.Enqueue(SummItem)
                        End SyncLock
                    End If

                    'If Not IsNothing(SFAAuth) And PTCStatus <> String.Empty Then
                    If Not IsNothing(SFAAuth) Then
                        AuthObjType = "SFA"
                        authObj = SFAAuth
                        SFAAuth.PTCStatus = PTCStatus
                        Select Case PTCStatus.Trim.ToUpper
                            Case "NONE"
                                SFAAuth.PTCTypeAuthority = False
                            Case Else
                                SFAAuth.PTCTypeAuthority = True
                        End Select
                        'SFAAuth.PTCTypeAuthority = True
                        SFAAuth.UpdateDatabaseWithPTCAuthorityStatus(PTCStatus)
                        Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC-STATUS", SFAAuth)
                        SyncLock gSummaryAuthQueue.SyncRoot
                            gSummaryAuthQueue.Enqueue(SummItem)
                        End SyncLock
                    End If

                    'If Not IsNothing(OthSplAuth) And PTCStatus <> String.Empty Then
                    If Not IsNothing(OthSplAuth) Then
                        AuthObjType = "SPL"
                        authObj = OthSplAuth
                        OthSplAuth.PTCStatus = PTCStatus
                        Select Case PTCStatus.Trim.ToUpper
                            Case "NONE"
                                OthSplAuth.PTCTypeAuthority = False
                            Case Else
                                OthSplAuth.PTCTypeAuthority = True
                        End Select
                        'OthSplAuth.PTCTypeAuthority = True
                        OthSplAuth.UpdateDatabaseWithPTCAuthorityStatus(PTCStatus)
                        Dim SummItem As New SummaryItem("SPLAUTHORITY", "UPDATE-PTC-STATUS", OthSplAuth)
                        SyncLock gSummaryAuthQueue.SyncRoot
                            gSummaryAuthQueue.Enqueue(SummItem)
                        End SyncLock
                    End If

                    Dim TrkLnAlertData As String = String.Empty
                    Dim AlertTabData As String = String.Empty
                    Dim ResendAction As String = String.Empty

                    Action = Action.Trim.ToUpper
                    If OKToAlert Then
                        If StatusRep = 1 And Action = "I" Then
                            TrkLnAlertData = LocoUID & " PTC TRACK WARRANT DELIVERY FAILURE"
                            AlertTabData = "TRACK WARRANT [] NOT DELIVERED TO PTC"
                            ResendAction = "DELIVERY"
                        ElseIf StatusRep = 1 And Action = "R" Then
                            TrkLnAlertData = LocoUID & " PTC TRACK WARRANT REPORT CLEAR FAILURE"
                            AlertTabData = "TRACK WARRANT [] NOT REPORTED CLEAR BY PTC"
                            ResendAction = "REPORTCLEAR"
                        ElseIf StatusRep = 1 And Action = "M" Then
                            TrkLnAlertData = LocoUID & " PTC TRACK WARRANT ROLL-UP FAILURE"
                            AlertTabData = "TRACK WARRANT [] NOT ROLLED UP BY PTC"
                            ResendAction = "ROLLUP"
                        ElseIf StatusRep = 2 And Action = "I" Then
                            TrkLnAlertData = LocoUID & " PTC TAT/TP DELIVERY FAILURE"
                            If isTrackPermit Then
                                AlertTabData = "TRACK PERMIT [] NOT DELIVERED TO PTC"
                            Else
                                AlertTabData = "TRACK AND TIME [] NOT DELIVERED TO PTC"
                            End If
                            ResendAction = "DELIVERY"
                        ElseIf StatusRep = 2 And Action = "R" Then
                            TrkLnAlertData = LocoUID & " PTC TAT/TP REPORT CLEAR FAILURE"
                            If isTrackPermit Then
                                AlertTabData = "TRACK PERMIT [] NOT REPORTED CLEAR BY PTC"
                            Else
                                AlertTabData = "TRACK AND TIME [] NOT REPORTED CLEAR BY PTC"
                            End If
                            ResendAction = "REPORTCLEAR"
                        ElseIf StatusRep = 2 And Action = "M" Then
                            TrkLnAlertData = LocoUID & " PTC TAT/TP MODIFY FAILURE"
                            If isTrackPermit Then
                                AlertTabData = "TRACK PERMIT [] NOT MODIFIED TO PTC"
                            Else
                                AlertTabData = "TRACK AND TIME [] NOT MODIFIED TO PTC"
                            End If
                            ResendAction = "MODIFY"

                        ElseIf StatusRep = 4 And Action = "I" Then
                            TrkLnAlertData = LocoUID & " PTC ENTER SIGNALED TRACK AUTHORITY FAILURE"
                            AlertTabData = "ENTER SIGNALED TRACK AUTHORITY NOT DELIVERED TO PTC"
                            ResendAction = "DELIVERY"

                        ElseIf StatusRep = 4 And Action = "R" Then
                            If Not authObj Is Nothing Then
                                If authObj.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.PENDINGRELEASE.ToString Then
                                    If OKToAlert Then
                                        'TrkLnAlertData = LocoUID & " ENTER SIGNALED TRACK REVOKE NOT DELIVERED TO PTC"
                                        'AlertTabData = LocoUID & " ENTER SIGNALED TRACK REVOKE NOT DELIVERED TO PTC"
                                        TrkLnAlertData = LocoUID & " PTC ENTER SIGNALED TRACK REVOKE FAILURE"
                                        AlertTabData = "ENTER SIGNALED TRACK REVOKE NOT DELIVERED TO PTC"
                                        ResendAction = "DELIVERY"
                                    Else
                                        TrkLnAlertData = String.Empty
                                    End If
                                End If
                            End If

                        ElseIf StatusRep = 5 And Action = "I" Then
                            TrkLnAlertData = LocoUID & " PTC PASS STOP SIGNAL AUTHORITY FAILURE"
                            AlertTabData = "PASS STOP SIGNAL PERMISSION/AUTHORITY NOT DELIVERED TO PTC"
                            ResendAction = "DELIVERY"

                        ElseIf StatusRep = 5 And Action = "R" Then
                            If Not authObj Is Nothing Then
                                If authObj.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.PENDINGRELEASE.ToString Then
                                    If OKToAlert Then
                                        'TrkLnAlertData = LocoUID & " PASS STOP SIGNAL REVOKE NOT DELIVERED TO PTC"
                                        'AlertTabData = LocoUID & " PASS STOP SIGNAL REVOKE NOT DELIVERED TO PTC"

                                        TrkLnAlertData = LocoUID & " PTC PASS STOP SIGNAL REVOKE FAILURE"
                                        AlertTabData = "PASS STOP SIGNAL REVOKE NOT DELIVERED TO PTC"
                                        ResendAction = "DELIVERY"
                                    Else
                                        TrkLnAlertData = String.Empty
                                    End If
                                End If
                            End If
                        End If

                        If Not IsNothing(authObj) Then
                            If TrkLnAlertData.Trim <> String.Empty Then
                                optSystemAlertMessagePTC = TrkLnAlertData
                                AlertTabData = AlertTabData.Replace("[]", authObj.authorityuid)
                                AlertTabData = AlertTabData & "|" & AuthObjType & "|" & ResendAction & "|" & authObj.issueto & "|" & PrompDisp & "|" & RetryTimeLimit & "|" & StatusRep & "|" & Action & "|" & AuthMsgID & "|" & SeqNo & "|" & Symbol & "|" & LocoUID
                                'AlertTabData = AlertTabData & "|" & AuthObjType & "|" & ResendAction & "|" & authObj.issueto & "|" & PrompDisp & "|" & SendAttmpCnt & "|" & StatusRep & "|" & Action & "|" & AuthMsgID & "|" & SeqNo & "|" & Symbol & "|" & LocoUID
                                'Dim ExistingAlert As Alert = TMDS.SystemUtilities.FetchData.FindAlertByObjectUId(authObj.authorityuid)
                                'Dim al As Alert

                                'If Not IsNothing(ExistingAlert) Then
                                '    al = ExistingAlert
                                'Else
                                '    al = New Alert(Alert.AlertType.PTC7004Authority, AlertTabData, Nothing, authObj)
                                'End If
                                Dim al As Alert = New Alert(Alert.AlertType.PTC7004Authority, AlertTabData, Nothing, authObj)
                                If Not IsNothing(al) Then
                                    al.AlertObjectUID = authObj.AuthorityUID
                                    al.AlertTime = Now
                                    SyncLock TMDS.GlobalDeclarations.gSystemAlertQueue.SyncRoot
                                        TMDS.GlobalDeclarations.gSystemAlertQueue.Enqueue(al)
                                    End SyncLock
                                End If
                            End If
                        End If
                    End If
                End If

                'Tag Messages
                If (StatusRep = 3) And OKToAlert Then
                    Dim strMP As String = " BETWEEN MP " & TagFromMP & " " & TagFromMPMod & " AND " & " MP " & TagToMP & " " & TagToMPMod
                    Select Case TagType.Trim.ToUpper
                        Case "T"
                            If TagFromMP <> String.Empty Then
                                TagFromMP = CStr(Truncate(CDbl(TagFromMP), 1))
                            End If
                            If TagToMP <> String.Empty Then
                                TagToMP = CStr(Truncate(CDbl(TagToMP), 1))
                            End If
                            strMP = " MP " & TagFromMP & TagFromMPMod & " TO " & " MP " & TagToMP & TagToMPMod
                        Case "X"
                            If TagFromMP <> String.Empty Then
                                TagFromMP = CStr(Truncate(CDbl(TagFromMP), 2))
                            End If
                            strMP = " MP " & TagFromMP & TagFromMPMod
                    End Select

                    Dim AlertData As String = String.Empty
                    Dim AlertTabData As String = String.Empty
                    Dim ResendAction As String = String.Empty

                    If Action = "I" Or Action = "M" Then
                        AlertData = LocoUID & " PTC TRACK TAG DELIVERY FAILURE"
                        Select Case TagType.Trim.ToUpper
                            Case "T"
                                AlertTabData = "SPEED TRACK TAG [] NOT DELIVERED TO PTC"
                            Case "X"
                                AlertTabData = "CROSSING TRACK TAG MP [] NOT DELIVERED TO PTC"
                        End Select
                        ResendAction = "DELIVERY"
                    ElseIf Action = "R" Then
                        AlertData = LocoUID & " PTC TRACK TAG REMOVE FAILURE"
                        AlertTabData = "TRACK TAG [] NOT REMOVED BY PTC"
                        Select Case TagType.Trim.ToUpper
                            Case "T"
                                AlertTabData = "SPEED TRACK TAG [] NOT REMOVED BY PTC"
                            Case "X"
                                AlertTabData = "CROSSING TRACK TAG [] NOT REMOVED BY PTC"
                        End Select
                        ResendAction = "REMOVE"
                    End If
                    AlertTabData = AlertTabData.Replace("[]", strMP)
                    AlertTabData = AlertTabData & "|" & SeqNo & "|" & "TAG" & "|" & Action & "|" & Symbol & "|" & LocoUID & "|" & IDNumber & "|" & IDDate & "|" & ResendAction & "|" & SendAttmpCnt.Trim & "|" & RetryTimeLimit
                    optSystemAlertMessagePTC = AlertData
                    If AlertTabData.Trim <> String.Empty Then
                        Dim al As New Alert(Alert.AlertType.PTC7004Tag, AlertTabData, Nothing, Nothing)
                        If Not IsNothing(al) Then
                            al.AlertObjectUID = IDNumber
                            al.AlertTime = Now
                            SyncLock TMDS.GlobalDeclarations.gSystemAlertQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSystemAlertQueue.Enqueue(al)
                            End SyncLock
                        End If
                    End If

                    ''COMMENTED DUE TO CHANGE IN ICD VERSION 2.6
                    ''Dim LMilePost As Decimal
                    ''Dim RMilePost As Decimal
                    ''Dim tg As Tag = TMDS.SystemUtilities.FetchData.FindTagByPTCFormat(IDNumber)

                    ''If Not IsNothing(tg) Then
                    ''    Dim TagString() As String
                    ''    TagString = tg.DataString.Split("|")
                    ''    Dim tagTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(tg.TrackGuid)
                    ''    If Not IsNothing(tagTrack) Then
                    ''        LMilePost = TagString(1)
                    ''        RMilePost = TagString(2)
                    ''        Dim strMP As String = " BETWEEN MP " & LMilePost & " AND " & " MP " & RMilePost

                    ''        Select Case tg.TagType.Trim.ToUpper
                    ''            Case "SPEED"
                    ''                strMP = " MP " & LMilePost & " TO " & " MP " & RMilePost
                    ''            Case "XING"
                    ''                'AlertTabData = "CROSSING TRACK TAG [] NOT REMOVED BY PTC"
                    ''                strMP = " MP " & LMilePost
                    ''        End Select


                    ''        Dim AlertData As String = String.Empty
                    ''        Dim AlertTabData As String = String.Empty
                    ''        Dim ResendAction As String = String.Empty

                    ''        If StatusRep = 3 And Action = "I" Then
                    ''            AlertData = LocoUID & " PTC TRACK TAG DELIVERY FAILURE"
                    ''            Select Case tg.TagType.Trim.ToUpper
                    ''                Case "SPEED"
                    ''                    AlertTabData = "SPEED TRACK TAG [] NOT DELIVERED TO PTC"
                    ''                Case "XING"
                    ''                    AlertTabData = "CROSSING TRACK TAG MP [] NOT DELIVERED TO PTC"
                    ''            End Select

                    ''            'CROSSING TRACK TAG MP YYYY.YY NOT DELIVERED TO PTC
                    ''            ResendAction = "DELIVERY"
                    ''        ElseIf StatusRep = 3 And Action = "R" Then
                    ''            AlertData = LocoUID & " PTC TRACK TAG REMOVE FAILURE"
                    ''            AlertTabData = "TRACK TAG [] NOT REMOVED BY PTC"
                    ''            'CROSSING TRACK TAG MP YYYY.YY NOT REMOVED BY PTC
                    ''            Select Case tg.TagType.Trim.ToUpper
                    ''                Case "SPEED"
                    ''                    AlertTabData = "TRACK TAG [] NOT REMOVED BY PTC"
                    ''                Case "XING"
                    ''                    AlertTabData = "CROSSING TRACK TAG [] NOT REMOVED BY PTC"
                    ''            End Select
                    ''            ResendAction = "REMOVE"
                    ''        End If
                    ''        'Select Case tg.TagType.Trim.ToUpper
                    ''        '    Case "SPEED"
                    ''        '        AlertTabData = "TRACK TAG [] NOT REMOVED BY PTC"
                    ''        '    Case "XING"
                    ''        '        AlertTabData = "CROSSING TRACK TAG [] NOT REMOVED BY PTC"
                    ''        'End Select


                    ''        AlertTabData = AlertTabData.Replace("[]", strMP)

                    ''        AlertTabData = AlertTabData & "|" & SeqNo & "|" & "TAG" & "|" & Action & "|" & Symbol & "|" & LocoUID & "|" & IDNumber & "|" & IDDate & "|" & ResendAction & "|" & SendAttmpCnt.Trim & "|" & RetryTimeLimit

                    ''        optSystemAlertMessagePTC = AlertData
                    ''        If AlertTabData.Trim <> String.Empty Then
                    ''            Dim al As New Alert(Alert.AlertType.PTC7004Tag, AlertTabData, Nothing, tg)
                    ''            If Not IsNothing(al) Then
                    ''                al.AlertObjectUID = tg.TagGuid
                    ''                al.AlertTime = Now
                    ''                SyncLock TMDS.GlobalDeclarations.gSystemAlertQueue.SyncRoot
                    ''                    TMDS.GlobalDeclarations.gSystemAlertQueue.Enqueue(al)
                    ''                End SyncLock
                    ''            End If
                    ''        End If
                    ''    Else

                    ''    End If
                    ''End If
                End If

                'FORMA ALERT ONLY
                If (StatusRep = 7) And OKToAlert Then
                    Dim AlertData As String = String.Empty
                    Dim AlertTabData As String = String.Empty
                    AuthMsgID = IDNumber
                    Dim ResendAction As String = String.Empty

                    If Action = "I" Then
                        ResendAction = "DELIVERY"
                        AlertData = LocoUID & " PTC FORM A RESTRICTION DELIVERY FAILURE"
                        'AlertTabData = "PTC FORM A RESTRICTION DELIVERY FAILURE"


                        AlertTabData = "RESTRICTION " & AuthMsgID.TrimStart("0") & " NOT DELIVERED TO PTC"
                        AlertTabData = AlertTabData & "|" & SeqNo & "|" & "FORMA" & "|" & Action & "|" & Symbol & "|" & LocoUID & "|" & AuthMsgID & "|" & IDDate & "|" & ResendAction & "|" & SendAttmpCnt.Trim & "|" & RetryTimeLimit

                    ElseIf Action = "R" Then
                        ResendAction = "REPORTCLEAR"
                        AlertData = LocoUID & " PTC FORM A RESTRICTION VOID FAILURE"
                        'AlertTabData = "PTC FORM A RESTRICTION VOID FAILURE"


                        AlertTabData = "RESTRICTION " & AuthMsgID.TrimStart("0") & " NOT VOIDED BY PTC"
                        AlertTabData = AlertTabData & "|" & SeqNo & "|" & "FORMA" & "|" & Action & "|" & Symbol & "|" & LocoUID & "|" & AuthMsgID & "|" & IDDate & "|" & ResendAction & "|" & SendAttmpCnt.Trim & "|" & RetryTimeLimit
                    End If
                    optSystemAlertMessagePTC = AlertData
                    If AlertTabData.Trim <> String.Empty Then
                        Dim al As New Alert(Alert.AlertType.PTC7004FormAB, AlertTabData, Nothing, Nothing)
                        If Not IsNothing(al) Then
                            al.AlertObjectUID = System.Guid.NewGuid.ToString
                            al.AlertTime = Now
                            SyncLock TMDS.GlobalDeclarations.gSystemAlertQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSystemAlertQueue.Enqueue(al)
                            End SyncLock
                        End If
                    End If
                End If

                'FORMB ALERT ONLY
                If (StatusRep = 8) And OKToAlert Then
                    Dim AlertData As String = String.Empty
                    Dim AlertTabData As String = String.Empty
                    AuthMsgID = IDNumber
                    Dim ResendAction As String = String.Empty

                    If Action = "I" Then
                        ResendAction = "DELIVERY"
                        AlertData = LocoUID & "  PTC FORM B RESTRICTION DELIVERY FAILURE"
                        'AlertTabData = "PTC FORM A RESTRICTION DELIVERY FAILURE"


                        AlertTabData = "RESTRICTION " & AuthMsgID.TrimStart("0") & " NOT DELIVERED TO PTC"
                        AlertTabData = AlertTabData & "|" & SeqNo & "|" & "FORMB" & "|" & Action & "|" & Symbol & "|" & LocoUID & "|" & AuthMsgID & "|" & IDDate & "|" & ResendAction & "|" & SendAttmpCnt.Trim & "|" & RetryTimeLimit

                    ElseIf Action = "R" Then
                        ResendAction = "REPORTCLEAR"
                        AlertData = LocoUID & "  PTC FORM B RESTRICTION VOID FAILURE"
                        'AlertTabData = "PTC FORM A RESTRICTION VOID FAILURE"


                        AlertTabData = "RESTRICTION " & AuthMsgID.TrimStart("0") & "  NOT VOIDED BY PTC"
                        AlertTabData = AlertTabData & "|" & SeqNo & "|" & "FORMB" & "|" & Action & "|" & Symbol & "|" & LocoUID & "|" & AuthMsgID & "|" & IDDate & "|" & ResendAction & "|" & SendAttmpCnt.Trim & "|" & RetryTimeLimit
                    End If
                    optSystemAlertMessagePTC = AlertData
                    If AlertTabData.Trim <> String.Empty Then
                        Dim al As New Alert(Alert.AlertType.PTC7004FormAB, AlertTabData, Nothing, Nothing)
                        If Not IsNothing(al) Then
                            al.AlertObjectUID = System.Guid.NewGuid.ToString
                            al.AlertTime = Now
                            SyncLock TMDS.GlobalDeclarations.gSystemAlertQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSystemAlertQueue.Enqueue(al)
                            End SyncLock
                        End If
                    End If
                End If


                'Other Messages -  Consist and Text
                If (StatusRep = 6 Or StatusRep = 9 Or StatusRep = 10) Then

                End If

                'Stop Flashing Authority if the condtions are met.
                'If AuthConfFlag.Trim.ToUpper = "Y" And (Action.Trim.ToUpper = "R" Or Action.Trim.ToUpper = "M") Then
                If AuthConfFlag.Trim.ToUpper = "Y" And (Action.Trim.ToUpper = "R") Then
                    If Not authObj Is Nothing Then
                        Select Case authObj.GetType.ToString
                            Case gSFAComponentName, gTTComponentName
                                If authObj.PTCAuthorityACKPending.Trim <> "" Then
                                    authObj.FlasherMode(False, True)
                                End If
                            Case gOtherSplAuthorityName

                        End Select
                    End If
                End If

                If AuthConfFlag.Trim.ToUpper = "N" And Action.Trim.ToUpper = "R" And Symbol.Trim = String.Empty And LocoUID.Trim = String.Empty Then
                    If Not authObj Is Nothing Then
                        Select Case authObj.GetType.ToString
                            Case gSFAComponentName, gTTComponentName
                                If authObj.PTCAuthorityACKPending.Trim <> "" Then
                                    authObj.FlasherMode(False, True)
                                End If
                        End Select
                    End If
                End If

                Dim AuthActivationConf As Boolean = False
                If AuthActconf.Trim.ToUpper = "Y" Then
                    AuthActivationConf = True
                End If

                If Not authObj Is Nothing Then
                    Select Case authObj.GetType.ToString
                        Case gOtherSplAuthorityName
                            If (AuthConfFlag.Trim.ToUpper = "Y") Or (CInt(AuthAckInd) = 5) Then
                                If authObj.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.PENDINGRELEASE.ToString Then
                                    authObj.FlasherMode(False, True)
                                    authObj.DoPSSPerformRelease()
                                End If
                            End If
                        Case gSFAComponentName
                            If (AuthConfFlag.Trim.ToUpper = "Y") And (Action.Trim.ToUpper = "M") And AuthActivationConf Then
                                If authObj.PTCAuthorityACKPending.Trim = PTCAuthorityACKPendingStatus.ROLLUP.ToString Then
                                    authObj.FlasherMode(False, True)
                                    authObj.PTCAuthorityACKPending = ""
                                End If
                            End If
                    End Select
                End If



            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                authObj = Nothing
            End Try
        End Sub

