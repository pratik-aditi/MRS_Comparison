        Public Sub RemoveTrain(ByVal TrainName As String, Optional ByVal terrID As Integer = 0)
            Dim trn, TrainToDelete As TrainID
            Dim TrainToRemove As TrainID = Nothing
            Dim trk As TMDS.TrackComponents.Track

            Try

                'If PlayBackMode Then Exit Sub
                Dim TrainList As New ArrayList()

                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.Name = TrainName Then
                        If optEnableTerritoryDeskAssignmentMode Then
                            If Not IsNothing(trn.myTrack) AndAlso trn.myTrack.IsControlled Then Exit Sub
                        End If

                        trk = Me.FindTrackWithTrain(CInt(trn.TrackGUID), trn.TrainGUID)
                        If trk.TerritoryID <> terrID Then
                            LogEvent("TRAIN NOT FOUND IN SAME TERRITORY:" & trn.Name & "-TRACKGUID:" & trn.TrackGUID)
                            Exit Sub
                        End If
                        trn.ReleaseTrainAbbreviation(gTrainAbbreviation)
                        trk.TrainIDs.Remove(trn)
                        trk.InvalidateTrainID()
                        trk.InitTrainDisplay()
                        trk.InvalidateTrainID()
                        trk.UpdateStatus()
                        'TrainToDelete = trn
                        TrainList.Add(trn)
                        'Exit For
                        If Not trk.Indicating And trk.TrainIDs.Count = 0 Then
                            trk.Occuppied = False
                            trk.UpdateStatus()

                            If Not trk.OsComponentCollection Is Nothing Then 'ARRC-1098
                                For Each comp As Object In trk.OsComponentCollection
                                    comp.Occuppied = False
                                    comp.UpdateStatus()
                                Next

                            End If
                        End If
                        TrainToRemove = trn
                    End If
                Next

                Dim SummItem As New SummaryItem("TRAIN", "RELEASE", TrainToRemove)
                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                End SyncLock
                'cschock: ARRC-1452 Force the refresh so train is removed from summary on train release message.
                Try
                    Dim SummItemRefresh As New SummaryItem("TRAIN", "FORCE-REFRESH", TrainToRemove)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItemRefresh)
                    End SyncLock
                Catch ex As Exception
                End Try


                For Each TrainToDelete In TrainList
                    If Not TrainToDelete Is Nothing Then
                        TrainCollection.Remove(TrainToDelete)
                    End If
                Next
                TrainList = Nothing
                'Message = Message & "|" & Me.TrackGUID
                'Message = Message & "|" & Me.Name
                'Message = Message & "|" & Me.Direction
                'Message = Message & "|" & Me.IdentifingUnit
                'Message = Message & "|" & Me.EngName
                'Message = Message & "|" & Me.EngOnDuty
                'Message = Message & "|" & Me.CondName
                'Message = Message & "|" & Me.CondOnDuty
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub FindPreviousTrack(ByVal TrainName As String, ByVal CurrentTrackGuid As Int32)
            Try
                Dim trk As TMDS.TrackComponents.Track
                For Each trk In TMDS.GlobalDeclarations.TrackCollection
                    If trk.GUID <> CurrentTrackGuid Then
                        If trk.TrainIDs.Count <> 0 Then
                            Dim trn As TrainID = Nothing
                            Dim TrnList As ArrayList = Nothing
                            For Each trn In trk.TrainIDs
                                If trn.Name = TrainName Then
                                    TrnList = trk.TrainIDs.Clone
                                    Exit For
                                End If
                            Next
                            If Not IsNothing(TrnList) Then
                                trk.TrainIDs.Remove(trn)
                                trk.InitTrainDisplay()
                                trk.InvalidateTrainID()
                                LogEvent("FindPreviousTrack:" & TrainName & " ON " & CurrentTrackGuid.ToString & " FOUND.")
                                Exit Sub
                            End If
                        End If
                    End If
                Next
                LogEvent("FindPreviousTrack:" & TrainName & " ON " & CurrentTrackGuid.ToString & " not found")


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindNote(ByVal noteGuid As String) As TMDS.GraphicComponent.Annotation
            Try
                Dim note As TMDS.GraphicComponent.Annotation
                For Each note In TMDS.GlobalDeclarations.Notes
                    If Trim(note.NoteGUID) = Trim(noteGuid) Then
                        Return note
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Shared Sub LogEvent(ByVal statusMessage As String)
            Try
                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.InformationEvent, statusMessage, SystemEventQueue)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub TrainUpdateInformation(ByVal data As String, Optional ByVal ShadowMode As Boolean = False)
            Try
                Dim datastring() As String = data.Split("|")

                If datastring.Length >= 18 Then
                    Dim trn As TrainID = Me.FindTrain(datastring(4))
                    If Not IsNothing(trn) Then
                        If optEnableTerritoryDeskAssignmentMode Then
                            If Not IsNothing(trn.myTrack) AndAlso trn.myTrack.IsControlled Then Exit Sub
                        End If

                        trn.CrewCurrent.Engineer.HOS = datastring(12)
                        trn.CrewCurrent.Conductor.HOS = datastring(13)
                        trn.HorsePowerTrailing = datastring(14)
                        trn.ScheduleStatus = datastring(15).Replace("!", "|")
                        trn.TrainScheduleUpdate()
                        trn.LastOS = datastring(16)
                        trn.OLength = CInt(datastring(17))
                        Try
                            trn.OLoads = CInt(datastring(18))
                            trn.OEmts = CInt(datastring(19))
                            trn.OTons = CInt(datastring(20))
                            trn.OLength = CInt(datastring(21))
                            trn.HazMat = CBool(datastring(23))
                            trn.HighWide = CBool(datastring(22))
                            trn.KeyTrain = CBool(datastring(24))
                            Try
                                trn.PseudoName = datastring(25)
                            Catch
                            End Try

                        Catch
                        End Try
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindTrain(ByVal TrainName As String) As TrainID
            Try
                Dim trn As TrainID
                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.Name = TrainName Then
                        Return trn
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function AddTrainToLists(ByVal trn As TrainID) As Boolean
            Dim trnToCheck As TrainID
            Try

                'If PlayBackMode Then Exit Function
                Dim TrainFound As Boolean
                For Each trnToCheck In TMDS.GlobalDeclarations.TrainCollection
                    If trnToCheck.Name = trn.Name Or trnToCheck.TrainGUID = trn.TrainGUID Then
                        LogEvent("AddTrainToLists-TRAIN FOUND IN myTrains, NOT ADDED:" & trn.Name)
                        TrainFound = True
                    End If
                Next

                If Not TrainFound Then
                    LogEvent("AddTrainToLists-TRAIN ADDED TO myTrains:" & trn.Name)
                    TMDS.GlobalDeclarations.TrainCollection.Add(trn)
                End If
                Dim TrainFoundInCollection As Boolean
                For Each trnToCheck In TrainCollection
                    If trnToCheck.Name = trn.Name Or trnToCheck.TrainGUID = trn.TrainGUID Then
                        LogEvent("AddTrainToLists-TRAIN FOUND IN TrainCollection, NOT ADDED:" & trn.Name)
                        TrainFoundInCollection = True
                    End If
                Next
                If Not TrainFoundInCollection Then
                    LogEvent("AddTrainToLists-TRAIN ADDED TO TrainCollection:" & trn.Name)
                    TrainCollection.Add(trn)
                End If
                If Not TrainFound Then
                    Return True
                Else
                    Return False
                End If
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

#Region "SFA"

        Public Sub AddSFANew(ByVal AuthorityUID As String, ByVal AuthorityDate As String,
                             ByVal DispatcherName As String, ByVal IssueTo As String,
                             ByVal JointStatus As Boolean, ByVal UntilTime As String,
                             ByVal Components As String, ByVal AuthType As String,
                             ByVal Direction As String, ByVal CheckBoxString As String,
                             ByVal spare3 As String, ByVal AuthorityLimits As String)
            Try
                'If optEnableTerritoryDeskAssignmentMode Then
                '    If Not CheckForShadowMode(Components) Then Exit Sub
                'End If
                Dim AuthToCheck As Object
                Dim auth As New TMDS.TrackAuthority.SFAuthority()

                auth.AuthorityUID = AuthorityUID
                auth.AuthDate = CDate(AuthorityDate)
                auth.AuthorityVerbiage = AuthorityLimits
                auth.DispName = DispatcherName
                auth.Direction = Direction
                auth.IssueTo = IssueTo
                auth.JointAuthority = JointStatus
                auth.Box10ClearBy = CDate(UntilTime)
                auth.AuthType1 = AuthType
                auth.TerrID1 = Me.TerritoryID
                Select Case AuthType
                    Case "ItemTwoToTrain", "ItemTwoFiveToTrain", "ItemFourToTrain", "ItemFourToTrainWithItem8"
                        auth.IssuedToTrain = True
                        Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(Mid(IssueTo, 1, 10))
                        If trn IsNot Nothing Then auth.TrainSymbol = trn.Name
                End Select
                Dim GUIDs() As String = Components.Split("-")
                Dim strGUID As String
                For Each strGUID In GUIDs
                    If IsNumeric(strGUID) Then
                        Dim compToBlock As Object = FindComponent(CInt(strGUID))
                        If Not compToBlock Is Nothing Then
                            auth.Components.Add(compToBlock)
                        End If
                    End If
                Next

                Dim CheckBoxes() As String = CheckBoxString.Split("-")
                Dim bx As String
                For Each bx In CheckBoxes
                    If bx = "1" Then
                        auth.CheckBoxItemsStatus.Add(True)
                    Else
                        auth.CheckBoxItemsStatus.Add(False)
                    End If
                Next
                For Each AuthToCheck In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If AuthToCheck.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        If auth.AuthorityUID = AuthToCheck.AuthorityUID Then
                            Exit Sub
                        End If
                    End If
                Next
                If Not TMDS.GlobalDeclarations.OtherTrackAuthorities.Contains(auth) Then TMDS.GlobalDeclarations.OtherTrackAuthorities.Add(auth)


                Dim comp As Object
                For Each comp In auth.Components
                    If Not comp.TrackAuthorities.Contains(auth) Then comp.TrackAuthorities.Add(auth)

                    If gDisplayTrackAuthorityNumbers Then
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(comp, Track)
                            trk.InitAuthorityNumbers()
                        End If
                    End If

                    comp.UpdateStatus()
                Next
                Dim SummItem As New SummaryItem("AUTHORITY", "REFRESH", Nothing)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

