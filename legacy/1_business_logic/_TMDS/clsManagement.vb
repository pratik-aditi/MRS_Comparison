        Public Sub AcknowledgeTrackZoneAlertFromOS(ByVal trn As TrainID, ByVal thisTrk As Track)
            Dim al As Alert
            'tz.ZoneName & "|" & tz.ZoneUID.ToString & "|" & BeginLimit & " TO " & EndLimit & "|" & auth.IssueTo & "|" & auth.AuthorityUID
            Dim ZonesToOverride As New ArrayList
            Dim auth As SFAuthority
            Dim myAuth As SFAuthority = Nothing
            Try

                For Each auth In thisTrk.TrackAuthorities
                    If auth.TrainSymbol = trn.Name Then
                        myAuth = auth
                        Exit For
                    End If
                Next
                If IsNothing(myAuth) Then
                    Exit Sub
                Else
                    If myAuth.AuthType1 <> "ItemTwoToTrain" Then
                        Exit Sub
                    End If
                End If

                Dim comp As Object
                Dim StopInspectingZones As Boolean

                For Each comp In myAuth.Components
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim trk As Track = CType(comp, Track)
                        If trk Is thisTrk Then
                            StopInspectingZones = True
                        End If

                        If Not StopInspectingZones Then
                            If Not trk.TrackZoneReference Is Me Then
                                If Not ZonesToOverride.Contains(trk.TrackZoneReference) Then
                                    ZonesToOverride.Add(trk.TrackZoneReference)
                                End If
                            End If
                        End If
                    End If
                Next
                'tz.ZoneName & "|" & tz.ZoneUID.ToString & "|" & BeginLimit & " TO " & EndLimit & "|" & auth.IssueTo & "|" & auth.AuthorityUID

                Dim tz As TrackZone
                For Each tz In ZonesToOverride
                    tz.PerformTrackZoneOverride(myAuth)


                    Dim RemoveList As New ArrayList
                    SyncLock TMDS.GlobalDeclarations.gSystemAlertList
                        For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                            Select Case al.TypeOfAlert
                                Case ManagementClasses.Alert.AlertType.TrackZone
                                    Dim data() As String = al.AlertData.Split("|")
                                    If data.Length >= 5 Then
                                        If data(0) = tz.ZoneName And data(4) = myAuth.AuthorityUID Then
                                            al.AlertAcknowledged = True
                                            Dim Message As String = "TIWS ALERT WAS ACKNOWLEDGED BY SYSTEM SUMMARY ACKNOWLEDGMENT FOR TRACK ZONE: " & tz.ZoneName & " FOR AUTHORITY:" & myAuth.AuthorityUID
                                            al.AlertAckedByPerson = Message
                                            TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                                            gSystemAlertExists = False
                                            Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al.AlertGUID)
                                            SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                                TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                            End SyncLock
                                            RemoveList.Add(al)

                                        End If
                                    End If
                                Case Alert.AlertType.FoulingPoint
                                    Dim data() As String = al.AlertData.Split("|")
                                    If data.Length >= 5 Then
                                        'Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(al.AlertObject)

                                        If data(1) & "-FOULING" = tz.ZoneName Then
                                            al.AlertAcknowledged = True
                                            Dim Message As String = "TIWS ALERT WAS ACKNOWLEDGED BY SYSTEM SUMMARY ACKNOWLEDGMENT FOR FOULING TRACK: " & tz.ZoneName & " FOR AUTHORITY:" & myAuth.AuthorityUID
                                            al.AlertAckedByPerson = Message
                                            TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                                            gSystemAlertExists = False
                                            Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al.AlertGUID)
                                            SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                                TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                            End SyncLock
                                            RemoveList.Add(al)

                                        End If
                                    End If

                            End Select
                        Next
                        For Each al In RemoveList
                            TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                        Next
                    End SyncLock
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
