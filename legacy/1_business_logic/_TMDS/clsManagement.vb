                            Dim UnitIDTrimmed As String = String.Empty

                            If TrainFound.IdentifingUnit <> "" Then
                                IdentifingUnitTrimmed = TrainFound.IdentifingUnit.Replace(" ", "")
                            End If
                            If UnitID <> "" Then
                                UnitIDTrimmed = UnitID.Replace(" ", "")
                            End If
                            If IdentifingUnitTrimmed <> UnitIDTrimmed Then
                                UnitChanges = True
                            End If
                            Exit For
                        End If
                    Next

                    If Not TrainFound Is Nothing Then
                        If TrainFound.IdentifingUnit = UnitID Then
                            Response = Symbol.PadRight(18, " ") & "Y"
                            TMDS.NetworkMessages.CadMessages.SendUnitChangeResponse(Response, gCadTransmitQueue)
                            Exit Sub
                        Else
                            If UnitChanges Then
                                TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.TrainUnitChange, messageToProcess, TrainFound, Nothing)
                            End If
                        End If
                    Else
                        Response = Symbol.PadRight(18, " ") & "N"
                        TMDS.NetworkMessages.CadMessages.SendUnitChangeResponse(Response, gCadTransmitQueue)
                    End If
                End If
                If gDebugPrint Then
                    DebugEvent("TRAIN UNIT CHANGE MESSAGE PROCESSED FROM COMMUNICATION CHANNEL:" & messageToProcess)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Sub ProcessTrainPosition(ByVal messageToProcess As String)


            Try
                DebugEvent("ProcessTrainPosition:" & messageToProcess)
                Dim data() As String = messageToProcess.Split("|")
                If data.Length >= 3 Then
                    Dim trn As TrainID
                    Dim TrainNameToCheck As String = data(0).Replace(Chr(4), "")
                    Dim TrnToRemove As TrainID = Nothing
                    For Each trn In TrainCollection
                        If trn.Name = TrainNameToCheck Then
                            If trn.ReadOnlySymbol Then
                                Dim SummItem As New SummaryItem("TRAIN", "RELEASE", trn)
                                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                                End SyncLock
                                trn.RemoveTrainViewRecord()
                                trn.ReleaseTrainAbbreviation(gTrainAbbreviation)
                                TrnToRemove = trn

                                Exit For
                            Else
                                Exit Sub
                            End If
                        End If
                    Next
                    If Not IsNothing(TrnToRemove) Then
                        SyncLock TrainCollection.SyncRoot
                            TrainCollection.Remove(TrnToRemove)
                        End SyncLock
                    End If
                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CInt(data(1)))
                    Dim auth As Object
                    Dim AuthDate As Date = Now
                    Dim NewTrk As Track = Nothing
                    For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                        If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                            If auth.TrainSymbol = TrainNameToCheck Then
                                If auth.AuthDate < AuthDate Then
                                    AuthDate = auth.AuthDate
                                    NewTrk = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(auth.Components)
                                End If
                            End If
                        End If
                    Next
                    If Not IsNothing(NewTrk) Then
                        trk = NewTrk
                    End If
                    If Not IsNothing(trk) Then
                        trn = trk.RetrieveTrainID(data(0).Replace(Chr(4), ""), False)
                        If Not IsNothing(trn) Then
                            trn.ApplyTrainAbbreviation(gTrainAbbreviation)
                            trk.AddTrainID(trn)
                            trk.InitTrainDisplay()
                            trk.InvalidateTrainID()
                            If Not trk.Indicating Then
                                trk.Occuppied = True
                                trk.UpdateStatus()
                            End If
                            Dim SummItem As New SummaryItem("TRAIN", "POSITION", trn)
                            SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                            End SyncLock
                            trn.TrackGUID = trk.GUID
                            trn.DoUpdateTrainIDIntoDatabase(trk)
                            trn.myTrack = trk
                            trn.SubID = trk.SubdivisionID
                            If Not IsNothing(TMDS.SystemForms.MySystemForms.frmSingleFormAuthority) Then
                                SyncLock gMessageQueuefrmSingleFormAuthority
                                    gMessageQueuefrmSingleFormAuthority.Enqueue("REFRESH TRAIN LIST")
                                    gMessageQueuefrmSingleFormAuthority.Enqueue("ISSUETO|" & trn.IdentifingUnit)
                                End SyncLock
                            End If
                        End If
                    Else
                        DebugEvent("ProcessTrainPosition-TrackNotFound:" & data(1))
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Sub ProcessViewPosition(ByVal messageToProcess As String)
            Try
                SystemEvent("ProcessViewPosition:" & messageToProcess)
                Dim data() As String = messageToProcess.Split("|")
                If data.Length >= 3 Then
                    Dim trn As TrainID
                    Dim TrainNameToCheck As String = data(0).Replace(Chr(4), "")
                    For Each trn In TrainCollection
                        If trn.Name = TrainNameToCheck Then
                            SystemEvent("EXITING PROCESSVIEWPOSITION AS TRAIN ALREADY EXISTS IN COLLECTION")
                            Exit Sub
                        End If
                    Next
                    Dim TrainSheetGuid As String = data(3).Replace(Chr(4), "")
                    Dim DatabaseTable As String = FindTrainSheetTable(TrainSheetGuid)
                    If DatabaseTable = "" Then
                        DatabaseTable = gtblTrainsActive
                    End If
                    SystemEvent("RETRIEVEVIEWONLYTRAINIDFROMSYMBOL:" & TrainNameToCheck & ";" & DatabaseTable & ";" & TrainSheetGuid)
                    trn = TMDS.SystemUtilities.Utilities.RetrieveViewOnlyTrainIDFromSymbol(TrainNameToCheck, DatabaseTable, TrainSheetGuid)
                    If Not IsNothing(trn) Then
                        SystemEvent("TRAIN RETRIEVED")
                        trn.ApplyTrainAbbreviation(gTrainAbbreviation)
                        If IsNumeric(data(2).Replace(Chr(4), "")) Then
                            trn.SubID = CInt(data(2).Replace(Chr(4), ""))
                        End If
                        If trn.InsertViewTrainIntoDatabase Then
                            SystemEvent("VIEW TRAIN INSERTED")
                            Dim SummItem As New SummaryItem("TRAIN", "POSITION", trn)
                            SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                            End SyncLock

                            If Not TrainCollection.Contains(trn) Then
                                TrainCollection.Add(trn)
                            End If
                        End If
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

