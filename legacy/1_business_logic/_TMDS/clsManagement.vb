#Region "TERRITORY COMPONENT ASSIST UPDATES"

        Private Function CheckForShadowMode(ByVal theList As String) As Boolean
            Try

                Dim GUIDs() As String = theList.Split("-")
                Dim strGUID As String
                For Each strGUID In GUIDs
                    If IsNumeric(strGUID) Then
                        Dim compToBlock As Object = FindComponent(CInt(strGUID))
                        If Not IsNothing(compToBlock) AndAlso compToBlock.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(compToBlock, Track)
                            If optApplyConfigurationForKCT AndAlso trk.IsShadowRemoteTrack Then
                            ElseIf trk.IsControlled Then
                                Return False
                            End If
                        End If
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            End Try
        End Function

        Private Function CheckForShadowModeAuthority(ByVal theAuth As Object) As Boolean
            Try

                If theAuth.GetType.ToString = gSFAComponentName Then
                    Dim sfa As SFAuthority = CType(theAuth, SFAuthority)
                    Dim comp As Object
                    For Each comp In sfa.Components
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(comp, Track)
                            If trk.IsControlled Then
                                Return False
                            End If
                        End If
                    Next
                ElseIf theAuth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                    Dim tnt As TrackAuthority.TrackAuthority = CType(theAuth, TrackAuthority.TrackAuthority)
                    Dim comp As Object
                    For Each comp In tnt.ComponentsInSelection
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(comp, Track)
                            If trk.IsControlled Then
                                Return False
                            End If
                        End If
                    Next
                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            End Try
        End Function

        Public Sub CreateTag(ByVal TagCreator As String, ByVal TagTime As String, ByVal TrackGuid As String, ByVal TagGUID As String, ByVal TagType As String,
                             ByVal Restriction As Boolean, ByVal TagData As String, ByVal DelayData As String, ByVal Direction As String)
            Try

                'If PlayBackMode Then Exit Sub

                Dim trk As TMDS.TrackComponents.Track = Me.FindTrack(CInt(TrackGuid))
                If optEnableTerritoryDeskAssignmentMode Then
                    If Not IsNothing(trk) AndAlso trk.IsControlled Then Exit Sub
                End If
                Dim TagExists As Boolean
                Dim TagToCheck As Tag = Nothing
                If Not trk Is Nothing Then
                    If Not trk.TrackTagLabels Is Nothing Then
                        If trk.TrackTagLabels.Count > 0 Then
                            For Each TagToCheck In trk.TrackTagLabels
                                If TagToCheck.TagGuid = TagGUID Then
                                    TagExists = True
                                End If
                            Next
                        End If
                    End If
                    If TagExists Then
                        LogEvent("TAG EXISTS:" & TagGUID & "- Type: " & TagType & "- Creator" & TagCreator & " - Track GUID: " & TrackGuid)
                        Exit Sub
                    End If
                    Dim tg As New TMDS.TrackTagComponents.Tag()
                    tg.DataString = TagData
                    tg.DelayData = DelayData
                    tg.Direction = Direction
                    tg.Creator = TagCreator
                    tg.CreateTime = CDate(TagTime)
                    tg.TagGuid = TagGUID
                    tg.TrackGuid = CInt(TrackGuid)
                    tg.Restriction = Restriction
                    tg.TagType = TagType
                    tg.TerritoryID = Me.TerritoryID
                    If trk.AddTagToTrack(tg) Then
                        TMDS.GlobalDeclarations.TrackTags.Add(tg)
                        trk.InitTagDisplay()
                        trk.UpdateTagStatus()
                        trk.UpdateStatus()

                        Dim SummItem As New SummaryItem("TAG", "UPDATE", tg)
                        SyncLock gSummaryTagQueue.SyncRoot
                            gSummaryTagQueue.Enqueue(SummItem)
                        End SyncLock
                    End If
                End If

                'Message = Message & "|" & Me.CreateTime 3
                'Message = Message & "|" & Me.TrackGuid 4
                'Message = Message & "|" & Me.Creator 5
                'Message = Message & "|" & Me.TagGuid 6
                'Message = Message & "|" & Me.TagType 7
                'Message = Message & "|" & Me.Restriction 8
                'Message = Message & "|" & Me.DataString 9

