        Friend Function GetEnRouteInformation() As String
            Dim s As String = ""
            Dim EnrouteCollection As New ArrayList
            Dim clsEn As TroubleReport.clsEnRoute
            Dim EnInfo As New StringBuilder
            Try
                If Me.TrainSymbol IsNot Nothing Then EnInfo.Append("[" & Me.TrainSymbol & "] ")
                If String.IsNullOrEmpty(Me.EnrouteDetails) AndAlso Me.EnrouteDetails.Trim = String.Empty Then Return EnInfo.ToString
                Dim Tempstr() As String = Me.EnrouteDetails.Split(Chr(1))
                For Each s In Tempstr
                    If s.Trim <> "" Then
                        Dim DataString() As String = s.Split("|")
                        Dim en As New TroubleReport.clsEnRoute
                        With en
                            If DataString.GetUpperBound(0) > 0 Then .EnRouteTrainName = DataString(0)
                            If DataString.GetUpperBound(0) >= 1 Then .EnDefectDetectorStr = DataString(1)
                            If DataString.GetUpperBound(0) >= 2 Then .EnEquip = DataString(2)
                            If DataString.GetUpperBound(0) >= 3 Then Boolean.TryParse(DataString(3), .EnEquipIsLoco) ' .EnEquipIsLoco = DataString(3)
                            If DataString.GetUpperBound(0) >= 4 Then .EnEquipFailType = DataString(4)
                            If DataString.GetUpperBound(0) >= 5 Then .EnEquipID = DataString(5)
                            If DataString.GetUpperBound(0) >= 6 Then .EnEquipNo = DataString(6)
                            If DataString.GetUpperBound(0) >= 7 Then .EnEquipAxle = DataString(7)
                            If DataString.GetUpperBound(0) >= 8 Then Boolean.TryParse(DataString(8), .EnSetOut) '.EnSetOut = DataString(8)
                            If DataString.GetUpperBound(0) >= 9 Then Boolean.TryParse(DataString(9), .EnBadOrder)
                            If DataString.GetUpperBound(0) >= 10 Then Boolean.TryParse(DataString(10), .EnFutureBadOrder) '.EnFutureBadOrder = DataString(9)
                            If DataString.GetUpperBound(0) >= 11 Then .EnEquipComments = DataString(11)
                            If DataString.GetUpperBound(0) >= 12 Then .EnSetOutString = DataString(12)
                            'If DataString.GetUpperBound(0) >= 13 Then .EnSetOutStation = DataString(13)
                            If DataString.GetUpperBound(0) >= 13 Then .EnStation = DataString(13)
                            If DataString.GetUpperBound(0) >= 14 Then .EnSetOutComments = DataString(14)
                            If DataString.GetUpperBound(0) >= 15 Then .EnFailTypeDetailString = DataString(15)
                            If DataString.GetUpperBound(0) >= 16 Then Boolean.TryParse(DataString(16), .EnMISDataSent) '.EnMISDataSent = DataString(16)
                        End With
                        If en IsNot Nothing Then
                            If Not EnrouteCollection.Contains(en) Then EnrouteCollection.Add(en)
                        End If
                    End If
                Next

                If EnrouteCollection IsNot Nothing AndAlso EnrouteCollection.Count > 0 Then
                    For Each clsEn In EnrouteCollection
                        If clsEn IsNot Nothing Then
                            With EnInfo
                                .Append(clsEn.EnEquipID & clsEn.EnEquipNo & "-" & clsEn.EnEquipFailType & "|")
                            End With
                        End If
                    Next
                End If
                Return EnInfo.ToString
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return String.Empty
        End Function

        Friend Class clsEnRoute
            Public myEnRouteGUID As String = String.Empty
            Public EnRouteTrainName As String = String.Empty
