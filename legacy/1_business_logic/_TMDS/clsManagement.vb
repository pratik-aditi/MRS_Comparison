        Public Function CreateMileageRanges() As Boolean
            Dim MsgList As New ArrayList
            Try
                'UID|NAME|LEFT MILEAGE|LEFT MILEAGE SUFFIX|RIGHT MILEAGE|RIGHT MILEAGE SUFFIX|SUBDIVISION ID|LEFT MILEAGE PREFIX|RIGHT MILEAGE PREFIX
                Dim Ranges() As String = MileageRangeDefinitions.Split(";")
                Dim r As String
                For Each r In Ranges
                    If r.Trim <> String.Empty Then
                        Dim data() As String = r.Split("|")
                        Dim UID As String = data(0)
                        Dim ExistingRange As MileageRange = FindRange(UID)
                        If ExistingRange Is Nothing Then
                            ExistingRange = FindRangeFromDB(UID)
                        End If

                        If Not IsNothing(ExistingRange) Then
                            Dim NewRange As New MileageRange
                            Try
                                NewRange.myName = ExistingRange.myName
                                NewRange.mySubdivision = ExistingRange.mySubdivision
                                NewRange.mySubdivisionName = ExistingRange.mySubdivisionName
                                NewRange.mySubdivisionUID = ExistingRange.mySubdivisionUID
                                NewRange.myUID = ExistingRange.myUID
                                NewRange.RightLinkage = ExistingRange.RightLinkage
                                NewRange.RightLinkageAlt = ExistingRange.RightLinkageAlt
                                NewRange.LeftLinkage = ExistingRange.LeftLinkage
                                NewRange.LeftLinkageAlt = ExistingRange.LeftLinkageAlt
                                NewRange.LeftMileage = CDbl(data(2))
                                NewRange.LeftMileageSuffix = data(3)
                                NewRange.RightMileage = CDbl(data(4))
                                NewRange.RightMileageSuffix = data(5)
                                'data(6) ==> SUBDIVISION ID
                                If data.Length >= 8 Then
                                    NewRange.LeftMileagePrefix = data(7)
                                    NewRange.RightMileagePrefix = data(8)
                                End If
                                NewRange.myDescription = ExistingRange.myDescription
                                myMileageRangeList.Add(NewRange) 'ExistingRange)
                                NewRange.AssignBulletinZone("CreateMileageRanges")
                            Catch ex As Exception
                                SystemEvent(">>>>ERROR LOADING MILEAGE RANGE: " & UID & " FOR BULLETIN CELL:" & Me.myName)
                                GetErrorDetails(ex)
                            End Try

                        Else
                            SystemEvent("ERROR LOADING MILEAGE RANGE:" & UID & "FOR BULLETIN CELL:" & Me.myName)
                            MsgList.Add("ERROR LOADING MILEAGE RANGE:" & UID & "FOR BULLETIN CELL:" & Me.myName)
                            ShowCustomMessageBox(MsgList, "SYSTEM ERROR", False, Nothing, True, True)
                            'MessageBox.Show(Me, "ERROR LOADING MILEAGE RANGE:" & UID & "FOR BULLETIN CELL:" & Me.myName, "SYSTEM ERROR", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                            Return False
                        End If
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Function FindRange(ByVal UID As String) As MileageRange
            Dim r As MileageRange
            For Each r In gMileageRangeList
                If Trim(r.myUID) = Trim(UID) Then
                    Return r
                End If
            Next
            Return Nothing
        End Function

        Private Function FindRangeFromDB(ByVal UID As String) As MileageRange
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Query As String = "SELECT * FROM tblSystemSubdivisionMileageRanges WHERE UID  = '" & UID & "'"
            Try
                SystemEvent("MileRange not found in loaded Mileage Range, Trying to Find and load it from the Database")
                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                dbcomm = New OleDbCommand(Query, dbconn)
                dr = dbcomm.ExecuteReader


                While dr.Read
                    Dim SystemUID As String = String.Empty
                    If Not dr.IsDBNull(0) Then SystemUID = dr.GetString(0)

                    If Not DoesExistMileageRange(SystemUID) Then
                        Dim MR As New MileageRange
                        With MR
                            If Not dr.IsDBNull(0) Then .myUID = dr.GetString(0)
                            If Not dr.IsDBNull(1) Then .myName = dr.GetString(1)
                            If Not dr.IsDBNull(2) Then .mySubdivisionUID = dr.GetInt32(2)
                            If Not dr.IsDBNull(3) Then .mySubdivisionName = dr.GetString(3)
                            If Not dr.IsDBNull(4) Then .LeftMileage = dr.GetDouble(4)
                            If Not dr.IsDBNull(5) Then .LeftMileageSuffix = dr.GetString(5).Trim
                            If Not dr.IsDBNull(6) Then .RightMileage = dr.GetDouble(6)
                            If Not dr.IsDBNull(7) Then .RightMileageSuffix = dr.GetString(7).Trim
                            If Not dr.IsDBNull(8) Then .LeftLinkage = dr.GetInt32(8)
                            If Not dr.IsDBNull(9) Then .LeftLinkageAlt = dr.GetInt32(9)
                            If Not dr.IsDBNull(10) Then .RightLinkage = dr.GetInt32(10)
                            If Not dr.IsDBNull(11) Then .RightLinkageAlt = dr.GetInt32(11)
                            If dr.FieldCount >= 14 Then
                                If Not dr.IsDBNull(14) Then .myDescription = dr.GetString(14)
                            End If
                            If dr.FieldCount >= 16 Then
                                If Not dr.IsDBNull(15) Then .LeftMileagePrefix = dr.GetString(15).Trim
                                If Not dr.IsDBNull(16) Then .RightMileagePrefix = dr.GetString(16).Trim
                            End If
                            MR.AssignSubdivision()
                            MR.AssignBulletinZone("FindRangeFromDB")
                        End With
                        gMileageRangeList.Add(MR)
                    End If

                End While
                Return FindRange(UID)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If Not dbconn Is Nothing Then
                    If dbconn.State = ConnectionState.Open Then dbconn.Close()
                    dbconn.Dispose()
                    dbconn = Nothing
                End If
                If Not dr Is Nothing Then
                    dr.Close()
                    dr = Nothing
                End If
                If Not dbcomm Is Nothing Then
                    dbcomm.Dispose()
                    dbcomm = Nothing
                End If
            End Try

            Return Nothing

        End Function

        Private Function DoesExistMileageRange(ByVal SystemUID As String) As Boolean
            Try
                Dim mr As MileageRange
                For Each mr In gMileageRangeList
                    If Trim(mr.myUID) = Trim(SystemUID) Then
                        Return True
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function
    End Class

