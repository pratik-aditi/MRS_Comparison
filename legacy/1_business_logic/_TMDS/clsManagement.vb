        Public Function GetNextWarrantNumber(ByRef WarrantCollection As ArrayList) As String
            Try
                Dim warr As Warrant
                Dim Unique As Boolean = False
                Dim ContinueUniqueSearch As Boolean = False
                Dim counter As Integer
                Dim NextWarrantNumber As String = String.Empty
                While Not Unique

                    If TWNumber = TWRange + TWFactor Then
                        TWNumber = TWRange
                    Else
                        TWNumber = TWNumber + 1
                    End If


                    For Each warr In WarrantCollection
                        If warr.WarrantNumber = TWNumber Then
                            ContinueUniqueSearch = True
                            counter = 0
                            Exit For
                        End If
                        counter = counter + 1

                        If counter = WarrantCollection.Count Then
                            ContinueUniqueSearch = False
                        End If
                    Next

                    If Not ContinueUniqueSearch Then
                        Unique = True
                        NextWarrantNumber = TWNumber
                        UpdateWarrantNumber(TMDS.GlobalDeclarations.gDatabaseConnectionStatic)
                    End If

                End While
                Return NextWarrantNumber
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub SetAuthorityNumber()
            Try
                Dim HighestNumber As Integer = Me.CurrentAuthorityNumber

                Dim warr As TrackAuthority.Warrant
                For Each warr In TMDS.GlobalDeclarations.TrackWarrants
                    If warr.WarrantNumber > HighestNumber Then
                        HighestNumber = warr.WarrantNumber
                    End If
                Next

                Dim auth As Object 'TrackAuthority.TrackAuthority
                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If auth.AuthorityNumber > HighestNumber Then
                        HighestNumber = auth.AuthorityNumber
                    End If
                Next

                Dim dev As TrackAuthority.DeviceBlock
                For Each dev In TMDS.GlobalDeclarations.gDeviceBlocks
                    If dev.AuthorityNumber > HighestNumber Then
                        HighestNumber = dev.AuthorityNumber
                    End If
                Next

                Me.CurrentAuthorityNumber = HighestNumber

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function GetNextAuthorityNumber(Optional ByVal IgnoreDeviceBlocks As Boolean = False, Optional ByVal ForDeviceBlocks As Boolean = False) As Int32
            Try
                Dim Unique As Boolean = False
                Dim LoopControl As Integer
                Dim CurrentTime As Date
                If IsNothing(Me.mySubdivision) Then
                    mySubdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromName(Subdivision)
                    If Not IsNothing(Me.mySubdivision) Then
                        Me.TimeZone = Me.mySubdivision.TimeZone
                    End If
                Else
                    Me.TimeZone = Me.mySubdivision.TimeZone
                End If
                Select Case Me.TimeZone
                    Case "EASTERN"
                        CurrentTime = Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor))
                    Case "PACIFIC"
                        CurrentTime = Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor))
                    Case "MOUNTAIN"
                        CurrentTime = Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor))
                    Case Else
                        CurrentTime = Now.AddHours(CDbl(gThisWorkstationTimeFactor))
                End Select

                TerritoryEventLog("GetNextAuthorityNumber:LastDatetime:" & LastGetAuthorityEvent.ToString & "-TerrID:" & Me.TerritoryID.ToString & "-AuthNum:" & CurrentAuthorityNumber.ToString)

                If Me.LastGetAuthorityEvent.Date < CurrentTime.Date Then
                    Me.UpdateAuthorityEvent(CurrentTime)
                    CheckForPreviousDayLowestNumber()
                Else
                    LastGetAuthorityEvent = CurrentTime
                End If

                While Not Unique
                    If CurrentAuthorityNumber >= 999 Then
                        CurrentAuthorityNumber = 1
                    Else
                        CurrentAuthorityNumber = CurrentAuthorityNumber + 1
                        If Me.PreviousAuthorityNumberReleased = CurrentAuthorityNumber Then
                            CurrentAuthorityNumber = CurrentAuthorityNumber + 1
                        End If
                    End If

                    If CheckAllAuthorityTypeNumbers(CurrentAuthorityNumber, IgnoreDeviceBlocks, ForDeviceBlocks) Then
                        Dim PerformUpdateAuthorityNumber As New DoUpdateAuthorityNumber(AddressOf Me.UpdateAuthorityNumber)
                        PerformUpdateAuthorityNumber.BeginInvoke(Nothing, Nothing)
                        TerritoryEventLog("GetNextAuthorityNumber:CurrentAuthorityNumber:" & CurrentAuthorityNumber.ToString)
                        Return CurrentAuthorityNumber
                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl = 999 Then
                        Return 0
                    End If
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Public Function GetNextAuthorityNumberRange() As Int32
            Dim Unique As Boolean = False
            Dim LoopControl As Integer
            Dim CurrentTime As Date
            Try
                If IsNothing(Me.mySubdivision) Then
                    mySubdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromName(Subdivision)
                    If Not IsNothing(Me.mySubdivision) Then
                        Me.TimeZone = Me.mySubdivision.TimeZone
                    End If
                Else
                    Me.TimeZone = Me.mySubdivision.TimeZone
                End If
                Select Case Me.TimeZone
                    Case "EASTERN"
                        CurrentTime = Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor))
                    Case "PACIFIC"
                        CurrentTime = Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor))
                    Case "MOUNTAIN"
                        CurrentTime = Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor))
                    Case Else
                        CurrentTime = Now.AddHours(CDbl(gThisWorkstationTimeFactor))
                End Select

                TerritoryEventLog("LastGetAuthorityEvent:" & LastGetAuthorityEvent.ToString & " for TerrID:" & Me.TerritoryID.ToString & ". AuthNum:" & CurrentAuthorityNumber.ToString)
                If Me.LastGetAuthorityEvent.Date < CurrentTime.Date Then
                    Me.UpdateAuthorityEvent(CurrentTime)
                    CheckForPreviousDayLowestNumber()
                Else
                    LastGetAuthorityEvent = CurrentTime
                End If


                If Me.LastGetAuthorityEvent.Date < Now.Date.AddDays(-1) Then
                    Me.UpdateAuthorityEvent(CurrentTime)
                    'CheckForPreviousDayLowestNumber()
                    Me.LastGetAuthorityEvent = Now
                    CurrentAuthorityNumber = Me.TWRange ' Me.AuthorityNumberRange
                ElseIf optEnableCPSpecificOptions AndAlso Me.LastGetAuthorityEvent.Date <= Now.Date.AddDays(-1) Then
                    Me.UpdateAuthorityEvent(CurrentTime)
                    CheckForPreviousDayLowestNumber()
                    Me.LastGetAuthorityEvent = Now
                    CurrentAuthorityNumber = Me.TWRange ' Me.AuthorityNumberRange

                End If

                While Not Unique
                    If CurrentAuthorityNumber >= Me.TWFactor + Me.TWRange Then
                        CurrentAuthorityNumber = Me.TWRange + 1
                    Else
                        If CurrentAuthorityNumber = 0 Then
                            CurrentAuthorityNumber = Me.TWRange
                        ElseIf CurrentAuthorityNumber < Me.TWRange Then
                            CurrentAuthorityNumber = Me.TWRange
                        Else
                            CurrentAuthorityNumber = CurrentAuthorityNumber + 1
                        End If
                        If Me.PreviousAuthorityNumberReleased = CurrentAuthorityNumber Then
                            CurrentAuthorityNumber = CurrentAuthorityNumber + 1
                            If CurrentAuthorityNumber >= Me.TWFactor + Me.TWRange Then
                                CurrentAuthorityNumber = Me.TWRange + 1
                            ElseIf CurrentAuthorityNumber < Me.TWRange Then
                                CurrentAuthorityNumber = Me.TWRange + 1
                            End If
                        End If
                    End If

                    If CurrentAuthorityNumber < Me.TWRange Then
                        CurrentAuthorityNumber = Me.TWFactor + Me.TWRange - 10
                    End If

                    If CheckAllAuthorityTypeNumbers(CurrentAuthorityNumber) Then
                        Dim PerformUpdateAuthorityNumber As New DoUpdateAuthorityNumber(AddressOf Me.UpdateAuthorityNumber)
                        PerformUpdateAuthorityNumber.BeginInvoke(Nothing, Nothing)
                        Return CurrentAuthorityNumber
                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl >= Me.TWFactor Then
                        SystemException("GetNextAuthorityNumber Failed on LoopControl. CurrentAuthorityNumber=" & CurrentAuthorityNumber)
                        Return 0
                    End If
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Sub CheckForPreviousDayLowestNumber()

            Dim warr As TrackAuthority.Warrant
            Dim auth As Object
            Try

                'Perform high water mark check
                Dim HighWaterMark As Integer
                For Each warr In TMDS.GlobalDeclarations.TrackWarrants
                    If warr.CreateDate.Date < Now.Date Then
                        If warr.WarrantNumber > HighWaterMark Then
                            HighWaterMark = warr.WarrantNumber
                        End If
                    End If
                Next

                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                        Dim tt As TrackAuthority.TrackAuthority = CType(auth, TrackAuthority.TrackAuthority)
                        If tt.CreateDate.Date < Now.Date Then
                            If tt.AuthorityNumber > HighWaterMark Then
                                HighWaterMark = tt.AuthorityNumber
                            End If
                        End If
                    ElseIf auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        Dim sfa As TrackAuthority.SFAuthority = CType(auth, TrackAuthority.SFAuthority)
                        If sfa.AuthDate.Date < Now.Date Then
                            If sfa.AuthorityNumber > HighWaterMark Then
                                HighWaterMark = sfa.AuthorityNumber
                            End If
                        End If
                    End If
                Next
                If Not optDisableUseOfHighWaterAuthorityMark Then
                    If HighWaterMark < 50 Then
                        If CurrentAuthorityNumber < 50 Then
                            CurrentAuthorityNumber = 50
                        Else
                            CurrentAuthorityNumber = 0
                        End If
                    Else
                        Me.CurrentAuthorityNumber = 0
                    End If
                Else
                    Me.CurrentAuthorityNumber = 0
                End If


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Private Function CheckAllAuthorityTypeNumbers(ByVal NumberToCheck As Int32, Optional ByVal IgnoreDeviceBlocks As Boolean = False, Optional ByVal ForDeviceBlocks As Boolean = False) As Boolean
            Try
                Dim warr As TrackAuthority.Warrant
                If Not optUseTerritoryUniquenessForAuthorityNumbers Or ForDeviceBlocks Then
                    For Each warr In TMDS.GlobalDeclarations.TrackWarrants
                        If warr.WarrantNumber = NumberToCheck Then
                            Return False
                        End If
                    Next

                    Dim auth As Object ' TrackAuthority.TrackAuthority
                    For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                        If auth.AuthorityNumber = NumberToCheck Then
                            Return False
                        End If
                    Next
                    For Each auth In TMDS.GlobalDeclarations.gOtherSpecialAuthorityCollection
                        If auth.AuthorityNumber = NumberToCheck Then
                            Return False
                        End If
                    Next
                    If Not IgnoreDeviceBlocks Then
                        Dim dev As TrackAuthority.DeviceBlock
                        For Each dev In TMDS.GlobalDeclarations.gDeviceBlocks
                            If dev.AuthorityNumber = NumberToCheck Then
                                Return False
                            End If
                        Next
                    End If
                ElseIf optUseTerritoryUniquenessForAuthorityNumbers Then
                    Dim auth As Object 'TrackAuthority.TrackAuthority
                    For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                        If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                            If auth.AuthorityNumber = NumberToCheck And auth.TerrID1 = Me.TerritoryID Then
                                Return False
                            End If
                        ElseIf auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                            If auth.AuthorityNumber = NumberToCheck And auth.TerritoryAssignment = Me.TerritoryID Then
                                Return False
                            End If
                        End If
                    Next
                    For Each auth In TMDS.GlobalDeclarations.gOtherSpecialAuthorityCollection
                        If auth.AuthorityNumber = NumberToCheck AndAlso auth.TerrID1 = Me.TerritoryID Then
                            Return False
                        End If
                    Next
                End If

                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

