        Friend Function PerformCancelFormC(TGBO As TabularGeneralBulletin) As Boolean
            Try
                Dim sb As SubBulletin = TMDS.SystemUtilities.FetchData.FindBulletinByGUID(Me.myBulletinGUID)
                If sb IsNot Nothing Then
                    Dim cGBO As New CancelBulletin(sb)
                    cGBO.TGBOToApply = TGBO
                    If cGBO.PerformCancelBulletin Then
                        Dim CancelledSB As SubBulletin = cGBO.myNewCancelledBulletin
                        If CancelledSB IsNot Nothing Then
                            Me.myBulletinGUID = CancelledSB.myGUID
                            UpdateBulletinCorrelation()
                            If optPerformDocumentArchiving Then
                                ArchiveTBPDF(CancelledSB, "C-FORM C - " & myTrain.Name)
                            End If
                        End If
                    End If
                End If
            Catch ex As Exception

            End Try

        End Function

