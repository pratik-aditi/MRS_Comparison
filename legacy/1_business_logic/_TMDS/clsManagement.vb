        Private Shared Function FindTrackFromBlockID(ByVal BlockID As Int32, ByVal kilopost As Decimal, ByVal SubID As Int32) As Track
            Try
                Dim trk As Track
                For Each trk In TMDS.GlobalDeclarations.TrackCollection
                    If trk.PTCBlockID = BlockID And trk.SubdivisionID = SubID Then
                        'If trk.LeftLimitMilePost >= kilopost And trk.RightLimitMilePost <= kilopost Or trk.LeftLimitMilePost <= kilopost And trk.RightLimitMilePost >= kilopost Then
                        '    Return trk
                        'End If
                        If System.Math.Round(trk.LeftLimitMilePost, 1) >= kilopost And System.Math.Round(trk.RightLimitMilePost, 1) <= kilopost Or System.Math.Round(trk.LeftLimitMilePost, 1) <= kilopost And System.Math.Round(trk.RightLimitMilePost, 1) >= kilopost Then
                            Return trk
                        End If

                    End If
                Next

                For Each trk In TMDS.GlobalDeclarations.TrackCollection
                    If trk.PTCBlockID = BlockID And trk.SubdivisionID = SubID Then
                        Return trk
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Shared Function FindTrainFromLocoID(ByVal LocoID As Int32) As TrainID
            Try
                Dim trn As TrainID
                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.IdentifingUnit = LocoID Then
                        Return trn
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

    End Class
