        Public Sub PositionMOW(ByVal Name As String, ByVal TrackGUID As String, ByVal MOWGUID As String, DisplayText As String, Optional ByVal ShadowMode As Boolean = False) 'ARRC-1107
            Dim PreviousTrack As Track = Nothing
            Try
                LogEvent("PositionMOW:" & Name & "TRK:" & TrackGUID)
                Dim trk As TMDS.TrackComponents.Track = Me.FindTrack(CInt(TrackGUID))

                If Not trk Is Nothing Then
                    If optEnableTerritoryDeskAssignmentMode AndAlso trk.IsControlled Then Exit Sub

                    Dim mow As TMDS.TrainComponents.MOWID = Nothing
                    mow = TMDS.SystemUtilities.FetchData.FindMow(MOWGUID)
                    If mow Is Nothing Then mow = TMDS.SystemUtilities.FetchData.GetForemanFromDB_ByGUID(MOWGUID)
                    If mow Is Nothing Then
                        mow = New TMDS.TrainComponents.MOWID
                        mow.Name = Name
                        mow.MowGUID = MOWGUID
                        mow.TrackGUID = TrackGUID
                        If trk IsNot Nothing Then mow.myTrack = trk
                        mow.TypeOfID = "MOW"
                        If Not String.IsNullOrEmpty(DisplayText) AndAlso DisplayText.Trim <> "" Then
                            mow.DisplayText = DisplayText.ToUpper.Trim
                        End If
                    Else
                        PreviousTrack = mow.myTrack
                        If PreviousTrack IsNot Nothing Then

                        End If
                    End If
                    'Dim mow As New TMDS.GraphicComponent.MOWID()




                    If AddMOWToLists(mow) Then
                        trk.AddMOWID(mow)
                        If Not trk.Indicating Then
                            trk.Occuppied = True
                            'trk.UpdateStatus()
                        End If
                    Else ' MPM 3/19/2013 - Added "else" statement to handle when the MOWID is already in the list of MOWs. Ref.V1-95
                        trk.MOWIDs.Insert(0, mow)
                        'trk.InvalidateMOWID()
                        'trk.InitMOWDisplay()
                        'trk.UpdateStatus()
                    End If
                    trk.InvalidateMOWID()
                    trk.InitMOWDisplay()
                    trk.UpdateStatus()
                Else
                    LogEvent("PositionMOW-TRACK NOT FOUND:" & TrackGUID)
                End If

            Catch ex As Exception
                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            End Try
        End Sub

        Public Sub PositionTrain(ByVal TrackGUID As String, ByVal Name As String,
                            ByVal Direction As String, ByVal IdentifingUnit As String,
                            ByVal EngName As String, ByVal EngOnDuty As String,
                            ByVal CondName As String, ByVal CondOnDuty As String, Optional ByVal PseudoName As String = Nothing, Optional ByVal ShadowMode As Boolean = False)
            Try
                LogEvent("PositionTrain:" & Name & "TRK:" & TrackGUID)
                Dim trk As TMDS.TrackComponents.Track = Me.FindTrack(CInt(TrackGUID))
                If optEnableTerritoryDeskAssignmentMode Then
                    If Not IsNothing(trk) AndAlso trk.IsControlled Then Exit Sub
                End If

                Dim trnCheck As TrainID = Me.FindTrain(Name)
                If Not IsNothing(trnCheck) Then
                    Exit Sub
                End If
                If Not trk Is Nothing Then
                    Dim trn As TrainID = trk.RetrieveTrainID(Name)
                    If IsNothing(trn) Then Exit Sub
                    trn.ApplyTrainAbbreviation(gTrainAbbreviation)
                    trk.AddTrainID(trn)
                    If Not trk.Indicating Then
                        trk.Occuppied = True
                        trk.InvalidateTrainID() 'ARRC-1098
                        trk.UpdateStatus()
                    End If
                    Dim SummItem As New SummaryItem("TRAIN", "POSITION", trn)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                    End SyncLock

                Else
                    LogEvent("PositionTrain-TRACK NOT FOUND:" & TrackGUID)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub MoveTrain(ByVal TrainName As String, ByVal TrackGUID As String, Optional ByVal ShadowMode As Boolean = False)
            Dim trn As TrainID = Nothing
            Dim Oldtrk As TMDS.TrackComponents.Track = Nothing
            Dim Newtrk As TMDS.TrackComponents.Track = Nothing
            Dim TrainFoundInTrainCollection As Boolean
            Dim TrainFoundInMyTrainCollection As Boolean

            Try
                'If PlayBackMode Then Exit Sub
                LogEvent("SUB:MoveTrain" & TrainName & "-" & TrackGUID)
                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.Name = TrainName Then
                        LogEvent("MOVE TRAIN2:" & TrainName)

                        Oldtrk = Me.FindTrack(CInt(trn.TrackGUID))
                        'If optEnableTerritoryDeskAssignmentMode Then
                        '    If Not IsNothing(Oldtrk) AndAlso Oldtrk.IsControlled Then Exit Sub
                        'End If

                        Dim TrainFoundOnTrack As Boolean
                        If Not IsNothing(Oldtrk) Then
                            If Oldtrk.OStype And Not IsNothing(Oldtrk.OsComponentCollection) Then
                                Dim comp As Object
                                For Each comp In Oldtrk.OsComponentCollection
                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        Dim trkInOs As Track = CType(comp, Track)
                                        If trkInOs.TrainIDs.Count <> 0 Then
                                            Dim trn1 As TrainID
                                            For Each trn1 In trkInOs.TrainIDs
                                                If trn.Name = TrainName Then
                                                    TrainFoundOnTrack = True
                                                    LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK" & TrainName & "-" & TrackGUID)
                                                    Oldtrk = trkInOs
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                    End If
                                Next
                            Else
                                If Oldtrk.TrainIDs.Count <> 0 Then
                                    Dim trn1 As TrainID
                                    For Each trn1 In Oldtrk.TrainIDs
                                        If trn1.Name = TrainName Then
                                            TrainFoundOnTrack = True
                                            LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK" & TrainName & "-" & TrackGUID)
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                        End If

                        If Not TrainFoundOnTrack Then
                            LogEvent("SUB:MoveTrain-TRAIN NOT FOUND ONTRACK1" & TrainName & "-" & TrackGUID)
                            Dim trn3 As TrainID
                            For Each trn3 In TMDS.GlobalDeclarations.TrainCollection
                                If trn3.Name = TrainName Then
                                    Oldtrk = Me.FindTrack(CInt(trn3.TrackGUID))
                                    If Not IsNothing(Oldtrk) Then
                                        LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK" & TrainName & "-" & Oldtrk.GUID.ToString)
                                    End If
                                    Exit For
                                End If
                            Next
                            LogEvent("SUB:MoveTrain-TRAIN NOT FOUND ONTRACK2" & TrainName & "-" & TrackGUID)
                        End If

                        Newtrk = Me.FindTrack(CInt(TrackGUID))
                        If Not Newtrk Is Nothing Then
                            If trn.TrackGUID = TrackGUID Then
                                LogEvent("SUB:MoveTrain-TRAIN FOUND ON SAME TRACK" & TrainName & "-" & Oldtrk.GUID.ToString)
                                Exit Sub
                            End If
                            trn.TrackGUID = TrackGUID
                            Newtrk.MoveTrainIDPlace(trn, Oldtrk, False, Nothing, ShadowMode)
                            Newtrk.InvalidateTrainID()
                        Else
                            LogEvent("Newtrk Not Found:" & TrainName)
                        End If
                        If IsNothing(Oldtrk) Then
                            If Not Newtrk Is Nothing Then
                                FindPreviousTrack(TrainName, Newtrk.GUID)
                            End If
                            LogEvent("Oldtrk Not Found:" & TrainName)

                        End If
                        LogEvent("TRAIN NAME Found:" & TrainName)
                        TrainFoundInTrainCollection = True
                        Exit For
                    End If
                Next



                If Not TrainFoundInTrainCollection Then
                    For Each trn In TMDS.GlobalDeclarations.TrainCollection
                        If trn.Name = TrainName Then
                            LogEvent("MOVE TRAIN2:" & TrainName)

                            Oldtrk = Me.FindTrack(CInt(trn.TrackGUID))

                            Dim TrainFoundOnTrack As Boolean
                            If Not IsNothing(Oldtrk) Then
                                If Oldtrk.TrainIDs.Count <> 0 Then
                                    Dim trn1 As TrainID
                                    For Each trn1 In Oldtrk.TrainIDs
                                        If trn.Name = TrainName Then
                                            TrainFoundOnTrack = True
                                            LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK" & TrainName & "-" & TrackGUID)
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If

                            If Not TrainFoundOnTrack Then
                                LogEvent("SUB:MoveTrain-TRAIN NOT FOUND ONTRACK1" & TrainName & "-" & TrackGUID)
                                Dim trn3 As TrainID
                                For Each trn3 In TMDS.GlobalDeclarations.TrainCollection
                                    If trn3.Name = TrainName Then
                                        Oldtrk = Me.FindTrack(CInt(trn3.TrackGUID))
                                        If Not IsNothing(Oldtrk) Then
                                            LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK" & TrainName & "-" & Oldtrk.GUID.ToString)
                                        End If
                                        Exit For
                                    End If
                                Next
                                LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK2" & TrainName & "-" & TrackGUID)
                            End If

                            Newtrk = Me.FindTrack(CInt(TrackGUID))
                            If Not Newtrk Is Nothing Then
                                trn.TrackGUID = TrackGUID
                                Newtrk.MoveTrainIDPlace(trn, Oldtrk, False, Nothing, ShadowMode)
                                Newtrk.InvalidateTrainID()
                            Else
                                LogEvent("Newtrk Not Found:" & TrainName)
                            End If
                            If IsNothing(Oldtrk) Then
                                LogEvent("Oldtrk Not Found:" & TrainName)
                            End If
                            LogEvent("TRAIN NAME Found:" & TrainName)
                            Me.AddTrainToLists(trn)
                            TrainFoundInMyTrainCollection = True
                            Exit For
                        End If
                    Next
                End If

                If Not TrainFoundInTrainCollection Then
                    LogEvent("TRAIN NAME NOT Found in TrainCollection:" & TrainName)
                    If Not TrainFoundInMyTrainCollection Then
                        LogEvent("TRAIN NAME NOT Found in myTrainCollection:" & TrainName)
                    End If
                End If

                If Not Oldtrk Is Nothing Then
                    If Not Oldtrk.Indicating And Oldtrk.TrainIDs.Count = 0 Then
                        Oldtrk.Occuppied = False
                        Oldtrk.UpdateStatus()
                    End If
                Else
                    If Not Newtrk Is Nothing Then
                        FindPreviousTrack(TrainName, Newtrk.GUID)
                    End If
                    LogEvent("Oldtrk Not Found:" & TrainName)
                End If

                If Not Newtrk Is Nothing Then
                    If Not Newtrk.Indicating Then
                        Newtrk.Occuppied = True
                        Newtrk.UpdateStatus()
                    End If
                Else
                    LogEvent("NEWtrk Not Found:" & TrainName & "TRK:" & TrackGUID)
                End If
                PrintTrainCollection()
                'Message = Message & "|" & Me.TrackGUID
                'Message = Message & "|" & Me.Name
                'Message = Message & "|" & Me.Direction
                'Message = Message & "|" & Me.IdentifingUnit
                'Message = Message & "|" & Me.EngName
                'Message = Message & "|" & Me.EngOnDuty
                'Message = Message & "|" & Me.CondName
                'Message = Message & "|" & Me.CondOnDuty
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub MoveManualTrain(ByVal TrainName As String, ByVal TrackGUID As String, Optional ByVal ShadowMode As Boolean = False)
            Dim trn As TrainID = Nothing
            Dim Oldtrk As TMDS.TrackComponents.Track = Nothing
            Dim Newtrk As TMDS.TrackComponents.Track = Nothing
            Dim TrainFoundInTrainCollection As Boolean
            Dim TrainFoundInMyTrainCollection As Boolean

            Try
                'If PlayBackMode Then Exit Sub
                LogEvent("SUB:MoveTrain" & TrainName & "-" & TrackGUID)
                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.Name = TrainName Then
                        LogEvent("MOVE TRAIN2:" & TrainName)

                        Oldtrk = Me.FindTrack(CInt(trn.TrackGUID))

                        Dim TrainFoundOnTrack As Boolean
                        If Not IsNothing(Oldtrk) Then
                            'If optEnableTerritoryDeskAssignmentMode Then
                            '    If Not IsNothing(Oldtrk) AndAlso Oldtrk.IsControlled Then Exit Sub
                            'End If

                            If Oldtrk.OStype And Not IsNothing(Oldtrk.OsComponentCollection) Then
                                Dim comp As Object
                                For Each comp In Oldtrk.OsComponentCollection
                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        Dim trkInOs As Track = CType(comp, Track)
                                        If trkInOs.TrainIDs.Count <> 0 Then
                                            Dim trn1 As TrainID
                                            For Each trn1 In trkInOs.TrainIDs
                                                If trn.Name = TrainName Then
                                                    TrainFoundOnTrack = True
                                                    LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK" & TrainName & "-" & TrackGUID)
                                                    Oldtrk = trkInOs
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                    End If
                                Next
                            Else
                                If Oldtrk.TrainIDs.Count <> 0 Then
                                    Dim trn1 As TrainID
                                    For Each trn1 In Oldtrk.TrainIDs
                                        If trn1.Name = TrainName Then
                                            TrainFoundOnTrack = True
                                            LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK" & TrainName & "-" & TrackGUID)
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                        End If

                        If Not TrainFoundOnTrack Then
                            LogEvent("SUB:MoveTrain-TRAIN NOT FOUND ON TRACK1" & TrainName & "-" & TrackGUID)
                            Dim trn3 As TrainID
                            For Each trn3 In TMDS.GlobalDeclarations.TrainCollection
                                If trn3.Name = TrainName Then
                                    Oldtrk = Me.FindTrack(CInt(trn3.TrackGUID))
                                    If Not IsNothing(Oldtrk) Then
                                        LogEvent("SUB:MoveTrain-TRAIN FOUND ON TRACK:" & TrainName & "-" & Oldtrk.GUID.ToString)
                                    End If
                                    Exit For
                                End If
                            Next
                            LogEvent("SUB:MoveTrain-TRAIN NOT FOUND ON TRACK2" & TrainName & "-" & TrackGUID)
                        End If

                        Newtrk = Me.FindTrack(CInt(TrackGUID))
                        If Not Newtrk Is Nothing Then
                            If trn.TrackGUID = TrackGUID Then
                                LogEvent("SUB:MoveTrain-TRAIN FOUND ON SAME TRACK:" & TrainName & "-" & TrackGUID)
                                Exit Sub
                            End If
                            trn.TrackGUID = TrackGUID
                            If Newtrk Is Oldtrk Then
                                Dim RealTrack As Track = Me.FindTrainWithTrack(trn.TrainGUID, Newtrk)
                                If Not IsNothing(RealTrack) Then
                                    Oldtrk = RealTrack
                                End If
                            End If
                            Newtrk.MoveTrainIDPlaceManual(trn, Oldtrk, False, Nothing, True, False, Nothing, False, ShadowMode)
                            Newtrk.InvalidateTrainID()
                        Else
                            LogEvent("Newtrk Not Found:" & TrainName)
                        End If
                        If IsNothing(Oldtrk) Then
                            If Not Newtrk Is Nothing Then
                                FindPreviousTrack(TrainName, Newtrk.GUID)
                            End If
                            LogEvent("Oldtrk Not Found:" & TrainName)

                        End If
                        LogEvent("TRAIN NAME Found:" & TrainName)
                        TrainFoundInTrainCollection = True
                        Exit For
                    End If
                Next



                If Not TrainFoundInTrainCollection Then
                    For Each trn In TMDS.GlobalDeclarations.TrainCollection
                        If trn.Name = TrainName Then
                            LogEvent("MOVE TRAIN2:" & TrainName)

                            Oldtrk = Me.FindTrack(CInt(trn.TrackGUID))

                            Dim TrainFoundOnTrack As Boolean
                            If Not IsNothing(Oldtrk) Then
                                If Oldtrk.TrainIDs.Count <> 0 Then
                                    Dim trn1 As TrainID
                                    For Each trn1 In Oldtrk.TrainIDs
                                        If trn.Name = TrainName Then
                                            TrainFoundOnTrack = True
                                            LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK" & TrainName & "-" & TrackGUID)
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If

                            If Not TrainFoundOnTrack Then
                                LogEvent("SUB:MoveTrain-TRAIN NOT FOUND ONTRACK1" & TrainName & "-" & TrackGUID)
                                Dim trn3 As TrainID
                                For Each trn3 In TMDS.GlobalDeclarations.TrainCollection
                                    If trn3.Name = TrainName Then
                                        Oldtrk = Me.FindTrack(CInt(trn3.TrackGUID))
                                        If Not IsNothing(Oldtrk) Then
                                            LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK" & TrainName & "-" & Oldtrk.GUID.ToString)
                                        End If
                                        Exit For
                                    End If
                                Next
                                LogEvent("SUB:MoveTrain-TRAIN FOUND ONTRACK2" & TrainName & "-" & TrackGUID)
                            End If

                            Newtrk = Me.FindTrack(CInt(TrackGUID))
                            If Not Newtrk Is Nothing Then
                                trn.TrackGUID = TrackGUID
                                If Newtrk Is Oldtrk Then
                                    Dim RealTrack As Track = Me.FindTrainWithTrack(trn.TrainGUID, Newtrk)
                                    If Not IsNothing(RealTrack) Then
                                        Oldtrk = RealTrack
                                    End If
                                End If

                                Newtrk.MoveTrainIDPlaceManual(trn, Oldtrk, False, Nothing, True, False, Nothing, False, ShadowMode)
                                Newtrk.InvalidateTrainID()
                            Else
                                LogEvent("Newtrk Not Found:" & TrainName)
                            End If
                            If IsNothing(Oldtrk) Then
                                LogEvent("Oldtrk Not Found:" & TrainName)
                            End If
                            LogEvent("TRAIN NAME Found:" & TrainName)
                            Me.AddTrainToLists(trn)
                            TrainFoundInMyTrainCollection = True
                            Exit For
                        End If
                    Next
                End If

                If Not TrainFoundInTrainCollection Then
                    LogEvent("TRAIN NAME NOT Found in TrainCollection:" & TrainName)
                    If Not TrainFoundInMyTrainCollection Then
                        LogEvent("TRAIN NAME NOT Found in myTrainCollection:" & TrainName)
                    End If
                End If

                If Not Oldtrk Is Nothing Then
                    If Not Oldtrk.Indicating And Oldtrk.TrainIDs.Count = 0 Then
                        Oldtrk.Occuppied = False
                        Oldtrk.UpdateStatus()
                    End If
                Else
                    If Not Newtrk Is Nothing Then
                        FindPreviousTrack(TrainName, Newtrk.GUID)
                    End If
                    LogEvent("Oldtrk Not Found:" & TrainName)
                End If

                If Not Newtrk Is Nothing Then
                    If Not Newtrk.Indicating Then
                        Newtrk.Occuppied = True
                        Newtrk.UpdateStatus()
                    End If
                Else
                    LogEvent("NEWtrk Not Found:" & TrainName & "TRK:" & TrackGUID)
                End If
                PrintTrainCollection()
                'Message = Message & "|" & Me.TrackGUID
                'Message = Message & "|" & Me.Name
                'Message = Message & "|" & Me.Direction
                'Message = Message & "|" & Me.IdentifingUnit
                'Message = Message & "|" & Me.EngName
                'Message = Message & "|" & Me.EngOnDuty
                'Message = Message & "|" & Me.CondName
                'Message = Message & "|" & Me.CondOnDuty
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub TrainOS(ByVal TrainName As String, ByVal LastOs As String)
            Try
                Dim trn As TrainID = Me.FindTrain(TrainName)
                If Not IsNothing(trn) Then
                    If optEnableTerritoryDeskAssignmentMode Then
                        If Not IsNothing(trn.myTrack) AndAlso trn.myTrack.IsControlled Then Exit Sub
                    End If

                    trn.LastOS = LastOs
                    trn.OSTimes.Add(LastOs)
                End If
                Dim SummItem As New SummaryItem("TRAIN", "UPDATE-OS", trn)
                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                End SyncLock


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub TrainReOrder(ByVal TrainName As String, ByVal TrackGUID As String, ByVal TrainList As String)
            Try
                Dim trn As TrainID = Me.FindTrain(TrainName)
                Dim trk As Track = Me.FindTrack(CInt(TrackGUID))
                If optEnableTerritoryDeskAssignmentMode Then
                    If Not IsNothing(trk) AndAlso trk.IsControlled Then Exit Sub
                End If

                Dim trnList As New ArrayList()
                Dim trnName As String
                Dim trainsToList() As String = TrainList.Split(Chr(8))
                For Each trnName In trainsToList
                    Dim trn1 As TrainID = Me.FindTrain(trnName)
                    If Not IsNothing(trn1) Then
                        trnList.Add(trn1)
                    End If
                Next

                If Not IsNothing(trn) And Not IsNothing(trk) Then
                    Dim trn2 As TrainID
                    trk.TrainIDs.Clear()
                    For Each trn2 In trnList
                        trk.TrainIDs.Add(trn2)
                    Next
                    trk.InitTrainDisplay()
                    trk.InvalidateTrainID()

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub UpdateTrain(ByVal TrainName As String, Optional ForceUpdate As Boolean = False)
            Try
                Dim trn As TrainID = FindTrain(TrainName)
                If Not IsNothing(trn) Then
                    If optEnableTerritoryDeskAssignmentMode AndAlso Not ForceUpdate Then
                        If Not IsNothing(trn.myTrack) AndAlso trn.myTrack.IsControlled Then Exit Sub
                    End If

                    trn.UpdateTrainID()
                    trn.myTrack.InvalidateTrainID()
                    trn.myTrack.InitTrainDisplay()
                    trn.myTrack.InvalidateTrainID()

                    Dim SummItem1 As New SummaryItem("TRAIN", "RELEASE", trn)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem1)
                    End SyncLock

                    Dim SummItem2 As New SummaryItem("TRAIN", "POSITION", trn)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem2)
                    End SyncLock
                End If


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

