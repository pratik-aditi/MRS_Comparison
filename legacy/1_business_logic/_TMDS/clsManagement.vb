        Public Sub AddTNT(ByVal AuthorityUID As String, ByVal AuthorityDate As String, ByVal DispatcherName As String,
        ByVal IssueTo As String, ByVal UntilTime As String, ByVal Components As String, ByVal AuthorityLimits As String)
            Try
                'If PlayBackMode Then Exit Sub
                If optEnableTerritoryDeskAssignmentMode Then
                    If Not CheckForShadowMode(Components) Then Exit Sub
                End If


                Dim auth As New TMDS.TrackAuthority.TrackAuthority()
                auth.AuthorityUID = AuthorityUID
                auth.AuthorityDate = CDate(AuthorityDate)
                auth.AuthorityLimits = AuthorityLimits
                auth.DispatcherName = DispatcherName
                auth.IssueTo = IssueTo
                auth.UntilTime = CDate(UntilTime)
                auth.AuthorityType = "TT"
                auth.TerritoryAssignment = Me.TerritoryID
                Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(Mid(IssueTo, 1, 10))
                If trn IsNot Nothing Then
                    auth.IssuedToTrain = True
                    auth.TrainSymbol = trn.Name
                End If

                If Not auth.TrackAuthorityDuplicateCheckByUID() Then Exit Sub

                Dim GUIDs() As String = Components.Split("-")
                Dim strGUID As String
                For Each strGUID In GUIDs
                    If IsNumeric(strGUID) Then
                        Dim compToBlock As Object = FindComponent(CInt(strGUID))
                        If Not compToBlock Is Nothing Then
                            If compToBlock.GetType.ToString = gTrackComponentName Then
                                Dim trk As Track = CType(compToBlock, Track)
                                If optApplyConfigurationForKCT AndAlso trk.IsShadowRemoteTrack Then
                                ElseIf trk.IsControlled Then
                                    Exit Sub
                                End If
                                'If trk.IsControlled Then Exit Sub
                            End If
                            auth.ComponentsInSelection.Add(compToBlock)
                        End If
                    End If
                Next

                Dim comp As Object
                For Each comp In auth.ComponentsInSelection
                    comp.BlockAbsolute = True
                    If comp.TrackAuthorityDuplicateCheck(auth) Then
                        If Not comp.TrackAuthorities.Contains(auth) Then comp.TrackAuthorities.Add(auth)
                    End If
                    'comp.TrackAuthorities.Add(auth)
                    comp.TrackAndTime = True
                    comp.UpdateStatus()
                Next
                If auth.TrackAuthorityDuplicateCheck Then
                    If Not TMDS.GlobalDeclarations.OtherTrackAuthorities.Contains(auth) Then OtherTrackAuthorities.Add(auth)
                Else
                    Exit Sub
                End If
                'OtherTrackAuthorities.Add(auth)
                Dim SummItem As New SummaryItem("AUTHORITY", "ADD", auth)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock

                'Message = Message & "|" & Me.AuthorityUID 3
                'Message = Message & "|" & Me.AuthorityDate 4
                'Message = Message & "|" & Me.AuthorityLimits 5
                'Message = Message & "|" & Me.DispatcherName 6
                'Message = Message & "|" & Me.IssueTo 7
                'Message = Message & "|" & Me.JointAuthority 8
                'Message = Message & "|" & Me.UntilTime 9
                'Dim comp As Object
                'Dim CompList As String
                'For Each comp In Me.ComponentsInSelection
                '    CompList = CompList & "-" & comp.GUID
                'Next
                'Message = Message & "|COMPONENTS" & CompList 10
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

