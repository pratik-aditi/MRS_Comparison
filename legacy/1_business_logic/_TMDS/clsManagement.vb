        ''' <summary>
        ''' Alert Crew
        ''' </summary>
        ''' <param name="messageToProcess"></param>
        Public Shared Sub AlertCrew(ByVal messageToProcess As String)
            Try
                SystemEvent("AlertCrew:" & messageToProcess)

                Dim DataString() As String = messageToProcess.Split(";")
                Dim Symbol As String = DataString(1)
                Dim CrewCurrent1 As String = DataString(2)
                Dim CrewCurrent2 As String = DataString(3)
                Dim DateBeginCrewCurrent As String = DataString(4)
                Dim DateEndCrewCurrent As String = DataString(5)
                Dim CrewNext1 As String = DataString(6)
                Dim CrewNext2 As String = DataString(7)
                Dim DateBeginCrewNext As String = DataString(8)
                Dim DateEndCrewNext As String = DataString(9)
                Dim Message As String = DataString(10)

                'Find train id
                Dim Train As TrainID = FindTrainID(Symbol)

                If Not IsNothing(Train) Then

                    If Train.IsActivePTC Then
                        'Sent text msg to onboard
                        SendTextMessage(Train, Message)
                    Else
                        SystemEvent("AlertCrew: Train is not actived " & Symbol)
                    End If

                    'Update object train
                    Train.CrewCurrent.Engineer.NameOfPerson = CrewCurrent1.TrimEnd
                    Train.CrewCurrent.Engineer.OnDutyTime = TMDS.SystemUtilities.Formatting.FormatDateString(DateBeginCrewCurrent)
                    Train.CrewCurrent.Engineer.HOS = TMDS.SystemUtilities.Formatting.FormatDateString(DateEndCrewCurrent)
                    Train.CrewCurrent.Conductor.NameOfPerson = CrewCurrent2.TrimEnd
                    Train.CrewCurrent.Conductor.OnDutyTime = TMDS.SystemUtilities.Formatting.FormatDateString(DateBeginCrewCurrent)
                    Train.CrewCurrent.Conductor.HOS = TMDS.SystemUtilities.Formatting.FormatDateString(DateEndCrewCurrent)

                    Train.CrewRelief.Engineer.NameOfPerson = CrewNext1.TrimEnd
                    Train.CrewRelief.Engineer.OnDutyTime = TMDS.SystemUtilities.Formatting.FormatDateString(DateBeginCrewNext)
                    Train.CrewRelief.Engineer.HOS = TMDS.SystemUtilities.Formatting.FormatDateString(DateEndCrewNext)
                    Train.CrewRelief.Conductor.NameOfPerson = CrewNext2.TrimEnd
                    Train.CrewRelief.Conductor.OnDutyTime = TMDS.SystemUtilities.Formatting.FormatDateString(DateBeginCrewNext)
                    Train.CrewRelief.Conductor.HOS = TMDS.SystemUtilities.Formatting.FormatDateString(DateEndCrewNext)

                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Train.TrackGUID)

                    If Not trk Is Nothing Then
                        SystemEvent("AlertCrew:Track:" & Train.TrackGUID)
                        'Update db

                        Train.CrewCurrentString = Train.CrewCurrent.CreateCrewString
                        Train.CrewPendingString = Train.CrewPending.CreateCrewString
                        Train.CrewReliefString = Train.CrewRelief.CreateCrewString

                        Train.CrewCurrent.ApplyCrewString(Train.CrewCurrentString)
                        Train.CrewPending.ApplyCrewString(Train.CrewPendingString)
                        Train.CrewRelief.ApplyCrewString(Train.CrewReliefString)



                        Train.DoUpdateTrainIDIntoDatabase(trk)
                        Dim SummItem As New SummaryItem("TRAIN", "UPDATE-CREW", Train)
                        SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                            TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                        End SyncLock
                        Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf Train.PublishTrainEvent)
                        PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)
                    Else
                        SystemEvent("AlertCrew:Track not found:" & Train.TrackGUID)
                    End If

                    'Create alert for dispatcher
                    Dim al As Alert = TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.Crew, Message, Train)
                    al.Critical = True
                Else
                    SystemEvent("AlertCrew: Can't find train " & Symbol)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Record event
        ''' </summary>
        ''' <param name="pType"></param>
        ''' <param name="pTerritory"></param>
        ''' <param name="pMessage"></param>
        Public Shared Sub RecordEvent(ByVal pType As String, ByVal pTerritory As String, ByVal pMessage As String)
            Try
                SystemEvent("RecordEvent:Type:" & pType & "-Territory:" & pTerritory & "-Message:" & pMessage)
                Dim SQLQuery As New StringBuilder
                Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.UserFullName
                Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                With SQLQuery
                    .Append("INSERT INTO tblSystemEvents")
                    .Append("( ")
                    .Append("[EventTime]")
                    .Append(",[Territory]")
                    .Append(",[Wrkstn]")
                    .Append(",[SysUser]")
                    .Append(",[DbVer]")
                    .Append(",[FuncType]")
                    .Append(",[UID]")
                    .Append(",[Event]")
                    .Append(",[SysData]")
                    .Append(")")
                    .Append("VALUES")
                    .Append("( ")
                    .Append("'" & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & "'")
                    .Append("," & pTerritory)
                    .Append("," & CurWrkstn)
                    .Append(",'" & CurUser & "'")
                    .Append(",''")
                    .Append(",'ALERT'")
                    .Append(",0")
                    .Append(",'" & pType & "'")
                    .Append(",'" & pMessage & "'")
                    .Append(" )")
                End With

                SyncLock gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(SQLQuery.ToString)
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

