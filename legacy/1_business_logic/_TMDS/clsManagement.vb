        Public Shared Sub ProcessTrainConsist(ByVal messageToProcess As String)
            Try
                DebugEvent("ProcessTrainConsist:" & messageToProcess)

                Dim DataString() As String = messageToProcess.Split(";")
                If DataString.Length >= 15 Then
                    Dim TrainLengthChange As Boolean
                    Dim ChangeTrainLength As Boolean
                    Dim MessageList As New ArrayList()
                    Dim Symbol As String = DataString(1)
                    Dim TotalCar As String = DataString(2)
                    Dim Loads As String = DataString(3)
                    Dim Emts As String = DataString(4)
                    Dim Tons As String = DataString(5)
                    Dim Length As String = DataString(6)
                    Dim MaxSpd As String = DataString(7)

                    Dim HW As Boolean = CBool(DataString(8))
                    Dim Key As Boolean = CBool(DataString(9))
                    Dim Haz As Boolean = CBool(DataString(10))

                    Dim EOT As String = DataString(11)
                    Dim HPT As String = DataString(12)
                    Dim TPOB As String = DataString(13)
                    Dim TotalHP As String = DataString(14)

                    Dim trn As TrainID = Nothing
                    Dim FoundTrain As TrainID = Nothing
                    For Each trn In TMDS.GlobalDeclarations.TrainCollection
                        If trn.Name = Symbol Then
                            FoundTrain = trn
                            Exit For
                        End If
                    Next

                    If Not FoundTrain Is Nothing Then
                        If IsNumeric(Length) Then
                            Dim LenLong As Int32 = Length + 200
                            Dim LenShort As Int32 = Length - 200

                            If (LenLong <= trn.OLength) Then
                                TrainLengthChange = True
                            End If

                            If (LenShort > trn.OLength) Then
                                TrainLengthChange = True
                            End If

                            If Length <> trn.OLength Then
                                ChangeTrainLength = True
                            End If
                            If ChangeTrainLength And Not TrainLengthChange Then
                                trn.OLength = Length
                            End If
                        End If

                        Dim iLds As Integer
                        Dim iEmt As Integer
                        Dim iTon As Integer
                        Dim iMsd As Integer
                        If IsNumeric(Loads) Then
                            iLds = CInt(Loads)
                        End If

                        If IsNumeric(Tons) Then
                            iTon = CInt(Tons)
                        End If

                        If IsNumeric(Emts) Then
                            iEmt = CInt(Emts)
                        End If

                        If IsNumeric(MaxSpd) Then
                            iMsd = CInt(MaxSpd)
                        End If

                        Dim ConsistChange As Boolean
                        If FoundTrain.TrainConsistChangeCheck(iLds, iEmt, CInt(Length), iTon, True) Then
                            ConsistChange = True
                        End If

                        If iLds <> FoundTrain.OLoads Then
                            FoundTrain.OLoads = iLds
                        End If

                        If iTon <> FoundTrain.OTons Then
                            FoundTrain.OTons = iTon
                        End If

                        If iEmt <> FoundTrain.OEmts Then
                            FoundTrain.OEmts = iEmt
                        End If

                        If IsNumeric(MaxSpd) Then
                            FoundTrain.MaxSpd = CInt(MaxSpd)
                        End If


                        If TrainLengthChange Then
                            FoundTrain.OLength = CInt(Length)

                            Dim trk1 As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FoundTrain.TrackGUID)

                            If Not IsNothing(trk1) Then
                                FoundTrain.DoUpdateTrainIDIntoDatabase(trk1)
                                Dim SummItem As New SummaryItem("TRAIN", "CONSIST", FoundTrain)
                                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                                End SyncLock

                                Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf FoundTrain.PublishTrainEvent)
                                PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)

                                TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.TrainLengthChanged, messageToProcess, FoundTrain, Nothing)
                            End If
                        End If


                        FoundTrain.HazMat = Haz
                        FoundTrain.KeyTrain = Key
                        FoundTrain.HighWide = HW
                        FoundTrain.EOTD = EOT
                        If IsNumeric(HPT) Then FoundTrain.HorsePowerTrailing = HPT
                        If IsNumeric(TPOB) Then FoundTrain.TonsPerOperativeBrake = CInt(TPOB)
                        If IsNumeric(TotalHP) Then FoundTrain.TotalHorsePower = CInt(TotalHP)
                        Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FoundTrain.TrackGUID)

                        If Not trk Is Nothing Then
                            FoundTrain.DoUpdateTrainIDIntoDatabase(trk)
                            Dim SummItem As New SummaryItem("TRAIN", "UPDATE-NAME", FoundTrain)
                            SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                                TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                            End SyncLock

                            Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf FoundTrain.PublishTrainEvent)
                            PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)
                        End If
                    End If
                End If

                DebugEvent("TRAIN CONSIST MESSAGE PROCESSED FROM COMMUNICATION CHANNEL:" & messageToProcess)


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

