        Private Shared Function IsValidToGPSTrackForFXE(thistrain As TrainID, trk As Track, LocoUID As String) As Boolean
            Dim Message As New ArrayList
            Dim OkToTrack As Boolean = True
            Dim s As String = ""
            Dim STRBLDR As New StringBuilder
            Try

                If thistrain Is Nothing Then Message.Add("INVALID TRAIN") : OkToTrack = False
                If OkToTrack AndAlso trk Is Nothing Then Message.Add("INVALID TRACK") : OkToTrack = False
                If OkToTrack AndAlso LocoUID Is Nothing Then Message.Add("INVALID ENGINEID") : OkToTrack = False
                If OkToTrack AndAlso LocoUID.Trim = "" Then Message.Add("INVALID ENGINEID") : OkToTrack = False
                Message.Add("***************************************")
                Message.Add("GPS TRACKING FOR TRAIN " & thistrain.Name & " TRACK GUID: " & trk.GUID & " ENGINE ID: " & LocoUID)

                If OkToTrack AndAlso Mid(trk.AuthorityType, 1, 1) <> "TWC" Then Message.Add("INVALID TRACK AUTHORITY TYPE") : OkToTrack = False
                If OkToTrack AndAlso Not TMDS.SystemUtilities.FetchData.IsMainTypeTrack(trk) Then Message.Add("NON MAIN TRACK - " & trk.AuthorityType.Trim) : OkToTrack = False
                If OkToTrack AndAlso Mid(trk.AuthorityType, 1, 1) = "CTC" Then Message.Add("CTC TRACK ") : OkToTrack = False

                If trk IsNot Nothing Then
                    Select Case trk.TrackName.Trim.ToUpper
                        Case "MAIN", "PRINCIPAL"
                            If LocoUID.Trim = String.Empty Then Exit Function
                            If Mid(trk.AuthorityType, 1, 3).Trim.ToUpper = "TWC" Then
                                Message.Add("GPS TRACKING-TRACK-TWC:" & trk.Name & ":" & trk.GUID)
                                Dim a As Object
                                For Each a In TMDS.GlobalDeclarations.OtherTrackAuthorities
                                    If a.GetType.ToString = gSFAComponentName AndAlso a.IssuedToTrain AndAlso a.IssueTo.Contains(LocoUID) Then
                                        Dim auth As SFAuthority = CType(a, SFAuthority)
                                        If Not auth.Components.Contains(trk) Then
                                            Message.Add("GPS TRACKING-ForceIgnoreTracking-Track Not Found in Authority:" & trk.GUID)
                                            OkToTrack = False
                                        ElseIf auth.Components.Contains(trk) Then
                                            Message.Add("GPS TRACKING-TRACK FOUND IN TWC:" & trk.Name & ":" & trk.GUID)
                                        End If
                                    End If
                                Next
                            End If
                        Case Else
                            Message.Add("GPS TRACKING-RECVD FOR:" & trk.Name & ":" & trk.GUID & " IGNORING GPS TRACKING")
                            OkToTrack = False
                    End Select
                End If
                Message.Add("***************************************")
                If Message IsNot Nothing AndAlso Message.Count > 0 Then
                    For Each s In Message
                        STRBLDR.Append(s & vbCrLf)
                    Next
                    SystemEvent(STRBLDR.ToString)
                End If
                Return OkToTrack


            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                Message = Nothing
            End Try

        End Function


    End Class



