                        If CheckForDupMOW(.FirstName, .LastName) Then
                            If .Initials.Trim <> "" Then
                                If optUseFirstLastNameFormat Then
                                    .Name = .FirstName.ToUpper.Trim & Space(1) & .Initials.ToUpper.Trim & Space(1) & .LastName.ToUpper.Trim
                                Else
                                    .Name = .LastName.ToUpper.Trim & Space(1) & .Initials.ToUpper.Trim & Space(1) & .FirstName.ToUpper.Trim
                                End If
                            Else
                                If optUseFirstLastNameFormat Then
                                    .Name = .FirstName.ToUpper.Trim & Space(1) & .LastName.ToUpper.Trim
                                Else
                                    .Name = .LastName.ToUpper.Trim & Space(1) & .FirstName.ToUpper.Trim
                                End If
