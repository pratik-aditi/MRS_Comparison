                        TaskDetails = "REQUEST AUTHORITY ROLLUP FROM TRAIN (" & Me.myTrain.Name & ") EMPLOYEE (" & data(5) & ") AUTHORITY NUMBER (" & data(1) & ")"
                        AlertMessage = "AUTHORITY ROLLUP REQUEST FROM TRAIN CREW FOR (" & Me.myTrain.Name & ") AUTHORITY NUMBER (" & data(1) & "). PLEASE VERIFY"
                        ShowAlertForCrewRequest = True

                    Case "IETMS-AUTHORITY-RELEASE-REQUEST"
