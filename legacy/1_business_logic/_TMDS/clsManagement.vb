                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                dbcomm = New OleDbCommand(query.ToString, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    Do Until PoolNumber > 13
                        PoolNumber += 1
                        Dim np As New NumberPool
                        np.myNumberColumnName = dr.GetName(ColumnCounter)
                        np.myRangeColumnName = dr.GetName(ColumnCounter + 1)
                        np.myFactorColumnName = dr.GetName(ColumnCounter + 2)
                        ColumnCounter = ColumnCounter + 3

                        np.myLockColumnName = dr.GetName(LockColumnCounter)
                        LockColumnCounter += 1

                        Select Case np.myNumberColumnName
                            Case "BullNumbrSR1"
                                np.myPoolNumberType = PoolNumberTypes.SpeedRestriction
                                np.myRange = 1000 : np.myFactor = 999 : np.myNumber = 1000

                            Case "BullNumbrSR2"
                                np.myPoolNumberType = PoolNumberTypes.TrackOutOfService
                                np.myRange = 7000 : np.myFactor = 999 : np.myNumber = 7000

                            Case "BullNumbrSR3"
                                np.myPoolNumberType = PoolNumberTypes.SlideZone
                                np.myRange = 8000 : np.myFactor = 999 : np.myNumber = 8000

                            Case "BullNumbrWZ1"
                                np.myPoolNumberType = PoolNumberTypes.WorkZone
                                np.myRange = 2000 : np.myFactor = 999 : np.myNumber = 2000

                            Case "BullNumbrWZ2"
                                np.myPoolNumberType = PoolNumberTypes.FlagMan
                                np.myRange = 20000 : np.myFactor = 999 : np.myNumber = 20000

                            Case "BullNumbrINF1"
                                np.myPoolNumberType = PoolNumberTypes.Informational
                                np.myRange = 3000 : np.myFactor = 999 : np.myNumber = 3000

                            Case "BullNumbrINF2"
                                np.myPoolNumberType = PoolNumberTypes.TrackTag
                                np.myRange = 9000 : np.myFactor = 999 : np.myNumber = 9000

                            Case "BullNumbrINF3"
                                np.myPoolNumberType = PoolNumberTypes.TrackConditionMessage
                                np.myRange = 11000 : np.myFactor = 999 : np.myNumber = 11000

                            Case "BullNumbrXING1"
                                np.myPoolNumberType = PoolNumberTypes.CrossingProtection
                                np.myRange = 4000 : np.myFactor = 999 : np.myNumber = 4000
                            Case "BullNumbrXING2"
                                np.myPoolNumberType = PoolNumberTypes.CrossingProtection
                                np.myRange = 40000 : np.myFactor = 999 : np.myNumber = 40000

                            Case "AuthNumber1"
                                np.myPoolNumberType = PoolNumberTypes.TrackAndTime
                                np.myRange = 5000 : np.myFactor = 999 : np.myNumber = 5000
                                np.myTableColumnName = "AuthorityUID" : np.myTableName = "tblAuthoritiesActive"

                            Case "AuthNumber2"
                                np.myPoolNumberType = PoolNumberTypes.TrackWarrant
                                np.myRange = 6000 : np.myFactor = 999 : np.myNumber = 6000
                                np.myTableColumnName = "AuthorityUID" : np.myTableName = "tblAuthoritiesSingleFormActive"

