        Private Function CheckForDuplicates(ByVal NumToCheck As Int32) As Boolean
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Query As String = "SELECT RestrictionUID FROM tblSystemBulletins WHERE (RestrictionSubName = N'" & Me.Name & "') AND (RestrictionUID = " & NumToCheck & ")"
            Dim NumExists As Boolean
            Try
                dbconn = New OleDbConnection(gConnectionStringDynamic)
                dbconn.Open()
                dbcomm = New OleDbCommand(Query, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    If Not dr.IsDBNull(0) Then
                        If dr.GetInt32(0) = NumToCheck Then
                            NumExists = True
                            Exit While
                        End If
                    End If
                End While
                dbconn.Close()
                dbconn = Nothing
                Return NumExists

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Function

