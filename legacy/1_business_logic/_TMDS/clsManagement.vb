                For Each Item In ConsoleAssignmentString
                    Dim Assignment() As String = Item.Split("|")
                    If Assignment.Length > 0 Then
                        If Not IsNumeric(Assignment(0)) Then
                            If Assignment(0).ToUpper <> "NONE" Then
