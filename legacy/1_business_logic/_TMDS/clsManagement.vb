        Public Function GetNumberForCPTB() As String
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim SQLQuery As New StringBuilder
            Dim BullNumber As Int32
            Dim BullRange As Int32
            Dim BullFactor As Int32
            Dim Unique As Boolean = False
            Dim bull As Object = Nothing
            Dim ContinueUniqueSearch As Boolean = False
            Dim counter As Integer
            Dim NextBulletinNumber As String = String.Empty
            Dim LoopControl As Integer
            Dim MissingTBNumberSearchLoop As Boolean = False
            'Public gTBNumberingColumn As String = "BullNumbrINF1"
            'Public gTBNumberRangeColumn As String = "BullRangeINF1"
            'Public gTBNumberFactorColumn As String = "BullFactorINF1"
            Try
                With SQLQuery
                    .Append("SELECT ")
                    .Append(gCPTBNumberingColumn)
                    .Append(" , " & gCPTBNumberRangeColumn)
                    .Append(" , " & gCPTBNumberFactorColumn)
                    .Append("  FROM ")
                    .Append(" " & gCPTBNumberingTable & " ")
                    .Append(" WHERE UID = " & Me.GUID)
                End With
                Using DbConn As New OleDbConnection(gConnectionStringStatic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery.ToString, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        If Not dr.IsDBNull(0) Then
                            BullNumber = dr.GetInt32(0)
                        End If
                        If Not dr.IsDBNull(1) Then
                            BullRange = dr.GetInt32(1)
                        End If
                        If Not dr.IsDBNull(2) Then
                            BullFactor = dr.GetInt32(2)
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using

                While Not Unique
                    If BullNumber >= BullRange + BullFactor Then
                        BullNumber = BullRange
                    Else
                        If BullNumber = 0 Then
                            BullNumber = BullRange
                        End If
                        BullNumber = BullNumber + 1
                    End If


                    For Each bull In BulletinCollection
                        If bull.GetType.ToString = gSubBulletinName Then
                            If bull.myUID.Trim = BullNumber.ToString.Trim Then
                                ContinueUniqueSearch = True
                                counter = 0
                                Exit For
                            End If
                        Else
                            If bull.BullNumber = BullNumber Then
                                ContinueUniqueSearch = True
                                counter = 0
                                Exit For
                            End If
                        End If

                        counter = counter + 1
                        If counter = BulletinCollection.Count Then
                            ContinueUniqueSearch = False
                        End If
                    Next


                    If Not ContinueUniqueSearch Then
                        If CheckForDuplicates(BullNumber) Then
                            ContinueUniqueSearch = True
                            counter = 0
                        End If
                    End If

                    If Not ContinueUniqueSearch Then
                        Unique = True
                        NextBulletinNumber = BullNumber
                        UpdateBulletinNumber(TMDS.GlobalDeclarations.gDatabaseConnectionStatic, gCPTBNumberingColumn, BullNumber)
                    End If
                    LoopControl += 1
                    If LoopControl >= (BullFactor) Then
                        'If MissingTBNumberSearchLoop Then
                        NextBulletinNumber = 0
                        Exit While
                        'Else
                        '    MissingTBNumberSearchLoop = True
                        '    NextBulletinNumber = 0
                        '    LoopControl = 0
                        '    BullNumber = BullRange
                        '    Exit While
                        'End If
                    End If
                End While

                Return NextBulletinNumber

            Catch ex As Exception
                SystemException(ex.ToString)
                Return 0
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
                bull = Nothing
            End Try

        End Function

