        ''' <summary>
        ''' Processes locomotive position reports received from VETMS.
        ''' This method extracts data from a formatted string, updates locomotive status, 
        ''' and integrates tracking information for operational purposes.
        ''' </summary>
        ''' <param name="data">A formatted string containing locomotive position details.</param>
        ''' <remarks>
        ''' The function handles various train operational aspects, including:
        ''' <list type="bullet">
        '''   <item>Extracting locomotive identity and movement details.</item>
        '''   <item>Determining whether tracking should be enabled.</item>
        '''   <item>Validating locomotive state and assigning to trains.</item>
        '''   <item>Logging critical information for diagnostics.</item>
        ''' </list>
        ''' Example Message:
        ''' ACTIVE|T01-1234|RUMO  1234|11/29/2024 10: 46:57 AM|INCREASING MILEPOSTS|80.003||77.9891||
        ''' 2|2|00|ACTIVE|CONTROLLING|N|VIA 2|VIA 2|00000000|JOHN|DOE|||||0|2024-11-29    13:46:55|FALSE
        ''' STATUS|TRAIN SYMBOL|LOCO ID|DATETIME|DIRECTION|BEGIN MP|BEGIN SUFFIX|END MP|END SUFFIX|
        ''' BEGIN SUBDIV|END SUBDIV|SPEED|STATE|SUB STATE|N|BEGIN NAME|END NAME|EMPLOYEE ID|EMPLOYEE FIRST NAME|
        ''' EMPLOYEE LAST NAME|BEGIN PREFIX|END PREFIX
        ''' </remarks>
        Public Shared Sub ProcessLocomotivePostionReportVETMS(data As String)
            Try
                If data.IsNullOrEmpty OrElse Not gInitialized Then Exit Sub
                Dim dataString() As String = data.Split("|")
                If dataString.GetUpperBound(0) <= 7 Then
                    SystemEvent($"{GetCurrentMethod.Name} Bad message")
                    Exit Sub
                End If
                Dim isShadowModeTrain As Boolean = False
                Dim symbol As String = dataString(1)
                Dim locoUID As String = dataString(2)
                Dim statusDate As Date = Convert.ToDateTime(dataString(3), CultureInfo.GetCultureInfo("en-US"))
                Dim direction As String = dataString(4)
                Dim startTrackMP As String = dataString(5)
                Dim startTrackMPSuffix As String = dataString(6)
                Dim endTrackMP As String = dataString(7)
                Dim endTrackMPSuffix As String = dataString(8)
                Dim trackingEnabled As String = dataString(9)
                Dim startTrackSubdivisionId As Integer
                Dim endTrackSubdivisionId As Integer
                'Tracking enabled field was discontinued
                If IsNumeric(trackingEnabled) Then
                    trackingEnabled = "N"
                    startTrackSubdivisionId = Convert.ToInt32(dataString(9))
                    endTrackSubdivisionId = Convert.ToInt32(dataString(10))
                Else
                    startTrackSubdivisionId = Convert.ToInt32(dataString(10))
                    endTrackSubdivisionId = startTrackSubdivisionId
                End If
                Dim speed As String = dataString(11)
                Dim locoState As String = dataString(12)
                Dim locoSubState As String = dataString(13)
                Dim locoOutOfComm As String = dataString(14)
                Dim startTrackName As String = dataString(15)
                Dim endTrackName As String = dataString(16)
                Dim startTrackMPPreFix As String = dataString(20).Trim.ToUpper
                Dim endTrackMPPreFix As String = dataString(21).Trim.ToUpper
                Dim locomotive As MobileTracking.Locomotive = FindLocomotive(locoUID, symbol)
                If locomotive Is Nothing Then
                    SystemEvent($"{GetCurrentMethod.Name} Locomotive {locoUID} not found")
                    Exit Sub
                End If
                With locomotive
                    Dim train As TrainID = FindTrainBySymbol(symbol)
                    If train Is Nothing Then
                        SystemEvent($"{GetCurrentMethod.Name} Train {symbol} not found")
                        Exit Sub
                    End If
                    .myTrainID = train
                    .PositionRequested = False
                    .ReportTime = statusDate
                    .Symbol = symbol.Trim
                    .LocomotiveID = locoUID.Trim
                    .DirectionOfTravel = direction
                    Dim beginTrack As Track = GetTrack(startTrackMP, startTrackMPSuffix, startTrackMPPreFix,
                                                       startTrackName, startTrackSubdivisionId)
                    If beginTrack IsNot Nothing Then
                        If gEnablePTCVETMSTrackingOnCTC Then
                            If Not beginTrack.AuthorityType.ToUpper.Trim.Contains("CTC") Then trackingEnabled = "Y"
                        End If
                        If gEnablePTCVETMSTrackingOnYardLimits Then
                            If beginTrack.AuthorityType.ToUpper.Trim.Contains("YL") Then trackingEnabled = "Y"
                        End If
                        If trackingEnabled = "N" Then
                            If beginTrack.AuthorityType.ToUpper.Trim.Contains("TWC") Then trackingEnabled = "Y"
                        End If
                        If Not isShadowModeTrain AndAlso trackingEnabled.Trim.ToUpper = "Y" Then PositionTrain(beginTrack, symbol.Trim)
                        .thisCurrentTrack = beginTrack
                        .TrackGUID = beginTrack.GUID 'CInt(StartTrackGUID)
                        .TrackName = beginTrack.TrackName ' FindCompFromGUID(162108).TrackName
                    End If
                    .Subdivision = FetchData.FindSubdivisionNameFromPTCUID(startTrackSubdivisionId)
                    Dim endTrack As Track = GetTrack(endTrackMP, endTrackMPSuffix, endTrackMPPreFix,
                                                   endTrackName, endTrackSubdivisionId)
                    If endTrack IsNot Nothing Then
                        .EndTrack = endTrack
                        .EndTrackGUID = endTrack.GUID
                    End If
                    .MilePost = startTrackMP
                    .MilePostSuffix = startTrackMPSuffix
                    .MilePostPrefix = startTrackMPPreFix
                    .MilePostTrackName = startTrackName
                    .EndMilePost = endTrackMP
                    .EndMilePostTrackName = endTrackName
                    .EndMilePostSuffix = endTrackMPSuffix
                    .EndMilePostPrefix = endTrackMPPreFix
                    If Not speed.IsNullOrWhiteSpace Then .Speed = Convert.ToInt32(speed)
                    .CutInState = False
                    .CutOutState = False
                    .PTCCapable = True
                    Select Case locoState
                        Case "ACTIVE", "ACTIVE-STOPPED", "ACTIVE-BRAKING", "DISENGAGED"
                            .CutInState = True
                            .CutOutState = False
                        Case "CUT OUT"
                            .CutInState = False
                            .CutOutState = True
                        Case Else
                            .CutInState = False
                            .CutOutState = False
                    End Select
                    .LocosubState = (locoSubState.Trim.ToUpper)
                    If .myTrainID IsNot Nothing Then
                        If locoSubState = "CONTROLLING" Then
                            .myTrainID.PTCStatus = "ACTIVE"
                            .myTrainID.UpdatePTCStatus("ACTIVE")
                        Else
                            .myTrainID.PTCStatus = "INACTIVE"
                            .myTrainID.UpdatePTCStatus("INACTIVE")
                        End If
                        If IsNothing(.myTrainID.myLocomotiveReport) Then
                            .myTrainID.myLocomotiveReport = locomotive
                        End If
                        .myTrainID.MilePost = .MilePost
                        .myTrainID.MilePostSuffix = .MilePostSuffix
                        .myTrainID.MilePostPrefix = .MilePostPrefix
                        .myTrainID.EndMilePost = .EndMilePost
                        .myTrainID.EndMilePostSuffix = .EndMilePostSuffix
                        .myTrainID.EndMilePostPrefix = .EndMilePostPrefix
                        .myTrainID.Speed = .Speed
                        .myTrainID.PositionReportTime = .ReportTime
                        .myTrainID.PTCSubStatus = locoState
                        Dim publishThisEvent As New DoPublishTrainEvent(AddressOf .myTrainID.PublishTrainEvent)
                        publishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)
                        .myTrainID.UpdateLocoMISInformation(locomotive)
                    End If
                    If trackingEnabled.Trim.ToUpper = "Y" Then .TrackingEnabled = True Else .TrackingEnabled = False
                    If locoOutOfComm.Trim.ToUpper = "Y" Then .OutOfComm = True Else .OutOfComm = False
                    .OutOfCommMins = 0
                    .LocosubState = locoSubState.Trim.ToUpper
                    .LocoStatusID = locoState
                    If Not isShadowModeTrain Then .ProcessPositionReportForTrainTracking()
                End With
                If Not locomotive.myTrainID Is Nothing Then
                    SystemEvent("ProcessLocomotivePostionReportVETMS:TRAIN FOUND " & locomotive.myTrainID.Name)
                    With locomotive.myTrainID
                        If locomotive.LocomotiveID = .IdentifingUnit Then
                            .TrainIDColor = locomotive.LocomotiveIDColor
                        End If
                        If locomotive.PTCCapable And locomotive.OutOfComm Then
                            .ShowFailure = True
                        Else
                            .ShowFailure = False
                        End If
                        .Speed = locomotive.Speed
                    End With
                    Dim SummItem2 As New SummaryItem("TRAIN", "UPDATE", locomotive.myTrainID)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem2)
                    End SyncLock
                    If locomotive.PTCCapable Then
                        Dim SummItem As New SummaryItem("LOCOMOTIVE", "LOCO-STATUS", locomotive)
                        SyncLock gLocomotiveSummaryQueue.SyncRoot
                            gLocomotiveSummaryQueue.Enqueue(SummItem)
                        End SyncLock
                    End If
                    If optEnableShadowMode AndAlso Not isShadowModeTrain Then
                        Dim publishThisEvent As New DoPublishTrainEvent(AddressOf locomotive.myTrainID.PublishTrainEvent)
                        publishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)
                    End If
                Else
                    SystemEvent("ProcessLocomotivePostionReportVETMS:TRAIN NOT FOUND:" & symbol)
                End If
                If isShadowModeTrain Then Exit Sub
                If locomotive.CutOutState Or locoSubState = "CUT OUT" Then
                    Dim Auth As Object = Nothing
                    Try
                        For Each Auth In OtherTrackAuthorities
                            If Not Auth Is Nothing Then
                                Select Case Auth.GetType.ToString
                                    Case gSFAComponentName
                                        If Auth.PTCAuthorityACKPending.Trim <> String.Empty Then
                                            If Mid(Auth.IssueTo, 1, 10) = Mid(locomotive.LocomotiveID, 1, 10) Then

                                                Auth.FlasherMode(False, True)
                                                Auth.PTCAuthorityACKPending = ""
                                            End If
                                        End If
                                    Case gTTComponentName
                                        If Auth.PTCAuthorityACKPending.Trim <> String.Empty Then
                                            If Mid(Auth.IssueTo, 1, 10) = Mid(locomotive.LocomotiveID, 1, 10) Then
                                                Auth.FlasherMode(False, True)
                                            End If
                                        End If
                                End Select
                            End If
                        Next
                        Auth = Nothing
                        For Each Auth In TMDS.GlobalDeclarations.gOtherSpecialAuthorityCollection
                            If Not Auth Is Nothing AndAlso Auth.GetType.ToString = gOtherSplAuthorityName Then
                                If Mid(Auth.IssueTo, 1, 10) = Mid(locomotive.LocomotiveID, 1, 10) Then
                                    If Auth.PTCAuthorityACKPending = PTCAuthorityACKPendingStatus.PENDINGRELEASE.ToString Then
                                        Auth.FlasherMode(False, True)
                                        Auth.DoPSSPerformRelease()
                                    End If
                                End If
                            End If
                        Next
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    Finally
                        Auth = Nothing
                    End Try
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

