#Region "VETMS MESSAGES"
        Private Delegate Sub DoPublishTrainEvent(ByVal EventType As TrainID.EventTypeTrainID)
        Private Delegate Sub DoEventLogTrainID(ByVal EventType As TrainID.EventTypeTrainID)

        Public Shared Sub ProcessDeliveryConfirmationVETMS(ByVal MessageType As String, ByVal data As String)
            Try
                Dim sfa As SFAuthority = Nothing
                Dim auth As TrackAuthority.TrackAuthority = Nothing
                Dim OtherAuth As OtherSpecialAuthorityType = Nothing
                Dim TrackTimeTypeAuth As Boolean
                Dim Messages() As String = data.Split("|")
                Dim MessageResponse As String = Messages(0)
                Dim AuthNum As String = Messages(1)
                Dim MessUID As String = String.Empty
                Dim LocoUID As String = String.Empty
                Dim trn As TrainID = Nothing
                Dim theTag As Tag = Nothing
                Dim theBull As SubBulletin = Nothing
                If Messages.Length >= 4 Then
                    LocoUID = Messages(2)
                    MessUID = Messages(3)
                End If
                If Mid(MessageType, 1, 3) = "MA-" Then
                    SystemEvent("ProcessDeliveryConfirmationVETMS:AuthNum=" & AuthNum)
                    sfa = TMDS.SystemUtilities.FetchData.FindSFA(AuthNum)
                    auth = TMDS.SystemUtilities.FetchData.FindAuthority(AuthNum)
                    OtherAuth = TMDS.SystemUtilities.FetchData.FindOtherAuthority(AuthNum)
                    If Not IsNothing(auth) Then
                        TrackTimeTypeAuth = True
                        trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(auth.TrainSymbol)
                    ElseIf LocoUID <> String.Empty AndAlso OtherAuth Is Nothing Then
                        'RMT554-Issues in delivery confirmation to 1051 msg
                        'Workaround when auth is not found
                        'jcosta-3/21/17
                        Dim trnaux As TrainID
                        For Each trnaux In TMDS.GlobalDeclarations.TrainCollection
                            If trnaux.IdentifingUnit = LocoUID AndAlso trnaux.thisCurrentLicense IsNot Nothing Then
                                trn = trnaux
                                auth = trnaux.thisCurrentLicense
                                SystemEvent("ProcessDeliveryConfirmationVETMS:AUTHORITY FOUND PER UNIT:" & LocoUID & "-AUTHMSG:" & AuthNum & "-TRAINID:" & trn.Name & "-AUTHFOUND:" & auth.AuthorityNumber.ToString)
                            End If
                        Next
                    End If
                    If IsNothing(sfa) And IsNothing(auth) And IsNothing(OtherAuth) Then
                        SystemEvent("ProcessDeliveryConfirmationVETMS:AUTHORITY NOT FOUND=" & data)
                        Exit Sub
                    Else
                        If sfa IsNot Nothing Then
                            trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(sfa.TrainSymbol)
                            If trn IsNot Nothing Then
                                SystemEvent("ProcessDeliveryConfirmationVETMS:SFA-TRAIN FOUND=" & trn.Name)
                            End If
                        ElseIf auth IsNot Nothing Then
                            trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(auth.TrainSymbol)
                            If trn IsNot Nothing Then
                                SystemEvent("ProcessDeliveryConfirmationVETMS:AUTH-TRAIN FOUND=" & trn.Name)
                            End If
                        ElseIf OtherAuth IsNot Nothing Then
                            trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(OtherAuth.TrainSymbol)
                            If trn IsNot Nothing Then
                                SystemEvent("ProcessDeliveryConfirmationVETMS:OTHERAUTH-TRAIN FOUND=" & trn.Name)
                            End If
                        End If
                    End If
                ElseIf Mid(MessageType, 1, 5) = "REST-" Then
                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(LocoUID)
                    theTag = TMDS.SystemUtilities.FetchData.FindTagFromGUID(AuthNum)
                    'find out the remote train
                    If trn Is Nothing Then
                        trn = TMDS.SystemUtilities.FetchData.FindTrainFromAuthority(LocoUID)
                    End If
                    theBull = TMDS.SystemUtilities.FetchData.FindBulletinByGUID(AuthNum)
                End If
                If optEnableShadowMode Then
                    If trn Is Nothing Then
                        SystemEvent("ProcessDeliveryConfirmationVETMS:TRAIN NOT FOUND:" & data)
                        Exit Sub
                    Else
                        If trn.myTrack.myControlPoint.IsShadowMode Then
                            SystemEvent("ProcessDeliveryConfirmationVETMS:TRAIN[" & trn.Name & "] FOUND IN SHADOW MODE - DROPPING MESSAGE " & data)
                            Exit Sub
                        End If
                    End If
                End If
                Dim UpdateStatus As Boolean
                Select Case MessageType
                    Case "MA-1051-TWC" 'TWC CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1051_TWC_CreateMessageResponse(MessageResponse, sfa)
                    Case "MA-2061-TWC-CREATED" 'TWC CREATE MESSAGE - CREW CONFIRMATION RESPONSE
                        ProcessMA_2061_TWC_CreateMessageAction(MessageResponse, sfa)
                    Case "MA-1053-TWC" 'TWC RELEASE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1053_TWC_ReleaseMessageResponse(MessageResponse, sfa)
                        If gEnableIgnoreCrewACKForBOX1Void Then
                            If sfa.VoidedBy IsNot Nothing AndAlso Not String.IsNullOrEmpty(sfa.VoidedBy) AndAlso sfa.VoidedBy.Trim <> "" Then
                                ProcessMA_2061_TWC_ReleaseMessageAction("ACCEPTED", sfa)
                            End If
                        End If
                    Case "MA-2061-TWC-VOIDED" 'TWC RELEASE MESSAGE - CREW CONFIRMATION RESPONSE
                        ProcessMA_2061_TWC_ReleaseMessageAction(MessageResponse, sfa)
                    Case "MA-1051-TWC-ROLLUP" 'TWC ROLLUP MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1051_TWC_RollupMessageResponse(MessageResponse, sfa)
                    Case "MA-2061-TWC-ROLLUP" 'TWC ROLLUP MESSAGE  - CREW CONFIRMATION RESPONSE
                        ProcessMA_2061_TWC_RollupMessageAction(MessageResponse, sfa)
                    Case "MA-1051-TNT" 'TNT CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1051_TNT_CreateMessageResponse(MessageResponse, auth)
                    Case "MA-2061-TNT-CREATED" 'TNT CREATE MESSAGE - CREW CONFIRMATION RESPONSE
                        ProcessMA_2061_TNT_CreateMessageAction(MessageResponse, auth)
                    Case "MA-1051-TNT-UPDATE"
                    Case "MA-1053-TNT" 'TNT RELEASE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1053_TNT_ReleaseMessageResponse(MessageResponse, auth)
                        If gEnableIgnoreCrewACKForBOX1Void Then
                            If auth.VoidedBy IsNot Nothing AndAlso Not String.IsNullOrEmpty(auth.VoidedBy) AndAlso auth.VoidedBy.Trim <> "" Then
                                ProcessMA_2061_TNT_ReleaseMessageAction("ACCEPTED", auth)
                            End If
                        End If
                    Case "MA-2061-TNT-VOIDED" 'TNT RELEASE MESSAGE - CREW CONFIRMATION RESPONSE
                        ProcessMA_2061_TNT_ReleaseMessageAction(MessageResponse, auth)
                    Case "MA-1051-EMT" 'EMT CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1051_EMT_CreateMessageResponse(MessageResponse, OtherAuth)
                    Case "MA-2061-EMT-CREATED" 'EMT CREATE MESSAGE - CREW CONFIRMATION RESPONSE
                        ProcessMA_2061_EMT_CreateMessageAction(MessageResponse, OtherAuth)
                    Case "MA-1051-PSS" 'PSS CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1051_PSS_CreateMessageResponse(MessageResponse, OtherAuth)
                    Case "MA-2061-PSS-CREATED" 'PSS CREATE MESSAGE - CREW CONFIRMATION RESPONSE
                        ProcessMA_2061_PSS_CreateMessageAction(MessageResponse, OtherAuth)
                    Case "MA-1053-EMT" 'EMT RELEASE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1053_EMT_ReleaseMessageResponse(MessageResponse, OtherAuth, False)
                    Case "MA-2054-EMT" 'EMT FULFILLED MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1053_EMT_ReleaseMessageResponse(MessageResponse, OtherAuth, True)
                    Case "MA-1053-PSS" 'PSS RELEASE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1053_PSS_ReleaseMessageResponse(MessageResponse, OtherAuth, False)
                    Case "MA-2054-PSS" 'PSS FULFILLED MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessMA_1054_PSS_ReleaseMessageResponse(MessageResponse, OtherAuth)
                    Case "MA-2061-EMT-VOIDED" 'EMT RELEASE MESSAGE - CREW CONFIRMATION RESPONSE
                        ProcessMA_2061_EMT_ReleaseMessageAction(MessageResponse, OtherAuth)
                    Case "MA-2061-PSS-VOIDED" 'PSS RELEASE MESSAGE - CREW CONFIRMATION RESPONSE
                        ProcessMA_2061_PSS_ReleaseMessageAction(MessageResponse, OtherAuth)
                    Case "REST-2042-TAG-CREATE" 'TAG CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessREST_2042_TAG_CreateMessageResponse(MessageResponse, theTag, trn)
                    Case "REST-2061-BULLETIN-CREATED"
                        ProcessREST_2061_TAG_CreateMessageResponse(MessageResponse, theTag, trn)
                    Case "REST-2043-TAG-DELETE" 'TAG DELETE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessREST_2043_TAG_DeleteMessageResponse(MessageResponse, theTag, trn)
                    Case "REST-2042-BULLETIN-CREATE", "REST-2043-BULLETIN-CREATE" 'BULLETIN CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessREST_2042_Bulletin_CreateMessageResponse(MessageResponse, theBull, trn)
                    Case "REST-2043-BULLETIN-DELETE" 'BULLETIN DELETE MESSAGE - TMC CONFIRMATION RESPONSE
                        ProcessREST_2043_Bulletin_DeleteMessageResponse(MessageResponse, theBull, trn)
                    Case "REST-1041-TAG" 'TAG CREATE MESSAGE - BOS CONFIRMATION RESPONSE
                        ProcessREST_1041_TAG_CreateMessageResponse(MessageResponse, theTag, trn)
                End Select
                If UpdateStatus And Not TrackTimeTypeAuth Then
                    Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC", sfa)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock
                ElseIf UpdateStatus And TrackTimeTypeAuth Then
                    Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC", auth)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Process Informational VETMS
        ''' </summary>
        ''' <param name="pMessageType"></param>
        ''' <param name="pData"></param>
        Public Shared Sub ProcessInformationalVETMS(ByVal pMessageType As String, ByVal pData As String)
            Try
                Select Case pMessageType
                    Case "LOCO-STATE-CHANGE"
                        ProcessLocomotiveStateChange(pData)
                    Case "DEVICE-STATUS-REQUEST"
                        ProcessDeviceStatusRequest(pData)
                    Case "LOCO-BRAKE-ENFORCEMENT"
                        ProcessLocomotiveBreakEnforcement(pData)
                    Case "LOCO-AUTHORITY-VIOLATION"
                        ProcessLocomotiveAuthorityViolation(pData)
                    Case "LOCO-AUTHORITY-VIOLATION-CLEARED"
                        ProcessLocomotiveAuthorityViolationCleared(pData)
                    Case "TRAIN-CONSIST-UPDATE"
                        ProcessLocomotiveConsistUpdate(pData)
                    Case "IETMS-CONSIST-REQUEST"
                        ProcessConsistRequest(pData)
                    Case "NETWORK-PRESENCE"
                        ProcessLocomotiveOnNetworkStatus(pData)
                    Case "LOCO-ROUTE-LIST-REQUEST"
                        ProcessLocomotiveRouteListRequestMessage(pData)
                    Case "LOCO-ROUTE-REQUEST"
                        ProcessRouteSelection(pData)
                End Select
            Catch ex As Exception
