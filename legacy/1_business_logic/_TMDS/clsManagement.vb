        Private Function TimeTranslationFromUTC(ByVal OldTime As Date) As Date
            Try
                'Dim TimeDiff As Integer = TimeSpan.Compare(Now, Now.UtcNow)
                Dim ts1 As System.TimeSpan = Now.Subtract(Now.ToUniversalTime)
                Dim TimeDiff As Integer = ts1.TotalHours
                Dim NewTime As Date = OldTime.AddHours(TimeDiff)

                SystemEvent("TimeTranslationFromUTC-CONVERTED FROM " & OldTime.ToString & " TO " & NewTime.ToString)

                Return NewTime


            Catch ex As Exception
                SystemException(ex.ToString)
                Return OldTime
            End Try
        End Function

        Private Function FormatDataString(ByVal MessageData As String) As Boolean
            Try
                Dim EventMessage As String = String.Empty
                Dim MessType As String = Mid(MessageData, 1, 1)
                Dim UniqueNum As String = Mid(MessageData, 2, 15)
                TrackReservationUID = UniqueNum
                Me.TimeStampBegin = TimeTranslationFromUTC(GetDate(Mid(MessageData, 17, 14)))
                Me.TimeStampEnd = TimeTranslationFromUTC(GetDate(Mid(MessageData, 31, 14)))

                Dim BeginTime As DateTime = TimeTranslationFromUTC(GetDate(Mid(MessageData, 17, 14)))
                Dim ENDTime As DateTime = TimeTranslationFromUTC(GetDate(Mid(MessageData, 31, 14)))

                Me.OwnerName = Mid(MessageData, 45, 30)
                Dim AbsBlock As String = Mid(MessageData, 75, 1)
                Dim SpdF As String = Mid(MessageData, 76, 3)
                Dim SpdP As String = Mid(MessageData, 79, 3)
                Dim Direction As String = Mid(MessageData, 82, 1)
                Dim MPStart As String = Mid(MessageData, 83, 8)
                Dim MPStartSuffix As String = Mid(MessageData, 91, 1)
                Dim MPEnd As String = Mid(MessageData, 92, 8)
                Dim MPEndSuffix As String = Mid(MessageData, 100, 1)
                Dim TrackCount As Integer = CInt(Mid(MessageData, 101, 3))
                Dim DescCount As Integer = 0 'CInt(Mid(MessageData, 202, 3))
                Dim DescStart As Integer = 153
                Select Case TrackCount
                    Case 1
                    Case Else
                        Dim TrackSpace As Integer = 49
                        Dim TrackCounter As Integer = TrackCount - 1
                        If TrackCount <> 0 Then
                            DescStart = DescStart + (TrackCounter * TrackSpace)
                        Else
                            DescStart = DescStart + TrackSpace
                        End If

                End Select

                If Mid(MessageData, DescStart, 3).Trim <> String.Empty Then
                    DescCount = CInt(Mid(MessageData, DescStart, 3))
                End If

                If DescCount > 0 Then
                    Me.Description = Mid(MessageData, DescStart + 3, DescCount)
                Else
                    Me.Description = "  "
                End If

                Dim I As Integer
                Dim ptr As Integer = 104
                For I = 1 To TrackCount
                    Dim Comp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CInt(Mid(MessageData, ptr, 6)))
                    If Not IsNothing(Comp) Then
                        Me.Components.Add(Comp)
                        CompList = CompList & Comp.GUID & "-"
                        If Me.TerrUID = 0 Then
                            TerrUID = Comp.TerritoryID
                        End If
                    End If

                    ptr += 6 + 20 + 8 + 1 + 8 + 1 + 5
                Next

                If Not Me.Components Is Nothing Then
                    Dim comp As Object = Nothing
                    Dim FirstTrack As Track = Nothing
                    Try
                        For Each comp In Me.Components
                            If comp.GetType.ToString = gTrackComponentName Then
                                FirstTrack = comp
                                Exit For
                            End If
                        Next
                        If Not FirstTrack Is Nothing Then
                            '************ FOR FRAMEWORK 3.5 *************************
                            'Dim TInfo As System.TimeZone
                            'Dim dt As DateTime
                            'TInfo = TimeZoneInfo.FindSystemTimeZoneById(MSTimeZone)
                            'dt = TimeZoneInfo.ConvertTime(BeginTime, TInfo)
                            '*************************************************************
                            Select Case Mid(FirstTrack.TimeZone, 1, 1)
                                Case "E"
                                    Me.TRBeginTime = Me.TimeStampBegin.AddHours(1)
                                    Me.TREndTime = Me.TimeStampEnd.AddHours(1)
                                Case "C"
                                    Me.TRBeginTime = Me.TimeStampBegin
                                    Me.TREndTime = Me.TimeStampEnd
                                Case "M"
                                    Me.TRBeginTime = Me.TimeStampBegin.AddHours(-1)
                                    Me.TREndTime = Me.TimeStampEnd.AddHours(-1)
                                Case "P"
                                    Me.TRBeginTime = Me.TimeStampBegin.AddHours(-2)
                                    Me.TREndTime = Me.TimeStampEnd.AddHours(-2)
                            End Select
                        Else
                            Me.TRBeginTime = Me.TimeStampBegin
                            Me.TREndTime = Me.TimeStampEnd
                        End If
                    Catch ex As Exception
                        SystemException(ex.ToString)
                        Me.TRBeginTime = Me.TimeStampBegin
                        Me.TREndTime = Me.TimeStampEnd
                    Finally
                        comp = Nothing
                        FirstTrack = Nothing
                    End Try


                End If


                Dim DBVersionCheck As String = CheckDBVersionAllTrack(UniqueNum, MessageData).Trim
                If DBVersionCheck <> String.Empty Then
                    SystemEvent("CREATE TRACK RESERVATION ERROR - DATABASE VERSION MISMATCH:" & MessageData)
                    SendTrackReservationErrorMessage(DBVersionCheck, TerrUID)
                    Return False
                End If

                If AbsBlock <> "Y" Then
                    Return False
                Else
                    Me.ReservationType = "TRACK-N-TIME"
                End If
                Select Case MessType
                    Case "D"
                        Dim tr As TrackReservation = Nothing
                        Try
                            For Each tr In gTrackReservations
                                If tr.TrackReservationUID = UniqueNum Then
                                    Exit For
                                End If
                            Next
                            If Not tr Is Nothing Then Me.DeleteReservationFromDB(tr)
                        Catch ex As Exception
                            SystemException(ex.ToString)
                            Return False
                        Finally
                            tr = Nothing
                        End Try

                        Return False
                    Case "N"
                        Me.InsertReservation(UniqueNum)

                        Return True
                    Case "M"

                End Select

                Return False

            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Function CheckDBVersionAllTrack(ByVal UniqueNumber As String, ByVal messageData As String) As String
            Dim rtnString As String = String.Empty
            Dim Comp As Object
            Dim CompCount As Integer = 0
            Dim CompArray As New ArrayList
            Try

                Dim ptr As Integer = 104

                For Each Comp In Me.Components
                    If Not IsNothing(Comp.myTerritory) Then
                        Dim DBver() As String = Comp.myTerritory.Dbversion.Split(".")
                        If DBver.Length = 3 Then
                            Dim dbversion As String = DBver(0) & DBver(1) & DBver(2).PadLeft(3, "0")
                            If dbversion <> Mid(messageData, ptr + 44, 5) Then
                                CompArray.Add(Comp)
                            End If
                        End If

                    End If
                    ptr += 6 + 20 + 8 + 1 + 8 + 1 + 5
                Next

                If Not CompArray Is Nothing Then
                    If CompArray.Count > 0 Then
                        rtnString = UniqueNumber & "02" & ("DATABASE VERSION MISMATCH").PadRight(100, " ") & CompArray.Count.ToString.PadLeft(3, "0")
                        For Each Comp In CompArray
                            rtnString = rtnString & Comp.GUID.ToString.PadLeft(6, "") & "02"
                        Next
                    End If
                End If

            Catch ex As Exception

            Finally
                Comp = Nothing
                CompArray = New ArrayList
            End Try
            Return rtnString
        End Function

