        Public Sub ResetComponents(ByVal FailComponent As Boolean, Optional ByVal InPlayBackMode As Boolean = False)
            Try

                Dim trk As TMDS.TrackComponents.Track
                For Each trk In TMDS.GlobalDeclarations.TrackCollection
                    trk.TrafficDirection = ""
                    trk.SignalStatOnMe = TrackComponents.Track.SignalStatus.SignalAtStop
                    trk.BlockAbsolute = False
                    trk.TrackAndTime = False
                    trk.DeviceBlocked = False
                    trk.TrainIDs.Clear()
                    trk.DeviceBlocks.Clear()
                    trk.Authorities.Clear()
                    trk.TrackTagLabels.Clear()
                    trk.TrackAuthorities.Clear()
                    trk.TrainIDs.Clear()
                    trk.Occuppied = False
                    trk.ApplyTraffic()
                    'trk.UpdateStatus()
                Next

                Dim sw As TMDS.SwitchComponents.Switch
                For Each sw In TMDS.GlobalDeclarations.SwitchCollection
                    sw.TrafficDirection = ""
                    sw.InitSwitchControl(False)
                    sw.SignalStatOnMe = TrackComponents.Track.SignalStatus.SignalAtStop
                    sw.BlockAbsolute = False
                    sw.TrackAndTime = False
                    sw.DeviceBlocked = False
                    sw.SwitchIndStatus = SwitchComponents.Switch.SwIndStatus.NormalInd
                    sw.ControlledReverse = False
                    sw.SwitchLockBit = False
                    sw.DeviceBlocks.Clear()
                    sw.Authorities.Clear()
                    sw.TrackAuthorities.Clear()
                    sw.DoMonitorMode = True
                    sw.Occuppied = False
                    sw.ApplyTraffic()
                Next

                Dim sg As TMDS.SignalComponents.Signal
                For Each sg In TMDS.GlobalDeclarations.SignalCollection
                    sg.BlockAbsolute = False
                    sg.DeviceBlocked = False
                    sg.SignalCtlStatus = SignalComponents.Signal.CtlStatus.RequestedStop
                    sg.SignalIndStatus = SignalComponents.Signal.IndStatus.Stopped
                    sg.SignalStatus = SignalComponents.Signal.BulbStatus.StopStatus
                    sg.DrillMode = False
                    sg.Initialized = False
                    sg.DoMonitorMode = True
                    sg.DeviceBlocks.Clear()
                    'sg.UpdateStatus()
                Next
                Dim cp As TMDS.GraphicComponent.ControlPoint
                For Each cp In Me.myControlPoints
                    Dim comp As Object
                    For Each comp In cp.AssignedComponenets
                        comp.FailState = FailComponent
                        comp.UpdateStatus()
                    Next
                    cp.CancelStoredRoutes()
                    cp.FailState = FailComponent
                    cp.UpdateStatus()
                Next


                TMDS.GlobalDeclarations.gDeviceBlocks.Clear()

                TMDS.GlobalDeclarations.OtherTrackAuthorities.Clear()

                TMDS.GlobalDeclarations.TrackWarrants.Clear()

                TMDS.GlobalDeclarations.TrainCollection.Clear()

                TMDS.GlobalDeclarations.TrackTags.Clear()

                TMDS.GlobalDeclarations.Notes.Clear()



                TMDS.SystemForms.MySystemForms.frmSystemSummary.lvTags.Items.Clear()
                TMDS.SystemForms.MySystemForms.frmSystemSummary.lvWestSum.Items.Clear()
                TMDS.SystemForms.MySystemForms.frmSystemSummary.lvEastSum.Items.Clear()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

