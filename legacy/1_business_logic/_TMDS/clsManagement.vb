#Region "MOBILE MESSAGES"

    Public Class MobileMessages

        Public Shared Sub ProcessVehicleMessage(ByVal MessageToProcess As String)

            Try
                Dim DataString() As String = MessageToProcess.Split(";")
                If DataString.Length >= 4 Then
                    Dim Ack As String = "ACK;" & DataString(2) & ";" & Chr(4)
                    TMDS.GlobalDeclarations.gCadTransmitQueue.Enqueue(Ack)
                    Dim VehRpt() As String = DataString(3).Split(",")
                    If VehRpt.Length >= 15 Then
                        Dim veh As MobileTracking.Vehicle
                        Dim VehExists As Boolean
                        Dim VehFound As MobileTracking.Vehicle = Nothing
                        For Each veh In TMDS.GlobalDeclarations.gVehicleCollection
                            If veh.VehicleID = VehRpt(0) Then
                                VehFound = veh
                                VehExists = True
                                Exit For
                            End If
                        Next

                        If Not VehExists Then
                            Dim NewVehicle As MobileTracking.Vehicle
                            If Not gMobileServerExists Then
                                NewVehicle = New MobileTracking.Vehicle _
                                (TMDS.GlobalDeclarations.gVehicleCollection,
                                VehRpt, TMDS.GlobalDeclarations.SystemEventQueue,
                                TMDS.GlobalDeclarations.gCadTransmitQueue,
                                TMDS.GlobalDeclarations.gThisWorkstation)
                            Else
                                NewVehicle = New MobileTracking.Vehicle _
                                (TMDS.GlobalDeclarations.gVehicleCollection,
                                VehRpt, TMDS.GlobalDeclarations.SystemEventQueue,
                                TMDS.GlobalDeclarations.gMGPSTransmitQueue,
                                TMDS.GlobalDeclarations.gThisWorkstation)
                            End If
                            SyncLock TMDS.GlobalDeclarations.gVehicleCollection
                                TMDS.GlobalDeclarations.gVehicleCollection.Add(NewVehicle)
                            End SyncLock
                            VehFound = NewVehicle
                        End If
                        If gDebugPrint Then
                            DebugEvent("BEGIN HLCS MESSAGE PROCESSING:" & VehFound.VehicleID)
                        End If

                        VehFound.UpdatePosition(VehRpt)
                        'Dim vehreport As New MobileTracking.UpdatePositionData(AddressOf VehFound.UpdatePosition)
                        'vehreport.BeginInvoke(VehRpt, Nothing, Nothing)
                        If gDebugPrint Then
                            DebugEvent("END HLCS MESSAGE PROCESSING:" & VehFound.VehicleID)
                        End If
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Sub ProcessLocomotiveReport(ByVal MessageToProcess As String)
            Dim IstraininShadowMode As Boolean = False
            Try
                If optDisableTrainTrackingViaGPS Then Exit Sub
                Dim LocoRpt() As String = MessageToProcess.Split(",")
                SystemEvent("MobileMessages-ProcessLocomotiveReport:" & MessageToProcess)

                If Not DoesTrainExist(LocoRpt(1), IstraininShadowMode) Then
                    SystemEvent("MobileMessages-ProcessLocomotiveReport...Train Does Not Exist:" & LocoRpt(1))
                    Exit Sub
                End If
                If IstraininShadowMode Then
                    SystemEvent("MobileMessages-ProcessLocomotiveReport...Train in ShadowMode:" & LocoRpt(1))
                    Exit Sub
                End If
                If LocoRpt.Length >= 14 Then
                    Dim loco As MobileTracking.Locomotive = Nothing
                    Dim LocExists As Boolean
                    Dim LocFound As MobileTracking.Locomotive = Nothing
                    For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                        If loco.LocomotiveID = LocoRpt(2) Then
                            LocFound = loco
                            LocExists = True
                            SystemEvent("MobileMessages-ProcessLocomotiveReport...LocomotiveTrackingObject-Locomotive Object Exists:" & LocoRpt(1))
                            Exit For
                        End If
                    Next

                    If Not LocExists Then
                        SystemEvent("MobileMessages-ProcessLocomotiveReport...LocomotiveTrackingObject Does Not Exist-Creating Object:" & LocoRpt(1))
                        Dim NewLocomotive As MobileTracking.Locomotive
                        If Not gMobileServerExists Then
                            NewLocomotive = New MobileTracking.Locomotive _
                            (TMDS.GlobalDeclarations.gLocomotiveCollection,
                             TMDS.GlobalDeclarations.SystemEventQueue,
                            TMDS.GlobalDeclarations.gCadTransmitQueue,
                            TMDS.GlobalDeclarations.gThisWorkstation, LocoRpt)
                        Else
                            NewLocomotive = New MobileTracking.Locomotive _
                            (TMDS.GlobalDeclarations.gLocomotiveCollection,
                             TMDS.GlobalDeclarations.SystemEventQueue,
                            TMDS.GlobalDeclarations.gMGPSTransmitQueue,
                            TMDS.GlobalDeclarations.gThisWorkstation, LocoRpt)
                        End If

                        SyncLock TMDS.GlobalDeclarations.gLocomotiveCollection
                            TMDS.GlobalDeclarations.gLocomotiveCollection.Add(NewLocomotive)
                        End SyncLock

                        LocFound = NewLocomotive
                    End If

                    LocFound.UpdateReportETMS(LocoRpt)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Sub ProcessLocomotiveMessage(ByVal MessageToProcess As String)

            Try
                Dim DataString() As String = MessageToProcess.Split(";")
                If DataString.Length >= 4 Then
                    Dim LocoRpt() As String = DataString(3).Split(",")
                    If optEnableShadowMode Then
                        Dim trn As TrainID = Nothing
                        Try
                            trn = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(LocoRpt(0))
                            If optEnableShadowMode AndAlso trn IsNot Nothing AndAlso trn.myTrack IsNot Nothing Then
                                If trn.myTrack.myControlPoint.IsShadowMode Then
                                    SystemEvent("MobileMessages-ProcessLocomotiveMessage...Train in ShadowMode:" & LocoRpt(0) & " Data<" & MessageToProcess & ">")
                                    Exit Sub
                                End If
                            End If
                        Catch ex As Exception

                        End Try
                    End If
                    Dim Ack As String = "ACK;" & DataString(2) & ";" & Chr(4)
                    TMDS.GlobalDeclarations.gCadTransmitQueue.Enqueue(Ack)

                    If LocoRpt.Length >= 14 Then
                        Dim loco As MobileTracking.Locomotive = Nothing
                        Dim LocExists As Boolean
                        Dim LocFound As MobileTracking.Locomotive = Nothing
                        For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                            If loco.LocomotiveID = LocoRpt(0) Then
                                LocFound = loco
                                LocExists = True
                                Exit For
                            End If
                        Next

                        If Not LocExists Then
                            Dim NewLocomotive As MobileTracking.Locomotive
                            If Not gMobileServerExists Then
                                NewLocomotive = New MobileTracking.Locomotive _
                                (TMDS.GlobalDeclarations.gLocomotiveCollection,
                                 TMDS.GlobalDeclarations.SystemEventQueue,
                                TMDS.GlobalDeclarations.gCadTransmitQueue,
                                TMDS.GlobalDeclarations.gThisWorkstation, LocoRpt)
                            Else
                                NewLocomotive = New MobileTracking.Locomotive _
                                (TMDS.GlobalDeclarations.gLocomotiveCollection,
                                 TMDS.GlobalDeclarations.SystemEventQueue,
                                TMDS.GlobalDeclarations.gMGPSTransmitQueue,
                                TMDS.GlobalDeclarations.gThisWorkstation, LocoRpt)
                            End If
                            SyncLock TMDS.GlobalDeclarations.gLocomotiveCollection
                                TMDS.GlobalDeclarations.gLocomotiveCollection.Add(NewLocomotive)
                            End SyncLock
                            LocFound = NewLocomotive
                        End If
                        If gDebugPrint Then
                            DebugEvent("BEGIN ETMS MESSAGE PROCESSING:" & LocFound.LocomotiveID)
                        End If

                        LocFound.UpdatePosition(LocoRpt)
                        'Dim vehreport As New MobileTracking.UpdatePositionData(AddressOf VehFound.UpdatePosition)
                        'vehreport.BeginInvoke(VehRpt, Nothing, Nothing)
                        If gDebugPrint Then
                            DebugEvent("END ETMS MESSAGE PROCESSING:" & LocFound.LocomotiveID)
                        End If
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub SystemEvent(ByVal EventNote As String)

            Try
                Dim ClickEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.SystemEvent, EventNote, SystemEventQueue)
                ClickEvent = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub DebugEvent(ByVal EventNote As String)

            Try
                If gDebug Then
                    Dim ClickEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.SystemEvent, EventNote, SystemEventQueue)
                    ClickEvent = Nothing
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Function DoesTrainExist(ByVal TrnName As String, ByVal IsTrainShadowMode As Boolean) As Boolean
            Try
                Dim trn As TrainID
                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.Name = TrnName Then
                        If optEnableShadowMode Then
                            IsTrainShadowMode = trn.myTrack.myControlPoint.IsShadowMode
                        Else
                            IsTrainShadowMode = False
                        End If
                        Return True
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

