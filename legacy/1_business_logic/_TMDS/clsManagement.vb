#Region "FORM PROPERTIES"

    Public Structure FormProperties
        Dim FormName As String
        Dim FormLocation As Point
    End Structure

    Public Class FormPropertyUpdate

        Private Delegate Sub DoUpdateFormProp(ByRef FormObject As Form, ByVal FormName As String, ByRef FormProp As FormProperties)

        Shared Sub SetFormPosition(ByRef FormObject As Form, ByVal FormName As String, ByRef FormProp As FormProperties, Optional ByVal ForceUpdate As Boolean = False)
            Try
                Dim DoDatabaseUpdate As Boolean

                If FormProp.FormLocation.X < 0 Then
                    FormProp.FormLocation.X = 0
                Else
                    If FormProp.FormLocation.X <> FormObject.Left Then
                        DoDatabaseUpdate = True
                    End If
                    FormProp.FormLocation.X = FormObject.Left
                End If

                If FormProp.FormLocation.Y < 0 Then
                    FormProp.FormLocation.Y = 0
                Else
                    If FormProp.FormLocation.Y <> FormObject.Top Then
                        DoDatabaseUpdate = True
                    End If
                    FormProp.FormLocation.Y = FormObject.Top
                End If
                If DoDatabaseUpdate Then
                    If Not ForceUpdate Then
                        Dim DoFormPositionUpdate As New DoUpdateFormProp(AddressOf UpdateFormProp)
                        DoFormPositionUpdate.BeginInvoke(FormObject, FormName, FormProp, Nothing, Nothing)
                    Else
                        UpdateDirectFormProp(FormObject, FormName, FormProp)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub UpdateFormProp(ByRef FormObject As Form, ByVal FormName As String, ByRef FormProp As FormProperties, Optional ByVal ForceDatabaseUpdate As Boolean = False)
            Dim q As String = "'"
            Dim s As String = ", "

            Try
                If FormProp.FormLocation.Y <> FormObject.Top Or FormProp.FormLocation.X <> FormObject.Left Then
                    FormProp.FormLocation.Y = FormObject.Top
                    FormProp.FormLocation.X = FormObject.Left
                End If

                If FormProp.FormLocation.Y < 0 Then
                    Exit Sub
                End If

                If FormProp.FormLocation.X < 0 Then
                    Exit Sub
                End If

                Dim PositionUpdate As String = "UPDATE " & gtblWrkStnSettings & " SET " & FormName & " = " & q & FormObject.Left & "|" & FormObject.Top & "|" & q & " WHERE WrkStnName = " & q & gWorkStationName & q
                If ForceDatabaseUpdate Then
                    Dim dbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                    'Dim CommandInsert As New OleDbCommand(PositionUpdate, dbConn)
                    'CommandInsert.Connection.Open()
                    'CommandInsert.ExecuteNonQuery()
                    'dbConn.Close()
                    'dbConn.Dispose()
                    'CommandInsert = Nothing

                Else
                    SystemDatabaseCommandToStatic("FormPropertyUpdate:UpdateFormProp", PositionUpdate)

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                'dbConn = Nothing
            End Try
        End Sub

        Private Shared Sub UpdateDirectFormProp(ByRef FormObject As Form, ByVal FormName As String, ByRef FormProp As FormProperties, Optional ByVal ForceDatabaseUpdate As Boolean = False)
            Dim q As String = "'"
            Dim s As String = ", "
            Dim dbConn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Try
                If FormProp.FormLocation.Y <> FormObject.Top Or FormProp.FormLocation.X <> FormObject.Left Then
                    FormProp.FormLocation.Y = FormObject.Top
                    FormProp.FormLocation.X = FormObject.Left
                End If

                If FormProp.FormLocation.Y < 0 Then
                    FormProp.FormLocation.Y = 0
                    'Exit Sub
                End If

                If FormProp.FormLocation.X < 0 Then
                    FormProp.FormLocation.X = 0
                    'Exit Sub
                End If

                Dim PositionUpdate As String = "UPDATE " & gtblWrkStnSettings & " SET " & FormName & " = " & q & FormObject.Left & "|" & FormObject.Top & "|" & q & " WHERE WrkStnName = " & q & gWorkStationName & q
                'Dim dbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                'Dim dbcomm As New OleDbCommand(PositionUpdate, dbConn)
                dbConn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                dbcomm = New OleDbCommand(PositionUpdate, dbConn)
                dbConn.Open()
                dbcomm.ExecuteNonQuery()
                'dbConn.Close()
                'dbConn = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                'dbConn = Nothing
            Finally
                If Not dbConn Is Nothing Then
                    If dbConn.State = ConnectionState.Open Then dbConn.Close()
                    dbConn.Dispose()
                    dbConn = Nothing
                End If
                If Not dbcomm Is Nothing Then
                    dbcomm.Dispose()
                    dbcomm = Nothing
                End If
            End Try
        End Sub

    End Class

