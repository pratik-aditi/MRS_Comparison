        ''' <summary>
        ''' Update Authority Number
        ''' </summary>
        Public Sub UpdateAuthorityNumber()
            Dim dbConn As OleDbConnection = Nothing
            Dim dbComm As OleDbCommand = Nothing
            Dim retryCount As Integer
            Dim query As String = String.Empty
            Try
                Try
                    Do While retryCount < 3
                        query = "UPDATE tblSystemWorkStations SET CurrentAuthorityNumber = " & (Me.CurrentAuthorityNumber) & " WHERE WrkStnName = '" & Me.Name & "'"
                        dbConn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                        dbComm = New OleDbCommand(query, dbConn)
                        dbConn.Open()
                        dbComm.ExecuteNonQuery()
                        retryCount = 3
                        Threading.Thread.Sleep(1000)
                    Loop
                Catch ex As Exception
                    SystemException(ex.ToString)
                    retryCount += 1
                End Try
            Catch ex As Exception
                SystemEvent("UpdateAuthorityNumber:Failed UpdateAuthorityNumber:Query=" & query)
                SystemException(ex.ToString)
            Finally
                query = Nothing
                retryCount = Nothing
                If Not dbConn Is Nothing Then
                    If dbConn.State = ConnectionState.Open Then dbConn.Close()
                    dbConn.Dispose()
                    dbConn = Nothing
                End If
                If Not dbComm Is Nothing Then
                    dbComm.Dispose()
                    dbComm = Nothing
                End If
            End Try
        End Sub

        Private Sub CheckForPreviousDayLowestNumber()
            Dim auth As Object
            Try
                'Perform high water mark check
                Dim HighWaterMark As Integer
                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                        Dim tt As TrackAuthority.TrackAuthority = CType(auth, TrackAuthority.TrackAuthority)
                        If tt.CreateDate.Date < Now.Date Then
                            If tt.AuthorityNumber > HighWaterMark Then
                                HighWaterMark = tt.AuthorityNumber
                            End If
                        End If
                    ElseIf auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        Dim sfa As TrackAuthority.SFAuthority = CType(auth, TrackAuthority.SFAuthority)
                        If sfa.AuthDate.Date < Now.Date Then
                            If sfa.AuthorityNumber > HighWaterMark Then
                                HighWaterMark = sfa.AuthorityNumber
                            End If
                        End If
                    End If
                Next
                If HighWaterMark < 50 Then
                    If CurrentAuthorityNumber < 50 Then
                        CurrentAuthorityNumber = 50
                    Else
                        CurrentAuthorityNumber = 0
                    End If
                Else
                    Me.CurrentAuthorityNumber = 0
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function CheckAllAuthorityTypeNumbers(ByVal NumberToCheck As String) As Boolean
            Dim dbconn As OleDb.OleDbConnection = Nothing
            Dim dbcomm As OleDb.OleDbCommand = Nothing
            Dim q As String = "'"
            Dim query As String = "SELECT AuthorityUID FROM tblAuthoritiesSingleFormActive WHERE AuthorityUID=" & q & NumberToCheck & q
            Dim NumberNotFound As Boolean = True
            Try
                Dim auth As Object 'TrackAuthority.TrackAuthority
                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If optEnableCPSpecificOptions Then
                        If auth.AuthorityNumber = NumberToCheck Then Return False
                    Else
                        If auth.AuthorityUID = NumberToCheck Then
                            Return False
                        End If
                    End If
                Next
                If optEnableCPSpecificOptions Then
                    For Each auth In gOtherSpecialAuthorityCollection
                        If auth.AuthorityNumber = NumberToCheck Then Return False
                    Next
                End If
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringAuthority)
                If optEnableCPSpecificOptions Then
                    query = "SELECT AuthorityUID FROM tblAuthoritiesSingleFormActive WHERE AuthNum=" & q & NumberToCheck & q
                    dbcomm = New OleDbCommand(query, dbconn)
                    dbconn.Open()
                    If dbcomm.ExecuteNonQuery() <> 0 Then
                        NumberNotFound = False
                    End If
                    query = "SELECT AuthorityUID FROM tblAuthoritiesActive WHERE AuthorityNumber=" & q & NumberToCheck & q
                    dbcomm = New OleDbCommand(query, dbconn)
                    If dbcomm.ExecuteNonQuery() <> 0 Then
                        NumberNotFound = False
                    End If

                    query = "SELECT AuthorityUID FROM tblAuthoritiesOtherActive WHERE AuthUID=" & q & NumberToCheck & q
                    dbcomm = New OleDbCommand(query, dbconn)
                    If dbcomm.ExecuteNonQuery() <> 0 Then
                        NumberNotFound = False
                    End If
                Else
                    dbcomm = New OleDbCommand(query, dbconn)
                    dbconn.Open()
                    If dbcomm.ExecuteNonQuery() <> 0 Then
                        NumberNotFound = False
                    End If
                    query = "SELECT AuthorityUID FROM tblAuthoritiesActive WHERE AuthorityUID=" & q & NumberToCheck & q
                    dbcomm = New OleDbCommand(query, dbconn)
                    If dbcomm.ExecuteNonQuery() <> 0 Then
                        NumberNotFound = False
                    End If

                End If
                Return NumberNotFound
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                If Not dbconn Is Nothing Then
                    If dbconn.State = ConnectionState.Open Then dbconn.Close()
                    dbconn.Dispose()
                    dbconn = Nothing
                End If
                If Not dbcomm Is Nothing Then
                    dbcomm.Dispose()
                    dbcomm = Nothing
                End If
            End Try
        End Function

