        ''' <summary>
        ''' Release Message Response
        ''' </summary>
        ''' <param name="message">message received</param>
        ''' <param name="authority">other special authority assigned</param>
        Private Shared Sub ProcessMA_1053_EMT_ReleaseMessageResponse(message As String,
                                                                     authority As OtherSpecialAuthorityType,
                                                                     fullFilled As Boolean)
            Try
                If String.IsNullOrWhiteSpace(message) Then
                    SystemEvent($"{GetCurrentMethod.Name}:Message is null")
                    Exit Sub
                End If
                If authority Is Nothing Then
                    SystemEvent($"{GetCurrentMethod.Name}:Authority is nothing")
                    Exit Sub
                End If
                If authority.PTCMarkedToBeVoidedElectronically OrElse
                    fullFilled Then
                    Select Case message
                        Case "FAILED"
                            authority.PTCStatus = "RELEASE-FAILED"
                            authority.SetPTCAuthorityFlasherStatus()
                        Case "DELIVERED"
                            authority.PTCStatus = "RELEASE-PENDING"
                            authority.SetPTCAuthorityFlasherStatus()
                        Case "ACCEPTED"
                            authority.PtcConfirmTotalCancellation()
                    End Select
                    If authority.UpdateDatabaseWithPTCAuthorityStatus(authority.PTCStatus) Then
                        SystemEvent($"{GetCurrentMethod.Name}:Authority {authority.AuthorityUID _
                                } updated with status {authority.PTCStatus}")
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

