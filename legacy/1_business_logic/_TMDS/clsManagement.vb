                        If Integer.TryParse(MilePostSuffix, Nothing) Then
                            MilePostPrefix = Mid(myMilePostBegin, 1, 1)
                            MilePostBegin = Mid(myMilePostBegin, 2, myMilePostBegin.Length)
                            MilePostSuffix = ""
