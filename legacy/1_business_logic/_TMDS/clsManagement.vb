        Public Function GetDelayTimeFormat() As String
            Try
                Dim Hours As Integer = EventDelayAmount / 60
                Dim Mins As Integer = System.Math.Abs((EventDelayAmount - (Hours * 60)))

                Dim DelayTime As String = Hours.ToString.PadLeft(3, "0") & "@" & Mins.ToString.PadLeft(2, "0")
                Return DelayTime

            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty
            End Try
        End Function

