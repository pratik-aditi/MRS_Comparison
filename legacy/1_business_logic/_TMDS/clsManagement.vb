#Region "TERRITORY ASSISTANCE PROCEDURES"

        Private Sub SendMessageToControlServers(ByVal message As String)
            Try
                If Not Me.myControlServerPClient Is Nothing Then
                    If Not Me.myControlServerPClient.AssignedTerritories.Contains(Me) Then
                        Me.myControlServerPClient.AssignedTerritories.Add(Me)
                    End If
                    If Not Me.myControlServerPClient.NormalControlServerConnection Is Nothing Then
                        Me.myControlServerPClient.NormalControlServerConnection.SendData(message)
                    End If
                End If

                If Not Me.myControlServerSClient Is Nothing Then
                    If Not Me.myControlServerSClient.AssignedTerritories.Contains(Me) Then
                        Me.myControlServerSClient.AssignedTerritories.Add(Me)
                    End If
                    If Not Me.myControlServerSClient.NormalControlServerConnection Is Nothing Then
                        Me.myControlServerSClient.NormalControlServerConnection.SendData(message)
                    End If
                End If

                Dim EventMessage As String = "MESSAGE SENT TO CONTROL SERVER. (" & message & ")"
                Me.TerritoryEventLog(EventMessage)
            Catch ex As Exception
                AddEventToLog(EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            End Try
        End Sub

