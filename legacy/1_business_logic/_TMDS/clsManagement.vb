        Public Sub CreateControlServerClients()
            Try
                Dim CreateNormal As Boolean = True
                Dim CreateStandby As Boolean = True

                Dim cntrlsvr As TMDS.ControlServerClient.ControlServerClient
                For Each cntrlsvr In ControlServers
                    If cntrlsvr.myName = Me.myControlServerP Then
                        'CreateNormal = False
                    End If

                    If cntrlsvr.myName = Me.myControlServerS Then
                        'CreateStandby = False
                    End If
                Next

                If CreateNormal Then
                    Me.myControlServerPClient = TMDS.ControlServerClient.ControlServerUtiliites.GetControlServer(Me.myControlServerP)
                    myControlServerPClient.AssignTerritories()
                    myControlServerPClient.CreateConnection()
                End If

                If CreateStandby Then
                    Me.myControlServerSClient = TMDS.ControlServerClient.ControlServerUtiliites.GetControlServer(Me.myControlServerS)
                    myControlServerSClient.AssignTerritories()
                    myControlServerSClient.CreateConnection()
                End If

                If CreateStandby Or CreateNormal Then
                    Me.SubscribeToTerritory()
                End If

            Catch ex As Exception
                AddEventToLog(EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            End Try

