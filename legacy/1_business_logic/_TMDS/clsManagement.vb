        End Sub

#Region "TRACK ALARM"

        ''' <summary>
        ''' Process track alarm messages
        ''' </summary>
        ''' <param name="pMessage"></param>
        Public Shared Sub ProcessTrackAlarmMessages(ByVal pMessage As String)
            Dim dataString As String()
            Try
                If Not optEnableTagTrackAlarm Then Exit Sub
                dataString = pMessage.Split(";")
                Select Case dataString(1)
                    Case "ADD"
                        AddTrackAlarm(dataString)
                    Case "DELETE"
                        DeleteTrackAlarm(dataString)
                    Case Else
                        SystemEvent("ProcessTrackAlarmMessages:Message unknown=" & pMessage)
                End Select
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                dataString = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Delete speed restriction
        ''' </summary>
        ''' <param name="pData"></param>
        Private Shared Sub DeleteTrackAlarm(ByVal pData As String())
            Dim currentTag As Tag = Nothing
            Dim currentTrack As Track
            Dim summItem As SummaryItem
            Dim trackName As String
            Dim trackComponents As String()
            Dim controlPoint As String
            Dim reason As String
            Dim gauge As String
            Dim guidMessage As String
            Try
                'TRACKALARM|DELETE|TRACKNAME|TRACKCOMPONENTS|CONTROLPOINT|REASON|GAUGE|GUID
                If pData.Length < 8 Then
                    SystemEvent("DeleteTrackAlarm:Data length less than 6")
                    Exit Sub
                End If
                trackName = pData(2)
                trackComponents = pData(3).Split("|")
                controlPoint = pData(4)
                reason = pData(5)
                gauge = pData(6)
                guidMessage = pData(7)
                'Find tag by guid
                For Each track As String In trackComponents
                    currentTag = TMDS.SystemUtilities.FetchData.FindTagFromGUID(guidMessage)
                    If currentTag IsNot Nothing Then
                        Exit For
                    End If
                Next
                If currentTag Is Nothing Then
                    SystemEvent("DeleteTrackAlarm:Cant find tag by guid")
                    'Find tag by track uid
                    For Each track As String In trackComponents
                        currentTag = TMDS.SystemUtilities.FetchData.FindTagFromTrack(track)
                        If currentTag IsNot Nothing Then Exit For
                    Next
                    If currentTag Is Nothing Then
                        SystemEvent("DeleteTrackAlarm:CurrentTag is nothing")
                        Exit Sub
                    End If
                End If
                If currentTag.TagType <> optTagType6 Then
                    SystemEvent("DeleteTrackAlarm:Tag is not track alarm")
                    Exit Sub
                End If
                currentTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(currentTag.TrackGuid)
                currentTrack.DeleteTagFromDatabase(currentTag)
                currentTrack.RemoveTagFromTrack(currentTag)
                currentTrack.InitTagDisplay()
                currentTrack.UpdateTagStatus(True)
                currentTrack.UpdateStatus()
                currentTag.RecordTrackAlarm("AUTO-DELETE")
                summItem = New SummaryItem("TAG", "REMOVE", currentTag)
                SyncLock gSummaryTagQueue.SyncRoot
                    gSummaryTagQueue.Enqueue(summItem)
                End SyncLock
                TrackTags.Remove(currentTag)
                CreateAlert(optTagType6 & ";" & gCurrentUser.UserFullName & ";" & reason)
                TMDS.NetworkMessages.CadMessages.SendTrackAlarmEvent("AUTO-DELETE", trackName, "OK", currentTrack.myControlPoint.GUID, currentTag, guidMessage)
                SystemEvent("DeleteTrackAlarm:Track alarm delete. TagGUID=" & currentTag.TagGuid & ":Track=" & currentTrack.GUID.ToString & ":" & currentTrack.Name)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                currentTrack = Nothing
                currentTag = Nothing
                trackName = Nothing
                summItem = Nothing
                trackComponents = Nothing
                controlPoint = Nothing
                reason = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Add speed restriction
        ''' </summary>
        ''' <param name="pData"></param>
        Private Shared Sub AddTrackAlarm(ByVal pData As String())
            Dim currentTrack As Track = Nothing
            Dim currentTag As Tag
            Dim trackName As String
            Dim summItem As SummaryItem
            Dim trackComponents As String()
            Dim controlPoint As String
            Dim reason As String
            Dim gauge As String
            Dim guidMessage As String
            Try
                'TRACKALARM|ADD|TRACKNAME|TRACKCOMPONENTS|CONTROLPOINT|REASON|GAUGE|GUID
                If pData.Length < 8 Then
                    SystemEvent("AddTrackAlarm:Data length less than 7")
                    Exit Sub
                End If
                trackName = pData(2)
                trackComponents = pData(3).Split("|")
                controlPoint = pData(4)
                reason = pData(5)
                gauge = pData(6)
                guidMessage = pData(7)
                currentTrack = FindTrackFromGUID(trackComponents(0))
                If currentTrack Is Nothing Then
                    TMDS.NetworkMessages.CadMessages.SendTrackAlarmEvent("AUTO-ADD", trackName, "NOK", controlPoint, Nothing, guidMessage, "CANT FIND TRACK NAME")
                    SystemEvent("AddTrackAlarm:currentTrack is nothing")
                    Exit Sub
                End If
                currentTag = New Tag()
                currentTag.CreateTime = Now
                currentTag.Creator = gCurrentUser.UserFullName
                currentTag.DataString = reason
                currentTag.DelayData = "|0000.0|0||"
                currentTag.Restriction = True
                currentTag.Subdivision = currentTrack.SubdivisionID
                currentTag.TagType = optTagType6
                currentTag.TerritoryID = currentTrack.TerritoryID
                currentTag.TrackGuid = currentTrack.GUID
                currentTag.Restrictive = 1
                currentTag.Direction = "BOTH"
                currentTag.Delay = False
                currentTag.AdvisorySummary = optTagType6
                currentTag.ExpectedReleaseTime = CDate(Now.AddDays(1).ToLongDateString & " " & Now.ToLongTimeString)
                currentTag.IsCriticalAlertType = False
                currentTag.RefNumPTC = CInt(CStr(currentTrack.GUID.ToString) & Format(Now, "fff"))
                currentTag.PTCData = String.Empty
                currentTag.Reason = reason
                currentTag.RestrictBy = String.Empty
                currentTag.isRemoteTag = True
                currentTag.TagGuid = guidMessage
                currentTag.trackAlarmGauge = gauge
                currentTag.SpeedTagFlagInfo = "REMOTE TAG"
                If currentTag.InsertTagIntoDB(gtblTagsActive) Then
                    If currentTrack.AddTagToTrack(currentTag) Then
                        currentTrack.InitTagDisplay()
                        TrackTags.Add(currentTag)
                        summItem = New SummaryItem("TAG", "ADD", currentTag)
                        SyncLock gSummaryTagQueue.SyncRoot
                            gSummaryTagQueue.Enqueue(summItem)
                        End SyncLock
                    End If
                End If
                currentTag.UpdateTagInformationForPTC(currentTrack)
                currentTrack.UpdateTagStatus()
                currentTrack.UpdateStatus()
                currentTag.UpdateTagAdvisorySummary()
                currentTag.UpdateTagMilepostInformation()
                currentTag.UpdateTagCriticalAlert()
                currentTag.RecordTrackAlarm("AUTO-ADD")
                CreateAlert(optTagType6 & ";" & gCurrentUser.UserFullName & ";" & reason)
                TMDS.NetworkMessages.CadMessages.SendTrackAlarmEvent("AUTO-ADD", trackName, "OK", currentTrack.myControlPoint.GUID, currentTag, guidMessage)
                SystemEvent("AddTrackAlarm:Track alarm added:TagGUID=" & currentTag.TagGuid & ":Track=" & currentTrack.GUID.ToString & ":" & currentTrack.Name)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                currentTrack = Nothing
                currentTag = Nothing
                trackName = Nothing
                summItem = Nothing
                trackComponents = Nothing
                controlPoint = Nothing
                reason = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Create Alert in system summary
        ''' </summary>
        ''' <param name="pData"></param>
        Private Shared Sub CreateAlert(ByVal pData As String)
            Dim al As Alert
            Try
                al = TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.RemoteAction, pData, Nothing)
                al.Critical = False
                al.RedAlert = False
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                al = Nothing
            End Try
        End Sub
    End Class

#End Region

#End Region

#Region "SUMMARY QUEUE ITEM"

    Public Class SummaryItem
        Public myItemType As String
        Public myItemAction As String
        Public myItemObject As Object
        Public myCallingMethod As String = ""

        Sub New(ByVal ItemType As String, ByVal ItemAction As String, ByVal ItemObject As Object, Optional CallingMethodName As String = "")
            Try
                Me.myItemType = ItemType
                Me.myItemAction = ItemAction
                Me.myItemObject = ItemObject
                If CallingMethodName IsNot Nothing AndAlso CallingMethodName.Trim <> "" Then myCallingMethod = CallingMethodName.Trim
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Function Clone() As SummaryItem
            Try
                Dim NewItem As New SummaryItem(Me.myItemType, Me.myItemAction, Me.myItemObject)
                Return NewItem
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

    End Class
#End Region

#Region "DATABASE QUEUE ITEM"

    Public Class DatabaseItem
        Public ProcedureName As String
        Public dbCommand As String
        Public CreateTime As Date

        Sub New(ByRef rProcedureName As String, ByRef rdbCommand As String)
            ProcedureName = rProcedureName
            dbCommand = rdbCommand
            CreateTime = Now
        End Sub
    End Class
#End Region

#Region "TRAIN REFRESH QUEUE ITEM"

    Public Class TrainRefreshItem

        Public Enum TrainRefreshType
            TGBO
        End Enum

        Public Enum TrainRefreshAction
            REFRESH
        End Enum

        Public myItemType As TrainRefreshType
        Public myItemAction As TrainRefreshAction
        Public myItemDate As Date = Now

        Sub New(ByVal ItemType As TrainRefreshType, ByVal ItemAction As TrainRefreshAction, ByVal ItemDate As String)
            Try
                Me.myItemType = ItemType
                Me.myItemAction = ItemAction
                If ItemDate IsNot Nothing AndAlso Not String.IsNullOrEmpty(ItemDate) And ItemDate.Trim <> "" Then
                    Date.TryParse(ItemDate, myItemDate)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Function Clone() As SummaryItem
            Try
                Dim NewItem As New SummaryItem(Me.myItemType, Me.myItemAction, Me.myItemDate)
                Return NewItem
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

    End Class
#End Region

