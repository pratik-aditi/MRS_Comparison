        ''' Get Track from milepost
        ''' </summary>
        ''' <param name="trackMilePost">track milePost</param>
        ''' <param name="trackMilepostSuffix">track milepost suffix</param>
        ''' <param name="trackMilepostPreFix">track milepost preFix</param>
        ''' <param name="trackName">track name</param>
        ''' <param name="trackSubdivisionId">track subdivision id</param>
        ''' <returns>Return track object</returns>
        Private Shared Function GetTrack(trackMilePost As String,
                                  trackMilepostSuffix As String,
                                  trackMilepostPreFix As String,
                                  trackName As String,
                                  trackSubdivisionId As Integer) As Track
            Try
                Dim theTrackMilepost As Decimal = Convert.ToDecimal(trackMilePost)
                If theTrackMilepost > 0 Then
                    Return FetchData.FindTrackFromMilePost_PreFixSuffix(theTrackMilepost,
                                                                        trackMilepostSuffix,
                                                                        trackMilepostPreFix,
                                                                        trackName,
                                                                        False,
                                                                        True,
                                                                        trackSubdivisionId)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return Nothing
        End Function

        Public Shared Sub ProcessLocomotiveOnNetworkStatus(ByVal data As String)
            Try
                Dim Messages() As String = data.Split("|")

                Dim TrainSymbol As String = Messages(0)
                Dim UnitID As String = Messages(1)
                Dim Status As String = Messages(2)
                Dim trn As TrainID

                trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(TrainSymbol)

                If IsNothing(trn) Then

                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(UnitID)
                    If IsNothing(trn) Then
                        SystemEvent("PTCMessages-ProcessLocomotiveOnNetworkStatus-TRAIN NOT FOUND:" & data)
                        Exit Sub
                    End If
                End If
                If optEnableShadowMode AndAlso trn IsNot Nothing AndAlso trn.myTrack IsNot Nothing Then
                    If trn.myTrack.myControlPoint.IsShadowMode Then
                        SystemEvent("PTCMessages-ProcessLocomotiveOnNetworkStatus...Train in ShadowMode:" & trn.Name & " Data<" & data & ">")
                        Exit Sub
                    End If
                End If
                Select Case Status
                    Case "OFF-NETWORK"
                        trn.IsPresenceOnNetwork = False
                    Case Else
                        trn.IsPresenceOnNetwork = True
                End Select

                trn.myTrack.InitTrainDisplay()
                trn.myTrack.InvalidateTrainID()
                trn.SetPresenceNetwork()

                Dim LogThisEvent As New DoEventLogTrainID(AddressOf trn.LogTheTrainIDEvent)
                LogThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)

                Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf trn.PublishTrainEvent)
                PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

