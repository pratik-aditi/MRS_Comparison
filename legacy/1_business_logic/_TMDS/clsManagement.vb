        Friend Sub PublishTroubleReport(Action As TROUBLEREPORTSTATUS)
            Dim AddToEventDB As Boolean = True
            Try
                If gPublishBulletinStatus Then
                    Dim Message As String = "DC" & Chr(6) & "TROUBLEREPORT;"
                    Message = Message & "|" & Me.TerritoryID
                    Message = Message & "|" & Action.ToString
                    Message = Message & "|" & Me.GUID

                    Dim MessageToSend As String = Me.TerritoryID.ToString & Chr(12) & Message
                    SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                        TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(MessageToSend)
                    End SyncLock
                    If AddToEventDB Then LogTheBulletinEvent(Message, Me.TerritoryID, Action.ToString)
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Public Sub LogTheBulletinEvent(ByVal ReportData As String, TerritoryID As Integer, Action As String)
            Dim SQLQuery As New StringBuilder
            Dim Message As String = ""
            Try
                Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.UserFullName
                Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                SystemEvent("INCIDENT-REPORT EVENT: " & CurUser & "--" & CurWrkstn & "--" & ReportData.Trim)
                With SQLQuery
                    .Append("INSERT INTO tblSystemEvents")
                    .Append("( ")
                    .Append("[EventTime]")
                    .Append(",[Territory]")
                    .Append(",[Wrkstn]")
                    .Append(",[SysUser]")
                    .Append(",[DbVer]")
                    .Append(",[FuncType]")
                    .Append(",[UID]")
                    .Append(",[Event]")
                    .Append(",[SysData]")
                    .Append(")")
                    .Append("VALUES")
                    .Append("( ")
                    .Append("'" & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & "'")
                    .Append("," & TerritoryID)
                    .Append("," & CurWrkstn)
                    .Append(",'" & CurUser & "'")
                    .Append(",''")
                    .Append(",'INCIDENT-REPORT'")
                    .Append(",0")
                    .Append(",'" & Action.ToUpper.Trim & "'")
                    .Append(",'" & TMDS.SystemUtilities.Formatting.FormatProperStringForDatabase(ReportData) & "'")
                    .Append(" )")
                End With

                SyncLock gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(SQLQuery.ToString)
                End SyncLock
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Public Function GetDelayComment() As String
            Dim strComments As New StringBuilder

            Try
                strComments.Append("IncidentType:" & Me.IncidentType & "|")
                strComments.Append("IncidentSubType:" & Me.IncidentSubType & "|")
                Select Case Me.IncidentType
                    Case "HIGHWAY CROSSING"
                        With strComments
                            .Append("XingLocationDOT:" & Me.XingLocationDOT & "|")
                            .Append("XingLocationCity:" & Me.XingLocationCity & "|")
                            .Append("XingLocationSubUID:" & Me.XingLocationSubUID & "|")
                            .Append("XingLocationCity:" & Me.XingLocationCity & "|")
                            .Append("XingLocationMilePost:" & Me.XingLocationMilePost & "|")
                            .Append("CrossingProtection:" & Me.CrossingProtection & "|")
                            .Append("CrossingProtectionInfo:" & Me.CrossingProtectionInfo & "|")
                            .Append("TroubleDescription:" & Me.TroubleDescription & "|")
                            .Append("AdditionalInformation:" & Me.AdditionalInformation & "|")

                        End With
                    Case "ENROUTE FAILURE EVENT"
                    Case Else
                        With strComments

                            .Append("DeviceName:" & Me.DeviceName & "|")
                            .Append("ControlPointName:" & Me.ControlPointName & "|")
                            .Append("SubdivisionName:" & Me.SubdivisionName & "|")
                            .Append("TrackName:" & Me.TrackName & "|")
                            .Append("TroubleDescription:" & Me.TroubleDescription & "|")
                            .Append("AdditionalInformation:" & Me.AdditionalInformation & "|")

                        End With
                End Select
                Return strComments.ToString
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return String.Empty
        End Function

