            Dim OldTrainCrew As TrainCrew = Nothing
            Try
                If myTrain IsNot Nothing Then
                    Select Case myTrain.CrewCurrent.Engineer.NameOfPerson.Trim.ToUpper
                        Case "NONE", "ENGINEER", "----", "---", String.Empty
                        Case Else
                            HasEngineerOrConductor = True
                    End Select
                    Select Case myTrain.CrewCurrent.Conductor.NameOfPerson.Trim.ToUpper
                        Case "NONE", "CONDUCTOR", "----", "---", String.Empty
                        Case Else
                            HasEngineerOrConductor = True
                    End Select

                    If ForceCurrentCrewUpdate Then
                        myTrain.CrewCurrent = New TrainCrew
                        myTrain.CrewCurrent.CreateCrewString()
                        myTrain.CrewCurrent.ApplyCrewString(TaskData)

                    ElseIf Not HasEngineerOrConductor Then
                        myTrain.CrewCurrent = New TrainCrew
                        myTrain.CrewCurrent.CreateCrewString()
                        myTrain.CrewCurrent.ApplyCrewString(TaskData)
                        TMDS.NetworkMessages.CadMessages.SendTrainCrewEventARRC(myTrain, gMISTransmitQueue, True, "NEW")
                    Else
                        myTrain.CrewRelief = New TrainCrew
                        myTrain.CrewRelief.CreateCrewString()
                        myTrain.CrewRelief.ApplyCrewString(TaskData)
                        'OldTrainCrew = myTrain.CrewCurrent
                        'myTrain.CrewCurrent.ApplyCrewString(TaskData)
                        'TMDS.NetworkMessages.CadMessages.SendTrainCrewEventARRC(myTrain, gCadTransmitQueue, True, "MODIFY")
                        'myTrain.RecordCrewChangeEvent(OldTrainCrew)

                    End If
                    Return True
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function ApplyCrew(ByVal IsReliefCrew As Boolean) As Boolean
            Dim HasEngineerOrConductor As Boolean = False
            Dim OldTrainCrew As TrainCrew = Nothing
            Try
                If myTrain IsNot Nothing Then
                    Dim CrewData As String = Me.TaskData
                    Select Case myTrain.CrewCurrent.Engineer.NameOfPerson.Trim.ToUpper
                        Case "NONE", "ENGINEER", "----", "---", String.Empty
                        Case Else
                            HasEngineerOrConductor = True
                    End Select
                    Select Case myTrain.CrewCurrent.Conductor.NameOfPerson.Trim.ToUpper
                        Case "NONE", "CONDUCTOR", "----", "---", String.Empty
                        Case Else
                            HasEngineerOrConductor = True
                    End Select

                    If Not IsReliefCrew Then
                        OldTrainCrew = myTrain.CrewCurrent
                        myTrain.CrewCurrent = New TrainCrew
                        myTrain.CrewCurrent.CreateCrewString()
                        myTrain.CrewCurrent.ApplyCrewString(CrewData)
                        TMDS.NetworkMessages.CadMessages.SendTrainCrewEventARRC(myTrain, gMISTransmitQueue, True, "N")
                        myTrain.RecordCrewChangeEvent(OldTrainCrew)
                    Else
                        myTrain.CrewRelief = New TrainCrew
                        myTrain.CrewRelief.CreateCrewString()
                        myTrain.CrewRelief.ApplyCrewString(CrewData)
                    End If
                    Return True
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

