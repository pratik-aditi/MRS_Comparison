        ''' <summary>
        ''' Process Text Message Alert
        ''' ChrW(1) "VETMS;TRAIN-TEXT-MESSAGE;TST0001;MRS   1234;message test" ChrW(4)
        ''' </summary>
        ''' <param name="message">message received from BOS</param>
        Public Shared Sub ProcessTextMessageAlert(message As String)
            Try
                Dim methodName As String = $"{NameOf(PTCMessages)}.{NameOf(ProcessTextMessageAlert)}"
                SystemEvent($"{methodName} Message={message}")
                Dim data() As String = message.Split(";")
                If data.Length < 5 Then
                    SystemEvent($"{methodName} Message error.")
                    Exit Sub
                End If
                Dim symbol As String = data(2).Trim
                Dim locomotiveId As String = data(3).Trim
                'try to join the text message when exist a semicolon
                Dim searchTerm As String = $";{data(4)}"
                Dim text As String = If(message.Contains(searchTerm), message.Substring(message.IndexOf(searchTerm) + 1), data(4))
                text = text.ToUpper.Replace(Chr(4), String.Empty).Replace(";", ":")
                Dim train As TrainID = FetchData.FindTrainFromSymbol(symbol)
                If train Is Nothing Then train = FetchData.FindTrainFromIDUnit(locomotiveId)
                If train Is Nothing Then
                    SystemEvent($"{methodName} Train not found.")
                    Exit Sub
                End If
                train.myTextMessageList.Add($"{Format(Now, "MM-dd-yy HH:mm:ss")}{vbTab}>>>{text}")
                AlertUtilities.CreateAlert(Alert.AlertType.VETMS_PTC_TextMessage, text, train)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

