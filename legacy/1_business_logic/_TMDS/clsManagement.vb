        Private Function CheckSrInCollection(SRGUID As String) As Boolean
            Dim sr As SignalRoute = Nothing
            Try
                If SRGUID.ToUpper.Trim = "E304A00766" Then
                    Beep()
                    Beep()
                End If
                If gSignalRouteList IsNot Nothing AndAlso gSignalRouteList.Count > 0 Then
                    For Each sr In gSignalRouteList
                        If sr.SystemUID.ToUpper.Trim = SRGUID.ToUpper.Trim Then Return True
                    Next
                Else
                    Return False
                End If
            Catch ex As Exception

            End Try
