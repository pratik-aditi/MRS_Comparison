                        TaskDetails = "REQUEST AUTHORITY RELEASE FROM TRAIN (" & Me.myTrain.Name & ") EMPLOYEE (" & data(5) & ") AUTHORITY NUMBER (" & data(1) & ")"
                        AlertMessage = "AUTHORITY RELEASE REQUEST FROM TRAIN CREW FOR (" & Me.myTrain.Name & ") AUTHORITY NUMBER (" & data(1) & "). PLEASE VERIFY"
                        ShowAlertForCrewRequest = True


                    Case "IETMS-CONSIST-CHANGE"

                        TaskName = "CONSIST CHANGE FROM CREW"
                        TaskDetails = "NEW CONSIST (TYPE=" & data(0) & ") (LOADS=" & data(1) & ") (EMTS=" & data(2) & ") (TONS=" & data(4) & ") (LEN=" & data(3) & ") (NUM OF OPB=" & data(7) & ") (NUM OF AXLES=" & data(6) & ") (MAX SPD=" & data(5) & ")"
                        AlertMessage = "NEW CONSIST UPDATE RECEIVED FROM TRAIN CREW FOR (" & Me.myTrain.Name & "). PLEASE VERIFY"
                        ShowAlertForConsist = True

                    Case "CONSIST-CHANGE"
                        '6|0|750|613|0|30|
                        TaskName = "CONSIST CHANGE"
                        TaskDetails = "NEW CONSIST (LOADS=" & data(0) & ") (EMTS=" & data(1) & ") (TONS=" & data(2) & ") (LEN=" & data(3) & ") (NUM OF OPB=" & data(4) & ") (NUM OF AXLES=" & data(5) & ")"
                        AlertMessage = "NEW CONSIST UPDATE RECEIVED FOR (" & Me.myTrain.Name & "). PLEASE VERIFY"
                        ShowAlertForConsist = True
                    Case "TRAIN-RESTRICTION-ADDED"
                        ShowWTinTaskWindow = False
                        'N|NB-08-044|HALX|1052|HW|Will not clear AIA Depot Platform.  Will not clear all building doors.  Be sure opening has adequate height for bilevel dome car|Y |NO CLEARANCE|45.6|47.1|20|
                        TaskName = "RESTRICTION ADDED"
                        TaskDetails = "NEW RESTRICTION (" & data(2) & data(3) & ") BETWEEN (" & data(8) & ") AND (" & data(9) & ")  AT (" & data(10) & " MPH)"
                        ApplyRestriction(True)
                        RemoveWorkTask = True
                    Case "WORKORDER-ADDED"
                        'P|1|ACHG|CUSTOMER CALLED|MSEX|7087|84|85|L|4|1|
                        TaskName = "WORK ORDER ADDED"
                        Dim WorkType As String = "PICKUP"
                        If data(0) = "S" Then WorkType = "SETOUT"
                        TaskDetails = "NEW WORK ORDER (" & WorkType & ")  (" & data(4) & data(5) & ")  (" & data(3) & ") (" & data(2) & ")"

                    Case "CREW-CHANGE-CURRENT"
                        TaskName = "CURRENT CREW CHANGE"
                        TaskDetails = "CHANGE CREW TO? " & Chr(10) & GetCrewDisplayData(True) & ""
                    Case "CREW-CHANGE-RELIEF"
                        TaskName = "RELIEF CREW CHANGE"
                        TaskDetails = "CREW CHANGE " & Chr(10) & GetCrewDisplayData() '& ")"


                    Case "LEAD-UNIT-CHANGE"
                        '1|ARR |4318|1|ANCH||
                        TaskName = "LEAD UNIT CHANGE"
                        TaskDetails = "NEW LEAD UNIT (" & data(1) & Space(2) & data(2) & ")"
                    Case "UNIT-CHANGE"
                        TaskName = "UNIT CHANGE"
                        TaskDetails = "UNIT CHANGE (" & Me.TaskData.Trim & ")"

                    Case "OTHER-UNIT-CHANGE"
                        '1|ARR |4318|1|ANCH|N|
                        TaskName = "UNIT CHANGE"
                        TaskDetails = "NEW UNIT(s)"
                        Dim units() As String = TaskData.Split(";")
                        Dim u As String
                        For Each u In units
                            If Trim(u) <> "" Then
                                Dim udata() As String = u.Split("|")
                                TaskDetails = TaskDetails & " (" & udata(1) & Space(2) & udata(2) & ") AT POSITION (" & udata(3) & ")"
                            End If
                        Next

                End Select

                If myTrain IsNot Nothing AndAlso myTrain.myTrack IsNot Nothing Then
                    If myTrain.myTrack.myControlPoint.IsShadowMode Then
                        ShowWTinTaskWindow = False
                        ShowAlertForConsist = False
                        ShowAlertForCrewRequest = False
                    End If
                End If

                If ShowWTinTaskWindow Then
                    If Not CheckIfWorkTaskExists() Then
                        gWorkTasks.Add(Me)
                        Dim SummItem As New SummaryItem("WORKTASK", "ADD", Me)
                        SyncLock TMDS.GlobalDeclarations.gWorkTasksSummaryQueue.SyncRoot
                            TMDS.GlobalDeclarations.gWorkTasksSummaryQueue.Enqueue(SummItem)
                        End SyncLock
                    End If

                End If
                If ShowAlertForConsist Then
                    If Not TMDS.SystemUtilities.Utilities.CheckForAlertExtistenceByAlertData(AlertMessage) Then
                        Dim al As Alert = TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.ConsistUpdate, AlertMessage, Me.myTrain)
                    End If
                ElseIf ShowAlertForCrewRequest Then
                    If Not TMDS.SystemUtilities.Utilities.CheckForAlertExtistenceByAlertData(AlertMessage) Then
                        Dim al As Alert = TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.VETMS_PTC_CrewRequest, AlertMessage, Me.myTrain)
                    End If

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function ApplyWorkTask(ByVal DeletedByDispatcher As Boolean, Optional ByVal pForm As Object = Nothing, Optional LaunchPoint As Point = Nothing) As Boolean
            Try
                If gAssistMode Then Exit Function
                Select Case TaskType
                    Case "IETMS-CONSIST-CHANGE"
                        If Not ApplyConsistFromCrewChange(pForm, True) Then Return False
                    Case "CONSIST-CHANGE"
                        '6|0|750|613|0|30|
                        If Not ApplyConsist(pForm) Then Return False
                    Case "TRAIN-RESTRICTION-ADDED"
                        'N|NB-08-044|HALX|1052|HW|Will not clear AIA Depot Platform.  Will not clear all building doors.  Be sure opening has adequate height for bilevel dome car|Y |NO CLEARANCE|45.6|47.1|20|
                        ApplyRestriction()

                    Case "WORKORDER-ADDED"
                        'P|1|ACHG|CUSTOMER CALLED|MSEX|7087|84|85|L|4|1|
                        If Not ApplyWorkOrder(DeletedByDispatcher, pForm) Then Return False

                        'Case "CREW-CHANGE"
                        '    If Not ApplyCrew() Then Return False

                    Case "CREW-CHANGE-CURRENT"
                        If Not ApplyCrew(True) Then Return False
                    Case "CREW-CHANGE-RELIEF"
                        If Not ApplyCrew(True) Then Return False

                    Case "LEAD-UNIT-CHANGE"
                        '1|ARR |4318|1|ANCH||
                        If Not ApplyUnitChange(True, pForm, LaunchPoint) Then Me.IgnoreErrorPrompt = True : Return False
                    Case "OTHER-UNIT-CHANGE"
                        '1|ARR |4318|1|ANCH|N|
                        ApplyUnitChange(False, pForm, LaunchPoint)
                    Case "UNIT CHANGE", "UNIT-CHANGE"
                        If Not ApplyUnitChange_New(pForm) Then
                            Return False
                        End If
                End Select
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Function CheckIfWorkTaskExists() As Boolean
            Dim wt As WorkTask
            Try
                If gWorkTasks Is Nothing Then
                    gWorkTasks = New ArrayList
                    Return False
                End If
                If gWorkTasks IsNot Nothing AndAlso gWorkTasks.Count > 0 Then
                    For Each wt In gWorkTasks
                        If wt.UID.Trim.ToUpper = Me.UID.Trim.ToUpper Then
                            Return True
                        End If
                    Next
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function

