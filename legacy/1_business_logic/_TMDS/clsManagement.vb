        ''' <summary>
        ''' Create Message Response to PSS
        ''' </summary>
        ''' <param name="message">message to received</param>
        ''' <param name="authority">authority assigned with message</param>
        Private Shared Sub ProcessMA_1051_PSS_CreateMessageResponse(message As String,
                                                                    authority As OtherSpecialAuthorityType)
            Try
                If String.IsNullOrWhiteSpace(message) Then
                    SystemEvent($"{GetCurrentMethod.Name}:Message is null")
                    Exit Sub
                End If
                If authority Is Nothing Then
                    SystemEvent($"{GetCurrentMethod.Name}:Authority is nothing")
                    Exit Sub
                End If
                Select Case message
                    Case "FAILED"
                        authority.PTCStatus = "AUTHORITY-FAILED"
                        authority.VETMS_GenerateIssuanceFailure()
                    Case "DELIVERED"
                        authority.PTCStatus = "AUTHORITY-DELIVERED"
                        authority.PTCIssuanceSuccessful = True
                        authority.CheckToAcknowledgeAlert()
                    Case "ACCEPTED"
                        authority.PTCStatus = "AUTHORITY-ACTIVATED"
                End Select
                If authority.UpdateDatabaseWithPTCAuthorityStatus(authority.PTCStatus) Then
                    SystemEvent($"{GetCurrentMethod.Name}:Authority {authority.AuthorityUID _
                                } updated with status {authority.PTCStatus}")
                End If
                authority.SetPTCAuthorityFlasherStatus()
                authority.SendEvents(OtherSpecialAuthorityType.EventTypeTNT.UPDATE)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

