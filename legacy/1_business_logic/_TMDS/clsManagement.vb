        Public Sub ShowCommAlarmForTrackZone()
            Try
                Dim FirstTrack As Track = TrackList.Item(0)
                Dim LastTrack As Track = TrackList.Item(TrackList.Count - 1)
                Dim BeginLimit As String = "NONE"
                Dim EndLimit As String = "NONE"

                If Not IsNothing(FirstTrack) Then
                    BeginLimit = FirstTrack.LeftLimitName
                End If

                If Not IsNothing(LastTrack) Then
                    EndLimit = LastTrack.RightLimitName
                End If

                Dim AlertMessage As String = ZoneName & "|" & ZoneUID.ToString & "|" & BeginLimit & " TO " & EndLimit
                'check for existing alert
                Dim al As Alert
                Dim AlertExists As Boolean
                For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                    If al.AlertData = AlertMessage And Not al.AlertAcknowledged Then
                        AlertExists = True
                        Exit For
                    End If
                Next
                For Each al In gSystemAlertQueue

                    If al.AlertData = AlertMessage And Not al.AlertAcknowledged Then
                        AlertExists = True
                        Exit For
                    End If
                Next
                If Not AlertExists Then
                    TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.TrackZoneCommFailure, AlertMessage, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Me)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

