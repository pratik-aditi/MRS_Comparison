        Private Shared Sub LoadBulletinCell()
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Query As New StringBuilder
            Dim TempList As New ArrayList
            Try
                Query.Append("SELECT * FROM blBulletinCells ")
                Dim sbCount As Integer
                Dim sb As Subdivision
                For Each sb In ControlledSubdivisions
                    If sbCount = 0 Then
                        Query.Append(" WHERE (StartSubdivisionUID=" & sb.GUID & " OR EndSubdivisionUID= " & sb.GUID & ")")
                    Else
                        Query.Append(" OR (StartSubdivisionUID=" & sb.GUID & " OR EndSubdivisionUID= " & sb.GUID & ")")
                    End If
                    sbCount += 1
                Next
                Query.Append(" ORDER BY TypeOfCell, Name")
                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                dbcomm = New OleDbCommand(Query.ToString, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read
                    Dim BC As New BulletinCell
                    With BC
                        If Not dr.IsDBNull(0) Then .myUID = dr.GetInt32(0)
                        If Not dr.IsDBNull(1) Then .myName = dr.GetString(1)
                        If Not dr.IsDBNull(2) Then .CellType = dr.GetString(2)
                        SystemEvent("BULLETIN-CELL:" & .myUID & ":" & .myName & ":" & .CellType)
                        If Not dr.IsDBNull(3) Then .MileageRangeDefinitions = dr.GetString(3)
                        If Not dr.IsDBNull(4) Then .StartSubdivisionUID = dr.GetInt32(4)
                        If Not dr.IsDBNull(5) Then .EndSubdivisionUID = dr.GetInt32(5)
                        If dr.FieldCount >= 10 Then
                            If Not dr.IsDBNull(6) Then .StartLocationUID = dr.GetInt32(6)
                            If Not dr.IsDBNull(7) Then .StartLocationName = dr.GetString(7)
                            If Not dr.IsDBNull(8) Then .PrintFaxListDefinitions = dr.GetString(8)
                            If Not dr.IsDBNull(9) Then .myNameAbbreviation = dr.GetString(9)
                        End If
                        If dr.FieldCount >= 13 Then
                            If Not dr.IsDBNull(10) Then .Language = dr.GetString(10)
                            If Not dr.IsDBNull(11) Then .OfficeUID = dr.GetInt32(11)
                            If Not dr.IsDBNull(12) Then .ReCreateTime = dr.GetDateTime(12)
                        End If
                    End With
                    TempList.Add(BC)
                End While
                If TempList.Count > 0 Then
                    SyncLock gBulletinCellRouteList
                        gBulletinCellRouteList.Clear()
                        gBulletinCellRouteList = TempList.Clone
                    End SyncLock
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                dbconn.Close()
                dbconn = Nothing
                dbcomm = Nothing
                dr = Nothing
            End Try
        End Sub

        Public Shared Sub ProcessBulletinMessage(ByVal messageToProcess As String)
            Try
                SystemEvent("ProcessBulletinMessage:" & messageToProcess)
                Dim data() As String = messageToProcess.Split(";")
                Dim theCommand As String = data(1)
                Dim theBulletinGUID As String = data(2)
                Dim theBull As SubBulletin = TMDS.SystemUtilities.FetchData.FindBulletinByGUID(theBulletinGUID)
                If IsNothing(theBull) Then Exit Sub
                Select Case theCommand
                    Case "DELETED"
                        If TMDS.GlobalDeclarations.BulletinCollection.Contains(theBull) Then
                            DeleteFromSubdivision(theBull)
                            TMDS.GlobalDeclarations.BulletinCollection.Remove(theBull)
                            Dim SummItem As New SummaryItem("SUB-BULLETIN", "REMOVE", theBull, "Manage_PRemoveGBO")
                            SyncLock gSubBulletinsMessageSummaryQueue.SyncRoot
                                gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                            End SyncLock
                        End If
                End Select
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub DeleteFromSubdivision(ByVal theBull As SubBulletin)
            Try
                Dim s As Subdivision
                For Each s In ControlledSubdivisions
                    Dim b As SubBulletin
                    For Each b In s.BulletinList
                        If b.myGUID = theBull.myGUID Then
                            s.BulletinList.Remove(theBull)
                            Exit Sub
                        End If
                    Next
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

