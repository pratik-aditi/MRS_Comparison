        Private Function DatabaseCommand(ByRef CommandString As String) As Boolean
            Dim CommandInsert As OleDbCommand = Nothing
            Dim newDBconn As OleDbConnection = Nothing
            Try
                newDBconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                If newDBconn.State <> ConnectionState.Open Then
                    newDBconn.Open()
                End If
                CommandInsert = New OleDbCommand(CommandString, newDBconn)
                CommandInsert.ExecuteNonQuery()

                'newDBconn.Close()
                'CommandInsert = Nothing
                'newDBconn = Nothing
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                'CommandInsert = Nothing
                'newDBconn = Nothing
            Finally
                If Not newDBconn Is Nothing Then
                    If newDBconn.State = ConnectionState.Open Then newDBconn.Close()
                    newDBconn.Dispose()
                    newDBconn = Nothing
                End If
                If Not CommandInsert Is Nothing Then
                    CommandInsert.Dispose()
                    CommandInsert = Nothing
                End If
            End Try

        End Function

        Public Class AlertTimeSort
            Implements IComparer

            Private mSortOrder As SortOrder
            Public Sub New(ByVal sortOrder As SortOrder)
                mSortOrder = sortOrder
            End Sub

            Public Function Compare(ByVal x As Object, ByVal y As Object) As Integer Implements IComparer.Compare
                Dim Result As Integer
                Dim ItemX As Alert
                Dim ItemY As Alert
                ItemX = CType(x, Alert)
                ItemY = CType(y, Alert)
                Result = DateTime.Compare(CType(ItemX.AlertTime, DateTime), CType(ItemY.AlertTime, DateTime))
                If mSortOrder = SortOrder.Descending Then
                    Result = -Result
                End If
                Return Result
            End Function
        End Class


        Public Function InsertAlertIntoDB() As Boolean
            Dim CommandInsert As OleDbCommand = Nothing
            Try
                Dim SQLFields As String
                Dim SQLValues As String
                Dim SetAlertInsertCommand As String
                Dim q As String = "'"
                Dim s As String = ", "

                SQLFields = "(AlertGUID, AlertTime, AlertType, AckByPerson, "
                SQLFields = SQLFields & "AlertObjectUID, AlertData, AlertTerrID, Critical"
                SQLFields = SQLFields & ")"
                SQLValues = " VALUES ("
                SQLValues = SQLValues & q & Trim(Me.AlertGUID) & q & s & q & Me.AlertTime & q & s & q & Me.TypeOfAlert.ToString.ToUpper & q
                SQLValues = SQLValues & s & q & Me.AlertAckedByPerson & q & s & q & Me.AlertObjectUID & q & s & q & SpclToEsc(Me.AlertData) & q
                SQLValues = SQLValues & s & Me.AlertTerrID
                SQLValues = SQLValues & s & CInt(Me.Critical)
                SQLValues = SQLValues & ")"

                SetAlertInsertCommand = "INSERT Into " & gtblAlertsActive & SQLFields & SQLValues
                Using dbConn As New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                    dbConn.Open()
                    CommandInsert = New OleDbCommand(SetAlertInsertCommand, dbConn)
                    CommandInsert.ExecuteNonQuery()
                End Using
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If Not CommandInsert Is Nothing Then CommandInsert.Dispose()
                CommandInsert = Nothing
            End Try

        End Function

        Public Sub AcknowledgeAlertInDatabase()
            Dim UpdateString As String
            'Dim dbConn As OleDb.OleDbConnection = Nothing
            Dim CommandInsert As OleDbCommand = Nothing

            Try
                UpdateString = "UPDATE " & gtblAlertsActive & " SET AckByPerson='" & gCurrentUser.LastName & "," & gCurrentUser.FirstName & "' WHERE AlertGUID='" & Me.AlertGUID & "'"
                Using dbConn As New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                    dbConn.Open()
                    CommandInsert = New OleDbCommand(UpdateString, dbConn)
                    CommandInsert.ExecuteNonQuery()
                End Using
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If Not CommandInsert Is Nothing Then CommandInsert.Dispose()
                CommandInsert = Nothing
            End Try
        End Sub

        Public Function RemoveAlertFromDatabase() As Boolean
            Dim dbcomm As OleDbCommand = Nothing
            Dim QueryList As New ArrayList
            Try
                Dim QueryDelete As String = "DELETE FROM " & gtblAlertsActive & " WHERE AlertGUID = '" & Me.AlertGUID & "'"
                Dim QueryInsert As String = "INSERT INTO " & gtblAlertsInActive & " SELECT * FROM " & gtblAlertsActive & " WHERE AlertGUID = '" & Me.AlertGUID & "'"

                Try
                    'Move to Inactive table
                    QueryList.Add(QueryInsert)
                    QueryList.Add(QueryDelete)

                    If Not ExecuteQueryCollection(QueryList, gConnectionStringDynamic) Then
                        Return False
                    End If
                Catch ex As Exception
                    SystemException(ex.ToString)
                    Return False
                Finally
                    QueryList = Nothing
                End Try
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return True
        End Function

    End Class

    Public Class AlertUtilities

        Public Shared Function CreateAlarmAlert(ByVal theTypeOfAlert As Alert.AlertType, ByVal DataString As String, theAlarm As AlarmAlert) As Alert
            Try
                Dim theUser As String = TMDS.GlobalDeclarations.gCurrentUser.LastName & ", " & TMDS.GlobalDeclarations.gCurrentUser.FirstName
                Dim Al As Alert = Nothing
                Al = New Alert(theTypeOfAlert, DataString, theUser, theAlarm)
                If Not Al Is Nothing Then
                    SyncLock TMDS.GlobalDeclarations.gSystemAlertQueue
                        Select Case theTypeOfAlert
                            Case Alert.AlertType.EventLogDatabaseAlert, Alert.AlertType.CADCommunicationConnectionLost, Alert.AlertType.GPSCommunicationConnectionLost, Alert.AlertType.MISCommunicationConnectionLost, Alert.AlertType.ControlSvrConnectionLost, Alert.AlertType.ControlSvrConnected
                                If Not CheckIfAlertExists(theTypeOfAlert) Then
                                    TMDS.GlobalDeclarations.gSystemAlertQueue.Enqueue(Al)
                                End If
                            Case Else
                                TMDS.GlobalDeclarations.gSystemAlertQueue.Enqueue(Al)
                        End Select
                    End SyncLock
                End If
                Return Al
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

