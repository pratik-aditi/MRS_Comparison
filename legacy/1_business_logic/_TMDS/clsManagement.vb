        Sub New(ByVal theType As AlertType, ByVal theData As String, ByVal thePerson As String, ByVal theObject As Object, Optional ByVal AlertTrain As TrainID = Nothing)
            AlertTime = Now
            TypeOfAlert = theType
            AlertData = theData
            AlertAckedByPerson = thePerson
            AlertObject = theObject
            AlertTrain = AlertTrain
            Me.Critical = True
            Try
                If IsNothing(AlertObject) Then
                    Exit Sub
                End If
                Select Case AlertObject.GetType.ToString
                    Case "TMDS.SwitchComponents.Switch"
                        AlertObjectUID = AlertObject.GUID.ToString
                        Dim sw As Switch = CType(AlertObject, Switch)
                        Me.AlertTerrID = sw.TerritoryID
                    Case "TMDS.TrackComponents.Track"
                        AlertObjectUID = AlertObject.GUID.ToString
                        Dim trk As Track = CType(AlertObject, Track)
                        Me.AlertTerrID = trk.TerritoryID
                    Case "TMDS.SignalComponents.Signal"
                        AlertObjectUID = AlertObject.GUID.ToString
                        Dim sig As Signal = CType(AlertObject, Signal)
                        Me.AlertTerrID = sig.TerritoryID
                    Case "TMDS.MobileTracking.Vehicle"
                        AlertObjectUID = AlertObject.VehicleID
                        Dim veh As MobileTracking.Vehicle = CType(AlertObject, MobileTracking.Vehicle)
                        Me.AlertTerrID = veh.TerrID
                    Case "TrainID", "TMDS.TrainComponents.TrainID"
                        AlertObjectUID = AlertObject.Name
                        Dim trn As TrainID = CType(AlertObject, TrainID)
                        Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trn.TrackGUID)
                        If Not trk Is Nothing Then
                            Me.AlertTerrID = trk.TerritoryID
                        End If
                    Case "TMDS.GraphicComponent.Device"
                        AlertObjectUID = AlertObject.GUID.ToString
                        Dim dv As Device = CType(AlertObject, Device)
                        Me.AlertTerrID = dv.TerritoryID
                    Case "TMDS.TrackTagComponents.Tag"
                        Dim tagAux As Tag = CType(AlertObject, Tag)
                        AlertObjectUID = tagAux.TagGuid
                        Me.AlertTerrID = tagAux.TerritoryID
                End Select
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

