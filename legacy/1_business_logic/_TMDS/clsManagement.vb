        Private Function GetLastActiveTBNumber(ByVal SubName As String, ByVal SubBullType As String) As Integer
            Dim ActiveSQLQuery As New StringBuilder ' = "SELECT GTBNumber FROM [tblGeneralBulletinsActive] WHERE [AtSubdivision]='" & SubName & "' ORDER BY GTBDate DESC"

            With ActiveSQLQuery
                .Append("SELECT RestrictionUID FROM [tblSystemBulletins] WHERE [RestrictionSubName]='" & SubName & "' AND SubType='" & SubBullType & "'")
                .Append(" AND CAST(CONVERT(CHAR(10), RestrictionDate,101)AS DATETIME) >= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                .Append(" AND CAST(CONVERT(CHAR(10), RestrictionDate,101)AS DATETIME) <= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                .Append("ORDER BY RestrictionDate DESC")
            End With

            Dim ds As New DataSet
            Dim CurrentNumber As Integer = 0
            Dim drow As DataRow
            Try
                ds = GetResultDS(ActiveSQLQuery.ToString, False)
                If IsValidDataset(ds) Then
                    drow = ds.Tables(0).Rows(0)
                    Integer.TryParse(drow(0), CurrentNumber)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                Return 0
            End Try
            Return CurrentNumber

        End Function

        Private Function GetLastInActiveTBNumbers(ByVal SubName As String, ByVal SubBullType As String) As ArrayList
            Dim InActiveSQLQuery As New StringBuilder

            With InActiveSQLQuery
                .Append("SELECT RestrictionUID FROM [tblSystemBulletinsInActive] WHERE [RestrictionSubName]='" & SubName & "' AND SubType='" & SubBullType & "'")
                .Append(" AND CAST(CONVERT(CHAR(10), RestrictionDate,101)AS DATETIME) >= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                .Append(" AND CAST(CONVERT(CHAR(10), RestrictionDate,101)AS DATETIME) <= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                .Append("ORDER BY RestrictionDate DESC")
            End With

            Dim ds As New DataSet
            Dim InActiveNumberLst As New ArrayList
            Dim drow As DataRow
            Try
                ds = GetResultDS(InActiveSQLQuery.ToString, False)
                If IsValidDataset(ds) Then
                    drow = ds.Tables(0).Rows(0)
                    For Each drow In ds.Tables(0).Rows
