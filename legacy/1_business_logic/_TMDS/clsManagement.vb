        Public Sub LoadNoteRecords()
            Dim NoteFetch As String
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseCommand As OleDbCommand = Nothing
            Dim note As TMDS.GraphicComponent.Annotation
            Dim trk As TMDS.TrackComponents.Track
            'Dim dbConnection As OleDbConnection = Nothing

            Try
                Using dbConnection As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                    dbConnection.Open()
                    NoteFetch = "SELECT * FROM " & gtblNotesActive
                    NoteFetch = NoteFetch & " WHERE TerritoryAssignmentID = " & TerritoryID
                    DatabaseCommand = New OleDbCommand(NoteFetch, dbConnection)
                    dr = DatabaseCommand.ExecuteReader()
                    While dr.Read()
                        note = New TMDS.GraphicComponent.Annotation()
                        note.Name = dr.GetString(0)
                        note.NoteText = dr.GetString(1)
                        note.Subdivision = dr.GetString(2)
                        note.TerritoryID = dr.GetInt32(3)
                        note.TrackGUID = dr.GetInt32(4)
                        note.xFactor = dr.GetInt32(5)
                        note.yFactor = dr.GetInt32(6)
                        note.CreateTime = dr.GetDateTime(7)
                        note.NoteGUID = dr.GetString(8)
