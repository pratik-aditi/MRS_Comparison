                    Case Alert.AlertType.EventLogDatabaseAlert
                        theAlert = New Alert(theTypeOfAlert, dataString, Nothing, Nothing)
                    Case Alert.AlertType.CadAlertToAssitMode
                        theAlert = New Alert(theTypeOfAlert, dataString, Nothing, Nothing)
                    Case Alert.AlertType.TRAIN_SCHEDULER_ALERT
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                    Case Alert.AlertType.GPS_TrainReportingOnNonOccupiedTrack
                        theAlert = New Alert(theTypeOfAlert, dataString, Nothing, theTrain)
                    Case Alert.AlertType.ConsistUpdate, Alert.AlertType.VETMS_PTC_CrewRequest
                        theAlert = New Alert(theTypeOfAlert, dataString, Nothing, theTrain)
                    Case Alert.AlertType.Bulletin_FormC
                        theAlert = New Alert(theTypeOfAlert, dataString, Nothing, theTrain)
                    Case Alert.AlertType.FEDDataAlert
                        theAlert = New Alert(theTypeOfAlert, dataString, Nothing, theEquipment)
                    Case Alert.AlertType.FEDDataAlertBroadCast
                        theAlert = New Alert(theTypeOfAlert, dataString, Nothing, theEquipment)
                    Case Alert.AlertType.CADCommunicationConnectionLost,
                         Alert.AlertType.GPSCommunicationConnectionLost,
                         Alert.AlertType.MISCommunicationConnectionLost,
                         Alert.AlertType.CommunicationServerConnected,
                         Alert.AlertType.CommunicationServerConnected,
                         Alert.AlertType.ControlSvrConnectionLost,
                         Alert.AlertType.ControlSvrConnected
                        theAlert = New Alert(theTypeOfAlert, dataString, Nothing, Nothing)
                    Case Alert.AlertType.DeviceBlockExpiration
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theDeviceBlock)
                    Case Alert.AlertType.AutoConsist
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                    Case Alert.AlertType.HotBox
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                    Case Alert.AlertType.Scale
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                    Case Alert.AlertType.Crew
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                    Case Alert.AlertType.PlannedTrains
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                    Case Alert.AlertType.ScaleAlarmUrgent,
                         Alert.AlertType.ScaleAlarm
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theDevice)
                    Case Alert.AlertType.Interjourney
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                End Select
                Try
                    If theAlert IsNot Nothing Then
                        SystemEvent($"NEW ALERT CREATED <GUID: {theAlert.AlertGUID}> <TYPE OF ALERT: {theTypeOfAlert}> <ALERT DATA: {dataString}>")
                        If optEnableInsertAllAlertsIntoDB And
                            theAlert.Critical And
                            theAlert.TypeOfAlert <> Alert.AlertType.NonIdentifiedTrackOccupancy Then
                            theAlert.InsertAlertIntoDB()
                        End If
                    End If
                Catch exp As Exception
                End Try
                If Not theAlert Is Nothing Then
                    SyncLock gSystemAlertQueue
                        Select Case theTypeOfAlert
                            Case Alert.AlertType.EventLogDatabaseAlert,
                                 Alert.AlertType.CADCommunicationConnectionLost,
                                 Alert.AlertType.GPSCommunicationConnectionLost,
                                 Alert.AlertType.MISCommunicationConnectionLost,
                                 Alert.AlertType.ControlSvrConnectionLost,
                                 Alert.AlertType.ControlSvrConnected
                                If Not CheckIfAlertExists(theTypeOfAlert) Then
                                    gSystemAlertQueue.Enqueue(theAlert)
                                End If
                            Case Else
                                gSystemAlertQueue.Enqueue(theAlert)
                        End Select
                    End SyncLock
                End If
                Return theAlert
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        ''' <summary>
        ''' Load alerts from file
        ''' </summary>
        Public Shared Sub LoadAlertsFromFile()
            Dim myStreamReader As StreamReader
            Dim myAlertString As String
            Dim NewAlert As Alert
            Try
                If Not Directory.Exists(Application.StartupPath & "\Alerts") Then
                    Directory.CreateDirectory(Application.StartupPath & "\Alerts")
                Else
                    If File.Exists(gSystemAlertFile) Then
                        myStreamReader = File.OpenText(gSystemAlertFile)
                        myAlertString = myStreamReader.ReadLine()
                        ' Continue reading while there are still lines to be read
                        While Not myAlertString Is Nothing
                            NewAlert = CreateAlertFromDataLine(myAlertString)
                            If Not NewAlert Is Nothing Then
                                SyncLock TMDS.GlobalDeclarations.gSystemAlertList.SyncRoot
                                    TMDS.GlobalDeclarations.gSystemAlertList.Add(NewAlert)
                                End SyncLock
                            End If
                            myAlertString = myStreamReader.ReadLine()
                        End While
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                myStreamReader = Nothing
                myAlertString = Nothing
                NewAlert = Nothing
            End Try
        End Sub

