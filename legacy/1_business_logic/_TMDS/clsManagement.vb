        Public Sub CreateTagCommand(tagGuid As String)
            Try
                Using dbconn As New OleDbConnection(gConnectionStringDynamic)
                    dbconn.Open()
                    Dim query As String = $"SELECT TrackGUID, Subdivision, TerritoryID, Creator, CreateTime, TagType, 
                                                DataString, Restrictive, RestrictionFlag, DelayData, Delay, TagUID, 
                                                Direction, ExpectedReleaseTime, CompList, RefNumPTC, PTCData, 
                                                NameRequestingTagPlacement, SpeedTagFlagInfo, SpeedTagReasonCode,
                                                CreateSpeedRestriction, SpeedRestrictionCreated, DurationTime, BulletinTag, 
                                                BulletinReferenceGUID, BulletinForProtectionList, BulletinForCancellationList, 
                                                PTCComponents, PTCTrackSegments, PTCBulletinText, MilePostBeginPrefix, 
                                                MilePostEndPrefix, DeliveryOfRestriction, AdvisorySummary, MilePostBeginSuffix, 
                                                MilePostEndSuffix, MilePostBegin, MilePostEnd, PTCCompositionCRC, 
                                                ObjectCRC, CriticalAlertType, HeadEndRestrictionOnly 
                                            FROM tblTrackTagsActive 
                                            WHERE TagUID = '{tagGuid}'"
                    Using dbComm As New OleDbCommand(query, dbconn)
                        Using dr As OleDbDataReader = dbComm.ExecuteReader()
                            While dr.Read()
                                Dim theTrack As Track = FetchData.FindTrackItemFromGUID(dr.GetInt32(0))
                                If theTrack IsNot Nothing AndAlso
                                    optEnableShadowMode AndAlso
                                    Not theTrack.IsShadowMode Then Exit Sub
                                Dim trackTag As New Tag()
                                With trackTag
                                    .TrackGuid = dr.GetInt32(0)
                                    .Subdivision = dr.GetString(1)
                                    .TerritoryID = dr.GetInt32(2)
                                    .Creator = dr.GetString(3)
                                    .CreateTime = dr.GetString(4)
                                    .TagType = dr.GetString(5)
                                    .DataString = dr.GetString(6)
                                    .Restrictive = dr.GetInt32(7)
                                    .Restriction = dr.GetBoolean(8)
                                    .DelayData = dr.GetString(9)
                                    .Delay = dr.GetBoolean(10)
                                    If Not dr.IsDBNull(11) Then .TagGuid = dr.GetString(11).Trim
                                    If .Restrictive = 2 Then .ShowOccupancy = True
                                    If Not dr.IsDBNull(12) Then .Direction = dr.GetString(12).Trim
                                    If theTrack IsNot Nothing Then
                                        If theTrack.AddTagToTrack(trackTag) Then
                                            TrackTags.Add(trackTag)
                                            Dim summItem As New SummaryItem("TAG", "UPDATE", trackTag)
                                            SyncLock gSummaryTagQueue.SyncRoot
                                                gSummaryTagQueue.Enqueue(summItem)
                                            End SyncLock
                                        End If
                                        theTrack.UpdateStatus()
                                    End If
                                End With
                            End While
                        End Using
                    End Using
                End Using
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Modify Tag Command
        ''' </summary>
        ''' <param name="tagGuid"></param>
        Public Sub ModifyTagCommand(tagGuid As String)
            Try
                Dim trackTag As Tag = Nothing
                For Each oneTag As Tag In TrackTags
                    If Trim(oneTag.TagGuid) = Trim(tagGuid) Then
                        trackTag = oneTag
                        Exit For
                    End If
                Next
                If trackTag Is Nothing Then Exit Sub
                Using dbconn As New OleDbConnection(gConnectionStringDynamic)
                    dbconn.Open()
                    Dim query As String = $"SELECT TrackGUID, Subdivision, TerritoryID, Creator, CreateTime, TagType, 
                                                DataString, Restrictive, RestrictionFlag, DelayData, Delay, TagUID, 
                                                Direction, ExpectedReleaseTime, CompList, RefNumPTC, PTCData, 
                                                NameRequestingTagPlacement, SpeedTagFlagInfo, SpeedTagReasonCode,
                                                CreateSpeedRestriction, SpeedRestrictionCreated, DurationTime, BulletinTag, 
                                                BulletinReferenceGUID, BulletinForProtectionList, BulletinForCancellationList, 
                                                PTCComponents, PTCTrackSegments, PTCBulletinText, MilePostBeginPrefix, 
                                                MilePostEndPrefix, DeliveryOfRestriction, AdvisorySummary, MilePostBeginSuffix, 
                                                MilePostEndSuffix, MilePostBegin, MilePostEnd, PTCCompositionCRC, 
                                                ObjectCRC, CriticalAlertType, HeadEndRestrictionOnly 
                                            FROM tblTrackTagsActive 
                                            WHERE TagUID = '{tagGuid}'"
                    Using dbComm As New OleDbCommand(query, dbconn)
                        Using dr As OleDbDataReader = dbComm.ExecuteReader()
                            While dr.Read()
                                With trackTag
                                    Dim theTrack As Track = FetchData.FindTrackItemFromGUID(dr.GetInt32(0))
                                    If theTrack IsNot Nothing AndAlso optEnableShadowMode AndAlso Not theTrack.IsShadowMode Then Exit Sub
                                    .TrackGuid = dr.GetInt32(0)
                                    .Subdivision = dr.GetString(1)
                                    .TerritoryID = dr.GetInt32(2)
                                    .Creator = dr.GetString(3)
                                    .CreateTime = dr.GetString(4)
                                    .TagType = dr.GetString(5)
                                    .DataString = dr.GetString(6)
                                    .Restrictive = dr.GetInt32(7)
                                    .Restriction = dr.GetBoolean(8)
                                    .DelayData = dr.GetString(9)
                                    .Delay = dr.GetBoolean(10)
                                    If Not dr.IsDBNull(11) Then .TagGuid = dr.GetString(11).Trim
                                    If .Restrictive = 2 Then .ShowOccupancy = True
                                    If Not dr.IsDBNull(12) Then .Direction = dr.GetString(12).Trim
                                End With
                            End While
                        End Using
                    End Using
                End Using
                Dim summItem As New SummaryItem("TAG", "UPDATE", trackTag)
                SyncLock gSummaryTagQueue.SyncRoot
                    gSummaryTagQueue.Enqueue(summItem)
                End SyncLock
                Dim singleTrack As Track = FetchData.FindTrackItemFromGUID(trackTag.TrackGuid)
                If singleTrack IsNot Nothing Then
                    singleTrack.InitTagDisplay()
                    singleTrack.UpdateTagStatus()
                    singleTrack.ModifyTagOnTrack(trackTag)
                    singleTrack.UpdateStatus()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub RemoveTagCommand(ByVal TagGuid As String)
            Try
                Dim trk As TMDS.TrackComponents.Track
                Dim tg As TMDS.TrackTagComponents.Tag = Nothing
                Dim tgToRemove As TMDS.TrackTagComponents.Tag = Nothing


                For Each tg In TMDS.GlobalDeclarations.TrackTags
                    If Trim(tg.TagGuid) = Trim(TagGuid) Then
                        tgToRemove = tg

                        trk = Me.FindTrack(CInt(tg.TrackGuid))
                        If Not trk Is Nothing Then
                            If optEnableShadowMode AndAlso Not trk.IsShadowMode Then Exit Sub
                            trk.RemoveTagFromTrack(tg)
                            trk.InitTagDisplay()
                            trk.UpdateTagStatus()
                            trk.UpdateStatus()
                        End If
                        Exit For
                    End If
                Next

                Dim SummItem As New SummaryItem("TAG", "REMOVE", tgToRemove)
                SyncLock gSummaryTagQueue.SyncRoot
                    gSummaryTagQueue.Enqueue(SummItem)
                End SyncLock

                TMDS.GlobalDeclarations.TrackTags.Remove(tgToRemove)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

