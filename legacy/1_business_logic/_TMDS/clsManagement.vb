        Public Sub LoadMOWIDRecords() ' ARRC-1107
            Dim MOWFetch As String
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseCommand As OleDbCommand = Nothing
            Dim mow As TMDS.TrainComponents.MOWID
            Dim trk As TMDS.TrackComponents.Track
            Dim CompCollection As ArrayList
            Dim CompToCheck As Object
            Dim dbConnection As OleDbConnection = Nothing
            dbConnection = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)


            Try
                If gAssistMode AndAlso Not optEnableARRCSpecificOptions Then Exit Sub
                TerritoryEventLog("LOADING MOW IDs...")

                MOWFetch = "SELECT * FROM " & gtblMOWActive
                MOWFetch = MOWFetch & " WHERE TerritoryAssignmentID = " & TerritoryID
                MOWFetch = MOWFetch & " ORDER BY Symbol;"

                Using DbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                    DbConn.Open()
                    DatabaseCommand = New OleDbCommand(MOWFetch, DbConn)
                    dr = DatabaseCommand.ExecuteReader()
                    While dr.Read()

                        mow = New TMDS.TrainComponents.MOWID()
                        Dim DspTxt As String = ""
                        If Not dr.IsDBNull(0) Then DspTxt = dr.GetString(0)
                        If OptShowMOWDisplayText Then
                            If dr.FieldCount > 4 Then

                                If Not dr.IsDBNull(5) AndAlso dr.GetString(5).Trim <> "" Then DspTxt = dr.GetString(5)

                            End If
                        End If
                        With mow
                            .Name = dr.GetString(0)
                            .DisplayText = DspTxt
                            .TrackGUID = dr.GetInt32(3)
                            .Subdivision = dr.GetString(1)
                            .MowGUID = dr.GetString(4)

                        End With
                        Dim OktoAddMow As Boolean = True
                        OktoAddMow = TMDS.SystemUtilities.FetchData.CheckForDupMOW(MOWCollection, mow.MowGUID)
                        If OktoAddMow Then
                            If Not MOWCollection.Contains(mow) Then MOWCollection.Add(mow)
                            'trk = New Track()
                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(mow.TrackGUID)
                            'check for os tracks to see here to put the Train ID and how to show occuppied the other tracks

                            If Not trk Is Nothing Then

                                CompCollection = trk.CollectComponentsOfLikeTracks()

                                If Not CompCollection Is Nothing Then
                                    For Each CompToCheck In CompCollection
                                        If Not CompToCheck.Indicating Then CompToCheck.Occuppied = True
                                        CompToCheck.UpdateStatus()
                                    Next
                                End If


                                trk.AddMOWID(mow)
                                trk.InvalidateMOWID()
                                trk.UpdateStatus()
                                mow = Nothing
                                trk = Nothing

                            End If
                        End If
                    End While
                    DbConn.Close()
                    dr.Close()
                End Using

                Dim RunLength As System.TimeSpan = Now.Subtract(gStartTime)
                Dim Millisecs As Integer = ((RunLength.Seconds * 1000) + RunLength.Milliseconds)
                TerritoryEventLog("MOW IDs LOADED...(" & Millisecs.ToString & ")")


            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If DatabaseCommand IsNot Nothing Then DatabaseCommand.Dispose()
                DatabaseCommand = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try

        End Sub

        Public Function AddMOWToLists(ByVal mow As TMDS.TrainComponents.MOWID) As Boolean ' ARRC-1107

            Dim mowToCheck As TMDS.TrainComponents.MOWID


            Try



                Dim MOWFound As Boolean
                For Each mowToCheck In Me.myMOWs

                    If mowToCheck.Name = mow.Name Or Trim(mowToCheck.MowGUID) = Trim(mow.MowGUID) Then
                        LogEvent("AddMOWToLists-MOW FOUND IN myMOWs, NOT ADDED:" & mow.Name)
                        MOWFound = True

                    End If

                Next


                If Not MOWFound Then
                    LogEvent("AddMOWToLists-MOW ADDED TO myMOWs:" & mow.Name)
                    Me.myMOWs.Add(mow)

                End If

                Dim MOWFoundInCollection As Boolean

                For Each mowToCheck In MOWCollection

                    If mowToCheck.Name = mow.Name Or Trim(mowToCheck.MowGUID) = Trim(mow.MowGUID) Then
                        LogEvent("AddMOWToLists-MOW FOUND IN MOWCollection, NOT ADDED:" & mow.Name)
                        MOWFoundInCollection = True

                    End If

                Next

                If Not MOWFoundInCollection Then
                    LogEvent("AddMOWToLists-MOW ADDED TO MOWCollection:" & mow.Name)
                    MOWCollection.Add(mow)

                End If

                If Not MOWFound Then
                    Return True
                Else
                    Return False
                End If


            Catch ex As Exception

                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)

            End Try

        End Function

        Public Sub MoveMOW(ByVal MOWName As String, ByVal TrackGUID As String, ByVal MOWGUID As String, DisplayText As String, Optional ByVal ShadowMode As Boolean = False) ' ARRC-1107

            Dim mow As TMDS.TrainComponents.MOWID
            Dim Oldtrk As TMDS.TrackComponents.Track = Nothing
            Dim Newtrk As TMDS.TrackComponents.Track = Nothing
            Dim MOWFoundInMOWCollection As Boolean
            Dim MOWFoundInMyMOWCollection As Boolean


            Try
                LogEvent("SUB:MoveMOW" & MOWName & "-" & TrackGUID)
                For Each mow In TMDS.GlobalDeclarations.MOWCollection
                    If mow.Name = MOWName Then
                        LogEvent("MOVE MOW2:" & MOWName)
                        Oldtrk = Me.FindTrack(CInt(mow.TrackGUID))

                        Dim MOWFoundOnTrack As Boolean
                        If Not IsNothing(Oldtrk) Then
                            If Oldtrk.MOWIDs.Count <> 0 Then
                                Dim mow1 As TMDS.TrainComponents.MOWID
                                For Each mow1 In Oldtrk.MOWIDs
                                    If mow.Name = MOWName Then
                                        MOWFoundOnTrack = True
                                        LogEvent("SUB:MoveMOW-MOW FOUND ONTRACK" & MOWName & "-" & TrackGUID)
                                        Exit For

                                    End If
                                Next
                            End If
                        End If



                        If Not MOWFoundOnTrack Then

                            LogEvent("SUB:MoveMOW-MOW NOT FOUND ONTRACK1" & MOWName & "-" & TrackGUID)
                            Dim mow3 As TMDS.TrainComponents.MOWID
                            For Each mow3 In TMDS.GlobalDeclarations.MOWCollection
                                If mow3.Name = MOWName Then
                                    Oldtrk = Me.FindTrack(CInt(mow.TrackGUID))
                                    If Not IsNothing(Oldtrk) Then
                                        LogEvent("SUB:MoveMOW-MOW FOUND ONTRACK" & MOWName & "-" & Oldtrk.GUID.ToString)
                                    End If
                                    Exit For
                                End If
                            Next

                            LogEvent("SUB:MoveMOW-MOW NOT FOUND ONTRACK2" & MOWName & "-" & TrackGUID)

                        End If

                        Newtrk = Me.FindTrack(CInt(TrackGUID))
                        If Not Newtrk Is Nothing Then
                            mow.TrackGUID = TrackGUID
                            Newtrk.MoveMOWIDPlace(mow, Oldtrk, False, ShadowMode)
                            'ARRC-1090
                            Newtrk.InvalidateMOWID()
                            Newtrk.RefreshRemotely()
                            LogEvent("SUB:MOVEMOW-MoveMOWIDPlace-NEWTRK:" & Newtrk.GUID & " OLDTRK:" & Oldtrk.GUID & " MOW:" & mow.Name)
                        Else
                            LogEvent("Newtrk Not Found:" & MOWName)
                        End If

                        If IsNothing(Oldtrk) Then
                            If Not Newtrk Is Nothing Then
                                FindPreviousTrack(MOWName, Newtrk.GUID)
                            End If
                            LogEvent("Oldtrk Not Found:" & MOWName)
                        End If
                        LogEvent("MOW NAME Found:" & MOWName)
                        MOWFoundInMOWCollection = True
                        Exit For

                    End If

                Next



                If MOWFoundInMOWCollection Then
                    For Each mow In Me.myMOWs
                        If mow.Name = MOWName Then
                            LogEvent("SUB:MoveMOW2:" & MOWName)
                            Oldtrk = Me.FindTrack(CInt(mow.TrackGUID))
                            Dim MOWFoundOnTrack As Boolean
                            If Not IsNothing(Oldtrk) Then
                                If Oldtrk.MOWIDs.Count <> 0 Then
                                    Dim mow1 As TMDS.TrainComponents.MOWID
                                    For Each mow1 In Oldtrk.MOWIDs
                                        If mow.Name = MOWName Then
                                            MOWFoundOnTrack = True
                                            LogEvent("SUB:MoveMOW-MOW FOUND ON OLD TRACK:" & TrackGUID & "-" & MOWName)
                                            Exit For
                                        End If
                                    Next

                                End If

                            End If


                            If Not MOWFoundOnTrack Then
                                LogEvent("SUB:MoveMOW-MOW NOT FOUND ON OLD TRACK:" & TrackGUID & "-" & MOWName)
                                Dim mow3 As TMDS.TrainComponents.MOWID
                                For Each mow3 In TMDS.GlobalDeclarations.MOWCollection
                                    If mow3.Name = MOWName Then
                                        Oldtrk = Me.FindTrack(CInt(mow3.TrackGUID))
                                        If Not IsNothing(Oldtrk) Then
                                            LogEvent("SUB:MoveMOW2-MOW FOUND ON OLD TRACK" & Oldtrk.GUID.ToString & "-" & MOWName)
                                        End If
                                        Exit For
                                    End If
                                Next
                                LogEvent("SUB:MoveMOW-MOW FOUND ONTRACK2" & MOWName & "-" & TrackGUID)

                            End If

                            Newtrk = Me.FindTrack(CInt(TrackGUID))
                            If Not Newtrk Is Nothing Then
                                If (Newtrk.GUID <> Oldtrk.GUID) Then


                                    mow.TrackGUID = TrackGUID
                                    Newtrk.MoveMOWIDPlace(mow, Oldtrk, False, ShadowMode)
                                End If
                                'ARRC-1090
                                Newtrk.InvalidateMOWID()
                                LogEvent("SUB:MOVEMOW2-MoveMOWIDPlace-NEWTRK:" & Newtrk.GUID & " OLDTRK:" & Oldtrk.GUID & " MOW:" & mow.Name)
                                Newtrk.RefreshRemotely()
                            Else
                                LogEvent("Newtrk Not Found:" & MOWName)
                            End If



                            If IsNothing(Oldtrk) Then
                                LogEvent("Oldtrk Not Found:" & MOWName)
                            End If

                            LogEvent("MOW NAME2 Found:" & MOWName)
                            Me.AddMOWToLists(mow)
                            MOWFoundInMyMOWCollection = True
                            Exit For
                        End If
                    Next
                End If

                If Not MOWFoundInMOWCollection Then
                    LogEvent("MOW NAME NOT Found in MOWCollection:" & MOWName)
                    If Not MOWFoundInMyMOWCollection Then
                        LogEvent("MOW NAME NOT Found in myMOWCollection:" & MOWName)
                    End If
                End If

                If Not Oldtrk Is Nothing Then
                    If Not Oldtrk.Indicating And Oldtrk.MOWIDs.Count = 0 Then
                        Oldtrk.Occuppied = False
                        Oldtrk.UpdateStatus()
                    End If

                Else

                    If Not Newtrk Is Nothing Then
                        FindPreviousTrack(MOWName, Newtrk.GUID)
                    End If
                    LogEvent("Oldtrk Not Found:" & MOWName)
                End If

                If Not Newtrk Is Nothing Then
                    If Not Newtrk.Indicating Then
                        Newtrk.Occuppied = True
                        'Newtrk.InitMOWDisplay()
                        Newtrk.UpdateStatus()
                    End If
                Else
                    LogEvent("NEWtrk Not Found:" & MOWName & "TRK:" & TrackGUID)
                End If

            Catch ex As Exception
                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            End Try

        End Sub

        Public Sub RemoveMOW(ByVal MOWName As String, MowGUID As String, Optional ByVal ShadowMode As Boolean = False) ' ARRC-1107

            Dim mow As TMDS.TrainComponents.MOWID = Nothing
            Dim MOWToDelete As TMDS.TrainComponents.MOWID = Nothing
            Dim trk As TMDS.TrackComponents.Track
            Dim UseGUID As Boolean = False
            Try

                Dim MOWList As New ArrayList()
                If MowGUID Is Nothing Then
                ElseIf String.IsNullOrEmpty(MowGUID) OrElse MowGUID.Trim = "" Then
                ElseIf MowGUID.Trim <> "" Then
                    UseGUID = True
                End If


                If Not UseGUID Then
                    For Each mow In TMDS.GlobalDeclarations.MOWCollection
                        If mow.Name = MOWName Then
                            trk = Me.FindTrackWithMOW(CInt(mow.TrackGUID), mow.MowGUID)
                            trk.MOWIDs.Remove(mow)
                            trk.InvalidateMOWID()
                            trk.UpdateStatus()
                            MOWList.Add(mow)
                            If Not trk.Indicating And trk.MOWIDs.Count = 0 Then
                                trk.Occuppied = False
                                trk.UpdateStatus()
                            End If
                        End If
                    Next
                Else
                    mow = TMDS.SystemUtilities.FetchData.FindMow(MowGUID)
                    If mow IsNot Nothing Then MOWList.Add(mow)
                End If

                For Each MOWToDelete In MOWList
                    If Not MOWToDelete Is Nothing Then
                        MOWCollection.Remove(MOWToDelete)
                        trk = Nothing
                        trk = MOWToDelete.myTrack
                        If trk IsNot Nothing Then
                            trk.MOWIDs.Remove(mow)
                            trk.InvalidateMOWID()
                            trk.UpdateStatus()
                            If Not trk.Indicating And trk.MOWIDs.Count = 0 Then
                                trk.Occuppied = False
                                trk.UpdateStatus()
                            End If
                        End If
                    End If
                Next
                MOWList = Nothing

            Catch ex As Exception

                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)

            End Try

        End Sub

        Public Function FindTrackWithMOW(ByVal UID As Int32, ByVal MOWGUID As String) As TMDS.TrackComponents.Track  ' ARRC-1107
            Dim trk As TMDS.TrackComponents.Track = Nothing
            Try

                For Each trk In TMDS.SystemForms.MySystemForms.frmDisplay.myTracksAndSwitches
                    If trk.GUID = UID Then
                        Return trk
                    End If

                Next

                If trk Is Nothing Then
                    For Each trk In TMDS.SystemForms.MySystemForms.frmDisplay.myTracksAndSwitches
                        If trk.MOWIDs.Count > 0 Then
                            Dim mow As TMDS.TrainComponents.MOWID
                            For Each mow In trk.MOWIDs
                                If Trim(mow.MowGUID) = Trim(MOWGUID) Then
                                    Return trk
                                End If
                            Next
                        End If
                    Next
                End If


            Catch
            Finally
                trk = Nothing

            End Try

            Return Nothing

        End Function

