#Region "GRAPHICAL GROUPING"
        Public Sub GetGraphicalGroups(ByRef CurrentDrawingForm As frmDisplay)
            Dim groups As New ArrayList()
            Dim rgnNumbers As New ArrayList()
            Dim RunLen As System.TimeSpan = Now.Subtract(gStartTime)
            Dim msecs As Integer = ((RunLen.Seconds * 1000) + RunLen.Milliseconds)


            Dim cp As TMDS.GraphicComponent.ControlPoint
            Try
                'Find the number of graphical groups for this territory and the control points in this territory
                For Each cp In TMDS.GlobalDeclarations.gControlPointCollection
                    If cp.TerritoryID = Me.TerritoryID Then
                        If Not groups.Contains(cp.GraphicalGroupID) Then
                            groups.Add(cp.GraphicalGroupID)
                        End If
                        If Not Me.myControlPoints.Contains(cp) Then
                            Me.myControlPoints.Add(cp)
                        End If
                    End If
                Next

                'Build the graphical groups for this territory
                Dim i As Integer
                groups.Sort()
                For Each i In groups
                    'build each group in territory
                    Dim newGrp As New GraphicalGroup()
                    newGrp.GroupID = i
                    newGrp.TerritoryUsed = Me
                    'find the control points that belong to this group from the control points assigned to this territory
                    For Each cp In Me.myControlPoints
                        If cp.GraphicalGroupID = i Then
                            newGrp.ControlPoints.Add(cp)
                            If Not rgnNumbers.Contains(cp.ScreenRegionID) Then
                                rgnNumbers.Add(cp.ScreenRegionID)
                            End If
                        End If
                    Next
                    'find each screen region area used in this graphical group from each component in each control point that is assigned to this group
                    Dim comp As Object
                    For Each cp In newGrp.ControlPoints
                        For Each comp In cp.AssignedComponenets
                            If Not rgnNumbers.Contains(comp.ScreenRegionID) Then
                                'If (RegionMarker + 1) < comp.ScreenRegionID Then
                                '    Dim j As Integer
                                '    Dim Difference As Integer = comp.ScreenRegionID - RegionMarker
                                '    For j = 1 To Difference
                                '        If Not rgnNumbers.Contains(RegionMarker + j) Then
                                '            rgnNumbers.Add(RegionMarker + j)
                                '        End If
                                '    Next
                                'End If
                                'RegionMarker = comp.ScreenRegionID
                                rgnNumbers.Add(comp.ScreenRegionID)
                            End If
                        Next
                    Next

                    'Create the ScreenRegionMapping
                    rgnNumbers.Sort()
                    Dim rgnNum As Integer
                    For Each rgnNum In rgnNumbers
                        'check for unused region areas between graphical groups
                        If Me.LastRegionNumber < rgnNum - 1 Then
                            Dim BlankRegions As Integer = (rgnNum - 1) - Me.LastRegionNumber
                            Dim NumOfRgn As Integer
                            For NumOfRgn = 1 To BlankRegions
                                Dim rgnBlank As New ScreenRegionMap()
                                rgnBlank.OriginalRegion = NumOfRgn + Me.LastRegionNumber
                                newGrp.ScreenRegionsUsed.Add(rgnBlank)
                            Next
                        End If
                        Dim rgnMap As New ScreenRegionMap()
                        rgnMap.OriginalRegion = rgnNum
                        LastRegionNumber = rgnNum
                        newGrp.ScreenRegionsUsed.Add(rgnMap)
                    Next
                    rgnNumbers.Clear()
                    Me.GraphicalGroups.Add(newGrp)
                Next


                'Find the available screen regions in this current drawing form
                'and then map this screen region to each component.
                Dim grp As GraphicalGroup
                For Each grp In Me.GraphicalGroups
                    If grp.FitGroupOnDisplay(CurrentDrawingForm) Then
                        RunLen = Now.Subtract(gStartTime)
                        msecs = ((RunLen.Seconds * 1000) + RunLen.Milliseconds)
                        grp.ReMapGraphicalGroupComponents()
                        RunLen = Now.Subtract(gStartTime)
                        msecs = ((RunLen.Seconds * 1000) + RunLen.Milliseconds)
                    End If
                Next

                'Clean up
                groups.Clear()
                groups = Nothing
                rgnNumbers.Clear()
                rgnNumbers = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub RemoveGraphicalGroups()
            Try
                Dim grp As GraphicalGroup
                For Each grp In Me.GraphicalGroups
                    grp.Dispose()
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Class GraphicalGroup
            Public GroupID As Integer
            Public DisplayForm As frmDisplay
            Public ScreenRegionsUsed As New ArrayList()
            Public ControlPoints As New ArrayList()
            Public TerritoryUsed As Territory

            Sub Dispose()
                Try
                    Me.ScreenRegionsUsed.Clear()
                    Me.ScreenRegionsUsed = Nothing
                    ControlPoints.Clear()
                    ControlPoints = Nothing
                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try
            End Sub

            Public Function FitGroupOnDisplay(ByRef CurrentDrawingForm As frmDisplay) As Boolean
                Try
                    Dim RegionMapped As Boolean
                    Dim RgnNum As ScreenRegionMap
                    Dim rgn As TMDS.GraphicComponent.ScreenDrawingRegion

                    'Test to see if there are enough regions left on the current form to fit the graphical group
                    Dim NumOfUnusedRegions As Integer
                    Dim SkipRegionMapping As Boolean
                    For Each rgn In CurrentDrawingForm.ScreenRegions
                        If Not rgn.BoundsInUse Then
                            NumOfUnusedRegions += 1
                        End If
                    Next
                    If Me.ScreenRegionsUsed.Count > NumOfUnusedRegions Then
                        SkipRegionMapping = True
                        CurrentDrawingForm = TMDS.SystemUtilities.UtilitiesDisplayForm.AddNewDisplayForm(False)

                    End If
                    If Not SkipRegionMapping Then
                        For Each RgnNum In Me.ScreenRegionsUsed
                            For Each rgn In CurrentDrawingForm.ScreenRegions

                                If rgn.BoundsInUse Then
                                    If Me.TerritoryUsed.TerritoryID = rgn.TerrID Then  'rgn.MapFromRegion Then 'rgn.RegionNumber Then
                                        If ((RgnNum.OriginalRegion = rgn.RegionNumber) And (rgn.MapFromRegion = 0)) _
                                        Or (rgn.MapFromRegion = RgnNum.OriginalRegion) Then

                                            RgnNum.MapToRegion = rgn.RegionNumber
                                            rgn.MapFromRegion = RgnNum.OriginalRegion
                                            Me.DisplayForm = CurrentDrawingForm
                                            RegionMapped = True
                                            Exit For
                                        ElseIf (rgn.MapFromRegion = RgnNum.OriginalRegion) Then ' this is redundant code
                                            RegionMapped = False
                                            Dim rgn1 As TMDS.GraphicComponent.ScreenDrawingRegion

                                            For Each rgn1 In CurrentDrawingForm.ScreenRegions
                                                If Not rgn1.BoundsInUse Then
                                                    RgnNum.MapToRegion = rgn1.RegionNumber
                                                    Me.DisplayForm = CurrentDrawingForm
                                                    rgn1.BoundsInUse = True
                                                    rgn1.MapFromRegion = RgnNum.OriginalRegion
                                                    rgn1.TerrID = Me.TerritoryUsed.TerritoryID
                                                    RegionMapped = True
                                                    Exit For
                                                End If
                                            Next
                                            If RegionMapped Then
                                                Exit For
                                            End If
                                        End If
                                    ElseIf RgnNum.OriginalRegion = rgn.RegionNumber Then
                                        RegionMapped = False
                                        Dim rgn1 As TMDS.GraphicComponent.ScreenDrawingRegion
                                        For Each rgn1 In CurrentDrawingForm.ScreenRegions
                                            If Not rgn1.BoundsInUse Then
                                                RgnNum.MapToRegion = rgn1.RegionNumber
                                                Me.DisplayForm = CurrentDrawingForm
                                                rgn1.BoundsInUse = True
                                                rgn1.MapFromRegion = RgnNum.OriginalRegion
                                                rgn1.TerrID = Me.TerritoryUsed.TerritoryID
                                                RegionMapped = True
                                                Exit For
                                            End If
                                        Next
                                        If RegionMapped Then
                                            Exit For
                                        End If
                                    End If
                                    'ElseIf RgnNum.OriginalRegion = rgn.RegionNumber Then
                                Else
                                    RgnNum.MapToRegion = rgn.RegionNumber
                                    Me.DisplayForm = CurrentDrawingForm
                                    rgn.BoundsInUse = True
                                    rgn.TerrID = Me.TerritoryUsed.TerritoryID
                                    rgn.MapFromRegion = RgnNum.OriginalRegion
                                    RegionMapped = True
                                    Exit For
                                End If
                            Next
                            If Not RegionMapped Then
                                Dim scn As TMDS.GraphicComponent.ScreenDrawingRegion
                                Dim Message As String = String.Empty
                                For Each scn In CurrentDrawingForm.ScreenRegions
                                    Message = Message & "REGION:" & scn.RegionNumber & " MAPtoREGION:" & scn.MapFromRegion & vbCrLf
                                Next
                                CurrentDrawingForm = TMDS.SystemUtilities.UtilitiesDisplayForm.AddNewDisplayForm(False)
                                Exit For
                            End If
                        Next
                        If RegionMapped Then
                            Return True
                        End If
                    End If
                    'If a new display is created then redo the region mapping for this group
                    'and not all region mapped then do it again..
                    For Each RgnNum In Me.ScreenRegionsUsed
                        For Each rgn In CurrentDrawingForm.ScreenRegions
                            If rgn.BoundsInUse Then
                                If Me.TerritoryUsed.TerritoryID = rgn.TerrID And RgnNum.OriginalRegion = rgn.RegionNumber Then
                                    RgnNum.MapToRegion = rgn.RegionNumber
                                    rgn.MapFromRegion = RgnNum.OriginalRegion
                                    Me.DisplayForm = CurrentDrawingForm
                                    RegionMapped = True
                                    Exit For
                                End If
                            Else
                                RgnNum.MapToRegion = rgn.RegionNumber
                                Me.DisplayForm = CurrentDrawingForm
                                rgn.MapFromRegion = RgnNum.OriginalRegion
                                rgn.BoundsInUse = True
                                rgn.TerrID = Me.TerritoryUsed.TerritoryID
                                RegionMapped = True
                                Exit For
                            End If
                        Next
                    Next
                    Return True

                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try
            End Function

            Public Sub ReMapGraphicalGroupComponents()
                Dim COMPGUID As String = String.Empty
                Dim COMPSR As String = String.Empty
                Try
                    Dim cp As TMDS.GraphicComponent.ControlPoint
                    Dim comp As Object

                    For Each cp In Me.ControlPoints
                        For Each comp In cp.AssignedComponenets
                            Try
                                Dim NewMapToRegionID As Integer = GetRegionMapFromID(comp.ScreenRegionID)
                                comp.CurrentDrawingForm = Me.DisplayForm
                                Dim OldRegion As TMDS.GraphicComponent.ScreenDrawingRegion
                                If NewMapToRegionID <> comp.ScreenRegionID Then
                                    'If comp.ScreenRegionID <> 0 Then
                                    COMPGUID = comp.guid
                                    COMPSR = comp.ScreenRegionID
                                    OldRegion = Me.DisplayForm.ScreenRegions.Item(comp.ScreenRegionID - 1)
                                    'Else
                                    '    OldRegion = Me.DisplayForm.ScreenRegions.Item(0)
                                    'End If

                                    Dim NewRegion As TMDS.GraphicComponent.ScreenDrawingRegion = Me.DisplayForm.ScreenRegions.Item(NewMapToRegionID - 1)

                                    Dim AdjustedLX, AdjustedLY, AdjustedRX, AdjustedRY As Int16
                                    AdjustedLX = comp.LX - OldRegion.Bounds.X
                                    AdjustedLY = comp.LY - OldRegion.Bounds.Y
                                    AdjustedRX = comp.RX - OldRegion.Bounds.X
                                    AdjustedRY = comp.RY - OldRegion.Bounds.Y

                                    comp.LX = NewRegion.Bounds.X + AdjustedLX
                                    comp.LY = NewRegion.Bounds.Y + AdjustedLY
                                    comp.RX = NewRegion.Bounds.X + AdjustedRX
                                    comp.RY = NewRegion.Bounds.Y + AdjustedRY
                                    comp.SnippetRegion = NewRegion.RegionNumber
                                End If
                            Catch ex As Exception
                                SystemException(ex.ToString & "-" & COMPGUID & "-" & COMPSR)
                            End Try
                        Next
                    Next
                Catch ex As Exception
                    SystemException(ex.ToString & "-" & COMPGUID & "-" & COMPSR)
                End Try
            End Sub

            Private Function GetRegionMapFromID(ByVal OriginalRegionID As Integer) As Integer
                Try
                    Dim rgnmap As ScreenRegionMap
                    For Each rgnmap In Me.ScreenRegionsUsed
                        If rgnmap.OriginalRegion = OriginalRegionID Then
                            Return rgnmap.MapToRegion
                        End If
                    Next

                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try
            End Function

            Private Function GetScreenRegion(ByVal RegionID As Integer, ByVal DisplayForm As frmDisplay) As TMDS.GraphicComponent.ScreenDrawingRegion
                Try
                    Dim rgn As TMDS.GraphicComponent.ScreenDrawingRegion
                    For Each rgn In DisplayForm.ScreenRegions
                        If rgn.RegionNumber = RegionID Then
                            Return rgn
                        End If
                    Next
                    Return Nothing
                Catch ex As Exception
                    SystemException(ex.ToString)
                    Return Nothing
                End Try
            End Function

        End Class

        Public Class ScreenRegionMap
            Public OriginalRegion As Integer
            Public MapToRegion As Integer
        End Class

