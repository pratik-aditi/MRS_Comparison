        Public Sub RemoveTag(ByVal TrackGuid As String, ByVal TagGUID As String)
            Try

                Dim trk As TMDS.TrackComponents.Track = Me.FindTrack(CInt(TrackGuid))
                Dim tg As TMDS.TrackTagComponents.Tag = Nothing
                Dim tgToRemove As TMDS.TrackTagComponents.Tag = Nothing
                If optEnableTerritoryDeskAssignmentMode Then
                    If Not IsNothing(trk) AndAlso trk.IsControlled Then Exit Sub
