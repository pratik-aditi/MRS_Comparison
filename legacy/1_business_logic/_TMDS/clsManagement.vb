        Public Function GetNextNumberFromPool(thePoolType As PoolNumberTypes) As Int32
            Dim thePool As NumberPool = Nothing
            Try
                thePool = GetNumberPool(thePoolType)
                Dim NextNumber As Int32 = 0
                If GetColumnLock(thePool.myLockColumnName) Then
                    Dim NumPool As NumberPool = GetNumberPool(thePool.myPoolNumberType)
                    If Not IsNothing(NumPool) Then
                        NextNumber = NumPool.GetNextPoolNumber
                    End If
                End If
                Return NextNumber

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If Not IsNothing(thePool) Then UnLockColumn(thePool.myLockColumnName)
            End Try
        End Function

        Private Function GetColumnLock(ColumnName As String) As Boolean
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim LockSatified As Boolean
            Dim LoopControl As Integer
            Try
                Dim query As New StringBuilder("SELECT " & ColumnName & " FROM tblSystemOffices")
                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                dbcomm = New OleDbCommand(query.ToString, dbconn)
                Do Until LockSatified

                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        If dr.IsDBNull(0) Then
                            LockColumn(ColumnName)
                        ElseIf String.IsNullOrEmpty(Trim(dr.GetString(0))) Then
                            LockColumn(ColumnName)
                        ElseIf dr.GetString(0) = gWorkStationName Then
                            LockSatified = True
                            Exit Do
                        End If

                    End While
                    LoopControl += 1
                    If LoopControl = 11 Then
                        LockColumn(ColumnName)
                    ElseIf LoopControl > 11 Then
                        Exit Do
                    End If
                    dr.Close()

                    Threading.Thread.Sleep(50)
                Loop

                Return LockSatified

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                dbconn.Close()
                dbconn = Nothing
                dbcomm = Nothing
            End Try
        End Function

        Private Sub LockColumn(ColumnName As String)
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Try
                Dim Update As New StringBuilder("UPDATE tblSystemOffices SET " & ColumnName & " = '" & gWorkStationName & "'")
                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                dbcomm = New OleDbCommand(Update.ToString, dbconn)
                dbcomm.ExecuteNonQuery()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                dbconn.Close()
                dbconn = Nothing
                dbcomm = Nothing
            End Try
        End Sub

        Private Sub UnLockColumn(ColumnName As String)
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Try
                Dim Update As New StringBuilder("UPDATE tblSystemOffices SET " & ColumnName & " = ''")
                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                dbcomm = New OleDbCommand(Update.ToString, dbconn)
                dbcomm.ExecuteNonQuery()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                dbconn.Close()
                dbconn = Nothing
                dbcomm = Nothing
            End Try
        End Sub

        Private Function GetNumberPool(thePool As PoolNumberTypes) As NumberPool
            Try
                Dim np As NumberPool
                For Each np In myNumberPools
                    If np.myPoolNumberType = thePool Then
                        Return np
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Class NumberPool
            Public myPoolName As String
            Public myNumberColumnName As String
            Public myRangeColumnName As String
            Public myFactorColumnName As String
            Public myLockColumnName As String

            Public myNumber As Int32
            Public myFactor As Int32
            Public myRange As Int32
            Public myPoolNumberType As PoolNumberTypes

            Public myTableName As String = "tblSystemBulletins"
            Public myTableColumnName As String = "RestrictionUID"


            Public Sub GetNumberRangesFactors()
                Dim dbconn As OleDbConnection = Nothing
                Dim dbcomm As OleDbCommand = Nothing
                Dim dr As OleDbDataReader = Nothing
                Try
                    Dim query As New StringBuilder("SELECT " & myNumberColumnName & ", " & myRangeColumnName & ", " & myFactorColumnName & " FROM tblSystemOffices")
                    dbconn = New OleDbConnection(gConnectionStringStatic)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(query.ToString, dbconn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        If Not dr.IsDBNull(0) Then myNumber = dr.GetInt32(0)
                        If Not dr.IsDBNull(1) Then myRange = dr.GetInt32(1)
                        If Not dr.IsDBNull(2) Then myFactor = dr.GetInt32(2)
                    End While

                Catch ex As Exception
                    SystemException(ex.ToString)
                Finally
                    dbconn.Close()
                    dbconn = Nothing
                    dbcomm = Nothing
                End Try
            End Sub

            Public Function GetNextPoolNumber() As Int32
                Dim dbconn As OleDbConnection = Nothing
                Dim dbcomm As OleDbCommand = Nothing
                Dim dr As OleDbDataReader = Nothing
                Dim LoopControl As Integer = 0
                Dim Multipler As Integer = 1
                Try
                    Dim theNumber As Int32 = 0
                    Dim query As New StringBuilder("SELECT " & myNumberColumnName & " FROM tblSystemOffices")
                    dbconn = New OleDbConnection(gConnectionStringStatic)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(query.ToString, dbconn)
                    dr = dbcomm.ExecuteReader
                    While dr.Read
                        If Not dr.IsDBNull(0) Then
                            theNumber = dr.GetInt32(0)
                        End If
                    End While

                    Dim UniqueFound As Boolean
                    Do Until UniqueFound
                        If theNumber = 0 Then
                            theNumber = myRange
                        End If

                        If theNumber > myRange + myFactor Then
                            theNumber = myRange
                        End If
                        If IsUniqueNumber(theNumber) Then
                            Exit Do
                        End If
                        theNumber = theNumber + Multipler
                        LoopControl += 1
                        'Multipler += 1
                        'Multipler = LoopControl * Multipler
                        If LoopControl > 10 Then
                            theNumber = 0
                            Exit Do
                        End If
                    Loop

                    Dim NextNumber As Int32 = theNumber + 1
                    Dim Update As New StringBuilder("UPDATE tblSystemOffices SET " & myNumberColumnName & " = " & NextNumber)
                    dbcomm = New OleDbCommand(Update.ToString, dbconn)
                    dbcomm.ExecuteNonQuery()

                    Return theNumber
                Catch ex As Exception
                    SystemException(ex.ToString)
                Finally
                    dbconn.Close()
                    dbconn = Nothing
                    dbcomm = Nothing
                End Try

            End Function

            Private Function IsUniqueNumber(theNumber As Int32) As Boolean
                Dim dbconn As OleDbConnection = Nothing
                Dim dbcomm As OleDbCommand = Nothing
                Dim dr As OleDbDataReader = Nothing
                Try
                    Dim NumberIsUnique As Boolean = False

                    Dim query As New StringBuilder("SELECT " & Me.myTableColumnName & " FROM " & myTableName & " WHERE " & myTableColumnName & " = '" & theNumber.ToString & "'")
                    dbconn = New OleDbConnection(gConnectionStringDynamic)
                    dbconn.Open()
                    dbcomm = New OleDbCommand(query.ToString, dbconn)
                    If dbcomm.ExecuteNonQuery = 0 Then
                        NumberIsUnique = True
                    End If
                    Return NumberIsUnique

                Catch ex As Exception
                    SystemException(ex.ToString)
                Finally
                    dbconn.Close()
                    dbconn = Nothing
                    dbcomm = Nothing
                End Try
            End Function

        End Class
