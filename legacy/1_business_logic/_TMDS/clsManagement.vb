            Dim AvailablePostion As Integer = 1
            Try

                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        If Not dr.IsDBNull(0) Then Integer.TryParse(dr.GetValue(0), AvailablePostion)
