                AddEventToLog(EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
                'dbConnection = Nothing
            Finally
                If DatabaseCommand IsNot Nothing Then DatabaseCommand.Dispose()
                DatabaseCommand = Nothing
                dr = Nothing
                trk = Nothing
                note = Nothing
            End Try
        End Sub

