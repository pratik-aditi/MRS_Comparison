        Private Function DoesBulletinExist() As Boolean
            Try
                If Trim(Me.myBulletinGUID) = "" Then Return False
                Dim sb As SubBulletin
                For Each sb In BulletinCollection
                    If sb.myGUID = Me.myBulletinGUID Then
                        Return True
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Function CreateBulletin(ByVal trn As TrainID, Optional ByVal ShowAlert As Boolean = False, Optional ByRef ErrorMessage As String = "") As Boolean
            Dim b As SubBulletin = Nothing
            Dim TrackCompList As New ArrayList
            Dim iBullNumber As Integer = 0
            Dim SystemWideRestriction As Boolean = False
            Dim MileageRangeInitialized As Boolean = False
            Dim AlertMessage As String = "" ' "FORM C BULLETIN CREATED FOR TRAIN (" & trn.Name & "). PLEASE VERIFY"
            Dim strMsg As String = ""
            Dim PTCVerbiageString As New ArrayList
            Dim ProcessAsSpeed As Boolean = False
            Try
                ErrorMessage = String.Empty
                If DoesBulletinExist() Then Return True
                MileageRangeInitialized = InitializeMileageRanges(SystemWideRestriction)
                'If Not InitializeMileageRanges() Then Return False
                If Not MileageRangeInitialized AndAlso SystemWideRestriction Then
                ElseIf Not MileageRangeInitialized Then
                    strMsg = ""
                    strMsg = "INVALID MILEPOST RANGE FORM C TO TRAIN:" & trn.Name & " RESTRICTION GUID " & Me.myUID
                    ErrorMessage = strMsg
                    SystemEvent(strMsg)
                    'SystemEvent("INVALID MILEPOST RANGE FORM C TO TRAIN:" & trn.Name & " RESTRICTION GUID " & Me.myUID)
                    Return False
                End If

                If SystemWideRestriction Then
                    If trn Is Nothing Then
                        strMsg = ""
                        strMsg = "INVALID TRAIN FOR FORM C. RESTRICTION GUID " & Me.myUID
                        ErrorMessage = strMsg
                        SystemEvent(strMsg)
                        Return False
                    ElseIf trn IsNot Nothing AndAlso trn.myTrack.mySubdivision Is Nothing Then
                        strMsg = ""
                        strMsg = "INVALID SUBDIVISION FOR FORM C. RESTRICTION GUID " & Me.myUID
                        ErrorMessage = strMsg
                        SystemEvent(strMsg & " Track GUID: " & trn.myTrack.GUID)
                        Return False
                    End If
                    thisSubdivision = trn.myTrack.mySubdivision
                End If
                If trn IsNot Nothing Then
                    AlertMessage = "UNDELIVERED FORM C RESTRICTION RECEIVED FOR (" & trn.Name & ")(" & Me.myCarUID & "). PLEASE VERIFY"
                End If
                b = New SubBulletin
                b.thisSubdivision = thisSubdivision
                b.Created = GenerateTime(thisSubdivision) 'Now
                b.myGUID = Guid.NewGuid.ToString.ToUpper
                b.myUID = thisSubdivision.GetNextBulletinNumber(BulletinCollection, "SPEED RESTRICTION", "BullNumbrSR1")

                If Integer.TryParse(b.myUID, iBullNumber) Then
                    If iBullNumber = 0 Then
                        SystemEvent("UNABLE TO RETRIVE NEXT BULLETIN NUMBER FOR FORM C To Train:" & trn.Name)
                        MessageBox.Show(Me, "UNABLE TO RETRIVE NEXT BULLETIN NUMBER " & vbCrLf & optSystemMessageString6, optSystemMessageString3, MessageBoxButtons.OK, MessageBoxIcon.Error)
                        strMsg = ""
                        strMsg = "UNABLE TO RETRIVE NEXT BULLETIN NUMBER FOR FORM C To Train:" & trn.Name
                        ErrorMessage = strMsg


                        Return False
                    End If
                Else
                    If b.myUID Is Nothing OrElse b.myUID.Trim = "0" Then
                        SystemEvent("UNABLE TO RETRIVE NEXT BULLETIN NUMBER FOR FORM C To Train:" & trn.Name)
                        MessageBox.Show(Me, "UNABLE TO RETRIVE NEXT BULLETIN NUMBER " & vbCrLf & optSystemMessageString6, optSystemMessageString3, MessageBoxButtons.OK, MessageBoxIcon.Error)
                        strMsg = ""
                        strMsg = "UNABLE TO RETRIVE NEXT BULLETIN NUMBER FOR FORM C To Train:" & trn.Name
                        ErrorMessage = strMsg
                        Return False
                    End If
                End If

                b.BullUID = b.myUID
                b.ActivatedTime = Now

                b.myStatus = "OK"
                b.myType = BulletinType.SPEED
                b.theType = "SPEED RESTRICTION"
                b.mysType = "SPEED RESTRICTION"
                b.myTypeForm = BulletinFormType.FORMC
                b.mysTypeForm = "FORM C"

                b.SubUID = thisSubdivision.GUID
                b.SubName = thisSubdivision.Name
                b.MilePostBegin = MilePostBegin
                b.MilePostEnd = MilePostEnd
                b.MilePostBeginSuffix = MilePostSuffix
                b.MilePostEndSuffix = MilePostSuffix
                b.MilePostBeginPrefix = MilePostPrefix
                b.MilePostEndPrefix = MilePostPrefix

                b.DispatchPointFromName = String.Empty
                b.DispatchPointToName = String.Empty

                b.SpeedFrght = Me.mySpeedLimit.ToString
                b.SpeedPassg = Me.mySpeedLimit.ToString
                b.SpeedExpedite = Me.mySpeedLimit.ToString
                b.TimeZone = thisSubdivision.TimeZone

                If SystemWideRestriction Then
                    b.TrackName = "All Tracks"
                Else
                    Select Case Me.myTypeOfRestriction.Trim.ToUpper
                        Case "KE", "HZ"
                            b.HeadEndRestrictionOnly = False
                        Case Else
                            b.HeadEndRestrictionOnly = True
                    End Select

                    b.TrackName = TrackName
                End If

                b.TrackNameList = TrackName
                TrackCompList = b.GetTrackList

                Dim comp As Object
                If Not TrackCompList Is Nothing Then
                    For Each comp In TrackCompList
                        If comp.GetType.ToString = gTrackComponentName Then b.CompList.Add(comp)
                    Next
                End If
                Dim Creator As String = gCurrentUser.LastName & ", " & gCurrentUser.FirstName & " (" & gCurrentUser.Initials & ")"
                b.Creator = Creator

                b.Instructions = SpclToEsc(Me.myInstructions)
                b.BulletinComments = SpclToEsc(Me.myDescription)

                b.TimeFrom = Now
                b.TimeUntil = Now
                b.Direction = String.Empty
                b.FlagDisplayInfo = String.Empty
                b.FlagData = String.Empty
                b.TrainSymbol = Me.myTrain.Name
                b.TrainSpecific = True
                b.ReasonCode = String.Empty
                b.myData = String.Empty

                b.SubdivisionFromUID = thisSubdivision.GUID
                b.SubdivisionFromName = thisSubdivision.Name
                b.SubdivisionToUID = thisSubdivision.GUID
                b.SubdivisionToName = thisSubdivision.Name
                b.DispatchPointFromUID = 0
                b.DispatchPointFromName = String.Empty
                b.DispatchPointToUID = 0
                b.DispatchPointToName = String.Empty

                b.SystemWideBulletin = SystemWideRestriction

                'Dim mr As MileageRange
                'For Each mr In theMileageRanges
                If theMileageRange IsNot Nothing Then b.myMileageRanges.Add(theMileageRange)
                ' Next
                'Dim sBulletinHeaderTitle As String = "General Bulletin Order "
                Dim BulletinVerbiageString As New StringBuilder
                'BulletinVerbiageString.Append("RESTRICTION FOR " & trn.Name & " (" & trn.IdentifingUnit & ")")
                BulletinVerbiageString.Append("|")
                BulletinVerbiageString.Append("CAR RESTRICTION ON " & Me.myCarUID & " (" & Me.myTypeOfRestriction & ")")
                PTCVerbiageString.Add("CAR RESTRICTION ON " & Me.myCarUID & " (" & Me.myTypeOfRestriction & ")")
                BulletinVerbiageString.Append("|")
                If Not SystemWideRestriction Then
                    ProcessAsSpeed = True
                    BulletinVerbiageString.Append("Between " & "<" & Me.myMilePostBegin & "> And " & "<" & Me.myMilePostEnd & ">")
                    PTCVerbiageString.Add("Between " & Me.myMilePostBegin & " And " & Me.myMilePostEnd)
                    BulletinVerbiageString.Append("|")
                    BulletinVerbiageString.Append(Me.mySpeedLimit & " MPH")
                    PTCVerbiageString.Add(Me.mySpeedLimit & " MPH")
                    BulletinVerbiageString.Append("|")
                End If

                If Me.TrackName.ToUpper.Trim = "ALL TRACKS" Then
                    BulletinVerbiageString.Append("ON ALL TRACKS")
                    PTCVerbiageString.Add("ON ALL TRACKS")
                Else
                    BulletinVerbiageString.Append("ON " & Me.TrackName & " TRACK")
                    PTCVerbiageString.Add("ON " & Me.TrackName & " TRACK")
                End If


                If Me.IsOnTrain Then
                    BulletinVerbiageString.Append("|")
                    BulletinVerbiageString.Append("ON TRAIN")
                    PTCVerbiageString.Add("ON TRAIN")
                Else
                    'b.myStatus = "NC"
                    'b.ConfirmationData = ""
                End If
                BulletinVerbiageString.Append("|")
                If b.HeadEndRestrictionOnly Then
                    BulletinVerbiageString.Append("HER: Yes")
                    PTCVerbiageString.Add("HER: Yes")
                Else
                    BulletinVerbiageString.Append("HER: No")
                    PTCVerbiageString.Add("HER: No")
                End If

                BulletinVerbiageString.Append("|")
                BulletinVerbiageString.Append(Me.myDescription)
                PTCVerbiageString.Add(Me.myDescription)
                BulletinVerbiageString.Append("|")

                Dim InstructionArr As New ArrayList
                Dim s As String = ""
                InstructionArr = WrapText(Me.myInstructions, 45, True)
                If InstructionArr IsNot Nothing AndAlso InstructionArr.Count > 0 Then
                    For Each s In InstructionArr
                        BulletinVerbiageString.Append(s)
                        PTCVerbiageString.Add(s)
                        BulletinVerbiageString.Append("|")
                    Next
                Else
                    BulletinVerbiageString.Append(SpclToEsc(Me.myInstructions))
                    PTCVerbiageString.Add(SpclToEsc(Me.myInstructions))
                    BulletinVerbiageString.Append("|")
                End If
                If optEnableARRCSpecificOptions Then 'ARRC-1828  - FORMC
                    'frmBulletinHMI.GetBulletinFormC(PTCVerbiageString, b)
                    PTCVerbiageString = New ArrayList
                    PTCVerbiageString.Insert(0, Me.thisSubdivision.Name & " Sub       Form C      " & b.BullUID)


                    PTCVerbiageString.Add("")
                    PTCVerbiageString.Add("MP       to      MP      HER     FRT     PSGR    ON TRN    Track(s)")

                    PTCVerbiageString.Add("------------------------------------------------------------------")
                    If Not SystemWideRestriction Then
                        ProcessAsSpeed = True
                        PTCVerbiageString.Add(Me.myMilePostBegin & "          " & Me.myMilePostEnd)
                    End If
                    If b.HeadEndRestrictionOnly Then
                        PTCVerbiageString(PTCVerbiageString.Count - 1) &= "      Yes"
                    Else
                        PTCVerbiageString(PTCVerbiageString.Count - 1) &= "		 No"
                    End If
                    PTCVerbiageString(PTCVerbiageString.Count - 1) &= "     " & Me.mySpeedLimit & "       " & Me.mySpeedLimit
                    If Me.IsOnTrain Then
                        PTCVerbiageString(PTCVerbiageString.Count - 1) &= "      Y"
                    Else
                        PTCVerbiageString(PTCVerbiageString.Count - 1) &= "      N"
                    End If
                    If Me.TrackName.ToUpper.Trim = "ALL TRACKS" Then
                        PTCVerbiageString(PTCVerbiageString.Count - 1) &= "     ALL TRACKS"
                    Else
                        PTCVerbiageString(PTCVerbiageString.Count - 1) &= "     " & Me.TrackName & " TRACK"
                    End If
                    PTCVerbiageString.Add("             CAR RESTRICTION ON " & Me.myCarUID & " (" & Me.myTypeOfRestriction & ")")
                    PTCVerbiageString.Add("             " & Me.myDescription)

                    InstructionArr = WrapText(Me.myInstructions, 45, True)
                    If InstructionArr IsNot Nothing AndAlso InstructionArr.Count > 0 Then
                        For Each s In InstructionArr
                            PTCVerbiageString.Add("             " & s)
                        Next
                    Else
                        PTCVerbiageString.Add("             " & SpclToEsc(Me.myInstructions))
                    End If

                    'PTCVerbiageString.Add("**********************************END***********************************")
                End If
                'ADD CARID and ONTrain to myDataSupplement
                Dim DataSupplement As New StringBuilder
                With DataSupplement
                    If Me.IsOnTrain Then
                        .Append("Y|")
                    Else
                        .Append("N|")
                    End If
                    .Append(Me.myCarUID)
                End With
                b.myDataSupplement = DataSupplement.ToString


                If Not IsNothing(b) Then
                    b.BulletinReadData = optBulletinProperName & " <" & b.BullUID & ">|" & BulletinVerbiageString.ToString
                    b.CorrelatingRestrictionUID = Me.myUID

                    If thisSubdivision IsNot Nothing Then
                        b.ActivatedTime = GenerateTime(thisSubdivision)
                    End If

                    If b.DatabaseInsertBulletin() Then
                        b.thisSubdivision = thisSubdivision
                        b.thisSubdivision.BulletinList.Add(b)
                        b.BulletinSummaryUpdate("ADD")
                        b.CreateElementsForPTC(PTCVerbiageString, True, ProcessAsSpeed, Me.IsOnTrain)
                        'b.DisplayBulletinOnTrackLine()
                        Me.myBulletinGUID = b.myGUID
                        UpdateBulletinCorrelation()
                    Else
                        Return False
                    End If
                Else
                    Return False
                End If
                b.PublishBulletin(BULLETINSTATUS.CREATE)
                Dim theTGBO As TabularGeneralBulletin = Nothing 'TMDS.SystemUtilities.FetchData.FindTGBOByTrainSymbol(trn.Name)
                Dim myTrainTGBOCollection As New ArrayList
                myTrainTGBOCollection = TMDS.SystemUtilities.FetchData.FindAllTGBOsByTrainSymbol(Me.myTrain.Name)
                If myTrainTGBOCollection IsNot Nothing AndAlso myTrainTGBOCollection.Count > 0 Then
                    For Each theTGBO In myTrainTGBOCollection
                        theTGBO.CreateFormCException(b)
                    Next
                End If

                'If Not IsNothing(theTGBO) Then
                '    If theTGBO.Status = "ACTIVE" Then
                '        If Not b.SystemWideBulletin Then
                '            theTGBO.PerformBulletinSortForCompare(True)
                '        Else
                '            theTGBO.CreateTGBOSystemWideFormCException(b)
                '        End If
                '    End If
                'End If
                If ShowAlert AndAlso AlertMessage.Trim <> "" Then
                    If Not TMDS.SystemUtilities.Utilities.CheckForAlertExtistenceByAlertData(AlertMessage) Then
                        Dim al As Alert = TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.Bulletin_FormC, AlertMessage, trn)
                    End If
                End If

                If optPerformDocumentArchiving Then
                    ArchiveTBPDF(b, "FORM C - " & trn.Name)
                End If

                Return True
            Catch ex As Exception
                'SystemException(ex.ToString)
                GetErrorDetails(ex, "CREATEBULLETIN - FORM C")
                Return False
            End Try
        End Function

