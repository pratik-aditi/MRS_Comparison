            End If
        End Sub

        Private Sub UpdateOverrideListToDatabase()
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim Update As String = String.Empty
            Dim OverrideString As String = String.Empty
            Dim ov As ZoneOverride
            Dim Count As Integer
            Try
                For Each ov In Me.ZoneOverrideList
                    If Count = 0 Then
                        OverrideString = ov.AuthUID & "|"
                        Dim n As Int32
                        For Each n In ov.TrackGUIDList
                            OverrideString = OverrideString & n & ":"
                        Next
                    Else
                        OverrideString = OverrideString & ";" & ov.AuthUID & "|"
                        Dim n As String
                        For Each n In ov.TrackGUIDList
                            OverrideString = OverrideString & n & ":"
                        Next

                    End If
                    Count = 1
                Next
                Update = "UPDATE tblTrackIntegrityStatuses SET AuthorityOverride = '" & OverrideString & "' WHERE TrackIntegrityUID =" & Me.ZoneUID
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                dbconn.Open()
                dbcomm = New OleDbCommand(Update, dbconn)
                dbcomm.ExecuteNonQuery()
                'dbconn.Close()
                'dbconn.Dispose()
                'dbconn = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                'dbconn = Nothing
            Finally
                If Not dbconn Is Nothing Then
                    If dbconn.State = ConnectionState.Open Then dbconn.Close()
                    dbconn.Dispose()
                    dbconn = Nothing
                End If
                If Not dbcomm Is Nothing Then
                    dbcomm.Dispose()
                    dbcomm = Nothing
                End If
            End Try
        End Sub

        Public Sub PerformTrackZoneOverride(ByVal auth As SFAuthority, Optional ByVal FoulingTrack As Boolean = False)
            Try
                Dim ov As New ZoneOverride

                ov.AuthUID = auth.AuthorityUID
                ov.ZoneUID = Me.ZoneUID
                Dim comp As Object
                For Each comp In auth.Components
                    If comp.GetType.ToString = gTrackComponentName Then
                        Dim trk As Track = CType(comp, Track)
                        Dim trkToCheck As Track
                        If FoulingTrack Then
                            If trk.FoulingTrackSPMS Then
                                ov.TrackGUIDList.Add(trk.GUID)
                            End If
                        Else
                            For Each trkToCheck In Me.TrackList
                                If trkToCheck.GUID = trk.GUID Then
                                    ov.TrackGUIDList.Add(trk.GUID)
                                End If
                            Next
                        End If
                    End If
                Next

                UpdateZoneOverrideList(Nothing, Nothing, False, ov)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub AcknowledgeTrackZoneAlertFromOverride(ByVal AuthUID As String, ByVal FoulingTrackAlert As Boolean, ByVal SwitchName As String)
            Dim al As Alert
            'tz.ZoneName & "|" & tz.ZoneUID.ToString & "|" & BeginLimit & " TO " & EndLimit & "|" & auth.IssueTo & "|" & auth.AuthorityUID
            Dim RemoveList As New ArrayList
            Try
                SyncLock TMDS.GlobalDeclarations.gSystemAlertList
                    For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                        Select Case al.TypeOfAlert
                            Case ManagementClasses.Alert.AlertType.TrackZone
                                Dim data() As String = al.AlertData.Split("|")
                                If data.Length >= 5 Then
                                    If data(0) = Me.ZoneName And data(4) = AuthUID Then
                                        al.AlertAcknowledged = True
                                        Dim Message As String = "TIWS ALERT WAS ACKNOWLEDGED BY SYSTEM SUMMARY ACKNOWLEDGMENT FOR TRACK ZONE: " & Me.ZoneName & " FOR AUTHORITY:" & AuthUID
                                        al.AlertAckedByPerson = Message
                                        TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                                        gSystemAlertExists = False
                                        Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al.AlertGUID)
                                        SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                            TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                        End SyncLock
                                        RemoveList.Add(al)

                                    End If
                                End If
                            Case Alert.AlertType.FoulingPoint
                                Dim data() As String = al.AlertData.Split("|")
                                If data.Length >= 5 Then
                                    If data(0) = SwitchName And data(4) = AuthUID Then
                                        al.AlertAcknowledged = True
                                        Dim Message As String = "TIWS ALERT WAS ACKNOWLEDGED BY SYSTEM SUMMARY ACKNOWLEDGMENT FOR FOULING TRACK: " & SwitchName & " FOR AUTHORITY:" & AuthUID
                                        al.AlertAckedByPerson = Message
                                        TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                                        gSystemAlertExists = False
                                        Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al.AlertGUID)
                                        SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                            TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                        End SyncLock
                                        RemoveList.Add(al)

                                    End If
                                End If

                        End Select
                    Next
                    For Each al In RemoveList
                        TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                    Next
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

