        Friend Function DeleteTroubleReport() As Boolean
            Dim QueryCollection As New ArrayList
            Dim td As TrainDelay
            Dim EnRouteFailureMode As Boolean = False

            Try
                Me.RepairInfo = "INCIDENT REPORT OPENED IN ERROR"
                Me.UpdatedBy = TMDS.GlobalDeclarations.gCurrentUser.UserFullName
                Dim mysubdvn As Subdivision = Nothing
                If Not String.IsNullOrEmpty(Me.SubdivisionUID) AndAlso Me.SubdivisionUID.Trim <> "" Then
                    Dim SubUID As Integer = 0
                    Integer.TryParse(Me.SubdivisionUID, SubUID)
                    If SubUID > 0 Then mysubdvn = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(SubUID)
                End If
                If optEnableTimeZoneSettings AndAlso mysubdvn IsNot Nothing Then
                    Me.UpdateTime = GenerateTime(mysubdvn)
                Else
                    Me.UpdateTime = Now
                End If
                Dim ReportInsertSQL As String = Me.GetInsertString("tblSystemIncidentReportsInActive")
                Dim ReportDeleteSQL As String = "DELETE FROM tblSystemIncidentReportsActive WHERE UID = '" & Me.GUID & "'"
                With QueryCollection
                    .Add(ReportInsertSQL)
                    .Add(ReportDeleteSQL)
                End With
                Dim TrainDelays() As String = Me.TrainDelayUIDReferences.Split(";")
                Dim TrainDelaysList As New ArrayList
                Dim tdUID As String
                For Each tdUID In TrainDelays
                    If tdUID.Trim <> "" Then
                        If Not TrainDelaysList.Contains(tdUID) Then TrainDelaysList.Add(tdUID)
                    End If
                Next
                'Dim DelayList As New ArrayList
                Dim trn As TrainID = Nothing

                'For Each trn In TrainCollection
                '    For Each td In trn.myDelayList
                '        If TrainDelaysList.Contains(td.DelayUID) Then
                '            DelayList.Add(td)
                '        End If
                '    Next
                'Next

                If Me.IncidentType = "ENROUTE FAILURE EVENT" Then
                    EnRouteFailureMode = True
                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(Me.TrainSymbol)
                    If trn Is Nothing Then EnRouteFailureMode = False
                End If


                If ExecuteQueryCollection(QueryCollection, gConnectionStringDynamic) Then
                    If Not EnRouteFailureMode Then
                        For Each trn In TrainCollection
                            Dim TempTrainDelayCollection As New ArrayList
                            CopyArrayCollection(TempTrainDelayCollection, trn.myDelayList)
                            If TempTrainDelayCollection IsNot Nothing AndAlso TempTrainDelayCollection.Count > 0 Then
                                For Each td In TempTrainDelayCollection
                                    For Each tdUID In TrainDelays
                                        If tdUID.Trim <> "" AndAlso td.DelayUID.ToUpper.Trim = tdUID.ToUpper.Trim Then
                                            td.RemoveDelay(True)
                                            TMDS.NetworkMessages.CadMessages.SendTrainDelayARRC(trn, td, gMISTransmitQueue, "D")
                                            Exit For
                                        End If
                                    Next
                                Next
                            End If
                        Next
                    Else
                        Dim TempTrainDelayCollection As New ArrayList
                        CopyArrayCollection(TempTrainDelayCollection, trn.myDelayList)
                        If TempTrainDelayCollection IsNot Nothing AndAlso TempTrainDelayCollection.Count > 0 Then
                            For Each td In TempTrainDelayCollection
                                For Each tdUID In TrainDelays
                                    If tdUID.Trim <> "" AndAlso td.DelayUID.ToUpper.Trim = tdUID.ToUpper.Trim Then
                                        td.RemoveDelay(True)
                                        TMDS.NetworkMessages.CadMessages.SendTrainDelayARRC(trn, td, gMISTransmitQueue, "D")
                                        Exit For
                                    End If
                                Next
                            Next
                        End If
                    End If
                    Dim SummItem As New SummaryItem("TROUBLEREPORT", "REMOVE", Me)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTroubleReportQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTroubleReportQueue.Enqueue(SummItem)
                    End SyncLock
                    TMDS.GlobalDeclarations.gTroubleReports.Remove(Me)
                    Return True
                End If
                PublishTroubleReport(TROUBLEREPORTSTATUS.DELETE)
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                QueryCollection = Nothing
            End Try

        End Function

