        Public Sub LoadTagRecords()
            Try
                Using dbConnection As New OleDbConnection(gConnectionStringDynamic)
                    dbConnection.Open()
                    Dim query As String = $"SELECT TrackGUID, Subdivision, TerritoryID, Creator, CreateTime, TagType, 
                                                DataString, Restrictive, RestrictionFlag, DelayData, Delay, TagUID, 
                                                Direction, ExpectedReleaseTime, CompList, RefNumPTC, PTCData, 
                                                NameRequestingTagPlacement, SpeedTagFlagInfo, SpeedTagReasonCode,
                                                CreateSpeedRestriction, SpeedRestrictionCreated, DurationTime, BulletinTag, 
                                                BulletinReferenceGUID, BulletinForProtectionList, BulletinForCancellationList, 
                                                PTCComponents, PTCTrackSegments, PTCBulletinText, MilePostBeginPrefix, 
                                                MilePostEndPrefix, DeliveryOfRestriction, AdvisorySummary, MilePostBeginSuffix, 
                                                MilePostEndSuffix, MilePostBegin, MilePostEnd, PTCCompositionCRC, 
                                                ObjectCRC, CriticalAlertType, HeadEndRestrictionOnly 
                                            FROM tblTrackTagsActive 
                                            WHERE TerritoryID = {TerritoryID}"
                    Using dbComm As New OleDbCommand(query, dbConnection)
                        Using dr As OleDbDataReader = dbComm.ExecuteReader()
                            While dr.Read()
                                Dim trackTag As New Tag()
                                With trackTag
                                    .TrackGuid = dr.GetInt32(0)
                                    .Subdivision = dr.GetString(1)
                                    .TerritoryID = dr.GetInt32(2)
                                    .Creator = dr.GetString(3)
                                    .CreateTime = dr.GetString(4)
                                    .TagType = dr.GetString(5)
                                    .DataString = dr.GetString(6)
                                    .Restrictive = dr.GetInt32(7)
                                    .Restriction = dr.GetBoolean(8)
                                    .DelayData = dr.GetString(9)
                                    .Delay = dr.GetBoolean(10)
                                    If Not dr.IsDBNull(11) Then .TagGuid = dr.GetString(11)
                                    If .Restrictive = 2 Then .ShowOccupancy = True
                                    If Not dr.IsDBNull(12) Then .Direction = Trim(dr.GetString(12))
                                    If Not dr.IsDBNull(13) Then .ExpectedReleaseTime = dr.GetDateTime(13)
                                    Dim theTrack As Track = FetchData.FindTrackItemFromGUID(.TrackGuid)
                                    If theTrack.AddTagToTrack(trackTag) Then TrackTags.Add(trackTag)
                                End With
                            End While
                        End Using
                    End Using
                End Using
            Catch ex As Exception
                AddEventToLog(EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            End Try
        End Sub

        ''' <summary>
        ''' Load stored routes
        ''' </summary>
        Public Sub LoadStoredRoutes()
            Dim query As String
            Dim dr As OleDbDataReader = Nothing
            Dim dbComm As OleDbCommand = Nothing
            Dim sr As StoredRoute
            Try
                query = "SELECT * FROM tblStoreRoutes"
                query = query & " WHERE TerrUID = " & Me.TerritoryID
                query = query & " ORDER BY tblStoreRoutes.ControlPoint, tblStoreRoutes.Priority;"
                Using dbConn As New OleDbConnection(TMDS.gConnectionStringDynamic)
                    dbConn.Open()
                    dbComm = New OleDbCommand(query, dbConn)
                    dr = dbComm.ExecuteReader()
                    While dr.Read()
                        sr = New StoredRoute()
                        sr.TerrUID = dr.GetInt32(0)
                        sr.CtrlPoint = TMDS.SystemUtilities.FetchData.FindCPFromGUID(dr.GetInt32(1))
                        sr.CreateTime = dr.GetDateTime(2)
                        sr.Priority = dr.GetInt32(3)
                        sr.EntrySignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(dr.GetInt32(4))
                        sr.TrafficDirection = sr.EntrySignal.DefaultTraffic
                        sr.ExitSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(dr.GetInt32(5))
                        Dim CompList() As String = dr.GetString(6).Split("|")
                        Dim compUID As String
                        For Each compUID In CompList
                            If compUID <> "" Then
                                If sr.ComponentSelection Is Nothing Then
                                    sr.ComponentSelection = New ArrayList()
                                End If
                                If IsNumeric(compUID) Then
                                    Dim Comp As Object = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(CInt(compUID))
                                    If Not sr.ComponentSelection.Contains(Comp) Then
                                        sr.ComponentSelection.Add(Comp)
                                    End If
                                End If
                            End If
                        Next
                        Dim SwList() As String = dr.GetString(7).Split("|")
                        Dim swUID As String
                        For Each swUID In SwList
                            If swUID <> "" Then
                                If sr.SwitchExecuteList Is Nothing Then
                                    sr.SwitchExecuteList = New ArrayList()
                                End If
                                Dim SwToExe() As String = swUID.Split(";")
                                If SwToExe.Length = 2 Then
                                    If IsNumeric(SwToExe(0)) Then
                                        Dim Comp As Object = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(CInt(SwToExe(0)))
                                        Dim swToAdd As New StoredRoute.SwitchToExecute()
                                        swToAdd.switchToControl = Comp
                                        swToAdd.ControlReverse = CBool(SwToExe(1))
                                        If Not sr.SwitchExecuteList.Contains(swToAdd) Then
                                            sr.SwitchExecuteList.Add(swToAdd)
                                        End If
                                    End If
                                End If
                            End If
                        Next
                        sr.RouteGUID = dr.GetString(8)
                        If sr.Priority = 0 Then
                            sr.UpdateSignalDisplays()
                        End If
                        sr.CtrlPoint.StoredRoutes.Add(sr)
                    End While
                    dr.Close()
                    dbConn.Close()
                End Using
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                query = Nothing
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                dr = Nothing
                sr = Nothing
            End Try
        End Sub

