        ''' <summary>
        ''' Simply returns whether or not this TrackZone is occupied based on the first track occupation (RPBJR)
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Function IsOccupied() As Boolean

            Dim zoneOccupied As Boolean = False

            Try
                If Me.TrackList.Count > 1 Then
                    zoneOccupied = CType(Me.TrackList(0), Track).Occuppied
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

            Return zoneOccupied

        End Function

        ''' <summary>
        ''' Overriding the Equals function to allow for comparisons. (RPBJR)
        ''' </summary>
        ''' <param name="object_to_compare"></param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Overridable Overloads Function Equals(ByVal object_to_compare As Object) As Boolean

            Dim isEqual As Boolean = False

            Try

                'Verify that the passed object is not empty and it is the same type
                If object_to_compare Is Nothing Or Not Me.GetType.Equals(object_to_compare.GetType) Then
                    Exit Function
                End If

                'Cast object
                Dim trackZoneToCompare As TrackZone = CType(object_to_compare, TrackZone)

                'Check zone UID's for =
                If Me.ZoneUID = trackZoneToCompare.ZoneUID Then
                    isEqual = True
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
                isEqual = False
            End Try

            Return isEqual

        End Function

        ''' <summary>
        ''' Overloads the = operator (RPBJR)
        ''' </summary>
        ''' <param name="first_track_zone"></param>
        ''' <param name="second_track_zone"></param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared Operator =(ByVal first_track_zone As TrackZone, ByVal second_track_zone As TrackZone) As Boolean

            Return Object.Equals(first_track_zone, second_track_zone)

        End Operator

        ''' <summary>
        ''' Overloads the not equals operator (RPBJR)
        ''' </summary>
        ''' <param name="first_track_zone"></param>
        ''' <param name="second_track_zone"></param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared Operator <>(ByVal first_track_zone As TrackZone, ByVal second_track_zone As TrackZone) As Boolean

            Return Not (first_track_zone = second_track_zone)

        End Operator

        ''' <summary>
        ''' Returns the zone reference for left neighboring zone (RPBJR)
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Function ZoneToTheLeft() As TrackZone

            Dim leftZone As TrackZone = Nothing

            Try

                If TrackList.Count > 0 Then

                    Dim firstTrack As Track = CType(TrackList(0), Track)

                    If firstTrack.LeftLink > 0 Then

                        leftZone = CType(FindCompFromGUID(firstTrack.LeftLink), Track).TrackZoneReference

                        If leftZone = Me Then
                            leftZone = Nothing
                        End If

                    End If

                End If

            Catch ex As Exception
                SystemException(ex.ToString)
                leftZone = Nothing
            End Try

            Return leftZone

        End Function

        ''' <summary>
        ''' Returns the reference to the zone to the right  (RPBJR)
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Function ZoneToTheRight() As TrackZone

            Dim rightZone As TrackZone = Nothing

            Try

                If TrackList.Count > 0 Then

                    Dim lastTrack As Track = CType(TrackList(TrackList.Count - 1), Track)

                    If lastTrack.RightLink > 0 Then

                        rightZone = CType(FindCompFromGUID(lastTrack.RightLink), Track).TrackZoneReference

                        If rightZone = Me Then
                            rightZone = Nothing
                        End If

                    End If

                End If

            Catch ex As Exception
                SystemException(ex.ToString)
                rightZone = Nothing
            End Try

            Return rightZone

        End Function

        ''' <summary>
        ''' Returns the track list from Right to Left for TIWS zone verification.
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Function TrackListInReverse() As ArrayList

            Dim reverseTrackList As New ArrayList()

            For trackCounter As Integer = Me.TrackList.Count - 1 To 0 Step -1

                reverseTrackList.Add(Me.TrackList(trackCounter))

            Next

            Return reverseTrackList

        End Function

        Public Sub ReorderTrackList()
            Dim NewList As New ArrayList
            Dim FirstTrack As Track
            Dim TrackFound As Boolean
            Do
                Dim trk As Track
                For Each trk In Me.TrackList
                    Dim NextTrack As Track
                    For Each NextTrack In Me.TrackList
                        If trk.LeftLink = NextTrack.GUID Then
                            TrackFound = True
                        Else
                            Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(trk.LeftLink)
                            If Not IsNothing(sw) Then
                                TrackFound = True
                            End If
                        End If
                    Next
                    If Not TrackFound Then
                        FirstTrack = trk
                        NewList.Add(trk)
                        Exit Do
                    Else
                        TrackFound = False
                    End If
                Next
                LoopControl += 1
                If LoopControl > 200 Then
                    Exit Sub
                End If
            Loop
            LoopControl = 0
            Do
                Dim trk As Track
                For Each trk In Me.TrackList
                    Dim NextTrack As Track = NewList.Item(NewList.Count - 1)
                    Dim NextLink As Int32
                    Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(NextTrack.RightLink)

                    If Not IsNothing(sw) Then
                        NextLink = sw.RightLink
                    Else
                        NextLink = NextTrack.RightLink
                    End If
                    If trk.GUID = NextLink Then
                        NewList.Add(trk)
                        Exit For
                    End If

                    If trk.FoulingTrackSPMS Then
                        'Dim mySwitch As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(trk)
                        'If Not IsNothing(mySwitch) Then
                        '    Me.ZoneName = mySwitch.Name
                        'End If
                    End If
                Next

                If Me.TrackList.Count = NewList.Count Then
                    Exit Do
                End If
                LoopControl += 1
                If LoopControl > 200 Then
                    Exit Sub
                End If

            Loop

            Me.TrackList = NewList
        End Sub

