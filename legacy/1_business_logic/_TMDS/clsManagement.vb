                                            TrainToUpdate.CrewCurrent.Conductor.OnDutyTime = TMDS.SystemUtilities.Formatting.FormatDateString(UnitData(2))
                                            TrainToUpdate.CrewCurrent.Conductor.HOS = TMDS.SystemUtilities.Formatting.FormatDateString(UnitData(3))
