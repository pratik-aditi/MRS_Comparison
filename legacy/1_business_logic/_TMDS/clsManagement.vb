        Private Function ApplyUnitChange(ByVal LeadUnit As Boolean, ByVal pForm As Object, LaunchPoint As Point) As Boolean
            Try
                ''1|ARR |4318|1|ANCH||
                If LeadUnit Then
                    Dim data() As String = TaskData.Split("|")
                    Dim Unit As String = data(1) & Space(2) & data(2)
                    Dim Position As Integer = CInt(data(3))
                    If Not myTrain.TrainInActive AndAlso CheckIfEngineIsActiveOnDifferentTrain(myTrain, Unit, pForm, LaunchPoint) Then Return False
                    myTrain.IdentifingUnit = Unit
                Else
                    Dim units() As String = TaskData.Split(";")
                    Dim u As String
                    Dim newUnits As New StringBuilder
                    myTrain.Units.Clear()
                    For Each u In units
                        Dim data() As String = u.Split("|")
                        Dim Unit As String = data(1) & Space(2) & data(2)
                        Dim Position As Integer = CInt(data(3))
                        myTrain.Units.Add(Unit)
                        UpdateUnitPosition(Unit, Position, data(4))
                    Next

                End If
                myTrain.UpdateTrainUnits("ApplyUnitChange", True)
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function ApplyUnitChange_New(Optional ByVal pForm As Object = Nothing) As Boolean
            Dim EngineSetList As New ArrayList
            Dim LeadEngineChange As Boolean
            Dim LocomotiveEngineSetInfoString As New StringBuilder
            Dim MessageList As New ArrayList
            Dim LaunchPoint As Point = Nothing
            Try

                If pForm IsNot Nothing Then
                    LaunchPoint = New Point(pForm.Left + 20, pForm.Top + 50)
                End If

                ''1|ARR |4318|1|ANCH||
                EngineSetList = GetEngineSet()
                If EngineSetList IsNot Nothing AndAlso EngineSetList.Count > 0 Then
                    Dim clseng As clsEngineSet
                    Dim LeadEngine As clsEngineSet = Nothing
                    For Each clseng In EngineSetList
                        If clseng.IsleadEngine Then LeadEngine = clseng : Exit For
                    Next
                    Dim myList As New List(Of clsEngineSet)
                    For Each clseng In EngineSetList
                        myList.Add(clseng)
                    Next
                    myList.Sort(Function(x, y) x.UnitPosition.CompareTo(y.UnitPosition))

                    If LeadEngine IsNot Nothing AndAlso myTrain.IdentifingUnit <> LeadEngine.UnitID Then
                        LeadEngineChange = True
                        If CheckIfAuthExistsForTrain(myTrain.Name) Then
                            MessageList = New ArrayList
                            With MessageList
                                .Add("THIS TRAIN HAS ONE OR MORE AUTHORITIES ISSUED")
                                .Add("WORK TASK CANNOT BE ACCEPTED AT THIS TIME")
                            End With
                            ShowCustomMessageBox(MessageList, "SYSTEM CONFLICT CHECK", False, LaunchPoint, True, True, pForm)
                            Me.IgnoreErrorPrompt = True
                            Return False
                        ElseIf Not myTrain.TrainInActive AndAlso CheckIfEngineIsActiveOnDifferentTrain(myTrain, LeadEngine.UnitID, pForm, LaunchPoint) Then
                            Me.IgnoreErrorPrompt = True
                            Return False
                        Else
                            myTrain.IdentifingUnit = LeadEngine.UnitID
                            Try
                                If myTrain.myTrack IsNot Nothing Then
                                    myTrain.myTrack.InvalidateTrainID()
                                    myTrain.myTrack.InitTrainDisplay()
                                End If
                            Catch ex As Exception
                            End Try
                        End If
                    End If
                    Dim LocomotiveUpdateStringCollection As New ArrayList
                    For Each clseng In myList
                        Dim QueryString As String = ""
                        If DoesUnitExist(clseng.UnitID) Then
                            QueryString = GetSystemLocomotiveUpdateString(clseng.UnitID, clseng.UnitPosition, clseng.FullDestStation, clseng.HPEffective)
                        Else
                            QueryString = GetSystemLocomotiveInsertString(clseng)
                        End If
                        If QueryString IsNot Nothing AndAlso QueryString.Trim <> "" Then
                            If Not LocomotiveUpdateStringCollection.Contains(QueryString) Then LocomotiveUpdateStringCollection.Add(QueryString)
                        Else
                            'Invalid Update or Insert String
                            MessageList = New ArrayList
                            With MessageList
                                .Add("ERROR SAVING TO DB - ERROR CODE: WT101")
                                .Add("PLEASE CONSULT SYSTEM ADMINISTATOR")

                            End With
                            ShowCustomMessageBox(MessageList, "SYSTEM CONFLICT CHECK", False, LaunchPoint, True, True, pForm)
                            Me.IgnoreErrorPrompt = True
                            Return False
                        End If
                    Next
                    If Not ExecuteQueryCollection(LocomotiveUpdateStringCollection, gConnectionStringStatic) Then
                        MessageList = New ArrayList
                        With MessageList
                            .Add("ERROR SAVING TO DB - ERROR CODE: WT102")
                            .Add("PLEASE CONSULT SYSTEM ADMINISTATOR")
                        End With
                        ShowCustomMessageBox(MessageList, "SYSTEM CONFLICT CHECK", False, LaunchPoint, True, True, pForm)
                        Me.IgnoreErrorPrompt = True
                        Return False
                    End If
                    If LeadEngine IsNot Nothing Then
                        myTrain.IdentifingUnit = LeadEngine.UnitID
                    End If
                    Dim FirstLoop As Boolean = True

                    'MsgVer|MsgEd|GrpIndx|GrpCount~SetNumber|LocoInitial|LocoNumber|Postion|StationUID|Controlling|EHP|DPStatus Chr(1) 
                    For Each clseng In myList
                        If clseng IsNot Nothing Then
                            With LocomotiveEngineSetInfoString
                                If Not FirstLoop Then .Append(Chr(1))
                                .Append(clseng.MessageVersion & "|")
                                .Append(clseng.MessageEdition & "|")
                                .Append(clseng.GroupIndex & "|")
                                .Append(clseng.GroupCount & "|")
                                .Append("~")
                                .Append(clseng.SetNumber & "|")
                                .Append(clseng.LocoInitial & "|")
                                .Append(clseng.LocoNumber & "|")
                                .Append(clseng.UnitPosition & "|")
                                .Append(clseng.FullDestStation & "|")
                                If clseng.IsleadEngine Then
                                    .Append("Y|")
                                Else
                                    .Append("|")
                                End If
                                .Append(clseng.HPEffective & "|")
                                If clseng.UnitDPEnabled Then
                                    .Append("Y|")
                                Else
                                    .Append("N")
                                End If

                            End With
                            FirstLoop = False
                        End If
                    Next
                    FirstLoop = True
                    For Each clseng In myList
                        Dim OkToProcess As Boolean = True
                        If LeadEngine IsNot Nothing AndAlso clseng Is LeadEngine Then OkToProcess = False

                        If myList.Count = 1 AndAlso OkToProcess = False Then
                            'Possible that the Other Units has been removed.
                            myTrain.Units.Clear()
                        End If


                        If OkToProcess Then
                            If FirstLoop Then myTrain.Units.Clear()
                            FirstLoop = False
                            myTrain.Units.Add(clseng.UnitID)
                            UpdateUnitPosition(clseng.UnitID, clseng.UnitPosition, clseng.FullDestStation)
                        End If
                    Next
                    myTrain.UpdateTrainUnits("Apply 1020 UnitChange", True)
                    'myTrain.LocomotiveConsistInfoString_MIS = LocomotiveEngineSetInfoString.ToString
                    'myTrain.UpdateLocomotiveConsistInformationMISIntoDatabase()

                End If
                Return True


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Sub UpdateUnitPosition(ByVal Unit As String, ByVal Position As Integer, ByVal CurrentDestination As String)
            Dim dbcomm As OleDbCommand = Nothing
            Dim dbconn As OleDb.OleDbConnection = Nothing

            Try
                dbconn = New OleDbConnection(gConnectionStringStatic)
                dbconn.Open()
                Dim Update As New StringBuilder
                Update.Append("UPDATE tblSystemLocomotives ")
                Update.Append(" SET UnitPosition = " & Position)
                Update.Append(", CurrentDestination = '" & CurrentDestination & "'")
                Update.Append(" WHERE UID = '" & Unit & "'")
                dbcomm = New OleDbCommand(Update.ToString, dbconn)
                dbcomm.ExecuteNonQuery()
                dbconn.Close()
                dbconn = Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try

        End Sub

