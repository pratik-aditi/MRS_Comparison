        Public Shared Function CreateAlert(theTypeOfAlert As Alert.AlertType,
                                           dataString As String,
                                           Optional theTrain As TrainID = Nothing,
                                           Optional theVehicle As TMDS.MobileTracking.Vehicle = Nothing,
                                           Optional theSignal As Signal = Nothing,
                                           Optional theTrack As Track = Nothing,
                                           Optional theDevice As Device = Nothing,
                                           Optional theAuthority As TrackAuthority.TrackAuthority = Nothing,
                                           Optional theDeviceBlock As DeviceBlock = Nothing,
                                           Optional theSwitch As Switch = Nothing,
                                           Optional theTrackZone As TrackZone = Nothing,
                                           Optional theWeatherMessage As WeatherMessage = Nothing,
                                           Optional theSingleAuthority As SFAuthority = Nothing,
                                           Optional theSubdivision As Subdivision = Nothing,
                                           Optional theControlPoint As ControlPoint = Nothing,
                                           Optional theOtherAuthority As OtherSpecialAuthorityType = Nothing,
                                           Optional theTabularBulletin As TabularGeneralBulletinException = Nothing,
                                           Optional theTag As Tag = Nothing,
                                           Optional theEquipment As FailedEquipmentDetectorMessage = Nothing,
                                           Optional theWeatherStation As WeatherStation = Nothing,
                                           Optional theObject As Object = Nothing) As Alert
            Try
                Dim theUser As String = $"{gCurrentUser.LastName}, {gCurrentUser.FirstName}"
                Dim theAlert As Alert = Nothing
                Select Case theTypeOfAlert
                    Case Alert.AlertType.VETMS_PTC_TextMessage
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                    Case Alert.AlertType.RequestControlOfControlPoint
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theControlPoint)
                    Case Alert.AlertType.LostTrackOccupancy
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                    Case Alert.AlertType.SignalAuthorizationRequest
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrack)
                    Case Alert.AlertType.JoinTrackNameRequest
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrack)
                    Case Alert.AlertType.JoinAuthorizationSuccess,
                         Alert.AlertType.JoinAuthorizationError
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theObject)
                        theAlert.ForceAlert = True
                    Case Alert.AlertType.JoinAuthorizationRequest
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theObject)
                    Case Alert.AlertType.JoinTrackNameAcceptedResponse
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theObject)
                    Case Alert.AlertType.JoinTrackNameDeniedResponse
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theObject)
                    Case Alert.AlertType.VETMS_PTC_TrackTagIssuanceRequestFailed
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTag)
                        theAlert.PTCAlert = True
                    Case Alert.AlertType.TagExpiration
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTag)
                    Case Alert.AlertType.ConditionalAlertCautionary,
                         Alert.AlertType.ConditionalAlertCritical
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, Nothing)
                    Case Alert.AlertType.DerailmentDetector
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrack)
                    Case Alert.AlertType.VETMS_PTC_AuthorityIssuanceRequestRejected
                        Dim myALObject As Object = Nothing
                        If theOtherAuthority IsNot Nothing Then myALObject = theOtherAuthority
                        If myALObject Is Nothing AndAlso theAuthority IsNot Nothing Then myALObject = theAuthority
                        If myALObject Is Nothing AndAlso theSingleAuthority IsNot Nothing Then myALObject = theSingleAuthority
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, myALObject)
                        theAlert.PTCAlert = True
                    Case Alert.AlertType.VETMS_PTC_TrainActiviatedForPTC,
                         Alert.AlertType.VETMS_PTC_TrainDeactiviatedForPTC,
                         Alert.AlertType.VETMS_PTC_BrakingEnforcementForPTC
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                        theAlert.PTCAlert = True
                    Case Alert.AlertType.VETMS_PTC_AuthorityViolation,
                         Alert.AlertType.VETMS_PTC_AuthorityViolationCleared
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                        theAlert.PTCAlert = True
                    Case Alert.AlertType.VETMS_PTC_RouteListRequest,
                         Alert.AlertType.VETMS_PTC_RouteListRequest
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theTrain)
                        theAlert.PTCAlert = True
                    Case Alert.AlertType.VETMS_PTC_EMT_AuthorityIssuanceRequestFailed,
                         Alert.AlertType.VETMS_PTC_PSS_AuthorityIssuanceRequestFailed,
                         Alert.AlertType.VETMS_PTC_EMT_AuthorityCancelRequestFailed,
                         Alert.AlertType.VETMS_PTC_PSS_AuthorityCancelRequestFailed
                        theAlert = New Alert(theTypeOfAlert, dataString, theUser, theOtherAuthority)
                        theAlert.PTCAlert = True
