        Public Shared Sub PerformCancelRequestFromMobile(ByVal dataInMessage As String)
            Try
                SystemEvent("CANCEL REQUEST RECEIVED:" & dataInMessage)
                Dim data() As String = dataInMessage.Split("|")
                If data.Length >= 4 Then
                    'TERRID = 0
                    'MOBILE TERMINAL = 1
                    'LAST NAME = 2
                    'FIRST NAME =3
                    Dim mm As MobileMessage
                    Dim mmList As New ArrayList()

                    SyncLock gMobileClientMessages.SyncRoot
                        For Each mm In gMobileClientMessages
                            If mm.thisMobileTerminal = data(1) Then
                                mmList.Add(mm)
                            End If
                        Next
                    End SyncLock
                    For Each mm In mmList
                        SyncLock gMobileClientMessages.SyncRoot
                            gMobileClientMessages.Remove(mm)
                        End SyncLock
                        Dim SummItem As New SummaryItem("MOBILEMESSAGE", "REMOVE", mm)
                        SyncLock TMDS.GlobalDeclarations.gMobileClientMessageSummaryQueue.SyncRoot
                            TMDS.GlobalDeclarations.gMobileClientMessageSummaryQueue.Enqueue(SummItem)
                        End SyncLock
                    Next
                    mmList.Clear()
                    mmList = Nothing
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Sub ProcessReleaseAuthorityRequestMessageForTrackWarrant(ByVal MessageToProcess As String)

            Try
                SystemEvent(MessageToProcess)

                Dim DataString() As String = MessageToProcess.Split(";")
                Dim data() As String = DataString(1).Split("|")
                'Message = "MC:RELAUTHREQ;" & "|"
                '0-CurrentAuthorityItem.TerritoryAssignment.ToString
                '1-CurrentAuthorityItem.AuthGUID 
                '2-CurrentAuthorityItem.AuthorityUID
                '3-CurrentAuthorityItem.MobileClientDSA
                '4-MDS.GlobalDeclarations.gThisWorkstation.Name 
                '5-TMDS.GlobalDeclarations.gCurrentUser.Initials()
                Dim auth As Object 'TrackAuthority.TrackAuthority
                Dim EventMessage As String
                Dim Response As String
                Dim AuthorityReleased As Boolean
                'Dim AuthToRelease As Object 'TrackAuthority.TrackAuthority

                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        Dim sfa As SFAuthority = CType(auth, SFAuthority)

                        If sfa.AuthGUID = data(1) Then
                            If sfa.MobileClientDSA = data(3) Then

                                'APPLY REPORT CLEAR TIME FIRST
                                Dim CurrentTimeZone As String = String.Empty
                                Dim Comp As Object
                                For Each Comp In sfa.Components
                                    If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        If Comp.TimeZone <> "" Then
                                            CurrentTimeZone = Mid(Comp.TimeZone, 1, 1)
                                            Exit For
                                        End If
                                    End If
                                Next
                                Dim CurrentTime As Date = Now
                                If Format(CurrentTime, "HH:mm") = "00:00" Then
                                    CurrentTime = CurrentTime.AddMinutes(1)
                                End If

                                Select Case CurrentTimeZone
                                    Case "E"
                                        sfa.ReportClearTime = CurrentTime.AddHours(CDbl(1 + gThisWorkstationTimeFactor))
                                    Case "M"
                                        sfa.ReportClearTime = CurrentTime.AddHours(CDbl(-1 + gThisWorkstationTimeFactor))
                                    Case "P"
                                        sfa.ReportClearTime = CurrentTime.AddHours(CDbl(-2 + gThisWorkstationTimeFactor))
                                    Case Else
                                        sfa.ReportClearTime = CurrentTime.AddHours(CDbl(gThisWorkstationTimeFactor))
                                End Select
                                'APPLY REPORT CLEAR TIME FIRST THEN RELEASE FROM THE DATABASE AND THEN FROM THE COMPONENTS

                                sfa.ReportedClearByMobileClient = True
                                sfa.UpdateSFAVIIIRpClearTime()
                                If sfa.RemoveSFAVIIAuthorityFromDB(Nothing) Then

                                    If sfa.RemoveAuthorityFromComponents(Nothing) Then
                                        EventMessage = "TRACK SFAORITY:" & data(2) & " REQUESTED FOR RELEASE FROM MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS REMOVED FROM TRACK COMPONENTS."
                                        SystemEvent(EventMessage)
                                        ''
                                        EventMessage = "TRACK SFAORITY:" & data(2) & " REQUESTED FOR RELEASE FROM MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS REMOVED FROM DATABASE."
                                        SystemEvent(EventMessage)
                                        AuthorityReleased = True

                                        Dim AlertMessage As String = sfa.AuthorityUID & "|" & sfa.IssueTo & "|" & sfa.ReducedLimitsVerbiage
                                        TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.ReleasedTWAuthority, AlertMessage, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, sfa)

                                        Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", sfa)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem)
                                        End SyncLock

                                        ''
                                        'sfa.RemoveTrackSFAFromRemoteLinks
                                        OtherTrackAuthorities.Remove(sfa)

                                    Else
                                        EventMessage = "TRACK SFAORITY:" & data(2) & " NOT RELEASED. MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS NOT REMOVED FROM TRACK COMPONENTS."
                                        SystemEvent(EventMessage)
                                    End If
                                Else
                                    EventMessage = "TRACK SFAORITY:" & data(2) & " NOT RELEASED. MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS NOT REMOVED FROM DATABASE."
                                    SystemEvent(EventMessage)
                                End If

                                If AuthorityReleased Then
                                    If auth.MixModeAuthorityType Then DoPerformReleaseSFAMixModeAuthority(auth.AuthorityUID)
                                    Response = "MC:RELSFAREQCONFIRMED;" & data(4) & "|" & data(1) & "|" & TMDS.GlobalDeclarations.gCurrentUser.Initials
                                    Exit For
                                Else
                                    Response = "MC:RELSFAREQNAK;" & data(4) & "|" & data(1) & "|" & TMDS.GlobalDeclarations.gCurrentUser.Initials
                                End If
                                SyncLock gMSCTransmitQueue.SyncRoot
                                    gMSCTransmitQueue.Enqueue(Response)
                                End SyncLock
                            End If
                        End If
                    End If
                Next


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
        Private Shared Sub DoPerformReleaseSFAMixModeAuthority(ByVal AuthUID As String)
            Try
                Dim auth As Object
                For Each auth In OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                        Dim ta As TrackAuthority.TrackAuthority = CType(auth, TrackAuthority.TrackAuthority)
                        If ta.MixModeAuthorityType AndAlso ta.AuthorityUID = AuthUID Then
                            If ta.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                If ta.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                    ta.RemoveTrackAuthFromRemoteLinks()
                                    TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(ta)
                                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", ta)
                                    SyncLock gSummaryAuthQueue.SyncRoot
                                        gSummaryAuthQueue.Enqueue(SummItem)
                                    End SyncLock
                                End If
                                Exit For
                            End If
                        End If
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

