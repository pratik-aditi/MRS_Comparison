            End Try
        End Sub


        Sub New(ByVal MessType As MessageType, ByVal MessData As String)
            Try

                Select Case MessType
                    Case MessageType.AuthorityRequest
                        If Not CreateAuthRequest(MessData) Then
                            Exit Sub
                        End If
                    Case MessageType.SpeedRestrictionRequest
                        If Not CreateTagRequest(MessData) Then
                            Exit Sub
                        End If

                    Case MessageType.InstantMessage
                        If Not CreateInstantMessage(MessData) Then
                            Exit Sub
                        End If

                End Select

                Dim fmn As Foreman = Me.FindMobileClient(Me)
                If Not IsNothing(fmn) Then
                    fmn.TerminalID = Me.thisMobileTerminal
                End If

                SyncLock gMobileClientMessages.SyncRoot
                    gMobileClientMessages.Add(Me)
                End SyncLock

                Dim SummItem As New SummaryItem("MOBILEMESSAGE", "ADD", Me)
                SyncLock TMDS.GlobalDeclarations.gMobileClientMessageSummaryQueue.SyncRoot
                    TMDS.GlobalDeclarations.gMobileClientMessageSummaryQueue.Enqueue(SummItem)
                End SyncLock


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Private Function CreateAuthRequest(ByVal dataInMessage As String) As Boolean
            Try
                MobileMessage.SystemEvent("AUTHORITY REQUEST RECEIVED:" & dataInMessage)
                If optEnableShadowMode Then
                    Dim tmpData() As String
                    tmpData = dataInMessage.Split("$")
                    If tmpData IsNot Nothing AndAlso tmpData.Length > 0 Then
                        dataInMessage = tmpData(0)
                    End If
                End If
                Dim data() As String = dataInMessage.Split("|")
                myMessageType = "AUTHORITY REQUEST"
                ' MC:REQUESTAUTH;148|RJ|SMITH|JOHN|True|148131-|148:1.0.18!|||TWC

                If data.Length >= 8 Then
                    If IsNumeric(data(0)) Then
                        Me.thisTerrID = CInt(data(0))
                    Else
                        Exit Function
                    End If
                    If Trim(data(1)) <> "" Then
                        Me.thisMobileTerminal = data(1)
                    Else
                        Exit Function
                    End If
                    'If Trim(data(2)) <> "" And Trim(data(3)) <> "" Then 'Commenting this out to preserve original functionality in case we need to roll it back.  This is for SCRRA-250 and the code below is added to allow the system summary to populate the mobile client field with a call sign/employeeUID instead of a First Name and Last Name
                    '    Me.thisLastName = data(2)
                    '    Me.thisFirstName = data(3)
                    '    Me.myMessageClient = Me.thisFirstName & " " & Me.thisLastName
                    'Else
                    '    Exit Function
                    'End If
                    If Trim(data(2)) <> "" And Trim(data(3)) <> "" And Not optEnableMetrolinkSpecificCallSignRule Then 'CMV SCRRA-250   
                        Me.thisLastName = data(2)
                        Me.thisFirstName = data(3)
                        Me.myMessageClient = Me.thisFirstName & " " & Me.thisLastName
                    ElseIf Trim(data(2)) <> "" And Trim(data(3)) <> "" And optEnableMetrolinkSpecificCallSignRule Then 'CMV SCRRA-250
                        Me.thisLastName = data(2)
                        Me.thisFirstName = data(3)
                        If data.Length > 11 Then
                            Me.myMessageClient = data(11)
                            Me.UseEmployeeUIDAsName = True
                        Else
                            Me.myMessageClient = Me.thisFirstName & " " & Me.thisLastName
                        End If

                    Else
                        Exit Function
                    End If
                    Try
                        Me.authUntilTime = CDate(data(4))
                    Catch
                        Exit Function
                    End Try
                    Try
                        Me.authJointStatus = CBool(data(5))
                    Catch
                        Exit Function
                    End Try

                    Dim VehList() As String = data(6).Split("-")
                    Dim veh As String
                    For Each veh In VehList
                        If Trim(veh) <> "" Then
                            If IsNothing(Me.authVehicleList) Then
                                Me.authVehicleList = New ArrayList()
                            End If
                            Me.authVehicleList.Add(veh)
                        End If
                    Next

                    Dim CompList() As String = data(7).Split("-")
                    Dim CompGuid As String
                    For Each CompGuid In CompList
                        If Trim(CompGuid) <> "" Then
                            If IsNothing(Me.authComponentList) Then
                                Me.authComponentList = New ArrayList()
                            End If
                            If IsNumeric(CompGuid) Then
                                Dim Comp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CInt(CompGuid))
                                If IsNothing(Comp) Then
                                    Return False
                                End If
                                If Not Me.authComponentList.Contains(Comp) Then
                                    If Me.thisAuthType = "" Then
                                        If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            Dim trk As Track = CType(Comp, Track)
                                            If trk.AuthorityType = "CTC" Then
                                                Me.thisAuthType = "TT"
                                            ElseIf Mid(trk.AuthorityType, 1, 3) = "TWC" Then
                                                Me.thisAuthType = "TW"
                                            End If
                                        End If
                                    End If
                                    Me.authComponentList.Add(Comp)
                                End If
                            End If
                        End If
                    Next

                    Dim TerrList() As String = data(8).Split("!")
                    Dim Terr As String
                    For Each Terr In TerrList
                        If Trim(Terr) <> "" Then
                            Dim TerrData() As String = Terr.Split(":")
                            Dim ter As Territory
                            For Each ter In TMDS.GlobalDeclarations.ControlledTerritories
                                If ter.TerritoryID = CInt(TerrData(0)) Then
                                    If ter.Dbversion <> TerrData(1) Then
                                        MobileMessage.SystemEvent("AUTHORITY REQUEST FAILED. DATABASE VERSION MISMATCH:" & dataInMessage)
                                        SendMessageDatabaseOutOfSync()
                                        Return False
                                    End If
                                End If
                            Next
                        End If
                    Next
                    Me.thisNoteFromUser = data(9)
                    Me.authDirection = data(10)

                    If data.Length >= 12 Then
                        Me.authAlias = data(11)
                    End If

                    If data.Length >= 13 Then
                        If Me.thisAuthType = "TW" Then
                            Me.thisAuthType = data(12)
                        End If
                    End If
                    If data.Length >= 14 Then
                        Dim VoidList As String = data(13)
                        If VoidList.Trim <> "" Then
                            Dim s As String
                            Dim SpltVoid() As String = VoidList.Split("~")
                            For Each s In SpltVoid
                                Dim SFA As Object = TMDS.SystemUtilities.FetchData.FindSFA(s)
                                If SFA.GetType.ToString = gSFAComponentName Then
                                    If Not SFAVoidAuthList.Contains(SFA) Then SFAVoidAuthList.Add(SFA)
                                End If
                            Next
                        End If

                    End If

                Else
                    Exit Function
                End If
                Return True


                '0=TERRID
                '1=TERMINAL
                '2=LASTNAME
                '3=FIRSTNAME
                '4=UNTILTIME
                '5=JOINT
                '6=VEHICLES
                '7=COMPONENTS
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function CreateTagRequest(ByVal dataInMessage As String) As Boolean
            Try
                MobileMessage.SystemEvent("TAG REQUEST RECEIVED:" & dataInMessage)
                Dim data() As String = dataInMessage.Split("|")
                myMessageType = "TAG REQUEST"
                If data.Length >= 15 Then
                    If IsNumeric(data(0)) Then
                        Me.thisTerrID = CInt(data(0))
                    Else
                        Exit Function
                    End If
                    If Trim(data(1)) <> "" Then
                        Me.thisMobileTerminal = data(1)
                    Else
                        Exit Function
                    End If
                    If Trim(data(2)) <> "" And Trim(data(3)) <> "" Then
                        Me.thisLastName = data(2)
                        Me.thisFirstName = data(3)
                        Me.myMessageClient = Me.thisFirstName & " " & Me.thisLastName
                    Else
                        Exit Function
                    End If
                    Me.tagType = data(4)

                    If Not IsNumeric(data(5)) Then
                        Return False
                    End If
                    Me.tagTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CInt(data(5)))
                    If IsNothing(Me.tagTrack) Then
                        Return False
                    End If

                    'Dim i As Integer
                    'For i = 6 To 9
                    '    If Trim(data(i)) = "" Then
                    '        Return False
                    '    End If
                    'Next

                    Me.tagTrackName = data(6)
                    Me.tagMPHpass = data(7)
                    Me.tagMPHfrgt = data(8)
                    Me.tagMPfrom = data(9)
                    Me.tagMPfromS = data(10)
                    Me.tagMPto = data(11)
                    Me.tagMPtoS = data(12)
                    Me.tagDirection = data(13)
                    Me.tagRest = CBool(data(14))

                    Dim TerrList() As String = data(15).Split("!")
                    Dim Terr As String
                    For Each Terr In TerrList
                        If Trim(Terr) <> "" Then
                            Dim TerrData() As String = Terr.Split(":")
                            Dim ter As Territory
                            For Each ter In TMDS.GlobalDeclarations.ControlledTerritories
                                If ter.TerritoryID = CInt(TerrData(0)) Then
                                    If ter.Dbversion <> TerrData(1) Then
                                        MobileMessage.SystemEvent("TAG REQUEST FAILED. DATABASE VERSION MISMATCH:" & dataInMessage)
                                        SendMessageDatabaseOutOfSync()
                                        Return False
                                    End If
                                End If
                            Next
                        End If
                    Next

                    Me.thisNoteFromUser = data(16)


                    Try
                        If data.GetUpperBound(0) > 17 Then
                            Me.tagShortFlag = data(17)
                            Me.tagBorderFlag = data(18)
                            If data(19).ToUpper = "TRUE" Then
                                Me.tagNoFlag = True
                            Else
                                Me.tagNoFlag = False
                            End If
                            Me.tagExpectedReleaseDate = data(20)
                            If data(21).ToUpper = "TRUE" Then
                                Me.tagCreateVerbalPrintFormA = True
                            Else
                                Me.tagCreateVerbalPrintFormA = False
                            End If
                            Me.tagTSS = data(22)
                            Me.tagTrainDelay = data(23)
                        End If


                    Catch ex As Exception
                        SystemException("Create Tag :" & ex.ToString)
                    End Try

                Else
                    Exit Function
                End If
                Return True


                '0=TERRID
                '1=TERMINAL
                '2=LASTNAME
                '3=FIRSTNAME
                '4=UNTILTIME
                '5=JOINT
                '6=VEHICLES
                '7=COMPONENTS
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function CreateInstantMessage(ByVal dataInMessage As String) As Boolean
            Try
                MobileMessage.SystemEvent("INSTANT MESSAGE RECEIVED:" & dataInMessage)
                Dim data() As String = dataInMessage.Split("|")
                myMessageType = "INSTANT MESSAGE"
                If data.Length >= 5 Then
                    If IsNumeric(data(0)) Then
                        Me.thisTerrID = CInt(data(0))
                    Else
                        Exit Function
                    End If
                    If Trim(data(1)) <> "" Then
                        Me.thisMobileTerminal = data(1)
                    Else
                        Exit Function
                    End If
                    If Trim(data(2)) <> "" And Trim(data(3)) <> "" Then
                        Me.thisLastName = data(2)
                        Me.thisFirstName = data(3)
                        Me.myMessageClient = Me.thisFirstName & " " & Me.thisLastName
                    Else
                        Exit Function
                    End If
                    Me.iMessage = data(4)

                Else
                    Exit Function
                End If
                Return True


                '0=TERRID
                '1=TERMINAL
                '2=LASTNAME
                '3=FIRSTNAME
                '4=UNTILTIME
                '5=JOINT
                '6=VEHICLES
                '7=COMPONENTS
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Sub SendMessageDatabaseOutOfSync()
            Try
                Dim Message As String

                Message = "DBOUTOFSYNC;"
                Message = Message & Me.thisMobileTerminal & "|" & Me.thisTerrID & "|" & TMDS.GlobalDeclarations.gThisWorkstation.Description & "|" & TMDS.GlobalDeclarations.gCurrentUser.Initials

                SyncLock TMDS.GlobalDeclarations.gMSCTransmitQueue
                    TMDS.GlobalDeclarations.gMSCTransmitQueue.Enqueue(Message)
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindMobileClient(ByVal mm As MobileMessage) As Foreman
            Try
                Dim fmn As Foreman
                For Each fmn In TMDS.GlobalDeclarations.gMowForemen
                    If fmn.LastName = mm.thisLastName And fmn.FirstName = mm.thisFirstName And fmn.EICEnabled Then
                        Return fmn
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try

        End Function

        Private Shared Sub SystemEvent(ByVal EventNote As String)

            Try
                Dim ClickEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.SystemEvent, EventNote, SystemEventQueue)
                ClickEvent = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

