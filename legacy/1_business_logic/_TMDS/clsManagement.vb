        Public mySecondaryControlledSubdivisions As New ArrayList
        Public myTestControlledSubdivisions As New ArrayList
        Public ActiveStatusFromConnectedBOS As Boolean

        ''' <summary>
        ''' Start back office server instance
        ''' </summary>
        Public Sub StartBackOfficeServerInstance()
            Try
                If Not myPrimaryServer Is Nothing Then
                    myPrimaryServerConnection = New CommunicationServerConnection(myPrimaryServer, 32999, myReceiveQueue, myTransmitQueue, True)
                    DoesServerExist = True
                    BOSEventLog("StartBackOfficeServerInstance:Found primary server")
                End If
                If Not mySecondaryServer Is Nothing Then
                    mySecondaryServerConnection = New CommunicationServerConnection(mySecondaryServer, 32999, myReceiveQueue, myTransmitQueue, True)
                    DoesServerExist = True
                    BOSEventLog("StartBackOfficeServerInstance:Found seconday server")
                End If
                If DoesServerExist Then
                    myRcvQueueCheckThread = New Threading.Thread(AddressOf Me.RetrieveMessages)
                    myXmtQueueCheckThread = New Threading.Thread(AddressOf Me.SendMessages)
                    myRcvQueueCheckThread.Priority = Threading.ThreadPriority.BelowNormal
                    myXmtQueueCheckThread.Priority = Threading.ThreadPriority.BelowNormal
                    myRcvQueueCheckThread.Name = "PTC-BOS-RCV-" & Me.myName
                    myXmtQueueCheckThread.Name = "PTC-BOS-XMT-" & Me.myName
                    myRcvQueueCheckThread.Start()
                    myXmtQueueCheckThread.Start()
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        ''' <summary>
        ''' Is DisConnected
        ''' </summary>
        ''' <returns></returns>
        Public Function IsDisConnected() As Boolean
            Dim disConnected As Boolean = False
            Try
                If DoesServerExist And gInitialized And (KeepAliveTimeStamp < Now.AddSeconds(-5)) Then
                    KeepAliveTimeStamp = Now
                    If Not myPrimaryServerConnection Is Nothing Then
                        If myPrimaryServerConnection.theNetworkConnecton.thisClient Is Nothing Then
                            disConnected = True
                        ElseIf myPrimaryServerConnection.theNetworkConnecton.thisClient.Connected = False Then
                            disConnected = True
                        ElseIf myPrimaryServerConnection.theNetworkConnecton.thisClient.Connected = True Then
                            disConnected = False
                        End If
                    End If
                    If disConnected Then
                        BOSEventLog("IsDisConnected:DisConnected")
                        If Not mySecondaryServerConnection Is Nothing Then
                            If mySecondaryServerConnection.theNetworkConnecton.thisClient Is Nothing Then
                                disConnected = True
                            ElseIf mySecondaryServerConnection.theNetworkConnecton.thisClient.Connected = False Then
                                disConnected = True
                            ElseIf mySecondaryServerConnection.theNetworkConnecton.thisClient.Connected = True Then
                                disConnected = False
                            End If
                        End If
                    End If
                End If
                Return disConnected
            Catch ex As Exception
                GetErrorDetails(ex)
                Return True
            Finally
                disConnected = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Shut Down Connections
        ''' </summary>
        Public Sub ShutDownConnections()
            Try
                BOSEventLog("ShutDownConnections:Start")
                StopThreads = True
                myPrimaryServer = Nothing
                mySecondaryServer = Nothing
                If Not IsNothing(myPrimaryServerConnection) Then
                    BOSEventLog("ShutDownConnections:myPrimaryServerConnection")
                    Try
                        myPrimaryServerConnection.Dispose()
                        myPrimaryServerConnection.theMonitorConnectionThread.Abort()
                    Catch ex As Exception
                    End Try
                    myPrimaryServerConnection.theMonitorConnectionThread = Nothing
                    myPrimaryServerConnection.theNetworkConnecton.CloseClientConnection()
                    myPrimaryServerConnection.theNetworkConnecton = Nothing
                End If
                If Not IsNothing(mySecondaryServerConnection) Then
                    BOSEventLog("ShutDownConnections:mySecondaryServerConnection")
                    Try
                        mySecondaryServerConnection.Dispose()
                        mySecondaryServerConnection.theMonitorConnectionThread.Abort()
                    Catch ex As Exception
                    End Try
                    mySecondaryServerConnection.theMonitorConnectionThread = Nothing
                    mySecondaryServerConnection.theNetworkConnecton.CloseClientConnection()
                    mySecondaryServerConnection.theNetworkConnecton = Nothing
                End If
                Threading.Thread.Sleep(250)
                myPrimaryServerConnection = Nothing
                mySecondaryServerConnection = Nothing
                myRcvQueueCheckThread = Nothing
                myXmtQueueCheckThread = Nothing
                BOSEventLog("ShutDownConnections:End")
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

#Region "COMMUNICATION INTERFACE"

        ''' <summary>
        ''' Send messages
        ''' </summary>
        Private Sub SendMessages()
            Try
                Do
                    If StopThreads Then
                        BOSEventLog("SendMessages:StopThreads=True")
                        Exit Sub
                    End If
                    SendMessage()
                    Threading.Thread.Sleep(250)
                Loop
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        ''' <summary>
        ''' Send message to BOS
        ''' </summary>
        Private Sub SendMessage()
            Dim message As String
            Dim messageSent As Boolean
            Try
                SyncLock myTransmitQueue
                    While myTransmitQueue.Count > 0
                        message = myTransmitQueue.Peek
                        If message Is Nothing Then
                            message = myTransmitQueue.Dequeue
                            BOSEventLog("SendMessage:Message is nothing")
                            Exit Sub
                        End If
                        BOSEventLog("SendMessage:Message=" & message)
                        If Not myPrimaryServerConnection Is Nothing Then
                            If Not myPrimaryServerConnection.theNetworkConnecton Is Nothing Then
                                If myPrimaryServerConnection.theNetworkConnecton.SendData(message & Chr(4)) Then
                                    messageSent = True
                                End If
                            End If
                        End If
                        If Not mySecondaryServerConnection Is Nothing Then
                            If Not mySecondaryServerConnection.theNetworkConnecton Is Nothing Then
                                If mySecondaryServerConnection.theNetworkConnecton.SendData(message & Chr(4)) Then
                                    messageSent = True
                                End If
                            End If
                        End If
                        If messageSent Then
                            message = myTransmitQueue.Dequeue
                            message = ""
                            messageSent = False
                        Else
                            If myTransmitQueue.Count > 25 Then
                                myTransmitQueue.Clear()
                            End If
                            Exit Sub
                        End If
                    End While
                End SyncLock
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                message = Nothing
                messageSent = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Retrive messages
        ''' </summary>
        Private Sub RetrieveMessages()
            Try
                Do
                    If StopThreads Then
                        BOSEventLog("RetrieveMessages:StopThreads=True")
                        Exit Sub
                    End If
                    RetrieveMessage()
                    Threading.Thread.Sleep(250)
                Loop
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        ''' <summary>
        ''' Retrieve Message
        ''' </summary>
        Private Sub RetrieveMessage()
            Dim message As String
            Dim loopControl As Integer
            Dim tempQueue As Queue = Nothing
            Try
                If Not gInitialized Then
                    SyncLock myReceiveQueue
                        myReceiveQueue.Clear()
                    End SyncLock
                    BOSEventLog("RetrieveMessage:gInitialized=False")
                    Exit Sub
                End If
                SyncLock myReceiveQueue
                    If myReceiveQueue.Count > 0 Then
                        tempQueue = myReceiveQueue.Clone
                        myReceiveQueue.Clear()
                    End If
                End SyncLock
                If Not IsNothing(tempQueue) Then
                    While tempQueue.Count > 0
                        message = tempQueue.Dequeue
                        ProcessMessage(message)
                        loopControl = loopControl + 1
                        If loopControl > 100 Then
                            Exit Sub
                        End If
                    End While
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                message = Nothing
                loopControl = Nothing
                tempQueue = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' BOS event log
        ''' </summary>
        ''' <param name="message">message to write in log</param>
        Private Sub BOSEventLog(message As String)
            Try
                SystemEvent($"{NameOf(BackOfficeServerInstance)} {message}")
            Catch ex As Exception
                SystemException(ex.Message)
            End Try
        End Sub

        ''' <summary>
        ''' Process Message
        ''' </summary>
        ''' <param name="messageToProcess"></param>
        Private Sub ProcessMessage(messageToProcess As String)
            Try
                Dim messages() As String = messageToProcess.Split(Chr(4))
                Dim dataString() As String
                Dim messageType As String
                Dim tmpMessageTYPE As String
                Dim message As String
                Dim messageSubType As String
                For Each mess As String In messages
                    'Checks if exist ACK-COMM text with SOH or EOT
                    If mess.IndexOf("ACK-COMM;") >= 0 AndAlso (mess.IndexOf(Chr(1)) >= 0 Or mess.IndexOf(Chr(4)) >= 0) Then
                        BOSEventLog($"ProcessMessage:Bad message={mess}")
                        'Checks each char
                        For index As Integer = 0 To mess.Length - 1
                            'Checks if before of SOH exist an EOT
                            If index > 0 AndAlso (mess(index) = Chr(1) And mess(index - 1) <> Chr(4)) Then
                                'Acknowledgementtime alerts
                                If myPrimaryServerConnection IsNot Nothing Then
                                    myPrimaryServerConnection.theAcknowledgementTime = Now
                                End If
                                If mySecondaryServerConnection IsNot Nothing Then
                                    mySecondaryServerConnection.theAcknowledgementTime = Now
                                End If
                                'Create new message without ack-comm
                                mess = mess.Substring(index, mess.Length - index - 1)
                                BOSEventLog($"ProcessMessage:AckMessage={mess}")
                                Exit For
                            End If
                        Next
                    End If
                    mess = mess.Replace(Chr(1), "")
                    mess = mess.Replace(Chr(4), "")
                    dataString = mess.Split(";")
                    If dataString.Length > 0 Then
                        Select Case dataString(0)
                            Case "DISCONNECT"
                                BOSEventLog($"ProcessMessage:DisconnectMessage={mess}")
                                If myPrimaryServerConnection IsNot Nothing Then
                                    myPrimaryServerConnection.theNetworkConnecton.CloseClientConnection()
                                End If
                                If mySecondaryServerConnection IsNot Nothing Then
                                    mySecondaryServerConnection.theNetworkConnecton.CloseClientConnection()
                                End If
                            Case "VETMS"
                                BOSEventLog($"ProcessMessage:VetmsMessage={mess}")
                                messageType = dataString(1)
                                Select Case messageType
                                    Case "LOCOMOTIVE REPORT"
                                        TMDS.ManagementClasses.MobileMessages.ProcessLocomotiveMessage(messageToProcess)
                                        TMDS.ManagementClasses.MobileMessages.ProcessLocomotiveReport(dataString(2))
                                    Case "DELIVERYCONFIRMATION"
                                        TMDS.ManagementClasses.PTCMessages.ProcessDeliveryConfirmationVETMS(dataString(2), dataString(3))
                                        If gEnableIgnoreCrewACKForMandatoryDirectives Then
                                            tmpMessageTYPE = ""
                                            Select Case dataString(2)
                                                Case "MA-1051-TWC" 'TWC CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                                                    tmpMessageTYPE = "MA-2061-TWC-CREATED"
                                                Case "MA-1053-TWC" 'TWC RELEASE MESSAGE - TMC CONFIRMATION RESPONSE
                                                    tmpMessageTYPE = "MA-2061-TWC-VOIDED"
                                                Case "MA-1051-TWC-ROLLUP" 'TWC ROLLUP MESSAGE - TMC CONFIRMATION RESPONSE
                                                    tmpMessageTYPE = "MA-2061-TWC-ROLLUP"
                                                Case "MA-1051-TNT" 'TNT CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                                                    tmpMessageTYPE = "MA-2061-TNT-CREATED"
                                                Case "MA-1051-TNT-UPDATE"
                                                Case "MA-1053-TNT" 'TNT RELEASE MESSAGE - TMC CONFIRMATION RESPONSE
                                                    tmpMessageTYPE = "MA-2061-TNT-VOIDED"
                                                Case "MA-1051-EMT" 'EMT CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                                                    tmpMessageTYPE = "MA-2061-EMT-CREATED"
                                                Case "MA-1051-PSS" 'PSS CREATE MESSAGE - TMC CONFIRMATION RESPONSE
                                                    tmpMessageTYPE = "MA-2061-PSS-CREATED"
                                                Case "MA-1053-EMT" 'EMT RELEASE MESSAGE - TMC CONFIRMATION RESPONSE
                                                    tmpMessageTYPE = "MA-2061-EMT-VOIDED"
                                            End Select
                                            If tmpMessageTYPE IsNot Nothing AndAlso tmpMessageTYPE.Trim <> "" Then
                                                TMDS.ManagementClasses.PTCMessages.ProcessDeliveryConfirmationVETMS(tmpMessageTYPE, dataString(3))
                                            End If
                                        End If
                                    Case "INFORMATION"
                                        TMDS.ManagementClasses.PTCMessages.ProcessInformationalVETMS(dataString(2), dataString(3))
                                    Case "WORKTASK"
                                        message = messageToProcess.Replace(Chr(4), "")
                                        messageSubType = dataString(2)
                                        Select Case messageSubType
                                            Case "IETMS-CONSIST-CHANGE"
                                                TMDS.ManagementClasses.PTCMessages.ProcessWorkTaskForConsistVETMS(message)
                                            Case "IETMS-AUTHORITY-ISSUANCE-REQUEST", "IETMS-AUTHORITY-EXTENSION-REQUEST", "IETMS-AUTHORITY-ROLLUP-REQUEST", "IETMS-AUTHORITY-RELEASE-REQUEST"
                                                TMDS.ManagementClasses.PTCMessages.ProcessWorkTaskForCrewRequestVETMS(message)
                                        End Select
                                    Case "TRAIN-TEXT-MESSAGE"
                                        Using interjourney As New Interjourney
                                            If interjourney.IsInterjourneyMessage(messageToProcess) Then
                                                interjourney.ProcessTextMessageFromBOSInterjourney(messageToProcess)
                                            Else
                                                PTCMessages.ProcessTextMessageAlert(messageToProcess)
                                            End If
                                        End Using
                                End Select
                            Case "ACK-COMM"
                                ProcessAckMessage(dataString(1))
                            Case Else
                                If Not mess.Equals(String.Empty) Then
                                    BOSEventLog($"MESSAGE RCVD:UNKNOW:{mess}")
                                End If
                        End Select
                    End If
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        ''' <summary>
        ''' Process Ack Message
        ''' </summary>
        ''' <param name="pMessage"></param>
        Private Sub ProcessAckMessage(ByVal pMessage As String)
            Try
                If pMessage = myPrimaryServerConnection.theServer.Name Then
                    myPrimaryServerConnection.theAcknowledgementTime = Now
                ElseIf Not IsNothing(mySecondaryServerConnection) Then
                    If pMessage = mySecondaryServerConnection.theServer.Name Then
                        mySecondaryServerConnection.theAcknowledgementTime = Now
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

#End Region

    End Class
#End Region

#Region "PITCH AND CATCH COMMANDS"

    Public Class SystemCommands

        Public Shared Sub ProcessRequestControl(ByVal messageToProcess As String)
            Try
                SystemEvent("ProcessRequestControl" & messageToProcess)

                Dim data() As String = messageToProcess.Split(";")

                Dim TypeOfRequest As String = data(1)
                Select Case TypeOfRequest
                    Case "CONTROLPOINT"
                        Dim CPName As String = data(2)
                        Dim CPGUID As Int32 = CInt(data(3))
                        Dim Workstation As String = data(4)
                        Dim UserName As String = data(5)
                        Dim cp As ControlPoint = TMDS.SystemUtilities.FetchData.FindControlPoint(CPGUID)
                        If Not IsNothing(cp) AndAlso cp.IsControlled Then
                            Dim Message As String = UserName & "|REQUESTING CONTROL OF|" & CPName & "|FROM WORKSTATION|" & Workstation
                            TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.RequestControlOfControlPoint, Message, Nothing, Nothing, Nothing, Nothing,
                                                                              Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, cp)
                        End If

                End Select

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Public Shared Sub ProcessAllowControl(ByVal messageToProcess As String)
            Try
                SystemEvent("ProcessAllowControl" & messageToProcess)

                Dim data() As String = messageToProcess.Split(";")

                Dim TypeOfRequest As String = data(1)
                Select Case TypeOfRequest
                    Case "CONTROLPOINT"
                        Dim CPName As String = data(2)
                        Dim CPGUID As Int32 = CInt(data(3))
                        Dim Workstation As String = data(4)
                        Dim UserName As String = data(5)
                        Dim cp As ControlPoint = TMDS.SystemUtilities.FetchData.FindControlPoint(CPGUID)
                        If Not IsNothing(cp) AndAlso Not cp.IsControlled AndAlso Workstation = gThisWorkstation.Name Then
                            If Not cp.IsControlled AndAlso cp.IsShadowMode Then
                                cp.DoAllowControl()
                            End If
                        End If
                End Select
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

    End Class
#End Region

End Namespace