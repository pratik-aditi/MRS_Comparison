        Public Function GetNextBulletinNumber(ByRef BulletinCollection As ArrayList, ByVal BulletinType As String) As String
            Try
                Dim bull As Bulletin
                Dim Unique As Boolean = False
                Dim ContinueUniqueSearch As Boolean = False
                Dim BullNumber As Int32
                Dim BullRange As Int32
                Dim BullFactor As Int32
                Dim BullTableName As String = String.Empty
                Dim counter As Integer
                Dim NextBulletinNumber As String = String.Empty

                Select Case BulletinType
                    Case "FORMA"
                        BullNumber = BullANumber
                        BullRange = BullARange
                        BullTableName = "NumberFormA"
                        BullFactor = BullAFactor
                    Case "FORMB"
                        BullNumber = BullBNumber
                        BullRange = BullBRange
                        BullTableName = "NumberFormB"
                        BullFactor = BullBFactor
                    Case "FORMC"
                        BullNumber = BullCNumber
                        BullRange = BullCRange
                        BullTableName = "NumberFormC"
                        BullFactor = BullCFactor
                    Case "FORMTC"
                        BullNumber = BullTCNumber
                        BullRange = BullTCRange
                        BullTableName = "NumberFormTC"
                        BullFactor = BullTCFactor
                    Case "FORMR"
                        BullNumber = BullCNumber
                        BullRange = BullCRange
                        BullTableName = "NumberFormC"
                        BullFactor = BullCFactor
                    Case "GTB"
                        BullNumber = GTBNumber
                        BullRange = GTBRange
                        BullTableName = "NumberGTB"
                        BullFactor = GTBFactor


                End Select

                While Not Unique
                    If BullNumber >= BullRange + BullFactor Then
                        BullNumber = BullRange
                    Else
                        BullNumber = BullNumber + 1
                    End If


                    For Each bull In BulletinCollection
                        If bull.BullNumber = BullNumber Then
                            ContinueUniqueSearch = True
                            counter = 0
                            Exit For
                        End If
                        counter = counter + 1
                        If counter = BulletinCollection.Count Then
                            ContinueUniqueSearch = False
                        End If
                    Next

                    If Not ContinueUniqueSearch Then
                        Unique = True
                        NextBulletinNumber = BullNumber
                        UpdateBulletinNumber(TMDS.GlobalDeclarations.gDatabaseConnectionStatic, BullTableName, BullNumber)
                        Select Case BulletinType
                            Case "FORMA"
                                BullANumber = BullNumber
                            Case "FORMB"
                                BullBNumber = BullNumber
                            Case "FORMC"
                                BullCNumber = BullNumber
                            Case "FORMTC"
                                BullTCNumber = BullNumber
                            Case "GTB"
                                GTBNumber = BullNumber

                        End Select

                    End If

                End While
                Return NextBulletinNumber
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function GetNextGTBNumber(ByRef GTBCollection As ArrayList) As String
            Dim VoidedGTBNumbers As New ArrayList
            Dim ActiveGTBNumbers As New ArrayList
            Try
                Dim GTB As GeneralTrackBulletin
                Dim Unique As Boolean = False
                Dim ContinueUniqueSearch As Boolean = False
                Dim BullNumber As Int32
                Dim BullRange As Int32
                Dim BullTableName As String
                Dim LoopControl As Integer
                BullNumber = GTBNumber
                BullRange = GTBRange
                BullTableName = "NumberGTB"

                While Not Unique
                    If BullNumber >= BullRange + Me.GTBFactor Then
                        BullNumber = BullRange
                    Else
                        BullNumber = BullNumber + 1
                    End If
                    For Each GTB In GTBCollection
                        If GTB.GTBnumber = BullNumber Then
                            ContinueUniqueSearch = True
                            Exit For
                        End If
                        ContinueUniqueSearch = False
                    Next

                    If optEnableMRLSpecificOptions AndAlso Not ContinueUniqueSearch AndAlso CheckIfGTBNoExisitsInDB(BullNumber) Then
                        ContinueUniqueSearch = True
                    End If


                    'Me.mySubdivision.Name
                    If Not ContinueUniqueSearch Then
                        Unique = True
                        GetNextGTBNumber = BullNumber
                        UpdateBulletinNumber(TMDS.GlobalDeclarations.gDatabaseConnectionStatic, BullTableName, BullNumber)
                        GTBNumber = BullNumber
                    End If
                    LoopControl += 1
                    If LoopControl > BullRange Then
                        Return Nothing
                    End If
                End While
                Return GTBNumber
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function GetLastActiveGTBNumber(ByVal SubName As String) As Integer
            Dim ActiveSQLQuery As New StringBuilder ' = "SELECT GTBNumber FROM [tblGeneralBulletinsActive] WHERE [AtSubdivision]='" & SubName & "' ORDER BY GTBDate DESC"

            With ActiveSQLQuery
                .Append("SELECT GTBNumber FROM [tblGeneralBulletinsActive] WHERE [AtSubdivision]='" & SubName & "'")
                .Append(" AND CAST(CONVERT(CHAR(10), GTBDate,101)AS DATETIME) >= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                .Append(" AND CAST(CONVERT(CHAR(10), GTBDate,101)AS DATETIME) <= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                .Append("ORDER BY GTBDate DESC")
            End With

            Dim ds As New DataSet
            Dim CurrentNumber As Integer = 0
            Dim drow As DataRow
            Try
                ds = GetResultDS(ActiveSQLQuery.ToString, False)
                If IsValidDataset(ds) Then
                    drow = ds.Tables(0).Rows(0)
                    Integer.TryParse(drow(0), CurrentNumber)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                Return 0
            End Try
            Return CurrentNumber

        End Function

