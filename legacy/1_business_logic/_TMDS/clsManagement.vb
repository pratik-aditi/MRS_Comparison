        Sub LogDispatcherEvent(ByVal EventType As String, ByRef territoryCollection As ArrayList)

            Dim SQLFields As String
            Dim SQLValues As String
            Dim s As String = ","
            Dim q As String = "'"
            Dim TerritoryString As String = String.Empty
            Dim terr As Territory
            Dim UID As String = System.Guid.NewGuid.ToString.ToUpper

            If LastName Is Nothing Or FirstName Is Nothing Then
                Exit Sub
            End If
            Dim dbconn As OleDb.OleDbConnection = Nothing
            Dim CommandInsert As OleDbCommand = Nothing

            TMDS.NetworkMessages.CadMessages.SendDispatcherEventForWabtecOne(territoryCollection, EventType)

            Try

                If LastName.Trim <> String.Empty Or FirstName.Trim <> String.Empty Or Initials.Trim <> String.Empty Then
                    dbconn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)

                    For Each terr In territoryCollection
                        TerritoryString = "(" & TerritoryString & terr.TerritoryID & "|" & terr.TerritoryName & ");"
                    Next

                    SQLFields = "(DispatcherName, Event, EventTime, TerritoryID, WorkstationID, UID"
                    SQLFields = SQLFields & ")"

                    SQLValues = " VALUES ("
                    SQLValues = SQLValues & q & LastName & "|" & FirstName & "|" & Initials & q
                    SQLValues = SQLValues & s & q & EventType & q & s & q & Now & q & s & q & TerritoryString & q & s & q & gThisWorkstation.WrkStnNumber.ToString & q & s & q & UID & q
                    SQLValues = SQLValues & ")"

                    Dim CommandString As String = "INSERT INTO " & gtblDispEvents & SQLFields & SQLValues

                    CommandInsert = New OleDbCommand(CommandString, dbconn)
                    If CommandInsert.Connection.State <> ConnectionState.Open Then
                        CommandInsert.Connection.Open()
                    End If
                    CommandInsert.ExecuteNonQuery()
                    'dbconn.Close()
                    'CommandInsert.Dispose()
                    'CommandInsert = Nothing
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                'dbconn = Nothing
            Finally
                If Not dbconn Is Nothing Then
                    If dbconn.State = ConnectionState.Open Then dbconn.Close()
                    dbconn.Dispose()
                    dbconn = Nothing
                End If

                If Not CommandInsert Is Nothing Then
                    CommandInsert.Dispose()
                    CommandInsert = Nothing
                End If
            End Try

        End Sub

        Public Sub UserLoginUpdate(ByVal LogOff As Boolean)
            Dim UpdateString As String
            Dim s As String = ","
            Dim q As String = "'"
            Dim LogEvent As String
            Dim WorkStationNumber As String
            Dim dbConn As OleDb.OleDbConnection = Nothing
            Dim CommandInsert As OleDbCommand = Nothing

            Try
                If LogOff Then
                    LogEvent = "LastLogOffTime"
                    WorkStationNumber = "NOTHING"
                Else
                    LogEvent = "LogOnTime"
                    WorkStationNumber = gThisWorkstation.WrkStnNumber.ToString
                End If
                UpdateString = "UPDATE " & gtblUsers
                UpdateString = UpdateString & " SET " & LogEvent & " = " & q & Now & q & s
                UpdateString = UpdateString & " WorkStationNumber = " & q & WorkStationNumber & q & s
                If LogOff Then
                    UpdateString = UpdateString & " LoggedIn = " & CInt(False)
                Else
                    UpdateString = UpdateString & " LoggedIn = " & CInt(True)
                End If


                UpdateString = UpdateString & " WHERE PIN = " & q & Me.PIN & q
                dbConn = New OleDb.OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                CommandInsert = New OleDbCommand(UpdateString, dbConn)
                CommandInsert.Connection.Open()
                CommandInsert.ExecuteNonQuery()
                'dbConn.Close()
                'CommandInsert.Dispose()
                'CommandInsert = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If Not dbConn Is Nothing Then
                    If dbConn.State = ConnectionState.Open Then dbConn.Close()
                    dbConn.Dispose()
                    dbConn = Nothing
                End If

                If Not CommandInsert Is Nothing Then
                    CommandInsert.Dispose()
                    CommandInsert = Nothing
                End If
            End Try

        End Sub

    End Class

