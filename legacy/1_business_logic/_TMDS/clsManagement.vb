        ''' <summary>
        ''' Loads and assigns territory configuration data from the database, validating lock ownership when applicable.
        ''' </summary>
        ''' <param name="dbConnection">
        ''' Database connection reference; the method establishes and manages its own connection internally.
        ''' </param>
        ''' <param name="overrideLock">
        ''' Optional; default is <see langword="False"/>. <see langword="True"/> forces the territory to be treated as unlocked,
        ''' bypassing user and workstation ownership checks.
        ''' </param>
        ''' <returns>
        ''' <see cref="Boolean"/>: <see langword="True"/> indicates territory information was loaded and the territory is usable;
        ''' <see langword="False"/> indicates the territory is locked by another user/workstation or an exception occurred.
        ''' </returns>
        ''' <exception cref="Exception">
        ''' Handled internally via <see cref="SystemException(String)"/>; the method returns <see langword="False"/>.
        ''' </exception>
        Public Function AssignTerritoryInformation(ByRef dbConnection As OleDbConnection,
                                                   Optional overrideLock As Boolean = False) As Boolean
            Try
                Dim query As String = $"SELECT * FROM tblTerritoryList WHERE Name = '{TerritoryName}'"
                Dim currentUser As String = String.Empty
