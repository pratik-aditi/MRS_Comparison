        Private Shared Function FindLocomotive(ByVal LocoUID As String) As MobileTracking.Locomotive

            Try
                Dim loco As MobileTracking.Locomotive = Nothing
                Dim LocExists As Boolean
                Dim LocFound As MobileTracking.Locomotive = Nothing
                For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                    If loco.LocomotiveID = LocoUID Then
                        LocFound = loco
                        LocExists = True
                        Exit For
                    End If
                Next

                If Not LocExists Then
                    Dim NewLocomotive As MobileTracking.Locomotive
                    If Not gMobileServerExists Then
                        NewLocomotive = New MobileTracking.Locomotive _
                        (TMDS.GlobalDeclarations.gLocomotiveCollection,
                         TMDS.GlobalDeclarations.SystemEventQueue,
                        TMDS.GlobalDeclarations.gCadTransmitQueue,
                        TMDS.GlobalDeclarations.gThisWorkstation, Nothing)
                    Else
                        NewLocomotive = New MobileTracking.Locomotive _
                        (TMDS.GlobalDeclarations.gLocomotiveCollection,
                         TMDS.GlobalDeclarations.SystemEventQueue,
                        TMDS.GlobalDeclarations.gMGPSTransmitQueue,
                        TMDS.GlobalDeclarations.gThisWorkstation, Nothing)
                    End If
                    NewLocomotive.LocomotiveID = LocoUID
                    SyncLock TMDS.GlobalDeclarations.gLocomotiveCollection
                        TMDS.GlobalDeclarations.gLocomotiveCollection.Add(NewLocomotive)
                    End SyncLock
                    LocFound = NewLocomotive
                End If

                Return LocFound

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try

        End Function

        Private Shared Function FindLocomotive(ByVal LocoUID As String, ByVal TrainSymbol As String) As MobileTracking.Locomotive

            Try
                Dim loco As MobileTracking.Locomotive = Nothing
                Dim LocExists As Boolean
                Dim LocFound As MobileTracking.Locomotive = Nothing
                If Not IsNothing(TMDS.GlobalDeclarations.gLocomotiveCollection) Then
                    If TMDS.GlobalDeclarations.gLocomotiveCollection.Count > 0 Then
                        For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                            If (loco.LocomotiveID = LocoUID) And (loco.Symbol.Trim = TrainSymbol.Trim) Then
                                LocFound = loco
                                LocExists = True
                                Exit For
                            End If
                        Next
                    End If
                End If

                If Not LocExists Then
                    'SystemEvent(" TEST LOG - LOCO NOT FOUND AND CREATED ")
                    Dim NewLocomotive As MobileTracking.Locomotive
                    If Not gMobileServerExists Then
                        NewLocomotive = New MobileTracking.Locomotive _
                        (TMDS.GlobalDeclarations.gLocomotiveCollection,
                         TMDS.GlobalDeclarations.SystemEventQueue,
                        TMDS.GlobalDeclarations.gCadTransmitQueue,
                        TMDS.GlobalDeclarations.gThisWorkstation, Nothing)
                    Else
                        NewLocomotive = New MobileTracking.Locomotive _
                        (TMDS.GlobalDeclarations.gLocomotiveCollection,
                         TMDS.GlobalDeclarations.SystemEventQueue,
                        TMDS.GlobalDeclarations.gMGPSTransmitQueue,
                        TMDS.GlobalDeclarations.gThisWorkstation, Nothing)
                    End If
                    NewLocomotive.LocomotiveID = LocoUID
                    SyncLock TMDS.GlobalDeclarations.gLocomotiveCollection
                        TMDS.GlobalDeclarations.gLocomotiveCollection.Add(NewLocomotive)
                    End SyncLock
                    LocFound = NewLocomotive
                End If

                Return LocFound

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try

        End Function

        Private Shared Sub PositionTrain(ByVal trk As Track, ByVal Name As String)
            Try
                LogEvent("PositionTrain:" & Name & "TRK:" & trk.GUID)
                Dim trnCheck As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(Name)
                If IsNothing(trk) Then
                    LogEvent("PositionTrain-Track Not Found for Train:" & Name)
                    Exit Sub
                End If
                If Not IsNothing(trnCheck) Then
                    trk.MoveTrainIDPlaceManual(trnCheck, trnCheck.myTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                    trnCheck.ClearOsReports()
                    Exit Sub
                End If
                If Not trk Is Nothing Then
                    Dim trn As TrainID = trk.RetrieveTrainID(Name)
                    If IsNothing(trn) Then Exit Sub
                    trn.ApplyTrainAbbreviation(gTrainAbbreviation)
                    trk.AddTrainID(trn)
                    If Not trk.Indicating Or gSimulationMode Then
                        trk.Occuppied = True
                        trk.UpdateStatus()
                    End If
                    Dim SummItem As New SummaryItem("TRAIN", "POSITION", trn)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                    End SyncLock

                Else
                    LogEvent("PositionTrain-TRACK NOT FOUND:" & trk.GUID)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub RemovePTCStatusFromAuthorities(ByVal LOCO As MobileTracking.Locomotive)

            Dim TATList As New ArrayList
            Dim SFAList As New ArrayList
            Dim SPLList As New ArrayList
            Dim TAT As TrackAuthority.TrackAuthority = Nothing
            Dim SFAAuth As TrackAuthority.SFAuthority = Nothing
            Dim OthSplAuth As TrackAuthority.OtherSpecialAuthorityType = Nothing
            Dim PTCStatus As String = "NONE"

            Try
                TATList = TMDS.SystemUtilities.FetchData.FindALLTATBelongsToLocomotive(LOCO.Symbol)
                SFAList = TMDS.SystemUtilities.FetchData.FindALLSFABelongsToLocomotive(LOCO.Symbol)
                SPLList = TMDS.SystemUtilities.FetchData.FindALLSPLAuthBelongsToLocomotive(LOCO.Symbol)

                Try
                    If Not TATList Is Nothing AndAlso TATList.Count > 0 Then
                        For Each TAT In TATList
                            If Not TAT Is Nothing Then
                                'If TAT.IssueTo = LOCO.LocomotiveID Then
                                TAT.PTCStatus = PTCStatus
                                TAT.PTCTypeAuthority = False
                                TAT.UpdateDatabaseWithPTCAuthorityStatus(PTCStatus)
                                Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC-STATUS", TAT)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock
                                'End If
                            End If
                        Next
                    End If
                Catch ex As Exception
                    GetErrorDetails(ex)
                End Try

                Try
                    If Not SFAList Is Nothing AndAlso SFAList.Count > 0 Then
                        For Each SFAAuth In SFAList
                            If Not SFAAuth Is Nothing Then
                                If SFAAuth.IssueTo = LOCO.LocomotiveID Then
                                    SFAAuth.PTCStatus = PTCStatus
                                    SFAAuth.PTCTypeAuthority = False
                                    SFAAuth.UpdateDatabaseWithPTCAuthorityStatus(PTCStatus)
                                    Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC-STATUS", SFAAuth)
                                    SyncLock gSummaryAuthQueue.SyncRoot
                                        gSummaryAuthQueue.Enqueue(SummItem)
                                    End SyncLock
                                End If
                            End If
                        Next
                    End If
                Catch ex As Exception
                    GetErrorDetails(ex)
                End Try

                Try
                    If Not SPLList Is Nothing AndAlso SPLList.Count > 0 Then
                        For Each OthSplAuth In SPLList
                            If Not OthSplAuth Is Nothing Then
                                ' If OthSplAuth.IssueTo = LOCO.LocomotiveID Then
                                OthSplAuth.PTCStatus = "NONE" 'PTCStatus
                                OthSplAuth.PTCTypeAuthority = False
                                OthSplAuth.UpdateDatabaseWithPTCAuthorityStatus("NONE")
                                Dim SummItem As New SummaryItem("AUTHORITY", "UPDATE-PTC-STATUS", OthSplAuth)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock
                                'End If
                            End If
                        Next
                    End If
                Catch ex As Exception
                    GetErrorDetails(ex)
                End Try


            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                TATList = Nothing
                SFAList = Nothing
                SPLList = Nothing
            End Try
        End Sub

        Private Shared Sub GetTrackNameFromDB(ByVal TrkGUID As Integer, ByRef TrackName As String)
            Dim dsTrk As New DataSet
            Try

                Dim SQLQuery As String = " SELECT TrkName FROM tblCompTracks WHERE UID=" & TrkGUID
                dsTrk = GetResultDS(SQLQuery, True)
                If IsValidDataset(dsTrk) Then
                    TrackName = dsTrk.Tables(0).Rows(0)("TrkName")
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                dsTrk = Nothing
            End Try

        End Sub

