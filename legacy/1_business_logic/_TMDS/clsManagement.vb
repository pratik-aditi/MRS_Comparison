        Public Sub GetMilePostMarkers()
            Try
                Dim stat As SubdivisionStation
                Dim Descending As Boolean
                Dim Ascending As Boolean
                Dim TempList As ArrayList = Me.Stations.Clone
                For Each stat In TempList
                    If Not TempList.IndexOf(stat) >= (TempList.Count - 1) Then
                        Dim MP1 As Single = CSng(stat.MilePost)
                        Dim Stat2 As SubdivisionStation = TempList.Item(TempList.IndexOf(stat) + 1)
                        Dim MP2 As Single = CSng(Stat2.MilePost)
                        If MP1 > MP2 And Not stat.MilePostChangeEvent Then
                            Dim MP1array() As String = MP1.ToString.Split(".")
                            Dim MP2array() As String = MP2.ToString.Split(".")
                            Dim MP1str As String = MP1array(0)
                            Dim MP2str As String = MP2array(0)
                            Dim MPint1 As Integer = CInt(MP1str)
                            Dim MPint2 As Integer = CInt(MP2str) + 1
                            Dim mpDiff As Integer = MPint1 - MPint2
                            Dim i As Integer
                            If Not Ascending Then
                                If Not Stat2.MilePostChangeEvent Then
                                    If Not stat.MilePostChangeEvent Then
                                        For i = 1 To mpDiff
                                            Dim newSt As New SubdivisionStation()
                                            newSt.MilePostMarker = True
                                            newSt.MilePost = MPint1 - i
                                            newSt.TrackType = stat.TrackType
                                            newSt.Name = optMilePostAbbreviation & newSt.MilePost
                                            Me.Stations.Insert(Stations.IndexOf(stat) + i, newSt)
                                            newSt.MilePostSuffix = stat.MilePostSuffix
                                            Descending = True
                                        Next
                                    End If
                                End If
                            Else
                                Ascending = False
                                'DO NOTHING
                            End If

                        Else
                            Dim MP1array() As String = MP1.ToString.Split(".")
                            Dim MP2array() As String = MP2.ToString.Split(".")
                            Dim MP1str As String = MP1array(0)
                            Dim MP2str As String = MP2array(0)
                            Dim MPint1 As Integer = CInt(MP1str)
                            Dim MPint2 As Integer = CInt(MP2str) - 1
                            Dim mpDiff As Integer = MPint2 - MPint1
                            Dim i As Integer
                            If Not Descending Then
                                If Not Stat2.MilePostChangeEvent Then
                                    If Not stat.MilePostChangeEvent Then
                                        For i = 1 To mpDiff
                                            Dim newSt As New SubdivisionStation()
                                            newSt.MilePostMarker = True
                                            newSt.MilePost = MPint1 + i
                                            newSt.TrackType = stat.TrackType
                                            newSt.Name = optMilePostAbbreviation & Stat2.MilePostPrefix & newSt.MilePost & Stat2.MilePostSuffix
                                            Me.Stations.Insert(Stations.IndexOf(stat) + i, newSt)
                                            newSt.MilePostSuffix = stat.MilePostSuffix
                                            Ascending = True
                                        Next
                                    End If
                                End If
                            Else
                                Stat2.AscendsionChange = True
                                Descending = False
                                'DO NOTHING
                            End If
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub GetControlPointGeoOrdering()
            Try
                Dim ss As SubdivisionStation
                For Each ss In Me.Stations
                    Dim cp As ControlPoint = TMDS.SystemUtilities.FetchData.FindControlPoint(ss.ControlPointUID)
                    If Not IsNothing(cp) Then
                        Me.ControlPointList.Add(cp)
                        cp.SubdvnGeoReference = ss.OrderIndex
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

