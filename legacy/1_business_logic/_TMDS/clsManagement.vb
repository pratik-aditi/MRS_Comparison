        Public Shared Sub ProcessLocomotivePositionReport(ByVal messageToProcess As String)
            Try
                SystemEvent("ProcessLocomotivePositionReport:" & messageToProcess)

                Dim trn As TrainID = Nothing
                Dim TrainFound As TrainID = Nothing
                Dim trk As Track = Nothing
                Dim LocoID As String = String.Empty
                Dim Message() As String = messageToProcess.Split(Chr(4))
                Dim data() As String = Message(0).Split(",")
                If data.Length >= 9 Then
                    LocoID = data(0)
                    For Each trn In TMDS.GlobalDeclarations.TrainCollection
                        If trn.IdentifingUnit = LocoID Then
                            TrainFound = trn
                            TrainFound.CommunicationStatus = True
                            Exit For
                        End If
                    Next
                End If
                If IsNothing(TrainFound) Then
                    trk = FindTrackFromBlockID(CInt(data(3)), CDec(data(4)), CInt(data(10)))
                    If Not IsNothing(trk) Then
                        trn = New TrainID()
                        trn.Name = LocoID
                        trn.IdentifingUnit = LocoID
                        trn.CBTCEquipped = True
                        trn.TrainCBTCCutInUpdate()
                        trn.Direction = ""
                        trn.TrackGUID = trk.GUID
                        trn.TypeOfID = "TRAIN"
                        trn.TrainType = "FREIGHT"

                        trn.ApplyTrainAbbreviation(gTrainAbbreviation)
                        trk.TrainIDs.Add(trn)
                        trk.InitTrainDisplay()

                        TrainFound = trn
                        TMDS.GlobalDeclarations.TrainCollection.Add(TrainFound)
                        trn.InsertNewTrainIDIntoDatabase(trk, gtblTrainsActive)
                        trn.CommunicationStatus = True
                        Dim SummItem2 As New SummaryItem("TRAIN", "POSITION", trn)
                        SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                            TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem2)
                        End SyncLock
                    End If

                Else
                    trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(TrainFound.TrackGUID)
                End If

                If Not IsNothing(TrainFound) Then
                    Dim PositionReport As String = BuildLocomotiveReport(Message(0), TrainFound)
                    ProcessLocomotivePosition(PositionReport)
                End If

                Select Case CInt(data(9))
                    Case 5
                        TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.EmergencyAlarmLocomotive, messageToProcess, TrainFound)
                        If Not TrainFound.EmeregencyFlag Then
                            TrainFound.EmeregencyFlag = True
                            TrainFound.EnableEmergencyMessageNotificationFlash(True)
                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(TrainFound.TrackGUID)
                            If Not IsNothing(trk) Then
                                trk.InitTrainDisplay()
                                trk.InvalidateTrainID()
                                trk.CurrentDrawingForm.Refresh()
                            End If
                        End If
                    Case 6
                        TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.DispatchCallLocomotive, messageToProcess, TrainFound)
                    Case 9, 10, 11
                        TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.EnforcementNotification, data(9), TrainFound)
                        If Not TrainFound.BrakingNotificationFlag Then
                            TrainFound.BrakingNotificationFlag = True
                            TrainFound.EnableBrakingEnforcementMessageNotificationFlash(True)
                            trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(TrainFound.TrackGUID)
                            If Not IsNothing(trk) Then
                                trk.InitTrainDisplay()
                                trk.InvalidateTrainID()
                                trk.CurrentDrawingForm.Refresh()
                            End If
                        End If

                End Select


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

