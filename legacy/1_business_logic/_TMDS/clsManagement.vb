        Private Function GetEngineSet() As ArrayList
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim EngineSetCollection As New ArrayList
            Dim SQLQuery As New StringBuilder
            Try
                With SQLQuery
                    .Append("SELECT MessageData,GroupIndex,GroupCount,MessageVersion,MessageEdition  FROM tblSystemQueueReceive ")
                    .Append(" WHERE")
                    .Append(" (MessageUID = 1020) AND (TimeProcessed IS NOT NULL) ")
                    .Append(" AND (MessageVersion='" & Me.MessageVersion.ToString & "' AND MessageEdition='" & Me.MessageEdition & "'  AND EntityUID='" & Me.myTrain.EntityUID & "' ) ")
                    .Append(" ORDER BY GroupIndex")
                End With
                EngineSetCollection = New ArrayList
                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery.ToString, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        'SetNumber|LocoInitial|LocoNumber|Postion|StationUID|Controlling|EHP
                        '1|ARR |4002|2|FAIR|||
                        Dim MessageData As String = String.Empty
                        If Not dr.IsDBNull(0) Then MessageData = dr.GetString(0)
                        If Not String.IsNullOrEmpty(MessageData) AndAlso MessageData.Trim <> String.Empty Then
                            'HALX|1054|95|89|4|0|L|
                            Dim clsEng As clsEngineSet
                            Dim d() As String = MessageData.Split("|")
                            Dim theUnit As String = d(1).PadRight(4, " ") & Space(2) & d(2).PadLeft(4, " ")
                            clsEng = myTrain.GetSystemLocomotiveFromDB(theUnit)
                            If clsEng Is Nothing Then clsEng = New clsEngineSet
                            With clsEng
                                If Not dr.IsDBNull(1) Then .GroupIndex = dr.GetValue(1)
                                If Not dr.IsDBNull(2) Then .GroupCount = dr.GetValue(2)
                                If Not dr.IsDBNull(3) Then .MessageVersion = dr.GetValue(3)
                                If Not dr.IsDBNull(4) Then .MessageEdition = dr.GetValue(4)
                                .LocoInitial = d(1).Trim
                                .LocoNumber = d(2).Trim
                                Integer.TryParse(d(0), .SetNumber)
                                .UnitID = theUnit.Trim
                                Integer.TryParse(d(3), .UnitPosition)
                                .FullDestStation = d(4).Trim
                                If d(5).ToUpper.Trim = "Y" Then .IsleadEngine = True
                                Dim EHP As Integer = 0
                                Integer.TryParse(d(6), EHP)
                                If EHP > 0 Then
                                    .HPEffective = EHP
                                End If
                            End With
                            If Not EngineSetCollection.Contains(clsEng) Then EngineSetCollection.Add(clsEng)
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
                Return EngineSetCollection
            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Function

