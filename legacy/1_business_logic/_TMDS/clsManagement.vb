        Public Sub SendAuthorityStatuses()
            Try
                Dim auth As TrackAuthority.TrackAuthority
                Dim PublishAuthority As Boolean
                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                        Dim comp As Object
                        For Each comp In auth.ComponentsInSelection
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If comp.myControlPoint.AllowStatusPublishing Then
                                    PublishAuthority = True
                                    Exit For
                                End If
                            End If
                        Next
                        If PublishAuthority Then
                            PublishAuthority = False
                            Dim Message As String = "DC" & Chr(6) & "AUTHSTAT;"
                            Message = Message & "|" & Me.TerritoryID.ToString
                            Message = Message & "|ACTION=ADD"
                            Message = Message & "|GUID=" & auth.AuthorityUID
                            Message = Message & "|ISSUED=" & Format(auth.OKTime, "MM-dd-yyyy HH:mm")
                            Dim TrackList As String = String.Empty
                            Dim i As Integer
                            For Each comp In auth.ComponentsInSelection

                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    Dim trk As Track = CType(comp, Track)
                                    If i = 0 Then
                                        TrackList = TrackList & comp.GUID.ToString & "@" & comp.myControlPoint.GUID.ToString & "@" & trk.Name
                                        i = 1
                                    Else
                                        TrackList = TrackList & "-" & comp.GUID.ToString & "@" & comp.myControlPoint.GUID.ToString & "@" & trk.Name
                                    End If
                                End If
                            Next
                            Message = Message & "|TRKLIST=" & TrackList

                            Message = Me.TerritoryID.ToString & Chr(12) & Message

                            SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                                TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                            End SyncLock

                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub SendTrainStatuses()
            Try
                Dim trn As TrainID
                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.myTrack.myControlPoint.AllowStatusPublishing Then
                        Dim Message As String = "DC" & Chr(6) & "TRNSTAT;"
                        Message = Message & "|" & Me.TerritoryID.ToString
                        Message = Message & "|ACTION=ADD"
                        Message = Message & "|NAME=" & trn.Name
                        Message = Message & "|TRACK=" & trn.myTrack.GUID.ToString & "@" & trn.myTrack.myControlPoint.GUID.ToString & "@" & trn.myTrack.Name
                        Message = Message & "|LENGTH=" & trn.OLength.ToString
                        Message = Message & "|TONNAGE=" & trn.OTons.ToString
                        Message = Message & "|LEAD ENGINE ID=" & trn.IdentifingUnit
                        Dim OtherUnits As String = "NONE"
                        Dim u As String
                        Dim i As Integer
                        For Each u In trn.Units
                            If u <> "" Then
                                If i = 0 Then
                                    OtherUnits = u
                                    i = 1
                                Else
                                    OtherUnits = OtherUnits & "-" & u
                                End If
                            End If
                        Next
                        Message = Message & "|OTHER ENGINE IDS=" & OtherUnits
                        Message = Message & "|ENGINEER=" & trn.CrewCurrent.Engineer.NameOfPerson & "#" & trn.CrewCurrent.Engineer.OnDutyTime & "#" & trn.CrewCurrent.Engineer.HOS
                        Message = Message & "|CONDUCTOR=" & trn.CrewCurrent.Conductor.NameOfPerson & "#" & trn.CrewCurrent.Conductor.OnDutyTime & "#" & trn.CrewCurrent.Conductor.HOS
                        Message = Me.TerritoryID.ToString & Chr(12) & Message

                        SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                            TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                        End SyncLock
                    End If
                Next
            Catch ex As Exception
                AddEventToLog(EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            End Try
        End Sub

        Public Sub SendTagStatuses()
            Try
                Dim tg As Tag
                For Each tg In TMDS.GlobalDeclarations.TrackTags
                    If tg.TagType = "SPEED" Or tg.TagType = "INFO" Or tg.TagType = "XING" Then
                        Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(tg.TrackGuid)
                        If Not IsNothing(trk) Then
                            If trk.myControlPoint.AllowStatusPublishing Then
                                Dim Message As String = "DC" & Chr(6) & "TAGSTAT;"
                                Message = Message & "|" & Me.TerritoryID.ToString
                                Message = Message & "|TYPE=" & tg.TagType
                                Message = Message & "|ACTION=ADD"
                                Message = Message & "|GUID=" & tg.TagGuid
                                Message = Message & "|ISSUE=" & Format(tg.CreateTime, "MM-dd-yyyy HH:mm")
                                Message = Message & "|TRKLIST=" & trk.GUID.ToString & "@" & trk.myControlPoint.GUID.ToString & "@" & trk.Name

                                Dim AdditionInformation As String
                                Dim data() As String = tg.DataString.Split("|")
                                Select Case tg.TagType
                                    Case "SPEED"
                                        AdditionInformation = "FRGHT SPEED=" & data(0) & " PASS SPEED=" & data(5) & " ON " & data(3) & " FROM MP " & data(1) & " AND MP " & data(2)

                                    Case "INFO"
                                        AdditionInformation = "TRACK NOTE:" & data(0)
                                    Case "XING"
                                        AdditionInformation = "XING MALFUNNCTION AT " & data(1) & " MP " & data(0)
                                    Case Else
                                        AdditionInformation = "NOTHING NOTED"
                                End Select
                                Message = Message & "|ADDINFO=" & AdditionInformation

                                Message = Me.TerritoryID.ToString & Chr(12) & Message

                                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                                End SyncLock
                            End If
                        End If
                    End If
                Next

            Catch ex As Exception
                AddEventToLog(EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            End Try
        End Sub
