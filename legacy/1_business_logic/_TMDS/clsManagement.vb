            Try
                SystemEvent(MessageToProcess)

                Dim DataString() As String = MessageToProcess.Split(";")
                Dim data() As String = DataString(1).Split("|")
                'Message = "MC:RELAUTHREQ;" & "|"
                '0-CurrentAuthorityItem.TerritoryAssignment.ToString
                '1-CurrentAuthorityItem.AuthGUID 
                '2-CurrentAuthorityItem.AuthorityUID
                '3-CurrentAuthorityItem.MobileClientDSA
                '4-MDS.GlobalDeclarations.gThisWorkstation.Name 
                '5-TMDS.GlobalDeclarations.gCurrentUser.Initials()
                Dim auth As Object 'TrackAuthority.TrackAuthority
                Dim EventMessage As String
                Dim Response As String
                Dim AuthorityReleased As Boolean
                'Dim AuthToRelease As Object 'TrackAuthority.TrackAuthority

                For Each auth In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then

                        If auth.AuthGUID = data(1) Then
                            If auth.MobileClientDSA = data(3) Then

                                'APPLY REPORT CLEAR TIME FIRST
                                Dim CurrentTimeZone As String = String.Empty
                                Dim Comp As Object
                                For Each Comp In auth.ComponentsInSelection
                                    If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        If Comp.TimeZone <> "" Then
                                            CurrentTimeZone = Mid(Comp.TimeZone, 1, 1)
                                            Exit For
                                        End If
                                    End If
                                Next
                                Dim CurrentTime As Date = Now
                                If Format(CurrentTime, "HH:mm") = "00:00" Then
                                    CurrentTime = CurrentTime.AddMinutes(1)
                                End If

                                Select Case CurrentTimeZone
                                    Case "E"
                                        auth.ReportClear = CurrentTime.AddHours(CDbl(1 + gThisWorkstationTimeFactor))
                                    Case "M"
                                        auth.ReportClear = CurrentTime.AddHours(CDbl(-1 + gThisWorkstationTimeFactor))
                                    Case "P"
                                        auth.ReportClear = CurrentTime.AddHours(CDbl(-2 + gThisWorkstationTimeFactor))
                                    Case Else
                                        auth.ReportClear = CurrentTime.AddHours(CDbl(gThisWorkstationTimeFactor))
                                End Select
                                'APPLY REPORT CLEAR TIME FIRST THEN RELEASE FROM THE DATABASE AND THEN FROM THE COMPONENTS

                                auth.ReportedClearByMobileClient = True
                                auth.UpdateTrackAuthorityReportClearTime()
                                auth.RemoveBlockingToRemoteLinkTrack(auth.ComponentsInSelection)
                                Dim AuthComponents As New ArrayList
                                CopyArrayCollection(AuthComponents, auth.ComponentsInSelection)
                                If auth.RemoveActiveAuthorityFromDB(Nothing) Then
                                    If auth.RemoveActiveAuthorityFromComponents(Nothing) Then
                                        'If auth.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                        EventMessage = "TRACK AUTHORITY:" & data(2) & " REQUESTED FOR RELEASE FROM MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS REMOVED FROM TRACK COMPONENTS."
                                        SystemEvent(EventMessage)
                                        ''
                                        EventMessage = "TRACK AUTHORITY:" & data(2) & " REQUESTED FOR RELEASE FROM MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS REMOVED FROM DATABASE."
                                        SystemEvent(EventMessage)
                                        AuthorityReleased = True

                                        Dim AlertMessage As String = auth.AuthorityUID & "|" & auth.IssueTo & "|" & auth.ReducedLimitsVerbiage
                                        TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.ReleasedAuthority, AlertMessage, Nothing, Nothing, Nothing, Nothing, Nothing, auth)

                                        Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", auth)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem)
                                        End SyncLock

                                        ''
                                        auth.RemoveTrackAuthFromRemoteLinks()
                                        If optEnablePTCBOSAPIMode Then
                                            TMDS.NetworkMessages.PTCBOSAPIMessaging.SendTNTAuthorityRelease(auth)
                                        End If

                                        OtherTrackAuthorities.Remove(auth)
                                        If auth.GetType.ToString = gTTComponentName Then
                                            auth.SendControl(TMDS.SystemUtilities.FetchData.GetFiedlBlockingComponents(auth.ComponentsInSelection))
                                        End If
                                        'If auth.RemoveActiveAuthorityFromDB(Nothing) Then
                                        '    EventMessage = "TRACK AUTHORITY:" & data(2) & " REQUESTED FOR RELEASE FROM MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS REMOVED FROM DATABASE."
                                        '    SystemEvent(EventMessage)
                                        '    AuthorityReleased = True

                                        '    Dim AlertMessage As String = auth.AuthorityUID & "|" & auth.IssueTo & "|" & auth.ReducedLimitsVerbiage
                                        '    TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.ReleasedAuthority, AlertMessage, Nothing, Nothing, Nothing, Nothing, Nothing, auth)

                                        '    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", auth)
                                        '    SyncLock gSummaryAuthQueue.SyncRoot
                                        '        gSummaryAuthQueue.Enqueue(SummItem)
                                        '    End SyncLock
                                        'Else
                                        '    EventMessage = "TRACK AUTHORITY:" & data(2) & " NOT RELEASED. MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS NOT REMOVED FROM DATABASE."
                                        '    SystemEvent(EventMessage)
                                        'End If

                                    Else
                                        EventMessage = "TRACK AUTHORITY:" & data(2) & " NOT RELEASED. MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS NOT REMOVED FROM TRACK COMPONENTS."
                                        SystemEvent(EventMessage)
                                    End If
                                Else
                                    EventMessage = "TRACK AUTHORITY:" & data(2) & " NOT RELEASED. MOBILE CLIENT:" & data(4) & " BY " & data(5) & " WAS NOT REMOVED FROM DATABASE."
                                    SystemEvent(EventMessage)
                                End If

                                If AuthorityReleased Then
                                    If auth.MixModeAuthorityType Then DoPerformReleaseMixModeAuthority(auth.AuthorityUID)
                                    Response = "MC:RELAUTHREQCONFIRMED;" & data(4) & "|" & data(1) & "|" & TMDS.GlobalDeclarations.gCurrentUser.Initials
                                    Exit For
                                Else
                                    Response = "MC:RELAUTHREQNAK;" & data(4) & "|" & data(1) & "|" & TMDS.GlobalDeclarations.gCurrentUser.Initials
                                End If
                                SyncLock gMSCTransmitQueue.SyncRoot
                                    gMSCTransmitQueue.Enqueue(Response)
                                End SyncLock
                            End If
                        End If
                    End If
                Next


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
        Private Shared Sub DoPerformReleaseMixModeAuthority(ByVal AuthUID As String)
            Try
                Dim auth As Object
                For Each auth In OtherTrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                        Dim ta As TrackAuthority.SFAuthority = CType(auth, TrackAuthority.SFAuthority)
                        If ta.MixModeAuthorityType AndAlso ta.AuthorityUID = AuthUID Then
                            If ta.RemoveSFAVIIAuthorityFromDB(Nothing) Then
                                If ta.RemoveAuthorityFromComponents(False) Then
                                    TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(ta)
                                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", ta)
                                    SyncLock gSummaryAuthQueue.SyncRoot
                                        gSummaryAuthQueue.Enqueue(SummItem)
                                    End SyncLock
                                End If
                                Exit For
                            End If
                        End If
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

