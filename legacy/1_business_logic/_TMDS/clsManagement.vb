#Region "EVENT LOGGING"

    Public Class SystemEventRecord
        Implements IDisposable

        Public pEventTime As Date
        Public pEventType As String
        Public pEventData As String
        Private disposedValue As Boolean

        Sub New(EventTime As Date,
                EventType As EventEnum,
                EventData As String,
                ByRef EventQueue As Queue)
            Try
                pEventTime = Now
                pEventType = EventType.ToString
                pEventData = EventData
                EventQueue.Enqueue(Me)
            Catch
            End Try
        End Sub

        Public Shared Sub AddEventToLog(ByVal EventType As EventEnum, ByVal EventData As String, ByVal EventQueue As Queue)
            Try
                Dim newEvent As New SystemEventRecord(Now, EventType, EventData, EventQueue)
                newEvent = Nothing
            Catch
            End Try
        End Sub

        Public Enum EventEnum
            DispatcherEvent
            SystemEvent
            ExceptionEvent
            AcknowledgeEvent
            ResourceEvent
            InformationEvent
            NetworkExceptionEvent
            DirectMoveEvent
            DiagnosticEvent
        End Enum

        Protected Overridable Sub Dispose(disposing As Boolean)
            If Not disposedValue Then
                If disposing Then
                    ' TODO: dispose managed state (managed objects)
                End If
                disposedValue = True
            End If
        End Sub

        Public Sub Dispose() Implements IDisposable.Dispose
            Dispose(disposing:=True)
            GC.SuppressFinalize(Me)
        End Sub

    End Class

