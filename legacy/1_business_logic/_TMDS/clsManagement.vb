        Public Shared Sub ProcessLocomotivePositionReport(ByVal MessageToProcess As String)
            If Not gInitialized Then Exit Sub
            Dim trk As Object = Nothing
            Dim Endtrk As Object = Nothing
            Dim loco As MobileTracking.Locomotive = Nothing
            Dim LocFound As MobileTracking.Locomotive = Nothing
            Dim LogOs As Boolean = False
            Dim ThisTrainLastTrack As Track = Nothing
            Try
                If optDisableTrainTrackingViaGPS Then Exit Sub

                'ProcessLocomotivePositionReport:LOCOMOTIVE-INFORMATION;POSITION-REPORT;183S-1430-0121;ARR   4005;;136.184;;;Main;33;


                'Dim theReport As New StringBuilder
                'theReport.Append("LOCOMOTIVE-INFORMATION;")
                'theReport.Append("POSITION-REPORT;")
                'theReport.Append(TrainSymbol)
                'theReport.Append(";")
                'theReport.Append(LocomotiveID)
                'theReport.Append(";")
                'theReport.Append(LocationSubdivisionName)
                'theReport.Append(";")
                'theReport.Append(LocationMilePost)
                'theReport.Append(";")
                'theReport.Append(LocationMilePostPrefix)
                'theReport.Append(";")
                'theReport.Append(LocationMilePostSuffix)
                'theReport.Append(";")
                'theReport.Append(MilePostTrackName)
                'theReport.Append(";")
                'theReport.Append(Speed)
                'theReport.Append(";")

                Dim theMessage As String = MessageToProcess.Replace(Chr(4), "")
                If optEnableARRCSpecificOptions Then SystemEvent(">>>>>>POSITION REPORT-DATA: " & theMessage)
                Dim data() As String = theMessage.Split(";")
                If data.Length < 8 Then Exit Sub

                Dim ForceIgnoreTracking As Boolean = False
                If optEnableARRCSpecificOptions OrElse optEnableFXESpecificOptions Then LogOs = True

                Dim LocoSymbol As String = ""
                Dim LocoUID As String = ""
                Dim SubUID As String = ""
                Dim BeginMP As Decimal = 0
                Dim MPPrefix As String = ""
                Dim MPSuffix As String = ""
                Dim MPTrackName As String = "" 'data(8)
                Dim Speed As Integer = 0
                Dim LocExists As Boolean


                If data.GetUpperBound(0) > 1 Then LocoSymbol = data(2).Trim.ToUpper
                If data.GetUpperBound(0) > 2 Then LocoUID = data(3)
                If data.GetUpperBound(0) > 3 Then SubUID = data(4)
                If data.GetUpperBound(0) > 4 Then Decimal.TryParse(data(5), BeginMP)
                If data.GetUpperBound(0) > 5 Then MPPrefix = data(6)
                If data.GetUpperBound(0) > 6 Then MPSuffix = data(7)
                If data.GetUpperBound(0) > 7 Then MPTrackName = data(8)
                If data.GetUpperBound(0) > 8 Then
                    If IsNumeric(data(9)) Then
                        Speed = CInt(data(9))
                        'Integer.TryParse(data(9), Speed)
                    End If
                End If

                Dim trn As TrainID
                If optEnableARRCSpecificOptions Then
                    'trn = TMDS.SystemUtilities.FetchData.FindActiveTrainFromSymbol(LocoSymbol) '
                    'FindTrainFromIDUnit
                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(LocoUID) '
                    If trn IsNot Nothing Then LocoSymbol = trn.Name
                Else
                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(LocoSymbol)
                End If
                If IsNothing(trn) Then
                    SystemEvent("GPS TRACKING-Train Not Found:" & LocoSymbol)
                    Exit Sub
                Else
                    If trn.ReadOnlySymbol Then
                        SystemEvent("GPS TRACKING-Train Not Controlled[ReadOnly]:" & LocoSymbol)
                        Exit Sub
                    ElseIf trn.myTrack.myControlPoint.IsShadowMode Then
                        SystemEvent("GPS TRACKING-Train Not Controlled[CP In Shadow Mode]:" & LocoSymbol)
                        Exit Sub
                    ElseIf trn.myTrack.IsShadowMode Then
                        SystemEvent("GPS TRACKING-Train Not Controlled[Track In Shadow Mode]:" & LocoSymbol)
                        Exit Sub
                    ElseIf trn.myTrack.AuthorityType.Trim.ToUpper = "SHELF" Then
                        SystemEvent("GPS TRACKING-Train On Shelf Track:" & LocoSymbol)
                        Exit Sub

                    End If

                End If
                If trn IsNot Nothing AndAlso trn.MyLastTrack IsNot Nothing Then ThisTrainLastTrack = trn.MyLastTrack
                If optEnableARRCSpecificOptions Then
                    If trn IsNot Nothing AndAlso trn.IdentifingUnit = LocoUID Then
                        If trn.TrainInActive Then
                            SystemEvent("GPS TRACKING-Train not active:" & LocoSymbol)
                            Exit Sub
                        ElseIf Not trn.IsUnitEnabledForGPS(trn.IdentifingUnit) Then
                            SystemEvent("GPS TRACKING-LOCO NOT ENABLED FOR GPS TRACKING:" & trn.IdentifingUnit)
                            Exit Sub
                        ElseIf Not optEnableGPSTrackingOnCTC AndAlso trn.myTrack IsNot Nothing AndAlso Mid(trn.myTrack.AuthorityType, 1, 3) <> "TWC" Then
                            SystemEvent("GPS TRACKING-Train not on TWC Track:" & LocoSymbol & " Track Type: " & trn.myTrack.AuthorityType)
                            Exit Sub
                        ElseIf Not optEnableGPSTrackingOnCTC AndAlso trn.myTrack IsNot Nothing AndAlso Mid(trn.myTrack.AuthorityType, 1, 3) = "TWC" AndAlso trn.myTrack.Indicating Then 'RMT-1789
                            SystemEvent("GPS TRACKING Failed-Train on TWC Indicating Track:" & LocoSymbol & " Track Type: " & trn.myTrack.AuthorityType)
                            Exit Sub
                        End If
                    Else
                        SystemEvent("GPS TRACKING-Train Not Lead Engine:" & LocoSymbol & " Lead Engine: " & trn.IdentifingUnit & " Recvd EngineID: " & LocoUID)
                        Exit Sub
                    End If

                    If MPTrackName IsNot Nothing AndAlso ThisTrainLastTrack IsNot Nothing AndAlso MPTrackName.Trim.ToUpper <> ThisTrainLastTrack.TrackNameAlias.Trim.ToUpper Then
                        SystemEvent("GPS TRACKING-Train Reporting Track Name Does not match with Last TrackName ALias:" & LocoSymbol & " Lead Engine: " & trn.IdentifingUnit & " Recvd TrackName: " & MPTrackName & " Last TrackName Alias: " & ThisTrainLastTrack.TrackNameAlias.Trim.ToUpper)
                        MPTrackName = ThisTrainLastTrack.TrackNameAlias
                    End If
                End If

                If Not String.IsNullOrEmpty(MPTrackName) AndAlso MPTrackName.ToUpper.Trim = "SDG" Then Exit Sub

                Dim SubName As String = ""
                If Integer.TryParse(SubUID, Nothing) Then SubName = TMDS.SystemUtilities.FetchData.FindSubdivisionNameFromUID(SubUID)

                SystemEvent("GPS TRACKING-LOCO TO FIND:" & LocoSymbol & "-" & LocoUID)
                SystemEvent("GPS TRACKING-gLocomotiveCollection-Count:" & gLocomotiveCollection.Count)

                For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                    SystemEvent("GPS TRACKING-gLocomotiveCollection:" & loco.Symbol & "-" & loco.LocomotiveID & "-" & loco.MilePost)
                Next

                For Each loco In TMDS.GlobalDeclarations.gLocomotiveCollection
                    If Trim(loco.Symbol) = Trim(LocoSymbol) AndAlso Trim(LocoUID) = Trim(loco.LocomotiveID) Then
                        LocFound = loco
                        LocExists = True
                        SystemEvent("GPS TRACKING-LOCO FOUND:" & loco.Symbol & "-" & loco.LocomotiveID)
                        Exit For
                    End If
                Next



                SystemEvent("GPS TRACKING-TRACK DETAILS:" & BeginMP & ":" & MPPrefix & ":" & MPSuffix & ":" & MPTrackName)

                trk = TMDS.SystemUtilities.FetchData.FindTrackFromMilePost_PreFixSuffix(BeginMP, MPSuffix, MPPrefix, MPTrackName, False)
                Dim SidingTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackFromMilePost_PreFixSuffix(BeginMP, MPSuffix, MPPrefix, MPTrackName, True)
                If optEnableFXESpecificOptions Then SidingTrack = Nothing
                If Not IsNothing(trk) Then
                    SystemEvent("GPS TRACKING-TRACK:" & trk.Name & ":" & trk.GUID)
                Else
                    ForceIgnoreTracking = True
                End If

                If Not IsNothing(SidingTrack) Then
                    SystemEvent("GPS TRACKING-STRACK:" & SidingTrack.Name & ":" & SidingTrack.GUID)
                ElseIf IsNothing(trk) Then
                    ForceIgnoreTracking = True
                End If

                If optEnableFXESpecificOptions AndAlso trk IsNot Nothing Then ' ADDED to Support FXE-414
                    Dim tmptrack As Track = TryCast(trk, Track)
                    If tmptrack IsNot Nothing Then
                        If Not IsValidToGPSTrackForFXE(trn, tmptrack, LocoUID) Then
                            Exit Sub
                        End If
                        'Select Case tmptrack.TrackName.Trim.ToUpper
                        '    Case "MAIN", "PRINCIPAL"
                        '        If LocoUID.Trim = String.Empty Then Exit Sub
                        '        If Mid(tmptrack.AuthorityType, 1, 3).Trim.ToUpper = "TWC" Then
                        '            SystemEvent("GPS TRACKING-TRACK-TWC:" & tmptrack.Name & ":" & tmptrack.GUID)
                        '            Dim a As Object
                        '            For Each a In TMDS.GlobalDeclarations.OtherTrackAuthorities
                        '                If a.GetType.ToString = gSFAComponentName AndAlso a.IssuedToTrain AndAlso a.IssueTo.Contains(LocoUID) Then
                        '                    Dim auth As SFAuthority = CType(a, SFAuthority)
                        '                    If Not auth.Components.Contains(tmptrack) Then
                        '                        SystemEvent("GPS TRACKING-ForceIgnoreTracking-Track Not Found in Authority:" & tmptrack.GUID)
                        '                        Exit Sub
                        '                    ElseIf auth.Components.Contains(tmptrack) Then
                        '                        SystemEvent("GPS TRACKING-TRACK FOUND IN TWC:" & tmptrack.Name & ":" & tmptrack.GUID)
                        '                    End If
                        '                End If
                        '            Next
                        '        End If
                        '    Case Else
                        '        ForceIgnoreTracking = True
                        'End Select
                    End If
                ElseIf optEnableFXESpecificOptions AndAlso trk Is Nothing Then
                    Exit Sub
                End If

                If optEnableARRCSpecificOptions Then
                    If trk IsNot Nothing AndAlso trk.GetType.ToString = gTrackComponentName Then
                        If optEnableGPSTrackingOnCTC AndAlso trk.AuthorityType = "CTC" AndAlso Speed < 2 Then
                            SystemEvent("GPS TRACKING Failed-Train:" & LocoSymbol & " Track Type: " & trk.AuthorityType & " SPEED LESS THAN 5 - GPS SPEED: " & Speed)
                            ForceIgnoreTracking = True
                        End If

                        If Mid(trk.AuthorityType, 1, 3) = "TWC" AndAlso trk.Indicating Then
                            ForceIgnoreTracking = True
                            SystemEvent("GPS TRACKING IGNORED -  Track Type: " & trk.AuthorityType & " INDICATING TWC TRACK ")
                        End If


                        If Not trk.IsValidTrackForOperation() Then
                            ForceIgnoreTracking = True
                            SystemEvent("GPS TRACKING-ForceIgnoreTracking:" & ForceIgnoreTracking.ToString)
                        End If
                    End If
                    If SidingTrack IsNot Nothing AndAlso SidingTrack.GetType.ToString = gTrackComponentName Then
                        If Not SidingTrack.IsValidTrackForOperation() Then
                            SystemEvent("GPS TRACKING-ForceIgnoreTracking1:" & ForceIgnoreTracking.ToString)
                            ForceIgnoreTracking = True
                        End If
                    End If

                    Dim t As Track = CType(trk, Track)
                    If Not IsNothing(t) Then
                        If t.AuthorityType = "TWC" Then
                            SystemEvent("GPS TRACKING-TRACK-TWC:" & t.Name & ":" & t.GUID)
                            Dim a As Object
                            For Each a In TMDS.GlobalDeclarations.OtherTrackAuthorities
                                If a.GetType.ToString = gSFAComponentName Then
                                    Dim auth As SFAuthority = CType(a, SFAuthority)
                                    If Not auth.Components.Contains(t) AndAlso auth.TrainSymbol = trn.Name Then
                                        ForceIgnoreTracking = True
                                        SystemEvent("GPS TRACKING-ForceIgnoreTracking-Track Not Found in Authority:" & t.GUID)
                                    ElseIf auth.Components.Contains(t) AndAlso auth.TrainSymbol = trn.Name Then
                                        SystemEvent("GPS TRACKING-TRACK FOUND IN TWC:" & t.Name & ":" & t.GUID)
                                    End If
                                End If
                            Next
                        ElseIf optEnableGPSTrackingOnCTC AndAlso t.AuthorityType = "CTC" Then
                            'If Not t.Occuppied Or t.SignalStatOnMe <> Track.SignalStatus.SignalCleared Then
                            '    SystemEvent("GPS TRACKING-ForceIgnoreTracking-CTC TRACK NOT OCCUPIED OR DOES NOT HAVE CLEARED SIGNAL:" & LocoSymbol.ToString & " TRACKGUID: " & t.GUID)
                            '    ForceIgnoreTracking = True
                            'End If
                            LogOs = False
                            If t.myControlPoint.FailState Then
                            ElseIf t.Occuppied AndAlso t.TrafficDirection.Trim <> "" Then
                            Else
                                Dim CheckForOccupancy As Boolean = True
                                Dim tt As Object = Nothing
                                'For Each tt In TMDS.GlobalDeclarations.OtherTrackAuthorities
                                '    If tt.GetType.ToString = gTTComponentName Then
                                '        Dim auth As TrackAuthority.TrackAuthority = CType(tt, TrackAuthority.TrackAuthority)
                                '        If auth.ComponentsInSelection.Contains(t) AndAlso auth.TrainSymbol = trn.Name Then
                                '            SystemEvent("GPS TRACKING-TRACK FOUND IN TNT AUTHORITY:" & t.Name & ":" & t.GUID)
                                '            ForceIgnoreTracking = False
                                '            CheckForOccupancy = False
                                '        End If
                                '    End If
                                'Next
                                'For Each tt In TMDS.GlobalDeclarations.gOtherSpecialAuthorityCollection
                                '    If tt.GetType.ToString = gOtherSplAuthorityName Then
                                '        Dim auth As TrackAuthority.OtherSpecialAuthorityType = CType(tt, TrackAuthority.OtherSpecialAuthorityType)
                                '        If auth.ComponentsInSelection.Contains(t) AndAlso auth.TrainSymbol = trn.Name Then
                                '            SystemEvent("GPS TRACKING-TRACK FOUND IN TNT AUTHORITY:" & t.Name & ":" & t.GUID)
                                '            ForceIgnoreTracking = False
                                '            CheckForOccupancy = False
                                '        End If
                                '    End If
                                'Next

                                If CheckForOccupancy Then
                                    If trn IsNot Nothing AndAlso trn.MyLastTrack IsNot Nothing Then
                                        If trn.MyLastTrack.GUID = t.GUID Then
                                            SystemEvent("GPS TRACKING-ForceIgnoreTracking-CTC TRACK - LAST TRACK TRACKED<" & trn.MyLastTrack.GUID & "> MATCHES RESOLVED GPS TRACK<" & t.GUID & "> :" & LocoSymbol.ToString)
                                            ForceIgnoreTracking = True
                                        ElseIf trn.MyLastTrack.OsComponentCollection IsNot Nothing AndAlso trn.MyLastTrack.OsComponentCollection.Count > 0 AndAlso trn.MyLastTrack.OsComponentCollection.Contains(t) Then
                                            SystemEvent("GPS TRACKING-ForceIgnoreTracking-CTC TRACK - LAST OS TRACK TRACKED<" & trn.MyLastTrack.GUID & "> MATCHES RESOLVED GPS TRACK<" & t.GUID & "> :" & LocoSymbol.ToString)
                                            ForceIgnoreTracking = True
                                        Else
                                            SystemEvent("GPS TRACKING-ForceIgnoreTracking---CTC TRACK NOT OCCUPIED OR DOES NOT HAVE CLEARED SIGNAL:" & LocoSymbol.ToString & " TRACKGUID: " & t.GUID)
                                            If optEnableARRCSpecificOptions Then GenerateAlertForTrainOnNonOccupiedTrack(trn, t)
                                            ForceIgnoreTracking = True
                                        End If
                                    Else
                                        SystemEvent("GPS TRACKING-ForceIgnoreTracking-CTC TRACK NOT OCCUPIED OR DOES NOT HAVE CLEARED SIGNAL:" & LocoSymbol.ToString & " TRACKGUID: " & t.GUID)
                                        If optEnableARRCSpecificOptions Then GenerateAlertForTrainOnNonOccupiedTrack(trn, t)
                                        ForceIgnoreTracking = True
                                    End If
                                End If


                            End If
                        End If
                    End If
                    If ForceIgnoreTracking Then
                        t = CType(SidingTrack, Track)
                        If Not IsNothing(t) Then
                            If t.AuthorityType = "TWC" Then
                                SystemEvent("GPS TRACKING-TRACK-TWC:" & t.Name & ":" & t.GUID)
                                Dim a As Object
                                For Each a In TMDS.GlobalDeclarations.OtherTrackAuthorities
                                    If a.GetType.ToString = gSFAComponentName Then
                                        Dim auth As SFAuthority = CType(a, SFAuthority)
                                        If Not auth.Components.Contains(t) AndAlso auth.TrainSymbol = trn.Name Then
                                            ForceIgnoreTracking = True
                                            SystemEvent("GPS TRACKING-ForceIgnoreTracking-Track Not Found in Authority:" & t.GUID)
                                        ElseIf auth.Components.Contains(t) AndAlso auth.TrainSymbol = trn.Name Then
                                            ForceIgnoreTracking = False
                                            trk = SidingTrack
                                            SystemEvent("GPS TRACKING-TRACK FOUND IN TWC:" & t.Name & ":" & t.GUID)
                                        End If
                                    End If
                                Next
                            End If

                        End If
                    End If

                End If



                If Not LocExists Then
                    Dim NewLocomotive As MobileTracking.Locomotive
                    NewLocomotive = New MobileTracking.Locomotive _
                        (TMDS.GlobalDeclarations.gLocomotiveCollection,
                         TMDS.GlobalDeclarations.SystemEventQueue,
                        TMDS.GlobalDeclarations.gMGPSTransmitQueue,
                        TMDS.GlobalDeclarations.gThisWorkstation)

                    RemoveDuplicateLocomotiveTrackObjects(LocoSymbol)

                    SyncLock TMDS.GlobalDeclarations.gLocomotiveCollection
                        TMDS.GlobalDeclarations.gLocomotiveCollection.Add(NewLocomotive)
                    End SyncLock
                    LocFound = NewLocomotive
                    NewLocomotive.ReportTime = Now
                    SystemEvent("GPS TRACKING-New Locomotive Added:" & LocoUID & ":" & LocoSymbol)

                End If


                With LocFound
                    .ReportTime = Now
                    If optEnableARRCSpecificOptions Then
                        .myTrainID = TMDS.SystemUtilities.FetchData.FindActiveTrainFromSymbol(LocoSymbol)
                    Else
                        .myTrainID = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(LocoSymbol)
                    End If

                    If Not trk Is Nothing AndAlso .myTrainID IsNot Nothing Then
                        Dim IgnoreTracking As Boolean = False
                        If optCheckForGPSEnabledUnit AndAlso .myTrainID IsNot Nothing Then
                            If .myTrainID.UnitsInTrain IsNot Nothing Then
                                Dim u As TrainUnit = Nothing
                                For Each u In .myTrainID.UnitsInTrain
                                    If u.UnitNumber = LocoUID Then
                                        If Not u.GPSCapable Then IgnoreTracking = True
                                        Exit For
                                    End If
                                Next
                            End If
                        End If
                        If optEnableARRCSpecificOptions Then
                            LocFound.DirectionOfTravel = LocFound.myTrainID.Direction
                            If Not TMDS.SystemUtilities.FetchData.IsMainTypeTrack(trk) Then
                                SystemEvent("GPS TRACKING IGNORED FOR TRAIN[ " & .myTrainID.Name & " ] DUE THE TRACK TYPE: " & trk.AuthorityType)
                                ForceIgnoreTracking = True
                                'Exit Sub
                            ElseIf Not optEnableGPSTrackingOnCTC AndAlso Mid(trk.AuthorityType, 1, 3) = "CTC" Then
                                SystemEvent("GPS TRACKING IGNORED FOR TRAIN[ " & .myTrainID.Name & " ] DUE THE TRACK TYPE: " & trk.AuthorityType)
                                ForceIgnoreTracking = True
                                'Exit Sub
                            End If

                        End If
                        If .myTrainID.MyLastTrack IsNot Nothing AndAlso .myTrainID.MyLastTrack.GUID = trk.GUID Then IgnoreTracking = True

                        If Not IsTrainMoveAllowedOnIndication(.myTrainID, "ProcessLocomotivePositionReport") Then
                            ForceIgnoreTracking = True
                        End If

                        If ForceIgnoreTracking Then IgnoreTracking = True



                        If Not IgnoreTracking Then
                            If Mid(trk.AuthorityType, 1, 3) = "TWC" Then
                                SystemEvent("GPS TRACKING-PositionTrain1:" & trk.Name & ":" & trk.GUID & ":" & trk.AuthorityType)
                                PositionTrain(trk, LocoSymbol.Trim, LogOs, SidingTrack)
                            ElseIf trk.AuthorityType = "SHELF" Then
                                SystemEvent("GPS TRACKING-PositionTrain2:" & trk.Name & ":" & trk.GUID & ":" & trk.AuthorityType)
                                PositionTrain(trk, LocoSymbol.Trim, LogOs, SidingTrack)
                            ElseIf Not IgnoreTracking AndAlso optEnableGPSTrackingOnCTC AndAlso Mid(trk.AuthorityType, 1, 3) = "CTC" Then
                                SystemEvent("GPS TRACKING-PositionTrain ON CTC TRACK :" & trk.Name & ":" & trk.GUID & ":" & trk.AuthorityType)
                                PositionTrain(trk, LocoSymbol.Trim, False, SidingTrack)
                            ElseIf gEnablePTCVETMSTrackingOnCTC AndAlso Mid(trk.AuthorityType, 1, 3) = "CTC" Then
                                If optEnableFXESpecificOptions OrElse optEnableARRCSpecificOptions Then
                                    ForceIgnoreTracking = True
                                Else
                                    SystemEvent("GPS TRACKING-PositionTrain4:" & trk.Name & ":" & trk.GUID & ":" & trk.AuthorityType)
                                    PositionTrain(trk, LocoSymbol.Trim, False, SidingTrack)
                                End If
                            End If
                        End If
                        .thisCurrentTrack = trk
                        .TrackGUID = trk.GUID
                        .TrackName = trk.TrackName
                        .myTrainID.MyLastGPSMilePost = BeginMP
                        .LocomotiveID = LocoUID
                        .myTrainID.MyLastTrack = trk
                    ElseIf IsNothing(trk) AndAlso Not IsNothing(.myTrainID) Then
                        .thisCurrentTrack = .myTrainID.myTrack
                        ForceIgnoreTracking = True
                    End If

                    If .myTrainID IsNot Nothing Then
                        If BeginMP > 0 Then .myTrainID.MyTrackingMilePost = MPPrefix.ToUpper.Trim & Space(1) & BeginMP.ToString & Space(1) & MPSuffix.ToUpper.Trim Else .myTrainID.MyTrackingMilePost = String.Empty
                        .myTrainID.MyTrackingSpeed = Speed
                        .myTrainID.IsTrackingWithGPS = True
                        .myTrainID.myTrack.InitTrainDisplay()
                    End If

                    .MilePost = BeginMP
                    .MilePostSuffix = MPSuffix
                    .MilePostPrefix = MPPrefix
                    .MilePostTrackName = MPTrackName
                    .Speed = Speed
                    .Symbol = LocoSymbol
                    If SubName <> "" Then
                        .Subdivision = SubName
                    End If

                    .SubID = SubUID
                    .OnBoardState = MobileTracking.Locomotive.StateOfOnBoard.ActiveMoving
                    If .myTrainID IsNot Nothing AndAlso Not ForceIgnoreTracking Then
                        .ProcessPositionReportForTrainTracking()
                    End If
                    If trk IsNot Nothing AndAlso LocFound IsNot Nothing AndAlso LocFound.myTrainID IsNot Nothing Then
                        SystemEvent("POSITION REPORT: LOCO NAME: " & LocFound.myTrainID.Name & " TRACK " & trk.GUID & " NAME: " & trk.NAME)
                    End If
                End With


            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                trk = Nothing
                Endtrk = Nothing
                loco = Nothing
                LocFound = Nothing
            End Try
        End Sub

        Private Shared Sub RemoveDuplicateLocomotiveTrackObjects(TrainSymbol As String)
            Try
                Dim tempList As ArrayList = gLocomotiveCollection.Clone
                Dim l As MobileTracking.Locomotive
                For Each l In tempList
                    If l.Symbol = TrainSymbol Then
                        l.Dispose()
                        gLocomotiveCollection.Remove(l)
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Function CheckForAuthority(ByVal theTrack As Track, ByVal theTrain As TrainID) As Boolean
            Try
                If theTrack.TrackAuthorities.Count = 0 Then Return False
                Dim sfa As SFAuthority
                For Each sfa In theTrack.TrackAuthorities
                    If InStr(sfa.IssueTo, theTrain.IdentifingUnit) OrElse InStr(theTrain.IdentifingUnit, sfa.IssueTo) Then
                        Return True
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Shared Function CheckForSidingTrackMovement(ByVal theTrack As Track, ByVal theTrain As TrainID) As Track
            Try
                Dim sfa As SFAuthority
                For Each sfa In theTrack.TrackAuthorities
                    If InStr(sfa.IssueTo, theTrain.IdentifingUnit) OrElse InStr(theTrain.IdentifingUnit, sfa.IssueTo) Then
                        If sfa.CheckBoxItemsStatus(2) OrElse sfa.CheckBoxItemsStatus(4) Then
                            Return theTrack
                        End If
                        Return Nothing
                    End If
                Next
                Return Nothing

            Catch ex As Exception
                GetErrorDetails(ex)
                Return Nothing
            End Try
        End Function

        Private Shared Sub PositionTrain(ByVal trk As Track, ByVal Name As String, Optional ByVal LogOS As Boolean = False, Optional ByVal SidingTrack As Track = Nothing)
            Try
                Dim theNewTrack As Track = trk
                LogEvent("PositionTrain:" & Name & "TRK:" & trk.GUID)
                Dim trnCheck As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(Name)
                If IsNothing(trk) Then
                    LogEvent("PositionTrain-Track Not Found for Train:" & Name)
                    Exit Sub
                End If
                If Not IsNothing(trnCheck) Then
                    If optEnableFXESpecificOptions Then
                        If Not CheckForAuthority(trk, trnCheck) Then
                            theNewTrack = CheckForSidingTrackMovement(SidingTrack, trnCheck)
                            If IsNothing(theNewTrack) Then
                                Exit Sub
                            End If
                        End If
                    End If
                    trk.MoveTrainIDPlaceManual(trnCheck, trnCheck.myTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                    If optEnableARRCSpecificOptions Then
                        If LogOS Then TMDS.SystemUtilities.TrainFunction.GetValidTrackToOS(trnCheck, trk)
                    End If
                    'trnCheck.ClearOsReports() - This is bad. This function will delete all the OS events in the DB. And this function is used only BNSF Sim App and Simulation Mode. 
                    'If optEnableARRCSpecificOptions AndAlso trk.AuthorityType.Contains("CTC") AndAlso Not trk.Occuppied AndAlso Not trk.myControlPoint.CommFail Then GenerateAlertForTrainOnNonOccupiedTrack(trnCheck, trk)
                    If optEnableARRCSpecificOptions Then GenerateAlertForTrainOnNonOccupiedTrack(trnCheck, trk)
                    Exit Sub
                End If
                If Not trk Is Nothing Then
                    Dim trn As TrainID = trk.RetrieveTrainID(Name)
                    If IsNothing(trn) Then Exit Sub
                    trn.ApplyTrainAbbreviation(gTrainAbbreviation)
                    trk.AddTrainID(trn)
                    If Not trk.Indicating Or gSimulationMode Then
                        trk.Occuppied = True
                        trk.UpdateStatus()
                    End If
                    Dim SummItem As New SummaryItem("TRAIN", "POSITION", trn)
                    SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                        TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                    End SyncLock



                Else
                    LogEvent("PositionTrain-TRACK NOT FOUND:" & trk.GUID)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub GenerateAlertForTrainOnNonOccupiedTrack(ByVal trn As TrainID, ByVal Trk As Track)
            Dim SFA As TMDS.TrackAuthority.SFAuthority
            Dim IsOkToAlert As Boolean = True
            Dim AlertMessage As String = "GPS TRAIN ON A NON-OCCUPIED TRACK - " & Trk.Name & "(" & Trk.myControlPoint.Name & ") - Symbol( " & trn.Name & " )"
            Try
                'Priority 1 Alarm TRACKING ALERT - GPS Position Report at Location 1213 Track 001 for Controlling Engine ARR 4002 of Initialized Train 130S   does not match Occupancy  Activated At 07:32:25 Is Inactive By Time
                If trn Is Nothing Then Exit Sub
                If Trk Is Nothing Then Exit Sub
                Select Case Trk.AuthorityType.ToUpper.Trim
                    Case "SHELF", "YL", "RL", "OTHER"
                        Exit Sub
                End Select


                If Trk.AuthorityType.Trim.ToUpper = "TWC" Then 'Contains("TWC") : ARRC-499
                    If Trk.TrackAuthorities IsNot Nothing AndAlso Trk.TrackAuthorities.Count > 0 Then
                        For Each SFA In Trk.TrackAuthorities
                            If Mid(SFA.IssueTo, 1, 10) = trn.IdentifingUnit Then
                                IsOkToAlert = False
                                Exit For
                            End If
                        Next
                    End If
                    If IsOkToAlert Then
                        AlertMessage = "GPS Position Report at Location " & Trk.myControlPoint.Name & "  " & Trk.TrackName & "  for Controlling Engine " & trn.IdentifingUnit & "|  " & trn.Name & " does not have Authority."
                    End If
                ElseIf Trk.AuthorityType.Trim.ToUpper = "CTC" Then '.Contains("CTC") : ARRC-499
                    If Trk.Occuppied Then IsOkToAlert = False
                    If Trk.myControlPoint.FailState Then
                        AlertMessage = "GPS Position Report at Location " & Trk.myControlPoint.Name & "  " & Trk.TrackName & "  for Controlling Engine " & trn.IdentifingUnit & "|  " & trn.Name & " STATION AT CODE FAIL."
                    ElseIf IsOkToAlert Then
                        AlertMessage = "GPS Position Report at Location " & Trk.myControlPoint.Name & "  " & Trk.TrackName & "  for Controlling Engine " & trn.IdentifingUnit & "|  " & trn.Name & " does not match Occupancy."
                    End If
                Else
                    IsOkToAlert = False
                End If
                If IsOkToAlert AndAlso Not CheckForAlertExtistence(AlertMessage) Then
                    Dim al As Alert = TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.GPS_TrainReportingOnNonOccupiedTrack, AlertMessage, trn)
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

        End Sub

        Private Shared Function CheckForAlertExtistence(ByVal theAlertMessage As String) As Boolean
            Dim TempAlArray As New ArrayList
            Try
                Dim al As Alert
                CopyArrayCollection(TempAlArray, gSystemAlertList)
                For Each al In TempAlArray 'TMDS.GlobalDeclarations.gSystemAlertList
                    If al.AlertData = theAlertMessage AndAlso Not al.AlertAcknowledged Then
                        Return True
                    ElseIf al.AlertData = theAlertMessage AndAlso al.AlertAcknowledged Then
                        TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                        Dim SummItem As New SummaryItem("ALERT", "REMOVE", al)
                        SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                            TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                        End SyncLock
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

