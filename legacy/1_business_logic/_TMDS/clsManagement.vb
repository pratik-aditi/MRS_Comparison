        Private Function ApplyConsistFromCrewChange(Optional ByVal pForm As Object = Nothing, Optional PTCLengthChange As Boolean = False) As Boolean
            Dim SQLStringCollection As New ArrayList
            Dim CarSQLStringCollection As New ArrayList
            Dim CarUIDCollection As New ArrayList
            Dim HasValidCarList As Boolean = False
            Dim MissingCarList As New ArrayList
            Dim MissingCarListHasBulletin As New ArrayList
            Dim MissingCarListRestriction As New ArrayList
            Dim MessageList As New ArrayList
            Dim CarDeleteSQLStringCollection As New ArrayList
            'Dim tc As TrainCar
            'Dim tr As TrainRestriction
            Dim HOTD As String = String.Empty
            Dim EOTD As String = String.Empty
            Try
                Dim LaunchPoint As Point = Nothing '(pForm.Left + 20, pForm.Top + 50)
                If pForm IsNot Nothing Then
                    LaunchPoint = New Point(pForm.Left + 20, pForm.Top + 50)
                End If

                Dim data() As String = TaskData.Split("|")
                Dim Loads As Integer = 0
                Dim Emts As Integer = 0
                Dim Tons As Int32 = 0
                Dim Length As Integer = 0
                Dim ThisTrainLocoLength As Integer = 0
                Dim NumOpBrakes As Integer
                Dim NumOfAxles As Integer
                Dim TrainType As String
                Dim MaxSpd As Integer
                If data.Length >= 8 Then
                    TrainType = data(0)
                    If IsNumeric(data(1)) Then Loads = CInt(data(1))
                    If IsNumeric(data(2)) Then Emts = CInt(data(2))
                    If IsNumeric(data(4)) Then Tons = CInt(data(4))
                    If IsNumeric(data(3)) Then Length = CInt(data(3))
                    If IsNumeric(data(7)) Then NumOpBrakes = CInt(data(7))
                    If IsNumeric(data(5)) Then MaxSpd = CInt(data(5))
                    If IsNumeric(data(6)) Then NumOfAxles = CInt(data(6))

                    If optEnableARRCSpecificOptions Then
                        ThisTrainLocoLength = Me.myTrain.GetMyLocoMotivesLength
                        Length = Length - ThisTrainLocoLength
                    End If

                    Me.myTrain.OEmts = Emts
                    Me.myTrain.OLength = Length
                    Me.myTrain.OLoads = Loads
                    Me.myTrain.OTons = Tons
                    Me.myTrain.NumberOfAxles = NumOfAxles
                    Me.myTrain.NumberOperatingBrakes = NumOpBrakes
                    Me.myTrain.TrainType = TrainType
                    Me.myTrain.MaxSpd = MaxSpd

                    Dim Consist As New StringBuilder
                    With Consist
                        .Append("(TYPE:" & TrainType & ")")
                        .Append("(LOADS:" & Loads & ")")
                        .Append("(EMTS:" & Emts & ")")
                        .Append("(TONS:" & Tons & ")")
                        .Append("(LEN:" & Length & ")")
                        .Append("(MAXSPD:" & MaxSpd & ")")
                        .Append("(NOA:" & NumOfAxles & ")")
                        .Append("(NOB:" & NumOpBrakes & ")")

                    End With
                    Me.myTrain.AddTrainSheetEvent("CONSIST CHANGE", Now, Mid(Me.myTrain.myTrack.TimeZone, 1, 1), Consist.ToString, Me.myTrain.myTrack.myControlPoint.GUID.ToString, Me.myTrain.GetIdentifyingLocationNameFromLimits, optRailRoadName)
                    If optApplyTrainSheetConfigurationForARRC Or optApplyTrainSheetConfigurationForDenver Then
                        Me.myTrain.CalculateTPOB(True)
                        Me.myTrain.CalculateTotalTonAndTotalLength("ApplyConsistFromCrewChange", True)
                    End If
                    Me.myTrain.UpdateTrainConsist()
                    Me.myTrain.PerformConsistDatabaseUpdatePTC()
                End If
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function ApplyConsist(Optional ByVal pForm As Object = Nothing) As Boolean
            Dim SQLStringCollection As New ArrayList
            Dim CarSQLStringCollection As New ArrayList
            Dim CarUIDCollection As New ArrayList
            Dim HasValidCarList As Boolean = False
            Dim MissingCarList As New ArrayList
            Dim MissingCarListHasBulletin As New ArrayList
            Dim MissingCarListRestriction As New ArrayList
            Dim MessageList As New ArrayList
            Dim CarDeleteSQLStringCollection As New ArrayList
            Dim tc As TrainCar
            Dim tr As TrainRestriction
            Dim HOTD As String = String.Empty
            Dim EOTD As String = String.Empty
            Try
                Dim LaunchPoint As Point = Nothing '(pForm.Left + 20, pForm.Top + 50)
                If pForm IsNot Nothing Then
                    LaunchPoint = New Point(pForm.Left + 20, pForm.Top + 50)
                End If

                '6|0|750|613|0|30|
                Dim data() As String = TaskData.Split("|")
                Dim Loads As Integer = 0
                Dim Emts As Integer = 0
                Dim Tons As Int32 = 0
                Dim Length As Integer = 0
                Dim NumOpBrakes As Integer
                Dim NumOfAxles As Integer
                If data.Length >= 6 Then
                    If IsNumeric(data(0)) Then Loads = CInt(data(0))
                    If IsNumeric(data(1)) Then Emts = CInt(data(1))
                    If IsNumeric(data(2)) Then Tons = CInt(data(2))
                    If IsNumeric(data(3)) Then Length = CInt(data(3))
                    If IsNumeric(data(4)) Then NumOpBrakes = CInt(data(4))
                    If IsNumeric(data(5)) Then NumOfAxles = CInt(data(5))
                End If

                If data.Length >= 8 Then
                    '****************
                    HOTD = data(6)
                    EOTD = data(7)
                    '****************
                End If

                If Loads = 0 AndAlso Emts = 0 AndAlso Tons = 0 AndAlso Length = 0 Then
                    If Me.myTrain IsNot Nothing Then
                        Dim myTrainTGBOCollection As New ArrayList
                        myTrainTGBOCollection = TMDS.SystemUtilities.FetchData.FindAllTGBOsByTrainSymbol(Me.myTrain.Name)
                        'If myTrainTGBOCollection IsNot Nothing AndAlso myTrainTGBOCollection.Count > 0 Then
                        '    MessageList = New ArrayList
                        '    With MessageList
                        '        .Add("PLEASE RELEASE ALL TGBO'S FOR THIS TRAIN [" & Me.myTrain.Name & "]")
                        '        .Add("CONSIST REBUILD MESSAGE RECEIVED FROM MIS.")
                        '    End With
                        '    ShowCustomMessageBox(MessageList, "SYSTEM CONFLICT CHECK", False, LaunchPoint, True, True, pForm)
                        '    Me.IgnoreErrorPrompt = True
                        '    Return False
                        'End If
                        Dim OLDGrossTon As Double = 0
                        Double.TryParse(Me.myTrain.HorsePowerTrailing, OLDGrossTon)
                        Me.myTrain.OEmts = Emts
                        Me.myTrain.OLength = Length
                        Me.myTrain.OLoads = Loads
                        Me.myTrain.OTons = Tons
                        Me.myTrain.NumberOfAxles = NumOfAxles
                        Me.myTrain.NumberOperatingBrakes = NumOpBrakes
                        Me.myTrain.EOTD = EOTD
                        Me.myTrain.HOTD = HOTD
                        myTrain.CalculateHorsePowerPerTon(Tons)
                        myTrain.CalculateTotalTonAndTotalLength("Manage_ApplyConsist")
                        myTrain.RefreshCarConsist(True)
                        Dim NewGrossTon As Double
                        Double.TryParse(myTrain.HorsePowerTrailing, NewGrossTon)
                        If Double.IsInfinity(OLDGrossTon) Then OLDGrossTon = 0
                        If OLDGrossTon <> NewGrossTon Then
                            Dim OGT As Double = 0 : If Not Double.IsInfinity(OLDGrossTon) Then OGT = OLDGrossTon
                            Dim ConsistChange As String = "GROSS TONS CHANGED FROM " & Space(1) & OGT.ToString & Space(1) & optTrainString8 & Space(1) & NewGrossTon.ToString
                            SystemEvent("TRAIN CONSIST CHANGE:" & Me.myTrain.Name & " (" & ConsistChange & ")")
                            Dim RRUID As String = Me.myTrain.myTrack.myControlPoint.UniqueName
                            Me.myTrain.AddTrainSheetEvent("CONSIST CHANGE", Now, Mid(Me.myTrain.myTrack.TimeZone, 1, 1), ConsistChange, Me.myTrain.myTrack.myControlPoint.GUID.ToString, Me.myTrain.GetIdentifyingLocationNameFromLimits, RRUID)
                        End If
                        'If OLDGrossTon <> NewGrossTon Then
                        '    Dim OGT As Double = 0 : If Not Double.IsInfinity(OLDGrossTon) Then OGT = OLDGrossTon
                        '    Dim ConsistChange As String = "GROSS TONS CHANGED FROM " & Space(1) & OGT.ToString & Space(1) & optTrainString8 & Space(1) & NewGrossTon.ToString
                        '    SystemEvent("TRAIN CONSIST CHANGE:" & Me.myTrain.Name & " (" & ConsistChange & ")")
                        '    Dim RRUID As String = Me.myTrain.myTrack.myControlPoint.UniqueName
                        '    Me.myTrain.AddTrainSheetEvent("CONSIST CHANGE", Now, Mid(Me.myTrain.myTrack.TimeZone, 1, 1), ConsistChange, Me.myTrain.myTrack.myControlPoint.GUID.ToString, Me.myTrain.GetIdentifyingLocationNameFromLimits, RRUID)
                        'End If
                        Dim myCarList As New ArrayList
                        Dim myTempRestriction As New ArrayList
                        CopyArrayCollection(myCarList, Me.myTrain.myCarList)
                        For Each tc In myCarList
                            tc.RemoveCar()
                        Next
                        CopyArrayCollection(myTempRestriction, Me.myTrain.myRestrictionList)
                        Dim tgb As TabularGeneralBulletin
                        For Each tr In myTempRestriction
                            If tr IsNot Nothing Then
                                If myTrainTGBOCollection IsNot Nothing AndAlso myTrainTGBOCollection.Count > 0 Then
                                    For Each tgb In myTrainTGBOCollection
                                        If tgb IsNot Nothing Then
                                            If InStr(tgb.BulletinListDefinitions, tr.myBulletinGUID) <> 0 Then
                                                tr.CancelFormC(tgb)
                                                Exit For
                                            End If
                                        End If
                                    Next

                                Else
                                    tr.RemoveRestriction()
                                End If

                            End If
                        Next
                        If Me.myTrain IsNot Nothing Then
                            Dim SummItem As New TrainRefreshItem(TrainRefreshItem.TrainRefreshType.TGBO, TrainRefreshItem.TrainRefreshAction.REFRESH, "")
                            SyncLock Me.myTrain.myTrainTimerRefreshQueue.SyncRoot
                                Try
                                    Dim tmp As TrainRefreshItem
                                    Dim OkToAdd As Boolean = True
                                    For Each tmp In Me.myTrain.myTrainTimerRefreshQueue
                                        If tmp.myItemAction = TrainRefreshItem.TrainRefreshAction.REFRESH AndAlso tmp.myItemAction = TrainRefreshItem.TrainRefreshType.TGBO Then
                                            OkToAdd = False
                                        End If
                                    Next
                                    If OkToAdd Then Me.myTrain.myTrainTimerRefreshQueue.Enqueue(SummItem)
                                Catch ex As Exception
                                    GetErrorDetails(ex)
                                End Try

                            End SyncLock
                        End If



                        TMDS.NetworkMessages.CadMessages.SendTrainEngineSetEventARRC(Me.myTrain, gMISTransmitQueue, "MODIFY")
                        'TMDS.NetworkMessages.CadMessages.SendTrainDataWarehouseEventARRC(Me.myTrain, gCadTransmitQueue, "MODIFY")   'Commented Based On RMT ARRC-1432
                        Return True
                    End If
                End If



                HasValidCarList = GetCarListSQLString(CarSQLStringCollection, CarUIDCollection)

                Dim S As String = ""
                Dim tmpS As String = ""
                If CarUIDCollection IsNot Nothing AndAlso CarUIDCollection.Count > 0 Then
                    For Each tc In Me.myTrain.myCarList
                        Dim CarFound As Boolean = False
                        For Each S In CarUIDCollection
                            If S IsNot Nothing AndAlso Not String.IsNullOrEmpty(S) AndAlso S.Trim <> "" Then
                                If S.ToUpper.Trim = tc.CarUID.ToUpper.Trim Then CarFound = True : Exit For
                            End If
                        Next
                        If Not CarFound Then
                            If Not MissingCarList.Contains(tc) Then MissingCarList.Add(tc)
                        End If

                        Dim tempDeleteString As New ArrayList
                        tempDeleteString = tc.GetDeleteString
                        tmpS = ""
                        If tempDeleteString IsNot Nothing AndAlso tempDeleteString.Count > 0 Then
                            For Each tmpS In tempDeleteString
                                If tmpS.Trim <> "" Then If Not CarDeleteSQLStringCollection.Contains(tmpS) Then CarDeleteSQLStringCollection.Add(tmpS)
                            Next
                        Else
                            Return False
                        End If

                    Next
                Else
                    For Each tc In Me.myTrain.myCarList
                        If Not MissingCarList.Contains(tc) Then MissingCarList.Add(tc)
                        Dim tempDeleteString As New ArrayList
                        tempDeleteString = tc.GetDeleteString
                        tmpS = ""
                        If tempDeleteString IsNot Nothing AndAlso tempDeleteString.Count > 0 Then
                            For Each tmpS In tempDeleteString
                                If tmpS.Trim <> "" Then If Not CarDeleteSQLStringCollection.Contains(tmpS) Then CarDeleteSQLStringCollection.Add(tmpS)
                            Next
                        Else
                            Return False
                        End If
                    Next
                End If


                If MissingCarList IsNot Nothing AndAlso MissingCarList.Count > 0 Then
                    For Each tc In MissingCarList
                        If tc.CheckCarForBulletinIssued Then
                            If Not MissingCarListHasBulletin.Contains(tc.CarUID) Then MissingCarListHasBulletin.Add(tc.CarUID)
                        End If
                    Next
                End If

                If MissingCarList IsNot Nothing AndAlso MissingCarList.Count > 0 Then
                    MissingCarListRestriction = New ArrayList
                    For Each tc In MissingCarList
                        tc.CheckCarForRestrictionHasNoFormC(MissingCarListRestriction)
                    Next
                End If

                If MissingCarListHasBulletin IsNot Nothing AndAlso MissingCarListHasBulletin.Count > 0 Then

                    MessageList = New ArrayList
                    With MessageList
                        .Add("PLEASE CANCEL THE FORM C BULLETIN FROM THE TGBO TAB, ")
                        .Add("ISSUE THE CANCELING BULLETIN TO THE TRAIN AND THEN ACCEPT THE CONSIST CHANGE.")
                        .Add("THE FOLLOWING CAR'S HAVE FORMC ISSUED.")
                        For Each S In MissingCarListHasBulletin
                            If S.Trim <> "" Then
                                .Add(S)
                            End If
                        Next
                    End With
                    ShowCustomMessageBox(MessageList, "SYSTEM CONFLICT CHECK", False, LaunchPoint, True, True, pForm)
                    Me.IgnoreErrorPrompt = True
                    Return False
                End If

                If optEnableARRCSpecificOptions Then

                    If Me.myTrain.TrainConsistChangeCheck(Loads, Emts, Length, Tons, NumOfAxles, NumOpBrakes, False, True, EOTD, HOTD) Then
                        Dim ConsistString As String = GetConsistUpdateSQLString()
                        If ConsistString Is Nothing Then Return False
                        If ConsistString.Trim = String.Empty Then Return False
                        Dim OLDGrossTon As Double = 0
                        Double.TryParse(Me.myTrain.HorsePowerTrailing, OLDGrossTon)
                        SQLStringCollection.Add(ConsistString)
                        If Not HasValidCarList Then Return False
                        S = ""
                        If CarDeleteSQLStringCollection IsNot Nothing AndAlso CarDeleteSQLStringCollection.Count > 0 Then
                            For Each S In CarDeleteSQLStringCollection : SQLStringCollection.Add(S) : Next
                        End If
                        S = ""
                        If CarSQLStringCollection IsNot Nothing AndAlso CarSQLStringCollection.Count > 0 Then
                            For Each S In CarSQLStringCollection : SQLStringCollection.Add(S) : Next
                        End If
                        If Not ExecuteQueryCollection(SQLStringCollection, gConnectionStringDynamic) Then Return False

                        If optEnablePTCBOSVETMSMode And myTrain.IsActivePTC Then
                            TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainConsistChange(myTrain, "ApplyConsist1")
                        End If
                        Me.myTrain.OEmts = Emts
                        Me.myTrain.OLength = Length
                        Me.myTrain.OLoads = Loads
                        Me.myTrain.OTons = Tons
                        Me.myTrain.NumberOfAxles = NumOfAxles
                        Me.myTrain.NumberOperatingBrakes = NumOpBrakes
                        Me.myTrain.EOTD = EOTD
                        Me.myTrain.HOTD = HOTD
                        myTrain.CalculateHorsePowerPerTon(Tons)
                        myTrain.CalculateTotalTonAndTotalLength("WorkTask_ApplyConsist")
                        myTrain.RefreshCarConsist(True)
                        Dim NewGrossTon As Double
                        Double.TryParse(myTrain.HorsePowerTrailing, NewGrossTon)
                        If Double.IsInfinity(OLDGrossTon) Then OLDGrossTon = 0
                        If OLDGrossTon <> NewGrossTon Then
                            Dim OGT As Double = 0 : If Not Double.IsInfinity(OLDGrossTon) Then OGT = OLDGrossTon
                            Dim ConsistChange As String = "GROSS TONS CHANGED FROM " & Space(1) & OGT.ToString & Space(1) & optTrainString8 & Space(1) & NewGrossTon.ToString
                            SystemEvent("TRAIN CONSIST CHANGE:" & Me.myTrain.Name & " (" & ConsistChange & ")")
                            Dim RRUID As String = Me.myTrain.myTrack.myControlPoint.UniqueName
                            Me.myTrain.AddTrainSheetEvent("CONSIST CHANGE", Now, Mid(Me.myTrain.myTrack.TimeZone, 1, 1), ConsistChange, Me.myTrain.myTrack.myControlPoint.GUID.ToString, Me.myTrain.GetIdentifyingLocationNameFromLimits, RRUID)
                        End If


                        If MissingCarListRestriction IsNot Nothing AndAlso MissingCarListRestriction.Count > 0 Then
                            For Each tr In MissingCarListRestriction
                                If tr IsNot Nothing Then
                                    tr.RemoveRestriction()
                                End If
                            Next
                        End If
                        TMDS.NetworkMessages.CadMessages.SendTrainEngineSetEventARRC(Me.myTrain, gMISTransmitQueue, "MODIFY")
                    End If
                Else

                    Dim OLDGrossTon As Double = 0
                    Double.TryParse(Me.myTrain.HorsePowerTrailing, OLDGrossTon)

                    Me.myTrain.OEmts = Emts
                    Me.myTrain.OLength = Length
                    Me.myTrain.OLoads = Loads
                    Me.myTrain.OTons = Tons
                    Me.myTrain.NumberOfAxles = NumOfAxles
                    Me.myTrain.NumberOperatingBrakes = NumOpBrakes
                    Me.myTrain.EOTD = EOTD
                    Me.myTrain.HOTD = HOTD
                    myTrain.CalculateHorsePowerPerTon(Tons)
                    myTrain.CalculateTotalTonAndTotalLength("WorkTask_ApplyConsist2")
                    myTrain.RefreshCarConsist(True)
                    Dim NewGrossTon As Double
                    Double.TryParse(myTrain.HorsePowerTrailing, NewGrossTon)
                    If Double.IsInfinity(OLDGrossTon) Then OLDGrossTon = 0
                    If OLDGrossTon <> NewGrossTon Then
                        Dim OGT As Double = 0 : If Not Double.IsInfinity(OLDGrossTon) Then OGT = OLDGrossTon
                        Dim ConsistChange As String = "GROSS TONS CHANGED FROM " & Space(1) & OGT.ToString & Space(1) & optTrainString8 & Space(1) & NewGrossTon.ToString
                        SystemEvent("TRAIN CONSIST CHANGE:" & Me.myTrain.Name & " (" & ConsistChange & ")")
                        Dim RRUID As String = Me.myTrain.myTrack.myControlPoint.UniqueName
                        Me.myTrain.AddTrainSheetEvent("CONSIST CHANGE", Now, Mid(Me.myTrain.myTrack.TimeZone, 1, 1), ConsistChange, Me.myTrain.myTrack.myControlPoint.GUID.ToString, Me.myTrain.GetIdentifyingLocationNameFromLimits, RRUID)
                    End If

                    If optEnablePTCBOSVETMSMode And myTrain.IsActivePTC Then
                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainConsistChange(myTrain, "ApplyConsist2")
                    End If

                End If

                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function GetConsistUpdateSQLString() As String
            Dim Update As New StringBuilder
            Try
                '0|86|2684|4783|0|344|
                '.1	Loads	3n	Y	Train Loads 
                '.2	Empties	3n	Y	Train Empties 
                '.3	Tons	5n	Y	Train Trailing Tons 
                '.4	Length	5n	Y	Train Trailing Length in feet (stretched)
                '.5	NumOperativeBrakes	3n	Y	
                '.6	NumAxles	4n	Y	
                Dim data() As String = TaskData.Split("|")
                Dim Loads As Integer
                Dim Emts As Integer
                Dim Tons As Int32
                Dim Length As Integer
                Dim NumOpBrakes As Integer
                Dim NumOfAxles As Integer
                If IsNumeric(data(0)) Then Loads = CInt(data(0))
                If IsNumeric(data(1)) Then Emts = CInt(data(1))
                If IsNumeric(data(2)) Then Tons = CInt(data(2))
                If IsNumeric(data(3)) Then Length = CInt(data(3))
                If IsNumeric(data(4)) Then NumOpBrakes = CInt(data(4))
                If IsNumeric(data(5)) Then NumOfAxles = CInt(data(5))
                Dim HOTD As String = data(6)
                Dim EOTD As String = data(7)

                Dim KeyTrain As Boolean
                Dim HazMat As Boolean
                If data(8) = "KE" Then KeyTrain = True
                If data(8) = "HZ" Then HazMat = True

                Dim HighWideWeight As Boolean
                If data(9) = "Y" Then HighWideWeight = True
                Dim HelperTrain As Boolean
                If data(10) = "Y" Then HelperTrain = True


                Update.Append("UPDATE tblTrainsActive ")
                Update.Append(" SET OLoads = " & Loads)
                Update.Append(", OEmts = " & Emts)
                Update.Append(", OTons = " & Tons)
                Update.Append(", OLength = " & Length)
                Update.Append(", NumberOperatingBrakes = " & NumOpBrakes)
                Update.Append(", NumberOfAxles = " & NumOfAxles)
                Update.Append(", HOTD = '" & HOTD & "'")
                Update.Append(", EOTD = '" & EOTD & "'")
                Update.Append(", HighWide = " & CInt(HighWideWeight))
                Update.Append(", HazMat = " & CInt(HazMat))
                Update.Append(", KeyTrain = " & CInt(KeyTrain))
                Update.Append(", Helper = " & CInt(HelperTrain))

                Update.Append(" WHERE EntityUID = '" & EntityUID & "'")
                Return Update.ToString
            Catch ex As Exception
                GetErrorDetails(ex, "SQL QUERY: " & Update.ToString)
            End Try
            Return Nothing
        End Function

        Private Function GetCarListSQLString(ByRef CarList As ArrayList, ByRef CarUIDList As ArrayList) As Boolean
            Dim dbComm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim TrainCarCollection As New ArrayList
            Dim SQLQuery As New StringBuilder
            Try
                With SQLQuery
                    .Append("SELECT MessageData,GroupIndex,GroupCount  FROM tblSystemQueueReceive ")
                    .Append(" WHERE")
                    .Append(" (MessageUID = 1045) AND (TimeProcessed IS NOT NULL) ")
                    .Append(" AND (MessageVersion='" & Me.MessageVersion.ToString & "' AND MessageEdition='" & Me.MessageEdition & "'  AND EntityUID='" & Me.myTrain.EntityUID & "' ) ")
                    .Append(" ORDER BY GroupIndex")
                End With
                CarList = New ArrayList
                Using DbConn As New OleDbConnection(gConnectionStringDynamic)
                    DbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery.ToString, DbConn)
                    dr = dbComm.ExecuteReader
                    While dr.Read
                        Dim MessageData As String = String.Empty

                        Dim CarPostion As Integer
                        Dim GrpCount As Integer
                        If Not dr.IsDBNull(0) Then MessageData = dr.GetString(0)
                        If Not dr.IsDBNull(1) Then Integer.TryParse(dr.GetValue(1), CarPostion)
                        If Not dr.IsDBNull(1) Then Integer.TryParse(dr.GetValue(2), GrpCount)
                        Dim MISInfo As String = Me.MessageVersion.ToString & "|" & Me.MessageEdition.ToString & "|" & CarPostion.ToString & "|" & GrpCount.ToString
                        If Not String.IsNullOrEmpty(MessageData) AndAlso MessageData.Trim <> String.Empty Then
                            'HALX|1054|95|89|4|0|L|
                            Dim d() As String = MessageData.Split("|")
                            Dim tc As New TrainCar
                            tc.myUID = Guid.NewGuid.ToString.ToUpper
                            If Me.myTrain IsNot Nothing Then
                                tc.myTrain = Me.myTrain
                                'tc.TrainGUID = Me.myTrain.TrainGUID
                                'tc.CarInitial = d(0)
                                'tc.CarNumber = d(1)
                                Dim CarID As String = d(0).ToUpper.Trim & d(1).ToUpper.Trim
                                tc.CarUID = CarID.Trim
                                If Not CarUIDList.Contains(CarID) Then CarUIDList.Add(CarID)
                                tc.CarTons = CInt(d(2))
                                tc.CarLength = CInt(d(3))
                                tc.CarAxles = CInt(d(4))
                                tc.CarNumOperateBrakes = CInt(d(5))
                                tc.LoadStatus = d(6)
                                tc.RailroadUID = Me.myTrain.EntityUID
                                tc.CarPositionIndex = CarPostion
                                tc.MISInfo = MISInfo
                                Dim S As String = tc.GetInsertSQLString
                                If S IsNot Nothing AndAlso Not String.IsNullOrEmpty(S) AndAlso S.Trim <> "" Then
                                    If Not CarList.Contains(S) Then CarList.Add(S)
                                Else
                                    Return False
                                End If
                            Else
                                Return False
                            End If
                        End If
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using
                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
                Return False
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Function

