        Friend Function RemoveGBO(ByVal pFORM As Object) As Boolean
            Try
                If Not Me.IsOnTrain Then Return True
                If pFORM Is Nothing Then
                    pFORM = myTrain.myTrack.CurrentDrawingForm
                End If
                Dim sb As SubBulletin = TMDS.SystemUtilities.FetchData.FindBulletinByGUID(Me.myBulletinGUID)
                If sb IsNot Nothing Then
                    Dim frmBulletinHMI As New frmBulletinHMI
                    frmBulletinHMI.theBulletin = sb
                    frmBulletinHMI.BulletinCancelFromTrainSheet = True
                    frmBulletinHMI.LoadForm("BULLETIN-CHANGE", "CANCEL", Nothing, sb)
                    If Not SetFormPropertiesGBO(frmBulletinHMI, pFORM) Then Return False
                End If
                Return True
            Catch ex As Exception

            End Try
        End Function

        Private Function SetFormPropertiesGBO(ByVal frmBulletinHMI As frmBulletinHMI, ByVal pFORM As Object) As Boolean
            Dim Feedback As Boolean = False
            Try
                frmBulletinHMI.Owner = pFORM
                frmBulletinHMI.Location = New Point(pFORM.Location.X + 100, pFORM.Location.Y + 100)
                frmBulletinHMI.ShowDialog()
                If frmBulletinHMI.BulletinFormFeedback = 6 Then Feedback = True
                frmBulletinHMI.Dispose()
            Catch ex As Exception
                GetErrorDetails(ex)
                Return False
            Finally
                frmBulletinHMI = Nothing
            End Try
            Return Feedback
        End Function

        Private Sub ArchiveTBPDF(ByVal Bull As SubBulletin, Optional EventType As String = "TRACK BULLETIN")
            Try
                If Not Bull Is Nothing Then
                    Dim BulletinDocument As New PrintForms.GeneralBulletinOrders
                    Dim GBOFile As String = BulletinDocument.PrintGBO(Bull)
                    If optPerformDocumentArchiving Then
                        Dim EntityUID As String
                        EntityUID = Bull.BullUID
                        Dim SubUID As Integer
                        SubUID = Bull.SubUID
                        Dim TerrUID As Integer = 0
                        TMDS.PrintForms.DocumentArchive.ArchiveTheDocument(GBOFile, EventType, EntityUID, TerrUID, SubUID)
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

