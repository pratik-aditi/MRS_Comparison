                        Me.thisTerrID = CInt(data(0))
                    Else
                        Exit Function
                    End If
                    If Trim(data(1)) <> "" Then
                        Me.thisMobileTerminal = data(1)
                    Else
                        Exit Function
                    End If
                    If Trim(data(2)) <> "" And Trim(data(3)) <> "" Then
                        Me.thisLastName = data(2)
                        Me.thisFirstName = data(3)
                        Me.myMessageClient = Me.thisFirstName & " " & Me.thisLastName
                    Else
                        Exit Function
                    End If
                    Me.iMessage = data(4)

                Else
                    Exit Function
                End If
                Return True


                '0=TERRID
                '1=TERMINAL
                '2=LASTNAME
                '3=FIRSTNAME
                '4=UNTILTIME
                '5=JOINT
                '6=VEHICLES
                '7=COMPONENTS
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

