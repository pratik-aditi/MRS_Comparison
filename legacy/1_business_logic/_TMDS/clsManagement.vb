        Private Sub RemoveTroubleReportFromCollection(GUID As String)
            Dim TR As TroubleReport
            Dim TempTR As New ArrayList
            Try
                CopyArrayCollection(TempTR, TMDS.GlobalDeclarations.gTroubleReports)
                If TempTR IsNot Nothing AndAlso TempTR.Count > 0 Then
                    For Each TR In TempTR
                        If TR.GUID = GUID Then
                            TMDS.GlobalDeclarations.gTroubleReports.Remove(TR)
                            Exit For
                        End If
                    Next
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

        End Sub

        Public Sub RetrieveTroubleReport(ByVal GUID As String)
            Dim ReportFetch As String
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseCommand As OleDbCommand = Nothing
            'Dim dbConn As OleDbConnection
            Dim tr As TroubleReport

            Try
                RemoveTroubleReportFromCollection(GUID)
                ReportFetch = "SELECT * FROM tblSystemIncidentReportsActive"
                ReportFetch = ReportFetch & " WHERE [UID] = '" & GUID & "'"
                Using DbConn As New OleDbConnection(TMDS.gConnectionStringDynamic)
                    DbConn.Open()
                    DatabaseCommand = New OleDbCommand(ReportFetch, DbConn)
                    dr = DatabaseCommand.ExecuteReader()
                    While dr.Read()
                        tr = New TroubleReport()
                        If Not dr.IsDBNull(0) Then tr.GUID = dr.GetString(0)
                        If Not dr.IsDBNull(1) Then tr.CreateTime = dr.GetDateTime(1)
                        If Not dr.IsDBNull(2) Then tr.CreatedBy = dr.GetString(2)
                        If Not dr.IsDBNull(3) Then tr.CrossingDOT = dr.GetString(3)
                        If Not dr.IsDBNull(4) Then tr.MilePost = dr.GetString(4)
                        If Not dr.IsDBNull(5) Then tr.Subdivision = dr.GetString(5)
                        If Not dr.IsDBNull(6) Then tr.TrackGUID = dr.GetInt32(6)
                        If Not dr.IsDBNull(7) And Not dr.IsDBNull(8) Then
                            tr.Location = dr.GetString(7) & "-" & dr.GetString(8)
                            tr.CrossingStreet = dr.GetString(7)
                            tr.CrossingCity = dr.GetString(8)
                        End If
                        If Not dr.IsDBNull(9) Then tr.MalfunctionType = dr.GetString(9) : tr.TroubleType = dr.GetString(9)
                        If Not dr.IsDBNull(10) Then tr.MalfunctionInfo = dr.GetString(10)
                        If Not dr.IsDBNull(11) Then tr.ReporterList = dr.GetString(11)
                        If Not dr.IsDBNull(12) Then tr.ReportedTo = dr.GetString(12)
                        If Not dr.IsDBNull(13) Then tr.ReportedToTime = dr.GetDateTime(13)
                        If Not dr.IsDBNull(14) Then tr.ArrivalTime = dr.GetDateTime(14)
                        If Not dr.IsDBNull(15) Then tr.ReportedLaw = dr.GetString(15)
                        If Not dr.IsDBNull(16) Then tr.ReportedTimeLaw = dr.GetDateTime(16)
                        If Not dr.IsDBNull(17) Then tr.NotificationList = dr.GetString(17)
                        If Not dr.IsDBNull(18) Then tr.BulletinNumber = dr.GetInt32(18)
                        If Not dr.IsDBNull(19) Then tr.RepairedBy = dr.GetString(19)
                        If Not dr.IsDBNull(20) Then tr.RepairTime = dr.GetDateTime(20)
                        If Not dr.IsDBNull(21) Then tr.MalfunctionCause = dr.GetString(21)
                        If Not dr.IsDBNull(22) Then tr.RepairInfo = dr.GetString(22)
                        If Not dr.IsDBNull(23) Then tr.ClearedBy = dr.GetString(23)
                        If Not dr.IsDBNull(24) Then tr.MalfunctionSubType = dr.GetString(24)
                        If Not dr.IsDBNull(25) Then tr.TerritoryID = dr.GetInt32(25)
                        If Not dr.IsDBNull(26) Then tr.CrossingProtection = dr.GetString(26)
                        If Not dr.IsDBNull(27) Then tr.CrossingProtectionInfo = dr.GetString(27)
                        If Not dr.IsDBNull(28) Then tr.ReportID = dr.GetString(28)
                        If Not dr.IsDBNull(29) Then tr.tStamp = dr.GetDateTime(29)
                        If Not dr.IsDBNull(30) Then tr.Link = dr.GetString(30)
                        If Not dr.IsDBNull(31) Then tr.ReferenceNumber = dr.GetInt32(31)
                        If Not dr.IsDBNull(32) Then tr.SubdivisionName = dr.GetString(32)
                        If Not dr.IsDBNull(33) Then tr.SubdivisionUID = dr.GetString(33)
                        If Not dr.IsDBNull(34) Then tr.ControlPointName = dr.GetString(34)
                        If Not dr.IsDBNull(35) Then tr.ControlPointUID = dr.GetString(35)
                        If Not dr.IsDBNull(36) Then tr.DeviceName = dr.GetString(36)
                        If Not dr.IsDBNull(37) Then tr.DeviceUID = dr.GetString(37)
                        If Not dr.IsDBNull(38) Then tr.IncidentType = dr.GetString(38) : tr.ReportType = dr.GetString(38)
                        If Not dr.IsDBNull(39) Then tr.IncidentSubType = dr.GetString(39)
                        If Not dr.IsDBNull(40) Then tr.TrackName = dr.GetString(40)
                        If Not dr.IsDBNull(41) Then tr.TroubleDescription = dr.GetString(41)
                        If Not dr.IsDBNull(42) Then tr.AdditionalInformation = dr.GetString(42)
                        If Not dr.IsDBNull(43) Then tr.TrainDelayUIDReferences = dr.GetString(43)

                        If dr.FieldCount >= 51 Then
                            If Not dr.IsDBNull(44) Then tr.XingProtectionProvided = dr.GetString(44)
                            If Not dr.IsDBNull(45) Then tr.XingTrainNotificationList = dr.GetString(45)
                            If Not dr.IsDBNull(46) Then tr.XingLocationState = dr.GetString(46)
                            If Not dr.IsDBNull(47) Then tr.XingLocationSubUID = dr.GetString(47)
                            If Not dr.IsDBNull(48) Then tr.XingLocationCity = dr.GetString(48)
                            If Not dr.IsDBNull(49) Then tr.XingLocationMilePost = dr.GetString(49)
                            If Not dr.IsDBNull(50) Then tr.XingLocationDOT = dr.GetString(50)
                        End If
                        If dr.FieldCount >= 52 Then
                            If Not dr.IsDBNull(51) Then tr.EnrouteDetails = dr.GetString(51)
                            If Not dr.IsDBNull(52) Then tr.TrainSymbol = dr.GetString(52)
                        End If
                        If dr.FieldCount >= 54 Then
                            If Not dr.IsDBNull(53) Then tr.UpdatedBy = dr.GetString(53)
                            If Not dr.IsDBNull(54) Then Date.TryParse(dr.GetValue(54), tr.UpdateTime)
                        End If
                        If dr.FieldCount >= 56 Then
                            If Not dr.IsDBNull(55) Then tr.EnrouteHeader = dr.GetString(55)
                        End If
                        If dr.FieldCount >= 57 Then
                            If Not dr.IsDBNull(56) Then tr.EventsList = dr.GetString(56)
                        End If


                        If Not TMDS.GlobalDeclarations.gTroubleReports.Contains(tr) Then TMDS.GlobalDeclarations.gTroubleReports.Add(tr)
                    End While
                    dr.Close()
                    DbConn.Close()
                End Using

                Dim SummItem As New SummaryItem("TROUBLEREPORT", "REFRESH", Nothing)
                SyncLock TMDS.GlobalDeclarations.gSummaryTroubleReportQueue.SyncRoot
                    TMDS.GlobalDeclarations.gSummaryTroubleReportQueue.Enqueue(SummItem)
                End SyncLock
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If DatabaseCommand IsNot Nothing Then DatabaseCommand.Dispose()
                DatabaseCommand = Nothing
                If dr IsNot Nothing Then dr = Nothing
            End Try
        End Sub
