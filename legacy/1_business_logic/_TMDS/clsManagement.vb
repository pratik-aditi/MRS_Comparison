        End Sub

        Private Shared Sub ProcessMA_2061_TWC_CreateMessageAction(ByVal MessageResponse As String, ByVal sfa As SFAuthority)
            Try
                Select Case MessageResponse
                    Case "ACCEPTED"
                        sfa.PTCStatus = "AUTHORITY-ACTIVATED"
                        If optUseSingleFormAuthorityVersionIII Then 'AndAlso Not optEnableCPSpecificPTCOperations
                            Dim s As String = ""
                            Try
                                If sfa.Box1Void.Count > 0 Then
                                    Dim auth As TMDS.TrackAuthority.SFAuthority = Nothing
                                    For Each s In sfa.Box1Void
                                        If s.Trim <> "" Then
                                            auth = Nothing
                                            auth = TMDS.SystemUtilities.FetchData.FindSFA(s)
                                            If auth IsNot Nothing Then
                                                auth.AutoRemoveAuthorityPTC()
                                            End If
                                        End If
                                    Next
                                End If
                            Catch ex As Exception
                                GetErrorDetails(ex)
                            End Try
                        ElseIf optEnableARRCSpecificPTCOperations Then
                            Dim s As String = ""
                            Try
                                If sfa.Box1Void.Count > 0 AndAlso gEnableIncludeVoidAuthorityIn1051 Then
                                    Dim auth As TMDS.TrackAuthority.SFAuthority = Nothing
                                    For Each s In sfa.Box1Void
                                        If s.Trim <> "" Then
                                            auth = Nothing
                                            auth = TMDS.SystemUtilities.FetchData.FindSFA(s)
                                            If auth IsNot Nothing Then
                                                auth.RemoveSFAAuthorityPTC()
                                                auth.PTCIssuanceSuccessful = True
                                                auth.CheckToAcknowledgeAlert()
                                                auth.PTCTransmissionCompleted()
                                            End If
                                        End If
                                    Next
                                End If
                            Catch ex As Exception
                                GetErrorDetails(ex)
                            End Try
                        End If

                        sfa.PTCIssuanceSuccessful = True
                        sfa.CheckToAcknowledgeAlert()
                        sfa.PTCTransmissionCompleted()


                    Case "REJECTED"
                        sfa.PTCIssuanceSuccessful = False
                        sfa.VETMS_GenerateIssuanceRejection()
                        sfa.PTCStatus = "AUTHORITY-FAILED"
                        sfa.SetPTCAuthorityFlasherStatus()
                        sfa.FlasherMode(False)
                        SystemEvent("AUTHORITY REJECTED FROM MA-1061 MESSAGE RECEIPT: " & sfa.AuthorityUID)
                End Select
                If sfa.UpdateDatabaseWithPTCAuthorityStatus(sfa.PTCStatus) Then
                    SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_1053_TWC_CreateMessageAction-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub ProcessMA_2061_TWC_ReleaseMessageAction(ByVal MessageResponse As String, ByVal sfa As SFAuthority)
            Try
                Select Case MessageResponse
                    Case "ACCEPTED"
                        If sfa.PTCMarkedToBeVoidedElectronically Then
                            If optUseSingleFormAuthorityVersionIII Then
                                If optEnableCPSpecificOptions Then
                                    sfa.PTCAuthorityACKPending = ""
                                    sfa.PTCStatus = "RELEASE-SUCCESSFUL"
                                    sfa.UpdateDatabaseWithPTCAuthorityStatus(sfa.PTCStatus)
                                    sfa.UpdateDatabaseWithPTCComponents()
                                    sfa.VETMS_StopTimerReleaseEvent()
                                    sfa.CheckToAcknowledgeAlert()
                                    If sfa.Box4NormalSwitchRptOnReleasePTC.Trim <> "" Then sfa.UpdateSFABox4SwitchRptOnRelease()
                                End If
                                sfa.FlasherMode(False)
                                SystemEvent("TWC AUTHORITY REMOVAL ACCEPTED FROM MA-2061 MESSAGE RECEIPT: " & sfa.AuthorityUID)
                                If sfa.RemoveSFAVIIIAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                    If sfa.RemoveAuthorityFromComponents() Then
                                        sfa.PTCStatus = "RELEASE-SUCCESSFUL"
                                        TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(sfa)
                                        Dim SummItem2 As New SummaryItem("AUTHORITY", "REMOVE", sfa)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem2)
                                        End SyncLock
                                        SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_2061_TWC_ReleaseMessageAction-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                                        sfa.PTCTransmissionCompleted()
                                        sfa = Nothing
                                    End If
                                End If
                            Else
                                If sfa.RemoveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                    If sfa.RemoveAuthorityFromComponents(False) Then
                                        TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(sfa)
                                        Dim SummItem2 As New SummaryItem("AUTHORITY", "REMOVE", sfa)
                                        SyncLock gSummaryAuthQueue.SyncRoot
                                            gSummaryAuthQueue.Enqueue(SummItem2)
                                        End SyncLock
                                        sfa.PTCStatus = "RELEASE-SUCCESSFUL"
                                        sfa.PTCIssuanceSuccessful = True
                                        sfa.CheckToAcknowledgeAlert()
                                        sfa.PTCTransmissionCompleted()
                                        sfa.FlasherMode(False)
                                        SystemEvent("TWC AUTHORITY REMOVAL ACCEPTED FROM MA-2061 MESSAGE RECEIPT: " & sfa.AuthorityUID)
                                    End If
                                End If
                            End If
                            If sfa IsNot Nothing Then sfa.PTCTransmissionCompleted()

                        End If
                    Case "REJECTED"
                        sfa.PTCStatus = "RELEASE-FAILED"
                        sfa.FlasherMode(False)
                        SystemEvent("TWC AUTHORITY REMOVAL REJECTED FROM MA-1061 MESSAGE RECEIPT: " & sfa.AuthorityUID)
                    Case "FAILED"
                        sfa.PTCStatus = "RELEASE-FAILED"
                        sfa.FlasherMode(False)
                        SystemEvent("TWC AUTHORITY REMOVAL REJECTED FROM MA-1061 MESSAGE RECEIPT: " & sfa.AuthorityUID)
                End Select

                If sfa IsNot Nothing AndAlso sfa.UpdateDatabaseWithPTCAuthorityStatus(sfa.PTCStatus) Then
                    SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_1053_TWC_ReleaseMessageAction-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub ProcessMA_2061_TWC_RollupMessageAction(ByVal MessageResponse As String, ByVal sfa As SFAuthority)
            Try
                If sfa.PTCMarkedToBeRolledUpElectronically Then
                    Select Case MessageResponse
                        Case "ACTIVATED", "ACCEPTED"
                            sfa.PTCStatus = "RELEASE-SUCCESSFUL"
                            If optUseSingleFormAuthorityVersionIII Then
                                If sfa.UpdateDatabaseWithPTCAuthorityStatus(sfa.PTCStatus) Then
                                    SystemEvent("PTCMessages-ProcessDeliveryConfirmation-UpdateDatabaseWithPTCTextualStatus-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                                End If
                                sfa.SetPTCAuthorityFlasherStatus()
                                sfa.FlasherMode(False)
                                SystemEvent("AUTHORITY rollup FROM MA-2052 MESSAGE RECEIPT: " & sfa.AuthorityUID)
                            Else
                                If sfa.UpdateDatabaseWithPTCAuthorityStatus(sfa.PTCStatus) Then
                                    SystemEvent("PTCMessages-ProcessDeliveryConfirmation-UpdateDatabaseWithPTCTextualStatus-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                                End If
                                sfa.SetPTCAuthorityFlasherStatus()
                                sfa.FlasherMode(False)
                                SystemEvent("AUTHORITY rollup FROM MA-2052 MESSAGE RECEIPT: " & sfa.AuthorityUID)
                            End If
                            sfa.PTCRollupSuccessful = True
                            sfa.PTCTransmissionCompleted()
                            SystemEvent("AUTHORITY rollup FROM MA-2052 MESSAGE RECEIPT: " & sfa.AuthorityUID)
                            sfa.CheckToAcknowledgeAlert()
                        Case "REJECTED"
                            sfa.PTCStatus = "RELEASE-REJECTED"
                            sfa.FlasherMode(False)
                            SystemEvent("TWC AUTHORITY REMOVAL REJECTED FROM MA-1061 MESSAGE RECEIPT: " & sfa.AuthorityUID)
                    End Select

                    If sfa.UpdateDatabaseWithPTCAuthorityStatus(sfa.PTCStatus) Then
                        SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_1051_TWC_RollupMessageResponse-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                    End If

                    sfa.SetPTCAuthorityFlasherStatus()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
