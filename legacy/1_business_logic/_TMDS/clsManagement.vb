                    '            .EmployeeType = dr.GetString(14)
                    '        End If
                    '    End If
                    '    If dr.FieldCount >= 16 Then
                    '        If Not dr.IsDBNull(15) Then
                    '            .JobType = dr.GetString(15)
                    '        End If
                    '    End If
                    Application.DoEvents()
