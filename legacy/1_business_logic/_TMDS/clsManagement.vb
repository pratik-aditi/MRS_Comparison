                'End If

                theMileageRange = TMDS.SystemUtilities.FetchData.FindMileageRange(MilePostBegin, MilePostPrefix, MilePostSuffix)

                If mySubUID = 0 Then
                    If Not IsNothing(theMileageRange) Then
                        thisSubdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(theMileageRange.mySubdivisionUID)
                        If thisSubdivision Is Nothing Then
