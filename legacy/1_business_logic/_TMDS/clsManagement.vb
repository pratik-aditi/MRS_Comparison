        Private Shared Function FindTrainSheetTable(ByVal TrainSheetGuid As String) As String
            Dim TrainFetch As String
            Dim dbconn As OleDbConnection = Nothing
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseTable As String = String.Empty
            TrainFetch = "SELECT ActiveSubTrainSheet FROM tblTrainsActiveSubTrainSheets "
            TrainFetch = TrainFetch & " WHERE ActiveSubTrainSheet = '" & TrainSheetGuid & "'"
            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                dbcomm = New OleDbCommand(TrainFetch, dbconn)
                dbconn.Open()
                dr = dbcomm.ExecuteReader()
                While dr.Read
                    If Not dr.IsDBNull(0) Then
                        If TrainSheetGuid = dr.GetString(0) Then
                            DatabaseTable = "tblTrainsActiveSubTrainSheets"
                            Exit While
                        End If
                    End If
                End While
                'dbconn.Close()
                'dbconn = Nothing
                Return DatabaseTable

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                If Not dbconn Is Nothing Then
                    If dbconn.State = ConnectionState.Open Then dbconn.Close()
                    dbconn.Dispose()
                    dbconn = Nothing
                End If
                If Not dr Is Nothing Then
                    dr.Close()
                    dr = Nothing
                End If
                If Not dbcomm Is Nothing Then
                    dbcomm.Dispose()
                    dbcomm = Nothing
                End If
            End Try
        End Function

        Private Shared Function CheckForDupMOW(ByVal FirstName As String, ByVal LastName As String) As Boolean
            Try
                Dim frm As Foreman
                For Each frm In gMowForemen
                    If frm.FirstName.Trim.ToUpper = FirstName.Trim.ToUpper And frm.LastName.Trim.ToUpper = LastName.Trim.ToUpper Then
                        Return False
                    End If
                Next
                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Public Shared Sub ProcessFaxAlert(ByVal messageToProcess As String)

            Try
                DebugEvent("ProcessFaxAlert:" & messageToProcess)
                TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.FAXYellowAlert, messageToProcess, Nothing, Nothing)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub


    End Class

