        Public Function CheckIfGTBNoExisitsInDB(ByVal iBullNumber As Integer) As Boolean
            Dim ActiveSQLQuery As New StringBuilder ' = "SELECT GTBNumber FROM [tblGeneralBulletinsActive] WHERE [AtSubdivision]='" & SubName & "' ORDER BY GTBDate DESC"
            Dim InActiveSQLQuery As New StringBuilder
            Dim ExistsInActive As Boolean = False
            Dim ExistsInInActive As Boolean = False
            With ActiveSQLQuery
                .Append("SELECT GTBNumber FROM [tblGeneralBulletinsActive] WHERE ")
                .Append("  GTBNumber=" & iBullNumber)
                '.Append(" AND CAST(CONVERT(CHAR(10), GTBDate,101)AS DATETIME) >= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                '.Append(" AND CAST(CONVERT(CHAR(10), GTBDate,101)AS DATETIME) <= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                .Append("ORDER BY GTBDate DESC")
            End With
            With InActiveSQLQuery
                .Append("SELECT GTBNumber FROM [tblGeneralBulletinsInActive] WHERE ")
                .Append("  GTBNumber=" & iBullNumber)
                .Append(" AND CAST(CONVERT(CHAR(10), GTBDate,101)AS DATETIME) >= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                .Append(" AND CAST(CONVERT(CHAR(10), GTBDate,101)AS DATETIME) <= CAST(CONVERT(CHAR(10),'" & Now.Date & "',101)AS DATETIME)")
                .Append("ORDER BY GTBDate DESC")
            End With

            Dim ds As New DataSet
            Try
                ds = GetResultDS(ActiveSQLQuery.ToString, False)
                If IsValidDataset(ds) Then ExistsInActive = True
                ds = New DataSet
                ds = GetResultDS(InActiveSQLQuery.ToString, False)
                If IsValidDataset(ds) Then ExistsInActive = True
                If ExistsInActive OrElse ExistsInInActive Then Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            Finally
                ds = Nothing
                ActiveSQLQuery = New StringBuilder
                InActiveSQLQuery = New StringBuilder
            End Try
            Return False

        End Function

