        Public Sub RetrieveBulletin(theGUID As String)
            Try
                Dim dbconn As OleDbConnection = Nothing
                Dim dbcomm As OleDbCommand = Nothing
                Dim dr As OleDbDataReader = Nothing
                Dim subdvn As Subdivision

                Dim Query As String = "SELECT * FROM tblSystemBulletins WHERE SystemUID = '" & theGUID & "'"
                dbconn = New OleDbConnection(gConnectionStringBulletin)
                dbconn.Open()
                dbcomm = New OleDbCommand(Query, dbconn)
                dr = dbcomm.ExecuteReader
                While dr.Read

                    Dim TypeOfBull As String = String.Empty
                    Dim LoadBulletin As Boolean = True

                    If CheckSubBulletinExistsInArray(TMDS.GlobalDeclarations.BulletinCollection, dr.GetString(0)) Then
                        LoadBulletin = False
                    End If


                    If LoadBulletin Then
                        Dim sb As New SubBulletin

                        If Not dr.IsDBNull(25) Then sb.SubUID = Trim(dr.GetString(25)).ToUpper
                        subdvn = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(sb.SubUID)
                        sb.thisSubdivision = subdvn
                        If Not dr.IsDBNull(0) Then sb.myGUID = dr.GetString(0)
                        If Not dr.IsDBNull(1) Then sb.myUID = dr.GetInt32(1)
                        If Not dr.IsDBNull(2) Then sb.theType = dr.GetString(2)
                        Select Case sb.theType
                            Case "CANCEL"
                                sb.myType = BulletinType.CANCEL
                                sb.mysType = "CANCEL"
                            Case "SPEED", "SPEED RESTRICTION"
                                sb.myType = BulletinType.SPEED
                                sb.mysType = sb.theType
                            Case "WORKZONE"
                                sb.myType = BulletinType.WORKZONE
                                sb.mysType = "WORKZONE"
                            Case "INFORMATIONAL", "MISC"
                                sb.myType = BulletinType.INFORMATIONAL
                                sb.mysType = sb.theType '"INFORMATIONAL"
                            Case "CONDITION"
                                sb.myType = BulletinType.CONDITION
                                sb.mysType = "CONDITION"
                            Case Else
                                If Mid(sb.theType, 1, 6) = "CANCEL" Then
                                    sb.myType = BulletinType.CANCEL
                                    sb.mysType = sb.theType
                                End If
                        End Select
                        If Not dr.IsDBNull(3) Then sb.EffectTime = dr.GetDateTime(3)
                        If Not dr.IsDBNull(3) Then sb.Created = dr.GetDateTime(3)
                        If Not dr.IsDBNull(5) Then sb.SubName = dr.GetString(5)
                        If Not dr.IsDBNull(6) Then sb.myData = dr.GetString(6)
                        If Not dr.IsDBNull(7) Then sb.myDataSupplement = dr.GetString(7)
                        If Not dr.IsDBNull(8) Then sb.BullUID = dr.GetString(8)
                        If Not dr.IsDBNull(9) Then sb.MilePostBegin = dr.GetString(9)
                        If Not dr.IsDBNull(10) Then sb.MilePostEnd = dr.GetString(10)
                        If Not dr.IsDBNull(11) Then sb.TrackType = dr.GetString(11)
                        If Not dr.IsDBNull(12) Then sb.TrackName = dr.GetString(12)
                        If Not dr.IsDBNull(13) Then sb.MessageTrnFrght = dr.GetString(13)
                        If Not dr.IsDBNull(15) Then sb.MessageTrnPassg = dr.GetString(15)
                        If Not dr.IsDBNull(14) Then sb.SpeedFrght = dr.GetInt32(14)
