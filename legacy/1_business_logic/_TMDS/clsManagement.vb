        ''' <summary>
        ''' Process Locomotive Route List Request Message
        ''' </summary>
        ''' <param name="pData"></param>
        Public Shared Sub ProcessLocomotiveRouteListRequestMessage(ByVal pData As String)
            Dim dataString() As String
            Dim symbol As String
            Dim thisTrain As TrainID
            Try
                dataString = pData.Split("|")
                symbol = dataString(0)
                thisTrain = FindTrainBySymbol(symbol)
                If Not thisTrain.MZEnabled Then
                    thisTrain.VETMS_GenerateAlertRouteRequest(pData)
                Else
                    ProcessLocomotiveRouteListRequest(thisTrain)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                dataString = Nothing
                symbol = Nothing
                thisTrain = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Process Locomotive Route List Request
        ''' </summary>
        ''' <param name="pTrain"></param>
        Public Shared Sub ProcessLocomotiveRouteListRequest(ByVal pTrain As TrainID)
            Dim thisTrain As TrainID = pTrain
            Dim routeTextValue As String = String.Empty
            Dim routeText As New StringBuilder
            Dim theSignalRouteInFrontOfTrain As ArrayList
            Dim s As SignalRoute
            Dim sr As New ArrayList
            Dim sig As Signal = Nothing
            Dim trueExitSignal As Signal = Nothing
            Dim comp As Object = Nothing
            Dim loopcontrol As Integer = 10
            Dim i As Integer = 0
            Dim compAux As Object
            Dim DoNotAddToList As Boolean
            Try
                thisTrain.MZEnabled = True
                theSignalRouteInFrontOfTrain = thisTrain.GetSignalRoutesInFrontOfTrack(thisTrain.myTrack)
                thisTrain.MZListOFRoutes.Clear()
                For Each s In theSignalRouteInFrontOfTrain
                    compAux = s.ComponentList(s.ComponentList.Count - 1)
                    Dim trk As Track = Nothing
                    If compAux.GetType.ToString = gTrackComponentName Then
                        trk = s.ComponentList(s.ComponentList.Count - 1)
                    Else
                        If s.ComponentList.Count > 1 Then
                            compAux = s.ComponentList(s.ComponentList.Count - 2)
                            If compAux.GetType.ToString = gTrackComponentName Then
                                trk = s.ComponentList(s.ComponentList.Count - 2)
                            Else
                                SystemEvent("ProcessLocomotiveRouteListRequest:Track not found:Train=" & thisTrain.Name)
                                Continue For
                            End If
                        End If
                    End If
                    Dim loopcontrolChecker As Integer = 0
                    Dim foundFlipFlop As Boolean
                    Dim nextComp As Object = Nothing
                    DoNotAddToList = False
                    If s.myDirection = "RIGHT" Then
                        comp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(trk.RightLink)
                        If Not IsNothing(comp) Then
                            Do While comp.GetType.ToString <> gSignalComponentName
                                If loopcontrolChecker = loopcontrol Then
                                    Exit Sub
                                Else
                                    If Not foundFlipFlop Then
                                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(comp.RightLink)
                                        If nextComp.GetType.ToString = gFlipFlopComponentName Then
                                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(comp.LeftLink)
                                            foundFlipFlop = True
                                        End If
                                        comp = nextComp
                                    Else
                                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(comp.LeftLink)
                                        comp = nextComp
                                    End If
                                End If
                                loopcontrolChecker += 1
                            Loop
                            trueExitSignal = comp
                            s.TrueExitSignal = trueExitSignal
                        Else
                            DoNotAddToList = True
                        End If
                    Else
                        comp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(trk.LeftLink)
                        If Not IsNothing(comp) Then
                            Do While comp.GetType.ToString <> gSignalComponentName
                                If loopcontrolChecker = loopcontrol Then
                                    Exit Sub
                                Else
                                    If Not foundFlipFlop Then
                                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(comp.LeftLink)
                                        If nextComp.GetType.ToString = gFlipFlopComponentName Then
                                            nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(comp.Rightlink)
                                            foundFlipFlop = True
                                        End If
                                        comp = nextComp
                                    Else
                                        nextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(comp.RightLink)
                                        comp = nextComp
                                    End If
                                End If
                                loopcontrolChecker += 1
                            Loop
                            trueExitSignal = comp
                            s.TrueExitSignal = trueExitSignal
                        Else
                            DoNotAddToList = True
                        End If
                    End If
                    If Not DoNotAddToList Then
                        If gEnableManeuverZone Then
                            'routeTextValue = s.EntrySignal.myToolTip & "-" & FindTrackName(s.EntrySignal) & "->" & trueExitSignal.myToolTip & "-" & FindTrackName(trueExitSignal)
                            'routeTextValue = routeTextValue.Replace("VIRTUAL", "V")
                            Dim directionAux As String
                            Select Case s.myDirection
                                Case "RIGHT"
                                    directionAux = "SUBINDO"
                                Case "LEFT"
                                    directionAux = "DESCENDO"
                                Case Else
                                    directionAux = "NENHUMA"
                            End Select
                            routeTextValue = directionAux & "-" & FindTrackName(s.EntrySignal) & "->" & FindTrackName(trueExitSignal)
                            'Max len allowed by onboard is 78 ch
                            If routeTextValue.Length > 78 Then
                                routeTextValue = routeTextValue.Substring(0, 78)
                            End If
                        Else
                            routeTextValue = s.EntrySignal.Name.ToString & " PARA " & trueExitSignal.Name
                        End If
                        routeText.Append(routeTextValue)
                        routeText.Append("~")
                        thisTrain.MZListOFRoutes.Add(theSignalRouteInFrontOfTrain(i))
                        SystemEvent("ProcessLocomotiveRouteListRequest:routeText=" & routeTextValue & ":CountChar=" & routeTextValue.Length.ToString)
                    End If
                    i += 1
                Next
                TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_RouteResponse(thisTrain, routeText.ToString)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Find Track Name
        ''' </summary>
        ''' <param name="pSignal"></param>
        ''' <returns></returns>
        Private Shared Function FindTrackName(ByVal pSignal As Signal) As String
            Dim trackName As String = String.Empty
            Dim trk As Track
            Try
                Select Case pSignal.ComponentType
                    Case "L"
                        trk = FindTrackFromGUID(pSignal.RightLink)
                        If trk Is Nothing Then
                            trk = FindTrackFromGUID(pSignal.LeftLink)
                        End If
                        trackName = trk.TrackNameAlias
                    Case "R"
                        trk = FindTrackFromGUID(pSignal.LeftLink)
                        If trk Is Nothing Then
                            trk = FindTrackFromGUID(pSignal.RightLink)
                        End If
                        trackName = trk.TrackNameAlias
                    Case Else
                        Return trackName
                End Select
                Return trackName
            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty
            End Try
        End Function

