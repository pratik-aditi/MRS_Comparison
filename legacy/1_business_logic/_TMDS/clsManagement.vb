        Private Shared Sub RemoveTGBO(ByVal tgbo As TabularGeneralBulletin)
            Dim sb As SubBulletin = Nothing
            Try
                If IsNothing(tgbo) Then Exit Sub
                Dim theTGBOSystemUID As String = tgbo.SystemUID
                gTabularGeneralBulletins.Remove(tgbo)
                If optEnableARRCSpecificOptions Then
                    SystemEvent("ProcessBulletinMessageTGBO-REMOVE_Reloading Bulletin Status state: " & tgbo.UID)
                    Dim BullUIDCollection As New ArrayList
                    Try
                        BullUIDCollection = TMDS.SystemUtilities.BulletinFunction.GetAllBulletinsUID(tgbo.BulletinListDefinitions)
                        If tgbo.ExceptionListDefinitions IsNot Nothing AndAlso tgbo.ExceptionListDefinitions.Trim <> "" Then
                            Dim ExistingExp() As String = tgbo.ExceptionListDefinitions.Split("|")
                            Dim s As String
                            Dim ExpExist As Boolean = False
                            Dim tmpExpArr As New ArrayList
                            For Each s In ExistingExp
                                Dim SubSplt() As String = s.Split(";")
                                If SubSplt.GetUpperBound(0) > 0 Then
                                    If Not BullUIDCollection.Contains(SubSplt(0)) Then BullUIDCollection.Add(SubSplt(0))
                                End If
                            Next

                        End If
                        If BullUIDCollection IsNot Nothing AndAlso BullUIDCollection.Count > 0 Then
                            For Each sb In BulletinCollection
                                If BullUIDCollection.Contains(sb.myGUID) Then
                                    sb.ReloadThisGBOStatus()
                                End If
                            Next
                        End If
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    Finally
                        BullUIDCollection = Nothing
                    End Try
                End If
                SystemEvent("ProcessBulletinMessageTGBO-REMOVE:" & tgbo.UID)
                Dim SummItem As New SummaryItem("TGBO", "REFRESH", tgbo, "Manage_PRemoveTGBO")
                SyncLock gSubBulletinsMessageSummaryQueue.SyncRoot
                    gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                End SyncLock
                If tgbo.TypeOfBulletin = "TGBO-TRAIN" Then
                    tgbo.RemoveExceptionsFromGBO()
                    tgbo.UnAssignFromTrain()
                    tgbo.RemoveTrainSpecificBulletins()

                ElseIf tgbo.TypeOfBulletin = "TGBO-MOW" Then
                    tgbo.RemoveExceptionsFromGBO()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

