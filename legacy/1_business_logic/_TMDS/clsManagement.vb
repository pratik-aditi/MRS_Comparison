        Public Function GetNextAuthorityNumber() As Int32
            Try
                Dim Unique As Boolean = False
                Dim LoopControl As Integer

                If Me.LastGetAuthorityEvent.Date < Now.Date.AddDays(-1) Then
                    Me.UpdateAuthorityEvent()
                    'CheckForPreviousDayLowestNumber()
                    Me.LastGetAuthorityEvent = Now
                    CurrentAuthorityNumber = Me.AuthorityNumberRange
                End If

                While Not Unique
                    If CurrentAuthorityNumber >= Me.AuthorityNumberFactor + Me.AuthorityNumberRange Then
                        CurrentAuthorityNumber = Me.AuthorityNumberRange + 1
                    Else
                        If CurrentAuthorityNumber = 0 Then
                            CurrentAuthorityNumber = Me.AuthorityNumberRange
                        ElseIf CurrentAuthorityNumber < Me.AuthorityNumberRange Then
                            CurrentAuthorityNumber = Me.AuthorityNumberRange
                        Else
                            CurrentAuthorityNumber = CurrentAuthorityNumber + 1
                        End If
                        If Me.PreviousAuthorityNumberReleased = CurrentAuthorityNumber Then
                            CurrentAuthorityNumber = CurrentAuthorityNumber + 1
                            If CurrentAuthorityNumber >= Me.AuthorityNumberFactor + Me.AuthorityNumberRange Then
                                CurrentAuthorityNumber = Me.AuthorityNumberRange + 1
                            ElseIf CurrentAuthorityNumber < Me.AuthorityNumberRange Then
                                CurrentAuthorityNumber = Me.AuthorityNumberRange + 1
                            End If
                        End If
                    End If

                    If CurrentAuthorityNumber < Me.AuthorityNumberRange Then
                        CurrentAuthorityNumber = Me.AuthorityNumberFactor + Me.AuthorityNumberRange - 10
                    End If

                    If CheckAllAuthorityTypeNumbers(CurrentAuthorityNumber) Then
                        Dim PerformUpdateAuthorityNumber As New DoUpdateAuthorityNumber(AddressOf Me.UpdateAuthorityNumber)
                        PerformUpdateAuthorityNumber.BeginInvoke(Nothing, Nothing)
                        Return CurrentAuthorityNumber
                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl >= Me.AuthorityNumberFactor Then
                        SystemException("GetNextAuthorityNumber Failed on LoopControl. CurrentAuthorityNumber=" & CurrentAuthorityNumber)
                        Return 0
                    End If
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function
