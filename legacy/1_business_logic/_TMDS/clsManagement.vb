        Public Sub FindTrackComponents()
            'FROM BLUFORD MP 0 TO BLUFORD MP 15
            Try
                Dim seg As String

                For Each seg In Me.TrackSegmentString.Split(":")
                    SystemEvent("Weather-FindTrackComponents-SEG:" & seg)

                    Dim data() As String = seg.Split("|")
                    Dim SubName As String = GetSubName(data(1))
                    Dim BeginMP As Double = CDbl(GetMilePost(data(1)))
                    Dim EndMP As Double = CDbl(GetMilePost(data(3)))
                    Dim SubUID As Int32
                    Dim s As Subdivision
                    For Each s In ControlledSubdivisions
                        If s.WeatherDataDesignation = SubName Then
                            SubUID = s.GUID
                            Exit For
                        End If
                    Next
                    Dim trk As Track
                    For Each trk In TrackCollection
                        If trk.SubdivisionID = SubUID Then

                            If trk.LeftLimitMilePost <= BeginMP And trk.RightLimitMilePost >= EndMP Then
                                If Not ComponentList.Contains(trk) Then
                                    ComponentList.Add(trk)
                                End If
                            ElseIf trk.LeftLimitMilePost >= BeginMP And trk.RightLimitMilePost <= EndMP Then
                                If Not ComponentList.Contains(trk) Then
                                    ComponentList.Add(trk)
                                    SystemEvent("Weather-FindTrackComponents-LL:" & trk.LeftLimitMilePost & " Weather-FindTrackComponents-RL:" & trk.RightLimitMilePost)

                                End If
                            End If
                        End If
                    Next
                Next
                Me.TrackSegmentString = Me.TrackSegmentString.Replace("|", "")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Private Function GetSubName(ByVal StringToTest As String) As String
            Try
                Dim i As Integer
                Dim NewString As String = String.Empty
                For i = 1 To StringToTest.Length
                    If Mid(StringToTest, i, 3) = "MP " Then
                        Return Trim(NewString)
                    Else
                        NewString = NewString & Mid(StringToTest, i, 1)
                    End If
                Next
                Return NewString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty
            End Try
        End Function

        Private Function GetMilePost(ByVal StringToTest As String) As String
            Try
                Dim i As Integer
                Dim NewString As String = String.Empty
                Dim NumericFound As Boolean
                For i = 1 To StringToTest.Length
                    If Mid(StringToTest, i, 3) = "MP " Then
                        NumericFound = True
                        i += 2
                    ElseIf NumericFound Then
                        If Not IsNumeric(Mid(StringToTest, i, 1)) Then
                            Return NewString
                        Else
                            NewString = NewString & Mid(StringToTest, i, 1)
                        End If
                    End If
                Next
                Return NewString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty
            End Try
        End Function

