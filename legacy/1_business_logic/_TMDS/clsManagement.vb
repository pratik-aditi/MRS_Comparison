                Dim trk As Track
                For Each trk In TMDS.GlobalDeclarations.TrackCollection
                    If trk.TrainIDs.Count > 0 Then
                        Dim trn As TrainID
                        For Each trn In trk.TrainIDs
                            If (Trim(trn.TrainGUID) = Trim(TrainGUID)) And (ExcludeTrack.GUID <> trk.GUID) Then
