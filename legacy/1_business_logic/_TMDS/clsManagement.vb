        Public Sub DeleteBulletin(theGUID As String)
            Try
                Dim sb As SubBulletin
                Dim myCurrentBulletin As SubBulletin = Nothing

                For Each sb In BulletinCollection
                    If sb.myGUID = theGUID Then
                        myCurrentBulletin = sb
                        Exit For
                    End If
                Next
                If IsNothing(myCurrentBulletin) Then Exit Sub
                myCurrentBulletin.RemoveDisplayBulletinOnTrackLine()
                myCurrentBulletin.thisSubdivision.BulletinList.Remove(myCurrentBulletin)
                BulletinCollection.Remove(myCurrentBulletin)
                myCurrentBulletin.DoCheckToDisableSlideZoneDisplay()
                If optEnableARRCSpecificOptions Then InitializeExceptionForTGBORecords()
                Dim SummItem As New SummaryItem("SUB-BULLETIN", "REMOVE", myCurrentBulletin, "Manage_RemoveGBO")
                SyncLock gSubBulletinsMessageSummaryQueue.SyncRoot
                    gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

#Region " SHADOW MODE BULLETIN UPDATE "
        Public Sub UpdateBulletin(theGUID As String, BullStatus As String)
            Try
                Dim sb As SubBulletin
                Dim myCurrentBulletin As SubBulletin = Nothing

                For Each sb In BulletinCollection
                    If sb.myGUID = theGUID Then
                        myCurrentBulletin = sb
                        Exit For
                    End If
                Next
                If IsNothing(myCurrentBulletin) Then Exit Sub
                If optEnableARRCSpecificOptions Then
                    UpdateBulletinExecp(theGUID, "")
                End If
                myCurrentBulletin.myStatus = BullStatus.Trim.ToUpper
                Dim SummItem As New SummaryItem("SUB-BULLETIN", "UPDATE", myCurrentBulletin, "Manage_UpdateGBO")
                SyncLock gSubBulletinsMessageSummaryQueue
                    gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
        Public Sub UpdateBulletinExecp(theGUID As String, theExpList As String)
            Try
                If Not optEnableARRCSpecificOptions Then Exit Sub
                Dim sb As SubBulletin
                Dim myCurrentBulletin As SubBulletin = Nothing
                Dim tmpBullCollection As New ArrayList
                CopyArrayCollection(tmpBullCollection, BulletinCollection)
                For Each sb In tmpBullCollection
                    If sb.myGUID = theGUID Then
                        myCurrentBulletin = sb
                        Exit For
                    End If
                Next
                If IsNothing(myCurrentBulletin) Then
                    myCurrentBulletin = TMDS.SystemUtilities.BulletinFunction.GetSubBulletinRecordsByUIDFromDB(theGUID)
                    If myCurrentBulletin Is Nothing Then Exit Sub
                End If

                'UpdateExpList(myCurrentBulletin, theExpList)
                ReinitializeExecpList(myCurrentBulletin)
                UpdateBulletinExceptionOtherInformation(myCurrentBulletin)
                InitializeExceptionForTGBORecords()

                Dim SummItem As New SummaryItem("SUB-BULLETIN", "UPDATE", myCurrentBulletin, "Manage_UpdateGBOExp")
                SyncLock gSubBulletinsMessageSummaryQueue
                    gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                End SyncLock
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        Private Sub ReinitializeExecpList(ByRef bull As SubBulletin)
            Dim dr As OleDbDataReader = Nothing
            Dim dbComm As OleDbCommand = Nothing
            Dim SQLQuery As String = "SELECT [ExceptionList] FROM [tblSystemBulletins] WHERE [SystemUID]='" & bull.myGUID & "'"
            Try
                Using dbConn As New OleDbConnection(gConnectionStringBulletin)
                    dbConn.Open()
                    dbComm = New OleDbCommand(SQLQuery, dbConn)
                    dr = dbComm.ExecuteReader
                    If dr.HasRows Then
                        While dr.Read
                            Dim ExceptionList As String = String.Empty
                            If Not dr.IsDBNull(0) Then ExceptionList = Trim(dr.GetValue(0))
                            bull.myExceptionList = CreateExceptionListARRC(ExceptionList, bull)
                        End While
                    End If
                    dr.Close()
                    dbConn.Close()
                End Using

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                dr = Nothing
            End Try
        End Sub

        Private Function CreateExceptionListARRC(ByVal sExceptions As String, ByVal b As SubBulletin) As ArrayList
            Dim ExcepList As New ArrayList
            Try

                If Trim(sExceptions) = "" Then Return ExcepList
                Dim Exceps() As String = sExceptions.Split("|")
                Dim e As String
                For Each e In Exceps
                    Dim data() As String = e.Split(";")
                    If data.Length >= 5 Then
                        Dim ex As New TabularGeneralBulletinException
                        If Not optEnableTGBOOperationsForCP Then
                            With ex
                                ex.SystemUID = data(0)
                                ex.theDesignation = data(1)
                                ex.theTBGOSytemUID = data(2)
                                ex.theTGBORouteCodeName = data(3)
                                ex.theTBGOUID = data(4)
                                ex.theGBOUID = b.myGUID
                                ex.theGBO = b
                                ex.theSubdivision = b.thisSubdivision
                                ex.theSubUID = b.thisSubdivision.GUID
                            End With
                        Else
                            ex = GetInactiveSubBulletinExceptionByGUID(data(0))
                            If ex IsNot Nothing Then
                                ex.theTBGOUID = data(4)
                            End If
                        End If
                        If ex IsNot Nothing Then
                            If Not ExcepList.Contains(ex) Then ExcepList.Add(ex)
                        End If

                    End If
                Next
                Return ExcepList
            Catch exp As Exception
                GetErrorDetails(exp)
                Return Nothing
            End Try
        End Function

        Private Sub UpdateExpList(ByRef bull As SubBulletin, theExpList As String)
            Dim ExceptionList As String = String.Empty
            ExceptionList = theExpList.Replace("$", "|")
            Dim ExcepList As New ArrayList
            Try
                Dim OkToAddExecp As Boolean = True
                If Not String.IsNullOrEmpty(ExceptionList) AndAlso ExceptionList.Trim <> "" Then
                    Dim Exceps() As String = ExceptionList.Split("|")
                    Dim e As String
                    For Each e In Exceps
                        Dim data() As String = e.Split("^")
                        If data.Length >= 5 Then
                            Dim ex As New TabularGeneralBulletinException
                            If Not optEnableTGBOOperationsForCP Then
                                With ex
                                    ex.SystemUID = data(0)
                                    ex.theDesignation = data(1)
                                    ex.theTBGOSytemUID = data(2)
                                    ex.theTGBORouteCodeName = data(3)
                                    ex.theTBGOUID = data(4)
                                    ex.theGBOUID = bull.myGUID
                                    ex.theGBO = bull
                                    ex.theSubdivision = bull.thisSubdivision
                                    ex.theSubUID = bull.thisSubdivision.GUID
                                End With
                            Else
                                ex = GetInactiveSubBulletinExceptionByGUID(data(0))
                                If ex IsNot Nothing Then
                                    ex.theTBGOUID = data(4)
                                End If
                            End If
                            If ex IsNot Nothing Then 'AndAlso Not CheckExpExisit(ex, bull.myExceptionList) 
                                If Not ExcepList.Contains(ex) Then ExcepList.Add(ex)
                            End If
                        End If
                    Next
                End If
                bull.myExceptionList = New ArrayList
                Dim DoAddExceptionToList As Boolean = True
                Dim exp As TabularGeneralBulletinException = Nothing
                If DoAddExceptionToList AndAlso ExcepList IsNot Nothing AndAlso ExcepList.Count > 0 Then

                    For Each exp In ExcepList
                        If Not bull.myExceptionList.Contains(exp) Then bull.myExceptionList.Add(exp)
                    Next
                    UpdateBulletinExceptionOtherInformation(bull)
                End If
                If optEnableARRCSpecificOptions Then InitializeExceptionForTGBORecords()
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

        End Sub

        Private Function CheckExpExisit(expToCheck As TabularGeneralBulletinException, ByVal ExecptionList As ArrayList) As Boolean
            Dim exp As TabularGeneralBulletinException
            Try
                If ExecptionList IsNot Nothing AndAlso ExecptionList.Count > 0 Then
                    For Each exp In ExecptionList
                        If exp.SystemUID = expToCheck.SystemUID Then
                            Return True
                        End If
                    Next
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Function

        Private Sub UpdateBulletinExceptionOtherInformation(ByVal bull As SubBulletin)
            Dim dbcomm As OleDbCommand = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim Query As System.Text.StringBuilder = Nothing
            Dim exp As TabularGeneralBulletinException
            Try
                Using dbconn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringBulletin)
                    dbconn.Open()
                    For Each exp In bull.myExceptionList
                        Query = New System.Text.StringBuilder
                        'Query.Append("SELECT Status, ProtectionType, HandlingType, InitialsOfMitigator, SubDesignation, OKTime FROM tblSystemTabularGeneralBulletinExceptionActive WHERE SystemUID = '" & exp.SystemUID & "'")
                        Query.Append("SELECT * FROM tblSystemTabularGeneralBulletinExceptionActive WHERE SystemUID = '" & exp.SystemUID & "'")
                        dbcomm = New OleDbCommand(Query.ToString, dbconn)
                        dr = dbcomm.ExecuteReader()
                        While dr.Read()
                            With exp
                                If Not dr.IsDBNull(7) Then .Status = dr.GetString(7)
                                If Not dr.IsDBNull(8) Then .ProtectionType = dr.GetString(8)
                                If Not dr.IsDBNull(9) Then .HandlingType = dr.GetString(9)
                                If Not dr.IsDBNull(10) Then .InitialsOfMitigator = dr.GetString(10)
                                If Not dr.IsDBNull(11) Then .SubDesignation = dr.GetString(11)
                                If dr.FieldCount > 13 Then If Not dr.IsDBNull(14) Then .OKTime = Trim(dr.GetDateTime(14))
                                If dr.FieldCount > 14 Then If Not dr.IsDBNull(15) Then .theCancelledBy = dr.GetString(15)
                                If dr.FieldCount > 15 Then If Not dr.IsDBNull(16) Then .theCancelDate = Trim(dr.GetDateTime(16))
                                If dr.FieldCount > 16 Then If Not dr.IsDBNull(17) Then .CancelledBulletinGUID = Trim(dr.GetValue(17))
                            End With
                        End While
                        dr.Close()
                    Next
                    dbconn.Close()
                End Using

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                If dbcomm IsNot Nothing Then dbcomm.Dispose()
                dbcomm = Nothing
                dr = Nothing
            End Try
        End Sub

        Private Sub InitializeExceptionForTGBORecords()
            Try
                Dim tgb As TabularGeneralBulletin
                For Each tgb In gTabularGeneralBulletins
                    tgb.CheckForExistingExceptions(BulletinCollection)
                Next
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                DoTGBOSummaryRefresh("InitializeExceptionForTGBORecords")
            End Try
        End Sub

