        Public Shared Sub ProcessTrainUnit(ByVal messageToProcess As String)

            Try
                DebugEvent("ProcessTrainUnit:" & messageToProcess)
                Dim DataString() As String = messageToProcess.Split(";")
                If DataString.Length >= 2 Then
                    Dim MessageList As New ArrayList()
                    Dim DataStringTwo() As String = DataString(1).Split(Chr(2))
                    Dim Symbol As String = DataStringTwo(0)
                    Dim trn As TrainID
                    Dim FoundTrain As TrainID = Nothing
                    For Each trn In TMDS.GlobalDeclarations.TrainCollection
                        If trn.Name = Symbol Then
                            FoundTrain = trn
                            Exit For
                        End If
                    Next
                    Dim Units() As String = DataStringTwo(1).Split(Chr(3))
                    Dim NewUnits As New ArrayList
                    Dim u As String
                    For Each u In Units
                        Dim data() As String = u.Split("#")
                        If data.Length > 1 Then
                            If Not NewUnits.Contains(Trim(data(0))) Then
                                NewUnits.Add(Trim(data(0)))
                            End If
                        End If
                    Next

                    Dim ChangeFound As Boolean
                    If Not IsNothing(FoundTrain) Then
                        Dim cu As String
                        If FoundTrain.Units.Count <> NewUnits.Count Then
                            ChangeFound = True
                        End If
                        For Each cu In FoundTrain.Units
                            Dim nu As String = TMDS.SystemUtilities.Formatting.CheckEngineIDFormatting(cu)
                            If Trim(nu) <> "" Then
                                If Not NewUnits.Contains(nu) Then
                                    ChangeFound = True
                                    Exit For
                                End If
                            End If
                        Next
                        If ChangeFound Then
                            Dim sUnit As String = String.Empty
                            FoundTrain.Units.Clear()
                            NewUnits.RemoveAt(0)
                            For Each cu In NewUnits
                                If Trim(cu) <> "" Then
                                    FoundTrain.Units.Add(TMDS.SystemUtilities.Formatting.CheckEngineIDFormatting(cu))
                                End If
                            Next
                            FoundTrain.UpdateTrainIDIntoDatabase(FoundTrain.myTrack, False, "ProcessTrainUnit")
                        End If

                    End If
                End If
                DebugEvent("TRAIN UNIT MESSAGE PROCESSED FROM COMMUNICATION CHANNEL:" & messageToProcess)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Shared Sub ProcessTrainCrew(ByVal messageToProcess As String)

            Try
                SystemEvent("ProcessTrainCrew:" & messageToProcess)

