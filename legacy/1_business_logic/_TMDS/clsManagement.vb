        ''' <summary>
        ''' Alert HotBox
        ''' </summary>
        ''' <param name="messageToProcess"></param>
        Public Shared Sub AlertHotBox(ByVal messageToProcess As String)
            Try
                SystemEvent("AlertHotBox:" & messageToProcess)

                Dim DataString() As String = messageToProcess.Split(";")
                Dim Symbol As String = DataString(1)
                Dim MessageTMDS As String = DataString(2)
                Dim MessageOnboard As String = DataString(3)
                Dim Enforcement As Boolean = CBool(DataString(4))
                Dim Xml As String = DataString(5)

                'Find train id
                Dim Train As TrainID = FindTrainID(Symbol)

                If Not IsNothing(Train) Then

                    If Train.IsActivePTC Then
                        If Enforcement Then
                            'Sent enforcement to onboard
                            Train.CancelAllLicenseForPTC(False, True, False)
                        End If
                        Thread.Sleep(500)
                        'Sent text msg to onboard
                        SendTextMessage(Train, MessageOnboard)
                    Else
                        SystemEvent("AlertHotBox: Train is not actived " & Symbol)
                    End If

                    'Create alert for dispatcher
                    Dim al As Alert = TMDS.ManagementClasses.AlertUtilities.CreateAlert(Alert.AlertType.HotBox, MessageTMDS, Train)
                    al.Critical = True

                    'Record event in system events logs
                    RecordEvent("HOTBOX", Train.myTrack.myTerritory.TerritoryID.ToString, Xml)
                Else
                    SystemEvent("AlertHotBox: Can't find train " & Symbol)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

