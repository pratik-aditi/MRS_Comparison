            End Try
        End Function

        Private Shared Sub WriteAlertsToFile()
            Dim AlertBackupFile As String = Application.StartupPath & "\Alerts\Alerts-" & Format(Now, "MM-dd-yyyy") & ".txt"
            Dim AlertLogWriter As StreamWriter

            Try
                If Not Directory.Exists(Application.StartupPath & "\Alerts") Then
                    Directory.CreateDirectory(Application.StartupPath & "\Alerts")
                End If

                If Not File.Exists(gSystemAlertFile) Then
                    AlertLogWriter = File.CreateText(gSystemAlertFile)
                Else
                    File.Move(gSystemAlertFile, AlertBackupFile)
                    AlertLogWriter = File.CreateText(gSystemAlertFile)
                End If

                Dim AlertString As String
                Dim at As Alert
                SyncLock TMDS.GlobalDeclarations.gSystemAlertList.SyncRoot
                    For Each at In TMDS.GlobalDeclarations.gSystemAlertList
                        AlertString = CreateDataLineFromAlert(at)
                        AlertLogWriter.WriteLine(AlertString)
                        AlertLogWriter.Flush()
                    Next
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Function CheckIfAlertExists(ByVal theTypeOfAlert As Alert.AlertType) As Boolean
            Try
                Dim al As Alert = Nothing
                For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                    If al.TypeOfAlert = theTypeOfAlert Then
                        Return True
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

    End Class


