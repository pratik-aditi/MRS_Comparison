        Public Function FindTrackWithTrain(ByVal UID As Int32, ByVal TrainGUID As String) As TMDS.TrackComponents.Track
            Try
                Dim trk As TMDS.TrackComponents.Track = Nothing


                For Each trk In TMDS.GlobalDeclarations.TrackCollection
                    If trk.GUID = UID Then
                        Return trk
                    End If
                Next

                If trk Is Nothing Then
                    For Each trk In TMDS.GlobalDeclarations.TrackCollection
                        If trk.TrainIDs.Count > 0 Then
                            Dim trn As TrainID
                            For Each trn In trk.TrainIDs
                                If trn.TrainGUID = TrainGUID Then
                                    Return trk
                                End If
                            Next
                        End If
                    Next
                End If
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function FindTrainWithTrack(ByVal TrainGUID As String, ByVal ExcludeTrack As Track) As TMDS.TrackComponents.Track
