        Private Shared Sub RefreshDelayCode()
            Dim FormQuery As String = "SELECT * FROM " & gtblDelayCode
            Dim dr As OleDbDataReader = Nothing
            Dim dbCommand As New OleDbCommand
            Dim dc As DelayCode
            Dim tmpDelayCollection As New ArrayList
            Try

                CopyArrayCollection(tmpDelayCollection, TMDS.GlobalDeclarations.gDelayCodeList)
                TMDS.GlobalDeclarations.gDelayCodeList = New ArrayList
                If optEnableDelayCodeSortOrderByCode Then
                    FormQuery = FormQuery & "  ORDER BY [DelayCode]"
                End If
                Using dbConn As New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringStatic)
                    dbConn.Open()
                    dbCommand = New OleDbCommand(FormQuery, dbConn)
                    dr = dbCommand.ExecuteReader()
                    While dr.Read()
                        dc = New DelayCode()
                        If Not dr.IsDBNull(0) Then dc.myUID = dr.GetValue(0)
                        If Not dr.IsDBNull(1) Then dc.Code = dr.GetString(1)
                        If Not dr.IsDBNull(2) Then dc.Description = dr.GetString(2)
                        If Not dr.IsDBNull(3) Then dc.DelayDeptResponsibility = dr.GetValue(3)
                        If Not dr.IsDBNull(4) Then dc.DelayExcused = dr.GetValue(4)
                        If Not TMDS.GlobalDeclarations.gDelayCodeList.Contains(dc) Then TMDS.GlobalDeclarations.gDelayCodeList.Add(dc)
                    End While
                    dr.Close()
                    dbConn.Close()
                End Using

            Catch ex As Exception
                GetErrorDetails(ex)
                CopyArrayCollection(TMDS.GlobalDeclarations.gDelayCodeList, tmpDelayCollection)
            Finally
                If dbCommand IsNot Nothing Then dbCommand.Dispose()
                dbCommand = Nothing
                dr = Nothing
            End Try

        End Sub

