        Public Shared Sub ProcessDeviceStatusRequest(ByVal data As String)
            Try
                Dim Elements() As String = data.Split("|")
                If Elements.Length >= 3 Then
                    Dim SubUID As String = Elements(0)
                    Dim DeviceUID As String = Elements(1)
                    Dim DeviceType As String = Elements(2)
                    Dim Subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromPTCUID(CInt(SubUID))
                    If IsNothing(Subdvn) Then Exit Sub
                    Select Case DeviceType
                        Case "SWITCH"
                            Dim sw As Switch
                            For Each sw In SwitchCollection
                                If sw.SubdivisionID = Subdvn.GUID AndAlso sw.DevicePTCUID = DeviceUID Then
                                    If optEnableShadowMode AndAlso sw IsNot Nothing Then
                                        If sw.myControlPoint.IsShadowMode Then
                                            SystemEvent("PTCMessages-ProcessDeviceStatusRequest...Switch in ShadowMode:" & sw.GUID & " Data<" & data & ">")
                                            Exit Sub
                                        End If
                                    End If
                                    If sw.PublishStatusToPTC Then
                                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_DeviceStatusBroadcast(Nothing, sw)
                                        Exit For
                                    End If
                                End If
                            Next
                        Case "SIGNAL"
                            Dim sg As Signal
                            For Each sg In SignalCollection
                                If sg.SubdivisionID = Subdvn.GUID AndAlso sg.DevicePTCUID = DeviceUID Then
                                    If optEnableShadowMode AndAlso sg IsNot Nothing Then
                                        If sg.myControlPoint.IsShadowMode Then
                                            SystemEvent("PTCMessages-ProcessDeviceStatusRequest...signal in ShadowMode:" & sg.GUID & " Data<" & data & ">")
                                            Exit Sub
                                        End If
                                    End If
                                    If sg.PublishStatusToPTC Then
                                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_DeviceStatusBroadcast(sg, Nothing)
                                        Exit For
                                    End If
                                End If
                            Next

                    End Select
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Process Locomotive State Change
        ''' </summary>
        ''' <param name="pData"></param>
        Public Shared Sub ProcessLocomotiveStateChange(ByVal pData As String)
            Dim messages() As String
            Dim trn As TrainID
            Dim empID As String = ""
            Dim firstName As String = ""
            Dim lastName As String = ""
            Dim craft As String = ""
            Dim employeeName As String = ""
            Dim locomotiveState As String
            Dim locomotiveControllingState As String
            Dim messageResponse As String
            Dim trainSymbol As String
            Dim unitID As String
            Try
                messages = pData.Split("|")
                If messages.Count <= 12 Then
                    SystemEvent("ProcessLocomotiveStateChange:Bad message:Data=" & pData)
                    Exit Sub
                End If
                locomotiveState = messages(12)
                locomotiveControllingState = messages(13)
                messageResponse = messages(0)
                trainSymbol = messages(1)
                unitID = messages(2)
                trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(trainSymbol)
                If IsNothing(trn) Then
                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(unitID)
                    If IsNothing(trn) Then
                        SystemEvent("ProcessLocomotiveStateChange:TRAIN NOT FOUND:Data=" & pData)
                        Exit Sub
                    End If
                End If
                If optEnableShadowMode AndAlso trn IsNot Nothing AndAlso trn.myTrack IsNot Nothing Then
                    If trn.myTrack.myControlPoint.IsShadowMode Then
                        SystemEvent("ProcessLocomotiveStateChange:Train in ShadowMode:Train=" & trn.Name & ":Data=" & pData)
                    End If
                End If
                If trn.IsActivePTC AndAlso locomotiveControllingState = "NON-CONTROLLING" Then
                    trn.PerformCutOutPTC()
                    trn.VETMS_GenerateAlertForDeActivation()
                    trn.myTrack.InitTrainDisplay()
                    trn.myTrack.InvalidateTrainID()
                    If Not IsNothing(trn.thisCurrentLicense) Then
                        trn.CancelAllLicenseForPTC(True, False, False)
                    End If
                ElseIf Not trn.IsActivePTC AndAlso locomotiveControllingState = "CONTROLLING" Then
                    If messages.GetUpperBound(0) > 18 Then
                        If Not String.IsNullOrEmpty(messages(18)) Then firstName = messages(18).ToUpper.Trim
                        If Not String.IsNullOrEmpty(messages(19)) Then lastName = messages(19).ToUpper.Trim
                        employeeName = firstName & Space(1) & lastName
                    End If
                    'REMOVE LICENSE IF WAS A GEOFENCE TRAIN
                    If Not IsNothing(trn.thisCurrentLicense) Then
                        trn.CancelAllLicenseForPTC(True, False, False)
                    End If
                    'REMOVE LICENSE IF WAS A GEOFENCE TRAIN
                    trn.PerformActiveTrainForPTC()
                    trn.VETMS_GenerateAlertForActivation(employeeName)
                    trn.myTrack.InitTrainDisplay()
                    trn.myTrack.InvalidateTrainID()
                End If
                'BOS is sending a wrong message when cad request a message after a cutout
                'ACTIVE|NO SYMBOL|MRS 7311|4/11/2017 9:42:46 AM|UNKNOWN|0||0||N|0|00|FAILED|NON-CONTROLLING|N||||||||||9||FALSE
                If messageResponse = "ACTIVE" And locomotiveState = "FAILED" Then
                    SystemEvent("ProcessLocomotiveStateChange:Wrong message from BOS:Message=" & messageResponse & ":LocomotiveState=" & locomotiveState & ":Train=" & trn.Name)
                    Exit Sub
                End If
                trn.PTCStatus = messageResponse
                trn.PTCSubStatus = locomotiveState
                trn.myTrack.InitTrainDisplay()
                trn.myTrack.InvalidateTrainID()
                If trn.IsActivePTC Then
                    trn.TimeStampPTCStatus = Now
                End If
                If optEnableGeoFenceOperations Then
                    trn.DoUpdateCBTCStatus(trn.IsActivePTC, False)
                End If
                ProcessLocomotivePostionReportVETMS(pData)
                SystemEvent("ProcessLocomotiveStateChange:End:Train=" & trn.Name & ":PTCStatus=" & trn.PTCStatus & ":PTCSubStatus=" & trn.PTCSubStatus)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                messages = Nothing
                empID = Nothing
                firstName = Nothing
                lastName = Nothing
                craft = Nothing
                employeeName = Nothing
                locomotiveState = Nothing
                locomotiveControllingState = Nothing
                messageResponse = Nothing
                trainSymbol = Nothing
                unitID = Nothing
            End Try
        End Sub

