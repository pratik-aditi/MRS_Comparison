        Public Shared Sub ProcessBulletinMessageTGBO(ByVal messageToProcess As String)
            Try
                Dim data() As String = Nothing
                If optEnableShadowMode Then
                    Try
                        Dim TmpShadowMode() As String = messageToProcess.Split(Chr(10))
                        If TmpShadowMode IsNot Nothing AndAlso TmpShadowMode.Length > 1 Then
                            Dim WrkstnName As String = TmpShadowMode(1)
                            If WrkstnName.Trim.ToUpper = gWorkStationName.Trim.ToUpper Then
                                LogEvent("ORGINATED FORM THIS WORKSTATION DROPPING THIS MESSAGE AND LOGGING ProcessBulletinMessageTGBO:" & messageToProcess)
                                Exit Sub
                            Else
                                data = TmpShadowMode(0).Split(";")
                            End If
                        End If
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    End Try
                Else
                    data = messageToProcess.Split(";")
                End If
                If data Is Nothing Then
                    data = messageToProcess.Split(";")
                End If
                SystemEvent("ProcessBulletinMessageTGBO:" & messageToProcess)
                Dim theCommand As String = data(1)
                Dim theBulletinGUID As String = data(2)
                Dim MileageRangeList As String
                Dim MileageRangeFound As Boolean
                Try
                    If data.Length >= 4 Then
                        If Trim(data(3)) <> "" Then
                            MileageRangeList = data(3)
                            Dim m As String
                            Dim mrList() As String = MileageRangeList.Split("-")
                            For Each m In mrList
                                Dim range() As String = m.Split("|")
                                If range.Length = 2 Then
                                    Dim mr As MileageRange
                                    For Each mr In gMileageRangeList
                                        If mr.myUID = CInt(range(1)) Then
                                            If mr.ControlledByThisDesk Then
                                                MileageRangeFound = True
                                                SystemEvent("ProcessBulletinMessageTGBO-MileageRangeFound")
                                                Exit For
                                            End If
                                        End If
                                    Next
                                End If
                            Next
                        End If
                    End If
                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try
                Dim tgb As TabularGeneralBulletin
                Dim FoundTGBO As TabularGeneralBulletin = Nothing
                For Each tgb In gTabularGeneralBulletins
                    If tgb.SystemUID = theBulletinGUID Then
                        FoundTGBO = tgb
                        SystemEvent("ProcessBulletinMessageTGBO-TGBOFOUND:" & tgb.SystemUID)
                        Exit For
                    End If
                Next
                If Not IsNothing(FoundTGBO) Then
                    Select Case theCommand
                        Case "ACTIVATED"
                            SystemEvent("ProcessBulletinMessageTGBO-ACTIVATED:" & FoundTGBO.SystemUID)
                            If FoundTGBO IsNot Nothing Then ActivateTGBO(FoundTGBO)
                            If optEnableARRCSpecificOptions Then TMDS.SystemUtilities.BulletinFunction.ReInitateTGBOExceptionList("ProcessBulletinMessageTGBO-ACTIVATE")
                        Case "DELETED"
                            SystemEvent("ProcessBulletinMessageTGBO-DELETE:" & FoundTGBO.SystemUID)
                            RemoveTGBO(FoundTGBO)
                            RemoveTGBOSuspension(theBulletinGUID)
                        Case "CREATED"
                            If Not IsNothing(FoundTGBO) Then Exit Sub
                            If MileageRangeFound Then
                                SystemEvent("ProcessBulletinMessageTGBO-ADD:" & FoundTGBO.SystemUID)
                                AddTGBO(theBulletinGUID)
                                If optEnableARRCSpecificOptions Then TMDS.SystemUtilities.BulletinFunction.ReInitateTGBOExceptionList("ProcessBulletinMessageTGBO-CREATE")
                            Else
                                SystemEvent("ProcessBulletinMessageTGBO-NOT ADDED:" & FoundTGBO.SystemUID)
                            End If
                        Case "CHANGE_DESIGNATION"
                            SystemEvent("ProcessBulletinMessageTGBO-CHANGE_DESIGNATION:" & FoundTGBO.SystemUID)
                            RemoveTGBO(FoundTGBO)
                            RemoveTGBOSuspension(theBulletinGUID)
                            AddTGBO(theBulletinGUID)
                    End Select
                Else
                    RemoveTGBOSuspension(theBulletinGUID)
                    SystemEvent("ProcessBulletinMessageTGBO-NOT FOUND")
                End If
                If FoundTGBO Is Nothing Then
                    If optEnableARRCSpecificOptions Or optEnableMetroLinkSpecificOptions Then
                        Select Case theCommand
                            Case "CREATED"
                                SystemEvent("ProcessBulletinMessageTGBO-ADD:" & theBulletinGUID)
                                AddTGBO(theBulletinGUID)
                        End Select
                    ElseIf optEnableCNSpecificOptions Then
                        Select Case theCommand
                            Case "CREATED"
                                If MileageRangeFound Then
                                    SystemEvent("ProcessBulletinMessageTGBO-ADD:" & theBulletinGUID)
                                    AddTGBO(theBulletinGUID)
                                Else
                                    SystemEvent("ProcessBulletinMessageTGBO-NOT ADDED[" & theBulletinGUID & "]- MILEAGERANGE NOT FOUND ")
                                End If

                        End Select
                    End If
                    If optEnableARRCSpecificOptions Then
                        Dim trn As TrainID = Nothing
                        tgb = Nothing
                        tgb = TMDS.SystemUtilities.FetchData.FindTGBOByUID(theBulletinGUID)
                        If tgb IsNot Nothing Then
                            trn = TMDS.SystemUtilities.FetchData.FindTrainByTGBO(tgb)
                        End If
                        If trn IsNot Nothing Then
                            trn.PerformTrainRestrictions(True)
                        End If
                    End If
                End If
                If optEnableARRCSpecificOptions Then
                    If optEnableARRCSpecificOptions Then ReinitializeExecpListAllBulletin()
                    TMDS.SystemUtilities.BulletinFunction.ReInitateTGBOExceptionList("ProcessBulletinMessageTGBO-Comm")
                    DoTGBOSummaryRefresh("ProcessBulletinMessageTGBO")
                Else
                    Dim SummItem As New SummaryItem("TGBO", "REFRESH", Nothing, "Manage_ProcessTGBO")
                    SyncLock gSubBulletinsMessageSummaryQueue
                        gSubBulletinsMessageSummaryQueue.Enqueue(SummItem)
                    End SyncLock
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

