                        'sfa.PTCIssuanceSuccessful = True
                        'sfa.CheckToAcknowledgeAlert()
                End Select

                If sfa.UpdateDatabaseWithPTCAuthorityStatus(sfa.PTCStatus) Then
                    SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_1051_TWC_CreateMessageResponse-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                End If
                sfa.SetPTCAuthorityFlasherStatus()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub ProcessMA_1053_TWC_ReleaseMessageResponse(ByVal MessageResponse As String, ByVal sfa As SFAuthority)
            Try
                If sfa.PTCMarkedToBeVoidedElectronically Then
                    Select Case MessageResponse
                        Case "FAILED"
                            sfa.PTCStatus = "RELEASE-FAILED"
                            sfa.SetPTCAuthorityFlasherStatus()
                        Case "DELIVERED"
                            sfa.PTCStatus = "RELEASE-PENDING"
                            sfa.SetPTCAuthorityFlasherStatus()
                            'sfa.CheckToAcknowledgeAlert()
                    End Select
                End If
                If sfa.UpdateDatabaseWithPTCAuthorityStatus(sfa.PTCStatus) Then
                    SystemEvent("PTCMessages-ProcessDeliveryConfirmation-ProcessMA_1053_TWC_ReleaseMessageResponse-AUTHORITY:" & sfa.AuthorityUID & " STATUS=" & sfa.PTCStatus)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Shared Sub ProcessMA_1051_TWC_RollupMessageResponse(ByVal MessageResponse As String, ByVal sfa As SFAuthority)
            Try
                If sfa.PTCMarkedToBeRolledUpElectronically Then
