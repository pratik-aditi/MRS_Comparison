        Public Sub LoadDeviceBlockRecords()
            Dim dbConnection As OleDbConnection = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseCommand As OleDbCommand = Nothing
            Dim DeviceBlockFetch As String
            Dim devBlk As TrackAuthority.DeviceBlock

            Try
                dbConnection = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                DeviceBlockFetch = "SELECT * FROM " & gtblBlkActive
                DeviceBlockFetch = DeviceBlockFetch & " WHERE TerritoryAssignment = " & TerritoryID & " OR TerritoryAssignmentSecondary = " & TerritoryID
                DeviceBlockFetch = DeviceBlockFetch & " ORDER BY CreateDate ASC;"
                DatabaseCommand = New OleDbCommand(DeviceBlockFetch, dbConnection)
                dbConnection.Open()
                dr = DatabaseCommand.ExecuteReader()
                While dr.Read()
                    devBlk = New TrackAuthority.DeviceBlock()
                    devBlk.AuthorityNumber = dr.GetInt32(0)
                    devBlk.RailRoadName = dr.GetString(1)
                    devBlk.DispatcherName = dr.GetString(2)
                    devBlk.CreateDate = dr.GetDateTime(3)
                    devBlk.Direction = dr.GetString(4)
                    devBlk.AuthorityDate = dr.GetDateTime(5)
                    devBlk.AuthorityType = dr.GetString(6)
                    devBlk.IssueTo = dr.GetString(7)
                    devBlk.AuthorityLimits = dr.GetString(8)
                    devBlk.OKTime = dr.GetDateTime(9)
                    devBlk.UntilTime = dr.GetDateTime(10)
                    devBlk.MobileID = dr.GetInt32(11)

                    Dim GUIDs() As String = dr.GetString(12).Split("|")
                    Dim strGUID As String
                    For Each strGUID In GUIDs
                        If IsNumeric(strGUID) Then
                            Dim compToBlock As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CInt(strGUID))
                            If Not compToBlock Is Nothing Then
                                devBlk.ComponentsInSelection.Add(compToBlock)
                            End If
                        End If
                    Next
                    devBlk.ReportClear = dr.GetDateTime(13)
                    devBlk.TerritoryAssignment = dr.GetInt32(14)
                    devBlk.BlockNotes = dr.GetString(15)

                    If Not dr.IsDBNull(16) Then
                        devBlk.AuthorityUID = dr.GetString(16)
                    End If
                    If dr.FieldCount >= 18 Then
                        devBlk.TerritoryAssignmentSecondary = dr.GetInt32(17)
                    End If

                    If dr.FieldCount >= 19 Then
                        devBlk.BlockGUID = dr.GetString(18)
                    End If
                    If dr.FieldCount >= 27 Then
                        Dim AllowFieldBlking As Boolean
                        If Not dr.IsDBNull(27) Then
                            AllowFieldBlking = dr.GetBoolean(27)
                        End If
                        Select Case AllowFieldBlking
                            Case False
                                devBlk.OverrideFieldBlocking = True
                        End Select
                    End If
                    ''****************************************************************************************
                    ''**   ADD device blocks TO components
                    ''*****************************************************************************************
                    Dim comp As Object
                    For Each comp In devBlk.ComponentsInSelection
                        If comp IsNot Nothing AndAlso comp.GetType.ToString = gTrackComponentName Then
                            If optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then comp.OverRideCodeBrown = True
                        End If
                        comp.BlockAbsolute = True
                        comp.BlockAbsolutePrevious = True
                        comp.DeviceBlocks.Add(devBlk)
                        comp.DeviceBlocked = True
                        comp.UpdateStatus()

                    Next
                    'gDeviceBlocks.Add(devBlk)
                    TMDS.GlobalDeclarations.gDeviceBlocks.Add(devBlk)
                    devBlk = Nothing
                End While

                'DatabaseCommand.Dispose()
                'DatabaseCommand = Nothing
                'dbConnection.Close()

            Catch ex As Exception
                AddEventToLog(EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            Finally
                If Not dbConnection Is Nothing Then
                    If dbConnection.State = ConnectionState.Open Then dbConnection.Close()
                    dbConnection.Dispose()
                    dbConnection = Nothing
                End If
                If Not dr Is Nothing Then
                    dr.Close()
                    dr = Nothing
                End If
                If Not DatabaseCommand Is Nothing Then
                    DatabaseCommand.Dispose()
                    DatabaseCommand = Nothing
                End If
            End Try
        End Sub

        Public Sub LoadTrackAuthorityRecords()
            Dim dbConnection As OleDbConnection = Nothing
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseCommand As OleDbCommand = Nothing
            Dim auth As TrackAuthority.TrackAuthority
            Dim AuthorityFetch As String
            Dim I As Integer
            Try
                dbConnection = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                AuthorityFetch = "SELECT * FROM " & gtblAuthActive
                AuthorityFetch = AuthorityFetch & " WHERE TerritoryAssignment = " & TerritoryID & " OR TerritoryAssignmentSecondary = " & TerritoryID
                AuthorityFetch = AuthorityFetch & " ORDER BY CreateDate ASC;"
                DatabaseCommand = New OleDbCommand(AuthorityFetch, dbConnection)
                dbConnection.Open()
                dr = DatabaseCommand.ExecuteReader()
                While dr.Read()
                    auth = New TrackAuthority.TrackAuthority()
                    auth.AuthorityNumber = dr.GetInt32(0)
                    auth.RailRoadName = dr.GetString(1)
                    auth.DispatcherName = dr.GetString(2)
                    auth.CreateDate = dr.GetDateTime(3)
                    auth.Direction = dr.GetString(4)
                    auth.AuthorityDate = dr.GetDateTime(5)
                    auth.AuthorityType = dr.GetString(6)
                    auth.IssueTo = dr.GetString(7)
                    auth.AuthorityLimits = dr.GetString(8)
                    auth.OKTime = dr.GetDateTime(9)
                    auth.UntilTime = dr.GetDateTime(10)
                    auth.MobileID = dr.GetInt32(11)


                    Dim GUIDs() As String = dr.GetString(12).Split("|")
                    Dim strGUID As String
                    For Each strGUID In GUIDs
                        If IsNumeric(strGUID) Then
                            Dim compToBlock As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(CInt(strGUID))
                            If Not compToBlock Is Nothing Then
                                auth.ComponentsInSelection.Add(compToBlock)
                            End If
                        End If
                    Next
                    If Not dr.IsDBNull(13) Then
                        Dim Rdate As Date
                        If Date.TryParse(dr.GetDateTime(13), Rdate) Then
                            If IsValidDate(Rdate.ToString) Then
                                auth.ReportClear = dr.GetDateTime(13)
                            End If
                        End If
                    End If

                    'auth.ReportClear = dr.GetDateTime(13)
                    auth.TerritoryAssignment = dr.GetInt32(14)
                    auth.AuthorityUID = dr.GetString(15)
                    If Not dr.IsDBNull(16) Then
                        Dim VehicleList() As String = dr.GetString(16).Split("|")
                        Dim veh As String
                        For Each veh In VehicleList
                            If veh.Trim <> "" Then
                                If auth.VehicleAssociations Is Nothing Then
                                    auth.VehicleAssociations = New ArrayList()
                                End If
                                auth.VehicleAssociations.Add(veh)
                            End If
                        Next
                    End If
                    auth.JointAuthority = dr.GetBoolean(17)
                    Dim TrainList() As String = dr.GetString(18).Split("|")
                    auth.BehindTrains = New ArrayList()

                    For I = 0 To TrainList.GetUpperBound(0)
                        auth.BehindTrains.Add(TrainList(I))
                    Next

                    auth.BeginMilePostLimits = dr.GetInt32(19)
                    auth.BeginMilePostLimits = dr.GetInt32(20)
                    auth.JointLimits = dr.GetString(21)

                    If dr.FieldCount >= 23 Then
                        If Not dr.IsDBNull(22) Then
                            auth.TerritoryAssignmentSecondary = dr.GetInt32(22)
                        End If
                    End If
                    If dr.FieldCount >= 24 Then
                        If Not dr.IsDBNull(23) Then
                            auth.AuthGUID = dr.GetString(23)
                        End If
                    End If

                    Dim TrackTimeType As Boolean
                    Dim FoulTimeType As Boolean
                    Select Case Mid(auth.AuthorityType, 1, 2)
                        Case "TT"
                            TrackTimeType = True
                        Case "FT"
                            FoulTimeType = True
                        Case Else
                            TrackTimeType = True
                    End Select


                    If dr.FieldCount >= 55 Then
                        If Not dr.IsDBNull(38) Then auth.PTCAuthorityText = dr.GetString(38)
                        If Not dr.IsDBNull(52) Then auth.PTCAuthoritySegments = dr.GetString(52)
                        If Not dr.IsDBNull(53) Then auth.PTCRestrictionText = dr.GetString(53)
                        If Not dr.IsDBNull(54) Then auth.PTCCompositionCRC = dr.GetInt64(54)
                        If Not dr.IsDBNull(55) Then auth.PTCContingencySegments = dr.GetString(55)
                    End If

                    ''RMT ARRC-1910
                    If dr.FieldCount >= 66 Then
                        If Not dr.IsDBNull(65) Then
                            Dim TempSwitchStr As String = ""
                            TempSwitchStr = dr.GetValue(65)
                            If Not String.IsNullOrEmpty(TempSwitchStr) AndAlso TempSwitchStr.Trim <> "" Then
                                auth.PopulateSwitchList(TempSwitchStr)
                            End If
                        End If
                    End If

                    ''****************************************************************************************
                    ''**   ADD AUTHORITY TO TRACKS
                    ''*****************************************************************************************
                    Dim comp As Object
                    For Each comp In auth.ComponentsInSelection
                        comp.BlockAbsolute = True
                        If Not comp.TrackAuthorities.Contains(auth) Then comp.TrackAuthorities.Add(auth)
                        comp.TrackAndTime = TrackTimeType
                        comp.FoulTime = FoulTimeType
                        comp.UpdateStatus()
                    Next
                    If Not TMDS.GlobalDeclarations.OtherTrackAuthorities.Contains(auth) Then TMDS.GlobalDeclarations.OtherTrackAuthorities.Add(auth)
                    'OtherTrackAuthorities.Add(auth)
                    auth.CreateReducedLimitsVerbiage()
                End While

                'DatabaseCommand.Dispose()
                'DatabaseCommand = Nothing
                'dbConnection.Close()

            Catch ex As Exception
                AddEventToLog(EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
                'dbConnection = Nothing
            Finally
                If Not dbConnection Is Nothing Then
                    If dbConnection.State = ConnectionState.Open Then dbConnection.Close()
                    dbConnection.Dispose()
                    dbConnection = Nothing
                End If
                If Not dr Is Nothing Then
                    dr.Close()
                    dr = Nothing
                End If
                If Not DatabaseCommand Is Nothing Then
                    DatabaseCommand.Dispose()
                    DatabaseCommand = Nothing
                End If
            End Try
        End Sub

