        Public Function GetNextBulletinNumber(ByRef BulletinCollection As ArrayList, ByVal BulletinType As String, Optional ByVal BulletinColumnName As String = Nothing) As String
            Dim VoidedTBNumbers As New ArrayList
            Dim CurrentTBNumberInDB As Integer = 0
            Try
                Dim bull As Object 'SubBulletin OR Bulletin
                Dim Unique As Boolean = False
                Dim ContinueUniqueSearch As Boolean = False
                Dim BullNumber As Int32
                Dim BullRange As Int32
                Dim BullFactor As Int32
                Dim BullTableName As String = String.Empty
                Dim counter As Integer
                Dim NextBulletinNumber As String = String.Empty
                Dim DBUniqueSearchFailed As Boolean = False

                If optEnableMRLSpecificOptions Then
                    CurrentTBNumberInDB = GetLastActiveTBNumber(Me.Name, BulletinType)
                    VoidedTBNumbers = GetLastInActiveTBNumbers(Me.Name, BulletinType)
                    If CurrentTBNumberInDB > 0 Then
                        BullNumber = CurrentTBNumberInDB
                        If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                            For i As Integer = 0 To 30
                                If VoidedTBNumbers.Contains(GTBNumber) Then
                                    GTBNumber = GTBNumber + 1
                                Else
                                    Exit For
                                End If
                            Next
                        End If
                    End If
                End If


                'Added This Condition Based on CP RMT-811
                If optEnableCPSpecificOptions Then
                    BullNumber = Info1Number
                    BullRange = Info1Range
                    If BulletinColumnName = "" Then
                        BullTableName = "NumberFormB"
                    Else
                        BullTableName = BulletinColumnName
                    End If
                    BullFactor = Info1Factor
                Else
                    Select Case BulletinType
                        Case "SPEEDRESTRICTION-FORMX"
                            If optEnableMRLSpecificOptions AndAlso CurrentTBNumberInDB > 0 Then
                                Xing1Number = CurrentTBNumberInDB
                                If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                                    For i As Integer = 0 To 30
                                        If VoidedTBNumbers.Contains(Xing1Number) Then
                                            Xing1Number = Xing1Number + 1
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                            BullNumber = Xing1Number
                            BullRange = Xing1Range
                            If BulletinColumnName = "" Then
                                BullTableName = "NumberFormA"
                            Else
                                BullTableName = BulletinColumnName
                            End If

                            BullFactor = Xing1Factor

                        Case "FORMA", "SPEED RESTRICTION", "SPEEDRESTRICTION-FORMD", "SPEEDRESTRICTION-FORMA", "SPEEDRESTRICTION-FORMX", "SPEEDRESTRICTION-FORMS"
                            If optEnableMRLSpecificOptions AndAlso CurrentTBNumberInDB > 0 Then
                                SpeedRest1Number = CurrentTBNumberInDB
                                If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                                    For i As Integer = 0 To 30
                                        If VoidedTBNumbers.Contains(SpeedRest1Number) Then
                                            SpeedRest1Number = SpeedRest1Number + 1
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                            BullNumber = SpeedRest1Number
                            BullRange = SpeedRest1Range
                            If BulletinColumnName = "" Then
                                BullTableName = "NumberFormA"
                            Else
                                BullTableName = BulletinColumnName
                            End If

                            BullFactor = SpeedRest1Factor

                        Case "FORMB", "WORKZONE", "WORKZONE-FORMB"
                            If optEnableMRLSpecificOptions AndAlso CurrentTBNumberInDB > 0 Then
                                WorkZone1Number = CurrentTBNumberInDB
                                If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                                    For i As Integer = 0 To 30
                                        If VoidedTBNumbers.Contains(WorkZone1Number) Then
                                            WorkZone1Number = WorkZone1Number + 1
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                            BullNumber = WorkZone1Number
                            BullRange = WorkZone1Range
                            If BulletinColumnName = "" Then
                                BullTableName = "NumberFormB"
                            Else
                                BullTableName = BulletinColumnName
                            End If
                            BullFactor = WorkZone1Factor

                        Case "WORKZONE-FORMF"
                            If optEnableMRLSpecificOptions AndAlso CurrentTBNumberInDB > 0 Then
                                WorkZone2Number = CurrentTBNumberInDB
                                If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                                    For i As Integer = 0 To 30
                                        If VoidedTBNumbers.Contains(WorkZone2Number) Then
                                            WorkZone2Number = WorkZone2Number + 1
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                            BullNumber = WorkZone2Number
                            BullRange = WorkZone2Range
                            If BulletinColumnName = "" Then
                                BullTableName = "NumberFormB"
                            Else
                                BullTableName = BulletinColumnName
                            End If
                            BullFactor = WorkZone2Factor


                        Case "WORKZONE-FORMO"
                            If optEnableMRLSpecificOptions AndAlso CurrentTBNumberInDB > 0 Then
                                Info1Number = CurrentTBNumberInDB
                                If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                                    For i As Integer = 0 To 30
                                        If VoidedTBNumbers.Contains(Info1Number) Then
                                            Info1Number = Info1Number + 1
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                            BullNumber = Info1Number
                            BullRange = Info1Range
                            If BulletinColumnName = "" Then
                                BullTableName = "NumberFormB"
                            Else
                                BullTableName = BulletinColumnName
                            End If
                            BullFactor = Info1Factor

                        Case "MISC-TIMETABLE", "MISC-FREEFORM", "MISC-TCM"
                            If optEnableMRLSpecificOptions AndAlso CurrentTBNumberInDB > 0 Then
                                Info2Number = CurrentTBNumberInDB
                                If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                                    For i As Integer = 0 To 30
                                        If VoidedTBNumbers.Contains(Info2Number) Then
                                            Info2Number = Info2Number + 1
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                            BullNumber = Info2Number
                            BullRange = Info2Range
                            If BulletinColumnName = "" Then
                                BullTableName = "NumberFormB"
                            Else
                                BullTableName = BulletinColumnName
                            End If
                            BullFactor = Info2Factor

                        Case "FORMC", "MISC", "1107", "529A", "529B"
                            If optEnableMRLSpecificOptions AndAlso CurrentTBNumberInDB > 0 Then
                                Info1Number = CurrentTBNumberInDB
                                If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                                    For i As Integer = 0 To 30
                                        If VoidedTBNumbers.Contains(Info1Number) Then
                                            Info1Number = Info1Number + 1
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                            BullNumber = Info1Number
                            BullRange = Info1Range
                            If BulletinColumnName = "" Then
                                BullTableName = "NumberFormC"
                            Else
                                BullTableName = BulletinColumnName
                            End If
                            BullFactor = Info1Factor
                        Case "FORMTC"
                            If optEnableMRLSpecificOptions AndAlso CurrentTBNumberInDB > 0 Then
                                Info2Number = CurrentTBNumberInDB
                                If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                                    For i As Integer = 0 To 30
                                        If VoidedTBNumbers.Contains(Info2Number) Then
                                            Info2Number = Info2Number + 1
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                            BullNumber = Info2Number
                            BullRange = Info2Range
                            If BulletinColumnName = "" Then
                                BullTableName = "NumberFormTC"
                            Else
                                BullTableName = BulletinColumnName
                            End If
                            BullFactor = Info2Factor
                        Case "FORMR"
                            If optEnableMRLSpecificOptions AndAlso CurrentTBNumberInDB > 0 Then
                                Info3Number = CurrentTBNumberInDB
                                If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                                    For i As Integer = 0 To 30
                                        If VoidedTBNumbers.Contains(Info3Number) Then
                                            Info3Number = Info3Number + 1
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                            BullNumber = Info3Number
                            BullRange = Info3Range
                            BullTableName = "NumberFormC"
                            BullFactor = Info3Factor
                        Case "GTB"
                            BullNumber = GTBNumber
                            BullRange = GTBRange
                            BullTableName = "NumberGTB"
                            BullFactor = GTBFactor
                    End Select
                End If


                Dim LoopControl As Integer
                While Not Unique
                    If DBUniqueSearchFailed = True Then
                        ContinueUniqueSearch = False
                        DBUniqueSearchFailed = False
                    End If
                    If BullNumber >= BullRange + BullFactor Then
                        BullNumber = BullRange
                    Else
                        If BullNumber = 0 Then
                            BullNumber = BullRange
                        End If
                        BullNumber = BullNumber + 1
                    End If
                    If optEnableMRLSpecificOptions Then
                        If VoidedTBNumbers IsNot Nothing AndAlso VoidedTBNumbers.Count > 0 Then
                            For i As Integer = 0 To 30
                                If VoidedTBNumbers.Contains(BullNumber) Then
                                    BullNumber = BullNumber + 1
                                Else
                                    Exit For
                                End If
                            Next
                        End If
                    End If

                    For Each bull In BulletinCollection
                        If bull.GetType.ToString = gSubBulletinName Then
                            'If bull.BullUID = BullNumber Then
                            If bull.myUID = BullNumber Then
                                ContinueUniqueSearch = True
                                DBUniqueSearchFailed = True
                                counter = 0
                                Exit For
                            End If
                        Else
                            If bull.BullNumber = BullNumber Then
                                ContinueUniqueSearch = True
                                DBUniqueSearchFailed = True
                                counter = 0
                                Exit For
                            End If
                        End If

                        counter = counter + 1
                        If counter = BulletinCollection.Count Then
                            ContinueUniqueSearch = False
                        End If
                    Next

                    If Not ContinueUniqueSearch Then
                        If CheckForDuplicates(BullNumber) Then
                            ContinueUniqueSearch = True
                            counter = 0
                            DBUniqueSearchFailed = True
                        End If
                    End If

                    If Not ContinueUniqueSearch Then
                        Unique = True
                        NextBulletinNumber = BullNumber
                        UpdateBulletinNumber(TMDS.GlobalDeclarations.gDatabaseConnectionStatic, BullTableName, BullNumber, BulletinType)

                        Select Case BulletinType
                            Case "SPEEDRESTRICTION-FORMX"
                                Xing1Number = BullNumber
                            Case "BullNumFormA", "SPEED RESTRICTION", "SPEEDRESTRICTION-FORMD", "SPEEDRESTRICTION-FORMA", "SPEEDRESTRICTION-FORMS"
                                SpeedRest1Number = BullNumber
                            Case "BullNumFormB", "WORKZONE", "WORKZONE-FORMB"
                                WorkZone1Number = BullNumber
                            Case "BullNumFormC", "MISC", "WORKZONE-FORMO"
                                Info1Number = BullNumber
                            Case "BullNumFormTC", "MISC-TIMETABLE", "MISC-FREEFORM"
                                Info2Number = BullNumber
                            Case "GTB"
                                GTBNumber = BullNumber
                        End Select
                    End If
                    If LoopControl > 1000 Then
                        Return 0
                    End If
                    LoopControl += 1
                End While
                Return NextBulletinNumber
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

