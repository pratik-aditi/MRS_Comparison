        Private Delegate Sub DoLoadCancelGBO(TGBO As TabularGeneralBulletin)
        Friend Sub CancelFormC(TGBO As TabularGeneralBulletin)
            Try
                Dim NewDoCancelGBO As New DoLoadCancelGBO(AddressOf PerformCancelFormC)
                NewDoCancelGBO.BeginInvoke(TGBO, Nothing, Nothing)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
