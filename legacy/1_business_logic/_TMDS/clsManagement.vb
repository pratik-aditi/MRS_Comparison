            Try
                Dim tr As TrainRestriction
                For Each tr In Me.myTrain.myRestrictionList
                    If tr.myCarUID.ToUpper.Trim = Me.CarUID.ToUpper.Trim Then
                        If tr.myBulletinGUID IsNot Nothing AndAlso Not String.IsNullOrEmpty(tr.myBulletinGUID) AndAlso tr.myBulletinGUID.Trim <> "" Then
