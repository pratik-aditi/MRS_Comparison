#Region " DENVER "

        Private Sub ReportingPerformedForDenver()
            Dim TimeWait As Date = Now
            Dim PS As PassengerStation = Nothing
            Dim trn As TrainID = Nothing
            Try '
                '"ON STATION", "OFF STATION"
                If Not Me.IsPositionReportingTrack Then Exit Sub

                Do While TimeWait > Now.AddSeconds(-3)
                    If LastTrainSymbolOnMe <> "" Then Exit Do
                    Threading.Thread.Sleep(200)
                Loop
                Me.TrackEventLog("ReportingPerformedForDenver - LastTrainSymbolOnMe:" & LastTrainSymbolOnMe)
                Dim OSTIme As Date = Now
                If Not Me.Occuppied Then
                    If LastTrainSymbolOnMe <> "" Then
                        Dim data() As String = LastTrainSymbolOnMe.Split(" ")
                        Dim symbol() As String = data(0).Split(":")
                        trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(symbol(0))
                        If Not IsNothing(trn) Then
                            PS = GetPassengerStation(False, Me, GetSearchableTrainDirection(trn.Direction))
                            If PS IsNot Nothing Then
                                trn.AddTrainMovementEvent(TrackName, OSTIme, Me.GUID, Me.TimeZone, PS, "OFF STATION")
                                If optEnableSendOSMessageDenver Then
                                    TMDS.NetworkMessages.CadMessages.SendTrainOSMessageDenver(trn, gCadTransmitQueue, Me, PS, "OFF STATION", OSTIme)
                                End If
                            End If
                        End If
                        Me.RemoveTrainEventOnAllOSTracks()
                    End If
                    Me.LastTrainSymbolOnMe = ""

                Else
                    If Me.TrainIDs.Count > 0 Then
                        trn = Me.TrainIDs(0)
                    Else
                        Dim data() As String = LastTrainSymbolOnMe.Split(" ")
                        Dim symbol() As String = data(0).Split(":")
                        trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(symbol(0))
                    End If
                    If Not IsNothing(trn) Then
                        PS = GetPassengerStation(True, Me, GetSearchableTrainDirection(trn.Direction))
                        If PS IsNot Nothing Then
                            trn.AddTrainMovementEvent(TrackName, OSTIme, Me.GUID, Me.TimeZone, PS, "ON STATION")
                            If LastTrainSymbolOnMe Is Nothing Then LastTrainSymbolOnMe = String.Empty
                            If LastTrainSymbolOnMe IsNot Nothing AndAlso LastTrainSymbolOnMe.Trim = "" Then
                                trn.LogTrainMovementOnTrack(Me)
                            End If
                            If optEnableSendOSMessageDenver Then
                                TMDS.NetworkMessages.CadMessages.SendTrainOSMessageDenver(trn, gCadTransmitQueue, Me, PS, "ON STATION", OSTIme)
                            End If

                        End If
                    End If
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

