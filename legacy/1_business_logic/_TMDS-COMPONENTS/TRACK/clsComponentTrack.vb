        Private Sub mnuTTRemove_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try
                Me.TrackEventLog("Clicked - Remove Track Time from CM")

                Dim mi As MenuItem = DirectCast(sender, MenuItem)
                Dim AuthData() As String = mi.Text.Split(",")
                Dim Auth As TrackAuthority.TrackAuthority = FindTrackAuthority(AuthData(0))
                If Auth Is Nothing Then Exit Sub

                If optEnableTNTForCP And optDisableTNTReleaseUNACKAuthoritiesForCP Then
                    If Auth.AuthorityStatus <> "ACKNOWLEDGED" Then
                        Dim LaunchPoint As New Point(Me.CurrentDrawingForm.Left + 400, Me.CurrentDrawingForm.Top + 600)
                        Dim frmMessageBox As frmMessageBox = Nothing
                        Dim MessageList As New ArrayList()
                        Try
                            MessageList.Add("AUTHORITY NO: " & Auth.AuthorityUID)
                            MessageList.Add(" HAS TO BE ACKNOWLEDGED - EXITING!")
                            MessageList.Add("")
                            frmMessageBox = New frmMessageBox()
                            frmMessageBox.Owner = TMDS.SystemForms.MySystemForms.frmMainMDI
                            frmMessageBox.SetMessage(MessageList, "AUTHORITY REPORT CLEAR", False, LaunchPoint)
                            frmMessageBox.ShowDialog()
                            Exit Sub
                        Catch ex As Exception
                            GetErrorDetails(ex)
                        Finally
                            If Not frmMessageBox Is Nothing Then
                                frmMessageBox.Close()
                                frmMessageBox.Dispose()
                                frmMessageBox = Nothing
                            End If
                            MessageList = Nothing
                        End Try
                    End If
                End If


                If Not optReportClearSimpleRelease Then
                    SystemForms.MySystemForms.frmReportClearTrackAuth = New frmReportClearTrackAuth()
                    SystemForms.MySystemForms.frmReportClearTrackAuth.Location = Me.CurrentDrawingForm.myLaunchPoint
                    SystemForms.MySystemForms.frmReportClearTrackAuth.LoadForm()
                    SystemForms.MySystemForms.frmReportClearTrackAuth.SingleReportClearEvent(Auth)
                    SystemForms.MySystemForms.frmReportClearTrackAuth.ShowDialog()
                    SystemForms.MySystemForms.frmReportClearTrackAuth.Dispose()
                    SystemForms.MySystemForms.frmReportClearTrackAuth = Nothing
                Else
                    SystemForms.MySystemForms.frmReportClearTrackAuth = New frmReportClearTrackAuth()
                    SystemForms.MySystemForms.frmReportClearTrackAuth.Location = Me.CurrentDrawingForm.myLaunchPoint
                    SystemForms.MySystemForms.frmReportClearTrackAuth.LoadForm()
                    SystemForms.MySystemForms.frmReportClearTrackAuth.SimpleReportClearEvent(Auth)
                    'SystemForms.MySystemForms.frmReportClearTrackAuth.ShowDialog()
                    SystemForms.MySystemForms.frmReportClearTrackAuth.Dispose()
                    SystemForms.MySystemForms.frmReportClearTrackAuth = Nothing

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub mnuTTModify_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try
                If optDisableTNTModify Then Exit Sub
                Me.TrackEventLog("Clicked - Modify Track Time from CM")

                Dim mi As MenuItem = DirectCast(sender, MenuItem)
                Dim AuthData() As String = mi.Text.Split(",")
                Dim Auth As TrackAuthority.TrackAuthority = FindTrackAuthority(AuthData(0))
                If Auth Is Nothing Then Exit Sub

                Dim AuthorityCanBeModified As Boolean
                Dim terr As Territory
                For Each terr In TMDS.GlobalDeclarations.ControlledTerritories
                    If terr.TerritoryID = Auth.TerritoryAssignment Then
                        AuthorityCanBeModified = True
                        Exit For
                    End If
                Next

                If AuthorityCanBeModified Then
                    If SystemForms.MySystemForms.frmTrackAuthority Is Nothing Then
                        SystemForms.MySystemForms.frmTrackAuthority = New frmTrackAuthority()
                    Else
                        'SystemForms.MySystemForms.frmTrackAuthority.Dispose()
                        SystemForms.MySystemForms.frmTrackAuthority = Nothing
                        SystemForms.MySystemForms.frmTrackAuthority = New frmTrackAuthority()
                    End If
                    SystemForms.MySystemForms.frmTrackAuthority.ModifyTrackAuthority(Auth)
                    SystemForms.MySystemForms.frmTrackAuthority.ShowDialog()
                    'ClearSystemVariables()
                    'SystemForms.MySystemForms.frmTrackAuthority.Dispose()
                    SystemForms.MySystemForms.frmTrackAuthority = Nothing
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub mnuTTRollup_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try
                Me.TrackEventLog("Clicked - RollUp Track & Time from CM")
                Dim mi As MenuItem = DirectCast(sender, MenuItem)
                Dim AuthData() As String = mi.Text.Split(",")
                Dim Auth As TrackAuthority.TrackAuthority = FindTrackAuthority(AuthData(0))
                If Not IsNothing(Auth) Then
                    Me.DoRollUpAuthority(Auth)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

