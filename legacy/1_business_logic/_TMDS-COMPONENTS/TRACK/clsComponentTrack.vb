                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Remve track tag for all desks
        ''' </summary>
        ''' <param name="pTag"></param>
        Private Sub RemoveTrackTagforAllDesks(pTag As Tag)
            Dim dbConn As OleDbConnection = Nothing
            Dim dbComm As OleDbCommand = Nothing
            Dim dbReader As OleDbDataReader = Nothing
            Dim issueTo, trackTagList, newTrackTagList As String
            Dim query As New StringBuilder
            Try
                TrackEventLog("RemoveTrackTagforAllDesks:TagID=" & pTag.TagGuid)
                dbConn = New OleDbConnection(gConnectionStringDynamic)
                dbConn.Open()
                'Get track tag in db
                dbComm = New OleDbCommand("SELECT IssuedTo,TrackTagList FROM tblSystemTabularGeneralBulletinActive WHERE TrackTagList LIKE '%" & pTag.TagGuid & "%'", dbConn)
                dbReader = dbComm.ExecuteReader()
                While dbReader.Read
                    If Not dbReader.IsDBNull(0) Then
                        issueTo = dbReader.GetString(0)
                        trackTagList = dbReader.GetString(1)
                        newTrackTagList = ChangeTrackTag(pTag, trackTagList)
                        'Update track tag in db
                        query.Append("UPDATE tblSystemTabularGeneralBulletinActive")
                        query.Append(" SET TrackTagList = '" & newTrackTagList & "'")
                        query.Append(" WHERE IssuedTo = '" & issueTo & "'")
                        dbComm = New OleDbCommand(query.ToString, dbConn)
                        TrackEventLog("RemoveTrackTagforAllDesks:TagID=" & pTag.TagGuid & ":Train=" & issueTo & ":TagList=" & newTrackTagList)
                        dbComm.ExecuteNonQuery()
                    End If
                End While
                dbConn.Close()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                If dbConn IsNot Nothing Then dbConn.Dispose()
                dbConn = Nothing
                If dbComm IsNot Nothing Then dbComm.Dispose()
                dbComm = Nothing
                dbReader = Nothing
                issueTo = Nothing
                trackTagList = Nothing
                newTrackTagList = Nothing
                query = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Change track tag
        ''' </summary>
        ''' <param name="pTag"></param>
        ''' <param name="pInfo"></param>
        ''' <returns></returns>
        Private Function ChangeTrackTag(pTag As Tag, pInfo As String) As String
            Dim tagAux As String
            Dim tagListSplit As String()
            Dim tagList As New ArrayList
            Dim index As Integer
            Dim newTagList As New StringBuilder
            Try
                tagListSplit = pInfo.Split("|")
                For Each tag As String In tagListSplit
                    tagList.Add(tag)
                Next
                tagAux = pTag.TagGuid & ";" & pTag.Subdivision & ";ADD"
                For Each tag As String In tagList
                    If tag = tagAux Then
                        index = tagList.LastIndexOf(tag)
                        tagList.Item(index) = pTag.TagGuid & ";" & pTag.Subdivision & ";CANCELLED"
                        TrackEventLog("ChangeTrackTag:TagIDcancelled=" & pTag.TagGuid)
                        Exit For
                    End If
                Next
                For Each s As String In tagList
                    If newTagList.Length = 0 Then
                        newTagList.Append(s)
                    Else
                        newTagList.Append("|")
                        newTagList.Append(s)
                    End If
                Next
                Return newTagList.ToString
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                tagAux = Nothing
                tagListSplit = Nothing
                tagList = Nothing
                index = Nothing
                newTagList = Nothing
            End Try
        End Function

