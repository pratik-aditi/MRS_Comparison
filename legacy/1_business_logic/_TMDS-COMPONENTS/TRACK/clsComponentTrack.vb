        Public Sub DoCreateBulletin()
            Try

                Select Case Me.AuthorityType
                    Case "SHELF", "OTHER"
                        Exit Sub
                End Select

                If gEntryTrack Is Nothing Then
                    gEntryTrack = Me
                    gDeviceBlockSelection.Add(Me)
                    Me.SelectionMode = ModeSelection.DeviceBlocking
                    Me.FlashComponent = True
                    TMDS.SystemForms.MySystemForms.frmMainMDI.DeviceBlockFlasherReset()
                ElseIf gExitTrack Is Nothing Then
                    gExitTrack = Me
                ElseIf Not gExitTrack Is Nothing Then
                    gEntryTrack = gExitTrack
                    gExitTrack = Me
                Else
                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearDeviceSelection()
                    ClearSystemVariables()
                    Exit Sub
                End If

                If Not gEntryTrack Is Nothing And Not gExitTrack Is Nothing Then
                    If Not Me.GetBulletinRoute(gEntryTrack, gExitTrack) Then
                        TMDS.SystemForms.MySystemForms.frmMainMDI.ClearDeviceSelection()
                        ClearSystemVariables()
                        Exit Sub
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function GetBulletinRoute(EntryTrack As Track, ExitTrack As Track) As Boolean
            Try
                Dim Direction As String = "RIGHT"
                Dim LoopControl As Integer
                Dim TrackList As New ArrayList
                Dim ExitTrackFound As Boolean
                TrackList.Add(EntryTrack)

                Dim NextComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(EntryTrack.RightLink)
                If EntryTrack.GUID = ExitTrack.GUID Then
                    ExitTrackFound = True
                End If
                Do Until ExitTrackFound
                    If NextComp.GetType.ToString = gTrackComponentName Then
                        Dim trk As Track = CType(NextComp, Track)
                        TrackList.Add(trk)
                        gDeviceBlockSelection.Add(trk)
                        trk.SelectionMode = ModeSelection.DeviceBlocking
                        trk.FlashComponent = True
                        TMDS.SystemForms.MySystemForms.frmMainMDI.DeviceBlockFlasherReset()
                        If trk.GUID = ExitTrack.GUID Then
                            ExitTrackFound = True
                            Exit Do
                        End If
                    End If
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                    LoopControl += 1
                    If LoopControl > 25 Then
                        Exit Do
                    End If
                Loop

                If Not ExitTrackFound Then
                    Direction = "LEFT"
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(EntryTrack.LeftLink)
                    Dim t As Track
                    For Each t In gDeviceBlockSelection
                        t.SelectionMode = ModeSelection.Regular
                        t.FlasherMode(False)
                    Next
                    gDeviceBlockSelection.Clear()
                    TrackList.Clear()
                    gDeviceBlockSelection.Add(EntryTrack)
                    TrackList.Add(EntryTrack)

                    EntryTrack.SelectionMode = ModeSelection.DeviceBlocking
                    EntryTrack.FlashComponent = True
                    TMDS.SystemForms.MySystemForms.frmMainMDI.DeviceBlockFlasherReset()
                    Do Until ExitTrackFound
                        If NextComp.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = CType(NextComp, Track)
                            TrackList.Add(trk)
                            gDeviceBlockSelection.Add(trk)
                            trk.SelectionMode = ModeSelection.DeviceBlocking
                            trk.FlashComponent = True
                            TMDS.SystemForms.MySystemForms.frmMainMDI.DeviceBlockFlasherReset()
                            If trk.GUID = ExitTrack.GUID Then
                                ExitTrackFound = True
                                Exit Do
                            End If
                        End If
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        LoopControl += 1
                        If LoopControl > 50 Then
                            Exit Do
                        End If
                    Loop

                End If
                If Not ExitTrackFound Then
                    Return False
                End If

                LaunchBulletinForm(EntryTrack, ExitTrack, Direction, gDeviceBlockSelection)

                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Sub LaunchBulletinForm(EntryTrack As Track, ExitTrack As Track, Direction As String, TrackCollection As ArrayList)
            Try
                Dim RightMileage As Double
                Dim LeftMileage As Double
                If Direction = "RIGHT" Then
                    RightMileage = EntryTrack.LeftLimitMilePost
                    LeftMileage = ExitTrack.RightLimitMilePost
                Else
                    LeftMileage = ExitTrack.LeftLimitMilePost
                    RightMileage = EntryTrack.RightLimitMilePost
                End If

                Dim LowMile As Double
                Dim HighMile As Double
                If LeftMileage > RightMileage Then
                    HighMile = LeftMileage
                    LowMile = RightMileage
                Else
                    HighMile = RightMileage
                    LowMile = LeftMileage
                End If

                Dim Prefix As String = EntryTrack.MilePostPrefix
                Dim Suffix As String = EntryTrack.MilePostSuffix

                Dim frmBulletinHMI As New frmBulletinHMI
                frmBulletinHMI.SelectedTrackCollection = TrackCollection
                frmBulletinHMI.SetFormValues(gCreateBulletinType, LowMile, HighMile, Prefix, Suffix, EntryTrack.mySubdivision.Name, Nothing, Nothing, EntryTrack)

                frmBulletinHMI.Owner = SystemForms.MySystemForms.frmSystemSummary
                frmBulletinHMI.Location = New Point(SystemForms.MySystemForms.frmSystemSummary.Location.X + 100, SystemForms.MySystemForms.frmSystemSummary.Location.Y + 100)
                frmBulletinHMI.ShowDialog()
                frmBulletinHMI.Dispose()
                frmBulletinHMI = Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoTrackAuthority(ByVal e As MouseEventArgs)
            Try

                If Me.AuthorityType <> "CTC" AndAlso Me.AuthorityType <> "TWC" Then ClearSystemVariables() : Exit Sub
                If gOptDisableTrackSelectionOnTurnOut AndAlso Me.TurnOutType Then Exit Sub
                If Me.IsLinkToRemoteTrack And Me.DisallowTNTOnRegionSplit Then
                    Exit Sub
                End If


                If optEnableRouteBlocking Then
                    If Me.RouteBlockingEnabled Then
                        If Me.RightLimitName = "IGNORE" And Me.LeftLimitName = "IGNORE" Then
                            Exit Sub
                        End If
                    End If
                End If

                If gBeginTrackSelect Is Nothing Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrSelectionFlasher.Enabled = True
                    gBeginTrackSelect = Me
                    TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionAdd(Me)


                    If Not optDisableExpandOutLogicOnOsTracks Then
                        Me.AddOSComponents(gTrackSelectionCollection)
                    End If
                    If optEnableRouteBlocking Then
                        If Me.RouteBlockingEnabled Then
                            Me.ExpandOutForComponentsForRouteBlocking(gTrackSelectionCollection)
                        Else
                            Me.ExpandOutForComponents(gTrackSelectionCollection)
                        End If
                    Else
                        Me.ExpandOutForComponents(gTrackSelectionCollection)
                    End If

                    If optEnableBRCSpecificChecks = True Then
                        If DoSelectAllALikeTracks(gTrackSelectionCollection) Then
                            Me.AddOSComponents(gTrackSelectionCollection)
                        End If
                    End If



                    TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionReset()

                    Dim comp As Object
                    For Each comp In gTrackSelectionCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If comp.IsRemoteTrack Then
                                If Not comp.myRemoteTrack.SendBlockPendingStatus(True, True) Then
                                    DisplayPromptRegardingLinkFailure()
                                    ClearSystemVariables()
                                    Exit Sub
                                End If
                            End If
                        End If
                    Next


                    FirstTrackSelectionMousePoint = e.X
                    Me.TrackEventLog("SELECTED BEGINNING TRACK(AUTHORITY):" & Me.GUID.ToString)
                ElseIf gBeginTrackSelect Is Me Then
                    If Not IsNothing(gEndTrackSelect) Then
                        If gTrackSelectionCollection.Contains(gEndTrackSelect) Then
                            TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionClear()
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    End If
                    TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionAdd(Me)
                    If Not optDisableExpandOutLogicOnOsTracks Then
                        Me.AddOSComponents(gTrackSelectionCollection)
                    End If
                    Me.ExpandOutForComponents(gTrackSelectionCollection)
                    TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionReset()

                    'If Mid(gBeginTrackSelect.AuthorityType, 1, 3) <> "CTC" Then
                    '    ClearSystemVariables()
                    '    MessageBox.Show(Me, "Route Selected Is Not CTC Controlled", "System Message", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    '    Exit Sub
                    'End If

                    gEndTrackSelect = Me
                    If gSearchDirection = "" Then
                        If FirstTrackSelectionMousePoint > e.X Then
                            gSearchDirection = "LEFT"
                        ElseIf FirstTrackSelectionMousePoint <= e.X Then
                            gSearchDirection = "RIGHT"
                        Else
                            gSearchDirection = ""
                        End If
                    Else
                        TMDS.modSystemFuncs.ClearSystemVariables()
                        TMDS.SystemForms.MySystemForms.frmMainMDI.tmrSelectionFlasher.Enabled = True
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    'ADDED FOR REMOTE BLOCKING
                    Dim CompToTest As Object
                    Dim LeftLink As Track = Nothing
                    Dim RightLink As Track = Nothing
                    For Each CompToTest In gTrackSelectionCollection
                        If CompToTest.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If CompToTest.IsLinkToRemoteTrack Then
                                LeftLink = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(CompToTest.LeftLink)
                                RightLink = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(CompToTest.RightLink)
                                Exit For
                            End If
                        End If
                    Next
                    If Not IsNothing(LeftLink) Then
                        If Not gTrackSelectionCollection.Contains(LeftLink) Then
                            gTrackSelectionCollection.Add(LeftLink)
                        End If
                    End If
                    If Not IsNothing(RightLink) Then
                        If Not gTrackSelectionCollection.Contains(RightLink) Then
                            gTrackSelectionCollection.Add(RightLink)
                        End If
                    End If

                    Me.TrackEventLog("SELECTED ENDING TRACK(AUTHORITY):" & Me.GUID.ToString)
                    'SystemForms.MySystemForms.frmMainMDI.ShowLimits()
                Else
                    gEndTrackSelect = Me

                    Me.TrackEventLog("SELECTED ENDING TRACK(AUTHORITY):" & Me.GUID.ToString)
                    'TMDS.SystemForms.MySystemForms.frmMainMDI.SearchForEndOfCTCTrack()
                    TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(System.Windows.Forms.Cursors.WaitCursor)
                    If TMDS.SystemForms.MySystemForms.frmMainMDI.SearchRouteForEndOfCTCTrack(True) Then
                        TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curTrackAuthority)

                        If optEnableARRCSpecificOptions Then
                            If optAllowAutoSwitchReverseIntoSidingForTNT AndAlso Mid(gBeginTrackSelect.AuthorityType.ToUpper.Trim, 1, 3) = "CTC" Then
                                gBeginTrackSelect = TMDS.SystemUtilities.FetchData.FindLastTrackInList(gTrackSelectionCollection)
                            End If
                        Else
                            If optAllowAutoSwitchReverseIntoSidingForTNT Then
                                gBeginTrackSelect = TMDS.SystemUtilities.FetchData.FindLastTrackInList(gTrackSelectionCollection)
                            End If
                        End If


                        'gBeginTrackSelect = Me
                    End If
                End If

                If optEnableARRCSpecificOptions Then
                    Dim comp As Object = Nothing
                    For Each comp In gTrackSelectionCollection
                        If comp.GetType.ToString = gTrackComponentName Then
                            If Not TMDS.SystemUtilities.FetchData.IsMainTypeTrack(comp) Then
                                ClearSystemVariables()
                                Exit Sub
                            End If
                        End If
                    Next
                End If

                If optEnableTerritoryDeskAssignmentMode Then
                    If IsValidJointControlComponents(gTrackSelectionCollection) Then
                        LockJointControlComponent(gTrackSelectionCollection)
                    Else
                        TrackEventLog("Track in Use Exiting:" & Me.GUID.ToString)
                        MessageBox.Show(Me.CurrentDrawingForm, "TRACK IN USE BY OTHER DESK- EXITING!", "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Exit Sub
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

