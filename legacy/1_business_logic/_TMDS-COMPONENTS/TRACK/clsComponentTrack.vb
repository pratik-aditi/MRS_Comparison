        Public Function DoDeviceBlockForRemoteTrack(ByVal pAddToCollection As Boolean, ByVal pDeviceBlock As Boolean, Optional pRemoteTrack As Boolean = False) As Boolean
            Try
                Me.TrackEventLog("DoDeviceBlockForRemoteTrack:Start:WhoCallMe=" & (New System.Diagnostics.StackTrace).GetFrame(1).GetMethod.Name)
                '--------------------
                If pRemoteTrack Then
                    Dim LeftRemoteTrack As Object = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.LeftLink)
                    Dim RightRemoteTrack As Object = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.RightLink)

                    If Not LeftRemoteTrack Is Nothing Then
                        If LeftRemoteTrack.IsRemoteTrack Then
                            If pAddToCollection Then
                                If Not LeftRemoteTrack.myRemoteTrack.SendBlockRemotePendingStatus(True, pDeviceBlock, True) Then
                                    Return False
                                End If
                                If Not gDeviceBlockSelection.Contains(LeftRemoteTrack) Then
                                    gDeviceBlockSelection.Add(LeftRemoteTrack)
                                End If
                            Else
                                gDeviceBlockSelection.Remove(LeftRemoteTrack)
                                If Not LeftRemoteTrack.myRemoteTrack.SendBlockRemotePendingStatus(False, pDeviceBlock, True) Then
                                    Return False
                                End If
                            End If
                        End If
                    End If
                    If Not RightRemoteTrack Is Nothing Then
                        If RightRemoteTrack.IsRemoteTrack Then
