#Region "OTHER TRACK FUNCTIONS"

        Private Function FindExitTrack(ByVal OStrk As Track, ByVal trn As TrainID) As Track
            Try
                Dim LoopControl As Integer
                Dim NextComp As Object
                Dim LastRefNumber As Int32

                Dim Direction As String = String.Empty

                Dim trk As Object
                If Not IsNothing(OStrk.OsComponentCollection) Then
                    For Each trk In OStrk.OsComponentCollection
                        If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If trk.TrafficDirection <> "" Then
                                Direction = trk.TrafficDirection
                                Exit For
                            End If
                        End If
                    Next
                End If

                If Direction = "" Then
                    Direction = trn.Direction
                    If Direction = optDirectionWest Or Direction = optDirectionNorth Then
                        Direction = "RIGHT"
                        NextComp = Me.FindObjectTypeFromGUID(OStrk.RightLink)
                    Else
                        Direction = "LEFT"
                        NextComp = Me.FindObjectTypeFromGUID(OStrk.LeftLink)
                    End If
                Else
                    If Direction = "RIGHT" Then
                        NextComp = Me.FindObjectTypeFromGUID(OStrk.RightLink)
                    Else
                        NextComp = Me.FindObjectTypeFromGUID(OStrk.LeftLink)
                    End If
                End If
                LastRefNumber = NextComp.GUID

                Do
                    If NextComp Is Nothing Then Return Nothing
                    If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        If Direction = "RIGHT" Then
                            If NextComp.ControlledReverse Then
                                If LastRefNumber = NextComp.LeftAltLink Then
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                                Else
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.RightAltLink)
                                End If
                            Else
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                            End If
                        Else
                            If NextComp.ControlledReverse Then
                                If LastRefNumber = NextComp.RightAltLink Then
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                                Else
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftAltLink)
                                End If
                            Else
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                            End If
                        End If
                    ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If Direction = "RIGHT" Then
                            If NextComp.ComponentType = "L" Then
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                                If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                                End If
                                Return NextComp
                            Else
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                            End If
                        Else
                            If NextComp.ComponentType = "R" Then
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                                If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                                End If
                                Return NextComp
                            Else
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                            End If
                        End If
                    Else
                        LastRefNumber = NextComp.GUID
                        If Direction = "RIGHT" Then
                            NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                        Else

                            NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                        End If
                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl > 20 Then
                        Return Nothing
                    End If
                Loop
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        ''' <summary>
        ''' Track event log
        ''' </summary>
        ''' <param name="message">message to write in log</param>
        Private Sub TrackEventLog(message As String)
            Try
                SystemEvent($"{NameOf(Track)} {Name}:{GUID}:{TrafficDirection}:{message}")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindNextTrack(ByVal GUID As Integer, ByVal SearchDirection As String) As Object
            Dim comp As Object = Nothing
            Dim Nextcomp As Object = Nothing
            Try


                comp = FindCompFromGUID(GUID)
                If comp.GetType.ToString = gTrackComponentName Then
                    Return comp
                End If
                For i As Integer = 0 To 5
                    Nextcomp = Nothing
                    Select Case SearchDirection.Trim.ToUpper
                        Case "RIGHT"
                            Nextcomp = FindCompFromGUID(comp.RightLink)
                        Case "LEFT"
                            Nextcomp = FindCompFromGUID(comp.LeftLink)
                    End Select

                    If Nextcomp.GetType.ToString = gTrackComponentName Then
                        Return Nextcomp
                    End If
                    comp = Nextcomp
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Nextcomp = Nothing
                comp = Nothing
            End Try
            Return Nothing
        End Function

        Private Function FindTagExitTrack(ByVal OStrk As Track, ByVal TagDirection As String) As Track
            Dim NextComp As Object
            Dim OSColl As New ArrayList
            Try
                Dim LoopControl As Integer
                Dim LastRefNumber As Int32
                Dim Direction As String = String.Empty

                If Not IsNothing(OStrk.OsComponentCollection) Then
                    Dim trk As Object
                    For Each trk In OStrk.OsComponentCollection
                        If Not OSColl.Contains(trk) Then
                            OSColl.Add(trk)
                        End If
                    Next
                Else
                    Return Nothing
                End If

                Select Case TagDirection
                    Case "RIGHT"
                        Direction = "RIGHT"
                        NextComp = Me.FindObjectTypeFromGUID(OStrk.RightLink)
                    Case Else
                        NextComp = Me.FindObjectTypeFromGUID(OStrk.LeftLink)
                End Select

                LastRefNumber = NextComp.GUID

                Do
                    If NextComp Is Nothing Then
                        Return Nothing
                    End If

                    If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        If Direction = "RIGHT" Then
                            If NextComp.ControlledReverse Then
                                If LastRefNumber = NextComp.LeftAltLink Then
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                                Else
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.RightAltLink)
                                End If
                            Else
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                            End If
                        Else
                            If NextComp.ControlledReverse Then
                                If LastRefNumber = NextComp.RightAltLink Then
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                                Else
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftAltLink)
                                End If
                            Else
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                            End If
                        End If
                    ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If Direction = "RIGHT" Then
                            If NextComp.ComponentType = "L" Then
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                                If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                                End If
                                Return NextComp
                            Else
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                            End If
                        Else
                            If NextComp.ComponentType = "R" Then
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                                If NextComp.GetType.ToString <> "TMDS.TrackComponents.Track" Then
                                    NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                                End If
                                Return NextComp
                            Else
                                NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                            End If
                        End If
                    Else
                        LastRefNumber = NextComp.GUID
                        If Direction = "RIGHT" Then
                            NextComp = Me.FindObjectTypeFromGUID(NextComp.RightLink)
                        Else

                            NextComp = Me.FindObjectTypeFromGUID(NextComp.LeftLink)
                        End If
                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl > 20 Then
                        Return Nothing
                    End If
                Loop
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                NextComp = Nothing
                OSColl = Nothing
            End Try
        End Function

