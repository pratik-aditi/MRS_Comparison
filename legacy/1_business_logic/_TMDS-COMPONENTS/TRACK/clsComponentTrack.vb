        Function CanTrainBeTracked(ByVal pComp As Object) As Boolean
            Try
                Dim NewTrackRef As Object = Nothing
                Dim override As Boolean = False
                If pComp.GetType.ToString = gTrackComponentName AndAlso pComp.OsComponentCollection IsNot Nothing AndAlso pComp.OsComponentCollection.Count > 0 Then
                    For Each NewTrackRef In pComp.OsComponentCollection
                        If NewTrackRef.GetType.ToString = gTrackComponentName Then
                            If NewTrackRef.TrainIDTracked Then
                                override = True
                                Exit For
                            End If
                        End If
                    Next
                End If
                If Not override Then
                    If Not pComp.TrainIDTracked Then
                        Return True
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False
        End Function

        Private Function ValidateReverseMovementIntoOS(ByVal pComp As Object) As Boolean
            Dim mySig As Signal = Nothing
            Dim comp As Object = Nothing
            Try
                If pComp.GetType.ToString = gTrackComponentName AndAlso pComp.OsComponentCollection IsNot Nothing AndAlso pComp.OsComponentCollection.Count > 0 AndAlso pComp.TrainIDTracked Then
                    mySig = TMDS.SystemUtilities.FetchData.FindMyControllingSignal(pComp, pComp.TrafficDirection)
                    If mySig IsNot Nothing AndAlso mySig.SignalIndStatus = Signal.IndStatus.Cleared Then
                        For Each comp In pComp.OsComponentCollection
                            If comp.GetType.ToString = gTrackComponentName Then
                                If comp.TrainIDs IsNot Nothing AndAlso comp.TrainIDs.Count > 0 Then
                                    Return False
                                End If
                            End If
                        Next
                        Return True
                    End If

                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                mySig = Nothing
            End Try
        End Function

        Public Sub MoveTrainIDToNonIndicatingTrack(ByRef NonIndTrack As Track, ByRef PrevTrack As Track, ByRef trn As TrainID)
            Try
                If Not PrevTrack.SimulateMode Then
                    Threading.Thread.Sleep(1000)
                    NonIndTrack.MoveTrainIDPlace(trn, PrevTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T")
                    NonIndTrack.InvalidateTrainID()
                End If

                If NonIndTrack.TrainIDs.Count > 0 Then
                    If NonIndTrack.ReleaseTrainIDTrack Then
                        Threading.Thread.Sleep(1000)
                        If optApplyTrainSheetConfigurationForKCT Then
                            Me.ReleaseTrainID(0, TMDS.GlobalDeclarations.TrainCollection, False, True)
                            Me.InvalidateTrainID()
                        Else
                            NonIndTrack.ReleaseTrainID(0, TMDS.GlobalDeclarations.TrainCollection)
                            NonIndTrack.InvalidateTrainID()
                        End If

                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function ReleaseTrainIDCheckBRC(ByRef Postion As Integer) As Boolean
            'If ReleaseTrain ID=true, and occupancy = false, and  traffic=left, and     left link=0, and     left alt link=0, and      ALT (1) link=0,    then release ID“
            'or
            'If Release Train ID=true, and occupancy = false, and  traffic=right, and   right link=0, and  right alt link=0, and   ALT (2) link=0    then release ID“

            Dim OkToRelease As Boolean = True
            Dim Comp As Object = Nothing
            Dim trnsColl As TrainID = Nothing
            Dim trn As TrainID = Nothing
            Dim TrnDirection As String = ""
            Dim FlipDirection As Boolean = False
            Dim MyTrafficDirection As String = Me.TrafficDirection
            Dim TrnPosition As Integer = 0
            Dim counter As Integer = 0
            Try
                If optCheckForTerritoryFlipDirectionEnabled Then
                    FlipDirection = Me.myTerritory.FlipDirection
                End If
                If Me.TrainIDs IsNot Nothing AndAlso Me.TrainIDs.Count > 0 Then
                    Select Case Me.TrainIDs.Count
                        Case 1
                            trn = Me.TrainIDs(0)
                        Case Else
                            For Each trnsColl In Me.TrainIDs
                                Select Case trnsColl.Direction
                                    Case optDirectionEast, optDirectionNorth
                                        If FlipDirection Then
                                            If MyTrafficDirection = "LEFT" Then trn = trnsColl : TrnPosition = counter
                                        Else
                                            If MyTrafficDirection = "RIGHT" Then trn = trnsColl : TrnPosition = counter
                                        End If

                                    Case optDirectionWest, optDirectionSouth
                                        If FlipDirection Then
                                            If MyTrafficDirection = "RIGHT" Then trn = trnsColl : TrnPosition = counter
                                        Else
                                            If MyTrafficDirection = "LEFT" Then trn = trnsColl : TrnPosition = counter
                                        End If
                                End Select
                                counter = counter + 1
                            Next
                    End Select
                Else
                    Exit Function
                End If
                If trn Is Nothing Then Exit Function

                Select Case trn.Direction
                    Case optDirectionEast, optDirectionNorth
                        If FlipDirection Then
                            TrnDirection = "LEFT"
                        Else
                            TrnDirection = "RIGHT"
                        End If

                    Case optDirectionWest, optDirectionSouth
                        If FlipDirection Then
                            TrnDirection = "RIGHT"
                        Else
                            TrnDirection = "LEFT"
                        End If
                    Case Else
                        TrnDirection = ""
                End Select


                Select Case TrnDirection.Trim.ToUpper
                    Case "", "NONE"
                        Me.TrackEventLog("Release Train ID Failed : [TRAIN DIRECTION IS NONE OR CANNOT BE DETERMINED]" & trn.Name & " Train Direction: " & trn.Direction.Trim.ToUpper & " Traffic Direction: " & Me.TrafficDirection.Trim.ToUpper)
                        Exit Function
                    Case Else
                        If TrnDirection.Trim.ToUpper <> MyTrafficDirection.Trim.ToUpper Then
                            Me.TrackEventLog("Release Train ID Failed :" & trn.Name & " Train Direction: " & trn.Direction.Trim.ToUpper & " Traffic Direction: " & Me.TrafficDirection.Trim.ToUpper)
                            Exit Function
                        End If
                End Select



                If Me.ReleaseTrainIDTrack Then
                    If TrnDirection.Trim.ToUpper = MyTrafficDirection.Trim.ToUpper Then
                        Select Case MyTrafficDirection
                            Case "LEFT"
                                If Me.LeftAltLink <> 0 Then OkToRelease = False
                                If Me.LeftLink <> 0 Then
                                    Comp = FindCompFromGUID(Me.LeftLink)
                                    If Comp.GetType.ToString = gSignalComponentName Then
                                        If Not Comp.MakeInvisible Then OkToRelease = False
                                    Else
                                        OkToRelease = False
                                    End If
                                End If
                            Case "RIGHT"
                                If Me.RightAltLink <> 0 Then OkToRelease = False
                                If Me.RightLink <> 0 Then
                                    Comp = FindCompFromGUID(Me.RightLink)
                                    If Comp.GetType.ToString = gSignalComponentName Then
                                        If Not Comp.MakeInvisible Then OkToRelease = False
                                    Else
                                        OkToRelease = False
                                    End If
                                End If
                            Case Else
                                OkToRelease = False
                        End Select
                    End If

                    If OkToRelease Then
                        Postion = TrnPosition
                        Return True
                    End If



                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                trn = Nothing
                Comp = Nothing
            End Try
            Return False
        End Function

        Public Sub PushTrainIDToNextOccupancy(ByVal TrkToPushFrom As Track, ByVal trn As TrainID, ByVal Direction As String)
            Try
                Dim LoopControl As Integer
                Dim NextComp As Object = Nothing
                Dim LastTrack As Object = Nothing
                Dim LastTrackOccuppied As Track = Nothing
                Dim mainDirection As String = Direction
                'SystemEvent("TRACING PUSHTRAINIDTONEXTOCCUPANCY:" & TrkToPushFrom.GUID & ":" & Direction.ToString)                
                If mainDirection.Equals(optDirectionLeft) Then
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(TrkToPushFrom.LeftLink)
                    LastTrack = TrkToPushFrom
                    If trn.Direction = optDirectionEast Or trn.Direction = optDirectionNorth Then
                        Exit Sub
                    End If
                Else
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(TrkToPushFrom.RightLink)
                    LastTrack = TrkToPushFrom
                    If optEnableBRCSpecificChecks AndAlso Me.myTerritory.FlipDirection Then
                        If trn.Direction = optDirectionEast Or trn.Direction = optDirectionNorth Then
                            Exit Sub
                        End If
                    Else
                        If trn.Direction = optDirectionWest Or trn.Direction = optDirectionSouth Then
                            Exit Sub
                        End If
                    End If
                End If

                Do
                    If mainDirection.Equals(optDirectionLeft) Then
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim currentTrk As Track = CType(NextComp, Track)
                            If currentTrk.Name <> LastTrack.Name Then
                                If currentTrk.Occuppied Then
                                    If currentTrk.OStype Then
                                        Dim trk As Track
                                        If Not IsNothing(currentTrk.OsComponentCollection) Then
                                            For Each trk In currentTrk.OsComponentCollection
                                                If trk.TrainIDs.Count = 0 Then
                                                    If trk.TrainIDPlace Then
                                                        LastTrackOccuppied = trk
                                                        'new code
                                                        'LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                                                        'Exit Sub
                                                        'new code
                                                        Exit For
                                                    End If
                                                Else
                                                    LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                                                    Exit Sub
                                                End If
                                            Next
                                        Else
                                            LastTrackOccuppied = currentTrk
                                        End If
                                    Else
                                        If currentTrk.TrainIDs.Count = 0 Then
                                            LastTrackOccuppied = currentTrk
                                        Else
                                            If LastTrackOccuppied.TrackIndicationANDED Or LastTrackOccuppied.TrackIndicationORED Then
                                                LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                                            End If
                                            Exit Sub
                                        End If
                                    End If
                                Else
                                    If Not IsNothing(LastTrackOccuppied) Then
                                        If LastTrackOccuppied.TrackIndicationANDED Or LastTrackOccuppied.TrackIndicationORED Then
                                            LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                                        ElseIf LastTrackOccuppied.OStype Then
                                            LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                                        End If
                                    ElseIf LastTrack IsNot Nothing Then
                                        Dim possibleFinalTrack As Track = DirectCast(LastTrack, Track)
                                        If possibleFinalTrack.Occuppied Then
                                            If possibleFinalTrack.TrackIndicationANDED OrElse possibleFinalTrack.TrackIndicationORED Then
                                                possibleFinalTrack.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", possibleFinalTrack.TrafficDirection)
                                            ElseIf possibleFinalTrack.OStype Then
                                                possibleFinalTrack.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", possibleFinalTrack.TrafficDirection)
                                            End If
                                        End If
                                    End If
                                    Exit Sub
                                End If
                            End If

                            LastTrack = NextComp
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)

                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(NextComp, Switch)
                            If sw.LeftAltLink <> 0 Then
                                If sw.ControlledReverse Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftAltLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftLink)
                                End If
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftLink)
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            If Not IsNothing(LastTrackOccuppied) Then
                                LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                            ElseIf LastTrack IsNot Nothing Then
                                Dim possibleFinalTrack As Track = DirectCast(LastTrack, Track)
                                If possibleFinalTrack.Occuppied Then
                                    possibleFinalTrack.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", possibleFinalTrack.TrafficDirection)
                                End If
                            End If
                            Exit Sub
                        ElseIf TypeOf NextComp Is FlipFlop Then
                            If LastTrack.GUID = NextComp.LeftLink Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                            mainDirection = optDirectionRight
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If

                    ElseIf mainDirection.Equals(optDirectionRight) Then

                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim currentTrk As Track = CType(NextComp, Track)

                            If currentTrk.Name <> LastTrack.Name Then
                                If currentTrk.Occuppied Then
                                    If currentTrk.OStype Then
                                        Dim trk As Track
                                        If Not IsNothing(currentTrk.OsComponentCollection) Then
                                            For Each trk In currentTrk.OsComponentCollection
                                                If trk.TrainIDs.Count = 0 Then
                                                    If trk.TrainIDPlace Then
                                                        LastTrackOccuppied = trk
                                                        Exit For
                                                    End If
                                                Else
                                                    If LastTrackOccuppied.TrackIndicationANDED Or LastTrackOccuppied.TrackIndicationORED Then
                                                        LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                                                    End If
                                                    Exit Sub
                                                End If
                                            Next
                                        Else
                                            LastTrackOccuppied = currentTrk
                                        End If
                                    Else
                                        If currentTrk.TrainIDs.Count = 0 Then
                                            LastTrackOccuppied = currentTrk
                                        Else
                                            If LastTrackOccuppied.TrackIndicationANDED Or LastTrackOccuppied.TrackIndicationORED Then
                                                LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                                            ElseIf LastTrack IsNot Nothing Then
                                                Dim possibleFinalTrack As Track = DirectCast(LastTrack, Track)
                                                If possibleFinalTrack.Occuppied Then
                                                    If possibleFinalTrack.TrackIndicationANDED OrElse possibleFinalTrack.TrackIndicationORED Then
                                                        possibleFinalTrack.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", possibleFinalTrack.TrafficDirection)
                                                    ElseIf possibleFinalTrack.OStype Then
                                                        possibleFinalTrack.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", possibleFinalTrack.TrafficDirection)
                                                    End If
                                                End If
                                            End If
                                            Exit Sub
                                        End If

                                    End If
                                Else
                                    If Not IsNothing(LastTrackOccuppied) Then
                                        LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                                    End If

                                    Exit Sub
                                End If

                            End If

                            LastTrack = NextComp
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)

                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(NextComp, Switch)
                            If sw.RightAltLink <> 0 Then
                                If sw.ControlledReverse Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightAltLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightLink)
                                End If
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightLink)
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            If Not IsNothing(LastTrackOccuppied) Then
                                LastTrackOccuppied.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", LastTrackOccuppied.TrafficDirection)
                            ElseIf LastTrack IsNot Nothing Then
                                Dim possibleFinalTrack As Track = DirectCast(LastTrack, Track)
                                If possibleFinalTrack.Occuppied Then
                                    possibleFinalTrack.MoveTrainIDPlace(trn, TrkToPushFrom, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", possibleFinalTrack.TrafficDirection)
                                End If
                            End If
                            Exit Sub
                        ElseIf TypeOf NextComp Is FlipFlop Then
                            If LastTrack.GUID = NextComp.RightLink Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If
                            mainDirection = optDirectionLeft
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If

                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl > 35 Then
                        Exit Sub
                    End If
                Loop

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Sub TrackTrainIDOn()
            Dim NextTrackFound, SearchRightComplete, SearchLeftComplete As Boolean
            Dim CompToCheck As Object = Nothing
            Dim NextReferenceNumber, LastRefNumber As Int32
            Dim LoopControl As Integer
            Dim LoopControlExternal As Integer
            Dim trn As TrainID = Nothing
            Dim trn1 As TrainID
            Dim trn2 As TrainID
            Dim trk As Object = Nothing
            Dim trnSym As String = String.Empty
            Dim ShelfTrack As Track = Nothing
            Dim myTrafficDirection As String = String.Empty
            Dim trainDirectionAux As String
            Try
                TrackEventLog("TrackTrainIDOn:Start")
                If (gAssistMode OrElse Me.IsShadowMode) AndAlso Not optTrackTrainIdOnAssistMode Then Exit Sub
                If Me.IsRemoteTrack Then Exit Sub
                myTrafficDirection = Me.TrafficDirection
                If optEnableARRCSpecificOptions Then
                    If Me.AuthorityType = "TWC" AndAlso Me.Indicating Then
                        If Me.TrackAuthorities IsNot Nothing AndAlso Me.TrackAuthorities.Count > 0 Then
                            Dim auth As TMDS.TrackAuthority.SFAuthority
                            For Each auth In Me.TrackAuthorities
                                If auth IsNot Nothing AndAlso auth.GetType.ToString = gSFAComponentName Then
                                    If auth.AuthType1 = gSFAAuthorityTypeItem4 Then
                                        myTrafficDirection = ""
                                        Exit For
                                    End If
                                End If
                            Next
                        End If
                    End If
                End If
                LastRefNumber = Me.GUID
                If myTrafficDirection.Equals(optDirectionRight) Then
                    NextReferenceNumber = LeftLink
                ElseIf myTrafficDirection.Equals(optDirectionLeft) Then
                    NextReferenceNumber = RightLink
                End If
                While Not NextTrackFound AndAlso Not myTrafficDirection.Equals(String.Empty)
                    If myTrafficDirection.Equals(optDirectionRight) Then
                        CompToCheck = Me.FindObjectTypeFromGUID(NextReferenceNumber)
                        If CompToCheck Is Nothing Then
                            If Me.RightAltLink <> 0 Then
                                ShelfTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.RightAltLink)
                                If ShelfTrack.TrainIDs.Count > 0 Then
                                    trn2 = Nothing
                                    trn2 = ShelfTrack.TrainIDs(0)
                                    If Not IsTrainMoveAllowedOnIndication(trn2, "TrackTrainIDOn") Then Exit Sub
                                    Me.MoveTrainIDPlace(trn2, ShelfTrack, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                    SearchLeftComplete = True
                                    SearchRightComplete = True
                                    Exit While
                                End If
                            End If

                            SearchLeftComplete = True
                            SearchRightComplete = True
                            Exit While
                        End If
                        If CompToCheck.GetType.ToString = gSwitchComponentName Then
                            Dim sw As Switch = CType(CompToCheck, Switch)
                            If sw.FlipOperations Then
                                If sw.ControlledReverse Then
                                    NextReferenceNumber = CompToCheck.LeftLink
                                Else
                                    If sw.LeftAltLink = 0 Then
                                        NextReferenceNumber = CompToCheck.LeftLink
                                    Else
                                        NextReferenceNumber = CompToCheck.LeftAltLink
                                    End If
                                End If
                            Else
                                If sw.ControlledReverse Then
                                    NextReferenceNumber = CompToCheck.LeftAltLink
                                Else
                                    NextReferenceNumber = CompToCheck.LeftLink
                                End If
                            End If
                        ElseIf CompToCheck.GetType.ToString = gSignalComponentName Then
                            NextReferenceNumber = CompToCheck.LeftLink
                        ElseIf CompToCheck.GetType.ToString = gTrackComponentName Then
                            LastRefNumber = NextReferenceNumber
                            Dim theTrack As Track = DirectCast(CompToCheck, Track)
                            If (CompToCheck.StationNumber = Me.StationNumber AndAlso CompToCheck.Name = Me.Name) Or
                        ((optEnableBRCSpecificChecks Or optEnableSpecificOptionsForFECR) AndAlso CompToCheck.StationNumber = Me.StationNumber And CompToCheck.Ind(0) Is Me.Ind(0)) Then
                                If Not theTrack.Occuppied And Not theTrack.OStype Then
                                    SearchRightComplete = True
                                    Exit While
                                Else
                                    NextReferenceNumber = CompToCheck.LeftLink
                                End If
                            Else
                                If theTrack.IsRemoteTrack Then
                                    trnSym = theTrack.myRemoteTrack.RequestTrainID()
                                    If Not String.IsNullOrEmpty(trnSym) Then
                                        theTrack.myRemoteTrack.PlaceTrainID(trnSym)
                                        Dim rightTrack As Track = theTrack.myRemoteTrack.myRightTrack
                                        If rightTrack?.TrainIDs.Count > 0 Then
                                            Dim train As TrainID = rightTrack.TrainIDs.Item(0)
                                            If Not IsTrainMoveAllowedOnIndication(train, GetCurrentMethod.Name) Then Exit Sub
                                            MoveTrainIDPlace(train, rightTrack, OStype, gDatabaseConnectionTrain, "T", TrafficDirection)
                                        End If
                                    End If
                                    SearchLeftComplete = True
                                    SearchRightComplete = True
                                    Exit While
                                End If
                                'MRS: WAS EXITING THE WHILE BEFORE THE REMOTE LINK COULD BE ESTABLISHED IF EXSISTED. THIS IS GOING IN RIGHT DIRECTION
                                'trk = CType(CompToCheck, Track)
                                If Not CompToCheck.Occuppied And CompToCheck.TrainIDs.Count = 0 Then
                                    SearchLeftComplete = True
                                    SearchRightComplete = True
                                    Exit While
                                End If
                                If CompToCheck.TrainIDs.Count > 0 Then
                                    trn = Nothing
                                    trn = CompToCheck.TrainIDs(0)
                                    If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainIDOn") Then Exit Sub
                                    'ADDED CODE TO CHECK AHEAD OF THIS TRACK INDICATION AND SEE IF THERE IS A NON-INDICATING TRACK TO MOVE THIS
                                    'TRAIN ID FURTHER THEN THIS TRACK THAT IS INDICATING
                                    Dim NonIndTrack As Track = SearchForNonIndicatingTrack(Me, Me.TrafficDirection)
                                    If Not NonIndTrack Is Nothing Then
                                        Me.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                        ''Me.InvalidateTrainID()
                                        If Not Me.SimulateMode Then
                                            If Not NonIndTrack.IsRemoteTrack Then
                                                Dim MoveTrainToNonIndicating As New DoMoveTrainIDToNonIndicatingTrack(AddressOf Me.MoveTrainIDToNonIndicatingTrack)
                                                MoveTrainToNonIndicating.BeginInvoke(NonIndTrack, Me, trn, Nothing, Nothing)
                                            ElseIf NonIndTrack.IsRemoteTrack Then
                                                If trn.Direction = optDirectionEast Or trn.Direction = optDirectionNorth Then
                                                    NonIndTrack.myRemoteTrack.TrackTrainID(trn.Name)
                                                End If
                                            End If
                                        End If
                                    Else
                                        Me.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                        If Me.OStype Then
                                            CompToCheck.PushTrainIDToNextOccupancy(Me, trn, "RIGHT")
                                        End If
                                    End If
                                    Exit While
                                Else
                                    If (CompToCheck.Occuppied) Or (Not CompToCheck.Occuppied And Not CompToCheck.Indicating) Then
                                        Dim OSTrackCollection As ArrayList
                                        OSTrackCollection = CompToCheck.OsComponentCollection
                                        If Not OSTrackCollection Is Nothing Then
                                            For Each trk In OSTrackCollection
                                                If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                    If trk.TrainIDs.Count > 0 Then
                                                        trn1 = Nothing
                                                        trn1 = trk.TrainIDs(0)
                                                        'This avoid than symbol moves for an OS occupied with direction divergent
                                                        trainDirectionAux = IIf(trn1.Direction = "SUBINDO", "RIGHT", "LEFT")
                                                        Dim trlAux As Track = CType(trk, Track)
                                                        If Me.EnableControlledSiding AndAlso
                                                    Me.AuthorityType.Contains("CTC") AndAlso
                                                    (trainDirectionAux <> Me.TrafficDirection Or trlAux.TrackName <> Me.TrackName) Then
                                                            TrackEventLog("TrackTrainIDOn:Symbol " & trn1.Name & " has a direction or track name divergent to OS occupied")
                                                            Exit Sub
                                                        End If
                                                        If Not IsTrainMoveAllowedOnIndication(trn1, "TrackTrainIDOn") Then Exit Sub
                                                        'CHECK FOR TRACKS THAT ARE ANDED OR ORED AND ARE INDICATED OCCUPIED BEFORE THIS TRACK FOUND OCCUPIED.
                                                        If Me.TrackIndicationORED Or Me.TrackIndicationANDED Then
                                                            Dim NextTrackToCheck As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.RightLink)
                                                            If Not NextTrackToCheck Is Nothing Then
                                                                If Not NextTrackToCheck.Ind(0) Is Nothing Then
                                                                    If Not NextTrackToCheck.Ind(1) Is Nothing Then
                                                                        If Not Me.Ind(1) Is Nothing Then
                                                                            If (NextTrackToCheck.Ind(0) Is Me.Ind(0)) Or (NextTrackToCheck.Ind(0) Is Me.Ind(1)) Or (NextTrackToCheck.Ind(1) Is Me.Ind(0)) Then
                                                                                NextTrackToCheck.MoveTrainIDPlace(trn1, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                                                                If Me.OStype Then
                                                                                    NextTrackToCheck.PushTrainIDToNextOccupancy(Me, trn1, "RIGHT")
                                                                                End If
                                                                                SearchLeftComplete = True
                                                                                Exit While
                                                                            End If
                                                                        End If
                                                                    End If
                                                                End If
                                                            End If
                                                        End If
                                                        Me.MoveTrainIDPlace(trn1, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                                        If Me.OStype Then
                                                            CompToCheck.PushTrainIDToNextOccupancy(Me, trn1, "RIGHT")
                                                        ElseIf Me.IsLinkToRemoteTrack Then
                                                            Dim RightTrk As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.RightLink)
                                                            If Not IsNothing(RightTrk) Then
                                                                If RightTrk.IsRemoteTrack And ((RightTrk.Occuppied And (RightTrk.TrackIndicationANDED Or RightTrk.TrackIndicationORED)) Or RightTrk.IsShelfTrack) Then
                                                                    trnSym = String.Empty
                                                                    'trnSym = RightTrk.myRemoteTrack.RequestTrainID("LEFT")
                                                                    trnSym = RightTrk.myRemoteTrack.RequestTrainID()
                                                                    If trnSym = "" Then
                                                                        RightTrk.myRemoteTrack.TrackTrainID(trn1.Name)
                                                                        TrackEventLog("SUB EVENT-888-remote")
                                                                    End If
                                                                End If
                                                            End If
                                                        End If
                                                    End If
                                                End If
                                            Next
                                        Else
                                            Dim comp As Object
                                            For Each comp In CompToCheck.myControlPoint.AssignedComponenets
                                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" And comp.Name = CompToCheck.Name Then
                                                    If comp.TrainIDs.Count > 0 Then
                                                        trn1 = Nothing
                                                        trn1 = comp.TrainIDs(0)
                                                        If Not IsTrainMoveAllowedOnIndication(trn1, "TrackTrainIDOn") Then Exit Sub
                                                        Me.MoveTrainIDPlace(trn1, comp, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                                        If Me.OStype Then
                                                            comp.PushTrainIDToNextOccupancy(Me, trn1, "RIGHT")
                                                        ElseIf Me.IsLinkToRemoteTrack Then
                                                            Dim RightTrk As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.RightLink)
                                                            If Not IsNothing(RightTrk) Then
                                                                If RightTrk.IsRemoteTrack And (RightTrk.Occuppied Or RightTrk.IsShelfTrack) Then
                                                                    trnSym = String.Empty
                                                                    'trnSym = RightTrk.myRemoteTrack.RequestTrainID("LEFT")
                                                                    trnSym = RightTrk.myRemoteTrack.RequestTrainID()
                                                                    If trnSym = "" Then
                                                                        RightTrk.myRemoteTrack.TrackTrainID(trn1.Name)
                                                                        TrackEventLog("SUB EVENT-999-remote")
                                                                    End If
                                                                End If
                                                            End If
                                                        End If
                                                        SearchLeftComplete = True
                                                        Exit While
                                                    End If
                                                End If
                                            Next
                                        End If
                                        'this code to to look backwards for a Train ID until a unoccupied OS is found
                                        If (Not CompToCheck.OStype) Then
                                            NextReferenceNumber = CompToCheck.LeftLink
                                        Else
                                            SearchLeftComplete = True
                                            Exit While
                                        End If
                                    End If
                                End If
                            End If
                        ElseIf CompToCheck.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                            'Dim ff As FlipFlop
                            NextReferenceNumber = CompToCheck.FindExitGUID(LastRefNumber)
                            myTrafficDirection = optDirectionLeft
                        ElseIf CompToCheck.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                            Dim RR As RRXING = CType(CompToCheck, RRXING)
                            NextReferenceNumber = RR.FindExitGUID(LastRefNumber)
                        Else
                            NextReferenceNumber = CompToCheck.LeftLink
                        End If
                        LoopControl = LoopControl + 1
                        'ElseIf Me.TrafficDirection = "LEFT" Then
                    ElseIf myTrafficDirection.Equals(optDirectionLeft) Then
                        CompToCheck = Me.FindObjectTypeFromGUID(NextReferenceNumber)
                        If CompToCheck Is Nothing Then
                            If Me.LeftAltLink <> 0 Then
                                ShelfTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.LeftAltLink)
                                If ShelfTrack.TrainIDs.Count > 0 Then
                                    trn2 = Nothing
                                    trn2 = ShelfTrack.TrainIDs(0)
                                    If Not IsTrainMoveAllowedOnIndication(trn2, "TrackTrainIDOn") Then Exit Sub
                                    Me.MoveTrainIDPlace(trn2, ShelfTrack, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                    SearchLeftComplete = True
                                    SearchRightComplete = True
                                    Exit While
                                End If
                            End If
                            SearchLeftComplete = True : Exit While
                        End If
                        If CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(CompToCheck, Switch)
                            If CompToCheck.ControlledReverse Then
                                If sw.FlipOperations Then
                                    NextReferenceNumber = CompToCheck.RightLink
                                Else
                                    If sw.RightAltLink <> 0 Then
                                        NextReferenceNumber = sw.RightAltLink
                                    Else
                                        NextReferenceNumber = sw.RightLink
                                    End If
                                End If
                            Else
                                If Not sw.FlipOperations Then
                                    NextReferenceNumber = CompToCheck.RightLink
                                Else
                                    NextReferenceNumber = CompToCheck.RightAltLink
                                End If
                            End If
                        ElseIf CompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            NextReferenceNumber = CompToCheck.RightLink
                        ElseIf CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            LastRefNumber = NextReferenceNumber
                            If CompToCheck.NonTransverable Then Exit While
                            ' add 6-6-04 if trying to tyrack through a piece of track that is non tranversable exit the sub
                            If (CompToCheck.StationNumber = Me.StationNumber And CompToCheck.Name = Me.Name) Or (CompToCheck.StationNumber = Me.StationNumber And CompToCheck.Ind(0) Is Me.Ind(0)) Then
                                trk = CType(CompToCheck, Track)
                                If Not trk.Occuppied And Not trk.OStype Then
                                    SearchLeftComplete = True
                                    Exit While
                                Else
                                    NextReferenceNumber = CompToCheck.RightLink
                                End If
                            Else
                                If Not CompToCheck.Occuppied And CompToCheck.TrainIDs.Count = 0 AndAlso Not CompToCheck.IsRemoteTrack Then
                                    SearchLeftComplete = True : Exit While
                                End If
                                If CompToCheck.IsRemoteTrack Then
                                    Dim theTrack As Track = DirectCast(CompToCheck, Track)
                                    trnSym = theTrack.myRemoteTrack.RequestTrainID()
                                    If Not String.IsNullOrEmpty(trnSym) Then
                                        theTrack.myRemoteTrack.PlaceTrainID(trnSym)
                                        Dim leftTrack As Track = theTrack.myRemoteTrack.myLeftTrack
                                        If leftTrack.TrainIDs.Count > 0 Then
                                            Dim train As TrainID = leftTrack.TrainIDs.Item(0)
                                            If Not IsTrainMoveAllowedOnIndication(train, GetCurrentMethod.Name) Then Exit Sub
                                            MoveTrainIDPlace(train, leftTrack, OStype, gDatabaseConnectionTrain, "T", TrafficDirection)
                                        End If
                                    End If
                                    SearchLeftComplete = True
                                    SearchRightComplete = True
                                    Exit While
                                ElseIf optEnableShadowModeRemoteLink AndAlso
                            CompToCheck.IsShadowRemoteTrack AndAlso
                            CompToCheck.myRemoteTrack IsNot Nothing Then
                                    Dim theTrack As Track = Me
                                    trnSym = theTrack.myRemoteTrack.RequestTrainID()
                                    If Not String.IsNullOrEmpty(trnSym) Then
                                        theTrack.myRemoteTrack.PlaceTrainID(trnSym)
                                        Dim leftTrack As Track = theTrack.myRemoteTrack.myLeftTrack
                                        If leftTrack.TrainIDs.Count > 0 Then
                                            Dim train As TrainID = leftTrack.TrainIDs.Item(0)
                                            If Not IsTrainMoveAllowedOnIndication(train, GetCurrentMethod.Name) Then Exit Sub
                                            MoveTrainIDPlace(train, leftTrack, OStype, gDatabaseConnectionTrain, "T", TrafficDirection)
                                        End If
                                    End If
                                    SearchLeftComplete = True
                                    SearchRightComplete = True
                                    Exit While
                                End If
                                If CompToCheck.TrainIDs.Count > 0 Then
                                    trn = Nothing
                                    trn = CompToCheck.TrainIDs(0)
                                    If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainIDOn") Then Exit Sub
                                    'ADDED CODE TO CHECK AHEAD OF THIS TRACK INDICATION
                                    'AND SEE IF THERE IS A NON-INDICATING TRACK TO MOVE THIS
                                    'TRAIN ID FURTHER THEN THIS TRACK THAT IS INDICATING
                                    Dim NonIndTrack As Track = SearchForNonIndicatingTrack(Me, Me.TrafficDirection)
                                    If Not NonIndTrack Is Nothing Then
                                        Me.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                        If Not Me.SimulateMode Then
                                            If Not NonIndTrack.IsRemoteTrack Then
                                                Dim MoveTrainToNonIndicating As New DoMoveTrainIDToNonIndicatingTrack(AddressOf Me.MoveTrainIDToNonIndicatingTrack)
                                                MoveTrainToNonIndicating.BeginInvoke(NonIndTrack, Me, trn, Nothing, Nothing)
                                            ElseIf NonIndTrack.IsRemoteTrack Then
                                                If trn.Direction = optDirectionWest Or trn.Direction = optDirectionSouth Then
                                                    NonIndTrack.myRemoteTrack.TrackTrainID(trn.Name)
                                                End If
                                            End If
                                        End If
                                    Else
                                        'CHECK FOR TRACKS THAT ARE ANDED OR ORED AND ARE INDICATED OCCUPIED BEFORE THIS TRACK FOUND OCCUPIED.
                                        If Me.TrackIndicationORED Or Me.TrackIndicationANDED Then
                                            Dim NextTrackToCheck As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.LeftLink)
                                            If Not NextTrackToCheck Is Nothing Then
                                                If Not NextTrackToCheck.Ind(0) Is Nothing Then
                                                    If Not NextTrackToCheck.Ind(1) Is Nothing Then
                                                        If Not Me.Ind(1) Is Nothing Then
                                                            If (NextTrackToCheck.Ind(0) Is Me.Ind(0)) Or (NextTrackToCheck.Ind(0) Is Me.Ind(1)) Or (NextTrackToCheck.Ind(1) Is Me.Ind(0)) Then
                                                                NextTrackToCheck.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                                                ' NextTrackToCheck.InvalidateTrainID()
                                                                If Me.OStype Then
                                                                    NextTrackToCheck.PushTrainIDToNextOccupancy(Me, trn, "LEFT")
                                                                End If
                                                                SearchLeftComplete = True
                                                                Exit While
                                                            End If
                                                        End If
                                                    End If
                                                End If
                                            End If
                                        End If
                                        Me.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                        If Me.OStype Then
                                            CompToCheck.PushTrainIDToNextOccupancy(Me, trn, "LEFT")
                                        End If
                                    End If
                                    SearchLeftComplete = True
                                    Exit While
                                Else
                                    If CompToCheck.Occuppied Or (Not CompToCheck.Occuppied And Not CompToCheck.Indicating) Then
                                        'If (CompToCheck.OStype And CompToCheck.Occuppied) Or (Not CompToCheck.Occuppied And Not CompToCheck.Indicating) Then
                                        'If Me.OStype Then
                                        Dim OSTrackCollection As ArrayList
                                        OSTrackCollection = CompToCheck.OsComponentCollection
                                        If Not OSTrackCollection Is Nothing Then
                                            For Each trk In OSTrackCollection
                                                If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                    If trk.TrainIDs.Count > 0 Then
                                                        trn1 = Nothing
                                                        trn1 = trk.TrainIDs(0)
                                                        'This avoid than symbol moves for an OS occupied with direction divergent
                                                        trainDirectionAux = IIf(trn1.Direction = "SUBINDO", "RIGHT", "LEFT")
                                                        Dim trlAux As Track = CType(trk, Track)
                                                        If Me.EnableControlledSiding AndAlso
                                                    Me.AuthorityType.Contains("CTC") AndAlso
                                                    (trainDirectionAux <> Me.TrafficDirection Or trlAux.TrackName <> Me.TrackName) Then
                                                            TrackEventLog("TrackTrainIDOn:Symbol " & trn1.Name & " has a direction or track name divergent to OS occupied")
                                                            Exit Sub
                                                        End If
                                                        If Not IsTrainMoveAllowedOnIndication(trn1, "TrackTrainIDOn") Then Exit Sub
                                                        'CHECK FOR TRACKS THAT ARE ANDED OR ORED AND ARE INDICATED OCCUPIED BEFORE THIS TRACK FOUND OCCUPIED.
                                                        If Me.TrackIndicationORED Or Me.TrackIndicationANDED Then
                                                            Dim NextTrackToCheck As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.LeftLink)
