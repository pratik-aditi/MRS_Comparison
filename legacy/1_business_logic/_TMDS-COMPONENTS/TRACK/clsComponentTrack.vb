                                                                                End If
                                                                            End If
                                                                        End If
                                                                    End If
                                                                End If
                                                                Me.MoveTrainIDPlace(trn, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", "LEFT")
