                            If Train.KeyTrain AndAlso Not String.IsNullOrEmpty(optKeyTrainSymbolPrefix) AndAlso optKeyTrainSymbolPrefix.Trim <> "" Then
                                Train.DisplayText = optKeyTrainSymbolPrefix & Train.DisplayText '"K" & Train.DisplayText
                            End If
