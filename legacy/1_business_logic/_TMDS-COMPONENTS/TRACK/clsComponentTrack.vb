                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Application.DoEvents()
            End Try
        End Sub

        ''' <summary>
        ''' Build menu for extend license license in split desk
        ''' </summary>
        Private Sub BuildExtendLicenseinSplitDeskMenus()
            Dim mnuTrainExtendLicense As MenuItem
            Dim mnuDiv As MenuItem
            Dim myAuth As TrackAuthority.TrackAuthority
            Try
                If Not optEnableExtendLicenseinSplitDesk Then
                    Exit Sub
                End If
                If Not Me.IsLinkToRemoteTrack Then
                    Exit Sub
                End If
                mnuDiv = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuExtendLicenseinSplitDeskDiv))
                mnuDiv.Visible = False
                mnuTrainExtendLicense = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuExtendLicenseinSplitDeskTrain))
                mnuTrainExtendLicense.Visible = False
                'Clear menus
                If Me.TrackAuthorities.Count = 0 Then
                    Exit Sub
                End If
                'Stuck license. TODO: Make a function to remove stuck license
                If Me.TrackAuthorities.Count > 1 Then
                    TrackEventLog("BuildExtendLicenseinSplitDeskMenus:More than one license in split desk")
                    Exit Sub
                End If
                myAuth = Me.TrackAuthorities.Item(0)
                'Get train id from db
                If myAuth.myTrain Is Nothing Then
                    Dim TrainAux As TrainID = FindTrainBySymbol(myAuth.TrainSymbol)
                    If TrainAux IsNot Nothing Then
                        TrackEventLog("BuildExtendLicenseinSplitDeskMenus:TestLog:Train " & myAuth.TrainSymbol & " already exist. Train=" & TrainAux.myTrack.GUID)
                        If TrainAux.myTrack IsNot Nothing Then
                            TrackEventLog("BuildExtendLicenseinSplitDeskMenus:TestLog:Train=" & TrainAux.myTrack.GUID)
                        End If
                    End If
                    TrainAux = Nothing
                    'Check if already exist the train
                    For Each foundTrain As TrainID In Me.TrainIDs
                        If foundTrain.Name = myAuth.TrainSymbol Then
                            TrackEventLog("BuildExtendLicenseinSplitDeskMenus:Train already exist in track. Remote train " & myAuth.TrainSymbol & " added and assigned to track")
                            myAuth.myTrain = foundTrain
                            myAuth.myTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain
                            myAuth.myTrain.thisCurrentLicense = myAuth
                            Exit For
                        End If
                    Next
                    If myAuth.myTrain Is Nothing Then
                        myAuth.myTrain = RetrieveTrainID(myAuth.TrainSymbol)
                        myAuth.myTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain
                        myAuth.myTrain.thisCurrentLicense = myAuth
                        Me.TrainIDs.Add(myAuth.myTrain)
                        TrackEventLog("BuildExtendLicenseinSplitDeskMenus:New remote train " & myAuth.TrainSymbol & " added and assigned to track")
                    End If
                End If
                'Just for Remote Trains
                If myAuth.myTrain.TrainRegionStatus <> TrainRegionEnum.RemoteTrain Then
                    TrackEventLog("BuildExtendLicenseinSplitDeskMenus:Train is not a remote train. Train=" & myAuth.TrainSymbol)
                    Exit Sub
                End If
                'Check if license is pending
                If myAuth.GetRemoteTransmissionInProgress() Then
                    mnuExtendLicenseinSplitDeskTrain.Text = myAuth.TrainSymbol & " (AGUARDANDO CONFIRMAÇÃO)"
                    mnuTrainExtendLicense = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuExtendLicenseinSplitDeskTrain))
                    mnuTrainExtendLicense.MenuItems.Clear()
                    mnuDiv = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuExtendLicenseinSplitDeskDiv))
                    mnuDiv.MenuItems.Clear()
                    mnuTrainExtendLicense.Visible = True
                    mnuDiv.Visible = True
                    TrackEventLog("BuildExtendLicenseinSplitDeskMenus:Remote Transmission In Progress. Train=" & myAuth.TrainSymbol)
                    Exit Sub
                End If
                'Check presence status
                If myAuth.myTrain IsNot Nothing AndAlso Not myAuth.myTrain.GetRemotePresenceNetwork(myAuth.myTrain.IdentifingUnit) Then
                    mnuExtendLicenseinSplitDeskTrain.Text = myAuth.TrainSymbol & " (BORDO SEM COMUNICAÇÃO)"
                    mnuTrainExtendLicense = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuExtendLicenseinSplitDeskTrain))
                    mnuTrainExtendLicense.MenuItems.Clear()
                    mnuDiv = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuExtendLicenseinSplitDeskDiv))
                    mnuDiv.MenuItems.Clear()
                    mnuTrainExtendLicense.Visible = True
                    mnuDiv.Visible = True
                    TrackEventLog("BuildExtendLicenseinSplitDeskMenus:Remote Network presence is off. Train=" & myAuth.TrainSymbol)
                    Exit Sub
                End If
                mnuExtendLicenseinSplitDeskTrain.Text = myAuth.TrainSymbol
                mnuTrainExtendLicense = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuExtendLicenseinSplitDeskTrain))
                mnuTrainExtendLicense.MenuItems.Clear()
                'Add submenus
                mnuTrainExtendLicense.MenuItems.Add(New MenuItem(optGraphicalCompContextMenuExtendLicenseinSlitDeskCreate, AddressOf Me.mnuExtendLicense_Click))
                mnuTrainExtendLicense.MenuItems.Add(New MenuItem(optGraphicalCompContextMenuExtendLicenseinSlitDeskCancel, AddressOf Me.mnuCancelLicense_Click))
                'mnuTrainExtendLicense.MenuItems.Add(New MenuItem(optGraphicalCompContextMenuExtendLicenseinSlitDeskCancelStoredLicense, AddressOf Me.mnuCancelStoredLicense_Click))
                'Enable/disable menus
                If myAuth.myTrain.myTacticalRoutes.Count = 0 Then
                    mnuTrainExtendLicense.MenuItems.Item(1).Enabled = False
                    'mnuTrainExtendLicense.MenuItems.Item(2).Enabled = False
                Else
                    mnuTrainExtendLicense.MenuItems.Item(1).Enabled = True
                    'mnuTrainExtendLicense.MenuItems.Item(2).Enabled = True
                End If
                'Add div
                mnuDiv = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuExtendLicenseinSplitDeskDiv))
                mnuDiv.MenuItems.Clear()
                mnuTrainExtendLicense.Visible = True
                mnuDiv.Visible = True
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                mnuTrainExtendLicense = Nothing
                mnuDiv = Nothing
                myAuth = Nothing
            End Try
        End Sub


