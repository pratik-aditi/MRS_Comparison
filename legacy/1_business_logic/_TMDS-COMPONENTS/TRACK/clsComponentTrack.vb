                        End If

                    End While

                    'if no candidate found for the right search then try to the left    
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.LeftLink)
                    LoopControl = 0
                    While Not SearchLeftComplete
                        If NextComp Is Nothing Then Exit While

                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
