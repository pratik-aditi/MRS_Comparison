        Private Sub ReportingPerformedForMRS()
            Try
                Dim timeWait As Date = Now
                Do While timeWait > Now.AddSeconds(-3)
                    If Not String.IsNullOrWhiteSpace(LastTrainSymbolOnMe) Then Exit Do
                    Threading.Thread.Sleep(200)
                Loop
                If Not Occuppied Then
                    If Not String.IsNullOrWhiteSpace(LastTrainSymbolOnMe) Then
                        Dim theData() As String = LastTrainSymbolOnMe.Split(" ")
                        Dim theSymbol() As String = theData(0).Split(":")
                        Dim theTrain As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(theSymbol(0), True)
                        If theTrain Is Nothing Then
                            theTrain = TMDS.SystemUtilities.FetchData.GetSystemTrainFromDatabase(theSymbol(0))
                        End If
                        If theTrain IsNot Nothing Then
                            Dim doReportEntry As Boolean
                            Dim doReportExit As Boolean
                            Select Case theTrain.Direction
                                Case optDirectionNorth, optDirectionEast 'right bound
                                    If Not HasMultipleExitPoints And IsReporingStationEntryRightBoundMovements Then
                                        doReportEntry = True
                                    ElseIf Not HasMultipleExitPoints And IsReporingStationEntryRightBoundMovements Then
                                        doReportExit = True
                                    ElseIf IsReporingStationExitRightBoundMovements Then
                                        doReportExit = True
                                    ElseIf IsPositionReportingTrack And IsReporingStationExitRightBoundMovements Then
                                        doReportExit = True
                                    End If
                                Case optDirectionSouth, optDirectionWest 'left bound
                                    If Not HasMultipleExitPoints And IsReporingStationEntryLeftBoundMovements Then
                                        doReportEntry = True
                                    ElseIf Not HasMultipleExitPoints And IsReporingStationEntryLeftBoundMovements Then
                                        doReportExit = True
                                    ElseIf IsReporingStationExitLeftBoundMovements Then
                                        doReportExit = True
                                    ElseIf IsPositionReportingTrack And IsReporingStationExitLeftBoundMovements Then
                                        doReportExit = True
                                    End If
                                Case Else
                                    Select Case theTrain.TrackingDirection
                                        Case "LEFT"
                                            If Not HasMultipleExitPoints And IsReporingStationEntryLeftBoundMovements Then
                                                doReportEntry = True
                                            ElseIf Not HasMultipleExitPoints And IsReporingStationEntryLeftBoundMovements Then
                                                doReportExit = True
                                            ElseIf Not HasMultipleExitPoints And IsReporingStationExitLeftBoundMovements Then
                                                doReportExit = True
                                            End If
                                        Case "RIGHT"
                                            If Not HasMultipleExitPoints And IsReporingStationEntryRightBoundMovements Then
                                                doReportEntry = True
                                            ElseIf Not HasMultipleExitPoints And IsReporingStationEntryRightBoundMovements Then
                                                doReportExit = True
                                            ElseIf IsReporingStationExitRightBoundMovements Then
                                                doReportExit = True
                                            End If
                                    End Select
                            End Select
                            If doReportEntry Then
                                theTrain.SendTrainPositionEvent(Me, myControlPoint, "ENTRY")
                                theTrain.OSLastDepartedTrack = Me
                                theTrain.PreviousOSReportingControlPoint = myControlPoint
                                If TrainCollectionForSplitDeskMRS.Count > 0 Then
                                    TrainCollectionForSplitDeskMRS.Remove(theTrain)
                                End If
                            ElseIf doReportExit Then
                                theTrain.SendTrainPositionEvent(Me, myControlPoint, "EXIT")
                                theTrain.OSLastDepartedTrack = Me
                                theTrain.PreviousOSReportingControlPoint = myControlPoint
                                If TrainCollectionForSplitDeskMRS.Count > 0 Then
                                    TrainCollectionForSplitDeskMRS.Remove(theTrain)
                                End If
                            End If
                        End If
                        RemoveTrainEventOnAllOSTracks()
                    End If
                    LastTrainSymbolOnMe = String.Empty
                Else
                    Dim theTrain As TrainID
                    If TrainIDs.Count > 0 Then
                        theTrain = TrainIDs(0)
                    Else
                        Dim theData() As String = LastTrainSymbolOnMe.Split(" ")
                        Dim theSymbol() As String = theData(0).Split(":")
                        theTrain = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(theSymbol(0))
                    End If
                    If theTrain IsNot Nothing Then
                        Dim doReport As Boolean
                        Select Case theTrain.Direction
                            Case optDirectionNorth, optDirectionEast 'right bound
                                If HasMultipleExitPoints And IsReporingStationEntryRightBoundMovements Then
                                    doReport = True
                                End If
                            Case optDirectionSouth, optDirectionWest 'left bound
                                If HasMultipleExitPoints And IsReporingStationEntryLeftBoundMovements Then
                                    doReport = True
                                End If
                            Case Else
                                Select Case theTrain.TrackingDirection
                                    Case "LEFT"
                                        If HasMultipleExitPoints And IsReporingStationEntryLeftBoundMovements Then
                                            doReport = True
                                        End If
                                    Case "RIGHT"
                                        If HasMultipleExitPoints And IsReporingStationEntryRightBoundMovements Then
                                            doReport = True
                                        End If
                                End Select
                        End Select
                        If doReport Then
                            theTrain.SendTrainPositionEvent(Me, myControlPoint, "ENTRY")
                            theTrain.OSLastDepartedTrack = Me
                            theTrain.PreviousOSReportingControlPoint = myControlPoint
                            TMDS.GlobalDeclarations.TrainCollectionForSplitDeskMRS.Add(theTrain)
                        End If
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

