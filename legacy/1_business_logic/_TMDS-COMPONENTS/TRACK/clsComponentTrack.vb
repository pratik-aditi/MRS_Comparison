        Public Sub FindLikeTracks(ByVal LikeTrackList As ArrayList, ByVal TrackComponents As ArrayList)
            Try
                Dim compToFind As Object
                For Each compToFind In TrackComponents
                    If compToFind.TerritoryID = Me.TerritoryID Then
                        If compToFind.StationNumber = Me.StationNumber Then
                            If Not optExcludeIndicationLikeOsTracksWhenNonTransversable Then
                                If compToFind.Name = Me.Name Then
                                    If Not LikeTrackList.Contains(compToFind) Then
                                        LikeTrackList.Add(compToFind)
                                    End If
                                End If
                            Else
                                If optEnableRouteBlocking Then
                                    If compToFind.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        Dim trk As Track = CType(compToFind, Track)
                                        If Not trk.RouteBlockingEnabled Then
                                            If compToFind.Name = Me.Name And compToFind.TrackName = Me.TrackName And Me.RightLimitName = compToFind.RightLimitName And Me.LeftLimitName = compToFind.LeftLimitName Then
                                                If Not LikeTrackList.Contains(compToFind) Then
                                                    LikeTrackList.Add(compToFind)
                                                End If
                                            End If
                                        End If
                                    End If
                                Else
                                    If compToFind.Name = Me.Name And compToFind.TrackName = Me.TrackName Then
                                        If Not LikeTrackList.Contains(compToFind) Then
                                            LikeTrackList.Add(compToFind)
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub FindTouchingSwitchesFromSelectedTracks(ByVal LikeTrackList As ArrayList, ByVal SelectionList As ArrayList)
            Try
                'Use this routine to determine if any tracks in the selection collection is touching switches
                'if they are and they are not part of the collection then add them
                Dim DoFlip As Boolean = Me.FlipMe
                Dim compToTest As Object
                For Each compToTest In LikeTrackList
                    If compToTest.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim swToTest As Switch
                        For Each swToTest In SwitchCollection
                            If (swToTest.GUID = compToTest.LeftLink Or swToTest.GUID = compToTest.RightLink) And Not compToTest.RouteBlockingEnabled Then
                                If Not SelectionList.Contains(swToTest) Then
                                    'SyncLock SelectionList
                                    SelectionList.Add(swToTest)
                                    swToTest.FlipMe = DoFlip
                                    'End SyncLock
                                    Exit For
                                End If
                            End If
                        Next
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub AddOSComponents(ByRef SelectionList As ArrayList)
            Try
                Dim LikeTracks As New ArrayList()
                If Me.OStype Then
                    Me.FindLikeTracks(LikeTracks, TrackCollection)
                End If
                Me.FindTouchingSwitchesFromSelectedTracks(LikeTracks, SelectionList)
                Dim DoFlip As Boolean = Me.FlipMe
                Dim comp As Object
                For Each comp In LikeTracks

                    If optEnableRouteBlocking Then
                        If Me.RouteBlockingEnabled Then
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim trk As Track = CType(comp, Track)
                                If trk.RightLimitName = comp.RightLimitName And Me.LeftLimitName = comp.LeftLimitName Then
                                    If Not SelectionList.Contains(comp) Then
                                        SelectionList.Add(comp)
                                        comp.FlipMe = DoFlip
                                    End If
                                End If
                            End If
                        Else
                            If Not SelectionList.Contains(comp) Then
                                SelectionList.Add(comp)
                                comp.FlipMe = DoFlip
                            End If
                        End If
                    Else
                        If Not SelectionList.Contains(comp) Then
                            SelectionList.Add(comp)
                            comp.FlipMe = DoFlip
                        End If
                    End If
                Next
                LikeTracks = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub AddTouchingSwitchPointMonitorSwitches(ByRef SelectionList As ArrayList)
            Try
                Dim swLeft As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(gBeginTrackSelect.LeftLink)
                Dim swRight As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(gBeginTrackSelect.RightLink)


                If Not IsNothing(swRight) Then
                    If swRight.NonOperationSwitchPointMonitor And swRight.SwitchPointerMonitorMode Then
                        If swRight.ComponentType = "SPRT" Or swRight.ComponentType = "SPRB" Then
                            If Not SelectionList.Contains(swRight) Then
                                If gSearchDirection = "LEFT" Then
                                    SelectionList.Insert(0, swRight)
                                Else
                                    SelectionList.Add(swRight)
                                End If
                            End If
                        End If
                    End If
                End If

                If Not IsNothing(swLeft) Then
                    If swLeft.NonOperationSwitchPointMonitor And swLeft.SwitchPointerMonitorMode Then
                        If swLeft.ComponentType = "SPLT" Or swLeft.ComponentType = "SPLB" Then
                            If Not SelectionList.Contains(swLeft) Then
                                If gSearchDirection = "RIGHT" Then
                                    SelectionList.Insert(0, swLeft)
                                Else
                                    SelectionList.Add(swLeft)
                                End If

                            End If
                        End If
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub ExtendOSComponents(ByRef SelectionList As ArrayList)
            Try
                Dim comp As Object
                If Not IsNothing(Me.OsComponentCollection) Then
                    For Each comp In Me.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If Not trk.NonTransverable Then
                                If Not SelectionList.Contains(comp) Then
                                    SelectionList.Add(comp)
                                End If
                            End If
                        Else
                            If Not SelectionList.Contains(comp) Then
                                SelectionList.Add(comp)
                            End If
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function AddAllOSComponents(ByVal GlobalTrackSelectCollection As ArrayList, ByVal AddSwitches As Boolean) As ArrayList
            Dim SearchingForEnd As Boolean = True
            Dim CompList As New ArrayList()
            Dim SearchDirection As Integer
            Dim NextCompToTest As Object
            Dim LoopTerminator As Int32

            Try
                For SearchDirection = 1 To 2
                    If SearchDirection = 1 Then
                        NextCompToTest = FindObjectTypeFromGUID(Me.RightLink)
                    Else
                        NextCompToTest = FindObjectTypeFromGUID(Me.LeftLink)
                    End If
                    While SearchingForEnd

                        If NextCompToTest Is Nothing Then Exit While

                        If NextCompToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If Not CompList.Contains(NextCompToTest) Then
                                CompList.Add(NextCompToTest)
                            End If
                            Exit While
                        ElseIf NextCompToTest.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If NextCompToTest.Name = Me.Name And NextCompToTest.StationNumber = Me.StationNumber Then
                                If Not CompList.Contains(NextCompToTest) Then
                                    CompList.Add(NextCompToTest)
                                End If
                                If SearchDirection = 1 Then
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.RightLink)
                                Else
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.LeftLink)
                                End If
                                If NextCompToTest Is Nothing Then Exit While
                                If NextCompToTest.GUID = 0 Then Exit While
                            Else
                                Exit While
                            End If
                        ElseIf NextCompToTest.GetType.ToString = "TMDS.SignalComponents.Signal" Then 'added 4-17-04
                            Exit While 'added 4-17-04
                        Else
                            If SearchDirection = 1 Then
                                NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.RightLink)
                            Else
                                NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.LeftLink)
                            End If
                            If NextCompToTest.GUID = 0 Then Exit While
                        End If
                    End While
                    LoopTerminator = LoopTerminator + 1
                    If LoopTerminator > 10000 Then
                        Return Nothing
                    End If
                Next SearchDirection

                Dim comp As Object = Nothing
                Dim NewCompsFound As ArrayList = Nothing
                For Each comp In CompList
                    If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        NewCompsFound = comp.FindAllTracksThatConnect()
                    End If
                Next

                If Not NewCompsFound Is Nothing Then
                    Dim CheckComp As Object
                    For Each CheckComp In NewCompsFound
                        If Not GlobalTrackSelectCollection.Contains(CheckComp) Then
                            GlobalTrackSelectCollection.Add(CheckComp)
                        End If
                    Next
                End If

                For Each comp In CompList
                    If Not GlobalTrackSelectCollection.Contains(comp) Then
                        If AddSwitches Then
                            GlobalTrackSelectCollection.Add(comp)
                        Else
                            If comp.GetType.ToString <> "TMDS.SwitchComponents.Switch" Then
                                GlobalTrackSelectCollection.Add(comp)
                            End If
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

