        ''' <summary>
        ''' Build planned trains menus
        ''' </summary>
        Private Sub BuildPlannedTrainsMenus()
            Try
                If Not optRailRoadEnumName = RailRoadName.RUMO OrElse
                    Not IsEntryForPTC Then Exit Sub
                If TrackAuthorities.Count > 0 OrElse
                    OStype Then
                    mnuPosTrain.Enabled = False
                    mnuPosTrainManeuverLoad.Enabled = False
                    mnuPosTrainManeuverEmpty.Enabled = False
                End If
                Dim mnuPlannedTrains As MenuItem =
                    ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuPosPlannedTrains))
                mnuPlannedTrains.MenuItems.Clear()
                Dim data As DataTable = gRepositories.TrainRepository.GetTrainsPlanned()
