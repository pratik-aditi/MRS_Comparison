        Overloads Sub DrawToBitmap(ByRef bp As Bitmap)
            Dim g As Graphics
            Try
                If GraphicalPathRelative Is Nothing Then
                    SystemException("GraphicalPathRelative has nothing MyGUID:[" & Me.GUID & "]" & vbCrLf & System.Environment.StackTrace.ToString)
                    Exit Sub
                End If
                g = Graphics.FromImage(bp)
                If SelectionMode = ModeSelection.DeviceBlocking Then
                    g.FillPath(ColorStatusBlocking, GraphicalPathRelative)
                ElseIf SelectionMode = ModeSelection.RouteRequesting Then
                    g.FillPath(ColorStatusRouteRequesting, Me.GraphicalPathRelative)
                ElseIf SelectionMode = ModeSelection.SummarySelectionBlocking Then
                    g.FillPath(ColorSummarySelectionBlocking, GraphicalPathRelative)
                ElseIf SelectionMode = ModeSelection.SummarySelectionRouting Then
                    g.FillPath(Me.ColorStatusRouteRequesting, GraphicalPathRelative)
                ElseIf SelectionMode = ModeSelection.OccupancySelectionBlocking Then
                    g.FillPath(Me.ColorStatusOccupancySelectionBlocking, GraphicalPathRelative)
                Else
                    If HatchItSpeed Or HatchItWorkZone Or HatchItInformational OrElse HatchItFormO Then
                        Dim myHatch As HatchBrush = Nothing
                        If HatchItWorkZone Then
                            myHatch = New HatchBrush(HatchStyle.DarkVertical, Color.Black, CurrentColorStatus.Color)
                        ElseIf HatchItSpeed Then
                            myHatch = New HatchBrush(HatchStyle.WideDownwardDiagonal, Color.Black, CurrentColorStatus.Color)
                        ElseIf HatchItInformational Then
                            myHatch = New HatchBrush(HatchStyle.WideUpwardDiagonal, Color.Black, CurrentColorStatus.Color)
                        ElseIf HatchItFormO Then
                            myHatch = New HatchBrush(HatchStyle.BackwardDiagonal, Color.Black, CurrentColorStatus.Color)
                        End If
                        g.FillPath(myHatch, GraphicalPathRelative)
                    Else
                        g.FillPath(CurrentColorStatus, GraphicalPathRelative)
                    End If
                    'g.FillPath(CurrentColorStatus, GraphicalPathRelative)
                End If
                g.Dispose()
                g = Nothing
            Catch ex As Exception
                g = Nothing
                If gDebug Then
                    SystemException(ex.ToString)
                End If
            End Try
        End Sub

        Public Sub DrawIt()
            Dim g As Graphics
            Try
                'g = Me.CreateGraphics
                If IsNothing(Me.Graphical) Then
                    Me.Graphical = Me.CreateGraphics
                End If
                g = Graphical

                SyncLock GraphicalPath

                    If FlashComponent Then
                        If FlashOn Then
                            If SelectionMode = ModeSelection.DeviceBlocking Then
                                g.FillPath(ColorStatusBlocking, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.RouteRequesting Then
                                g.FillPath(ColorStatusRouteRequesting, Me.GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.SummarySelectionBlocking Then
                                g.FillPath(ColorSummarySelectionBlocking, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.SummarySelectionRouting Then
                                g.FillPath(Me.ColorStatusRouteRequesting, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.OccupancySelectionBlocking Then
                                g.FillPath(Me.ColorStatusOccupancySelectionBlocking, GraphicalPathRelative)
                            ElseIf SelectionMode = ModeSelection.PTCIssuanceImminent Then
                                g.FillPath(Me.ColorStatusPTCIssuanceImminent, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.PTCIssuancePending Then
                                g.FillPath(Me.ColorStatusPTCIssuancePending, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.PTCReleasePending Then
                                g.FillPath(Me.ColorStatusPTCReleasePending, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.PTCReleaseImminent Then
                                g.FillPath(Me.ColorStatusPTCReleaseImminent, GraphicalPath)
                            Else
                                SyncLock g
                                    'SyncLock GraphicalPath
                                    g.FillPath(CurrentColorStatus, GraphicalPath)
                                    'End SyncLock
                                End SyncLock
                            End If
                        Else
                            g.FillPath(FlashOffColorStatus, GraphicalPath)
                        End If
                    Else
                        g.FillPath(CurrentColorStatus, Me.GraphicalPath)
                    End If
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Protected Overrides Sub OnPaint(ByVal e As System.Windows.Forms.PaintEventArgs)
            MyBase.OnPaint(e)
            Try
                If CurrentDrawingForm.Initializing Then Exit Sub
                If GraphicalPath Is Nothing Then
                    SystemException("Graphical Path has nothing: " & System.Environment.StackTrace.ToString)
                    Exit Sub
                End If

                SyncLock GraphicalPath
                    If FlashComponent Then
                        If FlashOn Then
                            If SelectionMode = ModeSelection.DeviceBlocking Then
                                e.Graphics.FillPath(ColorStatusBlocking, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.TagBlocking Then
                                e.Graphics.FillPath(ColorStatusTagRequesting, Me.GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.RouteRequesting Then
                                e.Graphics.FillPath(ColorStatusRouteRequesting, Me.GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.SummarySelectionBlocking Then
                                e.Graphics.FillPath(ColorSummarySelectionBlocking, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.SummarySelectionRouting Then
                                e.Graphics.FillPath(Me.ColorSummarySelectionRequesting, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.OccupancySelectionBlocking Then
                                e.Graphics.FillPath(Me.ColorStatusOccupancySelectionBlocking, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.PTCIssuanceImminent Then
                                e.Graphics.FillPath(Me.ColorStatusPTCIssuanceImminent, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.PTCIssuancePending Then
                                e.Graphics.FillPath(Me.ColorStatusPTCIssuancePending, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.PTCReleasePending Then
                                e.Graphics.FillPath(Me.ColorStatusPTCReleasePending, GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.PTCReleaseImminent Then
                                e.Graphics.FillPath(Me.ColorStatusPTCReleaseImminent, GraphicalPath)
                            Else
                                If Me.OverRideCodeBrown And Not gSimulationMode And Not optDisableShowingCodeFailureOnComponents Then
                                    e.Graphics.DrawPath(New Pen(gColorFailedState, 2), GraphicalPath)
                                End If
                                e.Graphics.FillPath(CurrentColorStatus, GraphicalPath)
                            End If
                        Else
                            e.Graphics.FillPath(FlashOffColorStatus, GraphicalPath)
                        End If
                    Else
                        If Me.DerailmentDetectorDisplayHatch Then
                            Dim myHatch As HatchBrush = Nothing
                            Dim myHatchColor As Color = Nothing
                            If Me.Occuppied Then
                                myHatchColor = Color.Black
                            Else
                                myHatchColor = Color.Red
                            End If
                            myHatch = New HatchBrush(HatchStyle.DarkVertical, myHatchColor, CurrentColorStatus.Color)
                            e.Graphics.FillPath(myHatch, Me.GraphicalPath)
                        ElseIf HatchItSpeed Or HatchItWorkZone Or HatchItInformational OrElse HatchItFormO Then
                            Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(Me.SubdivisionID)
                            If optEnableCNSpecificOptions AndAlso subdvn IsNot Nothing AndAlso subdvn.DisableMileageRangeCheck Then 'CN-1246
                                e.Graphics.FillPath(CurrentColorStatus, Me.GraphicalPath)
                            Else
                                Dim myHatch As HatchBrush = Nothing
                                If HatchItWorkZone Then
                                    myHatch = New HatchBrush(HatchStyle.DarkVertical, Color.Black, CurrentColorStatus.Color)
                                ElseIf HatchItSpeed Then
                                    myHatch = New HatchBrush(HatchStyle.WideDownwardDiagonal, Color.Black, CurrentColorStatus.Color)
                                ElseIf HatchItInformational Then
                                    myHatch = New HatchBrush(HatchStyle.DiagonalCross, Color.Black, CurrentColorStatus.Color)
                                ElseIf HatchItFormO Then
                                    myHatch = New HatchBrush(HatchStyle.BackwardDiagonal, Color.Black, CurrentColorStatus.Color)
                                End If
                                e.Graphics.FillPath(myHatch, Me.GraphicalPath)
                            End If
                        Else
                            e.Graphics.FillPath(CurrentColorStatus, Me.GraphicalPath)
                            If Me.OverRideCodeBrown And Me.FailState And Not gSimulationMode And Not optDisableShowingCodeFailureOnComponents Then
                                e.Graphics.DrawPath(New Pen(gColorFailedState, 4), GraphicalPath)
                            ElseIf Me.NonTransverable AndAlso optEnableShowStatusUnderNonTransverableTrack AndAlso Not optEnableAllowSwitchControlMovementWhileInCodeFailure Then
                                e.Graphics.DrawPath(New Pen(gColorNonTraverable, 6), GraphicalPath)
                            ElseIf Me.NonTransverable AndAlso optEnableAllowSwitchControlMovementWhileInCodeFailure Then
                                e.Graphics.FillPath(gColorNonTraverable, Me.GraphicalPath)
                                'gColorJointControlled
                            ElseIf gDisplayFeildBlockFailure AndAlso ApplyFBBlockOutline() Then
                                e.Graphics.DrawPath(New Pen(gShowFeildBlockingFaliureColor, 3), Me.GraphicalPath)
                            ElseIf SelectionMode = ModeSelection.HighLight And optEnableHighLightTrack Then
                                If optEnableHatchTrack Then
                                    Dim myHatch As HatchBrush = Nothing
                                    myHatch = New HatchBrush(HatchStyle.WideDownwardDiagonal, gHiglightColor.Color, CurrentColorStatus.Color)
                                    e.Graphics.FillPath(myHatch, Me.GraphicalPath)
                                Else
                                    e.Graphics.DrawPath(New Pen(gHiglightColor, 6), GraphicalPath)
                                End If

                            ElseIf Me.JointControl And Not Me.EnableJointControl Then
                                e.Graphics.FillPath(New SolidBrush(Color.DarkGray), Me.GraphicalPath)
                                'e.Graphics.DrawPath(New Pen(Color.Red, 2), GraphicalPath)
                            End If
                        End If
                        'e.Graphics.FillPath(CurrentColorStatus, Me.GraphicalPath)

                    End If
                    If Me.MouseEntered Then
                        If Not Me.Occuppied And Me.TrafficDirection = "" Then
                            e.Graphics.DrawPath(New Pen(Color.OrangeRed, 4), GraphicalPath)
                        ElseIf Me.TrafficDirection <> "" Then

                        Else
                            e.Graphics.DrawPath(New Pen(Color.White, 4), GraphicalPath)
                        End If

                    ElseIf Me.MouseLefted Then
                        Me.MouseLefted = False
                    End If
                End SyncLock
            Catch ex As Exception
                SystemException(Me.GUID.ToString)

                SystemException(ex.ToString)
                Try
                    'If gInitialized Then
                    '    Threading.Thread.Sleep(50)
                    '    If Me.InvokeRequired Then
                    '        Me.Invoke(New MethodInvoker(AddressOf Me.Refresh))
                    '    Else
                    '        Me.Refresh()
                    '    End If
                    'End If

                Catch ex1 As Exception
                    'ARRC-1567 , collect all frames information for analysis
                    SystemException(GetExceptionAllFrameMsg(ex, New StackTrace(True)))
                    'SystemException(ex.ToString)
                End Try
            End Try
        End Sub

