        Private Sub DoCreateTrackTagWithLikeTrackNames(ByVal TagType As String, Optional ByVal TagValue As String = "SPEED")
            Try
                Dim theList As New ArrayList
                theList.Add(Me)
                Dim trk As Track
                For Each trk In TrackCollection
                    If Me.Name = trk.Name AndAlso Me.GUID <> trk.GUID AndAlso Me.myControlPoint.GUID = trk.myControlPoint.GUID Then
                        If Not theList.Contains(trk) Then
                            theList.Add(trk)
                        End If
                    End If
                Next
                Dim tempColl As New ArrayList
                tempColl = RearrangeCompCollection_New(theList, False, gSearchDirection, False)
                If tempColl IsNot Nothing AndAlso tempColl.Count > 0 Then CopyArrayCollection(theList, tempColl)
                For Each trk In theList
                    If Not gTagTrackSelectionList.Contains(trk) Then
                        trk.SelectionMode = ModeSelection.TagBlocking
                        trk.FlashComponent = True
                        gTagTrackSelectionList.Add(trk)
                    End If
                Next

                TMDS.SystemForms.MySystemForms.frmMainMDI.TrackTagFlasherReset()
                Dim FormPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Left + 300, Me.CurrentDrawingForm.Height / 2)

                SystemForms.MySystemForms.frmTag = New frmTag()
                SystemForms.MySystemForms.frmTag.SetupProperties(Me, FormPoint, TMDS.GlobalDeclarations.gDatabaseConnectionDynamic, Me.CurrentDrawingForm, TagType, TagValue, gTagTrackSelectionList)
                SystemEvent("LAUNCH - TAG FORM (CREATE)")
                SystemForms.MySystemForms.frmTag.ShowDialog()
                SystemForms.MySystemForms.frmTag.Dispose()
                SystemForms.MySystemForms.frmTag = Nothing
                ClearSystemVariables()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function DoCheckForTagSelectionSequence() As Boolean
            Try
                If gTagTrackSelectionList.Count = 0 Then Return True

                Dim trk As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(gTagTrackSelectionList)
                If IsNothing(trk) Then Return False
                If trk.TrackName <> Me.TrackName Then Return False
                If optEnableStretchyTag Then
                    If Me.TrackColorStatus = "8" Then Return False
                End If

                If gTagTrackSelectionList.Contains(Me) And Not gTagSelectionDirection = "" Then Return False


                If gTagSelectionDirection = "" Then
                    If Not optEnableStretchyTag Then
                        Dim rt As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToRight(Me.RightLink)
                        Dim lt As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToLeft(Me.LeftLink)
                        If trk.OStype Then
                            If trk.OsComponentCollection.Contains(rt) Then
                                gTagSelectionDirection = "RIGHT"
                                Return True
                            End If
                            If trk.OsComponentCollection.Contains(lt) Then
                                gTagSelectionDirection = "LEFT"
                                Return True
                            End If
                        Else
                            If Not IsNothing(lt) Then
                                If lt.GUID = trk.GUID Then
                                    gTagSelectionDirection = "LEFT"
                                    Return True
                                End If
                            End If
                            If Not IsNothing(rt) Then
                                If rt.GUID = trk.GUID Then
                                    gTagSelectionDirection = "RIGHT"
                                    Return True
                                End If
                            End If


                        End If

                        rt = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToRight(trk.RightLink)
                        lt = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToLeft(trk.LeftLink)

                        If Me.OStype Then
                            If Me.OsComponentCollection.Contains(rt) Then
                                gTagSelectionDirection = "RIGHT"
                                Return True
                            End If
                            If Me.OsComponentCollection.Contains(lt) Then
                                gTagSelectionDirection = "LEFT"
                                Return True
                            End If
                        Else
                            If Not IsNothing(lt) Then

                                If lt.GUID = Me.GUID Then
                                    gTagSelectionDirection = "LEFT"
                                    Return True
                                End If
                            End If
                            If Not IsNothing(rt) Then
                                If rt.GUID = Me.GUID Then
                                    gTagSelectionDirection = "RIGHT"
                                    Return True
                                End If
                            End If
                        End If
                    Else

                        ''************************************************** Check for Track in Tag collection to determine the Direction ****************
                        Dim rt As Track
                        Dim lt As Track
                        Dim FirstTrack As Track = gTagTrackSelectionList(0)
                        rt = Me.FindNextTrack(Me.RightLink, "RIGHT")
                        lt = Me.FindNextTrack(Me.LeftLink, "LEFT")
                        If rt.GUID = FirstTrack.GUID Then
                            gTagSelectionDirection = "LEFT"
                            Return True
                        ElseIf lt.GUID = FirstTrack.GUID Then
                            gTagSelectionDirection = "RIGHT"
                            Return True
                        End If
                        If rt.GUID = Me.GUID Then
                            gTagSelectionDirection = "RIGHT"
                            Return True
                        ElseIf lt.GUID = Me.GUID Then
                            gTagSelectionDirection = "LEFT"
                            Return True
                        End If
                        'If gTagTrackSelectionList.Contains(lt) Then
                        '    gTagSelectionDirection = "LEFT"
                        '    Return True
                        'ElseIf gTagTrackSelectionList.Contains(rt) Then
                        '    gTagSelectionDirection = "RIGHT"
                        '    Return True
                        'End If
                        If gTagTrackSelectionList.Contains(lt) Then
                            gTagSelectionDirection = "RIGHT"
                            Return True
                        ElseIf gTagTrackSelectionList.Contains(rt) Then
                            gTagSelectionDirection = "LEFT"
                            Return True
                        End If
                        '************************************************** 

                    End If
                ElseIf gTagSelectionDirection = "LEFT" Then
                    If optEnableStretchyTag Then
                        If Me.GUID = gTagLeftExitTrack Then
                            gTagSelectionDirection = "LEFT"
                            Return True
                        End If
                        If Me.GUID = FindTagRoute() Then
                            gTagSelectionDirection = "LEFT"
                            Return True
                        End If
                    End If

                    Dim lt As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToLeft(Me.LeftLink)
                    If trk.OStype Then
                        If trk.OsComponentCollection.Contains(lt) Then
                            gTagSelectionDirection = "LEFT"
                            Return True
                        End If
                    Else
                        If Not IsNothing(lt) Then
                            If lt.GUID = trk.GUID Then
                                gTagSelectionDirection = "LEFT"
                                Return True
                            End If
                        End If
                    End If

                    lt = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToLeft(trk.LeftLink)

                    If Me.OStype Then
                        If Me.OsComponentCollection.Contains(lt) Then
                            gTagSelectionDirection = "LEFT"
                            Return True
                        End If
                    Else
                        If Not IsNothing(lt) Then
                            If lt.GUID = Me.GUID Then
                                gTagSelectionDirection = "LEFT"
                                Return True
                            End If
                        End If
                    End If


                ElseIf gTagSelectionDirection = "RIGHT" Then

                    If optEnableStretchyTag Then
                        If Me.GUID = gTagRightExitTrack Then
                            gTagSelectionDirection = "RIGHT"
                            Return True
                        End If
                        If Me.GUID = FindTagRoute() Then
                            gTagSelectionDirection = "RIGHT"
                            Return True
                        End If
                    End If


                    Dim rt As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToRight(Me.RightLink)
                    If trk.OStype Then
                        If trk.OsComponentCollection.Contains(rt) Then
                            gTagSelectionDirection = "RIGHT"
                            Return True
                        End If
                    Else
                        If Not IsNothing(rt) Then
                            If rt.GUID = trk.GUID Then
                                gTagSelectionDirection = "RIGHT"
                                Return True
                            End If
                        End If
                    End If

                    rt = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToRight(trk.RightLink)

                    If Me.OStype Then
                        If Me.OsComponentCollection.Contains(rt) Then
                            gTagSelectionDirection = "RIGHT"
                            Return True
                        End If
                    Else
                        If Not IsNothing(rt) Then
                            If rt.GUID = Me.GUID Then
                                gTagSelectionDirection = "RIGHT"
                                Return True
                            End If
                        End If
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False

        End Function

        Private Sub DoCreateMultipleTrackTags()
            Try
                If Me.AuthorityType = "SHELF" Then Exit Sub

                If Not gTagTrackSelectionList.Contains(Me) Then
                    If gTrackTagLimit <> 0 Then
                        Dim TagCount As Integer
                        TagCount = Me.TrackTagLabels.Count
                        If TagCount >= gTrackTagLimit Then
                            MessageBox.Show("NO MORE THEN " & gTrackTagLimit & " TAGS PER TRACK", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                            Exit Sub
                        End If
                        Dim trk As Track
                        For Each trk In TMDS.GlobalDeclarations.TrackCollection
                            If (trk IsNot Nothing AndAlso trk.myControlPoint IsNot Nothing) AndAlso (trk.Name = Me.Name And trk.myControlPoint.GUID = Me.myControlPoint.GUID) And Not Me.GUID = trk.GUID Then
                                TagCount = TagCount + trk.TrackTagLabels.Count
                                If TagCount >= gTrackTagLimit Then
                                    MessageBox.Show("NO MORE THEN " & gTrackTagLimit & " TAGS PER TRACK", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                    Exit Sub
                                End If
                            End If
                        Next
                    End If

                    If Not gTagAuthorityCheckDone Then
                        If Mid(Me.AuthorityType, 1, 3) <> "TWC" AndAlso Me.SignalStatOnMe <> TrackComponents.Track.SignalStatus.SignalAtStop OrElse (Me.Occuppied AndAlso Mid(Me.AuthorityType, 1, 3) <> "TWC") Then
                            Dim frmMessageBox As frmMessageBox
                            Dim FormPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Left + 300, Me.CurrentDrawingForm.Height / 2)
                            Dim MessageList As New ArrayList()
                            gTagAuthorityCheckDone = True
                            'MessageList.Add("SIGNAL ACTIVITY IN TAG LIMITS. CONTINUE WITH TRACK TAG?")
                            MessageList.Add(optTagString_SignalActivity)
                            MessageList.Add("")
                            frmMessageBox = New frmMessageBox()
                            frmMessageBox.Owner = Me.CurrentDrawingForm
                            frmMessageBox.StartPosition = FormStartPosition.Manual
                            frmMessageBox.SetMessage(MessageList, "TRACK TAG CHECK", True, FormPoint)
                            frmMessageBox.ShowDialog()
                            If frmMessageBox.FormFeedBack <> 6 Then
                                frmMessageBox.Dispose()
                                frmMessageBox = Nothing
                                TMDS.modSystemFuncs.ClearSystemVariables()
                                Exit Sub
                            End If
                            frmMessageBox.Dispose()
                            frmMessageBox = Nothing

                        End If
                    End If

                    If optEnableStretchyTag Then
                        Try
                            If Me.TrackColorStatus = "8" Then
                                TMDS.modSystemFuncs.ClearSystemVariables()
                                Exit Sub
                            End If

                            If Me.OStype Then
                                If Not Me.OsComponentCollection Is Nothing Then
                                    If gTagSelectionDirection.Trim <> String.Empty Then
                                        Dim sTrk As Track = Nothing
                                        Select Case gTagSelectionDirection
                                            Case "RIGHT"
                                                gTagLeftExitTrack = 0
                                                sTrk = FindTagExitTrack(Me, "RIGHT")
                                                If Not sTrk Is Nothing Then
                                                    gTagRightExitTrack = sTrk.GUID
                                                End If
                                                'gTagRightExitTrack = FindTagExitTrack(Me, "RIGHT").GUID
                                            Case Else
                                                'gTagLeftExitTrack = FindTagExitTrack(Me, "LEFT").GUID
                                                sTrk = FindTagExitTrack(Me, "LEFT")
                                                If Not sTrk Is Nothing Then
                                                    gTagRightExitTrack = sTrk.GUID
                                                End If
                                                gTagRightExitTrack = 0
                                        End Select
                                        sTrk = Nothing
                                    Else
                                        Dim Objtrk As Track = Nothing
                                        Objtrk = FindTagExitTrack(Me, "LEFT")
                                        If Not Objtrk Is Nothing Then
                                            gTagLeftExitTrack = Objtrk.GUID
                                        Else
                                            gTagLeftExitTrack = 0 'Me.LeftLink
                                        End If

                                        Objtrk = Nothing
                                        Objtrk = FindTagExitTrack(Me, "RIGHT")
                                        If Not Objtrk Is Nothing Then
                                            gTagRightExitTrack = Objtrk.GUID
                                        Else
                                            gTagRightExitTrack = 0 'Me.RightLink
                                        End If
                                        Objtrk = Nothing
                                    End If
                                End If
                                OsSpeedTagSelection()
                            Else
                                gTagLeftExitTrack = 0
                                gTagRightExitTrack = 0
                                If Not gTagTrackSelectionList.Contains(Me) Then
                                    gTagTrackSelectionList.Add(Me)
                                End If
                            End If

                        Catch ex As Exception
                            SystemException(ex.ToString)
                        End Try

                    Else
                        gTagTrackSelectionList.Add(Me)

                        If Not Me.OsComponentCollection Is Nothing Then
                            Dim comp As Object
                            For Each comp In Me.OsComponentCollection
                                If Not gTagTrackSelectionList.Contains(comp) Then
                                    gTagTrackSelectionList.Add(comp)
                                    comp.SelectionMode = ModeSelection.TagBlocking
                                    comp.FlashComponent = True
                                End If
                            Next
                        End If
                        Dim LikeCompArrayList As ArrayList = TMDS.SystemUtilities.FetchData.FindLikeOSCompInCP(Me.myControlPoint, Me)
                        If Not LikeCompArrayList Is Nothing Then
                            Dim comp As Object
                            For Each comp In LikeCompArrayList
                                If Not gTagTrackSelectionList.Contains(comp) Then
                                    gTagTrackSelectionList.Add(comp)
                                    comp.SelectionMode = ModeSelection.TagBlocking
                                    comp.FlashComponent = True
                                End If
                            Next
                        End If
                    End If
                    Me.SelectionMode = ModeSelection.TagBlocking
                    Me.FlashComponent = True
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TrackTagFlasherReset()
                Else

                    If Not Me.OsComponentCollection Is Nothing Then
                        Dim comp As Object
                        For Each comp In Me.OsComponentCollection
                            gTagTrackSelectionList.Remove(comp)
                            comp.SelectionMode = ModeSelection.Regular
                            comp.FlasherMode(False)
                            comp.Flasher.Interval = 250
                        Next
                    End If

                    Dim LikeCompArrayList As ArrayList = TMDS.SystemUtilities.FetchData.FindLikeOSCompInCP(Me.myControlPoint, Me)
                    If Not LikeCompArrayList Is Nothing Then
                        Dim comp As Object
                        For Each comp In LikeCompArrayList
                            gTagTrackSelectionList.Remove(comp)
                            comp.SelectionMode = ModeSelection.Regular
                            comp.FlasherMode(False)
                            comp.Flasher.Interval = 250
                        Next
                    End If

                    gTagTrackSelectionList.Remove(Me)
                    Me.SelectionMode = ModeSelection.Regular
                    Me.FlasherMode(False)
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TrackTagFlasherReset()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub OsSpeedTagSelection()
            Dim RObject As Object = Nothing
            Dim LObject As Object = Nothing
            Dim HasRobj As Boolean
            Dim HasLobj As Boolean
            Dim tempTrackCollection As New ArrayList
            Dim NextComp As Object = Nothing
            Dim comp As Object = Nothing
            Dim sw As Switch = Nothing
            Try
                If Not Me.OsComponentCollection Is Nothing Then
                    RObject = FindCompFromGUID(Me.RightLink)
                    LObject = FindCompFromGUID(Me.LeftLink)
                    tempTrackCollection.Add(Me)
                    If Me.OsComponentCollection.Contains(RObject) Then
                        HasRobj = True
                        tempTrackCollection.Add(RObject)
                    End If
                    If Me.OsComponentCollection.Contains(LObject) Then
                        HasLobj = True
                        tempTrackCollection.Add(LObject)
                    End If

                    If HasRobj Then
                        NextComp = RObject
                        For i As Integer = 0 To 25
                            Select Case NextComp.GetType.ToString
                                Case gSwitchComponentName
                                    sw = NextComp
                                    If sw.ControlledReverse Then
                                        comp = FindCompFromGUID(sw.RightAltLink)
                                    Else
                                        comp = FindCompFromGUID(sw.RightLink)
                                    End If
                                    If Me.OsComponentCollection.Contains(comp) And Not tempTrackCollection.Contains(comp) Then
                                        tempTrackCollection.Add(comp)
                                        NextComp = comp
                                    Else
                                        Exit For
                                    End If
                                    sw = Nothing
                                Case gSignalComponentName
                                    comp = FindCompFromGUID(NextComp.RightLink)
                                    NextComp = comp
                                Case gTrackComponentName
                                    comp = FindCompFromGUID(NextComp.RightLink)
                                    If Me.OsComponentCollection.Contains(comp) And Not tempTrackCollection.Contains(comp) Then
                                        tempTrackCollection.Add(comp)
                                        NextComp = comp
                                    Else
                                        Exit For
                                    End If
                            End Select
                        Next
                    End If

                    If HasLobj Then
                        NextComp = LObject
                        For i As Integer = 0 To 25
                            Select Case NextComp.GetType.ToString
                                Case gSwitchComponentName
                                    sw = NextComp
                                    If sw.ControlledReverse Then
                                        comp = FindCompFromGUID(sw.LeftAltLink)
                                    Else
                                        comp = FindCompFromGUID(sw.LeftLink)
                                    End If
                                    If Me.OsComponentCollection.Contains(comp) And Not tempTrackCollection.Contains(comp) Then
                                        tempTrackCollection.Add(comp)
                                        NextComp = comp
                                    Else
                                        Exit For
                                    End If
                                    sw = Nothing
                                Case gSignalComponentName
                                    comp = FindCompFromGUID(NextComp.LeftLink)
                                    NextComp = comp
                                Case gTrackComponentName
                                    comp = FindCompFromGUID(NextComp.LeftLink)
                                    If Me.OsComponentCollection.Contains(comp) And Not tempTrackCollection.Contains(comp) Then
                                        tempTrackCollection.Add(comp)
                                        NextComp = comp
                                    Else
                                        Exit For
                                    End If
                            End Select
                        Next
                    End If
                End If

                comp = Nothing
                For Each comp In tempTrackCollection
                    If Not gTagTrackSelectionList.Contains(comp) Then
                        gTagTrackSelectionList.Add(comp)
                        comp.SelectionMode = ModeSelection.TagBlocking
                        comp.FlashComponent = True
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                RObject = Nothing
                LObject = Nothing
                NextComp = Nothing
                comp = Nothing
                tempTrackCollection = Nothing
                sw = Nothing
            End Try




        End Sub

