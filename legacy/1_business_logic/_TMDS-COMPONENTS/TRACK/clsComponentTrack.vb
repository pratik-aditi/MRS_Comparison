        Private Function GetMLTrainDisplayText(trnSymbol As String) As String
            Try
                Dim trimLEN As Integer = 2
                Dim last2Digits As String = trnSymbol.Substring(trnSymbol.Length - trimLEN, 2)
                If Not IsNumeric(last2Digits) Then
                    trimLEN = 1
                    last2Digits = trnSymbol.Substring(trnSymbol.Length - trimLEN, 1).PadLeft(2, "0")
                End If
                Dim FirstSection As String = trnSymbol.Substring(0, trnSymbol.Length - trimLEN)
                Dim noofstars As Integer = 10 - (trnSymbol.Length)
                Dim TrnSymbolTosend As String
                If IsNumeric(last2Digits) AndAlso last2Digits <= 31 Then
                    TrnSymbolTosend = FirstSection & New String("*", noofstars) & last2Digits
                Else
                    TrnSymbolTosend = trnSymbol
                End If

                Return TrnSymbolTosend
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return String.Empty
        End Function

