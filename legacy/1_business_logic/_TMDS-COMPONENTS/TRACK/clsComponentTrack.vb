        ''' <summary>
        ''' Retrieve Train Not In Use
        ''' </summary>
        ''' <param name="symbol">symbol to retrieve data</param>
        ''' <returns>Returns <c>True</c>, if data were retrieved, otherwise, return <c>False</c></returns>
        Private Function RetrieveTrainNotInUse(symbol As String) As Boolean
            Try
                TrackEventLog($"{GetCurrentMethod.Name} Symbol={symbol}")
                Dim train As TrainID = RetrieveTrainID(symbol)
                If train Is Nothing Then
                    TrackEventLog($"{GetCurrentMethod.Name} Train is nothing")
                    Return False
                End If
                train.CrewCurrent.ApplyCrewString(train.CrewCurrentString)
                train.TrackGUID = GUID
                train.myTrack = Me
                train.SubID = SubdivisionID
                train.TypeOfID = "TRAIN"
                train.ApplyTrainAbbreviation(gTrainAbbreviation)
                AddTrainID(train)
                train.StackOrder = TrainIDs.IndexOf(train)
                If Not Indicating Then Occuppied = True
                UpdateStatus()
                If Not (gAssistMode OrElse train.myTrack.IsShadowMode) Then
                    TMDS.NetworkMessages.CadMessages.SendTrainSymbolMove(train, gCadTransmitQueue, Nothing, Me, "D")
                    Dim logThisEvent As New DoEventLogTrainID(AddressOf train.LogTheTrainIDEvent)
                    logThisEvent.BeginInvoke(TrainID.EventTypeTrainID.POSITION, Nothing, Nothing)
                    Dim publishThisEvent As New DoPublishTrainEvent(AddressOf train.PublishTrainEvent)
                    publishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.POSITION, False, Nothing, Nothing)
                End If
                train.EnableNotificationFlash(False)
                Dim summary As New SummaryItem("TRAIN", "POSITION", train)
                SyncLock gSummaryTrainQueue.SyncRoot
                    gSummaryTrainQueue.Enqueue(summary)
                End SyncLock
                InitTrainDisplay()
                InitTrainDisplay()
                InvalidateTrainID()
                UpDateTrainIDPosition(train)
                TrackEventLog($"{GetCurrentMethod.Name} Train {symbol} loaded")
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False
        End Function

