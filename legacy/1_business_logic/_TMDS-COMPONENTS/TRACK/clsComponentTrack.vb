        Private Function FindTagRoute() As Integer
            Dim FirstTrack As Track = gTagTrackSelectionList(0)
            Dim Counter As Integer = gTagTrackSelectionList.Count + 5
            Dim Comp As Object = FirstTrack
            Dim NextComp As Object
            Try


                For i As Integer = 0 To Counter

                    Select Case gTagSelectionDirection
                        Case "RIGHT"
                            NextComp = FindCompFromGUID(Comp.RightLink)
                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim Sg As Signal = NextComp
                                NextComp = New Object
                                NextComp = FindCompFromGUID(Sg.RightLink)
                            End If
                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim Sg As Signal = NextComp
                                NextComp = New Object
                                NextComp = FindCompFromGUID(Sg.RightLink)
                            End If
                            If Not (gTagTrackSelectionList.Contains(NextComp)) And NextComp.GetType.ToString = gTrackComponentName Then
                                Return NextComp.GUID
                            End If
                            Comp = NextComp
                        Case "LEFT"
                            TrackEventLog("Comp - " & Comp.GetType.ToString & ":" & Comp.guid)
                            NextComp = FindCompFromGUID(Comp.LeftLink)
                            TrackEventLog("NextComp - " & NextComp.GetType.ToString & ":" & NextComp.guid)
                            TrackEventLog(vbTab & "NextComp LeftLink - " & NextComp.GetType.ToString & ":" & NextComp.LeftLink)
                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim Sg As Signal = NextComp
                                NextComp = New Object
                                NextComp = FindCompFromGUID(Sg.LeftLink)
                            End If
                            If NextComp.GetType.ToString = gSignalComponentName Then
                                Dim Sg As Signal = NextComp
                                NextComp = New Object
                                NextComp = FindCompFromGUID(Sg.LeftLink)
                            End If
                            If Not (gTagTrackSelectionList.Contains(NextComp)) And NextComp.GetType.ToString = gTrackComponentName Then
                                TrackEventLog("NextComp - " & NextComp.GetType.ToString & ":" & NextComp.guid)
                                Return NextComp.GUID
                            End If
                            Comp = NextComp
                    End Select


                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return 0
        End Function

        Public Function IsValidTrackForOperation(Optional AllowOnJCTracks As Boolean = False, Optional theTrain As TrainID = Nothing) As Boolean
            Try
                If optEnableShadowMode AndAlso optEnableTerritoryDeskAssignmentMode Then
                    If Not Me.myControlPoint.IsShadowMode Then
                        Return True
                    Else
                        If AllowOnJCTracks AndAlso Me.JointControl Then
                            Return True
                        ElseIf Me.JointControl AndAlso Me.IsPrimaryController Then
                            Return True
                        Else
                            If Not IsNothing(theTrain) Then
                                SystemEvent("IsValidTrackForOperation:" & Me.Name & ":" & Me.GUID & ":" & theTrain.Name)
                            End If
                            Return False
                        End If
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return True
        End Function

        Friend Sub CheckForNonTWCComponents()
            Dim TempArray As New ArrayList
            Dim comp As Object = Nothing
            Dim FirstTrack As Track = Nothing
            Dim LastTrack As Track = Nothing
            Try
                CopyArrayCollection(TempArray, gTrackSelectionCollection)
                TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionClear()
                TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionTWC.Enabled = True
                gTrackSelectionCollection.Clear()

                For Each comp In TempArray
                    If optEnableTrackSidingBit Then
                        'NEW SIDING LOGIC CODE
                        If comp.GetType.ToString = gTrackComponentName Then
                            If comp.EnableControlledSiding Or comp.EnableNonControlledSiding Then
                            Else
                                gTrackSelectionCollection.Add(comp)
                            End If
                        Else
                            gTrackSelectionCollection.Add(comp)
                        End If
                    Else
                        'OLD LEGACY SIDING CODE
                        If comp.TrackName = "SIDING" Then
                        Else
                            gTrackSelectionCollection.Add(comp)
                        End If
                    End If

                Next
                FirstTrack = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(gTrackSelectionCollection)
                LastTrack = TMDS.SystemUtilities.FetchData.FindLastTrackInList(gTrackSelectionCollection)
                gBeginTrackSelect = FirstTrack
                gEndTrackSelect = LastTrack


                TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                TempArray = Nothing
                FirstTrack = Nothing
                LastTrack = Nothing
            End Try
        End Sub

