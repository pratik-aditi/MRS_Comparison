        ''' <summary>
        ''' Finds the exit track for the currently selected items.
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Private Function FindExitTrack(Optional ByRef pExitSignal As Signal = Nothing) As Track
            Dim comp As Object = Nothing
            Dim sigLeft As Signal
            Dim sigRight As Signal
            Dim FirstSignalFound As Boolean
            Dim FirstSignal As Signal = Nothing
            Dim LastSignalFound As Boolean
            Dim trk As Track
            Try
                pExitSignal = Nothing
                For Each comp In gEntExtTrackSelection
                    If Not comp Is Nothing Then
                        If comp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            If Not FirstSignalFound Then
                                FirstSignal = comp
                                FirstSignalFound = True
                            Else
                                LastSignalFound = True
                                pExitSignal = comp
                            End If
                        ElseIf comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            trk = CType(comp, Track)
                            If FirstSignalFound And Not LastSignalFound Then
                                sigRight = Nothing
                                sigLeft = Nothing
                                sigLeft = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(trk.LeftLink)
                                sigRight = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(trk.RightLink)
                                If Not IsNothing(sigLeft) Then
                                    If sigLeft.GUID <> FirstSignal.GUID Then
                                        LastSignalFound = True
                                        If sigLeft IsNot Nothing Then pExitSignal = sigLeft
                                    End If
                                End If
                                If Not IsNothing(sigRight) Then
                                    If sigRight.GUID <> FirstSignal.GUID Then
                                        LastSignalFound = True
                                        If sigRight IsNot Nothing Then pExitSignal = sigRight
                                    End If
                                End If
                            ElseIf FirstSignalFound And LastSignalFound Then
                                Return comp
                            End If
                        End If
                    End If
                Next
                If FirstSignalFound And LastSignalFound And Not comp Is Nothing Then
                    Return comp
                End If
                'Its need to issue PSS over signal clear
                If FirstSignalFound AndAlso gExitTrack IsNot Nothing Then
                    TrackEventLog("FindExitTrack:gExitTrack=" & gExitTrack.GUID & ":" & gExitTrack.Name)
                    Return gExitTrack
                End If
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                comp = Nothing
                sigLeft = Nothing
                sigRight = Nothing
                FirstSignalFound = Nothing
                FirstSignal = Nothing
                LastSignalFound = Nothing
                trk = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Do train permission to pass red signal
        ''' </summary>
        ''' <param name="pTrain"></param>
        ''' <param name="pIsJointRequest"></param>
        Public Sub DoTrainPermissionToPassRedSignal(ByVal pTrain As TrainID, Optional ByVal pIsJointRequest As Boolean = False)
            Dim theSignal As Signal = Nothing
            Dim exitTrack As Track = Nothing
            Dim okToProceed As Boolean = True
            Dim eventMessage As String
            Dim mess As String = ""
            Dim strErrorMessage As String = ""
            Dim frmMessageBox As frmMessageBox
            Dim messageList As New ArrayList()
            Dim launchPoint As Point
            Try
                TrackEventLog("DoTrainPermissionToPassRedSignal:Train=" & pTrain.Name & ":IsJoinRequest=" & pIsJointRequest.ToString)
                If CheckIsRemoteTrack(gEntExtTrackSelection) Then
                    TrackEventLog("DoTrainPermissionToPassRedSignal:Route doenst allow:Train=" & pTrain.Name)
                    messageList.Add("LICENÇA ESPECIAL NÃO É PERMITIDA PARA ESSA ROTA!")
                    messageList.Add("MOTIVO: DIVISÃO DE REGIÕES")
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = Me.CurrentDrawingForm
                    frmMessageBox.SetMessage_PSS(messageList, "LICENÇA ESPECIAL", False, Me.CurrentDrawingForm.myLaunchPoint, Nothing, False, False, Nothing, Nothing, False, Nothing, True, False, True)
                    frmMessageBox.ShowDialog()
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    messageList.Clear()
                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                    ClearSystemVariables()
                    Exit Sub
                End If
                theSignal = FindPassRedSignal()
                exitTrack = FindExitTrack()
                If IsNothing(theSignal) Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                    ClearSystemVariables()
                    Exit Sub
                End If
                gPermissionPassRedSignalControlPoint = theSignal.myControlPoint
                If IsNothing(exitTrack) Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                    ClearSystemVariables()
                    Exit Sub
                End If
                If PerformConflictCheckToPassRedSignal(pTrain) Then
                    If PSSHandeOperationRequiredNOOption = 6 Then
                        strErrorMessage = CheckForAdjacentTNTandDeviceBlock(pTrain.IdentifingUnit)
                        If Not String.IsNullOrEmpty(strErrorMessage) AndAlso strErrorMessage.Trim <> "" Then
                            ErrorMessage(strErrorMessage)
                            TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    End If
                    mess = PerformPSSCTCConflictCheck(pTrain.IdentifingUnit)
                    If Not optEnableOverrideSIGValidationForPRS AndAlso Not optEnableOverrideSIGValidationForPRSCheckSigStatus Then
                        ErrorMessage(mess)
                    Else
                        Select Case mess.Trim
                            Case String.Empty
                            Case "SIG", "SR", "PRS"
                                messageList.Add(optPssMessageTWELine1)
                                messageList.Add(optPssMessageTWELine2)
                                messageList.Add("")
                                frmMessageBox = New frmMessageBox()
                                frmMessageBox.Owner = Me.CurrentDrawingForm
                                launchPoint = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Width / 2, 150)
                                frmMessageBox.btnOK.TabIndex = 2
                                frmMessageBox.btnYes.TabIndex = 1
                                frmMessageBox.btnNo.TabIndex = 3
                                frmMessageBox.SetMessage_PSS(messageList, optConflictResolutionMsg, True, Me.CurrentDrawingForm.myLaunchPoint, "YES" & "|" & "NO", False, False, Nothing, Nothing, False, Nothing, True, False, True)
                                frmMessageBox.ShowDialog()
                                If frmMessageBox.FormFeedBack <> 6 Then
                                    eventMessage = "DISPATCHER SELECT NO TO CONFLICTING ROUTE(PSS) "
                                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                    TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()
                                    ClearSystemVariables()
                                    okToProceed = False
                                Else
                                    eventMessage = "DISPATCHER SELECT YES TO CONFLICTING ROUTE(PSS) "
                                End If
                                frmMessageBox.Dispose()
                                frmMessageBox = Nothing
                                Me.TrackEventLog(eventMessage)
                            Case Else
                                ErrorMessage(mess)
                                okToProceed = False
                        End Select
                    End If
                    If okToProceed Then
                        pTrain.ShowDialogToPassRedSignal_MRS(theSignal, gEntryTrack, exitTrack, False)
                    End If
                    MySystemForms.frmMainMDI.ClearEntExtSelection()
                    ClearSystemVariables()
                    Exit Sub
                Else
                    MySystemForms.frmMainMDI.ClearEntExtSelection()
                    ClearSystemVariables()
                    Exit Sub
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                exitTrack = Nothing
                theSignal = Nothing
                okToProceed = Nothing
                eventMessage = Nothing
                mess = Nothing
                strErrorMessage = Nothing
                frmMessageBox = Nothing
                messageList = Nothing
                launchPoint = Nothing
            End Try
        End Sub

        Private Function PerformPSSCTCConflictCheck(ByVal IssueTo As String) As String
            Dim i As Integer = 0
            Dim J As Integer = 0
            Dim Comp As Object = Nothing
            Dim returnStr As String = ""
            Try
                For i = 0 To gEntExtTrackSelection.Count - 1
                    If gEntExtTrackSelection(i).GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        J = i
                        Exit For
                    End If
                Next

                For i = J To gEntExtTrackSelection.Count - 1
                    Dim OverrideTNT As Boolean = False
                    Dim TNTPresent As Boolean = False
                    Dim IgnoreDeviceBlock As Boolean = False
                    Dim HasTrafficDirection As Boolean = False
                    Dim TrafficDirection As String = String.Empty
                    Comp = gEntExtTrackSelection(i)
                    Select Case Comp.GetType.ToString
                        Case "TMDS.TrackComponents.Track"
                            If Comp.TrafficDirection Is Nothing Then
                                HasTrafficDirection = False
                                TrafficDirection = ""
                            Else
                                HasTrafficDirection = True
                                TrafficDirection = Comp.TrafficDirection
                            End If
                            If optEnableOverrideTNTForPRS Then
                                If Comp.BlockAbsolute Then
                                    'OverrideTNT = True
                                    If optEnableOverrideDeviceBlockForPRS Then IgnoreDeviceBlock = True
                                    Dim auth As TrackAuthority.TrackAuthority
                                    If Comp.TrackAuthorities.count > 0 Then TNTPresent = True
                                    For Each auth In Comp.TrackAuthorities
                                        If auth.IssueTo = IssueTo Then
                                            OverrideTNT = True
                                            'Exit For
                                        End If
                                    Next
                                    If Not optEnableOverrideJointTNTForPRS Then
                                        For Each auth In Comp.TrackAuthorities
                                            If auth.IssueTo <> IssueTo Then
                                                OverrideTNT = False
                                                Exit For
                                            End If
                                        Next
                                    End If

                                    If OverrideTNT = False And TNTPresent Then
                                        TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                        ClearSystemVariables()
                                        If Not OverrideTNT And TNTPresent Then returnStr = "TNT"
                                        Return returnStr
                                        Exit Function
                                    End If


                                    'If optEnableOverrideDeviceBlockForPRS Then
                                    '    If Comp.DeviceBlocks.Count > 0 Then IgnoreDeviceBlock = True
                                    '    Dim dv As TrackAuthority.DeviceBlock
                                    '    For Each dv In Comp.DeviceBlocks
                                    '        If dv.IsPRS Then
                                    '            IgnoreDeviceBlock = False
                                    '            returnStr = "PRS"
                                    '            Return "PRS"
                                    '            Exit For
                                    '        ElseIf dv.IsEMT Then
                                    '            IgnoreDeviceBlock = False
                                    '            returnStr = "EMT"
                                    '            Return "EMT"
                                    '            Exit For
                                    '        End If
                                    '    Next
                                    'End If
                                End If

                            End If
                            'If Not optEnableOverrideSIGValidationForPRS Then
                            If Comp.SignalStatOnMe = TrackComponents.Track.SignalStatus.SignalCleared Or Comp.SignalStatOnMe = TrackComponents.Track.SignalStatus.SignalRequested Or Comp.SignalStatOnMe = TrackComponents.Track.SignalStatus.SignalInTime Then
                                If optEnableOverrideSIGValidationForPRSCheckSigStatus Then
                                    Dim SIG As Signal = Nothing
                                    SIG = TMDS.SystemUtilities.FetchData.FindMyControllingSignal(Comp)
                                    If SIG IsNot Nothing AndAlso SIG.SignalStatus <> Signal.BulbStatus.StopStatus Then
                                        TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                        ClearSystemVariables()
                                        returnStr = "SIG"
                                        Return returnStr
                                        Exit Function
                                    End If

                                ElseIf Not optEnableOverrideSIGValidationForPRS Then
                                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                    ClearSystemVariables()
                                End If
                                returnStr = "SIG"
                                Return returnStr
                                Exit Function
                            End If
                            'End If
                            If HasTrafficDirection And TrafficDirection.Trim <> String.Empty And TrafficDirection <> gSearchDirection Then
                                returnStr = "SIG"
                                Return returnStr
                                Exit Function
                            ElseIf (HasTrafficDirection And gEntryTrack.TrackName <> Comp.TrackName And Comp.SignalStatOnMe <> TrackComponents.Track.SignalStatus.SignalAtStop) And Not optEnableOverrideSIGValidationForPRS Then
                                TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                ClearSystemVariables()
                                returnStr = "SIG"
                                Return returnStr
                                Exit Function
                            End If



                        Case "TMDS.SignalComponents.Signal"
                            'If Comp.StoredEntrySignal Or Comp.StoredExitSignal Then
                            '    returnStr = "SR"
                            '    Return returnStr
                            '    Exit Function
                            'End If

                            If Not optEnableOverrideSIGValidationForPRS Then
                                If Comp.SignalStatus <> SignalComponents.Signal.BulbStatus.StopStatus Then
                                    If Comp.SignalStatus = SignalComponents.Signal.BulbStatus.Unsolitated Or Comp.SignalStatus = SignalComponents.Signal.BulbStatus.ClearStatus Or Comp.SignalStatus = SignalComponents.Signal.BulbStatus.RequestingClear Or Comp.SignalStatus = SignalComponents.Signal.BulbStatus.RequestingStop Or Comp.SignalStatus = SignalComponents.Signal.BulbStatus.RequestingClear Then
                                        Return "SIG"
                                        Exit Function
                                    End If
                                End If
                            End If
                    End Select
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Comp = Nothing
            End Try
            Return String.Empty

        End Function

