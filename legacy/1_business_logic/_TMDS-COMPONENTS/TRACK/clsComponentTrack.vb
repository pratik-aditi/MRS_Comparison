        Private Function DoEnhancedPSS() As Boolean

            Dim theSignal As Signal = Nothing
            Dim myExitTrack As Track = Nothing
            Dim myExitSignal As Signal = Nothing
            Dim tmpEntryTrack As Track = Nothing
            Dim tmpExitSignal As Track = Nothing
            Dim tmpEntireCompCollection As New ArrayList
            Dim myRoutesCollection As New List(Of SignalRoute)
            Dim LaunchPoint As Point = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + 20, TMDS.SystemForms.MySystemForms.frmMainMDI.Top + 50)
            Dim FormFeedBack As Integer
            Try
                tmpEntryTrack = gEntryTrack
                tmpExitSignal = gExitTrack
                CopyArrayCollection(tmpEntireCompCollection, gEntExtTrackSelection)
                LaunchPoint = New Point(Me.CurrentDrawingForm.Width / 2, Me.CurrentDrawingForm.Height / 2)
                theSignal = FindPassRedSignal()
                myExitTrack = FindExitTrack(myExitSignal)
                If theSignal Is Nothing OrElse myExitTrack Is Nothing Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                    ClearSystemVariables()
                    Exit Function
                Else
                    Dim EntrySigDirection As String = GetSignalDirection(theSignal)
                    Dim ExitSigDirection As String = GetSignalDirection(myExitSignal)

                    Dim Sr As SignalRoute = Nothing
                    If EntrySigDirection = "LEFT" Then
                        'myRoutesCollection = theSignal.myControlPoint.myLeftSignalRoutes
                        For Each Sr In theSignal.myControlPoint.myLeftSignalRoutes
                            If Sr.EntrySignal.GUID = theSignal.GUID AndAlso Sr.ExitSignal.GUID = myExitSignal.GUID AndAlso Sr.IsValidForPSS Then
                                If Not myRoutesCollection.Contains(Sr) Then myRoutesCollection.Add(Sr)
                            End If
                        Next
                    Else
                        For Each Sr In theSignal.myControlPoint.myRightSignalRoutes
                            If Sr.EntrySignal.GUID = theSignal.GUID AndAlso Sr.ExitSignal.GUID = myExitSignal.GUID AndAlso Sr.IsValidForPSS Then
                                If Not myRoutesCollection.Contains(Sr) Then myRoutesCollection.Add(Sr)
                            End If
                        Next
                    End If
                End If
                If myRoutesCollection IsNot Nothing AndAlso myRoutesCollection.Count > 1 Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()

                    Using frm As New frmMessageBox
                        With frm
                            If frm IsNot Nothing Then
                                .Owner = gEntryTrack.CurrentDrawingForm
                            Else
                                .Owner = TMDS.SystemForms.MySystemForms.frmMainMDI
                            End If
                            .mySRSignal = theSignal
                            .StartPosition = FormStartPosition.CenterParent

                            .TopMost = True
                            .BringToFront()
                            .SetMessage_PssRouteSelection(LaunchPoint, "", myRoutesCollection)

                            .ShowDialog()
                            FormFeedBack = .FormFeedBack
                            .TopMost = False
                        End With
                        If FormFeedBack = 1 Then
                            TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                            ClearSystemVariables()
                            Exit Function
                        End If
                    End Using
                Else
                    gEntryTrack = tmpEntryTrack
                    gExitTrack = tmpExitSignal
                    CopyArrayCollection(gEntExtTrackSelection, tmpEntireCompCollection)
                End If
                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                theSignal = Nothing
                myExitTrack = Nothing
                myExitSignal = Nothing
                tmpEntryTrack = Nothing
                tmpExitSignal = Nothing
                tmpEntireCompCollection = Nothing
                myRoutesCollection = Nothing
                LaunchPoint = Nothing
            End Try
        End Function

