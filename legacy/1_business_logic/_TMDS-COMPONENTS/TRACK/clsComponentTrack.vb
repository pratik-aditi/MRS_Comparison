        Private Function GetTrackGap(ByVal TrackIndex As Integer, ByVal RightLink As Int32) As Integer
            'This function finds the component type that the track is linked to from the right
            'and determines whether or not to create a gap between the components for visuall effects
            Try
                If Me.IsRemoteTrack Then Exit Function
                If RightLink = 0 Then
                    Return 0
                End If
                Select Case FindComponentType(RightLink)
                    Case "T", "T+", "T&"
                        If TrackComponent(FindTrackIndexFromGUID(RightLink)).StationNumber = TrackComponent(TrackIndex).StationNumber _
                        And TrackComponent(FindTrackIndexFromGUID(RightLink)).Name = TrackComponent(TrackIndex).Name Then
                            GetTrackGap = 0
                        ElseIf (FindComponentType(TrackComponent(TrackIndex).RightLink) = "S") Then
                            GetTrackGap = 0
                            'ElseIf (FindComponentType(TrackComponent(TrackIndex).LeftLink) = "S") Then
                            '   GetTrackGap = 0
                        Else
                            If TrackComponent(TrackIndex).LY <> TrackComponent(TrackIndex).RY Then
                                GetTrackGap = 0
                            Else
                                GetTrackGap = 3
                            End If
                        End If
                    Case "S", "+"
                        GetTrackGap = 0
                    Case Else
                        GetTrackGap = 3

                End Select
            Catch ex As Exception
                'SystemException(ex.ToString)
            End Try
        End Function

        Private Function FindObjectTypeFromGUID(ByVal UniqueID As Int32) As Object
            'This function finds the current trackcomponent index from the global unique ID
            Dim I As Integer
            Try
                For I = 1 To UBound(TrackComponent)
                    If TrackComponent(I).GUID = UniqueID Then
                        FindObjectTypeFromGUID = TrackComponent(I)
                        Exit Function
                    End If
                Next I

                For I = 1 To UBound(SwitchComponent)
                    If SwitchComponent(I).GUID = UniqueID Then
                        FindObjectTypeFromGUID = SwitchComponent(I)
                        Exit Function
                    End If
                Next I

                For I = 1 To SignalComponent.GetUpperBound(0)
                    If SignalComponent(I).GUID = UniqueID Then
                        FindObjectTypeFromGUID = SignalComponent(I)
                        Exit Function
                    End If
                Next I

                Dim comp As Object
                For Each comp In TMDS.GlobalDeclarations.gComponentsCollection
                    If comp.GUID = UniqueID Then
                        Return comp
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub ExpandOutForComponents(ByVal SelectionCollection As ArrayList)
            Dim SearchingForEnd As Boolean = True
            Dim CompList As ArrayList = SelectionCollection
            'Dim CompList1 As New ArrayList
            Dim SearchDirection As Integer
            Dim NextCompToTest As Object
            Dim LoopTerminator As Int32
            Dim FlipComp As Boolean = Me.FlipMe
            Dim LastLink As Int32 = Me.GUID
            Dim FlipFlopFound As Boolean
            If Not FlipComp Then
                Dim comp As Object
                For Each comp In SelectionCollection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.FlipMe Then
                            FlipComp = True
                            Exit For
                        End If
                    End If
                Next
            End If

            Try
                For SearchDirection = 1 To 2
                    If SearchDirection = 1 Then
                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.RightLink)
                    Else
                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.LeftLink)
                        LastLink = Me.GUID
                        FlipFlopFound = False
                    End If
                    While SearchingForEnd

                        If NextCompToTest Is Nothing Then Exit While

                        If NextCompToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" AndAlso NextCompToTest.AuthorityType = "CTC" Then
                            Dim sw As Switch = CType(NextCompToTest, Switch)

                            If Not CompList.Contains(NextCompToTest) Then
                                CompList.Add(NextCompToTest)
                                NextCompToTest.FlipMe = FlipComp
                            End If
                            If Not optDisableExpandOutLogicOnOsTracks Then

                                Dim comp As Object
                                If Not sw.OsComponentCollection Is Nothing Then
                                    For Each comp In sw.OsComponentCollection
                                        If Not CompList.Contains(comp) Then
                                            If optExcludeIndicationLikeOsTracksWhenNonTransversable Then
                                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                    If Not comp.NonTransverable And comp.TrackName <> Me.TrackName Then
                                                        CompList.Add(comp)
                                                        comp.FlipMe = FlipComp
                                                    Else
                                                        CompList.Add(comp)
                                                        comp.FlipMe = FlipComp
                                                    End If
                                                Else
                                                    CompList.Add(comp)
                                                    comp.FlipMe = FlipComp
                                                End If
                                            Else
                                                CompList.Add(comp)
                                                comp.FlipMe = FlipComp
                                            End If
                                        End If
                                    Next
                                End If
                            End If

                            If SearchDirection = 1 Then
                                If optEnableSwitchPositionRouting Then
                                    If sw.ControlledReverse Then
                                        If optEnableBRCSpecificChecks Then
                                            If NextCompToTest.RightAltLink = 0 Then
                                                NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                            Else
                                                NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightAltLink)
                                            End If
                                        Else
                                            NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightAltLink)
                                        End If
                                        'NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightAltLink)
                                    Else
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                    End If
                                Else
                                    If Not FlipFlopFound Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                    Else
                                        NextCompToTest.FlipMe = FlipFlopFound
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                    End If
                                End If

                            Else
                                If optEnableSwitchPositionRouting Then
                                    If sw.ControlledReverse Then
                                        If optEnableBRCSpecificChecks Then
                                            If NextCompToTest.LeftAltLink = 0 Then
                                                NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                            Else
                                                NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftAltLink)
                                            End If
                                        Else
                                            NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftAltLink)
                                        End If

                                    Else
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                    End If
                                Else

                                    If FlipFlopFound Then
                                        NextCompToTest.FlipMe = FlipFlopFound
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                    Else
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                    End If
                                End If
                            End If

                            If NextCompToTest Is Nothing Then
                                Exit While
                            End If

                            If NextCompToTest.GUID = 0 Then
                                Exit While
                            End If

                            'Exit While
                        ElseIf NextCompToTest.GetType.ToString = "TMDS.TrackComponents.Track" AndAlso NextCompToTest.AuthorityType = "CTC" Then
                            'If NextCompToTest.Name = Me.Name And NextCompToTest.StationNumber = Me.StationNumber Then
                            Dim trk As Track = CType(NextCompToTest, Track)
                            If optEnableSegmentBlockingForTNT Then
                                If Me.OStype AndAlso trk.LeftLimitName <> Me.LeftLimitName AndAlso trk.RightLimitName <> Me.RightLimitName Then
                                    Exit While
                                End If
                            Else
                                If Me.OStype AndAlso trk.Name <> Me.Name AndAlso trk.OStype AndAlso Not trk.RouteBlockingEnabled Then
                                    Exit While
                                End If
                            End If
                            If Not CompList.Contains(NextCompToTest) Then
                                CompList.Add(NextCompToTest)
                                NextCompToTest.FlipMe = FlipComp
                            End If
                            If SearchDirection = 1 Then
                                LastLink = NextCompToTest.guid

                                If Not FlipFlopFound Then
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                Else
                                    NextCompToTest.FlipMe = FlipFlopFound
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                End If

                            Else
                                LastLink = NextCompToTest.guid
                                If FlipFlopFound Then
                                    NextCompToTest.FlipMe = FlipFlopFound
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                Else
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                End If
                            End If

                            If NextCompToTest Is Nothing Then
                                Exit While
                            End If
                            If NextCompToTest.GUID = 0 Then
                                Exit While
                            End If
                            'Else
                            '    Exit While
                            'End If
                        ElseIf NextCompToTest.GetType.ToString = "TMDS.SignalComponents.Signal" Then 'added 4-17-04
                            Exit While 'added 4-17-04
                        Else
                            If SearchDirection = 1 Then
                                If NextCompToTest.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                                    Dim rr As RRXING = CType(NextCompToTest, RRXING)
                                    If LastLink = rr.LeftLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                    ElseIf rr.RightAltLink = LastLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftAltLink)
                                    ElseIf rr.LeftAltLink = LastLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightAltLink)
                                    End If
                                ElseIf NextCompToTest.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                                    If LastLink = NextCompToTest.RightLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                    Else
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                    End If
                                    FlipFlopFound = True
                                    NextCompToTest.FlipMe = FlipFlopFound

                                Else
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                End If

                            Else
                                If NextCompToTest.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                                    Dim rr As RRXING = CType(NextCompToTest, RRXING)
                                    If LastLink = rr.RightLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                    ElseIf rr.LeftAltLink = LastLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.rightAltLink)
                                    ElseIf rr.RightAltLink = LastLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftAltLink)
                                    End If
                                ElseIf NextCompToTest.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                                    If LastLink = NextCompToTest.RightLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                    Else
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                    End If

                                    'FlipFlopFound = True
                                    If FlipFlopFound Then
                                        FlipFlopFound = False
                                    Else
                                        FlipFlopFound = True
                                    End If
                                    NextCompToTest.FlipMe = FlipFlopFound
                                Else
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                End If
                            End If
                            If NextCompToTest Is Nothing Then
                                Exit While
                            ElseIf NextCompToTest.GUID = 0 Then
                                Exit While
                            End If
                        End If
                        LoopTerminator = LoopTerminator + 1
                        If LoopTerminator > 100 Then
                            Exit While
                        End If
                    End While
                Next SearchDirection

                If optEnableSegmentBlockingForTNT Then
                    RemoveSwitchesFromOuterBoundries(CompList)
                End If

                If Me.FlipMe Then
                    ResetTATCollectionFlipFlop(SelectionCollection)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub RemoveSwitchesFromOuterBoundries(ByRef theList As ArrayList)
            Try
                Dim TempList As ArrayList = theList.Clone
                Dim comp As Object
                For Each comp In TempList
                    If comp.GetType.ToString = gSwitchComponentName Then
                        Dim sw As Switch = CType(comp, Switch)
                        Dim myLeftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.LeftLink)
                        Dim myRightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.RightLink)

                        Dim myTurnoutTrack As Track = Nothing
                        If sw.LeftAltLink <> 0 Then
                            myTurnoutTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.LeftAltLink)
                        Else
                            myTurnoutTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.RightAltLink)
                        End If
                        Dim ExcludeSwitch As Boolean = True
                        If TempList.Contains(myRightTrack) AndAlso TempList.Contains(myLeftTrack) Then
                            ExcludeSwitch = False
                        ElseIf (TempList.Contains(myTurnoutTrack) AndAlso TempList.Contains(myRightTrack)) OrElse (TempList.Contains(myTurnoutTrack) AndAlso TempList.Contains(myLeftTrack)) Then
                            ExcludeSwitch = False
                        End If
                        If ExcludeSwitch Then
                            theList.Remove(sw)
                        End If
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub ResetTATCollectionFlipFlop(ByRef ComponentsColletion As ArrayList)
            Dim comp As Object = Nothing
            Dim CompColl As New ArrayList
            Dim FlipFlopFound As Boolean = False
            Dim OrgCompColl As New ArrayList
            Try
                For Each comp In ComponentsColletion
                    OrgCompColl.Add(comp)
                    Select Case comp.GetType.ToString
                        Case gTrackComponentName, gSwitchComponentName, gRRXINGComponentName
                            comp.FlipMe = False
                    End Select
                    CompColl.Add(comp)
                Next
                ComponentsColletion.Clear()
                comp = Nothing

                For Each comp In CompColl
                    If FlipFlopFound Then
                        Select Case comp.GetType.ToString
                            Case gTrackComponentName, gSwitchComponentName, gRRXINGComponentName
                                comp.FlipMe = True
                        End Select
                    Else
                        If comp.GetType.ToString = gTrackComponentName Then
                            Dim LeftObj As Object = FindCompFromGUID(comp.LeftLink)
                            Dim RightObj As Object = FindCompFromGUID(comp.RightLink)
                            If LeftObj.GetType.ToString = gFlipFlopComponentName Or RightObj.GetType.ToString = gFlipFlopComponentName Then
                                FlipFlopFound = True
                            End If
                        End If
                    End If
                    ComponentsColletion.Add(comp)
                    'Me.TrackEvent("ResetTATCollectionFlipFlop: " & comp.GetType.ToString & " : " & comp.Guid & " Flipme: " & comp.flipme.ToString)
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
                ComponentsColletion.Clear()
                For Each comp In OrgCompColl
                    ComponentsColletion.Add(comp)
                Next
            Finally
                CompColl = Nothing
                comp = Nothing
                OrgCompColl = Nothing
            End Try
        End Sub

        Public Sub ExpandOutForComponentsForRouteBlocking(ByVal SelectionCollection As ArrayList)
            Dim SearchingForEnd As Boolean = True
            Dim CompList As ArrayList = SelectionCollection
            Dim SearchDirection As Integer
            Dim NextCompToTest As Object
            Dim LoopTerminator As Int32
            Dim FlipComp As Boolean = Me.FlipMe
            Dim LastLink As Int32
            If Not FlipComp Then
                Dim comp As Object
                For Each comp In SelectionCollection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.FlipMe Then
                            FlipComp = True
                            Exit For
                        End If

                    End If
                Next
            End If

            Try
                For SearchDirection = 1 To 2
                    If SearchDirection = 1 Then
                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.RightLink)
                    Else
                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.LeftLink)
                    End If
                    While SearchingForEnd

                        If NextCompToTest Is Nothing Then Exit While

                        If NextCompToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim sw As Switch = CType(NextCompToTest, Switch)
                            If Not CompList.Contains(NextCompToTest) Then
                                CompList.Add(NextCompToTest)
                                NextCompToTest.FlipMe = FlipComp
                            End If
                            Dim comp As Object
                            For Each comp In sw.OsComponentCollection
                                If Not CompList.Contains(comp) Then
                                    If optExcludeIndicationLikeOsTracksWhenNonTransversable Then
                                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            If Not comp.NonTransverable And comp.TrackName <> Me.TrackName And Me.RightLimitName = comp.RightLimitName And Me.LeftLimitName = comp.LeftLimitName Then
                                                CompList.Add(comp)
                                                'Else
                                                '    CompList.Add(comp)
                                            End If
                                        Else
                                            CompList.Add(comp)
                                        End If
                                    Else
                                        CompList.Add(comp)
                                    End If

                                End If
                            Next
                            If SearchDirection = 1 Then
                                If sw.RightAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightAltLink)
                                    Else
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                    End If
                                Else
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                End If

                            Else
                                If sw.LeftAltLink <> 0 Then
                                    If sw.ControlledReverse Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftAltLink)
                                    Else
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                    End If
                                Else
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                End If

                            End If
                            If NextCompToTest Is Nothing Then
                                Exit While
                            End If

                            If NextCompToTest.GUID = 0 Then
                                Exit While
                            End If

                            'Exit While
                        ElseIf NextCompToTest.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            'If NextCompToTest.Name = Me.Name And NextCompToTest.StationNumber = Me.StationNumber Then
                            Dim trk As Track = CType(NextCompToTest, Track)
                            If (Me.OStype And trk.Name <> Me.Name And trk.OStype And Not trk.RouteBlockingEnabled) Or trk.NonTransverable Then
                                Exit While
                            End If

                            If Not CompList.Contains(NextCompToTest) Then
                                CompList.Add(NextCompToTest)
                                NextCompToTest.FlipMe = FlipComp
                            End If
                            If SearchDirection = 1 Then
                                LastLink = NextCompToTest.guid
                                NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)

                            Else
                                LastLink = NextCompToTest.guid
                                NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                            End If
                            If NextCompToTest Is Nothing Then
                                Exit While
                            End If
                            If NextCompToTest.GUID = 0 Then
                                Exit While
                            End If
                            'Else
                            '    Exit While
                            'End If
                        ElseIf NextCompToTest.GetType.ToString = "TMDS.SignalComponents.Signal" Then 'added 4-17-04
                            Exit While 'added 4-17-04
                        Else
                            If SearchDirection = 1 Then
                                If NextCompToTest.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                                    Dim rr As RRXING = CType(NextCompToTest, RRXING)
                                    If LastLink = rr.LeftLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                    ElseIf rr.RightAltLink = LastLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftAltLink)
                                    End If
                                Else
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.RightLink)
                                End If

                            Else
                                If NextCompToTest.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                                    Dim rr As RRXING = CType(NextCompToTest, RRXING)
                                    If LastLink = rr.RightLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                    ElseIf rr.LeftAltLink = LastLink Then
                                        NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.rightAltLink)
                                    End If
                                Else
                                    NextCompToTest = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextCompToTest.LeftLink)
                                End If
                            End If
                            If NextCompToTest.GUID = 0 Then
                                Exit While
                            End If
                        End If
                        LoopTerminator = LoopTerminator + 1
                        If LoopTerminator > 100 Then
                            Exit While
                        End If
                    End While
                Next SearchDirection

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

