        ''' <summary>
        ''' Update tag status
        ''' </summary>
        ''' <param name="pRemove"></param>
        Public Sub UpdateTagStatus(Optional ByVal pRemove As Boolean = False)
            Dim osComp As Object
            Try
                If Not IsNothing(Me.OsComponentCollection) Then
                    For Each osComp In Me.OsComponentCollection
                        If osComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then
                                If pRemove Then
                                    osComp.OverRideCodeBrown = False
                                Else
                                    osComp.OverRideCodeBrown = True
                                End If
                            End If
                        ElseIf osComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then
                                If pRemove Then
                                    osComp.OverRideCodeBrown = False
                                Else
                                    osComp.OverRideCodeBrown = True
                                End If
                            End If
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Try
                'Set the restrictive tag flag on looking at current tags
                If Not Me.OStype Then
                    TrackTagRestrictive = False
                    trackTagAlarm = False
                    trackTagPlan = False
                    If Me.TrackTagLabels.Count > 0 Then
                        Dim tg As Tag
                        Dim foundSpeedTag As Boolean = False
                        Dim foundActiveRestriction As Boolean = False
                        Dim foundPlanRestriction As Boolean = False
                        Dim foundTrackAlarmTag As Boolean = False
                        For Each tg In Me.TrackTagLabels
                            If tg.Restriction Then
                                TrackTagRestrictive = True
                            End If
                            If tg.TagType = optTagType1 Then
                                foundSpeedTag = True
                            End If
                            If tg.TagType = optTagType6 Then
                                foundTrackAlarmTag = True
                            End If
                            If tg.isWorkZonePlan AndAlso tg.TagType = optTagType7 Then
                                foundPlanRestriction = True
                            End If
                            If Not tg.isWorkZonePlan Then
                                foundActiveRestriction = True
                            End If
                        Next
                        If Not foundSpeedTag AndAlso foundTrackAlarmTag Then
                            trackTagAlarm = True
                        End If
                        If Not foundActiveRestriction AndAlso foundPlanRestriction Then
                            trackTagPlan = True
                        Else
                            trackTagPlan = False
                        End If
                    End If
                Else
                    TrackTagRestrictive = False
                    trackTagAlarm = False
                    trackTagPlan = False
                    For Each osComp In Me.OsComponentCollection
                        If osComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If osComp.TrackTagLabels.Count > 0 Then
                                Dim tg As Tag
                                Dim foundSpeedTag As Boolean = False
                                Dim foundActiveRestriction As Boolean = False
                                Dim foundPlanRestriction As Boolean = False
                                Dim foundTrackAlarmTag As Boolean = False
                                For Each tg In osComp.TrackTagLabels
                                    If tg.Restriction Then
                                        TrackTagRestrictive = True
                                        If tg.TagType = optTagType6 Then
                                            trackTagAlarm = True
                                        End If
                                        If tg.TagType = optTagType1 Then
                                            foundSpeedTag = True
                                        End If
                                        If tg.TagType = optTagType6 Then
                                            foundTrackAlarmTag = True
                                        End If
                                        If tg.isWorkZonePlan AndAlso tg.TagType = optTagType7 Then
                                            foundPlanRestriction = True
                                        End If
                                        If Not tg.isWorkZonePlan Then
                                            foundActiveRestriction = True
                                        End If
                                    End If
                                Next
                                If Not foundSpeedTag AndAlso foundTrackAlarmTag Then
                                    trackTagAlarm = True
                                End If
                                If Not foundActiveRestriction AndAlso foundPlanRestriction Then
                                    trackTagPlan = True
                                Else
                                    trackTagPlan = False
                                End If
                            End If
                        End If
                    Next
                    For Each osComp In Me.OsComponentCollection
                        If Not osComp Is Me Then
                            osComp.TrackTagRestrictive = Me.TrackTagRestrictive
                            osComp.TrackTagAlarm = Me.trackTagAlarm
                            osComp.trackTagPlan = Me.trackTagPlan
                            If osComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                osComp.UpdateColorStatusOnly()
                            Else
                                osComp.UpdateStatus()
                            End If
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function AddTagToTrack(ByVal TagLabel As Tag) As Boolean
            Dim tg As Tag = Nothing
            Try
                If Me.OStype Then
                    Dim osTrk As Object
                    For Each osTrk In Me.OsComponentCollection
                        If osTrk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(osTrk, Track)
                            Dim t As Tag
                            For Each t In trk.TrackTagLabels
                                If Trim(t.TagGuid) = Trim(TagLabel.TagGuid) Then
                                    Return False
                                End If
                            Next
                        End If
                    Next

                    'for OS tracks with more then one switch allow placement anywhere but the angled-piece of track
                    Dim NumOfSwitches As Integer
                    If IsNothing(Me.OsComponentCollection) Then
                        Me.OsComponentCollection = Me.FindOsTracks
                    End If
                    For Each osTrk In Me.OsComponentCollection
                        If osTrk.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            NumOfSwitches = NumOfSwitches + 1
                        End If
                    Next
                    If NumOfSwitches <= 1 Or Me.LY <> Me.RY Then
                        For Each osTrk In Me.OsComponentCollection
                            If osTrk.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                If osTrk.LeftAltLink <> 0 Then
                                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(osTrk.RightLink)
                                    If trk Is Nothing Then Exit For
                                    If trk.RepositionTrackTag(TagLabel) Then
                                        Return True
                                    Else
                                        Return False
                                    End If
                                Else
                                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(osTrk.LeftLink)
                                    If trk Is Nothing Then Exit For
                                    If trk.RepositionTrackTag(TagLabel) Then
                                        Return True
                                    Else
                                        Return False
                                    End If
                                End If
                            End If
                        Next
                    End If

                End If
                If TagLabel.ShowOccupancy Then
                    Me.OccupancyReminder = True
                    Me.UpdateStatus()
                End If


                'TrackTagLabels.Add(TagLabel)



                Dim TagExists As Boolean
                For Each tg In TrackTagLabels
                    If tg.TagGuid = TagLabel.TagGuid Then
                        TagExists = True
                        Exit For
                    End If
                Next
                If Not TagExists Then
                    TrackTagLabels.Add(TagLabel)
                End If

                Me.UpdateTagStatus()

                'Remote Linked Track
                If Me.IsLinkToRemoteTrack Then
                    Dim ClientConnection As TMDS.NetworkListener.WrkstnConnection = Me.FindRemoteLinkConnection
                    If Not ClientConnection Is Nothing Then
                        ClientConnection.SendRetrieveTag()
                    End If
                End If
                If Not Me.IsRemoteTrack Then
                    InitTagDisplay()
                End If
                If Me.myControlPoint IsNot Nothing AndAlso Me.myControlPoint.AllowStatusPublishing Then
                    PublishTagStatus(True, TagLabel)
                End If


                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                tg = Nothing
            End Try
        End Function

        Public Function RepositionTrackTag(ByVal TagLabel As Tag) As Boolean
            Try
                If TagLabel.ShowOccupancy Then
                    Me.OccupancyReminder = True
                    Me.UpdateStatus()
                End If
                If TagLabel.TrackGuid <> 0 Then
                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(TagLabel.TrackGuid)
                    If Not IsNothing(trk) Then
                        If Me.OStype Then
                            If Not IsNothing(Me.OsComponentCollection) Then
                                If Me.OsComponentCollection.Contains(trk) Then
                                    TagLabel.TrackGuid = Me.GUID
                                End If
                            End If
                        End If
                    End If
                Else
                    TagLabel.TrackGuid = Me.GUID
                End If


                TrackTagLabels.Add(TagLabel)
                TagLabel.UpdateTagIntoDB()
                Me.UpdateTagStatus()
                'Remote Linked Track
                If Me.IsLinkToRemoteTrack Then
                    Dim ClientConnection As TMDS.NetworkListener.WrkstnConnection = Me.FindRemoteLinkConnection
                    If Not ClientConnection Is Nothing Then
                        ClientConnection.SendRetrieveTag()
                    End If
                End If
                InitTagDisplay()
                Me.UpdateStatus()
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        ''' <summary>
        ''' Remove Tag From Track
        ''' </summary>
        ''' <param name="pTag"></param>
        ''' <param name="pMasterBulletinTag"></param>
        Sub RemoveTagFromTrack(ByVal pTag As Tag, Optional ByVal pMasterBulletinTag As Boolean = True)
            Dim clientConnection As TMDS.NetworkListener.WrkstnConnection
            Try
                TrackTagLabels.Remove(pTag)
                InitTagDisplay()
                If Me.IsLinkToRemoteTrack Then
                    clientConnection = Me.FindRemoteLinkConnection
                    If Not clientConnection Is Nothing Then
                        clientConnection.SendRetrieveTag()
                    End If
                End If
                If Me.myControlPoint.AllowStatusPublishing Then
                    PublishTagStatus(False, pTag)
