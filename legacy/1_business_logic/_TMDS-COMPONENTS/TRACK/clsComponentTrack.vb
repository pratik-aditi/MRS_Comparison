        ''' <summary>
        ''' Remove tag
        ''' </summary>
        ''' <param name="sender"></param>
        ''' <param name="e"></param>
        Private Sub mnuTagRemove_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Dim tg As Tag
            Dim tagToDelete As Tag = Nothing
            Dim mi As MenuItem
            Dim tagData() As String
            Try
                TrackEventLog("CLICKED - REMOVE TAG")
                mi = DirectCast(sender, MenuItem)
                tagData = mi.Text.Split(",")
                For Each tg In Me.TrackTagLabels
                    If tagData.Length < 4 Then
                        TrackEventLog("mnuTagRemove_Click:TagData=" & mi.Text)
                    End If
                    If (tg.TagType = tagData(0) OrElse tg.IsCriticalAlertType And tagData(0) = "CRITICAL ALERT") And CStr(tg.CreateTime) = Trim(tagData(3)) And Trim(tg.Creator) = Trim(tagData(1)) & "," & tagData(2) Then
                        tagToDelete = tg
                        Exit For
                    End If
                Next
                If tagToDelete IsNot Nothing AndAlso tagToDelete.BulletinTag Then
                    If Not ShowAdminPassword(Nothing, Nothing, True, "DELETE BULLETIN TAG GUID: " & tagToDelete.TagGuid, Me) Then Exit Sub
                End If
                RemoveTag(tagToDelete)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                tg = Nothing
                tagToDelete = Nothing
                mi = Nothing
                tagData = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Remote tag
        ''' </summary>
        ''' <param name="pTagtoDelete"></param>
        Public Sub RemoveTag(ByVal pTagtoDelete As Tag)
            Dim myTagType As String = String.Empty
            Dim multipleTrackTagFound As Boolean
            Dim messageList As New ArrayList()
            Dim frmMessageBox As frmMessageBox
            Dim data() As String
            Dim tagMessage As String = String.Empty
            Dim overrideNextPrompt As Boolean
            Dim summItem As SummaryItem
            Dim masterTagTrack As Track = Nothing
            Dim frmMessBoxMultipleTags As frmMessageBox
            Dim messageListMT As New ArrayList()
            Try
                If Not IsNothing(pTagtoDelete.CompList) Then
                    If pTagtoDelete.CompList.Count > 0 Then
                        multipleTrackTagFound = True
                    End If
                End If
                If Not IsNothing(pTagtoDelete) Then
                    TrackEventLog("RemoveTag:TagGUID=" & pTagtoDelete.TagGuid)
                    'Ckeck if tag was created per view client
                    If pTagtoDelete.isRemoteTag Then
                        messageList.Add(optTagString28)
                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = Me.CurrentDrawingForm
                        frmMessageBox.StartPosition = FormStartPosition.Manual
                        frmMessageBox.SetMessage(messageList, pTagtoDelete.TagType, False, Me.CurrentDrawingForm.myLaunchPoint)
                        frmMessageBox.ShowDialog()
                        TrackEventLog("RemoveTag:Cant remove speed restriction:Reason=" & optTagString28)
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing
                        Exit Sub
                    End If
                    data = pTagtoDelete.DataString.Split("|")
                    If pTagtoDelete.IsCriticalAlertType Then
                        messageList.Add(optTagString1 & Space(1) & "CRITICAL ALERT" & Space(1) & "NO BLOCO " & Me.Name & "?")
                    Else
                        messageList.Add(optTagString1 & Space(1) & pTagtoDelete.TagType & Space(1) & "NO BLOCO " & Me.Name & "?")
                    End If
                    Select Case pTagtoDelete.TagType
                        Case optTagType1
                            If Not multipleTrackTagFound Or Not optEnablePromptForMultipleTagRelease Then
                                tagMessage = optTagString2 & Space(1) & data(1) & Space(1) & optTagString3 & Space(1) & data(2)
                            ElseIf multipleTrackTagFound Then
                                tagMessage = optTagString2 & Space(1) & Decimal.Round(Me.LeftLimitMilePost, optMilePostRoundFactor) & Space(1) & optTagString3 & Space(1) & Decimal.Round(Me.RightLimitMilePost, optMilePostRoundFactor)
                            End If
                        Case optTagType2
                            tagMessage = Space(1) & optTagString4 & Space(1) & data(1) & Space(1) & optTagString5 & Space(1) & data(0)
                        Case optTagType3
                            tagMessage = optTagString6 & Space(1) & Mid(data(0), 1, 50)
                    End Select
                    messageList.Add(tagMessage)
                    messageList.Add("")
                    If optEnablePromptForMultipleTagRelease And multipleTrackTagFound Then
                        If Not IsNothing(pTagtoDelete.CompList) Then
                            messageListMT.Add(tagMessage)
                            messageListMT.Add("MULTIPLE TRACKS ARE ASSOCIATED WITH THIS TAG.")
                            messageListMT.Add("DELETE TAGS ON ALL TRACKS?")
                            messageListMT.Add("")
                            frmMessBoxMultipleTags = New frmMessageBox()
                            frmMessBoxMultipleTags.Owner = Me.CurrentDrawingForm
                            frmMessBoxMultipleTags.StartPosition = FormStartPosition.Manual
                            frmMessBoxMultipleTags.SetMessage(messageListMT, optTagString7, True, Me.CurrentDrawingForm.myLaunchPoint)
                            frmMessBoxMultipleTags.ShowDialog()
                            If frmMessBoxMultipleTags.FormFeedBack = 6 Then
                                overrideNextPrompt = True
                                Dim comp As Object
                                For Each comp In pTagtoDelete.CompList
                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                        comp.RemoveTagFromTrack(pTagtoDelete)
                                        comp.InitTagDisplay()
                                        comp.UpdateTagStatus(True)
                                        comp.UpdateStatus()
                                    End If
                                Next
                            End If
                            frmMessBoxMultipleTags.Dispose()
                            frmMessBoxMultipleTags = Nothing
                        End If
                        If Not overrideNextPrompt And Not IsNothing(pTagtoDelete.CompList) Then
                            Dim LastTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(pTagtoDelete.CompList)
                            Dim FirstTrack As Track = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(pTagtoDelete.CompList)
                            If Not IsNothing(LastTrack) And Not IsNothing(FirstTrack) Then
                                If LastTrack.GUID <> Me.GUID And Not FirstTrack.GUID <> Me.GUID Then
                                    TMDS.modSystemFuncs.ClearSystemVariables()
                                    Exit Sub
                                End If
                            End If
                        End If
                    End If
                    If Not overrideNextPrompt Then
                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = Me.CurrentDrawingForm
                        frmMessageBox.StartPosition = FormStartPosition.Manual
                        If optEnableTAGDeleteTimer Then
                            frmMessageBox.IsTAGDelete = True
                            frmMessageBox.SetMessage(messageList, optTagString7, True, Me.CurrentDrawingForm.myLaunchPoint, Nothing, True)
                        Else
                            frmMessageBox.SetMessage(messageList, optTagString7, True, Me.CurrentDrawingForm.myLaunchPoint)
                        End If
                        frmMessageBox.ShowDialog()
                        If frmMessageBox.FormFeedBack <> 6 Then
                            frmMessageBox.Dispose()
                            frmMessageBox = Nothing
                            TMDS.modSystemFuncs.ClearSystemVariables()
                            Exit Sub
                        End If
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing
                    End If
                    If Not multipleTrackTagFound Or overrideNextPrompt Then
                        Me.DeleteTagFromDatabase(pTagtoDelete)
                    Else
                        If Not optEnablePromptForMultipleTagRelease And multipleTrackTagFound Then
                            For Each comp As Object In pTagtoDelete.CompList
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    comp.RemoveTagFromTrack(pTagtoDelete)
                                    comp.InitTagDisplay()
                                    comp.UpdateTagStatus(True)
                                    comp.UpdateStatus()
                                End If
                            Next
                            masterTagTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(pTagtoDelete.TrackGuid)
                            If Not IsNothing(masterTagTrack) Then
                                masterTagTrack.RemoveTagFromTrack(pTagtoDelete)
                                masterTagTrack.InitTagDisplay()
                                masterTagTrack.UpdateTagStatus(True)
                                masterTagTrack.UpdateStatus()
                            End If
                            Me.DeleteTagFromDatabase(pTagtoDelete)
                        End If
                        pTagtoDelete.UpdateCompList(Me)
                    End If
                    Me.RemoveTagFromTrack(pTagtoDelete)
                    Me.InitTagDisplay()
                    Me.UpdateTagStatus(True)
                    Me.UpdateStatus()
                    pTagtoDelete.RecordTrackAlarm("MANUAL-DELETE")
                    TMDS.NetworkMessages.CadMessages.SendTrackAlarmEvent("MANUAL-DELETE", Me.Name, "OK", Me.myControlPoint.GUID, pTagtoDelete)
                    If Not multipleTrackTagFound Or overrideNextPrompt Or optEnableStretchyTag Then
                        summItem = New SummaryItem("TAG", "REMOVE", pTagtoDelete)
                        SyncLock gSummaryTagQueue.SyncRoot
                            gSummaryTagQueue.Enqueue(summItem)
                        End SyncLock
                        TrackTags.Remove(pTagtoDelete)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                myTagType = Nothing
                multipleTrackTagFound = Nothing
                messageList = Nothing
                frmMessageBox = Nothing
                data = Nothing
                tagMessage = Nothing
                overrideNextPrompt = Nothing
                summItem = Nothing
                masterTagTrack = Nothing
                frmMessBoxMultipleTags = Nothing
                messageListMT = Nothing
            End Try
        End Sub

