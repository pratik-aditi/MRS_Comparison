        Public Function CheckIfAdjacentZoneIsOccupied(ByVal AuthZonelist As ArrayList, ByVal ZoneName As String, ByVal AuthUID As String, ByRef Auth As Object) As Boolean
            Dim OneZoneHasTrain As Boolean = False
            Dim OneZoneHasTrainZone As ZoneDetail = Nothing
            Dim ZoneWentDown As TrackZone = Nothing
            Dim PreviousZoneSeqNo As Integer = 0
            Dim IgnoreZoneStamping As Boolean = False
            Try
