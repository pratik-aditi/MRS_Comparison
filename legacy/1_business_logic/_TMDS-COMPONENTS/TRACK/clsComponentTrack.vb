        ''' <summary>
        ''' Perform Conflict Check To Pass Red Signal
        ''' </summary>
        ''' <param name="pTrain"></param>
        ''' <returns></returns>
        Private Function PerformConflictCheckToPassRedSignal(ByVal pTrain As TrainID) As Boolean
            Dim compToCheck As Object
            Dim validCompSelecttion As New ArrayList
            Dim firstSignalFound As Boolean
            Try
                If IsNothing(pTrain) Then Return False
                For Each compToCheck In gEntExtTrackSelection
                    If compToCheck.GetType.ToString = gSignalComponentName Then
                        firstSignalFound = True
                    End If
                    If firstSignalFound Then
                        validCompSelecttion.Add(compToCheck)
                    End If
                Next
                'If Not CheckForRestrictiveTags(validCompSelecttion) Then
                '    Me.TrackEventLog("PerformConflictCheckToPassRedSignal:Exist track tag the front of train that doesnt allow to send license")
                '    ClearSystemVariables()
                '    Return False
                'End If
                Dim BlockNames As New ArrayList
                Dim Message As String = CheckForEMTDeviceBlocks(validCompSelecttion, BlockNames)
                Select Case Message.Trim
                    Case "False", "PRS", "EMT"
                        Dim frmMessageBox As frmMessageBox
                        Dim MessageList As New ArrayList()
                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = Me.CurrentDrawingForm
                        MessageList.Add(optPSSDeviceWarningBegin)
                        MessageList.Add(optPSSDeviceWarningLimits)
                        MessageList.Add("")
                        If optEnableARRCSpecificOptions AndAlso BlockNames IsNot Nothing AndAlso BlockNames.Count > 0 Then
                            Dim s As String
                            BlockNames.Reverse()
                            For Each s In BlockNames
                                If s.Trim <> "" Then
                                    MessageList.Add(s)
                                End If
                            Next
                            MessageList.Add("")
                        End If
                        MessageList.Add(optPSSDeviceWarningContinue)
                        frmMessageBox.btnOK.TabIndex = 2
                        frmMessageBox.btnYes.TabIndex = 1
                        frmMessageBox.btnNo.TabIndex = 3
                        frmMessageBox.SetMessage_PSS(MessageList, optPSSDeviceBlockTitle, True, Me.CurrentDrawingForm.myLaunchPoint)
                        frmMessageBox.ShowDialog()
                        If frmMessageBox.FormFeedBack <> 6 Then
                            Me.TrackEventLog("PerformConflictCheckToPassRedSignal:DISPATCHER(" & gCurrentUser.Initials & ") SELECT NO TO CONTINUE WITH AUTHORITY ACCOUNT DEVICE BLOCKS FOUND IN THE LIMITS OF THE TRACK AUTHORITY.")
                            frmMessageBox.Dispose()
                            frmMessageBox = Nothing
                            Return False
                        End If
                        Me.TrackEventLog("PerformConflictCheckToPassRedSignal:DISPATCHER(" & gCurrentUser.Initials & ") SELECT YES TO CONTINUE WITH AUTHORITY ACCOUNT DEVICE BLOCKS FOUND IN THE LIMITS OF THE TRACK AUTHORITY.")
                End Select
                PSSHandeOperationRequiredNOOption = 0
                If Not optDisableSwitchesInHandForPSS Then
                    If gEntryTrack.AuthorityType = "CTC" Then
                        CheckForSwitches(gEntExtTrackSelection)
                    Else
                        If CheckIfSwitchEnabledForBlocking() Then
                            CheckForSwitches(gEntExtTrackSelection)
                        End If
                    End If
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                compToCheck = Nothing
                validCompSelecttion = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Check For Restrictive Tags
        ''' </summary>
        ''' <param name="pTrackSelection"></param>
        ''' <returns></returns>
        Private Function CheckForRestrictiveTags(ByRef pTrackSelection As ArrayList) As Boolean
            Dim messageList As New ArrayList
            Dim frmReadRepeat As frmReadRepeat = Nothing
            Dim tagString() As String
            Try
                For Each comp As Object In pTrackSelection
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If comp.TrackTagLabels.Count > 0 Then
                            For Each trkTag As Tag In comp.TrackTagLabels
                                If trkTag.Restriction Then
                                    messageList.Add(trkTag.TagType.ToString.ToUpper & " : ")
                                    tagString = trkTag.DataString.Split("|")
                                    Select Case trkTag.TagType.ToString.ToUpper
                                        Case "XING"
                                            If tagString.Length < 2 Then Exit Select
                                            messageList.Add("PROTECT XING AT MP " & tagString(0))
                                            messageList.Add("XING NAME: " & tagString(1))
                                        Case optTagType1
                                            If tagString.Length < 5 Then Exit Select
                                            messageList.Add("VELOCIDADE LIMITE: " & tagString(5) & " KM/H")
                                            messageList.Add("ENTRE " & tagString(1))
                                            messageList.Add("ATÉ " & tagString(2))
                                            messageList.Add("NA LINHA " & tagString(3))
                                        Case optTagType3
                                            If tagString.Length < 1 Then Exit Select
                                            messageList.Add("INSTRUÇÕES: " & tagString(0))
                                        Case optTagType6 'TRACK ALARM
                                            Return True
                                    End Select
                                    frmReadRepeat = New frmReadRepeat
                                    frmReadRepeat.SetMessage(messageList, trkTag.TagType.ToUpper, Me.CurrentDrawingForm.myLaunchPoint, "TAG", False)
                                    frmReadRepeat.ShowDialog()
                                    If frmReadRepeat.FormFeedback = 6 Then
                                        Me.TrackEventLog("CheckForRestrictiveTags:SELECT OK TO TRACK RESTRICTION. (TAG TYPE:" & trkTag.TagType.ToString.ToUpper & ")(TRACK UID:" & trkTag.TrackGuid & ")(TAG DATA:" & trkTag.DataString & ")")
                                    Else
