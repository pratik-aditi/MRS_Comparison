                                If Me.RightAltLink <> 0 Then
                                    ShelfTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.RightAltLink)
                                    If ShelfTrack.TrainIDs.Count > 0 Then
                                        trn2 = Nothing
                                        trn2 = ShelfTrack.TrainIDs(0)
