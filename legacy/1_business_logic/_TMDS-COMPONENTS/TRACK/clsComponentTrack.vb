        Private Function CheckForTrainToRight() As Boolean
            Try
                Dim NextTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.RightLink)
                If Me.OStype And IsNothing(NextTrack) Then
                    Dim NextComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.RightLink)
                    If Not IsNothing(NextComp) Then
                        NextTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightLink)
                    End If
                End If
                If IsNothing(NextTrack) Then Return False
                If NextTrack.TrainIDs.Count > 0 Then Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Function CheckForTrainToLeft() As Track
            Try
                Dim NextTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.LeftLink)
                If Me.OStype And IsNothing(NextTrack) Then
                    Dim NextComp As Object = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.LeftLink)
                    If Not IsNothing(NextComp) Then
                        NextTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.LeftLink)
                    End If
                End If
                If IsNothing(NextTrack) Then
                    Return Nothing
                End If

                If NextTrack.TrainIDs.Count > 0 Then
                    Return NextTrack
                End If
                Return Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub InitTrainDisplay()
            Dim RefreshTrainDisplay As Boolean = False
            Try
                If Me.CurrentDrawingForm Is Nothing Then Exit Sub
                If optEnableBRCSpecificChecks Then RefreshTrainDisplay = True
                Dim FontLength As Integer
                If TrainIDs.Count > 0 Then
                    If Not IsNothing(TrainIDText) Then
                        TrainIDText.Dispose()
                    End If
                    TrainIDText = Nothing
                    TrainIDText = New TrainIDFont()
                    Dim Train As TrainID
                    If Me.myGraphic Is Nothing Then
                        If Me.ParentForm IsNot Nothing Then
                            Me.myGraphic = Me.ParentForm.CreateGraphics
                        ElseIf Me.CurrentDrawingForm IsNot Nothing Then
                            Me.myGraphic = Me.CurrentDrawingForm.CreateGraphics
                        Else
                            TrackEventLog("InitTrainDisplay:myGraphic is nothing")
                            Exit Sub
                        End If
                    End If
                    TrainIDText.Graphical = Me.myGraphic
                    If IsNothing(TrainIDText.Graphical) Then Exit Sub
                    Dim TrainFoundToRight As Boolean
                    If optDisableTrainSymbolTruncate Then
                        TrainFoundToRight = CheckForTrainToRight()
                        Dim LeftTrack As Track = CheckForTrainToLeft()
                        If Not IsNothing(LeftTrack) Then
                            If optRailRoadName <> "MRS" Or optRailRoadName = "RUMO" Then
                                LeftTrack.InitTrainDisplay()
                            End If
                        End If
                    End If
                    If optDisableTrainSymbolTruncate And Not TrainFoundToRight Then
                        FontLength = 50
                    Else
                        If optScaleTrainSymbolsFormatting Then
                            If Me.Width <= 40 Then
                                FontLength = 3 ' 5
                            ElseIf Me.Width <= 50 Then
                                FontLength = 5 ' 5
                            ElseIf Me.Width <= 60 Then
                                FontLength = 6 ' 5
                            ElseIf Me.Width <= 80 Then
                                FontLength = 7 '6
                            ElseIf Me.Width <= 100 Then
                                FontLength = 8 '8
                            ElseIf Me.Width > 100 Then
                                FontLength = 10
                            Else
                                FontLength = 6
                            End If
                        Else
                            If Me.Width <= 60 Then
                                FontLength = 7 ' 5
                            ElseIf Me.Width <= 80 Then
                                FontLength = 8 '6
                            ElseIf Me.Width <= 100 Then
                                FontLength = 9 '8
                            ElseIf Me.Width > 100 Then
                                FontLength = 10
                            Else
                                FontLength = 6
                            End If
                        End If
                    End If
                    Train = TrainIDs.Item(0)
                    TrackEventLog("InitTrainDisplay:Start:TrainName=" & Train.Name & ":TrainDirection=" & Train.Direction & ":WhoCallMe=" & (New System.Diagnostics.StackTrace).GetFrame(1).GetMethod.Name)
                    If Train.DisplayEngineID Then
                        If Trim(Train.IdentifingUnit) = "" Then
                            If TrainIDs.Count > 1 Or Me.MOWIDs.Count > 0 Then
                                Train.DisplayText = optTrainString20 & "*"
                            Else
                                Train.DisplayText = optTrainString20
                            End If
                            If Train.Name.Length > FontLength Then
                                Train.DisplayText = Mid(Train.DisplayText, 1, FontLength) & ".."
                            End If
                        Else
                            If TrainIDs.Count > 1 Or Me.MOWIDs.Count > 0 Then
                                Train.DisplayText = Train.IdentifingUnit & " *"
                            Else
                                Train.DisplayText = Train.IdentifingUnit
                            End If
                            If optEnableARRCSpecificOptions Then
                                Train.DisplayText = Train.DisplayText.ToUpper.Trim.Replace("ARR", "").Trim
                            End If
                            If optEnbaleEngineIDTrackLineFormatting Then
                                If Train.Name.Length - 6 > FontLength Then
                                    Train.DisplayText = Mid(Train.DisplayText, 1, FontLength) & ".."
                                End If
                            End If
                            If optEnableARRCSpecificOptions Then
                                If Train.KeyTrain Then
                                    Train.DisplayText = optKeyTrainSymbolPrefix & Train.DisplayText
                                End If
                                If Train.HighWide Then
                                    Train.DisplayText = "+" & Train.DisplayText
                                End If
                                If optHazMatTrainSymbolPrefixDisplay AndAlso Train.HazMat AndAlso Not String.IsNullOrEmpty(optHazMatTrainSymbolPrefix) AndAlso optHazMatTrainSymbolPrefix.Trim <> "" Then
                                    Train.DisplayText = optHazMatTrainSymbolPrefix & Train.DisplayText
                                End If
                                If optHelperTrainSymbolPrefixDisplay AndAlso Train.HelperTrain AndAlso Not String.IsNullOrEmpty(optHelperTrainSymbolPrefix) AndAlso optHelperTrainSymbolPrefix.Trim <> "" Then
                                    Train.DisplayText = optHelperTrainSymbolPrefix & Train.DisplayText
                                End If
                                RefreshTrainDisplay = True
                            End If
                        End If
                    ElseIf Train.DisplayAbbreviation Then
                        If TrainIDs.Count > 1 Or Me.MOWIDs.Count > 0 Then
                            Train.DisplayText = Train.Abbreviation & " *"
                        Else
                            Train.DisplayText = Train.Abbreviation
                        End If
                    Else
                        If TrainIDs.Count > 1 Or Me.MOWIDs.Count > 0 Then
                            If Not Train.DisplayPseudoName Then
                                If Train.Name.Length > FontLength Then
                                    Train.DisplayText = Mid(Train.Name, 1, FontLength) & "..*"
                                Else
                                    Train.DisplayText = Train.Name & " *"
                                End If
                            Else
                                If Train.PseudoName = "" Then
                                    Train.PseudoName = Train.Name
                                End If

                                If Train.PseudoName.Length > FontLength Then
                                    Train.DisplayText = Mid(Train.PseudoName, 1, FontLength) & "..*"
                                Else
                                    Train.DisplayText = Train.PseudoName & " *"
                                End If
                            End If
                        Else
                            If Not Train.DisplayPseudoName Then
                                If Train.Name.Length > FontLength Then
                                    Train.DisplayText = Mid(Train.Name, 1, FontLength) & ".."
                                Else
                                    Train.DisplayText = Train.Name
                                End If
                            Else
                                If Train.PseudoName = "" Then
                                    Train.PseudoName = Train.Name
                                ElseIf Train.PseudoName = optTrainString19 Then
                                    If Trim(Train.IdentifingUnit) = "" Then
                                        Train.PseudoName = optTrainString20
                                    Else
                                        Train.PseudoName = Trim(Train.IdentifingUnit) & " " & Mid(Train.Direction, 1, 1)
                                    End If

                                End If
                                If Train.PseudoName.Length >= FontLength Then
                                    Train.DisplayText = Mid(Train.PseudoName, 1, FontLength) & ".."
                                Else
                                    Train.DisplayText = Train.PseudoName
                                End If
                            End If

                        End If

                        If Train.AutomaticModeOn Then
                            Train.DisplayText = "^" & Train.DisplayText
                        ElseIf optShowHighWideKeyTrainSymbolTogether Then
