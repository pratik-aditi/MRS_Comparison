                If Not IsNothing(LeftSig) Then
                    If LeftSig.SignalStatus = Signal.BulbStatus.ClearStatus Or LeftSig.SignalStatus = Signal.BulbStatus.RequestingClear Then
                        If LeftSig.HoldingSignal Then
                            LeftSig.SlotToStop()
                            'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                            LeftSig.SignalStatus = Signal.BulbStatus.RequestingStop
                            'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                            LeftSig.SlottedByOSTrack = True
                            LeftSig.UpdateStatus()
                            LeftSig.InvalidateSignal()
                            If optEnableMRSSpecificPTCOperations Then
                                Me.PerformLicenseUpdateForMRS(LeftSig)
                            End If

                        End If
                    End If
                End If

                If Not IsNothing(RightSigBehind) Then
                    If RightSigBehind.SignalStatus = Signal.BulbStatus.ClearStatus Or RightSigBehind.SignalStatus = Signal.BulbStatus.RequestingClear Then
                        If RightSigBehind.HoldingSignal Then
                            RightSigBehind.SlotToStop()
                            'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                            RightSigBehind.SignalStatus = Signal.BulbStatus.RequestingStop
                            'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                            RightSigBehind.SlottedByOSTrack = True
                            RightSigBehind.UpdateStatus()
                            RightSigBehind.InvalidateSignal()
                            If optEnableMRSSpecificPTCOperations Then
                                Me.PerformLicenseUpdateForMRS(RightSigBehind)
                            End If

                        End If
                    End If
                End If

                If Not IsNothing(LeftSigBehind) Then
                    If LeftSigBehind.SignalStatus = Signal.BulbStatus.ClearStatus Or LeftSigBehind.SignalStatus = Signal.BulbStatus.RequestingClear Then
                        If LeftSigBehind.HoldingSignal Then
                            LeftSigBehind.SlotToStop()
                            'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                            LeftSigBehind.SignalStatus = Signal.BulbStatus.RequestingStop
                            'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                            LeftSigBehind.SlottedByOSTrack = True
                            LeftSigBehind.UpdateStatus()
                            LeftSigBehind.InvalidateSignal()
                            If optEnableMRSSpecificPTCOperations Then
                                Me.PerformLicenseUpdateForMRS(LeftSigBehind)
                            End If

                        End If
                    End If
                End If

            Catch ex As Exception
