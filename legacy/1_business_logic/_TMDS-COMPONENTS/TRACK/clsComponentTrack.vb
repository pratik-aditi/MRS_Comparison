            End Try
        End Sub

        Private Function CheckForHoldingSignalFleets() As Boolean
            Try
                Dim FleetedSignal As Boolean
                Dim RightSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.RightLink)
                Dim LeftSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.LeftLink)

                If Not IsNothing(RightSig) Then
                    If RightSig.FleetEnabled Then
                        FleetedSignal = True
                        If Not RightSig.ControlSignalToClear(True, True, True, False, False) Then
                            RightSig.tmrFleetRetry.Enabled = True
                        End If
                    End If
                End If

                If Not IsNothing(LeftSig) Then
                    If LeftSig.FleetEnabled Then
                        FleetedSignal = True
                        If Not LeftSig.ControlSignalToClear(True, True, True, False, False) Then
                            LeftSig.tmrFleetRetry.Enabled = True
                        End If
                    End If
                End If
                Return FleetedSignal
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Sub SendHoldingSignalRequests()
            Try
                Dim RightSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.RightLink)
                Dim LeftSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.LeftLink)

                If Not IsNothing(RightSig) Then
                    If RightSig.SignalStatus = Signal.BulbStatus.ClearStatus Or RightSig.SignalStatus = Signal.BulbStatus.RequestingClear Then
