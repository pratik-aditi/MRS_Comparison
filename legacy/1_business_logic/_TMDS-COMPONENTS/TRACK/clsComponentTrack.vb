                    '    'End If
                    'ElseIf Not OccupancyDetected AndAlso RtTzn IsNot Nothing AndAlso RtTzn.IsOccupied Then
                    '    'If Not clsTIWSRules.IsOccupancyOutofSequenceBox4(auth, Me) Then
                    '    '    auth.LastTrainZone = RtTzn
                    '    '    If Not auth.MyWorkTrainOccupiedTrackZoneList.Contains(RtTzn) Then auth.MyWorkTrainOccupiedTrackZoneList.Add(RtTzn)
                    '    'End If

                    'Else
                    If Not OccupancyDetected AndAlso (RtTzn IsNot Nothing AndAlso Not RtTzn.IsOccupied) AndAlso (LtTzn IsNot Nothing AndAlso Not LtTzn.IsOccupied) Then
                        auth.LastTrainZone = Nothing
                        If auth.MyWorkTrainOccupiedTrackZoneList IsNot Nothing AndAlso auth.MyWorkTrainOccupiedTrackZoneList.Count > 0 Then
                            auth.LastTrainZone = auth.MyWorkTrainOccupiedTrackZoneList(auth.MyWorkTrainOccupiedTrackZoneList.Count - 1)
                        End If
                    ElseIf Not OccupancyDetected AndAlso (RtTzn IsNot Nothing AndAlso RtTzn.IsOccupied) AndAlso (LtTzn IsNot Nothing AndAlso Not LtTzn.IsOccupied) Then
                        auth.LastTrainZone = Nothing
                        If auth.MyWorkTrainOccupiedTrackZoneList IsNot Nothing AndAlso auth.MyWorkTrainOccupiedTrackZoneList.Count > 0 Then
                            auth.LastTrainZone = auth.MyWorkTrainOccupiedTrackZoneList(auth.MyWorkTrainOccupiedTrackZoneList.Count - 1)
