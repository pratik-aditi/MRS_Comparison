                    miVoid = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuTWCVoid))
                    miVoid.MenuItems.Clear()
                End If

                If Me.Authorities.Count > 0 Then
                    Dim auth As TrackAuthority.Warrant
