        ''' <param name="e"></param>
        Private Sub mnuPosTrainManeuverLoad_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Dim train As New TrainID
            Dim newSymbol As String
            Dim SummItem As SummaryItem = Nothing
            Dim LogThisEvent As DoEventLogTrainID = Nothing
            Dim PublishThisEvent As DoPublishTrainEvent = Nothing
            Try
                Me.TrackEventLog("Clicked - New Manuever Load")
                newSymbol = FindManeuverTrain(True)
                train.Name = newSymbol
                train.IdentifingUnit = newSymbol
                train.Direction = optDirectionNone.Trim.ToUpper
                train.PseudoName = newSymbol & " CARREGADO"
                train.myTrack = Me
                train.TrackGUID = Me.GUID
                train.TrackOccupiedTime = ApplyCurrentTimeZone(Me, Now)
                train.ApplyTrainAbbreviation(gTrainAbbreviation)
                train.InsertNewTrainIDIntoDatabase(Me, gtblTrainsActive)
                Me.AddTrainID(train)
                train.StackOrder = Me.TrainIDs.IndexOf(train)
                If Not (gAssistMode OrElse train.myTrack.IsShadowMode) Then
                    TMDS.NetworkMessages.CadMessages.SendTrainSymbolMove(train, gCadTransmitQueue, Nothing, Me, "D")
                    LogThisEvent = New DoEventLogTrainID(AddressOf train.LogTheTrainIDEvent)
                    LogThisEvent.BeginInvoke(TrainID.EventTypeTrainID.POSITION, Nothing, Nothing)
                    PublishThisEvent = New DoPublishTrainEvent(AddressOf train.PublishTrainEvent)
                    PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.POSITION, False, Nothing, Nothing)
                End If
                train.EnableNotificationFlash(False)
                SummItem = New SummaryItem("TRAIN", "POSITION", train)
                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                End SyncLock
                If Not Me.Indicating Then
                    Me.Occuppied = True
                    Me.UpdateStatus()
                End If
                If Not TrainCollection.Contains(train) Then
                    TrainCollection.Add(train)
                End If
                Me.InitTrainDisplay()
                Me.InvalidateTrainID()
                Me.UpDateTrainIDPosition(train)
            Catch ex As Exception
