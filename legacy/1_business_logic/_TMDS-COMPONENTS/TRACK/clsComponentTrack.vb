        Public Function CollectComponentsOfLikeTracks() As ArrayList
            Dim SearchingForEnd As Boolean = True
            Dim CompList As New ArrayList()
            Dim SearchDirection As Integer
            Dim NextCompToTest As Object = Nothing
            Dim LoopTerminator As Int32

            'CompList.Add(Me)
            Try
                For SearchDirection = 1 To 2
                    If SearchDirection = 1 Then
                        NextCompToTest = FindObjectTypeFromGUID(Me.RightLink)
                    Else
                        NextCompToTest = FindObjectTypeFromGUID(Me.LeftLink)
                    End If
                    While SearchingForEnd

                        If NextCompToTest Is Nothing Then Exit While

                        If NextCompToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If Not CompList.Contains(NextCompToTest) Then
                                CompList.Add(NextCompToTest)
                            End If
                            Exit While
                        ElseIf NextCompToTest.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If NextCompToTest.Name = Me.Name And NextCompToTest.StationNumber = Me.StationNumber Then
                                If Not CompList.Contains(NextCompToTest) Then
                                    CompList.Add(NextCompToTest)
                                End If
                                If SearchDirection = 1 Then
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.RightLink)
                                Else
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.LeftLink)
                                End If
                                If NextCompToTest.GUID = 0 Then Exit While
                            Else
                                Exit While
                            End If
                        Else
                            If SearchDirection = 1 Then
                                NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.RightLink)
                            Else
                                NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.LeftLink)
                            End If
                            If NextCompToTest Is Nothing Then Exit While
                            If NextCompToTest.GUID = 0 Then Exit While
                        End If
                        LoopTerminator = LoopTerminator + 1
                        If LoopTerminator > 100 Then
                            Return Nothing
                        End If
                    End While
                Next SearchDirection

                Dim NumOfCompInList As Integer = CompList.Count - 1
                Dim CurrentComp As Object
                Dim LoopControl As Integer

                Dim I As Integer
                For I = 0 To NumOfCompInList
                    CurrentComp = CompList(I)
                    If CurrentComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        Dim CurrentSwitch As Switch = CurrentComp
                        Dim CompInTurnOut As Object = Nothing
                        Dim ExpandingTurnOutSearchComplete As Boolean
                        Dim RouteInSwitch As Integer
                        Dim CompName As String = String.Empty

                        For RouteInSwitch = 1 To 3
                            If CurrentSwitch.LeftAltLink <> 0 Then
                                If RouteInSwitch = 1 Then
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.LeftLink)
                                Else
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.LeftAltLink)
                                End If
                            ElseIf CurrentSwitch.RightAltLink <> 0 Then
                                If RouteInSwitch = 1 Then
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.RightLink)
                                Else
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.RightAltLink)
                                End If
                            End If
                            CompName = CompInTurnOut.Name
                            While Not ExpandingTurnOutSearchComplete
                                If (CurrentSwitch.StationNumber = CompInTurnOut.StationNumber) And
                                (CompInTurnOut.Name = CompName) Then
                                    If Not CompList.Contains(CompInTurnOut) Then
                                        CompList.Add(CompInTurnOut)
                                    End If
                                    If CurrentSwitch.LeftAltLink <> 0 Then
                                        CompInTurnOut = FindObjectTypeFromGUID(CompInTurnOut.LeftLink)
                                    ElseIf CurrentSwitch.RightAltLink <> 0 Then
                                        CompInTurnOut = FindObjectTypeFromGUID(CompInTurnOut.RightLink)
                                    End If
                                    If CompInTurnOut.GUID = 0 Then
                                        Exit While
                                    End If
                                Else
                                    Exit While
                                End If
                                LoopControl = LoopControl + 1
                                If LoopControl > 10 Then
                                    Exit While
                                End If
                            End While
                        Next RouteInSwitch
                    End If
                Next I

                CollectComponentsOfLikeTracks = CompList
                CompList = Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function FindComponentType(ByVal UniqueID As Int32) As String
            Try

                'Search through the switches
                Dim sw As Switch
                For Each sw In TMDS.GlobalDeclarations.SwitchCollection
                    If sw.GUID = UniqueID Then
                        Return sw.ComponentType
                    End If
                Next
                'Search through the tracks
                Dim trk As Track
                For Each trk In TMDS.GlobalDeclarations.TrackCollection
                    If trk.GUID = UniqueID Then
                        Return trk.ComponentType
                    End If
                Next

                'Search through the signals
                Dim sg As Signal
                For Each sg In TMDS.GlobalDeclarations.SignalCollection
                    If sg.GUID = UniqueID Then
                        Return sg.ComponentType
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function FindControlPoint(ByVal trk As Track) As ControlPoint

            Try
                For Each cp As ControlPoint In TMDS.GlobalDeclarations.gControlPointCollection
                    If trk.StationNumber = cp.StationNumber Then
                        Return cp
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.Message & " - " & ex.StackTrace())
            End Try

            Return Nothing

        End Function

        Public Function FindControlPointName(ByVal trk As Track) As String
            Try
                Dim cp As ControlPoint
                For Each cp In TMDS.GlobalDeclarations.gControlPointCollection
                    If trk.StationNumber = cp.StationNumber Then
                        Return cp.Name
                    End If
                Next
                Return "NO NAME"
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub GetOsTypeComponents()
            Try
                Me.OsComponentCollection = New ArrayList()
                OsComponentCollection.Add(Me)
                Dim trk As Object
                For Each trk In Me.myControlPoint.AssignedComponenets
                    If IsNothing(Me.Ind(0)) Then
                        Exit For
                    End If
                    If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim tk As Track = CType(trk, Track)
                        If optEnableMRSSpecificPTCOperations Then
                            If (tk.StationNumber = Me.StationNumber AndAlso tk.Name = Me.Name) Then 'AndAlso Me.TrackName = tk.TrackName) Then
                                If tk.TrackZoneIntegrityMonitoringEnabled Then
                                    If tk.OStype Then
                                        tk.OStype = True
                                        If Not OsComponentCollection.Contains(tk) Then
                                            OsComponentCollection.Add(tk)
                                        End If
                                    End If
                                Else
                                    tk.OStype = True
                                    If Not OsComponentCollection.Contains(tk) Then
                                        OsComponentCollection.Add(tk)
                                    End If
                                End If
                            End If

                        ElseIf (trk.StationNumber = Me.StationNumber And trk.Name = Me.Name) Or (trk.StationNumber = Me.StationNumber And trk.ind(0) Is Me.Ind(0) And Not tk.TrackZoneIntegrityMonitoringEnabled) Then
                            If tk.TrackZoneIntegrityMonitoringEnabled Then
                                If tk.OStype Then
                                    trk.OStype = True
                                    If Not OsComponentCollection.Contains(trk) Then
                                        OsComponentCollection.Add(trk)
                                    End If
                                End If
                            Else
                                trk.OStype = True
                                If Not OsComponentCollection.Contains(trk) Then
                                    OsComponentCollection.Add(trk)
                                End If
                            End If
                        End If
                    End If
                Next
                Dim CompToCheck As Object
                Dim SwitchArray As New ArrayList()
                For Each trk In OsComponentCollection
                    CompToCheck = GetSwitchFromCollection(trk.LeftLink)
                    If Not CompToCheck Is Nothing Then
                        If Not SwitchArray.Contains(CompToCheck) Then
                            SwitchArray.Add(CompToCheck)
                        End If
                    End If

                    CompToCheck = GetSwitchFromCollection(trk.RightLink)
                    If Not CompToCheck Is Nothing Then
                        If Not SwitchArray.Contains(CompToCheck) Then
                            SwitchArray.Add(CompToCheck)
                        End If
                    End If
                Next

                Dim sw As Switch
                Dim RCPSFound As Boolean
                For Each sw In SwitchArray
                    If sw.RCPS Then
                        RCPSFound = True
                    End If
                    If Not OsComponentCollection.Contains(sw) Then
                        OsComponentCollection.Add(sw)
                    End If
                Next
                If RCPSFound Then
                    For Each trk In Me.OsComponentCollection
                        If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trkFound As Track = CType(trk, Track)
                            trkFound.OsOverAnRCPS = True
                        End If
                    Next
                End If
                SwitchArray = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub GetOsTypeTWCComponents()
            Try
                If IsNothing(Me.OsComponentCollection) Then
                    Me.OsComponentCollection = New ArrayList()
                End If

                OsComponentCollection.Add(Me)
                Dim trk As Object
                For Each trk In Me.myControlPoint.AssignedComponenets
                    If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If (trk.StationNumber = Me.StationNumber And trk.Name = Me.Name) Then
                            trk.OStype = True
                            If Not OsComponentCollection.Contains(trk) Then
                                OsComponentCollection.Add(trk)
                            End If
                        End If
                    End If
                Next
                Dim CompToCheck As Object
                Dim SwitchArray As New ArrayList()
                For Each trk In OsComponentCollection
                    CompToCheck = GetSwitchFromCollection(trk.LeftLink)
                    If Not CompToCheck Is Nothing Then
                        If Not SwitchArray.Contains(CompToCheck) Then
                            SwitchArray.Add(CompToCheck)
                        End If
                    End If

                    CompToCheck = GetSwitchFromCollection(trk.RightLink)
                    If Not CompToCheck Is Nothing Then
                        If Not SwitchArray.Contains(CompToCheck) Then
                            SwitchArray.Add(CompToCheck)
                        End If
                    End If
                Next

                Dim sw As Switch
                For Each sw In SwitchArray
                    If Not OsComponentCollection.Contains(sw) Then
                        OsComponentCollection.Add(sw)
                    End If
                Next
                For Each trk In Me.OsComponentCollection
                    If IsNothing(trk.OsComponentCollection) Then
                        trk.OsComponentCollection = New ArrayList()
                    End If
                    trk.OsComponentCollection = Me.OsComponentCollection.Clone
                Next


                SwitchArray = Nothing
            Catch ex As Exception
