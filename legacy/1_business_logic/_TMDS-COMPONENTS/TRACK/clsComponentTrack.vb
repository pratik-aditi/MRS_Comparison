        ''' <summary>
        ''' Delete Tag From Database
        ''' </summary>
        ''' <param name="pTagToDelete"></param>
        ''' <returns></returns>
        Public Function DeleteTagFromDatabase(ByVal pTagToDelete As Tag) As Boolean
            Dim q As String = "'"
            Dim s As String = ", "
            Dim tagDeleteSQL As String
            Dim logTheEvent As DoEventLogTag
            Dim publishTheEvent As DoPublishTagEvent
            Dim publishTheCommandEvent As DoPublishTagEvent
            Try
                If optEnableSendTrackTagToBusInfoCommunicationServer And pTagToDelete.TagType = "SPEED" Then
                    TMDS.NetworkMessages.TSSMessage.SendTrackTagChange(pTagToDelete, "DELETE", gBSCSTransmitQueue)
                End If
                pTagToDelete.RemoveTagFromDB()
                tagDeleteSQL = "DELETE FROM " & gtblTagsActive & " WHERE TagUID = '" & pTagToDelete.TagGuid & "'"
                SystemDatabaseCommandToDynamic("TRACK:DeleteTagFromDatabase", tagDeleteSQL)
                logTheEvent = New DoEventLogTag(AddressOf pTagToDelete.LogTheTagEvent)
                logTheEvent.BeginInvoke(TMDS.TrackTagComponents.Tag.EventTypeTag.REMOVE, Nothing, Nothing)
                publishTheEvent = New DoPublishTagEvent(AddressOf pTagToDelete.PublishTagEventUpdate)
                publishTheEvent.BeginInvoke(TMDS.TrackTagComponents.Tag.EventTypeTag.REMOVE, Nothing, Nothing)
                If gAssistMode And Not (gMaintenanceMode OrElse (Me.IsShadowMode AndAlso Not Me.JointControl)) Then
                    publishTheCommandEvent = New DoPublishTagEvent(AddressOf pTagToDelete.PublishTagCommand)
                    publishTheCommandEvent.BeginInvoke(TMDS.TrackTagComponents.Tag.EventTypeTag.REMOVE, Nothing, Nothing)
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                q = Nothing
                s = Nothing
                tagDeleteSQL = Nothing
                logTheEvent = Nothing
                publishTheEvent = Nothing
                publishTheCommandEvent = Nothing
            End Try
        End Function

