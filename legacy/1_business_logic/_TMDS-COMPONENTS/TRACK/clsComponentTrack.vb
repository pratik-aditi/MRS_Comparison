        Private Sub mnuTroubleReportCrossing_Specific(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try
                Dim mi As MenuItem = CType(sender, MenuItem)
                If IsNothing(mi) Then Exit Sub
                TrackEventLog("Clicked - Create Xing Incident Report from CM")

                Dim gc As GradeCrossing
                Dim thisCrossing As GradeCrossing = Nothing

                For Each gc In myGradeCrossings
                    Dim XingString As String = gc.MilePostPrefix & gc.MilePost & gc.MilePostSuffix
                    If optApplyConfigurationForKCT Then
                        XingString = XingString & " | " & gc.StreetName
                    Else
                        XingString = XingString & " - " & gc.StreetName
                    End If

                    If XingString = mi.Text Then
                        thisCrossing = gc
                        Exit For
                    End If
                Next
                If IsNothing(thisCrossing) Then Exit Sub
                If TMDS.SystemForms.MySystemForms.frmTroubleReportEnhanced IsNot Nothing Then
                    TMDS.SystemForms.MySystemForms.frmTroubleReportEnhanced.Dispose()
                    TMDS.SystemForms.MySystemForms.frmTroubleReportEnhanced = Nothing
