        ''' <summary>
        ''' Do start beginning of pass red signal route
        ''' </summary>
        Public Sub DoStartBeginningOfPassRedSignalRoute()
            Try
                gEntryTrack = Me
                gEntExtTrackSelection.Add(gEntryTrack)
                Me.AddOSComponents(gEntExtTrackSelection)
                If Me.AuthorityType = "CTC" Then
                    Me.ExpandOutForComponents(gEntExtTrackSelection)
                Else
                    Me.ExpandOutForTWCComponents(gEntExtTrackSelection)
                End If
                gEntryTrack.SelectionMode = GenericComponent.ModeSelection.SummarySelectionRouting
                gEntryTrack.FlashComponent = True
                gTrackAuthSelectionFlashOn = True
                TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionEntExt.Enabled = True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' DoCreateTrainPassRedSignalRoute
        ''' </summary>
        ''' <param name="pTrain"></param>
        Public Sub DoCreateTrainPassRedSignalRoute(ByVal pTrain As TrainID)
            Try
                TrackEventLog("DoCreateTrainPassRedSignalRoute:Train=" & pTrain.Name)
                Select Case Me.AuthorityType
                    Case "SHELF", "OTHER"
                        Exit Sub
                End Select
                If gEntryTrack Is Nothing Then
                    'this is to not check the first entry track inthe invalidation check for this route
                    If gEntryTrack Is Nothing Then
                        gFirstEntryTrack = Me
                    End If
                    gEntryTrack = Me
                    gEntExtTrackSelection.Add(gEntryTrack)
                    gEntryTrack.SelectionMode = GenericComponent.ModeSelection.SummarySelectionRouting
                    gEntryTrack.FlashComponent = True
                    gTrackAuthSelectionFlashOn = True
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionEntExt.Enabled = True
                ElseIf gExitTrack Is Nothing Then
                    gExitTrack = Me
                ElseIf Not gExitTrack Is Nothing Then
                    gEntryTrack = gExitTrack
                    gExitTrack = Me
                Else
                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                    ClearSystemVariables()
                    Exit Sub
                End If
                If Not gEntryTrack Is Nothing And Not gExitTrack Is Nothing Then
                    TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(System.Windows.Forms.Cursors.WaitCursor)
                    If Not ErrorMessage(TMDS.SystemForms.MySystemForms.frmMainMDI.SearchForRoute(gEntryTrack, gExitTrack, True, pTrain.IdentifingUnit, pTrain.TrainGUID)) Then
                        Exit Sub
                    End If
                    ' ATAG: Check for signal Activity in the same main
                    If Not CheckForAllTracksinSameMainPSS() Then
                        ErrorMessage("SIG")
                        Exit Sub
                    End If
                    ' TODO: A1 Add code to check all signals to right or left of activity just in case manual switch operation is selected
                    If Not ErrorMessage(CheckForTNTandDeviceBlock(pTrain.IdentifingUnit)) Then
                        Exit Sub
                    End If
                    If gEntryTrack Is Nothing Then
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    If Not CheckForSignal() Then
                        TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                        gEntExtTrackSelection.Add(gEntryTrack)
                        gEntryTrack.SelectionMode = GenericComponent.ModeSelection.SummarySelectionRouting
                        SetCursor(curPassRedSignal)
                        gEntryTrack.FlashComponent = True
                        gTrackAuthSelectionFlashOn = True
                        TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionEntExt.Enabled = True
                        Exit Sub
                    Else
                        AdjustSignalSelection()
                    End If
                    If OptEnableEnhancedPSS Then
                        If Not DoEnhancedPSS() Then
                            TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    End If
                    DoTrainPermissionToPassRedSignal(pTrain)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' CheckNumberofSubdivs
        ''' </summary>
        ''' <param name="pCompList"></param>
        ''' <returns></returns>
        Private Function CheckNumberOfSubdivisions(ByVal pCompList As ArrayList) As Boolean
            Dim numSubdivis As Integer = 0
            Dim subdiv As Integer = 0
            Dim trk As Track
            Try
                For Each comp As Object In pCompList
                    If comp.GetType.ToString = gTrackComponentName Then
                        trk = CType(comp, Track)
                        If subdiv <> trk.SubdivisionID Then
                            subdiv = trk.SubdivisionID
                            numSubdivis += 1
                        End If
                    End If
                Next
                If numSubdivis > 1 Then
                    Return True
                End If
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                numSubdivis = Nothing
                subdiv = Nothing
                trk = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Checks whether <paramref name="components"/> contains any track linked to or marked as remote.
        ''' </summary>
        ''' <param name="components">Collection to inspect; non-<see cref="Track"/> items are ignored.</param>
        ''' <returns>
        ''' <see cref="Boolean"/>: <see langword="True"/> indicates at least one <see cref="Track"/> has
        ''' <see cref="Track.IsLinkToRemoteTrack"/> or <see cref="Track.IsRemoteTrack"/> set; <see langword="False"/> indicates
        ''' none were found or an exception occurred.
        ''' </returns>
        Private Function CheckIsRemoteTrack(components As ArrayList) As Boolean
            Try
                For Each oneTrack As Track In components.OfType(Of Track)
                    If oneTrack.IsLinkToRemoteTrack OrElse
                        oneTrack.IsRemoteTrack Then
                        Return True
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False
        End Function

