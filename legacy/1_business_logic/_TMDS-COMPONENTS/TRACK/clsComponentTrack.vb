            LCK
            OSGTM
            OSOCCUPPIED
            OSUNOCCUPIED
        End Enum

        Private Delegate Sub DoEventLogTrack(ByVal EventType As EventTypeTrack, ByVal EventData As String, ByVal Train As TrainID)

        ''' <summary>
        ''' Log Track Event
        ''' </summary>
        ''' <param name="eventType">Event Type</param>
        ''' <param name="eventData">Event Data</param>
        ''' <param name="theTrain">Train</param>
        Public Sub LogTheTrackEvent(eventType As EventTypeTrack, eventData As String, theTrain As TrainID)
            Try
                Dim previousOccuppiedTrack As Track
                Dim curUser As String = $"{TMDS.GlobalDeclarations.gCurrentUser.LastName},{TMDS.GlobalDeclarations.gCurrentUser.FirstName}"
                Dim curWrkstn As Integer = Convert.ToInt32(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                Dim curTerr As Territory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(TerritoryID)
                Dim logString As String = "INSERT INTO tblSystemEvents "
                Dim sqlFields As String = "([EventTime], [Territory], [Wrkstn], [SysUser], [DbVer], [FuncType], [UID], [Event], [SysData])"
                Dim sqlValues As String = String.Empty
                Dim c As String = ", "
                Dim q As String = "'"
                Dim cpName As String = String.Empty
                Dim otherTypeEvent As String = eventType.ToString.ToUpper
                Dim eventTypeString As String = String.Empty
                Select Case otherTypeEvent
                    Case "OSOCCUPPIED", "OSUNOCCUPIED"
                        sqlValues = $" VALUES ({q}{Now.ToString("yyyy-MM-dd HH:mm:ss.fff")}{q}{c}{TerritoryID}{c}{curWrkstn}{c}{q}{curUser}{q}{c}"
                        Dim myGUID As String = myControlPoint.GUID.ToString
                        Dim myDBVer As String
                        If curTerr IsNot Nothing Then
                            myDBVer = curTerr.Dbversion
                        Else
                            myDBVer = "UNKNOWN"
                        End If
                        sqlValues = $"{sqlValues}{q}{myDBVer}{q}{c}{q}TRACK{q}{c}{q}{GUID}{q}{c}"
                        If myControlPoint IsNot Nothing Then
                            cpName = myControlPoint.Name
                        Else
                            cpName = "REMOTE TRACK - NO CP NAME ASSIGNED"
                        End If
                    Case "OSGTM"
                        Dim OSEvtTime As Date = Now
                        If optEnableARRCSpecificOptions Then
                            If mySubdivision IsNot Nothing Then
                                OSEvtTime = GenerateTime(mySubdivision)
                            End If
                            sqlValues = $" VALUES ({q}{OSEvtTime}{q}{c}{TerritoryID}{c}{curWrkstn}{c}{q}{curUser}{q}{c}"
                        Else
                            sqlValues = $" VALUES ({q}{Now.ToString("yyyy-MM-dd HH:mm:ss.fff")}{q}{c}{TerritoryID}{c}{curWrkstn}{c}{q}{curUser}{q}{c}"
                        End If
                        Dim myGUID As String = myControlPoint.GUID.ToString
                        Dim myDBVer As String
                        If Not curTerr Is Nothing Then
                            myDBVer = curTerr.Dbversion
                        Else
                            myDBVer = "UNKNOWN"
                        End If
                        sqlValues = $"{sqlValues}{q}{myDBVer}{q}{c}{q}GTM-EVENT{q}{c}{q}{myGUID}{q}{c}"
                        If Not myControlPoint Is Nothing Then
                            cpName = myControlPoint.Name
                        Else
                            cpName = "REMOTE TRACK - NO CP NAME ASSIGNED"
                        End If
                    Case Else
                        sqlValues = $" VALUES ({q}{Now.ToString("yyyy-MM-dd HH:mm:ss.fff")}{q}{c}{TerritoryID}{c}{curWrkstn}{c}{q}{curUser}{q}{c}"
                        Dim myGUID As String
                        If IsRemoteTrack Then
                            myGUID = myRemoteTrack.thisTrack.GUID.ToString()
                        Else
                            myGUID = GUID.ToString
                        End If
                        Dim myDBVer As String
                        If Not curTerr Is Nothing Then
                            myDBVer = curTerr.Dbversion
                        Else
                            myDBVer = "UNKNOWN"
                        End If
                        sqlValues = $"{sqlValues}{q}{myDBVer}{q}{c}{q}TRACK{q}{c}{q}{myGUID}{q}{c}"
                        If Not myControlPoint Is Nothing Then
                            cpName = myControlPoint.Name
                        Else
                            cpName = "REMOTE TRACK - NO CP NAME ASSIGNED"
                        End If
                End Select
                Select Case eventType
                    Case EventTypeTrack.CTL
                    Case EventTypeTrack.IND
                        If Occuppied Then
                            sqlValues = $"{sqlValues}{q}OCCUPPIED{q}{c}{q}{cpName}:{Name}:"
                            eventTypeString = "OCCUPPIED"
                        Else
                            sqlValues = $"{sqlValues}{q}UNOCCUPPIED{q}{c}{q}{cpName}:{Name}:"
                            eventTypeString = "UNOCCUPPIED"
                        End If
                        'Add symbol in event
                        If theTrain IsNot Nothing Then
                            sqlValues = $"{sqlValues}{theTrain.Name}:"
                        ElseIf Not Occuppied AndAlso previousTrainID IsNot Nothing Then 'Get train name from previus train for unoccuppied
                            sqlValues = $"{sqlValues}{previousTrainID.Name}:"
                            'Logs for track alarms
                        ElseIf Occuppied AndAlso theTrain Is Nothing Then
                            Try
                                previousOccuppiedTrack = TMDS.SystemUtilities.FetchData.FindPreviousTrackOtherThenMe(FindTrackFromGUID(GUID), pTrafficDirection)
                                If previousOccuppiedTrack IsNot Nothing AndAlso previousOccuppiedTrack.TrainIDText IsNot Nothing Then
                                    SystemEvent($"LogTheTrackEvent:previousOccuppiedTrack={previousOccuppiedTrack.TrainIDText.FullTrainName}")
                                End If
                            Catch ex As Exception
                                SystemException(ex.ToString)
                            End Try
                        Else
                            sqlValues = $"{sqlValues}:"
                        End If
                        'Add gauge type in event
                        If theTrain IsNot Nothing Then
                            Select Case theTrain.SubType
                                Case "LARGA"
                                    sqlValues = $"{sqlValues}L:"
                                Case "MÉTRICA"
                                    sqlValues = $"{sqlValues}E:"
                                Case "MISTA"
                                    sqlValues = $"{sqlValues}M:"
                                Case Else
                                    sqlValues = $"{sqlValues}L:"
                            End Select
                        ElseIf Not Occuppied AndAlso previousTrainID IsNot Nothing Then 'Get gauge from previus train for unoccuppied
                            Select Case previousTrainID.SubType
                                Case "LARGA"
                                    sqlValues = $"{sqlValues}L:"
                                Case "MÉTRICA"
                                    sqlValues = $"{sqlValues}E:"
                                Case "MISTA"
                                    sqlValues = $"{sqlValues}M:"
                                Case Else
                                    sqlValues = $"{sqlValues}L:"
                            End Select
                        Else
                            'Ckeck if track has mixed gauge, If so, the field should be empty
                            If LineSegmentGroupName.Split(";").Last.Contains("M") Then
                                sqlValues = $"{sqlValues}:"
                            Else
                                sqlValues = $"{sqlValues}L:"
                            End If
                        End If
                        'Add switch position for OS type
                        If OStype Then
                            For Each comp As Object In OsComponentCollection
                                If comp.GetType.ToString = gSwitchComponentName Then
                                    Dim sw As Switch = CType(comp, Switch)
                                    If sw.SwitchIndStatus = Switch.SwIndStatus.NormalInd Then
                                        sqlValues = $"{sqlValues}N"
                                        Exit For
                                    ElseIf sw.SwitchIndStatus = Switch.SwIndStatus.ReverseInd Then
                                        sqlValues = $"{sqlValues}R"
                                        Exit For
                                    Else
                                        sqlValues = $"{sqlValues}NI"
                                        Exit For
                                    End If
                                End If
                            Next
                        Else
                            sqlValues = $"{sqlValues}NA"
                        End If
                        'Need to identify the firt ocuppation after restart the system
                        If Occuppied AndAlso
                            gThisWorkstation IsNot Nothing AndAlso
                            Ind IsNot Nothing AndAlso
                            Ind(0).countOccupation = 1 Then
                            sqlValues = $"{sqlValues}:START"
                        End If
                        sqlValues = $"{sqlValues}{q})"
                    Case EventTypeTrack.LCK
                    Case EventTypeTrack.BLK
                        If BlockAbsolute Then
                            sqlValues = $"{sqlValues}{q}TRACK-BLOCKED{q}{c}{q}{cpName}:{Name}{q}"
                            eventTypeString = "TRACK-BLOCKED"
                        Else
                            sqlValues = $"{sqlValues}{q}TRACK-UNBLOCKED{q}{c}{q}{cpName}:{Name}{q}"
                            eventTypeString = "TRACK-UNBLOCKED"
                        End If
                        sqlValues = $"{sqlValues})"
                    Case EventTypeTrack.OSGTM
                        Dim trainSymbol As String = "UNKNOWN"
                        Dim tons As String = "000000"
                        Dim len As String = "000000"
                        Dim LDS As String = "000000"
                        Dim EMT As String = "000000"
                        Dim GTM As Integer
                        Dim trainData As String = String.Empty
                        Dim dblGTM As Double = 0.0
                        If TrainIDs.Count > 0 Then
                            Dim train As TrainID = TrainIDs.Item(0)
                            If Not IsNothing(train) Then
                                trainSymbol = train.Name
                                tons = train.OTons.ToString.PadLeft(6, "0")
                                len = train.OLength.ToString.PadLeft(6, "0")
                                LDS = train.OLoads.ToString.PadLeft(6, "0")
                                EMT = train.OEmts.ToString.PadLeft(6, "0")
                                tons = train.OTons.ToString.PadLeft(6, "0")
                                If TrackLength = 0 Then
                                    CalculateFeetInTrack()
                                End If
                                If TrackLength <> 0 And Convert.ToInt32(tons) <> 0 Then
                                    If optEnableGTMToBeDouble Then
                                        Try
                                            dblGTM = Convert.ToInt32(tons) * TrackLength / 5280
                                        Catch ex As Exception
                                            GetErrorDetails(ex, $"optEnableGTMToBeDouble::: TONS: {tons}  TrackLength:{TrackLength}")
                                        End Try
                                    Else
                                        Try
                                            GTM = Convert.ToInt32(tons) * TrackLength / 5280
                                        Catch ex As Exception
                                            GetErrorDetails(ex, $"::: TONS: {tons}  TrackLength:{TrackLength}")
                                        End Try
                                    End If
                                End If
                                If optEnableGTMToBeDouble Then
                                    trainData = $"{train.HomeRoadCode}:{train.Direction}:{train.Name}:{len}:{LDS}:{EMT}:{tons}:{cpName}:{Name}:{dblGTM.ToString("0.00")}"
                                Else
                                    trainData = $"{train.HomeRoadCode}:{train.Direction}:{train.Name}:{len}:{LDS}:{EMT}:{tons}:{cpName}:{Name}:{GTM.ToString}"
                                End If
                                trainData = $"{trainData}:{GetSwitchNames(train.myTrack)}"
                            End If
                        End If
                        sqlValues = $"{sqlValues}{q}{trainSymbol}{q}{c}{q}{trainData}{q}"
                        sqlValues = $"{sqlValues})"
                        eventTypeString = "OSGTM"
                    Case EventTypeTrack.OSOCCUPPIED, EventTypeTrack.OSUNOCCUPIED
                        sqlValues = $"{sqlValues}{q}{otherTypeEvent}{q}{c}{q}{eventData}{q}"
                        sqlValues = $"{sqlValues})"
                        eventTypeString = otherTypeEvent
                End Select
                TMDS.NetworkMessages.CadMessages.SendTrackEventToWabtecOne(Me, eventTypeString)
                SyncLock gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(logString & sqlFields & sqlValues)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub LogTheGTMEventManually(ByVal EventType As EventTypeTrack, ByVal EventData As String, ByVal trn As TrainID)
            Try
                Dim CurUser As String = TMDS.GlobalDeclarations.gCurrentUser.LastName & "," & TMDS.GlobalDeclarations.gCurrentUser.FirstName
                Dim CurWrkstn As Integer = CInt(TMDS.GlobalDeclarations.gThisWorkstation.WrkStnNumber)
                Dim CurTerr As Territory = TMDS.SystemUtilities.FetchData.FindTerritoryFromID(Me.TerritoryID)
                Dim LogString As String = "INSERT INTO tblSystemEvents "
                'Dim SqlFields As String = "(EventTime, Territory, Wrkstn, SysUser, DbVer, FuncType, UID, Event, SysData)"
                Dim SqlFields As String = "([EventTime], [Territory], [Wrkstn], [SysUser], [DbVer], [FuncType], [UID], [Event], [SysData])"
                Dim SqlValues As String = String.Empty
                Dim c As String = ", "
                Dim q As String = "'"
                Dim CPNAME As String = String.Empty
                Dim OtherTypeEvent As String = EventType.ToString.ToUpper

                If IsNothing(trn) Then Exit Sub
                Select Case OtherTypeEvent
                    Case "OSGTM"
                        Dim OSEvtTime As Date = Now
                        If optEnableARRCSpecificOptions Then
                            If trn IsNot Nothing AndAlso trn.myTrack IsNot Nothing AndAlso trn.myTrack.mySubdivision IsNot Nothing Then
                                OSEvtTime = GenerateTime(trn.myTrack.mySubdivision)
                            End If
                            SqlValues = " VALUES (" & q & OSEvtTime & q & c & Me.TerritoryID & c & CurWrkstn & c & q & CurUser & q & c
                        Else
                            SqlValues = " VALUES (" & q & Now.ToString("yyyy-MM-dd HH:mm:ss.fff") & q & c & Me.TerritoryID & c & CurWrkstn & c & q & CurUser & q & c
                        End If

                        Dim myGUID As String = Me.myControlPoint.GUID.ToString

                        Dim myDBVer As String
                        If Not CurTerr Is Nothing Then
                            myDBVer = CurTerr.Dbversion
                        Else
                            myDBVer = "UNKNOWN"
                        End If
                        SqlValues = SqlValues & q & myDBVer & q & c & q & "GTM-EVENT" & q & c & q & myGUID & q & c

                        If Not Me.myControlPoint Is Nothing Then
                            CPNAME = Me.myControlPoint.Name
                        Else
                            CPNAME = "REMOTE TRACK - NO CP NAME ASSIGNED"
                        End If
                End Select

                Select Case EventType
                    Case EventTypeTrack.OSGTM
                        Dim TrainSymbol As String = "UNKNOWN"
                        Dim Tons As String = "000000"
                        Dim Len As String = "000000"
                        Dim LDS As String = "000000"
                        Dim EMT As String = "000000"
                        Dim GTM As Int32
                        Dim dblGTM As Double = 0.0
                        Dim TrainData As String = String.Empty
                        TrainSymbol = trn.Name
                        Tons = trn.OTons.ToString.PadLeft(6, "0")
                        Len = trn.OLength.ToString.PadLeft(6, "0")
                        LDS = trn.OLoads.ToString.PadLeft(6, "0")
                        EMT = trn.OEmts.ToString.PadLeft(6, "0")
                        Tons = trn.OTons.ToString.PadLeft(6, "0")
                        If TrackLength = 0 Then
                            CalculateFeetInTrack()
                        End If
                        'If TrackLength <> 0 And CInt(Tons) <> 0 Then
                        '    GTM = CInt(Tons) * TrackLength / 5280
                        'End If
                        'TrainData = trn.HomeRoadCode & ":" & trn.Direction & ":" & trn.Name & ":" & Len & ":" & LDS & ":" & EMT & ":" & Tons & ":" & CPNAME & ":" & Me.Name & ":" & GTM.ToString

                        If TrackLength <> 0 And CInt(Tons) <> 0 Then
                            If optEnableGTMToBeDouble Then
                                Try
                                    dblGTM = CInt(Tons) * TrackLength / 5280
                                Catch ex As Exception
                                    GetErrorDetails(ex)
                                End Try
                            Else
                                Try
                                    GTM = CInt(Tons) * TrackLength / 5280
                                Catch ex As Exception
                                    SystemException(ex.ToString)
                                End Try

                            End If
                        End If
                        If optEnableGTMToBeDouble Then
                            TrainData = trn.HomeRoadCode & ":" & trn.Direction & ":" & trn.Name & ":" & Len & ":" & LDS & ":" & EMT & ":" & Tons & ":" & CPNAME & ":" & Me.Name & ":" & dblGTM.ToString("0.00")
                        Else
                            TrainData = trn.HomeRoadCode & ":" & trn.Direction & ":" & trn.Name & ":" & Len & ":" & LDS & ":" & EMT & ":" & Tons & ":" & CPNAME & ":" & Me.Name & ":" & GTM.ToString
                        End If
                        TrainData = TrainData & ":" & GetSwitchNames(trn.myTrack)


                        SqlValues = SqlValues & q & TrainSymbol & q & c & q & TrainData & q
                        SqlValues = SqlValues & ")"
                End Select
                SyncLock gSystemEventLogQueue
                    TMDS.GlobalDeclarations.gSystemEventLogQueue.Enqueue(LogString & SqlFields & SqlValues)
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CalculateFeetInTrack()
            Try
                Dim Mileage As Double
                If Me.TrackLength = 0 Then
                    If Not Me.OStype Then
                        If Me.LeftLimitMilePost > Me.RightLimitMilePost Then
                            Mileage = Me.LeftLimitMilePost - Me.RightLimitMilePost
                        Else
                            Mileage = Me.RightLimitMilePost - Me.LeftLimitMilePost
                        End If
                    Else
                        TrackLength = 1500
                    End If

                    If Mileage <> 0 Then
                        Me.TrackLength = CInt(Mileage * 5280)
                    End If

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function GetSwitchNames(osTrack As Track) As String
            Dim Sw As Switch = Nothing
            Dim Comp As Object = Nothing
            Dim Swlist As New ArrayList
            Dim SwName As New StringBuilder
            Dim S As String = ""
            Try
                If osTrack Is Nothing Then Return String.Empty
                If osTrack.OsComponentCollection Is Nothing Then Return String.Empty
                If osTrack.OsComponentCollection.Count = 0 Then Return String.Empty
                For Each Comp In osTrack.OsComponentCollection
                    If Comp IsNot Nothing AndAlso Comp.GetType.ToString = gSwitchComponentName Then
                        Sw = Nothing
                        Sw = TryCast(Comp, Switch)
                        If Sw IsNot Nothing AndAlso Sw.Occuppied AndAlso Not Sw.NonTransverable Then
                            If Not Swlist.Contains(Sw.Name) Then Swlist.Add(Sw.Name)
                        End If

                    End If
                Next
                If Swlist IsNot Nothing AndAlso Swlist.Count > 0 Then
                    For Each S In Swlist
                        If S.Trim <> "" Then SwName.Append(S.Trim & "~")
                    Next
                    Return SwName.ToString
                End If

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
            Return String.Empty
        End Function

