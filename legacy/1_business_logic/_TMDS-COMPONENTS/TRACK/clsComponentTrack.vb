        Public Sub DoTrackWarrant(ByVal e As MouseEventArgs)
            Try
                If Me.PTCAuthorityPending Then
                    ClearSystemVariables()
                    Exit Sub
                End If
                If gOptDisableTrackSelectionOnTurnOut AndAlso Me.TurnOutType Then Exit Sub
                If (Mid(Me.AuthorityType, 1, 3) <> "TWC" AndAlso Me.AuthorityType <> "YL") AndAlso (optAllowNonTWCSelection AndAlso Me.AuthorityType <> "NON-TWC") Then
                    ClearSystemVariables()
                    Exit Sub
                End If

                If gBeginTrackSelect Is Nothing Then
                    gBeginTrackSelect = Me
                    If Not optAllowNonTWC Then
                        If Mid(gBeginTrackSelect.AuthorityType, 1, 3) <> "TWC" Then
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    End If

                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionAdd(gBeginTrackSelect)
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionTWC.Enabled = True
                    Me.ExtendOSComponents(gTrackSelectionCollection)
                    If optEnableExpandOutForTWCComponents Then
                        ExpandOutForTWCComponents(gTrackSelectionCollection)
                    End If
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()

                    gFirstTrackSelectionMousePoint = e.X
                    Me.TrackEventLog("SELECTED BEGINNING TRACK(WARRANT):" & Me.GUID.ToString)
                ElseIf gBeginTrackSelect Is Me Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionClear()
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionTWC.Enabled = True
                    gTrackSelectionCollection.Clear()
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionAdd(gBeginTrackSelect)
                    'Me.AddOSComponents(gTrackSelectionCollection)
                    Me.ExtendOSComponents(gTrackSelectionCollection)
                    If optEnableExpandOutForTWCComponents Then
                        ExpandOutForTWCComponents(gTrackSelectionCollection)
                    End If

                    If Mid(gBeginTrackSelect.AuthorityType, 1, 3) <> "TWC" Then
                        ClearSystemVariables()
                        MessageBox.Show(Me, "Route Selected Is Not Track Warrant Controlled", "System Message", MessageBoxButtons.OK, MessageBoxIcon.Information)
                        Exit Sub
                    End If

                    gEndTrackSelect = Me
                    If gFirstTrackSelectionMousePoint > e.X Then
                        gSearchDirection = "LEFT"
                    ElseIf gFirstTrackSelectionMousePoint < e.X Then
                        gSearchDirection = "RIGHT"
                    Else
                        gSearchDirection = ""
                    End If
                    If gSwitchPointMonitoringExists Then
                        Me.AddTouchingSwitchPointMonitorSwitches(gTrackSelectionCollection)
                    End If
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()


                    Me.TrackEventLog("SELECTED ENDING TRACK(WARRANT):" & Me.GUID.ToString)
                    SystemForms.MySystemForms.frmMainMDI.ShowLimits()
                    If gLaunchCreateItemTwoToTrain Then
                        If TMDS.SystemUtilities.Utilities.TrackWarrantItemTwoStartValidation Then
                            ClearCurrentAuthorityListSelection()
                            CreateTrackWarrant("ItemTwoToTrain")
                        Else
                            ClearSystemVariables()
                            Exit Sub
                        End If

                    ElseIf gLaunchCreateItemFourToSameTrain Then
                        If TMDS.SystemUtilities.Utilities.TrackWarrantItemFourStartValidation Then
                            ClearCurrentAuthorityListSelection()
                            CreateTrackWarrant("ItemFourToTrain")
                        Else
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    End If

                Else
                    If optDisallowNonTWCTracksInMiddleOfSelection Then
                        If Not IsNothing(gEndTrackSelect) Then
                            If Mid(gEndTrackSelect.AuthorityType, 1, 3) <> "TWC" Then
                                'gTrackSelectionCollection.Clear()
                                Me.TrackEventLog("SELECTED ENDING TRACK(WARRANT) FAILED:" & Me.GUID.ToString)
                                ClearSystemVariables()
                                Exit Sub
                            End If
                        End If
                    End If

                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionClear()
                    'gTrackSelectionCollection.Clear()
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionTWC.Enabled = True

                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionAdd(gBeginTrackSelect)

                    gBeginTrackSelect.ExtendOSComponents(gTrackSelectionCollection)

                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()

                    gEndTrackSelect = Me

                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()
                    If Not TMDS.SystemForms.MySystemForms.frmMainMDI.SearchForEndOfTWCtrack() Then
                        gTrackSelectionCollection.Clear()
                        Me.TrackEventLog("SELECTED ENDING TRACK(WARRANT) FAILED:" & Me.GUID.ToString)
                    Else
                        'If optEnableKCSSpecificOptions Then CheckForNonTWCComponents()
                        'Me.AddOSComponents(gTrackSelectionCollection)
                        Me.ExtendOSComponents(gTrackSelectionCollection)
                        If gSwitchPointMonitoringExists Then
                            Me.AddTouchingSwitchPointMonitorSwitches(gTrackSelectionCollection)
                        End If
                        TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()

                        Me.TrackEventLog("SELECTED ENDING TRACK(WARRANT):" & Me.GUID.ToString)
                        If gLaunchCreateItemTwoToTrain Then
                            If TMDS.SystemUtilities.Utilities.TrackWarrantItemTwoStartValidation Then
                                ClearCurrentAuthorityListSelection()
                                CreateTrackWarrant("ItemTwoToTrain")
                            Else
                                ClearSystemVariables()
                                Exit Sub
                            End If

                        ElseIf gLaunchCreateItemFourToSameTrain Then
                            If TMDS.SystemUtilities.Utilities.TrackWarrantItemFourStartValidation Then
                                ClearCurrentAuthorityListSelection()
                                CreateTrackWarrant("ItemFourToTrain")
                            Else
                                ClearSystemVariables()
                                Exit Sub
                            End If
                        End If

                    End If

                    '********************************************* PTC Pending Check ***********************************
                    Dim comp As Object = Nothing
                    For Each comp In gTrackSelectionCollection
                        If comp.GetType.ToString = gTrackComponentName Then
                            If comp.PTCAuthorityPending Then
                                ClearSystemVariables()
                                Exit Sub
                            End If
                        End If
                    Next
                    '********************************************* PTC Pending Check ***********************************

                End If

                If Not optAllowNonTWCSelection Then
                    Dim comp As Object = Nothing
                    For Each comp In gTrackSelectionCollection
                        If comp.GetType.ToString = gTrackComponentName Then
                            If Not TMDS.SystemUtilities.FetchData.IsMainTypeTrack(comp) Then
                                ClearSystemVariables()
                                Exit Sub
                            End If
                        End If
                    Next
                End If

                If optEnableTerritoryDeskAssignmentMode Then
                    If IsValidJointControlComponents(gTrackSelectionCollection) Then
                        LockJointControlComponent(gTrackSelectionCollection)
                    Else
                        TrackEventLog("Track in Use Exiting:" & Me.GUID.ToString)
                        MessageBox.Show(Me.CurrentDrawingForm, "TRACK IN USE BY OTHER DESK- EXITING!", "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Exit Sub
                    End If
                End If

                TMDS.SystemUtilities.UtilitiesDisplayForm.ResetMenuItems()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoRollUpWarrant(Optional ByVal SFAtype As Boolean = False, Optional ByVal sfa As SFAuthority = Nothing)
            Try
                If Not SFAtype Then
                    If Me.AuthorityCounts > 0 Then
                        Dim warr As New Warrant()
                        warr = Me.Authorities(0)
                        If warr.WarrantType = "ItemTwoToTrain" Or warr.WarrantType = "ItemTwoToMOW" Then
                            If Not warr.RollUpWarrant(Me, gComponentsCollection, TMDS.GlobalDeclarations.gDatabaseConnectionAuthority) Then
                                Dim NextWarrIndex As Integer
                                If Me.AuthorityCounts > 1 Then
                                    Dim nextWarr As Warrant

                                    For NextWarrIndex = 1 To Me.AuthorityCounts - 1
                                        nextWarr = Me.Authorities(NextWarrIndex)
                                        If nextWarr.WarrantType = "ItemTwoToTrain" Or nextWarr.WarrantType = "ItemTwoToMOW" Then
                                            If nextWarr.RollUpOtherWarrant(Me, gComponentsCollection, TMDS.GlobalDeclarations.gDatabaseConnectionAuthority, nextWarr) Then
                                                Exit For
                                            End If
                                        End If
                                    Next
                                End If
                            End If
                            SystemForms.MySystemForms.frmSystemSummary.UpdateTrainSummaries()
                            'optEnableDirectionalRollup
                        ElseIf warr.WarrantType = "ItemFourToTrain" Or warr.WarrantType = "ItemFourToMOW" Then
                            Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(Me.SubdivisionID)
                            Dim TitleOne As String
                            Dim TitleTwo As String
                            Dim ButtonStringOne As String
                            Dim ButtonStringTwo As String

                            If Not IsNothing(subdvn) Then

                                If subdvn.SubDirection Then
                                    TitleOne = optRollUpAuthorityString16
                                    TitleTwo = optRollUpAuthorityString17
                                    ButtonStringOne = "S"
                                    ButtonStringTwo = "N"
                                Else
                                    TitleOne = optRollUpAuthorityString18
                                    TitleTwo = optRollUpAuthorityString19
                                    ButtonStringOne = "W"
                                    ButtonStringTwo = "E"
                                End If


                            Else
                                If optFlipNorthSouthDirection Then
                                    TitleOne = "SELECT 'W/N' TO ROLL UP WEST/NORTH"
                                    TitleTwo = "SELECT 'E/S' TO ROLL UP EAST/SOUTH"
                                    ButtonStringOne = "W/N"
                                    ButtonStringTwo = "E/S"
                                Else
                                    TitleOne = optRollUpAuthority_TitleOne_WS '"SELECT 'W/S' TO ROLL UP WEST/SOUTH"
                                    TitleTwo = optRollUpAuthority_TitleOne_EN ' "SELECT 'E/N' TO ROLL UP EAST/NORTH"
                                    ButtonStringOne = "W/S"
                                    ButtonStringTwo = "E/N"
                                End If

                            End If
                            If warr.WarrantType = "ItemFourToTrain" Or warr.WarrantType = "ItemFourToMOW" Then
                                Dim frmMessageBox As frmMessageBox
                                Dim MessageList As New ArrayList()
                                MessageList.Add(optRollUpAuthorityString20 & " (" & sfa.AuthorityUID & ")")
                                MessageList.Add("")
                                MessageList.Add(TitleOne)
                                MessageList.Add(TitleTwo)
                                MessageList.Add("")
                                frmMessageBox = New frmMessageBox()
                                frmMessageBox.Owner = Me.CurrentDrawingForm
                                Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Width / 2, 150)
                                If optEnableARRCSpecificOptions Then
                                    LaunchPoint = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Left + 100, 500)
                                    ' LaunchPoint = New Point(Me.CurrentDrawingForm.Left + Me.CurrentDrawingForm.Width / 2 - 100, Me.CurrentDrawingForm.Top + 300)
                                End If

                                frmMessageBox.SetMessage(MessageList, optRollUpAuthorityString21, True, LaunchPoint, ButtonStringOne & "|" & ButtonStringTwo)
                                frmMessageBox.ShowDialog()
                                Dim RollUpDirection As String
                                If frmMessageBox.FormFeedBack = 6 Then
                                    Me.TrackEventLog(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO WEST/SOUTH ROLL UP Direction CONFIRMATION ")
                                    RollUpDirection = "RIGHT"
                                Else
                                    Me.TrackEventLog(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO EAST/NORTH ROLL UP Direction CONFIRMATION ")
                                    RollUpDirection = "LEFT"
                                End If
                                frmMessageBox.Dispose()
                                frmMessageBox = Nothing
                                sfa.RollUpWarrant(Me, RollUpDirection)
                            End If
                        End If
                        warr = Nothing
                    End If
                ElseIf sfa IsNot Nothing AndAlso optEnableDirectionalRollup AndAlso (sfa.AuthType1 = "ItemFourToTrain" Or sfa.AuthType1 = "ItemFourToMOW") Then
                    sfa.RollUpWarrant(Me, sfa.Direction)
                Else
                    Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(Me.SubdivisionID)
                    Dim TitleOne As String
                    Dim TitleTwo As String
                    Dim ButtonStringOne As String
                    Dim ButtonStringTwo As String

                    If Not IsNothing(subdvn) Then
                        If subdvn.SubDirection Then
                            TitleOne = optRollUpAuthorityString16
                            TitleTwo = optRollUpAuthorityString17
                            If optFlipNorthSouthDirection Then
                                ButtonStringOne = "N"
                                ButtonStringTwo = "S"
                            Else
                                ButtonStringOne = "S"
                                ButtonStringTwo = "N"
                            End If
                        Else
                            TitleOne = optRollUpAuthorityString18
                            TitleTwo = optRollUpAuthorityString19
                            ButtonStringOne = "W"
                            ButtonStringTwo = "E"

                        End If
                    Else
                        TitleOne = "SELECT 'W/S' TO ROLL UP WEST/SOUTH"
                        TitleTwo = "SELECT 'E/N' TO ROLL UP EAST/NORTH"
                        ButtonStringOne = "W/S"
                        ButtonStringTwo = "E/N"

                    End If
                    If sfa.AuthType1 = "ItemFourToTrain" Or sfa.AuthType1 = "ItemFourToMOW" Then
                        Dim frmMessageBox As frmMessageBox
                        Dim MessageList As New ArrayList()
                        MessageList.Add(optRollUpAuthorityString20 & " (" & sfa.AuthorityUID & ")")
                        MessageList.Add("")
                        MessageList.Add(TitleOne)
                        MessageList.Add(TitleTwo)
                        MessageList.Add("")
                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = Me.CurrentDrawingForm
                        Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Width / 2, 150)
                        LaunchPoint = New Point(Me.CurrentDrawingForm.Left + Me.CurrentDrawingForm.Width / 2 - 100, Me.CurrentDrawingForm.Top + 300)
                        frmMessageBox.SetMessage(MessageList, optRollUpAuthorityString21, True, LaunchPoint, ButtonStringOne & "|" & ButtonStringTwo)
                        frmMessageBox.ShowDialog()
                        Dim RollUpDirection As String
                        If frmMessageBox.FormFeedBack = 6 Then
                            Me.TrackEventLog(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO WEST/SOUTH ROLL UP Direction CONFIRMATION ")
                            RollUpDirection = "RIGHT"
                        Else
                            Me.TrackEventLog(TMDS.GlobalDeclarations.gCurrentUser.Initials & " SELECTED YES TO EAST/NORTH ROLL UP Direction CONFIRMATION ")
                            RollUpDirection = "LEFT"
                        End If
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing
                        sfa.RollUpWarrant(Me, RollUpDirection)
                    Else
                        If optUseSingleFormAuthorityVersionCN OrElse optUseSingleFormAuthorityVersionARRC Then
                            If Me.TrackAuthorities.Count > 1 Then
                                Dim RadioBlockingFound As Boolean
                                Dim a As SFAuthority
                                For Each a In Me.TrackAuthorities
                                    If a.RadioBlockingUsed Then
                                        RadioBlockingFound = True
                                    End If
                                Next
                                If RadioBlockingFound Then
                                    Dim auth As SFAuthority = Me.TrackAuthorities.Item(0)
                                    Dim LastTrack As Track = auth.Components.Item(0)
                                    If auth.AuthorityUID <> sfa.AuthorityUID AndAlso Me.GUID <> LastTrack.GUID Then
                                        Dim frmMessageBox As frmMessageBox
                                        Dim MessageList As New ArrayList()
                                        MessageList.Add("CANNOT ROLL UP AUTHORITIES")
                                        MessageList.Add("OUT OF SEQUENCE IN RADIO BLOCKING.")
                                        MessageList.Add("")
                                        frmMessageBox = New frmMessageBox()
                                        frmMessageBox.Owner = Me.CurrentDrawingForm
                                        Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Width / 2, 150)
                                        frmMessageBox.SetMessage(MessageList, "ROLL UP CHECK", False, LaunchPoint)
                                        frmMessageBox.ShowDialog()
                                        frmMessageBox.Dispose()
                                        frmMessageBox = Nothing
                                        Exit Sub
                                    End If
                                End If
                            End If
                        End If
                        sfa.RollUpWarrant(Me, sfa.Direction)
                    End If
                End If

                ClearSystemVariables()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

