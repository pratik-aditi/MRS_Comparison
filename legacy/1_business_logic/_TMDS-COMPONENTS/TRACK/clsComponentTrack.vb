        ''' <summary>
        ''' Do Train Release
        ''' </summary>
        ''' <param name="train">train assigned with track</param>
        ''' <param name="trainPosition">postion of train within trainids list</param>
        Public Sub DoTrainRelease(train As TrainID, Optional trainPosition As Integer = 0)
            Try
                If train Is Nothing Then
                    TrackEventLog($"{GetCurrentMethod.Name}:Train is nothing")
                    Exit Sub
                End If
                If train.myStoredRoutes.Count > 0 Then
                    TrackEventLog($"{GetCurrentMethod.Name}:Found stored license for train {train.Name}")
                    train.InfoMessage($"{My.Resources.UserMessage2}")
                    Exit Sub
                End If
                If train.thisCurrentLicense IsNot Nothing Then
                    TrackEventLog($"{GetCurrentMethod.Name}:Found normal authority for train {train.Name}")
                    train.InfoMessage($"{My.Resources.UserMessage1} {train.thisCurrentLicense.AuthorityNumber}")
                    Exit Sub
                End If
                If train.thisRestrictiveLicense IsNot Nothing Then
                    TrackEventLog($"{GetCurrentMethod.Name}:Found special authority for train {train.Name}")
                    train.InfoMessage($"{My.Resources.UserMessage1} {train.thisRestrictiveLicense.AuthorityNumber}")
                    Exit Sub
                End If
                If Not train.YesNoMessage($"{optTrainReleasePrompt}?") Then Exit Sub
                TrackEventLog($"{GetCurrentMethod.Name}:Perform release for train {train.Name}")
                Dim summaryItem As New SummaryItem("TRAIN", "RELEASE", train)
                SyncLock gSummaryTrainQueue.SyncRoot
                    gSummaryTrainQueue.Enqueue(summaryItem)
                End SyncLock
                InvalidateTrainID()
                ReleaseTrainID(trainPosition, TrainCollection)
                If Not CheckIfAuthExistsForTrain(train.Name) Then TrainFunction.RemoveLocomotive(train)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                ClearSystemVariables()
            End Try
        End Sub

        Public Sub DoTrainFinal()
            Dim ErrorMessage As New ArrayList
            'Dim LaunchPoint As Point = Nothing
            Try
                If Me.TrainIDs.Count <> 0 Then
                    Dim trn As TrainID
                    trn = Me.TrainIDs(0)
                    'MRS need to lock when train is activated
                    If trn.IsActivePTC Then
                        ErrorMessage = New ArrayList
                        ErrorMessage.Add(optTrainReleaseLicenseExitsPrompt.Trim & Space(1) & trn.Name)
                        ErrorMessage.Add("")
                        ErrorMessage.Add(optTrainReleaseLicenseExitsPromptConfirm)
                        'LaunchPoint = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Left + 100, Me.CurrentDrawingForm.Top + 200)
                        ShowCustomMessageBox(ErrorMessage, optTrainFinalHeader, False, Me.CurrentDrawingForm.myLaunchPoint)
                        Exit Sub
                    End If
                    If optEnableCheckForAuthoritiesBeforeFinalTrain Then
                        Dim AuthorthyExists As Boolean
                        If Mid(Me.AuthorityType, 1, 3) = "TWC" Then
                            If CheckForAuthoritiesBeforeFinal(trn) Then
                                AuthorthyExists = True
                            End If
                        ElseIf Mid(Me.AuthorityType, 1, 3) = "CTC" Then
                            If CheckForAuthoritiesBeforeFinalInCTC(trn) Then
                                AuthorthyExists = True
                            End If
                        End If
                        If AuthorthyExists Then
                            ErrorMessage = New ArrayList
                            ErrorMessage.Add(optTrainReleaseLicenseExitsPrompt.Trim & Space(1) & trn.Name)
                            ErrorMessage.Add("")
                            ErrorMessage.Add(optTrainReleaseLicenseExitsPromptConfirm)
                            'LaunchPoint = New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Left + 100, Me.CurrentDrawingForm.Top + 200)
                            ShowCustomMessageBox(ErrorMessage, optTrainFinalHeader, False, Me.CurrentDrawingForm.myLaunchPoint)
                            Exit Sub
                        End If
                    End If
                    Dim LinkTripTrain As TrainID = Nothing
                    If optEnableTripLinkLegacy Then LinkTripTrain = TMDS.SystemUtilities.TrainFunction.FindLinkTripTrain(trn)
                    Dim frmMessageBox As frmMessageBox
                    Dim MessageList As New ArrayList()
                    MessageList.Add(optTrainFinalPrompt1 & Space(1) & trn.Name & "?")
                    MessageList.Add(optTrainFinalPrompt2)
                    MessageList.Add("")
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = Me.CurrentDrawingForm
                    'Dim myPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Left + 100, Me.CurrentDrawingForm.Top + 200)
                    frmMessageBox.SetMessage(MessageList, optTrainFinalHeader, True, Me.CurrentDrawingForm.myLaunchPoint)
                    frmMessageBox.ShowDialog()
                    If frmMessageBox.FormFeedBack = 6 Then
                        If optApplyTrainSheetConfigurationForARRC AndAlso Not RemoveTGBOOnTrainDelete(trn) Then Exit Sub
                        Me.TrackEventLog("CLICKED -(YES TO DELETE TRAIN ID:" & trn.Name & ")")

                        Dim SummItem As New SummaryItem("TRAIN", "RELEASE", trn)
                        SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                            TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                        End SyncLock
                        Me.InvalidateTrainID()
                        TMDS.SystemUtilities.TrainFunction.RemoveLocomotive(trn)
                        Me.FinalTrainID(trn, TrainCollection)
                    Else
                        Me.TrackEventLog("CLICKED -(NO TO DELETE TRAIN ID:" & trn.Name & ")")
                    End If
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    If Not IsNothing(LinkTripTrain) Then
                        MessageList.Clear()
                        MessageList.Add("TRIP LINKED TRAIN FOUND. (" & LinkTripTrain.Name & " )")
                        MessageList.Add("")
                        MessageList.Add("POSITION IT IN PLACE OF THE FINALED TRAIN?")
                        MessageList.Add("")
                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = Me.CurrentDrawingForm
                        frmMessageBox.SetMessage(MessageList, optTrainFinalHeader, True, Me.CurrentDrawingForm.myLaunchPoint)
                        frmMessageBox.ShowDialog()
                        If frmMessageBox.FormFeedBack = 6 Then
                            Me.MoveTrainIDPlace(LinkTripTrain, LinkTripTrain.myTrack, False, Nothing)
                        End If
                    End If
                    If optEnableSpecificOptionsForFECR Then
                        TMDS.NetworkMessages.CadMessages.SendTrainFinal(trn, gCadTransmitQueue)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                ClearSystemVariables()
                ErrorMessage = New ArrayList
                'LaunchPoint = Nothing
            End Try
        End Sub

