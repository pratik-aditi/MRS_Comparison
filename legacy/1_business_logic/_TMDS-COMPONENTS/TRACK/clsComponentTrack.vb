#Region "DATA CAPTURE FOR TRAIN RUN TIME ANALYSIS"

        Private Sub DoCaptureTrainRuntimeData(trn As TrainID)
            Try


                Dim TrfDir As String
                If trn.Direction = optDirectionNorth Or trn.Direction = optDirectionSouth Then
                    TrfDir = "LEFT"
                Else
                    TrfDir = "RIGHT"
                End If

                Dim SigFound As Boolean = False
                Dim nxtObj As Object = trn.MyLastTrack
                Dim loopcnt As Integer = 0
                Dim pEntrySignal As Signal = Nothing
                Dim pExitSignal As Signal = Nothing

                If TrfDir = "LEFT" Then
                    Do Until SigFound
                        If IsNothing(nxtObj) Then Exit Do
                        If nxtObj.GetType.ToString = gSignalComponentName Then
                            Dim sig As Signal = CType(nxtObj, Signal)
                            If sig.ComponentType = "L" Or sig.ComponentType = "U" Then
                                pEntrySignal = sig
                            ElseIf sig.ComponentType = "R" Or sig.ComponentType = "D" Then
                                pExitSignal = sig
                            End If
                            SigFound = True
                        ElseIf nxtObj.GetType.ToString = gTrackComponentName Then
                            nxtObj = SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.leftlink)
                            If nxtObj.guid = trn.myTrack.GUID Then
                                Exit Do
                            End If
                        ElseIf nxtObj.GetType.ToString = gSwitchComponentName Then
                            Dim sw As Switch = CType(nxtObj, Switch)
                            If sw.ControlledReverse Then
                                If sw.LeftAltLink <> 0 Then
                                    nxtObj = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(sw.LeftAltLink)
                                Else
                                    Exit Do
                                End If
                            Else
                                nxtObj = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.leftlink)
                            End If
                        End If
                        loopcnt = loopcnt + 1
                        If loopcnt > 100 Then
                            Exit Do
                        End If
                    Loop
                ElseIf TrfDir = "RIGHT" Then
                    Do Until SigFound
                        If IsNothing(nxtObj) Then Exit Do
                        If nxtObj.GetType.ToString = gSignalComponentName Then
                            Dim sig As Signal = CType(nxtObj, Signal)
                            If sig.ComponentType = "L" Or sig.ComponentType = "U" Then
                                pExitSignal = sig
                            ElseIf sig.ComponentType = "R" Or sig.ComponentType = "D" Then
                                pEntrySignal = sig
                            End If
                            SigFound = True
                        ElseIf nxtObj.GetType.ToString = gTrackComponentName Then
                            nxtObj = SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.rightlink)
                            If nxtObj.guid = trn.myTrack.GUID Then
                                Exit Do
                            End If
                        ElseIf nxtObj.GetType.ToString = gSwitchComponentName Then
                            Dim sw As Switch = CType(nxtObj, Switch)
                            If sw.ControlledReverse Then
                                If sw.LeftAltLink <> 0 Then
                                    nxtObj = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(sw.RightAltLink)
                                Else
                                    Exit Do
                                End If
                            Else
                                nxtObj = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.rightlink)
                            End If
                        End If
                        loopcnt = loopcnt + 1
                        If loopcnt > 100 Then
                            Exit Do
                        End If
                    Loop
                End If

                Dim pAheadSignal1 As Signal = Nothing
                nxtObj = trn.myTrack
                SigFound = False
                If TrfDir = "LEFT" Then
                    Do Until SigFound
                        If IsNothing(nxtObj) Then Exit Do
                        If nxtObj.GetType.ToString = gSignalComponentName Then
                            Dim sig As Signal = CType(nxtObj, Signal)
                            If sig.ComponentType = "L" Or sig.ComponentType = "U" Then
                                pAheadSignal1 = sig
                                SigFound = True
                            Else
                                nxtObj = SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.leftlink)
                            End If
                        ElseIf nxtObj.GetType.ToString = gTrackComponentName Then
                            nxtObj = SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.leftlink)
                        ElseIf nxtObj.GetType.ToString = gSwitchComponentName Then
                            Dim sw As Switch = CType(nxtObj, Switch)
                            If sw.ControlledReverse Then
                                If sw.LeftAltLink <> 0 Then
                                    nxtObj = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(sw.LeftAltLink)
                                Else
                                    Exit Do
                                End If
                            Else
                                nxtObj = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.leftlink)
                            End If
                        End If
                        loopcnt = loopcnt + 1
                        If loopcnt > 100 Then
                            Exit Do
                        End If
                    Loop
                ElseIf TrfDir = "RIGHT" Then
                    Do Until SigFound
                        If IsNothing(nxtObj) Then Exit Do
                        If nxtObj.GetType.ToString = gSignalComponentName Then
                            Dim sig As Signal = CType(nxtObj, Signal)
                            If sig.ComponentType = "R" Or sig.ComponentType = "D" Then
                                pAheadSignal1 = sig
                                SigFound = True
                            Else
                                nxtObj = SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.rightlink)
                            End If
                        ElseIf nxtObj.GetType.ToString = gTrackComponentName Then
                            nxtObj = SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.rightlink)
                        ElseIf nxtObj.GetType.ToString = gSwitchComponentName Then
                            Dim sw As Switch = CType(nxtObj, Switch)
                            If sw.ControlledReverse Then
                                If sw.LeftAltLink <> 0 Then
                                    nxtObj = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(sw.RightAltLink)
                                Else
                                    Exit Do
                                End If
                            Else
                                nxtObj = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(nxtObj.rightlink)
                            End If
                        End If
                        loopcnt = loopcnt + 1
                        If loopcnt > 100 Then
                            Exit Do
                        End If
                    Loop
                End If

                Dim SignalAData As New StringBuilder
                'Format Data in below Order - Signal Ahead Count|Signal Ahead GUID|Signal Ahead Status
                If Not IsNothing(pAheadSignal1) Then
                    SignalAData.Append(pAheadSignal1.GUID)
                    SignalAData.Append("|")
                    SignalAData.Append(pAheadSignal1.SignalStatus.ToString)
                Else
                    SignalAData.Append("")
                    SignalAData.Append("|")
                    SignalAData.Append("")
                End If

                Dim trnData As New StringBuilder
                'Format Data in below Order - Lead engine|Train Direction|Train Type|Train Speed|Train Total Length|Train HPT
                With trnData
                    .Append(trn.IdentifingUnit)
                    .Append("|")
                    .Append(trn.Direction)
                    .Append("|")
                    .Append(trn.TrainType)
                    .Append("|")
                    .Append(trn.Speed)
                    .Append("|")
                    .Append(trn.TotalLength)
                    .Append("|")
                    .Append(trn.HorsePowerTrailing)
                    .Append("|")
                End With

                Dim RouteGUID As String = String.Empty
                Dim SqlFields As String = "(RecordGUID,TrainGUID,Symbol,TrackGUID,PrevTrackGUID,EventTime,EntrySignal,EntrySignalStatus,ExitSignal,ExitSignalStatus,RouteGUID,TrainData,SignalData)"
                Dim SqlValues As New StringBuilder
                With SqlValues
                    .Append(" ( ")
                    .Append("'" & System.Guid.NewGuid.ToString.ToUpper & "'" & " , ")
                    .Append("'" & trn.ActiveTrainSheetGUID & "'" & " , ")
                    .Append("'" & trn.Name & "'" & " , ")
                    .Append(trn.myTrack.GUID & " , ")
                    .Append(trn.MyLastTrack.GUID & " , ")
                    .Append("'" & Now.ToString & "'" & " , ")

                    If Not IsNothing(pEntrySignal) Then
                        .Append(pEntrySignal.GUID & " , ")
                        .Append("'" & pEntrySignal.SignalStatus.ToString & "'" & " , ")
                    Else
                        .Append("''" & " , ")
                        .Append("''" & " , ")
                    End If
                    If Not IsNothing(pExitSignal) Then
                        .Append(pExitSignal.GUID & " , ")
                        .Append("'" & pExitSignal.SignalStatus.ToString & "'" & " , ")
                    Else
                        .Append("''" & " , ")
                        .Append("''" & " , ")
                    End If

                    .Append("'" & RouteGUID & "'" & " , ")
                    .Append("'" & trnData.ToString & "'" & " , ")
                    .Append("'" & SignalAData.ToString & "'" & "  ")
                    .Append(" ) ")
                End With

                Dim sqlInsert As String = "Insert into tblTrainRunTimesActive " & SqlFields & " values " & SqlValues.ToString
                SystemDatabaseCommandToDynamic("TRACK:TrainRuntime", sqlInsert)
                SystemEvent("trace3 : " & sqlInsert)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

#End Region

#Region "ISSUE AUTHORITY"

        ''' <summary>
        ''' Issue ptc authority
        ''' </summary>
        ''' <returns><see langword="True"/>Authority performed, <see langword="False"/> otherwise.</returns>
        Public Function IssuePtcAuthority() As Boolean
            Try
                If TrainIDs.Count = 0 Then
                    TrackEventLog($"{GetCurrentMethod.Name} Train not found")
                    Return False
                End If
                Dim train As TrainID = TrainIDs.Item(0)
                TrackEventLog($"{GetCurrentMethod.Name} Train={train.Name}")
                If Not train.PtcLicenseValidationForMenus() Then
                    TrackEventLog($"{GetCurrentMethod.Name} Authority not valid")
                    Return False
                End If
                gCreateLicenseTrain = train
                train.UserActionType = UserActionTypeEnum.NormalLicense
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False
        End Function

#End Region

    End Class

#End Region

#Region "CATENARY TRACK"

    Public Class CatenaryTrack
        Inherits UserControl

        Private LockBitPath As GraphicsPath
        Private myColor As Color = Color.Red
        Private myBrush As New SolidBrush(myColor)
        Public myTrack As Track

        Dim rLX As Int32
        Dim rLY As Int32
        Dim rRX As Int32
        Dim rRY As Int32
        Dim LX As Int32
        Dim RX As Int32
        Dim LY As Int32
        Dim RY As Int32
        Public MouseEntered As Boolean
        Public MouseLefted As Boolean
        Public IsEnergized As Boolean
        Dim TrackWidth As Integer = 3

        Sub New(theTrack As Track)
            myTrack = theTrack
            Me.Visible = False
            InitializeGraphicsFromScreenCoordinates()
            InitGraphics()

            AddHandler Me.MouseHover, AddressOf Me.Switch_MouseHover
            AddHandler Me.MouseEnter, AddressOf Me.Switch_MouseEnter
            AddHandler Me.MouseLeave, AddressOf Me.Switch_MouseLeave

            ForeColor = Color.Red
            'BuildLockGraphics()
        End Sub

        Private Sub InitializeGraphicsFromScreenCoordinates()

            LX = myTrack.LX
            RX = myTrack.RX
            LY = myTrack.LY
            RY = myTrack.RY

            'Set the position of the Control Drawing Area
            Me.Left = LX
            If RY <LY Then
                Me.Top= RY + 9
                Me.Left= LX + 5
            ElseIf RY = LY Then
                Me.Top = LY + myTrack.Height + 2
            ElseIf RY > LY Then
                Me.Top = LY + 9
                Me.Left = LX - 5
            End If

            Me.Width = Math.Abs(RX - LX) '-3
            If Me.myTrack.AltLinkFour <> 0 Then
                Me.Width = Me.Width - 8
            ElseIf Me.myTrack.AltLinkThree <> 0 Then
                Me.Left = Me.Left + 4
                Me.Width = Me.Width - 4
            End If
            Me.Height = Math.Abs(RY - LY) + TrackWidth

            'CHECK TO SEE IF THIS IS A VERTICAL TRACK
            If Me.Width = 0 Then
                Me.Width = TrackWidth
            End If


            'Set the Relative coordinates in the control from the screen coords
            rLX = 0
            If RY < LY Then
                rLY = Math.Abs(LY - RY)
            Else
                rLY = 0
            End If

            rRX = Math.Abs(RX - LX)
            If RY < LY Then
                rRY = 0
            Else
                rRY = Math.Abs(RY - LY)
            End If

        End Sub

        Private Sub InitGraphics()
            Try
                Dim pt1 As Point
                Dim pt2 As Point
                Dim pt3 As Point
                Dim pt4 As Point

                LockBitPath = New GraphicsPath()
                If myTrack.LY = myTrack.RY Then
                    'If myTrack.IsLinkedToSwitchLeft Then
                    '    If myTrack.SwitchLeft.mySwitchLock.Position = "RD" And myTrack.isLinkedToSwitchRight Then
                    '        Me.Left = Me.Left + 12
                    '    End If
                    'End If

                    'If myTrack.isLinkedToSwitchRight Then
                    '    If myTrack.SwitchRight.mySwitchLock.Position = "LD" Then
                    '        Me.Width = Me.Width '- 15
                    '    ElseIf myTrack.SwitchRight.mySwitchLock.Position = "RU" Then
                    '        Me.Width = Me.Width + 3
                    '    End If
                    'End If
                    LockBitPath.AddLine(New Point(0, 0), New Point(Me.Width, 0))
                    LockBitPath.AddLine(New Point(Width, 0), New Point(Width, Height))
                    LockBitPath.AddLine(New Point(Width, Height), New Point(0, Height))
                    LockBitPath.AddLine(New Point(0, 0), New Point(0, 0))

                ElseIf myTrack.LY < myTrack.RY Then
                    If Not myTrack.isLinkedToSwitchRight Then
                        Dim myLeftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(myTrack.RightLink)
                        If myLeftTrack IsNot Nothing AndAlso Not myLeftTrack.isLinkedToSwitchRight Then
                            rRX = rRX + 8
                            rRY = rRY + 8
                            Me.Width = Me.Width + 8
                        End If
                    End If
                    rRX = rRX - 3
                    rRY = rRY - 3
                    pt1 = New Point(rLX + TrackWidth, rLY + TrackWidth)
                    pt2 = New Point(rRX, rRY)
                    pt3 = New Point(rRX, rRY + TrackWidth)
                    pt4 = New Point(rLX, rLY + TrackWidth)

                    LockBitPath.AddLine(pt1, pt2)
                    LockBitPath.AddLine(pt2, pt3)
                    LockBitPath.AddLine(pt3, pt4)
                    LockBitPath.AddLine(pt4, pt1)

                ElseIf myTrack.LY > myTrack.RY Then
                    rLX = rLX + 3
                    rLY = rLY - 3

                    pt1 = New Point(rLX, rLY)
                    pt2 = New Point(rRX - TrackWidth, rRY + TrackWidth)
                    pt3 = New Point(rRX, rRY + TrackWidth)
                    pt4 = New Point(rLX, rLY + TrackWidth)
                    LockBitPath.AddLine(pt1, pt2)
                    LockBitPath.AddLine(pt2, pt3)
                    LockBitPath.AddLine(pt3, pt4)
                    LockBitPath.AddLine(pt4, pt1)

                End If

                Me.Region = New Region(LockBitPath)
                Me.Visible = True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Protected Overrides Sub OnPaint(ByVal e As System.Windows.Forms.PaintEventArgs)
            MyBase.OnPaint(e)
            Try
                If Me.LockBitPath Is Nothing Then Exit Sub
                If IsEnergized Then
                    myColor = Color.Red
                Else
                    myColor = Color.Green
                End If
                myBrush = New SolidBrush(myColor)
                e.Graphics.FillPath(myBrush, Me.LockBitPath)
                If Me.MouseEntered Then
                    e.Graphics.FillPath(New SolidBrush(Color.White), Me.LockBitPath)
                ElseIf Me.MouseLefted Then
                    Me.MouseLefted = False
                End If
            Catch ex As Exception
                'ARRC-1567 , collect all frames information for analysis
                SystemException(GetExceptionAllFrameMsg(ex, New StackTrace(True)))
                'SystemException(ex.ToString)
            End Try
        End Sub

#Region "MOUSE EVENTS"

        Public Sub Switch_MouseEnter(ByVal sender As Object, ByVal e As EventArgs)
            MouseEntered = True
            MouseLefted = False
            Me.Invalidate()
            Me.Update()
        End Sub

        Public Sub Switch_MouseLeave(ByVal sender As Object, ByVal e As EventArgs)
            MouseEntered = False
            MouseLefted = True
            Me.Invalidate()
            Me.Update()
        End Sub

        Public Sub Switch_MouseHover(ByVal sender As Object, ByVal e As EventArgs)
            Dim ToolTipMessage As New StringBuilder
            Try
                ToolTipMessage.Append("(" & myTrack.myCatenaryTrackCircuitName & ")")


                Me.myTrack.CurrentDrawingForm.TrackToolTip.SetToolTip(Me, ToolTipMessage.ToString)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

#End Region


    End Class
#End Region

