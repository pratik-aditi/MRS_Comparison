        Private Sub AutoPositionTrainSymbolLink(train As TrainID)
            Try
                If train.TrainSymbolScheduleLink = "" Then Exit Sub
                Dim theTrain As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(train.TrainSymbolScheduleLink)
                If Not IsNothing(theTrain) Then
                    If AutoPositionPrompt(theTrain) Then
                        Me.TrafficDirection = ""
                        Me.ApplyTraffic()
                        Me.MoveTrainIDPlaceManual(theTrain, theTrain.myTrack, False, Nothing)
                        Me.InvalidateTrainID()
                    End If

                Else
                    Dim trn As TrainID = Me.RetrieveTrainID(train.TrainSymbolScheduleLink, True)
                    If IsNothing(trn) Then Exit Sub
                    If AutoPositionPrompt(trn) Then
                        trn.ApplyTrainAbbreviation(gTrainAbbreviation)
                        Me.AddTrainID(trn)
                        Me.TrafficDirection = ""
                        Me.ApplyTraffic()

                        If Not Me.Indicating Or gSimulationMode Then
                            Me.Occuppied = True
                            Me.UpdateStatus()
                        End If
                        Dim SummItem As New SummaryItem("TRAIN", "POSITION", trn)
                        SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                            TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                        End SyncLock
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

