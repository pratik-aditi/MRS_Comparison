        Public Sub SetFieldBlockingControls(ByVal SetControl As Boolean)
            Try
                If gAssistMode Then Exit Sub
                Dim SendControl As Boolean = False
                Dim ControlPointOne As ControlPoint = Nothing
                Dim ControlPointTwo As ControlPoint = Nothing
                If Not Me.FBZ Is Nothing Then
                    If SetControl <> Me.FBZ.BitState Then
                        SendControl = True
                    End If
                    Me.FBZ.BitState = SetControl
                End If
                If Not Me.FBOFFZ Is Nothing Then
                    If SetControl Then
                        Me.FBOFFZ.BitState = False
                    Else
                        Me.FBOFFZ.BitState = True
                    End If
                End If

                If Not Me.FBZ2 Is Nothing Then
                    If SetControl <> Me.FBZ2.BitState Then
                        SendControl = True
                    End If
                    Me.FBZ2.BitState = SetControl
                End If
                If Not Me.FBOFFZ2 Is Nothing Then
                    If SetControl Then
                        Me.FBOFFZ2.BitState = False
                    Else
                        Me.FBOFFZ2.BitState = True
                    End If
                End If
                If SetControl Then
                    Me.FieldBlockingControlStatus = FieldBlockStatus.BlockingOn
                Else
                    Me.FieldBlockingControlStatus = FieldBlockStatus.BlockingOff
                End If
                If SendControl Then
                    If Not Me.FBZ Is Nothing Then
                        ControlPointOne = TMDS.SystemUtilities.FetchData.FindCPFromGUID(Me.FBZ.ControlPoint)
                    End If
                    If Not Me.FBZ2 Is Nothing Then
                        ControlPointTwo = TMDS.SystemUtilities.FetchData.FindCPFromGUID(Me.FBZ2.ControlPoint)
                    End If
                    If IsNothing(ControlPointTwo) Then
                        If Not IsNothing(ControlPointOne) Then
                            Me.FindCodeStationToSend()
                            ControlPointOne.SendCodeStationControlUpdate()
                        End If
                        Exit Sub
                    End If
                    If IsNothing(ControlPointOne) Then
                        If Not IsNothing(ControlPointTwo) Then
                            Me.FindCodeStationToSend()
                            ControlPointTwo.SendCodeStationControlUpdate()
                        End If
                        Exit Sub
                    End If

                    If ControlPointOne Is ControlPointTwo Then
                        Me.FindCodeStationToSend()
                        ControlPointOne.SendCodeStationControlUpdate()
                    Else
                        Me.FindCodeStationToSend()
                        ControlPointOne.SendCodeStationControlUpdate()

                        Me.FindCodeStationToSend()
                        ControlPointTwo.SendCodeStationControlUpdate()
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub LossOfShuntEvent(ByVal source As Object, ByVal e As ElapsedEventArgs)
            Try
                If gTraineeMode Then
                    Me.Ind(0).BitState = False
