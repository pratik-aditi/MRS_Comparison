        Sub DrawTrainID(Optional ByVal DrawAdditionalText As Boolean = False)
            Try
                'Me.TrackEvent("DrawTrainID:" & Me.GUID.ToString)

                DrawingTrainID = True
                If TrainIDs IsNot Nothing AndAlso TrainIDs.Count > 0 Then
                    Dim Train As TrainID
                    Train = TrainIDs.Item(0)
                    If Train Is Nothing Then Exit Sub
                    If TrainIDText Is Nothing Then Exit Sub
                    If Not DrawAdditionalText Then
                        Me.myGraphic.DrawString(Train.DisplayText, TrainIDText.pAlphaFont, New SolidBrush(Color.Black), TrainIDText.pAlphaBox, TrainIDText.pStringFormat)
                        myGraphic.DrawString(Train.DisplayText, TrainIDText.pAlphaFont, TrainIDText.pAlphaBrush, TrainIDText.pAlphaBox, TrainIDText.pStringFormat)
                    Else
                        If (Train.HighWide And optEnableFlashTrainForHighWide) Or (Train.KeyTrain And optEnableFlashTrainForKey) Then
                            Dim trntxFont As Font = Me.TrainIDEmergencyMessageText.pAlphaFont.Clone
                            If Not Train.FlashModeOff AndAlso trntxFont IsNot Nothing Then
                                If Train.MessageAlertFlashOn And Not Train.FlashModeOff And TrainIDEmergencyMessageText.pAlphaBox.X <> 0 And TrainIDEmergencyMessageText.pAlphaBox.Y <> 0 Then
                                    myGraphic.DrawString(Train.EmergencyMessage, trntxFont, TrainIDEmergencyMessageText.pAlphaBrush, TrainIDEmergencyMessageText.pAlphaBox, TrainIDEmergencyMessageText.pStringFormat)
                                Else
                                    If TrainIDEmergencyMessageText.pAlphaBox.X <> 0 And TrainIDEmergencyMessageText.pAlphaBox.Y <> 0 Then
                                        myGraphic.DrawString(Train.EmergencyMessage, trntxFont, New SolidBrush(Color.Black), TrainIDEmergencyMessageText.pAlphaBox, TrainIDEmergencyMessageText.pStringFormat)
                                    Else
                                        myGraphic.DrawString("             ", trntxFont, New SolidBrush(Color.Black), TrainIDEmergencyMessageText.pAlphaBox, TrainIDEmergencyMessageText.pStringFormat)
                                        Me.TrainIDEmergencyMessageText.BuildGraphics()
                                    End If
                                End If
                            End If
                            If Not IsNothing(trntxFont) Then
                                trntxFont.Dispose()
                            End If
                            Exit Sub
                        End If
                        If Train.EmeregencyFlag Then
                            If Not IsNothing(TrainIDEmergencyMessageText) Then
                                If Not Train.FlashModeOff Then
                                    If Train.MessageAlertFlashOn And Not Train.FlashModeOff Then
                                        myGraphic.DrawString(Train.EmergencyMessage, Me.TrainIDEmergencyMessageText.pAlphaFont, TrainIDEmergencyMessageText.pAlphaBrush, TrainIDEmergencyMessageText.pAlphaBox, TrainIDEmergencyMessageText.pStringFormat)
                                    Else
                                        If TrainIDEmergencyMessageText.pAlphaBox.X <> 0 And TrainIDEmergencyMessageText.pAlphaBox.Y <> 0 Then
                                            myGraphic.DrawString(Train.EmergencyMessage, Me.TrainIDEmergencyMessageText.pAlphaFont, New SolidBrush(Color.Black), TrainIDEmergencyMessageText.pAlphaBox, TrainIDEmergencyMessageText.pStringFormat)
                                        End If
                                    End If
                                End If
                            End If
                        End If
                        If Train.BrakingNotificationFlag Then
                            If Not IsNothing(TrainIDBrakingMessageText) Then
                                If Not Train.FlashModeOff Then
                                    If Train.MessageAlertFlashOn Then
                                        myGraphic.DrawString(Train.BrakingMessage, Me.TrainIDBrakingMessageText.pAlphaFont, TrainIDBrakingMessageText.pAlphaBrush, TrainIDBrakingMessageText.pAlphaBox, TrainIDBrakingMessageText.pStringFormat)
                                    Else
                                        If TrainIDBrakingMessageText.pAlphaBox.X <> 0 And TrainIDBrakingMessageText.pAlphaBox.Y <> 0 Then
                                            myGraphic.DrawString(Train.BrakingMessage, Me.TrainIDBrakingMessageText.pAlphaFont, New SolidBrush(Color.Black), TrainIDBrakingMessageText.pAlphaBox, TrainIDBrakingMessageText.pStringFormat)
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
                DrawingTrainID = False

            Catch ex As Exception
                DrawingTrainID = False
                'ARRC-1567 , collect all frames information for analysis
                SystemException(GetExceptionAllFrameMsg(ex, New StackTrace(True)))
                'SystemException(ex.ToString)
                Me.InitTrainMessageDisplay()
                Me.InvalidateTrainIDMessageDisplay()
            End Try
