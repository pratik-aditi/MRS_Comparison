        Private Function CheckForDeviceBlocks(ByVal CurrentTrackSelection As ArrayList) As Boolean
            Try
                Dim CompToCheck As Object
                Dim SameBlock As Boolean = False
                For Each CompToCheck In gEntExtTrackSelection
                    'gEntryTrack
                    If CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If CompToCheck Is gEntryTrack Then
