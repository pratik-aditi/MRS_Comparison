        Private Function ConvertTWCWarrantSelectionIntoSignalRouteSelection() As Boolean
            Dim StartingTrack As Track = Nothing
            Dim LeftObject As Object = Nothing
            Dim RightObject As Object = Nothing
            Dim IsConverstionValid As Boolean = False
            Try
                If Not optEnableTWCWarrantSelectionIntoSignalRouteSelection Then Return False
                If gBeginTrackSelect Is Nothing Then Return False
                If Not gBeginTrackSelect.AuthorityType.ToUpper.Trim.Contains("TWC") Then Return False
                If Not Me.AuthorityType.ToUpper.Trim.Contains("CTC") Then Return False
                LeftObject = FindCompFromGUID(gBeginTrackSelect.LeftLink)
                RightObject = FindCompFromGUID(gBeginTrackSelect.RightLink)
                If LeftObject IsNot Nothing Then
                    Select Case LeftObject.GetType.ToString
                        Case gTrackComponentName
                            If Not LeftObject.AuthorityType.ToUpper.Trim.Contains("CTC") Then IsConverstionValid = True
                        Case gSignalComponentName
                            IsConverstionValid = True
                    End Select
                ElseIf RightObject IsNot Nothing Then
                    Select Case RightObject.GetType.ToString
                        Case gTrackComponentName
                            If Not RightObject.AuthorityType.ToUpper.Trim.Contains("CTC") Then IsConverstionValid = True
                        Case gSignalComponentName
                            IsConverstionValid = True
                    End Select
                End If
                If Not IsConverstionValid Then Return False
                StartingTrack = gBeginTrackSelect
                If gBeginTrackSelect.Indicating Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionClear()
                    gTrackSelectionCollection.Clear()
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionTWC.Enabled = False
                    ClearSystemVariables()
                    StartingTrack.DoQuickRoute()
                    DoEntExit()
                    Return True
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                StartingTrack = Nothing
                LeftObject = Nothing
                RightObject = Nothing
            End Try
        End Function

        Private Sub AddOsCollectionToDeviceBlock(ByRef SwList As ArrayList)
            Try
                If Not IsNothing(Me.OsComponentCollection) Then
                    Dim comp As Object
                    For Each comp In Me.OsComponentCollection
                        If gBlockOSDevices Then
                            If Not gDeviceBlockSelection.Contains(comp) Then
                                gDeviceBlockSelection.Add(comp)
                                comp.SelectionMode = ModeSelection.DeviceBlocking
                                comp.FlashComponent = True
                            End If
                        Else
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" And Not gBlockOSDevices Then
                                If Not gDeviceBlockSelection.Contains(comp) Then
                                    gDeviceBlockSelection.Add(comp)
                                    comp.SelectionMode = ModeSelection.DeviceBlocking
                                    'comp.Flasher.Interval = 150
                                    comp.FlashComponent = True
                                End If
                            End If
                        End If
                        If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If Not SwList.Contains(comp) Then
                                SwList.Add(comp)
                            End If
                        End If
                    Next
                End If
            Catch ex As Exception

            End Try
        End Sub

