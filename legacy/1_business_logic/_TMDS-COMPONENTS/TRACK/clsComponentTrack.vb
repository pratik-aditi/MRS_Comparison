        ''' <summary>
        ''' Do Issue license
        ''' </summary>
        ''' <param name="trackSelection"></param>
        Public Sub DoIssueLicense(trackSelection As ArrayList)
            Try
                Dim cancelLicense As Boolean = True
                Dim newAuthority As frmSingleAuthorityFormMRS = Nothing
                TrackEventLog("DoIssueLicense")
                gBeginTrackSelect = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(trackSelection)
                gEndTrackSelect = TMDS.SystemUtilities.FetchData.FindLastTrackInList(trackSelection)
                gCreateLicenseTrain = gSelectedTrainIDTrack.TrainIDs.Item(0)
                gCreateLicenseDTC = True
                newAuthority = New frmSingleAuthorityFormMRS
                If newAuthority.BuildAuthority(gSearchDirection, trackSelection, gCreateLicenseTrain) Then
                    newAuthority.Owner = ParentForm
