#Region "MOUSE EVENTS"

        Protected Overrides Sub OnMouseDown(ByVal e As MouseEventArgs)
            MyBase.OnMouseDown(e)
            Dim TrackWarrantType As Boolean
            Dim CPTrackWarrantType As Boolean = False
            Dim button As Short = e.Button \ &H100000
            Try
                TrackEventLog("CLICKED - MOUSE DOWN TRACK (BUTTON=" & IIf(button = 1, "LEFT", "RIGHT") & ")")
                If (optEnableTerritoryDeskAssignmentMode OrElse optEnableShadowMode) AndAlso (Me.IsShadowMode AndAlso Not Me.JointControl) AndAlso Not gStackRoute Then Exit Sub
                If Me.GUID = 0 Then Exit Sub
                If optEnableARRCSpecificOptions AndAlso gPermissionPassRedSignalSwitchSelectionMode Then Exit Sub
                If optEnableARRCSpecificOptions AndAlso gEntExit Then
                    If (Me.AuthorityType.ToUpper.Trim.Contains("TWC") AndAlso Me.Indicating) Then
                    ElseIf (Me.AuthorityType.ToUpper.Trim.Contains("TWC") AndAlso Not Me.Indicating) Then
                        Exit Sub
                    End If
                End If
                If optDisableTNTIssueOnNonTransverableTrack AndAlso gCreateTrackTime AndAlso Me.AllowTrackTime AndAlso Me.NonTransverable Then Exit Sub
                myMouseArguments = e
                If gCritcalPromptExists Then
                    TrackEventLog("CRITICAL PROMPT EXISTS - EXITING MOUSE SELECTION")
                    Exit Sub
                End If
                If Me.myControlPoint.MaintenanceMode And Not gMaintenanceMode Then
                    AddMessageToFeedback("TRACK CONTROL NOT OPERATONAL BECAUSE THE CONTROL POINT " & Me.myControlPoint.Name & " IS CURRENTLY IN MAINTENANCE MODE")
                    Exit Sub
                End If
                If e.Button = Windows.Forms.MouseButtons.Left Then
                    If Mid(Me.AuthorityType, 1, 3) = "TWC" Or Me.AuthorityType = "NON-TWC" Or Me.AuthorityType = "YL" Then
                        TrackWarrantType = True
                    End If
                    If optEnableCPSpecificOptions Then
                        If gCreateIssueTrackWarrantProceedForTrain OrElse gCreateIssueTrackWarrantWorkForTrain OrElse gCreateIssueTrackWarrantRollUpForTrain OrElse gCPTWCTrainReportClearMode Then CPTrackWarrantType = True
                        If gCreateIssueTrackWarrantWorkForMOW OrElse gCreateIssueTrackWarrantWorkForMOW OrElse gCreateIssueTrackWarrantRollUpForMow OrElse gCPTWCTrainReportClearMode Then CPTrackWarrantType = True
                        If gCPTNTRollUpForTrain OrElse gCPTNTRollUpForMow Then CPTrackWarrantType = True
                    End If
                    If gDeviceSelectMode Then
                        Me.DeviceSelectMode()
                        Exit Sub
                    End If
                    If gSendCTC Then Exit Sub
                    If gTNTComplete And Not gTNTContinue Then Exit Sub
                    If gDTCComplete Then Exit Sub
                    If optAllowSwitchLegSelectionForSwitchControl Then
                        If Me.OStype And Me.NonTransverable Then
                            Dim mySwitch As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSTrackLeg(Me)
                            If Not IsNothing(mySwitch) Then
                                mySwitch.IsSwitch(Nothing, True, e)
                                Exit Sub
                            End If
                        End If
                    End If
                    If gPermissionPassRedSignal And optEnableToPassRedSignalOnCodeBrown Then
                    ElseIf (gCreateTrainPassRed564 Or gCreateCPEMT) And optEnableToPassRedSignalOnCodeBrown Then
                    ElseIf optEnableTrackTimeIssueOnCodeBrown = True And gCreateTrackTime Then
                        If (Me.RemoteLinkShowDown) And Not (gMoveMOWID OrElse gMoveMOWID OrElse gBlockAllDevices Or gBlockTrackDevices Or gPositionTrainID Or gMoveTrainID Or gCreateBlueFlagBlock Or gCreateTrackWarrant) Then
                            Dim OverrideExit As Boolean
                            If optAllowTagCopyFunctionOnCodeFailureTrack And gCopyTag Then OverrideExit = True
                            If Not OverrideExit Then
                                Exit Sub
                            End If
                        End If
                    ElseIf optEnableTrackTimeIssueOnCodeBrown = True And (gCreateCPTNT Or gCreateCPFT) Then
                        If (Me.RemoteLinkShowDown) And Not (gMoveMOWID OrElse gBlockAllDevices Or gBlockTrackDevices Or gPositionTrainID Or gMoveTrainID Or gCreateBlueFlagBlock Or gCreateTrackWarrant) Then
                            Dim OverrideExit As Boolean
                            If optAllowTagCopyFunctionOnCodeFailureTrack And gCopyTag Then OverrideExit = True
                            If Not OverrideExit Then
                                Exit Sub
                            End If
                        End If
                    ElseIf optEnableTrackTimeIssueOnCodeBrown AndAlso ((gCreateTrackAuthorityMOW AndAlso gCreateAuthorityTypeMOW = "BIDIRECTIONAL") OrElse (gCreateTrackAuthorityTrain AndAlso gCreateAuthorityTypeTrain = "BIDIRECTIONAL")) Then
                        If (Me.RemoteLinkShowDown) And Not (gMoveMOWID OrElse gBlockAllDevices Or gBlockTrackDevices Or gPositionTrainID Or gMoveTrainID Or gCreateBlueFlagBlock Or gCreateTrackWarrant) Then
                            Dim OverrideExit As Boolean
                            If optAllowTagCopyFunctionOnCodeFailureTrack And gCopyTag Then OverrideExit = True
                            If Not OverrideExit Then
                                Exit Sub
                            End If
                        End If
                    Else
                        If (Me.RemoteLinkShowDown Or Me.FailState) And Not (gMoveMOWID OrElse gBlockAllDevices Or gBlockTrackDevices Or gPositionTrainID Or gMoveTrainID Or gCreateBlueFlagBlock Or gCreateTrackWarrant Or CPTrackWarrantType) Then
                            Dim OverrideExit As Boolean
                            If optAllowTagCopyFunctionOnCodeFailureTrack And gCopyTag Then OverrideExit = True
                            If gCreateBulletin Then OverrideExit = True
                            If optEnableMRSSpecificOptions AndAlso Not IsNothing(gCreateLicenseTrain) Then OverrideExit = True
                            If Not OverrideExit Then
                                Exit Sub
                            End If
                        End If
                    End If
                    'Cancel license for trains
                    If gCancelLicenseToTrain Then
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    'Simulator for position report
                    If gSimPositionReport Then
                        ClearSystemVariables()
                        Exit Sub
                        'Simulator for release eot
                    ElseIf gSimReleaseEot Then
                        Dim theTrain As TrainID = gCreateLicenseTrain
                        gCreateLicenseTrain = Nothing
                        theTrain.myRearEndTrack = Me
                        theTrain.CheckToReleaseTrackBehindTrain(theTrain.myTrack, Me)
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    If gTrainSetRearEndToTrack Then
                        gTrainSetRearEndToTrack = False
                        If Not IsNothing(gSelectedTrainIDTrack) Then
                            Dim trn As TrainID = gSelectedTrainIDTrack.TrainIDs.Item(0)
                            gCreateLicenseTrain = Nothing
                            trn.CheckToReleaseTrackBehindTrain(trn.myRearEndTrack, Me)
                            trn.myRearEndTrack = Me
                        End If
                    ElseIf gTrainSetHeadEndToTrack Then
                        gTrainSetHeadEndToTrack = False
                        If Not IsNothing(gSelectedTrainIDTrack) Then
                            Dim trn As TrainID = gSelectedTrainIDTrack.TrainIDs.Item(0)
                            trn.myHeadEndTrack = Me
                        End If
                    ElseIf gBlockAllDevices Or gBlockTrackDevices Then
                        If Me.FailState Then Exit Sub
                        Me.DoDeviceBlock()
                    ElseIf gCreateLicenseDTC Then
                        Me.DoIssueLicenseDTC(e)
                    ElseIf gCreateBlueFlagBlock Then
                        Me.DoBlueFlagBlock()
                    ElseIf gCreateTrackreservationMode Then
                        Me.DoCreateTrackReservsation(e)
                        'AUTHORITY
                    ElseIf gCreateDTCWarrant Then
                        Me.DoDTCWarrant(e)
                    ElseIf gCreateTrackAuthorityTrain OrElse gCreateTrackAuthorityMOW Then
                        Me.DoTrackAuthority(e)
                    ElseIf gCreateTrackTime Or gCreateFoulTime Then
                        Me.DoTrackAndTimeAuthority(e)
                    ElseIf gCreateTrackPermit Then
                        Me.DoTrackPermit(e)
                    ElseIf gContingentMode Then
                        Me.DoTrackWarrantContingent(e)
                    ElseIf gDualAuthorityMode Then
                        Me.DoTrackWarrantItemSixLimits(e)
                    ElseIf gCreateTrackWarrant Then
                        If Me.NonTransverable Then Exit Sub
                        Dim isSignalRouteSelectionMode As Boolean = False
                        isSignalRouteSelectionMode = ConvertTWCWarrantSelectionIntoSignalRouteSelection()
                        If Not isSignalRouteSelectionMode Then
                            gCreateTrackWarrant = True
                            SetCursor(curCreateTW)
                            Me.DoTrackWarrant(e) 'needs some work
                        End If
                    ElseIf gRollUpTrackWarrant Then
                        Me.DoRollUpWarrant() 'needs some work
                        'TRAIN
                    ElseIf gPositionTrainID Then
                        Me.DoTrainPosition(e)
                    ElseIf gModifyTrainID Then
                        Me.DoTrainModify(e)
                    ElseIf gMoveTrainID Then
                        If Me.GUID > 0 Then Me.DoTrainMove() Else Exit Sub
                    ElseIf gFinalTrain Then
                        Me.DoTrainFinal()
                    ElseIf gOSTrain Then
                        Me.DoOSTrain()
                    ElseIf gSimulateTrain Then
                        Me.DoSimulateTrainStart()
                    ElseIf gSimulateTrainPassRed Then
                        gSimulateTrainPassRed = False
                        Me.DoSimulateTrainPassRed()
                    ElseIf gSimulateTrainStop Then
                        Me.DoSimulateTrainStop()
                    ElseIf gHelperTrainSelected Then
                        Me.DoTrainLink()
                        'BULLETINS
                    ElseIf gCreateBulletin Then
                        Me.DoCreateBulletin()
                        'TAGS
                    ElseIf gCreateTag Then
                        If optEnableMultipleTrackTagSelectionForSpeedRestrictions And gCreateTagType = "SPEED" Then
                            If DoCheckForTagSelectionSequence() Then
                                Me.DoCreateMultipleTrackTags()
                                If Not gTagAuthorityCheckDone Then
                                    If Not OkToIssueTagWithAuthority() Then
                                        Exit Sub
                                    End If
                                End If
                            Else
                                Exit Sub
                            End If
                        ElseIf optEnableMultipleTrackTagSelectionForWeather And gCreateTagType = "WEATHER" Then
                            Me.DoCreateMultipleTrackTags()
                        ElseIf optEnableMultipleTrackTagSelectionForInfoRestrictions AndAlso gCreateTagType = "INFO" Then
                            If DoCheckForTagSelectionSequence() Then
                                Me.DoCreateMultipleTrackTags()
                            Else
                                Exit Sub
                            End If
                        Else
                            Me.DoTagCreate(e, "RESTRICTIVE", gCreateTagType)
                        End If
                    ElseIf gCreateNonTag Then
                        Me.DoTagCreate(e, Nothing)
                    ElseIf gCreateDelayTag Then
                        Me.DoTagCreate(e, "DELAY")
                    ElseIf gCopyTag Then
                        Me.DoTagCopy(e)
                        'MOW
                    ElseIf gCreateTOP Then
                        'CreateTOP(gForemanMenuMiscSelectedID, e)
                    ElseIf gCreateCPTNT Or gCreateCPFT Then
                        'If optEnableTNTForCP Then
                        '    Me.CreateMOWTNTForCP(gForemanMenuMiscSelectedID, e)
                        'End If
                    ElseIf gCreateMOWID Then
                        Me.DoMOWCreate(e)
                    ElseIf gMoveMOWID Then
                        Me.DoMOWMove(gMoveMOWSelectedID)
                    ElseIf gDeleteMOWID Then
                        If Me.MOWIDs.Count > 0 Then
                            Me.DoMOWDelete(Me.MOWIDs.Item(0))
                        End If
                        'OTHER
                        '
                    ElseIf gRemoveLicense Then
                        ' If Me.GUID > 0 Then Me.DoRemoveLicense() Else Exit Sub
                    ElseIf gChangeOccupancy Then
                        If Me.GUID > 0 Then Me.DoChangeOccupany() Else Exit Sub
                    ElseIf gChangeTraffic Then
                        Me.DoChangeTraffic()
                        'ROUTING
                    ElseIf gEntExit Then
                        Me.DoEntExit()
                    ElseIf gGenerateRouteForTrainMode Then
                        Me.DoGenerateRoute()
                    ElseIf gPermissionPassRedSignal Then
                        If Not gEntryTrack Is Nothing Then
                            If (Mid(gEntryTrack.AuthorityType, 1, 3) <> Mid(Me.AuthorityType, 1, 3)) And Not gOverridePSSPermissionForCTCIsland Then
                                Exit Sub
                            End If
                        End If
                        DoCreateTrainPassRedSignalRoute(gTrainMenuMiscSelectedTrainID)
                    ElseIf gQuickRouteMode OrElse gStackMode OrElse gGropupedStoredRoute Then
                        If (TrackWarrantType And gQuickRouteMode) Then
                            If Me.NonTransverable Then Exit Sub
                            If optEnableTWCForCP And Not gCreateIssueTrackWarrantWorkForMOW Then
                                If Me.Indicating Then
                                    Me.DoQuickRoute()
                                    Exit Sub
                                Else
                                    Exit Sub
                                End If
                            End If
                            If optUseSingleFormAuthorityVersionMRS Then Exit Sub
                            gCreateTrackWarrant = True
                            SetCursor(curCreateTW)
                            Me.DoTrackWarrant(e) 'needs some work
                        ElseIf Not OptEnableSignalClearByMenu OrElse optAllowQuickRouteWithSignalClearbyMenu Then
                            Me.DoQuickRoute()
                        End If
                    ElseIf Not (gAssistMode OrElse Me.IsShadowMode) Then
                        If Me.TrainIDs.Count > 0 Then
                            If Me.TrainIDs.Count > 1 Then
                                SystemForms.MySystemForms.frmTrainStack = New frmTrainStack()
                                SystemForms.MySystemForms.frmTrainStack.SetProperties(Me.CurrentDrawingForm.myLaunchPoint, Me, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                SystemForms.MySystemForms.frmTrainStack.ShowDialog(SystemForms.MySystemForms.frmMainMDI)
                                SystemForms.MySystemForms.frmTrainStack = Nothing
                                Me.TrackEventLog("LAUNCH - TRAIN STACK FORM")
                            ElseIf Me.TrainIDs.Count = 1 Then
                                gModifyTrainID = True
                                SystemForms.MySystemForms.frmTrainID = New frmTrainID()
                                If SystemForms.MySystemForms.frmTrainID.ModifyTrain(Me, Me.CurrentDrawingForm.myLaunchPoint, 0) Then
                                    SystemForms.MySystemForms.frmTrainID.ShowDialog(SystemForms.MySystemForms.frmMainMDI)
                                    SystemForms.MySystemForms.frmTrainID.Dispose()
                                    SystemForms.MySystemForms.frmTrainID = Nothing
                                End If
                            End If
                            Exit Sub
                        End If
                    End If
                ElseIf e.Button = Windows.Forms.MouseButtons.Right Then
                    If optEnableCPSpecificOptions Then
                        If gCPTNTRollUpForMow Or gCPTNTRollUpForTrain Or gCreateTrainPassRed564 Or gCreateCPEMT Or gCreateCPTNT Or gCreateCPFT Then
                            ContextMenuEnabled(False)
                            Exit Sub
                        ElseIf gCreateIssueTrackWarrantProceedForTrain OrElse gCreateIssueTrackWarrantWorkForTrain OrElse gCreateIssueTrackWarrantRollUpForTrain OrElse gCPTWCTrainReportClearMode Then
                            ContextMenuEnabled(False)
                            Exit Sub
                        ElseIf gCreateIssueTrackWarrantWorkForMOW OrElse gCreateIssueTrackWarrantWorkForMOW OrElse gCreateIssueTrackWarrantRollUpForMow OrElse gCPTWCTrainReportClearMode Then
                            ContextMenuEnabled(False)
                            Exit Sub
                        End If
                    End If
                    If gEntExit Or gPermissionPassRedSignal Or gCreateTrainPassRed564 Or gPermissionPassRedSignalSwitchSelectionMode Then
                        ContextMenuEnabled(False)
                        Exit Sub
                    End If
                    If Me.JointControl And Me.myControlPoint.IsShadowMode Then
                        ContextMenuEnabled(EnableJointControl)
                    ElseIf optDisbaleContextMenuOnCodeBrownDisplay AndAlso Me.FailState Then
                        ContextMenuEnabled(False)
                    Else
                        ContextMenuEnabled(True)
                    End If
                    RefreshContextMenu()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                button = Nothing
            End Try
        End Sub

