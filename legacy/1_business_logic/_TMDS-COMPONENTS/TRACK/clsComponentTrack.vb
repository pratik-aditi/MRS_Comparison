        Private Function FindComponent(ByVal GUID As Int32) As Object
            Try
                Dim sig As Signal
                If GUID = 0 Then Return Nothing
                For Each sig In TMDS.GlobalDeclarations.SignalCollection
                    If GUID = sig.GUID Then
                        Return sig
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

