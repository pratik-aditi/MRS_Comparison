        Private Function CheckForEMTDeviceBlocks(ByVal CurrentTrackSelection As ArrayList, Optional ByRef BlockNames As ArrayList = Nothing) As String
            Dim BlocksTOCheck As New ArrayList
            Dim CompToCheck As Object
            Try
                BlockNames = New ArrayList
                Dim SameBlock As Boolean = False

                Dim FirstSignal As Boolean
                For Each CompToCheck In gEntExtTrackSelection
                    If CompToCheck.GetType.ToString = gSignalComponentName Then
                        FirstSignal = True
                    End If

                    If FirstSignal Then
                        BlocksTOCheck.Add(CompToCheck)
                    End If

                Next

                For Each CompToCheck In BlocksTOCheck
                    'For Each CompToCheck In gEntExtTrackSelection
                    'gEntryTrack
                    If CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        If CompToCheck Is gEntryTrack Then
                            SameBlock = True
                        End If
                    End If
                    If Not SameBlock Then
                        If CompToCheck.DeviceBlocked Then
                            Dim dv As TrackAuthority.DeviceBlock
                            For Each dv In CompToCheck.Deviceblocks
                                If dv.IsEMT Then
                                    Return "EMT"
                                ElseIf dv.IsPRS Then
                                    Return "PRS"
                                ElseIf optEnableARRCSpecificOptions Then
                                    BlockNames.Add(dv.IssueTo)
                                End If

                            Next
                            Return "False"
                            SameBlock = False
                        End If
                    End If
                    SameBlock = False
                Next
                'OptEnableMutiplePSSToATrain
                If optEnablePSSEMTAuthorityNoDeviceBlk Then
                    If Not OptEnableMutiplePSSToATrain Then
                        CopyArrayCollection(BlocksTOCheck, gEntExtTrackSelection)
                    End If
                    For Each CompToCheck In BlocksTOCheck
                        ' For Each CompToCheck In gEntExtTrackSelection
                        If CompToCheck.GetType.ToString = gTrackComponentName Then
                            Dim trk As Track = Nothing
                            trk = TryCast(CompToCheck, Track)
                            If CompToCheck.OtherSplAuthorities IsNot Nothing AndAlso CompToCheck.OtherSplAuthorities.count > 0 Then
                                Dim spl As TMDS.TrackAuthority.OtherSpecialAuthorityType
                                For Each spl In CompToCheck.OtherSplAuthorities
                                    If spl IsNot Nothing Then
                                        Select Case spl.SubType
                                            Case "PSS"
                                                Return "PRS"
                                            Case Else
                                                Return "EMT"
                                        End Select
                                    End If
                                Next
                            End If
                        End If
                    Next
                End If


                Return "True"
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                BlocksTOCheck = Nothing
                CompToCheck = Nothing
            End Try
        End Function

        Private Function CheckForSwitches(ByVal CurrentTrackSelection As ArrayList) As Boolean
            Dim CompToCheck As Object = Nothing
            Dim SwitchList As New ArrayList
            Dim PSSSelection As New ArrayList

            Dim RALTComp As Object = Nothing
            Dim LALTComp As Object = Nothing
            Try
                PSSSelection = gEntExtTrackSelection.Clone

                For Each CompToCheck In gEntExtTrackSelection
                    If CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        If Not SwitchList.Contains(CompToCheck) Then SwitchList.Add(CompToCheck)
                        RALTComp = Nothing
                        LALTComp = Nothing
                        If CompToCheck.RightAltLink > 0 Then
                            RALTComp = FindCompFromGUID(CompToCheck.RightAltLink)
                            If PSSSelection.Contains(RALTComp) Then
                                PSSSameMain = False
                                'PSSSelectedSwitchCollection.Add(CompToCheck)
                            End If

                        ElseIf CompToCheck.LeftAltLink > 0 Then
                            LALTComp = FindCompFromGUID(CompToCheck.LeftAltLink)
                            If PSSSelection.Contains(LALTComp) Then
                                PSSSameMain = False
                                'PSSSelectedSwitchCollection.Add(CompToCheck)
                            End If

                        End If
                    End If
                Next
                Application.DoEvents()
                Return ValidateSwitches(SwitchList)
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                CompToCheck = Nothing
                SwitchList = Nothing
                PSSSelection = Nothing
                RALTComp = Nothing
                LALTComp = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Gets all of the switches in gEntExtTrackSelection and checks to see if they are a part
        ''' of the same main. It then validates their hand operation. (RPBJR)
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Private Function CheckForSwitches_BNSF() As Boolean

            Dim switchCollection As New ArrayList

            Try

                For Each tmdsComponent As Object In gEntExtTrackSelection

                    Dim rightAltComponent As Object = Nothing
                    Dim leftAltComponent As Object = Nothing

                    If tmdsComponent.GetType.ToString = "TMDS.SwitchComponents.Switch" Then

                        If Not switchCollection.Contains(tmdsComponent) Then
                            switchCollection.Add(tmdsComponent)
                        End If

                        If tmdsComponent.RightAltLink > 0 Then

                            rightAltComponent = FindCompFromGUID(tmdsComponent.RightAltLink)
                            If gEntExtTrackSelection.Contains(rightAltComponent) Then
                                PSSSameMain = False
                            End If

                        ElseIf tmdsComponent.LeftAltLink > 0 Then

                            leftAltComponent = FindCompFromGUID(tmdsComponent.LeftAltLink)
                            If gEntExtTrackSelection.Contains(leftAltComponent) Then
                                PSSSameMain = False
                            End If

                        End If

                    End If

                Next

                Application.DoEvents()

                Dim switchesValidated As Boolean = ValidateSwitches_BNSF(switchCollection)

                Return switchesValidated

            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                switchCollection = Nothing
            End Try

        End Function

        Private Function ValidateSwitches(ByVal SwitchArray As ArrayList) As Boolean
            Dim HandOperaterequired As Boolean
            Dim compSwitch As Switch = Nothing
            Dim SwitchCPCodeFail As Boolean = False
            Dim CodeFailSwitches As New ArrayList
            Try
                For Each compSwitch In SwitchArray
                    'If compSwitch.FailState = True Or compSwitch.CurrentControlStatus <> compSwitch.SwitchIndStatus Then
                    compSwitch.SelectionMode = SwitchComponents.Switch.ModeSelection.DeviceBlocking
                    compSwitch.Flasher.Interval = 250
                    compSwitch.FlashOn = True
                    compSwitch.FlashComponent = True
                    compSwitch.UpdateStatus()
                    HandOperaterequired = True
                    If compSwitch.myControlPoint.FailState AndAlso Not compSwitch.IndicateOnly Then
                        If Not CodeFailSwitches.Contains(compSwitch) Then CodeFailSwitches.Add(compSwitch)
                        SwitchCPCodeFail = True
                    End If

                    'End If
                Next
                If optEnablePSSAutoSelectSwitchesOnCodeFail AndAlso SwitchCPCodeFail Then
                    If CodeFailSwitches IsNot Nothing AndAlso CodeFailSwitches.Count > 0 Then
                        PSSSelectedSwitchCollection = New ArrayList
                        For Each compSwitch In CodeFailSwitches
                            If Not PSSSelectedSwitchCollection.Contains(compSwitch) Then PSSSelectedSwitchCollection.Add(compSwitch)
                        Next
                        PSSHandeOperationRequiredNOOption = 6
                        HandOperaterequired = False
                    End If

                Else
                    If HandOperaterequired Then
                        Return ShowDialogSwitchConfirmation()
                    End If
                End If


                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return True
        End Function

        ''' <summary>
        ''' Validates the switches - Basically sets switches in the switch_list to DeviceBlocking Enabled BNSF.
        ''' </summary>
        ''' <param name="switch_list">The switch_list.</param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Private Function ValidateSwitches_BNSF(ByVal switch_list As ArrayList) As Boolean

            Dim handOperationRequired As Boolean

            Try
                For Each switchComponent As Switch In switch_list

                    switchComponent.SelectionMode = SwitchComponents.Switch.ModeSelection.DeviceBlocking
                    switchComponent.Flasher.Interval = 250
                    switchComponent.FlashOn = True
                    switchComponent.FlashComponent = True
                    switchComponent.UpdateStatus()
                    handOperationRequired = True

                Next

                'This will always be true if switch_list.Count > 0 ... ?
                If handOperationRequired Then
                    'If dispatcher chooses yes to switches in hand this will return true
                    Return ShowDialogSwitchConfirmation()
                End If

                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

            Return True

        End Function

        Public Function ShowDialogSwitchConfirmation() As Boolean
            Dim EventMessage As String = String.Empty
            Try

                Dim frmMessageBox As New frmMessageBox()
                frmMessageBox.PassRedSignal = True
                Dim MessageList As New ArrayList()
                Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + gEntryTrack.CurrentDrawingForm.Width / 2 - 100, 150)
                'MessageList.Add("THERE ARE OTHER SWITCHES WHICH REQUIRES TO POSITION BY HAND-OPERATION.")
                frmMessageBox.btnOK.TabIndex = 2
                frmMessageBox.btnYes.TabIndex = 1
                frmMessageBox.btnNo.TabIndex = 3
                MessageList.Add(optAuthString58)
                'MessageList.Add("(" & gTrainMenuMiscSelectedTrainID.IdentifingUnit & ")")
                MessageList.Add(optAuthString59)
                MessageList.Add("")
                frmMessageBox.SetMessage_PSS(MessageList, optAuthString60, True, Me.CurrentDrawingForm.myLaunchPoint, Nothing, False, False, "", Nothing, True, optAuthString61)
                frmMessageBox.ShowDialog()
                PSSHandeOperationRequiredNOOption = frmMessageBox.FormFeedBack
                If frmMessageBox.FormFeedBack = 6 Then
                    gPermissionPassRedSignalSwitchSelectionMode = True
                    RemoveSwitchesFromPSSCollection()

                    EventMessage = vbCrLf & "DISPATCHER(" & gCurrentUser.Initials & ") SELECTED YES TO PLACE SWITCH IN HAND OPERATION."
                    Me.TrackEventLog(EventMessage)
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    Do While gPermissionPassRedSignalSwitchSelectionMode
                        If Not gPermissionPassRedSignalSwitchSelectionMode Then
                            Exit Do
                        Else
                            SetCursor(curPassRedSignalSW)
                            Threading.Thread.Sleep(50)
                            Application.DoEvents()
                        End If
                    Loop

                Else
                    EventMessage = vbCrLf & "DISPATCHER(" & gCurrentUser.Initials & ") SELECTED NO TO PLACE SWITCH IN HAND OPERATION."
                    Me.TrackEventLog(EventMessage)
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing
                    Return False
                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function CheckForStoredRoutes(ByVal CurrentTrackSelection As ArrayList) As Boolean
            Try
                'Check for any stored routes over selection
                Dim SignalList As New ArrayList()
                Dim CompToCheck As Object
                Dim sr As StoredRoute
                For Each CompToCheck In CurrentTrackSelection
                    Dim LeftSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(CompToCheck.Leftlink)
                    Dim RightSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(CompToCheck.Rightlink)
                    If Not LeftSig Is Nothing Then
                        If Not SignalList.Contains(LeftSig) Then
                            SignalList.Add(LeftSig)
                        End If
                    End If
                    If Not RightSig Is Nothing Then
                        If Not SignalList.Contains(RightSig) Then
                            SignalList.Add(RightSig)
                        End If
                    End If
                Next

                Dim cpList As New ArrayList()
                Dim sigToCheck As Signal
                For Each sigToCheck In SignalList
                    If Not cpList.Contains(sigToCheck.myControlPoint) Then
                        cpList.Add(sigToCheck.myControlPoint)
                    End If
                Next

                Dim cp As ControlPoint
                For Each cp In cpList
                    For Each sr In cp.StoredRoutes
                        Dim srComp As Object
                        For Each srComp In sr.ComponentSelection
                            If srComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                For Each sigToCheck In SignalList
                                    If sigToCheck.GUID = srComp.GUID Then
                                        If srComp.StoredExitSignal Then
                                            SignalList = Nothing
                                            cpList = Nothing
                                            Return False
                                        Else

                                            If srComp.ComponentType = "R" Or srComp.ComponentType = "D" Then
                                                Dim RightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(srComp.RightLink)
                                                If Not RightTrack Is Nothing Then
                                                    If CurrentTrackSelection.Contains(RightTrack) Then
                                                        SignalList = Nothing
                                                        cpList = Nothing
                                                        Return False
                                                    End If
                                                End If
                                            Else
                                                Dim LeftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(srComp.LeftLink)
                                                If CurrentTrackSelection.Contains(LeftTrack) Then
                                                    SignalList = Nothing
                                                    cpList = Nothing
                                                    Return False
                                                End If
                                            End If

                                        End If
                                        'Message = "Current Track Selection Not Valid - Stored Route Found In Selection!"
                                        'TrackAuthorityEvent(Message)
                                        'MessageBox.Show(SystemForms.MySystemForms.frmMainMDI.ActiveMdiChild, Message, "CONFLICT RESOLUTION MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                    End If
                                Next
                            ElseIf srComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                                Dim rr As RRXING = CType(srComp, RRXING)
                                Dim TopTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(rr.LeftAltLink)
                                Dim BottomTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(rr.RightAltLink)
                                Dim RightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(rr.RightLink)
                                Dim LeftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(rr.LeftLink)

                                If CurrentTrackSelection.Contains(TopTrack) Then
                                    SignalList = Nothing
                                    cpList = Nothing
                                    Return False
                                End If
                                If CurrentTrackSelection.Contains(BottomTrack) Then
                                    SignalList = Nothing
                                    cpList = Nothing
                                    Return False
                                End If
                                If CurrentTrackSelection.Contains(RightTrack) Then
                                    SignalList = Nothing
                                    cpList = Nothing
                                    Return False
                                End If
                                If CurrentTrackSelection.Contains(LeftTrack) Then
                                    SignalList = Nothing
                                    cpList = Nothing
                                    Return False
                                End If

                            End If
                        Next
                    Next
                Next

                For Each sigToCheck In SignalList
                    If sigToCheck.FleetEnabled Then
                        If sigToCheck.ComponentType = "R" Or sigToCheck.ComponentType = "D" Then
                            Dim RightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sigToCheck.RightLink)
                            If Not RightTrack Is Nothing Then
                                If CurrentTrackSelection.Contains(RightTrack) Then
                                    SignalList = Nothing
                                    cpList = Nothing
                                    Return False
                                End If
                            End If
                        Else
                            Dim LeftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sigToCheck.LeftLink)
                            If CurrentTrackSelection.Contains(LeftTrack) Then
                                SignalList = Nothing
                                cpList = Nothing
                                Return False
                            End If
                        End If
                    End If
                Next


                cpList = Nothing
                SignalList = Nothing
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

