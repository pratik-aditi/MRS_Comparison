                        End If
                        Dim trk As Track = CType(NextComp, Track)
                        If NextComp.SignalStatOnMe <> TrackComponents.Track.SignalStatus.SignalAtStop And trk.TrafficDirection <> "LEFT" Then
                            NoRightConflict = False
                            Exit While
                        End If
                        If NextComp.NonTransverable Then
                            NoRightConflict = True
                            Exit While
                        End If
                        If trk.OStype And trk.TrafficDirection <> "LEFT" And trk.Occuppied Then
                            NoRightConflict = False
                            Exit While
                        End If
                        If FlipIt Then
