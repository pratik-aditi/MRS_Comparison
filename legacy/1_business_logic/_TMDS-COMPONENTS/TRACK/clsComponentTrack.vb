                                                                            If (NextTrackToCheck.Ind(0) Is Me.Ind(0)) Or (NextTrackToCheck.Ind(0) Is Me.Ind(1)) Or (NextTrackToCheck.Ind(1) Is Me.Ind(0)) Then
                                                                                NextTrackToCheck.MoveTrainIDPlace(trn1, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                                                                'NextTrackToCheck.InvalidateTrainID()
                                                                                If Me.OStype Then
                                                                                    NextTrackToCheck.PushTrainIDToNextOccupancy(Me, trn1, "LEFT")
                                                                                End If

                                                                                SearchLeftComplete = True
                                                                                Exit While
                                                                            End If
                                                                        End If
                                                                    End If
                                                                End If
                                                            End If
                                                        End If
                                                        Me.MoveTrainIDPlace(trn1, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", Me.TrafficDirection)
                                                        'Me.InvalidateTrainID()
                                                        If Me.OStype Then
                                                            CompToCheck.PushTrainIDToNextOccupancy(Me, trn1, "LEFT")
                                                        ElseIf Me.IsLinkToRemoteTrack Then
                                                            Dim LeftTrk As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.LeftLink)
