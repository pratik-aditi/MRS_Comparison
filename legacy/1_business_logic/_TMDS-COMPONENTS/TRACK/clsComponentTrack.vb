                            End If

                            If NextComp.StationNumber = Me.StationNumber And NextComp.Name = Me.Name Then
                                If FlipIt Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            Else
                                If NextComp.Occuppied Then
                                    If Me.TrainIDs.Count > 0 Then
                                        Dim trn As TrainID = Me.TrainIDs.Item(0)
                                        If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainIDOff") Then Exit Sub
                                        If optEnableBRCSpecificChecks AndAlso TerrFlipDirection Then
                                            If trn.Direction = optDirectionWest Or trn.Direction = optDirectionSouth Then
                                                If CanTrainBeTracked(NextComp) Then
                                                    TrackIDsOffTrack(Me, NextComp)
