                                                If Not IsTrainMoveAllowedOnIndication(train, GetCurrentMethod.Name) Then Exit Sub
                                                MoveTrainIDPlace(train, leftTrack, OStype, gDatabaseConnectionTrain, "T", "LEFT")
                                                train.TrackingDirection = "LEFT"
                                            End If
                                        End If
