        Private Sub InvalidateAuthNumberRegion()
            'Dim AuthText As AuthNumberText
            'For Each AuthText In AuthNumberTextCollection
            'Dim rgn As New Region(AuthText.pAlphaBox)
            'DisplayForm.Invalidate(rgn)
            'Next
            Try
                If Mid(Me.AuthorityType, 1, 3) = "TWC" Then
                    Dim AuthNumberRegion As New Rectangle(LX - 1, LY + 9, 70, 90)
                    Dim rgn As New Region(AuthNumberRegion)
