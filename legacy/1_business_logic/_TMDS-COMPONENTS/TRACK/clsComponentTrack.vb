#Region "TRACK"

    Public Class Track
        Inherits GenericComponent

#Region "MAIN METHODS"

        Sub New()
            'Build the flasher timer for the signal bulb
            Flasher = New Windows.Forms.Timer() 'New Timers.Timer()
            Flasher.Interval = 250

            LossOfShuntTimer = New Timers.Timer()
            LossOfShuntTimer.AutoReset = False
            AddHandler LossOfShuntTimer.Elapsed, AddressOf LossOfShuntEvent

            'BuildContextMenu()
        End Sub

        Protected Overloads Overrides Sub Dispose(ByVal disposing As Boolean)
            If disposing Then
                Try
                    LossOfShuntTimer.Enabled = False
                    LossOfShuntTimer.Stop()
                    RemoveHandler LossOfShuntTimer.Elapsed, AddressOf LossOfShuntEvent
                    LossOfShuntTimer = Nothing
                Catch
                End Try
                Try
                    Flasher.Enabled = False
                    Flasher.Stop()
                    Flasher = Nothing
                Catch ex As Exception
                End Try

                Try
                    RemoveHandler Me.MouseEnter, AddressOf Me.Track_MouseEnter
                    RemoveHandler Me.MouseLeave, AddressOf Me.Track_MouseLeave
                    RemoveHandler Me.MouseHover, AddressOf Me.Track_MouseHover
                Catch ex As Exception
                End Try

                ColorStatusBlocking = Nothing
                ColorStatusRouteRequesting = Nothing
                ColorSummarySelectionBlocking = Nothing
                ColorSummarySelectionRequesting = Nothing
                ColorStatusOccupancySelectionBlocking = Nothing
                TrainIDGraphicPath = Nothing
                FlashOffColorStatus = Nothing
                MOWIDGraphicPath = Nothing
                If Not IsNothing(gPath) Then
                    gPath.Dispose()
                    gPath = Nothing
                End If
                If Not IsNothing(Me.TrackTagText) Then
                    Me.TrackTagText.Dispose()
                    Me.TrackTagText = Nothing
                End If

                If Not IsNothing(Me.TrainIDEmergencyMessageText) Then
                    Me.TrainIDEmergencyMessageText.Dispose()
                    Me.TrainIDEmergencyMessageText = Nothing
                End If
                If Not IsNothing(Me.TrainIDBrakingMessageText) Then
                    Me.TrainIDBrakingMessageText.Dispose()
                    Me.TrainIDBrakingMessageText = Nothing
                End If
                If Not IsNothing(Me.MOWIDText) Then
                    Me.MOWIDText.Dispose()
                    Me.MOWIDText = Nothing
                End If
                If Not IsNothing(Me.TrainIDText) Then
                    Me.TrainIDText.Dispose()
                    Me.TrainIDText = Nothing
                End If
                If myCatenaryTrack IsNot Nothing Then
                    myCatenaryTrack.Dispose()
                    myCatenaryTrack = Nothing
                End If
            End If
            MyBase.Dispose(disposing)
        End Sub

        Public Overloads Sub Dispose()
            ' Do not change this code.  Put cleanup code in Dispose(ByVal disposing As Boolean) above.
            Dispose(True)
            GC.SuppressFinalize(Me)
        End Sub

        Protected Overrides Sub Finalize()
            MyBase.Finalize()
        End Sub
#End Region

