        Private Function GetSwitchFromCollection(ByVal UniqueID As Int32) As Switch
            Try
                Dim sw As Object
                For Each sw In Me.myControlPoint.AssignedComponenets
                    If sw.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        If UniqueID = sw.GUID And Not sw.NonOperationSwitchPointMonitor Then
                            Return sw
                        End If
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub NonTranversableSearch(ByVal RequestingSwitch As Switch, ByVal NonTraversableStatus As Boolean)
            Try
                'Me.TrackEvent("NonTranversableSearch:" & Me.GUID.ToString)
                Dim LeftSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(Me.LeftLink)
                Dim RightSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(Me.RightLink)
                Dim NextComp As Object
                Dim LoopControl As Integer

                RequestingSwitch.Invoke(New MethodInvoker(AddressOf RequestingSwitch.Refresh))
                If Not LeftSw Is Nothing Then
                    If Not LeftSw Is RequestingSwitch Then
                        'Me.TrackEvent("NonTranversableSearch-Track2:" & Me.GUID.ToString)
                        If LeftSw.ControlledReverse Then
                            If LeftSw.LeftAltLink <> 0 Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(LeftSw.LeftAltLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(LeftSw.LeftLink)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(LeftSw.LeftLink)
                        End If
                        If Not LeftSw.ControlledReverse Then
                            LeftSw.NonTransverable = NonTraversableStatus
                            LeftSw.RefreshMe()
                            Do
                                If NextComp Is Nothing Then Exit Do
                                If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If NextComp.StationNumber = Me.StationNumber And NextComp.Name = Me.Name Then
                                        'DebugEvent("TRACK:" & NextComp.Name & "-" & NextComp.guid & " NON:" & NextComp.NonTransverable.ToString)
                                        NextComp.NonTransverable = NonTraversableStatus
                                        NextComp.UpdateStatus()
                                        NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                                    Else
                                        Exit Do
                                    End If
                                ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(NextComp, Switch)
                                    If NextComp.ControlledReverse Then
                                        If NextComp.LeftAltLink <> 0 Then
                                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftAltLink)
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                                        End If
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                                    End If
                                    sw.NonTransverable = NonTraversableStatus
                                    sw.UpdateColorStatusOnly()
                                ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                                End If
                                LoopControl = LoopControl + 1
                                If LoopControl > 10 Then Exit Do
                            Loop
                        End If
                    End If
                End If

                LoopControl = 0
                If Not RightSw Is Nothing Then
                    If Not RightSw Is RequestingSwitch Then
                        If RightSw.ControlledReverse Then
                            If RightSw.RightAltLink <> 0 Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(RightSw.RightAltLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(RightSw.RightLink)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(RightSw.RightLink)
                        End If
                        If Not RightSw.ControlledReverse Then
                            RightSw.NonTransverable = NonTraversableStatus
                            RightSw.RefreshMe()
                            Do
                                If NextComp Is Nothing Then Exit Do
                                If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If NextComp.StationNumber = Me.StationNumber And NextComp.Name = Me.Name Then
                                        'DebugEvent("TRACK:" & NextComp.Name & "-" & NextComp.guid & " NON:" & NextComp.NonTransverable.ToString)
                                        NextComp.NonTransverable = NonTraversableStatus
                                        NextComp.UpdateStatus()
                                        NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                                    Else
                                        Exit Do
                                    End If
                                ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                    Dim sw As Switch = CType(NextComp, Switch)
                                    If NextComp.ControlledReverse Then
                                        If NextComp.RightAltLink <> 0 Then
                                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightAltLink)
                                        Else
                                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                                        End If
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                                    End If
                                    sw.NonTransverable = NonTraversableStatus
                                    sw.UpdateColorStatusOnly()
                                ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                                End If
                                LoopControl = LoopControl + 1
                                If LoopControl > 10 Then Exit Do
                            Loop
                        End If
                    End If
                End If
                'Me.TrackEvent("NonTranversableSearch-Complete:" & Me.GUID.ToString)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

