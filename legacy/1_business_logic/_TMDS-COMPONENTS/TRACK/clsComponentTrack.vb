        Public Sub CheckToAcknowledgeNonIdenitifedOccupancy()
            Dim al As Alert

            Dim RemoveList As New ArrayList
            Try
                SyncLock TMDS.GlobalDeclarations.gSystemAlertList
                    For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                        Select Case al.TypeOfAlert
                            Case ManagementClasses.Alert.AlertType.NonIdentifiedTrackOccupancy
                                Dim trk As Track = CType(al.AlertObject, Track)
                                If Not IsNothing(trk) Then
                                    If trk.GUID = Me.GUID Then
                                        al.AlertAcknowledged = True
                                        Dim Message As String = "NON-IDENTIFIED OCCUPANCY ALERT WAS ACKNOWLEDGED BY SYSTEM: " & Me.Name
                                        al.AlertAckedByPerson = Message
                                        TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                                        gSystemAlertExists = False
                                        Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al)
                                        SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                            TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                        End SyncLock
                                        RemoveList.Add(al)
                                    End If
                                End If
                        End Select
                    Next
                    For Each al In RemoveList
                        TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                    Next
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function FindTrackWithTrain(ByVal TrainGUID As String, ByVal ExcludeTrack As Track) As TMDS.TrackComponents.Track
            Try
                Dim trk As Track
                For Each trk In TMDS.GlobalDeclarations.TrackCollection
                    If trk.TrainIDs.Count > 0 Then
                        Dim trn As TrainID
                        For Each trn In trk.TrainIDs
                            If (Trim(trn.TrainGUID) = Trim(TrainGUID)) And (ExcludeTrack.GUID <> trk.GUID) Then
                                Return trk
                            End If
                        Next
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

