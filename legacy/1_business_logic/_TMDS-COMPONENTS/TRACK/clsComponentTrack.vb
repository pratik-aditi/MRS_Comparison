        ''' <summary>
        ''' Find Maneuver Train
        ''' </summary>
        ''' <param name="pIsLoad"></param>
        ''' <returns></returns>
        Private Function FindManeuverTrain(ByVal pIsLoad As Boolean) As String
            Dim newSymbol As String = "N"
            Dim trainFound As Boolean = False
            Dim count As Integer = 0
            Dim trainAux As TrainID
            Try
                While Not trainFound
                    If pIsLoad Then 'N02, N04 UNTIL N98
                        If gManeuverLoadCount >= 98 Then
                            gManeuverLoadCount = 2
                        Else
                            gManeuverLoadCount += 2
                        End If
                        newSymbol = newSymbol & gManeuverLoadCount.ToString("#00")
                    Else 'N01, N03 UNTIL N99
                        If gManeuverEmptyCount >= 99 Then
                            gManeuverEmptyCount = 1
                        Else
                            gManeuverEmptyCount += 2
                        End If
                        newSymbol = newSymbol & gManeuverEmptyCount.ToString("#00")
                    End If
                    trainAux = FindTrainBySymbol(newSymbol)
                    count += 1
                    If count > 100 Then
                        Exit While
                    End If
                    If trainAux IsNot Nothing Then
                        newSymbol = "N"
                        Continue While
                    Else
                        trainFound = True
                    End If
                End While
                Return newSymbol
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                newSymbol = Nothing
                trainFound = Nothing
                count = Nothing
                trainAux = Nothing
            End Try
        End Function

