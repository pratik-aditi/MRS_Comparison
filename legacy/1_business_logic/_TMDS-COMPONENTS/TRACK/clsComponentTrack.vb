                                                            If Not IsTrainMoveAllowedOnIndication(trn1, "TrackTrainIDOn") Then Exit Sub
                                                            If trn1.Direction = optDirectionWest Or trn1.Direction = optDirectionSouth Then
                                                                Me.MoveTrainIDPlace(trn1, comp, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", "LEFT")
                                                                trn1.TrackingDirection = "LEFT"
                                                                If Me.OStype Then
                                                                    CompToCheck.PushTrainIDToNextOccupancy(Me, trn1, "LEFT")
                                                                End If
                                                            End If
                                                        End If
                                                    End If
                                                Next
                                            End If
                                            If Me.RightAltLink <> 0 Then
                                                ShelfTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.RightAltLink)
                                                If ShelfTrack.TrainIDs.Count > 0 Then
                                                    trn2 = Nothing
                                                    trn2 = ShelfTrack.TrainIDs(0)
                                                    If Not IsTrainMoveAllowedOnIndication(trn2, "TrackTrainIDOn") Then Exit Sub
                                                    If trn2.Direction = optDirectionWest Or trn2.Direction = optDirectionSouth Then
                                                        Me.MoveTrainIDPlace(trn2, ShelfTrack, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T")
                                                        trn2.TrackingDirection = "LEFT"
                                                        If Me.OStype Then
                                                            CompToCheck.PushTrainIDToNextOccupancy(Me, trn2, "LEFT")
                                                        End If
                                                    End If
                                                    SearchLeftComplete = True
                                                    SearchRightComplete = True
                                                    Exit While
                                                End If
                                            End If
                                            'this code to to look backwards for a Train ID until a unoccupied OS is found
                                            If Not CompToCheck.OStype Then
                                                NextReferenceNumber = CompToCheck.RightLink
                                            Else
                                                SearchLeftComplete = True
                                                SearchRightComplete = True
                                                Exit While
                                            End If
                                        End If
                                    End If
                                End If
                            ElseIf CompToCheck.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                                'Dim ff As FlipFlop
                                NextReferenceNumber = CompToCheck.FindExitGUID(LastRefNumber)
                                'FlipIt = True
                            ElseIf CompToCheck.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                                Dim RR As RRXING = CType(CompToCheck, RRXING)
                                NextReferenceNumber = RR.FindExitGUID(LastRefNumber)
                            ElseIf CompToCheck Is Nothing Then
                                SearchRightComplete = True
                                Exit While
                            Else
                                NextReferenceNumber = CompToCheck.RightLink
                            End If
                            LoopControl = LoopControl + 1
                            If LoopControl > 50 Then
                                SearchRightComplete = True
                                Exit While
                            End If
                        End While
                        LoopControlExternal = LoopControlExternal + 1
                        If LoopControlExternal > 50 Then
                            SearchRightComplete = True
                            LoopControlExternal = 0
                            Exit While
                        End If
                    End While
                End If

                'check for trains pass red signals here
                If (Me.OSReporting Or Me.SlottingTrack) Then
                    If Not Me.InitOS Then ' OS needs to have one inidication before making this check
                        Me.InitOS = True
                    Else
                        Dim OsTracks As ArrayList = Me.FindOsTracks
                        Dim theComp As Object
                        If Not OsTracks Is Nothing Then
                            For Each theComp In OsTracks
                                If theComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If theComp.TrainIDs.Count > 0 Then
                                        trn = theComp.TrainIDs.Item(0)
                                        If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainIDOn") Then Exit Sub
                                        Exit For
                                    End If
                                End If
                            Next
                        End If
                        If Not optSupressPassRedSignalCheck Then
                            If Not Me.PassRedSignalAlertOff Then
                                Me.CheckForTrainMoveByRedSignal(Me, trn)
                            End If
                        End If
                    End If
                End If
                If optEnableGenerateAlarmNonIdentifiedOccuppancy Then
                    If Me.TrainIDs.Count = 0 Then
                        Me.ShowAlarmForNonIdentifiedOccupancy(Me)
                    End If
                End If
                TrackEventLog("TrackTrainIDOn:End")
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function GetLastIndicatingTrackInCollection(ByVal TrafficDirection As String, ByVal CurrentTrack As Track, ByVal HasFlipFlop As Boolean) As Track
            Dim rtnTrk As Object = Nothing
            Dim Comp As Track
            Dim NextComp As Object = Nothing
            Dim SearchDirection As String = ""

            Try


                If HasFlipFlop Then
                    Select Case TrafficDirection
                        Case "LEFT"
                            SearchDirection = "RIGHT"
                        Case Else
                            SearchDirection = "LEFT"
                    End Select
                Else
                    SearchDirection = TrafficDirection
                End If

                If CurrentTrack.OsComponentCollection Is Nothing Then Return CurrentTrack
                rtnTrk = CurrentTrack
                Select Case SearchDirection
                    Case "LEFT"
                        NextComp = FindCompFromGUID(CurrentTrack.LeftLink)
                    Case Else
                        NextComp = FindCompFromGUID(CurrentTrack.RightLink)
                End Select

                For i As Integer = 0 To 20
                    If NextComp.GetType.ToString = gTrackComponentName Then
                        If CurrentTrack.OsComponentCollection.Contains(NextComp) Then
                            If NextComp.StationNumber = CurrentTrack.StationNumber AndAlso NextComp.Ind(0) Is CurrentTrack.Ind(0) Then
                                rtnTrk = NextComp
                                Select Case SearchDirection
                                    Case "LEFT"
                                        NextComp = FindCompFromGUID(NextComp.LeftLink)
                                    Case Else
                                        NextComp = FindCompFromGUID(NextComp.RightLink)
                                End Select
                            End If
                        Else
                            Return rtnTrk
                        End If
                    ElseIf NextComp.GetType.ToString = gSwitchComponentName Then
                        Dim sw As Switch = NextComp
                        Select Case SearchDirection
                            Case "LEFT"
                                If sw.ControlledReverse Then
                                    NextComp = FindCompFromGUID(sw.LeftAltLink)
                                Else
                                    NextComp = FindCompFromGUID(NextComp.LeftLink)
                                End If

                            Case Else
                                If sw.ControlledReverse Then
                                    NextComp = FindCompFromGUID(sw.RightAltLink)
                                Else
                                    NextComp = FindCompFromGUID(NextComp.RightLink)
                                End If
                                'NextComp = FindCompFromGUID(NextComp.RightLink)
                        End Select
                    ElseIf NextComp.GetType.ToString = gSignalComponentName Then
                        Dim SG As Signal = NextComp
                        Select Case SearchDirection
                            Case "LEFT"
                                If SG.ComponentType = "L" Then
                                    Return rtnTrk
                                Else
                                    NextComp = FindCompFromGUID(NextComp.LeftLink)
                                End If
                            Case Else
                                If SG.ComponentType = "R" Then
                                    Return rtnTrk
                                Else
                                    NextComp = FindCompFromGUID(NextComp.RightLink)
                                End If
                                'NextComp = FindCompFromGUID(NextComp.RightLink)
                        End Select
                    ElseIf NextComp.GetType.ToString = gRRXINGComponentName Then
                        Dim IsMovementThroRRXing As Boolean = False
                        Comp = FindCompFromGUID(NextComp.LeftLink)
                        If Comp.SignalStatOnMe = SignalStatus.SignalAtStop Then
                            IsMovementThroRRXing = True
                        End If
                        If IsMovementThroRRXing Then

                            Select Case SearchDirection
                                Case "LEFT"
                                    NextComp = FindCompFromGUID(NextComp.LeftAltLink)
                                Case Else
                                    NextComp = FindCompFromGUID(NextComp.RightAltLink)
                            End Select
                        Else
                            Select Case SearchDirection
                                Case "LEFT"
                                    NextComp = FindCompFromGUID(NextComp.LeftLink)
                                Case Else
                                    NextComp = FindCompFromGUID(NextComp.RightLink)
                            End Select

                        End If


                    Else
                        Select Case SearchDirection
                            Case "LEFT"
                                NextComp = FindCompFromGUID(NextComp.LeftLink)
                            Case Else
                                NextComp = FindCompFromGUID(NextComp.RightLink)
                        End Select
                    End If
                Next




            Catch ex As Exception
                GetErrorDetails(ex)
            End Try

            Return rtnTrk
        End Function

        Sub TrackTrainID(ByVal TrackOn As Boolean)
            Dim NextTrackFound, SearchRightComplete, SearchLeftComplete As Boolean
            Dim CompToCheck As Object
            Dim NextReferenceNumber As Int32
            Dim LoopControl As Integer
            Try
                If Me.TrafficDirection = "RIGHT" Then
                    NextReferenceNumber = Me.LeftLink
                    While Not NextTrackFound
                        CompToCheck = Me.FindObjectTypeFromGUID(NextReferenceNumber)
                        If CompToCheck Is Nothing Then Exit While 'added 5-3-04
                        If CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If CompToCheck.ControlledReverse Then
                                NextReferenceNumber = CompToCheck.LeftAltLink
                            Else
                                NextReferenceNumber = CompToCheck.LeftLink
                            End If
                        ElseIf CompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            NextReferenceNumber = CompToCheck.LeftLink
                        ElseIf CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If CompToCheck.NonTransverable Then Exit Sub ' add 6-6-04 if trying to tyrack through a piece of track that is non tranversable exit the sub
                            If CompToCheck.StationNumber = Me.StationNumber And CompToCheck.Name = Me.Name Then
                                NextReferenceNumber = CompToCheck.LeftLink
                                'Exit While
                            Else
                                'NextReferenceNumber = CompToCheck.LeftLink
                                If CompToCheck.TrainIDs.Count > 0 Then
                                    Dim trn As TrainID = CompToCheck.TrainIDs(0)
                                    If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainID") Then Exit Sub
                                    'ADDED CODE TO CHECK AHEAD OF THIS TRACK INDICATION
                                    'AND SEE IF THERE IS A NON-INDICATING TRACK TO MOVE THIS
                                    'TRAIN ID FURTHER THEN THIS TRACK THAT IS INDICATING
                                    Dim NonIndTrack As Track = SearchForNonIndicatingTrack(Me, Me.TrafficDirection)
                                    If Not NonIndTrack Is Nothing Then
                                        Me.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                        Me.InvalidateTrainID()
                                        If Not Me.SimulateMode Then
                                            Threading.Thread.Sleep(1000)
                                            NonIndTrack.MoveTrainIDPlace(trn, Me, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                            NonIndTrack.InvalidateTrainID()
                                        End If
                                    Else
                                        Me.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                        Me.InvalidateTrainID()
                                    End If
                                    Exit While
                                Else
                                    If (CompToCheck.Occuppied) Or (Not CompToCheck.Occuppied And Not CompToCheck.Indicating) Then
                                        Dim OSTrackCollection As ArrayList
                                        OSTrackCollection = CompToCheck.FindOsTracks()
                                        Dim trk As Object
                                        For Each trk In OSTrackCollection
                                            If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                If trk.TrainIDs.Count > 0 Then
                                                    Dim trn1 As TrainID = trk.TrainIDs(0)
                                                    If Not IsTrainMoveAllowedOnIndication(trn1, "TrackTrainID") Then Exit Sub
                                                    Me.MoveTrainIDPlace(trn1, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                                    Me.InvalidateTrainID()
                                                End If
                                            End If
                                        Next
                                        Exit While
                                    Else
                                        SearchLeftComplete = True
                                        Exit While
                                    End If
                                End If
                            End If

                        ElseIf CompToCheck Is Nothing Then
                            Exit While
                        End If

                        LoopControl = LoopControl + 1
                        If LoopControl > 25 Then LoopControl = 0 : Exit While
                    End While
                ElseIf Me.TrafficDirection = "LEFT" Then
                    NextReferenceNumber = Me.RightLink
                    While Not NextTrackFound
                        CompToCheck = Me.FindObjectTypeFromGUID(NextReferenceNumber)
                        If CompToCheck Is Nothing Then SearchLeftComplete = True : Exit While 'added 5-3-04
                        If CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If CompToCheck.ControlledReverse Then
                                NextReferenceNumber = CompToCheck.RightAltLink
                            Else
                                NextReferenceNumber = CompToCheck.RightLink
                            End If
                        ElseIf CompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            NextReferenceNumber = CompToCheck.RightLink
                        ElseIf CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If CompToCheck.NonTransverable Then Exit While ' add 6-6-04 if trying to tyrack through a piece of track that is non tranversable exit the sub
                            If CompToCheck.StationNumber = Me.StationNumber And CompToCheck.Name = Me.Name Then
                                NextReferenceNumber = CompToCheck.RightLink
                                'Exit While
                            Else
                                If CompToCheck.TrainIDs.Count > 0 Then
                                    Dim trn As TrainID = CompToCheck.TrainIDs(0)
                                    If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainID") Then Exit Sub
                                    'ADDED CODE TO CHECK AHEAD OF THIS TRACK INDICATION
                                    'AND SEE IF THERE IS A NON-INDICATING TRACK TO MOVE THIS
                                    'TRAIN ID FURTHER THEN THIS TRACK THAT IS INDICATING
                                    Dim NonIndTrack As Track = SearchForNonIndicatingTrack(Me, Me.TrafficDirection)
                                    If Not NonIndTrack Is Nothing Then
                                        Me.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                        Me.InvalidateTrainID()
                                        If Not Me.SimulateMode Then
                                            Threading.Thread.Sleep(1000)
                                            NonIndTrack.MoveTrainIDPlace(trn, Me, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                            NonIndTrack.InvalidateTrainID()
                                        End If
                                    Else
                                        Me.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                        Me.InvalidateTrainID()
                                    End If
                                    SearchLeftComplete = True
                                    Exit While
                                Else
                                    If CompToCheck.Occuppied Or (Not CompToCheck.Occuppied And Not CompToCheck.Indicating) Then
                                        Dim OSTrackCollection As ArrayList
                                        OSTrackCollection = CompToCheck.FindOsTracks()
                                        Dim trk As Object
                                        For Each trk In OSTrackCollection
                                            If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                If trk.TrainIDs.Count > 0 Then
                                                    Dim trn1 As TrainID = trk.TrainIDs(0)
                                                    If Not IsTrainMoveAllowedOnIndication(trn1, "TrackTrainID") Then Exit Sub
                                                    Me.MoveTrainIDPlace(trn1, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                                    Me.InvalidateTrainID()
                                                End If
                                            End If
                                        Next
                                        SearchLeftComplete = True
                                        Exit While
                                    Else
                                        SearchLeftComplete = True
                                        Exit While
                                    End If
                                End If
                            End If

                        ElseIf CompToCheck Is Nothing Then
                            Exit While
                        End If

                        LoopControl = LoopControl + 1
                        If LoopControl > 25 Then LoopControl = 0 : Exit While
                    End While
                Else
                    While Not SearchLeftComplete
                        NextReferenceNumber = Me.LeftLink
                        While Not NextTrackFound
                            CompToCheck = Me.FindObjectTypeFromGUID(NextReferenceNumber)
                            If CompToCheck Is Nothing Then SearchLeftComplete = True : Exit While 'added 5-3-04
                            If CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                If CompToCheck.ControlledReverse Then
                                    NextReferenceNumber = CompToCheck.LeftAltLink
                                Else
                                    NextReferenceNumber = CompToCheck.LeftLink
                                End If
                            ElseIf CompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                NextReferenceNumber = CompToCheck.LeftLink
                            ElseIf CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If CompToCheck.NonTransverable Then Exit Sub ' add 6-6-04 if trying to tyrack through a piece of track that is non tranversable exit the sub
                                If CompToCheck.StationNumber = Me.StationNumber And CompToCheck.Name = Me.Name Then
                                    NextReferenceNumber = CompToCheck.LeftLink
                                Else
                                    'added new code to keep the Train ID from tracking backwards
                                    If CompToCheck.TrafficDirection = "LEFT" Then
                                        SearchLeftComplete = True
                                        Exit While
                                    End If

                                    If CompToCheck.TrainIDs.Count > 0 Then
                                        Dim trn As TrainID = CompToCheck.TrainIDs(0)
                                        If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainID") Then Exit Sub
                                        Me.MoveTrainIDPlace(trn, CompToCheck, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                        Me.InvalidateTrainID()
                                        SearchRightComplete = True
                                        Exit While
                                    Else
                                        If CompToCheck.Occuppied Or (Not CompToCheck.Occuppied And Not CompToCheck.Indicating) Then
                                            Dim OSTrackCollection As ArrayList
                                            OSTrackCollection = CompToCheck.FindOsTracks()
                                            Dim trk As Object
                                            For Each trk In OSTrackCollection
                                                If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                    If trk.TrainIDs.Count > 0 Then
                                                        Dim trn As TrainID = trk.TrainIDs(0)
                                                        If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainID") Then Exit Sub
                                                        'If trn.Direction = optDirectionNorth Or trn.Direction = optDirectionWest Or trn.Direction = "" Then
                                                        Me.MoveTrainIDPlace(trn, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                                        Me.InvalidateTrainID()
                                                        SearchRightComplete = True
                                                        Exit While
                                                        'End If
                                                    End If
                                                    'Exit Sub
                                                End If
                                            Next
                                        Else
                                            SearchLeftComplete = True
                                            Exit While
                                        End If
                                    End If
                                End If
                            ElseIf CompToCheck Is Nothing Then
                                SearchLeftComplete = True
                                Exit While
                            End If

                            LoopControl = LoopControl + 1
                            If LoopControl > 25 Then SearchLeftComplete = True : LoopControl = 0 : Exit While
                        End While

                    End While

                    While Not SearchRightComplete
                        NextReferenceNumber = Me.RightLink
                        While Not NextTrackFound
                            CompToCheck = Me.FindObjectTypeFromGUID(NextReferenceNumber)
                            If CompToCheck Is Nothing Then Exit Sub 'added 5-3-04
                            If CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                If CompToCheck.ControlledReverse Then
                                    NextReferenceNumber = CompToCheck.RightAltLink
                                Else
                                    NextReferenceNumber = CompToCheck.RightLink
                                End If
                            ElseIf CompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                NextReferenceNumber = CompToCheck.RightLink
                            ElseIf CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                If CompToCheck.NonTransverable Then Exit Sub ' add 6-6-04 if trying to tyrack through a piece of track that is non tranversable exit the sub
                                If CompToCheck.StationNumber = Me.StationNumber And CompToCheck.Name = Me.Name Then
                                    If Not Me.Occuppied And Me.TrainIDs.Count > 0 Then
                                        NextReferenceNumber = CompToCheck.RightLink
                                    Else
                                        SearchRightComplete = True
                                        Exit While
                                    End If

                                Else
                                    'added new code to keep the Train ID from tracking backwards
                                    If CompToCheck.TrafficDirection = "RIGHT" Then
                                        SearchRightComplete = True
                                        Exit While
                                    End If

                                    If CompToCheck.TrainIDs.Count > 0 Then
                                        Dim trn As TrainID = CompToCheck.TrainIDs(0)
                                        If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainID") Then Exit Sub
                                        Me.MoveTrainIDPlace(trn, CompToCheck, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                        Me.InvalidateTrainID()
                                        SearchRightComplete = True
                                        Exit While
                                    Else
                                        If CompToCheck.Occuppied Then
                                            Dim OSTrackCollection As ArrayList
                                            OSTrackCollection = CompToCheck.FindOsTracks()
                                            Dim trk As Object
                                            For Each trk In OSTrackCollection
                                                If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                                    If trk.TrainIDs.Count > 0 Then
                                                        Dim trn As TrainID = trk.TrainIDs(0)
                                                        If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainID") Then Exit Sub
                                                        'If trn.Direction = optDirectionSouth Or trn.Direction = optDirectionWest Then
                                                        Me.MoveTrainIDPlace(trn, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                                        Me.InvalidateTrainID()
                                                        SearchRightComplete = True
                                                        Exit While
                                                        'End If
                                                    End If
                                                    'Exit Sub
                                                End If
                                            Next
                                        ElseIf (Not CompToCheck.Occuppied And Not CompToCheck.Indicating) Then
                                            Dim trn As TrainID = Nothing
                                            If Me.TrainIDs.Count > 0 Then trn = Me.TrainIDs(0) 'added 5-4-03
                                            If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainID") Then Exit Sub
                                            CompToCheck.MoveTrainIDPlace(trn, Me, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                                            CompToCheck.InvalidateTrainID()
                                            SearchRightComplete = True
                                            Exit While
                                        Else
                                            SearchRightComplete = True
                                            Exit While
                                        End If
                                    End If
                                End If
                            ElseIf CompToCheck Is Nothing Then
                                SearchRightComplete = True
                                Exit While
                            End If

                            LoopControl = LoopControl + 1
                            If LoopControl > 25 Then
                                SearchRightComplete = True
                                Exit While
                            End If
                        End While
                    End While
                End If

                'check for trains pass red signals here
                'If Me.OStype Then
                If (Me.OSReporting Or Me.SlottingTrack) And TrackOn Then
                    If Not Me.InitOS Then ' OS needs to have one inidication before making this check
                        Me.InitOS = True
                    Else
                        Dim OsTracks As ArrayList = Me.FindOsTracks
                        Dim trk As Object = Nothing
                        Dim trn As TrainID = Nothing
                        If Not OsTracks Is Nothing Then
                            For Each trk In OsTracks
                                If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If trk.TrainIDs.Count > 0 Then
                                        trn = trk.TrainIDs.Item(0)
                                        If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainID") Then Exit Sub
                                        Exit For
                                    End If
                                End If
                            Next
                        End If
                        Me.CheckForTrainMoveByRedSignal(Me, trn)
                    End If
                End If

                'Add TrackTag
                If Me.TrackTagLabels.Count > 0 Then

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function SearchForNonIndicatingTrack(ByVal LeavingTrack As Track, ByVal Direction As String) As Track
            Try
                Dim TrackFound As Boolean
                Dim LoopControl As Integer
                Dim NextComp As Object

                If Direction = "RIGHT" Then
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.RightLink)
                    While Not TrackFound
                        If NextComp Is Nothing Then Return Nothing
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If NextComp.Name = Me.Name And NextComp.StationNumber = Me.StationNumber Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            Else
                                If Not NextComp.Indicating Then
                                    Return NextComp
                                Else
                                    Return Nothing
                                End If
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If NextComp.ControlledReverse Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightAltLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightLink)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightLink)
                        End If
                        LoopControl = LoopControl + 1
                        If LoopControl > 100 Then
                            Return Nothing
                        End If
                    End While
                Else
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.LeftLink)
                    While Not TrackFound
                        If NextComp Is Nothing Then Return Nothing
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If NextComp.Name = Me.Name And NextComp.StationNumber = Me.StationNumber Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            Else
                                If Not NextComp.Indicating Then
                                    Return NextComp
                                Else
                                    Return Nothing
                                End If
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If NextComp.ControlledReverse Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.LeftAltLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.LeftLink)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.LeftLink)
                        End If
                        LoopControl = LoopControl + 1
                        If LoopControl > 100 Then
                            Return Nothing
                        End If
                    End While
                End If
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Function FindOsTracks() As ArrayList
            Dim SearchingForEnd As Boolean = True
            Dim CompList As New ArrayList()
            Dim SearchDirection As Integer
            Dim NextCompToTest As Object
            Dim LoopTerminator As Int32
            Try
                CompList.Add(Me)
                For SearchDirection = 1 To 2
                    If SearchDirection = 1 Then
                        NextCompToTest = FindObjectTypeFromGUID(Me.RightLink)
                    Else
                        NextCompToTest = FindObjectTypeFromGUID(Me.LeftLink)
                    End If
                    While SearchingForEnd

                        If NextCompToTest Is Nothing Then Exit While

                        If NextCompToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If Not CompList.Contains(NextCompToTest) Then
                                CompList.Add(NextCompToTest)
                            End If
                            'added this for train id tracking simulation to find multilpe switches in the OS
                            '10-12-2003
                            If SearchDirection = 1 Then
                                NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.RightLink)
                            Else
                                NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.LeftLink)
                            End If
                            If NextCompToTest.GUID = 0 Then Exit While
                            ''10-12-2003 removed Exit While, and add code above
                            ''Exit While

                        ElseIf NextCompToTest.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If NextCompToTest.Name = Me.Name And NextCompToTest.StationNumber = Me.StationNumber Then
                                If Not CompList.Contains(NextCompToTest) Then
                                    CompList.Add(NextCompToTest)
                                End If
                                If SearchDirection = 1 Then
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.RightLink)
                                Else
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.LeftLink)
                                End If
                                If NextCompToTest.GUID = 0 Then
                                    Exit While
                                End If
                            Else
                                Exit While
                            End If
                        Else
                            If SearchDirection = 1 Then
                                NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.RightLink)
                            Else
                                NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.LeftLink)
                            End If
                            If NextCompToTest.GUID = 0 Then
                                Exit While
                            End If
                        End If
                        LoopTerminator = LoopTerminator + 1
                        If LoopTerminator > 100 Then
                            Return Nothing
                        End If
                    End While
                Next SearchDirection

                Dim NumOfCompInList As Integer = CompList.Count - 1
                Dim CurrentComp As Object
                Dim I As Integer
                For I = 0 To NumOfCompInList
                    CurrentComp = CompList(I)
                    If CurrentComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        Dim CurrentSwitch As Switch = CurrentComp
                        Dim CompInTurnOut As Object = Nothing
                        Dim ExpandingTurnOutSearchComplete As Boolean
                        Dim RouteInSwitch As Integer
                        Dim CompName As String
                        Dim LoopControl As Integer

                        For RouteInSwitch = 1 To 3
                            If CurrentSwitch.LeftAltLink <> 0 Then
                                If RouteInSwitch = 1 Then
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.LeftLink)
                                ElseIf RouteInSwitch = 2 Then
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.LeftAltLink)
                                Else
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.RightLink)
                                End If
                            ElseIf CurrentSwitch.RightAltLink <> 0 Then
                                If RouteInSwitch = 1 Then
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.RightLink)
                                ElseIf RouteInSwitch = 2 Then
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.RightAltLink)
                                Else
                                    CompInTurnOut = FindObjectTypeFromGUID(CurrentSwitch.LeftLink)
                                End If
                            End If

                            If IsNothing(CompInTurnOut) Then
                                TMDS.SystemUtilities.Utilities.SystemException("FindOsTracks-EXCEPTION-CurrentSwitch:" & CurrentSwitch.GUID & " - " & CurrentSwitch.Name)
                                Return Nothing
                            End If

                            CompName = CompInTurnOut.Name
                            While Not ExpandingTurnOutSearchComplete
                                If (CurrentSwitch.StationNumber = CompInTurnOut.StationNumber) And
                                (CompInTurnOut.Name = CompName) Then
                                    If Not CompList.Contains(CompInTurnOut) Then
                                        CompList.Add(CompInTurnOut)
                                    End If
                                    If CurrentSwitch.LeftAltLink <> 0 Then
                                        CompInTurnOut = FindObjectTypeFromGUID(CompInTurnOut.LeftLink)
                                    ElseIf CurrentSwitch.RightAltLink <> 0 Then
                                        CompInTurnOut = FindObjectTypeFromGUID(CompInTurnOut.RightLink)
                                    End If
                                    If CompInTurnOut.GUID = 0 Then
                                        Exit While
                                    End If
                                Else
                                    Exit While
                                End If
                                LoopControl = LoopControl + 1
                                If LoopControl > 100 Then
                                    LoopControl = 0
                                    Exit While
                                End If
                            End While
                        Next RouteInSwitch
                    End If
                Next I

                Return CompList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Sub CheckForSignalFleets()
            Try
                Dim Sig As Signal
                If Not IsNothing(Me.SignalSlotCollection) Then
                    For Each Sig In Me.SignalSlotCollection
                        If Sig.FleetEnabled Then
                            If Not Sig.ControlSignalToClear(True, True, True, False, False, False, False, False, True) Then
                                Sig.tmrFleetRetry.Enabled = True
                                Exit For
                            End If
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub SlotSignalRequests()
            Try
                Dim Sig As Signal
                If IsNothing(Me.SignalSlotCollection) Then Exit Sub

                For Each Sig In Me.SignalSlotCollection
                    If (Sig.SignalStatus = Signal.BulbStatus.ClearStatus Or Sig.SignalStatus = Signal.BulbStatus.RequestingClear) OrElse (optEnableMRSSpecificPTCOperations AndAlso Not Me.myControlPoint.Initialized) Then
                        'SyncLock Sig
                        If optEnableMRSSpecificPTCOperations Then
                            Me.PerformLicenseUpdateForMRS(Sig)
                        End If
                        Sig.SlotToStop()
                        'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                        Sig.SignalStatus = Signal.BulbStatus.StopStatus
                        'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                        Sig.SlottedByOSTrack = True
                        Sig.UpdateStatus()
                        Sig.InvalidateSignal()
                        'End SyncLock
                    Else
                        If Not Sig.Ctl(2) Is Nothing Then
                            If Sig.Ctl(2).BitState = False Then
                                If optEnableMRSSpecificPTCOperations Then
                                    Me.PerformLicenseUpdateForMRS(Sig)
                                End If

                                Sig.SlotToStop()
                                'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                                Sig.SignalStatus = Signal.BulbStatus.StopStatus
                                'ADDED TO SUPRESS UNSOLICATED SIGNAL STATE WHILE OS IS GOING DOWN AND SIGNAL IND HAS NOT YET BEEN PROCESSED TO STOP
                                Sig.SlottedByOSTrack = True
                                Sig.UpdateStatus()
                                Sig.InvalidateSignal()
                            End If
                        End If

                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

