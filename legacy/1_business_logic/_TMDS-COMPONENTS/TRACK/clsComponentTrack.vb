        Sub MoveMOWIDPlace(ByVal mow As MOWID, ByVal PreviousTrack As Track, ByVal LogOs As Boolean, Optional ByVal ShadowMode As Boolean = False)
            Try
                Dim CompCollection As ArrayList = CollectComponentsOfLikeTracks()
                Dim CompToCheck As Object = Nothing
                Dim NewTrackRef As Track = Nothing

                NewTrackRef = Me
                If Me.OStype Then
                    Dim trk As Object
                    For Each trk In Me.OsComponentCollection
                        If trk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If trk.TrainIDPlace And Not trk.NonTransverable Then
                                NewTrackRef = trk
                            End If
                        End If
                        If Not trk.Indicating Then
                            trk.Occuppied = True
                            trk.UpdateStatus()
                        End If

                    Next
                End If
                If NewTrackRef Is PreviousTrack Then
                    Exit Sub
                End If
                If MOWIDs.Count > 0 Then
                    NewTrackRef.MOWIDs.Insert(0, mow)
                Else
                    NewTrackRef.MOWIDs.Add(mow)
                End If
                If Not NewTrackRef.Indicating Then
                    NewTrackRef.Occuppied = True
                End If



                'Update the previous track
                PreviousTrack.MOWIDs.Remove(mow)


                'ARRC-1097 
                Dim DuplicateFound As Boolean = False
                For Each PossibleDuplicate As MOWID In PreviousTrack.MOWIDs
                    If PossibleDuplicate.myForman.EmployeeUID = mow.myForman.EmployeeUID Then
                        DuplicateFound = True
                        mow = PossibleDuplicate
                    End If
                Next
                If DuplicateFound Then
                    PreviousTrack.MOWIDs.Remove(mow)
                End If
                PreviousTrack.InvalidateMOWID()
                PreviousTrack.InitMOWDisplay()
                PreviousTrack.InvalidateMOWID()
                PreviousTrack.UpdateStatus()

                'Added this code from the mouse down event on OSTRAIN AND MOVE TRAIN 04-21-2003
                NewTrackRef.UpDateMOWIDPosition(ShadowMode)
                'ARRC-1090
                If Not gAssistMode Then NewTrackRef.InvalidateMOWID()
                NewTrackRef.InitMOWDisplay()
                NewTrackRef.UpdateStatus()
                NewTrackRef.RefreshRemotely()

                'If LogOs Then
                '    NewTrackRef.LogOsMessage(dbConnection)
                'End If
                '*******************************************************************************
                CompCollection = Nothing
                CompToCheck = Nothing
                NewTrackRef = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Sub UpDateMOWIDPosition(Optional ByVal ShadowMode As Boolean = False)
            Try
                If ShadowMode Then Exit Sub
                Dim MOWIDUpdateSQL As String
                Dim mow As MOWID

                If MOWIDs.Count > 0 Then
                    mow = MOWIDs.Item(0)
                    mow.TrackGUID = GUID
                Else
                    Exit Sub
                End If

                MOWIDUpdateSQL = "UPDATE " & gtblMOWActive
                MOWIDUpdateSQL = MOWIDUpdateSQL & " SET Symbol = " & "'" & mow.Name & "',"
                MOWIDUpdateSQL = MOWIDUpdateSQL & " Subdivision = " & "'" & Subdivision & "',"
                MOWIDUpdateSQL = MOWIDUpdateSQL & " TerritoryAssignmentID = " & "'" & TerritoryID & "',"
                MOWIDUpdateSQL = MOWIDUpdateSQL & " TrackGUID = " & "'" & mow.TrackGUID & "'"
                MOWIDUpdateSQL = MOWIDUpdateSQL & " WHERE Symbol = " & "'" & mow.Name & "'"
                SystemDatabaseCommandToDynamic("TRACK:UpDateMOWIDPosition", MOWIDUpdateSQL)

                'DatabaseCommand(MOWIDUpdateSQL, TMDS.GlobalDeclarations.gConnectionStringDyanmic)
                Dim LogTheEvent As New DoEventLogMowID(AddressOf mow.LogTheMowIDEvent)
                LogTheEvent.BeginInvoke(TMDS.TrainComponents.MOWID.EventTypeMowID.UPDATE, Nothing, Nothing)
                'ARRC-1097 : Put a check in to prevent a Assist Dispatch mode sending out the move MOW message
                If Not gAssistMode Then
                    mow.SendMowEvents(Me, MOWID.EventTypeMowID.MOVE)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

