#Region "RELEASE TRAIN"

        Private Sub CheckForDupicateTrains(ByVal TrainName As String)
            Try
                Dim trn As TrainID
                Dim TrainCollectionClone As ArrayList = TMDS.GlobalDeclarations.TrainCollection.Clone
                For Each trn In TrainCollectionClone
                    If trn.Name = TrainName Then
                        TrackEventLog("CheckForDupicateTrains:" & TrainName)
                        ReleaseTrainID(trn, TMDS.GlobalDeclarations.TrainCollection)
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        ''' <summary>
        ''' Release Train ID
        ''' </summary>
        ''' <param name="train">train for release</param>
        ''' <param name="trains">train list</param>
        ''' <param name="shadowMode">Shadow Mode</param>
        ''' <param name="isRemoteLinkRelease">Is Remote Link Release</param>
        Overloads Sub ReleaseTrainID(ByRef train As TrainID,
                                     ByRef trains As ArrayList,
                                     Optional shadowMode As Boolean = False,
                                     Optional isRemoteLinkRelease As Boolean = False)
            Try
                TrackEventLog($"{GetCurrentMethod.Name}:Start:Train={train.Name _
                              }:TrainCollectionCount={trains.Count _
                              }:ShadowMode={shadowMode _
                              }:IsRemoteLinkRelease={isRemoteLinkRelease}")
                train.IsBeingReleased = True
                Dim compCollection As ArrayList = CollectComponentsOfLikeTracks()
                If optEnableTrainOnAllLikeTracks Then
                    Dim likeComponents As ArrayList = FindLikeComponents(Me)
                    If likeComponents IsNot Nothing AndAlso likeComponents.Count > 0 Then
                        If compCollection Is Nothing Then compCollection = likeComponents
                    End If
                    For Each oneComponent As Object In likeComponents
                        If compCollection IsNot Nothing Then
                            If Not compCollection.Contains(oneComponent) Then compCollection.Add(oneComponent)
                        End If
                    Next
                End If
                Dim swToReleaseTrackLight As Switch = Nothing
                If compCollection IsNot Nothing Then
                    For Each oneComponent As Object In compCollection
                        Select Case oneComponent.GetType.ToString
                            Case "TMDS.TrackComponents.Track"
                                If Not oneComponent.Indicating Then oneComponent.Occuppied = False
                                oneComponent.UpdateStatus()
                            Case "TMDS.SwitchComponents.Switch"
                                swToReleaseTrackLight = oneComponent
                        End Select
                    Next
                    If Not IsNothing(swToReleaseTrackLight) Then
                        swToReleaseTrackLight.Occuppied = False
                        swToReleaseTrackLight.UpdateColorStatusOnly()
                    End If
                End If
                If TrainIDs.Count > 0 Then
                    TrackEventLog($"{GetCurrentMethod.Name}:Train {train.Name} on track:{GUID}:{Name}")
                    Dim storeTrainName As String = train.Name
                    train.TerminateSimulation()
                    train.ReleaseTrainAbbreviation(gTrainAbbreviation)
                    ReleaseTrainIDPosition(train)
                    train.TrainLinkedToMe = String.Empty
                    train.myTrainIDLinkedToMe = Nothing
                    Try
                        If train.myScheduleList IsNot Nothing AndAlso
                            train.myScheduleList.Count > 0 Then train.myScheduleList.Clear()
                        train.ScheduleTimer.Enabled = False
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    End Try
                    TrainIDs.Remove(train)
                    If isRemoteLinkRelease AndAlso
                        TrackAuthorities.Count > 0 AndAlso
                        TrackAuthority Then
                        Dim oneAuthority As Object = TrackAuthorities(0)
                        If oneAuthority IsNot Nothing AndAlso
                            oneAuthority.GetType.ToString = gTTComponentName Then
                            TrackEventLog($"{GetCurrentMethod.Name}:Authority found for train {train.Name}")
                            oneAuthority.HasTrainLeftDeskViaRemoteLink = True
                        End If
                    End If
                    If optEnableAutoRouting Then train.RemoveTacticalRoutesForTrain()
                    trains.Remove(train)
                    CheckForDupicateTrains(storeTrainName)
                    If TrainIDs.Count = 0 AndAlso
                        Not Indicating Then
                        Occuppied = False
                        TrafficDirection = String.Empty
                        SignalStatOnMe = SignalStatus.SignalAtStop
                    End If
                    If train.myLocomotiveReport IsNot Nothing Then
                        gLocomotiveCollection.Remove(train.myLocomotiveReport)
                        train.myLocomotiveReport.Dispose()
                        train.myLocomotiveReport = Nothing
                    End If
                    InvalidateTrainID()
                    InitTrainDisplay()
                    InvalidateTrainID()
                    UpdateStatus()
                    Dim logThisEvent As New DoEventLogTrainID(AddressOf train.LogTheTrainIDEvent)
                    logThisEvent.BeginInvoke(TrainID.EventTypeTrainID.RELEASE, Nothing, Nothing)
                    Dim publishThisEvent As New DoPublishTrainEvent(AddressOf train.PublishTrainEvent)
                    publishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.RELEASE, shadowMode, Nothing, Nothing)
                    Dim summItem As New SummaryItem("TRAIN", "RELEASE", train)
                    SyncLock gSummaryTrainQueue.SyncRoot
                        gSummaryTrainQueue.Enqueue(summItem)
                    End SyncLock
                    If (gAssistMode OrElse
                        (IsShadowMode AndAlso Not JointControl)) AndAlso
                        Not gMaintenanceMode Then
                        Dim CommandThisEvent As New DoCommandTrainEvent(AddressOf train.PublishTrainCommand)
                        CommandThisEvent.BeginInvoke(TrainID.EventTypeTrainID.RELEASE, shadowMode, Nothing, Nothing)
                    End If
                    If IsRemoteDatabaseLink Then
                        TrackEventLog($"{GetCurrentMethod.Name} Remove train {train.Name} from remote database")
                        PerformCleanUpDatabaseRecords(train)
                    End If
                    train.Dispose()
                    TrackEventLog($"{GetCurrentMethod.Name}:End:Release train {train.Name}")
                Else
                    TrackEventLog($"{GetCurrentMethod.Name}:End:No trains found on track {GUID}:{Name}")
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Release train id
        ''' </summary>
        ''' <param name="trainPosition">train Position</param>
        ''' <param name="trainCollection">train Collection</param>
        ''' <param name="shadowMode">shadow Mode</param>
        ''' <param name="suppressReleaseValidationMessage">suppress Release Validation Message</param>
        ''' <param name="autoReleaseFailed">auto Release Failed</param>
        ''' <param name="isRemoteLinkRelease">is Remote Link Release</param>
        Overloads Sub ReleaseTrainID(ByRef trainPosition As Integer,
                                     ByRef trainCollection As ArrayList,
                                     Optional shadowMode As Boolean = False,
                                     Optional suppressReleaseValidationMessage As Boolean = False,
                                     Optional ByRef autoReleaseFailed As Boolean = False,
                                     Optional isRemoteLinkRelease As Boolean = False)
            Try
                Dim components As ArrayList = CollectComponentsOfLikeTracks()
                If components IsNot Nothing Then
                    For Each component As GenericComponent In components
                        If TypeOf component Is Track Then
                            Dim track As Track = DirectCast(component, Track)
                            If Not track.Indicating Then track.Occuppied = False
                        ElseIf TypeOf component Is Switch Then
                            Dim switch As Switch = DirectCast(component, Switch)
                            switch.Occuppied = False
                            switch.UpdateColorStatusOnly()
                        End If
                    Next
                End If
                If TrainIDs IsNot Nothing AndAlso
                    trainPosition >= 0 AndAlso
                    TrainIDs.Count >= trainPosition Then
                    Dim train As TrainID = TrainIDs(trainPosition)
                    TrackEventLog($"{GetCurrentMethod.Name}:Release train {train.Name}")
                    train.IsBeingReleased = True
                    Dim trainName As String = train.Name
                    train.TerminateSimulation()
                    train.ReleaseTrainAbbreviation(gTrainAbbreviation)
                    train.TrainLinkedToMe = String.Empty
                    train.myTrainIDLinkedToMe = Nothing
                    Try
                        If train.myScheduleList IsNot Nothing AndAlso
                            train.myScheduleList.Count > 0 Then train.myScheduleList.Clear()
                        train.ScheduleTimer.Enabled = False
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    End Try
                    If isRemoteLinkRelease AndAlso
                        TrackAuthorities.Count > 0 AndAlso
                        TrackAuthority Then
                        Dim authority As Object = TrackAuthorities(0)
                        If authority IsNot Nothing AndAlso
                            authority.GetType.ToString = gTTComponentName Then
                            authority.HasTrainLeftDeskViaRemoteLink = True
                        End If
                    End If
                    train.DeleteClearanceForTrain(train.IdentifingUnit)
                    If optEnableAutoRouting Then train.RemoveTacticalRoutesForTrain()
                    ReleaseTrainIDPosition(train)
                    TrainIDs.Remove(train)
                    trainCollection.Remove(train)
                    CheckForDupicateTrains(trainName)
                    If TrainIDs.Count = 0 Then
                        If Not Indicating Then
                            Occuppied = False
                            SignalStatOnMe = SignalStatus.SignalAtStop
                        End If
                        If SimulateMode Then Occuppied = False
                        TrafficDirection = String.Empty
                    End If
                    If train.myLocomotiveReport IsNot Nothing Then
                        gLocomotiveCollection.Remove(train.myLocomotiveReport)
                        train.myLocomotiveReport.Dispose()
                        train.myLocomotiveReport = Nothing
                    End If
                    InvalidateTrainID()
                    InitTrainDisplay()
                    InvalidateTrainID()
                    InvalidateTrainIDMessageDisplay()
                    UpdateStatus()
                    Dim eventLog As New DoEventLogTrainID(AddressOf train.LogTheTrainIDEvent)
                    eventLog.BeginInvoke(TrainID.EventTypeTrainID.RELEASE, Nothing, Nothing)
                    Dim publishTrain As New DoPublishTrainEvent(AddressOf train.PublishTrainEvent)
                    publishTrain.BeginInvoke(TrainID.EventTypeTrainID.RELEASE, shadowMode, Nothing, Nothing)
                    train.Dispose()
                    train = Nothing
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function ValidateDate(ByVal DateString As String) As Boolean
            Try
                If DateString = "NONE" Or DateString = "" Then
                    Return False
                End If
                Try
                    Dim TestDate As Date = CDate(DateString)
                    Return True
                Catch
                    Return False
                End Try
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Function GetSubTrainSheets(ByVal trn As TrainID) As ArrayList
            Dim dbconn As OleDbConnection
            Try
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                Dim dbcomm As New OleDbCommand("Select ActiveSubTrainSheet FROM tblTrainsActiveSubTrainSheets WHERE symbol = '" & trn.Name & "'", dbconn)
                Dim SubList As New ArrayList()
                Dim dr As OleDbDataReader
                dbconn.Open()
                dr = dbcomm.ExecuteReader
                While dr.Read
                    If Not dr.IsDBNull(0) Then
                        SubList.Add(dr.GetString(0))
                    End If
                End While
                dbconn.Close()
                dbconn = Nothing
                Return SubList
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
                Return Nothing
            End Try
        End Function

        Overloads Sub FinalTrainID(ByVal train As TrainID, ByRef pTrainCollection As ArrayList, Optional ByVal ShadowMode As Boolean = False)
            Dim s As String = ","
            Dim q As String = "'"
            Dim LaunchPoint As New Point(Me.CurrentDrawingForm.Left + 100, Me.CurrentDrawingForm.Top + 150)
            If optEnableAutoPrintTrainRelease = True Then
                Try
                    Dim docTrn As New TMDS.PrintForms.TrainDocument()
                    Dim FileName As String = docTrn.BuildTrainDocument(train, True)
                    If System.IO.File.Exists(FileName) Then
                        If optPerformDocumentArchiving Then
                            TMDS.PrintForms.DocumentArchive.ArchiveTheDocument(FileName, "TRAIN-FINALED", train.Name, train.myTrack.TerritoryID, train.myTrack.SubdivisionID)
                        End If
                    End If
                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try
            End If

            Try
                If train IsNot Nothing AndAlso optReleaseTGBOOnTrainFinal AndAlso TMDS.SystemUtilities.FetchData.DoesTrainHasActiveTGBO(train.Name) > 1 Then
                    If Not IsOkToReleasePTCTrainTGBO(LaunchPoint, train) Then Exit Sub
                End If
                If optApplyTrainSheetConfigurationForKCT AndAlso train IsNot Nothing Then
                    If Not train.ValidatePaidMovementValues(True) Then
                        Exit Sub
                    Else
                        train.CreatePaidMoveEvent(True)
                    End If
                End If
                If optEnableARRCSpecificOptions AndAlso train IsNot Nothing Then
                    If Not gAssistMode AndAlso train.myTrack IsNot Nothing AndAlso train.myTrack.IsShadowMode Then Exit Sub

                    If Not train.ValidateDataWareHouseValues(True) Then
                        Exit Sub
                    ElseIf train.TrainType = "YARD" Then
                        If Not Me.ReleaseTGBO(train) Then Exit Sub
                    Else
                        train.UpdateUnitValueInDB(train.IdentifingUnit, "DistributivePower", False)
                    End If
                ElseIf optApplyTrainSheetConfigurationForDenver AndAlso Not IsOKTOFinalTrainDenver(train) Then
                    Exit Sub
                ElseIf optApplyTrainSheetConfigurationForMRL AndAlso Not IsOKToFinalTrainMRL(train) Then
                    Exit Sub
                End If
                Dim FileName As String = ""
                If optEnableArchiveTrainSheetSummaryOnFinal AndAlso train IsNot Nothing Then
                    Dim docTrn As New TMDS.PrintForms.TrainDocument()
                    FileName = docTrn.BuildTrainDocument(train)
                End If

                If optEnableARRCSpecificOptions Then PerformCleanUpDatabaseRecords(train)

                Dim CompCollection As New ArrayList
                CompCollection = CollectComponentsOfLikeTracks()
                Dim CompToCheck As Object = Nothing
                If optEnableTrainOnAllLikeTracks Then
                    Dim LikeComponents As ArrayList = FindLikeComponents(Me)
                    If LikeComponents IsNot Nothing AndAlso LikeComponents.Count > 0 Then
                        If CompCollection Is Nothing Then CompCollection = LikeComponents
                    End If
                    For Each CompToCheck In LikeComponents
                        If CompCollection IsNot Nothing Then
                            If Not CompCollection.Contains(CompToCheck) Then CompCollection.Add(CompToCheck)
                        End If
                    Next
                    CompToCheck = Nothing
                End If
                Dim swToReleaseTrackLight As Switch = Nothing
                If Not CompCollection Is Nothing Then
                    For Each CompToCheck In CompCollection
                        Select Case CompToCheck.GetType.ToString
                            Case "TMDS.TrackComponents.Track"
                                If Not CompToCheck.Indicating Then CompToCheck.Occuppied = False
                                CompToCheck.UpdateStatus()
                            Case "TMDS.SwitchComponents.Switch"
                                swToReleaseTrackLight = CompToCheck
                        End Select
                    Next
                    If Not IsNothing(swToReleaseTrackLight) Then
                        swToReleaseTrackLight.Occuppied = False
                        swToReleaseTrackLight.UpdateColorStatusOnly()
                    End If
                End If

                Dim trn As TrainID
                If TrainIDs.Count > 0 Then
                    trn = train 'TrainIDs(0)
                    Me.TrackEventLog("FINALING TRAIN:" & trn.Name & " ON TRACK:" & Me.GUID & " NAME:" & Me.Name)

                    TMDS.NetworkMessages.CadMessages.SendTrainEventForWabtecOne(trn, "DELETED")

                    trn.UpdateFinalTime()
                    trn.TerminateSimulation()
                    trn.ReleaseTrainAbbreviation(gTrainAbbreviation)
                    Dim LogThisEvent As New DoEventLogTrainID(AddressOf trn.LogTheTrainIDEvent)
                    LogThisEvent.BeginInvoke(TrainID.EventTypeTrainID.FINAL, Nothing, Nothing)

                    Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf trn.PublishTrainEvent)
                    PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.FINAL, ShadowMode, Nothing, Nothing)

                    If gAssistMode AndAlso Not (gMaintenanceMode OrElse (Me.IsShadowMode AndAlso Not Me.JointControl)) Then
                        Dim CommandThisEvent As New DoCommandTrainEvent(AddressOf trn.PublishTrainCommand)
                        CommandThisEvent.BeginInvoke(TrainID.EventTypeTrainID.FINAL, ShadowMode, Nothing, Nothing)
                    End If
                    Try
                        If trn.myScheduleList IsNot Nothing AndAlso trn.myScheduleList.Count > 0 Then trn.myScheduleList.Clear()
                        trn.ScheduleTimer.Enabled = False
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    End Try

                    pTrainCollection.Remove(trn)
                    TrainIDs.Remove(trn)
                    If TrainIDs.Count = 0 Then
                        If Not Me.Indicating Then
                            Occuppied = False
                            Me.TrafficDirection = ""
                            Me.SignalStatOnMe = SignalStatus.SignalAtStop
                        End If
                        If Me.SimulateMode Then Occuppied = False
                    End If
                    Me.InvalidateTrainID()
                    InitTrainDisplay()
                    InvalidateTrainID()
                    trn.CleanUpTrainRecords()
                    UpdateStatus()
                    Try
                        Dim SummItem As New SummaryItem("TRAIN", "FORCE-REFRESH", trn)
                        SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                            TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                        End SyncLock
                    Catch ex As Exception
                    End Try

                    If gAssistMode Then
                        Try
                            Dim SummItem As New SummaryItem("TRAIN", "FORCE-REFRESH-SYSTEM-TRAINS", trn)
                            SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue
                                TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                            End SyncLock
                        Catch ex As Exception
                        End Try
                    End If

                    If optEnableAutoTrainPositionFromScheduleLink Then
                        AutoPositionTrainSymbolLink(train)
                    End If

                    PerformCleanUpDatabaseRecords(train)
                    If optDisableUnitDPStatusOnFinal Then trn.DisableDPStatusOnUnitsInDB()
                    If optDisableUnitPTCStatusOnFinal Then trn.DisablePTCStatusOnUnitInDB(trn.IdentifingUnit)

                    trn.Dispose()
                    If optEnableArchiveTrainSheetSummaryOnFinal AndAlso trn IsNot Nothing AndAlso FileName IsNot Nothing AndAlso FileName.Trim <> "" Then
                        Dim TerritoryID As Integer = 0
                        Dim SubdivisionID As Integer = 0
                        If Me.myTerritory IsNot Nothing Then TerritoryID = Me.myTerritory.TerritoryID
                        If Me.mySubdivision IsNot Nothing Then SubdivisionID = Me.mySubdivision.GUID
                        ArchivePDF(FileName, "TRAINSHEET", trn.Name, TerritoryID, SubdivisionID)
                    End If
                Else
                    Me.TrackEventLog("ATTEMPT TO FINAL TRAIN UNSUCCESSFUL ON TRACK:" & Me.GUID & " NAME:" & Me.Name)
                End If

                TMDS.NetworkMessages.CadMessages.SendTrainSymbolDelete(train, gCadTransmitQueue, "D")

                trn = Nothing
                CompCollection = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

