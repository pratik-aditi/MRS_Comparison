        ''' <summary>
        ''' Finds the first signal in current selection.
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Function FindFirstSignalInCurrentSelection() As Signal

            Dim firstSignal As Signal = Nothing

            For Each tmdsComponent As Object In gEntExtTrackSelection

                If tmdsComponent.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                    firstSignal = tmdsComponent
                    Exit For
                End If

            Next

            Return firstSignal

        End Function

