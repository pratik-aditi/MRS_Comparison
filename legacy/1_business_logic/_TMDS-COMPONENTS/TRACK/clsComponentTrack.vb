        Private Sub CheckToTrackTrainSymbol()
            Try
                If Me.TrackAuthorities.Count > 0 Then
                    Dim auth As SFAuthority = Nothing
                    Dim authToTest As SFAuthority
                    For Each authToTest In Me.TrackAuthorities
                        If authToTest.IssuedToTrain Then
                            auth = authToTest
                            Exit For
                        End If
                    Next
                    If IsNothing(auth) Then Exit Sub

                    If auth.Direction = "RIGHT" And auth.AuthType1 = "ItemTwoToTrain" Then
                        Dim tz As TrackZone = Me.TrackZoneReference
                        Dim FirstTrack As Track = tz.TrackList.Item(0)
                        Dim NextZoneTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FirstTrack.LeftLink)
                        'Added to Fix BNSF RMT 5170. 
                        If FirstTrack.OsComponentCollection IsNot Nothing AndAlso FirstTrack.OsComponentCollection.Count > 0 Then
                            If FirstTrack.NonTransverable Then
                                Dim Sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(FirstTrack)
                                If Sw.ControlledReverse Then
                                    If Sw.LeftAltLink > 0 Then FirstTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Sw.LeftAltLink)
                                    If Sw.RightAltLink > 0 Then FirstTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Sw.RightAltLink)
                                Else
                                    FirstTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Sw.LeftLink)
                                End If
                                NextZoneTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FirstTrack.LeftLink)
                            End If
                        End If

                        'Dim NextZoneTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FirstTrack.LeftLink)
                        If Not IsNothing(NextZoneTrack) Then
                            If NextZoneTrack.Occuppied Then
                                TrackTrainSymbol(auth.Direction, NextZoneTrack.TrackZoneReference, auth)
                            End If
                        End If
                    ElseIf auth.Direction = "LEFT" And auth.AuthType1 = "ItemTwoToTrain" Then
                        Dim tz As TrackZone = Me.TrackZoneReference
                        Dim FirstTrack As Track = tz.TrackList.Item(tz.TrackList.Count - 1)
                        Dim NextZoneTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FirstTrack.RightLink)
                        'Added to Fix BNSF RMT 5170. 

                        If FirstTrack.OsComponentCollection IsNot Nothing AndAlso FirstTrack.OsComponentCollection.Count > 0 Then
                            If FirstTrack.NonTransverable Then
                                Dim Sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(FirstTrack)
                                If Sw.ControlledReverse Then
                                    If Sw.LeftAltLink > 0 Then FirstTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Sw.LeftAltLink)
                                    If Sw.RightAltLink > 0 Then FirstTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Sw.RightAltLink)
                                Else
                                    FirstTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Sw.RightLink)

                                End If
                                NextZoneTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FirstTrack.RightLink)
                            End If
                        End If

                        If Not IsNothing(NextZoneTrack) Then
                            If NextZoneTrack.Occuppied Then
                                If NextZoneTrack.AuthorityType = "TWC" And Not NextZoneTrack.TrackZoneIntegrityMonitoringEnabled Then
                                    Dim trn As TrainID
                                    For Each trn In NextZoneTrack.TrainIDs
                                        If (trn.Name = auth.TrainSymbol Or trn.IdentifingUnit = Mid(auth.IssueTo, 1, 10)) And auth.IssuedToTrain Then
                                            If Me.Occuppied Then
                                                Me.MoveTrainIDPlaceManual(trn, NextZoneTrack, False, Nothing, False, True)
                                            End If
                                        End If
                                    Next
                                Else
                                    TrackTrainSymbol(auth.Direction, NextZoneTrack.TrackZoneReference, auth)
                                End If
                            End If
                        End If
                    ElseIf auth.AuthType1 = "ItemFourToTrain" Then
                        Dim tz As TrackZone = Me.TrackZoneReference
                        Dim FirstTrack As Track = tz.TrackList.Item(0)
                        Dim NextZoneTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FirstTrack.LeftLink)
                        If Not IsNothing(NextZoneTrack) Then
                            If NextZoneTrack.Occuppied Then
                                TrackTrainSymbol(auth.Direction, NextZoneTrack.TrackZoneReference, auth)
                            End If
                        End If
                        Dim tz1 As TrackZone = Me.TrackZoneReference
                        Dim FirstTrack1 As Track = tz1.TrackList.Item(tz1.TrackList.Count - 1)
                        Dim NextZoneTrack1 As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(FirstTrack1.RightLink)
                        If Not IsNothing(NextZoneTrack1) Then
                            If NextZoneTrack1.Occuppied Then
                                TrackTrainSymbol(auth.Direction, NextZoneTrack1.TrackZoneReference, auth)
                            End If
                        End If
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub TrackTrainSymbol(ByVal Direction As String, ByVal tz As TrackZone, ByVal auth As SFAuthority)
            Dim trnIDCollection As New ArrayList
            Dim TrackZoneReferenceCollection As New ArrayList
            Dim TrackListCollection As New ArrayList
            Try
                Dim trk As Track
                Dim trn As TrainID
                If Me.Occuppied Then
                    CopyArrayCollection(TrackListCollection, tz.TrackList)
                    For Each trk In TrackListCollection
                        If trk.TrainIDs.Count > 0 Then
                            CopyArrayCollection(trnIDCollection, trk.TrainIDs)
                            For Each trn In trnIDCollection
                                If (trn.Name = auth.TrainSymbol Or trn.IdentifingUnit = Mid(auth.IssueTo, 1, 10)) And auth.IssuedToTrain Then
                                    Me.MoveTrainIDPlaceManual(trn, trk, False, Nothing, False, True)
                                End If
                            Next
                        End If
                    Next
                Else
                    Dim FirstTrack As Track = tz.TrackList.Item(0)
                    CopyArrayCollection(TrackZoneReferenceCollection, Me.TrackZoneReference.TrackList)
                    For Each trk In TrackZoneReferenceCollection
                        If trk.TrainIDs.Count > 0 Then
                            CopyArrayCollection(trnIDCollection, trk.TrainIDs)
                            For Each trn In trnIDCollection
                                If (trn.Name = auth.TrainSymbol Or trn.IdentifingUnit = Mid(auth.IssueTo, 1, 10)) And auth.IssuedToTrain Then
                                    FirstTrack.MoveTrainIDPlaceManual(trn, trk, False, Nothing, False, True)
                                End If
                            Next
                        End If
                    Next

                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                trnIDCollection = Nothing
                TrackListCollection = Nothing
                TrackZoneReferenceCollection = Nothing
            End Try
        End Sub

