                                    Case Else
                                        Train.DisplayText = "<>" & Train.DisplayText
                                End Select
                            Else
                                Select Case Train.Direction
                                    Case optDirectionNorth, optDirectionEast
                                        Train.DisplayText = "<" & Train.DisplayText
                                    Case optDirectionSouth, optDirectionWest
