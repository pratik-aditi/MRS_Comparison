                                                        trn2.TrackingDirection = "RIGHT"
                                                        If Me.OStype Then
                                                            CompToCheck.PushTrainIDToNextOccupancy(Me, trn2, "RIGHT")
                                                        End If
                                                    End If
                                                    SearchLeftComplete = True
                                                    SearchRightComplete = True
                                                    Exit While
                                                End If
                                            End If
                                            'SearchLeftComplete = True
                                            'Exit While
                                            'this code to to look backwards for a Train ID until a unoccupied OS is found
                                            If Not CompToCheck.OStype Then
                                                NextReferenceNumber = CompToCheck.LeftLink
                                            Else
                                                SearchLeftComplete = True
                                                SearchRightComplete = True
                                                Exit While
                                            End If
                                        End If
                                    End If
                                End If
                            ElseIf CompToCheck.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                                'Dim ff As FlipFlop
                                NextReferenceNumber = CompToCheck.FindExitGUID(LastRefNumber)
