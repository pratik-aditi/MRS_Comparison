                If Not IsNothing(LeftSig) Then
                    'RightSigBehind = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(LeftSig.RightLink)
                End If

                If Not IsNothing(RightSig) Then
                    'LeftSigBehind = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(RightSig.LeftLink)
                End If

                If Not IsNothing(RightSig) Then
                    If RightSig.SignalStatus = Signal.BulbStatus.ClearStatus Or RightSig.SignalStatus = Signal.BulbStatus.RequestingClear Then
