#Region " PSS REMOTE SIGNAL REQUEST "

        Public Function GetRemoteSignalStatus(ByVal Direction As String) As Boolean
            Try

                Dim LeftTrack As Object = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.LeftLink)
                Dim RightTrack As Object = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.RightLink)

                If Not LeftTrack Is Nothing Then
                    If LeftTrack.IsRemoteTrack Then
                        If LeftTrack.myRemoteTrack.SendPSSRequestOK(Direction) Then
                            Return True
                        Else
                            Return False
                        End If
                    End If
                End If

                If Not RightTrack Is Nothing Then
                    If RightTrack.IsRemoteTrack Then
                        If RightTrack.myRemoteTrack.SendPSSRequestOK(Direction) Then
                            Return True
                        Else
                            Return False
                        End If
                    End If
                End If

                Dim LeftAltTrack As Object = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.LeftAltLink)
                Dim RightAltTrack As Object = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.RightAltLink)
                If Not LeftAltTrack Is Nothing Then
                    If LeftAltTrack.IsRemoteTrack Then
                        If LeftAltTrack.myRemoteTrack.SendPSSRequestOK(Direction) Then
                            Return True
                        Else
                            Return False
                        End If
                    End If
                End If

                If Not RightAltTrack Is Nothing Then
                    If RightAltTrack.IsRemoteTrack Then
                        If RightAltTrack.myRemoteTrack.SendPSSRequestOK(Direction) Then
                            Return True
                        Else
                            Return False
                        End If
                    End If
                End If

                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Function

