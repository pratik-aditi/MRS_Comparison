#Region "DERAILMENT DETECTOR"

        Private Sub DerailmentDetectorUpdateStatus()
            Try
                If Me.DerailmentDetectorInhibited Or Not Me.DerailmentDetectorIndBit.BitState Then
                    If DerailmentDetectorDoesAlertExist() Then
                        If Me.DerailmentDetectorInhibited Then
                            DerailmentDetectorRemoveAlert("DISPATCHER INHIBITED THE DETECTOR")
                        End If
                    End If
                    Me.DerailmentDetectorAlarmAcknowledged = True
                    Me.DerailmentDetectorDisplayHatch = False
                    Me.UpdateStatus()
                    Exit Sub
                End If

                If Me.DerailmentDetectorIndBit.BitState Then
                    Me.DerailmentDetectorDisplayHatch = True
                    If DerailmentDetectorDoesAlertExist() Then
                        Me.DerailmentDetectorCreateAlert()
                    End If
                    Me.UpdateStatus()
                End If


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DerailmentDetectorUpdateDatabase()
            Try
                Dim dbUpdate As String = "UPDATE tblCompTracks SET DerailmentDetectorInhibited = " & CInt(DerailmentDetectorInhibited) & " WHERE UID = " & Me.GUID
                SystemDatabaseCommandToStatic("TRACK:DerailmentDetectorUpdateDatabase", dbUpdate)
                TMDS.SystemUtilities.Utilities.SystemEvent("DERAILMENT DETECTOR INHIBITED FOR " & Me.Name)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function DerailmentDetectorDoesAlertExist() As Boolean
            Try
                If Me.DerailmentDetectorAlarmAcknowledged Then Return True
                Dim al As Alert
                Dim AlertMessage As String = optDerailmentDetectorString3 & Space(1) & Me.TrackName & " - " & Me.Name

                Dim RemoveList As New ArrayList
                SyncLock TMDS.GlobalDeclarations.gSystemAlertList
                    For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                        Select Case al.TypeOfAlert
                            Case ManagementClasses.Alert.AlertType.DerailmentDetector
                                If al.AlertData = AlertMessage Then
                                    Return True
                                End If
                        End Select
                    Next
                End SyncLock
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Private Sub DerailmentDetectorRemoveAlert(ByVal ReasonToRemove As String)
            Try
                Dim AlertMessage As String = optDerailmentDetectorString3 & Space(1) & Me.TrackName & " - " & Me.Name
                Dim al As Alert
                Dim RemoveList As New ArrayList
                SyncLock TMDS.GlobalDeclarations.gSystemAlertList
                    For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                        Select Case al.TypeOfAlert
                            Case ManagementClasses.Alert.AlertType.DerailmentDetector
                                If al.AlertData = AlertMessage Then
                                    al.AlertAcknowledged = True
                                    Dim Message As String = "DERAILMENT ALERT WAS ACKNOWLEDGED BY SYSTEM " & ReasonToRemove
                                    al.AlertAckedByPerson = Message
                                    TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                                    gSystemAlertExists = False
                                    Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al)
                                    SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                        TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                    End SyncLock
                                    RemoveList.Add(al)
                                End If
                        End Select
                    Next
                    For Each al In RemoveList
                        TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                    Next
                End SyncLock
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DerailmentDetectorCreateAlert()
            Try
                Dim AlertMessage As String = optDerailmentDetectorString3 & Space(1) & Me.TrackName & " - " & Me.Name
                TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.DerailmentDetector, AlertMessage, Nothing, Nothing, Nothing, Me)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

