        ''' <summary>
        ''' Track train request
        ''' </summary>
        ''' <param name="sender"></param>
        ''' <param name="e"></param>
        Private Sub mnuRemoteTrackTrainRequest_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try
                TrackEventLog("Clicked - REQUEST TRAIN SYMBOL")
                If myLeftRemoteLinkedTrack Is Nothing Then
                    myLeftRemoteLinkedTrack = FetchData.FindRemoteTrackItemFromGUID(LeftLink)
                End If
                If myRightRemoteLinkedTrack Is Nothing Then
                    myRightRemoteLinkedTrack = FetchData.FindRemoteTrackItemFromGUID(RightLink)
                End If
                If myRightRemoteLinkedTrack IsNot Nothing Then
                    Dim symbol As String = myRightRemoteLinkedTrack.myRemoteTrack.RequestTrainID("LEFT")
                    If Not String.IsNullOrEmpty(symbol) Then
                        myRightRemoteLinkedTrack.myRemoteTrack.PlaceTrainID(symbol)
                        Dim leftTrack As Track = myRightRemoteLinkedTrack.myRemoteTrack.myLeftTrack
                        If leftTrack.TrainIDs.Count > 0 Then
                            Dim train As TrainID = leftTrack.TrainIDs.Item(0)
                            MoveTrainIDPlace(train, leftTrack, OStype, gDatabaseConnectionTrain, "T", TrafficDirection)
                        End If
                    End If
                End If
                If myLeftRemoteLinkedTrack IsNot Nothing Then
                    Dim symbol As String = myLeftRemoteLinkedTrack.myRemoteTrack.RequestTrainID("RIGHT")
                    If Not String.IsNullOrEmpty(symbol) Then
                        myLeftRemoteLinkedTrack.myRemoteTrack.PlaceTrainID(symbol)
                        Dim rightTrack As Track = myLeftRemoteLinkedTrack.myRemoteTrack.myRightTrack
                        If rightTrack.TrainIDs.Count > 0 Then
                            Dim train As TrainID = rightTrack.TrainIDs.Item(0)
                            MoveTrainIDPlace(train, rightTrack, OStype, gDatabaseConnectionTrain, "T", TrafficDirection)
                        End If
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoTrackLinkReset()
            Try
                If Not IsNothing(Me.myRemoteConnection) Then
                    Me.myRemoteConnection.SendRetrieveTag()
                    Me.myRemoteConnection.SendRemoteLinkObjectStatus()
                End If

                Dim LeftLink As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.LeftLink)
                Dim RightLink As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.RightLink)

                If Not IsNothing(LeftLink) Then
                    If LeftLink.IsRemoteTrack Then
                        Me.TrackEventLog("RESETTING REMOTE TRACK LINK:" & LeftLink.GUID.ToString)
                        LeftLink.myRemoteTrack.theNetworkConnecton.CloseClientConnection()
                    End If
                End If
                If Not IsNothing(RightLink) Then
                    If RightLink.IsRemoteTrack Then
                        Me.TrackEventLog("RESETTING REMOTE TRACK LINK:" & RightLink.GUID.ToString)
                        RightLink.myRemoteTrack.theNetworkConnecton.CloseClientConnection()
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub
