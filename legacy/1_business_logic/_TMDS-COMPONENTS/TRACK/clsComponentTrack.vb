                    Message = Message & vbTab & "(GUID:" & comp.GUID.ToString.PadLeft(6, "0") & ") (TYPE:" & comp.GetType.ToString & ")" & vbCrLf
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Message = Message & vbTab & "OCCUPPIED=" & comp.Occuppied.ToString & " TRAFFIC=" & comp.TrafficDirection & " BLOCKING=" & comp.BlockAbsolute & " TRACKSTATUS=" & comp.SignalStatOnMe & vbCrLf
                    ElseIf comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        Message = Message & vbTab & "OCCUPPIED=" & comp.Occuppied.ToString & " TRAFFIC=" & comp.TrafficDirection & " BLOCKING=" & comp.BlockAbsolute & " SWITCHSTATUS=" & comp.SignalStatOnMe & vbCrLf
                    ElseIf comp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        Message = Message & vbTab & " BLOCKING=" & comp.BlockAbsolute & " CTLSTATUS=" & comp.SignalCtlStatus & " INDSTATUS=" & comp.SignalIndStatus & vbCrLf
                    End If
                    Message = Message & vbCrLf
                Next
                TrackEventLog(Message)
                Message = ""

