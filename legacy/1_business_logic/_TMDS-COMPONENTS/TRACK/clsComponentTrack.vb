        Private Sub DoRemoveLicense()
            Dim comp As Object
            Dim NoAuthoritiesFound As Boolean
            Try

                TrackEventLog("DoRemoveLicense:" & Me.GUID.ToString)
                If Me.TrackAuthorities Is Nothing Then
                    NoAuthoritiesFound = True
                ElseIf Me.TrackAuthorities.Count = 0 Then
                    NoAuthoritiesFound = True
                End If
                If NoAuthoritiesFound Then
                    ClearSystemVariables()
                    Exit Sub
                End If
                Dim auth As TrackAuthority.TrackAuthority = Me.TrackAuthorities.Item(0)
                If Not IsNothing(gRemoveLicenseTrainSelectedID) Then
                    auth = Nothing
                    Dim tnt As TrackAuthority.TrackAuthority
                    For Each tnt In Me.TrackAuthorities
                        If tnt.TrainSymbol = gRemoveLicenseTrainSelectedID.Name Then
                            auth = tnt
                            Exit For
                        End If
                    Next
                End If

                If IsNothing(auth) OrElse Me.Occuppied Then
                    ClearSystemVariables()
                    Exit Sub
                End If

                If IsNothing(auth) Then
                    If Me.IsLinkToRemoteTrack Then
                        Dim theRemoteTrack As Track
                        If Me.AltLinkOne <> 0 Then
                            theRemoteTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.AltLinkOne)
                        Else
                            theRemoteTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.AltLinkTwo)
                        End If
                        If IsNothing(theRemoteTrack) Then Exit Sub

                    End If
                End If
                If Not IsNothing(auth.myTrain) Then
                    If Not auth.myTrain.IsActivePTC And Not auth.myTrain.GeoFenceLegacyEnabled Then
                        Exit Sub
                    End If
                End If

                If Me.OStype Then
                    If Not IsNothing(Me.OsComponentCollection) Then
                        For Each comp In Me.OsComponentCollection
                            If comp.TrackAuthorities.Count > 0 Then
                                auth.ComponentsInSelection.Remove(comp)
                                comp.TrackAuthorities.Remove(auth)
                                comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                If comp.TrackAuthorities.Count = 0 Then
                                    comp.TrackAuthority = False
                                    comp.TrafficDirection = ""
                                End If
                                comp.UpdateStatus()
                            End If
                        Next
                        auth.UpdateDatabaseWithCompList("DoRemoveLicense1")
                        TrackEventLog("DoRemoveLicense1:" & Me.GUID.ToString)
                    End If
                End If

                If Me.TrackAuthorities.Count > 0 Then
                    auth.ComponentsInSelection.Remove(Me)
                    Me.TrackAuthorities.Remove(auth)
                    Me.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                    If Me.TrackAuthorities.Count = 0 Then
                        Me.TrackAuthority = False
                        Me.TrafficDirection = ""
                    End If
                    Me.UpdateStatus()
                    auth.UpdateDatabaseWithCompList("DoRemoveLicense2")
                    TrackEventLog("DoRemoveLicense2:" & Me.GUID.ToString)
                End If

                If auth.ComponentsInSelection.Count = 0 Then
                    If auth.RemoveActiveAuthorityFromDB(Nothing) Then
                        If auth.RemoveActiveAuthorityFromComponents(Nothing) Then
                            auth.RemoveTrackAuthFromRemoteLinks()
                        End If
                    End If
                    OtherTrackAuthorities.Remove(auth)
                    Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", auth)
                    SyncLock gSummaryAuthQueue.SyncRoot
                        gSummaryAuthQueue.Enqueue(SummItem)
                    End SyncLock
                    TrackEventLog("DoRemoveLicense3:" & Me.GUID.ToString)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Find Like Tracks With Same Indication
        ''' </summary>
        ''' <returns></returns>
        Private Function FindLikeTracksWithSameIndication() As ArrayList
            Dim theList As New ArrayList
            Dim trk As Track
            Try
                For Each trk In TrackCollection
                    If trk.Indicating AndAlso Not trk.OStype Then
                        If Not IsNothing(trk.Ind(0)) AndAlso Not IsNothing(Me.Ind(0)) Then
                            If trk.Ind(0).ControlPoint = Me.Ind(0).ControlPoint AndAlso trk.Ind(0).Codeline = Me.Ind(0).Codeline AndAlso trk.Ind(0).CodeStation = Me.Ind(0).CodeStation AndAlso trk.Ind(0).PositionOfBit = Me.Ind(0).PositionOfBit Then
                                theList.Add(trk)
                            End If
                        End If
                    End If
                Next
                Return theList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                theList = Nothing
                trk = Nothing
            End Try
        End Function

        Private Sub DoChangeOccupany()
            Dim LikeArray As New ArrayList
            Dim comp As Object = Nothing
            Try
                LikeArray = FindLikeTracksWithSameIndication()
                If TMDS.GlobalDeclarations.gSimulationMode Then
                    Dim BitState As Boolean
                    If Me.Occuppied = True Then
                        If Not Me.Ind(0) Is Nothing Then
                            Me.Ind(0).BitState = False
                            Me.ApplyIndicationChange()
                            BitState = False
                            'If optEnableTrainOnAllLikeTracks Then
                            If LikeArray IsNot Nothing AndAlso LikeArray.Count > 1 Then
                                For Each comp In LikeArray
                                    If comp.GetType.ToString = gTrackComponentName Then
                                        If Not comp Is Me Then
                                            comp.Ind(0).BitState = False
                                            comp.ApplyIndicationChange()
                                            comp.UpdateStatus()

                                        End If
                                    End If
                                Next
                            End If
                            'End If
                        Else
                            Me.Occuppied = False
                            Me.TrafficDirection = ""
                            'If optEnableTrainOnAllLikeTracks Then
                            If LikeArray IsNot Nothing AndAlso LikeArray.Count > 1 Then
                                For Each comp In LikeArray
                                    If comp.GetType.ToString = gTrackComponentName Then
                                        If Not comp Is Me Then
                                            comp.Occuppied = False
                                            comp.TrafficDirection = ""
                                            comp.UpdateStatus()

                                        End If
                                    End If
                                Next
                            End If
                            'End If
                        End If
                    Else
                        If Not Me.Ind(0) Is Nothing Then
                            Me.Ind(0).BitState = True
                            Me.ApplyIndicationChange()
                            BitState = True
                            'If optEnableTrainOnAllLikeTracks Then
                            If LikeArray IsNot Nothing AndAlso LikeArray.Count > 1 Then
                                For Each comp In LikeArray
                                    If comp.GetType.ToString = gTrackComponentName Then
                                        If Not comp Is Me Then
                                            comp.Ind(0).BitState = True
                                            comp.ApplyIndicationChange()
                                            comp.UpdateStatus()
                                        End If
                                    End If
                                Next
                            End If
                            'End If
                        Else
                            Me.Occuppied = True
                            'If optEnableTrainOnAllLikeTracks Then
                            If LikeArray IsNot Nothing AndAlso LikeArray.Count > 1 Then
                                For Each comp In LikeArray
                                    If comp.GetType.ToString = gTrackComponentName Then
                                        If Not comp Is Me Then
                                            comp.Occuppied = True
                                            comp.UpdateStatus()
                                        End If
                                    End If
                                Next
                            End If
                            ' End If
                        End If

                    End If
                    Me.UpdateStatus()
                    If optEnableTrainOnAllLikeTracks Then
                        If LikeArray IsNot Nothing AndAlso LikeArray.Count > 1 Then
                            For Each comp In LikeArray
                                If comp.GetType.ToString = gTrackComponentName Then
                                    If Not comp Is Me Then
                                        comp.UpdateStatus()
                                    End If
                                End If
                            Next
                        End If
                    End If
                    If Not IsNothing(Me.OsComponentCollection) Then
                        comp = Nothing
                        For Each comp In Me.OsComponentCollection
                            If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim trk As Track = CType(comp, Track)
                                If trk.GUID <> Me.GUID Then
                                    If Not trk.Ind(0) Is Nothing Then
                                        trk.Ind(0).BitState = BitState
                                        trk.ApplyIndicationChange()
                                        trk.UpdateStatus()
                                    End If
                                End If
                            End If
                        Next
                    End If
                Else
                    If Not Me.Indicating Then
                        If Me.Occuppied = True Then
                            Me.Occuppied = False
                            Me.TrafficDirection = ""
                        Else
                            Me.Occuppied = True
