        Public Function IsTrain(ByVal e As System.Windows.Forms.MouseEventArgs) As Boolean
            If TrainIDText Is Nothing Then Return False
            If TrainIDText.GraphicalPath.IsVisible(e.X, e.Y) Then
                If Me.TrainIDs.Count Then
                    Dim train As TrainID = Me.TrainIDs(0)
                    Me.TrackEventLog("MOUSE DOWN TRAIN (" & train.Name & ")")
                    If optEnableMRSSpecificPTCOperations Then
                        If train.IsActivePTC Then
                            train.ClickedOnTrainForLicense = True
                            If train.SendCTConly Then
                                train.SendCTConly = False
                            End If
                        End If
                    End If
                End If
                IsTrain = True
            Else
                IsTrain = False
            End If
        End Function

        Sub AddTrainID(ByVal Train As TrainID, Optional ByVal PerformSortTrain As Boolean = False)
            Try
                'CHECK TO MAKE SURE NOT TRYING TO PLACE ON REMOTETRACK
                If Me.IsRemoteTrack Then
                    Me.TrackEventLog("AddTrainID:REMOTE TRACK:Train=" & Train.Name)
                    If Not IsNothing(Me.myRemoteTrack.myLeftTrack) Then
                        Me.myRemoteTrack.myLeftTrack.AddTrainID(Train)
                        Exit Sub
                    End If
                    If Not IsNothing(Me.myRemoteTrack.myRightTrack) Then
                        Me.myRemoteTrack.myRightTrack.AddTrainID(Train)
                        Exit Sub
                    End If
                End If

                Me.TrackEventLog("AddTrainID:Train=" & Train.Name & ":IdentifingUnit=" & Train.IdentifingUnit)

                If optRailRoadName.Contains("MRS") AndAlso Train.Name.Length > 7 Then
                    Me.TrackEventLog("AddTrainID:Train is not a symbol valid. Train=" & Train.Name & ":IdentifingUnit=" & Train.IdentifingUnit)
                    Exit Sub
                End If

                Train.DisplayPseudoName = gDisplayPseudo
                Train.DisplayEngineID = gDisplayEngineID
                Train.DisplayAbbreviation = gDisplayAbbrev

                'Me.TrackEvent("AddTrainID:" & Me.GUID.ToString)
                If Not TrainIDs.Contains(Train) Then
                    If VerifyForTrainIDDuplicates(Train) Then
                        If Not TrainCollection.Contains(Train) Then
                            TrainCollection.Add(Train)
                            If optEnablePTCBOSAPIMode And gInitialized Then TMDS.NetworkMessages.PTCBOSAPIMessaging.SendLocomotiveRequestMessageStatus(Train)
                        End If
                        TrainIDs.Add(Train)
                        Train.StackOrder = Me.TrainIDs.IndexOf(Train)
                        InitTrainDisplay()
                    End If
                End If

                If PerformSortTrain Then
                    Dim NewList As New ArrayList()
                    Dim HighWater As Date
                    Dim TrnList As ArrayList = Me.TrainIDs.Clone
                    Dim trn As TrainID = Nothing
                    Dim TrnToInsert As TrainID = Nothing
                    While NewList.Count <> TrnList.Count
                        For Each trn In Me.TrainIDs 'TrnList
                            If trn.DepTime > HighWater Then
                                HighWater = trn.DepTime
                                TrnToInsert = trn
                            End If
                        Next
                        If Not IsNothing(TrnToInsert) Then
                            Me.TrainIDs.Remove(TrnToInsert)
                            NewList.Add(TrnToInsert)
                            TrnToInsert = Nothing
                            HighWater = Nothing
                        Else
                            Exit While
                        End If
                    End While
                    NewList.Reverse()
                    Me.TrainIDs.Clear()
                    For Each trn In NewList
                        Me.TrainIDs.Add(trn)
                        trn.StackOrder = Me.TrainIDs.IndexOf(trn)
                    Next
                    InitTrainDisplay()
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function VerifyForTrainIDDuplicates(ByVal Train As TrainID) As Boolean
            Try
                TrackEventLog("VerifyForTrainIDDuplicates:Train=" & Train.Name)
                Dim ViewTrainFound As Boolean
                Dim ViewTrain As TrainID = Nothing
                Dim trn As TrainID = Nothing

                For Each trn In TrainCollection
                    If trn.Name = Train.Name Then
                        If trn.ReadOnlySymbol Then
                            ViewTrainFound = True
                            ViewTrain = trn
                            Exit For
                        End If
                        TrackEventLog("VerifyForTrainIDDuplicates:DUPLICATE TRAIN FOUND ON CHECK:Train=" & trn.Name)
                        Return False
                    End If
                Next

                If ViewTrainFound Then
                    If Not IsNothing(ViewTrain) Then
                        Dim SummItem As New SummaryItem("TRAIN", "RELEASE", ViewTrain)
                        SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue.SyncRoot
                            TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                        End SyncLock
                        ViewTrain.RemoveTrainViewRecord()
                        ViewTrain.ReleaseTrainAbbreviation(gTrainAbbreviation)
                        SyncLock TrainCollection.SyncRoot
                            TrainCollection.Remove(ViewTrain)
                        End SyncLock
                    Else
                        Return False
                    End If
                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

