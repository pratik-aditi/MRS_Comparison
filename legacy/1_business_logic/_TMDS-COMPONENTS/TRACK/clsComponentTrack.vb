        Private Function CheckForTNTandDeviceBlock(ByVal IssueTo As String) As String
            Dim Comp As Object = Nothing
            Dim returnStr As String = ""
            Try
                Dim i As Integer = 0
                Dim J As Integer = 0
                For i = 0 To gEntExtTrackSelection.Count - 1
                    If gEntExtTrackSelection(i).GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        J = i
                        Exit For
                    End If
                Next
                i = 0
                For i = J To gEntExtTrackSelection.Count - 1
                    Dim OverrideTNT As Boolean = False
                    Dim TNTPresent As Boolean = False
                    Dim IgnoreDeviceBlock As Boolean = False
                    Comp = gEntExtTrackSelection(i)
                    Select Case Comp.GetType.ToString
                        Case "TMDS.TrackComponents.Track"
                            If optEnableOverrideTNTForPRS Then
                                If Comp.BlockAbsolute Then
                                    'OverrideTNT = True
                                    If optEnableOverrideDeviceBlockForPRS Then IgnoreDeviceBlock = True
                                    Dim auth As TrackAuthority.TrackAuthority
                                    If Comp.TrackAuthorities.count > 0 Then TNTPresent = True
                                    For Each auth In Comp.TrackAuthorities
                                        If auth.IssueTo = IssueTo Then
                                            OverrideTNT = True
                                            'Exit For
                                        End If
                                    Next
                                    'If Not optEnableOverrideJointTNTForPRS Then
                                    '    For Each auth In Comp.TrackAuthorities
                                    '        If auth.IssueTo <> IssueTo Then
                                    '            OverrideTNT = False
                                    '            Exit For
                                    '        End If
                                    '    Next
                                    'End If

                                    If OverrideTNT = False And TNTPresent Then
                                        TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                        ClearSystemVariables()
                                        If Not OverrideTNT And TNTPresent Then returnStr = "TNT"
                                        Return returnStr
                                        Exit Function
                                    End If
                                End If

                                If optEnableOverrideDeviceBlockForPRS Then
                                    If Comp.DeviceBlocks.Count > 0 Then IgnoreDeviceBlock = True
                                    Dim dv As TrackAuthority.DeviceBlock
                                    For Each dv In Comp.DeviceBlocks
                                        If Not optEnableOverrideSIGValidationForPRS Then
                                            If dv.IsPRS Then
                                                IgnoreDeviceBlock = False
                                                returnStr = "PRS"
                                                Return "PRS"
                                                Exit For
                                            End If
                                        End If
                                        If dv.IsEMT Then
                                            IgnoreDeviceBlock = False
                                            returnStr = "EMT"
                                            Return "EMT"
                                            Exit For
                                        End If
                                    Next
                                    'End If
                                End If

                            End If

                        Case "TMDS.SignalComponents.Signal"

                    End Select

                    'If Comp.BlockAbsolute And OverrideTNT = False Then
                    '    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                    '    ClearSystemVariables()
                    '    If Not OverrideTNT And TNTPresent Then returnStr = "TNT"
                    '    Return returnStr
                    '    Exit Function
                    'End If

                    'If Not OverrideTNT And Not IgnoreDeviceBlock Then
                    '    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                    '    ClearSystemVariables()
                    '    If Not OverrideTNT And TNTPresent Then returnStr = "TNT"
                    '    Return returnStr
                    '    Exit Function
                    'End If

                Next

            Catch ex As Exception

            End Try



            Return String.Empty
        End Function

        ''' <summary>
        ''' Checks for an existing TNT or device block.
        ''' </summary>
        ''' <param name="issue_to">Trains Identifying Unit</param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Private Function CheckForTNTandDeviceBlock_BNSF(ByVal issue_to As String) As String

            Dim firstSignalIndex As Int32
            Dim returnString As String = String.Empty

            Try

                'Get the index of the first signal
                'For i As Int32 = 0 To gEntExtTrackSelection.Count - 1
                '    If gEntExtTrackSelection(i).GetType.ToString = "TMDS.SignalComponents.Signal" Then
                '        firstSignalIndex = i
                '        Exit For
                '    End If
                'Next
                firstSignalIndex = FindIndexOfFirstSignalInCurrentSelection()

                'Start looking from the first signal found to the end of the track selection
                For selectionIterator As Int32 = firstSignalIndex To gEntExtTrackSelection.Count - 1

                    Dim overrideTNT As Boolean = False
                    Dim isTNTPresent As Boolean = False
                    Dim ignoreDeviceBlock As Boolean = False

                    Dim tmdsComponent As Object = gEntExtTrackSelection(selectionIterator)

                    Select Case tmdsComponent.GetType.ToString

                        Case "TMDS.TrackComponents.Track"

                            Dim trackComponent As Track = CType(tmdsComponent, Track)

                            If optEnableOverrideTNTForPRS Then

                                If trackComponent.BlockAbsolute Then

                                    If optEnableOverrideDeviceBlockForPRS Then
                                        ignoreDeviceBlock = True
                                    End If

                                    If trackComponent.TrackAuthorities.Count > 0 Then
                                        isTNTPresent = True
                                    End If

                                    For Each tmdsAuthority As TrackAuthority.TrackAuthority In trackComponent.TrackAuthorities
                                        If tmdsAuthority.IssueTo = issue_to Then
                                            overrideTNT = True
                                        End If
                                    Next

                                    'We found a TNT and we are not allowed to override it so exit
                                    If Not overrideTNT And isTNTPresent Then

                                        TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                        ClearSystemVariables()

                                        returnString = "TNT"
                                        Exit For

                                    End If
                                End If


                                If optEnableOverrideDeviceBlockForPRS Then

                                    If trackComponent.DeviceBlocks.Count > 0 Then
                                        ignoreDeviceBlock = True
                                    End If

                                    For Each tmdsBlock As TrackAuthority.DeviceBlock In trackComponent.DeviceBlocks

                                        If Not optEnableOverrideSIGValidationForPRS Then
                                            If tmdsBlock.IsPRS Then
                                                ignoreDeviceBlock = False
                                                returnString = "PRS"
                                                Exit For
                                            End If
                                        End If

                                        If tmdsBlock.IsEMT Then
                                            ignoreDeviceBlock = False
                                            returnString = "EMT"
                                            Exit For
                                        End If

                                    Next
                                End If

                            End If

                    End Select

                    'If we have a return value then just return
                    If Not returnString.Equals(String.Empty) Then
                        Exit For
                    End If

                Next

            Catch ex As Exception
                SystemException(ex.ToString)
                'returnString = "EX"
            End Try

            Return returnString

        End Function

        Private Function CheckForAdjacentTNTandDeviceBlock(ByVal IssueTo As String) As String
            Dim Comp As Object = Nothing
            Dim returnStr As String = ""
            Dim SwitchCollection As New ArrayList
            Dim StatColl1, Statcoll2 As New ArrayList
            Dim collectionModified As Boolean = False
            Dim SelectionClone As New ArrayList
            Dim SelectionClone1 As New ArrayList
            Dim comp2 As Object
            Dim HasMultipleMains As Boolean = False
            Try


                Try
                    Dim Stat1, Stat2 As Integer
                    Stat1 = gEntryTrack.StationNumber
                    Stat2 = gExitTrack.StationNumber

                    For Each Comp In TMDS.GlobalDeclarations.TrackCollection
                        If Comp.StationNumber = Stat1 Then
                            If Not Comp.TrackName Is Nothing Then
                                Dim IsSidingTrack As Boolean = False
                                If optEnableTrackSidingBit Then
                                    'NEW SIDING LOGIC CODE
                                    If Comp.GetType.ToString = gTrackComponentName Then
                                        If Comp.EnableNonControlledSiding Or Comp.EnableControlledSiding Then IsSidingTrack = True
                                    End If
                                    If Not IsSidingTrack Then
                                        If Not StatColl1.Contains(Comp.trackname) Then
                                            StatColl1.Add(Comp.Trackname)
                                        End If
                                    End If
                                Else
                                    'OLD LEGACY SIDING CODE
                                    If InStr(Comp.TrackName, "SIDING") = 0 Then
                                        If Not StatColl1.Contains(Comp.trackname) Then
                                            StatColl1.Add(Comp.Trackname)
                                        End If
                                    End If
                                End If

                            End If
                        End If
                        If Comp.StationNumber = Stat2 Then
                            If Not Comp.TrackName Is Nothing Then
                                Dim IsSidingTrack As Boolean = False
                                If optEnableTrackSidingBit Then
                                    'NEW SIDING LOGIC CODE
                                    If Comp.GetType.ToString = gTrackComponentName Then
                                        If Comp.EnableNonControlledSiding Or Comp.EnableControlledSiding Then IsSidingTrack = True
                                    End If
                                    If Not IsSidingTrack Then
                                        If Not Statcoll2.Contains(Comp.trackname) Then Statcoll2.Add(Comp.Trackname)
                                    End If
                                Else
                                    'OLD LEGACY SIDING CODE
                                    If InStr(Comp.TrackName, "SIDING") = 0 Then
                                        If Not Statcoll2.Contains(Comp.trackname) Then Statcoll2.Add(Comp.Trackname)
                                    End If
                                End If
                            End If
                        End If
                    Next
                    If StatColl1.Count > 1 Or Statcoll2.Count > 1 Then
                        HasMultipleMains = True
                    End If

                Catch ex As Exception
                    SystemException(ex.ToString)
                Finally
                    StatColl1 = New ArrayList
                    Statcoll2 = New ArrayList
                End Try

                If HasMultipleMains Then
                    Try
                        Dim i As Integer = 0
                        Dim J As Integer = 0
                        For i = 0 To gEntExtTrackSelection.Count - 1
                            If gEntExtTrackSelection(i).GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                J = i
                                Exit For
                            End If
                        Next
                        i = 0
                        For i = J To gEntExtTrackSelection.Count - 1
                            If gEntExtTrackSelection(i).GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                SwitchCollection.Add(gEntExtTrackSelection(i))
                            End If
                        Next


                        'SelectionClone = gEntExtTrackSelection.Clone
                        Dim sidingDetected As Boolean = False
                        For Each Comp In SwitchCollection
                            SelectionClone1 = New ArrayList
                            SelectionClone1 = GetAdjacenTracksfromSwitch(Comp)

                            For Each comp2 In SelectionClone1
                                SelectionClone.Add(comp2)
                            Next

                        Next

                        For Each Comp In SelectionClone
                            Select Case Comp.GetType.ToString
                                Case "TMDS.SignalComponents.Signal"
                                    If Comp.StoredEntrySignal Or Comp.StoredExitSignal Then
                                        returnStr = "SR"
                                        Return returnStr
                                        Exit Function
                                    End If

                                Case Else
                                    If Not gEntExtTrackSelection.Contains(Comp) Then
                                        gEntExtTrackSelection.Add(Comp)
                                        collectionModified = True
                                    End If
                            End Select

                        Next
                        If collectionModified Then
                            TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()
                        End If


                        i = 0
                        For i = J To gEntExtTrackSelection.Count - 1
                            Dim OverrideTNT As Boolean = False
                            Dim TNTPresent As Boolean = False
                            Dim IgnoreDeviceBlock As Boolean = False
                            Dim HasTrafficDirection As Boolean = False
                            Dim TrafficDirection As String = String.Empty
                            Comp = gEntExtTrackSelection(i)
                            Select Case Comp.GetType.ToString
                                Case "TMDS.TrackComponents.Track"
                                    If Comp.TrafficDirection Is Nothing Then
                                        HasTrafficDirection = False
                                        TrafficDirection = ""
                                    Else
                                        HasTrafficDirection = True
                                        TrafficDirection = Comp.TrafficDirection
                                    End If
                                    If optEnableOverrideTNTForPRS Then
                                        If Comp.BlockAbsolute Then
                                            'OverrideTNT = True
                                            If optEnableOverrideDeviceBlockForPRS Then IgnoreDeviceBlock = True
                                            Dim auth As TrackAuthority.TrackAuthority
                                            If Comp.TrackAuthorities.count > 0 Then TNTPresent = True
                                            For Each auth In Comp.TrackAuthorities
                                                If auth.IssueTo = IssueTo Then
                                                    OverrideTNT = True
                                                    'Exit For
                                                End If
                                            Next
                                            If Not optEnableOverrideJointTNTForPRS Then
                                                For Each auth In Comp.TrackAuthorities
                                                    If auth.IssueTo <> IssueTo Then
                                                        OverrideTNT = False
                                                        Exit For
                                                    End If
                                                Next
                                            End If

                                            If OverrideTNT = False And TNTPresent Then
                                                TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                                ClearSystemVariables()
                                                If Not OverrideTNT And TNTPresent Then returnStr = "TNT"
                                                Return returnStr
                                                Exit Function
                                            End If


                                            If optEnableOverrideDeviceBlockForPRS Then
                                                If Comp.DeviceBlocks.Count > 0 Then IgnoreDeviceBlock = True
                                                Dim dv As TrackAuthority.DeviceBlock
                                                For Each dv In Comp.DeviceBlocks
                                                    If dv.IsPRS Then
                                                        IgnoreDeviceBlock = False
                                                        returnStr = "PRS"
                                                        Return "PRS"
                                                        Exit For
                                                    ElseIf dv.IsEMT Then
                                                        IgnoreDeviceBlock = False
                                                        returnStr = "EMT"
                                                        Return "EMT"
                                                        Exit For
                                                    End If
                                                Next
                                            End If
                                        End If

                                    End If
                                    ''If Comp.SignalStatOnMe = TrackComponents.Track.SignalStatus.SignalCleared Or Comp.SignalStatOnMe = TrackComponents.Track.SignalStatus.SignalRequested Or Comp.SignalStatOnMe = TrackComponents.Track.SignalStatus.SignalInTime Then
                                    ''    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                    ''    ClearSystemVariables()
                                    ''    returnStr = "SIG"
                                    ''    Return returnStr
                                    ''    Exit Function
                                    ''End If
                                    If HasTrafficDirection And TrafficDirection.Trim <> String.Empty And TrafficDirection <> gSearchDirection Then
                                        TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                        ClearSystemVariables()
                                        returnStr = "SIG"
                                        Return returnStr
                                        Exit Function
                                    ElseIf HasTrafficDirection And gEntryTrack.TrackName <> Comp.TrackName And Comp.SignalStatOnMe <> TrackComponents.Track.SignalStatus.SignalAtStop Then
                                        TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                        ClearSystemVariables()
                                        returnStr = "SIG"
                                        Return returnStr
                                        Exit Function
                                    End If

                                Case "TMDS.SignalComponents.Signal"
                                    If Comp.StoredEntrySignal Or Comp.StoredExitSignal Then
                                        returnStr = "SR"
                                        Return returnStr
                                        Exit Function
                                    End If

                                    'If Comp.SignalStatus <> SignalComponents.Signal.BulbStatus.StopStatus Then
                                    '    If Comp.SignalStatus = SignalComponents.Signal.BulbStatus.Unsolitated Or Comp.SignalStatus = SignalComponents.Signal.BulbStatus.ClearStatus Or Comp.SignalStatus = SignalComponents.Signal.BulbStatus.RequestingClear Or Comp.SignalStatus = SignalComponents.Signal.BulbStatus.RequestingStop Or Comp.SignalStatus = SignalComponents.Signal.BulbStatus.RequestingClear Then
                                    '        Return "SIG"
                                    '        Exit Function
                                    '    End If
                                    'End If
                            End Select
                        Next

                    Catch ex As Exception
                        SystemException(ex.ToString)
                    End Try

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Comp = Nothing
                comp2 = Nothing
                SwitchCollection = New ArrayList
                SelectionClone = New ArrayList
                SelectionClone1 = New ArrayList
            End Try
            Return String.Empty
        End Function


        Private Function GetAdjacenTracksfromSwitch(ByVal Sw As TMDS.SwitchComponents.Switch, Optional ByVal SearchForNormalSwitch As Boolean = False) As ArrayList
            Dim SecondSwitchDetected As Boolean
            Dim SignalDetected As Boolean = False
            Dim SecondSwitch As TMDS.SwitchComponents.Switch = Nothing
            Dim SecondSwitchGUID As Integer
            Dim CompToCheck As Object = Nothing
            Dim NextCompToCheck As Object = Nothing
            Dim SelectionArrayList As New ArrayList()
            Dim I As Integer = 0
            Dim SrchDirection As String
            Try
                If gPermissionPassRedSignalIncludeSiding And Not SearchForNormalSwitch Then
                    If Sw.ControlledReverse Or Sw.SetOutOfCorespondenceReverse Then
                        If Sw.LeftLink = 0 Then
                            SrchDirection = "R"
                        Else
                            SrchDirection = "L"
                        End If
                        Select Case SrchDirection
                            Case "L"
                                CompToCheck = FindCompFromGUID(Sw.LeftLink)
                            Case "R"
                                CompToCheck = FindCompFromGUID(Sw.RightLink)
                        End Select
                    ElseIf Sw.ControlledReverse = False And Sw.SetOutOfCorespondenceNormal = True Then
                        If Sw.LeftLink = 0 Then
                            SrchDirection = "L"
                        Else
                            SrchDirection = "R"
                        End If
                        Select Case SrchDirection
                            Case "L"
                                CompToCheck = FindCompFromGUID(Sw.LeftLink)
                                If gEntExtTrackSelection.Contains(CompToCheck) Then
                                    If Sw.LeftAltLink > 0 Then CompToCheck = FindCompFromGUID(Sw.LeftAltLink)
                                End If
                            Case "R"
                                CompToCheck = FindCompFromGUID(Sw.RightLink)
                                If gEntExtTrackSelection.Contains(CompToCheck) Then
                                    If Sw.RightAltLink > 0 Then CompToCheck = FindCompFromGUID(Sw.RightAltLink)
                                End If
                        End Select
                    Else
                        If Sw.LeftAltLink = 0 Then
                            SrchDirection = "R"
                        Else
                            SrchDirection = "L"
                        End If
                        Select Case SrchDirection
                            Case "L"
                                CompToCheck = FindCompFromGUID(Sw.LeftAltLink)
                                If gEntExtTrackSelection.Contains(CompToCheck) Then
                                    CompToCheck = FindCompFromGUID(Sw.LeftLink)
                                End If
                            Case "R"
                                CompToCheck = FindCompFromGUID(Sw.RightAltLink)
                                If gEntExtTrackSelection.Contains(CompToCheck) Then
                                    CompToCheck = FindCompFromGUID(Sw.RightLink)
                                End If
                        End Select
                    End If


                Else



                    If Sw.LeftAltLink = 0 Then
                        SrchDirection = "R"
                    Else
                        SrchDirection = "L"
                    End If
                    Select Case SrchDirection
                        Case "L"
                            CompToCheck = FindCompFromGUID(Sw.LeftAltLink)
                        Case "R"
                            CompToCheck = FindCompFromGUID(Sw.RightAltLink)
                    End Select
                End If

                If SearchForNormalSwitch Then
                    CompToCheck = Nothing
                    If Sw.ControlledReverse Then
                        If Sw.LeftLink = 0 Then
                            SrchDirection = "L"
                        Else
                            SrchDirection = "R"
                        End If
                        Select Case SrchDirection
                            Case "L"
                                CompToCheck = FindCompFromGUID(Sw.LeftLink)
                                If gEntExtTrackSelection.Contains(CompToCheck) Then
                                    If Sw.LeftAltLink = 0 Then
                                        CompToCheck = FindCompFromGUID(Sw.RightAltLink)
                                        SrchDirection = "R"
                                    Else
                                        CompToCheck = FindCompFromGUID(Sw.LeftAltLink)
                                        SrchDirection = "L"
                                    End If

                                End If

                            Case "R"
                                CompToCheck = FindCompFromGUID(Sw.RightLink)
                                If gEntExtTrackSelection.Contains(CompToCheck) Then
                                    'CompToCheck = FindCompFromGUID(Sw.RightAltLink)
                                    If Sw.RightAltLink = 0 Then
                                        CompToCheck = FindCompFromGUID(Sw.LeftAltLink)
                                        SrchDirection = "L"
                                    Else
                                        CompToCheck = FindCompFromGUID(Sw.RightAltLink)
                                        SrchDirection = "R"
                                    End If
                                End If
                        End Select
                    Else
                        If Sw.LeftLink = 0 Then
                            SrchDirection = "R"
                        Else
                            SrchDirection = "L"
                        End If
                        Select Case SrchDirection
                            Case "L"
                                CompToCheck = FindCompFromGUID(Sw.LeftLink)
                                If gEntExtTrackSelection.Contains(CompToCheck) Then
                                    CompToCheck = FindCompFromGUID(Sw.LeftAltLink)
                                End If
                            Case "R"
                                CompToCheck = FindCompFromGUID(Sw.RightLink)
                                If gEntExtTrackSelection.Contains(CompToCheck) Then
                                    CompToCheck = FindCompFromGUID(Sw.RightAltLink)
                                End If
                        End Select
                    End If
                End If


                If Not CompToCheck Is Nothing Then
                    SelectionArrayList.Add(CompToCheck)
                End If
                Dim SwSrchDirection As String = ""



                For I = 0 To 10
                    Select Case SrchDirection
                        Case "L"
                            If CompToCheck Is Nothing Then Exit For
                            NextCompToCheck = FindCompFromGUID(CompToCheck.LeftLink)
                            If NextCompToCheck Is Nothing Then Exit For
                            Select Case NextCompToCheck.GetType.ToString
                                Case "TMDS.TrackComponents.Track"
                                    SelectionArrayList.Add(NextCompToCheck)
                                    CompToCheck = NextCompToCheck
                                    If SignalDetected Then
                                        NextCompToCheck = FindCompFromGUID(CompToCheck.LeftLink)
                                        If Not NextCompToCheck Is Nothing Then
                                            If NextCompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                                'SelectionArrayList.Add(NextCompToCheck)
                                            End If
                                        End If
                                        Exit For
                                    End If
                                Case "TMDS.SignalComponents.Signal"
                                    If NextCompToCheck.ComponentType = "L" Or NextCompToCheck.ComponentType = "U" Then
                                        SignalDetected = True
                                        CompToCheck = Nothing
                                    Else
                                        SelectionArrayList.Add(NextCompToCheck)
                                        CompToCheck = NextCompToCheck
                                    End If
                                Case "TMDS.SwitchComponents.Switch"
                                    If Not SecondSwitchDetected Then
                                        SecondSwitchDetected = True
                                        SecondSwitch = NextCompToCheck
                                        SecondSwitchGUID = SecondSwitch.RightLink
                                        SwSrchDirection = "L"
                                    End If
                                    SelectionArrayList.Add(NextCompToCheck)
                                    CompToCheck = NextCompToCheck
                                Case "TMDS.TrackOtherComponents.FlipFlop"
                                    If SrchDirection = "L" Then
                                        SrchDirection = "R"
                                    Else
                                        SrchDirection = "L"
                                    End If
                                    CompToCheck = NextCompToCheck
                            End Select


                        Case "R"
                            If CompToCheck Is Nothing Then Exit For
                            NextCompToCheck = FindCompFromGUID(CompToCheck.RightLink)
                            Select Case NextCompToCheck.GetType.ToString
                                Case "TMDS.TrackComponents.Track"
                                    SelectionArrayList.Add(NextCompToCheck)
                                    CompToCheck = NextCompToCheck
                                    If SignalDetected Then
                                        NextCompToCheck = FindCompFromGUID(CompToCheck.RightLink)
                                        If Not NextCompToCheck Is Nothing Then
                                            If NextCompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                                'SelectionArrayList.Add(NextCompToCheck)
                                            End If
                                        End If
                                        Exit For
                                    End If
                                Case "TMDS.SignalComponents.Signal"

                                    If NextCompToCheck.ComponentType = "R" Or NextCompToCheck.ComponentType = "D" Then
                                        SignalDetected = True
                                        'SelectionArrayList.Add(NextCompToCheck)
                                        CompToCheck = Nothing
                                    Else
                                        SelectionArrayList.Add(NextCompToCheck)
                                        CompToCheck = NextCompToCheck
                                    End If
                                    'SelectionArrayList.Add(NextCompToCheck)
                                    'CompToCheck = NextCompToCheck
                                Case "TMDS.SwitchComponents.Switch"
                                    If Not SecondSwitchDetected Then
                                        SecondSwitchDetected = True
                                        SecondSwitch = NextCompToCheck
                                        SwSrchDirection = "R"
                                        SecondSwitchGUID = SecondSwitch.LeftLink
                                    End If

                                    SelectionArrayList.Add(NextCompToCheck)
                                    CompToCheck = NextCompToCheck
                                Case "TMDS.TrackOtherComponents.FlipFlop"
                                    If SrchDirection = "L" Then
                                        SrchDirection = "R"
                                    Else
                                        SrchDirection = "L"
                                    End If
                                    CompToCheck = NextCompToCheck
                            End Select
                    End Select


                Next
                SignalDetected = False
                'Dim NewSrchDirection As String = ""
                If Not SecondSwitch Is Nothing Then
                    If SecondSwitchDetected Then CompToCheck = SecondSwitch
                    For I = 0 To 10
                        If SecondSwitchDetected Then
                            Select Case SwSrchDirection
                                Case "L"
                                    If CompToCheck Is Nothing Then Exit For
                                    NextCompToCheck = FindCompFromGUID(CompToCheck.RightLink)
                                    Select Case NextCompToCheck.GetType.ToString
                                        Case "TMDS.TrackComponents.Track"
                                            SelectionArrayList.Add(NextCompToCheck)
                                            CompToCheck = NextCompToCheck
                                            'If SignalDetected Then
                                            '    Exit For
                                            'End If

                                            If SignalDetected Then
                                                NextCompToCheck = FindCompFromGUID(CompToCheck.RightLink)
                                                If Not NextCompToCheck Is Nothing Then
                                                    If NextCompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                                        'SelectionArrayList.Add(NextCompToCheck)
                                                    End If
                                                End If
                                                Exit For
                                            End If
                                        Case "TMDS.SignalComponents.Signal"
                                            'SignalDetected = True
                                            'SelectionArrayList.Add(NextCompToCheck)
                                            'CompToCheck = NextCompToCheck
                                            If NextCompToCheck.ComponentType = "L" Or NextCompToCheck.ComponentType = "U" Then
                                                SignalDetected = True
                                                CompToCheck = Nothing
                                            Else
                                                SelectionArrayList.Add(NextCompToCheck)
                                                CompToCheck = NextCompToCheck
                                            End If
                                        Case "TMDS.SwitchComponents.Switch"
                                            SelectionArrayList.Add(NextCompToCheck)
                                            CompToCheck = NextCompToCheck
                                        Case "TMDS.TrackOtherComponents.FlipFlop"
                                            If SrchDirection = "L" Then
                                                SrchDirection = "R"
                                            Else
                                                SrchDirection = "L"
                                            End If
                                            CompToCheck = NextCompToCheck
                                    End Select

                                Case "R"

                                    If CompToCheck Is Nothing Then Exit For

                                    NextCompToCheck = FindCompFromGUID(CompToCheck.LeftLink)
                                    Select Case NextCompToCheck.GetType.ToString
                                        Case "TMDS.TrackComponents.Track"
                                            SelectionArrayList.Add(NextCompToCheck)
                                            CompToCheck = NextCompToCheck
                                            'If SignalDetected Then
                                            '    Exit For
                                            'End If
                                            If SignalDetected Then
                                                NextCompToCheck = FindCompFromGUID(CompToCheck.LeftLink)
                                                If Not NextCompToCheck Is Nothing Then
                                                    If NextCompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                                        'SelectionArrayList.Add(NextCompToCheck)
                                                    End If
                                                End If
                                                Exit For
                                            End If
                                        Case "TMDS.SignalComponents.Signal"
                                            'SignalDetected = True
                                            'SelectionArrayList.Add(NextCompToCheck)
                                            'CompToCheck = NextCompToCheck
                                            If NextCompToCheck.ComponentType = "R" Or NextCompToCheck.ComponentType = "D" Then
                                                SignalDetected = True
                                                CompToCheck = Nothing
                                            Else
                                                SelectionArrayList.Add(NextCompToCheck)
                                                CompToCheck = NextCompToCheck
                                            End If
                                        Case "TMDS.SwitchComponents.Switch"
                                            SelectionArrayList.Add(NextCompToCheck)
                                            CompToCheck = NextCompToCheck
                                        Case "TMDS.TrackOtherComponents.FlipFlop"
                                            If SrchDirection = "L" Then
                                                SrchDirection = "R"
                                            Else
                                                SrchDirection = "L"
                                            End If
                                            CompToCheck = NextCompToCheck
                                    End Select


                            End Select

                        Else
                            Exit For
                        End If
                    Next
                End If

                Return SelectionArrayList
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                SecondSwitch = Nothing
                CompToCheck = Nothing
                NextCompToCheck = Nothing
                SecondSwitch = Nothing
            End Try

            Return SelectionArrayList
        End Function

        Private Function CheckForAdjacentStoredRoutesExists(ByVal SearchDirection As String) As Boolean
            Dim comp As Object = Nothing
            Dim Lastcomp As Object = Nothing
            Try
                If Not gEntExtTrackSelection Is Nothing Then
                    If gEntExtTrackSelection.Count > 0 Then
                        Lastcomp = gEntExtTrackSelection(gEntExtTrackSelection.Count - 1)
                    Else
                        Return False
                    End If
                Else
                    Return False
                End If

                Select Case gSearchDirection.Trim.ToUpper
                    Case "LEFT"
                        comp = FindComponent(Lastcomp.LeftLink)
                    Case "RIGHT"
                        comp = FindComponent(Lastcomp.RightLink)
                End Select

                If Not comp Is Nothing Then
                    If comp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If comp.StoredEntrySignal Or comp.StoredExitSignal Then
                            Return True
                        End If
                    End If
                End If
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            Finally
                Lastcomp = Nothing
                comp = Nothing
            End Try

        End Function

        ' ATAG: CheckForAllTracksinSameMainPSS() - Code to check for signal Activity
        Private Function CheckForAllTracksinSameMainPSS() As Boolean
            Dim EntryTrackName As String = ""
            Dim tempTrackCollection As New ArrayList
            Dim comp As Object = Nothing
            Dim DoAllTrackBelongtoSameMain As Boolean = True
            Dim FirstSignalDetected As Boolean
            Dim trk As Track
            Dim MessageList As New ArrayList
            Dim LaunchPoint As Point = Nothing
            Dim HasValidOccupancy As Boolean = False
            Dim OccupanyResolutionNeeded As Boolean = False
            Try
                LaunchPoint = New Point(Me.CurrentDrawingForm.Width / 2, Me.CurrentDrawingForm.Height / 2)

                If Not gEntryTrack Is Nothing Then EntryTrackName = gEntryTrack.TrackName
                For Each comp In gEntExtTrackSelection
                    If comp.GetType.ToString = gSignalComponentName And Not FirstSignalDetected Then
                        FirstSignalDetected = True
                    End If

                    If comp.GetType.ToString = gTrackComponentName And FirstSignalDetected Then
                        tempTrackCollection.Add(comp)
                        If EntryTrackName <> comp.TrackName Then
                            DoAllTrackBelongtoSameMain = False
                            Return True
                        End If
                    End If
                Next
                comp = Nothing
                If DoAllTrackBelongtoSameMain Then
                    If Not optEnableOverrideSIGValidationForPRS Then
                        Dim count As Integer = 1
                        Dim DoesTrackHasTraffic As Integer = 0
                        For i As Integer = 0 To tempTrackCollection.Count - 1
                            trk = tempTrackCollection(i)

                            If Not trk.TrafficDirection Is Nothing Then
                                If trk.TrafficDirection.Trim <> String.Empty Then
                                    If optAllowPSSOverOccupancy Then
                                        If Not trk.Occuppied Then
                                            If i = 0 Then
                                                Return True
                                            Else
                                                Return False
                                            End If
                                        Else
                                            If trk.TrainIDs IsNot Nothing AndAlso trk.TrainIDs.Count > 0 Then HasValidOccupancy = True
                                            If trk.MOWIDs IsNot Nothing AndAlso trk.MOWIDs.Count > 0 Then HasValidOccupancy = True
                                            If trk.Occuppied Then OccupanyResolutionNeeded = True
                                        End If
                                    Else
                                        If i = 0 Then
                                            Return True
                                        Else
                                            Return False
                                        End If
                                    End If

                                End If
                            End If
                        Next
                    End If
                End If
                If OccupanyResolutionNeeded AndAlso Not HasValidOccupancy Then
                    MessageList.Add("AN OCCUPANCY WAS FOUND WITH NO TRAIN ID ASSOCIATED!")
                    MessageList.Add("")
                    MessageList.Add("HAS THE TRAIN DISPATCHER RESOLVED THIS CONFLICT?")
                    MessageList.Add("")
                    If ShowCustomMessageBox(MessageList, gMenuPermissionToPassRedSignalText & " VALIDATION", True, LaunchPoint, True, True, Me.CurrentDrawingForm) <> 6 Then
                        Return False
                    Else
                        Return True
                    End If
                ElseIf HasValidOccupancy Then
                    If Not optAllowPSSOverOccupancy Then
                        Return False
                    Else
                        MessageList = New ArrayList
                        With MessageList
                            .Add("ONE OR MORE TRAIN/MOW IDS FOUND IN THE AUTHORITY LIMITS")
                            .Add("")
                            .Add("HAS THE TRAIN DISPATCHER RESOLVED THIS CONFLICT?")
                        End With
                        If ShowCustomMessageBox(MessageList, gMenuPermissionToPassRedSignalText & " VALIDATION", True, LaunchPoint, True, True, Me.CurrentDrawingForm) <> 6 Then
                            Return False
                        Else
                            Return True
                        End If
                        'Return True
                    End If

                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                tempTrackCollection = New ArrayList
                comp = Nothing
                trk = Nothing
                MessageList = Nothing
                LaunchPoint = Nothing
            End Try
            Return True
        End Function

        Private Sub StartPSSFromSignal()
            Dim tempArray As New ArrayList
            Dim NewList As New ArrayList
            Dim comp As Object = Nothing
            Dim OkToAddTocollectoion As Boolean = False
            Try
                CopyArrayCollection(tempArray, gEntExtTrackSelection)
                For Each comp In tempArray
                    Select Case comp.GetType.ToString
                        Case gSignalComponentName
                            OkToAddTocollectoion = True
                            If Not NewList.Contains(comp) Then NewList.Add(comp)
                        Case Else
                            If OkToAddTocollectoion Then
                                If Not NewList.Contains(comp) Then NewList.Add(comp)
                            End If
                    End Select
                Next
                TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                CopyArrayCollection(gEntExtTrackSelection, NewList)

            Catch ex As Exception
                GetErrorDetails(ex)
            End Try
        End Sub

        ''' <summary>
        ''' Adjusts the signal selection based on the tracks selected.
        ''' </summary>
        ''' <remarks></remarks>
        Private Sub AdjustSignalSelection()
            Try
                Dim NewList As New ArrayList
                Dim comp As Object
                Dim StopSearch As Boolean
                Dim EntrySignal As Signal = Nothing
                Dim ExitTrack As Track = Nothing
                Dim CompList As New ArrayList

                CopyArrayCollection(CompList, gEntExtTrackSelection)
                TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                Dim IgnoreFirstTWCTrack As Boolean = False
                Dim LikeArray As New ArrayList
                ''If (Mid(gEntryTrack.AuthorityType, 1, 3) = "TWC") AndAlso gEntryTrack.Indicating = True Then
                ''    gEntryTrack.FindLikeTracks(LikeArray, TMDS.GlobalDeclarations.TrackCollection)
                ''End If
                If gEntryTrack.AuthorityType.Trim.ToUpper.Contains("TWC") AndAlso gEntryTrack.Indicating = True Then
                    gEntryTrack.FindLikeTracks(LikeArray, TMDS.GlobalDeclarations.TrackCollection)
                End If
                For Each comp In CompList
                    IgnoreFirstTWCTrack = False
                    If Not comp Is Nothing Then
                        If comp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            If IsNothing(EntrySignal) Then
                                EntrySignal = comp
                                comp.SelectionMode = GenericComponent.ModeSelection.SummarySelectionRouting
                            Else
                                StopSearch = True
                                Exit For
                            End If
                        ElseIf comp.GetType.ToString = "TMDS.TrackComponents.Track" Then

                            Dim trk As Track = CType(comp, Track)
                            If trk.AuthorityType <> "SHELF" Then

                                If trk Is gEntryTrack And gOverridePSSPermissionForCTCIsland Then
                                    IgnoreFirstTWCTrack = True
                                    'ElseIf trk Is gEntryTrack And (Mid(trk.AuthorityType, 1, 3) = "TWC") AndAlso trk.Indicating = True Then
                                ElseIf trk Is gEntryTrack And trk.AuthorityType.Trim.ToUpper.Contains("TWC") AndAlso trk.Indicating = True Then
                                    IgnoreFirstTWCTrack = True
                                ElseIf LikeArray.Contains(trk) And trk.AuthorityType.Trim.ToUpper.Contains("TWC") AndAlso trk.Indicating = True Then
                                    'ElseIf LikeArray.Contains(trk) And (Mid(trk.AuthorityType, 1, 3) = "TWC") AndAlso trk.Indicating = True Then
                                    IgnoreFirstTWCTrack = True
                                Else
                                    IgnoreFirstTWCTrack = False
                                End If
                                If (Mid(trk.AuthorityType, 1, 3) <> "CTC") And Not IgnoreFirstTWCTrack Then
                                    ExitTrack = comp
                                    Exit For
                                End If
                            End If
                            comp.SelectionMode = GenericComponent.ModeSelection.SummarySelectionRouting

                            If StopSearch Then
                                NewList.Add(comp)
                                ExitTrack = comp
                                Exit For
                            End If
                        End If
                    End If
                    If Not IgnoreFirstTWCTrack Then NewList.Add(comp)
                Next
                gEntExtTrackSelection.Clear()
                If gOverridePSSPermissionForCTCIsland Then
                    If Mid(gEntryTrack.AuthorityType, 1, 3) = "TWC" Then
                    Else
                        gEntExtTrackSelection.Add(gEntryTrack)
                    End If
                Else
                    gEntExtTrackSelection.Add(gEntryTrack)
                    If (Mid(gEntryTrack.AuthorityType, 1, 3) = "TWC") AndAlso gEntryTrack.Indicating = True Then
                        gEntryTrack.FindLikeTracks(gEntExtTrackSelection, TMDS.GlobalDeclarations.TrackCollection)
                    End If
                End If
                'gEntExtTrackSelection.Add(gEntryTrack)
                If (Mid(gEntryTrack.AuthorityType, 1, 3) <> "TWC") AndAlso gOverridePSSPermissionForCTCIsland Then
                    gEntryTrack.SelectionMode = GenericComponent.ModeSelection.SummarySelectionRouting
                    gEntryTrack.FlashComponent = True
                    gTrackAuthSelectionFlashOn = True
                End If

                For Each comp In NewList
                    If Not gEntExtTrackSelection.Contains(comp) Then gEntExtTrackSelection.Add(comp)
                Next
                TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()

                TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionEntExt.Enabled = True
                If Not ExitTrack Is Nothing Then frmMainMDI.ExtendStoreRoute(gSearchDirection, ExitTrack, gEntExtTrackSelection, gEntryTrack)



            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

