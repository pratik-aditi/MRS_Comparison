                    For Each zn As ZoneDetail In AuthZonelist
                        If zn.ZoneDown Then
                            ZoneDownList.Add(zn)
                        End If
                        If zn.ZoneName.ToUpper.Trim = ZoneName.ToUpper.Trim Then
                            ZoneWentDown = zn.ZoneDetailsTrackZone
                        End If
                    Next
                    For Each zn As ZoneDetail In ZoneDownList

                        Dim AZN As String = ""

                        If Auth IsNot Nothing AndAlso Auth.LastTrainZone IsNot Nothing Then
                            AZN = Auth.LastTrainZone.ZoneName
                        End If
                        If zn.ZoneName.Trim.ToUpper = AZN.Trim.ToUpper Then
                            PreviousZoneSeqNo = zn.ZoneSequence
                            OneZoneHasTrain = True
                            Exit For
                        End If
                    Next

                    ' If Not OneZoneHasTrain AndAlso ZoneDownList.Count > 1 Then
                    'Dim tmpArray As New ArrayList
                    'For Each zn As ZoneDetail In ZoneDownList
                    '    If Not tmpArray.Contains(zn.ZoneSequence) Then tmpArray.Add(zn.ZoneSequence)
                    'Next
                    'tmpArray.Sort()
                    'If Not tmpArray.Contains(1) Then
                    '    Return False

                    'Else
                    '    If Auth IsNot Nothing AndAlso Auth.LastTrainZone Is Nothing Then
                    '        If Auth.AuthType1 = gSFAAuthorityTypeItem2 Then
                    '            Auth.LastTrainZone = ZoneWentDown
                    '        End If
                    '    End If
                    'End If


                    ' Else
                    If OneZoneHasTrain AndAlso ZoneDownList.Count > 1 Then
                        Dim tmpArray As New ArrayList
                        Dim LastOccupiedZoneSqNo As Integer = -1
                        Dim CurrentOCCSqNo As Integer = -1
                        Dim AZN As String = ""
                        Dim CurrentZN As String = ""
                        If Auth IsNot Nothing AndAlso Auth.LastTrainZone IsNot Nothing Then
                            AZN = Auth.LastTrainZone.ZoneName
                        End If
                        If Me.TrackZoneReference IsNot Nothing Then CurrentZN = Me.TrackZoneReference.ZoneName
                        For Each zn As ZoneDetail In ZoneDownList
                            If zn.ZoneName.Trim.ToUpper = AZN.Trim.ToUpper Then
                                LastOccupiedZoneSqNo = zn.ZoneSequence
                            End If
                            If zn.ZoneName.Trim.ToUpper = CurrentZN.Trim.ToUpper Then
                                CurrentOCCSqNo = zn.ZoneSequence
                            End If

                        Next
                        If LastOccupiedZoneSqNo > 0 AndAlso CurrentOCCSqNo > 0 Then
                            If CurrentOCCSqNo > LastOccupiedZoneSqNo Then
                            Else
                                IgnoreZoneStamping = True
                            End If

                        End If


                        'tmpArray.Sort()
                        'Dim FirstSEQNumber As Integer = PreviousZoneSeqNo ' tmpArray(0)
                        'For i As Integer = 0 To tmpArray.Count - 1

                        '    If FirstSEQNumber = tmpArray(i) Then
                        '        FirstSEQNumber = FirstSEQNumber + 1
                        '    Else
                        '        Return False
                        '    End If
                        'Next

                    End If

                    ''This Condition was added to Statisfy BNSF-403. 
                    If Auth IsNot Nothing AndAlso Auth.LastTrainZone Is Nothing Then
                        If Auth.AuthType1 = gSFAAuthorityTypeItem4 Then
                            Return False
                        End If
                    End If


                    If ZoneDownList.Count > 1 Then
                        For znDwnindx As Integer = 0 To ZoneDownList.Count - 1
                            If ZoneDownList(znDwnindx).ZoneName.toupper = ZoneName.ToUpper Then
                                Dim currseq As Int32 = znDwnindx
                                Dim Prevseq As Int32 = -1
                                Dim Nextseq As Int32 = -1
                                If (znDwnindx - 1) >= 0 Then
                                    Prevseq = znDwnindx - 1
                                End If
                                If (znDwnindx + 1) <= (ZoneDownList.Count - 1) Then
                                    Nextseq = znDwnindx + 1
                                End If
                                If currseq <> -1 AndAlso Prevseq <> -1 Then
                                    Dim zn1 As ZoneDetail = ZoneDownList(Prevseq)
                                    Dim zn2 As ZoneDetail = ZoneDownList(currseq)
                                    If zn1.ZoneSequence + 1 = zn2.ZoneSequence Then
                                        If zn1.CheckIfAuthorityExists(AuthUID) Then
                                            If Not IgnoreZoneStamping AndAlso ZoneWentDown IsNot Nothing Then Auth.LastTrainZone = ZoneWentDown
                                            Return True

                                        End If
                                    End If
                                End If
                                If currseq <> -1 AndAlso Nextseq <> -1 Then
                                    Dim zn1 As ZoneDetail = ZoneDownList(currseq)
                                    Dim zn2 As ZoneDetail = ZoneDownList(Nextseq)
                                    If zn1.ZoneSequence + 1 = zn2.ZoneSequence Then
                                        If zn2.CheckIfAuthorityExists(AuthUID) Then
                                            If Not IgnoreZoneStamping AndAlso ZoneWentDown IsNot Nothing Then Auth.LastTrainZone = ZoneWentDown
                                            Return True
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
            Return False
        End Function

