        ''' <summary>
        ''' Message train move
        ''' </summary>
        ''' <param name="pTrain"></param>
        ''' <returns></returns>
        Public Function ConfirmTrainMove(ByVal pTrain As TrainID) As Boolean
            Dim frmMessageBox As frmMessageBox
            Dim messageList As New ArrayList()
            Dim sfa As TrackAuthority.SFAuthority
            Try
                'Avoid message dialog when dispatcher move train over same authority
                If Me.TrackAuthorities.Count > 0 Then
                    For Each sfa In Me.TrackAuthorities
                        If sfa.IssueTo = pTrain.Name Then
                            TrackEventLog("ConfirmTrainMove:Found authority " & sfa.AuthorityNumber.ToString & " for train " & pTrain.Name)
                            Return True
                        End If
                    Next
                End If
                messageList.Add(optSystemMessageString19 & Space(1) & pTrain.Name & Space(1) & optSystemMessageString20 & Space(1) & Me.Name & Space(1) & optSystemMessageString21 & Space(1) & Me.myControlPoint.Name & "?")
                messageList.Add("")
                frmMessageBox = New frmMessageBox()
                frmMessageBox = New frmMessageBox()
                frmMessageBox.SetMessage(messageList, optSystemMessageString3, True, Me.CurrentDrawingForm.myLaunchPoint, Nothing, True)
                frmMessageBox.TopMost = True
                frmMessageBox.ShowDialog()
                If frmMessageBox.FormFeedBack <> 6 Then
                    TrackEventLog("ConfirmTrainMove:DISPATCHER CLICKED NO TO MOVE TRAIN " & gMoveTrainSelectedID.Name)
                    Return False
                End If
                frmMessageBox.Dispose()
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            Finally
                frmMessageBox = Nothing
                messageList = Nothing
                sfa = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Do train move
        ''' </summary>
        ''' <param name="pTrainPosition"></param>
        Public Sub DoTrainMove(Optional ByVal pTrainPosition As Integer = 0)
            Dim okToMoveTrain As Boolean
            Dim frmMessageBox As frmMessageBox
            Dim messageList As New ArrayList()
            Dim sfa As TrackAuthority.SFAuthority = Nothing
            Dim lastTrack As Track
            Dim authDirection As String
            Try
                TrackEventLog("DoTrainMove:Start")
                If gMoveTrainSelected Then
                    'Request confirmation of the dispatcher to move train
                    If Me.AuthorityType.Contains("TWC") AndAlso gMoveTrainSelectedID IsNot Nothing AndAlso Not ConfirmTrainMove(gMoveTrainSelectedID) Then
                        TrackEventLog("DoTrainMove:Abort train move.Train=" & gMoveTrainSelectedID.Name)
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    If OptAllowAssistTrainPositionOnNonMainTracksOnly Then
                        If TMDS.SystemUtilities.FetchData.IsMainTypeTrack(Me) Then
                            ClearSystemVariables() : Exit Sub
                        End If
                    End If
                    If optEnableNeedOccupancyToPositionMoveTrain Then
                        If Me.AuthorityType = "CTC" And Not Me.Occuppied And Me.Indicating Then
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    ElseIf optEnableNeedOccupancyToPositionMoveTrainElseDeviceBlock Then
                        If Me.AuthorityType = "CTC" And Not Me.Occuppied And Me.Indicating Then
                            ApplyDeviceBlockForTrainSymbol(gMoveTrainSelectedID)
                        End If
                    End If
                    If optEnableCheckLicenseExistenceOnTrainMove Then
                        Dim a As Object
                        For Each a In OtherTrackAuthorities
                            If a.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                                Dim s As TMDS.TrackAuthority.SFAuthority = CType(a, TMDS.TrackAuthority.SFAuthority)
                                If s.IssueTo = gMoveTrainSelectedID.Name Then
                                    If Not Me.TrackAuthorities.Contains(s) Then
                                        ClearSystemVariables()
                                        Exit Sub
                                    End If
                                End If
                            End If
                        Next
                    End If
                    If optDisallowTrainIdPlacementOnTrackWithAuthorityOfOtherTrain Then
                        If Me.TrackAuthorities.Count > 0 And Mid(Me.AuthorityType, 1, 3) = "TWC" Then
                            Dim auth As Object
                            For Each auth In Me.TrackAuthorities
                                If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" Then
                                    sfa = CType(auth, SFAuthority)
                                    If Mid(sfa.IssueTo, 1, gMoveTrainSelectedID.IdentifingUnit.Length) = gMoveTrainSelectedID.IdentifingUnit Or Mid(sfa.IssueTo, 1, gMoveTrainSelectedID.Name.Length) = gMoveTrainSelectedID.Name Then
                                        okToMoveTrain = True
                                        Exit For
                                    End If
                                End If
                            Next
                        Else
                            okToMoveTrain = True
                        End If
                        If Not okToMoveTrain Then
                            messageList.Add(optTrainPositionString7)
                            messageList.Add(optTrainPositionString8)
                            messageList.Add("")
                            frmMessageBox = New frmMessageBox()
                            frmMessageBox.Owner = Me.CurrentDrawingForm
                            frmMessageBox.SetMessage(messageList, optTrainPositionString9, False, Me.CurrentDrawingForm.myLaunchPoint)
                            frmMessageBox.TopMost = True
                            frmMessageBox.ShowDialog()
                            frmMessageBox = Nothing
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    End If
                    If Me Is gMoveTrainSelectedTrack Then
                        Me.InitTrainDisplay()
                        Me.InvalidateTrainID()
                        Me.TrackEventLog("Clicked -(MOVE Train ID TO SAME TRACK):" & Me.GUID)
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    If Not IsNothing(gMoveTrainSelectedID.thisHelperIsLinkedToThisTrainID) Then
                        gMoveTrainSelectedID.thisHelperIsLinkedToThisTrainID.RemoveLinkTrainID()
                        gMoveTrainSelectedID.thisHelperIsLinkedToThisTrainID = Nothing
                    End If
                    Me.MoveTrainIDPlaceManual(gMoveTrainSelectedID, gMoveTrainSelectedTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, False, True)
                    If gSendOSMessageFromReportClearPositionTWC Then
                        gSendOSMessageFromReportClearPositionTWC = False
                        TMDS.NetworkMessages.CadMessages.SendTrainOSMessage(gMoveTrainSelectedID, gCadTransmitQueue, Me, gMoveTrainSelectedID.OSPreviousTrack, Me, "A")
                    End If
                    gMoveTrainID = False
                    gMoveTrainSelectedTrack.Draw(Me.Graphical)
                    gMoveTrainSelectedTrack.InvalidateTrainID()
                    Me.TrackEventLog("Clicked -(MOVE Train ID " & gMoveTrainSelectedID.Name & " TO TRACK):" & Me.GUID)
                    If Me.MOWIDs.Count <> 0 Then
                        Me.InitMOWDisplay()
                        Me.DrawMOWID()
                    End If
                    If gMoveTrainSelectedTrack.MOWIDs.Count <> 0 Then
                        gMoveTrainSelectedTrack.InitMOWDisplay()
                        gMoveTrainSelectedTrack.DrawMOWID()
                    End If
                    If gMoveTrainFromTrainStackForm Then
                        If Not TMDS.SystemForms.MySystemForms.frmTrainStack Is Nothing Then
                            TMDS.SystemForms.MySystemForms.frmTrainStack.ResetList()
                        End If
                    End If
                    If gSimulationMode And OptOnSimulationModeClearOSEventonTrnMove Then
                        gMoveTrainSelectedID.ClearOsReports()
                    End If
                    If optAutoReleaseLicenseOnTrainMove Then
                        If Me.AuthorityType = "TWC" Then
                            If Me.TrackAuthorities.Count > 0 Then
                                For Each auth As SFAuthority In Me.TrackAuthorities
                                    If auth.GetType.ToString = "TMDS.TrackAuthority.SFAuthority" AndAlso
                                            gMoveTrainSelectedID IsNot Nothing AndAlso
                                            auth.IssueTo = gMoveTrainSelectedID.Name Then
                                        sfa = CType(auth, SFAuthority)
                                        TrackEventLog("DoTrainMove:AuthFound:AuthorityNumber=" & sfa.AuthorityNumber.ToString & ":Train=" & sfa.IssueTo)
                                    End If
                                Next
                                If sfa Is Nothing Then
                                    ClearSystemVariables()
                                    Exit Sub
                                End If
                                lastTrack = TMDS.SystemUtilities.FetchData.FindLastTrackInList(sfa.Components)
                                authDirection = sfa.Direction

                                Dim FoundFlipFlop As Boolean = False
                                For Each comp As Object In sfa.Components
                                    If comp.GetType.ToString = gFlipFlopComponentName Then
                                        FoundFlipFlop = True
                                    End If
                                Next
                                If FoundFlipFlop Then
                                    sfa.Direction = Me.TrafficDirection
                                    authDirection = Me.TrafficDirection
                                    sfa.myTrain = gMoveTrainSelectedID
                                End If

                                If Not IsNothing(lastTrack) Then
                                    If Me.GUID = lastTrack.GUID Then
                                        SystemForms.MySystemForms.frmReportClr = New frmReportClear()
                                        SystemForms.MySystemForms.frmReportClr.ReportClearInitiatedByTrainMove = True
                                        SystemForms.MySystemForms.frmReportClr.Location = Me.CurrentDrawingForm.myLaunchPoint
                                        SystemForms.MySystemForms.frmReportClr.LoadForm()
                                        SystemForms.MySystemForms.frmReportClr.SimpleReportClearEvent(sfa)
                                        SystemForms.MySystemForms.frmReportClr.Dispose()
                                        SystemForms.MySystemForms.frmReportClr = Nothing
                                        If optUseSingleFormAuthorityVersionMRS Then
                                            If Not gMoveTrainSelectedID Is Nothing Then
                                                If optTWCOSEventType.Trim <> "" Then
                                                    gMoveTrainSelectedID.SendMRSTWCOSEvent(Me, authDirection)
                                                End If
                                            End If
                                        End If
                                    Else
                                        Me.DoRollUpWarrant(True, sfa)
                                    End If
                                Else
                                    Me.DoRollUpWarrant(True, sfa)
                                End If
                            End If
                        End If
                    End If
                    ClearSystemVariables()
                    Exit Sub
                Else
                    If Me.TrainIDs.Count = 0 Then
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    Me.MoveTrainIDSelect()
                    gMoveTrainSelectedTrack = Me
                    If Me.TrainIDs.Count > 0 Then
                        gMoveTrainSelectedID = Me.TrainIDs(pTrainPosition)
                    End If
                    TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curMove)
                    gMoveTrainSelected = True
                    Me.InvalidateTrainID()
                    Me.TrackEventLog("Clicked -(MOVE Train ID " & gMoveTrainSelectedID.Name & " FROM TRACK):" & Me.GUID)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                okToMoveTrain = Nothing
                frmMessageBox = Nothing
                messageList = Nothing
                sfa = Nothing
                lastTrack = Nothing
                authDirection = Nothing
            End Try
        End Sub

