        Public Sub DoOSTrain(Optional pTrain As TrainID = Nothing)
            Try
                Me.TrackEventLog("DoOSTrain")
                If gPlaceOSTrain Then
                    'Request confirmation of the dispatcher to move train
                    If Me.AuthorityType.Contains("TWC") AndAlso gMoveTrainSelectedID IsNot Nothing AndAlso Not ConfirmTrainMove(gMoveTrainSelectedID) Then
                        TrackEventLog("DoOSTrain:Abort train move.Train=" & gMoveTrainSelectedID.Name)
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    If Me.MOWIDs.Count <> 0 Then
                        gMoveTrainSelectedTrack.InitTrainDisplay()
                        ClearSystemVariables()
                    End If
                    If gMoveTrainSelectedTrack.GUID <> Me.GUID Then
                        Me.MoveTrainIDPlaceManual(gMoveTrainSelectedID, gMoveTrainSelectedTrack, True, TMDS.GlobalDeclarations.gDatabaseConnectionTrain)
                        gPlaceOSTrain = False
                        gMoveTrainSelectedTrack.Draw(Me.Graphical)
                        If optEnableLogOSOnAllTWCMoves Then
                            Me.LogOsMessage(Nothing, False, gMoveTrainSelectedID)
                        End If
                        Me.InitTrainDisplay()
                    Else
                        Me.LogOsMessage(Nothing, False, gMoveTrainSelectedID)
                        Me.InitTrainDisplay()
                    End If
                    If optApplyTrainSheetConfigurationForKCS And Not optEnableSendOSMessageFXE Then
                        TMDS.NetworkMessages.CadMessages.SendTrainOSMessage(gMoveTrainSelectedID, gCadTransmitQueue, Me, Nothing, Nothing, "D")
                    ElseIf optEnableSendOSMessageFXE Then
                        TMDS.NetworkMessages.CadMessages.SendTrainOSMessageFXE(gMoveTrainSelectedID, gCadTransmitQueue, Me, True)
                    ElseIf optEnableSendOSMessageARRC Then
                        TMDS.NetworkMessages.CadMessages.SendTrainOSMessageARRC(gMoveTrainSelectedID, gMISTransmitQueue, Me, True)
                    ElseIf optEnableSendOSMessageFECR Then
                        TMDS.NetworkMessages.CadMessages.SendTrainOSMessageFECR(gMoveTrainSelectedID, gCadTransmitQueue, Me, False)
                    ElseIf optEnableSendOSMessageCN Then
                        TMDS.NetworkMessages.CadMessages.SendTrainOSMessageCN(gMoveTrainSelectedID, gCadTransmitQueue, Me, False)
                    ElseIf optEnableSendOSMessageMRL Then
                        TMDS.NetworkMessages.CadMessages.SendTrainOSMessageMRL(gMoveTrainSelectedID, gCadTransmitQueue, Me)
                    ElseIf optEnableSendOSMessageDenver Then
                    End If
                    If gTrackIntegrityMonitoringExists Then
                        If gMoveTrainSelectedTrack.TrackZoneIntegrityMonitoringEnabled Then
                            Me.TrackZoneReference.AcknowledgeTrackZoneAlertFromOS(gMoveTrainSelectedID, Me)
                        End If
                    End If
                    Me.TrackEventLog("DoOSTrain:Train=" & gMoveTrainSelectedID.Name)
                    SystemForms.MySystemForms.frmSystemSummary.UpdateTrainSummaries()
                    Dim LogThisEvent As New DoEventLogTrainID(AddressOf gMoveTrainSelectedID.LogTheTrainIDEvent)
                    LogThisEvent.BeginInvoke(TrainID.EventTypeTrainID.OS, Nothing, Nothing)
                    ClearSystemVariables()
                    Exit Sub
                Else
                    If Me.TrainIDs.Count <> 0 Then
                        Me.MoveTrainIDSelect()
                        gMoveTrainSelectedTrack = Me
                        If Me.TrainIDs.Count > 0 Then
                            If pTrain IsNot Nothing Then 'Correct TrainStack selected
                                gMoveTrainSelectedID = pTrain
                            Else
                                gMoveTrainSelectedID = Me.TrainIDs(0)
                            End If
                            Me.TrackEventLog("DoOSTrain:Train=" & gMoveTrainSelectedID.Name)
                        End If
                        gPlaceOSTrain = True
                        TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curOSTrain)
                        Me.InvalidateTrainID()
                    Else
                        ClearSystemVariables()
                        Exit Sub
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

