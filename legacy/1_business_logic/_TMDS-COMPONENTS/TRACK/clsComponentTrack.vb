                            ElseIf CompToCheck.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                                Dim RR As RRXING = CType(CompToCheck, RRXING)
                                NextReferenceNumber = RR.FindExitGUID(LastRefNumber)
                            ElseIf CompToCheck Is Nothing Then
                                SearchLeftComplete = True
                                Exit While
                            Else
                                NextReferenceNumber = CompToCheck.LeftLink
                            End If
                            LoopControl = LoopControl + 1
                            If LoopControl > 50 Then SearchLeftComplete = True : LoopControl = 0 : Exit While
                        End While
                        LoopControlExternal = LoopControlExternal + 1
                        If LoopControlExternal > 50 Then SearchLeftComplete = True : LoopControlExternal = 0 : Exit While
                    End While

                    While Not SearchRightComplete
                        NextReferenceNumber = Me.RightLink
                        While Not NextTrackFound
                            CompToCheck = Me.FindObjectTypeFromGUID(NextReferenceNumber)
