            End Try
        End Sub

        Private Sub SlotSignalRequest()
            Try
                Dim SearchComplete, SearchRight As Boolean
                Dim I, NextReferenceNum, LoopTerminator As Int32
                Dim comp As Object


                For I = 1 To 2

                    NextReferenceNum = LeftLink
                    If I = 2 Then
                        SearchRight = True
                        NextReferenceNum = RightLink
                    End If

                    While Not SearchComplete
                        comp = Me.FindObjectTypeFromGUID(NextReferenceNum)
                        If comp Is Nothing Then Exit Sub
                        If Not SearchRight Then
                            If comp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                If comp.ComponentType = "R" And (comp.SignalStatus = Signal.BulbStatus.ClearStatus _
                                Or comp.SignalStatus = Signal.BulbStatus.RequestingClear) Then

                                    If optEnableMRSSpecificPTCOperations Then
                                        Me.PerformLicenseUpdateForMRS(comp)
                                    End If

                                    comp.SlotToStop(False)
                                    comp.SignalStatus = Signal.BulbStatus.StopStatus
                                    comp.SlottedByOSTrack = True
                                    comp.UpdateStatus()
                                    comp.InvalidateSignal()
                                End If
                                Exit While
                            ElseIf comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim trk As Track = CType(comp, Track)
                                If trk.NonTransverable Then
                                    Exit While
                                End If
                                NextReferenceNum = comp.LeftLink

                            ElseIf comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                If comp.ControlledReverse And comp.LeftAltLink <> 0 Then
                                    NextReferenceNum = comp.LeftAltLink
                                Else
                                    NextReferenceNum = comp.LeftLink
                                End If
                            Else
                                NextReferenceNum = comp.LeftLink
                            End If
                        Else
                            If comp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                                If comp.ComponentType = "L" And (comp.SignalStatus = Signal.BulbStatus.ClearStatus _
                                Or comp.SignalStatus = Signal.BulbStatus.RequestingClear) Then

                                    If optEnableMRSSpecificPTCOperations Then
                                        Me.PerformLicenseUpdateForMRS(comp)
                                    End If

                                    comp.SlotToStop(False)
                                    comp.SignalStatus = Signal.BulbStatus.StopStatus
                                    comp.SlottedByOSTrack = True
                                    comp.UpdateStatus()
                                    comp.InvalidateSignal()
                                    'End SyncLock
                                    Exit Sub
                                Else
                                    Exit While 'if signal found but not cleared or requested clear then jump from loop and search to the right
                                End If
                            ElseIf comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                Dim trk As Track = CType(comp, Track)
                                If trk.NonTransverable Then
                                    Exit While
                                End If
                                NextReferenceNum = comp.RightLink
                            ElseIf comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                If comp.ControlledReverse And comp.RightAltLink <> 0 Then
                                    NextReferenceNum = comp.RightAltLink
                                Else
                                    NextReferenceNum = comp.RightLink
                                End If
                            Else
                                NextReferenceNum = comp.RightLink
                            End If

                        End If

                        LoopTerminator = LoopTerminator + 1
                        If LoopTerminator > 100 Then Exit Sub

                    End While

                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Function ItemSevenCheck(ByRef DirectionOfWarrant As String) As Boolean
            Dim SearchDirection, NumOfNodes As Integer
            Dim NextCompToTest As Object = Nothing
            Dim NodeCompToTest As Object = Nothing
            Dim SwitchComp As Object = Nothing
            Dim CompCollectionToTest As New ArrayList()
            Dim EndOfTrackFound, SearchingNodesOnSwitchComplete As Boolean
            Dim ErrorMessage As String
            Dim Comp As Object

            Try
                For SearchDirection = 1 To 2
                    If SearchDirection = 1 Then
                        NextCompToTest = FindObjectTypeFromGUID(LeftLink)
                    Else
                        NextCompToTest = FindObjectTypeFromGUID(RightLink)
                        EndOfTrackFound = False
                    End If

                    If NextCompToTest Is Nothing Then
                        ItemSevenCheck = False
                        Exit Function
                    End If

                    'code added to allow item seven warrant at CTC and Yard Limits points
                    If Me.AuthorityType = "YL" Then
                        If DirectionOfWarrant = "RIGHT" Then
                            Comp = FindObjectTypeFromGUID(Me.RightLink)
                        Else
                            Comp = FindObjectTypeFromGUID(Me.LeftLink)
                        End If
                    Else

                        If DirectionOfWarrant = "RIGHT" Then
                            Comp = FindObjectTypeFromGUID(Me.LeftLink)
                        Else
                            Comp = FindObjectTypeFromGUID(Me.RightLink)
                        End If
                    End If
                    If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Or Comp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                    Else
                        Exit Function
                    End If

                    If Not Comp Is Nothing And (Comp.AuthorityType = "YL" Or Mid(Comp.AuthorityType, 1, 3) = "CTC") _
                    Or (Comp.ItemSevenAllowedOnLeftLimits And DirectionOfWarrant = "RIGHT") _
                    Or (Comp.ItemSevenAllowedOnRightLimits And DirectionOfWarrant = "LEFT") Then
                        'EndOfTrackFound = True
                        If Me.AuthorityType = "YL" Then
                            CompCollectionToTest.Add(Comp)
                        Else
                            CompCollectionToTest.Add(Me)
                        End If
                    End If
                    'code added to allow item seven warrant at CTC and Yard Limits points


                    While Not EndOfTrackFound

                        If NextCompToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If NextCompToTest.StationNumber = Me.StationNumber And NextCompToTest.TrackName = Me.TrackName Then
                                CompCollectionToTest.Add(NextCompToTest)
                                SwitchComp = NextCompToTest
                                For NumOfNodes = 1 To 3
                                    If NumOfNodes = 1 Then
                                        NodeCompToTest = FindObjectTypeFromGUID(SwitchComp.LeftLink)
                                    ElseIf NumOfNodes = 2 Then
                                        NodeCompToTest = FindObjectTypeFromGUID(SwitchComp.RightLink)
                                        SearchingNodesOnSwitchComplete = False
                                    ElseIf NumOfNodes = 3 Then
                                        If SwitchComp.LeftAltLink <> 0 Then
                                            NodeCompToTest = FindObjectTypeFromGUID(SwitchComp.LeftAltLink)
                                            SearchingNodesOnSwitchComplete = False
                                        ElseIf SwitchComp.RightAltLink <> 0 Then
                                            NodeCompToTest = FindObjectTypeFromGUID(SwitchComp.RightAltLink)
                                            SearchingNodesOnSwitchComplete = False
                                        Else
                                            SearchingNodesOnSwitchComplete = True
                                            EndOfTrackFound = True
                                        End If
                                    Else
                                        SearchingNodesOnSwitchComplete = True
                                    End If


                                    'searching through switch node
                                    While Not SearchingNodesOnSwitchComplete
                                        If NodeCompToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                            SearchingNodesOnSwitchComplete = True
                                        ElseIf NodeCompToTest.StationNumber = Me.StationNumber And NodeCompToTest.Name = Me.Name Then
                                            If Not CompCollectionToTest.Contains(NodeCompToTest) Then
                                                CompCollectionToTest.Add(NodeCompToTest)
                                            End If
                                            If NumOfNodes = 1 Then
                                                NodeCompToTest = FindObjectTypeFromGUID(NodeCompToTest.LeftLink)
                                            ElseIf NumOfNodes = 2 Then
                                                NodeCompToTest = FindObjectTypeFromGUID(NodeCompToTest.RightLink)
                                            ElseIf NumOfNodes = 3 Then
                                                If SwitchComp.LeftAltLink <> 0 Then
                                                    NodeCompToTest = FindObjectTypeFromGUID(NodeCompToTest.LeftLink)
                                                ElseIf SwitchComp.RightAltLink <> 0 Then
                                                    NodeCompToTest = FindObjectTypeFromGUID(NodeCompToTest.RightLink)
                                                Else
                                                    SearchingNodesOnSwitchComplete = True
                                                End If
                                                EndOfTrackFound = True
                                            Else
                                                SearchingNodesOnSwitchComplete = True
                                            End If

                                        Else
                                            SearchingNodesOnSwitchComplete = True
                                        End If
                                    End While 'searching through switch node
                                Next NumOfNodes
                                EndOfTrackFound = True
                            Else
                                EndOfTrackFound = True
                            End If
                        Else
                            If NextCompToTest.StationNumber = Me.StationNumber And NextCompToTest.Name = Me.Name Then
                                CompCollectionToTest.Add(NextCompToTest)
                                If SearchDirection = 1 Then
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.LeftLink)
                                Else
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.RightLink)
                                End If
                            Else
                                EndOfTrackFound = True
                            End If
                        End If
                    End While
                Next
                Dim CompToTestForWarrant As Object
                Dim ConflictingWarrantFound As Boolean
                'test for number of warrants 
                'Also look to see if the track is bi-directional ABS if more warrants then one exist.
                For Each CompToTestForWarrant In CompCollectionToTest
                    'If CompToTestForWarrant.Authorities.Count > 1  Then
                    If CompToTestForWarrant.Authorities.Count > 1 Then
                        If Not CompToTestForWarrant.BiDirectionalABS Then
                            ItemSevenCheck = False
                            CompCollectionToTest = Nothing
                            ErrorMessage = "Too Many Warrants! Not Compatiable With An Item Seven Warrant! - EXITTING"
                            TrackEventLog(ErrorMessage)
                            'MessageBox.Show(SystemForms.MySystemForms.frmDisplay, ErrorMessage, "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            Exit Function
                        End If
                    End If

                Next

                'test for type warrants different then an item 3 warrant
                For Each CompToTestForWarrant In CompCollectionToTest
                    If CompToTestForWarrant.Authorities.Count > 0 Then
                        Dim warr As Warrant = CompToTestForWarrant.Authorities(0)
                        If warr.WarrantType <> "ItemTwoToTrain" Then
                            ItemSevenCheck = False
                            CompCollectionToTest = Nothing
                            ErrorMessage = "This Type of Track Warrant Not Compatiable With An Item Seven Warrant! - EXITTING"
                            TrackEventLog(ErrorMessage)
                            Exit Function
                        End If
                    End If
                Next



                'test for meet at a switch
                Dim ItemSevenSituationFound As Boolean
                For Each CompToTestForWarrant In CompCollectionToTest
                    If CompToTestForWarrant.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        'If CompToTestForWarrant.pControlled Then
                        ItemSevenSituationFound = True
                        'Else
                        'ItemSevenCheck = False
                        'Exit Function
                        'End If
                    End If
                Next

                'TEST FOR MEET AT CTC OR YARD LIMITS
                'code added to allow item seven warrant at CTC and Yard Limits points
                If Me.AuthorityType = "YL" Then
                    If DirectionOfWarrant = "RIGHT" Then
                        Comp = FindObjectTypeFromGUID(Me.RightLink)
                    Else
                        Comp = FindObjectTypeFromGUID(Me.LeftLink)
                    End If
                Else
                    If DirectionOfWarrant = "RIGHT" Then
                        Comp = FindObjectTypeFromGUID(Me.LeftLink)
                    Else
                        Comp = FindObjectTypeFromGUID(Me.RightLink)
                    End If
                End If

                If Not Comp Is Nothing And (Comp.AuthorityType = "YL" Or Mid(Comp.AuthorityType, 1, 3) = "CTC") _
                Or (Comp.ItemSevenAllowedOnLeftLimits And DirectionOfWarrant = "RIGHT") _
                Or (Comp.ItemSevenAllowedOnRightLimits And DirectionOfWarrant = "LEFT") Then

                    ItemSevenSituationFound = True
                End If
                'code added to allow item seven warrant at CTC and Yard Limits points


                If ItemSevenSituationFound = False Then
                    ItemSevenCheck = False
                    CompCollectionToTest = Nothing
                    Exit Function
                End If

                'test for Same warrant
                Dim FirstWarrantFound As Boolean = False
                Dim FirstWarrant As Warrant = Nothing
                Dim OtherWarrantFound As Warrant = Nothing
                For Each CompToTestForWarrant In CompCollectionToTest
                    If CompToTestForWarrant.Authorities.Count > 0 Then
                        If Not FirstWarrantFound Then
                            ConflictingWarrantFound = True
                            FirstWarrantFound = True
                            FirstWarrant = CompToTestForWarrant.Authorities.Item(0)
                        Else
                            OtherWarrantFound = CompToTestForWarrant.Authorities.Item(0)
                            If OtherWarrantFound.WarrantNumber <> FirstWarrant.WarrantNumber Then
                                ItemSevenCheck = False
                                CompCollectionToTest = Nothing
                                Exit Function
                            End If
                        End If
                    End If
                Next
                Dim DebugMessage As String = String.Empty
                For Each CompToTestForWarrant In CompCollectionToTest
                    DebugMessage = DebugMessage & "ITEM SEVEN COMPONENT:"
                    DebugMessage = DebugMessage & CompToTestForWarrant.GetType.ToString & vbCrLf
                    DebugMessage = DebugMessage & CompToTestForWarrant.Authorities.Count & vbCrLf
                    DebugMessage = DebugMessage & CompToTestForWarrant.GUID & vbCrLf
                    DebugMessage = DebugMessage & CompToTestForWarrant.Name & vbCrLf
                    DebugMessage = DebugMessage & "----------------------------------" & vbCrLf
                Next
                'MsgBox(DebugMessage)
                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.InformationEvent, "ItemSevenComponentList:" & DebugMessage, SystemEventQueue)
                SysEvent = Nothing

                If Not ConflictingWarrantFound Then
                    ItemSevenCheck = False
                    CompCollectionToTest = Nothing
                    Exit Function
                End If

                If DirectionOfWarrant = FirstWarrant.Direction Then
                    ItemSevenCheck = False
                    CompCollectionToTest = Nothing
                    Exit Function
                End If

                ItemSevenCheck = True

                If gTrackSelectionCollection.Item(0) Is gBeginTrackSelect Then
                    If (Not Mid(gTrackSelectionCollection.Item(0).AuthorityType, 1, 3) = "TWC") Then
                        gTrackSelectionCollection.Remove(gBeginTrackSelect)
                        gBeginTrackSelect.SelectionMode = GenericComponent.ModeSelection.Regular
                        gBeginTrackSelect.FlasherMode(False)
                        gBeginTrackSelect.Refresh()
                    End If
                End If

                CompCollectionToTest = Nothing
            Catch ex As Exception
                ItemSevenCheck = False
                SystemException(ex.ToString)
            End Try
        End Function

        Function ItemFiveCheck(ByRef DirectionOfWarrant As String) As Boolean
            Dim SearchDirection, NumOfNodes As Integer
            Dim NextCompToTest As Object = Nothing
            Dim NodeCompToTest As Object = Nothing
            Dim SwitchComp As Object = Nothing
            Dim CompCollectionToTest As New ArrayList()
            Dim EndOfTrackFound, SearchingNodesOnSwitchComplete As Boolean
            Dim ErrorMessage As String
            Dim Comp As Object = Nothing

            Try
                For SearchDirection = 1 To 2
                    If SearchDirection = 1 Then
                        NextCompToTest = FindObjectTypeFromGUID(LeftLink)
                        If NextCompToTest Is Nothing And Not Me.AllowOpposingAuthorityCreationToRight Then
                            Return False
                        ElseIf Me.AllowOpposingAuthorityCreationToRight Then
                            NextCompToTest = Me
                        End If

                    Else
                        NextCompToTest = FindObjectTypeFromGUID(RightLink)
                        EndOfTrackFound = False
                        If NextCompToTest Is Nothing And Not Me.AllowOpposingAuthorityCreationToLeft Then
                            Return False
                        ElseIf Me.AllowOpposingAuthorityCreationToLeft Then
                            NextCompToTest = Me
                        End If
                    End If


                    'code added to allow item seven warrant at CTC and Yard Limits points
                    If Me.AuthorityType = "YL" Or Me.AuthorityType = "CTC" Then
                        If DirectionOfWarrant = "RIGHT" Then
                            Comp = FindObjectTypeFromGUID(Me.RightLink)
                        Else
                            Comp = FindObjectTypeFromGUID(Me.LeftLink)
                        End If
                    Else
                        If DirectionOfWarrant = "RIGHT" Then
                            If Me.AllowOpposingAuthorityCreationToRight Then
                                Comp = Me
                            End If
                        Else
                            If Me.AllowOpposingAuthorityCreationToLeft Then
                                Comp = Me
                            End If
                        End If
                    End If
                    If IsNothing(Comp) Then Exit Function
                    If Comp.GetType.ToString = "TMDS.TrackComponents.Track" Or Comp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                    Else
                        Exit Function
                    End If

                    If Not Comp Is Nothing And (Comp.AuthorityType = "YL" Or Mid(Comp.AuthorityType, 1, 3) = "CTC") _
                    Or (Comp.AllowOpposingAuthorityCreationToLeft And DirectionOfWarrant = "LEFT") _
                    Or (Comp.AllowOpposingAuthorityCreationToRight And DirectionOfWarrant = "RIGHT") Then
                        If Me.AuthorityType = "YL" Then
                            CompCollectionToTest.Add(Comp)
                        Else
                            CompCollectionToTest.Add(Me)
                        End If
                    End If
                    'code added to allow item seven warrant at CTC and Yard Limits points


                    While Not EndOfTrackFound
                        If IsNothing(NextCompToTest) Then
                            Exit While
                        End If
                        If NextCompToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If NextCompToTest.StationNumber = Me.StationNumber And NextCompToTest.TrackName = Me.TrackName Then
                                CompCollectionToTest.Add(NextCompToTest)
                                SwitchComp = NextCompToTest
                                For NumOfNodes = 1 To 3
                                    If NumOfNodes = 1 Then
                                        NodeCompToTest = FindObjectTypeFromGUID(SwitchComp.LeftLink)
                                    ElseIf NumOfNodes = 2 Then
                                        NodeCompToTest = FindObjectTypeFromGUID(SwitchComp.RightLink)
                                        SearchingNodesOnSwitchComplete = False
                                    ElseIf NumOfNodes = 3 Then
                                        If SwitchComp.LeftAltLink <> 0 Then
                                            NodeCompToTest = FindObjectTypeFromGUID(SwitchComp.LeftAltLink)
                                            SearchingNodesOnSwitchComplete = False
                                        ElseIf SwitchComp.RightAltLink <> 0 Then
                                            NodeCompToTest = FindObjectTypeFromGUID(SwitchComp.RightAltLink)
                                            SearchingNodesOnSwitchComplete = False
                                        Else
                                            SearchingNodesOnSwitchComplete = True
                                            EndOfTrackFound = True
                                        End If
                                    Else
                                        SearchingNodesOnSwitchComplete = True
                                    End If


                                    'searching through switch node
                                    While Not SearchingNodesOnSwitchComplete
                                        If NodeCompToTest.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                            SearchingNodesOnSwitchComplete = True
                                        ElseIf NodeCompToTest.StationNumber = Me.StationNumber And NodeCompToTest.Name = Me.Name Then
                                            If Not CompCollectionToTest.Contains(NodeCompToTest) Then
                                                CompCollectionToTest.Add(NodeCompToTest)
                                            End If
                                            If NumOfNodes = 1 Then
                                                NodeCompToTest = FindObjectTypeFromGUID(NodeCompToTest.LeftLink)
                                            ElseIf NumOfNodes = 2 Then
                                                NodeCompToTest = FindObjectTypeFromGUID(NodeCompToTest.RightLink)
                                            ElseIf NumOfNodes = 3 Then
                                                If SwitchComp.LeftAltLink <> 0 Then
                                                    NodeCompToTest = FindObjectTypeFromGUID(NodeCompToTest.LeftLink)
                                                ElseIf SwitchComp.RightAltLink <> 0 Then
                                                    NodeCompToTest = FindObjectTypeFromGUID(NodeCompToTest.RightLink)
                                                Else
                                                    SearchingNodesOnSwitchComplete = True
                                                End If
                                                EndOfTrackFound = True
                                            Else
                                                SearchingNodesOnSwitchComplete = True
                                            End If

                                        Else
                                            SearchingNodesOnSwitchComplete = True
                                        End If
                                    End While 'searching through switch node
                                Next NumOfNodes
                                EndOfTrackFound = True
                            Else
                                EndOfTrackFound = True
                            End If
                        Else
                            If NextCompToTest.StationNumber = Me.StationNumber And NextCompToTest.Name = Me.Name Then
                                CompCollectionToTest.Add(NextCompToTest)
                                If SearchDirection = 1 Then
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.LeftLink)
                                Else
                                    NextCompToTest = FindObjectTypeFromGUID(NextCompToTest.RightLink)
                                End If
                            Else
                                EndOfTrackFound = True
                            End If
                        End If
                    End While
                Next
                Dim CompToTestForWarrant As Object
                Dim ConflictingWarrantFound As Boolean
                Dim ItemSevenSituationFound As Boolean

                'test for number of warrants 
                'Also look to see if the track is bi-directional ABS if more warrants then one exist.
                For Each CompToTestForWarrant In CompCollectionToTest
                    'If CompToTestForWarrant.Authorities.Count > 1  Then
                    If CompToTestForWarrant.TrackAuthorities.Count >= 1 Then
                        If CompToTestForWarrant.BiDirectionalABS Or CompToTestForWarrant.SingleABSEast Or CompToTestForWarrant.SingleABSWest Then
                            Dim auth As SFAuthority
                            For Each auth In CompToTestForWarrant.TrackAuthorities
                                If auth.Direction <> DirectionOfWarrant Then
                                    ItemSevenSituationFound = True
                                    ConflictingWarrantFound = True
                                    Exit For
                                End If
                            Next
                        ElseIf CompToTestForWarrant.TrackAuthorities.Count > 1 Then
                            Dim auth As SFAuthority
                            Dim OverrideConflict As Boolean = True
                            Dim FirstItemTwoFound As Boolean = False
                            For Each auth In CompToTestForWarrant.TrackAuthorities
                                If Not auth.CheckBoxItemsStatus(4) Then
                                    If Not FirstItemTwoFound Then
                                        If auth.CheckBoxItemsStatus(1) Then
                                            FirstItemTwoFound = True
                                        Else
                                            OverrideConflict = False
                                        End If
                                    ElseIf auth.CheckBoxItemsStatus(7) And auth.AuthType1 = "ItemFourToMOW" Then
                                        OverrideConflict = True
                                    Else
                                        OverrideConflict = False
                                        Exit For
                                    End If
                                ElseIf auth.CheckBoxItemsStatus(7) And auth.AuthType1 = "ItemFourToMOW" Then
                                    OverrideConflict = True
                                ElseIf auth.CheckBoxItemsStatus(4) And gSearchDirection = auth.Direction And gItemTwoFiveVoidedAuthorityCandidate Is Nothing Then
                                    OverrideConflict = True
                                    gItemTwoFiveVoidedAuthorityCandidate = auth
                                End If
                                'If Not auth.CheckBoxItemsStatus(4) Then
                                '    If Not FirstItemTwoFound Then
                                '        If auth.CheckBoxItemsStatus(1) Then
                                '            FirstItemTwoFound = True
                                '        Else
                                '            OverrideConflict = False
                                '        End If
                                '    Else
                                '        OverrideConflict = False
                                '        Exit For
                                '    End If
                                'ElseIf auth.CheckBoxItemsStatus(4) And gSearchDirection = auth.Direction And gItemTwoFiveVoidedAuthorityCandidate Is Nothing Then
                                '    OverrideConflict = True
                                '    gItemTwoFiveVoidedAuthorityCandidate = auth
                                'End If
                            Next
                            If Not OverrideConflict Then
                                CompCollectionToTest = Nothing
                                ErrorMessage = "Too Many Warrants! Not Compatiable With An Item Five Warrant! - EXITTING"
                                TrackEventLog(ErrorMessage)
                                Return False
                            Else
                                OverrideConflict = True
                                FirstItemTwoFound = False
                            End If
                        End If
                    End If

                Next

                'test for type warrants different then an item 3 warrant
                For Each CompToTestForWarrant In CompCollectionToTest
                    If CompToTestForWarrant.TrackAuthorities.Count > 0 Then
                        Dim warr As SFAuthority = CompToTestForWarrant.TrackAuthorities(0)
                        If warr.AuthType1 <> "ItemTwoToTrain" Then
                            CompCollectionToTest = Nothing
                            ErrorMessage = "This Type of Track Warrant Not Compatiable With An Item Five Warrant! - EXITTING"
                            TrackEventLog(ErrorMessage)
                            Return False
                        ElseIf warr.Box4Components.Contains(Me) And Not warr.ShowItemFourComponents Then
                            CompCollectionToTest = Nothing
                            ErrorMessage = "Pending Item 4 warrant found! - EXITTING"
                            TrackEventLog(ErrorMessage)
                            Return False
                        End If
                    End If
                Next



                'test for meet at a switch
                'Dim ItemSevenSituationFound As Boolean
                For Each CompToTestForWarrant In CompCollectionToTest
                    If CompToTestForWarrant.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        'If CompToTestForWarrant.pControlled Then
                        ItemSevenSituationFound = True
                        'Else
                        'ItemSevenCheck = False
                        'Exit Function
                        'End If
                    End If
                Next

                'TEST FOR MEET AT CTC OR YARD LIMITS
                'code added to allow item seven warrant at CTC and Yard Limits points
                If Me.AuthorityType = "YL" Or Me.AuthorityType = "CTC" Then
                    If DirectionOfWarrant = "RIGHT" Then
                        Comp = FindObjectTypeFromGUID(Me.RightLink)
                    Else
                        Comp = FindObjectTypeFromGUID(Me.LeftLink)
                    End If
                Else
                    If DirectionOfWarrant = "RIGHT" Then
                        If Me.AllowOpposingAuthorityCreationToRight Then
                            Comp = Me
                        End If
                    Else
                        If Me.AllowOpposingAuthorityCreationToLeft Then
                            Comp = Me
                        End If
                    End If

                End If

                If Not Comp Is Nothing And (Comp.AuthorityType = "YL" Or Mid(Comp.AuthorityType, 1, 3) = "CTC") _
                Or (Comp.AllowOpposingAuthorityCreationToLeft And DirectionOfWarrant = "LEFT") _
                Or (Comp.AllowOpposingAuthorityCreationToRight And DirectionOfWarrant = "RIGHT") Then

                    ItemSevenSituationFound = True
                End If
                'code added to allow item seven warrant at CTC and Yard Limits points


                If Not ItemSevenSituationFound Then
                    Return False
                End If

                'test for Same warrant
                Dim FirstWarrantFound As Boolean = False
                Dim FirstWarrant As SFAuthority = Nothing
                Dim OtherWarrantFound As SFAuthority = Nothing
                For Each CompToTestForWarrant In CompCollectionToTest
                    If CompToTestForWarrant.TrackAuthorities.Count > 0 Then
                        If CompToTestForWarrant.BiDirectionalABS Or CompToTestForWarrant.SingleABSEast Or CompToTestForWarrant.SingleABSWest Then
                            'do nothing
                        Else

                            If Not FirstWarrantFound Then
                                ConflictingWarrantFound = True
                                FirstWarrantFound = True
                                FirstWarrant = CompToTestForWarrant.TrackAuthorities.Item(0)
                            Else
                                OtherWarrantFound = CompToTestForWarrant.TrackAuthorities.Item(0)
                                If OtherWarrantFound.AuthorityUID <> FirstWarrant.AuthorityUID Then
                                    Return False
                                End If
                            End If
                        End If
                    End If
                Next
                Dim DebugMessage As String = String.Empty
                For Each CompToTestForWarrant In CompCollectionToTest
                    DebugMessage = DebugMessage & "ITEM FIVE COMPONENT:"
                    DebugMessage = DebugMessage & CompToTestForWarrant.GetType.ToString & vbCrLf
                    DebugMessage = DebugMessage & CompToTestForWarrant.Authorities.Count & vbCrLf
                    DebugMessage = DebugMessage & CompToTestForWarrant.GUID & vbCrLf
                    DebugMessage = DebugMessage & CompToTestForWarrant.Name & vbCrLf
                    DebugMessage = DebugMessage & "----------------------------------" & vbCrLf
                Next
                'MsgBox(DebugMessage)
                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.InformationEvent, "ItemSevenComponentList:" & DebugMessage, SystemEventQueue)
                SysEvent = Nothing

                If Not ConflictingWarrantFound Then
                    Return False
                End If
                If Not IsNothing(FirstWarrant) Then
                    If DirectionOfWarrant = FirstWarrant.Direction Then
                        Return False
                    End If
                End If
                ItemFiveCheck = True

                If gTrackSelectionCollection.Item(0) Is gBeginTrackSelect Then
                    If (Not Mid(gTrackSelectionCollection.Item(0).AuthorityType, 1, 3) = "TWC") Then
                        gTrackSelectionCollection.Remove(gBeginTrackSelect)
                        gBeginTrackSelect.SelectionMode = GenericComponent.ModeSelection.Regular
                        gBeginTrackSelect.FlasherMode(False)
                        gBeginTrackSelect.Refresh()
                    End If
                End If

                CompCollectionToTest = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False

            End Try
        End Function

