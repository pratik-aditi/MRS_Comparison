                    'miVoid.Visible = True
                    For Each auth In Me.Authorities
                        Me.mnuTWCRemove.MenuItems.Add(New MenuItem(auth.WarrantNumber & ", (" & auth.IssueTo & ")", AddressOf mnuTWCRemove_Click))
                    Next

                ElseIf Me.TrackAuthorities.Count > 0 Then
                    Dim auth As TrackAuthority.SFAuthority
                    miRemove.Visible = True
                    miModify.Visible = True
                    If optEnableVoidAuthorityMenuItem Then
                        miVoid.Visible = True
                    End If

                    For Each auth In Me.TrackAuthorities
