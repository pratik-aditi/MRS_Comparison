#Region "REMOTE TRACK METHODS"

        Public Function CheckForLeftTrafficStatus() As Boolean
            Try
                Dim NoLeftConflict As Boolean
                Dim LeftSignalFound As Boolean
                Dim LoopControl As Integer
                Dim LastComp As Object = Nothing
                Dim CompToStart As Object = Me
                Dim FlipIt As Boolean
                If CompToStart.IsRemoteTrack Then
                    Return True
                End If

                Dim NextComp As Object = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(CompToStart.RightLink)

                While Not LeftSignalFound
                    If NextComp Is Nothing Then
                        NoLeftConflict = False
                        Exit While
                    End If
                    If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        LastComp = NextComp
                        If NextComp.IsLinkToRemoteTrack Or NextComp.IsRemoteTrack Then
                            Return True
                        End If
                        Dim trk As Track = CType(NextComp, Track)
                        If NextComp.SignalStatOnMe <> TrackComponents.Track.SignalStatus.SignalAtStop And NextComp.TrafficDirection <> "RIGHT" Then
                            NoLeftConflict = False
                            Exit While
                        End If
                        If NextComp.NonTransverable Then
                            NoLeftConflict = True
                            Exit While
                        End If

                        If trk.OStype And trk.TrafficDirection <> "RIGHT" And trk.Occuppied Then
                            NoLeftConflict = False
                            Exit While
                        End If
                        If FlipIt Then
                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                        End If

                        If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            Dim swToCheck As Switch = CType(NextComp, Switch)
                            If swToCheck.LeftAltLink <> 0 And swToCheck.LeftAltLink = trk.GUID And Not swToCheck.ControlledReverse Then
                                NoLeftConflict = True
                                Exit While
                            End If
                            If swToCheck.RightAltLink <> 0 And swToCheck.RightAltLink = trk.GUID And Not swToCheck.ControlledReverse Then
                                NoLeftConflict = True
                                Exit While
                            End If
                        End If
                    ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        'If NextComp.SignalStatOnMe <> SwitchComponents.Switch.SignalStatus.SignalAtStop And NextComp.TrafficDirection <> "RIGHT" Then
                        '    NoLeftConflict = False 
                        '    Exit While
                        'End If

                        If NextComp.RightAltLink <> 0 Then
                            If NextComp.ControlledReverse Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightAltLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                        End If
                    ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If NextComp.ComponentType = "L" Then
                            If Not FlipIt Then
                                Dim sig As Signal = CType(NextComp, Signal)
                                If sig.SignalStatus <> SignalComponents.Signal.BulbStatus.StopStatus Or sig.FleetEnabled Then 'Or sig.StoredEntrySignal Then
                                    NoLeftConflict = False
                                    Exit While
                                End If
                            End If
                            NoLeftConflict = True
                            Exit While
                        Else
                            If FlipIt Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                            End If

                            'NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                        End If
                    ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                        'FlipIt = True
                        If FlipIt Then
                            FlipIt = False
                        Else
                            FlipIt = True
                        End If
                        NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                    ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                        Dim rr As RRXING = CType(NextComp, RRXING)
                        NextComp = rr.FindExitComponent(LastComp.GUID)
                    Else
                        NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                    End If
                    LoopControl = LoopControl + 1
                    If LoopControl = 50 Then
                        NoLeftConflict = False
                        Exit While
                    End If
                End While
                If NoLeftConflict Then
                    Return True
                Else
                    Return False
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Function CheckForRightTrafficStatus() As Boolean
            Try
                Dim NoRightConflict As Boolean
                Dim RightSignalFound As Boolean
                Dim LoopControl As Integer
                Dim LastComp As Object = Nothing
                Dim CompToStart As Object = Me
                Dim FlipIt As Boolean
                If CompToStart.IsRemoteTrack Then
