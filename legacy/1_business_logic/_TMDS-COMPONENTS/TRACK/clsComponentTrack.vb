        Public Sub DoTrainPermissionToEnterMainTrack(ByVal theTrain As TrainID, ByVal theSwitch As TMDS.SwitchComponents.Switch)
            Try
                Select Case Me.AuthorityType
                    Case "SHELF", "OTHER"
                        Exit Sub
                End Select
                If Mid(Me.AuthorityType, 1, 3) <> "CTC" Then ClearSystemVariables() : Exit Sub

                'this is to not check the first entry track inthe invalidation check for this route
                If gEntryTrack Is Nothing Then
                    gFirstEntryTrack = Me
                End If
                gEntryTrack = Me
                gEntExtTrackSelection.Add(gEntryTrack)
                gEntryTrack.SelectionMode = GenericComponent.ModeSelection.SummarySelectionRouting

                gEntryTrack.FlashComponent = True
                gTrackAuthSelectionFlashOn = True
                TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionEntExt.Enabled = True
                Me.AddOSComponents(gEntExtTrackSelection)
                Me.ExpandOutForComponents(gEntExtTrackSelection)
                If Mid(gEntryTrack.AuthorityType, 1, 3) <> "CTC" Then
                    ClearSystemVariables()
                    MessageBox.Show(Me, "Route Selected Is Not CTC Controlled", "System Message", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Exit Sub
                End If
                If Not gEntryTrack Is Nothing Then
                    If PerformConflictCheckToEnterMainTrack(theTrain) Then
                        theTrain.ShowDialogToEnterMainTrack_MRS(theSwitch, Me, False)
                    Else
                        MySystemForms.frmMainMDI.ClearEntExtSelection()
                        MySystemForms.frmMainMDI.EntExtFlasherReset()
                        ClearSystemVariables()
                        Exit Sub
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

