        Private Sub DoCheckToStopTrainOnOccupancy() 'release license behind the train
            Try
                TrackEventLog("DoCheckToStopTrainOnOccupancy:Start")
                Threading.Thread.Sleep(3000)

                Dim theTrack As Track = Me
                If theTrack.TrackAuthorities.Count = 0 Then Exit Sub
                If Not theTrack.IsTrackWarrantEnforcementEnabled Then Exit Sub

                'RMTXXX -Check if DD Is true
                'I added the condition when OS switch coming occupied together with DD
                'jcosta -2/2/17

                If Not theTrack.DerailmentDetectorIndBit Is Nothing AndAlso theTrack.DerailmentDetectorIndBit.BitState = True Then
                    TrackEventLog("DoCheckToStopTrainOnOccupancy:DerailmentDetectorEnabled")
                    Exit Sub
                End If

                Dim auth As TrackAuthority.TrackAuthority = Me.TrackAuthorities.Item(0)
                If IsNothing(auth) Then Exit Sub
                Dim theTrain As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(auth.IssueTo)
                If IsNothing(theTrain) Then Exit Sub

                'RMT660 - Auto cancel improper in rear of the train
                'Need to add tracks from rear until front of the train
                'jcosta-2/1/17

                Dim TracksTrain As Object
                Dim TrackTrainList As New ArrayList

                'Add tracks from rear until front of the train
                For Each TracksTrain In auth.ComponentsInSelection

                    If TracksTrain.GetType.ToString = "TMDS.TrackComponents.Track" Then

                        Dim TrackAux As Track = CType(TracksTrain, Track)
                        TrackTrainList.Add(TrackAux.GUID)

                        'Until track with train id
                        If TrackAux.GUID = theTrain.myTrack.GUID Then
                            Exit For
                        End If

                    End If
                Next

                'RMT677 - Auto cancel doesn't work when there are two false occupancies the front
                'Need to check if tracks left and right are in train list
                'jcosta-2/14/17

                Dim leftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToLeft(theTrack.LeftLink)
                If Not IsNothing(leftTrack) Then
                    'Check if lefttrack is occuppied and lefttrack is in train list
                    'If leftTrack.Occuppied And TrackTrainList.Contains(leftTrack.GUID) Then Exit Sub
                    If leftTrack.Occuppied Then Exit Sub
                End If

                Dim rightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToRight(theTrack.RightLink)
                If Not IsNothing(rightTrack) Then
                    'Check if righttrack is occuppied and righttrack is in train list
                    'If rightTrack.Occuppied And TrackTrainList.Contains(rightTrack.GUID) Then Exit Sub
                    If rightTrack.Occuppied Then Exit Sub
                End If

                If Me.Occuppied And Me.TrainIDs.Count = 0 Then

                    'Check if track is behind of the train
                    If TrackTrainList.Contains(Me.GUID) Then
                        TrackEventLog("DoCheckToStopTrainOnOccupancy:TrackBehindTrain:Train=" & theTrain.Name)
                        Exit Sub
                    End If

                    Dim tr As TacticalRoute
                    Dim theRoute As TacticalRoute = Nothing
                    Dim theAutomaticRoute As TacticalRoute = Nothing
                    Dim theList As New ArrayList

                    For Each tr In theTrain.myTacticalRoutes

                        TrackEventLog("DoCheckToStopTrainOnOccupancy:EntrySignal=" & tr.mySignalRoute.EntrySignal.Name & ":Train=" & theTrain.Name)

                        If tr.mySignalRoute.EntrySignal.SignalCtlStatus = Signal.CtlStatus.RequestedClear OrElse tr.mySignalRoute.EntrySignal.SignalCtlStatus = Signal.CtlStatus.RequestedClear Then
                            theRoute = tr
                        End If

                        If tr.mySignalRoute.ComponentList.Contains(Me) Then
                            If tr.mySignalRoute.EntrySignal.AutomaticSignal Then theAutomaticRoute = tr
                            Exit For
                        End If

                    Next

                    If Not IsNothing(theRoute) Then

                        TrackEventLog("DoCheckToStopTrainOnOccupancy:Absolute:CancelLicenseForTrain:Train=" & theTrain.Name)
                        If Not theTrain.GeoFenceLegacyEnabled Then theTrain.PtcCancelNormalLicense(theRoute.mySignalRoute.EntrySignal, True)

                    ElseIf Not IsNothing(theAutomaticRoute) Then

                        TrackEventLog("DoCheckToStopTrainOnOccupancy:Automatic:CancelLicenseForTrain:Train=" & theTrain.Name)
                        If Not theTrain.GeoFenceLegacyEnabled Then theTrain.PtcCancelNormalLicense(theAutomaticRoute.mySignalRoute.EntrySignal, True)

                    End If

                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

