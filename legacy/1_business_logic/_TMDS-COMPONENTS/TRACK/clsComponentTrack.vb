        Public Function FindRemoteLinkConnection() As TMDS.NetworkListener.WrkstnConnection
            Try
                Dim client As TMDS.NetworkListener.WrkstnConnection
                Dim entry As DictionaryEntry
                For Each entry In gRemoteLinkHashTable
                    client = CType(entry.Value, TMDS.NetworkListener.WrkstnConnection)
                    If client.ConnectingObject Is Me Then
                        Return client
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub ApplyTrackAuthority(ByVal AuthUID As String, Optional ByVal FoundFlipFlop As Boolean = False, Optional ByVal RemoteTrackDirection As String = "")

            TrackEventLog("ApplyTrackAuthority-AuthUID:" & AuthUID & "-FoundFlipFlop:" & FoundFlipFlop.ToString & "-RemoteTrackDirection:" & RemoteTrackDirection)

            Dim AuthorityFetch As String
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseCommand As OleDbCommand = Nothing
            Dim dbconn As OleDbConnection = Nothing
            Dim auth As TrackAuthority.TrackAuthority = Nothing
            Dim authority As Object = Nothing

            Try
                Dim AuthorityExists As Boolean
                Dim AuthThatExists As TrackAuthority.TrackAuthority = Nothing
                For Each authority In TMDS.GlobalDeclarations.OtherTrackAuthorities
                    If authority.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                        If authority.AuthorityUID = AuthUID Then
                            AuthorityExists = True
                            AuthThatExists = authority
                            Exit For
                        End If
                    End If
                Next

                'Avoid stuck license in split desk
                If Me.TrackAuthorities.Contains(AuthThatExists) Then
                    TrackEventLog("ApplyTrackAuthority-Authority number " & AuthUID & " already exist in track " & Me.Name)
                    Exit Sub
                End If

                Dim TrackTimeType As Boolean = False
                Dim FoulTimeType As Boolean = False
                Dim TrackAuthType As Boolean = False

                If AuthorityExists AndAlso AuthThatExists IsNot Nothing Then
                    Select Case Mid(AuthThatExists.AuthorityType, 1, 2)
                        Case "TT"
                            TrackTimeType = True
                        Case "FT"
                            FoulTimeType = True
                        Case "TA"
                            TrackAuthType = True
                            AuthThatExists.LicenseTypeAuthority = True
                        Case Else
                            TrackTimeType = True
                    End Select

                    Me.BlockAbsolute = True
                    Me.TrackAuthorities.Add(AuthThatExists)
                    Me.TrackAndTime = TrackTimeType
                    Me.FoulTime = FoulTimeType
                    Me.UpdateStatus()
                    TrackEventLog("ApplyTrackAuthority-Exit Sub")
                    Exit Sub
                End If

                AuthorityFetch = "SELECT * FROM " & gtblAuthActive & " WHERE AuthorityUID = '" & AuthUID & "'"
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                DatabaseCommand = New OleDbCommand(AuthorityFetch, dbconn)
                dbconn.Open()
                dr = DatabaseCommand.ExecuteReader()
                While dr.Read()
                    auth = New TrackAuthority.TrackAuthority()
                    auth.AuthorityNumber = dr.GetInt32(0)
                    auth.RailRoadName = dr.GetString(1)
                    auth.DispatcherName = dr.GetString(2)
                    auth.CreateDate = dr.GetDateTime(3)
                    auth.Direction = dr.GetString(4)
                    auth.AuthorityDate = dr.GetDateTime(5)
                    auth.AuthorityType = dr.GetString(6)
                    auth.IssueTo = dr.GetString(7)
                    auth.AuthorityLimits = dr.GetString(8)
                    auth.OKTime = dr.GetDateTime(9)
                    auth.UntilTime = dr.GetDateTime(10)
                    auth.MobileID = dr.GetInt32(11)


                    Dim GUIDs() As String = dr.GetString(12).Split("|")
                    Dim strGUID As String
                    For Each strGUID In GUIDs
                        If IsNumeric(strGUID) Then
                            Dim compToBlock As Object = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(CInt(strGUID))
                            If Not compToBlock Is Nothing Then
                                auth.ComponentsInSelection.Add(compToBlock)
                            End If
                        End If
                    Next

                    auth.ReportClear = dr.GetDateTime(13)
                    auth.TerritoryAssignment = dr.GetInt32(14)
                    auth.AuthorityUID = dr.GetString(15)
                    If Not dr.IsDBNull(16) Then
                        Dim VehicleList() As String = dr.GetString(16).Split("|")
                        Dim veh As String
                        For Each veh In VehicleList
                            If veh.Trim <> "" Then
                                If auth.VehicleAssociations Is Nothing Then
                                    auth.VehicleAssociations = New ArrayList()
                                End If
                                If Not auth.VehicleAssociations.Contains(veh) Then
                                    auth.VehicleAssociations.Add(veh)
                                End If
                            End If
                        Next
                    End If
                    auth.JointAuthority = dr.GetBoolean(17)
                    Dim TrainList() As String = dr.GetString(18).Split("|")
                    auth.BehindTrains = New ArrayList()

                    Dim behTrn As String
                    For Each behTrn In TrainList
                        If behTrn <> "" Then
                            auth.BehindTrains.Add(behTrn)
                        End If
                    Next
                    'For I = 0 To TrainList.GetUpperBound(0)
                    '    auth.BehindTrains.Add(TrainList(I))
                    'Next

                    auth.BeginMilePostLimits = dr.GetInt32(19)
                    auth.BeginMilePostLimits = dr.GetInt32(20)
                    'auth.JointLimits = dr.GetString(21)

                    If dr.FieldCount >= 23 Then
                        If Not dr.IsDBNull(22) Then
                            auth.TerritoryAssignmentSecondary = dr.GetInt32(22)
                        End If
                    End If
                    If dr.FieldCount >= 24 Then
                        If Not dr.IsDBNull(23) Then
                            auth.AuthGUID = dr.GetString(23)
                        End If
                    End If

                    If dr.FieldCount >= 25 Then
                        If Not dr.IsDBNull(24) Then
                            auth.TerrIDTeritary = dr.GetInt32(24)
                        End If
                    End If

                    If dr.FieldCount >= 26 Then
                        If Not dr.IsDBNull(25) Then
                            auth.TerrIDQuadtary = dr.GetInt32(25)
                        End If
                    End If

                    If dr.FieldCount >= 32 Then
                        If Not dr.IsDBNull(26) Then
                            auth.MobileClientLastName = dr.GetString(26)
                        End If

                        If Not dr.IsDBNull(27) Then
                            auth.MobileClientFirstName = dr.GetString(27)
                        End If

                        If Not dr.IsDBNull(28) Then
                            auth.MobileClientPassword = dr.GetString(28)
                        End If

                        If Not dr.IsDBNull(29) Then
                            auth.MobileClientPIN = dr.GetString(29)
                        End If

                        If Not dr.IsDBNull(30) Then
                            auth.MobileClientEnabled = dr.GetBoolean(30)
                        End If

                        If Not dr.IsDBNull(31) Then
                            auth.MobileClientDSA = dr.GetString(31)
                        End If

                    End If
                    If dr.FieldCount >= 34 Then
                        If Not dr.IsDBNull(32) Then
                            auth.CopiedBy = dr.GetString(32)
                        End If
                        If Not dr.IsDBNull(33) Then
                            auth.RelayedTo = dr.GetString(33)
                        End If
                    End If


                    Dim AuthTrackTimeType As Boolean = False
                    Dim AuthFoulTimeType As Boolean = False

                    Select Case Mid(auth.AuthorityType, 1, 2)
                        Case "TT"
                            AuthTrackTimeType = True
                        Case "FT"
                            AuthFoulTimeType = True
                        Case "TA"
                            TrackAuthType = True
                            auth.LicenseTypeAuthority = True
                        Case Else
                            AuthTrackTimeType = True
                    End Select

                    If optEnableTTRollupEventDisplay Then
                        If dr.FieldCount >= 36 Then
                            If Not IsDBNull(dr("RollupEvent")) Then
                                Dim RollEvents() As String = dr("RollupEvent").ToString.Split(Chr(1)) 'dr.GetString(68).Split(Chr(1))
                                Dim roll As String
                                For Each roll In RollEvents
                                    If roll <> "" Then
                                        auth.RollUpEvents.Add(roll)
                                    End If
                                Next
                            End If
                        End If
                    End If

                    If optEnablePTCOperations Then
                        If dr.FieldCount >= 39 Then
                            If Not dr.IsDBNull(37) And Not dr.IsDBNull(38) Then
                                auth.PTCStatus = dr.GetString(37)
                                auth.PTCAuthorityText = dr.GetString(38)
                                If auth.PTCStatus = "AUTHORITY-ACTIVATED" Then
                                    auth.PTCTypeAuthority = True
                                End If
                            End If
                        End If
                    End If

                    If dr.FieldCount >= 38 Then
                        If Not dr.IsDBNull(39) Then
                            'String format TBD 
                            'auth.TrainSymbol = dr.GetBoolean(39)
                            auth.IssuedToTrain = dr.GetBoolean(39)
                        End If
                    End If

                    If dr.FieldCount >= 40 Then
                        If Not dr.IsDBNull(41) Then
                            'String format TBD 
                            auth.TrainSymbol = dr.GetString(41)
                            auth.myTrain = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(auth.TrainSymbol)
                            If Not IsNothing(auth.myTrain) AndAlso optEnableLicenseGenerationForPTC Then
                                auth.myTrain.thisCurrentLicense = auth
                            End If
                        End If
                    End If

                    If optEnablePTCBOSAPIMode Or optEnablePTCBOSVETMSMode Then
                        If dr.FieldCount >= 44 Then
                            If Not dr.IsDBNull(43) Then
                                auth.PTCAuthorityACKPending = dr.GetString(43)
                                If auth.PTCAuthorityACKPending.Trim <> "" Then
                                    If Not dr.IsDBNull(44) Then
                                        Dim PTCComps As String = dr.GetString(44)
                                        Dim PTCCompsSplit() As String = PTCComps.Split("-")
                                        Dim s As String
                                        For Each s In PTCCompsSplit
                                            If s.Trim <> "" Then
                                                Dim compToBlock As Object = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(CInt(s))
                                                If Not compToBlock Is Nothing Then
                                                    If Not auth.PTCAuthorityComponents.Contains(compToBlock) Then
                                                        auth.PTCAuthorityComponents.Add(compToBlock)
                                                    End If
                                                End If
                                            End If
                                        Next
                                        If auth.PTCAuthorityComponents.Count > 0 Then auth.FlasherMode(True, True)
                                        auth.SetPTCSTatusSelectionMode()
                                    End If
                                End If
                            End If
                        End If
                    End If

                    If dr.FieldCount >= 46 Then
                        If Not dr.IsDBNull(45) Then
                            'String format TBD 
                            auth.LimitsInfo = dr.GetString(45)
                        End If
                    End If

                    If dr.FieldCount >= 47 Then
                        If Not dr.IsDBNull(46) Then
                            'Symbol|EngineID|Direction|Location;
                            auth.BehindTrainsInfo = dr.GetString(46)
                        End If
                    End If
                    If dr.FieldCount >= 48 Then
                        If Not dr.IsDBNull(47) Then
                            auth.AuthorityStatus = dr.GetString(47)
                        End If
                    End If

                    If dr.FieldCount >= 49 Then
                        If Not dr.IsDBNull(48) Then
                            auth.AuthVoidList = dr.GetString(48)
                        End If
                    End If

                    If dr.FieldCount >= 50 Then
                        If Not dr.IsDBNull(49) Then
                            'IssueToName|FirstLimit|SecondLimit;
                            auth.JointVerbiage = dr.GetString(49)
                        End If
                    End If
                    If dr.FieldCount >= 51 Then
                        If Not dr.IsDBNull(50) Then
                            'IssueToName|FirstLimit|SecondLimit;
                            Dim StrUntilTime() As String = dr.GetString(50).Trim.Split("|")
                            Dim s As String
                            For Each s In StrUntilTime
                                If s.Trim <> "" Then
                                    auth.UntilTimeInfo.Add(s)
                                End If
                            Next
                            auth.UntilTimeCount = auth.UntilTimeInfo.Count
                        End If
                    End If
                    If dr.FieldCount >= 52 Then
                        If Not dr.IsDBNull(51) Then
                            auth.Box1List = dr.GetString(51)
                        End If
                    End If

                    If dr.FieldCount >= 56 Then
                        If Not dr.IsDBNull(38) Then auth.PTCAuthorityText = dr.GetString(38)
                        If Not dr.IsDBNull(52) Then auth.PTCAuthoritySegments = dr.GetString(52)
                        If Not dr.IsDBNull(53) Then auth.PTCRestrictionText = dr.GetString(53)
                        If Not dr.IsDBNull(54) Then auth.PTCCompositionCRC = dr.GetInt64(54)
                        If Not dr.IsDBNull(55) Then auth.PTCContingencySegments = dr.GetString(55)
                    End If

                    If optEnableLicenseGenerationForPTC Then
                        If dr.FieldCount >= 58 Then
                            If Not dr.IsDBNull(57) Then auth.TacticalRouteList = dr.GetString(57)
                        End If
                    End If

                    If dr.FieldCount >= 60 Then
                        If Not dr.IsDBNull(59) Then
                            auth.MixModeAuthorityType = dr.GetBoolean(59)
                        End If
                    End If

                    If dr.FieldCount >= 61 Then
                        If Not dr.IsDBNull(60) Then auth.UntilReleased = dr.GetBoolean(60)
                        If Not dr.IsDBNull(61) Then auth.NoticeTime = dr.GetValue(61)
                    End If
                    If dr.FieldCount >= 62 Then
                        If Not dr.IsDBNull(62) Then
                            Dim SoleJointInfo() As String = dr.GetString(62).Split("|")
                            Dim s As String
                            For Each s In SoleJointInfo
                                If s.Trim <> "" Then
                                    auth.SoleJointInfo.Add(s)
                                End If
                            Next
                        End If
                    End If

                    ''RMT ARRC-1910
                    If dr.FieldCount >= 66 Then
                        If Not dr.IsDBNull(65) Then
                            Dim TempSwitchStr As String = ""
                            TempSwitchStr = dr.GetValue(65)
                            If Not String.IsNullOrEmpty(TempSwitchStr) AndAlso TempSwitchStr.Trim <> "" Then
                                auth.PopulateSwitchList(TempSwitchStr)
                            End If
                        End If
                    End If

                    ''****************************************************************************************
                    ''**   ADD AUTHORITY TO TRACKS
                    ''*****************************************************************************************
                    Dim comp As Object
                    For Each comp In auth.ComponentsInSelection

                        comp.BlockAbsolute = True
                        comp.TrackAuthorities.Add(auth)
                        SystemEvent("TRACK AUTHORITY CHECK-" & "ADDING AUTHORITY:" & auth.AuthorityNumber & " TO COMPONENT TRACK AUTHORITY ARRAYLIST FOR GUID:" & comp.GUID.ToString & ": DIRECTION=" & auth.Direction)
                        comp.TrackAndTime = AuthTrackTimeType
                        comp.FoulTime = AuthFoulTimeType
                        comp.TrackAuthority = TrackAuthType

                        If comp.TrackAuthority Then
                            comp.BlockAbsolute = False
                        End If

                        If optEnableTrackTimeDisplayonCodeBrown OrElse optEnableCTCTAGDispalyonCodeBrown And Not gSimulationMode Then
                            comp.OverRideCodeBrown = True
                        End If

                        'Tracks
                        If optEnableLicenseGenerationForPTC AndAlso comp.GetType.ToString = gTrackComponentName Then

                            Dim trk As Track = CType(comp, Track)

                            'RMT560-Traffic directions are changing in split desk
                            'Need to send the direction for last track in origin desk
                            'jcosta-9/14/17

                            auth.Direction = RemoteTrackDirection

                            'Track in FLP station - Central Line 2
                            'Need to invert direction
                            If trk.GUID = 111228 Then
                                If auth.Direction = "RIGHT" Then
                                    auth.Direction = "LEFT"
                                    TrackEventLog("ApplyTrackAuthority-Invert direction to track 111228-LEFT")
                                End If
                            End If

                            'Track in Alça station - Steel line 
                            'Need to invert direction
                            If trk.GUID = 151197 Then
                                If auth.Direction = "RIGHT" Then
                                    auth.Direction = "LEFT"
                                    TrackEventLog("ApplyTrackAuthority-Invert direction to track 151197-LEFT")
                                End If
                            End If

                            trk.TrafficDirection = auth.Direction

                        End If

                        comp.UpdateStatus()

                    Next

                    OtherTrackAuthorities.Add(auth)
                    auth.CreateReducedLimitsVerbiage()

                End While

                Me.UpdateStatus()
                Dim SummItem As New SummaryItem("AUTHORITY", "ADD", auth)
                SyncLock gSummaryAuthQueue.SyncRoot
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock


                Dim DoAuthorityEvent As New DoPublishTNTEvent(AddressOf auth.PublishTNTEventUpdate)
                DoAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.TrackAuthority.EventTypeTNT.ADD, Nothing, Nothing)

                dr = Nothing
                DatabaseCommand = Nothing
                dbconn.Close()
                dbconn = Nothing
                TrackEventLog("ApplyTrackAuthority-Complete")

            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
        End Sub

        Private Function CheckFlipFlopExists(ByVal pFlipFlop As String, ByVal pTrackList As String()) As Boolean
            Try
                Dim strGUID As String
                For Each strGUID In pTrackList
                    If IsNumeric(strGUID) Then

                        Dim compToBlock As Object = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(CInt(strGUID))

                        If Not compToBlock Is Nothing Then

                            If compToBlock.GetType.ToString = gFlipFlopComponentName Then
                                Return True
                            End If

                        End If

                        If pFlipFlop.IndexOf(strGUID) >= 0 Then
                            Return True
                        End If

                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

            Return False

        End Function

        Public Sub UpdateTrackAuthority(ByVal AuthUID As String)

            Dim AuthorityFetch As String = String.Empty
            Dim dr As OleDbDataReader = Nothing
            Dim DatabaseCommand As OleDbCommand = Nothing
            Dim dbconn As OleDbConnection = Nothing
            Dim auth As TrackAuthority.TrackAuthority = Nothing
            Try
                AuthorityFetch = "SELECT * FROM " & gtblAuthActive & " WHERE AuthorityUID = '" & AuthUID & "'"
                dbconn = New OleDbConnection(TMDS.GlobalDeclarations.gConnectionStringDynamic)
                DatabaseCommand = New OleDbCommand(AuthorityFetch, dbconn)
                dbconn.Open()
                dr = DatabaseCommand.ExecuteReader()
                While dr.Read()
                    auth = Me.FindTrackAuthority(AuthUID)
                    auth.OKTime = dr.GetDateTime(9)
                    auth.UntilTime = dr.GetDateTime(10)
                    auth.MobileID = dr.GetInt32(11)

                    If Not IsNothing(auth.VehicleAssociations) Then
                        auth.VehicleAssociations.Clear()
                    End If
                    If Not dr.IsDBNull(16) Then
                        Dim VehicleList() As String = dr.GetString(16).Split("|")
                        Dim veh As String
                        For Each veh In VehicleList
                            If veh.Trim <> "" Then
                                If auth.VehicleAssociations Is Nothing Then
                                    auth.VehicleAssociations = New ArrayList()
                                End If
                                If Not auth.VehicleAssociations.Contains(veh) Then
                                    auth.VehicleAssociations.Add(veh)
                                End If
                            End If
                        Next
                    End If
                    auth.JointAuthority = dr.GetBoolean(17)
                    auth.JointLimits = dr.GetString(21)

                End While
                Dim SummItem As New SummaryItem("AUTHORITY", "MODIFY", auth)
                SyncLock gSummaryAuthQueue
                    gSummaryAuthQueue.Enqueue(SummItem)
                End SyncLock
                DatabaseCommand = Nothing
                dbconn.Close()
                dbconn = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                dbconn = Nothing
            End Try
        End Sub

        Public Delegate Sub SendControls(ByVal WaitTimeEnabled As Boolean)

        ''' <summary>
        ''' Remove Track Authority
        ''' </summary>
        ''' <param name="pAuthUID"></param>
        ''' <param name="pRemoveFromDatabase"></param>
        ''' <param name="pRemoveViaEIC"></param>
        ''' <param name="pSender"></param>
        ''' <param name="pCancelType"></param>
        Public Sub RemoveTrackAuthority(ByVal pAuthUID As String,
                                        Optional ByVal pRemoveFromDatabase As Boolean = True,
                                        Optional ByVal pRemoveViaEIC As Boolean = False,
                                        Optional ByVal pSender As TMDS.NetworkListener.WrkstnConnection = Nothing,
                                        Optional ByVal pCancelType As String = Nothing)
            Dim currentAuth As TrackAuthority.TrackAuthority = Nothing
            Try
                Dim wrkStnName As String = String.Empty
                If Not IsNothing(pSender) Then
                    wrkStnName = $"{pSender.Name}-{pSender.Number}"
                End If
                TrackEventLog($"RemoveTrackAuthority:AuthUID={pAuthUID}: WrkstnConnection={wrkStnName}:RemoveDB={pRemoveFromDatabase}:pCancelType={pCancelType}:User={gCurrentUser.FirstName}")
                For Each auth As TrackAuthority.TrackAuthority In TMDS.GlobalDeclarations.OtherTrackAuthorities.OfType(Of TrackAuthority.TrackAuthority)
                    If auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                        If auth.AuthorityUID = pAuthUID Then
                            currentAuth = auth
                            Exit For
                        End If
                    End If
                Next
                If currentAuth Is Nothing Then
                    TrackEventLog($"RemoveTrackAuthority:Authnotfound={pAuthUID}")
                    Exit Sub
                End If
                'Cancel signals for remote train
                If optEnableExtendLicenseinSplitDesk AndAlso Me.TrainIDs.Count > 0 Then
                    For Each train As TrainID In Me.TrainIDs
                        If train.TrainRegionStatus = TrainRegionEnum.RemoteTrain Then
                            If pCancelType = "RELEASE" Then
                                TrackEventLog($"RELEASE::RemoveTrackAuthority:Remote train {train.Name} was released:Authority={pAuthUID}:User={gCurrentUser.FirstName}")
                                train.RemoteAction = RemoteActionEnum.Release
                                train.StopTrainCommand(True) 'send immediate 
                            ElseIf pCancelType = "ROLLUP" Then
                                If train.myTacticalRoutes.Count > 0 Then
                                    TrackEventLog($"ROLLUP:RemoveTrackAuthority:Partial cancel going to other desk. Train={train.Name}:Authority={pAuthUID}:User={gCurrentUser.FirstName}")
                                    train.RemoteAction = RemoteActionEnum.PartialCancel
                                    Dim tr As TacticalRoute = train.myTacticalRoutes(0)
                                    train.PtcCancelNormalLicense(tr.mySignalRoute.EntrySignal, True)
                                End If
                            End If
                        End If
                    Next
                End If
                If Not pRemoveViaEIC Then
                    If optAllowAuthorityRemovalAlertFromWorkstation Then
                        Dim alertMessage As String = $"LICENÇA ({pAuthUID}) FOI REMOVIDA PELO PAINEL: {wrkStnName}"
                        TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.TrackAuthorityReleaseEvent, alertMessage, Nothing, Nothing, Nothing, Nothing, Nothing, currentAuth)
                        TrackEventLog(alertMessage)
                    End If
                Else
                    Dim alertMessage As String = $"TRACK AUTHORITY RELEASE BY A MOBILE CLIENT: {currentAuth.MobileClientLastName}, {currentAuth.MobileClientFirstName}"
                    TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.TrackAuthorityReleaseEvent, alertMessage, Nothing, Nothing, Nothing, Nothing, Nothing, currentAuth)
                    TrackEventLog(alertMessage)
                End If
                currentAuth.ReportClear = Now
                If pRemoveFromDatabase Then
                    If currentAuth.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionDynamic) Then
                        currentAuth.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                        TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(currentAuth)
                        TrackEventLog($"RemoveTrackAuthority:1:AuthUID={pAuthUID}:User={gCurrentUser.FirstName}")
                    End If
                Else
                    If TrackAuthorities.Count > 0 Then
                        TrackAuthorities.Remove(currentAuth)
                        SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                    End If
                    currentAuth.ComponentsInSelection.Remove(Me)
                    If TrackAuthorities.Count = 0 Then
                        TrackAuthority = False
                        TrafficDirection = ""
                    End If
                    UpdateStatus()
                    currentAuth.RemoveBlockingToRemoteLinkTrack(currentAuth.ComponentsInSelection)
                    currentAuth.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionDynamic)
                    currentAuth.UpdateJoinLimits(String.Empty)
                    TMDS.GlobalDeclarations.OtherTrackAuthorities.Remove(currentAuth)
                    TrackEventLog($"RemoveTrackAuthority:2:AuthUID={pAuthUID}:User={gCurrentUser.FirstName}")
                End If
                gSummaryAuthQueue.Enqueue(New SummaryItem("AUTHORITY", "REMOVE", currentAuth))
                Dim doAuthorityEvent As New DoPublishTNTEvent(AddressOf currentAuth.PublishTNTEventUpdate)
                doAuthorityEvent.BeginInvoke(TMDS.TrackAuthority.TrackAuthority.EventTypeTNT.REMOVE, Nothing, Nothing)
                System.Threading.Thread.Sleep(500)
                'Remove remote trains of tracks
                If optEnableExtendLicenseinSplitDesk AndAlso TrainIDs.Count > 0 Then
                    For Each train As TrainID In TrainIDs.OfType(Of TrainID)
                        If train.TrainRegionStatus = TrainRegionEnum.RemoteTrain Then
                            TrackEventLog($"RemoveTrackAuthority:Remote train {train.Name} was removed::AuthUID={pAuthUID}:User={gCurrentUser.FirstName}")
                            TrainIDs.Remove(train)
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Remove Device Block
        ''' </summary>
        ''' <param name="deviceBlockId">Device Block Id</param>
        Public Sub RemoveDeviceBlock(deviceBlockId As String)
            Try
                Dim currentDeviceBlock As DeviceBlock = FindDeviceBlockByAuthorityUid(deviceBlockId)
                If currentDeviceBlock Is Nothing Then
                    TrackEventLog($"{GetCurrentMethod.Name}:DeviceBlock {deviceBlockId} not found")
                    Exit Sub
                End If
                If Not currentDeviceBlock.RemoveDeviceBlockFromDB(IsRemoteDatabaseLink) Then Exit Sub
                Dim alertMessage As String = "DEVICE BLOCK RELEASE EVENT FROM ADJOINING DISPATCHER"
                AlertUtilities.CreateAlert(Alert.AlertType.DeviceBlockReleaseEvent, alertMessage, Nothing, Nothing,
                                           Nothing, Nothing, Nothing, Nothing, currentDeviceBlock)
                currentDeviceBlock.RemoveDeviceBlockFromComponents(gDatabaseConnectionDynamic)
                gDeviceBlocks.Remove(currentDeviceBlock)
                Dim SummItem As New SummaryItem("BLOCK", "REMOVE", currentDeviceBlock)
                SyncLock gSummaryBlockQueue
                    gSummaryBlockQueue.Enqueue(SummItem)
                End SyncLock
                Dim DoDeviceBlockEvent As New DoPublishDeviceBlockEvent(AddressOf currentDeviceBlock.PublishDeviceBlockEventUpdate)
                DoDeviceBlockEvent.BeginInvoke(DeviceBlock.EventTypeDevBlk.REMOVE, Nothing, Nothing)
                If optEnablePSSEMTAuthorityType Then
                    Dim SplAuth As OtherSpecialAuthorityType
                    SplAuth = FindPSSESTAuthority(currentDeviceBlock.BlockGUID)
                    If Not SplAuth Is Nothing Then
                        If SplAuth.RemoveSplAuthorityFromDB(gDatabaseConnectionDynamic) Then
                            Dim SummAuthItem As New SummaryItem("SPLAUTHORITY", "REMOVE", SplAuth)
                            SyncLock gSummaryAuthQueue
                                gSummaryAuthQueue.Enqueue(SummAuthItem)
                            End SyncLock
                            gOtherSpecialAuthorityCollection.Remove(SplAuth)
                        End If
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Get Tracks With Same Name
        ''' </summary>
        ''' <param name="addCurrentTrack">Add Current Track</param>
        ''' <param name="addSlottingTracks">add Slotting Tracks</param>
        ''' <returns>Returns a list of tracks with the same name</returns>
        Public Function GetTracksWithSameName(Optional addCurrentTrack As Boolean = True,
                                              Optional addSlottingTracks As Boolean = False) As List(Of Track)
            Dim tracks As New List(Of Track)
            Try
                If addCurrentTrack Then tracks.Add(Me)
                For Each track As Track In TrackCollection.OfType(Of Track)
                    If (Not track.OStype OrElse
                        addSlottingTracks) AndAlso
                        track.GUID <> GUID AndAlso
                        track.Name.Equals(Name) Then
                        tracks.Add(track)
                    End If
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return tracks
        End Function

        ''' <summary>
        ''' Apply Device Block
        ''' </summary>
        ''' <param name="deviceBlockId">device Block Id</param>
        Public Sub ApplyDeviceBlock(deviceBlockId As String)
            Try
                If FindDeviceBlockByAuthorityUid(deviceBlockId) IsNot Nothing Then
                    TrackEventLog($"{GetCurrentMethod.Name}:DeviceBlock {deviceBlockId} already exist")
                    Exit Sub
                End If
                'TO DO - MOVE IT TO REPOSITORY
                Using dbconn As New OleDbConnection(If(IsRemoteDatabaseLink,
                                                    gConnectionStringRemoteDatabase, gConnectionStringDynamic))
                    Dim query As String = $"SELECT * 
                                            FROM tmdsDatabaseDynamic..tblDeviceBlocksActive 
                                            WHERE AuthorityUID = '{deviceBlockId}'"
                    Using dbComm As New OleDbCommand(query, dbconn)
                        dbconn.Open()
                        Using dr As OleDbDataReader = dbComm.ExecuteReader()
                            While dr.Read()
                                Dim devBlk As New DeviceBlock()
                                devBlk.AuthorityNumber = dr.GetInt32(0)
                                devBlk.RailRoadName = dr.GetString(1)
                                devBlk.DispatcherName = dr.GetString(2)
                                devBlk.CreateDate = dr.GetDateTime(3)
                                devBlk.Direction = dr.GetString(4)
                                devBlk.AuthorityDate = dr.GetDateTime(5)
                                devBlk.AuthorityType = dr.GetString(6)
                                devBlk.IssueTo = dr.GetString(7)
                                devBlk.AuthorityLimits = dr.GetString(8)
                                devBlk.OKTime = dr.GetDateTime(9)
                                devBlk.UntilTime = dr.GetDateTime(10)
                                devBlk.MobileID = dr.GetInt32(11)
                                Dim GUIDs() As String = dr.GetString(12).Split("|")
                                Dim strGUID As String
                                For Each strGUID In GUIDs
                                    If IsNumeric(strGUID) Then
                                        Dim compToBlock As Object = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(CInt(strGUID))
                                        If Not compToBlock Is Nothing Then
                                            devBlk.ComponentsInSelection.Add(compToBlock)
                                        End If
                                    End If
                                Next
                                devBlk.ReportClear = dr.GetDateTime(13)
                                devBlk.TerritoryAssignment = dr.GetInt32(14)
                                devBlk.BlockNotes = dr.GetString(15)
                                If Not dr.IsDBNull(16) Then devBlk.AuthorityUID = dr.GetString(16)
                                If dr.FieldCount >= 18 Then devBlk.TerritoryAssignmentSecondary = dr.GetInt32(17)
                                If dr.FieldCount >= 19 Then devBlk.BlockGUID = dr.GetString(18)
                                If dr.FieldCount >= 27 Then
                                    Dim AllowFieldBlking As Boolean
                                    If Not dr.IsDBNull(27) Then AllowFieldBlking = dr.GetBoolean(27)
                                    Select Case AllowFieldBlking
                                        Case False
                                            devBlk.OverrideFieldBlocking = True
                                    End Select
                                End If
                                Dim comp As Object
                                For Each comp In devBlk.ComponentsInSelection
                                    comp.BlockAbsolute = True
                                    If comp.DeviceBlockDuplicateCheck(devBlk) Then
                                        comp.DeviceBlocks.Add(devBlk)
                                    End If
                                    comp.DeviceBlocked = True
                                    comp.UpdateStatus()
                                Next
                                If devBlk.DeviceBlockDuplicateCheck Then
                                    gDeviceBlocks.Add(devBlk)
                                Else
                                    Exit Sub
                                End If
                                If Not devBlk.AddDeviceBlockToDB(IsRemoteDatabaseLink) Then Exit Sub
                                Dim SummItem As New SummaryItem("BLOCK", "ADD", devBlk)
                                SyncLock gSummaryBlockQueue
                                    gSummaryBlockQueue.Enqueue(SummItem)
                                End SyncLock
                                Dim DoDeviceBlockEvent As New DoPublishDeviceBlockEvent(AddressOf devBlk.PublishDeviceBlockEventUpdate)
                                DoDeviceBlockEvent.BeginInvoke(DeviceBlock.EventTypeDevBlk.ADD, Nothing, Nothing)
                            End While
                        End Using
                    End Using
                End Using
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Track auth remove from Me
        ''' </summary>
        ''' <param name="pAuthToRemove"></param>
        Public Sub TrackAuthorityRemoveFromMe(ByVal pAuthToRemove As TrackAuthority.TrackAuthority)
            Dim auth As TrackAuthority.TrackAuthority
            Dim deleteList As New ArrayList()
            Dim cloneList As ArrayList
            Try
                SyncLock Me.TrackAuthorities
                    cloneList = Me.TrackAuthorities.Clone
                    For Each auth In cloneList
                        If Trim(auth.AuthGUID) = Trim(pAuthToRemove.AuthGUID) Then
                            deleteList.Add(auth)
                        End If
                    Next
                End SyncLock
                For Each auth In deleteList
                    Me.TrackAuthorities.Remove(auth)
                Next
                If Me.TrackAuthorities.Count = 0 Then
                    Me.TrackAuthority = False
                End If
                deleteList.Clear()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                auth = Nothing
                cloneList = Nothing
                deleteList = Nothing
            End Try
        End Sub

        Public Function TrackAuthorityDuplicateCheck(ByVal authToCheck As TrackAuthority.TrackAuthority) As Boolean
            Try
                Dim auth As TrackAuthority.TrackAuthority
                For Each auth In Me.TrackAuthorities
                    If auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                        If Trim(auth.AuthGUID) = Trim(authToCheck.AuthGUID) Then
                            Return False
                        End If
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            End Try
        End Function

        Public Sub CheckForPendingRoutesBehindMe()
            Dim Searching As Boolean = True
            Dim LoopControl As Integer
            Dim NextRefNumber, LastRefNumber As Int32
            Dim CompToCheck As Object
            Dim FlipFlopFound As Boolean
            Try
                If Me.TrafficDirection = "RIGHT" Then
                    NextRefNumber = Me.LeftLink

                    If Me.IsRemoteTrack And NextRefNumber = 0 Then
                        Exit Sub
                    End If

                ElseIf Me.TrafficDirection = "LEFT" Then
                    NextRefNumber = Me.RightLink
                    'Else
                    '    If Me.IsLinkToRemoteTrack Then
                    '        Dim LeftRemote As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.LeftLink)
                    '        Dim RightRemote As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.RightLink)
                    '        If Not IsNothing(LeftRemote) Then
                    '            NextRefNumber = Me.RightLink
                    '            Me.TrafficDirection = "LEFT"
                    '        ElseIf Not IsNothing(RightRemote) Then
                    '            NextRefNumber = Me.LeftLink
                    '            Me.TrafficDirection = "RIGHT"
                    '        Else
                    '            Exit Sub
                    '        End If
                    '    Else
                    '        Exit Sub
                    '    End If

                End If

                LastRefNumber = Me.GUID
                Dim CurrentTraffic As String = Me.TrafficDirection




                If Me.IsLinkToRemoteTrack Then
                    Dim LeftRemote As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.LeftLink)
                    Dim RightRemote As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.RightLink)

                    If Not IsNothing(LeftRemote) Then
                        If Me.TrafficDirection = "RIGHT" And Me.Occuppied Then
                            Exit Sub
                        End If
                    End If

                    If Not IsNothing(RightRemote) Then
                        If Me.TrafficDirection = "LEFT" And Me.Occuppied Then
                            Exit Sub
                        End If
                    End If

                End If

                While Searching
                    CompToCheck = Me.FindObjectTypeFromGUID(NextRefNumber)

                    If CompToCheck Is Nothing Then

                        Me.SignalStatOnMe = SignalStatus.SignalAtStop
                        Me.TrafficDirection = ""
                        Me.ApplyTraffic() '325
                        Me.UpdateStatus() '325
                        Exit Sub
                    End If



                    If CompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If CompToCheck.DefaultTraffic = CurrentTraffic Then
                            Dim sig As Signal = CType(CompToCheck, Signal)
                            Select Case sig.SignalCtlStatus
                                Case Signal.CtlStatus.RequestedClear, Signal.CtlStatus.RequestingStop
                                    If sig.SignalIndStatus = Signal.IndStatus.Cleared Then
                                        Me.SignalStatOnMe = SignalStatus.SignalCleared
                                        Me.TrafficDirection = CurrentTraffic
                                    Else
                                        Me.SignalStatOnMe = SignalStatus.SignalRequested
                                        Me.TrafficDirection = CurrentTraffic

                                    End If
                                Case Signal.CtlStatus.RequestedStop
                                    Me.SignalStatOnMe = SignalStatus.SignalAtStop
                                    Me.TrafficDirection = ""

                                Case Signal.CtlStatus.RequestingClear
                                    Me.SignalStatOnMe = SignalStatus.SignalRequested
                                    Me.TrafficDirection = CurrentTraffic
                            End Select
                            Me.ApplyTraffic() '325
                            Me.UpdateStatus() '325
                            Exit Sub
                        Else
                            If CurrentTraffic = "RIGHT" Then
                                NextRefNumber = CompToCheck.LeftLink
                            ElseIf CurrentTraffic = "LEFT" Then
                                NextRefNumber = CompToCheck.RightLink
                            End If
                        End If
                    ElseIf CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        If CurrentTraffic = "LEFT" Then
                            If CompToCheck.ControlledReverse Then
                                NextRefNumber = CompToCheck.RightAltLink
                            Else
                                NextRefNumber = CompToCheck.RightLink
                            End If
                        Else
                            If CompToCheck.ControlledReverse Then
                                NextRefNumber = CompToCheck.LeftAltLink
                            Else
                                NextRefNumber = CompToCheck.LeftLink
                            End If
                        End If
                    ElseIf CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        LastRefNumber = NextRefNumber
                        If CompToCheck.Occuppied And CurrentTraffic = CompToCheck.TrafficDirection Then
                            Me.SignalStatOnMe = CompToCheck.SignalStatOnMe
                            Me.TrafficDirection = CompToCheck.TrafficDirection
                            Me.ApplyTraffic()
                            Me.UpdateStatus()
                            CheckToProjectTrafficAhead(CurrentTraffic)

                            Exit Sub
                        ElseIf Me.Name = CompToCheck.Name And Me.StationNumber = CompToCheck.StationNumber Then
                            If Not Me.OStype Then
                                If CurrentTraffic = "RIGHT" Then
                                    NextRefNumber = CompToCheck.LeftLink
                                ElseIf CurrentTraffic = "LEFT" Then
                                    NextRefNumber = CompToCheck.RightLink
                                End If


                            Else

                                Exit Sub
                            End If
                        Else
                            If CurrentTraffic = CompToCheck.TrafficDirection Or CompToCheck.TrafficDirection = "BOTH" Then
                                Dim TrafficChange As String = String.Empty
                                If FlipFlopFound Then
                                    If CurrentTraffic = "RIGHT" Then
                                        TrafficChange = "LEFT"
                                    ElseIf CurrentTraffic = "LEFT" Then
                                        TrafficChange = "RIGHT"
                                    End If
                                    Me.SignalStatOnMe = CompToCheck.SignalStatOnMe
                                    Me.TrafficDirection = TrafficChange
                                    Dim comp As Object
                                    For Each comp In Me.myControlPoint.AssignedComponenets
                                        If comp.Name = Me.Name Then

                                            comp.SignalStatOnMe = CompToCheck.SignalStatOnMe
                                            comp.TrafficDirection = TrafficChange
                                            comp.ApplyTraffic()
                                            comp.UpdateStatus()
                                        End If
                                    Next

                                Else
                                    Me.SignalStatOnMe = CompToCheck.SignalStatOnMe
                                    Me.TrafficDirection = CompToCheck.TrafficDirection
                                End If

                            Else
                                Me.SignalStatOnMe = SignalStatus.SignalAtStop
                                Me.TrafficDirection = ""
                                Me.ApplyTraffic()
                                Me.UpdateStatus()

                                Exit Sub
                            End If
                            If CurrentTraffic = "RIGHT" Then
                                NextRefNumber = CompToCheck.LeftLink
                            ElseIf CurrentTraffic = "LEFT" Then
                                NextRefNumber = CompToCheck.RightLink
                            End If

                            CheckToProjectTrafficAhead(CurrentTraffic)
                            Exit Sub
                        End If
                    ElseIf CompToCheck.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                        NextRefNumber = CompToCheck.FindExitGUID(LastRefNumber)
                        If CurrentTraffic = "RIGHT" Then
                            CurrentTraffic = "LEFT"
                        Else
                            CurrentTraffic = "RIGHT"
                        End If
                        FlipFlopFound = True

                    End If
                    LoopControl = LoopControl + 1
                    If LoopControl > 20 Then

                        Exit Sub
                    End If
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckToProjectTrafficAhead(ByVal Direction As String)
            Try
                Dim LoopControl As Integer
                Dim NextComp As Object = Me
                If Direction = "" Then Exit Sub

                Do
                    If Direction = "RIGHT" Then
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                    Else
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                    End If
                    If IsNothing(NextComp) Then Exit Sub
                    If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(NextComp, Track)
                        If trk.Occuppied Then Exit Sub
                        If Me.SignalStatOnMe = SignalStatus.SignalAtStop Then
                            trk.SignalStatOnMe = SignalStatus.SignalCleared
                        Else
                            trk.SignalStatOnMe = Me.SignalStatOnMe
                        End If

                        trk.TrafficDirection = Me.TrafficDirection
                        trk.ApplyTraffic()
                        trk.UpdateStatus()

                    ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        Dim sw As Switch = CType(NextComp, Switch)
                        If sw.ControlledReverse Then
                            If sw.LeftAltLink <> 0 And Direction = "LEFT" Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftAltLink)
                                If Me.SignalStatOnMe = SignalStatus.SignalAtStop Then
                                    NextComp.SignalStatOnMe = SignalStatus.SignalCleared
                                Else
                                    NextComp.SignalStatOnMe = Me.SignalStatOnMe
                                End If

                                NextComp.TrafficDirection = Me.TrafficDirection
                                NextComp.ApplyTraffic()
                                NextComp.UpdateStatus()

                            ElseIf sw.RightAltLink <> 0 And Direction = "RIGHT" Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.RightAltLink)
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(sw.LeftAltLink)
                                If Me.SignalStatOnMe = SignalStatus.SignalAtStop Then
                                    NextComp.SignalStatOnMe = SignalStatus.SignalCleared
                                Else
                                    NextComp.SignalStatOnMe = Me.SignalStatOnMe
                                End If

                                NextComp.TrafficDirection = Me.TrafficDirection
                                NextComp.ApplyTraffic()
                                NextComp.UpdateStatus()
                            End If
                        End If
                    ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        Exit Sub
                    End If

                    LoopControl += 1
                    If LoopControl >= 10 Then
                        Exit Sub
                    End If

                Loop

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub CheckToRemoveOfficeTrafficRoute(Optional ByVal PreviousTraffic As String = Nothing)
            Try
                Dim CompList As New ArrayList()
                Dim Searching As Boolean = True
                Dim LoopControl As Integer
                Dim NextRefNumber, LastRefNumber As Int32
                Dim CompToCheck As Object
                Dim CurrentTraffic As String = Me.TrafficDirection
                If Me.NonTransverable Then Exit Sub
                If CurrentTraffic = "RIGHT" Then
                    NextRefNumber = Me.RightLink
                ElseIf CurrentTraffic = "LEFT" Then
                    NextRefNumber = Me.LeftLink
                Else
                    If Me.IsRemoteTrack Then
                        If Not IsNothing(Me.myRemoteTrack.myLeftTrack) Then
                            NextRefNumber = Me.LeftLink
                        ElseIf Not IsNothing(Me.myRemoteTrack.myRightTrack) Then
                            NextRefNumber = Me.RightLink
                        Else
                            Exit Sub
                        End If
                    Else
                        If PreviousTraffic <> "" Then
                            If PreviousTraffic = "RIGHT" Then
                                NextRefNumber = Me.RightLink
                            ElseIf PreviousTraffic = "LEFT" Then
                                NextRefNumber = Me.LeftLink
                            End If
                        Else
                            Exit Sub
                        End If

                    End If
                End If
                LastRefNumber = Me.GUID


                While Searching
                    CompToCheck = Me.FindObjectTypeFromGUID(NextRefNumber)
                    If CompToCheck Is Nothing Then
                        Dim comp As Object
                        For Each comp In CompList
                            comp.SignalStatOnMe = SignalStatus.SignalAtStop
                            comp.TrafficDirection = ""
                            comp.UpdateStatus()
                        Next
                        CompList = Nothing

                        Exit Sub
                    End If

                    If CompToCheck.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        Dim sig As Signal = CType(CompToCheck, Signal)
                        If sig.DefaultTraffic = CurrentTraffic AndAlso Not sig.AutomaticSignal Then
                            Dim comp As Object
                            For Each comp In CompList
                                comp.SignalStatOnMe = SignalStatus.SignalAtStop
                                comp.TrafficDirection = ""
                                comp.UpdateStatus()
                            Next
                            CompList = Nothing
                            Exit Sub
                        Else
                            If CurrentTraffic = "RIGHT" Then
                                NextRefNumber = CompToCheck.RightLink
                            ElseIf CurrentTraffic = "LEFT" Then
                                NextRefNumber = CompToCheck.LeftLink
                            End If
                        End If
                    ElseIf CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        If CurrentTraffic = "LEFT" Then
                            If CompToCheck.ControlledReverse Then
                                If CompToCheck.LeftAltLink <> 0 Then
                                    NextRefNumber = CompToCheck.LeftAltLink
                                Else
                                    NextRefNumber = CompToCheck.LeftLink
                                End If
                            Else
                                NextRefNumber = CompToCheck.LeftLink
                            End If
                        Else

                            If CompToCheck.ControlledReverse Then
                                If CompToCheck.RightAltLink <> 0 Then
                                    NextRefNumber = CompToCheck.RightAltLink
                                Else
                                    NextRefNumber = CompToCheck.RightLink
                                End If
                            Else
                                NextRefNumber = CompToCheck.RightLink
                            End If
                        End If
                        CompList.Add(CompToCheck)
                        'If NextRefNumber = 0 Then
                        '    Exit Sub
                        'End If
                    ElseIf CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(CompToCheck, Track)
                        If trk.NonTransverable Then Exit Sub
                        LastRefNumber = NextRefNumber

                        If CompToCheck.Occuppied And Not CompToCheck.OsType And ((Me.myControlPoint.GUID <> CompToCheck.myControlPoint.GUID) Or (Me.Name <> CompToCheck.Name)) Then
                            Dim comp As Object
                            For Each comp In CompList
                                comp.SignalStatOnMe = SignalStatus.SignalAtStop
                                comp.TrafficDirection = ""
                                comp.UpdateStatus()
                            Next
                            CompList = Nothing
                            Exit Sub
                        ElseIf CompToCheck.Occuppied And CompToCheck.OsType And (Me.Name <> CompToCheck.Name) Then

                            Dim comp As Object
                            For Each comp In CompList
                                comp.SignalStatOnMe = SignalStatus.SignalAtStop
                                comp.TrafficDirection = ""
                                comp.UpdateStatus()
                            Next
                            CompList = Nothing
                            Exit Sub
                        ElseIf Me.Name = CompToCheck.Name And Me.myControlPoint.GUID = CompToCheck.myControlPoint.GUID Then
                            If CurrentTraffic = "RIGHT" Then
                                NextRefNumber = CompToCheck.RightLink
                            ElseIf CurrentTraffic = "LEFT" Then
                                NextRefNumber = CompToCheck.LeftLink
                            End If
                            Select Case CompToCheck.GetType.ToString
                                Case "TMDS.TrackComponents.Track", "TMDS.SwitchComponents.Switch"
                                    CompList.Add(CompToCheck)
                            End Select


                        Else
                            If CurrentTraffic = "RIGHT" Then
                                NextRefNumber = CompToCheck.RightLink
                            ElseIf CurrentTraffic = "LEFT" Then
                                NextRefNumber = CompToCheck.LeftLink
                            End If
                            CompToCheck.SignalStatOnMe = SignalStatus.SignalAtStop
                            CompToCheck.TrafficDirection = ""
                            CompToCheck.UpdateStatus()

                        End If
                    ElseIf CompToCheck.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                        'Dim ff As FlipFlop
                        NextRefNumber = CompToCheck.FindExitGUID(LastRefNumber)

                        If CurrentTraffic = "RIGHT" Then
                            CurrentTraffic = "LEFT"
                        Else
                            CurrentTraffic = "RIGHT"
                        End If
                        'If NextRefNumber = 0 Then
                        '    Exit Sub
                        'End If
                    ElseIf CompToCheck.GetType.ToString = gRRXINGComponentName And optEnableBRCSpecificChecks Then
                        Dim TravelingThroRRXing As Boolean = False
                        Dim LeftObject As Object = FindCompFromGUID(CompToCheck.LeftAltLink)
                        Dim RightObject As Object = FindCompFromGUID(CompToCheck.RightAltLink)
                        If CompList.Contains(LeftObject) Then
                            TravelingThroRRXing = True
                        ElseIf CompList.Contains(RightObject) Then
                            TravelingThroRRXing = True
                        ElseIf CompToCheck.LeftAltLink = LastRefNumber Then
                            TravelingThroRRXing = True
                        ElseIf CompToCheck.RightAltLink = LastRefNumber Then
                            TravelingThroRRXing = True
                        End If
                        If CurrentTraffic = "LEFT" Then

                            If TravelingThroRRXing Then
                                If CompToCheck.LeftAltLink <> 0 Then
                                    NextRefNumber = CompToCheck.LeftAltLink
                                Else
                                    NextRefNumber = CompToCheck.LeftLink
                                End If
                            Else
                                NextRefNumber = CompToCheck.LeftLink
                            End If
                        Else

                            If TravelingThroRRXing Then
                                If CompToCheck.RightAltLink <> 0 Then
                                    NextRefNumber = CompToCheck.RightAltLink
                                Else
                                    NextRefNumber = CompToCheck.RightLink
                                End If
                            Else
                                NextRefNumber = CompToCheck.RightLink
                            End If
                        End If
                        CompList.Add(CompToCheck)
                    End If
                    LoopControl = LoopControl + 1
                    If LoopControl > 130 Then
                        Exit Sub
                    End If
                End While
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub ApplyIndicationChange(Optional OverrideTrainTracking As Boolean = False)


            Try

                If gTraineeMode Then
                    If Not Me.InitOS Then
                        Me.InitOS = True
                    End If
                ElseIf gTrainerMode Then
                    If Not Me.OStype Then
                        Me.LossOfShuntTimer.Interval = 1
                    End If

                End If
                If Me.Indicating Then
                    If Me.Occuppied And Me.Ind(0).BitState = False Then
                        If Me.LossOfShuntTimer.Interval < 1000 Then
                            ApplyIndicationChangeToTrack(OverrideTrainTracking)
                        Else
                            If gTraineeMode Then
                                Me.Ind(0).BitState = True
                            End If
                            Me.LossOfShuntTimer.Enabled = True
                        End If
                    Else
                        ApplyIndicationChangeToTrack(OverrideTrainTracking)
                        Me.LossOfShuntTimer.Enabled = False
                    End If
                Else
                    If Me.AllowFieldBlocking Then
                        ApplyIndicationChangeToTrack(OverrideTrainTracking)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub ApplyIndicationChangeToTrack(Optional OverrideTrainTracking As Boolean = False)
            Dim TrackOccupied As Boolean
            Try
                If Not Me.SimulateMode And Me.Indicating Then
                    If Me.TrackIndicationORED Then
                        If Ind(0).BitState Or Ind(1).BitState Then 'CTC Track Indication Bit
                            TrackOccupied = True
                        Else
                            TrackOccupied = False
                        End If
                    ElseIf Me.TrackIndicationANDED And Not Me.FieldDurmantTrafficOn Then
                        If Ind(0).BitState And Ind(1).BitState Then 'CTC Track Indication Bit
                            TrackOccupied = True
                        Else
                            TrackOccupied = False
                        End If
                    ElseIf Me.FieldDurmantTrafficOn Then
                        Dim TrafficOn As Boolean

                        If Not IsNothing(Me.TrafficLeftList) Then
                            Dim dev As Device = Me.TrafficLeftList.Item(0)
                            If dev.DeviceControlled Then
                                TrafficOn = True
                            End If
                        End If
                        If Not IsNothing(Me.TrafficRightList) Then
                            Dim dev As Device = Me.TrafficRightList.Item(0)
                            If dev.DeviceControlled Then
                                TrafficOn = True
                            End If
                        End If

                        If Me.TrackIndicationANDED And TrafficOn Then
                            If Not IsNothing(Ind(1)) Then
                                If Ind(0).BitState And Ind(1).BitState Then
                                    TrackOccupied = True
                                Else
                                    TrackOccupied = False
                                End If
                            Else
                                TrackOccupied = False
                            End If
                        ElseIf TrafficOn And Ind(0).BitState Then
                            TrackOccupied = True
                        Else
                            TrackOccupied = False
                        End If
                    ElseIf Me.TrackIndicationOREDANDED And Not IsNothing(Ind(1)) And Not IsNothing(Ind(2)) Then
                        If Ind(0).BitState Or (Ind(1).BitState And Ind(2).BitState) Then 'CTC Track Indication Bit
                            TrackOccupied = True
                        Else
                            TrackOccupied = False
                        End If
                    ElseIf Me.TrackIndicationANDEDORED And Not IsNothing(Ind(1)) And Not IsNothing(Ind(2)) Then
                        If (Ind(0).BitState And Ind(1).BitState) Or Ind(2).BitState Then 'CTC Track Indication Bit
                            TrackOccupied = True
                        Else
                            TrackOccupied = False
                        End If

                    Else
                        If Ind(0).BitState Then 'CTC Track Indication Bit
                            TrackOccupied = True
                        Else
                            TrackOccupied = False
                        End If
                    End If
                ElseIf Me.Indicating Then
                    If Ind(0).BitState Then 'CTC Track Indication Bit
                        TrackOccupied = True
                    Else
                        TrackOccupied = False
                    End If
                End If

                Dim FldBlkIndBit1, FldBlkIndBit2 As Boolean
                If Me.AllowFieldBlocking Then
                    If Not Me.FBK Is Nothing Then
                        If Me.FBK.BitState = True Then
                            FldBlkIndBit1 = True
                        Else
                            FldBlkIndBit1 = False
                        End If
                    Else
                        FldBlkIndBit1 = True
                    End If

                    If Not Me.FBK2 Is Nothing Then
                        If Me.FBK2.BitState = True Then
                            FldBlkIndBit2 = True
                        Else
                            FldBlkIndBit2 = False
                        End If
                    Else
                        If FldBlkIndBit1 Then
                            FldBlkIndBit2 = True
                        Else
                            FldBlkIndBit2 = False
                        End If
                    End If
                    If FldBlkIndBit1 AndAlso FldBlkIndBit2 Then
                        Me.FieldBlockingIndicationStatus = FieldBlockStatus.BlockingOn
                    ElseIf Not FldBlkIndBit1 AndAlso Not FldBlkIndBit2 Then
                        Me.FieldBlockingIndicationStatus = FieldBlockStatus.BlockingOff
                    Else
                        Me.FieldBlockingIndicationStatus = FieldBlockStatus.BlockingOutOfCorespondence
                    End If
                    SystemEvent("FB TRACK<" & Me.GUID & ">, FB1:" & FldBlkIndBit1.ToString & ", FB2:" & FldBlkIndBit2.ToString & ", FieldBlockingIndicationStatus:" & FieldBlockingIndicationStatus.ToString)
                End If


                'If the logic equation sets the track to be occuppied then do this.
                If TrackOccupied Then

                    If optEnableMiscDeviceTrackInterlockMode AndAlso Me.IsInterlockWithMiscellanousDevice Then
                        If Not IsNothing(Me.myInterlockedMiscellanousDevice) AndAlso Not Me.myInterlockedMiscellanousDevice.DisableSlotting Then
                            If Me.myInterlockedMiscellanousDevice.DeviceControlled Then
                                Me.myInterlockedMiscellanousDevice.ControlManually(False, True)
                            End If
                        End If
                    End If

                    If Me.InitOS Or Me.SimulateMode Then
                        If (Not PreviouslyOccuppied And Not Me.NonTransverable And Not Me.OStype And Not Me.TrackZoneIntegrityMonitoringEnabled) Then
                            'This is to prevent train tracking on angle type tracks
                            If Me.LY = Me.RY Then
                                If Not OverrideTrainTracking Then
                                    TrackTrainIDOn()
                                End If
                            ElseIf optEnableTrackSymbolTrackingOnVerticalTracks AndAlso Me.RX = Me.LX Then ' This enables tracking on Vertical Tracks
                                TrackTrainIDOn()
                            End If
                            If optEnableTrainStopOnOccupancyCheck Then
                                CheckToStopTrainOnOccupancy()
                            End If
                        ElseIf (Not PreviouslyOccuppied And Not Me.NonTransverable) And Not Me.FoulingTrackSPMS And Me.TrainIDPlace Then '(Me.OStype And (Me.SlottingTrack Or Me.OSReporting)) Then
                            If Not Me.PreviouslyOccuppied Then
                                If Not Me.NonTransverable Then
                                    Dim osTrk As Object
                                    For Each osTrk In Me.OsComponentCollection
                                        Select Case osTrk.GetType.ToString
                                            Case "TMDS.TrackComponents.Track"
                                                Dim trk As Track = CType(osTrk, Track)
                                                If Not trk.FoulingTrackSPMS Then
                                                    osTrk.PreviouslyOccuppied = True
                                                    osTrk.Occuppied = True
                                                End If

                                        End Select
                                    Next
                                    If Mid(Me.AuthorityType, 1, 3) <> "TWC" Then
                                        TrackTrainIDOn()
                                        If Me.OStype And Me.TrainIDPlace Then
                                            Me.TrainIDTracked = True
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If

                    If optEnableTrainStopOnOccupancyCheck Then
                        CheckToStopTrainOnOSOccupancy()
                    End If

                    If Not Me.PreviouslyOccuppied Then
                        PreviouslyOccuppied = True
                    End If
                    Me.Occuppied = True

                    If Me.SlottingTrack And Not Me.DrillTrack Then
                        Me.SlotSignalRequests()
                        Me.SlotSignalRequest()
                    End If

                    If Me.HoldingSignalSlottingTrack Then
                        Me.SlotHoldingSignalRequests()
                    End If

                    If Me.OStype Or Me.SimulateMode Then
                        'do a check and see if the signals are signal slotting types if so then let the 
                        'CN-919
                        Dim mySwtich As Switch = Nothing
                        Try
                            mySwtich = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(Me)
                            If mySwtich IsNot Nothing Then
                                Select Case mySwtich.TypeOfSwitch.ToUpper.Contains("ELECTRIC LOCK")
                                    Case True
                                        If mySwtich.IgnoreOS Then Me.SignalStatOnMe = SignalStatus.SignalAtStop
                                    Case Else
                                End Select
                            End If

                        Catch ex As Exception
                            GetErrorDetails(ex)
                        End Try
                        'Me.SignalStatOnMe = SignalStatus.SignalAtStop
                    End If

                    If optEnableTrainPositionReportingForMRS AndAlso ((Me.TrainIDPlace And Me.OSReporting) OrElse Me.IsPositionReportingTrack) Then
                        Me.DoCheckPerformReportingForMRS()
                    ElseIf gOptUsePassengerStationForOS AndAlso ((Me.TrainIDPlace And Me.OSReporting) OrElse Me.IsPositionReportingTrack) Then
                        Me.DoCheckPerformReporting()
                    End If

                Else

                    Me.Occuppied = False
                    Me.CallOn = False
                    If Me.OStype Then
                        If optEnableTrainMovementReporting AndAlso PreviouslyOccuppied AndAlso Not Me.TurnOutType AndAlso Me.TrainIDPlace Then
                            Try
                                SystemEvent("SETTING OCCUPANCY OFF STATION:" & Me.GUID.ToString & "; Name:" & Me.Name.ToString)
                                Dim EventData As String = LastTrainSymbolOnMe
                                Dim LogThisOSEvent As New DoEventLogTrack(AddressOf Me.LogTheTrackEvent)
                                LogThisOSEvent.BeginInvoke(Track.EventTypeTrack.OSUNOCCUPIED, EventData, Nothing, Nothing, Nothing)
                                If Not LastTrainSymbolOnMe Is Nothing AndAlso Not String.IsNullOrEmpty(LastTrainSymbolOnMe) Then
                                    Dim data() As String = LastTrainSymbolOnMe.Split(":")
                                    Dim symbol() As String = data(0).Split(":")
                                    Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(symbol(0))
                                    If Not IsNothing(trn) Then
                                        If IsLastOSInCP(Me) Then
                                            SystemEvent("SETTING OFF STATION:" & Me.GUID.ToString & "; train:" & symbol(0).ToString)
                                            trn.AddTrainMovementEvent(Me, Me.myControlPoint, "OFF STATION")
                                        End If
                                        trn.OFFStationCPUID = Me.myControlPoint.GUID
                                        trn.OFFStationOSTrk = Me
                                        If optEnableSendOSMessageFECR Then
                                            TMDS.NetworkMessages.CadMessages.SendTrainOSMessageFECR(trn, gCadTransmitQueue, Me, True)
                                        End If
                                        Me.LastTrainSymbolOnMe = ""
                                    End If
                                End If
                            Catch ex As Exception
                                SystemException(ex.ToString)
                            End Try
                        End If
                    End If

                    If optEnableTrainPositionReportingForMRS AndAlso PreviouslyOccuppied Then
                        'If (Me.TrainIDPlace AndAlso Me.OStype) AndAlso Me.TrackAuthorities.Count > 0 OrElse Me.OtherSplAuthorities.Count > 0 Then
                        '    'If (Me.OSReleaseTrackForRollup AndAlso Me.OStype) Then
                        '    'If Me.OStype Then
                        '    Me.PerformLicenseReleaseForMRS()
                        '    Me.PerformSpecialLicenseReleaseForMRS()
                        'ElseIf Not Me.OStype Then
                        '    Me.PerformLicenseReleaseForMRS()
                        '    Me.PerformSpecialLicenseReleaseForMRS()
                        'End If

                        If (Me.TrainIDPlace AndAlso Me.OStype) AndAlso Me.TrackAuthorities.Count > 0 Then
                            'If (Me.OSReleaseTrackForRollup AndAlso Me.OStype) Then
                            'If Me.OStype Then
                            Me.PerformLicenseReleaseForMRS()

                            If Me.OtherSplAuthorities.Count > 0 Then
                                Try
                                    If Not Me.PerformSpecialLicenseReleaseForMRS() Then
                                        Me.OtherSplAuthorities.Remove(Me)
                                        SystemEvent("ApplyIndicationChangeToTrack ~ Removing Track from OtherSplAuth 1.0:" & Me.GUID.ToString & "; Name:" & Me.Name.ToString)
                                    End If
                                Catch ex As Exception
                                    Me.OtherSplAuthorities.Remove(Me)
                                    SystemEvent("ApplyIndicationChangeToTrack ~ Removing Track from OtherSplAuth 1:" & Me.GUID.ToString & "; Name:" & Me.Name.ToString)
                                End Try

                            End If

                        ElseIf Not Me.OStype Then
                            Me.PerformLicenseReleaseForMRS()
                            If Me.OtherSplAuthorities.Count > 0 Then
                                Try
                                    If Not Me.PerformSpecialLicenseReleaseForMRS() Then
                                        Me.OtherSplAuthorities.Remove(Me)
                                        SystemEvent("ApplyIndicationChangeToTrack ~ Removing Track from OtherSplAuth 2.0:" & Me.GUID.ToString & "; Name:" & Me.Name.ToString)
                                    End If
                                Catch ex As Exception
                                    Me.OtherSplAuthorities.Remove(Me)
                                    SystemEvent("ApplyIndicationChangeToTrack ~ Removing Track from OtherSplAuth 2:" & Me.GUID.ToString & "; Name:" & Me.Name.ToString)
                                End Try
                            End If
                        End If

                        If Me.IsPositionReportingTrack Then
                            Me.DoCheckPerformReportingForMRS()
                        End If
                    ElseIf gOptUsePassengerStationForOS AndAlso PreviouslyOccuppied Then
                        Me.DoCheckPerformReporting()
                    ElseIf optEnableBRCSpecificChecks AndAlso Me.HoldingSignalSlottingTrack AndAlso Me.PreviouslyOccuppied AndAlso optEnableTrainMovementReporting AndAlso Not Me.OStype Then

                        Dim OkToLogOffStationEvent As Boolean = False
                        Dim trn As TrainID = Nothing
                        Try
                            SystemEvent("SETTING OCCUPANCY OFF STATION:" & Me.GUID.ToString & "; Name:" & Me.Name.ToString)
                            Dim EventData As String = LastTrainSymbolOnMe
                            Dim LogThisOSEvent As New DoEventLogTrack(AddressOf Me.LogTheTrackEvent)
                            LogThisOSEvent.BeginInvoke(Track.EventTypeTrack.OSUNOCCUPIED, EventData, Nothing, Nothing, Nothing)
                            If Not LastTrainSymbolOnMe Is Nothing AndAlso Not String.IsNullOrEmpty(LastTrainSymbolOnMe) Then
                                Dim data() As String = LastTrainSymbolOnMe.Split(":")
                                Dim symbol() As String = data(0).Split(":")
                                'Dim trn As TrainID
                                trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(symbol(0))
                                If Not IsNothing(trn) Then
                                    If Me.HoldingSignalOSLeftBoundReporting And (trn.Direction = optDirectionWest Or trn.Direction = optDirectionSouth) Then
                                        If IsLastOSInCP(Me) Then
                                            SystemEvent("SETTING OFF STATION:" & Me.GUID.ToString & "; train:" & symbol(0).ToString)
                                            trn.AddTrainMovementEvent(Me, Me.myControlPoint, "OFF STATION")
                                        End If
                                        trn.OFFStationCPUID = Me.myControlPoint.GUID
                                        trn.OFFStationOSTrk = Me
                                        Me.LastTrainSymbolOnMe = ""
                                    ElseIf Me.HoldingSignalOSRightBoundReporting And (trn.Direction = optDirectionEast Or trn.Direction = optDirectionNorth) Then
                                        If IsLastOSInCP(Me) Then
                                            SystemEvent("SETTING OFF STATION:" & Me.GUID.ToString & "; train:" & symbol(0).ToString)
                                            trn.AddTrainMovementEvent(Me, Me.myControlPoint, "OFF STATION")
                                        End If
                                        trn.OFFStationCPUID = Me.myControlPoint.GUID
                                        trn.OFFStationOSTrk = Me
                                        Me.LastTrainSymbolOnMe = ""
                                    End If
                                End If
                            End If
                        Catch ex As Exception
                            SystemException(ex.ToString)
                        End Try
                    End If

                    'If Me.DerailmentDetectorEnabled Then
                    '    If Not IsNothing(Me.DerailmentDetectorIndBit) Then
                    '        If Me.DerailmentDetectorIndBit.BitState Then
                    '            If Not Me.DerailmentDetectorDisplayHatch Then
                    '                DerailmentDetectorUpdateStatus()
                    '            End If
                    '        Else
                    '            If Me.DerailmentDetectorDisplayHatch Then
                    '                DerailmentDetectorUpdateStatus()
                    '            End If
                    '        End If
                    '    End If
                    'End If

                    If Me.TrackZoneIntegrityMonitoringEnabled Then
                        If Me.TrackZoneCommunicationAlert Then
                            Me.CheckToAcknowledgeNonCommAlert()
                        End If
                        If Not Me.TrackZoneInitialized Then
                            Me.FailState = False
                            Me.TrackZoneLastReportTime = Now
                            If Me.TrackZoneMasterTrack Then
                                Me.UpdateTrackIntegrityZoneStatus()
                            End If
                            Me.TrackZoneInitialized = True
                        Else
                            If Me.TrackZoneStatusRecordTime < Now.AddMinutes(-2) Then
                                Me.TrackZoneLastReportTime = Now
                                If Me.TrackZoneMasterTrack Then
                                    Me.UpdateTrackIntegrityZoneStatus()
                                End If
                            ElseIf OccuppiedPreviousInd <> Me.Occuppied Then
                                Me.TrackZoneLastReportTime = Now
                                If Me.TrackZoneMasterTrack Then
                                    Me.UpdateTrackIntegrityZoneStatus()
                                End If
                            End If
                        End If

                        Dim EventMsg As String = "TRACK INDICATION DATA. (UPDATE STATUS:  Me.FoulingTrackSPMS=" & Me.FoulingTrackSPMS & "Me.TrackZoneMasterTrack=" & Me.TrackZoneMasterTrack & " TrackOccupied=" & TrackOccupied.ToString & ")(OccuppiedPreviousInd:" & OccuppiedPreviousInd.ToString & ")(UID:" & Me.GUID.ToString & ")(CP:" & TMDS.SystemUtilities.FetchData.FindControlPointName(Me.StationNumber) & ")"
                        Me.TrackEventLog(EventMsg)

                        If TrackOccupied And Not OccuppiedPreviousInd And Not Me.FoulingTrackSPMS And Me.TrackZoneMasterTrack Then
                            CheckForExistingAuthorities()
                            If Me.TrackAuthorities.Count > 0 And Not OccuppiedPreviousInd Then
                                CheckToTrackTrainSymbol()
                            End If
                        Else
                            If OccuppiedPreviousInd <> Me.Occuppied And Not Me.FoulingTrackSPMS And Not Me.Occuppied And Me.TrackZoneMasterTrack Then
                                Me.CheckToAcknowledgeAlert()
                                CheckToTrackTrainSymbol()
                            End If
                        End If
                        Me.TrackZoneLastReportTime = Now

                        If Me.FoulingTrackSPMS Then
                            If TrackOccupied And Not OccuppiedPreviousInd Then
                                Me.CheckForExistingAuthorities(True)
                            Else
                                If OccuppiedPreviousInd <> Me.Occuppied Then
                                    Me.CheckToAcknowledgeAlert()
                                End If
                            End If
                        End If
                    End If

                    If (Me.InitOS Or Me.SimulateMode) And Not Me.OStype Then
                        If Me.TrainIDs.Count > 0 Then
                            TrackTrainIDOff(Me.TrafficDirection)
                        End If
                    End If

                    If Me.PreviouslyOccuppied And Not Me.OStype Then
                        If Me.TrafficDirection <> "" And Not SlottingTrack Then
                            Dim RemoveMyTraffic As Boolean = True
                            If (optEnableBRCSpecificChecks Or optEnableARRCSpecificOptions) AndAlso Not TMDS.SystemUtilities.FetchData.CanTrafficBeRemoved(Me, Me.TrafficDirection) Then
                                RemoveMyTraffic = False
                                TrackEventLog("ApplyIndicationChangeToTrack-CanTrafficBeRemoved-RemoveMyTraffic=FALSE:" & Me.Name & ";" & Me.GUID)
                            End If
                            If RemoveMyTraffic Then
                                'if there is a route established and the occupancy goes away.
                                'then check to see if the route is completely clear of occupancies to release the route entirely.
                                CheckToRemoveOfficeTrafficRoute()
                                'Check to see if there is a pending or establish route behind me, if so, then apply it to me
                                CheckForPendingRoutesBehindMe()
                            End If
                        Else
                            If Me.IsLinkToRemoteTrack Then
                                CheckToRemoveOfficeTrafficRoute()
                                'Check to see if there is a pending or establish route behind me, if so, then apply it to me
                                CheckForPendingRoutesBehindMe()
                            ElseIf Me.IsRemoteTrack Then
                                CheckToRemoveOfficeTrafficRoute()
                                'Check to see if there is a pending or establish route behind me, if so, then apply it to me
                                CheckForPendingRoutesBehindMe()
                            End If
                            If Me.TrafficDirection <> "" OrElse Me.SignalStatOnMe <> SignalStatus.SignalAtStop Then
                                Me.SignalStatOnMe = SignalStatus.SignalAtStop
                                Me.TrafficDirection = ""
                            End If
                        End If
                        Me.PreviouslyOccuppied = False '327

                        If Me.HoldingSignalSlottingTrack Then
                            If Not Me.CheckForHoldingSignalFleets() Then
                                Me.SendHoldingSignalRequests()
                            End If
                        End If

                    ElseIf PreviouslyOccuppied And Me.OStype Then
                        PreviouslyOccuppied = False
                        If Me.SlottingTrack And Not Me.DrillTrack Then
                            Dim RemoveMyTraffic As Boolean = True
                            Dim RemoveMyTrafficSearchDirection As String = Me.TrafficDirection
                            TrackEventLog("ApplyIndicationChangeToTrack-RemoveMyTrafficSearchDirection::" & RemoveMyTrafficSearchDirection & ":" & Me.Name & ";" & Me.GUID)

                            If Not IsNothing(RemoveMyTrafficSearchDirection) Then
                                If RemoveMyTrafficSearchDirection.Trim = "" Then
                                    Dim toscomp As Object
                                    For Each toscomp In Me.OsComponentCollection
                                        If toscomp.GetType.ToString = gTrackComponentName Then
                                            Dim ttrk As Track = DirectCast(toscomp, Track)
                                            If Not IsNothing(ttrk.TrafficDirection) AndAlso ttrk.TrafficDirection <> String.Empty Then
                                                RemoveMyTrafficSearchDirection = ttrk.TrafficDirection
                                                If String.IsNullOrEmpty(Me.TrafficDirection) AndAlso Me.NonTransverable Then Me.TrafficDirection = ttrk.TrafficDirection
                                                Exit For
                                            End If
                                        End If
                                    Next
                                End If



                                If optEnableBRCSpecificChecks Then
                                    RemoveMyTrafficSearchDirection = Me.TrafficDirection
                                    If Me.OStype AndAlso Me.SignalStatOnMe = SignalStatus.SignalAtStop AndAlso Me.TrafficDirection.Trim = "" Then
                                        Me.TrafficDirection = ReEstablishTrafficDirection()
                                    End If

                                    If Not TMDS.SystemUtilities.FetchData.CanTrafficBeRemoved(Me, Me.TrafficDirection) Then
                                        RemoveMyTraffic = False
                                        TrackEventLog("ApplyIndicationChangeToTrack-CanTrafficBeRemoved-RemoveMyTraffic=FALSE:" & Me.Name & ";" & Me.GUID)
                                    End If
                                Else
                                    Dim PreviousTrack As Track = TMDS.SystemUtilities.FetchData.FindPreviousTrackOtherThenMe(Me, RemoveMyTrafficSearchDirection)
                                    If Not IsNothing(PreviousTrack) Then
                                        If PreviousTrack.Occuppied AndAlso PreviousTrack.OStype Then
                                            RemoveMyTraffic = False
                                        End If
                                    End If
                                End If
                            End If

                            If RemoveMyTraffic Then
                                TrackEventLog("ApplyIndicationChangeToTrack-CanTrafficBeRemoved-RemoveMyTraffic=FALSE:" & Me.Name & ";" & Me.GUID & ":" & LastTraffic)
                                CheckToRemoveOfficeTrafficRoute(LastTraffic)
                                If Not Me.OsComponentCollection Is Nothing Then
                                    Dim comp As Object
                                    For Each comp In OsComponentCollection
                                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then


                                            If comp.TrainIDs.Count > 0 Then
                                                comp.TrackTrainIDOff(comp.TrafficDirection)
                                            End If
                                            Dim trk As Track = CType(comp, Track)
                                            If Not trk.TrackIndicationORED Then
                                                If Not IsNothing(trk.Ind(0)) Then
                                                    If Not trk.Ind(0).BitState Then
                                                        comp.Occuppied = False
                                                        comp.SignalStatOnMe = SignalStatus.SignalAtStop
                                                        comp.TrafficDirection = ""
                                                        comp.UpdateStatus()
                                                    End If
                                                End If
                                            Else
                                                If Not IsNothing(trk.Ind(0)) And Not IsNothing(trk.Ind(1)) Then
                                                    If Not trk.Ind(0).BitState And Not trk.Ind(1).BitState Then
                                                        comp.Occuppied = False
                                                        comp.SignalStatOnMe = SignalStatus.SignalAtStop
                                                        comp.TrafficDirection = ""
                                                        comp.UpdateStatus()
                                                    End If
                                                End If

                                            End If
                                            comp.TrainIDTracked = False
                                        Else
                                            'comp.Occuppied = False
                                            'comp.SignalStatOnMe = SignalStatus.SignalAtStop
                                            'comp.TrafficDirection = ""
                                            'comp.UpdateStatus()
                                        End If
                                    Next
                                End If
                                'added in 1.0.0.371 as as result of traffic being left on west bound at the slotting track of OS sections
                                Me.SignalStatOnMe = SignalStatus.SignalAtStop
                                Me.TrafficDirection = ""
                            End If

                            'added in 1.0.0.371 as as result of traffic being left on west bound at the slotting track of OS sections
                            If Me.SlottingTrack Then 'Or Me.OSReporting Then
                                CheckForSignalFleets()
                            End If
                        End If

                        If optEnableBRCSpecificChecks Then
                            ApplyInTimeRoute()
                        End If

                    End If

                    If DrillTrack Then
                        If Not Me.myDrillSignal Is Nothing Then
                            'If Me.myDrillSignal.SignalIndStatus <> Signal.IndStatus.Cleared Then
                            Me.myDrillSignal.SetToDrillRequestingClear()
                            Me.TrafficDirection = "BOTH"
                            Me.SignalStatOnMe = Track.SignalStatus.SignalRequestedDrill
                            Me.ApplyTraffic()
                            Me.myDrillSignal.UpdateStatus()
                            'Else 
                            'Me.myDrillSignal.UpdateStatus()
                            'End If
                        End If
                    End If
                End If

                If Me.DerailmentDetectorEnabled Then
                    If Not IsNothing(Me.DerailmentDetectorIndBit) Then
                        If Me.DerailmentDetectorIndBit.BitState Then
                            If Not Me.DerailmentDetectorDisplayHatch Then
                                DerailmentDetectorUpdateStatus()
                            End If
                            If optEnableTrainStopOnDerailmentDetectorCheck Then
                                CheckToStopTrainOnODerailmentDetector()
                            End If
                        Else
                            If Me.DerailmentDetectorDisplayHatch Then
                                DerailmentDetectorUpdateStatus()
                            End If
                        End If
                    End If
                End If




                If Not Me.InitOS Then
                    Me.InitOS = True
                End If


                If Me.Occuppied <> Me.OccuppiedPreviousInd Then
                    Dim LogThisEvent As New DoEventLogTrack(AddressOf Me.LogTheTrackEvent)
                    If Me.TrainIDs.Count > 0 Then
                        LogThisEvent.BeginInvoke(Track.EventTypeTrack.IND, Nothing, Me.TrainIDs(0), Nothing, Nothing)
                    Else
                        'This added symbol in remote tracks
                        If Me.AltLinkOne <> 0 Then
                            Dim trkAux As Track = FindTrackFromGUID(Me.AltLinkOne)
                            If trkAux IsNot Nothing AndAlso trkAux.TrainIDs.Count > 0 Then
                                LogThisEvent.BeginInvoke(Track.EventTypeTrack.IND, Nothing, trkAux.TrainIDs(0), Nothing, Nothing)
                                TrackEventLog("ApplyIndicationChangeToTrack:Added symbol from remote track:Track=" & trkAux.GUID.ToString & ":Train=" & trkAux.TrainIDs(0).Name)
                            End If
                            trkAux = Nothing
                        Else
                            LogThisEvent.BeginInvoke(Track.EventTypeTrack.IND, Nothing, Nothing, Nothing, Nothing)
                        End If
                    End If
                    'Create alert to lost occupancy with train over track
                    If optEnableLostOccupancyAlert AndAlso
                        Me.Initialized AndAlso
                        Not Me.Occuppied AndAlso
                        (Me.OStype AndAlso Me.TrainIDPlace OrElse Not Me.OStype) AndAlso
                        Me.TrainIDs.Count > 0 Then
                        Dim trn As TrainID
                        For Each trn In Me.TrainIDs
                            GenerateLostOccupancyAlert(trn)
                        Next
                    End If
                    'Create track block to to lost occupancy
                    If optEnableLostOccupancyAlertWithTrackBlock AndAlso
                        Me.Initialized AndAlso
                        Not Me.Occuppied AndAlso
                        Not Me.OStype AndAlso
                        Not Me.IsRemoteTrack AndAlso
                        Me.AuthorityType.Contains("CTC") AndAlso
                        Me.DeviceBlocks.Count = 0 AndAlso
                        Me.TrackAlternativeName.Contains("AUTOBLOCKLOSTOCCUPANCY") Then
                        GenerateLostOccupancyTrackBlock()
                    End If
                    'Send update for track alarm
                    If optEnableTagTrackAlarm AndAlso Me.TrackTagLabels.Count > 0 AndAlso Me.Occuppied Then
                        Dim tagFound As Tag = Nothing
                        For Each tg As Tag In Me.TrackTagLabels
                            If tg.TagType = optTagType6 Then
                                tagFound = tg
                                Exit For
                            End If
                        Next
                        If tagFound IsNot Nothing Then
                            Dim train As TrainID
                            Dim trainSymbol As String = String.Empty
                            Dim trainGauge As String = String.Empty
                            If Me.TrainIDs.Count > 0 Then
                                train = Me.TrainIDs.Item(0)
                                trainSymbol = train.Name
                                trainGauge = train.SubType
                            End If
                            TMDS.NetworkMessages.CadMessages.SendTrackAlarmEvent("UPDATE", Me.Name, trainSymbol, Me.myControlPoint.GUID, tagFound)
                            train = Nothing
                            trainSymbol = Nothing
                        End If
                        tagFound = Nothing
                    End If
                End If
                OccuppiedPreviousInd = Me.Occuppied
                If Me.FailState Or Me.DoMonitorMode Or Not Me.Initialized Then
                    If Me.AllowFieldBlocking Then
                        If FldBlkIndBit1 Or FldBlkIndBit2 Then
                            Me.SetFieldBlockingControls(True)
                        End If
                    End If
                End If
                Me.Initialized = True
                Me.FailState = False
                Dim EventMessage As String = "TRACK INDICATION RECEIVED. (UPDATE STATUS: OCCUPANCY=" & Me.Occuppied & ")(NAME:" & Me.Name & ")(UID:" & Me.GUID.ToString & ")(CP:" & TMDS.SystemUtilities.FetchData.FindControlPointName(Me.StationNumber) & ")"
                Me.TrackEventLog(EventMessage)
                If gTraineeMode Then
                    Me.myControlPoint.SendSimulatedIndication()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Generate Lost Occupancy Alert - TRAIN xxxx HAS LOST OCCUPANCY ALERT ON TRACK CIRCUIT YYYY AT CONTROL POINT ZZZZ
        ''' </summary>
        ''' <param name="pTrain"></param>
        Private Sub GenerateLostOccupancyAlert(pTrain As TrainID)
            Dim al As Alert
            Dim alertExists As Boolean
            Dim alertMessage As String
            Try
                alertMessage = optTrainAlertString01 & Space(1) & pTrain.Name & Space(1) & optTrainAlertString02 & Space(1) & Me.Name & Space(1) & optTrainAlertString03 & Space(1) & Me.myControlPoint.Name
                TrackEventLog("GenerateLostOccupancyAlert:Alert=" & alertMessage)
                'check for existing alert
                For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                    If al.AlertData = alertMessage And Not al.AlertAcknowledged Then
                        TrackEventLog("GenerateLostOccupancyAlert:1:Alert already exist in system summary:Alert=" & alertMessage)
                        alertExists = True
                        Exit For
                    End If
                Next
                For Each al In gSystemAlertQueue
                    If al.AlertData = alertMessage And Not al.AlertAcknowledged Then
                        TrackEventLog("GenerateLostOccupancyAlert:2:Alert already exist in system summary:Alert=" & alertMessage)
                        alertExists = True
                        Exit For
                    End If
                Next
                If Not alertExists Then
                    TMDS.ManagementClasses.AlertUtilities.CreateAlert(ManagementClasses.Alert.AlertType.LostTrackOccupancy, alertMessage, pTrain)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                al = Nothing
                alertExists = Nothing
                alertMessage = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Generate Lost Occupancy Track Block
        ''' </summary>
        Private Sub GenerateLostOccupancyTrackBlock()
            Dim trkLeft As Track = Nothing
            Dim trkRight As Track = Nothing
            Dim trkAux As Track = Nothing
            Dim trackNamesDuplicates As String = String.Empty
            Dim trackList As New ArrayList
            Try
                'If Me.LastTraffic = String.Empty Then
                '    TrackEventLog("GenerateLostOccupancyTrackBlock:Track without traffic direction")
                '    Exit Sub
                'End If
                'Find out the next track with different name
                If Me.LeftLink <> 0 Then
                    trkLeft = FindDifferentTrackName("LEFT", Me.LeftLink, trackNamesDuplicates)
                End If
                If Me.RightLink <> 0 Then
                    trkRight = FindDifferentTrackName("RIGHT", Me.RightLink, trackNamesDuplicates)
                End If
                ''Avoid track block with no direction to adjacents tracks
                'If trkLeft IsNot Nothing AndAlso trkRight IsNot Nothing AndAlso trkLeft.TrafficDirection = String.Empty AndAlso trkRight.TrafficDirection = String.Empty Then
                '    TrackEventLog("GenerateLostOccupancyTrackBlock:Track without traffic direction")
                '    Exit Sub
                'End If
                'Find out the first track in track collection with name duplicated 
                If trackNamesDuplicates <> String.Empty Then
                    If trackNamesDuplicates.Contains("RIGHT") Then
                        trkAux = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToLeft(Me.LeftLink)
                        If Me.Name <> trkAux.Name Then
                            For Each trk As Track In TMDS.GlobalDeclarations.TrackCollection
                                If trk.Name = Me.Name Then
                                    trackList.Add(trk)
                                    TrackEventLog("GenerateLostOccupancyTrackBlock:AddTrack=" & trk.GUID.ToString & ":" & trk.Name)
                                End If
                            Next
                        End If
                    ElseIf trackNamesDuplicates.Contains("LEFT") Then
                        trkAux = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToLeft(Me.RightLink)
                        If Me.Name <> trkAux.Name Then
                            For Each trk As Track In TMDS.GlobalDeclarations.TrackCollection
                                If trk.Name = Me.Name Then
                                    trackList.Add(trk)
                                    TrackEventLog("GenerateLostOccupancyTrackBlock:AddTrack=" & trk.GUID.ToString & ":" & trk.Name)
                                End If
                            Next
                        End If
                    End If
                Else
                    trackList.Add(Me)
                    TrackEventLog("GenerateLostOccupancyTrackBlock:AddTrack=" & Me.GUID.ToString & ":" & Me.Name)
                End If
                If trackList.Count > 0 AndAlso trkLeft IsNot Nothing AndAlso trkRight IsNot Nothing Then
                    If trkLeft.Occuppied = False AndAlso trkRight.Occuppied = False Then
                        TrackEventLog("GenerateLostOccupancyTrackBlock:Track block added to lost occupancy")
                        ApplyDeviceBlockFromTrack(trackList, "INTERDIÇÃO AUTOMÁTICA PARA PERDA DE OCUPAÇÃO")
                    Else
                        TrackEventLog("GenerateLostOccupancyTrackBlock:Adjacent blocks occupied:trkLeft=" & trkLeft.Name & "-" & trkLeft.Occuppied.ToString & ":trkRight=" & trkRight.Name & "-" & trkRight.Occuppied.ToString)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                trkLeft = Nothing
                trkRight = Nothing
                trkAux = Nothing
                trackNamesDuplicates = Nothing
                trackList = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Find Different track name according direction
        ''' </summary>
        ''' <param name="pDirection"></param>
        ''' <param name="pUID"></param>
        ''' <returns></returns>
        Private Function FindDifferentTrackName(ByVal pDirection As String, ByVal pUID As Integer, ByRef pTrackNamesDuplicates As String) As Track
            Dim trk As Track
            Dim loopControl As Integer
            Dim uidRef As Integer = pUID
            Try
                Do
                    If pDirection.Contains("LEFT") Then
                        trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToLeft(uidRef)
                        If trk.Name <> Me.Name Then
                            Return trk
                        End If
                        pTrackNamesDuplicates = "LEFT"
                        If trk.LeftLink <> 0 Then
                            uidRef = trk.LeftLink
                        Else
                            Return Nothing
                        End If
                    ElseIf pDirection.Contains("RIGHT") Then
                        trk = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUIDAndLoopToRight(uidRef)
                        If trk.Name <> Me.Name Then
                            Return trk
                        End If
                        pTrackNamesDuplicates = "RIGHT"
                        If trk.RightLink <> 0 Then
                            uidRef = trk.RightLink
                        Else
                            Return Nothing
                        End If
                    End If
                    loopControl += 1
                    If loopControl > 3 Then
                        Return Nothing
                    End If
                Loop
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            Finally
                trk = Nothing
                loopControl = Nothing
                uidRef = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Apply Device Block From Track
        ''' </summary>
        ''' <param name="pTrackList"></param>
        ''' <param name="pBlockNote"></param>
        ''' <returns></returns>
        Public Function ApplyDeviceBlockFromTrack(ByVal pTrackList As ArrayList, ByVal pBlockNote As String) As Boolean
            Dim index As Integer
            Dim blk As New TrackAuthority.DeviceBlock()
            Dim deviceBlockSelection As New ArrayList()
            Dim summItem As SummaryItem
            Dim trk As Track
            Try
                TrackEventLog("ApplyDeviceBlockFromTrack:pTrackList=" & pTrackList.Count.ToString & ":pBlockNote=" & pBlockNote)
                trk = pTrackList(0)
                With blk
                    .AuthorityLimits = "SWITCH DEVICE BLOCK"
                    .BlockNotes = pBlockNote
                    .OKTime = Now
                    .IssueTo = trk.Name
                    .RailRoadName = "NONE"
                    .DispatcherName = gCurrentUser.FirstName & " " & gCurrentUser.LastName
                    .AuthorityDate = Now
                    .AuthorityNumber = trk.myTerritory.GetNextAuthorityNumber()
                    .Direction = "NONE"
                    .AuthorityType = "DEVICE BLOCK"
                    .UntilTime = Now
                    .AuthorityUID = trk.TerritoryID.ToString & " - " & .AuthorityNumber.ToString
                    .TerritoryAssignment = trk.TerritoryID
                    .ComponentsInSelection = pTrackList.Clone
                End With
                For index = 1 To 3
                    Select Case index
                        Case 1
                            If blk.AddSwitchDeviceBlockToSystem(pTrackList, TMDS.GlobalDeclarations.gDeviceBlocks) Then
                                TrackEventLog("ApplyDeviceBlockFromTrack:Device Block Applied to the System: " & blk.AuthorityUID)
                            Else
                                TrackEventLog("ApplyDeviceBlockFromTrack:System Error! Please Consider Device Block " & blk.AuthorityUID & " NOT in Effect!")
                                ClearSystemVariables()
                            End If
                        Case 2 'Check to see if track warrant data is written to database OK
                            If blk.AddDeviceBlockToDB() Then
                                TrackEventLog("ApplyDeviceBlockFromTrack:Device Block Applied to the Database: " & blk.AuthorityUID)
                                blk.ApplyDeviceBlockToRemoteLinks()
                            Else
                                TrackEventLog("ApplyDeviceBlockFromTrack:System Error! Please Consider Device Block " & blk.AuthorityUID & " NOT in Effect!")
                                ClearSystemVariables()
                            End If
                        Case 3
                            summItem = New SummaryItem("BLOCK", "ADD", blk)
                            SyncLock gSummaryBlockQueue.SyncRoot
                                gSummaryBlockQueue.Enqueue(summItem)
                            End SyncLock
                    End Select
                Next
                TrackEventLog("ApplyDeviceBlockFromTrack:Device=" & blk.BlockGUID & ":" & blk.IssueTo)
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                index = Nothing
                blk = Nothing
                summItem = Nothing
            End Try
        End Function

        Private Sub ApplyInTimeRoute()
            Try
                ' this is to paint the signal route intime if track unoccupancy and Intime is received in one indication message.
                ' make the indication to process it in the order : signal, track and signal again after shunt timer..
                If optEnableBRCSpecificChecks Then
                    Dim i As Integer
                    Dim CompInSelection As Object
                    For i = 1 To 2
                        Select Case i
                            Case 1
                                Dim myRightSignal As Object = SystemUtilities.FetchData.FindCompItemFromGUID(Me.RightLink)
                                If Not IsNothing(myRightSignal) AndAlso myRightSignal.GetType.ToString = gSignalComponentName AndAlso myRightSignal.SignalIndStatus = Signal.IndStatus.InTime Then
                                    myRightSignal.GetSignalRoute()
                                    For Each CompInSelection In myRightSignal.SignalRouteCollection
                                        If CompInSelection.TrafficDirection <> Nothing AndAlso CompInSelection.TrafficDirection <> "" Then
                                            myRightSignal.UpdateStatus()
                                            Exit For
                                        End If
                                    Next
                                End If
                            Case 2
                                Dim myLeftSignal As Object = SystemUtilities.FetchData.FindCompItemFromGUID(Me.LeftLink)
                                If Not IsNothing(myLeftSignal) AndAlso myLeftSignal.GetType.ToString = gSignalComponentName AndAlso myLeftSignal.SignalIndStatus = Signal.IndStatus.InTime Then
                                    myLeftSignal.GetSignalRoute()
                                    For Each CompInSelection In myLeftSignal.SignalRouteCollection
                                        If CompInSelection.TrafficDirection <> Nothing AndAlso CompInSelection.TrafficDirection <> "" Then
                                            myLeftSignal.UpdateStatus()
                                            Exit For
                                        End If
                                    Next
                                End If
                        End Select
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub TrackIDsOffTrack(ByRef TrackOffTrack As Track, ByRef TrackOnTrack As Track, Optional ByVal DirectionToTrack As String = Nothing)
            Dim LoopControl As Integer
            'this is to track multple Train IDs off an unoccupied traack
            If (gAssistMode OrElse Me.IsShadowMode) Then Exit Sub

            Try
                Dim trnToMove As TrainID = Nothing
                If TrackOnTrack.IsRemoteTrack Then
                    Dim Trains As ArrayList = Me.TrainIDs.Clone
                    For Each trnToMove In Trains
                        Dim TrainName As String = trnToMove.Name
                        Me.ReleaseTrainID(trnToMove, TrainCollection)
                        Me.InvalidateTrainID()
                        Me.InitTrainDisplay()
                        TrackOnTrack.myRemoteTrack.TrackTrainID(TrainName)
                    Next
                    Exit Sub
                ElseIf TrackOnTrack.IsLinkToRemoteTrack AndAlso optEnableBRCSpecificChecks Then
                    Dim myRemoteTrack As Track = Nothing
                    Dim RightTrk As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(TrackOnTrack.RightLink)
                    Dim LeftTrk As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(TrackOnTrack.LeftLink)
                    Try
                        If RightTrk IsNot Nothing Then
                            myRemoteTrack = RightTrk
                        ElseIf LeftTrk IsNot Nothing Then
                            myRemoteTrack = LeftTrk
                        End If

                        If myRemoteTrack IsNot Nothing Then
                            Dim Trains As ArrayList = Me.TrainIDs.Clone
                            For Each trnToMove In Trains
                                Dim TrainName As String = trnToMove.Name
                                Me.ReleaseTrainID(trnToMove, TrainCollection)
                                Me.InvalidateTrainID()
                                Me.InitTrainDisplay()
                                myRemoteTrack.myRemoteTrack.TrackTrainID(TrainName)
                            Next
                            Exit Sub
                        End If
                    Catch ex As Exception
                        GetErrorDetails(ex)
                    Finally
                        myRemoteTrack = Nothing
                        RightTrk = Nothing
                        LeftTrk = Nothing
                    End Try
                ElseIf TrackOnTrack.AuthorityType = "YL" AndAlso TrackOnTrack.ReleaseTrainIDTrack AndAlso optApplyTrainSheetConfigurationForKCT Then
                    If Me.TrainIDs.Count > 0 Then
                        Dim tmpTrainToRel As TrainID = Me.TrainIDs(0)
                        If tmpTrainToRel IsNot Nothing AndAlso tmpTrainToRel.DoesThisTrainHasOsRecords Then
                            Dim AutoReleasefailed As Boolean = False
                            Me.ReleaseTrainID(0, TMDS.GlobalDeclarations.TrainCollection, False, True, AutoReleasefailed)
                            Me.InvalidateTrainID()
                            Me.InitTrainDisplay()
                            If Not AutoReleasefailed Then Exit Sub
                        End If
                    End If
                End If


                Do Until TrackOffTrack.TrainIDs.Count = 0
                    trnToMove = Me.TrainIDs.Item(0)
                    If Not IsTrainMoveAllowedOnIndication(trnToMove, "TrackIDsOffTrack") Then Exit Sub
                    If DirectionToTrack = "" Then
                        If (trnToMove.Direction = optDirectionEast Or trnToMove.Direction = optDirectionNorth) And Me.RightAltLink <> 0 Then

                            TrackOnTrack.MoveTrainIDPlace(trnToMove, TrackOffTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T")
                            TrackOnTrack.InvalidateTrainID()

                        ElseIf (trnToMove.Direction = optDirectionWest Or trnToMove.Direction = optDirectionSouth) And Me.LeftAltLink <> 0 Then

                            TrackOnTrack.MoveTrainIDPlace(trnToMove, TrackOffTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T")
                            TrackOnTrack.InvalidateTrainID()

                        ElseIf Me.RightAltLink = 0 And Me.LeftAltLink = 0 Then
                            TrackOnTrack.MoveTrainIDPlace(trnToMove, TrackOffTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T")
                            TrackOnTrack.InvalidateTrainID()
                        End If

                        'If trnToMove.Direction = optDirectionEast Or trnToMove.Direction = optDirectionNorth Then
                        '    If Me.RightAltLink <> 0 Then
                        '        TrackOnTrack.MoveTrainIDPlace(trnToMove, TrackOffTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T")
                        '        TrackOnTrack.InvalidateTrainID()
                        '    End If
                        'ElseIf trnToMove.Direction = optDirectionWest Or trnToMove.Direction = optDirectionSouth Then
                        '    If Me.LeftAltLink <> 0 Then
                        '        TrackOnTrack.MoveTrainIDPlace(trnToMove, TrackOffTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T")
                        '        TrackOnTrack.InvalidateTrainID()
                        '    End If
                        'Else
                        '    TrackOnTrack.MoveTrainIDPlace(trnToMove, TrackOffTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T")
                        '    TrackOnTrack.InvalidateTrainID()
                        'End If
                    ElseIf DirectionToTrack = "RIGHT" Then
                        If trnToMove.Direction = optDirectionEast Or trnToMove.Direction = optDirectionNorth Then
                            TrackOnTrack.MoveTrainIDPlace(trnToMove, TrackOffTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", DirectionToTrack)
                            TrackOnTrack.InvalidateTrainID()
                        End If
                    ElseIf DirectionToTrack = "LEFT" Then
                        If trnToMove.Direction = optDirectionWest Or trnToMove.Direction = optDirectionSouth Then
                            TrackOnTrack.MoveTrainIDPlace(trnToMove, TrackOffTrack, False, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", DirectionToTrack)
                            TrackOnTrack.InvalidateTrainID()
                        End If

                    End If

                    LoopControl = LoopControl + 1
                    If LoopControl > 10 Then
                        Exit Sub
                    End If
                Loop

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Sub TrackTrainIDOff(Optional ByVal DirectionOfTraffic As String = Nothing)
            Try
                If (gAssistMode OrElse Me.IsShadowMode) Then Exit Sub
                Dim SearchRightComplete, SearchLeftComplete As Boolean
                Dim NextComp As Object
                Dim LastRefNumber As Int32
                Dim LoopControl As Integer
                Dim FlipIt As Boolean
                If Me.TrainIDs.Count = 0 Then Exit Sub
                Dim trnToMove As TrainID = Me.TrainIDs.Item(0)
                Dim BRCTrainPostion As Integer
                Dim TerrFlipDirection As Boolean
                TerrFlipDirection = Me.myTerritory.FlipDirection

                'SystemEvent("TRACING TRACKTRAINIDOFF:" & Me.GUID)
                If Me.TrafficDirection = "RIGHT" Or DirectionOfTraffic = "RIGHT" Then

                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.RightLink)

                    While Not SearchRightComplete
                        If NextComp Is Nothing Then
                            If Me.RightAltLink <> 0 Then
                                Dim ShelfTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.RightAltLink)
                                If Me.TrainIDs.Count > 0 Then
                                    TrackIDsOffTrack(Me, ShelfTrack, Me.TrafficDirection)
                                    Exit Sub
                                End If
                            End If
                            Exit While
                        End If
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            LastRefNumber = NextComp.GUID

                            If NextComp.NonTransverable Then

                                Exit While
                            End If

                            If NextComp.StationNumber = Me.StationNumber And NextComp.Name = Me.Name Then
                                If FlipIt Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            Else
                                If NextComp.Occuppied Then
                                    If Me.TrainIDs.Count > 0 Then
                                        Dim trn As TrainID = Me.TrainIDs.Item(0)
                                        If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainIDOff") Then Exit Sub
                                        If optEnableBRCSpecificChecks AndAlso TerrFlipDirection Then
                                            If trn.Direction = optDirectionWest Or trn.Direction = optDirectionSouth Then
                                                If CanTrainBeTracked(NextComp) Then
                                                    TrackIDsOffTrack(Me, NextComp)
                                                End If
                                            Else
                                                Exit While
                                            End If
                                        ElseIf optEnableReverseMovementIntoOSIfSignalIndicatesClear AndAlso NextComp.OsComponentCollection IsNot Nothing AndAlso NextComp.OsComponentCollection.Count > 0 AndAlso ValidateReverseMovementIntoOS(NextComp) Then
                                            TrackIDsOffTrack(Me, NextComp)
                                        ElseIf optEnableCPSpecificOptions Then
                                            If optFlipNorthSouthDirection AndAlso trn.Direction = optDirectionEast OrElse trn.Direction = optDirectionSouth Then
                                                If Not NextComp.TrainIDTracked Then
                                                    TrackIDsOffTrack(Me, NextComp)
                                                End If
                                            Else
                                                Exit While
                                            End If
                                        Else
                                            If trn.Direction = optDirectionEast OrElse trn.Direction = optDirectionNorth Then
                                                If Not NextComp.TrainIDTracked Then
                                                    TrackIDsOffTrack(Me, NextComp)
                                                End If
                                            Else
                                                Exit While
                                            End If
                                        End If
                                    Else
                                        Exit While
                                    End If
                                ElseIf Not NextComp.Indicating Then
                                    TrackIDsOffTrack(Me, NextComp)
                                    Exit Sub
                                End If
                                SearchRightComplete = True
                            End If
                        ElseIf NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If NextComp.ControlledReverse Then
                                If NextComp.RightAltLink <> 0 Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightAltLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(NextComp.RightLink)
