                            If Truncate(OldTrack.LeftLimitMilePost) <> Truncate(Me.LeftLimitMilePost) Or Truncate(OldTrack.RightLimitMilePost) <> Truncate(Me.RightLimitMilePost) Then
                                MessageBox.Show("MILEPOST RANGES DO NOT MATCH AND NOT ALLOWED FROM COPY TAG FUNCTION", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                Exit Sub
                            End If
                        Else
                            If OldTrack.LeftLimitMilePost <> Me.LeftLimitMilePost Or OldTrack.RightLimitMilePost <> Me.RightLimitMilePost Then
                                MessageBox.Show("MILEPOST RANGES DO NOT MATCH AND NOT ALLOWED FROM COPY TAG FUNCTION", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                Exit Sub
                            End If
                        End If
                        If OldTrack.MilePostSuffix <> Me.MilePostSuffix Then
                            MessageBox.Show("MILEPOST RANGES DO NOT MATCH AND NOT ALLOWED FROM COPY TAG FUNCTION", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                            Exit Sub
                        End If
                End Select





                If gTrackTagLimit <> 0 Then
                    Dim TagCount As Integer
                    TagCount = Me.TrackTagLabels.Count
                    If TagCount >= gTrackTagLimit Then
                        MessageBox.Show("NO MORE THEN " & gTrackTagLimit & " TAGS PER TRACK", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                        Exit Sub
                    End If
                    Dim trk As Track
                    For Each trk In TMDS.GlobalDeclarations.TrackCollection
                        If (trk.Name = Me.Name And trk.myControlPoint.GUID = Me.myControlPoint.GUID) And Not Me.GUID = trk.GUID Then
                            TagCount = TagCount + trk.TrackTagLabels.Count
                            If TagCount >= gTrackTagLimit Then
                                MessageBox.Show("NO MORE THEN " & gTrackTagLimit & " TAGS PER TRACK", "SYSTEM MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                Exit Sub
                            End If
                        End If
                    Next
                End If

                If Me.SignalStatOnMe <> TrackComponents.Track.SignalStatus.SignalAtStop Or Me.Occuppied Then
                    Dim frmMessageBox As frmMessageBox
                    Dim FormPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Left + 300, Me.CurrentDrawingForm.Height / 2)
                    Dim MessageList As New ArrayList()
                    'MessageList.Add("SIGNAL ACTIVITY IN TAG LIMITS. CONTINUE WITH TRACK TAG?")
                    MessageList.Add(optTagString_SignalActivity)
                    MessageList.Add("")
                    frmMessageBox = New frmMessageBox()
                    frmMessageBox.Owner = Me.CurrentDrawingForm
                    frmMessageBox.StartPosition = FormStartPosition.Manual
                    frmMessageBox.SetMessage(MessageList, "TRACK TAG CHECK", True, FormPoint)
                    frmMessageBox.ShowDialog()
                    If frmMessageBox.FormFeedBack <> 6 Then
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing
                        TMDS.modSystemFuncs.ClearSystemVariables()
                        Exit Sub
                    End If
                    frmMessageBox.Dispose()
                    frmMessageBox = Nothing

                End If
                Dim currentTag As New Tag()
                currentTag.CreateTime = Now
                currentTag.Creator = gTagToCopy.Creator
                If gTagToCopy.TagType = "SPEED" Then
                    Dim MilePostOutOfRange As Boolean
                    'Dim data() As String = gTagToCopy.DataString.Split("|")
                    'Dim TagData As String = data(0) & "|" & data(1) & "|"
                    'TagData = TagData & data(2) & "|" & Me.TrackName & "|" & data(4) & "|"
                    'TagData = TagData & data(5) & "|" & data(6) & "|" & data(7)
                    Dim data() As String = gTagToCopy.DataString.Split("|")
                    Dim TagData As String = String.Empty
                    Dim index As Integer
                    Dim d As String
                    For Each d In data
                        If index = 0 Then
                            TagData = d
                        Else
                            If index = 3 Then
                                TagData = TagData & "|" & Me.TrackName
                            Else
                                TagData = TagData & "|" & d
                            End If

                        End If
                        index += 1
                    Next

                    If CDec(data(1)) < CDec(data(2)) Then
                        If Not Me.SetMilePostLimits(Me, CDec(data(1)), CDec(data(2))) Then
                            MilePostOutOfRange = True
                        End If
                    Else
                        If Not Me.SetMilePostLimits(Me, CDec(data(2)), CDec(data(1))) Then
                            MilePostOutOfRange = True
                        End If
                    End If

                    If MilePostOutOfRange Then
                        Dim frmMessageBox As frmMessageBox
                        Dim FormPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Left + 300, Me.CurrentDrawingForm.Height / 2)
                        Dim MessageList As New ArrayList()
                        MessageList.Add("THE TAG BEING COPIED HAS A MILE POST RANGE")
                        MessageList.Add("THAT IS OUTSIDE THE LIMITS OF THIS TRACK.")
                        MessageList.Add("")
                        MessageList.Add("APPLY THE ORIGINAL TAG'S MILE POST RANGES?")
                        MessageList.Add("IF NO, THEN THE TRACK'S MILEPOST RANGES WILL BE APPLIED.")
                        MessageList.Add("")

                        frmMessageBox = New frmMessageBox()
                        frmMessageBox.Owner = Me.CurrentDrawingForm
                        frmMessageBox.StartPosition = FormStartPosition.Manual
                        frmMessageBox.SetMessage(MessageList, "TRACK TAG CHECK", True, FormPoint)
                        frmMessageBox.ShowDialog()
                        If frmMessageBox.FormFeedBack <> 6 Then
                            TagData = data(0) & "|" & CStr(Me.LeftLimitMilePost) & "|"
                            TagData = TagData & CStr(Me.RightLimitMilePost) & "|" & Me.TrackName & "|" & data(4) & "|"
                            TagData = TagData & data(5) & "|" & data(6) & "|" & data(7)
                        End If
                        frmMessageBox.Dispose()
                        frmMessageBox = Nothing
                        'ClearSystemVariables()
                        'Exit Sub
                    End If
                    currentTag.DataString = TagData
                Else
                    currentTag.DataString = gTagToCopy.DataString
                End If

                currentTag.ExpectedReleaseTime = gTagToCopy.ExpectedReleaseTime
                currentTag.DelayData = gTagToCopy.DelayData
                currentTag.Restriction = gTagToCopy.Restriction
                currentTag.Subdivision = gTagToCopy.Subdivision
                currentTag.TagType = gTagToCopy.TagType
                currentTag.TerritoryID = Me.TerritoryID
                currentTag.TrackGuid = Me.GUID
                currentTag.Restrictive = gTagToCopy.Restrictive
                currentTag.Direction = gTagToCopy.Direction
                currentTag.Delay = gTagToCopy.Delay
                currentTag.RefNumPTC = CInt(CStr(Me.GUID.ToString) & Format(Now, "fff"))
                currentTag.PTCData = currentTag.GetPTCData()

                currentTag.SpeedTagReasonCode = gTagToCopy.SpeedTagReasonCode
                currentTag.NameRequestingTagPlacement = gTagToCopy.NameRequestingTagPlacement
                currentTag.CreateSpeedRestriction = gTagToCopy.CreateSpeedRestriction
                currentTag.SpeedTagFlagInfo = gTagToCopy.SpeedTagFlagInfo

                If currentTag.InsertTagIntoDB(gtblTagsActive) Then
                    If Me.AddTagToTrack(currentTag) Then
                        Me.InitTagDisplay()

                        TrackTags.Add(currentTag)
                        Dim SummItem As New SummaryItem("TAG", "ADD", currentTag)
                        SyncLock gSummaryTagQueue.SyncRoot
                            gSummaryTagQueue.Enqueue(SummItem)
                        End SyncLock
                    End If

                    If currentTag.Restrictive Then
                        TrackEventLog("Copied Tag Inserted into database @ " & currentTag.CreateTime & " (" & currentTag.Creator & ")" & "RESTRICTION CHECK ON")
                    Else
                        TrackEventLog("Copied Tag Inserted into database @ " & currentTag.CreateTime & " (" & currentTag.Creator & ")" & "RESTRICTION CHECK OFF")
                    End If

                    If optEnableSpeedRestrictionFlags Then
                        currentTag.UpdateTagRecordWithFlagData()
                    End If
                    If optEnableSendTrackTagToBusInfoCommunicationServer Then
                        TMDS.NetworkMessages.TSSMessage.SendTrackTagChange(currentTag, "NEW", gBSCSTransmitQueue)
                    End If

                    If Me.myTerritory.PTCEnabled And optEnablePTCBOSVETMSMode And currentTag.Restriction Then
                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_TrackTagChangeNotification(currentTag, "ADD")
                    End If

                    TMDS.NetworkMessages.CadMessages.SendSpeedRestrictionEventForWabtecOne(currentTag, "CREATE")

                Else
                    If currentTag.Restrictive Then
                        TrackEventLog("Copied Tag NOT Inserted into database @ " & currentTag.CreateTime & " (" & currentTag.Creator & ")" & "RESTRICTION CHECK ON")
                    Else
                        TrackEventLog("Copied Tag NOT Inserted into database @ " & currentTag.CreateTime & " (" & currentTag.Creator & ")" & "RESTRICTION CHECK OFF")
                    End If
                End If
                Me.UpdateTagStatus()
                Me.UpdateStatus()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function OkToCopyTag(ByVal OldTrack As Track, ByVal TagType As String, ByVal UserFromMP As String, ByVal UserToMP As String) As Boolean
            Dim OldLMP As Decimal = 0.0
            Dim OldRMP As Decimal = 0.0
            Dim NLMP As Decimal = 0.0
            Dim NRMP As Decimal = 0.0
            Dim FromMP As Decimal = 0.0
            Dim ToMP As Decimal = 0.0
            Dim validLimits As New ArrayList
            Dim returnValue As Boolean
            If OldTrack Is Nothing Then Return False
            Dim NoOfDec As Integer = 0
            Try


                Select Case TagType.Trim.ToUpper
                    Case "SPEED"
                        NoOfDec = 1
                    Case Else
                        NoOfDec = 2
                End Select
                Dim isMPDescending As Boolean

                OldLMP = Truncate(OldTrack.LeftLimitMilePost, NoOfDec)
                OldRMP = Truncate(OldTrack.RightLimitMilePost, NoOfDec)
                NLMP = Truncate(Me.LeftLimitMilePost, NoOfDec)
                NRMP = Truncate(Me.RightLimitMilePost, NoOfDec)
                If UserFromMP.Trim <> String.Empty Then FromMP = Truncate(CDec(UserFromMP), NoOfDec)
                If UserToMP.Trim <> String.Empty Then ToMP = Truncate(CDec(UserToMP), NoOfDec)
                Dim K As Decimal
                If NLMP < NRMP Then
                    isMPDescending = True
                    K = NLMP
                Else
                    K = NRMP
                End If

                Dim i As Decimal
                Dim J As Decimal

                Dim incrementer As Decimal
                Select Case TagType.Trim.ToUpper
                    Case "SPEED"
                        incrementer = 0.1
                    Case Else
                        incrementer = 0.01
                End Select

                validLimits = New ArrayList
                validLimits.Add(NLMP)

                Select Case isMPDescending
                    Case True
                        For i = NLMP To NRMP Step incrementer
                            J = K + incrementer
                            If J >= NRMP Then
                                Exit For
                            End If
                            If Not validLimits.Contains(J) Then
                                validLimits.Add(J)
                            End If
                            K = J
                        Next
                    Case Else
                        For i = NRMP To NLMP Step incrementer
                            J = K + incrementer
                            If J >= NLMP Then
                                Exit For
                            End If
                            If Not validLimits.Contains(J) Then
                                validLimits.Add(J)
                            End If
                            K = J
                        Next

                End Select
                validLimits.Add(NRMP)

                If validLimits.Contains(OldLMP) And validLimits.Contains(OldRMP) Then
                    returnValue = True
                End If

                If Not returnValue Then
                    Select Case TagType.Trim.ToUpper
                        Case "SPEED"
                            If FromMP >= 0 And ToMP >= 0 Then
                                If validLimits.Contains(FromMP) And validLimits.Contains(ToMP) Then
                                    returnValue = True
                                End If
                            End If
                        Case "XING"
                            If FromMP >= 0 Then
                                If validLimits.Contains(FromMP) Then
                                    returnValue = True
                                End If

                            End If
                    End Select
                End If

                Return returnValue

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                validLimits = New ArrayList
            End Try
        End Function

