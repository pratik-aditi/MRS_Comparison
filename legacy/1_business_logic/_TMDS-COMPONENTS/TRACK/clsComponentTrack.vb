            End Try
        End Sub

        ''' <summary>
        ''' DoIssueLicenseDTC
        ''' </summary>
        ''' <param name="e">Mouse Event</param>
        Private Sub DoIssueLicenseDTC(e As MouseEventArgs)
            Try
                Dim theSfa As TMDS.TrackAuthority.SFAuthority
                Dim newAuthority As frmSingleAuthorityFormMRS
                Dim cancelTheLicense As Boolean
                TrackEventLog("DoIssueLicenseDTC")
                If optEnableMRSSpecificOptions AndAlso OStype AndAlso Mid(AuthorityType, 1, 3).Equals("TWC") Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionClear()
                    gTrackSelectionCollection.Clear()
                    TrackEventLog("DoIssueLicenseDTC:SELECTED START/END TRACK(WARRANT) OSTYPE -  FAILED")
                    ClearSystemVariables()
                    Exit Sub
                End If
                If gBeginTrackSelect Is Nothing AndAlso gCreateLicenseTrain IsNot Nothing Then
                    theSfa = TMDS.SystemUtilities.FetchData.GetLastTWCAuthority(gCreateLicenseTrain.Name)
                    If theSfa IsNot Nothing Then
                        TrackEventLog("DoIssueLicenseDTC:SFANumber=" & theSfa.AuthorityNumber.ToString)
                        If Not IsEntryTrackValidForTWCIssue(Me, theSfa) Then
                            TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    Else
                        TrackEventLog("DoIssueLicenseDTC:SFA is nothing")
                    End If
                End If
                If gBeginTrackSelect Is Nothing Then
                    gBeginTrackSelect = Me
                    If Not optAllowNonTWC Then
                        If Not Mid(gBeginTrackSelect.AuthorityType, 1, 3).Equals("TWC") Then
                            TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    End If
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionAdd(gBeginTrackSelect)
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionTWC.Enabled = True
                    If Not Mid(AuthorityType, 1, 3).Equals("TWC") Then
                        ExtendOSComponents(gTrackSelectionCollection)
                    End If
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()
                    gFirstTrackSelectionMousePoint = e.X
                    TrackEventLog("DoIssueLicenseDTC:SELECTED BEGINNING TRACK(WARRANT)")
                ElseIf gBeginTrackSelect Is Me Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionClear()
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionTWC.Enabled = True
                    gTrackSelectionCollection.Clear()
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionAdd(gBeginTrackSelect)
                    If Not Mid(AuthorityType, 1, 3).Equals("TWC") Then
                        ExtendOSComponents(gTrackSelectionCollection)
                    End If
                    gEndTrackSelect = Me
                    If gSwitchPointMonitoringExists Then
                        AddTouchingSwitchPointMonitorSwitches(gTrackSelectionCollection)
                    End If
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()
                    TrackEventLog("DoIssueLicenseDTC:SELECTED ENDING TRACK(WARRANT)")
                    SystemForms.MySystemForms.frmMainMDI.ShowLimits()
                Else
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionClear()
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionTWC.Enabled = True
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionAdd(gBeginTrackSelect)
                    gBeginTrackSelect.ExtendOSComponents(gTrackSelectionCollection)
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()
                    gEndTrackSelect = Me
                    TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()
                    If Not TMDS.SystemForms.MySystemForms.frmMainMDI.SearchRouteForEndOfCTCTrack(True) Then
                        gTrackSelectionCollection.Clear()
                        TrackEventLog("DoIssueLicenseDTC:SELECTED ENDING TRACK(WARRANT) FAILED")
                        ClearSystemVariables()
                    Else
                        If Not Mid(AuthorityType, 1, 3).Equals("TWC") Then
                            ExtendOSComponents(gTrackSelectionCollection)
                        End If
                        TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionReset()
                        'ADDED THIS CONDITION BASED ON MRS318
                        If optEnableMRSSpecificOptions AndAlso Not CheckIfNextTrackIsValid() Then
                            TMDS.SystemForms.MySystemForms.frmMainMDI.TWCSelectionClear()
                            gTrackSelectionCollection.Clear()
                            TrackEventLog("DoIssueLicenseDTC:SELECTED ENDING TRACK(WARRANT) FAILED")
                            ClearSystemVariables()
                            Exit Sub
                        End If
                        newAuthority = New frmSingleAuthorityFormMRS
                        cancelTheLicense = True
                        If gCreateLicenseTrain Is Nothing Then
                            TrackEventLog("DoIssueLicenseDTC:NO TRAIN FOUND")
                            ClearSystemVariables()
                            Exit Sub
                        Else
                            TrackEventLog($"DoIssueLicenseDTC:Train={gCreateLicenseTrain.Name}")
                        End If
                        If newAuthority.BuildAuthority(gSearchDirection, gTrackSelectionCollection, gCreateLicenseTrain) Then
                            newAuthority.Owner = ParentForm
                            newAuthority.Location = gCreateLicenseTrain.myTrack.CurrentDrawingForm.myLaunchPoint
                            newAuthority.ShowDialog()
                            TMDS.NetworkMessages.CadMessages.SendSingleAuthorityEventForWabtecOne(newAuthority.mySFAuthority, "CREATE", "AUTHORITY-ACTIVATED")
                            If Not newAuthority.CancelLicense Then
                                cancelTheLicense = False
                            End If
                        End If
                        newAuthority.Dispose()
                        If Not cancelTheLicense Then
                            Dim theSignal As Signal = GetSignalForRouting(gTrackSelectionCollection)
                            If theSignal IsNot Nothing Then
                                Dim theEntryTrack As Track = GetEntryTrack(theSignal)
                                If theEntryTrack IsNot Nothing Then
                                    gEntryTrack = theEntryTrack
                                    Dim theExitTrack As Track = TMDS.SystemUtilities.FetchData.FindLastTrackInList(gTrackSelectionCollection)
                                    If theExitTrack IsNot Nothing Then
                                        theExitTrack.DoEntExit()
                                        TMDS.SystemForms.MySystemForms.frmMainMDI.ProcessEnterExitSelection()
                                    End If
                                End If
                            End If
                        End If
                        ClearSystemVariables()
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub DoQuickCancelRoute(Optional ByVal theSignal As Signal = Nothing, Optional ByVal theTrain As TrainID = Nothing)
            Dim StopSignalFound As Boolean
            Dim LoopControl As Integer
            Dim NextComp As Object
            Dim SignalList As New ArrayList
            Try
                Dim trn As TrainID = Nothing
                If IsNothing(theTrain) Then
                    trn = Me.TrainIDs.Item(0)
                Else
                    trn = theTrain
                End If
                If IsNothing(trn) Then Exit Sub
                gCreateLicenseTrain = trn
                Dim FirstSignal As Signal = Nothing
                If IsNothing(theSignal) Then
                    FirstSignal = trn.FindStartingSignal
                Else
                    FirstSignal = theSignal
                End If
                If IsNothing(FirstSignal) Then Exit Sub
                gCancellingStartSignalForLicense = FirstSignal

                If FirstSignal.SignalCtlStatus = Signal.CtlStatus.RequestedStop Or FirstSignal.SignalCtlStatus = Signal.CtlStatus.RequestingStop Then Exit Sub
                Dim theDirection As String = "RIGHT"
                NextComp = FirstSignal.SignalRouteCollection.Item(FirstSignal.SignalRouteCollection.Count - 1)
                SignalList.Add(FirstSignal)
                If FirstSignal.ComponentType = "L" Then theDirection = "LEFT"
                Do While Not StopSignalFound

                    If theDirection = "RIGHT" Then
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        If NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.SignalCtlStatus = Signal.CtlStatus.RequestedStop Or sig.SignalCtlStatus = Signal.CtlStatus.RequestingStop Then
                                Exit Do
                            Else
                                SignalList.Add(sig)
                                NextComp = sig.SignalRouteCollection.Item(sig.SignalRouteCollection.Count - 1)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If
                    Else
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        If NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.SignalCtlStatus = Signal.CtlStatus.RequestedStop Or sig.SignalCtlStatus = Signal.CtlStatus.RequestingStop Then
                                Exit Do
                            Else
                                SignalList.Add(sig)
                                NextComp = sig.SignalRouteCollection.Item(sig.SignalRouteCollection.Count - 1)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                    End If

                    If LoopControl > 500 Then
                        Exit Sub
                    End If
                    LoopControl += 1
                Loop

                Dim s As Signal
                Dim LastSignal As Signal = SignalList(SignalList.Count - 1)
                If Not IsNothing(LastSignal) Then
                    If Not CheckToCancelLicenseInNonSignalTrack(LastSignal, trn) Then
                        Exit Sub
                    End If
                End If

                For Each s In SignalList
                    s.myControlPoint.FlasherMode(True)
                    s.ControlSignalToStop(False, True)
                Next

                gSendCTC = True
                TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curSend)

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function GetEntryTrack(ByVal theSignal As Signal) As Track
            Try
                Dim theTrack As Track
                If theSignal.ComponentType = "L" Then
                    theTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(theSignal.RightLink)
                Else
                    theTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(theSignal.LeftLink)
                End If
                Return theTrack
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function GetSignalForRouting(ByVal RouteList As ArrayList) As Signal
            Try
                Dim comp As Object
                Dim theSignal As Signal = Nothing
                For Each comp In RouteList
                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                        Dim trk As Track = CType(comp, Track)
                        If gSearchDirection = "LEFT" Then
                            theSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(trk.LeftLink)
                            If Not IsNothing(theSignal) Then
                                Return theSignal
                            End If
                        Else
                            theSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(trk.RightLink)
                            If Not IsNothing(theSignal) Then
                                Return theSignal
                            End If
                        End If
                    End If
                Next
                Return theSignal
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function CheckToCancelLicenseInNonSignalTrack(ByVal theSignal As Signal, ByVal theTrain As TrainID) As Boolean
            Try
                Dim TrackFoundInTWC As Boolean
                Dim theTrack As Track = Nothing
                Dim LoopControl As Integer

                Dim NextComp As Object = theSignal.SignalRouteCollection.Item(theSignal.SignalRouteCollection.Count - 1)
                Do While Not TrackFoundInTWC
                    If theSignal.ComponentType = "R" Then
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(NextComp, Track)
                            If Mid(trk.AuthorityType, 1, 3) = "TWC" Then
                                theTrack = trk
                                Exit Do
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                        End If
                    Else
                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        If NextComp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(NextComp, Track)
                            If Mid(trk.AuthorityType, 1, 3) = "TWC" Then
                                theTrack = trk
                                Exit Do
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                        End If
                    End If

                    If LoopControl > 50 Then
                        Exit Do
                    End If
                    LoopControl += 1
                Loop

                Dim ReleaseCompleted As Boolean = True
                If Not IsNothing(theTrack) Then
                    If theTrack.TrackAuthorities.Count > 0 Then
                        Dim sfa As SFAuthority
                        For Each sfa In theTrack.TrackAuthorities
                            If sfa.TrainSymbol = theTrain.Name Then
                                SystemForms.MySystemForms.frmReportClr = New frmReportClear()
                                SystemForms.MySystemForms.frmReportClr.Location = Me.CurrentDrawingForm.myLaunchPoint
                                SystemForms.MySystemForms.frmReportClr.LoadForm()
                                SystemForms.MySystemForms.frmReportClr.SimpleReportClearEvent(sfa)
                                If SystemForms.MySystemForms.frmReportClr.CancelledTheRelease Then
                                    ReleaseCompleted = False
                                End If
                                SystemForms.MySystemForms.frmReportClr.Dispose()
                                SystemForms.MySystemForms.frmReportClr = Nothing
                                Exit For
                            End If
                        Next
                    End If
                End If

                Return ReleaseCompleted
            Catch ex As Exception
                SystemException(ex.ToString)
                Return True
            End Try
        End Function

        Private Function CheckIfNextTrackIsValid() As Boolean
            Dim SFA As TMDS.TrackAuthority.SFAuthority = Nothing
            Dim SfaFp As Object
            Dim SfaFlipFlop As Boolean = False
            Try
                If gEndTrackSelect Is Nothing Then Return True
                If gSearchDirection Is Nothing Then Return True
                If Not String.IsNullOrEmpty(gSearchDirection) AndAlso gSearchDirection.Trim <> "" Then
                    Dim trk As Track = Nothing
                    Dim Comp As Object = Nothing
                    Select Case gSearchDirection
                        Case "LEFT"
                            Comp = FindCompFromGUID(gEndTrackSelect.LeftLink)
                        Case Else
                            Comp = FindCompFromGUID(gEndTrackSelect.RightLink)
                    End Select
                    For i As Integer = 0 To 5
                        If Comp Is Nothing Then Return True
                        Select Case Comp.GetType.ToString
                            Case gTrackComponentName
                                trk = TryCast(Comp, Track)
                                If trk IsNot Nothing Then
                                    If Mid(trk.AuthorityType, 1, 3) = "CTC" Then
                                        If trk.TrafficDirection IsNot Nothing AndAlso Not String.IsNullOrEmpty(trk.TrafficDirection) AndAlso trk.TrafficDirection.Trim <> "" AndAlso trk.TrafficDirection <> gSearchDirection Then
                                            Return False
                                        Else
                                            Exit For
                                        End If
                                    ElseIf Mid(trk.AuthorityType, 1, 3) = "TWC" AndAlso trk.NonTransverable Then
                                        Return True
                                    ElseIf Mid(trk.AuthorityType, 1, 3) = "TWC" Then
                                        If trk.TrackAuthorities IsNot Nothing AndAlso trk.TrackAuthorities.Count > 0 AndAlso gCreateLicenseTrain IsNot Nothing Then
                                            For Each SFA In trk.TrackAuthorities

                                                'Check if within the components there are any that are FlipFlop
                                                For Each SfaFp In SFA.Components
                                                    If SfaFp.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                                                        SfaFlipFlop = True
                                                        Me.TrackEventLog("CheckIfNextTrackIsValid: Found FlipFlop")
                                                        Exit For
                                                    End If
                                                Next

                                                If SFA.GetType.ToString = gSFAComponentName Then
                                                    If SFA.TrainSymbol.Trim.ToUpper <> gCreateLicenseTrain.Name.Trim.ToUpper AndAlso (SFA.Direction <> gSearchDirection) Then
                                                        If SfaFlipFlop = False Then
                                                            Return False
                                                        End If
                                                    End If
                                                End If
                                            Next
                                            Exit For
                                        End If

                                    Else
                                        Exit For
                                    End If
                                Else
                                    Exit For
                                End If
                            Case Else
                                Select Case gSearchDirection
                                    Case "LEFT"
                                        Comp = FindCompFromGUID(Comp.LeftLink)
                                    Case Else
                                        Comp = FindCompFromGUID(Comp.RightLink)
                                End Select
                        End Select
                    Next
                End If
                Return True
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                SFA = Nothing
                SfaFp = Nothing
                SfaFlipFlop = Nothing
            End Try

        End Function

