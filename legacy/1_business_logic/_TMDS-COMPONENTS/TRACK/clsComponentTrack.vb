        Public Function CheckForFoulingPointOccunpancy(ByVal tz As TrackZone) As Boolean
            Try
                Dim trk As Track
                For Each trk In tz.TrackList
                    If Not IsNothing(trk.OsComponentCollection) Then
                        Dim comp As Object
                        For Each comp In trk.OsComponentCollection
                            If comp.GetType.ToString = gTrackComponentName Then
                                Dim trkToChk As Track = CType(comp, Track)
                                If trkToChk.FoulingTrackSPMS And trkToChk.Occuppied And Not trkToChk Is Me Then
                                    Return True
                                End If
                            End If
                        Next
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Sub CheckToAcknowledgeAlert()
            Dim al As Alert
            'tz.ZoneName & "|" & tz.ZoneUID.ToString & "|" & BeginLimit & " TO " & EndLimit & "|" & auth.IssueTo & "|" & auth.AuthorityUID

            Dim RemoveList As New ArrayList
            Try
                SyncLock TMDS.GlobalDeclarations.gSystemAlertList
                    For Each al In TMDS.GlobalDeclarations.gSystemAlertList
                        Select Case al.TypeOfAlert
                            Case ManagementClasses.Alert.AlertType.TrackZone
                                Dim data() As String = al.AlertData.Split("|")
                                If data.Length >= 5 Then
                                    If data(0) = Me.TrackZoneReference.ZoneName Then
                                        Me.TrackZoneReference.OccupiedTrainAuthUIDList = New ArrayList
                                        al.AlertAcknowledged = True
                                        Dim Message As String = "TIWS ALERT WAS ACKNOWLEDGED BY SYSTEM FROM OFF TRACK INDICATION FOR TRACK ZONE: " & Me.TrackZoneReference.ZoneName
                                        al.AlertAckedByPerson = Message
                                        TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                                        gSystemAlertExists = False
                                        Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al.AlertGUID)
                                        SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                            TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                        End SyncLock
                                        RemoveList.Add(al)
                                    End If
                                End If
                            Case ManagementClasses.Alert.AlertType.FoulingPoint
                                Dim data() As String = al.AlertData.Split("|")
                                If data.Length >= 5 Then
                                    If data(1) = Me.Name And Me.FoulingTrackSPMS Then
                                        Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSTrackLeg(Me)
                                        If Not IsNothing(sw) AndAlso sw.Name = data(0) Then
                                            al.AlertAcknowledged = True
                                            Dim Message As String = "FOULING POINT INDICATION ALERT WAS ACKNOWLEDGED BY SYSTEM FROM OFF TRACK INDICATION FOR FOULING POINT: " & Me.TrackZoneReference.ZoneName
                                            al.AlertAckedByPerson = Message
                                            TMDS.SystemUtilities.Utilities.SystemEvent(Message)
                                            gSystemAlertExists = False
                                            Dim SummItem As New SummaryItem("ALERT", "ACKNOWLEDGE", al.AlertGUID)
                                            SyncLock TMDS.GlobalDeclarations.gSummaryAlertQueue.SyncRoot
                                                TMDS.GlobalDeclarations.gSummaryAlertQueue.Enqueue(SummItem)
                                            End SyncLock
                                            RemoveList.Add(al)
                                        End If
                                    End If
                                End If
                        End Select
                    Next
                    For Each al In RemoveList
                        TMDS.GlobalDeclarations.gSystemAlertList.Remove(al)
                    Next
                End SyncLock
                Me.CheckForAbuttingZonesOccupancy()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

