        Private Sub AutoClearRoutesRight(ByVal trn As TrainID, ByVal EventTrainMoveOnOS As Boolean)
            Try
                Dim LoopControl As Integer
                Dim ExitSignal As Signal
                Dim SignalClearAheadCount As Integer
                Dim NextComp As Object = Nothing
                Dim LastRightSignal As Signal = Nothing

                If EventTrainMoveOnOS Then
                    ExitSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.RightLink)
                    If IsNothing(ExitSignal) Then Exit Sub
                    SignalClearAheadCount = ExitSignal.SignalClearAheadCount
                    If SignalClearAheadCount = 0 Then Exit Sub
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(ExitSignal.RightLink)
                Else
                    SignalClearAheadCount = 2
                End If



                While SignalClearAheadCount < 0
                    If IsNothing(NextComp) Then Exit Sub
                    Dim CompType As String = NextComp.GetType.ToString

                    Select Case CompType

                        Case "TMDS.TrackComponents.Track"
                            Dim tk As Track = CType(NextComp, Track)
                            If tk.Occuppied And tk.TrafficDirection <> "RIGHT" Then
                                Exit Sub
                            End If

                            If tk.OStype And tk.Occuppied And tk.TrafficDirection = "RIGHT" Then

                            End If

                        Case "TMDS.SwitchComponents.Switch"
                            Dim sw As Switch = CType(NextComp, Switch)

                        Case "TMDS.SignalComponents.Signal"
                            Dim sg As Signal = CType(NextComp, Signal)
                            If sg.ComponentType = "R" Then
                                LastRightSignal = sg
                                SignalClearAheadCount -= 1
                            End If


                        Case "TMDS.TrackOtherComponents.RRXING"
                            Dim rr As RRXING = CType(NextComp, RRXING)

                        Case "TMDS.TrackOtherComponents.FlipFlop"
                            Dim ff As FlipFlop = CType(NextComp, FlipFlop)


                    End Select


                    If LoopControl > 100 Then
                        Exit Sub
                    Else
                        LoopControl += 1
                    End If
                End While


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

