        Sub MoveTrainIDPlaceManual(trn As TrainID, PreviousTrack As Track, LogOs As Boolean,
        ByRef dbConnection As OleDbConnection, Optional NullifyTrainCommand As Boolean = False,
        Optional SendManualMoveMessage As Boolean = False, Optional OverRideTimeStamp As String = Nothing,
        Optional LinkTrainMovement As Boolean = False, Optional ShadowModeEvent As Boolean = False)
            Try
                Dim CompCollection As ArrayList = Me.OsComponentCollection
                Dim CompToCheck As Object
                Dim NewTrackRef As Track
                If trn Is Nothing Then Exit Sub
                If Me Is PreviousTrack Then Exit Sub
                Dim startTime As Date = Now
                If trn.MyMoveInitiated Then
                    Do Until Not trn.MyMoveInitiated
                        If Now.AddSeconds(-5) > startTime Then
                            Exit Do
                        End If
                    Loop
                End If
                trn.MyMoveInitiated = True
                trn.MyLastTrack = PreviousTrack
                NewTrackRef = Me
                TrackEventLog($"TRAIN-TRACKING:MANUAL TRAIN MOVE EVENT  <NEW TRACK={NewTrackRef.GUID}> <OLD TRACK ={PreviousTrack.GUID}> <TRAINID:{trn.Name}>")
                If Not CompCollection Is Nothing Then
                    For Each CompToCheck In CompCollection
                        If TypeOf CompToCheck Is Track Then
                            If CompToCheck.TrainIDPlace And Not CompToCheck.NonTransverable Then
                                NewTrackRef = CompToCheck
                            End If
                        End If
                        If Not Me.Indicating Then
                            CompToCheck.Occuppied = True
                            CompToCheck.UpdateStatus()
                        End If
                    Next
                End If
                If Not optRailRoadName.Equals("BNSF", StringComparison.InvariantCultureIgnoreCase) Then
                    Dim LikeComponents As ArrayList = FindLikeComponents(NewTrackRef)
                    For Each CompToCheck In LikeComponents
                        If Not Indicating Then
                            CompToCheck.Occuppied = True
                            CompToCheck.UpdateStatus()
                        End If
                    Next
                End If
                ' SyncLock NewTrackRef
                If TrainIDs.Count > 0 Or LinkTrainMovement Then
                    If Not NewTrackRef.TrainIDs.Contains(trn) Then
                        'NewTrackRef.TrainIDs.Insert(0, trn)
                        NewTrackRef.TrainIDs.Add(trn)
                        TrackEventLog($"TRAIN-TRACKING:MANUAL TRAIN MOVE EVENT - ADD TO TRACK: GUID={NewTrackRef.GUID}TRAINID:{trn.Name}")
                    End If
                Else
                    If optEnableCPCheckOnTrainMove Then
                        If NewTrackRef.TrainIDs IsNot Nothing AndAlso NewTrackRef.TrainIDs.Count > 0 Then
                            If Not NewTrackRef.TrainIDs.Contains(trn) Then
                                'NewTrackRef.TrainIDs.Insert(0, trn)
                                NewTrackRef.TrainIDs.Add(trn)
                                TrackEventLog($"TRAIN-TRACKING:MANUAL TRAIN MOVE EVENT - INSERT TO TRACK: GUID={NewTrackRef.GUID}TRAINID:{trn.Name}")
                            End If
                        Else
                            If Not NewTrackRef.TrainIDs.Contains(trn) Then
                                NewTrackRef.TrainIDs.Insert(0, trn)
                                TrackEventLog($"TRAIN-TRACKING:MANUAL TRAIN MOVE EVENT - INSERT TO TRACK: GUID={NewTrackRef.GUID}TRAINID:{trn.Name}")
                            End If
                        End If
                    Else
                        If Not NewTrackRef.TrainIDs.Contains(trn) Then
                            NewTrackRef.TrainIDs.Insert(0, trn)
                            TrackEventLog($"TRAIN-TRACKING:MANUAL TRAIN MOVE EVENT - INSERT TO TRACK: GUID={NewTrackRef.GUID}TRAINID:{trn.Name}")
                        End If
                    End If

                End If
                If Not NewTrackRef.TrafficDirection.Equals("") Then
                    trn.TrackingDirection = NewTrackRef.TrafficDirection
                End If

                'End SyncLock

                If Not Indicating Then
                    NewTrackRef.Occuppied = True
                ElseIf NewTrackRef.SimulateMode And trn.SimulateMode Then
                    NewTrackRef.Ind(0).BitState = True
                    If trn.Direction = optDirectionWest Or trn.Direction = optDirectionNorth Then
                        NewTrackRef.TrafficDirection = "RIGHT"
                    ElseIf trn.Direction = optDirectionWest Or trn.Direction = optDirectionSouth Then
                        NewTrackRef.TrafficDirection = "LEFT"
                    End If
                    NewTrackRef.ApplyIndicationChange()
                    NewTrackRef.UpdateStatus()
                End If
                trn.myTrack = NewTrackRef
                'Update the previous track graphically
                'SyncLock PreviousTrack
                'PreviousTrack.TrainIDs.Remove(trn)
                If Not PreviousTrack Is NewTrackRef Then
                    If PreviousTrack.TrainIDs.Count > 0 Then
                        'PreviousTrack.TrainIDs.RemoveAt(0)
                        PreviousTrack.TrainIDs.Remove(trn)
                        PreviousTrack.InitTrainDisplay()
                        PreviousTrack.InvalidateTrainID()
                        PreviousTrack.InvalidateTrainIDMessageDisplay()

                        TrackEventLog($"TRAIN-TRACKING:MANUAL TRAIN MOVE EVENT - REMOVE FROM TRACK: GUID={PreviousTrack.GUID}TRAINID:{trn.Name}")
                    Else
                        Dim RealTrack As Track = FindTrackWithTrain(trn.TrainGUID, NewTrackRef)
                        If Not IsNothing(RealTrack) Then
                            PreviousTrack = RealTrack
                            PreviousTrack.TrainIDs.Remove(trn)
                            PreviousTrack.InitTrainDisplay()
                            PreviousTrack.InvalidateTrainID()
                        End If
                    End If

                    If Not PreviousTrack.Indicating And PreviousTrack.TrainIDs.Count = 0 And PreviousTrack.MOWIDs.Count = 0 Then
                        PreviousTrack.TrafficDirection = ""
                        PreviousTrack.Occuppied = False
                        PreviousTrack.SignalStatOnMe = SignalStatus.SignalAtStop
                        Dim LikeComponentsForPreviousTrack As ArrayList = FindLikeComponents(PreviousTrack)
                        For Each CompToCheck In LikeComponentsForPreviousTrack
                            If Not PreviousTrack.Indicating Then
                                If optRailRoadName.Equals("BNSF", StringComparison.InvariantCultureIgnoreCase) Then
                                    If Not CompToCheck Is NewTrackRef Then
                                        CompToCheck.TrafficDirection = ""
                                        CompToCheck.Occuppied = False
                                        CompToCheck.UpdateStatus()
                                    End If
                                Else
                                    CompToCheck.TrafficDirection = ""
                                    CompToCheck.Occuppied = False
                                    CompToCheck.UpdateStatus()
                                End If
                            End If
                        Next

                    ElseIf PreviousTrack.SimulateMode Then
                        If Not IsNothing(PreviousTrack.Ind(0)) Then
                            PreviousTrack.Ind(0).BitState = False
                            PreviousTrack.ApplyIndicationChange()
                        End If
                    End If

                    If AuthorityType.Equals("TWC", StringComparison.InvariantCultureIgnoreCase) AndAlso
                    optEnableTrainPositionReportingForMRS AndAlso
                    ((PreviousTrack.TrainIDPlace And PreviousTrack.OSReporting) OrElse PreviousTrack.IsPositionReportingTrack) Then
                        PreviousTrack.DoCheckPerformReportingForMRS()
                    End If

                    PreviousTrack.UpdateStatus()

                    CompCollection = PreviousTrack.OsComponentCollection
                    CompToCheck = Nothing
                    If Not CompCollection Is Nothing Then
                        For Each CompToCheck In CompCollection
                            'SyncLock CompToCheck
                            If Not CompToCheck.Indicating Then
                                CompToCheck.TrafficDirection = ""
                                CompToCheck.Occuppied = False
                            Else
                                If TypeOf CompToCheck Is Track Then
                                    If Not CompToCheck.ind(0) Is Nothing And CompToCheck.SimulateMode Then
                                        CompToCheck.Ind(0).BitState = False
                                        CompToCheck.TrafficDirection = ""
                                        CompToCheck.ApplyIndicationChange()
                                    End If
                                ElseIf TypeOf CompToCheck Is Switch Then
                                    Dim sw As Switch = CType(CompToCheck, Switch)
                                    If Mid(sw.AuthorityType, 1, 3).Equals("TWC", StringComparison.InvariantCultureIgnoreCase) Then
                                        sw.TrafficDirection = ""
                                        sw.Occuppied = False
                                    End If
                                End If
                            End If
                            CompToCheck.UpdateStatus()
                            'End SyncLock
                        Next
                    End If
                End If
                Dim LeftTrack As Track = PreviousTrack.CheckForTrainToLeft()
                If Not IsNothing(LeftTrack) Then
                    LeftTrack.InitTrainDisplay()
                End If
                '  End SyncLock

                ' SyncLock NewTrackRef
                NewTrackRef.InitTrainDisplay()
                NewTrackRef.InvalidateTrainID()
                '  End SyncLock
                If Not NewTrackRef.Indicating Then
                    NewTrackRef.UpdateStatus()
                End If

                If ShadowModeEvent Then Exit Sub

                Dim PerformOtherTrainIDMoveEvents As New DoTrainIDMoveEvents(AddressOf PerformTrainIDMoveEvents)
                PerformOtherTrainIDMoveEvents.BeginInvoke(PreviousTrack, NewTrackRef, trn, LogOs, "D", True, Nothing, NullifyTrainCommand, SendManualMoveMessage, OverRideTimeStamp, Nothing, Nothing)

                If trn.TrainIsLinked Then
                    DoMoveLinkTrainIDPlaceManual(trn, LogOs, dbConnection)
                End If

                If optEnableMRSSpecificOptions Then
                    PerformReleaseOfPassStopSignal(trn, PreviousTrack)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                trn.MyMoveInitiated = False
            End Try
        End Sub

        ''' <summary>
        ''' PerformReleaseOfPassStopSignal
        ''' </summary>
        ''' <param name="pTrain"></param>
        ''' <param name="pPreviousTrack"></param>
        Public Sub PerformReleaseOfPassStopSignal(ByVal pTrain As TrainID, ByVal pPreviousTrack As Track)

            Try
                If optEnableAutomaticRemovalOfPRSEMT AndAlso Not pTrain.GeoFenceEnabled Then

                    TrackEventLog("PerformReleaseOfPassStopSignal:Train=" & pTrain.Name & ":PreviousTrack=" & pPreviousTrack.Name)

                    Dim SplAuth As TrackAuthority.OtherSpecialAuthorityType
                    Dim SplAuthCollection As New ArrayList

                    For Each SplAuth In pPreviousTrack.OtherSplAuthorities
                        If SplAuth.TrainSymbol = pTrain.Name Then
                            If Not SplAuthCollection.Contains(SplAuth) Then SplAuthCollection.Add(SplAuth)
                        End If
                    Next

                    If SplAuthCollection IsNot Nothing AndAlso SplAuthCollection.Count > 0 Then

                        Dim frmMessage As New frmMessageBox
                        Dim MessageList As New ArrayList
                        Dim LaunchPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Width / 2 - 100, 200)

                        MessageList.Add(optSystemMessageString15 & Space(1) & pTrain.Name)
                        MessageList.Add("")
                        MessageList.Add(optSystemMessageString16)
                        frmMessage.SetMessage(MessageList, optRollUpAuthorityString12, True, LaunchPoint, Nothing, False, False, Nothing, Nothing, False, False, False, optUseReadRepeatMessageBoxOnAuthorityRelease)

                        frmMessage.ShowDialog()

                        If frmMessage.FormFeedBack = 6 Then

                            TrackEventLog("PerformReleaseOfPassStopSignal:Clicked in yes:Train=" & pTrain.Name)

                            If Me.OtherSplAuthorities IsNot Nothing Then
                                For Each SplAuth In SplAuthCollection
                                    If SplAuth.AuthorityType = "PASS-RED-SIGNAL" Then
                                        pTrain.CancelPassRedSignalAuthority(True, False)
                                    End If
                                Next
                            End If

                        Else

                            TrackEventLog("PerformReleaseOfPassStopSignal:Clicked in no:Train=" & pTrain.Name)

                        End If

                    End If

                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Find Like Components
        ''' </summary>
        ''' <param name="pTrack"></param>
        ''' <returns></returns>
        Private Function FindLikeComponents(ByVal pTrack As Track) As ArrayList
            Dim theList As New ArrayList
            Dim trk As Track
            Dim comp As Object
            Dim leftTrack As Track
            Dim rightTrack As Track
            Dim sw As Switch
            Try
                TrackEventLog("FindLikeComponents")
                For Each trk In pTrack.myControlPoint.AssignedTracks
                    If trk.Name = pTrack.Name Then
                        theList.Add(trk)
                    End If
                Next
                For Each comp In pTrack.myControlPoint.AssignedComponenets
                    If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                        sw = CType(comp, Switch)
                        If sw.TypeOfSwitch = "SPM ONLY" Then
                            leftTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.LeftLink)
                            rightTrack = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sw.RightLink)
                            If theList.Contains(leftTrack) Then
                                theList.Add(sw)
                            ElseIf theList.Contains(rightTrack) Then
                                theList.Add(sw)
                            End If
                        End If
                    End If
                Next
                Return theList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return theList
            Finally
                theList = Nothing
                trk = Nothing
                comp = Nothing
                leftTrack = Nothing
                rightTrack = Nothing
                sw = Nothing
            End Try
        End Function

        Overloads Sub MoveTrainIDPlace(ByVal trn As TrainID, ByVal PreviousTrack As Track, ByVal LogOs As Boolean,
                                       ByRef dbConnection As OleDbConnection, Optional ByVal ShadowModeEvent As Boolean = False)
            Try
                Dim CompCollection As ArrayList = Nothing
                Dim CompToCheck As Object = Nothing
                Dim NewTrackRef As Track = Nothing
                'Me.TrackEvent("TRAIN-TRACKING:BEGIN-MoveTrainIDPlace1:" & Me.GUID & " TRAINID:" & trn.Name)

                If trn Is Nothing Then Exit Sub
                If Me.MOWIDs.Count <> 0 Then Exit Sub

                If Me Is PreviousTrack Then Exit Sub


                Dim startTime As Date = Now
                If trn.MyMoveInitiated Then
                    Do Until Not trn.MyMoveInitiated
                        If Now.AddSeconds(-5) > startTime Then
                            Exit Do
                        End If
                    Loop
                End If
                trn.MyMoveInitiated = True


                trn.MyLastTrack = PreviousTrack
                NewTrackRef = Me
                If Not CompCollection Is Nothing Then
                    For Each CompToCheck In CompCollection
                        If CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If CompToCheck.RightAltLink <> 0 Then
                                NewTrackRef = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CompToCheck.LeftLink)
                            Else
                                NewTrackRef = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CompToCheck.RightLink)
                            End If
                            Exit For 'added this as a result of multiple switches in the collection was misplacing the ID on the wrong link
                        End If

                        If Not Me.Indicating Then
                            CompToCheck.Occuppied = True
                            CompToCheck.UpdateStatus()
                        End If
                    Next

                End If

                'SyncLock NewTrackRef
                If TrainIDs.Count > 0 Then
                    If Not NewTrackRef.TrainIDs.Contains(trn) Then
                        NewTrackRef.TrainIDs.Add(trn)
                        Dim train As TrainID
                        For Each train In NewTrackRef.TrainIDs
                            'TrackEvent("TRAIN-TRACKING:TRAIN ID IN TRACK QUEUE:" & train.Name)
                        Next
                        'TrackEvent("TRAIN-TRACKING:TRACK'S TRAIN ID LIST COUNT:" & NewTrackRef.TrainIDs.Count.ToString)
                        'TrackEvent("TRAIN-TRACKING:THIS TRAIN ID LIST POSITION:" & NewTrackRef.TrainIDs.IndexOf(trn).ToString)
                        'TrackEvent("TRAIN-TRACKING:TRAIN ID MOVE EVENT -- ADD TO TRACK: GUID=" & NewTrackRef.GUID.ToString & "TRAINID:" & trn.Name)
                    End If
                Else
                    If Not NewTrackRef.TrainIDs.Contains(trn) Then
                        NewTrackRef.TrainIDs.Insert(0, trn)
                        TrackEventLog("TRAIN-TRACKING:TRAIN MOVE EVENT - INSERT TO TRACK: GUID=" & NewTrackRef.GUID.ToString & " TRAINID:" & trn.Name)
                    End If
                End If
                If NewTrackRef.TrafficDirection <> "" Then
                    trn.TrackingDirection = NewTrackRef.TrafficDirection
                End If
                'End SyncLock

                If Not Me.Indicating Then
                    NewTrackRef.Occuppied = True
                    If NewTrackRef.OStype Then
                        If Not IsNothing(NewTrackRef.OsComponentCollection) Then
                            Dim comp As Object
                            For Each comp In NewTrackRef.OsComponentCollection
                                comp.Occuppied = True
                                comp.UpdateStatus()
                            Next
                        End If
                    End If
                End If

                'Update the previous track graphically
                SyncLock PreviousTrack
                    'PreviousTrack.TrainIDs.Remove(trn)
                    If PreviousTrack.TrainIDs.Count > 0 Then
                        Dim TrnPosition As Integer = TMDS.SystemUtilities.FetchData.FindTrainFromTrainStackInTrack(trn, PreviousTrack)
                        If TrnPosition <> -1 Then
                            PreviousTrack.TrainIDs.RemoveAt(TrnPosition)
                            PreviousTrack.InvalidateTrainID()
                            PreviousTrack.InitTrainDisplay()
                            PreviousTrack.InvalidateTrainIDMessageDisplay()
                            TrackEventLog("TRAIN-TRACKING:TRAIN MOVE EVENT - REMOVE FROM TRACK: GUID=" & PreviousTrack.GUID.ToString & " TRAINID:" & trn.Name)
                        End If
                    Else
                        Dim RealTrack As Track = Me.FindTrackWithTrain(trn.TrainGUID, NewTrackRef)
                        If Not IsNothing(RealTrack) Then
                            PreviousTrack = RealTrack
                            PreviousTrack.TrainIDs.Remove(trn)
                            PreviousTrack.InvalidateTrainID()
                            PreviousTrack.InitTrainDisplay()
                            PreviousTrack.InvalidateTrainIDMessageDisplay()
                            TrackEventLog("TRAIN-TRACKING1:TRAIN MOVE EVENT - REMOVE FROM TRACK: GUID=" & PreviousTrack.GUID.ToString & " TRAINID:" & trn.Name)
                        End If
                    End If
                    If Not PreviousTrack.Indicating And PreviousTrack.TrainIDs.Count = 0 Then
                        PreviousTrack.TrafficDirection = ""
                        PreviousTrack.Occuppied = False
                        PreviousTrack.SignalStatOnMe = SignalStatus.SignalAtStop
                    End If
                    PreviousTrack.UpdateStatus()
                End SyncLock

                SyncLock NewTrackRef
                    NewTrackRef.InitTrainDisplay()
                    NewTrackRef.InvalidateTrainID()
                End SyncLock
                If Not NewTrackRef.Indicating Then
                    NewTrackRef.UpdateStatus()
                End If

                'Update the previous track
                CompCollection = PreviousTrack.OsComponentCollection
                CompToCheck = Nothing
                If optEnableTrainOnAllLikeTracks AndAlso PreviousTrack IsNot Nothing Then
                    Dim LikeComponents As ArrayList = FindLikeComponents(PreviousTrack)
                    If LikeComponents IsNot Nothing AndAlso LikeComponents.Count > 0 Then
                        If CompCollection Is Nothing Then CompCollection = LikeComponents
                    End If
                    For Each CompToCheck In LikeComponents
                        If CompCollection IsNot Nothing Then
                            If Not CompCollection.Contains(CompToCheck) Then CompCollection.Add(CompToCheck)
                        End If
                    Next
                    CompToCheck = Nothing
                End If


                If Not CompCollection Is Nothing Then
                    For Each CompToCheck In CompCollection
                        SyncLock CompToCheck
                            If Not CompToCheck.Indicating Then
                                CompToCheck.TrafficDirection = ""
                                CompToCheck.Occuppied = False
                            Else
                                If CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                    If Not CompToCheck.ind(0) Is Nothing And CompToCheck.SimulateMode Then
                                        CompToCheck.Ind(0).BitState = False
                                        CompToCheck.TrafficDirection = ""
                                        CompToCheck.ApplyIndicationChange()
                                    End If
                                End If
                            End If
                            CompToCheck.UpdateStatus()
                        End SyncLock
                    Next
                End If

                If optApplyTrainSheetConfigurationForKCT Then
                    If trn.IsOkToCreateAutoArrivalEvent Then
                        Dim RR As String = ""
                        Dim ArrivalTime As Date = Now
                        If PreviousTrack IsNot Nothing Then
                            RR = PreviousTrack.RailRoadUniqueName
                        Else
                            RR = Me.RailRoadUniqueName
                        End If
                        trn.AddTrainSheetEvent("AUTO-ARRIVAL", ArrivalTime, Mid(Me.TimeZone, 1, 1), trn.GetTrainReportDataString("", 0, 0, RR), Me.myControlPoint.GUID.ToString, trn.GetIdentifyingLocationNameFromLimits, RR)
                        trn.ArrTime = ArrivalTime
                        trn.Origin = RR
                        trn.UpdateTrainArrivalDepartureIntoDatabase(True)
                    End If
                End If

                If ShadowModeEvent Then Exit Sub

                Dim PerformOtherTrainIDMoveEvents As New DoTrainIDMoveEvents(AddressOf Me.PerformTrainIDMoveEvents)
                PerformOtherTrainIDMoveEvents.BeginInvoke(PreviousTrack, NewTrackRef, trn, LogOs, "D", False, Nothing, False, False, Nothing, Nothing, Nothing)

                If trn.TrainIsLinked Then
                    Me.DoMoveLinkTrainIDPlaceManual(trn, LogOs, dbConnection)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                trn.MyMoveInitiated = False
            End Try
        End Sub

        Overloads Sub MoveTrainIDPlace(ByVal trn As TrainID, ByVal PreviousTrack As Track, ByVal LogOs As Boolean, ByRef dbConnection As OleDbConnection,
        ByVal MoveEventType As String, Optional ByVal TrackingDirection As String = Nothing, Optional ByVal FlipFlop As Boolean = False)

            Dim SplAuth As TMDS.TrackAuthority.OtherSpecialAuthorityType = Nothing
            Dim SplAuthCollection As New ArrayList
            Dim CurrentSplAuth As TMDS.TrackAuthority.OtherSpecialAuthorityType = Nothing

            Try
                Dim CompCollection As ArrayList = Nothing
                Dim CompToCheck As Object = Nothing
                Dim NewTrackRef As Track = Nothing

                'This avoid symbols duplicated in CAD
                If optEnableExtendLicenseinSplitDesk AndAlso trn.TrainRegionStatus = TrainRegionEnum.RemoteTrain Then
                    Me.TrackEventLog("TRAIN-TRACKING:MoveTrainIDPlace:Train=" & trn.Name & " is remote train")
                    Exit Sub
                End If

                Me.TrackEventLog("TRAIN-TRACKING:BEGIN-MoveTrainIDPlace:ID" & Me.GUID & "-NAME:" & Me.Name & "-TRAINID:" & trn.Name)

                If trn Is Nothing Then Exit Sub
                If Me Is PreviousTrack Then Exit Sub
                If Me.MOWIDs.Count <> 0 Then Exit Sub
                If optApplyConfigurationForKCT AndAlso trn.myTrack.myControlPoint.IsShadowMode AndAlso Not Me.myControlPoint.IsShadowMode Then
                ElseIf trn.myTrack.myControlPoint.IsShadowMode Then
                    Me.TrackEventLog("TRAIN-TRACKING:BEGIN-MoveTrainIDPlace-ShadowMode-Check:" & trn.myTrack.GUID & "-TRAINID:" & trn.Name)
                    Me.TrackEventLog("TRAIN-TRACKING:BEGIN-MoveTrainIDPlace-ShadowMode-Check-PreviousTrack:" & PreviousTrack.GUID & "-TRAINID:" & trn.Name)
                    Me.TrackEventLog("TRAIN-TRACKING:BEGIN-MoveTrainIDPlace-ShadowMode-Check-PreviousTrack-TrainCount:" & PreviousTrack.TrainIDs.Count & "-TRAINID:" & trn.Name)
                    Exit Sub
                End If
                Dim startTime As Date = Now
                If trn.MyMoveInitiated Then
                    Do Until Not trn.MyMoveInitiated
                        If Now.AddSeconds(-5) > startTime Then
                            Exit Do
                        End If
                    Loop
                End If
                trn.MyMoveInitiated = True

                trn.MyLastTrack = PreviousTrack
                If optEnableBRCSpecificChecks Then
                    NewTrackRef = GetLastIndicatingTrackInCollection(Me.TrafficDirection, Me, FlipFlop)

                    'Check If Next OS Track is Occupiued - RMT-156
                    Dim NextOccTrk As Object = Nothing
                    Dim tmpTrk As Track = Nothing
                    Dim NewTrkSig As Signal = Nothing
                    Dim tmptrkSig As Signal = Nothing
                    Try
                        If NewTrackRef IsNot Nothing Then
                            Select Case Me.TrafficDirection.Trim.ToUpper
                                Case "LEFT"
                                    NextOccTrk = FindCompFromGUID(NewTrackRef.LeftLink)
                                Case Else
                                    NextOccTrk = FindCompFromGUID(NewTrackRef.RightLink)
                            End Select
                            If NextOccTrk IsNot Nothing AndAlso NextOccTrk.GetType.ToString = gTrackComponentName AndAlso Not NextOccTrk.NonTransverable AndAlso NextOccTrk.Occuppied Then
                                tmpTrk = GetLastIndicatingTrackInCollection(Me.TrafficDirection, NextOccTrk, FlipFlop)
                                If tmpTrk IsNot Nothing Then
                                    NewTrkSig = TMDS.SystemUtilities.FetchData.FindMyControllingSignal(NewTrackRef, NewTrackRef.TrafficDirection)
                                    tmptrkSig = TMDS.SystemUtilities.FetchData.FindMyControllingSignal(tmpTrk, tmpTrk.TrafficDirection)
                                    If NewTrkSig IsNot Nothing AndAlso NewTrkSig IsNot Nothing AndAlso NewTrkSig Is tmptrkSig Then
                                        Dim PerformOtherTrainIDMoveEvents1 As New DoTrainIDMoveEvents(AddressOf Me.PerformTrainIDMoveEvents)
                                        PerformOtherTrainIDMoveEvents1.BeginInvoke(NewTrackRef, tmpTrk, trn, LogOs, MoveEventType, False, TrackingDirection, False, False, Nothing, Nothing, Nothing)

                                        If Not tmpTrk.IsRemoteTrack Then NewTrackRef = tmpTrk
                                    End If
                                End If
                            End If
                        End If
                    Catch ex As Exception
                        GetErrorDetails(ex, "MoveTrainIDPlace-1001")
                    Finally
                        NextOccTrk = Nothing
                        tmpTrk = Nothing
                        NewTrkSig = Nothing
                        tmptrkSig = Nothing
                    End Try

                    If NewTrackRef Is Nothing Then NewTrackRef = Me
                Else
                    NewTrackRef = Me
                End If

                If optEnableAutomaticRemovalOfPRSEMT AndAlso Not trn.GeoFenceEnabled Then
                    If PreviousTrack.OtherSplAuthorities IsNot Nothing AndAlso PreviousTrack.OtherSplAuthorities.Count > 0 Then

                        For Each SplAuth In PreviousTrack.OtherSplAuthorities
                            If SplAuth.TrainSymbol = trn.Name Then
                                If Not SplAuthCollection.Contains(SplAuth) Then SplAuthCollection.Add(SplAuth)
                            End If
                        Next
                        If SplAuthCollection IsNot Nothing AndAlso SplAuthCollection.Count > 0 Then
                            If Me.OtherSplAuthorities IsNot Nothing Then
                                Select Case Me.OtherSplAuthorities.Count
                                    Case 0
                                        SplAuth = Nothing
                                        For Each SplAuth In SplAuthCollection
                                            SplAuth.DoPSSPerformRelease()
                                        Next
                                    Case Else
                                        SplAuth = Nothing
                                        For Each SplAuth In SplAuthCollection
                                            If Not Me.OtherSplAuthorities.Contains(SplAuth) Then
                                                SplAuth.DoPSSPerformRelease()
                                            End If
                                        Next
                                End Select
                            End If
                        End If

                    End If
                End If

                If Not CompCollection Is Nothing Then
                    For Each CompToCheck In CompCollection
                        If CompToCheck.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                            If CompToCheck.RightAltLink <> 0 Then
                                NewTrackRef = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CompToCheck.LeftLink)
                            Else
                                NewTrackRef = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(CompToCheck.RightLink)
                            End If
                            Exit For 'added this as a result of multiple switches in the collection was misplacing the ID on the wrong link
                        End If

                        If Not Me.Indicating Then
                            CompToCheck.Occuppied = True
                            CompToCheck.UpdateStatus()
                        End If
                    Next

                End If

                SyncLock NewTrackRef.TrainIDs
                    If NewTrackRef.TrainIDs.Count > 0 Then
                        If Not NewTrackRef.TrainIDs.Contains(trn) Then
                            NewTrackRef.TrainIDs.Add(trn)
                            Dim train As TrainID
                            For Each train In NewTrackRef.TrainIDs
                                TrackEventLog("TRAIN-TRACKING: TRAIN ID IN QUEUE:" & train.Name)
                            Next
                            TrackEventLog("TRAIN-TRACKING:TRACK'S TRAIN ID TRACK LIST COUNT:" & NewTrackRef.TrainIDs.Count.ToString)
                            TrackEventLog("TRAIN-TRACKING:THIS TRAIN ID LIST POSITION:" & NewTrackRef.TrainIDs.IndexOf(trn).ToString)
                            TrackEventLog("TRAIN-TRACKING:TRAIN ID MOVE EVENT - ADD TO TRACK: GUID=" & NewTrackRef.GUID.ToString & "-TRAINID:" & trn.Name)
                        End If
                    Else
                        If Not NewTrackRef.TrainIDs.Contains(trn) Then
                            NewTrackRef.TrainIDs.Insert(0, trn)
                            NewTrackRef.previousTrainID = Nothing
                            TrackEventLog("TRAIN-TRACKING: TRAIN ID MOVE EVENT - INSERT TO TRACK: GUID=" & NewTrackRef.GUID.ToString & "-TRAINID:" & trn.Name)
                        End If
                    End If
                    If Not NewTrackRef.TrainIDs.Contains(trn) Then
                        NewTrackRef.TrainIDs.Add(trn)
                        TrackEventLog("TRAIN-TRACKING: TRAIN ID MOVE EVENT - FORCED INSERT TO TRACK: GUID=" & NewTrackRef.GUID.ToString & "-TRAINID:" & trn.Name)
                    End If
                End SyncLock
                If NewTrackRef.TrafficDirection <> "" Then
                    trn.TrackingDirection = NewTrackRef.TrafficDirection
                End If


                If Not Me.Indicating Then NewTrackRef.Occuppied = True

                'Update the previous track graphically
                SyncLock PreviousTrack
                    If PreviousTrack.TrainIDs.Count > 0 Then
                        PreviousTrack.TrainIDs.RemoveAt(0)
                        PreviousTrack.InvalidateTrainID()
                        PreviousTrack.InitTrainDisplay()
                        PreviousTrack.InvalidateTrainIDMessageDisplay()
                        PreviousTrack.previousTrainID = trn
                        TrackEventLog("TRAIN-TRACKING: TRAIN ID MOVE EVENT - REMOVE FROM TRACK: GUID=" & PreviousTrack.GUID.ToString & "-TRAINID:" & trn.Name)
                    Else
                        Dim RealTrack As Track = Me.FindTrackWithTrain(trn.TrainGUID, NewTrackRef)
                        If Not IsNothing(RealTrack) Then
                            PreviousTrack = RealTrack
                            PreviousTrack.TrainIDs.Remove(trn)
                            PreviousTrack.InvalidateTrainID()
                            PreviousTrack.InitTrainDisplay()
                            PreviousTrack.InvalidateTrainIDMessageDisplay()
                            TrackEventLog("TRAIN-TRACKING1:TRAIN MOVE EVENT - REMOVE FROM TRACK: GUID=" & PreviousTrack.GUID.ToString & "-TRAINID:" & trn.Name)
                        End If
                    End If
                    If Not PreviousTrack.Indicating And PreviousTrack.TrainIDs.Count = 0 Then
                        PreviousTrack.TrafficDirection = ""
                        PreviousTrack.Occuppied = False
                        PreviousTrack.SignalStatOnMe = SignalStatus.SignalAtStop
                    End If
                    PreviousTrack.UpdateStatus()
                End SyncLock

                SyncLock NewTrackRef
                    NewTrackRef.InitTrainDisplay()
                    NewTrackRef.InvalidateTrainID()
                End SyncLock
                If Not NewTrackRef.Indicating Then
                    NewTrackRef.UpdateStatus()
                End If

                'Update the previous track
                CompCollection = PreviousTrack.OsComponentCollection
                If optEnableTrainOnAllLikeTracks AndAlso PreviousTrack IsNot Nothing Then
                    Dim LikeComponents As ArrayList = FindLikeComponents(PreviousTrack)
                    If LikeComponents IsNot Nothing AndAlso LikeComponents.Count > 0 Then
                        If CompCollection Is Nothing Then CompCollection = LikeComponents
                    End If
                    For Each CompToCheck In LikeComponents
                        If CompCollection IsNot Nothing Then
                            If CompCollection IsNot Nothing Then
                                If Not CompCollection.Contains(CompToCheck) Then CompCollection.Add(CompToCheck)
                            End If
                        End If
                    Next
                    CompToCheck = Nothing
                End If

                CompToCheck = Nothing
                If Not CompCollection Is Nothing Then
                    Dim DrillModeFound As Boolean

                    For Each CompToCheck In CompCollection
                        If CompToCheck.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If CompToCheck.DrillTrack Then
                                DrillModeFound = True
                                Exit For
                            End If
                        End If
                    Next
                    For Each CompToCheck In CompCollection
                        'SyncLock CompToCheck
                        If Not CompToCheck.Indicating Then
                            If Not DrillModeFound Then
                                CompToCheck.TrafficDirection = ""
                            End If
                            CompToCheck.Occuppied = False
                            CompToCheck.UpdateStatus()
                        End If
                        'End SyncLock
                    Next
                End If

                If optApplyTrainSheetConfigurationForKCT Then
                    If trn.IsOkToCreateAutoArrivalEvent Then
                        Dim RR As String = ""
                        Dim ArrivalTime As Date = Now
                        If PreviousTrack IsNot Nothing Then
                            RR = PreviousTrack.RailRoadUniqueName
                        Else
                            RR = Me.RailRoadUniqueName
                        End If
                        trn.AddTrainSheetEvent("AUTO-ARRIVAL", ArrivalTime, Mid(Me.TimeZone, 1, 1), trn.GetTrainReportDataString("", 0, 0, RR), Me.myControlPoint.GUID.ToString, trn.GetIdentifyingLocationNameFromLimits, RR)
                        trn.ArrTime = ArrivalTime
                        trn.Origin = RR
                        trn.UpdateTrainArrivalDepartureIntoDatabase(True)
                    End If
                End If

                'Me.TrackEvent("END-MoveTrainIDPlace:" & Me.GUID & "TRAINID:" & trn.Name)

                'PerformTrainIDMoveEvents(PreviousTrack, NewTrackRef, trn, LogOs, MoveEventType, False)
                Dim PerformOtherTrainIDMoveEvents As New DoTrainIDMoveEvents(AddressOf Me.PerformTrainIDMoveEvents)
                PerformOtherTrainIDMoveEvents.BeginInvoke(PreviousTrack, NewTrackRef, trn, LogOs, MoveEventType, False, TrackingDirection, False, False, Nothing, Nothing, Nothing)

                If trn.TrainIsLinked Then
                    Me.DoMoveLinkedTrainIDPlace(trn, LogOs, dbConnection, MoveEventType)
                End If


                If optEnableCaptureTRTData Then
                    DoCaptureTrainRuntimeData(trn)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                trn.MyMoveInitiated = False
            End Try
        End Sub

        Private Sub PerformTrainIDMoveEvents(ByRef PreviousTrack As Track, ByRef NewTrackRef As Track, trn As TrainID,
        LogOs As Boolean, EventType As String,
        Optional ManualMove As Boolean = False,
        Optional TrackingDirection As String = Nothing,
        Optional NullifyTrainCOmmand As Boolean = False,
        Optional SendManualMoveMessage As Boolean = False,
        Optional OverRideTimeStamp As String = Nothing,
        Optional ShadowMode As Boolean = False)

            Try

                If IsNothing(trn) Then
                    TrackEventLog($"PerformTrainIDMoveEvents:NO TRAINID OBJECT REFERENCED FOR TRAIN MOVE EVENT ON TRACK:{Me.GUID}")
                    Exit Sub
                End If

                If gAssistMode AndAlso Not (gMaintenanceMode OrElse (Me.IsShadowMode AndAlso Not Me.JointControl)) AndAlso Not ManualMove Then Exit Sub

                Try
                    trn.StackOrder = NewTrackRef.TrainIDs.IndexOf(trn)
                    trn.SubID = trn.myTrack.SubdivisionID
                    Dim ValidTrainPosition As Boolean
                    Dim trnToCheck As TrainID
                    For Each trnToCheck In NewTrackRef.TrainIDs
                        If trnToCheck.Name = trn.Name Then
                            ValidTrainPosition = True
                            Exit For
                        End If
                    Next
                    If ValidTrainPosition Then
                        NewTrackRef.UpDateTrainIDPosition(trn)
                    Else
                        TrackEventLog($"PerformTrainIDMoveEvents:No update train id position:Track:{Me.GUID}:{trn.Name}")
                        Exit Sub
                    End If

                Catch ex As Exception
                    SystemException(ex.ToString)
                End Try


                If gAssistMode AndAlso Not (gMaintenanceMode OrElse (Me.IsShadowMode AndAlso Not Me.JointControl)) And ManualMove Then
                    If Not NullifyTrainCOmmand Then
                        Dim CommandThisEvent As New DoCommandTrainEvent(AddressOf trn.PublishTrainCommand)
                        CommandThisEvent.BeginInvoke(TrainID.EventTypeTrainID.MOVEMANUAL, ShadowMode, Nothing, Nothing)
                    End If
                    Exit Sub
                End If


                'Added this code from the mouse down event on OSTRAIN AND MOVE TRAIN 04-21-2003
                Dim OKtoOS As Boolean
                Dim ForceOSEventOnTWCTrack As Boolean
                Dim ForceOSEventOnTWCTrackFromYard As Boolean
                If optEnableARRCSpecificOptions Then
                    If (PreviousTrack.AuthorityType.ToUpper.Trim.Contains("YL") AndAlso Mid(NewTrackRef.AuthorityType, 1, 3).Equals("TWC")) Then
                        Dim Auth As Object = Nothing
                        If NewTrackRef.TrackAuthorities IsNot Nothing AndAlso NewTrackRef.TrackAuthorities.Count > 0 Then
                            For Each Auth In NewTrackRef.TrackAuthorities
                                If Auth.GetType.ToString = gSFAComponentName Then
                                    If Auth.TrainSymbol = trn.Name Then
                                        ForceOSEventOnTWCTrackFromYard = True
                                        Exit For
                                    End If
                                End If
                            Next
                        End If
                        Auth = Nothing
                    End If
                End If



                If LogOs Then
                    If Not trn.OSPreviousControlPoint Is Me.myControlPoint Then
                        If optEnableLogOSOnAllTWCMoves And Not Mid(NewTrackRef.AuthorityType, 1, 3).Equals("TWC") And Not Mid(NewTrackRef.AuthorityType, 1, 3).Equals("CTC") Then
                            NewTrackRef.LogOsMessage(OverRideTimeStamp, False, trn)
                            OKtoOS = True
                        Else
                            NewTrackRef.LogOsMessage(OverRideTimeStamp, False, trn)
                            OKtoOS = True
                            ForceOSEventOnTWCTrack = True
                        End If
                    Else
                        If trn.OSPreviousTrack.TrackName = Me.TrackName And Not Mid(NewTrackRef.AuthorityType, 1, 3).Equals("TWC") Then
                            NewTrackRef.LogOsMessage(OverRideTimeStamp, False, trn)
                            OKtoOS = True
                        End If
                    End If
                ElseIf Me.IsPositionReportingTrack Then
                    NewTrackRef.LogOsMessage(OverRideTimeStamp, False, trn)
                ElseIf ForceOSEventOnTWCTrackFromYard Then
                    NewTrackRef.LogOsMessage(OverRideTimeStamp, False, trn)
                    OKtoOS = True
                    ForceOSEventOnTWCTrack = True
                End If
                '******************************************************************************
                NetworkMessages.CadMessages.SendTrainSymbolMove(trn, gCadTransmitQueue, PreviousTrack, NewTrackRef, EventType)

                If optSendManualPositionReportToCBTC And SendManualMoveMessage Then
                    Dim MessageToSend As String = $"{trn.IdentifingUnit}|{NewTrackRef.SubdivisionID}|{NewTrackRef.PTCBlockID}|{NewTrackRef.LeftLimitMilePost}"
                    Me.TrackEventLog($"PerformTrainIDMoveEvents:CBTC DTC MANUAL POSITION MESSAGE: {MessageToSend}")
                    NetworkMessages.CBTCMessages.SendDTCManualPositionReportMessage(MessageToSend, TMDS.GlobalDeclarations.gCadTransmitQueue)
                End If

                Dim EntryTrack As Track = PreviousTrack

                CheckForChangeDirection(trn, TrackingDirection, PreviousTrack)

                If Me.OSReporting And Not ManualMove Then
                    Dim ExitTrack As Track = FindExitTrack(Me, trn)
                    If optEnableSendOSMessageCN Then
                        NetworkMessages.CadMessages.SendTrainOSMessageCN(trn, gCadTransmitQueue, Me, False)
                        trn.OSPreviousControlPoint = Me.myControlPoint
                        trn.OSPreviousTrack = Me
                    ElseIf optEnableSendOSMessageFECR Then
                        NetworkMessages.CadMessages.SendTrainOSMessageFECR(trn, gCadTransmitQueue, Me, False)
                        trn.OSPreviousControlPoint = Me.myControlPoint
                        trn.OSPreviousTrack = Me
                    ElseIf optEnableSendOSMessageMRL Then
                        NetworkMessages.CadMessages.SendTrainOSMessageMRL(trn, gCadTransmitQueue, Me)
                        trn.OSPreviousControlPoint = Me.myControlPoint
                        trn.OSPreviousTrack = Me
                    ElseIf optEnableSendOSMessageFXE Then
                        NetworkMessages.CadMessages.SendTrainOSMessageFXE(trn, gCadTransmitQueue, Me, False)
                    ElseIf optEnableSendOSMessageARRC Then
                        NetworkMessages.CadMessages.SendTrainOSMessageARRC(trn, gMISTransmitQueue, Me, False)
                    ElseIf optEnableSendOSMessageDenver Then
                        'TMDS.NetworkMessages.CadMessages.SendTrainOSMessageDenver(trn, gCadTransmitQueue, Me, False)
                    Else

                        If OKtoOS And Not IsNothing(ExitTrack) Then
                            If (Not EntryTrack.OStype And Not ExitTrack.OStype) Then
                                NetworkMessages.CadMessages.SendTrainOSMessage(trn, gCadTransmitQueue, Me, EntryTrack, ExitTrack, "A")
                                trn.OSPreviousControlPoint = Me.myControlPoint
                                trn.OSPreviousTrack = Me
                            ElseIf (EntryTrack.OStype And Not ExitTrack.OStype) And (EntryTrack.Name <> Me.Name) Then
                                NetworkMessages.CadMessages.SendTrainOSMessage(trn, gCadTransmitQueue, Me, EntryTrack, ExitTrack, "A")
                                trn.OSPreviousControlPoint = Me.myControlPoint
                                trn.OSPreviousTrack = Me
                            ElseIf (EntryTrack.OStype And Not ExitTrack.OStype) And (EntryTrack.Name <> ExitTrack.Name) Then
                                NetworkMessages.CadMessages.SendTrainOSMessage(trn, gCadTransmitQueue, Me, EntryTrack, ExitTrack, "A")
                                trn.OSPreviousControlPoint = Me.myControlPoint
                                trn.OSPreviousTrack = Me

                            ElseIf (Not EntryTrack.OStype And ExitTrack.OStype) And (Not trn.OSPreviousControlPoint Is Me.myControlPoint) Then
                                NetworkMessages.CadMessages.SendTrainOSMessage(trn, gCadTransmitQueue, Me, EntryTrack, ExitTrack, "A")
                                trn.OSPreviousControlPoint = Me.myControlPoint
                                trn.OSPreviousTrack = Me
                            End If
                        ElseIf OKtoOS And IsNothing(ExitTrack) Then
                            NetworkMessages.CadMessages.SendTrainOSMessage(trn, gCadTransmitQueue, Me, EntryTrack, Nothing, "A")
                            trn.OSPreviousControlPoint = Me.myControlPoint
                            trn.OSPreviousTrack = Me
                        End If
                    End If

                    If optEnableTrainMovementReporting Then
                        trn.LogTrainMovementOnTrack(Me)
                        If trn.OnStationCPUID <> Me.myControlPoint.GUID Then
                            trn.AddTrainMovementEvent(Me, Me.myControlPoint, "ON STATION")
                            trn.OnStationCPUID = Me.myControlPoint.GUID
                            trn.OnStationOSTrk = Me
                        End If
                        'trn.AddTrainMovementEvent(Me, Me.myControlPoint, "ON STATION")
                    End If

                ElseIf Me.HoldingSignalOSLeftBoundReporting And (trn.Direction = optDirectionWest Or trn.Direction = optDirectionSouth) Then

                    NetworkMessages.CadMessages.SendTrainOSMessage(trn, gCadTransmitQueue, Me, EntryTrack, Me, "A")
                    trn.OSPreviousControlPoint = Me.myControlPoint
                    trn.OSPreviousTrack = Me
                    Me.LogOsMessage(Nothing, False, trn)
                    If optEnableTrainMovementReporting Then
                        trn.LogTrainMovementOnTrack(Me)
                        If trn.OnStationCPUID <> Me.myControlPoint.GUID Then
                            trn.AddTrainMovementEvent(Me, Me.myControlPoint, "ON STATION")
                            trn.OnStationCPUID = Me.myControlPoint.GUID
                            trn.OnStationOSTrk = Me
                        End If
                    End If
                ElseIf Me.HoldingSignalOSRightBoundReporting And (trn.Direction = optDirectionEast Or trn.Direction = optDirectionNorth) Then
                    NetworkMessages.CadMessages.SendTrainOSMessage(trn, gCadTransmitQueue, Me, EntryTrack, Me, "A")
                    trn.OSPreviousControlPoint = Me.myControlPoint
                    trn.OSPreviousTrack = Me
                    Me.LogOsMessage(Nothing, False, trn)
                    If optEnableTrainMovementReporting Then
                        trn.LogTrainMovementOnTrack(Me)
                        If trn.OnStationCPUID <> Me.myControlPoint.GUID Then
                            trn.AddTrainMovementEvent(Me, Me.myControlPoint, "ON STATION")
                            trn.OnStationCPUID = Me.myControlPoint.GUID
                            trn.OnStationOSTrk = Me
                        End If
                    End If

                ElseIf ForceOSEventOnTWCTrack Then
                    If optSendOsMessageWhenSymbolMoves Then
                        NetworkMessages.CadMessages.SendTrainOSMessage(trn, gCadTransmitQueue, Me, EntryTrack, Me, "A")
                    End If
                    trn.OSPreviousControlPoint = Me.myControlPoint
                    trn.OSPreviousTrack = Me
                Else
                    trn.LogTrainMovementOnTrack(Me)
                End If
                If Me.TrackTagLabels.Count > 0 Then
                    Dim tg As Tag
                    For Each tg In Me.TrackTagLabels
                        If tg.Delay Then
                            If optEnableSpecificOptionsForFECR Then
                                NetworkMessages.CadMessages.SendTrainDelayMessageFECR(trn, gCadTransmitQueue, tg, Me)
                            Else
                                NetworkMessages.CadMessages.SendTrainDelayMessage(trn, gCadTransmitQueue, tg, Me)
                            End If
                        End If
                    Next
                End If

                If optEnableTrainDelayReportingLegacy Then
                    CheckForTrainDelay(NewTrackRef, PreviousTrack, trn)
                End If

                If Not IsNothing(PreviousTrack) Then
                    PreviousTrack.UpdateTrainStackIndex()
                End If
                If Not ManualMove Then
                    Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf trn.PublishTrainEvent)
                    PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.MOVE, ShadowMode, Nothing, Nothing)
                Else
                    If Not (gAssistMode OrElse (Me.IsShadowMode AndAlso Not Me.JointControl)) Then
                        Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf trn.PublishTrainEvent)
                        PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.MOVEMANUAL, ShadowMode, Nothing, Nothing)

                        Thread.Sleep(500) 'temporary until new view 46 is distributed.
                        Dim PublishThisEvent1 As New DoPublishTrainEvent(AddressOf trn.PublishTrainEvent)
                        PublishThisEvent1.BeginInvoke(TrainID.EventTypeTrainID.MOVE, ShadowMode, Nothing, Nothing)
                    End If
                End If
                Dim LogThisEvent As New DoEventLogTrainID(AddressOf trn.LogTheTrainIDEvent)
                LogThisEvent.BeginInvoke(TrainID.EventTypeTrainID.MOVE, Nothing, Nothing)

                If (Me.OStype Or Me.HoldingSignalSlottingTrack) And trn.AutomaticModeOn Then
                    If gEnableAutoClearingMode Then
                        PerformAutoClearEvent(trn)
                    Else
                        SystemEvent($"PERFORM TRAIN MOVE EVENT NOTIFICATION:{trn.Name}")
                        CheckToPublishTrainMoveEventToAutoRouter(trn)
                    End If
                End If

                If optLogGrossTonMiles Then
                    If Not Mid(Me.AuthorityType, 1, 3).Equals("TWC") Then
                        Dim LogThisGTMEvent As New DoEventLogTrack(AddressOf Me.LogTheTrackEvent)
                        LogThisGTMEvent.BeginInvoke(Track.EventTypeTrack.OSGTM, Nothing, Nothing, Nothing, Nothing)
                    End If
                End If

                If optEnableGenerateAlarmNonIdentifiedOccuppancy Then
                    CheckToAcknowledgeNonIdenitifedOccupancy()
                End If

                If optEnableSlowOrderTrainDelayGeneration Then
                    If Me.Bulletins.Count > 0 Then
                        trn.CheckToGenerateTrainDelayFromBulletins()
                    End If
                End If

                If optEnableTrainDelayReporting Then
                    CheckForTrainDelay(NewTrackRef, PreviousTrack, trn)
                End If

                If optEnableAutomaticPositionReportRequesting Then
                    If trn.IsActivePTC And trn.IsPresenceOnNetwork Then
                        trn.DoLogTrainPositionReportFromGPS()
                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainPositionRequest(trn)
                    End If
                End If

                If optEnableTrainDelayOnTrackTag Then
                    Dim trkTG As Tag
                    Dim trkTag As Track = NewTrackRef
                    If NewTrackRef.OsComponentCollection IsNot Nothing AndAlso NewTrackRef.OsComponentCollection.Count > 0 Then
                        Dim comp As Object = Nothing
                        For Each comp In NewTrackRef.OsComponentCollection
                            If comp.GetType.ToString = gTrackComponentName AndAlso Not comp.NonTransverable Then
                                If comp.TrackTagLabels IsNot Nothing AndAlso comp.TrackTagLabels.Count > 0 Then
                                    trkTag = comp
                                    Exit For
                                End If
                            End If
                        Next
                    End If
                    If trkTag.TrackTagLabels IsNot Nothing AndAlso trkTag.TrackTagLabels.Count > 0 Then
                        'TG|6.33|9|DELAY DUE TO TRACK TAG|
                        For Each trkTG In trkTag.TrackTagLabels
                            Dim DCode As String = ""
                            Dim DMins As Integer = 0
                            Dim DMP As String = ""
                            Dim DNotes As String = trkTG.TagType
                            Dim DelayData() As String = trkTG.DelayData.Split("|")
                            If DelayData IsNot Nothing AndAlso DelayData.Length > 2 Then
                                DCode = DelayData(0).Trim
                                DMP = DelayData(1).Trim
                                Integer.TryParse(DelayData(2).Trim, DMins)
                                If DNotes.Trim <> "" Then
                                    If optApplyConfigurationForKCT Then
                                        DNotes = $"{DNotes} TAG DELAY - ({SystemUtilities.FetchData.GetDelayCodeDescriptionByDelayCode(DCode)} - {DCode.Trim}) - {DelayData(3).Trim}"
                                    Else
                                        DNotes = $"{DNotes} TAG DELAY - ({SystemUtilities.FetchData.GetDelayCodeDescriptionByDelayCode(DCode)}) - {DelayData(3).Trim}"
                                    End If

                                End If
                                trn.AddTrainDelay(DMins, Now, DMP, DCode, TrainDelay.DelayEventType.TrackTag, DNotes)
                            End If

                        Next
                    End If

                End If

                If optEnableTrainPositionReportingForMRS AndAlso
                    IsPositionReportingTrack AndAlso
                    String.IsNullOrEmpty(LastTrainSymbolOnMe) AndAlso
                    Occuppied Then
                    trn.LogTrainMovementOnTrack(Me)
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckForChangeDirection(ByVal trn As TrainID, ByVal TrackingDirection As String, ByVal PreviousTrack As Track)
            Try
                If Me.ForceIgnoreTrainDirectionLogicChange Then Exit Sub

                If optCheckToSetDirectionForNoneDirection Then
                    Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(Me.SubdivisionID)
                    Dim NorthSouthSub As Boolean
                    Dim RedrawTrain As Boolean
                    If Not IsNothing(subdvn) Then
                        If subdvn.SubDirection Then
                            NorthSouthSub = True
                        End If
                    End If
                    If trn.Direction = "" Or trn.Direction = optDirectionNone Then
                        Select Case TrackingDirection
                            Case "RIGHT"
                                If NorthSouthSub Then
                                    trn.Direction = optDirectionSouth
                                Else
                                    trn.Direction = optDirectionEast
                                End If
                            Case "LEFT"
                                If NorthSouthSub Then
                                    trn.Direction = optDirectionNorth
                                Else
                                    trn.Direction = optDirectionWest
                                End If
                        End Select
                    End If
                    If optShowTrainSymbolColorScheme1 Or optShowTrainSymbolColorScheme2 Then
                        RedrawTrain = True
                    End If
                    If RedrawTrain Then
                        Me.InvalidateTrainID()
                        Me.InitTrainDisplay()
                    End If

                End If

                'CHECK FOR Direction CHANGE EVENTS
                If Not optCheckForChangeDirectionEnabled Then
                    Dim FlipDirection As Boolean
                    If optCheckForTerritoryFlipDirectionEnabled Then
                        FlipDirection = Me.myTerritory.FlipDirection
                    End If



                    If Not IsNothing(TrackingDirection) Then
                        Dim OldDirection As String = String.Empty
                        Dim AssumedDirection As String = String.Empty
                        Dim DirectionBasedOnSubDivision As String = GetSearchableTrainDirectionBasedOnSubdivision(trn.Direction, trn.myTrack.mySubdivision)
                        Select Case trn.Direction
                            Case optDirectionEast, optDirectionNorth
                                If FlipDirection Then
                                    AssumedDirection = "LEFT"
                                Else
                                    AssumedDirection = "RIGHT"
                                End If

                            Case optDirectionWest, optDirectionSouth
                                If FlipDirection Then
                                    AssumedDirection = "RIGHT"
                                Else
                                    AssumedDirection = "LEFT"
                                End If
                        End Select

                        If (optEnableCPSpecificOptions) AndAlso Not String.IsNullOrEmpty(DirectionBasedOnSubDivision) Then
                            AssumedDirection = DirectionBasedOnSubDivision

                        End If


                        If AssumedDirection <> "" Then
                            OldDirection = trn.Direction
                            If AssumedDirection <> TrackingDirection Then
                                If Me.OStype Or HoldingSignalOsLeft Or HoldingSignalOsRight Then
                                    Dim DirectionChanged As Boolean
                                    Select Case trn.Direction
                                        Case optDirectionEast
                                            trn.Direction = optDirectionWest
                                            DirectionChanged = True
                                        Case optDirectionNorth
                                            trn.Direction = optDirectionSouth
                                            DirectionChanged = True
                                        Case optDirectionWest
                                            trn.Direction = optDirectionEast
                                            DirectionChanged = True
                                        Case optDirectionSouth
                                            trn.Direction = optDirectionNorth
                                            DirectionChanged = True
                                    End Select
                                    If DirectionChanged Then
                                        Dim DoUpdateToDirection As New UpdateTrainDirection(AddressOf trn.UpdateTrainDirection)
                                        DoUpdateToDirection.BeginInvoke(Nothing, Nothing)
                                        trn.TrainSummaryDirectionRefresh()
                                        TMDS.SystemUtilities.Utilities.SystemEvent("AUTOMATIC TRAIN Direction CHANGE FROM <" & OldDirection & "> TO <" & trn.Direction & ">")
                                        Me.InitTrainDisplay()

                                    End If
                                End If
                            End If
                        End If
                    End If
                ElseIf optenableDirectionChangeBasedOnTracking Then
                    'ElseIf optEnableMRSSpecificOptions Or optEnableCNSpecificOptions Then 'CN-1087
                    Dim thisTrainDirection As String = "" 'GetTrainDirectionMRS(trn.Direction)
                    If optEnableCNSpecificOptions Then
                        TrackEventLog(">>>>>> TRAIN DIRECTION CHECK_BEFORE----TrackingDirection: " & TrackingDirection & "Train[" & trn.Name & "] Direction: " & trn.Direction)
                        PerformTrainDirectionCheckCN(TrackingDirection, trn, Me)
                        TrackEventLog(">>>>>> TRAIN DIRECTION CHECK_AFTER----TrackingDirection: " & TrackingDirection & "Train[" & trn.Name & "] Direction: " & trn.Direction)
                    Else
                        thisTrainDirection = GetTrainDirectionMRS(trn.Direction)
                        If thisTrainDirection IsNot Nothing AndAlso Not String.IsNullOrEmpty(thisTrainDirection) AndAlso thisTrainDirection.Trim <> "" Then
                            If Me.TrafficDirection IsNot Nothing AndAlso Not String.IsNullOrEmpty(Me.TrafficDirection) AndAlso Me.TrafficDirection <> "" Then
                                Dim OldDirection As String = trn.Direction
                                If Me.TrafficDirection <> thisTrainDirection Then
                                    Dim DirectionChanged As Boolean
                                    trn.Direction = GetTrainDirectionFromLeftRight(Me.TrafficDirection, Me)
                                    DirectionChanged = True
                                    If DirectionChanged Then
                                        Dim DoUpdateToDirection As New UpdateTrainDirection(AddressOf trn.UpdateTrainDirection)
                                        DoUpdateToDirection.BeginInvoke(Nothing, Nothing)
                                        trn.TrainSummaryDirectionRefresh()
                                        TMDS.SystemUtilities.Utilities.SystemEvent("AUTOMATIC TRAIN Direction CHANGE FROM <" & OldDirection & "> TO <" & trn.Direction & ">")
                                        Me.InitTrainDisplay()
                                    End If
                                End If
                            End If
                        End If
                    End If

                    Exit Sub
                End If

                'CHECK FOR Subdivision CHANGE EVENTS
                If Me.SubdivisionID <> 0 Then
                    If Me.SubdivisionID <> PreviousTrack.SubdivisionID Then
                        Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(Me.SubdivisionID)
                        If Not IsNothing(subdvn) Then
                            Dim DirectionChanged As Boolean
                            Dim NorthSouthSubdivision As Boolean = subdvn.SubDirection
                            If NorthSouthSubdivision Then
                                Select Case trn.Direction
                                    Case optDirectionEast
                                        trn.Direction = optDirectionNorth
                                        DirectionChanged = True
                                    Case optDirectionWest
                                        trn.Direction = optDirectionSouth
                                        DirectionChanged = True
                                End Select
                            Else
                                Select Case trn.Direction
                                    Case optDirectionNorth
                                        trn.Direction = optDirectionEast
                                        DirectionChanged = True
                                    Case optDirectionSouth
                                        trn.Direction = optDirectionWest
                                        DirectionChanged = True
                                End Select
                            End If

                            If DirectionChanged Then
                                Dim DoUpdateToDirection As New UpdateTrainDirection(AddressOf trn.UpdateTrainDirection)
                                DoUpdateToDirection.BeginInvoke(Nothing, Nothing)
                                trn.TrainSummaryDirectionRefresh()
                                Me.InitTrainDisplay()

                            End If
                        End If
                    ElseIf Me.OStype Then
                        Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(Me.SubdivisionID)
                        Dim DirectionChanged As Boolean

                        If Not IsNothing(subdvn) Then
                            If (subdvn.SubDirection And trn.Direction <> optDirectionSouth) AndAlso (subdvn.SubDirection And trn.Direction <> optDirectionNorth) Then
                                Select Case trn.Direction
                                    Case optDirectionEast
                                        trn.Direction = optDirectionNorth
                                        DirectionChanged = True
                                    Case optDirectionWest
                                        trn.Direction = optDirectionSouth
                                        DirectionChanged = True
                                End Select

                            ElseIf (Not subdvn.SubDirection And trn.Direction <> optDirectionEast) AndAlso (Not subdvn.SubDirection And trn.Direction <> optDirectionWest) Then
                                Select Case trn.Direction
                                    Case optDirectionNorth
                                        trn.Direction = optDirectionEast
                                        DirectionChanged = True
                                    Case optDirectionSouth
                                        trn.Direction = optDirectionWest
                                        DirectionChanged = True
                                End Select
                            End If
                        End If

                        'this supports licensing through a flipflop when one exists for MRS operations
                        'MRS-297
                        If optEnableMRSSpecificPTCOperations Then
                            If Me.TrackAuthorities.Count > 0 Then
                                Select Case trn.Direction
                                    Case optDirectionNorth
                                        If Me.TrafficDirection = "LEFT" Then
                                            trn.Direction = optDirectionSouth
                                            SystemEvent("CheckForChangeDirection-Traffic Difference Detected-R:" & trn.Name & "-" & trn.Direction)
                                            DirectionChanged = True

                                        End If
                                    Case optDirectionSouth
                                        If Me.TrafficDirection = "RIGHT" Then
                                            trn.Direction = optDirectionNorth
                                            SystemEvent("CheckForChangeDirection-Traffic Difference Detected-L:" & trn.Name & "-" & trn.Direction)
                                            DirectionChanged = True
                                        End If

                                End Select
                            End If
                        End If
                        'MRS-297
                        'this supports licensing through a flipflop when one exists for MRS operations

                        If DirectionChanged Then
                            Dim DoUpdateToDirection As New UpdateTrainDirection(AddressOf trn.UpdateTrainDirection)
                            DoUpdateToDirection.BeginInvoke(Nothing, Nothing)
                            trn.TrainSummaryDirectionRefresh()
                            If Not (gAssistMode OrElse (Me.IsShadowMode AndAlso Not Me.JointControl)) Then
                                Dim CommandThisEvent As New DoPublishTrainCommand(AddressOf trn.PublishTrainCommand)
                                CommandThisEvent.BeginInvoke(TrainID.EventTypeTrainID.UPDATE, Nothing, Nothing)
                            End If
                            Me.InitTrainDisplay()
                        End If
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Private Sub CheckForTrainDelay(ByRef NewTrack As Track, ByRef PreviousTrack As Track, ByRef trn As TrainID)
            Try
                If optEnableTrackSidingBit Then
                    'NEW SIDING LOGIC CODE
                    Dim IsNewTrkSiding As Boolean = False
                    Dim IsPrevTrkSiding As Boolean = False
                    If NewTrack.EnableNonControlledSiding Or NewTrack.EnableControlledSiding Then IsNewTrkSiding = True
                    If PreviousTrack.EnableNonControlledSiding Or PreviousTrack.EnableControlledSiding Then IsPrevTrkSiding = True
                    If Not IsNewTrkSiding AndAlso IsPrevTrkSiding Then
                        Dim tg As New Tag()
                        If Format(trn.TrackOccupiedTime, "HH:mm") <> "00:00" Then
                            'Me.TrackEvent("TRAIN DELAY EVENT-TrackOccupiedTime:" & trn.TrackOccupiedTime.ToLongTimeString)
                            Dim TimeDiff As Integer = DateDiff(DateInterval.Minute, trn.TrackOccupiedTime, ApplyCurrentTimeZone(Me, Now))
                            If TimeDiff < 5 Then
                                'Me.TrackEvent("TRAIN DELAY LESS THAN 5 MINUTES. NOT LOGGED AS A DELAY:" & trn.Name)
                                Exit Sub
                            End If
                            Dim OsList As String = Me.FindPassedTrains(trn, Me.myControlPoint, ApplyCurrentTimeZone(Me, Now), trn.TrackOccupiedTime)
                            If OsList <> "" Then
                                tg.DelayData = "DY" & "|" & PreviousTrack.LeftLimitMilePost & "|" & TimeDiff.ToString & "|" & "BY:" & OsList & " DELAY DUE TO FREIGHT TRAINS TMDS"
                            Else
                                tg.DelayData = "TS" & "|" & PreviousTrack.LeftLimitMilePost & "|" & TimeDiff.ToString & "|" & "AUTOMATIC TAKE SIDING DELAY"
                            End If
                            If optEnableSpecificOptionsForFECR Then
                                TMDS.NetworkMessages.CadMessages.SendTrainDelayMessageFECR(trn, gCadTransmitQueue, tg, Me)
                            Else
                                TMDS.NetworkMessages.CadMessages.SendTrainDelayMessage(trn, gCadTransmitQueue, tg, Me)
                            End If
                            tg = Nothing
                        End If
                    End If
                    trn.TrackOccupiedTime = ApplyCurrentTimeZone(Me, Now)
                    If gDebug Then Me.TrackEventLog("TRAIN DELAY EVENT-TRAIN-TrackOccupiedTime=" & trn.TrackOccupiedTime.ToLongTimeString)
                Else
                    'OLD LEGACY SIDING CODE
                    If NewTrack.TrackName <> "SIDING" And PreviousTrack.TrackName = "SIDING" Then
                        Dim tg As New Tag()
                        If Format(trn.TrackOccupiedTime, "HH:mm") <> "00:00" Then
                            'Me.TrackEvent("TRAIN DELAY EVENT-TrackOccupiedTime:" & trn.TrackOccupiedTime.ToLongTimeString)
                            Dim TimeDiff As Integer = DateDiff(DateInterval.Minute, trn.TrackOccupiedTime, ApplyCurrentTimeZone(Me, Now))
                            If TimeDiff < 5 Then
                                'Me.TrackEvent("TRAIN DELAY LESS THAN 5 MINUTES. NOT LOGGED AS A DELAY:" & trn.Name)
                                Exit Sub
                            End If
                            Dim OsList As String = Me.FindPassedTrains(trn, Me.myControlPoint, ApplyCurrentTimeZone(Me, Now), trn.TrackOccupiedTime)
                            If OsList <> "" Then
                                tg.DelayData = "DY" & "|" & PreviousTrack.LeftLimitMilePost & "|" & TimeDiff.ToString & "|" & "BY:" & OsList & " DELAY DUE TO FREIGHT TRAINS TMDS"
                            Else
                                tg.DelayData = "TS" & "|" & PreviousTrack.LeftLimitMilePost & "|" & TimeDiff.ToString & "|" & "AUTOMATIC TAKE SIDING DELAY"
                            End If
                            If optEnableSpecificOptionsForFECR Then
                                TMDS.NetworkMessages.CadMessages.SendTrainDelayMessageFECR(trn, gCadTransmitQueue, tg, Me)
                            Else
                                TMDS.NetworkMessages.CadMessages.SendTrainDelayMessage(trn, gCadTransmitQueue, tg, Me)
                            End If
                            tg = Nothing
                        End If
                    End If
                    trn.TrackOccupiedTime = ApplyCurrentTimeZone(Me, Now)
                    'Me.TrackEvent("TRAIN DELAY EVENT-TRAIN-TrackOccupiedTime=" & trn.TrackOccupiedTime.ToLongTimeString)
                End If





            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function ApplyCurrentTimeZone(ByVal trk As Track, ByVal TimeToCheck As Date) As Date

            Dim DelayTimeZone As String = Mid(trk.TimeZone, 1, 1).PadLeft(1, "C")
            Dim DelayStartTime As Date
            Try
                Select Case DelayTimeZone
                    Case "M"
                        DelayStartTime = TimeToCheck.AddHours(-1)
                    Case "P"
                        DelayStartTime = TimeToCheck.AddHours(-2)
                    Case Else
                        DelayStartTime = TimeToCheck
                End Select
                Return DelayStartTime

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function FindPassedTrains(ByVal thisTrain As TrainID, ByVal cp As ControlPoint, ByVal OsTime As Date, ByVal SidingTime As Date) As String
            Try
                Dim OsList As New ArrayList()
                Dim OS As String
                Dim OsString() As String

                Dim trn As TrainID
                For Each trn In TMDS.GlobalDeclarations.TrainCollection
                    If trn.Name <> thisTrain.Name Then
                        For Each OS In trn.OSTimes
                            OsString = OS.Split("|")
                            ' Dim OsMessage As String = OsPoint & "|" & Format(OsTime, "MM-dd-yyyy HH:mm") & "|" & SubName

                            If OsString.Length > 2 Then
                                If OsString(0) = cp.Name Then
                                    If (CDate(OsString(1)) >= SidingTime) And (CDate(OsString(1)) <= OsTime) Then
                                        If Not OsList.Contains(trn.Name) Then
                                            OsList.Add(trn.Name)
                                        End If
                                    End If
                                End If
                            End If
                        Next
                    End If
                Next
                Dim OsListOfTrains As String = String.Empty
                Dim TrainOS As String = String.Empty
                Dim FirstTrain As Integer

                For Each TrainOS In OsList
                    If FirstTrain = 0 Then
                        OsListOfTrains = OsListOfTrains & TrainOS
                        FirstTrain = 1
                    Else
                        OsListOfTrains = OsListOfTrains & "," & TrainOS
                    End If
                Next
                Return OsListOfTrains
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

