        Private Function FormatHPT(ByVal hpt As String) As String
            Dim num As Integer = 0
            Try
                Dim data() As String = hpt.Split(".")
                Dim Whole As String
                Dim Dec As String
                If data.Length > 1 Then
                    If IsNumeric(data(0)) Then
                        num = 0
                        'Dim num As Integer = CInt(data(0))
                        Integer.TryParse(data(0), num)
                        Whole = num.ToString
                    Else
                        Whole = 0
                    End If

                    Dec = Mid(data(1), 1, 1)
                    Return Whole & "." & Dec
                Else
                    If IsNumeric(data(0)) Then
                        num = 0
                        Integer.TryParse(data(0), num)
                        Whole = num.ToString
                        Return Whole & ".0"
                    Else
                    End If

                End If
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Public Sub Track_MouseHover(ByVal sender As Object, ByVal e As EventArgs)
            Dim ToolTipMessage As String = String.Empty
            Try
                If Me.TrainIDs.Count > 0 Then
                    Dim trn As TrainID
                    For Each trn In Me.TrainIDs
                        If optTrainIDDisplayTrainMiscDetails Then
                            ToolTipMessage = ToolTipMessage & "(" & trn.Name.ToUpper & ") (" & trn.PseudoName & ") (" & trn.IdentifingUnit & ") (" & trn.Direction & ") (" & trn.OLength & ")"
                        ElseIf optCPTrackToolTipFormat Then
                            If Mid(Me.AuthorityType, 1, 3) = "CTC" Then
                                ToolTipMessage = ToolTipMessage & "(" & trn.Name.ToUpper & ") (" & trn.IdentifingUnit & ") (" & trn.CTCAuthDesignation & ")"
                            Else
                                ToolTipMessage = ToolTipMessage & "(" & trn.Name.ToUpper & ") (" & trn.IdentifingUnit & ") (" & trn.Direction & ")"
                            End If
                        ElseIf optTrackToolTipFormatForKCT Then
                            ToolTipMessage = ToolTipMessage & "(" & trn.Name.ToUpper & ") (" & trn.IdentifingUnit & ") (" & trn.Direction & ") (" & trn.TotalCars & ") (" & trn.OLength & ") (" & Format(trn.TrainHOS, "HH:mm") & ") (" & trn.PseudoName & ")"
                        Else
                            ToolTipMessage = ToolTipMessage & "(" & trn.Name.ToUpper & ") (" & trn.IdentifingUnit & ") (" & trn.Direction & ")"
                            ToolTipMessage = ToolTipMessage & " (" & trn.OLength.ToString.PadLeft(5, "0") & ")"

                        End If
                        If Not String.IsNullOrEmpty(trn.MyTrackingMilePost) Then
                            'ToolTipMessage = ToolTipMessage & "(POS Report:" & trn.MyTrackingMilePost.Trim & ", SPD-" & trn.MyTrackingSpeed & ")"
                        End If

                        If optTrainIDDisplayCrewDetails Then
                            Dim DateToUse As Date
                            Dim HOS As String
                            If Not Me.CheckForValidDate(trn.CrewCurrent.Engineer.HOS) Or Not Me.CheckForValidDate(trn.CrewCurrent.Conductor.HOS) Then
                                HOS = "00:00"
                            Else
                                If CDate(trn.CrewCurrent.Engineer.HOS) < CDate(trn.CrewCurrent.Conductor.HOS) Then
                                    DateToUse = CDate(trn.CrewCurrent.Engineer.HOS)
                                Else
                                    DateToUse = CDate(trn.CrewCurrent.Conductor.HOS)
                                End If
                                HOS = Format(DateToUse, "dd-HHmm")
                            End If
                            ToolTipMessage = ToolTipMessage & " (" & HOS & ")"
                        End If
                        If optTrainIDDisplayTrainMiscDetails Then
                            If trn.HorsePowerTrailing <> "" Then
                                ToolTipMessage = ToolTipMessage & " (" & FormatHPT(trn.HorsePowerTrailing) & ")"
                            Else
                                ToolTipMessage = ToolTipMessage & " (0.0)"
                            End If
                        End If

                        If trn.MilePost <> "" Then
                            ToolTipMessage = ToolTipMessage & " (" & trn.MilePostPrefix.Trim & trn.MilePost & trn.MilePostSuffix.Trim & ")"
                            If trn.EndMilePost <> "" Then
                                ToolTipMessage = ToolTipMessage & " (" & trn.EndMilePostPrefix.Trim & trn.EndMilePost & trn.EndMilePostSuffix & ")"
                            End If
                            ToolTipMessage = ToolTipMessage & " (" & trn.Speed & " " & optMPHDisplay & ")"
                            ToolTipMessage = ToolTipMessage & " (" & Format(trn.PositionReportTime, "HH:mm") & ")"
                        End If

                        If trn.AutomaticModeOn And optShowToolTipForPlanningPriority Then
                            Dim pc As String = "NA"
                            If trn.PriorityCode <> "" Then pc = trn.PriorityCode
                            ToolTipMessage = ToolTipMessage & " (" & pc & ")"
                        End If
                        If optTrainIDToolTipTrainScheduleInfo Then
                            Dim strSCHTP As String = ""
                            GetTrainScheduleInfo(trn, strSCHTP)
                            If Not String.IsNullOrEmpty(strSCHTP) AndAlso strSCHTP.Trim <> "" Then
                                ToolTipMessage = ToolTipMessage & vbCrLf
                                ToolTipMessage = ToolTipMessage & " (" & strSCHTP & ")"
                            End If

                        End If

                        ToolTipMessage = ToolTipMessage & vbCrLf
                    Next
                End If

                If Me.MOWIDs.Count > 0 Then
                    Dim mw As MOWID
                    For Each mw In Me.MOWIDs
                        ToolTipMessage = ToolTipMessage & Space(1) & optMOWIDString1 & " (" & mw.Name & ")" & vbCrLf
                    Next
                End If


                If Me.TrackAndTime Or Me.AllowTrackPermit Then
                    Dim Auth As TrackAuthority.TrackAuthority
                    For Each Auth In Me.TrackAuthorities
                        If Not Auth.LicenseTypeAuthority Then
                            If optUseUntilCallFormattingForUntilTime Then
                                Dim sUntilTime As String
                                If Format(Auth.UntilTime, "HH:mm") = "00:00" Then
                                    sUntilTime = optUntilCalled
                                Else
                                    sUntilTime = Format(Auth.UntilTime, optSystemTimeFormat)
                                End If
                                If optDisableTNTModify Then
                                    If sUntilTime.Contains(optUntilCalled) Then
                                        ToolTipMessage = ToolTipMessage & "(" & Auth.AuthorityUID & ") (" & Auth.IssueTo & ") "
                                    Else
                                        ToolTipMessage = ToolTipMessage & "(" & Auth.AuthorityUID & ") (" & Auth.IssueTo & ") (" & sUntilTime & ")"
                                    End If
                                Else
                                    ToolTipMessage = ToolTipMessage & "(" & Auth.AuthorityUID & ") (" & Auth.IssueTo & ") (" & sUntilTime & ")"
                                End If
                            Else
                                If (optEnableDenverSpecificOptions) Then
                                    ToolTipMessage = ToolTipMessage & "FORM A-(" & Auth.IssueTo & ") (" & Format(Auth.UntilTime, optSystemTimeFormat) & ")"

                                Else
                                    ToolTipMessage = ToolTipMessage & "(" & Auth.AuthorityUID & ") (" & Auth.IssueTo & ") (" & Format(Auth.UntilTime, optSystemTimeFormat) & ")"

                                End If

                            End If

                            Dim veh As String
                            If Not IsNothing(Auth.VehicleAssociations) AndAlso Auth.VehicleAssociations.Count > 0 Then
                                ToolTipMessage = ToolTipMessage & " ( "
                                For Each veh In Auth.VehicleAssociations
                                    ToolTipMessage = ToolTipMessage & "{" & veh & "}"
                                Next
                                ToolTipMessage = ToolTipMessage & " )"
                            End If
                            ToolTipMessage = ToolTipMessage & vbCrLf
                        End If

                    Next
                ElseIf Me.TrackAuthority Then
                    Dim Auth As TrackAuthority.TrackAuthority
                    For Each Auth In Me.TrackAuthorities
                        If Auth.LicenseTypeAuthority Then
                            ToolTipMessage = ToolTipMessage & "(LICENSE:" & Auth.AuthorityNumber & ")(" & Auth.IssueTo & ")"
                            ToolTipMessage = ToolTipMessage & vbCrLf
                        End If
                    Next
                End If

                If Me.Authorities.Count > 0 And Me.AuthorityType <> "DTC" Then
                    Dim Auth As TrackAuthority.Warrant
                    For Each Auth In Me.Authorities
                        ToolTipMessage = ToolTipMessage & "(" & Auth.WarrantNumber & ") (" & Auth.IssueTo & ") (" & Auth.Box22Items & ")"
                        ToolTipMessage = ToolTipMessage & vbCrLf
                    Next

                ElseIf Me.Authorities.Count > 0 And Me.AuthorityType = "DTC" Then
                    Dim Auth As Object 'TrackAuthority.DTCAuthority
                    For Each Auth In Me.Authorities
                        ToolTipMessage = ToolTipMessage & "(" & Auth.AuthorityUID & ") (" & Auth.IssueTo & ")"
                        ToolTipMessage = ToolTipMessage & vbCrLf
                    Next
                ElseIf Me.TrackAuthorities.Count > 0 And Mid(Me.AuthorityType, 1, 3) = "TWC" Then

                    Dim Auth As TrackAuthority.SFAuthority
                    For Each Auth In Me.TrackAuthorities
                        Dim AuthLimits As String = String.Empty
                        Dim AuthLimitsDual As String = String.Empty
                        If Auth.CheckBoxItemsStatus(1) Then
                            AuthLimits = " (" & Auth.Box2From1 & Space(1) & optAuthString2 & Auth.Box2To1 & ")"
                            If Auth.Components1.Count <> 0 Then
                                AuthLimitsDual = " (" & Auth.Box4From1 & Space(1) & optAuthString5 & Auth.Box4To1 & ")"
                            End If
                        ElseIf Auth.CheckBoxItemsStatus(3) Then
                            If optUseSingleFormAuthorityVersionII Or optUseSingleFormAuthorityVersionCN Or optUseSingleFormAuthorityVersionMRL Or optUseSingleFormAuthorityVersionARRC OrElse optUseSingleFormAuthorityVersionNCTD Then
                                AuthLimits = " (" & Auth.Box2From3 & Space(1) & optAuthString5 & Auth.Box2To3 & ")"
                            Else
                                AuthLimits = " (" & Auth.Box4From1 & Space(1) & optAuthString5 & Auth.Box4To1 & ")"
                            End If

                        ElseIf Auth.CheckBoxItemsStatus(5) Then
                            AuthLimits = " (" & Auth.Box4From1 & Space(1) & optAuthString5 & Auth.Box4To1 & ")"
                        End If

                        If Not Auth.CheckBoxItemsStatus(9) Then
                            ToolTipMessage = ToolTipMessage & "(" & Auth.AuthorityUID & ") (" & Auth.IssueTo & ") (" & optAuthString38 & ")" & AuthLimits
                        Else
                            ToolTipMessage = ToolTipMessage & "(" & Auth.AuthorityUID & ") (" & Auth.IssueTo & ") (" & Format(Auth.Box10ClearBy, "HH:mm") & ")" & AuthLimits
                        End If
                        If AuthLimitsDual <> "" Then
                            ToolTipMessage = ToolTipMessage & vbCrLf & "(" & Auth.AuthorityUID & ") (" & Auth.IssueTo & ") (" & optAuthString38 & ")" & AuthLimitsDual
                        End If
                        ToolTipMessage = ToolTipMessage & vbCrLf
                    Next
                ElseIf Me.OtherSplAuthorities.Count > 0 Then
                    Dim splAuth As TrackAuthority.OtherSpecialAuthorityType
                    If optEnableCPSpecificOptions Then
                        For Each splAuth In Me.OtherSplAuthorities
                            Select Case splAuth.SubType.Trim.ToUpper
                                Case "EMT"
                                    Dim strData As String = String.Empty
                                    Dim EMTSwitchUID As Integer = 0
                                    strData = splAuth.AuthorityData
                                    Dim EMTSwitch As Switch = Nothing
                                    Dim Data() As String = strData.Split("|")
                                    Integer.TryParse(Data(1), EMTSwitchUID)
                                    If EMTSwitchUID > 0 Then
                                        EMTSwitch = FindCompFromGUID(EMTSwitchUID)
                                    End If
                                    Dim EMTSwitchName As String = String.Empty
                                    If Not IsNothing(EMTSwitch) Then
                                        EMTSwitchName = EMTSwitch.Name
                                    End If
                                    ToolTipMessage = ToolTipMessage & "(" & splAuth.AuthorityNumber & ")(" & splAuth.IssueTo & ")(" & EMTSwitchName & ")(" & splAuth.Direction & ")"
                                    ToolTipMessage = ToolTipMessage & vbCrLf
                                Case "PSS"
                                    Dim strData As String = String.Empty
                                    Dim PSSLocation As String = String.Empty
                                    Dim SigUID As Integer = 0
                                    Dim PSSSignal As Signal = Nothing
                                    strData = splAuth.AuthorityData
                                    Dim Data() As String = strData.Split("|")
                                    Integer.TryParse(Data(1), SigUID)
                                    If SigUID > 0 Then
                                        PSSSignal = FindCompFromGUID(SigUID)
                                    End If
                                    If Not IsNothing(PSSSignal) Then
                                        PSSLocation = PSSSignal.myControlPoint.Name
                                    End If
                                    Dim FirstTrack As Track
                                    Dim LastTrack As Track
                                    FirstTrack = TMDS.SystemUtilities.FetchData.FindFirstTrackInList(splAuth.ComponentsInSelection)
                                    LastTrack = TMDS.SystemUtilities.FetchData.FindLastTrackInList(splAuth.ComponentsInSelection)

                                    ToolTipMessage = ToolTipMessage & "(" & splAuth.AuthorityNumber & ")(" & splAuth.IssueTo & ")(" & PSSLocation & ")" & "( " & FirstTrack.TrackName & " to " & LastTrack.TrackName & " )"
                                    ToolTipMessage = ToolTipMessage & vbCrLf
                            End Select
                        Next
                    Else
                        For Each splAuth In Me.OtherSplAuthorities
                            ToolTipMessage = ToolTipMessage & "(" & splAuth.AuthorityUID & ")( " & splAuth.AuthorityType & ") (" & splAuth.TrainSymbol & ") (" & splAuth.IssueTo & ")"
                            ToolTipMessage = ToolTipMessage & vbCrLf
                        Next
                    End If
                End If


                If Me.DeviceBlocked Then
                    Dim Auth As TrackAuthority.DeviceBlock
                    Dim dbBlkCollection As New ArrayList
                    For Each Auth In Me.DeviceBlocks
                        Select Case Auth.AuthorityType
                            Case "DEVICE BLOCK"
                                If Not dbBlkCollection.Contains(Auth.BlockGUID) Then
                                    If Auth.isRemoteDeviceBlock Or Auth.isMaintenanceMode Then
                                        ToolTipMessage = ToolTipMessage & "(" & optBlockString1 & Auth.IssueTo & "-INTERDIÇÃO REMOTA) "
                                    Else
                                        ToolTipMessage = ToolTipMessage & "(" & optBlockString1 & Auth.IssueTo & ") "
                                    End If

                                    dbBlkCollection.Add(Auth.BlockGUID)
                                End If
                            Case "BLUE FLAG"
                                ToolTipMessage = ToolTipMessage & "(" & optBFlagString & ":" & Auth.IssueTo & ") (" & Auth.TrackName & ") (" & Auth.WorkCraft & ")"
                        End Select
                        ToolTipMessage = ToolTipMessage & vbCrLf
                    Next
                    dbBlkCollection = New ArrayList
                End If

                If Me.TrackTagLabels.Count > 0 Then
                    Dim tg As Tag
                    For Each tg In Me.TrackTagLabels
                        Dim TagType As String = String.Empty
                        Select Case tg.TagType
                            Case optTagType1 '"SPEED"
                                If tg.isRemoteTag Then
                                    TagType = optTagType1 & " REMOTA"
                                Else
                                    TagType = optTagType1
                                End If
                            Case optTagType2 '"XING"
                                TagType = optTagType2
                            Case optTagType3 '"INFO"
                                If tg.IsCriticalAlertType Then
                                    TagType = "CRITICAL ALERT"
                                Else
                                    TagType = optTagType3
                                End If
                            Case optTagType4 '"INFO"
                                TagType = optTagType4
                            Case optTagType6 'TRACK ALARM
                                TagType = optTagType6
                            Case optTagType7 'WORK ZONE
                                If tg.isRemoteTag Then
                                    TagType = optTagType7 & " REMOTA"
                                Else
                                    TagType = optTagType7
                                End If
                            Case Else
                                TagType = tg.TagType
                        End Select
                        Dim TagData As String = TagType & ": " & tg.Creator & ", " & tg.CreateTime
                        Dim DataString() As String = tg.DataString.Split("|")
                        Select Case tg.TagType
                            Case optTagType1 '"SPEED"
                                TagData = TagData & ", " & DataString(0) & ", " & DataString(5) & ", " & DataString(1) & ", " & DataString(2)
                            Case optTagType2 '"XING"
                                TagData = TagData & ", " & DataString(0) & ", " & DataString(1)  '& ", " & DataString(2)
                            Case optTagType3, optTagType4, "CRITICAL ALERT"
                                If Not String.IsNullOrEmpty(tg.AdvisorySummary) AndAlso optShowInfoTagHeadingOnToolTip Then
                                    TagData = TagData & ", " & tg.AdvisorySummary.Trim
                                End If
                            Case optTagType6 'TRACK ALARM
                                TagData = TagData & " - BITOLA:" & tg.trackAlarmGauge
                            Case optTagType7 'WORK ZONE
                                TagData = TagData & ", " & DataString(0) & ", " & DataString(5) & ", " & DataString(1) & ", " & DataString(2)
                        End Select
                        ToolTipMessage = ToolTipMessage & TagData & vbCrLf
                        If tg.RestrictionDeliveryList.Count > 0 Then
                            Dim t As String
                            Dim Message As String = String.Empty
                            Dim rest() As String
                            Dim data() As String
                            Dim dateSent As String = String.Empty
                            Dim dateAck As String = String.Empty
                            For Each t In tg.RestrictionDeliveryList
                                rest = t.Split("|")
                                data = tg.DataString.Split("|")
                                dateSent = IIf(IsValidDate(rest(3)), "ENVIADA " & CDate(rest(3)).ToString("dd/MM/yy HH:mm:ss"), String.Empty)
                                If rest.Length > 5 AndAlso rest(5) <> String.Empty Then
                                    dateAck = IIf(IsValidDate(rest(5)), "RECONHECIDA " & CDate(rest(5)).ToString("dd/MM/yy HH:mm:ss"), String.Empty)
                                Else
                                    dateAck = String.Empty
                                End If
                                If tg.isRemoteTag Then
                                    Message = tg.TagType & " REMOTA: (" & rest(0) & ") (KM " & data(1) & " ATÉ KM " & data(2) & ") (" & data(5) & " KPH) (" & dateSent & ") (" & dateAck & ")"
                                Else
                                    Message = tg.TagType & ": (" & rest(0) & ") (KM " & data(1) & " ATÉ KM " & data(2) & ") (" & data(5) & " KPH) (" & dateSent & ") (" & dateAck & ")"
                                End If
                                ToolTipMessage = Message & vbCrLf
                            Next
                        End If
                    Next
                End If
                If optEnableBulletinSubTypes And optEnableDisplayBulletinsOnTracks Then
                    Dim BulletinInfo As String = GetBulletinToolTipInfo()
                    If BulletinInfo <> "" Then
                        ToolTipMessage = ToolTipMessage & BulletinInfo
                    End If
                End If
                If Not optEnableForceAllTrackInfoMouseHover Then
                    If Not optDisableTrackInfoMouseHover Then
                        If ToolTipMessage = "" Then
                            If optTrackLengthOnMouseHover Then
                                ToolTipMessage = ToolTipMessage & "(" & Me.Name.ToUpper & ") (" & Me.TrackLength.ToString.PadLeft(6, "0") & ")"
                            Else
                                ToolTipMessage = ToolTipMessage & Me.Name.ToUpper
                            End If
                        End If
                    End If
                    If optEnableTrackMileageInfoMouseHover Then
                        If optEnableTrackMileageInfoMouseHoverRoundToHundereds Then
                            Dim LeftLimitMP As String = ""
                            Dim RightLimitMP As String = ""
                            If optEnableARRCSpecificOptions Then
                                If LeftLimitMilePost > RightLimitMilePost Then
                                    LeftLimitMP = Math.Round(LeftLimitMilePost, 2).ToString
                                    RightLimitMP = Truncate(RightLimitMilePost, 2).ToString
                                Else
                                    LeftLimitMP = Math.Round(LeftLimitMilePost, 2).ToString
                                    RightLimitMP = Truncate(RightLimitMilePost, 2).ToString
                                End If
                            Else
                                If LeftLimitMilePost > RightLimitMilePost Then
                                    LeftLimitMP = Math.Round(LeftLimitMilePost, 2).ToString
                                    RightLimitMP = Math.Round(RightLimitMilePost, 2).ToString
                                Else
                                    LeftLimitMP = Math.Round(LeftLimitMilePost, 2).ToString
                                    RightLimitMP = Math.Round(RightLimitMilePost, 2).ToString
                                End If
                            End If
                            ToolTipMessage = ToolTipMessage & " (" & optMilePostAbbreviation & Space(1) & Me.LeftLimitMilePostPrefix & LeftLimitMP & Me.LeftLimitMilePostSuffix & Space(1) & optMilePostAbbreviation1 & Space(1) & RightLimitMilePostPrefix & RightLimitMP & RightLimitMilePostSuffix & " " & Me.TrackName.ToUpper & ")"
                        Else
                            ToolTipMessage = ToolTipMessage & " (" & optMilePostAbbreviation & Space(1) & Me.LeftLimitMilePostPrefix & Me.LeftLimitMilePost & Me.LeftLimitMilePostSuffix & Space(1) & optMilePostAbbreviation1 & Space(1) & RightLimitMilePostPrefix & Me.RightLimitMilePost & RightLimitMilePostSuffix & " " & Me.TrackName.ToUpper & ")"
                        End If
                        ToolTipMessage = ToolTipMessage & vbCrLf
                    End If
                Else
                    If optTrackToolTipFormatForKCT Then
                        ToolTipMessage = ToolTipMessage & "(" & Me.Name.ToUpper & ") (" & Me.TrackName & ") (" & Me.myControlPoint.Name & ")"
                        ToolTipMessage = ToolTipMessage & vbCrLf
                    Else
                        ToolTipMessage = ToolTipMessage & "(" & Me.Name.ToUpper & ") (" & Me.TrackLength.ToString.PadLeft(6, "0") & ")"
                        ToolTipMessage = ToolTipMessage & " (" & optMilePostAbbreviation & Space(1) & Me.LeftLimitMilePostPrefix & Me.LeftLimitMilePost & Space(1) & Me.LeftLimitMilePostSuffix & Space(1) & optMilePostAbbreviation1 & Space(1) & Me.RightLimitMilePostPrefix & Me.RightLimitMilePost & RightLimitMilePostSuffix & ") (" & Me.TrackName.ToUpper & ")"
                        ToolTipMessage = ToolTipMessage & vbCrLf
                    End If
                End If
                If optEnableSidingCalculationMouseHover Then
                    If optEnableTrackSidingBit Then
                        'NEW SIDING LOGIC CODE
                        If Me.EnableControlledSiding Or Me.EnableNonControlledSiding Then
                            If Me.TrainIDs.Count > 0 Then
                                Dim trn As TrainID = Me.TrainIDs.Item(0)
                                If Not IsNothing(trn) Then
                                    If trn.OLength < Me.TrackLength Then
                                        Dim LengthLeft As Integer = Me.TrackLength - trn.OLength
                                        ToolTipMessage = ToolTipMessage & LengthLeft.ToString & Space(1) & optTrackLengthLeftInSidingString
                                    Else
                                        ToolTipMessage = ToolTipMessage & "0 " & optTrackLengthLeftInSidingString
                                    End If
                                End If
                            End If
                        End If
                    Else
                        'OLD LEGACY SIDING CODE
                        If Me.TrackName = optTrackNameSidingDefault Then
                            If Me.TrainIDs.Count > 0 Then
                                Dim trn As TrainID = Me.TrainIDs.Item(0)
                                If Not IsNothing(trn) Then
                                    If trn.OLength < Me.TrackLength Then
                                        Dim LengthLeft As Integer = Me.TrackLength - trn.OLength
                                        ToolTipMessage = ToolTipMessage & LengthLeft.ToString & Space(1) & optTrackLengthLeftInSidingString
                                    Else
                                        ToolTipMessage = ToolTipMessage & "0 " & optTrackLengthLeftInSidingString
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
                If optCPTrackToolTipFormat Then
                    If Not ToolTipMessage.Contains(Me.Name.ToUpper) Then ToolTipMessage = ToolTipMessage & Space(1) & "(" & Me.Name.ToUpper & ")"
                End If
                Me.CurrentDrawingForm.TrackToolTip.SetToolTip(Me, ToolTipMessage)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function CheckForValidDate(ByVal DateString As String) As Boolean
            Try
                Try
                    If DateString = "NONE" Then
                        Return False
                    End If
                    Dim DateToTry As Date '= CDate(DateString)
                    If Not Date.TryParse(DateString, DateToTry) Then
                        Return False
                    End If
                    Return True
                Catch
                    Return False
                End Try
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Function GetBulletinToolTipInfo() As String
            Try
                If Me.Bulletins.Count = 0 Then Return String.Empty
                Dim tt As New StringBuilder()
                Dim sb As GeneralBulletins.SubBulletin
                For Each sb In Me.Bulletins

                    Dim BulletinHeader As String = String.Empty
                    Dim BulletinBody As String = String.Empty
                    Select Case sb.mysTypeForm
                        Case "FORM A", "FORMA"
                            BulletinHeader = "SPEED RESTRICTION"
                            BulletinBody = " (" & sb.BullUID & ") (" & (Format(sb.EffectTime, optBulletinSystemDateTimeFormat) & ") (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & optBulletinString2 & sb.MilePostEndPrefix & sb.MilePostEnd & sb.MilePostEndSuffix & ")")
                            BulletinBody = BulletinBody & " (F: " & sb.SpeedFrght & ") (P: " & sb.SpeedPassg & ")"
                            If (optEnableDenverSpecificOptions) Then
                                BulletinHeader = "Form-S "
                                BulletinBody = "(P: " & sb.SpeedPassg & ") (F: " & sb.SpeedFrght & ") "
                                BulletinBody = BulletinBody & "  (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & optBulletinString2 & sb.MilePostEndPrefix & sb.MilePostEnd & sb.MilePostEndSuffix & ")"
                            End If
                            'If optEnableKCSSpecificOptions Then
                            '    BulletinBody = BulletinBody & "  ( FROM " & (Format(sb.TimeFrom, optBulletinSystemDateTimeFormat) & " TO " & Format(sb.TimeUntil, optBulletinSystemDateTimeFormat) & ")")
                            'End If

                        Case "FORM B", "FORMB"
                            BulletinHeader = "WORK ZONE"
                            BulletinBody = " (" & sb.BullUID & ") (" & Format(sb.TimeFrom, optBulletinSystemDateTimeFormat) & ") (" & Format(sb.TimeUntil, optBulletinSystemDateTimeFormat) & ") (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & optBulletinString2 & sb.MilePostEndPrefix & sb.MilePostEnd & sb.MilePostEndSuffix & ")"
                            If (optEnableDenverSpecificOptions) Then
                                BulletinHeader = "Form-W "
                                BulletinBody = " (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & optBulletinString2 & sb.MilePostEndPrefix & sb.MilePostEnd & sb.MilePostEndSuffix & ") " & sb.Foreman
                            End If

                        Case "FORM O"
                            If optEnableDenverSpecificOptions Then
                                BulletinHeader = "FORM-O"
                                BulletinBody = "(" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & optBulletinString2 & sb.MilePostEndPrefix & sb.MilePostEnd & sb.MilePostEndSuffix & ") (" & Format(sb.EffectTime, optBulletinSystemDateTimeFormat) & ") "
                            Else
                                If sb.TrackBlocked Then
                                    BulletinHeader = "TRACK BLOCKED"
                                Else
                                    BulletinHeader = "OSS"
                                End If
                                BulletinHeader = "FORM O"
                                If optEnableCNSpecificOptions Then
                                    Dim Bulletin() As String = sb.FlagData.Split("|")
                                    BulletinHeader = Bulletin(0)
                                End If
                                BulletinBody = " (" & sb.BullUID & ") (" & (Format(sb.EffectTime, optBulletinSystemDateTimeFormat) & ") (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & optBulletinString2 & sb.MilePostEndPrefix & sb.MilePostEnd & sb.MilePostEndSuffix & ")")
                            End If

                        Case "FORM F"
                            BulletinHeader = "INFORMATIONAL"
                            BulletinBody = " (" & sb.BullUID & ") (" & (Format(sb.EffectTime, optBulletinSystemDateTimeFormat) & ") (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & optBulletinString2 & sb.MilePostEndPrefix & sb.MilePostEnd & sb.MilePostEndSuffix & ")")

                        Case "FORM X"
                            BulletinHeader = "CROSSING PROTECTION"
                            BulletinBody = " (" & sb.BullUID & ") (" & (Format(sb.EffectTime, optBulletinSystemDateTimeFormat) & ") (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & "-" & sb.CrossingName & ")")
                            If (optEnableDenverSpecificOptions) Then
                                BulletinHeader = "Form-C "
                                BulletinBody = " (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & "-" & sb.CrossingName & ")" & sb.CrossingDOT
                            ElseIf optEnableCNSpecificOptions Then
                                BulletinHeader = "CROSSING PROTECTION"
                                BulletinBody = " (" & sb.BullUID & ") (" & (Format(sb.EffectTime, optBulletinSystemDateTimeFormat) & ") (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & "-" & sb.CrossingName & ")")
                                BulletinBody = BulletinBody & vbCrLf & "(" & sb.CrossingProtectionItem & ")"
                                'sb.CrossingProtectionItem
                            End If
                        Case "FORM S"
                            BulletinHeader = "SLIDE ZONE"
                            BulletinBody = " (" & sb.BullUID & ") (" & (Format(sb.EffectTime, optBulletinSystemDateTimeFormat) & ") (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & optBulletinString2 & sb.MilePostEndPrefix & sb.MilePostEnd & sb.MilePostEndSuffix & ")")

                        Case "FORMTC"
                            BulletinHeader = "TRACK CONDITION"
                            BulletinBody = " (" & sb.BullUID & ") (" & (Format(sb.EffectTime, optBulletinSystemDateTimeFormat) & ") (" & sb.MilePostBeginPrefix.Trim & sb.MilePostBegin & sb.MilePostBeginSuffix.Trim & optBulletinString2 & sb.MilePostEndPrefix & sb.MilePostEnd & sb.MilePostEndSuffix & ")")

                    End Select
                    If BulletinHeader.Trim <> "" Then
                        tt.Append("(" & optBulletinString1 & ": ")
                        tt.Append(BulletinHeader)
                        tt.Append(")")
                        tt.Append(BulletinBody)
                        tt.Append(vbCrLf)
                    End If
                Next
                Return tt.ToString

            Catch ex As Exception
                SystemException(ex.ToString)
                Return String.Empty
            End Try
        End Function
