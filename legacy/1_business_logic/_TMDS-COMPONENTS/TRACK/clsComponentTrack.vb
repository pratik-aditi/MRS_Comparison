                                    End If
                                End If
                            Next
                        End If
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                messageList = Nothing
                If frmReadRepeat IsNot Nothing Then frmReadRepeat.Dispose()
                frmReadRepeat = Nothing
