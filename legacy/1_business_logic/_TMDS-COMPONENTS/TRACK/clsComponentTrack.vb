        Public Overrides Sub InitAuthorityNumbers()
            Dim OkToShowAuthNumbers As Boolean = False
            Try
                If optEnableCPSpecificOptions Then
                    If Mid(Me.AuthorityType, 1, 3) = "TWC" Then OkToShowAuthNumbers = True
                Else
                    If Mid(Me.AuthorityType, 1, 3) = "TWC" AndAlso Not Me.NonTransverable Then OkToShowAuthNumbers = True
                End If


                'If Mid(Me.AuthorityType, 1, 3) = "TWC" And Not Me.NonTransverable Then
                If OkToShowAuthNumbers Then ' Added Based on CP RMT-541. CP want to see AuthNumber eventhough the track is NonTransversable... :)
                    Dim Left As Single = LX - 1
                    Dim Top As Single = LY + 9
                    Dim AuthText As AuthNumberText
                    Dim warr As Warrant

                    AuthNumberTextCollection.Clear()
                    InvalidateAuthNumberRegion()
                    If Authorities.Count > 0 And CanDisplayAuthNumbers Then
                        For Each warr In Authorities
                            AuthText = New AuthNumberText()
                            AuthText.Graphical = Graphical
                            AuthText.Top = Top
                            AuthText.Left = Left
                            AuthText.Name = warr.WarrantNumber.ToString
                            If (warr.WarrantType = "ItemFourToMOW") Or (warr.WarrantType = "ItemFourToTrain") Then
                                AuthText.Name = AuthText.Name & "<>"
                            Else
                                If warr.Direction = "LEFT" Then
                                    AuthText.Name = AuthText.Name & "<"
                                ElseIf warr.Direction = "RIGHT" Then
                                    AuthText.Name = AuthText.Name & ">"
                                End If
                            End If

                            AuthText.BuildGraphics()
                            AuthNumberTextCollection.Add(AuthText)
                            Top = Top + 9
                            AuthText.Graphical = Nothing
                        Next
                    End If
                    warr = Nothing

                    Dim sfa As SFAuthority
                    If Me.TrackAuthorities.Count > 0 And CanDisplayAuthNumbers Then
                        For Each sfa In TrackAuthorities
                            AuthText = New AuthNumberText()
                            AuthText.Graphical = Graphical
                            Dim Filler As Integer
                            Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(Me.LeftLink)
                            If Not IsNothing(sw) Then
                                Filler = 5
                            End If
                            AuthText.Top = Top
                            AuthText.Left = Left + Filler
                            AuthText.Name = sfa.AuthorityUID
                            If (sfa.AuthType1 = "ItemFourToMOW") Or (sfa.AuthType1 = "ItemFourToTrain") Or (sfa.AuthType2 = "ItemFourToTrain" And sfa.Components1.Contains(Me)) Then
                                AuthText.Name = AuthText.Name & "<>"
                            Else
                                If sfa.Direction = "LEFT" Then
                                    AuthText.Name = AuthText.Name & "<"
                                ElseIf sfa.Direction = "RIGHT" Then
                                    AuthText.Name = AuthText.Name & ">"
                                End If
                            End If
                            AuthText.BuildGraphics()
                            AuthNumberTextCollection.Add(AuthText)
                            Top = Top + 9
                            AuthText.Graphical = Nothing
                        Next
                    End If
                Else
                    AuthNumberTextCollection.Clear()
                    InvalidateAuthNumberRegion()

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

