        Public Sub DeviceSelectMode()
            Try
                Dim Message As String = String.Empty
                Message = Message & "GUID=" & Me.GUID.ToString
                Message = Message & vbCrLf & "NAME=" & Me.Name.ToUpper
                Message = Message & vbCrLf & "TRACK-NAME=" & Me.TrackName.ToUpper
                Message = Message & vbCrLf & "LEFT-LIMITS=" & Me.LeftLimitName.ToUpper
                Message = Message & vbCrLf & "RIGHTLIMITS=" & Me.RightLimitName.ToUpper
                Message = Message & vbCrLf & "BLOCK-ABSOLUTE=" & Me.BlockAbsolute.ToString.ToUpper
                Message = Message & vbCrLf & "BLOCKED-DEVICE=" & Me.DeviceBlocked.ToString.ToUpper
                Message = Message & vbCrLf & "FlashComponent=" & Me.FlashComponent.ToString.ToUpper
                Message = Message & vbCrLf & "FlashON=" & Me.FlashOn.ToString.ToUpper
                Message = Message & vbCrLf & "SIGNAL-STATUS=" & Me.SignalStatOnMe.ToString
                Message = Message & vbCrLf & "RIGHT-MP-LIMITS=" & Me.RightLimitMilePost.ToString
                Message = Message & vbCrLf & "LEFT-MP-LIMITS=" & Me.LeftLimitMilePost.ToString
                Message = Message & vbCrLf & "TRAFFIC=" & Me.TrafficDirection
                Message = Message & vbCrLf & "OS REPORTING=" & Me.OSReporting
                Message = Message & vbCrLf & "LeftLink=" & Me.LeftLink
                Message = Message & vbCrLf & "RightLink=" & Me.RightLink

                Message = Message & vbCrLf & "LeftAltLink=" & Me.LeftAltLink
                Message = Message & vbCrLf & "AltLinkOne=" & Me.AltLinkOne
                Message = Message & vbCrLf & "AltLinkThree=" & Me.AltLinkThree
                Message = Message & vbCrLf & "RightAltLink=" & Me.RightAltLink
                Message = Message & vbCrLf & "AltLinkTwo=" & Me.AltLinkTwo
                Message = Message & vbCrLf & "AltLinkFour=" & Me.AltLinkFour

                If Me.IsLinkToRemoteTrack Then
                    If Not IsNothing(Me.myRemoteConnection) Then
                        Dim socketAddress As SocketAddress = Me.myRemoteConnection.myEndPoint.Serialize

                        Message = Message & vbCrLf & "REMOTE ENDPOINT=" & socketAddress.ToString
                    Else
                        Message = Message & vbCrLf & "remoteIPADRESS= NOTHING"
                    End If
                End If

                If Me.OStype Then
                    Message = Message & vbCrLf & "TRAINIDPLACE=" & Me.TrainIDPlace.ToString
                    Message = Message & vbCrLf & "OSREPORTING=" & Me.OSReporting.ToString
                    Message = Message & vbCrLf & "SLOTTINGTRACK=" & Me.SlottingTrack.ToString
                    Dim mySignals As String = String.Empty
                    If Not IsNothing(Me.SignalSlotCollection) Then
                        Dim sig As Signal
                        For Each sig In Me.SignalSlotCollection
                            mySignals = mySignals & vbTab & sig.Name & "-" & sig.GUID & vbCrLf
                        Next
                        Message = Message & vbCrLf & "SIGNAL TO BE SLOTTED ON OS TRACK:" & vbCrLf & mySignals
                    End If

                End If
                MessageBox.Show(Message, "TRACK INFORMATION", MessageBoxButtons.OK, MessageBoxIcon.Information)


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

