        Overrides Sub InitializeGraphicsFromScreenCoordinates()
            Dim TrackWidth As Integer = 9

            'Set the position of the Control Drawing Area
            Me.Left = LX
            If RY < LY Then
                Me.Top = RY
            Else
                Me.Top = LY
            End If

            Me.Width = Math.Abs(RX - LX)
            Me.Height = Math.Abs(RY - LY) + TrackWidth
            'CHECK TO SEE IF THIS IS A VERTICAL TRACK
            If Me.Width = 0 Then
                Me.Width = TrackWidth
            End If


            'Set the Relative coordinates in the control from the screen coords
            rLx = 0
            If RY < LY Then
                rLy = Math.Abs(LY - RY)
            Else
                rLy = 0
            End If

            rRx = Math.Abs(RX - LX)
            If RY < LY Then
                rRy = 0
            Else
                rRy = Math.Abs(RY - LY)
            End If

        End Sub

        Public Overloads Sub RefreshPathTurnOutTrack(ByVal TurnOutType As String)
            Try
                Dim TrackWidth As Integer = 5
                Dim TrackGap As Integer
                Me.Visible = False


                ''** Set graphical path for track without traffic
                gPath = New GraphicsPath()
                Dim pt1 As New Point()
                Dim pt2 As New Point()
                Dim pt3 As New Point()
                Dim pt4 As New Point()
                Dim pt5 As New Point()
                Dim pt6 As New Point()

                If (rLy > rRy) And (rLx <> rRx) And (rLx < rRx) And TurnOutType = "SPRT" Then
                    'These points draw a line like this:
                    '    /--
                    '   /
                    '  /
                    '-----------
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx - 12, rRy)
                    pt3 = New Point(rRx, rRy)
                    pt4 = New Point(rRx, rRy + TrackWidth) ' - TrackGap)
                    pt5 = New Point(rRx - 10, rRy + TrackWidth)
                    pt6 = New Point(rLx + TrackWidth, rLy)
                    CanDisplayAuthNumbers = False
                ElseIf (rLy < rRy) And (rLx <> rRx) And (rLx < rRx) And TurnOutType = "SPLT" Then
                    'These points draw a line like this:
                    '-- \
                    '    \
                    '     \
                    '-------------
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rLx + 12, rLy)
                    pt3 = New Point(rRx, rRy)
                    pt4 = New Point(rRx - TrackWidth, rRy) ' - TrackGap)
                    pt5 = New Point(rLx + 10, rLy + TrackWidth)
                    pt6 = New Point(rLx, rLy + TrackWidth)
                    CanDisplayAuthNumbers = False
                ElseIf (rLy < rRy) And (rLx <> rRx) And (rLx < rRx) And TurnOutType = "SPRB" Then
                    'These points draw a line like this:
                    '-------------
                    '   \
                    '    \
                    '     \--
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx - 12, rRy)
                    pt3 = New Point(rRx, rRy)
                    pt4 = New Point(rRx, rRy - TrackWidth) ' - TrackGap)
                    pt5 = New Point(rRx - 10, rRy - TrackWidth)
                    pt6 = New Point(rLx + TrackWidth, rLy)
                    CanDisplayAuthNumbers = False
                ElseIf (rLy > rRy) And (rLx <> rRx) And (rLx < rRx) And TurnOutType = "SPLB" Then
                    'These points draw a line like this:
                    '-------------
                    '    /
                    '   /
                    '  /
                    '--
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rLx + 12, rLy)
                    pt3 = New Point(rRx, rRy)
                    pt4 = New Point(rRx - TrackWidth, rRy) ' - TrackGap)
                    pt5 = New Point(rLx + 10, rLy - TrackWidth)
                    pt6 = New Point(rLx, rLy - TrackWidth)
                    CanDisplayAuthNumbers = False
                    'Else
                Else
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx, rRy - TrackGap)
                    pt3 = New Point(rRx + TrackWidth, rRy - TrackGap)
                    pt4 = New Point(rLx + TrackWidth, rLy)
                End If
                ''**********************************************************************************************************
                gPath.StartFigure()
                gPath.AddLine(pt1, pt2)
                gPath.AddLine(pt2, pt3)
                gPath.AddLine(pt3, pt4)
                gPath.AddLine(pt4, pt5)
                gPath.AddLine(pt5, pt6)
                gPath.AddLine(pt6, pt1)
                gPath.CloseFigure()
                pDefaultPath = gPath
                GraphicalPath = pDefaultPath
                Me.GraphicalPath = gPath

                Me.Region = New Region(GraphicalPath)
                'Me.Left = Me.Left * 0.8
                'Me.Top = Me.Top * 0.858
                pt1 = Nothing
                pt2 = Nothing
                pt3 = Nothing
                pt4 = Nothing

                Graphical.PixelOffsetMode = PixelOffsetMode.HighQuality
                Graphical.SmoothingMode = SmoothingMode.HighQuality

                'build paths for bitmap imaging
                Me.GraphicalPathRelative = gPath.Clone

                Dim mat As New Matrix()
                Dim NewLY As Integer
                If RY < LY Then
                    NewLY = RY
                Else
                    NewLY = LY
                End If
                mat.Translate(Me.LX, NewLY)
                GraphicalPathRelative.Transform(mat)
                DefaultPathRelative = GraphicalPathRelative.Clone
                'Me.LTrafficGraphicPathRelative.Transform(mat)
                'Me.RLTrafficPathRelative.Transform(mat)
                'Me.RTrafficGraphicPathRelative.Transform(mat)


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Overloads Sub RefreshPath()
            Dim ForceDisableAuthnumber As Boolean = False
            Dim LikeTracksColl As New ArrayList
            Dim LikeTracksComp As Track = Nothing
            Try
                Dim TrackWidth As Integer = 9
                Dim Trackindex As Integer = Index
                Me.Visible = False
                'GENERATE a gap in the track for visuals if appropriate
                Dim TrackGap As Integer
                If Me.SPMTrack Then
                    TrackWidth = 5
                Else
                    TrackGap = GetTrackGap(Trackindex, TrackComponent(Trackindex).RightLink)
                End If

                If optShowOneAuthorityNumberPerSPMSwitch AndAlso Mid(Me.AuthorityType, 1, 3) = "TWC" AndAlso Me.GUID > 0 Then
                    Me.FindLikeTracks(LikeTracksColl, TrackCollection)
                    If Not LikeTracksColl Is Nothing AndAlso LikeTracksColl.Count > 1 Then
                        Dim AuthNoEnabled As Boolean = False
                        For Each LikeTracksComp In LikeTracksColl
                            LikeTracksComp.BelongToSPMCollection = True
                            If LikeTracksComp.AuthorityNumberDisplayedOnMe Then
                                AuthNoEnabled = True
                            End If
                        Next
                        If AuthNoEnabled Then
                            ForceDisableAuthnumber = True
                        Else
                            Me.AuthorityNumberDisplayedOnMe = True
                        End If
                    End If
                End If


                Dim LeftLinkType As String = String.Empty
                Dim RightLinkType As String = String.Empty

                Dim LeftSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(TrackComponent(Trackindex).LeftLink)
                Dim RightSw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(TrackComponent(Trackindex).RightLink)
                Dim RightSwPntMonitor As Boolean
                Dim LeftSwPntMonitor As Boolean
                If Not IsNothing(LeftSw) Then
                    LeftLinkType = "S"
                    LeftSwPntMonitor = LeftSw.NonOperationSwitchPointMonitor
                End If
                If Not IsNothing(RightSw) Then
                    RightLinkType = "S"
                    RightSwPntMonitor = RightSw.NonOperationSwitchPointMonitor
                End If

                'Dim LeftLinkType As String = FindComponentType(TrackComponent(Trackindex).LeftLink)
                'Dim RightLinkType As String = FindComponentType(TrackComponent(Trackindex).RightLink)

                ''** Set graphical path for track without traffic
                gPath = New GraphicsPath()
                Dim pt1 As New Point()
                Dim pt2 As New Point()
                Dim pt3 As New Point()
                Dim pt4 As New Point()

                If (rLy > rRy) And (rLx <> rRx) And (rLx < rRx) And LeftLinkType = "S" Then
                    'These points draw a line like this:
                    '    /--
                    '   /
                    '  /
                    '-----------
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx - TrackGap, rRy)
                    pt3 = New Point(rRx - TrackGap, rRy + TrackWidth)
                    pt4 = New Point(rLx + TrackWidth, rLy)
                    CanDisplayAuthNumbers = False
                ElseIf (rLy < rRy) And (rLx <> rRx) And (rLx < rRx) And RightLinkType = "S" Then
                    'These points draw a line like this:
                    '-- \
                    '    \
                    '     \
                    '-------------
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx, rRy)  '- TrackGap)
                    pt3 = New Point(rRx - TrackWidth, rRy) ' - TrackGap)
                    pt4 = New Point(rLx, rLy + TrackWidth)
                    CanDisplayAuthNumbers = False
                ElseIf (rLy < rRy) And (rLx <> rRx) And (rLx < rRx) And LeftLinkType = "S" Then
                    'These points draw a line like this:
                    '-------------
                    '   \
                    '    \
                    '     \--
                    pt1 = New Point(rLx + TrackWidth, rLy + TrackWidth)
                    pt2 = New Point(rRx, rRy)  '- TrackGap)
                    pt3 = New Point(rRx, rRy + TrackWidth)  ' - TrackGap)
                    pt4 = New Point(rLx, rLy + TrackWidth)
                    CanDisplayAuthNumbers = False
                ElseIf (rLy > rRy) And (rLx <> rRx) And (rLx < rRx) And RightLinkType = "S" Then
                    'These points draw a line like this:
                    '-------------
                    '    /
                    '   /
                    '  /
                    '--
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx - TrackWidth, rRy + TrackWidth)
                    pt3 = New Point(rRx, rRy + TrackWidth)
                    pt4 = New Point(rLx, rLy + TrackWidth)
                    CanDisplayAuthNumbers = False
                    'Else
                ElseIf (rLy < rRy) And (rLx <> rRx) And (rLx < rRx) And RightLinkType = "T" Then
                    Dim RightComp As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(TrackComponent(Trackindex).RightLink)
                    Dim rGap, lGap As Integer
                    If Not RightComp Is Nothing Then
                        If RightComp.rLx = RightComp.rRx Or RightComp.rLy = RightComp.rRy Then
                            rGap = 1
                        Else
                            rGap = 0
                        End If
                    End If

                    Dim LeftComp As Object = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(TrackComponent(Trackindex).LeftLink)
                    If Not LeftComp Is Nothing Then
                        If LeftComp.Ly <> LeftComp.Ry Then
                            'lGap = -1
                        Else
                            'lGap = 0
                        End If
                    End If
                    'These points draw a line like this:
                    '-- \
                    '    \
                    '     \
                    '     |
                    '     |

                    'OR like this

                    '  |
                    '  |
                    '  \
                    '   \
                    '    \------

                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx - rGap, rRy - rGap)
                    pt3 = New Point(rRx - rGap, rRy + TrackWidth)
                    pt4 = New Point(rLx + lGap, rLy + TrackWidth)
                    CanDisplayAuthNumbers = False

                ElseIf (rLy > rRy) And (rLx <> rRx) And (rLx < rRx) And RightLinkType = "T" Then
                    Dim RightComp As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(TrackComponent(Trackindex).RightLink)
                    Dim rGap, lGap As Integer
                    If Not RightComp Is Nothing Then
                        If RightComp.rLx = RightComp.rRx Or RightComp.rLy = RightComp.rRy Then
                            rGap = 1
                        Else
                            rGap = 0
                        End If
                    End If

                    Dim LeftComp As Object = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(TrackComponent(Trackindex).LeftLink)
                    If Not LeftComp Is Nothing Then
                        If LeftComp.Ly <> LeftComp.Ry Then
                            'lGap = -1
                        Else
                            'lGap = 0
                        End If
                    End If
                    'These points draw a line like this:
                    '     |
                    '    /
                    '   /
                    '-- 


                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx - rGap, rRy - rGap)
                    pt3 = New Point(rRx - rGap, rRy + TrackWidth)
                    pt4 = New Point(rLx + lGap, rLy + TrackWidth)
                    CanDisplayAuthNumbers = False

                ElseIf Math.Abs((rRy - rLy) / (rRx - rLx)) <= 1 Then
                    'This draws a horizontal line
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx - TrackGap, rRy)
                    pt3 = New Point(rRx - TrackGap, rRy + TrackWidth)
                    pt4 = New Point(rLx, rLy + TrackWidth)

                    ''**********************************************************************************************************
                    ''**** This is to draw the angle in the track when it hooks to a switch and requires an angle for the turnout
                    ''**********************************************************************************************************
                    Dim SwitchIndex As Integer
                    Dim TurnOutTrackIndex As Integer

                    'Passing the Tracks rightlink GUID into this function to see if it is linked to a switch on the right
                    If RightLinkType = "S" Then
                        'find the switches component index
                        SwitchIndex = FindSwitchIndexFromGUID(TrackComponent(Trackindex).RightLink)
                        If SwitchIndex <> 0 Then
                            'See if the turnout is a right alternative link, if not do not worry about angle of track for turnout
                            If SwitchComponent(SwitchIndex).LeftAltLink <> 0 Then
                                'if switch is right alt link then see if it is right or left turnout
                                TurnOutTrackIndex = FindTrackIndexFromGUID(SwitchComponent(SwitchIndex).LeftAltLink)
                                If TurnOutTrackIndex <> 0 AndAlso SwitchComponent(SwitchIndex).LX > TrackComponent(TurnOutTrackIndex).rLx Then
                                    If SwitchComponent(SwitchIndex).LY > TrackComponent(TurnOutTrackIndex).rLy Then
                                        'draws angle on track for a trailing left turn switch looking from trailing end
                                        pt1 = New Point(rLx, rLy)
                                        pt2 = New Point(rRx - TrackWidth, rRy)
                                        pt3 = New Point(rRx, rRy + TrackWidth)
                                        pt4 = New Point(rLx, rLy + TrackWidth)
                                        'CanDisplayAuthNumbers = False
                                    Else
                                        'draws angle on track for a trailing right turn switch looking from trailing end
                                        pt1 = New Point(rLx, rLy)
                                        pt2 = New Point(rRx, rRy)
                                        pt3 = New Point(rRx - TrackWidth, rRy + TrackWidth)
                                        pt4 = New Point(rLx, rLy + TrackWidth)
                                        CanDisplayAuthNumbers = True
                                        'CHANGED
                                    End If

                                End If
                            End If
                        End If
                        'End If
                        If ForceDisableAuthnumber Then CanDisplayAuthNumbers = False




                        'Passing the Tracks leftlink GUID into this function to see if it is linked to a switch on the link

                    ElseIf LeftLinkType = "S" Then
                        If (RightSwPntMonitor Or LeftSwPntMonitor) Then
                            CanDisplayAuthNumbers = True
                        Else
                            CanDisplayAuthNumbers = False
                        End If
                        If ForceDisableAuthnumber Then CanDisplayAuthNumbers = False
                        SwitchIndex = FindSwitchIndexFromGUID(TrackComponent(Trackindex).LeftLink)
                        If SwitchIndex <> 0 Then
                            'See if the turnout is a right alternative link, if not do not worry about angle of track for turnout
                            If SwitchComponent(SwitchIndex).RightAltLink <> 0 Then
                                'if switch is right alt link then see if it is right or left turnout
                                TurnOutTrackIndex = FindTrackIndexFromGUID(SwitchComponent(SwitchIndex).RightAltLink)
                                If TurnOutTrackIndex <> 0 AndAlso SwitchComponent(SwitchIndex).LX < TrackComponent(TurnOutTrackIndex).rRx Then
                                    If SwitchComponent(SwitchIndex).LY < TrackComponent(TurnOutTrackIndex).rRy Then
                                        'draws angle on track for a facing right turn switch
                                        pt1 = New Point(rLx, rLy)
                                        pt2 = New Point(rRx - TrackGap, rRy)
                                        pt3 = New Point(rRx - TrackGap, rRy + TrackWidth)
                                        pt4 = New Point(rLx + TrackWidth, rLy + TrackWidth)
                                        CanDisplayAuthNumbers = False
                                    Else
                                        'draws angle on track for a facing left turn switch
                                        pt1 = New Point(rLx + TrackWidth, rLy)
                                        pt2 = New Point(rRx - TrackGap, rRy)
                                        pt3 = New Point(rRx - TrackGap, rRy + TrackWidth)
                                        pt4 = New Point(rLx, rLy + TrackWidth)
                                        CanDisplayAuthNumbers = False
                                    End If
                                End If
                            End If
                        End If
                        'End If

                        'Passing the Tracks rightlink GUID into this function to see if it is linked to a switch on the right and the left

                    ElseIf RightLinkType = "S" And LeftLinkType = "S" Then
                        'find the switches component index
                        SwitchIndex = FindSwitchIndexFromGUID(TrackComponent(Trackindex).RightLink)
                        If SwitchIndex <> 0 Then
                            'See if the turnout is a right alternative link, if not do not worry about angle of track for turnout
                            If SwitchComponent(SwitchIndex).LeftAltLink <> 0 Then
                                'if switch is right alt link then see if it is right or left turnout
                                TurnOutTrackIndex = FindTrackIndexFromGUID(SwitchComponent(SwitchIndex).LeftAltLink)
                                If TurnOutTrackIndex <> 0 AndAlso SwitchComponent(SwitchIndex).LX > TrackComponent(TurnOutTrackIndex).rLx Then
                                    If SwitchComponent(SwitchIndex).LY > TrackComponent(TurnOutTrackIndex).rLy Then
                                        If SwitchComponent(SwitchIndex).LX <= TrackComponent(TurnOutTrackIndex).rRx Then
                                            If SwitchComponent(SwitchIndex).LY <= TrackComponent(TurnOutTrackIndex).rRy Then
                                                'draws angle on track for a trailing left turn switch looking from trailing end
                                                pt1 = New Point(rLx + TrackWidth, rLy)
                                                pt2 = New Point(rRx - TrackWidth, rRy)
                                                pt3 = New Point(rRx, rRy + TrackWidth)
                                                pt4 = New Point(rLx, rLy + TrackWidth)
                                                CanDisplayAuthNumbers = False
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    Else

                    End If
                Else
                    pt1 = New Point(rLx, rLy)
                    pt2 = New Point(rRx, rRy - TrackGap)
                    pt3 = New Point(rRx + TrackWidth, rRy - TrackGap)
                    pt4 = New Point(rLx + TrackWidth, rLy)
                End If
                ''**********************************************************************************************************
                gPath.StartFigure()
                gPath.AddLine(pt1, pt2)
                gPath.AddLine(pt2, pt3)
                gPath.AddLine(pt3, pt4)
                gPath.AddLine(pt4, pt1)
                gPath.CloseFigure()
                pDefaultPath = gPath
                GraphicalPath = pDefaultPath
                Me.GraphicalPath = gPath

                Me.Region = New Region(GraphicalPath)
                'Me.Left = Me.Left * 0.8
                'Me.Top = Me.Top * 0.858
                pt1 = Nothing
                pt2 = Nothing
                pt3 = Nothing
                pt4 = Nothing

                ''** Set graphical path for left traffic on track
                Dim gLeftTraffic As New GraphicsPath()
                Dim LeftAdjustment As Integer
                If LeftSwPntMonitor Then
                    LeftAdjustment = 8
                End If
                Dim pt5 As New Point(rLx + LeftAdjustment, rLy + 3)
                Dim pt6 As New Point(rLx + 6 + LeftAdjustment, rLy - 0)
                'Dim pt7 As New Point(rlx + 6, rly + 0)
                Dim pt8 As New Point(rRx - TrackGap, rRy)
                Dim pt9 As New Point(rRx - TrackGap, rRy + 9)
                Dim pt10 As New Point(rLx + 6 + LeftAdjustment, rLy + 9)
                'Dim pt11 As New Point(rlx + 6, rly + 9)
                Dim pt12 As New Point(rLx + LeftAdjustment, rLy + 6)
                gLeftTraffic.ClearMarkers()
                gLeftTraffic.StartFigure()
                gLeftTraffic.AddLine(pt5, pt6)
                gLeftTraffic.AddLine(pt6, pt8) ' new
                'gLeftTraffic.AddLine(pt6, pt7)
                'gLeftTraffic.AddLine(pt7, pt8)
                gLeftTraffic.AddLine(pt8, pt9)
                gLeftTraffic.AddLine(pt9, pt10)
                gLeftTraffic.AddLine(pt10, pt12) 'new
                'gLeftTraffic.AddLine(pt10, pt11)
                'gLeftTraffic.AddLine(pt11, pt12)
                gLeftTraffic.AddLine(pt12, pt5)
                gLeftTraffic.CloseFigure()
                LeftTrafficPath = gLeftTraffic
                'gLeftTraffic.Dispose()


                ''** Set graphical path for right traffic on track
                ''** Set graphical path for left traffic on track
                Dim gRightTraffic As New GraphicsPath()
                Dim RightAdjustment As Integer
                If RightSwPntMonitor Then
                    RightAdjustment = 8
                End If

                Dim pt20 As New Point(rLx, rLy)
                Dim pt21 As New Point(rRx - 6 - TrackGap - RightAdjustment, rRy - 0)
                Dim pt22 As New Point(rRx - TrackGap - RightAdjustment, rRy + 4)
                Dim pt23 As New Point(rRx - TrackGap - RightAdjustment, rRy + 5)
                Dim pt24 As New Point(rRx - 7 - TrackGap - RightAdjustment, rRy + 9)
                Dim pt25 As New Point(rLx, rLy + 9)
                gRightTraffic.ClearMarkers()
                gRightTraffic.StartFigure()
                gRightTraffic.AddLine(pt20, pt21)
                gRightTraffic.AddLine(pt21, pt22)
                gRightTraffic.AddLine(pt22, pt23)
                gRightTraffic.AddLine(pt23, pt24)
                gRightTraffic.AddLine(pt24, pt25)
                gRightTraffic.AddLine(pt25, pt20)
                gRightTraffic.CloseFigure()
                RightTrafficPath = gRightTraffic

                ''** Set graphical path for right-left traffic on track
                Dim gLRTraffic As New GraphicsPath()
                Dim pt30 As New Point(rLx, rLy + 3)
                Dim pt31 As New Point(rLx + 6, rLy)
                Dim pt32 As New Point(rRx - 6 - TrackGap, rRy - 0)
                Dim pt33 As New Point(rRx - TrackGap, rRy + 4)
                Dim pt34 As New Point(rRx - TrackGap, rRy + 5)
                Dim pt35 As New Point(rRx - 6 - TrackGap, rRy + 9)
                Dim pt36 As New Point(rLx + 7, rLy + 9)
                Dim pt37 As New Point(rLx, rLy + 6)
                gLRTraffic.ClearMarkers()
                gLRTraffic.StartFigure()
                gLRTraffic.AddLine(pt30, pt31)
                gLRTraffic.AddLine(pt31, pt32)
                gLRTraffic.AddLine(pt32, pt33)
                gLRTraffic.AddLine(pt33, pt34)
                gLRTraffic.AddLine(pt34, pt35)
                gLRTraffic.AddLine(pt35, pt36)
                gLRTraffic.AddLine(pt36, pt37)
                gLRTraffic.AddLine(pt37, pt30)
                gLRTraffic.CloseFigure()
                RLTrafficPath = gLRTraffic
                pt5 = Nothing
                pt6 = Nothing
                pt8 = Nothing
                pt9 = Nothing
                pt12 = Nothing
                pt20 = Nothing
                pt21 = Nothing
                pt22 = Nothing
                pt23 = Nothing
                pt24 = Nothing
                pt25 = Nothing
                pt30 = Nothing
                pt31 = Nothing
                pt32 = Nothing
                pt33 = Nothing
                pt34 = Nothing
                pt35 = Nothing
                pt36 = Nothing
                pt37 = Nothing

                Graphical.PixelOffsetMode = PixelOffsetMode.HighQuality
                Graphical.SmoothingMode = SmoothingMode.HighQuality

                'build paths for bitmap imaging
                Me.GraphicalPathRelative = gPath.Clone
                Me.LTrafficGraphicPathRelative = gLeftTraffic.Clone
                Me.RLTrafficPathRelative = gLRTraffic.Clone
                Me.RTrafficGraphicPathRelative = gRightTraffic.Clone

                Dim mat As New Matrix()
                Dim NewLY As Integer
                If RY < LY Then
                    NewLY = RY
                Else
                    NewLY = LY
                End If
                mat.Translate(Me.LX, NewLY)
                GraphicalPathRelative.Transform(mat)
                DefaultPathRelative = GraphicalPathRelative.Clone
                Me.LTrafficGraphicPathRelative.Transform(mat)
                Me.RLTrafficPathRelative.Transform(mat)
                Me.RTrafficGraphicPathRelative.Transform(mat)

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                LikeTracksColl = Nothing
                LikeTracksComp = Nothing
            End Try
        End Sub

        Private Sub InitializeTrackSpeeds()
            Try
                Me.TrackSpeeds = New ArrayList()
                Dim data() As String = Me.TrackSpeedString.Split("|")
                Dim chr As String
                For Each chr In data
                    TrackSpeeds.Add(chr)
                Next

            Catch
            End Try
        End Sub

        Overloads Sub BuildGraphics()
            Try
                If optInitializeTrackSpeeds Then
                    InitializeTrackSpeeds()
                End If
                Me.InitializeGraphicsFromScreenCoordinates()
                RefreshPath()
                Refresh()
                Me.Graphical = Me.CreateGraphics
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Overrides Sub InitGraphics()
            Try

                Select Case AuthorityType

                    Case "CTC"
                        If Me.Indicating Then
                            CurrentColorStatus = gColorTrackDefault
                        Else
                            CurrentColorStatus = New SolidBrush(Color.Gray)  'ADDED FOR CTC DEVELOPMENT
                        End If
                    Case "CTC-OTHER", "CTC-PSEUD"
                        If Me.Indicating Then
                            CurrentColorStatus = gColorTrackDefault  'ADDED FOR CTC DEVELOPMENT
                        Else
                            CurrentColorStatus = New SolidBrush(Color.Gray)  'ADDED FOR CTC DEVELOPMENT
                        End If

                    Case "YL", "RL", "OTHER"
                        If Me.Indicating Then
                            CurrentColorStatus = gColorTrackDefault
                        Else
                            CurrentColorStatus = New SolidBrush(Color.SlateGray)  'ADDED FOR CTC DEVELOPMENT
                        End If
                    Case "SHELF"
                        CurrentColorStatus = New SolidBrush(Color.LightSlateGray)  'ADDED FOR CTC DEVELOPMENT
                        Me.IsShelfTrack = True
                    Case "NON-TWC"
                        CurrentColorStatus = New SolidBrush(Color.DarkGray)
                    Case "TWC"
                        CurrentColorStatus = gColorTrackDefault
                    Case Else
                        CurrentColorStatus = gColorTrackDefault
                End Select

                'Version 227
                If FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                    If Mid(Me.AuthorityType, 1, 3) = "TWC" Then
                        CurrentColorStatus = gColorTrackDefault
                        Me.FailState = False
                    Else
                        CurrentColorStatus = gColorFailedState
                    End If

                End If

                If Me.RemoteLinkShowDown Then 'And Not Me.SimulateMode Then
                    CurrentColorStatus = gColorRemoteLinkDown
                    TrackColorStatus = "47"
                    'Me.FailState = True
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Sub Draw(ByRef g As Graphics)

            Try
                If TrainIDs.Count > 0 Then
                    DrawTrainID()
                End If

                If MOWIDs.Count > 0 Then
                    DrawMOWID()
                End If

                If TrackTagLabels.Count > 0 Then
                    DrawTrackTag()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Overrides Sub UpdateStatus(Optional ByVal objAuthority As Object = Nothing)
            Dim BoxElevenRestrictionFound As Boolean
            Dim BoxEightRestrictionFound As Boolean
            Dim TypeOfAuthority As String = String.Empty
            Dim isTWCSpecialLicense As Boolean = False
            Dim ClearMainTypeAuthority As Boolean
            Dim OverrideFieldBlocking As Boolean = False
            Dim ShowAuthStatusOnNonTransversableTracks As Boolean = False
            Dim loggableWhoCall As String = String.Empty
            Dim toLog As Boolean = False
            Try
                'Log for defect 73970
                loggableWhoCall = (New StackTrace).GetFrame(1).GetMethod.Name.ToString()
                If loggableWhoCall = "MoveTrainIDPlace" Then
                    TrackEventLog("UpdateStatus:Start:WhoCallMe=" & loggableWhoCall)
                    toLog = True
                End If
                'Log for defect #129869
                If Me.GUID = 152101 OrElse Me.GUID = 152180 Then
                    TrackEventLog("UpdateStatus:Start:WhoCallMe=" & (New System.Diagnostics.StackTrace).GetFrame(1).GetMethod.Name)
                End If
                If Me.OverRideCodeBrown And Not gSimulationMode Then
                ElseIf gSimulationMode Then
                    optEnableCTCTAGDispalyonCodeBrown = False
                End If
                If objAuthority IsNot Nothing AndAlso objAuthority.GetType.ToString = gTTComponentName Then
                    OverrideFieldBlocking = objAuthority.OverrideFieldBlocking
                    If OverrideFieldBlocking Then TrackEventLog("FEILD BLOCKING DISABLED BY " & objAuthority.AuthorityType & " UID: " & objAuthority.AuthorityUID)
                ElseIf objAuthority IsNot Nothing AndAlso objAuthority.GetType.ToString = gDBLKComponentName Then
                    OverrideFieldBlocking = objAuthority.OverrideFieldBlocking
                    If OverrideFieldBlocking Then TrackEventLog("FEILD BLOCKING DISABLED BY " & objAuthority.AuthorityType & " UID: " & objAuthority.AuthorityUID)
                End If
                If Me.AuthorityType <> "CTC" And Me.AuthorityType <> "OTHER" And Me.AuthorityType <> "DTC" And Me.AuthorityType <> "CTC-OTHER" Then
                    If AuthorityCounts > 0 And Not gSFAMode Then
                        Dim warr As Warrant
                        Dim FirstWarrant As Warrant
                        FirstWarrant = Authorities(0)
                        TrafficDirection = FirstWarrant.Direction
                        TypeOfAuthority = FirstWarrant.WarrantType
                        LimitsForMOW = False
                        LimitsForTrain = False
                        ActiveTrackWarrant = True
                        For Each warr In Authorities
                            Select Case warr.WarrantType
                                Case "ItemTwoToMOW", "ItemFourToMOW"
                                    LimitsForMOW = True
                                Case "ItemFourToTrain", "ItemTwoToTrain"
                                    LimitsForTrain = True
                                Case Else
                                    LimitsForTrain = True
                                    LimitsForMOW = True
                            End Select
                            'New Box Eleven Restriction Code
                            Dim BoxElevenRestriction As Object
                            For Each BoxElevenRestriction In warr.BoxElevenComponents
                                If BoxElevenRestriction Is Me Then
                                    BoxElevenRestrictionFound = True
                                End If
                            Next
                            'New Box Eleven Restriction Code
                        Next
                        'New Box Eleven Restriction Code
                        If BoxElevenRestrictionFound Then
                            Me.BoxElevenRestriction = True
                        Else
                            Me.BoxElevenRestriction = False
                        End If
                        'New Box Eleven Restriction Code
                    ElseIf Me.TrackAuthorities.Count > 0 And gSFAMode Then
                        Dim warr As SFAuthority
                        Dim FirstWarrant As SFAuthority
                        FirstWarrant = Me.TrackAuthorities(0)
                        TypeOfAuthority = FirstWarrant.AuthType1
                        'TrafficDirection = FirstWarrant.Direction
                        isTWCSpecialLicense = FirstWarrant.isSpecialLicense
                        LimitsForMOW = False
                        LimitsForTrain = False
                        ActiveTrackWarrant = True
                        If FirstWarrant.CheckBoxItemsStatus(2) Then
                            If optUseClearMainTrackColorOption Then
                                ClearMainTypeAuthority = True
                            End If
                        End If
                        OverRideLimitsForTrain = False
                        If optUseSingleFormAuthorityVersionII Or optUseSingleFormAuthorityVersionCN Or optUseSingleFormAuthorityVersionMRL Or optUseSingleFormAuthorityVersionARRC OrElse optUseSingleFormAuthorityVersionNCTD Then
                            If Me.TrackAuthorities.Count = 1 Then
                                If (FirstWarrant.IssuedToTrain And Not FirstWarrant.ShowItemFourComponents And FirstWarrant.Box4Components.Contains(Me)) Or
                                (FirstWarrant.IssuedToTrain And Not FirstWarrant.ShowItemFourComponents And FirstWarrant.CheckBoxItemsStatus(3) And Not FirstWarrant.CheckBoxItemsStatus(1)) Then
                                    OverRideLimitsForTrain = True
                                    ActiveTrackWarrant = False
                                End If
                            End If
                            If (FirstWarrant.IssuedToTrain And Not FirstWarrant.ShowItemFourComponents And FirstWarrant.Box4Components.Contains(Me)) Or
                            (FirstWarrant.IssuedToTrain And Not FirstWarrant.ShowItemFourComponents And FirstWarrant.CheckBoxItemsStatus(3) And Not FirstWarrant.CheckBoxItemsStatus(1)) Then
                                If Me.TrackAuthorities.Count > 1 Then
                                    Dim NextAuth As SFAuthority = Me.TrackAuthorities(1)
                                    TrafficDirection = NextAuth.Direction
                                End If
                            End If
                        End If

                        For Each warr In Me.TrackAuthorities
                            Select Case warr.AuthType1
                                Case "ItemTwoToMOW", "ItemFourToMOW"
                                    LimitsForMOW = True
                                Case "ItemFourToTrain", "ItemTwoToTrain", "ItemTwoSixToTrain"
                                    If Not OverRideLimitsForTrain Then
                                        LimitsForTrain = True
                                    End If
                                Case Else
                                    If Not OverRideLimitsForTrain Then
                                        LimitsForTrain = True
                                    End If
                                    LimitsForMOW = True
                            End Select

                            Dim BoxEightRestriction As Object
                            For Each BoxEightRestriction In warr.BoxEightRestrictionComponents
                                If BoxEightRestriction Is Me Then
                                    BoxEightRestrictionFound = True
                                End If
                            Next
                        Next

                        'New Box Eleven Restriction Code
                        If BoxEightRestrictionFound Then
                            Me.BoxEightRestriction = True
                        Else
                            Me.BoxEightRestriction = False
                        End If
                        'New Box Eleven Restriction Code

                        'Search against the right link for switches that need to be graphically updated with track occupied
                    Else
                        TrafficDirection = ""
                        ActiveTrackWarrant = False
                        LimitsForTrain = False
                        LimitsForMOW = False
                    End If

                    Dim RightSwitchComponent As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(Me.RightLink)
                    If Not RightSwitchComponent Is Nothing Then
                        RightSwitchComponent.Occuppied = Me.Occuppied
                        If Me.Occuppied Then
                            RightSwitchComponent.SignalStatOnMe = SignalStatus.SignalAtStop
                        End If
                        RightSwitchComponent.TrafficDirection = Me.TrafficDirection
                        If Not RightSwitchComponent.Graphical Is Nothing Then
                            'SyncLock RightSwitchComponent.Graphical
                            If Me.OverRideCodeBrown Then RightSwitchComponent.OverRideCodeBrown = True
                            RightSwitchComponent.UpdateColorStatusOnly()
                            'End SyncLock
                        End If
                    End If
                    Me.BlockAbsolute = False
                    Me.DeviceBlocked = False
                    If Me.DeviceBlocks.Count > 0 Then Me.BlockAbsolute = True : Me.DeviceBlocked = True ': RemotePendingBlock = False
                    If Me.BlockAbsolute <> Me.BlockAbsolutePrevious Then
                        Dim LogThisEvent As New DoEventLogTrack(AddressOf Me.LogTheTrackEvent)
                        LogThisEvent.BeginInvoke(Track.EventTypeTrack.BLK, Nothing, Nothing, Nothing, Nothing)
                        If Me.AllowFieldBlocking Then
                            If Me.BlockAbsolute Then
                                Me.SetFieldBlockingControls(True)
                            Else
                                Me.SetFieldBlockingControls(False)
                            End If
                        End If
                    End If
                    Me.BlockAbsolutePrevious = Me.BlockAbsolute
                ElseIf Me.AuthorityType = "DTC" Then
                    Dim dtc As TrackAuthority.DTCAuthority
                    If Me.Authorities.Count > 0 Then
                        Dim FirstDTC As DTCAuthority = Authorities(0)
                        TrafficDirection = FirstDTC.Direction
                        LimitsForMOW = False
                        LimitsForTrain = False
                        For Each dtc In Authorities
                            If dtc.IssuedToTrain Then
                                LimitsForTrain = True
                            Else
                                LimitsForMOW = True
                            End If
                        Next
                        ActiveTrackWarrant = True
                    End If
                ElseIf Me.AuthorityType = "SHELF" Then
                Else 'CTC TYPE
                    If Me.pNonTransverable AndAlso ((Me.OverRideCodeBrown AndAlso optEnableCTCNonTraversableDispalyonCodeBrown) OrElse optEnableShowStatusUnderNonTransverableTrack) AndAlso Me.TrackAuthorities IsNot Nothing AndAlso Me.TrackAuthorities.Count > 0 Then
                        ShowAuthStatusOnNonTransversableTracks = True
                    End If
                    If Me.Occuppied Then 'CTC Track Indication Bit
                        'If this track is a slotting track, search for signals to put to slot to the stop position
                        'If Me.SlottingTrack Then
                        '    Me.SlotSignalRequests()
                        'End If
                    ElseIf PreviouslyOccuppied And Me.OStype Then
                        'PreviouslyOccuppied = False
                        If Me.SlottingTrack Or Me.OSReporting Then
                            CheckToRemoveOfficeTrafficRoute()
                            If Not IsNothing(Me.OsComponentCollection) AndAlso Me.TrainIDPlace Then
                                Dim comp As Object
                                For Each comp In OsComponentCollection
                                    If Not comp Is Me Then
                                        If comp.GetType.ToString = gTrackComponentName Then
                                            Dim t As Track = CType(comp, Track)
                                            If Not t.TrainIDPlace Then
                                                t.SignalStatOnMe = SignalStatus.SignalAtStop
                                                t.TrafficDirection = ""
                                                t.UpdateStatus()
                                            End If
                                        Else
                                            comp.SignalStatOnMe = SignalStatus.SignalAtStop
                                            comp.TrafficDirection = ""
                                            comp.UpdateStatus()
                                        End If
                                    End If
                                Next
                            End If
                        End If
                    End If

                    'Search against the right link for switches that need to be graphically updated with track occupied
                    Dim RightSwitchComponent As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(Me.RightLink)
                    If Not RightSwitchComponent Is Nothing Then
                        RightSwitchComponent.Occuppied = Me.Occuppied
                        'This was added while Fixing BRC-71 Not sure why, Need to recheck this
                        'If Not Me.Occuppied AndAlso Not Me.NonTransverable Then ' 
                        '    RightSwitchComponent.SignalStatOnMe = Me.SignalStatOnMe
                        'End If
                        'This is OLD Code
                        If Me.Occuppied Then
                            RightSwitchComponent.SignalStatOnMe = SignalStatus.SignalAtStop ' Me.SignalStatOnMe
                        ElseIf Not Me.Occuppied AndAlso Not Me.NonTransverable Then
                            RightSwitchComponent.SignalStatOnMe = Me.SignalStatOnMe
                        End If
                        RightSwitchComponent.TrafficDirection = Me.TrafficDirection
                        If Not RightSwitchComponent.Graphical Is Nothing Then
                            'SyncLock RightSwitchComponent
                            'If Me.OverRideCodeBrown Then RightSwitchComponent.FailState = False
                            If Me.OverRideCodeBrown Then RightSwitchComponent.OverRideCodeBrown = True
                            RightSwitchComponent.UpdateColorStatusOnly()
                            'End SyncLock
                        End If
                    End If

                    SetBlockingStatus()

                    Dim HasSplAuth As Boolean = False
                    Dim splAuth As TrackAuthority.OtherSpecialAuthorityType
                    Me.SpecialAuthorityBlocking = False
                    If optEnablePSSEMTAuthorityNoDeviceBlk Then
                        For Each splAuth In Me.OtherSplAuthorities
                            Me.BlockAbsolute = True
                            If optShwoPSSEMTAuthorityNoDeviceBlkDirection Then Me.TrafficDirection = splAuth.Direction
                            HasSplAuth = True
                        Next
                    ElseIf optEnablePTCBOSVETMSMode AndAlso optEnablePTCOperations Then
                        For Each splAuth In Me.OtherSplAuthorities
                            Me.BlockAbsolute = optEnablePSSEMTAuthorityApplyBlocking
                            Me.TrafficDirection = splAuth.Direction
                            SpecialAuthorityBlocking = True
                            HasSplAuth = True
                        Next
                        If optEnableMRSSpecificOptions Then
                            Dim auth As Object
                            For Each auth In Me.TrackAuthorities
                                If auth.GetType.ToString = "TMDS.TrackAuthority.TrackAuthority" Then
                                    Dim a As TrackAuthority.TrackAuthority = CType(auth, TrackAuthority.TrackAuthority)
                                    If a.IssuedToTrain Then
                                        HasSplAuth = True
                                    End If
                                End If
                            Next
                        End If
                    End If

                    If HasSplAuth AndAlso optEnableCTCTAGDispalyonCodeBrown Then Me.OverRideCodeBrown = True
                    If Me.DeviceBlocks.Count > 0 Then Me.BlockAbsolute = True : Me.DeviceBlocked = True ': RemotePendingBlock = False
                    If Me.LimitsForMOW = True Then

                    End If
                    If Me.BlockAbsolute <> Me.BlockAbsolutePrevious Then
                        Dim LogThisEvent As New DoEventLogTrack(AddressOf Me.LogTheTrackEvent)
                        LogThisEvent.BeginInvoke(Track.EventTypeTrack.BLK, Nothing, Nothing, Nothing, Nothing)
                        If Me.AllowFieldBlocking AndAlso Not OverrideFieldBlocking Then
                            If Me.BlockAbsolute Then
                                Me.SetFieldBlockingControls(True)
                            Else
                                Me.SetFieldBlockingControls(False)
                            End If
                        End If
                    End If
                    Me.BlockAbsolutePrevious = Me.BlockAbsolute

                    'this supports licensing through a flipflop when one exists for MRS operations
                    'MRS-297
                    If optEnableMRSSpecificPTCOperations Then
                        Try
                            If Me.FlipMe Then
                                If Me.TrackAuthorities.Count > 0 Then
                                    Dim ta As TrackAuthority.TrackAuthority = Me.TrackAuthorities.Item(0)
                                    If ta.Direction = "RIGHT" Then
                                        Me.TrafficDirection = "LEFT"
                                    Else
                                        Me.TrafficDirection = "RIGHT"
                                    End If
                                    TrackEventLog("UpdateStatus:FlipMe:AuthDirection=" & ta.Direction)
                                End If
                            End If
                        Catch ex As Exception
                            SystemException(ex.ToString)
                        End Try
                    End If
                    'this supports licensing through a flipflop when one exists for MRS operations
                    'MRS-297
                End If

                'Set the color scheme for the current track condition
                If ActiveTrackWarrant And Not pNonTransverable Then
                    CurrentColorStatus = Nothing
                    TrackColorStatus = "0"
                    If LimitsForTrain And LimitsForMOW And (Not Occuppied And Not OccupancyReminder) Then
                        'CurrentColorStatus = New SolidBrush(Color.Teal)  'light blue/green
                        If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.Teal, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.Teal)
                        TrackColorStatus = "1"
                    ElseIf LimitsForTrain And LimitsForMOW And (Occuppied Or OccupancyReminder) Then
                        'CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128)) 'hot pink
                        If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.FromArgb(255, 0, 128), objAuthority) Else CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "2"
                    ElseIf LimitsForTrain And (Not Occuppied And Not OccupancyReminder) Then
                        If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                            'CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                            If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.LightSeaGreen, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                            TrackColorStatus = "66"
                        Else
                            If Mid(TypeOfAuthority, 1, 7) = "ItemTwo" Then
                                If ClearMainTypeAuthority Then
                                    'CurrentColorStatus = New SolidBrush(Color.Yellow)
                                    If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.Yellow, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.Yellow)
                                    TrackColorStatus = "366"
                                Else
                                    If optUseSFAColorStatusForPTC Then
                                        CurrentColorStatus = GetSFAColorStatusForPTC(Color.Green, objAuthority)
                                    Else
                                        CurrentColorStatus = New SolidBrush(Color.Green)
                                    End If
                                    TrackColorStatus = "3"
                                    If Me.BoxEightRestriction And optShowJointLimitsColor Then
                                        If optUseSFAColorStatusForPTC Then
                                            CurrentColorStatus = GetSFAColorStatusForPTC(Color.DarkOliveGreen, objAuthority)
                                        Else
                                            CurrentColorStatus = New SolidBrush(Color.DarkOliveGreen)
                                        End If
                                        TrackColorStatus = "3"
                                    End If
                                    If isTWCSpecialLicense Then 'Special license for TWC no occupancy
                                        CurrentColorStatus = New SolidBrush(Color.DarkTurquoise)
                                    End If
                                End If
                            Else
                                CurrentColorStatus = New SolidBrush(Color.SpringGreen)
                                If optEnableARRCSpecificOptions AndAlso objAuthority IsNot Nothing Then
                                    If optUseSFAColorStatusForPTC Then
                                        If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.DarkOliveGreen, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.DarkOliveGreen)
                                    End If
                                End If
                                'If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.Teal) Else CurrentColorStatus = New SolidBrush(Color.Teal)
                                TrackColorStatus = "3"
                                If Me.BoxEightRestriction And optShowJointLimitsColor Then
                                    'CurrentColorStatus = New SolidBrush(Color.DarkOliveGreen)
                                    If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.DarkOliveGreen, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.DarkOliveGreen)
                                    TrackColorStatus = "3"

                                End If
                            End If
                        End If
                    ElseIf LimitsForMOW And (Not Occuppied And Not OccupancyReminder) Then
                        If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                            'CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                            If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.LightSeaGreen, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                            TrackColorStatus = "66"
                        Else
                            'CurrentColorStatus = New SolidBrush(Color.Blue)
                            If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.Blue, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.Blue)
                            TrackColorStatus = "4"
                        End If

                    ElseIf LimitsForTrain And (Occuppied Or OccupancyReminder) Then
                        If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                            'CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 255))
                            If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.FromArgb(255, 0, 255), objAuthority) Else CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 255))
                            TrackColorStatus = "17"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.Orange)
                            TrackColorStatus = "5"
                            'If isTWCSpecialLicense Then 'Special license for TWC with occupancy
                            '    CurrentColorStatus = New SolidBrush(Color.DarkViolet)
                            'End If
                        End If
                    ElseIf LimitsForMOW And (Occuppied Or OccupancyReminder) Then
                        'CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 255)) ' magenta
                        If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.FromArgb(255, 0, 255), objAuthority) Else CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 255))
                        TrackColorStatus = "6"
                    Else
                        ' CurrentColorStatus = New SolidBrush(Color.DarkBlue)
                        If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.DarkBlue, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.DarkBlue)
                        TrackColorStatus = "7"

                        If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                            If Me.OverRideCodeBrown = False Then
                                CurrentColorStatus = gColorFailedState
                                TrackColorStatus = "99"
                            End If
                        ElseIf Me.TrackTagRestrictive Then
                            'CurrentColorStatus = New SolidBrush(Color.Cyan)
                            If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.Cyan, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"
                        End If
                    End If

                ElseIf Me.AuthorityType = "SHELF" Then
                    If RemotePendingBlock Then
                        Me.BlockAbsolute = True
                    Else
                        Me.BlockAbsolute = False
                    End If
                    If Me.BlockAbsolute And Not Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                        TrackColorStatus = "16"

                    ElseIf Me.BlockAbsolute And Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "17"
                    ElseIf Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.Firebrick)
                        TrackColorStatus = "39"
                    Else
                        CurrentColorStatus = New SolidBrush(Color.LightSlateGray)
                        TrackColorStatus = "65"
                    End If

                ElseIf pNonTransverable AndAlso Not ShowAuthStatusOnNonTransversableTracks Then
                    CurrentColorStatus = New SolidBrush(Color.FromArgb(128, 128, 128)) 'gray
                    TrackColorStatus = "8"
                    If Me.FoulingTrackSPMS And Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.Red)
                        TrackColorStatus = "9"
                    End If
                    If Me.FailState And Not Me.SimulateMode And Not optDisableShowingCodeFailureOnComponents Then
                        CurrentColorStatus = gColorFailedState
                    End If

                ElseIf Occuppied Or OccupancyReminder Then
                    If Not Me.BlockAbsolute Then
                        CurrentColorStatus = New SolidBrush(Color.Red)
                        TrackColorStatus = "9"
                    Else
                        If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.Magenta, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.Magenta)
                        TrackColorStatus = "55"
                    End If
                ElseIf AuthorityType = "CTC" OrElse AuthorityType = "CTC-OTHER" Then
                    Select Case SignalStatOnMe
                        Case SignalStatus.SignalCleared, SignalStatus.SignalClearedDrill
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                If objAuthority IsNot Nothing Then
                                    CurrentColorStatus = GetColorStatusForPTC(objAuthority, Me.BlockAbsolute, Color.MediumSlateBlue)
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                                End If
                                TrackColorStatus = "66"
                            ElseIf Me.TrackAuthority Then
                                CurrentColorStatus = GetColorStatusForPTC(objAuthority)
                                TrackColorStatus = "66"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.Green)
                                TrackColorStatus = "10"
                            End If
                        Case SignalStatus.PendingStateChange
                            CurrentColorStatus = New SolidBrush(Color.LightYellow)
                            TrackColorStatus = "91"
                        Case SignalStatus.SignalRequested, SignalStatus.SignalRequestedDrill
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightBlue)
                                TrackColorStatus = "47"
                                If Me.SpecialAuthorityBlocking Then
                                    CurrentColorStatus = New SolidBrush(Color.GreenYellow)
                                    TrackColorStatus = "147"
                                ElseIf Me.TrackAuthority Then
                                    CurrentColorStatus = GetColorStatusForPTC(objAuthority)
                                    TrackColorStatus = "66"
                                End If
                            Else
                                CurrentColorStatus = New SolidBrush(Color.Yellow)
                                TrackColorStatus = "11"
                            End If

                        Case SignalStatus.SignalInTime
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                                TrackColorStatus = "66"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.DarkSalmon)
                                TrackColorStatus = "12"
                            End If

                        Case SignalStatus.SignalOfficeLock
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                                TrackColorStatus = "66"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.Orange)
                                TrackColorStatus = "150"
                            End If

                        Case SignalStatus.SignalUnSolicated
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                                TrackColorStatus = "39"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.MediumSpringGreen)
                                TrackColorStatus = "72"
                            End If

                        Case SignalStatus.SignalAtStop
                            If Me.BlockAbsolute AndAlso Not Me.Occuppied AndAlso Not Me.DeviceBlocked Then
                                If optDisableFlashingTrackForPTC Then
                                    'Since 
                                    CurrentColorStatus = GetColorStatusForPTC(objAuthority, BlockAbsolute)
                                    TrackColorStatus = "66"
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                    TrackColorStatus = "16"
                                End If
                            ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked And TrackAndTime Then
                                CurrentColorStatus = New SolidBrush(gTNTColorOverDeviceBlock)
                                TrackColorStatus = "57"
                            ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                                If optDisableFlashingTrackForPTC Then
                                    Dim TmpColor As Color = Nothing
                                    If optEnableARRCSpecificOptions Then
                                        If OverrideFieldBlocking Then
                                            TmpColor = gOverRideFeildBlockingDeviceBlockColor
                                        Else
                                            TmpColor = gDeviceBlockColor
                                        End If
                                        CurrentColorStatus = GetColorStatusForPTC(objAuthority, True, TmpColor)
                                    Else
                                        CurrentColorStatus = GetColorStatusForPTC(objAuthority, True)
                                    End If
                                Else
                                    CurrentColorStatus = New SolidBrush(gDeviceBlockColor)
                                End If
                                TrackColorStatus = "56"
                            ElseIf Me.TrackAuthority Then
                                CurrentColorStatus = GetColorStatusForPTC(objAuthority)
                                TrackColorStatus = "66"
                            ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                                If Me.trackTagAlarm Then
                                    CurrentColorStatus = New SolidBrush(Color.DarkOrange)
                                ElseIf Me.trackTagPlan Then
                                    CurrentColorStatus = New SolidBrush(Color.White)
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.Cyan)
                                End If
                                TrackColorStatus = "77"
                            ElseIf Me.BlockAbsolute And Me.Occuppied Then
                                CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                                TrackColorStatus = "17"
                            Else
                                If Me.TrackAuthority Then
                                    If Me.Occuppied Then
                                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                                        TrackColorStatus = "17"
                                    Else
                                        CurrentColorStatus = GetColorStatusForPTC(objAuthority)
                                        TrackColorStatus = "66"
                                    End If
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.White)
                                    TrackColorStatus = "13"
                                End If
                            End If
                        Case Else
                            If Me.Indicating Then
                                CurrentColorStatus = New SolidBrush(Color.White)
                            Else
                                CurrentColorStatus = New SolidBrush(Color.Gray)  'ADDED FOR CTC DEVELOPMENT
                            End If
                            TrackColorStatus = "13"
                    End Select

                    If Me.FailState And (Not Me.SimulateMode Or gTraineeMode) And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                        If Me.OverRideCodeBrown = False Then
                            CurrentColorStatus = gColorFailedState
                            TrackColorStatus = "99"
                        End If
                    ElseIf Not Me.Indicating Then
                        If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                            'CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.DodgerBlue, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                            'CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.MediumSlateBlue, objAuthority) Else CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            TrackColorStatus = "56"
                        ElseIf Me.BlockAbsolute And Me.Occuppied Then
                            'CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            If optUseSFAColorStatusForPTC Then CurrentColorStatus = GetSFAColorStatusForPTC(Color.FromArgb(255, 0, 128), objAuthority) Else CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            TrackColorStatus = "17"
                        ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"
                        ElseIf Me.SimulateMode And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.Red)
                            TrackColorStatus = "9"
                        Else
                            If Me.TrackAuthorities.Count > 0 Then

                            ElseIf Me.AuthorityType = "CTC-OTHER" AndAlso Me.Occuppied Then
                                CurrentColorStatus = New SolidBrush(Color.Red)
                                TrackColorStatus = "9"
                            Else

                                CurrentColorStatus = New SolidBrush(Color.Gray)  'ADDED FOR CTC DEVELOPMENT
                                TrackColorStatus = "13"
                            End If

                        End If
                    End If
                ElseIf AuthorityType = "NON-TWC" Then
                    CurrentColorStatus = gColorTrackNotUsable
                    TrackColorStatus = "14"

                    If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                        If Me.OverRideCodeBrown = False Then
                            CurrentColorStatus = gColorFailedState
                            TrackColorStatus = "99"
                        End If
                    ElseIf Not Me.Occuppied And Me.BlockAbsolute And Not Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                        TrackColorStatus = "16"
                    ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                        TrackColorStatus = "56"

                    ElseIf Me.Occuppied And Me.BlockAbsolute Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "17"
                    ElseIf Me.TrackTagRestrictive Then
                        CurrentColorStatus = New SolidBrush(Color.Cyan)
                        TrackColorStatus = "77"
                    End If

                ElseIf AuthorityType = "CTC-OTHER" Or AuthorityType = "CTC-PSEUD" Or AuthorityType = "YL" Or AuthorityType = "RL" Then
                    If Me.Indicating Then
                        If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            TrackColorStatus = "56"
                        ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"

                        ElseIf Me.BlockAbsolute And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            TrackColorStatus = "17"
                        ElseIf Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"
                        Else
                            CurrentColorStatus = gColorTrackDefault
                            TrackColorStatus = "15"
                        End If

                        If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                            If Me.OverRideCodeBrown = False Then
                                CurrentColorStatus = gColorFailedState
                                TrackColorStatus = "99"
                            End If
                        End If
                    Else
                        If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            TrackColorStatus = "56"
                        ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"

                        ElseIf Me.BlockAbsolute And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            TrackColorStatus = "17"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.SlateGray)
                            TrackColorStatus = "75"
                        End If
                    End If
                Else
                    If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                        If Me.OverRideCodeBrown = False Then
                            CurrentColorStatus = gColorFailedState
                            TrackColorStatus = "47"
                        End If
                    ElseIf Not Me.Occuppied And Me.BlockAbsolute And Not Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                        TrackColorStatus = "16"
                    ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                        TrackColorStatus = "56"

                    ElseIf Me.Occuppied And Me.BlockAbsolute Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "17"
                    ElseIf Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.Red)
                        TrackColorStatus = "9"
                    ElseIf Me.TrackTagRestrictive Then
                        CurrentColorStatus = New SolidBrush(Color.Cyan)
                        TrackColorStatus = "77"
                    Else

                        CurrentColorStatus = New SolidBrush(Color.White)
                        TrackColorStatus = "15"
                        If OverRideLimitsForTrain Then
                            CurrentColorStatus = New SolidBrush(Color.Yellow)
                            TrackColorStatus = "366"
                        End If
                    End If

                End If

                If Me.RemoteLinkShowDown Then
                    CurrentColorStatus = gColorFailedState
                    TrackColorStatus = "47"
                End If

                If Me.AllowFieldBlocking AndAlso Not OverrideFieldBlocking AndAlso Not Me.FailState Then
                    If Me.FieldBlockingControlStatus = FieldBlockStatus.BlockingOff And Me.FieldBlockingIndicationStatus = FieldBlockStatus.BlockingOff Then
                        Me.SetFieldBlockingCorespondence()
                    ElseIf Me.FieldBlockingControlStatus = FieldBlockStatus.BlockingOn And Me.FieldBlockingIndicationStatus = FieldBlockStatus.BlockingOn Then
                        If Me.TrackAuthorities.Count = 0 And Me.DeviceBlocks.Count = 0 And Me.SplAuthorityBlock = False Then
                            Me.BlockAbsolute = True
                            If optEnablePTCBOSVETMSMode AndAlso Me.myTerritory.PTCEnabled Then
                                If optDisableFlashingTrackForPTC Then
                                    If Me.Occuppied Then
                                        CurrentColorStatus = GetColorStatusForPTC(objAuthority, BlockAbsolute, Color.Magenta)
                                        TrackColorStatus = "55"
                                    Else
                                        CurrentColorStatus = GetColorStatusForPTC(objAuthority, BlockAbsolute, Color.DodgerBlue)
                                        TrackColorStatus = "16"
                                    End If
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                    TrackColorStatus = "16"
                                End If
                            Else
                                If Me.Occuppied Then
                                    CurrentColorStatus = New SolidBrush(Color.Magenta)
                                    TrackColorStatus = "55"
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                    TrackColorStatus = "16"
                                End If
                            End If

                            If Me.MatchModeFieldBlocking Then
                                Me.SetFieldBlockingCorespondence()
                            Else
                                Me.SetFieldBlockingOutOfCorespondence()
                            End If
                            'ElseIf optEnablePSSEMTAuthorityNoDeviceBlk and 
                            'ElseIf Me.OtherSplAuthorities isnot Nothing andalso Me.OtherSplAuthorities.Count
                        Else
                            Me.SetFieldBlockingCorespondence()
                        End If

                    ElseIf Me.FieldBlockingControlStatus = FieldBlockStatus.BlockingOn And Me.FieldBlockingIndicationStatus <> FieldBlockStatus.BlockingOn Then
                        'If (optEnablePSSEMTAuthorityNoDeviceBlk And Me.OtherSplAuthorities.Count = 0) And Not (Me.TrackAuthorities.Count = 0 And Me.DeviceBlocks.Count = 0) Then
                        '    Me.SetFieldBlockingControls(False)
                        '    Me.SetFieldBlockingCorespondence()
                        If Me.FieldBlockingIndicationStatus = FieldBlockStatus.BlockingOff And Me.TrackAuthorities.Count = 0 And Me.DeviceBlocks.Count = 0 And (optEnablePSSEMTAuthorityNoDeviceBlk And Me.OtherSplAuthorities.Count = 0) Then
                            Me.SetFieldBlockingControls(False)
                            Me.SetFieldBlockingCorespondence()
                        Else
                            Me.BlockAbsolute = True
                            If optEnablePTCBOSVETMSMode AndAlso Me.myTerritory.PTCEnabled Then
                                If optDisableFlashingTrackForPTC Then
                                    If Me.Occuppied Then
                                        CurrentColorStatus = GetColorStatusForPTC(objAuthority, BlockAbsolute, Color.Magenta)
                                        TrackColorStatus = "55"
                                    Else
                                        CurrentColorStatus = GetColorStatusForPTC(objAuthority, BlockAbsolute, Color.DodgerBlue)
                                        TrackColorStatus = "16"
                                    End If
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                    TrackColorStatus = "16"
                                End If
                            Else
                                If Me.Occuppied Then
                                    CurrentColorStatus = New SolidBrush(Color.Magenta)
                                    TrackColorStatus = "55"
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                    TrackColorStatus = "16"

                                End If
                            End If

                            If Me.MatchModeFieldBlocking Then
                                Me.SetFieldBlockingCorespondence()
                            Else
                                Me.SetFieldBlockingOutOfCorespondence()
                            End If

                        End If
                    Else
                        Me.BlockAbsolute = True
                        If optEnablePTCBOSVETMSMode AndAlso Me.myTerritory.PTCEnabled Then
                            If optDisableFlashingTrackForPTC Then
                                If Me.Occuppied Then
                                    CurrentColorStatus = GetColorStatusForPTC(objAuthority, BlockAbsolute, Color.Magenta)
                                    TrackColorStatus = "55"
                                Else
                                    CurrentColorStatus = GetColorStatusForPTC(objAuthority, BlockAbsolute, Color.DodgerBlue)
                                    TrackColorStatus = "16"
                                End If
                            Else
                                CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                TrackColorStatus = "16"
                            End If
                        Else
                            If Me.Occuppied Then
                                CurrentColorStatus = New SolidBrush(Color.Magenta)
                                TrackColorStatus = "55"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                TrackColorStatus = "16"
                            End If
                        End If
                        If Me.MatchModeFieldBlocking Then
                            Me.SetFieldBlockingCorespondence()
                        Else
                            Me.SetFieldBlockingOutOfCorespondence()
                        End If
                    End If
                End If
                If optEnableMRSSpecificPTCOperations Then
                    If PreviousTraffic <> "" Then
                        If Me.TrafficDirection <> "" Then
                            'SAA HAD TO ADD THIS CONDITION TO ONLY APPLY TO ONE TRACK... TO CLOSE 30 OBSERVATIONS. SOMEHOW WHEN GOING THROUGH THE CONFIRMATION PROCESS THE TRACKS TRAFFIC DIRECTION GETS RESET.
                            If Me.GUID = 152101 OrElse Me.GUID = 152180 Then
                                If Me.TrafficDirection <> PreviousTraffic Then
                                    'Me.TrafficDirection = PreviousTraffic
                                    TrackEventLog("UpdateStatus:PreviousTrafficDifferent=" & PreviousTraffic)
                                End If
                            End If
                        End If
                    End If
                End If
                'Apply the traffic arrows
                ApplyTraffic()

                'Log for defect 73970                
                If toLog Then
                    TrackEventLog("UpdateStatus:CurrentColorStatus=" & Me.CurrentColorStatus.Color.ToString() & ":PreviousColorStatus=" & PreviousColorStatus.Color.ToString() & ":TrackColorStatus=" & TrackColorStatus & ":PreviousTrackStatus=" & Me.PreviousTrackStatus)
                End If

                Me.PreviousTrackStatus = TrackColorStatus
                'FIELD TRAFFIC LOGIC
                If Me.FieldTrafficOn Then
                    DoFieldTrafficCheck(True)
                End If
                If Me.FieldDurmantTrafficOn Then
                    DoFieldDormantTrafficCheck(True)
                End If
                PreviousTraffic = Me.TrafficDirection
                If DisplayAuthNumbers Then
                    'InitAuthorityNumbers()
                End If
                PreviousColorStatus = Me.CurrentColorStatus
                'If this track is a remote link track, which is invisible, then send update to the master track on other workstation 
                If Me.IsRemoteTrack Then
                    Me.myRemoteTrack.SendTrackStatus()
                End If
                'if this is link to a remote track on the workstation then send the update to it slave on the other workstation
                If Me.IsLinkToRemoteTrack Then
                    If Not Me.myRemoteConnection Is Nothing Then
                        'Me.myRemoteConnection.SendRemoteLinkObjectStatus()
                        If Me.myLeftRemoteLinkedTrack IsNot Nothing AndAlso Not Me.myLeftRemoteLinkedTrack.AuthorityType.Trim.ToUpper.Contains("CTC") Then
                            Me.myRemoteConnection.SendRemoteLinkObjectStatus(True)
                        ElseIf Me.myRightRemoteLinkedTrack IsNot Nothing AndAlso Not Me.myRightRemoteLinkedTrack.AuthorityType.Trim.ToUpper.Contains("CTC") Then
                            Me.myRemoteConnection.SendRemoteLinkObjectStatus(True)
                        Else
                            Me.myRemoteConnection.SendRemoteLinkObjectStatus()
                        End If
                    End If
                End If
                'Send Status Update to Xmt Queue to send to attached control server
                If Not Me.FailState And Me.IsLinkToRemoteTrack Then
                    SendStatusUpdate()
                End If
                If Not Me.FailState And Me.FailStatePrevious Then
                    Me.FailStatePrevious = False
                    If Me.IsLinkToRemoteTrack Then
                        If Not IsNothing(Me.myLeftRemoteLinkedTrack) Then
                            Me.myLeftRemoteLinkedTrack.myRemoteTrack.RequestTrackStatus()
                        End If
                        If Not IsNothing(Me.myRightRemoteLinkedTrack) Then
                            Me.myRightRemoteLinkedTrack.myRemoteTrack.RequestTrackStatus()
                        End If
                    End If
                End If
                If Me.myControlPoint.AllowStatusPublishing Then
                    Me.PublishStatus()
                End If
                If Me.InvokeRequired Then
                    Me.Invoke(New MethodInvoker(AddressOf Me.Refresh))
                Else
                    Me.Refresh()
                End If

                'Log for defect 73970 
                If toLog Then
                    TrackEventLog("UpdateStatus:End")
                End If

                'Log for defect #129869
                If Me.GUID = 152101 OrElse Me.GUID = 152180 Then
                    TrackEventLog("UpdateStatus:End")
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                loggableWhoCall = Nothing
                toLog = Nothing
            End Try
        End Sub

        Private Sub SetBlockingStatus()
            Try

                'see if there are any track authority type on this component
                Me.TrackAndTime = False
                Me.BlockAbsolute = False
                Me.TrackPermit = False
                If RemotePendingBlock Then
                    Me.BlockAbsolute = True
                Else
                    Me.BlockAbsolute = False
                End If

                Dim auth As TrackAuthority.TrackAuthority
                For Each auth In Me.TrackAuthorities
                    Me.BlockAbsolute = True
                    'RemotePendingBlock = False
                    If Mid(auth.AuthorityType, 1, 2) = "TT" Then
                        Me.TrackAndTime = True
                    ElseIf Mid(auth.AuthorityType, 1, 2) = "TP" Then
                        Me.TrackPermit = True
                    ElseIf Mid(auth.AuthorityType, 1, 2) = "TA" Then
                        Me.BlockAbsolute = False
                        If Me.TrackAndTime Or TrackPermit Then
                            Me.BlockAbsolute = True
                        Else
                            Me.BlockAbsolute = False
                            If Not Me.IsLinkToFlipFlopToRight AndAlso Not Me.IsLinkToFlipFlopToLeft Then Me.TrafficDirection = auth.Direction
                        End If
                    Else
                        Me.TrackAndTime = True
                    End If
                Next
                If Me.TrackAndTime AndAlso optEnableCTCTAGDispalyonCodeBrown Then Me.OverRideCodeBrown = True
            Catch ex As Exception
                SystemException(ex.ToString)
                Me.BlockAbsolute = True
            End Try
        End Sub

        Public Sub UpdateStatusFromRemoteMessage()
            Dim warr, FirstWarrant As Warrant
            Dim BoxElevenRestrictionFound As Boolean
            Try


                If Me.AuthorityType <> "CTC" And Me.AuthorityType <> "OTHER" And Me.AuthorityType <> "DTC" Then
                    If AuthorityCounts > 0 Then
                        FirstWarrant = Authorities(0)
                        TrafficDirection = FirstWarrant.Direction
                        LimitsForMOW = False
                        LimitsForTrain = False
                        ActiveTrackWarrant = True
                        For Each warr In Authorities
                            Select Case warr.WarrantType
                                Case "ItemTwoToMOW", "ItemFourToMOW"
                                    LimitsForMOW = True
                                Case "ItemFourToTrain", "ItemTwoToTrain"
                                    LimitsForTrain = True
                                Case Else
                                    LimitsForTrain = True
                                    LimitsForMOW = True
                            End Select

                            'New Box Eleven Restriction Code
                            Dim BoxElevenRestriction As Object
                            For Each BoxElevenRestriction In warr.BoxElevenComponents
                                If BoxElevenRestriction Is Me Then
                                    BoxElevenRestrictionFound = True
                                End If
                            Next
                            'New Box Eleven Restriction Code
                        Next
                    Else
                        TrafficDirection = ""
                        ActiveTrackWarrant = False
                        LimitsForTrain = False
                        LimitsForMOW = False
                    End If


                    'New Box Eleven Restriction Code
                    If BoxElevenRestrictionFound Then
                        Me.BoxElevenRestriction = True
                    Else
                        Me.BoxElevenRestriction = False
                    End If
                    'New Box Eleven Restriction Code

                ElseIf Me.AuthorityType = "DTC" Then
                    If Me.Authorities.Count > 0 Then
                        Dim FirstDTC As DTCAuthority = Authorities(0)
                        TrafficDirection = FirstDTC.Direction
                        LimitsForTrain = True
                        ActiveTrackWarrant = True
                    End If

                ElseIf Me.AuthorityType = "SHELF" Then


                Else 'CTC TYPE

                    If Me.Occuppied Then 'CTC Track Indication Bit
                        'If this track is a slotting track, search for signals to put to slot to the stop position
                        'If Me.SlottingTrack Then
                        '    Me.SlotSignalRequests()
                        'End If
                    ElseIf PreviouslyOccuppied And Me.OStype Then
                        PreviouslyOccuppied = False
                        If Me.SlottingTrack Or Me.OSReporting Then

                            CheckToRemoveOfficeTrafficRoute()
                            If Not Me.OsComponentCollection Is Nothing Then
                                Dim comp As Object
                                For Each comp In OsComponentCollection
                                    If Not comp Is Me Then
                                        comp.SignalStatOnMe = SignalStatus.SignalAtStop
                                        comp.TrafficDirection = ""
                                        comp.UpdateStatus()
                                    End If
                                Next
                            End If
                        End If

                    End If

                    'Search against the right link for switches that need to be graphically updated with track occupied
                    Dim RightSwitchComponent As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(Me.RightLink)
                    If Not RightSwitchComponent Is Nothing Then
                        RightSwitchComponent.Occuppied = Me.Occuppied
                        If Me.Occuppied Then
                            RightSwitchComponent.SignalStatOnMe = SignalStatus.SignalAtStop
                        End If
                        RightSwitchComponent.TrafficDirection = Me.TrafficDirection
                        If Not RightSwitchComponent.Graphical Is Nothing Then
                            'SyncLock RightSwitchComponent.Graphical
                            If Me.OverRideCodeBrown Then RightSwitchComponent.OverRideCodeBrown = True
                            RightSwitchComponent.UpdateColorStatusOnly()
                            'End SyncLock
                        End If
                    End If

                    SetBlockingStatus()

                    'check for device blocks
                    If Me.DeviceBlocks.Count > 0 Then Me.BlockAbsolute = True : Me.DeviceBlocked = True ': RemotePendingBlock = False

                    If Me.BlockAbsolute <> Me.BlockAbsolutePrevious Then
                        Dim LogThisEvent As New DoEventLogTrack(AddressOf Me.LogTheTrackEvent)
                        LogThisEvent.BeginInvoke(Track.EventTypeTrack.BLK, Nothing, Nothing, Nothing, Nothing)
                        If Me.AllowFieldBlocking Then
                            If Me.BlockAbsolute Then
                                Me.SetFieldBlockingControls(True)
                            Else
                                Me.SetFieldBlockingControls(False)
                            End If
                        End If
                    End If
                    Me.BlockAbsolutePrevious = Me.BlockAbsolute

                End If

                'Set the color scheme for the current track condition
                If ActiveTrackWarrant And Not pNonTransverable Then
                    CurrentColorStatus = Nothing
                    TrackColorStatus = "0"
                    If LimitsForTrain And LimitsForMOW And (Not Occuppied And Not OccupancyReminder) Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(0, 128, 128))  'light blue/green
                        TrackColorStatus = "1"
                    ElseIf LimitsForTrain And LimitsForMOW And (Occuppied Or OccupancyReminder) Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128)) 'hot pink
                        TrackColorStatus = "2"
                    ElseIf LimitsForTrain And (Not Occuppied And Not OccupancyReminder) Then
                        CurrentColorStatus = New SolidBrush(Color.Green) 'light green
                        TrackColorStatus = "3"
                    ElseIf LimitsForMOW And (Not Occuppied And Not OccupancyReminder) Then
                        CurrentColorStatus = New SolidBrush(Color.Blue)
                        TrackColorStatus = "4"
                    ElseIf LimitsForTrain And (Occuppied Or OccupancyReminder) Then
                        CurrentColorStatus = New SolidBrush(Color.Orange)
                        TrackColorStatus = "5"
                    ElseIf LimitsForMOW And (Occuppied Or OccupancyReminder) Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 255)) ' magenta
                        TrackColorStatus = "6"
                    Else
                        CurrentColorStatus = New SolidBrush(Color.DarkBlue)
                        TrackColorStatus = "7"

                        If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                            CurrentColorStatus = gColorFailedState
                            TrackColorStatus = "99"
                        ElseIf Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"
                        End If
                    End If

                ElseIf Me.AuthorityType = "SHELF" Then
                    If Me.BlockAbsolute And Not Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                        TrackColorStatus = "16"

                    ElseIf Me.BlockAbsolute And Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "17"
                    ElseIf Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.Firebrick)
                        TrackColorStatus = "39"
                    Else
                        CurrentColorStatus = New SolidBrush(Color.LightSlateGray)
                        TrackColorStatus = "65"
                    End If

                ElseIf pNonTransverable Then
                    CurrentColorStatus = New SolidBrush(Color.FromArgb(128, 128, 128)) 'gray
                    TrackColorStatus = "8"

                    If Me.FailState And Not Me.SimulateMode And Not optDisableShowingCodeFailureOnComponents Then
                        CurrentColorStatus = gColorFailedState
                    End If
                ElseIf Occuppied Or OccupancyReminder Then
                    If Not Me.BlockAbsolute Then
                        CurrentColorStatus = New SolidBrush(Color.Red)
                        TrackColorStatus = "9"
                    Else
                        CurrentColorStatus = New SolidBrush(Color.Magenta)
                        TrackColorStatus = "55"
                    End If
                    'ElseIf Mid(AuthorityType, 1, 3) = "TWC" And Not pNonTransverable Then

                ElseIf AuthorityType = "CTC" Then
                    Select Case SignalStatOnMe
                        Case SignalStatus.SignalCleared, SignalStatus.SignalClearedDrill
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                                TrackColorStatus = "66"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.Green)
                                TrackColorStatus = "10"
                            End If
                        Case SignalStatus.PendingStateChange
                            CurrentColorStatus = New SolidBrush(Color.LightYellow)
                            TrackColorStatus = "91"
                        Case SignalStatus.SignalRequested, SignalStatus.SignalRequestedDrill
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightBlue)
                                TrackColorStatus = "47"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.Yellow)
                                TrackColorStatus = "11"
                            End If
                            'CurrentColorStatus = New SolidBrush(Color.Yellow)
                            'TrackColorStatus = "11"
                        Case SignalStatus.SignalInTime
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                                TrackColorStatus = "66"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.DarkSalmon)
                                TrackColorStatus = "12"
                            End If

                        Case SignalStatus.SignalUnSolicated
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                                TrackColorStatus = "39"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.MediumSpringGreen)
                                TrackColorStatus = "72"
                            End If

                        Case SignalStatus.SignalAtStop
                            If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                                CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                TrackColorStatus = "16"
                            ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked And TrackAndTime Then
                                CurrentColorStatus = New SolidBrush(gTNTColorOverDeviceBlock)
                                TrackColorStatus = "57"
                            ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                                'CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                                CurrentColorStatus = New SolidBrush(gDeviceBlockColor)
                                TrackColorStatus = "56"
                            ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.Cyan)
                                TrackColorStatus = "77"
                            ElseIf Me.BlockAbsolute And Me.Occuppied Then
                                CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                                TrackColorStatus = "17"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.White)
                                TrackColorStatus = "13"
                            End If
                        Case Else
                            If Me.Indicating Then
                                ''CurrentColorStatus = New SolidBrush(Color.White)
                                If Me.TrackAuthority Then
                                    If Me.Occuppied Then
                                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                                        TrackColorStatus = "17"
                                    Else
                                        CurrentColorStatus = GetColorStatusForPTC(Nothing)
                                        TrackColorStatus = "66"
                                    End If
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.White)
                                    TrackColorStatus = "13"
                                End If

                            Else
                                CurrentColorStatus = New SolidBrush(Color.Gray)  'ADDED FOR CTC DEVELOPMENT
                            End If
                            TrackColorStatus = "13"
                    End Select


                    If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                        CurrentColorStatus = gColorFailedState
                        TrackColorStatus = "99"
                    ElseIf Not Me.Indicating Then
                        If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            TrackColorStatus = "56"
                        ElseIf Me.BlockAbsolute And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            TrackColorStatus = "17"
                        ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"
                        ElseIf Me.SimulateMode And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.Red)
                            TrackColorStatus = "9"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.Gray)  'ADDED FOR CTC DEVELOPMENT
                            TrackColorStatus = "13"
                        End If
                    End If
                ElseIf AuthorityType = "NON-TWC" Then
                    CurrentColorStatus = gColorTrackNotUsable
                    TrackColorStatus = "14"

                    If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                        CurrentColorStatus = gColorFailedState
                        TrackColorStatus = "99"
                    ElseIf Not Me.Occuppied And Me.BlockAbsolute And Not Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                        TrackColorStatus = "16"
                    ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                        TrackColorStatus = "56"

                    ElseIf Me.Occuppied And Me.BlockAbsolute Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "17"
                    ElseIf Me.TrackTagRestrictive Then
                        CurrentColorStatus = New SolidBrush(Color.Cyan)
                        TrackColorStatus = "77"
                    End If

                ElseIf AuthorityType = "CTC-OTHER" Or AuthorityType = "CTC-PSEUD" Or AuthorityType = "YL" Or AuthorityType = "RL" Then
                    If Me.Indicating Then
                        If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            TrackColorStatus = "56"
                        ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"

                        ElseIf Me.BlockAbsolute And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            TrackColorStatus = "17"
                        ElseIf Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"
                        Else
                            CurrentColorStatus = gColorTrackDefault
                            TrackColorStatus = "15"
                        End If

                        If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                            CurrentColorStatus = gColorFailedState
                            TrackColorStatus = "99"
                        End If
                    Else
                        If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            TrackColorStatus = "56"
                        ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"

                        ElseIf Me.BlockAbsolute And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            TrackColorStatus = "17"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.SlateGray)
                            TrackColorStatus = "75"
                        End If
                    End If
                Else
                    If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                        CurrentColorStatus = gColorFailedState
                        TrackColorStatus = "47"
                    ElseIf Not Me.Occuppied And Me.BlockAbsolute And Not Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                        TrackColorStatus = "16"
                    ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                        TrackColorStatus = "56"

                    ElseIf Me.Occuppied And Me.BlockAbsolute Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "17"
                    ElseIf Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.Red)
                        TrackColorStatus = "9"
                    ElseIf Me.TrackTagRestrictive Then
                        CurrentColorStatus = New SolidBrush(Color.Cyan)
                        TrackColorStatus = "77"
                    Else
                        CurrentColorStatus = New SolidBrush(Color.White)
                        TrackColorStatus = "15"
                    End If

                End If

                If Me.RemoteLinkShowDown Then 'And Not Me.SimulateMode Then
                    CurrentColorStatus = gColorRemoteLinkDown
                    TrackColorStatus = "47"
                    'Me.FailState = True
                End If

                If Me.AllowFieldBlocking And Not Me.FailState Then
                    If Me.FieldBlockingControlStatus = FieldBlockStatus.BlockingOff And Me.FieldBlockingIndicationStatus = FieldBlockStatus.BlockingOff Then
                        Me.SetFieldBlockingCorespondence()
                    ElseIf Me.FieldBlockingControlStatus = FieldBlockStatus.BlockingOn And Me.FieldBlockingIndicationStatus = FieldBlockStatus.BlockingOn Then
                        If Me.TrackAuthorities.Count = 0 And Me.DeviceBlocks.Count = 0 Then
                            Me.BlockAbsolute = True
                            If Me.Occuppied Then
                                CurrentColorStatus = New SolidBrush(Color.Magenta)
                                TrackColorStatus = "55"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                TrackColorStatus = "16"
                            End If
                            Me.SetFieldBlockingOutOfCorespondence()
                        Else
                            Me.SetFieldBlockingCorespondence()
                        End If

                    ElseIf Me.FieldBlockingControlStatus = FieldBlockStatus.BlockingOn And Me.FieldBlockingIndicationStatus <> FieldBlockStatus.BlockingOn Then
                        If Me.FieldBlockingIndicationStatus = FieldBlockStatus.BlockingOff And Me.TrackAuthorities.Count = 0 And Me.DeviceBlocks.Count = 0 Then
                            Me.SetFieldBlockingControls(False)
                            Me.SetFieldBlockingCorespondence()
                        Else
                            Me.BlockAbsolute = True
                            If Me.Occuppied Then
                                CurrentColorStatus = New SolidBrush(Color.Magenta)
                                TrackColorStatus = "55"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                TrackColorStatus = "16"
                            End If
                            Me.SetFieldBlockingOutOfCorespondence()

                        End If
                    Else
                        Me.BlockAbsolute = True
                        If Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.Magenta)
                            TrackColorStatus = "55"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        End If
                        Me.SetFieldBlockingOutOfCorespondence()
                    End If

                End If

                'Apply the traffic arrows
                ApplyTraffic()



                Me.PreviousTrackStatus = TrackColorStatus


                'FIELD TRAFFIC LOGIC
                If Me.FieldTrafficOn Then
                    DoFieldTrafficCheck(True)
                End If

                If Me.FieldDurmantTrafficOn Then
                    DoFieldDormantTrafficCheck(True)
                End If


                PreviousTraffic = Me.TrafficDirection

                If DisplayAuthNumbers Then
                    InitAuthorityNumbers()
                End If

                PreviousColorStatus = Me.CurrentColorStatus

                If Me.InvokeRequired Then
                    Me.Invoke(New MethodInvoker(AddressOf Me.Refresh))
                Else
                    Me.Refresh()
                End If



            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoFieldDormantTrafficCheck(Optional ByVal ForceSendAutomatic As Boolean = False)
            Try
                If PreviousTraffic <> Me.TrafficDirection Then

                    If Me.TrafficDirection <> "" Then
                        Dim dv As Device
                        If Me.TrafficDirection = "RIGHT" Then
                            If Not Me.TrafficLeftList Is Nothing Then
                                For Each dv In TrafficLeftList
                                    dv.ControlManually(False, ForceSendAutomatic)
                                Next
                            End If

                            If Not Me.TrafficRightList Is Nothing Then
                                For Each dv In TrafficRightList
                                    dv.ControlManually(True, ForceSendAutomatic)
                                Next
                            End If
                        Else
                            If Not Me.TrafficLeftList Is Nothing Then
                                For Each dv In TrafficLeftList
                                    dv.ControlManually(True, ForceSendAutomatic)
                                Next
                            End If

                            If Not Me.TrafficRightList Is Nothing Then
                                For Each dv In TrafficRightList
                                    dv.ControlManually(False, ForceSendAutomatic)
                                Next
                            End If
                        End If
                    Else
                        Dim TrafficOn As Boolean
                        Dim trk As Track
                        Dim dv As Device

                        If Not IsNothing(Me.TrafficLeftTrackList) Then
                            For Each trk In Me.TrafficLeftTrackList
                                If trk.TrafficDirection <> "" Then
                                    TrafficOn = True
                                End If
                            Next
                        End If

                        If Not IsNothing(Me.TrafficRightTrackList) Then
                            For Each trk In Me.TrafficRightTrackList
                                If trk.TrafficDirection <> "" Then
                                    TrafficOn = True
                                End If
                            Next
                        End If

                        If Not TrafficOn Then
                            If Not Me.TrafficRightList Is Nothing Then
                                For Each dv In TrafficRightList
                                    dv.ControlManually(False, ForceSendAutomatic)
                                Next
                            End If

                            If Not Me.TrafficLeftList Is Nothing Then
                                For Each dv In TrafficLeftList
                                    dv.ControlManually(False, ForceSendAutomatic)
                                Next
                            End If
                        End If

                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoFieldTrafficCheck(Optional ByVal ForceSendAutomatic As Boolean = False)
            Try
                If PreviousTraffic <> Me.TrafficDirection Then
                    If Me.FieldTrafficOn Then
                        If Me.TrafficDirection <> "" Then
                            Dim dv As Device
                            If Me.TrafficDirection = "RIGHT" Then
                                If Not Me.TrafficLeftList Is Nothing Then
                                    For Each dv In TrafficLeftList
                                        dv.ControlManually(False, ForceSendAutomatic)
                                    Next
                                End If

                                If Not Me.TrafficRightList Is Nothing Then
                                    For Each dv In TrafficRightList
                                        dv.ControlManually(True, ForceSendAutomatic)
                                    Next
                                End If
                            Else
                                If Not Me.TrafficLeftList Is Nothing Then
                                    For Each dv In TrafficLeftList
                                        dv.ControlManually(True, ForceSendAutomatic)
                                    Next
                                End If

                                If Not Me.TrafficRightList Is Nothing Then
                                    For Each dv In TrafficRightList
                                        dv.ControlManually(False, ForceSendAutomatic)
                                    Next
                                End If
                            End If
                        ElseIf Me.SlotFieldTraffic Then
                            Dim dv As Device
                            If Not Me.TrafficLeftList Is Nothing Then
                                For Each dv In TrafficLeftList
                                    dv.ControlManually(False, ForceSendAutomatic)
                                Next
                            End If
                            If Not Me.TrafficRightList Is Nothing Then
                                For Each dv In TrafficRightList
                                    dv.ControlManually(False, ForceSendAutomatic)
                                Next
                            End If
                        End If
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub UpdateStatusFromRemoteLink()
            Dim warr, FirstWarrant As Warrant
            Dim BoxElevenRestrictionFound As Boolean
            Try


                If Me.AuthorityType <> "CTC" Then
                    If AuthorityCounts > 0 Then
                        FirstWarrant = Authorities(0)
                        TrafficDirection = FirstWarrant.Direction
                        LimitsForMOW = False
                        LimitsForTrain = False
                        ActiveTrackWarrant = True
                        For Each warr In Authorities
                            Select Case warr.WarrantType
                                Case "ItemTwoToMOW", "ItemFourToMOW"
                                    LimitsForMOW = True
                                Case "ItemFourToTrain", "ItemTwoToTrain"
                                    LimitsForTrain = True
                                Case Else
                                    LimitsForTrain = True
                                    LimitsForMOW = True
                            End Select

                            'New Box Eleven Restriction Code
                            Dim BoxElevenRestriction As Object
                            For Each BoxElevenRestriction In warr.BoxElevenComponents
                                If BoxElevenRestriction Is Me Then
                                    BoxElevenRestrictionFound = True
                                End If
                            Next
                            'New Box Eleven Restriction Code
                        Next
                    Else
                        TrafficDirection = ""
                        ActiveTrackWarrant = False
                        LimitsForTrain = False
                        LimitsForMOW = False
                    End If


                    'New Box Eleven Restriction Code
                    If BoxElevenRestrictionFound Then
                        Me.BoxElevenRestriction = True
                    Else
                        Me.BoxElevenRestriction = False
                    End If
                    'New Box Eleven Restriction Code

                ElseIf Me.AuthorityType = "SHELF" Then


                Else 'CTC TYPE

                    If Me.Occuppied Then 'CTC Track Indication Bit
                        'If this track is a slotting track, search for signals to put to slot to the stop position
                        If Me.SlottingTrack Then
                            'Me.SlotSignalRequest()
                            Me.SlotSignalRequests()
                        End If
                    ElseIf PreviouslyOccuppied Then
                        PreviouslyOccuppied = False
                        If Me.SlottingTrack Or Me.OSReporting Then

                            CheckToRemoveOfficeTrafficRoute()
                            If Not Me.OsComponentCollection Is Nothing Then
                                Dim comp As Object
                                For Each comp In OsComponentCollection
                                    'SyncLock comp
                                    comp.SignalStatOnMe = SignalStatus.SignalAtStop
                                    comp.TrafficDirection = ""
                                    comp.UpdateStatus()
                                    'End SyncLock
                                Next
                            End If

                        End If
                        If Me.TrafficDirection <> "" And Not SlottingTrack Then
                            'if there is a route established and the occupancy goes away.
                            'then check to see if the route is completely clear of occupancies to release the route entirely.
                            CheckToRemoveOfficeTrafficRoute()
                            'Check to see if there is a pending or establish route behind me, if so, then apply it to me
                            CheckForPendingRoutesBehindMe()
                        Else
                            'If Not Me.OStype Then
                            Me.SignalStatOnMe = SignalStatus.SignalAtStop
                            Me.TrafficDirection = ""
                            'End If
                        End If
                    End If

                    'Search against the right link for switches that need to be graphically updated with track occupied
                    Dim RightSwitchComponent As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(Me.RightLink)
                    If Not RightSwitchComponent Is Nothing Then
                        'If (RightComponent.GetType.ToString = "TMDS.SwitchComponents.Switch") Then
                        RightSwitchComponent.Occuppied = Me.Occuppied
                        If Me.Occuppied Then
                            RightSwitchComponent.SignalStatOnMe = SignalStatus.SignalAtStop
                        End If
                        RightSwitchComponent.TrafficDirection = Me.TrafficDirection
                        '
                        'End If
                        If Not RightSwitchComponent.Graphical Is Nothing Then
                            'SyncLock RightSwitchComponent.Graphical
                            If Me.OverRideCodeBrown Then RightSwitchComponent.OverRideCodeBrown = True
                            RightSwitchComponent.UpdateColorStatusOnly()
                            'End SyncLock
                        End If
                        'End If
                    End If


                    SetBlockingStatus()

                    'check for device blocks
                    If Me.DeviceBlocks.Count > 0 Then Me.BlockAbsolute = True : Me.DeviceBlocked = True ': RemotePendingBlock = False

                    If Me.BlockAbsolute <> Me.BlockAbsolutePrevious Then
                        Dim LogThisEvent As New DoEventLogTrack(AddressOf Me.LogTheTrackEvent)
                        LogThisEvent.BeginInvoke(Track.EventTypeTrack.BLK, Nothing, Nothing, Nothing, Nothing)
                    End If
                    Me.BlockAbsolutePrevious = Me.BlockAbsolute

                End If

                'Set the color scheme for the current track condition
                If ActiveTrackWarrant And Not pNonTransverable Then
                    CurrentColorStatus = Nothing
                    TrackColorStatus = "0"
                    If LimitsForTrain And LimitsForMOW And (Not Occuppied And Not OccupancyReminder) Then
                        CurrentColorStatus = New SolidBrush(Color.Teal)  'light blue/green
                        TrackColorStatus = "1"
                    ElseIf LimitsForTrain And LimitsForMOW And (Occuppied Or OccupancyReminder) Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128)) 'hot pink
                        TrackColorStatus = "2"
                    ElseIf LimitsForTrain And (Not Occuppied And Not OccupancyReminder) Then
                        If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                            TrackColorStatus = "66"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.Green)
                            TrackColorStatus = "3"
                        End If
                    ElseIf LimitsForMOW And (Not Occuppied And Not OccupancyReminder) Then
                        If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.BlueViolet)
                            TrackColorStatus = "66"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.Blue)
                            TrackColorStatus = "4"
                        End If

                    ElseIf LimitsForTrain And (Occuppied Or OccupancyReminder) Then
                        If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.IndianRed)
                            TrackColorStatus = "17"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.Orange)
                            TrackColorStatus = "5"
                        End If
                    ElseIf LimitsForMOW And (Occuppied Or OccupancyReminder) Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 255)) ' magenta
                        TrackColorStatus = "6"
                    Else
                        CurrentColorStatus = New SolidBrush(Color.DarkBlue)
                        TrackColorStatus = "7"

                        If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                            CurrentColorStatus = gColorFailedState
                            TrackColorStatus = "99"
                        ElseIf Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"
                        End If
                    End If
                ElseIf Me.AuthorityType = "SHELF" Then
                    If Me.BlockAbsolute And Not Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                        TrackColorStatus = "16"

                    ElseIf Me.BlockAbsolute And Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "17"
                    ElseIf Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.Firebrick)
                        TrackColorStatus = "39"
                    Else
                        CurrentColorStatus = New SolidBrush(Color.LightSlateGray)
                        TrackColorStatus = "65"
                    End If

                ElseIf pNonTransverable Then
                    CurrentColorStatus = New SolidBrush(Color.FromArgb(128, 128, 128)) 'gray
                    TrackColorStatus = "8"

                    If Me.FailState And Not Me.SimulateMode And Not optDisableShowingCodeFailureOnComponents Then
                        CurrentColorStatus = gColorFailedState
                    End If
                ElseIf Occuppied Or OccupancyReminder Then
                    If Not Me.BlockAbsolute Then
                        CurrentColorStatus = New SolidBrush(Color.Red)
                        TrackColorStatus = "9"
                    Else
                        CurrentColorStatus = New SolidBrush(Color.Magenta)
                        TrackColorStatus = "55"
                    End If
                    'ElseIf Mid(AuthorityType, 1, 3) = "TWC" And Not pNonTransverable Then

                ElseIf AuthorityType = "CTC" Then
                    Select Case SignalStatOnMe
                        Case SignalStatus.SignalCleared
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                                TrackColorStatus = "66"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.Green)
                                TrackColorStatus = "10"
                            End If
                        Case SignalStatus.SignalRequested
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightGoldenrodYellow)
                                TrackColorStatus = "47"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.Yellow)
                                TrackColorStatus = "11"
                            End If
                            'CurrentColorStatus = New SolidBrush(Color.Yellow)
                            'TrackColorStatus = "11"
                        Case SignalStatus.SignalInTime
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.LightSeaGreen)
                                TrackColorStatus = "66"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.DarkSalmon)
                                TrackColorStatus = "12"
                            End If

                        Case SignalStatus.SignalUnSolicated
                            If Me.BlockAbsolute Or Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.DarkViolet)
                                TrackColorStatus = "39"
                            Else
                                CurrentColorStatus = New SolidBrush(Color.MediumSpringGreen)
                                TrackColorStatus = "72"
                            End If

                        Case SignalStatus.SignalAtStop
                            If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                                CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                                TrackColorStatus = "16"
                            ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked And TrackAndTime Then
                                CurrentColorStatus = New SolidBrush(gTNTColorOverDeviceBlock)
                                TrackColorStatus = "57"
                            ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                                'CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                                CurrentColorStatus = New SolidBrush(gDeviceBlockColor)
                                TrackColorStatus = "56"
                            ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                                CurrentColorStatus = New SolidBrush(Color.Cyan)
                                TrackColorStatus = "77"
                            ElseIf Me.BlockAbsolute And Me.Occuppied Then
                                CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                                TrackColorStatus = "17"
                            Else
                                ''CurrentColorStatus = New SolidBrush(Color.White)
                                ''TrackColorStatus = "13"
                                If Me.TrackAuthority Then
                                    If Me.Occuppied Then
                                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                                        TrackColorStatus = "17"
                                    Else
                                        CurrentColorStatus = GetColorStatusForPTC(Nothing)
                                        TrackColorStatus = "66"
                                    End If
                                Else
                                    CurrentColorStatus = New SolidBrush(Color.White)
                                    TrackColorStatus = "13"
                                End If

                            End If
                        Case Else
                            If Me.Indicating Then
                                CurrentColorStatus = New SolidBrush(Color.White)
                            Else
                                CurrentColorStatus = New SolidBrush(Color.Gray)  'ADDED FOR CTC DEVELOPMENT
                            End If
                            TrackColorStatus = "13"
                    End Select


                    If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                        CurrentColorStatus = gColorFailedState
                        TrackColorStatus = "99"
                    ElseIf Not Me.Indicating Then
                        If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            TrackColorStatus = "56"
                        ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"
                        ElseIf Me.BlockAbsolute And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            TrackColorStatus = "17"
                        ElseIf Me.SimulateMode And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.Red)
                            TrackColorStatus = "9"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.Gray)  'ADDED FOR CTC DEVELOPMENT
                            TrackColorStatus = "13"
                        End If
                    End If
                ElseIf AuthorityType = "NON-TWC" Then
                    CurrentColorStatus = gColorTrackNotUsable
                    TrackColorStatus = "14"

                    If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                        CurrentColorStatus = gColorFailedState
                        TrackColorStatus = "99"
                    ElseIf Not Me.Occuppied And Me.BlockAbsolute And Not Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                        TrackColorStatus = "16"
                    ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                        TrackColorStatus = "56"
                    ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                        CurrentColorStatus = New SolidBrush(Color.Cyan)
                        TrackColorStatus = "77"
                    ElseIf Me.Occuppied And Me.BlockAbsolute Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "17"
                    End If

                ElseIf AuthorityType = "CTC-OTHER" Or AuthorityType = "CTC-PSEUD" Or AuthorityType = "YL" Then
                    If Me.Indicating Then
                        If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            TrackColorStatus = "56"
                        ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"
                        ElseIf Me.BlockAbsolute And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            TrackColorStatus = "17"
                        Else
                            CurrentColorStatus = gColorTrackDefault
                            TrackColorStatus = "15"
                        End If

                        If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                            CurrentColorStatus = gColorFailedState
                            TrackColorStatus = "99"
                        End If
                    Else
                        If Me.BlockAbsolute And Not Me.Occuppied And Not Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                            TrackColorStatus = "16"
                        ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                            CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                            TrackColorStatus = "56"
                        ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                            CurrentColorStatus = New SolidBrush(Color.Cyan)
                            TrackColorStatus = "77"

                        ElseIf Me.BlockAbsolute And Me.Occuppied Then
                            CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                            TrackColorStatus = "17"
                        Else
                            CurrentColorStatus = New SolidBrush(Color.Gray)
                            TrackColorStatus = "75"
                        End If
                    End If
                Else
                    If Me.FailState And Not Me.SimulateMode And Me.Indicating And Not optDisableShowingCodeFailureOnComponents Then
                        CurrentColorStatus = gColorFailedState
                        TrackColorStatus = "47"
                    ElseIf Not Me.Occuppied And Me.BlockAbsolute And Not Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.DodgerBlue)
                        TrackColorStatus = "16"
                    ElseIf Me.BlockAbsolute And Not Me.Occuppied And Me.DeviceBlocked Then
                        CurrentColorStatus = New SolidBrush(Color.MediumSlateBlue)
                        TrackColorStatus = "56"
                    ElseIf Not Me.BlockAbsolute And Not Me.Occuppied And Me.TrackTagRestrictive Then
                        CurrentColorStatus = New SolidBrush(Color.Cyan)
                        TrackColorStatus = "77"

                    ElseIf Me.Occuppied And Me.BlockAbsolute Then
                        CurrentColorStatus = New SolidBrush(Color.FromArgb(255, 0, 128))
                        TrackColorStatus = "17"
                    ElseIf Me.Occuppied Then
                        CurrentColorStatus = New SolidBrush(Color.Red)
                        TrackColorStatus = "9"
                    Else
                        CurrentColorStatus = New SolidBrush(Color.White)
                        TrackColorStatus = "15"
                    End If

                End If

                If Me.RemoteLinkShowDown Then 'And Not Me.SimulateMode Then
                    CurrentColorStatus = gColorRemoteLinkDown
                    TrackColorStatus = "47"
                    'Me.FailState = True
                End If


                'Apply the traffic arrows
                ApplyTraffic()
                ForceRedraw = False

                Me.PreviousTrackStatus = TrackColorStatus
                PreviousTraffic = Me.TrafficDirection

                If DisplayAuthNumbers Then
                    InitAuthorityNumbers()
                End If

                PreviousColorStatus = Me.CurrentColorStatus


                'Send Status Update to Xmt Queue to send to attached control server
                If Not Me.FailState And Me.IsLinkToRemoteTrack Then
                    SendStatusUpdate()
                End If
                If Me.InvokeRequired Then
                    Me.Invoke(New MethodInvoker(AddressOf Me.Refresh))
                Else
                    Me.Refresh()
                End If


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Sub ApplyTraffic()
            Dim trkRight As Track
            Dim trkLeft As Track
            Dim LeftSideOnly As Boolean
            Dim RightSideOnly As Boolean
            Dim ValidTraffic As Boolean
            Dim Comptype As String = String.Empty
            Dim WarrantTypeIssued As String = String.Empty
            Dim DirectionOfTraffic As String = String.Empty
            Dim OverRideTrafficForTrain As Boolean = False
            Dim OverRideTrafficDirection As String = String.Empty
            Try
                'Find the type of the first warrant in this track to apply the visible traffic
                Dim warr As Warrant
                If Authorities.Count > 0 And Me.AuthorityType <> "DTC" And Not gSFAMode Then
                    For Each warr In Authorities
                        If warr.WarrantType = "ItemFourToMOW" Or warr.WarrantType = "ItemFourToTrain" Then
                            WarrantTypeIssued = warr.WarrantType
                            Exit For
                        Else
                            WarrantTypeIssued = warr.WarrantType
                        End If
                    Next
                    'This is added with item seven stuff here you can have two or more warrants on the sane track
                    'in different directions
                    Dim FirstWarrantInCollection As Warrant = Authorities.Item(0)
                    Dim DirectionOfFirstWarrantInstance As String = FirstWarrantInCollection.Direction
                    For Each warr In Authorities
                        If warr.Direction <> DirectionOfFirstWarrantInstance Then
                            WarrantTypeIssued = "ItemTwoWithItemSeven"
                            Exit For
                        End If
                    Next
                ElseIf Authorities.Count > 0 And Me.AuthorityType = "DTC" And Not gSFAMode Then
                    Dim FirstDTC As DTCAuthority = Authorities.Item(0)
                    WarrantTypeIssued = FirstDTC.AuthorityType
                ElseIf Me.TrackAuthorities.Count > 0 And Mid(Me.AuthorityType, 1, 3) = "TWC" And gSFAMode Then
                    Dim FirstSFA As SFAuthority = Me.TrackAuthorities.Item(0)
                    WarrantTypeIssued = FirstSFA.AuthType1

                    If optUseSingleFormAuthorityVersionII Or optUseSingleFormAuthorityVersionCN And Not optUseSingleFormAuthorityVersionARRC And Not optUseSingleFormAuthorityVersionMRL OrElse optUseSingleFormAuthorityVersionNCTD Then
                        If Me.TrackAuthorities.Count >= 1 Then
                            If (FirstSFA.IssuedToTrain And Not FirstSFA.ShowItemFourComponents And FirstSFA.Box4Components.Contains(Me)) Or
                            (FirstSFA.IssuedToTrain And Not FirstSFA.ShowItemFourComponents And FirstSFA.CheckBoxItemsStatus(3) And Not FirstSFA.CheckBoxItemsStatus(1)) Then
                                OverRideTrafficForTrain = True
                                If Me.TrackAuthorities.Count > 1 Then
                                    Dim NextSFA As SFAuthority = Me.TrackAuthorities.Item(1)
                                    WarrantTypeIssued = NextSFA.AuthType1
                                    OverRideTrafficDirection = NextSFA.Direction
                                ElseIf Me.TrackAuthorities.Count = 1 Then
                                    Dim NextSFA As SFAuthority = Me.TrackAuthorities.Item(0)
                                    WarrantTypeIssued = NextSFA.AuthType1
                                    OverRideTrafficDirection = NextSFA.Direction
                                End If
                            End If
                        End If
                    ElseIf optUseSingleFormAuthorityVersionMRL Or optUseSingleFormAuthorityVersionARRC Then
                        If FirstSFA.Components1.Contains(Me) Then
                            WarrantTypeIssued = FirstSFA.AuthType2
                        End If
                    End If
                End If
                If Me.TrackAuthorities.Count > 0 Then
                    If Me.AuthorityType = "CTC" Then
                        Dim MRSAuth As TrackAuthority.TrackAuthority = Me.TrackAuthorities.Item(0)
                        If MRSAuth.BiDirectional Then
                            DirectionOfTraffic = "BOTH"
                        End If
                    End If
                End If
                Select Case WarrantTypeIssued
                    Case "ItemFourToMOW", "ItemFourToTrain", "ItemTwoWithItemSeven", "DTC-WORK"
                        DirectionOfTraffic = "BOTH"
                    Case Else
                        If OverRideTrafficForTrain Then
                            DirectionOfTraffic = OverRideTrafficDirection
                        Else
                            If DirectionOfTraffic <> "BOTH" Then
                                If Me.TrafficDirection <> "" AndAlso TrafficDirection <> "" Then
                                    DirectionOfTraffic = TrafficDirection
                                End If

                            End If

                        End If
                End Select
                If DirectionOfTraffic = "LEFT" Then
                    If LeftLink = 0 Then
                        ValidTraffic = True
                    Else
                        Comptype = FindComponentType(LeftLink)
                        If Mid(Comptype, 1, 1) = "S" Then
                            If gSwitchPointMonitoringExists Then
                                Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(LeftLink)
                                If Not IsNothing(sw) Then
                                    If sw.NonOperationSwitchPointMonitor And Not optDisableTrafficArrowsSPM Then 'And (sw.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or sw.FailState) Then
                                        ValidTraffic = True
                                    Else
                                        ValidTraffic = False
                                    End If
                                Else
                                    ValidTraffic = False
                                End If
                            Else
                                ValidTraffic = False
                            End If
                        ElseIf Comptype = "L" Or Comptype = "R" Or Comptype = "D" Or Comptype = "U" Then
                            'ValidTraffic = False
                            ValidTraffic = True
                        Else
                            trkLeft = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(LeftLink)
                            If trkLeft Is Nothing Then
                                ValidTraffic = True
                            Else
                                If Not (trkLeft.StationNumber = StationNumber And trkLeft.Name = Name) Then
                                    ValidTraffic = True
                                End If
                            End If
                        End If
                    End If
                ElseIf DirectionOfTraffic = "RIGHT" Then
                    If RightLink = 0 Then
                        ValidTraffic = True
                    Else
                        Comptype = FindComponentType(RightLink)
                        'If Comptype = "S" Then Exit Sub
                        If Mid(Comptype, 1, 1) = "S" Then
                            If gSwitchPointMonitoringExists Then
                                Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(RightLink)
                                If Not IsNothing(sw) Then
                                    If sw.NonOperationSwitchPointMonitor And Not optDisableTrafficArrowsSPM Then 'And (sw.SwitchIndStatus <> Switch.SwIndStatus.NormalInd Or sw.FailState) Then
                                        ValidTraffic = True

                                    Else
                                        ValidTraffic = False
                                    End If
                                Else
                                    ValidTraffic = False
                                End If
                            Else
                                ValidTraffic = False
                            End If
                        ElseIf Comptype = "L" Or Comptype = "R" Or Comptype = "D" Or Comptype = "U" Then
                            'ValidTraffic = False
                            ValidTraffic = True
                        Else
                            trkRight = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(RightLink)
                            If trkRight Is Nothing Then
                                ValidTraffic = True
                            Else
                                If Not (trkRight.StationNumber = StationNumber And trkRight.Name = Name) Then
                                    ValidTraffic = True
                                End If
                            End If

                        End If
                    End If
                ElseIf DirectionOfTraffic = "BOTH" Then

                    If LeftLink = 0 Then
                        ValidTraffic = True
                        LeftSideOnly = True
                    Else
                        Comptype = FindComponentType(LeftLink)
                        If Comptype = "S" Then
                            ValidTraffic = False
                        ElseIf Comptype = "L" Or Comptype = "R" Or Comptype = "D" Or Comptype = "U" Then
                            'ValidTraffic = False
                            ValidTraffic = True
                            LeftSideOnly = True
                        Else
                            trkLeft = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(LeftLink)
                            If trkLeft Is Nothing Then
                                ValidTraffic = True
                                LeftSideOnly = True
                            Else
                                If Not (trkLeft.StationNumber = StationNumber And trkLeft.Name = Name) Then
                                    ValidTraffic = True
                                    LeftSideOnly = True
                                End If
                            End If

                        End If
                    End If


                    If RightLink = 0 Then
                        ValidTraffic = True
                        RightSideOnly = True
                    Else
                        Comptype = FindComponentType(RightLink)
                        'If Comptype = "S" Then Exit Sub
                        If Comptype = "S" Then
                            'ValidTraffic = False
                        ElseIf Comptype = "L" Or Comptype = "R" Or Comptype = "D" Or Comptype = "U" Then
                            'ValidTraffic = False
                            ValidTraffic = True
                            RightSideOnly = True
                        Else
                            trkRight = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(RightLink)
                            If trkRight Is Nothing Then
                                ValidTraffic = True
                                RightSideOnly = True
                            Else
                                If Not (trkRight.StationNumber = StationNumber And trkRight.Name = Name) Then
                                    ValidTraffic = True
                                    RightSideOnly = True
                                End If
                            End If

                        End If
                    End If
                Else
                    ValidTraffic = True
                End If
                If ValidTraffic And Not Me.NonTransverable Then
                    If Me.LY <> Me.RY Then
                        GraphicalPath = pDefaultPath
                        Exit Sub
                    End If
                    Select Case DirectionOfTraffic
                        Case "RIGHT"
                            GraphicalPath = RightTrafficPath
                            Me.GraphicalPathRelative = Me.RTrafficGraphicPathRelative
                        Case "LEFT"
                            GraphicalPath = LeftTrafficPath
                            Me.GraphicalPathRelative = Me.LTrafficGraphicPathRelative
                        Case "BOTH"
                            If RightSideOnly And LeftSideOnly Then
                                GraphicalPath = RLTrafficPath
                                Me.GraphicalPathRelative = Me.RLTrafficPathRelative
                            ElseIf RightSideOnly Then
                                GraphicalPath = RightTrafficPath
                                Me.GraphicalPathRelative = Me.RTrafficGraphicPathRelative
                            ElseIf LeftSideOnly Then
                                GraphicalPath = LeftTrafficPath
                                Me.GraphicalPathRelative = Me.LTrafficGraphicPathRelative
                            End If
                        Case Else
                            GraphicalPath = pDefaultPath
                            Me.GraphicalPathRelative = DefaultPathRelative
                    End Select
                Else
                    GraphicalPath = pDefaultPath
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Sub InvalidateTrack()
            Try
                Me.Invalidate()
                Me.Update()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        ''' <summary>
        ''' Get color status for PTC
        ''' </summary>
        ''' <param name="pTATAuthority"></param>
        ''' <param name="pIsDeviceBlock"></param>
        ''' <param name="pDbBlockColor"></param>
        ''' <returns></returns>
        Private Function GetColorStatusForPTC(ByVal pTATAuthority As Object, Optional ByVal pIsDeviceBlock As Boolean = False, Optional pDbBlockColor As Object = Nothing) As SolidBrush
            Dim auth As Object = Nothing
            Dim mrsAuth As TrackAuthority.TrackAuthority
            Try
                If pTATAuthority IsNot Nothing AndAlso pTATAuthority.GetType.ToString = gTTComponentName Then
                    auth = pTATAuthority
                ElseIf pTATAuthority IsNot Nothing AndAlso pTATAuthority.GetType.ToString = gOtherSplAuthorityName Then
                    auth = pTATAuthority
                Else
                    If Me.TrackAuthorities IsNot Nothing AndAlso Me.TrackAuthorities.Count > 0 Then auth = Me.TrackAuthorities.Item(Me.TrackAuthorities.Count - 1)
                End If
                If Not IsNothing(auth) Then
                    Select Case CType(auth.PTCSTatusSelectionMode, TMDS.GraphicComponent.GenericComponent.ModeSelection) 'auth.PTCSTatusSelectionMode
                        Case ModeSelection.PTCIssuanceImminent
                            Return ColorStatusPTCIssuanceImminent
                        Case ModeSelection.PTCIssuancePending
                            Return ColorStatusPTCIssuancePending
                        Case ModeSelection.PTCReleasePending
                            Return ColorStatusPTCReleasePending
                        Case ModeSelection.PTCReleaseImminent
                            Return ColorStatusPTCReleaseImminent
                    End Select
                End If
                If optEnableMRSSpecificOptions AndAlso Not pIsDeviceBlock Then
                    If Me.TrackAuthorities.Count > 0 Then
                        mrsAuth = Me.TrackAuthorities.Item(0)
                        If mrsAuth IsNot Nothing AndAlso mrsAuth.BiDirectional Then
                            Return New SolidBrush(Color.DodgerBlue)
                        Else
                            Return New SolidBrush(Color.SeaGreen)
                        End If
                    Else
                        Return New SolidBrush(Color.SeaGreen)
                    End If
                ElseIf Not optEnableMRSSpecificOptions AndAlso auth IsNot Nothing AndAlso pIsDeviceBlock Then
                    Return New SolidBrush(Color.DodgerBlue)
                ElseIf pIsDeviceBlock Then
                    If pDbBlockColor IsNot Nothing AndAlso pDbBlockColor.GetType.ToString = "System.Drawing.Color" Then
                        Return New SolidBrush(pDbBlockColor)
                    Else
                        Return New SolidBrush(gDeviceBlockColor)
                    End If
                Else
                    Return New SolidBrush(Color.DodgerBlue)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                If optEnableMRSSpecificOptions Then
                    Return New SolidBrush(Color.SeaGreen)
                Else
                    If pIsDeviceBlock Then
                        Return New SolidBrush(gDeviceBlockColor)
                    Else
                        Return New SolidBrush(Color.DodgerBlue)
                    End If
                End If
            Finally
                auth = Nothing
                mrsAuth = Nothing
            End Try
        End Function

        Private Function GetSFAColorStatusForPTC(ByVal CurrentColor As Color, Optional ByVal Authority As Object = Nothing) As SolidBrush
            Dim auth As Object = Nothing
            Dim objTempAuth As Object = Nothing
            Try

                If optUseSFAColorStatusForPTC AndAlso optEnablePTCBOSVETMSMode Then
                    If Authority Is Nothing Then
                        If Me.AuthorityType.ToUpper.Trim.Contains("TWC") Then
                            If Me.TrackAuthorities IsNot Nothing AndAlso Me.TrackAuthorities.Count > 0 Then
                                For Each objTempAuth In Me.TrackAuthorities
                                    If objTempAuth.GetType.ToString = gSFAComponentName Then
                                        Authority = CType(objTempAuth, TMDS.TrackAuthority.SFAuthority)
                                        Exit For
                                    End If
                                Next
                            End If
                        ElseIf Me.AuthorityType.ToUpper.Trim.Contains("CTC") Then
                            If Me.TrackAuthorities IsNot Nothing AndAlso Me.TrackAuthorities.Count > 0 Then
                                For Each objTempAuth In Me.TrackAuthorities
                                    If objTempAuth.GetType.ToString = gTTComponentName Then
                                        Authority = CType(objTempAuth, TMDS.TrackAuthority.TrackAuthority)
                                        Exit For
                                    End If
                                Next
                            End If

                            If Me.OtherSplAuthorities IsNot Nothing AndAlso Me.OtherSplAuthorities.Count > 0 Then
                                For Each objTempAuth In Me.OtherSplAuthorities
                                    If objTempAuth.GetType.ToString = gOtherSplAuthorityName Then
                                        Authority = CType(objTempAuth, TMDS.TrackAuthority.OtherSpecialAuthorityType)
                                        Exit For
                                    End If
                                Next
                            End If
                        End If
                        If Authority Is Nothing Then Return New SolidBrush(CurrentColor)
                    End If
                Else
                    Return New SolidBrush(CurrentColor)
                End If

                Select Case Authority.GetType.ToString
                    Case gSFAComponentName
                        auth = CType(Authority, TMDS.TrackAuthority.SFAuthority)
                    Case gTTComponentName
                        auth = CType(Authority, TMDS.TrackAuthority.TrackAuthority)
                    Case gOtherSplAuthorityName
                        auth = CType(Authority, TMDS.TrackAuthority.OtherSpecialAuthorityType)
                    Case Else
                        Return New SolidBrush(CurrentColor)
                End Select



                If Authority IsNot Nothing Then
                    Select Case CType(auth.PTCSTatusSelectionMode, TrackComponents.Track.ModeSelection)
                        Case ModeSelection.PTCIssuanceImminent
                            Return SFAColorStatusPTCIssuanceImminent
                        Case ModeSelection.PTCIssuancePending
                            Return SFAColorStatusPTCIssuancePending
                        Case ModeSelection.PTCReleasePending
                            Return SFAColorStatusPTCReleasePending
                        Case ModeSelection.PTCReleaseImminent
                            Return SFAColorStatusPTCReleaseImminent
                    End Select
                End If
                Return New SolidBrush(CurrentColor)
            Catch ex As Exception
                SystemException(ex.ToString)
                Return New SolidBrush(CurrentColor)
            Finally
                auth = Nothing
            End Try
        End Function

        Private Function ApplyFBBlockOutline() As Boolean
            Try
                If Me.AuthorityType <> "CTC" Then Return False
                If Me.DeviceBlocked Or Me.TrackAndTime Then
                    Dim ApplyFBOutLine As Boolean = False
                    If Me.DeviceBlocks IsNot Nothing AndAlso Me.DeviceBlocks.Count > 0 Then
                        Dim dv As DeviceBlock
                        For Each dv In Me.DeviceBlocks
                            If Not dv.OverrideFieldBlocking Then
                                ApplyFBOutLine = True
                                Exit For
                            End If
                        Next
                    End If
                    If Not ApplyFBOutLine Then
                        Dim auth As Object = Nothing
                        If Me.TrackAuthorities IsNot Nothing AndAlso Me.TrackAuthorities.Count > 0 Then
                            For Each auth In Me.TrackAuthorities
                                If auth.GetType.ToString = gTTComponentName Then
                                    If Not auth.OverrideFieldBlocking Then
                                        ApplyFBOutLine = True
                                        Exit For
                                    End If
                                End If
                            Next
                        End If
                    End If
                    If ApplyFBOutLine Then
                        If Me.FieldBlockingIndicationStatus <> FieldBlockStatus.BlockingOn Then
                            Return True
                        End If
                    End If



                End If
            Catch ex As Exception

            End Try
        End Function

