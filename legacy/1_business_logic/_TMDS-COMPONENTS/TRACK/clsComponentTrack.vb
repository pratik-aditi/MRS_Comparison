        ''' <summary>
        ''' Refresh Context Menu 
        ''' </summary>
        Public Sub RefreshContextMenu()
            Try
                If optEnableMOWContextMenu Then BuildMOWIDMenu()
                Select Case AuthorityType
                    Case "CTC"
                        BuildTNTMenus()
                        mnuPosTrain.Enabled = True
                        If optEnableNeedOccupancyToPositionMoveTrain AndAlso
                            Not Occuppied Then mnuPosTrain.Enabled = False
                    Case "NON-TWC", "YL", "RL"
                        BuildTWCMenus()
                    Case "TWC"
                        If Not OsOverAnRCPS AndAlso
                            Not PTCAuthorityPending Then BuildTWCMenus()
                    Case "DTC"
                        BuildDTCMenus()
                End Select
                BuildTagMenus()
                If optEnableBulletinTrackContextMenus Then BuildBulletinMenus()
                If AllowBlocking Then BuildBlockMenus()
                If AllowTrackPermit Then BuildTPMenus()
                If AllowBlueFlag Then BuildBlueFlagMenus()
                If DerailmentDetectorEnabled Then
                    mnuDerailmentDetectorInhibit.Text = If(DerailmentDetectorInhibited,
                        optDerailmentDetectorString2,
                        optDerailmentDetectorString1)
                End If
                If IsShadowMode AndAlso
                    Not JointControl Then
                    For Each menu As MenuItem In ContextMenu.MenuItems
                        menu.Visible = False
                    Next
                End If
                BuildExtendLicenseinSplitDeskMenus()
                BuildPlannedTrainsMenus()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

#Region "MENU BUILDS"

        Private Sub BuildTNTMenus()
            'TrackEvent("BuildTNTMenus")
            Try
                Dim miRemove As MenuItem = Nothing
                Dim miModify As MenuItem = Nothing
                Dim miRollup As MenuItem = Nothing
                If optApplyConfigurationForKCT AndAlso Me.DisallowTNTOnRegionSplit Then Exit Sub
                If optDisableTNTIssueOnNonTransverableTrack Then
                    If Me.AllowTrackTime AndAlso Me.NonTransverable Then
                        mnuTTCreate.Enabled = False
                    ElseIf Me.AllowTrackTime AndAlso Not Me.NonTransverable Then
                        mnuTTCreate.Enabled = True
                    End If
                End If


                If ContextMenuControl.MenuItems.IndexOf(mnuTTRemove) < 0 Then
                    Exit Sub
                End If

                If Not optDisableTNTModify AndAlso ContextMenuControl.MenuItems.IndexOf(mnuTTModify) < 0 Then
                    Exit Sub
                End If

                If optEnableTNTRollUp Then
                    If ContextMenuControl.MenuItems.IndexOf(mnuTTRollup) < 0 Then
                        Exit Sub
                    End If
                End If

                miRemove = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuTTRemove))
                If Not optDisableTNTModify Then miModify = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuTTModify))
                If optEnableTNTRollUp Then
                    miRollup = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuTTRollup))
                End If
                If IsNothing(miRemove) Then
                    Exit Sub
                End If

                If Not optDisableTNTModify AndAlso IsNothing(miModify) Then
                    Exit Sub
                End If
                If optEnableTNTRollUp Then
                    If IsNothing(miRollup) Then
                        Exit Sub
                    End If
                End If

                miRemove.MenuItems.Clear()
                If Not optDisableTNTModify Then miModify.MenuItems.Clear()
                If optEnableTNTRollUp Then
                    miRollup.MenuItems.Clear()
                    miRollup.Visible = False
                End If

                miRemove.Visible = False
                If Not optDisableTNTModify Then miModify.Visible = False

                If Me.TrackAuthorities.Count > 0 Then
                    Dim auth As TrackAuthority.TrackAuthority
                    For Each auth In Me.TrackAuthorities
                        If Mid(auth.AuthorityType, 1, 2) = "TT" Then
                            Dim OKtoShowAuth As Boolean = True
                            If optOnlyAllowReleaseTTOnControlledTerritories Then
                                OKtoShowAuth = CheckAuthTerrExists(auth.TerritoryAssignment)
                            End If

                            If OKtoShowAuth Then
                                miRemove.Visible = True
                                Me.mnuTTRemove.MenuItems.Add(New MenuItem(auth.AuthorityUID & ", (" & auth.IssueTo & ")", AddressOf mnuTTRemove_Click))

                                If Not optDisableTNTModify Then
                                    miModify.Visible = True
                                    Me.mnuTTModify.MenuItems.Add(New MenuItem(auth.AuthorityUID & ", (" & auth.IssueTo & ")", AddressOf mnuTTModify_Click))
                                End If


                                If optEnableTNTRollUp Then
                                    miRollup.Visible = True
                                    Me.mnuTTRollup.MenuItems.Add(New MenuItem(auth.AuthorityUID & ", (" & auth.IssueTo & ")", AddressOf mnuTTRollup_Click))
                                End If
                            End If
                        End If
                    Next
                    Dim DisableMenu As Boolean = False
                    If optDisableTTReportClearOnIsLinkToRemoteTrack Then
                        If Me.IsLinkToRemoteTrack And Me.DisallowTNTOnRegionSplit Then
                            DisableMenu = True
                        End If
                    End If
                    If DisableMenu Then
                        Dim mi As MenuItem
                        If Me.mnuTTRemove IsNot Nothing AndAlso Me.mnuTTRemove.MenuItems IsNot Nothing AndAlso Me.mnuTTRemove.MenuItems.Count > 0 Then
                            For Each mi In Me.mnuTTRemove.MenuItems
                                mi.Enabled = False
                            Next
                        End If
                        If Me.mnuTTModify IsNot Nothing AndAlso Me.mnuTTModify.MenuItems IsNot Nothing AndAlso Me.mnuTTModify.MenuItems.Count > 0 Then
                            For Each mi In Me.mnuTTModify.MenuItems
                                mi.Enabled = False
                            Next
                        End If
                        If optEnableTNTRollUp Then
                            If Me.mnuTTRollup IsNot Nothing AndAlso Me.mnuTTRollup.MenuItems IsNot Nothing AndAlso Me.mnuTTRollup.MenuItems.Count > 0 Then
                                For Each mi In Me.mnuTTRollup.MenuItems
                                    mi.Enabled = False
                                Next
                            End If
                        End If

                    End If

                Else
                    miRemove.Visible = False
