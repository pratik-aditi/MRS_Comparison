        ''' <summary>
        ''' Do Check ToStop TrainOn Derailment Detector
        ''' </summary>
        Private Sub DoCheckToStopTrainOnDerailmentDetector()
            Dim AuthList As New ArrayList
            Dim SegList As New ArrayList
            Dim sig As Signal
            Dim SigList As New ArrayList
            Dim sr As SignalRoute
            Try
                TrackEventLog("DoCheckToStopTrainOnDerailmentDetector:Start")
                If SigList.Count = 0 Then
                    For Each sr In gSignalRouteList
                        If sr.ComponentList.Contains(Me) Then
                            If Not SigList.Contains(sr.EntrySignal) Then
                                SigList.Add(sr.EntrySignal)
                            End If
                        End If
                    Next
                End If
                For Each sig In SigList
                    If Me.OStype Then
                        If Me.Occuppied Then
                            If sig.ComponentType = "R" Then
                                Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sig.LeftLink)
                                If Not IsNothing(trk) Then
                                    If trk.TrackAuthorities.Count > 0 Then
                                        Dim AuthAux As TrackAuthority.TrackAuthority = trk.TrackAuthorities.Item(0)
                                        If Not AuthList.Contains(trk.TrackAuthorities.Item(0)) And AuthAux.Direction = "RIGHT" Then
                                            AuthList.Add(trk.TrackAuthorities.Item(0))
                                            Dim newseg As New LicenseSegment(trk, trk.TrackAuthorities.Item(0))
                                            SegList.Add(newseg)
                                        End If
                                    End If
                                End If
                            Else
                                Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sig.RightLink)
                                If Not IsNothing(trk) Then
                                    If trk.TrackAuthorities.Count > 0 Then
                                        Dim AuthAux As TrackAuthority.TrackAuthority = trk.TrackAuthorities.Item(0)
                                        If Not AuthList.Contains(trk.TrackAuthorities.Item(0)) And AuthAux.Direction = "LEFT" Then
                                            AuthList.Add(trk.TrackAuthorities.Item(0))
                                            Dim newseg As New LicenseSegment(trk, trk.TrackAuthorities.Item(0))
                                            SegList.Add(newseg)
                                        End If
                                    End If
                                End If
                            End If
                        Else
                            If sig.SignalCtlStatus = Signal.CtlStatus.RequestedClear Or sig.SignalCtlStatus = Signal.CtlStatus.RequestingClear Or sig.AutomaticSignal Then
                                If sig.ComponentType = "R" Then
                                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sig.LeftLink)
                                    If Not IsNothing(trk) Then
                                        If trk.TrackAuthorities.Count > 0 Then
                                            If Not AuthList.Contains(trk.TrackAuthorities.Item(0)) Then
                                                AuthList.Add(trk.TrackAuthorities.Item(0))
                                                Dim newseg As New LicenseSegment(trk, trk.TrackAuthorities.Item(0))
                                                SegList.Add(newseg)
                                            End If
                                        End If
                                    End If
                                Else
                                    Dim trk As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(sig.RightLink)
                                    If Not IsNothing(trk) Then
                                        If trk.TrackAuthorities.Count > 0 Then
                                            If Not AuthList.Contains(trk.TrackAuthorities.Item(0)) Then
                                                AuthList.Add(trk.TrackAuthorities.Item(0))
                                                Dim newseg As New LicenseSegment(trk, trk.TrackAuthorities.Item(0))
                                                SegList.Add(newseg)
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    Else
                        If Me.TrackAuthorities.Count > 0 Then
                            If Not AuthList.Contains(Me.TrackAuthorities.Item(0)) Then
                                AuthList.Add(Me.TrackAuthorities.Item(0))
                                Dim newseg As New LicenseSegment(Me, Me.TrackAuthorities.Item(0))
                                SegList.Add(newseg)
                            End If
                        End If

                    End If
                Next
                'To cases like rear of the train
                If SegList.Count = 0 And Me.Occuppied And Me.TrackAuthorities.Count > 0 Then
                    If Not AuthList.Contains(Me.TrackAuthorities.Item(0)) Then
                        AuthList.Add(Me.TrackAuthorities.Item(0))
                        Dim newseg As New LicenseSegment(Me, Me.TrackAuthorities.Item(0))
                        SegList.Add(newseg)
                    End If
                End If
                Dim ls As LicenseSegment
                Dim trToCancel As TacticalRoute = Nothing
                For Each ls In SegList
                    ' Dim theTrain As TrainID = ls.theAuth.IssueTo
                    Dim theTrain As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(ls.theAuth.IssueTo)
                    If Not IsNothing(theTrain) Then
                        Dim tr As TacticalRoute
                        For Each tr In theTrain.myTacticalRoutes
                            If tr.mySignalRoute.ComponentList.Contains(ls.theTrack) OrElse (Me.OStype AndAlso tr.mySignalRoute.ComponentList.Contains(Me)) Then
                                trToCancel = tr
                                Dim TrackTrainList As New ArrayList
                                If Not IsNothing(ls.theAuth) Then
                                    Dim TracksTrain As Object
                                    'Add track from rear until front of the train
                                    For Each TracksTrain In ls.theAuth.ComponentsInSelection
                                        If TracksTrain.GetType.ToString = "TMDS.TrackComponents.Track" Then
                                            Dim TrackAux As Track = CType(TracksTrain, Track)
                                            TrackTrainList.Add(TrackAux.GUID)
                                            If TrackAux.GUID = theTrain.myTrack.GUID Then
                                                Exit For
                                            End If
                                        End If
                                    Next
                                End If
                                'Check if tracks is occupied and if current trains is present in tracktrainlist
                                If tr.mySignalRoute.EntrySignal.SignalIndStatus <> Signal.IndStatus.Cleared And tr.myStatus = "CLEARED" Then

                                End If
                                If Me.Occuppied And TrackTrainList.Contains(Me.GUID) Then
                                    TrackEventLog("DoCheckToStopTrainOnDerailmentDetector:CancelALLLicense1:Train=" & theTrain.Name)
                                    theTrain.CancelAllLicenseForPTC(False, False)
                                Else
                                    TrackEventLog("DoCheckToStopTrainOnDerailmentDetector:CancelPartialLicense1:Train=" & theTrain.Name)
                                    theTrain.PtcCancelNormalLicense(tr.mySignalRoute.EntrySignal, True)
                                End If
                                Exit Sub
                            End If
                        Next
                        If Not IsNothing(trToCancel) Then
                            'check to see if the train is in front of DD and if so cancel the entire license
                            Dim CancelEntireLicense As Boolean
                            Dim Index As Integer = theTrain.myTacticalRoutes.IndexOf(trToCancel)
                            Dim trToCheck As TacticalRoute = Nothing
                            If Index <> 0 Then
                                trToCheck = theTrain.myTacticalRoutes.Item(Index - 1)
                                If Not IsNothing(trToCheck) Then
                                    If trToCheck.mySignalRoute.ComponentList.Contains(theTrain.myTrack) Then
                                        CancelEntireLicense = True
                                    End If
                                End If
                            End If
                            If Not CancelEntireLicense Then
                                TrackEventLog("DoCheckToStopTrainOnDerailmentDetector:CancelPartialLicense2:Train=" & theTrain.Name)
                                theTrain.PtcCancelNormalLicense(trToCancel.mySignalRoute.EntrySignal, True)
                                Exit Sub
                            Else
                                TrackEventLog("DoCheckToStopTrainOnDerailmentDetector:CancelPartialLicense3:Train=" & theTrain.Name)
                                theTrain.PtcCancelNormalLicense(Nothing, True)
                                Exit Sub
                            End If
                        ElseIf Me.Occuppied Then
                            TrackEventLog("DoCheckToStopTrainOnDerailmentDetector:CancelALLLicense2:Train=" & theTrain.Name)
                            theTrain.CancelAllLicenseForPTC(False, False)
                            Exit Sub
                        End If
                    End If
                Next
                'if the track in front of the signal does not have a tactical route then just cancel entire license
                If SegList.Count > 0 Then
                    For Each ls In SegList
                        Dim theTrain As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(ls.theAuth.IssueTo)
                        If Not IsNothing(theTrain) Then
                            If ls.theTrack.TrainIDs.Count > 0 Then
                                Dim trn As TrainID = ls.theTrack.TrainIDs.Item(0)
                                If trn.Name = theTrain.Name Then
                                    TrackEventLog("DoCheckToStopTrainOnDerailmentDetector:CancelALLLicense3:Train=" & theTrain.Name)
                                    theTrain.PtcCancelNormalLicense(Nothing, True)
                                    Exit For
                                End If
                            End If
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

