        Sub InitTagDisplay()
            Try
                Dim TagToCheck As Tag
                Dim ContainsRestrictiveTag As Boolean
                For Each TagToCheck In TrackTagLabels
                    If TagToCheck.Restriction Then
                        ContainsRestrictiveTag = True
                        Exit For
                    End If
                Next

                If TrackTagLabels.Count > 0 Then
                    TrackTagText = Nothing
                    TrackTagText = New TrackTagFont()
                    If ContainsRestrictiveTag Then
                        TrackTagText.TagType = "RESTRICTIVE"
                    Else
                        TrackTagText.TagType = ""
                    End If
                    Dim TrkTag As Tag

                    If IsNothing(Me.myGraphic) Then
                        Me.myGraphic = Me.CurrentDrawingForm.CreateGraphics
                    End If

                    TrackTagText.Graphical = Me.myGraphic
                    TrackTagText.Name = TrackTagLabels.Count.ToString

                    'check to see if tag placement is behind a turn out track that is link from switch downwards.
                    Dim SwtoRight As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(Me.RightLink)
                    Dim TagPositionDither As Integer = 0
                    If Not SwtoRight Is Nothing Then
                        If SwtoRight.LeftAltLink <> 0 Then
                            Dim LeftTrackLink As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(SwtoRight.LeftAltLink)
                            If Not LeftTrackLink Is Nothing Then
                                If LeftTrackLink.LY > LeftTrackLink.RY Then
                                    TagPositionDither = 15
                                End If
                            End If
                        End If
                    End If
                    TrackTagText.Left = RX - 15 - TagPositionDither
                    TrackTagText.Top = RY + 11
                    TrackTagText.BuildGraphics()
                    InvalidateTagFont()

                    Dim foundSpeedTag As Boolean = False
                    Dim foundTrackAlarmTag As Boolean = False

                    For Each tg As Tag In Me.TrackTagLabels
                        If tg.TagType = optTagType1 Then
                            foundSpeedTag = True
                        End If
                        If tg.TagType = optTagType6 Then
                            foundTrackAlarmTag = True
                        End If
                    Next
                    If Not foundSpeedTag AndAlso foundTrackAlarmTag Then
                        TrackTagText.Draw(myGraphic, True)
                    Else
                        TrackTagText.Draw(myGraphic, False)
                    End If
                    TrkTag = Nothing
                Else
                    InvalidateTagFont()
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

