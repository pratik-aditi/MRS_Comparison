#Region " BNSF Specific PSS V1.0"

        Private Sub FindExemptTrack()

            Dim Comp As Object = Nothing
            Dim LastSignalFoud As Boolean
            Dim CloneSelection As New ArrayList
            Dim FirstSignal As Signal = Nothing

            Try
                CloneSelection = gEntExtTrackSelection.Clone

                For Each Comp In CloneSelection
                    If Comp.GetType.ToString = gSignalComponentName Then
                        FirstSignal = Comp
                        Exit For
                    End If

                Next
                Comp = Nothing
                If FirstSignal Is Nothing Then
                    Exit Sub
                End If

                If FirstSignal.ComponentType = "L" Then
                    Comp = FindCompFromGUID(FirstSignal.LeftLink)
                    For i As Integer = 1 To 20
                        If Not LastSignalFoud Then
                            If Comp Is Nothing Then Exit For
                            Select Case Comp.GetType.ToString

                                Case gTrackComponentName
                                    If Not PSSOriginalCompCollection.Contains(Comp) Then
                                        If Not ExemptTrackCollection.Contains(Comp) Then
                                            ExemptTrackCollection.Add(Comp)
                                            Comp = FindCompFromGUID(Comp.LeftLink)
                                        End If
                                    End If
                                Case gSwitchComponentName
                                    Comp = FindCompFromGUID(Comp.LeftLink)
                                Case gSignalComponentName
                                    If Comp.ComponentType = "L" Or Comp.ComponentType = "U" Then
                                        LastSignalFoud = True
                                    Else
                                        Comp = FindCompFromGUID(Comp.LeftLink)
                                    End If
                                Case Else
                                    Comp = FindCompFromGUID(Comp.LeftLink)
                            End Select
                        Else
                            Exit For
                        End If
                    Next
                Else
                    Comp = FindCompFromGUID(FirstSignal.RightLink)
                    For i As Integer = 1 To 20
                        If Not LastSignalFoud Then
                            If Comp Is Nothing Then Exit For
                            Select Case Comp.GetType.ToString

                                Case gTrackComponentName
                                    If Not PSSOriginalCompCollection.Contains(Comp) Then
                                        If Not ExemptTrackCollection.Contains(Comp) Then
                                            ExemptTrackCollection.Add(Comp)
                                            Comp = FindCompFromGUID(Comp.RightLink)
                                        Else
                                            Comp = FindCompFromGUID(Comp.RightLink)
                                        End If
                                    Else
                                        Comp = FindCompFromGUID(Comp.RightLink)
                                    End If
                                Case gSwitchComponentName
                                    Comp = FindCompFromGUID(Comp.RightLink)
                                Case gSignalComponentName
                                    If Comp.ComponentType = "R" Or Comp.ComponentType = "D" Then
                                        LastSignalFoud = True
                                    Else
                                        Comp = FindCompFromGUID(Comp.RightLink)
                                    End If
                                Case Else
                                    Comp = FindCompFromGUID(Comp.RightLink)
                            End Select
                        Else
                            Exit For
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally

                Comp = Nothing
                CloneSelection = Nothing

            End Try
        End Sub

        ''' <summary>
        ''' Finds the exempt track in the selection - BNSF.
        ''' </summary>
        ''' <remarks></remarks>
        Private Sub FindExemptTrack_BNSF()

            Dim lastSignalFound As Boolean
            Dim firstSignal As Signal = Nothing
            Dim nextComponent As Object = Nothing

            Try

                'For Each tmdsComponent As Object In gEntExtTrackSelection

                '    If tmdsComponent.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                '        firstSignal = tmdsComponent
                '        Exit For
                '    End If

                'Next
                firstSignal = FindFirstSignalInCurrentSelection()

                If firstSignal Is Nothing Then
                    Exit Sub
                End If

                If firstSignal.ComponentType = "L" Then

                    nextComponent = FindCompFromGUID(firstSignal.LeftLink)

                    For i As Int32 = 1 To 20

                        If Not lastSignalFound Then

                            If nextComponent Is Nothing Then
                                Exit For
                            End If

                            Select Case nextComponent.GetType.ToString

                                Case "TMDS.TrackComponents.Track"

                                    If Not PSSOriginalCompCollection.Contains(nextComponent) Then
                                        If Not ExemptTrackCollection.Contains(nextComponent) Then
                                            ExemptTrackCollection.Add(nextComponent)
                                            nextComponent = FindCompFromGUID(nextComponent.LeftLink)
                                        End If
                                    End If

                                Case "TMDS.SwitchComponents.Switch"
                                    nextComponent = FindCompFromGUID(nextComponent.LeftLink)

                                Case "TMDS.SignalComponents.Signal"
                                    If nextComponent.ComponentType = "L" Or nextComponent.ComponentType = "U" Then
                                        lastSignalFound = True
                                    Else
                                        nextComponent = FindCompFromGUID(nextComponent.LeftLink)
                                    End If

                                Case Else
                                    nextComponent = FindCompFromGUID(nextComponent.LeftLink)

                            End Select
                        Else
                            Exit For
                        End If

                    Next

                Else

                    nextComponent = FindCompFromGUID(firstSignal.RightLink)

                    For i As Int32 = 1 To 20

                        If Not lastSignalFound Then

                            If nextComponent Is Nothing Then
                                Exit For
                            End If

                            Select Case nextComponent.GetType.ToString

                                Case "TMDS.TrackComponents.Track"

                                    If Not PSSOriginalCompCollection.Contains(nextComponent) Then
                                        If Not ExemptTrackCollection.Contains(nextComponent) Then
                                            ExemptTrackCollection.Add(nextComponent)
                                            nextComponent = FindCompFromGUID(nextComponent.RightLink)
                                        Else
                                            nextComponent = FindCompFromGUID(nextComponent.RightLink)
                                        End If
                                    Else
                                        nextComponent = FindCompFromGUID(nextComponent.RightLink)
                                    End If

                                Case "TMDS.SwitchComponents.Switch"
                                    nextComponent = FindCompFromGUID(nextComponent.RightLink)

                                Case "TMDS.SignalComponents.Signal"

                                    If nextComponent.ComponentType = "R" Or nextComponent.ComponentType = "D" Then
                                        lastSignalFound = True
                                    Else
                                        nextComponent = FindCompFromGUID(nextComponent.RightLink)
                                    End If
                                Case Else
                                    nextComponent = FindCompFromGUID(nextComponent.RightLink)

                            End Select

                        Else
                            Exit For
                        End If

                    Next

                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally

                nextComponent = Nothing
                firstSignal = Nothing

            End Try
        End Sub

        ''' <summary>
        ''' Finds the index of first signal in current selection.
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Function FindIndexOfFirstSignalInCurrentSelection() As Int32

            Dim firstSignalIndex As Int32

            For i As Int32 = 0 To gEntExtTrackSelection.Count - 1
                If gEntExtTrackSelection(i).GetType.ToString = "TMDS.SignalComponents.Signal" Then
                    firstSignalIndex = i
                    Exit For
                End If
            Next

            Return firstSignalIndex

