                            Train.DisplayText = optHelperTrainSymbolPrefix & Train.DisplayText
                        End If

                        If optEnableCPTrainsheet And Train.GhostTrain Then
                            Train.DisplayText = "G" & Space(1) & Train.DisplayText
                        ElseIf optEnableCPTrainsheet And Not Train.GhostTrain Then
                            If Train.DisplayText.Contains("$") Then
