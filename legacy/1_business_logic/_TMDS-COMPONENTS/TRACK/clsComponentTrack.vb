        Private Function ShowErrorMessageBox(ByVal MessageList As ArrayList, ByVal Header As String, ByVal ReasonCode As String, ByVal YesNoButton As Boolean) As Integer
            If MessageList Is Nothing Then Return -1
            Dim frmMessageBox As frmMessageBox = Nothing

            Try
                Dim LaunchPoint As New Point(Me.Left + 20, Me.Top + 50)
                frmMessageBox = New frmMessageBox()
                frmMessageBox.Owner = Me.CurrentDrawingForm
                frmMessageBox.SetMessage(MessageList, Header, YesNoButton, LaunchPoint)
                frmMessageBox.ShowDialog()
                Return frmMessageBox.FormFeedBack
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                MessageList.Clear()
                MessageList = Nothing
                frmMessageBox.Close()
                frmMessageBox.Dispose()
                frmMessageBox = Nothing
            End Try

        End Function



