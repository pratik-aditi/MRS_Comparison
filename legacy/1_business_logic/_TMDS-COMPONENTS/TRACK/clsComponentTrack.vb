        Overloads Sub ReleaseMOWID(ByVal mow As MOWID)
            Try
                Dim CompCollection As ArrayList = CollectComponentsOfLikeTracks()
                Dim CompToCheck As Object = Nothing
                If Not IsNothing(CompCollection) Then
                    For Each CompToCheck In CompCollection
                        CompToCheck.Occuppied = False
                        CompToCheck.UpdateStatus()
                    Next
                End If
                If MOWIDs.Count > 0 Then
                    'mow = MOWIDs(0)
                    ReleaseMOWIDPosition(mow)
                    MOWIDs.Remove(mow)
                    Dim MOWLIST As ArrayList = MOWCollection.Clone
                    Dim MW As MOWID
                    For Each MW In MOWLIST
                        If MW.Name = mow.Name Then
                            MOWCollection.Remove(MW)
                        End If
                    Next
                    InitMOWDisplay()
                    UpdateStatus()
                End If
                CompCollection = Nothing
                mow = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Overloads Sub ReleaseMOWID(ByRef MOWPosition As Integer, ByRef pMOWCollection As ArrayList)
            Try
                Dim CompCollection As ArrayList = CollectComponentsOfLikeTracks()
                Dim CompToCheck As Object = Nothing
                For Each CompToCheck In CompCollection
                    CompToCheck.Occuppied = False
                    CompToCheck.UpdateStatus()
                Next
                Dim mow As MOWID
                If MOWIDs.Count >= MOWPosition Then
                    mow = MOWIDs(MOWPosition)
                    ReleaseMOWIDPosition(mow)
                    TrainIDs.Remove(mow)
                    MOWIDs.Remove(mow)
                    If MOWIDs.Count = 0 Then
                        Occuppied = False
                    End If
                    InitMOWDisplay()

                    UpdateStatus()
                End If
                CompCollection = Nothing
                mow = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
