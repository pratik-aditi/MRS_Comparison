                    End If
                End While
                If myTrafficDirection.Equals(String.Empty) Then
                    While Not SearchLeftComplete
                        NextReferenceNumber = Me.LeftLink
                        While Not NextTrackFound
                            CompToCheck = Me.FindObjectTypeFromGUID(NextReferenceNumber)
