                                            Else
                                                Exit While
                                            End If
                                        Else
                                            If trn.Direction = optDirectionEast Or trn.Direction = optDirectionNorth Then
                                                If Not NextComp.TrainIDTracked Then
                                                    TrackIDsOffTrack(Me, NextComp)
                                                End If
                                            Else
                                                Exit While
                                            End If
                                        End If
                                    Else
                                        Exit While
                                    End If
                                ElseIf Not NextComp.Indicating Then
                                    TrackIDsOffTrack(Me, NextComp)
                                    Exit Sub
                                End If
                                If Me.TrainIDs.Count > 0 Then
                                    If Me.ReleaseTrainIDTrack Then
                                        If optEnableBRCSpecificChecks Then
                                            BRCTrainPostion = 0
                                            If ReleaseTrainIDCheckBRC(BRCTrainPostion) Then
                                                Me.ReleaseTrainID(BRCTrainPostion, TMDS.GlobalDeclarations.TrainCollection)
