                            If gBlockOSDevices Then
                                gDeviceBlockSelection.Remove(comp)
                                comp.SelectionMode = ModeSelection.Regular
                                comp.FlasherMode(False)
                                comp.Flasher.Interval = 250
                            Else
                                If comp.GetType.ToString = "TMDS.TrackComponents.Track" And Not gBlockOSDevices Then
                                    gDeviceBlockSelection.Remove(comp)
                                    comp.SelectionMode = ModeSelection.Regular
                                    comp.FlasherMode(False)
                                    comp.Flasher.Interval = 250
                                End If
                            End If
                            If comp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                If Not SwList.Contains(comp) Then
                                    SwList.Add(comp)
                                End If
                            End If
                        Next
                    End If

                    gDeviceBlockSelection.Remove(Me)
                    Me.SelectionMode = ModeSelection.Regular
                    Me.FlasherMode(False)

                    TMDS.SystemForms.MySystemForms.frmMainMDI.DeviceBlockFlasherReset()

                End If

                If optEnableTerritoryDeskAssignmentMode Then
                    If IsValidJointControlComponents(gDeviceBlockSelection) Then
                        LockJointControlComponent(gDeviceBlockSelection)
                    Else
                        TrackEventLog("Track in Use Exiting:" & Me.GUID.ToString)
                        MessageBox.Show(Me.CurrentDrawingForm, "TRACK IN USE BY OTHER DESK- EXITING!", "System Message", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        ClearSystemVariables()
                        Exit Sub
                    End If
                End If

                If optEnableBRCSpecificChecks Then


                    Dim XingList As New ArrayList
                    Dim comp As Object = Nothing
                    Dim LObject As Object = Nothing
                    Dim RObject As Object = Nothing
                    Try
                        For Each comp In gDeviceBlockSelection
                            If comp.GetType.ToString = gTrackComponentName Then
                                LObject = FindCompFromGUID(comp.LeftLink)
                                RObject = FindCompFromGUID(comp.RightLink)
                                If LObject IsNot Nothing AndAlso LObject.GetType.ToString = gRRXINGComponentName Then
                                    If Not XingList.Contains(LObject) Then XingList.Add(LObject)
                                End If
                                If RObject IsNot Nothing AndAlso RObject.GetType.ToString = gRRXINGComponentName Then
                                    If Not XingList.Contains(RObject) Then XingList.Add(RObject)
                                End If
                            End If
                        Next
                        If XingList IsNot Nothing AndAlso XingList.Count > 0 Then
                            Dim IsOktoIssueDB As Boolean = True
                            Dim Message As String = "SIGNAL ACTIVITY FOUND IN SELECTION"
                            For Each comp In XingList
                                If comp IsNot Nothing Then
                                    LObject = FindCompFromGUID(comp.LeftLink)
                                    RObject = FindCompFromGUID(comp.LeftAltLink)
                                    If LObject IsNot Nothing AndAlso LObject.GetType.ToString = gTrackComponentName Then
                                        If LObject.SignalStatOnMe <> SignalStatus.SignalAtStop Then
                                            IsOktoIssueDB = False
                                            Exit For
                                        End If
                                    End If
                                    If RObject IsNot Nothing AndAlso RObject.GetType.ToString = gTrackComponentName Then
                                        If RObject.SignalStatOnMe <> SignalStatus.SignalAtStop Then
                                            IsOktoIssueDB = False
                                            Exit For
                                        End If
                                    End If
                                End If

                            Next
                            If Not IsOktoIssueDB Then
                                SyncLock gSystemFeedbackQueue
                                    gSystemFeedbackQueue.Enqueue(Message)
                                End SyncLock
                                ClearSystemVariables()
                            End If
                        End If
                    Catch exp As Exception
                    Finally
                        XingList = Nothing
                        LObject = Nothing
                        RObject = Nothing
                        comp = Nothing
                    End Try
                End If



            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Dim sw As Switch
            For Each sw In SwList
                sw.SetOutOfCorespondenceReverse = False
                sw.SetOutOfCorespondenceNormal = False
                sw.UpdateStatus()
            Next
        End Sub

        Private Sub DoTrackAndTimeAuthority(ByVal e As MouseEventArgs)
            Try

                If Me.AuthorityType <> "CTC" Then ClearSystemVariables() : Exit Sub

                If gOptDisableTrackSelectionOnTurnOut AndAlso Me.TurnOutType Then Exit Sub

                If Me.IsLinkToRemoteTrack And Me.DisallowTNTOnRegionSplit Then
                    Exit Sub
                End If

                If Not Me.AllowTrackTime Then
                    Exit Sub
                End If

                If Me.IsLinkToRemoteTrack Then
                    'Me.RemotePendingBlock = True
                End If


                If optEnableRouteBlocking Then
                    If Me.RouteBlockingEnabled Then
                        If Me.RightLimitName = "IGNORE" And Me.LeftLimitName = "IGNORE" Then
                            Exit Sub
                        End If
                    End If
                End If
                SetCursor(curCreateTT)

                If gBeginTrackSelect Is Nothing Then
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrSelectionFlasher.Enabled = True
                    gBeginTrackSelect = Me
                    TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionAdd(Me)


                    If Not optDisableExpandOutLogicOnOsTracks Then
                        Me.AddOSComponents(gTrackSelectionCollection)
                    End If
                    If optEnableRouteBlocking Then
                        If Me.RouteBlockingEnabled Then
                            Me.ExpandOutForComponentsForRouteBlocking(gTrackSelectionCollection)
                        Else
                            Me.ExpandOutForComponents(gTrackSelectionCollection)
                        End If
                    Else
                        Me.ExpandOutForComponents(gTrackSelectionCollection)
                    End If

                    If optEnableBRCSpecificChecks = True Then
                        If DoSelectAllALikeTracks(gTrackSelectionCollection) Then
                            Me.AddOSComponents(gTrackSelectionCollection)
                        End If
                    End If

                    TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionReset()

                    Dim comp As Object
                    For Each comp In gTrackSelectionCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If optEnableShadowModeRemoteLink AndAlso (comp.IsShadowRemoteTrack) AndAlso comp.myRemoteTrack IsNot Nothing Then
                                If Not comp.myRemoteTrack.SendBlockPendingStatus(True, True) Then
                                    DisplayPromptRegardingLinkFailure()
                                    ClearSystemVariables()
                                    Exit Sub
                                End If
                            ElseIf comp.IsRemoteTrack Then
                                If Not comp.myRemoteTrack.SendBlockPendingStatus(True, True) Then
                                    DisplayPromptRegardingLinkFailure()
                                    ClearSystemVariables()
                                    Exit Sub
                                End If
                            End If
                        End If
                    Next


                    FirstTrackSelectionMousePoint = e.X
                    Me.TrackEventLog("SELECTED BEGINNING TRACK(AUTHORITY):" & Me.GUID.ToString)
                ElseIf gBeginTrackSelect Is Me Then
                    If Not IsNothing(gEndTrackSelect) Then
                        If gTrackSelectionCollection.Contains(gEndTrackSelect) Then
                            TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionClear()
                            ClearSystemVariables()
                            Exit Sub
                        End If
                    End If
                    TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionAdd(Me)
                    If Not optDisableExpandOutLogicOnOsTracks Then
                        Me.AddOSComponents(gTrackSelectionCollection)
                    End If
                    Me.ExpandOutForComponents(gTrackSelectionCollection)
                    TMDS.SystemForms.MySystemForms.frmMainMDI.SelectionReset()

                    If Mid(gBeginTrackSelect.AuthorityType, 1, 3) <> "CTC" Then
                        ClearSystemVariables()
                        MessageBox.Show(Me, "Route Selected Is Not CTC Controlled", "System Message", MessageBoxButtons.OK, MessageBoxIcon.Information)
                        Exit Sub
                    End If

                    gEndTrackSelect = Me
                    If gSearchDirection = "" Then
                        If FirstTrackSelectionMousePoint > e.X Then
                            gSearchDirection = "LEFT"
                        ElseIf FirstTrackSelectionMousePoint <= e.X Then
                            gSearchDirection = "RIGHT"
                        Else
                            gSearchDirection = ""
                        End If
                    ElseIf Not gTNTContinue Then
                        TMDS.modSystemFuncs.ClearSystemVariables()
                        TMDS.SystemForms.MySystemForms.frmMainMDI.tmrSelectionFlasher.Enabled = True
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    'ADDED FOR REMOTE BLOCKING
                    Dim CompToTest As Object
                    Dim LeftLink As Track = Nothing
                    Dim RightLink As Track = Nothing
                    For Each CompToTest In gTrackSelectionCollection
                        If CompToTest.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If CompToTest.IsLinkToRemoteTrack Then
                                LeftLink = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(CompToTest.LeftLink)
                                RightLink = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(CompToTest.RightLink)
                                Exit For
                            End If
                        End If
                    Next
                    If Not IsNothing(LeftLink) Then
                        If Not gTrackSelectionCollection.Contains(LeftLink) Then
                            gTrackSelectionCollection.Add(LeftLink)
                        End If
                    End If
                    If Not IsNothing(RightLink) Then
                        If Not gTrackSelectionCollection.Contains(RightLink) Then
                            gTrackSelectionCollection.Add(RightLink)
                        End If
                    End If

                    Me.TrackEventLog("SELECTED ENDING TRACK(AUTHORITY):" & Me.GUID.ToString)
                    'SystemForms.MySystemForms.frmMainMDI.ShowLimits()
                Else
                    If optApplyConfigurationForKCT AndAlso gEndTrackSelect Is Nothing Then
                        If gTrackSelectionCollection.Contains(Me) Then
                            gEndTrackSelect = Me
                            If gSearchDirection = "" Then
                                If FirstTrackSelectionMousePoint > e.X Then
                                    gSearchDirection = "LEFT"
                                ElseIf FirstTrackSelectionMousePoint <= e.X Then
                                    gSearchDirection = "RIGHT"
                                Else
                                    gSearchDirection = ""
                                End If
                            End If
                            Exit Sub
                        End If
                    End If
                    gEndTrackSelect = Me
                    If optEnableBRCSpecificChecks Or optApplyConfigurationForKCT Then Me.ExpandOutForComponents(gTrackSelectionCollection)
                    Me.TrackEventLog("SELECTED ENDING TRACK(AUTHORITY):" & Me.GUID.ToString)
                    TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(System.Windows.Forms.Cursors.WaitCursor)
                    If TMDS.SystemForms.MySystemForms.frmMainMDI.SearchRouteForEndOfCTCTrack() Then
                        TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curCreateTT)

                        If optAllowAutoSwitchReverseIntoSidingForTNT Then
                            gBeginTrackSelect = TMDS.SystemUtilities.FetchData.FindLastTrackInList(gTrackSelectionCollection)
                        End If
                        'gBeginTrackSelect = Me
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

