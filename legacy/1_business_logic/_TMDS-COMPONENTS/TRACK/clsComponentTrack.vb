        Private Sub CheckToPublishTrainMoveEventToAutoRouter(ByVal trn As TrainID)
            Try
                TMDS.SystemUtilities.Utilities.SystemEvent("CheckToPublishTrainMoveEventToAutoRouter")

                Dim tr As TacticalRoute = FindTacticalRoute(GetSignalList, trn)

                If Not IsNothing(tr) Then
                    TMDS.NetworkMessages.MPARMessages.SendRouteStatusMessage(tr, "UPDATE", "COMPLETED")
                    trn.SendTrainMoveEventToAutoRouter(tr)
                    trn.myTacticalRoutes.Remove(tr)
                    TMDS.SystemUtilities.Utilities.SystemEvent("CheckToPublishTrainMoveEventToAutoRouter1")
                Else
                    If trn.AutomaticModeOn Then
                        If Me.myControlPoint.AutomaticModeOn Then
                            trn.ToggleAutoRouting(True, "OS MOVE EVENT ON A TRAIN IN AUTOMATIC MODE")
                            TMDS.SystemUtilities.Utilities.SystemEvent("CheckToPublishTrainMoveEventToAutoRouter2")
                        Else
                            trn.TriggerAutoRoutingEvent("TRAIN MOVEMENT FROM DISBALED CONTROL POINT", True)
                            TMDS.SystemUtilities.Utilities.SystemEvent("CheckToPublishTrainMoveEventToAutoRouter3")
                        End If
                    Else
                        trn.ToggleAutoRouting(False, "ERROR FINDING TACTICAL ROUTE FROM OS EVENT")
                        TMDS.SystemUtilities.Utilities.SystemEvent("CheckToPublishTrainMoveEventToAutoRouter4")
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function FindTacticalRoute(ByVal SigList As ArrayList, ByVal trn As TrainID) As TacticalRoute
            Try
                Dim tr As TacticalRoute
                If IsNothing(SigList) Then Return Nothing
                For Each tr In trn.myTacticalRoutes
                    If SigList.Contains(tr.mySignalRoute.EntrySignal) Then
                        Return tr
                    End If
                Next
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function GetSignalList() As ArrayList
            Dim SigList As New ArrayList
            Dim Sig As Signal

            Try
                If Not IsNothing(Me.SignalSlotCollection) Then
                    For Each Sig In Me.SignalSlotCollection
                        SigList.Add(Sig)
                    Next
                End If

                If Not IsNothing(Me.OsComponentCollection) Then
                    Dim comp As Object
                    For Each comp In Me.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            Dim LeftSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(trk.LeftLink)
                            Dim RightSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(trk.RightLink)
                            If Not IsNothing(LeftSig) Then
                                If Not SigList.Contains(LeftSig) Then
                                    SigList.Add(LeftSig)
                                End If
                            End If
                            If Not IsNothing(RightSig) Then
                                If Not SigList.Contains(RightSig) Then
                                    SigList.Add(RightSig)
                                End If
                            End If
                        End If
                    Next
                Else
                    Dim LeftSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.LeftLink)
                    Dim RightSig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.RightLink)
                    If Not IsNothing(LeftSig) Then
                        If Not SigList.Contains(LeftSig) Then
                            SigList.Add(LeftSig)
                        End If
                    End If
                    If Not IsNothing(RightSig) Then
                        If Not SigList.Contains(RightSig) Then
                            SigList.Add(RightSig)
                        End If
                    End If

                End If
                Return SigList
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function CheckForSignalInSlottingList(ByVal sigToCheck As Signal) As Boolean

            Dim Sig As Signal
            Try
                For Each Sig In Me.SignalSlotCollection
                    If Sig.GUID = sigToCheck.GUID Then
                        Return True
                    End If
                Next
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
