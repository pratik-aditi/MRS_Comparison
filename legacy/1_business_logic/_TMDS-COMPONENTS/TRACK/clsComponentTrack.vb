        Private Sub CheckToStopTrainOnOSOccupancy()
            Try
                Dim DoTheCheck As New PerformCheckToStopTrainOnOSOccupancy(AddressOf DoCheckToStopTrainOnOSOccupancy)
                DoTheCheck.BeginInvoke(Nothing, Nothing)
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoCheckToStopTrainOnOSOccupancy() 'release license behind the train
            Try

                'Fixes to rmt 654 - Disable auto cancel over switches to CBTC region
                'Added condition (theTrack.IsTrackWarrantEnforcementEnabled)
                'jcosta - 11/30/16

                If Not Me.IsTrackWarrantEnforcementEnabled Then
                    'SystemEvent("DoCheckToStopTrainOnOSOccupancy_DCOS-001:" & Me.Name)
                    Exit Sub
                End If

                If Me.OStype And Not Me.OSReleaseTrackForRollup Then Exit Sub
                SystemEvent("DoCheckToStopTrainOnOSOccupancy:" & Me.Name)
                Threading.Thread.Sleep(3000)

                Dim theTrack As Track = Me
                Dim theSwitch As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(Me)
                If IsNothing(theSwitch) Then Exit Sub
                If theTrack.TrackAuthorities.Count = 0 Then Exit Sub

                Dim leftTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackFromSwitch(theSwitch, "LEFT")
                If Not IsNothing(leftTrack) Then
                    If leftTrack.Occuppied Then Exit Sub
                End If

                Dim rightTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackFromSwitch(theSwitch, "RIGHT")
                If Not IsNothing(rightTrack) Then
                    If rightTrack.Occuppied Then Exit Sub
                End If
                If Me.Occuppied AndAlso Me.TrainIDs.Count = 0 Then
                    If Mid(Me.AuthorityType, 1, 3) = "CTC" Then
                        Dim auth As TrackAuthority.TrackAuthority = Me.TrackAuthorities.Item(0)
                        If IsNothing(auth) Then Exit Sub
                        Dim theTrain As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromIDUnit(auth.IssueTo)
                        If IsNothing(theTrain) Then Exit Sub
                        Dim tr As TacticalRoute
                        For Each tr In theTrain.myTacticalRoutes
                            If tr.mySignalRoute.ComponentList.Contains(Me) Then
                                SystemEvent("DoCheckToStopTrainOnOSOccupancy:CancelLicenseForTrain" & Me.Name)

                                'Commented: TO address Automatic cancellation of License.
                                theTrain.PtcCancelNormalLicense(tr.mySignalRoute.EntrySignal, True)
                            End If
                        Next
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub PerformLicenseReleaseForMRS()
            Try
                If Me.SuppressAuthorityRelease Then Exit Sub

                SystemEvent("PerformLicenseReleaseForMRS:TrackName:" & Me.Name & "-TrackGUID" & Me.GUID & "-isPostion:" & IsPositionReportingTrack.ToString & "-TrainIDPlace:" & Me.TrainIDPlace.ToString)

                Dim data() As String
                Dim symbol() As String
                Dim trn As TrainID = Nothing

                If LastTrainSymbolOnMe <> "" Then
                    data = LastTrainSymbolOnMe.Split(" ")
                    symbol = data(0).Split(":")
                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(symbol(0))
                    SystemEvent("PerformLicenseReleaseForMRS1:TrackName:" & Me.Name & ":" & Me.GUID)
                End If
                If IsNothing(trn) Then
                    If Me.TrackAuthorities.Count > 0 Then
                        Dim auth As TrackAuthority.TrackAuthority = Me.TrackAuthorities.Item(0)
                        If IsNothing(auth) Then Exit Sub
                        trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(auth.TrainSymbol)
                        SystemEvent("PerformLicenseReleaseForMRS2:TrackName:" & Me.Name & ":" & Me.GUID)
                    End If
                End If
                If Not IsNothing(trn) Then
                    SystemEvent("PerformLicenseReleseForMRS3.1:TrackName:" & Me.Name & ":" & Me.GUID)

                    If trn.GeoFenceLegacyEnabled Then
                        SystemEvent("PerformLicenseReleaseForMRS3:TrackName:" & Me.Name & ":" & Me.GUID)
                        Dim ExecuteRelease As New PerformReleaseLicese(AddressOf trn.DoReleaseLicenseGeoFence)
                        ExecuteRelease.BeginInvoke(Me, Nothing, Nothing)
                    End If
                Else
                    SystemEvent("PerformLicenseReleseForMRS4.1:TrackName:" & Me.Name & ":" & Me.GUID)
                    If Me.TrackAuthorities.Count > 0 Then
                        SystemEvent("PerformLicenseReleseForMRS4:TrackName:" & Me.Name & ":" & Me.GUID)
                        Dim ExecuteRelease As New PerformReleaseLicese(AddressOf DoReleaseLicenseGeoFenceFromTrack)
                        ExecuteRelease.BeginInvoke(Me, Nothing, Nothing)
                    Else
                        SystemEvent("PerformLicenseReleseForMRS6:TrackName:" & Me.Name & ":" & Me.GUID)
                        DoReleaseLicenseGeoFenceFromAuthority(Me)
                    End If
                End If

                If Me.TrackAuthorities.Count > 0 Then
                    SystemEvent("PerformLicenseReleaseForMRS5.1:TrackName:" & Me.Name & ":" & Me.GUID)
                    Dim a As TrackAuthority.TrackAuthority = Me.TrackAuthorities.Item(0)
                    If Not IsNothing(a.myTrain) AndAlso a.myTrain.IsActivePTC AndAlso Not a.myTrain.GeoFenceLegacyEnabled Then
                        SystemEvent("PerformLicenseReleaseForMRS5:TrackName:" & Me.Name & ":" & Me.GUID)
                        a.myTrain.DoLogTrainPositionReportFromGPS()
                        TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainPositionRequest(a.myTrain)
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoReleaseLicenseGeoFenceFromAuthority(ByVal theTrack As Track) 'release license behind the train
            Try
                Dim at As Object
                Dim auth As TrackAuthority.TrackAuthority = Nothing
                For Each at In OtherTrackAuthorities
                    If at.GetType.ToString = gTTComponentName Then
                        Dim t As TrackAuthority.TrackAuthority = CType(at, TrackAuthority.TrackAuthority)
                        If t.ComponentsInSelection.Contains(theTrack) Then
                            auth = t
                            Exit For
                        End If
                    End If
                Next

                Dim comp As Object = Nothing

                If Not IsNothing(auth) Then
                    Dim theList As ArrayList = auth.ComponentsInSelection.Clone
                    theList.Reverse()
                    Dim theDeleteList As New ArrayList
                    Dim StartDeletion As Boolean
                    For Each comp In theList
                        If StartDeletion Then
                            SystemEvent("DoReleaseLicenseGeoFenceFromTrack-StartDeletion:" & Me.Name)

                            If comp.GetType.ToString = gTrackComponentName Then
                                Dim t As Track = CType(comp, Track)
                                If Not t.Occuppied Then
                                    If Not theDeleteList.Contains(t) Then
                                        theDeleteList.Add(t)
                                        SystemEvent("DoReleaseLicenseGeoFenceFromTrack-AddToDeleteList:" & t.Name)
                                    End If
                                End If
                            ElseIf comp.GetType.ToString = gSwitchComponentName Then
                                Dim s As Switch = CType(comp, Switch)
                                If Not s.Occuppied Then
                                    If Not theDeleteList.Contains(s) Then
                                        SystemEvent("DoReleaseLicenseGeoFenceFromTrack-AddToDeleteList1:" & s.Name)
                                        theDeleteList.Add(s)
                                    End If
                                End If
                            End If
                        End If

                        If comp.GUID = Me.GUID Then
                            StartDeletion = True
                            If Not comp.Occuppied Then
                                If Not theDeleteList.Contains(comp) Then
                                    theDeleteList.Add(comp)
                                    SystemEvent("DoReleaseLicenseGeoFenceFromTrack-AddToDeleteList:" & comp.Name)
                                End If
                            End If
                        End If

                    Next

                    If theDeleteList.Count > 0 Then
                        For Each comp In theDeleteList
                            If comp.TrackAuthorities.Count > 0 Then
                                Dim a As TrackAuthority.TrackAuthority
                                Dim AuthList As ArrayList = comp.TrackAuthorities.Clone
                                For Each a In AuthList
                                    If a.AuthGUID = auth.AuthGUID Then
                                        SystemEvent("DoReleaseLicenseGeoFenceFromTrack-RemoveFromTrack:" & comp.Name)
                                        auth.ComponentsInSelection.Remove(comp)
                                        comp.TrackAuthorities.Remove(a)
                                        comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                        If comp.TrackAuthorities.Count = 0 Then
                                            comp.TrackAuthority = False
                                            comp.TrafficDirection = ""
                                        End If
                                        comp.UpdateStatus()
                                        If comp.GetType.ToString = gTrackComponentName AndAlso comp.IsRemoteTrack Then
                                            If Not comp.Occuppied Then
                                                SystemEvent("SendRemoveTrackAuthority - RemoveFromTrack")
                                                comp.myRemoteTrack.SendRemoveTrackAuthority(a.AuthorityUID)
                                            End If

                                            Dim t As Track = CType(comp, Track)
                                            Dim RemoteTrackLikeMe As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemLikeMe(t)
                                            If Not IsNothing(RemoteTrackLikeMe) Then
                                                auth.ComponentsInSelection.Remove(RemoteTrackLikeMe)
                                                RemoteTrackLikeMe.TrackAuthorities.Remove(a)
                                                RemoteTrackLikeMe.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                                If RemoteTrackLikeMe.TrackAuthorities.Count = 0 Then
                                                    RemoteTrackLikeMe.TrackAuthority = False
                                                    RemoteTrackLikeMe.TrafficDirection = ""
                                                End If
                                                RemoteTrackLikeMe.UpdateStatus()
                                            End If

                                        End If
                                    End If
                                Next
                            Else
                                auth.ComponentsInSelection.Remove(comp)
                                SystemEvent("DoReleaseLicenseGeoFenceFromTrack-Clearrack:" & comp.Name)
                                comp.TrackAuthority = False
                                comp.TrafficDirection = ""
                                comp.UpdateStatus()
                                If comp.GetType.ToString = gTrackComponentName AndAlso comp.IsLinkToRemoteTrack Then
                                    'comp.myRemoteTrack.SendRemoveTrackAuthority(auth.AuthorityUID)
                                    Dim t As Track = CType(comp, Track)
                                    ' t.IsLinkToRemoteTrack()
                                    Dim RemoteTrackLikeMe As Track = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemLikeMe(t)
                                    If Not IsNothing(RemoteTrackLikeMe) Then
                                        auth.ComponentsInSelection.Remove(RemoteTrackLikeMe)
                                        RemoteTrackLikeMe.TrackAuthorities.Remove(auth)
                                        RemoteTrackLikeMe.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                        If RemoteTrackLikeMe.TrackAuthorities.Count = 0 Then
                                            RemoteTrackLikeMe.TrackAuthority = False
                                            RemoteTrackLikeMe.TrafficDirection = ""
                                        End If
                                        RemoteTrackLikeMe.UpdateStatus()
                                    End If
                                End If

                            End If
                        Next
                        auth.UpdateDatabaseWithCompList("DoReleaseLicenseGeoFenceFromTrack1")
                    End If
                End If

                If Not IsNothing(auth) Then
                    If auth.ComponentsInSelection.Count = 0 Then
                        SystemEvent("DoReleaseLicenseGeoFenceFromTrack:RemoveTrackAuthority:" & Me.Name)
                        Me.RemoveTrackAuthority(auth.AuthorityUID, False, False, Nothing)
                    Else
                        auth.UpdateDatabaseWithCompList("DoReleaseLicenseGeoFenceFromTrack2")
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub DoReleaseLicenseNotUsed() 'Check if exists any license not used in system

            Try
                Dim Authorities As String = String.Empty
                Dim Count As Integer = 0
                Dim trn As TrainID = Nothing
                Dim trnFromDB As TrainID = Nothing
                Dim at As Object
                Dim NewList As ArrayList = OtherTrackAuthorities.Clone()

                For Each at In NewList
                    If at.GetType.ToString = gTTComponentName Then
                        Dim AuthAux As TrackAuthority.TrackAuthority = CType(at, TrackAuthority.TrackAuthority)
                        If IsNothing(AuthAux) Then Continue For
                        trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(AuthAux.TrainSymbol)
                        If IsNothing(trn) Then
                            Count = Count + 1
                            trnFromDB = TMDS.SystemUtilities.FetchData.GetSystemTrainFromDatabase(AuthAux.TrainSymbol)
                            'If train doesnt exist in db, delete the auth from db
                            If trnFromDB Is Nothing Then
                                AuthAux.RemoveActiveAuthorityFromDB(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority)
                                AuthAux.RemoveActiveAuthorityFromComponents(TMDS.GlobalDeclarations.gDatabaseConnectionAuthority)
                                OtherTrackAuthorities.Remove(AuthAux)
                                Dim SummItem As New SummaryItem("AUTHORITY", "REMOVE", AuthAux)
                                SyncLock gSummaryAuthQueue.SyncRoot
                                    gSummaryAuthQueue.Enqueue(SummItem)
                                End SyncLock
                                SystemEvent("DoReleaseLicenseNotUsed:RemoveLicensefromDesk:AuthNumber:" & AuthAux.AuthorityUID.ToString & "-TrainID:" & AuthAux.TrainSymbol)
                            End If
                        End If
                    End If
                Next

                SystemEvent("DoReleaseLicenseNotUsed:TotalofAuth:" & OtherTrackAuthorities.Count.ToString & "-NotUsed:" & Count.ToString)
                trn = Nothing
                trnFromDB = Nothing
                NewList.Clear()
                NewList = Nothing

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Sub

        Private Sub DoReleaseLicenseGeoFenceFromTrack(ByVal theTrack As Track) 'release license behind the train
            Try
                SystemEvent("DoReleaseLicenseGeoFenceFromTrack:" & Me.Name)

                DoReleaseLicenseNotUsed()

                Dim at As Object
                Dim auth As TrackAuthority.TrackAuthority = Nothing
                For Each at In OtherTrackAuthorities
                    If at.GetType.ToString = gTTComponentName Then
                        Dim t As TrackAuthority.TrackAuthority = CType(at, TrackAuthority.TrackAuthority)
                        If t.ComponentsInSelection.Contains(theTrack) Then
                            auth = t
                            Exit For
                        End If
                    End If
                Next

                If IsNothing(auth) Then
                    SystemEvent("DoReleaseLicenseGeoFenceFromTrack:No License:" & Me.Name)
                    Exit Sub
                End If

                SystemEvent("DoReleaseLicenseGeoFenceFromTrack:Track1:" & Me.Name & "-AuthNumber:" & auth.AuthorityNumber.ToString)

                Dim comp As Object = Nothing

                If Not IsNothing(auth) Then
                    Dim theList As ArrayList = auth.ComponentsInSelection.Clone
                    theList.Reverse()
                    Dim theDeleteList As New ArrayList
                    Dim StartDeletion As Boolean
                    For Each comp In theList
                        If StartDeletion Then
                            SystemEvent("DoReleaseLicenseGeoFenceFromTrack:StartDeletion:" & Me.Name)

                            If comp.GetType.ToString = gTrackComponentName Then
                                Dim t As Track = CType(comp, Track)
                                If Not t.Occuppied Then
                                    If Not theDeleteList.Contains(t) Then
                                        theDeleteList.Add(t)
                                        SystemEvent("DoReleaseLicenseGeoFenceFromTrack:AddToDeleteList:" & t.Name)
                                    End If
                                End If
                            ElseIf comp.GetType.ToString = gSwitchComponentName Then
                                Dim s As Switch = CType(comp, Switch)
                                If Not s.Occuppied Then
                                    If Not theDeleteList.Contains(s) Then
                                        SystemEvent("DoReleaseLicenseGeoFenceFromTrack:AddToDeleteList1:" & s.Name)
                                        theDeleteList.Add(s)
                                    End If
                                End If
                            End If
                        End If

                        If comp.GUID = Me.GUID Then
                            StartDeletion = True
                        End If
                    Next

                    SystemEvent("DoReleaseLicenseGeoFenceFromTrack:Track2:" & Me.Name & "-AuthNumber:" & auth.AuthorityNumber.ToString & "-DeleteListCount:" & theDeleteList.Count.ToString)

                    If theDeleteList.Count > 0 Then
                        For Each comp In theDeleteList
                            If comp.TrackAuthorities.Count > 0 Then
                                Dim a As TrackAuthority.TrackAuthority
                                Dim AuthList As ArrayList = comp.TrackAuthorities.Clone
                                For Each a In AuthList
                                    If a.AuthGUID = auth.AuthGUID Then
                                        SystemEvent("DoReleaseLicenseGeoFenceFromTrack:RemoveFromTrack:" & comp.Name)
                                        auth.ComponentsInSelection.Remove(comp)
                                        comp.TrackAuthorities.Remove(a)
                                        comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                        If comp.TrackAuthorities.Count = 0 Then
                                            comp.TrackAuthority = False
                                            comp.TrafficDirection = ""
                                        End If
                                        comp.UpdateStatus()
                                        If comp.GetType.ToString = gTrackComponentName AndAlso comp.IsRemoteTrack Then
                                            SystemEvent("DoReleaseLicenseGeoFenceFromTrack:SendRemoveTrackAuthority-RemoveFromTrack")
                                            If Not comp.Occuppied Then
                                                comp.myRemoteTrack.SendRemoveTrackAuthority(a.AuthorityUID)
                                            End If
                                        End If
                                    End If
                                Next
                            Else
                                auth.ComponentsInSelection.Remove(comp)
                                SystemEvent("DoReleaseLicenseGeoFenceFromTrack:Cleartrack:" & comp.Name)
                                comp.TrackAuthority = False
                                comp.TrafficDirection = ""
                                comp.UpdateStatus()
                            End If
                        Next
                        auth.UpdateDatabaseWithCompList("DoReleaseLicenseGeoFenceFromTrack1")
                    End If

                    Dim trk As Track
                    For Each trk In TrackCollection
                        If trk.TrackAuthorities.Count > 0 Then

                            Dim authTT As Object = Nothing 'TrackAuthority.TrackAuthority
                            Dim AuthList As ArrayList = trk.TrackAuthorities.Clone

                            For Each authTT In AuthList
                                If authTT IsNot Nothing AndAlso authTT.GetType.ToString = gTTComponentName AndAlso authTT.AuthGUID = auth.AuthGUID Then
                                    If trk.OStype Then
                                        If Not IsNothing(trk.OsComponentCollection) Then
                                            For Each comp In trk.OsComponentCollection
                                                If comp.TrackAuthorities.Count > 0 Then
                                                    SystemEvent("DoReleaseLicenseGeoFenceFromTrack:RemoveFromTrackGlobal:" & comp.Name)
                                                    auth.ComponentsInSelection.Remove(comp)
                                                    comp.TrackAuthorities.Remove(authTT)
                                                    comp.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                                    If comp.TrackAuthorities.Count = 0 Then
                                                        comp.TrackAuthority = False
                                                        comp.TrafficDirection = ""
                                                    End If
                                                    comp.UpdateStatus()
                                                    If comp.GetType.ToString = gTrackComponentName AndAlso comp.IsRemoteTrack Then
                                                        If Not comp.Occuppied Then
                                                            SystemEvent("DoReleaseLicenseGeoFenceFromTrack:SendRemoveTrackAuthority-RemoveFromTrackGlobal")
                                                            comp.myRemoteTrack.SendRemoveTrackAuthority(authTT.AuthorityUID)
                                                        End If
                                                    End If
                                                End If
                                            Next
                                        End If
                                    End If

                                    SystemEvent("DoReleaseLicenseGeoFenceFromTrack:Remove:Track:" & trk.Name & "-AuthNumber:" & authTT.AuthorityNumber.ToString & "-ViaRemoteLink:" & authTT.HasTrainLeftDeskViaRemoteLink.ToString)

                                    authTT.ComponentsInSelection.Remove(comp)
                                    trk.TrackAuthorities.Remove(authTT)

                                    If authTT.HasTrainLeftDeskViaRemoteLink Then
                                        SystemEvent("DoReleaseLicenseGeoFenceFromTrack-RemoveFromTrackGlobalperRemoteLink:" & trk.GUID & ":" & trk.Name)
                                        OtherTrackAuthorities.Remove(authTT)
                                    End If

                                    trk.SelectionMode = GraphicComponent.GenericComponent.ModeSelection.Regular
                                    If trk.TrackAuthorities.Count = 0 Then
                                        trk.TrackAuthority = False
                                        trk.TrafficDirection = ""
                                    End If
                                    trk.UpdateStatus()
                                    If trk.IsRemoteTrack Then
                                        If Not trk.Occuppied Then
                                            SystemEvent("DoReleaseLicenseGeoFenceFromTrack:TrackGUID" & trk.GUID)
                                            'trk.myRemoteTrack.SendRemoveTrackAuthority(a.AuthorityUID)
                                        End If

                                    End If
                                End If
                            Next
                        End If
                        'End If
                    Next
                End If

                If auth.ComponentsInSelection.Count = 0 Then
                    SystemEvent("DoReleaseLicenseGeoFenceFromTrack:RemoveTrackAuthority:" & Me.Name)
                    Me.RemoveTrackAuthority(auth.AuthorityUID, False, False, Nothing)
                Else
                    auth.UpdateDatabaseWithCompList("DoReleaseLicenseGeoFenceFromTrack2")
                End If


            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function PerformSpecialLicenseReleaseForMRS() As Boolean
            Try
                SystemEvent("PerformSpecialLicenseReleaseForMRS:" & Me.Name)
                'Exit Sub
                If LastTrainSymbolOnMe = "" Then Exit Function
                Dim data() As String = LastTrainSymbolOnMe.Split(" ")
                If data IsNot Nothing AndAlso data.Length > 0 Then
                Else
                    SystemEvent("PerformSpecialLicenseReleaseForMRS-Step2:" & Me.Name & "-LastTrainSymbolOnMe:" & LastTrainSymbolOnMe)
                    Exit Function
                End If
                Dim symbol() As String = data(0).Split(":")
                Dim trn As TrainID = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(symbol(0))
                If IsNothing(trn) Then
                    If Me.TrackAuthorities.Count > 0 Then
                        Dim auth As TrackAuthority.OtherSpecialAuthorityType = Me.OtherSplAuthorities.Item(0)
                        If IsNothing(auth) Then Exit Function
                        trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(auth.TrainSymbol)
                    End If
                End If

                If Not IsNothing(trn) Then
                    If trn.GeoFenceLegacyEnabled Then
                        Dim ExecuteRelease As New PerformReleaseLicese(AddressOf trn.DoReleasePSSLicenseBehindTrain)
                        ExecuteRelease.BeginInvoke(Me, Nothing, Nothing)
                    ElseIf trn.IsActivePTC Then
                        trn.DoReleaseSpecialLicenseBehindTrain(False)
                    End If
                End If
                'End If
                Return True
            Catch ex As Exception
                Return False
                SystemException(ex.ToString)
            End Try
        End Function

        Private Sub PerformLicenseUpdateForMRS(ByVal theSignal As Signal)
            Try
                Dim trn As TrainID
                TrackEventLog("PerformLicenseUpdateForMRS:Start")

                If Not Me.myControlPoint.Initialized And Me.OStype Then
                    For Each trn In TrainCollection
                        If trn.IsActivePTC Or trn.GeoFenceLegacyEnabled Then
                            Dim t As TacticalRoute
                            For Each t In trn.myTacticalRoutes
                                If t.mySignalRoute.EntrySignal.GUID = theSignal.GUID Then
                                    SystemEvent("PerformLicenseUpdateForMRS:EntrySignal=" & t.mySignalRoute.EntrySignal.Name & ":FULLFILLED:1")
                                    t.myStatus = "FULLFILLED"
                                    t.UpdateRouteStatus("FULLFILLED")
                                    theSignal.CurrentTacticalRoute = Nothing
                                    PerformSignalFullfillment(t, trn)
                                    Exit Sub
                                End If
                            Next
                        End If
                    Next
                End If

                If LastTrainSymbolOnMe = "" Then
                    If Not IsNothing(theSignal.CurrentTacticalRoute) Then
                        TrackEventLog("PerformLicenseUpdateForMRS1:EntrySignal=" & theSignal.CurrentTacticalRoute.mySignalRoute.EntrySignal.GUID & ":" & theSignal.CurrentTacticalRoute.mySignalRoute.EntrySignal.Name & ":FULLFILLED:2")
                        theSignal.CurrentTacticalRoute.myStatus = "FULLFILLED"
                        theSignal.CurrentTacticalRoute.UpdateRouteStatus("FULLFILLED")
                        theSignal.CurrentTacticalRoute = Nothing
                    End If
                    Exit Sub
                End If
                If Trim(LastTrainSymbolOnMe) <> "" Then
                    Dim data() As String = LastTrainSymbolOnMe.Split(" ")
                    Dim symbol() As String = data(0).Split(":")
                    trn = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(symbol(0))
                    If Not IsNothing(trn) Then
                        Dim tr As TacticalRoute
                        For Each tr In trn.myTacticalRoutes
                            If tr.mySignalRoute.EntrySignal.GUID = theSignal.GUID Then
                                TrackEventLog("PerformLicenseUpdateForMRS:EntrySignal=" & tr.mySignalRoute.EntrySignal.GUID & ":" & tr.mySignalRoute.EntrySignal.Name & ":FULLFILLED:3")
                                tr.myStatus = "FULLFILLED"
                                tr.UpdateRouteStatus("FULLFILLED")
                                theSignal.CurrentTacticalRoute = Nothing
                                PerformSignalFullfillment(tr, trn)
                                Exit Sub
                            End If
                        Next
                    End If
                End If

                For Each trn In TrainCollection
                    If trn.IsActivePTC Or trn.GeoFenceLegacyEnabled Then
                        Dim t As TacticalRoute
                        For Each t In trn.myTacticalRoutes
                            If t.mySignalRoute.EntrySignal.GUID = theSignal.GUID Then
                                If t.mySignalRoute.EntryTrack.Occuppied Then
                                    TrackEventLog("PerformLicenseUpdateForMRS:EntrySignal=" & theSignal.CurrentTacticalRoute.mySignalRoute.EntrySignal.GUID & ":" & theSignal.CurrentTacticalRoute.mySignalRoute.EntrySignal.Name & ":FULLFILLED:4")
                                    t.myStatus = "FULLFILLED"
                                    t.UpdateRouteStatus("FULLFILLED")
                                    theSignal.CurrentTacticalRoute = Nothing
                                    PerformSignalFullfillment(t, trn)
                                    Exit Sub
                                End If
                            End If
                        Next
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub PerformSignalFullfillment(ByVal theTactRoute As TacticalRoute, ByVal theTrain As TrainID)
            Try
                If Not IsNothing(theTactRoute) AndAlso Not IsNothing(theTrain) Then
                    Dim t As TacticalRoute
                    For Each t In theTrain.myTacticalRoutes
                        If t.myGUID = theTactRoute.myGUID Then
                            Exit For
                        Else
                            If t.mySignalRoute.EntrySignal.AutomaticSignal Then
                                t.UpdateRouteStatus("FULLFILLED")
                            End If
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function IsCandidateReleaseTrack() As Boolean
            Try
                If OStype Then Return True

                Dim leftsig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.LeftLink)
                Dim rightsig As Signal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(Me.RightLink)

                If Not IsNothing(leftsig) AndAlso leftsig.AutomaticSignal AndAlso Me.TrafficDirection = "LEFT" Then Return True
                If Not IsNothing(rightsig) AndAlso rightsig.AutomaticSignal AndAlso Me.TrafficDirection = "RIGHT" Then Return True
                If Me.TrafficDirection = "" AndAlso Not IsNothing(leftsig) AndAlso Not IsNothing(rightsig) Then Return True

                If Me.TrackAuthorities.Count > 0 Then
                    Dim auth As TrackAuthority.TrackAuthority = Me.TrackAuthorities.Item(0)
                    If Not IsNothing(auth) Then
                        If Not IsNothing(auth.myTrain) Then
                            If auth.myTrain.myTacticalRoutes.Count = 0 Then
                                Dim comp As Object
                                For Each comp In auth.ComponentsInSelection
                                    If comp.GetType.ToString = gTrackComponentName Then
                                        Dim trk As Track = CType(comp, Track)
                                        If trk.Occuppied Then
                                            Return False
                                        End If
                                    End If
                                Next
                                Return True
                            End If
                        End If
                    End If
                End If

                Return False

            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

