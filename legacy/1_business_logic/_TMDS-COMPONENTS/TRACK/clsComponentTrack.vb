        Private Sub UpdateTrackIntegrityZoneStatus()
            Try
                'If TrackZoneStatusRecordExists Then
                If CheckIfTrackIntegrityZoneRecordExists() Then  'Uncomment this Line and Update line if Primarykey Violation is an Issue. -  RAJA
                    Dim Update As String = "UPDATE tblTrackIntegrityStatuses"
                    Dim Status As String = "UNKNOWN"

                    If Me.Occuppied Then
                        Status = "OCCUPPIED"
                    Else
                        Status = "NORMAL"
                    End If

                    Update = Update & " SET Status = '" & Status & "',"
                    Update = Update & " LastUpdate = '" & Me.TrackZoneLastReportTime.ToString & "'"
                    Update = Update & " WHERE TrackIntegrityUID = " & Me.TrackZoneReference.ZoneUID

                    Update = Update & " AND TerrUID = '" & Me.TerritoryID & "'"

                    SystemDatabaseCommandToDynamic("TRACK:UpdateTrackIntegrityZoneStatus", Update)
                    TrackEventLog("TRACK INTEGRITY ZONE EVENT-STATUS UPDATED INTO DATABASE @:" & Format(Me.TrackZoneLastReportTime.ToString, "MM-dd-yy HH:mm:ss") & " FOR TRACK ZONE:" & Me.TrackZoneReference.ZoneName)

                Else
                    Dim Status As String = "UNKNOWN"
                    If Me.Occuppied Then
                        Status = "OCCUPPIED"
                    Else
                        Status = "NORMAL"
                    End If

                    Dim Insert As String = "INSERT INTO tblTrackIntegrityStatuses"
                    Insert = Insert & " (TrackIntegrityUID,Status,LastUpdate,TerrUID,ZoneName)"
                    Insert = Insert & "VALUES (" & Me.TrackZoneReference.ZoneUID & ", '" & Status & "', '" & Me.TrackZoneLastReportTime.ToString & "', " & Me.TerritoryID & ", '" & Me.TrackZoneReference.ZoneName & "')"
                    SystemDatabaseCommandToDynamic("TRACK:UpdateTrackIntegrityZoneStatus", Insert)
                    Me.TrackZoneStatusRecordExists = True
                    TrackEventLog("SPMS EVENT-STATUS INSERTED INTO DATABASE @:" & Format(Me.TrackZoneLastReportTime.ToString, "MM-dd-yy HH:mm:ss") & " FOR TRACK ZONE:" & Me.TrackZoneReference.ZoneName)
                End If
                Dim trk As Track
                For Each trk In Me.TrackZoneReference.TrackList
                    trk.TrackZoneStatusRecordTime = Now
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function CheckIfTrackIntegrityZoneRecordExists() As Boolean
            Dim ds As New DataSet
            Try
                ds = GetResultDS("Select TrackIntegrityUID from tblTrackIntegrityStatuses Where TrackIntegrityUID=" & Me.TrackZoneReference.ZoneUID & " AND TerrUID='" & Me.TerritoryID & "' ", False)
                If IsValidDataset(ds) Then Return True

            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                ds = Nothing
            End Try
            Return False
        End Function

        Public Sub CheckTrackZoneStatus()
            Try
                Dim UpdateRequired As Boolean
                If Not Me.TrackZoneInitialized Then
                    If Me.TrackZoneLastReportTime > Now.AddSeconds(-1 * Me.TrackZoneReportTimeOut) Then
                        'Me.CalculateFailureTime()
                        Exit Sub
                    Else
                        TrackZoneInitialized = True
                        'Me.FailState = True
                        If Not TrackZoneStatusRecordExists Then
                            Me.TrackZoneStatusRecordTime = Now
                            Me.TrackZoneLastReportTime = Now
                            UpdateRequired = True
                        End If
                        Me.UpdateStatus()
                        'Me.CalculateFailureTime()
                    End If
                End If

                If TrackZoneLastReportTime < Now.AddMinutes(-5) Then
                    UpdateRequired = True
                End If

                If UpdateRequired Then
                    Me.UpdateTrackIntegrityZoneStatus()
                End If

                If TrackZoneLastReportTime < Now.AddSeconds(-1 * TrackZoneReportTimeOut) Then

                    'Me.FailState = True
                    Me.UpdateStatus()
                    Me.TrackZoneReference.ShowCommAlarmForTrackZone()
                    Me.TrackZoneCommunicationAlert = True
                End If
                'Me.CalculateFailureTime()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Function CheckPreviousTrackZoneForAuthority(ByVal trkToTest As Track, ByVal auth As SFAuthority) As Boolean
            Try
                Dim ZoneToCheck As TrackZone = Nothing
                If auth.Direction = "RIGHT" Then
                    Dim trk As Track = trkToTest.TrackZoneReference.TrackList.Item(0)
                    Dim NextTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trk.LeftLink)
                    If Not IsNothing(NextTrack) Then
                        If NextTrack.TrackAuthorities.Count = 0 Then
                            Return True
                        Else
                            Dim sfa As SFAuthority
                            For Each sfa In NextTrack.TrackAuthorities
                                If sfa.IssueTo = auth.IssueTo Then
                                    If Not NextTrack.Occuppied Then
                                        Return False
                                    Else
                                        Return True
                                    End If
                                End If
                            Next
                        End If
                    Else
                        Return True
                    End If

                ElseIf auth.Direction = "LEFT" Then
                    Dim trk As Track = trkToTest.TrackZoneReference.TrackList.Item(trkToTest.TrackZoneReference.TrackList.Count - 1)
                    Dim NextTrack As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(trk.RightLink)
                    If Not IsNothing(NextTrack) Then
                        If NextTrack.TrackAuthorities.Count = 0 Then
                            Return True
                        Else
                            Dim sfa As SFAuthority
                            For Each sfa In NextTrack.TrackAuthorities
                                If sfa.IssueTo = auth.IssueTo Then
                                    If Not NextTrack.Occuppied Then
                                        Return False
                                    Else
                                        Return True
                                    End If
                                End If
                            Next
                        End If
                    Else
                        Return True
                    End If

                End If

                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Sub CheckForExistingAuthorities(Optional ByVal FoulingTrack As Boolean = False)
            Try
                Dim EventMsg As String = "CHECK FOR EXISTING AUTHORITY : TRACK : " & Me.GUID
                Me.TrackEventLog(EventMsg)

                If Not Me.TrackZoneInitialized Then Exit Sub
                If Me.TrackAuthorities.Count = 0 Then
                    Dim strevt As String = "TRACK AUTHORITIES COUNT ZERO FOR TRACK : " & Me.GUID
                    AddEventToLog(EventEnum.SystemEvent, strevt, SystemEventQueue)
                    Exit Sub
                End If

                Dim auth As Object = Nothing
                Dim TrainAuthorityFound As Boolean
                For Each auth In Me.TrackAuthorities
                    Dim DoAlarm As Boolean = True
                    If auth.AuthType1 = "ItemFourToMOW" And Not TrainAuthorityFound Then
                        DoAlarm = False
                    ElseIf auth.AuthType1 = "ItemFourToMOW" And auth.Box6Train.Count > 0 Then
                        Dim sfa As TMDS.TrackAuthority.SFAuthority
                        Dim tempTrainCollection As New ArrayList
                        Dim trnString As String = ""
                        Dim TrnNotFound As Boolean = False
                        Try
                            For Each sfa In Me.TrackAuthorities
                                If sfa.AuthType1 = "ItemTwoToTrain" Then
                                    tempTrainCollection.Add(sfa.IssueTo.Trim.ToUpper)
                                End If
                            Next
                            For Each trnString In auth.Box6Train
                                If trnString.Trim <> String.Empty Then
                                    If Not tempTrainCollection.Contains(trnString.Trim.ToUpper) Then
                                        TrnNotFound = True
                                        Exit For
                                    End If
                                End If
                            Next
                            If TrnNotFound Then
                                DoAlarm = True
                            Else
                                DoAlarm = False
                            End If
                        Catch ex As Exception
                            GetErrorDetails(ex)
                            DoAlarm = True
                        Finally
                            tempTrainCollection = Nothing
                            sfa = Nothing
                        End Try
                    Else
                        DoAlarm = True
                        TrainAuthorityFound = True
                        If auth.CheckBoxItemsStatus(7) And auth.BoxEightRestrictionComponents.Contains(Me) Then
                            DoAlarm = False
                        End If
                        Dim ov As ZoneOverride
                        For Each ov In Me.TrackZoneReference.ZoneOverrideList
                            If ov.AuthUID = auth.AuthorityUID Then
                                If ov.TrackGUIDList.Contains(Me.GUID) Then
                                    DoAlarm = False
                                End If
                            End If
                        Next
                        If DoAlarm Then
                            Dim clsTIWSRules As New clsTIWSRulesCheck
                            If auth.AuthType1 = "ItemTwoToTrain" Or auth.AuthType1 = "ItemFourToTrain" Then
                                auth.PopulateAuthZones()
                                If Me.FoulingTrackSPMS Then
                                    If auth.AuthType1 = "ItemTwoToTrain" Then
                                        Dim AuthZonelist As New ArrayList
                                        AuthZonelist = GetZoneListWithinAuthority(auth)

                                        Dim TrackZoneBehindMyTrain As New ArrayList
                                        'TrackZoneBehindMyTrain = GetZonesBehindTrainInAuthority(auth)
                                        TrackZoneBehindMyTrain = clsTIWSRules.GetZonesBehindTrainInAuthority(auth) ' GetZonesBehindTrainInAuthority_New2(auth)

                                        Dim FoulTrackParentZone As TrackZone = Nothing
                                        Dim ConnectingTrack As Track = Nothing
                                        Dim ConnectingSWSPMS As Switch = Nothing
                                        FoulTrackParentZone = GetFoulingTrkParentZone(Me, ConnectingTrack, ConnectingSWSPMS)
                                        If Not IsNothing(FoulTrackParentZone) AndAlso Not IsNothing(TrackZoneBehindMyTrain) Then
                                            'If TrackZoneBehindMyTrain.Contains(FoulTrackParentZone.ZoneName.ToUpper) Then
                                            '    DoAlarm = False
                                            'End If
                                            If TrackZoneBehindMyTrain.Contains(FoulTrackParentZone) Then
                                                DoAlarm = False
                                            End If
                                        End If

                                        If DoAlarm AndAlso Not IsNothing(FoulTrackParentZone) Then
                                            If FoulTrackParentZone.ZoneName.ToUpper = AuthZonelist(0).ZoneName.toupper Then
                                                If Not (ConnectingSWSPMS.SetOutOfCorespondenceReverse OrElse ConnectingSWSPMS.SetOutOfCorespondenceNormal) Then
                                                    If ConnectingSWSPMS.ControlledReverse Then
                                                        DoAlarm = False
                                                    End If
                                                End If
                                            End If
                                            If FoulTrackParentZone.ZoneName.ToUpper = AuthZonelist(AuthZonelist.Count - 1).ZoneName.toupper Then
                                                If FoulTrackParentZone.IsZownOccuppied AndAlso FoulTrackParentZone.IsZownIdentified(auth.AuthorityUID) Then
                                                    If Not (ConnectingSWSPMS.SetOutOfCorespondenceReverse OrElse ConnectingSWSPMS.SetOutOfCorespondenceNormal) Then
                                                        If ConnectingSWSPMS.ControlledReverse Then
                                                            DoAlarm = False
                                                        End If
                                                    End If
                                                End If
                                            End If
                                        End If

                                    End If
                                Else
                                    Dim AuthZonelist As New ArrayList
                                    AuthZonelist = GetZoneListWithinAuthority(auth)
                                    If CheckIfAdjacentZoneIsOccupied(AuthZonelist, Me.TrackZoneReference.ZoneName, auth.AuthorityUID, auth) Then
                                        Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                        If auth.AuthType1 = "ItemFourToTrain" Then
                                            auth.LastTrainZone = Me.TrackZoneReference
                                        End If
                                        DoAlarm = False
                                    End If
                                    ''Eventhough the current zone is occuppied and the adjacent zone is not occuppied it might have went down and came up in sequence from beginning limits.
                                    'If DoAlarm AndAlso CheckIfAdjacentZoneIsIdentified(AuthZonelist, Me.TrackZoneReference.ZoneName, auth.AuthorityUID) Then
                                    '    Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                    '    DoAlarm = False
                                    'End If
                                    If DoAlarm AndAlso auth.AuthType1 = "ItemTwoToTrain" Then
                                        'FOR BOX2 IF THE ZONE WENT DOWN IS THE BEGINNING LIMIT IT SHOULD NOT ALERT.
                                        Dim TrackZoneBehindMyTrain As New ArrayList
                                        'TrackZoneBehindMyTrain = GetZonesBehindTrainInAuthority_New(auth) ' GetZonesBehindTrainInAuthority(auth)
                                        TrackZoneBehindMyTrain = clsTIWSRules.GetZoneNamesBehindTrainInAuthority(auth)
                                        If AuthZonelist.Count > 0 Then
                                            If Me.TrackZoneReference.ZoneName.ToUpper = AuthZonelist(0).ZoneName.toupper Then
                                                If PreviousZoneHaveAuthority(Me) Then
                                                    If CheckBehindForAuthContinuity(Me, auth) Then
                                                        Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                                        DoAlarm = False
                                                    End If
                                                Else
                                                    Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                                    DoAlarm = False
                                                    If auth.LastTrainZone Is Nothing Then
                                                        auth.LastTrainZone = Me.TrackZoneReference
                                                    ElseIf auth.LastTrainZone Is Me.TrackZoneReference Then
                                                    Else
                                                        If AuthZonelist IsNot Nothing AndAlso AuthZonelist.Count > 0 Then
                                                            For Each znD As ZoneDetail In AuthZonelist
                                                                If znD.ZoneDetailsTrackZone.ZoneName.ToUpper.Trim = auth.LastTrainZone.ZoneName.ToUpper.Trim Then
                                                                    If Not znD.ZoneDown Then auth.LastTrainZone = Me.TrackZoneReference
                                                                    Exit For
                                                                End If
                                                            Next
                                                        End If
                                                    End If

                                                End If
                                            End If
                                            If Not IsNothing(TrackZoneBehindMyTrain) AndAlso TrackZoneBehindMyTrain.Contains(Me.TrackZoneReference.ZoneName.ToUpper) Then
                                                DoAlarm = False ' BNSF-425
                                            End If
                                            If Not IsNothing(TrackZoneBehindMyTrain) AndAlso TrackZoneBehindMyTrain.Contains(Me.TrackZoneReference.ZoneName.ToUpper) Then
                                                If PreviousZoneHaveAuthority(Me) Then
                                                    If CheckBehindForAuthContinuity(Me, auth) Then
                                                        Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                                        DoAlarm = False
                                                    End If
                                                Else
                                                    Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                                    DoAlarm = False
                                                End If
                                            End If
                                        End If
                                    End If
                                    If DoAlarm AndAlso auth.AuthType1 = "ItemFourToTrain" Then
                                        Dim TmpAuthorityOccupiedZOne As New ArrayList
                                        TmpAuthorityOccupiedZOne = clsTIWSRules.GetZonesOccupiedInAuthority(auth, Me)
                                        If TmpAuthorityOccupiedZOne Is Nothing Then
                                        ElseIf TmpAuthorityOccupiedZOne.Count = 0 Then
                                            If clsTIWSRules.PreviousZoneHaveAuthorityBox4(Me, auth) Then
                                                If auth IsNot Nothing AndAlso auth.LastTrainZone Is Nothing Then
                                                    auth.LastTrainZone = Me.TrackZoneReference
                                                    If auth.MyWorkTrainOccupiedTrackZoneList Is Nothing Then
                                                        auth.MyWorkTrainOccupiedTrackZoneList = New ArrayList
                                                    End If
                                                    If Not auth.MyWorkTrainOccupiedTrackZoneList.Contains(Me.TrackZoneReference) Then auth.MyWorkTrainOccupiedTrackZoneList.Add(Me.TrackZoneReference)
                                                End If
                                                Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                                DoAlarm = False
                                            End If
                                        ElseIf TmpAuthorityOccupiedZOne.Count > 1 Then
                                            If Not clsTIWSRules.IsOccupancyOutofSequenceBox4(auth, Me) Then
                                                DoAlarm = False
                                            Else
                                                If clsTIWSRules.PreviousZoneHaveAuthorityBox4(Me, auth) Then
                                                    If auth IsNot Nothing AndAlso auth.LastTrainZone Is Nothing Then
                                                        auth.LastTrainZone = Me.TrackZoneReference
                                                        If auth.MyWorkTrainOccupiedTrackZoneList Is Nothing Then
                                                            auth.MyWorkTrainOccupiedTrackZoneList = New ArrayList
                                                        End If
                                                        If Not auth.MyWorkTrainOccupiedTrackZoneList.Contains(Me.TrackZoneReference) Then auth.MyWorkTrainOccupiedTrackZoneList.Add(Me.TrackZoneReference)
                                                    End If
                                                    Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                                    DoAlarm = False
                                                End If


                                                'If PreviousZoneHaveAuthority(Me) Then
                                                '    If CheckBehindForAuthContinuity(Me, auth) Then
                                                '        If auth IsNot Nothing AndAlso auth.LastTrainZone Is Nothing Then
                                                '            auth.LastTrainZone = Me.TrackZoneReference
                                                '            If auth.MyWorkTrainOccupiedTrackZoneList Is Nothing Then
                                                '                auth.MyWorkTrainOccupiedTrackZoneList = New ArrayList
                                                '            End If
                                                '            If Not auth.MyWorkTrainOccupiedTrackZoneList.Contains(Me.TrackZoneReference) Then auth.MyWorkTrainOccupiedTrackZoneList.Add(Me.TrackZoneReference)
                                                '        End If
                                                '        Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                                '        DoAlarm = False
                                                '    End If
                                                'End If
                                            End If
                                        Else
                                            If clsTIWSRules.PreviousZoneHaveAuthorityBox4(Me, auth) Then
                                                If auth IsNot Nothing AndAlso auth.LastTrainZone Is Nothing Then
                                                    auth.LastTrainZone = Me.TrackZoneReference
                                                    If auth.MyWorkTrainOccupiedTrackZoneList Is Nothing Then
                                                        auth.MyWorkTrainOccupiedTrackZoneList = New ArrayList
                                                    End If
                                                    If Not auth.MyWorkTrainOccupiedTrackZoneList.Contains(Me.TrackZoneReference) Then auth.MyWorkTrainOccupiedTrackZoneList.Add(Me.TrackZoneReference)
                                                End If
                                                Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                                DoAlarm = False
                                            End If
                                            'If PreviousZoneHaveAuthority(Me) Then
                                            '    If CheckBehindForAuthContinuity(Me, auth) Then
                                            '        Me.TrackZoneReference.AddAuthUID(auth.AuthorityUID)
                                            '        DoAlarm = False
                                            '    End If
                                            'End If
                                        End If

                                    End If
                                    If Not DoAlarm Then
                                        Dim TrackZoneBehindMyTrain As New ArrayList
                                        TrackZoneBehindMyTrain = clsTIWSRules.GetZoneNamesBehindTrainInAuthority(auth)
                                        If Not IsNothing(TrackZoneBehindMyTrain) AndAlso TrackZoneBehindMyTrain.Contains(Me.TrackZoneReference.ZoneName.ToUpper) Then
                                        Else
                                            auth.LastTrainZone = Me.TrackZoneReference
                                            If auth.MyWorkTrainOccupiedTrackZoneList Is Nothing Then
                                                auth.MyWorkTrainOccupiedTrackZoneList = New ArrayList
                                            End If
                                            If Not auth.MyWorkTrainOccupiedTrackZoneList.Contains(Me.TrackZoneReference) Then auth.MyWorkTrainOccupiedTrackZoneList.Add(Me.TrackZoneReference)
                                        End If

                                    End If
                                End If
                            End If
                        End If
                    End If
                    If DoAlarm Then
                        If Not FoulingTrack Then
                            Me.ShowAlarmForTrackZone(Me.TrackZoneReference, auth)
                        Else
                            Me.ShowAlarmForFoulingTrack(Me, auth)
                        End If
                    End If
                Next

                If gCreateTrackWarrant Then
                    If Not IsNothing(TMDS.SystemForms.MySystemForms.frmSingleFormAuthority) Then
                        TMDS.SystemForms.MySystemForms.frmSingleFormAuthority.UpdateTrackZoneStatus(Me)
                    End If
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub CheckForAbuttingZonesOccupancy()
            Dim LeftZoneTrack As Track = Nothing
            Dim RightZoneTrack As Track = Nothing
            Dim MyZoneSFAList As New ArrayList
            Dim MyLeftZoneSFAList As New ArrayList
            Dim MyRightZoneSFAList As New ArrayList
            Dim SFA As Object = Nothing
            Try
                If Me.TrackAuthorities IsNot Nothing AndAlso Me.TrackAuthorities.Count > 0 Then
                    For Each SFA In Me.TrackAuthorities
                        If SFA.GetType.ToString = gSFAComponentName AndAlso SFA.IssuedToTrain Then
                            If Not MyZoneSFAList.Contains(SFA) Then MyZoneSFAList.Add(SFA)
                        End If
                    Next
                    If MyZoneSFAList.Count > 0 Then
                        GetAdjacentZones(Me, "LEFT", LeftZoneTrack)
                        GetAdjacentZones(Me, "RIGHT", RightZoneTrack)
                        If LeftZoneTrack IsNot Nothing Then
                            If LeftZoneTrack.TrackAuthorities IsNot Nothing AndAlso LeftZoneTrack.TrackAuthorities.Count > 0 Then
                                For Each SFA In LeftZoneTrack.TrackAuthorities
                                    If SFA.GetType.ToString = gSFAComponentName AndAlso SFA.IssuedToTrain Then
                                        If MyZoneSFAList.Contains(SFA) Then
                                            If Not MyLeftZoneSFAList.Contains(SFA) Then MyLeftZoneSFAList.Add(SFA)
                                        End If
                                    End If
                                Next
                            End If
                        End If
                        If RightZoneTrack IsNot Nothing Then
                            If RightZoneTrack.TrackAuthorities IsNot Nothing AndAlso RightZoneTrack.TrackAuthorities.Count > 0 Then
                                For Each SFA In RightZoneTrack.TrackAuthorities
                                    If SFA.GetType.ToString = gSFAComponentName AndAlso SFA.IssuedToTrain Then
                                        If MyZoneSFAList.Contains(SFA) Then
                                            If Not MyRightZoneSFAList.Contains(SFA) Then MyRightZoneSFAList.Add(SFA)
                                        End If
                                    End If
                                Next
                            End If
                        End If
                        If MyRightZoneSFAList.Count > 0 AndAlso MyLeftZoneSFAList.Count > 0 Then
                            If LeftZoneTrack.Occuppied AndAlso RightZoneTrack.Occuppied Then
                                For Each SFA In MyZoneSFAList
                                    Dim ZonesBehindTrain As New ArrayList
                                    Dim ZoneTrainIsOn As TrackZone = Nothing
                                    ZonesBehindTrain = GetZonesBehindTrainInAuthority(SFA, ZoneTrainIsOn)
                                    Dim leftzone As TrackZone = LeftZoneTrack.TrackZoneReference
                                    Dim rightzone As TrackZone = RightZoneTrack.TrackZoneReference
                                    If Not IsNothing(leftzone) Then
                                        If Not ZonesBehindTrain.Contains(leftzone.ZoneName.ToUpper) AndAlso ZoneTrainIsOn.ZoneName.ToUpper <> leftzone.ZoneName.ToUpper Then
                                            'So if any zone in middle of the authority picks up then no track zone warning  is required as long as the zone went down in sequence and first zone is identified as train
                                            If Not leftzone.OccupiedTrainAuthUIDList.Contains(SFA.AuthorityUID) Then
                                                leftzone.RemoveAuthUID(SFA.AuthorityUID)
                                                LeftZoneTrack.ShowAlarmForTrackZone(leftzone, SFA)
                                            End If
                                        End If
                                    End If
                                    If Not IsNothing(rightzone) Then
                                        If Not ZonesBehindTrain.Contains(rightzone.ZoneName.ToUpper) AndAlso ZoneTrainIsOn.ZoneName.ToUpper <> rightzone.ZoneName.ToUpper Then
                                            'So if any zone in middle of the authority picks up then no track zone warning  is required as long as the zone went down in sequence and first zone is identified as train
                                            If Not rightzone.OccupiedTrainAuthUIDList.Contains(SFA.AuthorityUID) Then
                                                rightzone.RemoveAuthUID(SFA.AuthorityUID)
                                                RightZoneTrack.ShowAlarmForTrackZone(rightzone, SFA)
                                            End If
                                        End If
                                    End If
                                Next
                            End If
                        End If
                    End If
                End If
            Catch ex As Exception
                GetErrorDetails(ex)
            Finally
                LeftZoneTrack = Nothing
                RightZoneTrack = Nothing
                MyRightZoneSFAList = Nothing
                MyZoneSFAList = Nothing
                MyLeftZoneSFAList = Nothing
                SFA = Nothing
            End Try
        End Sub

