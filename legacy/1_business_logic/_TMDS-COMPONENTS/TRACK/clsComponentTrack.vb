#Region "TRAIN ID"

#Region "LOG OS"

        Delegate Sub DoLogOSMessage(ByVal OverRideTimeStamp As String, ByVal ForceControlPointNamse As Boolean, ByVal trn As TrainID)

        Public Sub LogTheOSEvent(ByVal OverRideTimeStamp As String, ByVal ForceControlPointName As Boolean, ByVal trn As TrainID)
            Dim OsMessage As String
            Dim OsPoint As String
            Dim Sw As Switch = Nothing
            Try
                If Me.TurnOutType Then Exit Sub
                If optEnableShadowMode AndAlso optEnableTerritoryDeskAssignmentMode Then
                    If Not Me.IsValidTrackForOperation Then Exit Sub
                End If
                'If gDebug Then SystemEvent(" LogOsMessage:::" & System.Environment.StackTrace.ToString)
                If TrainIDs.Count > 0 Then
                    If IsNothing(trn) Then
                        trn = TrainIDs.Item(0)
                    End If
                Else
                    If IsNothing(trn) Then Exit Sub
                End If

                If Me.AuthorityType <> "CTC" And Not ForceControlPointName And Mid(Me.AuthorityType, 1, 3) = "TWC" Then
                    If optEnableCPTrainsheet Then
                        If TrafficDirection <> "LEFT" Then
                            OsPoint = RightLimitName
                        Else
                            OsPoint = LeftLimitName
                        End If
                    Else
                        If TrafficDirection = "LEFT" Then
                            OsPoint = RightLimitName
                        Else
                            OsPoint = LeftLimitName
                        End If
                    End If
                Else
                    OsPoint = Me.FindControlPointName(Me)
                End If
                If OptUseSwitchNameAsOSPoint AndAlso Not Me.AuthorityType.ToUpper.Trim.Contains("CTC") AndAlso Me.OsComponentCollection IsNot Nothing AndAlso Me.OsComponentCollection.Count > 0 Then
                    Sw = TMDS.SystemUtilities.FetchData.FindSwitchFromOSList(Me)
                    If Sw IsNot Nothing Then
                        OsPoint = Sw.Name
                    End If
                ElseIf optUSeSignalNameInOsReport Then

                    Dim sig As Signal = FindSignalAssociatedWithOSEvent(True)
                    If sig IsNot Nothing Then
                        OsPoint = sig.Name & " @ " & sig.myControlPoint.Name
                    Else
                        Exit Sub
                    End If
                End If

                Dim OSTime As Date
                If IsNothing(OverRideTimeStamp) Then
                    Select Case Me.TimeZone
                        Case "EASTERN"
                            OSTime = Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor))
                            'OSTime = Now.AddHours(1)
                        Case "MOUNTAIN"
                            OSTime = Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor))
                            'OSTime = Now.AddHours(-1)
                        Case "PACIFIC"
                            OSTime = Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor))
                            'OSTime = Now.AddHours(-2)
                        Case Else
                            OSTime = Now
                    End Select
                Else
                    OSTime = Format(Now.ToLongDateString & " " & OverRideTimeStamp)
                End If
                If optEnableTimeZoneSettings AndAlso Me IsNot Nothing AndAlso Me.mySubdivision IsNot Nothing Then
                    Dim NewReportTime As Date = GenerateTime(Me.mySubdivision)
                    OSTime = NewReportTime
                End If
                If OptCheckLastOSForDuplicateOS Then
                    Dim LastOS As String = ""
                    trn.GetLastOSEvent(LastOS)
                    If LastOS = OsPoint Then
                        TrackEventLog("OS IGNORED FOR TRAIN <" & trn.Name & "> LastOS:" & LastOS & " REPORTING OS: " & OsPoint)
                        Exit Sub
                    End If
                End If



                Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(Me.SubdivisionID)
                Dim SubName As String
                If IsNothing(subdvn) Then
                    SubName = "NOT AVAILABLE"
                Else
                    SubName = subdvn.LongName
                End If

                Dim SQLFields As String
                Dim SQLValues As String
                Dim s As String = ","
                Dim q As String = "'"
                If optEnableDirectionLoggingWithOsReports Then
                    SQLFields = " (TrainSheetGUID, OsPoint, OsTime, TrackGUID, SubName, ReportData, RecordGUID, Direction, EventCreator"
                    SQLFields = SQLFields & ")"

                    SQLValues = " VALUES (" & q & trn.ActiveTrainSheetGUID & q & s
                    SQLValues = SQLValues & q & OsPoint & q & s
                    SQLValues = SQLValues & q & Format(OSTime, optSystemOSDateAndTimeString) & q & s
                    SQLValues = SQLValues & q & Me.GUID.ToString & q & s
                    SQLValues = SQLValues & q & SubName & q & s
                    SQLValues = SQLValues & q & trn.GetTrainReportDataString("NONE", 0) & q & s
                    SQLValues = SQLValues & q & System.Guid.NewGuid.ToString.ToUpper & q & s
                    SQLValues = SQLValues & q & trn.Direction & q & s
                    SQLValues = SQLValues & q & gCurrentUser.UserFullName & q
                    SQLValues = SQLValues & ")"

                Else
                    SQLFields = " (TrainSheetGUID, OsPoint, OsTime, TrackGUID, SubName, ReportData, RecordGUID, EventCreator"
                    SQLFields = SQLFields & ")"

                    SQLValues = " VALUES (" & q & trn.ActiveTrainSheetGUID & q & s
                    SQLValues = SQLValues & q & OsPoint & q & s
                    SQLValues = SQLValues & q & Format(OSTime, optSystemOSDateAndTimeString) & q & s
                    SQLValues = SQLValues & q & Me.GUID.ToString & q & s
                    SQLValues = SQLValues & q & SubName & q & s
                    SQLValues = SQLValues & q & trn.GetTrainReportDataString("NONE", 0) & q & s
                    SQLValues = SQLValues & q & System.Guid.NewGuid.ToString.ToUpper & q & s
                    SQLValues = SQLValues & q & gCurrentUser.UserFullName & q
                    SQLValues = SQLValues & ")"

                End If

                Dim InsertCommand As String = "INSERT INTO tblTrainOsEventsActive " & SQLFields & SQLValues
                SystemDatabaseCommandToDynamicTrain("TRACK:LogTheOSEvent", InsertCommand)
                If optEnableBeepOnTrainOS = True Then Beep()
                ' Me.DatabaseCommand(InsertCommand)

                'OsMessage = OsPoint & "|" & Format(OSTime, "MM-dd-yyyy HH:mm") & "|" & SubName
                OsMessage = OsPoint & "|" & Format(OSTime, optSystemOSDateAndTimeString) & "|" & SubName

                If optAllowSecondsInOSReportLogging Then
                    OsMessage = OsPoint & "|" & Format(OSTime, "MM-dd-yyyy HH:mm:ss") & "|" & SubName
                Else
                    OsMessage = OsPoint & "|" & Format(OSTime, optSystemOSDateAndTimeString) & "|" & SubName
                End If


                If optEnableMessagingEDI Then

                    If trn.OSTimes.Count <> 0 Then
                        If Not IsNothing(Me.myControlPoint.mySubdivisionStation) AndAlso Me.myControlPoint.mySubdivisionStation.StandardPointLocationCode <> String.Empty Then
                            Dim SendReport As Boolean
                            If optEnableSpecificOptionsForMetrolink Then
                                Select Case trn.HomeRoadCode
                                    Case "BNSF", "UP", "AMTK"
                                        SendReport = True
                                End Select
                            End If
                            TMDS.NetworkMessages.CadMessages.SendTrainPassingUpdateEDI(trn)
                        End If
                    Else
                        Dim SendReport As Boolean
                        If optEnableSpecificOptionsForMetrolink Then
                            Select Case trn.HomeRoadCode
                                Case "BNSF", "UP", "AMTK"
                                    SendReport = True
                                Case "SCAX"
                                    If trn.IsOperatingOnForiegnRoads Then
                                        SendReport = True
                                    End If
                            End Select
                        End If

                        TMDS.NetworkMessages.CadMessages.SendTrainDepartureUpdateEDI(trn)
                    End If
                End If


                If optEnableTrainMovementReporting AndAlso gOSTrain Then
                    SystemEvent("(MANUAL OS TRAIN):" & Me.GUID.ToString & "; train:" & trn.Name)
                    trn.AddTrainMovementEvent(Me, Me.myControlPoint, "OFF STATION", OSTime)
                End If


                trn.LastOS = Format(OSTime, "HH:mm") & " (" & OsPoint & ")"
                If Not trn.OSTimes.Contains(OsMessage) Then
                    trn.OSTimes.Insert(0, OsMessage)
                Else
                    Exit Sub
                End If

                If trn IsNot Nothing AndAlso trn.OSTimes IsNot Nothing AndAlso trn.OSTimes.Count = 1 AndAlso optEnableARRCSpecificOptions Then
                    TMDS.NetworkMessages.CadMessages.SendTrainCrewEventARRC(trn, gMISTransmitQueue, True, "MODIFY")
                End If


                Dim SummItem As New SummaryItem("TRAIN", "UPDATE-OS", trn)
                SyncLock TMDS.GlobalDeclarations.gSummaryTrainQueue
                    TMDS.GlobalDeclarations.gSummaryTrainQueue.Enqueue(SummItem)
                End SyncLock

                Dim EventData As String = trn.Name & ":" & trn.IdentifingUnit & ":" & trn.LastOS & ":" & Me.SubdivisionID
                ApplyTrainEventOnAllOSTracks(EventData)
                If Me.IsPositionReportingTrack Then
                    Me.LastTrainSymbolOnMe = EventData
                End If

                'Me.LastTrainSymbolOnMe = EventData
                Dim LogThisOSEvent As New DoEventLogTrack(AddressOf Me.LogTheTrackEvent)
                LogThisOSEvent.BeginInvoke(Track.EventTypeTrack.OSOCCUPPIED, EventData, Nothing, Nothing, Nothing)

                Dim PublishThisEvent As New DoPublishTrainEvent(AddressOf trn.PublishTrainEvent)
                PublishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.OS, False, Nothing, Nothing)

                If Me.myTerritory.AllowMovementPlanning Then
                    If Me.myControlPoint.StoredRoutes.Count > 0 Then
                        Dim sr As StoredRoute
                        For Each sr In Me.myControlPoint.StoredRoutes
                            If sr.AutoRouteGenerated And Not sr.DisplayStoredRoute Then
                                If sr.myRouteDependentSymbolName = trn.Name Then
                                    sr.DisplayStoredRoute = True
                                    sr.UpdateDisplayRoute()
                                    If sr.Priority = 0 Then
                                        sr.UpdateSignalDisplays()
                                    End If
                                End If
                            End If
                        Next
                    End If
                End If

                If optEnableAllowControlPointCorrelation Then
                    If Not IsNothing(Me.myControlPoint.CorrelatingControlPoints) Then
                        Dim Points() As String = Me.myControlPoint.CorrelatingControlPointReferences.Split("|")
                        Dim cp As String
                        For Each cp In Points
                            If Trim(cp) <> "" Then
                                LogTheOSEventForCorrelatingControlPoint(Me.myControlPoint.Name, cp, trn)
                            End If
                        Next
                    End If
                End If
                If optEnableTrainScheduleFunctions AndAlso trn IsNot Nothing Then
                    trn.ProcessTrainSchedule()
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                Sw = Nothing
            End Try
        End Sub

        Private Function FindSignalAssociatedWithOSEvent(Optional ValidateSignalAgaintTraffic As Boolean = False) As Signal
            Dim sig As Signal
            Try
                If Me.TrafficDirection = "RIGHT" Then
                    sig = TMDS.SystemUtilities.FetchData.FindSignalFromLeftGUID(Me.LeftLink, String.Empty, ValidateSignalAgaintTraffic, Me.TrafficDirection)
                Else
                    sig = TMDS.SystemUtilities.FetchData.FindSignalFromRightGUID(Me.RightLink, String.Empty, ValidateSignalAgaintTraffic, Me.TrafficDirection)

                End If
                Return sig
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Sub ApplyTrainEventOnAllOSTracks(ByVal LastTrainSymbolOnMe As String)
            Try
                If Not IsNothing(Me.OsComponentCollection) Then
                    Dim comp As Object
                    For Each comp In Me.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If trk.TrainIDPlace Or trk.IsPositionReportingTrack Then
                                trk.LastTrainSymbolOnMe = LastTrainSymbolOnMe
                            End If
                        End If
                    Next
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Sub RemoveTrainEventOnAllOSTracks()
            Try
                If Not IsNothing(Me.OsComponentCollection) Then
                    Dim comp As Object
                    For Each comp In Me.OsComponentCollection
                        If comp.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            Dim trk As Track = CType(comp, Track)
                            If trk.TrainIDPlace Then
                                trk.LastTrainSymbolOnMe = ""
                            End If
                        End If
                    Next
                End If
                If Me.IsPositionReportingTrack Then
                    Me.LastTrainSymbolOnMe = ""
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub LogTheOSEventForCorrelatingControlPoint(ByVal ControlPointName As String, ByVal CorrelatingControlPointUID As String, ByVal trn As TrainID)
            Dim OsMessage As String
            Dim OsPoint As String
            Try
                If gDebug Then SystemEvent(" LogTheOSEventForCorrelatingControlPoint:::" & System.Environment.StackTrace.ToString)
                If TrainIDs.Count > 0 Then
                    If IsNothing(trn) Then
                        trn = TrainIDs.Item(0)
                    End If
                Else
                    If IsNothing(trn) Then Exit Sub
                End If
                OsPoint = ControlPointName

                Dim OSTime As Date
                Select Case Me.TimeZone
                    Case "EASTERN"
                        OSTime = Now.AddHours(CDbl(1 + gThisWorkstationTimeFactor))
                        'OSTime = Now.AddHours(1)
                    Case "MOUNTAIN"
                        OSTime = Now.AddHours(CDbl(-1 + gThisWorkstationTimeFactor))
                        'OSTime = Now.AddHours(-1)
                    Case "PACIFIC"
                        OSTime = Now.AddHours(CDbl(-2 + gThisWorkstationTimeFactor))
                        'OSTime = Now.AddHours(-2)
                    Case Else
                        OSTime = Now
                End Select
                Dim subdvn As Subdivision = TMDS.SystemUtilities.FetchData.FindSubdivisionFromUID(Me.SubdivisionID)
                Dim SubName As String
                If IsNothing(subdvn) Then
                    SubName = "NOT AVAILABLE"
                Else
                    SubName = subdvn.LongName
                End If

                Dim SQLFields As String
                Dim SQLValues As String
                Dim s As String = ","
                Dim q As String = "'"

                SQLFields = " (TrainSheetGUID, OsPoint, OsTime, TrackGUID, SubName, ReportData, RecordGUID"
                SQLFields = SQLFields & ")"

                SQLValues = " VALUES (" & q & trn.ActiveTrainSheetGUID & q & s
                SQLValues = SQLValues & q & OsPoint & q & s
                SQLValues = SQLValues & q & Format(OSTime, "MM-dd-yyyy HH:mm") & q & s
                SQLValues = SQLValues & q & Me.GUID.ToString & q & s
                SQLValues = SQLValues & q & SubName & q & s
                SQLValues = SQLValues & q & trn.GetTrainReportDataString("NONE", 0, CorrelatingControlPointUID) & q & s
                SQLValues = SQLValues & q & System.Guid.NewGuid.ToString.ToUpper & q

                SQLValues = SQLValues & ")"

                Dim InsertCommand As String = "INSERT INTO tblTrainOsEventsActive " & SQLFields & SQLValues
                SystemDatabaseCommandToDynamicTrain("TRACK:LogTheOSEvent", InsertCommand)
                OsMessage = OsPoint & "|" & Format(OSTime, optSystemOSDateAndTimeString) & "|" & SubName
                trn.LastOS = Format(OSTime, "HH:mm") & " (" & OsPoint & ")"
                If Not trn.OSTimes.Contains(OsMessage) Then
                    trn.OSTimes.Insert(0, OsMessage)
                Else
                    Exit Sub
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Sub LogOsMessage(ByVal OverRideTimeStamp As String, ByVal ForceControlPointName As Boolean, ByVal trn As TrainID)
            Dim LogIt As New DoLogOSMessage(AddressOf LogTheOSEvent)
            LogIt.BeginInvoke(OverRideTimeStamp, ForceControlPointName, trn, Nothing, Nothing)
            'If gDebug Then SystemEvent("Delegate LogOsMessage:::" & System.Environment.StackTrace.ToString)
        End Sub

        Sub SendOSMessage()
            Try
                Dim OsMessage As String
                Dim trn As TrainID
                Dim OsPoint As String
                Dim OSSockect As New NetworkMessage()
                OSSockect.InitSocket()
                If OSSockect.Initiated Then
                    If TrainIDs.Count > 0 Then
                        trn = TrainIDs.Item(0)
                        If TrafficDirection = "LEFT" Then
                            OsPoint = RightLimitName
                        Else
                            OsPoint = LeftLimitName
                        End If
                        OsMessage = trn.Name & "|" & trn.IdentifingUnit & "|" & trn.TrackGUID & "|" & OsPoint & "|" & Now & "|" & TrafficDirection & "|"
                        OSSockect.SendData("TRAINOSMESSAGE|" & OsMessage)
                    End If
                End If
                OSSockect = Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
