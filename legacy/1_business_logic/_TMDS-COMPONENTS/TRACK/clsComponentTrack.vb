        Private Delegate Sub DoCleanUpDatabaseRecords(ByVal pTrain As TrainID)

        ''' <summary>
        ''' Perforn clean up databse records
        ''' </summary>
        ''' <param name="pTrain"></param>
        Private Sub PerformCleanUpDatabaseRecords(ByVal pTrain As TrainID)
            Dim cleanup As DoCleanUpDatabaseRecords
            Try
                cleanup = New DoCleanUpDatabaseRecords(AddressOf CleanUpDatabaseRecords)
                cleanup.BeginInvoke(pTrain, Nothing, Nothing)
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                cleanup = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Clean up datase records
        ''' </summary>
        ''' <param name="pTrain"></param>
        Private Sub CleanUpDatabaseRecords(ByVal pTrain As TrainID)
            Dim query As String
            Dim trainSheetList As ArrayList
            Dim trainSheetGuid As String
            Try
                query = "INSERT INTO tblTrainsInActive SELECT * FROM tblTrainsActive WHERE Symbol = " & "'" & pTrain.Name & "'"
                If DatabaseCommand(query) Then
                    query = "DELETE FROM tblTrainsActive WHERE Symbol = " & "'" & pTrain.Name & "'"
                    TrackEventLog("CleanUpDatabaseRecords:Train=" & pTrain.Name & ":Query=" & query)
                    DatabaseCommand(query)
                End If
                trainSheetList = Me.GetSubTrainSheets(pTrain)
                If IsNothing(trainSheetList) Then trainSheetList = New ArrayList()
                If Not trainSheetList.Contains(pTrain.ActiveTrainSheetGUID) Then
                    trainSheetList.Add(pTrain.ActiveTrainSheetGUID)
                End If
                For Each trainSheetGuid In trainSheetList
                    query = "INSERT INTO tblTrainsInActiveSubTrainSheets SELECT * FROM tblTrainsActiveSubTrainSheets WHERE ActiveSubTrainSheet = " & "'" & trainSheetGuid & "'"
                    If DatabaseCommand(query) Then
                        query = "DELETE FROM tblTrainsActiveSubTrainSheets WHERE ActiveSubTrainSheet = " & "'" & trainSheetGuid & "'"
                        DatabaseCommand(query)
                    End If
                    query = "INSERT INTO tblTrainOsEventsInActive SELECT * FROM tblTrainOsEventsActive WHERE TrainSheetGUID = " & "'" & trainSheetGuid & "'"
                    If DatabaseCommand(query) Then
                        query = "DELETE FROM tblTrainOsEventsActive WHERE TrainSheetGUID = " & "'" & trainSheetGuid & "'"
                        DatabaseCommand(query)
                    End If
                    query = "INSERT INTO tblTrainEventInActiveComments SELECT * FROM tblTrainEventActiveComments WHERE TrainSheetUID = " & "'" & trainSheetGuid & "'"
                    If DatabaseCommand(query) Then
                        query = "DELETE FROM tblTrainEventActiveComments WHERE TrainSheetUID = " & "'" & trainSheetGuid & "'"
                        DatabaseCommand(query)
                    End If
                    query = "INSERT INTO tblTrainEventInActiveDelays SELECT * FROM tblTrainEventActiveDelays WHERE TrainSheetUID = " & "'" & trainSheetGuid & "'"
                    If DatabaseCommand(query) Then
                        query = "DELETE FROM tblTrainEventActiveDelays WHERE TrainSheetUID = " & "'" & trainSheetGuid & "'"
                        DatabaseCommand(query)
                    End If
                    query = "INSERT INTO tblTrainEventInActiveOther SELECT * FROM tblTrainEventActiveOther WHERE TrainSheetUID = " & "'" & trainSheetGuid & "'"
                    If DatabaseCommand(query) Then
                        query = "DELETE FROM tblTrainEventActiveOther WHERE TrainSheetUID = " & "'" & trainSheetGuid & "'"
                        DatabaseCommand(query)
                    End If
                    query = "INSERT INTO tblTrainEventInActiveMovements SELECT * FROM tblTrainEventActiveMovements WHERE TrainSheetUID = " & "'" & trainSheetGuid & "'"
                    If DatabaseCommand(query) Then
                        query = "DELETE FROM tblTrainEventActiveMovements WHERE TrainSheetUID = " & "'" & trainSheetGuid & "'"
                        DatabaseCommand(query)
                    End If
                Next
                If optReleaseTGBOOnTrainFinal Then
                    ReleaseTGBO(pTrain)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                query = Nothing
                trainSheetList = Nothing
                trainSheetGuid = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Realse train id position
        ''' </summary>
        ''' <param name="pTrain"></param>
        ''' <returns></returns>
        Friend Function ReleaseTrainIDPosition(ByVal pTrain As TrainID) As Boolean
            Dim query As String
            Try
                query = "UPDATE " & gtblTrainsActive
                query = query & " SET EngineID = " & "'" & pTrain.IdentifingUnit & "',"
                query = query & " InUsed = " & "'" & 0 & "',"
                query = query & " Subdivision = " & "'" & 0 & "',"
                query = query & " TerritoryAssignmentID = " & "'" & 0 & "',"
                query = query & " TrackGUID = " & "'" & 0 & "',"
                query = query & " TrainLink = " & " '" & pTrain.TrainLinkedToMe & "'"
                query = query & " WHERE Symbol = " & "'" & pTrain.Name & "' AND TerritoryAssignmentID = " & pTrain.myTrack.TerritoryID
                SystemDatabaseCommandToDynamicTrain("TRACK:ReleaseTrainIDPosition", query)
                TMDS.NetworkMessages.CadMessages.SendTrainSymbolDelete(pTrain, gCadTransmitQueue, "R")
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            Finally
                query = Nothing
            End Try
        End Function

        ''' <summary>
        ''' Update train
        ''' </summary>
        ''' <param name="train">train object</param>
        Sub UpDateTrainIDPosition(train As TrainID)
            Try
                If train Is Nothing Then Exit Sub
                TrackEventLog($"{GetCurrentMethod.Name} Train={train.Name}:{train.IdentifingUnit _
                              }:WhoCallMe={(New StackTrace).GetFrame(1).GetMethod().Name}")
                train.TrackGUID = GUID
                If train.IsBeingReleased Then
                    TrackEventLog($"{GetCurrentMethod.Name} Train is being release")
                    Exit Sub
                End If
                Dim subdivision As Subdivision = FetchData.FindSubdivisionFromUID(SubdivisionID)
                Dim subdivisionName As String = If(subdivision Is Nothing, optAuthString38, subdivision.LongName)
                Dim query As String = $"UPDATE tblTrainsActive SET 
                                            InUsed = 1,
                                            Subdivision = {SubdivisionID},
                                            TerritoryAssignmentID = {TerritoryID},
                                            TrackGUID = {train.TrackGUID},
                                            OsEvents = '{train.LastOS}',
                                            StackOrder = {train.StackOrder},
                                            MiscellanousInfoThree = '{subdivisionName}'"
                If optEnableSubdivisionGeoReferencing Then
                    query &= $",SubdvnGeoReference = {train.myTrack.myControlPoint.SubdvnGeoReference}"
                End If
                If gIsRestrictionTypesExistInDb Then
                    query &= $",TrainRestrictionTypes = '{train.RestrictionType}'"
                End If
                query &= $" WHERE Symbol = '{train.Name}'"
                SystemDatabaseCommandToDynamicTrain(GetCurrentMethod.Name, query)
                If optEnableScaleAlarm AndAlso
                    train.myTrack.TrackAlternativeName.Contains("SCALETRACKWEIGHT") AndAlso
                    train.myTrack.Occuppied AndAlso train.Direction = optDirectionSouth Then
                    ScaleAlarm.ScaleAlarm.SendSymbolNameToScale(train, train.myTrack)
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub UpdateTrainStackIndex()
            Try
                Dim CommandString As String = String.Empty
                Dim trn As TrainID
                For Each trn In Me.TrainIDs
                    CommandString = "UPDATE " & gtblTrainsActive
                    CommandString = CommandString & " SET StackOrder = " & Me.TrainIDs.IndexOf(trn)
                    CommandString = CommandString & " WHERE Symbol = " & "'" & trn.Name & "'"
                    SystemDatabaseCommandToDynamicTrain("TRACK:UpdateTrainStackIndex", CommandString)
                Next
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Private Function DatabaseCommand(ByRef CommandString As String, Optional ByVal MethodName As String = "NONE") As Boolean
            Try
                TMDS.SystemUtilities.Utilities.SystemDatabaseCommandToDynamicTrain(MethodName, CommandString)
                Return True
            Catch ex As Exception
                SystemException(ex.ToString & " - SQL QUERY: " & CommandString)
            End Try
        End Function

        Private Function ReleaseTGBO(ByVal theTrain As TrainID) As Boolean
            Dim LaunchPoint As New Point(Me.CurrentDrawingForm.Left + 100, Me.CurrentDrawingForm.Top + 150)
            Try
                Dim myCurrentTGBO As TMDS.GeneralBulletins.TabularGeneralBulletin
                For Each myCurrentTGBO In gTabularGeneralBulletins
                    If myCurrentTGBO.IssuedTo = theTrain.Name AndAlso myCurrentTGBO.TypeOfBulletin = "TGBO-TRAIN" Then
                        If myCurrentTGBO.Status.Trim.ToUpper = "ACTIVE" Then
                            If theTrain IsNot Nothing Then
                                If Not IsOkToReleasePTCTrainTGBO(LaunchPoint, theTrain) Then Return False
                            End If
                        End If
                        If myCurrentTGBO.RemoveFromDatabase Then
                            TrackEventLog("RemoveFromDatabase:WhoCallMe=" & (New System.Diagnostics.StackTrace).GetFrame(1).GetMethod.Name)
                            myCurrentTGBO.RemoveExceptionsFromGBO()
                            myCurrentTGBO.RemoveTrainSpecificBulletins()
                            myCurrentTGBO.UnAssignFromTrain()
                            TMDS.NetworkMessages.TGBOMessages.SendDeleteTGBO(myCurrentTGBO, gCadTransmitQueue)
                        End If
                    End If
                Next
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

        End Function
