#Region "STATUS UPDATES"

        Public Sub PublishStatus(Optional ByVal ForceUpdate As Boolean = False)
            Try
                If Me.myControlPoint.IsShadowMode Then Exit Sub
                If Me.IsShadowMode Then Exit Sub
                If Not ForceUpdate Then
                    If Me.StatusPreviousOccuppied = Me.Occuppied And Me.StatusPreviousBlocked = Me.BlockAbsolute And Me.StatusPreviousSignalStatus = Me.SignalStatOnMe Then
                        Exit Sub
                    Else
                        Me.StatusPreviousOccuppied = Me.Occuppied
                        Me.StatusPreviousBlocked = Me.BlockAbsolute
                        Me.StatusPreviousSignalStatus = Me.SignalStatOnMe
                    End If
                End If
                Dim Message As String = "DC" & Chr(6) & "TRKSTAT;"
                Message = Message & "|" & Me.TerritoryID.ToString
                Message = Message & "|" & Me.myControlPoint.GUID.ToString
                Message = Message & "|" & Me.GUID.ToString

                If Me.Occuppied Then
                    Message = Message & "|OCC=TRUE"
                Else
                    Message = Message & "|OCC=FALSE"
                End If

                If Me.BlockAbsolute Then
                    Message = Message & "|BLKCTL=TRUE|BLKIND=TRUE"
                Else
                    Message = Message & "|BLKCTL=FALSE|BLKIND=FALSE"
                End If

                Select Case Me.SignalStatOnMe
                    Case SignalStatus.SignalAtStop, SignalStatus.SignalOfficeLock, SignalStatus.SignalInTime, SignalStatus.SignalUnSolicated
                        Message = Message & "|SIGCTL=FALSE"
                    Case Else
                        Message = Message & "|SIGCTL=TRUE"
                End Select

                Select Case Me.SignalStatOnMe
                    Case SignalStatus.SignalAtStop, SignalStatus.SignalOfficeLock, SignalStatus.SignalRequested, SignalStatus.SignalRequestedDrill
                        Message = Message & "|SIGIND=FALSE"
                    Case Else
                        Message = Message & "|SIGIND=TRUE"
                End Select
                If Me.TrafficDirection = "" Then
                    Message = Message & "|Direction=NONE"
                Else
                    Message = Message & "|Direction=" & Me.TrafficDirection.ToUpper
                End If
                Message = Message & "|TRKNAME=" & Me.Name


                Message = Me.TerritoryID.ToString & Chr(12) & Message

                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                End SyncLock

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub PublishTagStatus(ByVal AddTag As Boolean, ByVal tg As Tag)
            Try
                If Me.myControlPoint.IsShadowMode Then Exit Sub
                If Me.IsShadowMode Then Exit Sub
                Dim Message As String = "DC" & Chr(6) & "TAGSTAT;"
                Message = Message & "|" & Me.TerritoryID.ToString
                Message = Message & "|TYPE=" & tg.TagType
                If AddTag Then
                    Message = Message & "|ACTION=ADD"
                Else
                    Message = Message & "|ACTION=REMOVE"

                End If
                Message = Message & "|GUID=" & tg.TagGuid
                Message = Message & "|ISSUE=" & Format(tg.CreateTime, "MM-dd-yyyy HH:mm")
                Message = Message & "|TRKLIST=" & Me.GUID.ToString & "@" & Me.myControlPoint.GUID.ToString & "@" & Me.Name

                Dim AdditionInformation As String
                Dim data() As String = tg.DataString.Split("|")
                Select Case tg.TagType
                    Case "SPEED"
                        AdditionInformation = "FRGHT SPEED=" & data(0) & " PASS SPEED=" & data(5) & " ON " & data(3) & " FROM MP " & data(1) & " AND MP " & data(2)

                    Case "INFO"
                        AdditionInformation = "TRACK NOTE:" & data(0)
                    Case "XING"
                        AdditionInformation = "XING MALFUNNCTION AT " & data(1) & " MP " & data(0)
                    Case Else
                        AdditionInformation = "NOTHING NOTED"
                End Select
                Message = Message & "|ADDINFO=" & AdditionInformation

                Message = Me.TerritoryID.ToString & Chr(12) & Message

                SyncLock TMDS.GlobalDeclarations.gControlServerXmtQueue
                    TMDS.GlobalDeclarations.gControlServerXmtQueue.Enqueue(Message)
                End SyncLock

            Catch ex As Exception
                Dim SysEvent As New SystemEventRecord(Now, SystemEventRecord.EventEnum.ExceptionEvent, ex.ToString, SystemEventQueue)
            End Try
        End Sub

        Public Sub SendRemoveTrackAuthority(ByVal pAuth As String)
            Try
                Dim Message As String = "REMOTELINK;REMOVETRACKAUTHORITY;" & pAuth & Chr(4)
                'Me.theNetworkConnecton.SendData(Message)
