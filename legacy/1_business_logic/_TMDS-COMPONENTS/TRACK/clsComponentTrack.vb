        Public Sub DoEntExit()
            Dim TmpExitTrack As Track = Nothing
            Dim TmpEntryTrack As Track = Nothing
            Dim Tmpdirection As String = String.Empty
            Dim SecondClick As Boolean
            Try

                Select Case Me.AuthorityType
                    Case "SHELF", "OTHER"
                        Exit Sub
                        'CTC
                        'TWC
                        'YL
                        'RL
                        'TWC-BABS
                        'TWC-ABSW
                        'TWC-ABSE
                        'NON-TWC
                        'CTC-OTHER
                        'CTC-PSEUD
                        'OTHER
                        'SHELF
                End Select
                If optEnableRestrictedSignalRouteForQuickRoute Then
                    DoEntExitRestrictedRoute()
                    Exit Sub
                End If
                If gEntryTrack Is Nothing Then
                    gEntExtTrackSelection.Clear()
                    gEntExtTrackSelection = New ArrayList
                    gTmpRouteCollection = New ArrayList
                    gTmpRouteSignalCollection = New ArrayList
                    'this is to not check the first entry track inthe invalidation check for this route
                    If gEntryTrack Is Nothing Then
                        gFirstEntryTrack = Me
                    End If
                    gEntryTrack = Me
                    gEntExtTrackSelection.Add(gEntryTrack)
                    If gGenerateRouteForTrainMode Then
                        gEntryTrack.SelectionMode = GenericComponent.ModeSelection.SummarySelectionRouting
                    Else
                        gEntryTrack.SelectionMode = GenericComponent.ModeSelection.RouteRequesting
                    End If

                    gEntryTrack.FlashComponent = True
                    gTrackAuthSelectionFlashOn = True
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionEntExt.Enabled = True
                ElseIf gExitTrack Is Nothing Then
                    gExitTrack = Me
                    SecondClick = True
                ElseIf Not gExitTrack Is Nothing Then
                    If optEnablePreseveQuickRouteCollectionOnInvalidClick Then
                        Tmpdirection = gSearchDirection
                        TmpEntryTrack = gEntryTrack
                        TmpExitTrack = gExitTrack
                        CopyArrayCollection(gTmpRouteSignalCollection, gEntExtExecutionSelection)
                        CopyArrayCollection(gTmpRouteCollection, gEntExtTrackSelection)
                    End If
                    gEntryTrack = gExitTrack
                    gExitTrack = Me
                Else
                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                    ClearSystemVariables()
                    Exit Sub
                End If
                If gEntryTrack IsNot Nothing AndAlso
                    gExitTrack IsNot Nothing Then
                    If optEnablePreseveQuickRouteCollectionOnInvalidClick Then
                        CopyArrayCollection(gTmpRouteSignalCollection, gEntExtExecutionSelection)
                        CopyArrayCollection(gTmpRouteCollection, gEntExtTrackSelection)
                    End If
                    'Generate license over the same track
                    If optEnableLicenseGenerationForPTC AndAlso
                        gCreateLicenseTrain IsNot Nothing AndAlso
                        gEntryTrack Is gExitTrack Then
                        gCreateLicenseTrain.PtcGenerateNormalLicenseOverTrack(gEntryTrack, gEntExtTrackSelection)
                        MySystemForms.frmMainMDI.ClearEntExtSelection()
                        ClearSystemVariables()
                        Exit Sub
                    End If
                    SetCursor(Cursors.WaitCursor)
                    If optEnableGroupedSignalRoutes Then
                        Dim GSR As New TMDS.FastRoutes.GroupedRoutes
                        If GSR.SearchForGroupedSignalRoutes(gEntryTrack, gExitTrack) Then
                            gEntryTrack = gExitTrack
                            gExitTrack = Me
                            TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()
                            If optEnableBulletinRouteCheck Then
                                If gCreateAuthorityTrain IsNot Nothing AndAlso Not gCreateAuthorityTrain.DoCheckForBulletinExceptions(gEntExtTrackSelection) Then
                                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                    ClearSystemVariables()
                                    Exit Sub
                                End If
                                If gCreateAuthorityTrain IsNot Nothing AndAlso Not gCreateAuthorityTrain.CheckMyTGBOValidity(Nothing, gEntExtTrackSelection) Then
                                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                    ClearSystemVariables()
                                    Exit Sub
                                End If
                            End If
                        Else
                            TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curEntExit)
                            If gEntExtTrackSelection.Contains(gExitTrack) Then gEntExtTrackSelection.Remove(gExitTrack)
                            gExitTrack = TmpExitTrack
                            TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()
                            Exit Sub
                            'TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                            'ClearSystemVariables()
                            'Exit Sub
                        End If
                    ElseIf optEnableSignalRouteForQuickRoute Then
                        Dim clsFRoute As New clsFastRoute
                        If clsFRoute.SearchForRoute(gEntryTrack, gExitTrack) Then
                            gEntryTrack = gExitTrack
                            gExitTrack = Me
                            TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()
                            If optEnableBulletinRouteCheck Then
                                If gCreateAuthorityTrain IsNot Nothing AndAlso Not gCreateAuthorityTrain.DoCheckForBulletinExceptions(gEntExtTrackSelection) Then
                                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                    ClearSystemVariables()
                                    Exit Sub
                                End If
                                If gCreateAuthorityTrain IsNot Nothing AndAlso Not gCreateAuthorityTrain.CheckMyTGBOValidity(Nothing, gEntExtTrackSelection) Then
                                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                                    ClearSystemVariables()
                                    Exit Sub
                                End If
                            End If
                        End If
                    Else
                        If MySystemForms.frmMainMDI.SearchForRoute(gEntryTrack,
                                                                   gExitTrack,
                                                                   gCreateLicenseTrain) Then
                            Tmpdirection = gSearchDirection
                            TmpEntryTrack = gEntryTrack
                            TmpExitTrack = gExitTrack
                            CopyArrayCollection(gTmpRouteCollection, gEntExtTrackSelection)
                            gEntryTrack = gExitTrack
                            gExitTrack = Me
                            MySystemForms.frmMainMDI.EntExtFlasherReset()
                        Else
                            If optEnablePreseveQuickRouteCollectionOnInvalidClick AndAlso
                                Not SecondClick AndAlso
                                gTmpRouteCollection IsNot Nothing AndAlso
                                gTmpRouteCollection.Count > 0 Then
                                CopyArrayCollection(gEntExtTrackSelection, gTmpRouteCollection)
                                CopyArrayCollection(gEntExtExecutionSelection, gTmpRouteSignalCollection)
                                gEntExit = True
                                gEntryTrack = TmpEntryTrack
                                gExitTrack = TmpExitTrack
                                gSearchDirection = Tmpdirection
                                TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()
                                TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curEntExit)
                            End If
                            Exit Sub
                        End If
                        If gGenerateRouteForTrainMode Then
                            TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curCreatePlan)
                        Else
                            TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curEntExit)
                        End If
                        gEntExit = True
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

        Public Sub DoEntExitRestrictedRoute()

            Try
                If gEntryTrack IsNot Nothing AndAlso gExitTrack IsNot Nothing Then Exit Sub
                Select Case Me.AuthorityType
                    Case "SHELF", "OTHER"
                        Exit Sub
                        'CTC
                        'TWC
                        'YL
                        'RL
                        'TWC-BABS
                        'TWC-ABSW
                        'TWC-ABSE
                        'NON-TWC
                        'CTC-OTHER
                        'CTC-PSEUD
                        'OTHER
                        'SHELF
                End Select
                If gEntryTrack Is Nothing Then
                    'this is to not check the first entry track inthe invalidation check for this route
                    If gEntryTrack Is Nothing Then
                        gFirstEntryTrack = Me
                    End If
                    gEntryTrack = Me
                    gEntExtTrackSelection.Add(gEntryTrack)
                    If gGenerateRouteForTrainMode Then
                        gEntryTrack.SelectionMode = GenericComponent.ModeSelection.SummarySelectionRouting
                    Else
                        gEntryTrack.SelectionMode = GenericComponent.ModeSelection.RouteRequesting
                    End If

                    gEntryTrack.FlashComponent = True
                    gTrackAuthSelectionFlashOn = True
                    TMDS.SystemForms.MySystemForms.frmMainMDI.tmrTrackSelectionEntExt.Enabled = True
                End If

                If gEntryTrack IsNot Nothing AndAlso gExitTrack Is Nothing Then
                    TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(System.Windows.Forms.Cursors.WaitCursor)
                    Dim EntrySignal As Signal = Nothing
                    EntrySignal = FindSignalEntryForRestrictedRoute(gEntryTrack)
                    Dim ReturnSR As SignalRoute = Nothing
                    ReturnSR = GetRestrictedSignalRoute(EntrySignal)
                    If ReturnSR Is Nothing Then
                        EntrySignal = FindSignalEntryForRestrictedRoute(gEntryTrack, False)
                        ReturnSR = GetRestrictedSignalRoute(EntrySignal)
                    End If
                    If ReturnSR IsNot Nothing Then
                        Dim comp As Object = Nothing
                        'gEntExtTrackSelection = New ArrayList
                        TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()
                        gEntExtExecutionSelection.Add(ReturnSR.EntrySignal)
                        For Each comp In ReturnSR.ComponentList
                            If comp.GetType.ToString = gSignalComponentName Then
                                If comp.Guid <> EntrySignal.GUID Then
                                    If GetSignalDirection(comp) = GetSignalDirection(EntrySignal) AndAlso Not ReturnSR.HasFlipFlop Then
                                        Exit For
                                    ElseIf GetSignalDirection(comp) <> GetSignalDirection(EntrySignal) AndAlso ReturnSR.HasFlipFlop Then
                                        Exit For
                                    End If
                                    'Exit For
                                End If
                            End If
                            If Not gEntExtTrackSelection.Contains(comp) Then gEntExtTrackSelection.Add(comp)
                        Next
                        Dim clsFRoute As New clsFastRoute
                        If Not clsFRoute.ValidateRoute(gEntExtTrackSelection, gEntryTrack, gExitTrack) Then
                            TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                            ClearSystemVariables()
                            Exit Sub
                        Else
                            'TMDS.SystemForms.MySystemForms.frmMainMDI.ProcessEnterExitSelection()
                        End If
                        'If ReturnSR.ExitSignal IsNot Nothing AndAlso Not gEntExtTrackSelection.Contains(ReturnSR.ExitSignal) Then gEntExtTrackSelection.Add(ReturnSR.ExitSignal)
                        'For Each comp In ReturnSR.myExitTracks
                        '    If Not gEntExtTrackSelection.Contains(comp) Then gEntExtTrackSelection.Add(comp)
                        'Next
                        gExitTrack = Me
                        TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()
                        TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curSend)
                    Else
                        TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                        ClearSystemVariables()
                        Exit Sub
                    End If

                    'TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()
                    'TMDS.SystemUtilities.UtilitiesDisplayForm.SetCursor(curEntExit)
                    'gEntExit = True
                Else
                    TMDS.SystemForms.MySystemForms.frmMainMDI.ClearEntExtSelection()
                    ClearSystemVariables()
                    Exit Sub
                End If


                'TMDS.SystemForms.MySystemForms.frmMainMDI.EntExtFlasherReset()

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub
        Private Function FindSignalEntryForRestrictedRoute(ByVal entry_track As Track, Optional SearchRight As Boolean = True) As Signal
            Try
                Dim returnSignal As Signal = Nothing
                If SearchRight Then
                    returnSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(entry_track.RightLink)
                    If returnSignal IsNot Nothing Then
                        Select Case returnSignal.ComponentType.Trim.ToUpper
                            Case "R", "D"
                                Return returnSignal
                        End Select
                    End If
                Else
                    returnSignal = TMDS.SystemUtilities.FetchData.FindSignalFromGUID(entry_track.LeftLink)
                    If Not IsNothing(returnSignal) Then
                        Select Case returnSignal.ComponentType.Trim.ToUpper
                            Case "L", "U"
                                Return returnSignal
                        End Select
                    End If
                End If
                Return Nothing
            Catch ex As Exception
                SystemException(ex.ToString)
                Return Nothing
            End Try
        End Function

        Private Function GetRestrictedSignalRoute(EntrySignal As Signal) As SignalRoute
            Try
                If EntrySignal IsNot Nothing Then
                    gSearchDirection = GetSignalDirection(EntrySignal)
                    Dim SR As SignalRoute

                    For Each SR In gSignalRouteList
                        If SR IsNot Nothing Then
                            If SR.EntrySignal IsNot Nothing AndAlso SR.EntrySignal.GUID = EntrySignal.GUID Then
                                If SR.ExitTrack IsNot Nothing AndAlso SR.ExitTrack Is Me Then
                                    Return SR
                                ElseIf SR.myExitTracks IsNot Nothing AndAlso SR.myExitTracks.Contains(Me) Then
                                    Return SR
                                End If
                            End If
                        End If
                    Next


                End If
            Catch ex As Exception

            End Try
            Return Nothing
        End Function

        Public Sub DoQuickRoute()
            Try
                Select Case Me.AuthorityType
                    Case "SHELF", "OTHER"
                        Exit Sub
                        'CTC
                        'TWC
                        'YL
                        'RL
                        'TWC-BABS
                        'TWC-ABSW
                        'TWC-ABSE
                        'NON-TWC
                        'CTC-OTHER
                        'CTC-PSEUD
                        'OTHER
                        'SHELF
                End Select

                Me.TrackEventLog("CLICKED - ENTER/EXIT - FAST ROUTE MODE")
                gEntExit = True
