                                                                            End If
                                                                        End If
                                                                    End If
                                                                End If
                                                            End If
                                                            SearchLeftComplete = True
                                                            SearchRightComplete = True
                                                            Exit While
                                                        End If
                                                    End If
                                                Next
                                            Else
                                                Dim comp As Object
                                                For Each comp In CompToCheck.myControlPoint.AssignedComponenets
                                                    If comp.GetType.ToString = "TMDS.TrackComponents.Track" And comp.Name = CompToCheck.Name Then
                                                        If comp.TrainIDs.Count > 0 Then
                                                            trn1 = Nothing
                                                            trn1 = comp.TrainIDs(0)
                                                            If Not IsTrainMoveAllowedOnIndication(trn1, "TrackTrainIDOn") Then Exit Sub
                                                            If trn1.Direction = optDirectionEast Or trn1.Direction = optDirectionNorth Then
                                                                Me.MoveTrainIDPlace(trn1, comp, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", "RIGHT")
                                                                If Me.OStype Then
                                                                    CompToCheck.PushTrainIDToNextOccupancy(Me, trn1, "RIGHT")
