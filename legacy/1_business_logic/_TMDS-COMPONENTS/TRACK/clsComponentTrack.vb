                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                            End If
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                        End If
                    ElseIf NextComp.GetType.ToString = "TMDS.SignalComponents.Signal" Then
                        If NextComp.ComponentType = "R" Then
                            If Not FlipIt Then
                                Dim sig As Signal = CType(NextComp, Signal)
                                If sig.SignalStatus <> SignalComponents.Signal.BulbStatus.StopStatus Or sig.FleetEnabled Then 'Or sig.StoredEntrySignal Then
                                    NoRightConflict = False
                                    Exit While
                                End If
                            End If

                            NoRightConflict = True
                            Exit While
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                        End If
                    ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.FlipFlop" Then
                        FlipIt = True
                        NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)

                    ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                        Dim rr As RRXING = CType(NextComp, RRXING)
                        NextComp = rr.FindExitComponent(LastComp.GUID)
                    Else
                        If FlipIt Then
                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.RightLink)
                        Else
                            NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                        End If
                        'NextComp = TMDS.SystemUtilities.FetchData.FindComponentFromGUID(NextComp.LeftLink)
                    End If
                    LoopControl = LoopControl + 1
                    If LoopControl = 50 Then
                        NoRightConflict = False
                        Exit While
                    End If
                End While
                If NoRightConflict Then
                    Return True
                Else
                    Return False
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

        Public Function CheckForSignalIntoBlockRequest(Optional ByVal Directional As Boolean = False, Optional ByVal Direction As String = "", Optional ByVal IgnoreCodeFail As Boolean = False) As Boolean
            Dim NextComp As Object = Me
            Dim LastComp As Object = Me
            Dim RightSearchComplete, LeftSearchComplete As Boolean
            Dim FlipFlopToLeft As Boolean
            Dim LoopControl As Integer
            Try


                'SEARCH RIGHT FOR ANY OPPOSING SIGNALS
                'NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                If Directional And Direction = "LEFT" Then
                    RightSearchComplete = True
                End If
                Do Until RightSearchComplete

                    Select Case NextComp.GetType.ToString
                        Case "TMDS.TrackComponents.Track"
                            Dim trk As Track = CType(NextComp, Track)

                            LastComp = NextComp
                            If NextComp.IsRemoteTrack Then
                                Exit Do
                            End If

                            If trk.NonTransverable Then
                                Exit Do
                            End If

                            If trk.FailState AndAlso Not IgnoreCodeFail Then
                                Return False
                            End If
                            NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)

                            If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                Dim swToCheck As Switch = CType(NextComp, Switch)
                                If swToCheck.LeftAltLink <> 0 And swToCheck.LeftAltLink = trk.GUID And Not swToCheck.ControlledReverse Then
                                    Exit Do
                                End If
                                If swToCheck.RightAltLink <> 0 And swToCheck.RightAltLink = trk.GUID And Not swToCheck.ControlledReverse Then
                                    Exit Do
                                End If
                            End If

                        Case "TMDS.SignalComponents.Signal"
                            LastComp = NextComp

                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.ComponentType = "R" Or sig.ComponentType = "D" Then
                                If sig.StoredExitSignal Then
                                    Return False
                                End If
                            End If
                            If (sig.FailState And Not sig.MakeInvisible) AndAlso (optEnableTrackTimeIssueOnCodeBrown = False And (gCreateCPFT Or gCreateCPTNT)) Then

                            ElseIf sig.FailState AndAlso Not IgnoreCodeFail AndAlso Not sig.MakeInvisible Then
                                Return False
                            End If
                            If FlipFlopToLeft Then
                                If sig.ComponentType = "R" Or sig.ComponentType = "D" Then
                                    If sig.SignalCtlStatus <> SignalComponents.Signal.CtlStatus.RequestedStop _
                                    Or sig.SignalIndStatus <> SignalComponents.Signal.IndStatus.Stopped Then
                                        Return False
                                    Else
                                        Exit Do
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                            Else
                                If sig.ComponentType = "L" Or sig.ComponentType = "U" Then
                                    If sig.SignalCtlStatus <> SignalComponents.Signal.CtlStatus.RequestedStop _
                                    Or sig.SignalIndStatus <> SignalComponents.Signal.IndStatus.Stopped Then
                                        Return False
                                    Else
                                        Exit Do
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            End If

                        Case "TMDS.SwitchComponents.Switch"
                            LastComp = NextComp

                            Dim sw As Switch = CType(NextComp, Switch)
                            If sw.ControlledReverse Then
                                If sw.RightAltLink <> 0 Then
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If


                        Case "TMDS.TrackOtherComponents.RRXING"
                            Dim rr As RRXING = CType(NextComp, RRXING)
                            NextComp = rr.FindExitComponent(LastComp.GUID)
                        Case "TMDS.TrackOtherComponents.FlipFlop"
                            Dim ff As FlipFlop = CType(NextComp, FlipFlop)
                            NextComp = ff.FindExitComponent(LastComp.GUID)
                            If optEnableDoubleFlipFlopLogic Then
                                If Not FlipFlopToLeft Then
                                    FlipFlopToLeft = True
                                Else
                                    FlipFlopToLeft = False
                                End If
                            Else
                                FlipFlopToLeft = True
                            End If


                    End Select
                    If NextComp Is Nothing Then
                        Exit Do
                    End If
                    LoopControl = LoopControl + 1
                    If LoopControl > 25 Then
                        Exit Do
                    End If
                Loop

                LoopControl = 0
                'SEARCH LEFT FOR ANY OPPOSING SIGNALS
                NextComp = Me 'TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                If Directional And Direction = "RIGHT" Then
                    LeftSearchComplete = True
                End If
                Dim FlipFlopToRight As Boolean
                Do Until LeftSearchComplete

                    Select Case NextComp.GetType.ToString
                        Case "TMDS.TrackComponents.Track"
                            Dim trk As Track = CType(NextComp, Track)
                            LastComp = NextComp
                            If NextComp.IsRemoteTrack Then
                                Exit Do
                            End If
                            If trk.NonTransverable Then
                                Exit Do
                            End If

                            If trk.FailState AndAlso (optEnableTrackTimeIssueOnCodeBrown = False And (gCreateCPFT Or gCreateCPTNT)) Then
                                Return False
                            End If

                            If Not FlipFlopToRight Then
                                If NextComp.LeftLink = 0 Then
                                    Exit Do
                                End If

                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            Else
                                If NextComp.RightLink = 0 Then
                                    Exit Do
                                End If
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            End If

                            If NextComp.GetType.ToString = "TMDS.SwitchComponents.Switch" Then
                                Dim swToCheck As Switch = CType(NextComp, Switch)
                                If swToCheck.LeftAltLink <> 0 And swToCheck.LeftAltLink = trk.GUID And Not swToCheck.ControlledReverse Then
                                    Exit Do
                                End If
                                If swToCheck.RightAltLink <> 0 And swToCheck.RightAltLink = trk.GUID And Not swToCheck.ControlledReverse Then
                                    Exit Do
                                End If
                            End If

                        Case "TMDS.SignalComponents.Signal"
                            Dim sig As Signal = CType(NextComp, Signal)
                            If sig.ComponentType = "L" Or sig.ComponentType = "U" Then
                                If sig.StoredExitSignal Then
                                    Return False
                                End If
                            End If
                            ' AndAlso (optEnableTrackTimeIssueOnCodeBrown = False And (gCreateCPFT Or gCreateCPTNT)) 
                            If (sig.FailState And Not sig.MakeInvisible) AndAlso (optEnableTrackTimeIssueOnCodeBrown = False And (gCreateCPFT Or gCreateCPTNT)) Then

                            ElseIf (sig.FailState And Not sig.MakeInvisible) AndAlso (optEnableTrackTimeIssueOnCodeBrown = False And (gCreateCPFT Or gCreateCPTNT)) Then
                                Return False
                            End If

                            If Not FlipFlopToRight Then
                                If sig.ComponentType = "R" Or sig.ComponentType = "D" Then
                                    If sig.SignalCtlStatus <> SignalComponents.Signal.CtlStatus.RequestedStop _
                                    Or sig.SignalIndStatus <> SignalComponents.Signal.IndStatus.Stopped Then
                                        Return False
                                    Else
                                        Exit Do
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                            Else
                                If sig.ComponentType = "L" Or sig.ComponentType = "U" Then
                                    If sig.SignalCtlStatus <> SignalComponents.Signal.CtlStatus.RequestedStop _
                                    Or sig.SignalIndStatus <> SignalComponents.Signal.IndStatus.Stopped Then
                                        Return False
                                    Else
                                        Exit Do
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            End If

                        Case "TMDS.SwitchComponents.Switch"
                            Dim sw As Switch = CType(NextComp, Switch)
                            If Not FlipFlopToRight Then
                                If sw.ControlledReverse Then
                                    If sw.LeftAltLink <> 0 Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftAltLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                                End If
                            Else
                                If sw.ControlledReverse Then
                                    If sw.RightAltLink <> 0 Then
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightAltLink)
                                    Else
                                        NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                    End If
                                Else
                                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                                End If
                            End If


                        Case "TMDS.TrackOtherComponents.RRXING"
                            Dim rr As RRXING = CType(NextComp, RRXING)
                            NextComp = rr.FindExitComponent(LastComp.GUID)

                        Case "TMDS.TrackOtherComponents.FlipFlop"
                            Dim ff As FlipFlop = CType(NextComp, FlipFlop)
                            NextComp = ff.FindExitComponent(LastComp.GUID)

                            If optEnableDoubleFlipFlopLogic Then
                                If Not FlipFlopToRight Then
                                    FlipFlopToRight = True
                                Else
                                    FlipFlopToRight = False
                                End If
                            Else
                                FlipFlopToRight = True
                            End If


                    End Select
                    If NextComp Is Nothing Then
                        Return False
                    End If
                    LoopControl = LoopControl + 1
                    If LoopControl > 50 Then
                        Return False
                    End If
                Loop

                Return True

            Catch ex As Exception
                SystemException(ex.ToString)
                Return False
            End Try
        End Function

