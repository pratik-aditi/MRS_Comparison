                                                                    trnSym = String.Empty
                                                                    'trnSym = LeftTrk.myRemoteTrack.RequestTrainID("RIGHT")
                                                                    trnSym = LeftTrk.myRemoteTrack.RequestTrainID()
                                                                    If trnSym = "" Then
                                                                        LeftTrk.myRemoteTrack.TrackTrainID(trn1.Name)
                                                                        TrackEventLog("SUB EVENT-999-remote")
                                                                    End If
                                                                End If
                                                            End If
                                                        End If
                                                        SearchLeftComplete = True
                                                        Exit While
                                                    End If
                                                End If
                                            Next
                                        Else
                                            Dim comp As Object
                                            For Each comp In CompToCheck.myControlPoint.AssignedComponenets
