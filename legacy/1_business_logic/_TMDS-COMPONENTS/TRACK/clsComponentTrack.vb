                                Return False
                            End If
                            If Not gDeviceBlockSelection.Contains(RightTrack) Then
                                gDeviceBlockSelection.Add(RightTrack)
                            End If
                        Else
                            gDeviceBlockSelection.Remove(RightTrack)
                            If Not RightTrack.myRemoteTrack.SendBlockPendingStatus(False, pDeviceBlock, True) Then
                                Return False
                            End If
                        End If
                    End If
                End If
                Dim LeftAltTrack As Object = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.LeftAltLink)
                Dim RightAltTrack As Object = TMDS.SystemUtilities.FetchData.FindRemoteTrackItemFromGUID(Me.RightAltLink)
                If Not LeftAltTrack Is Nothing Then
                    If LeftAltTrack.IsRemoteTrack Then
                        If pAddToCollection Then
                            If Not LeftAltTrack.myRemoteTrack.SendBlockPendingStatus(True, pDeviceBlock, True) Then
                                Return False
                            End If
                            If Not gDeviceBlockSelection.Contains(LeftAltTrack) Then
                                gDeviceBlockSelection.Add(LeftAltTrack)
                            End If
                        Else
                            gDeviceBlockSelection.Remove(LeftAltTrack)
                            If Not LeftAltTrack.myRemoteTrack.SendBlockPendingStatus(False, pDeviceBlock, True) Then
                                Return False
                            End If
                        End If
                    End If
                End If
                If Not RightAltTrack Is Nothing Then
                    If RightAltTrack.IsRemoteTrack Then
                        If pAddToCollection Then
                            If Not RightAltTrack.myRemoteTrack.SendBlockPendingStatus(True, pDeviceBlock, True) Then
                                Return False
                            End If
                            If Not gDeviceBlockSelection.Contains(RightAltTrack) Then
                                gDeviceBlockSelection.Add(RightAltTrack)
                            End If
                        Else
                            gDeviceBlockSelection.Remove(RightAltTrack)
                            If Not RightAltTrack.myRemoteTrack.SendBlockPendingStatus(False, pDeviceBlock, True) Then
                                Return False
                            End If
                        End If
                    End If
                End If
                Return True
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

        Private Sub DoBlueFlagBlock()
            Try

                If Me.AuthorityType = "SHELF" Then Exit Sub

                If Not Me.AllowBlocking Then Exit Sub

                If Not Me.AllowBlueFlag Then Exit Sub

                If Not gDeviceBlockSelection.Contains(Me) Then

                    gDeviceBlockSelection.Add(Me)


                    If Not Me.OsComponentCollection Is Nothing Then
                        Dim comp As Object
                        For Each comp In Me.OsComponentCollection
                            If Not gDeviceBlockSelection.Contains(comp) Then
                                gDeviceBlockSelection.Add(comp)
                                comp.SelectionMode = ModeSelection.DeviceBlocking
                                'comp.Flasher.Interval = 150
                                comp.FlashComponent = True
                            End If
                        Next
                    End If

                    Dim LikeCompArrayList As ArrayList = TMDS.SystemUtilities.FetchData.FindLikeCompInCPForBlueFlag(Me.myControlPoint, Me)
                    If Not LikeCompArrayList Is Nothing Then
                        Dim comp As Object
                        For Each comp In LikeCompArrayList
                            If Not gDeviceBlockSelection.Contains(comp) Then
                                gDeviceBlockSelection.Add(comp)
                                comp.SelectionMode = ModeSelection.DeviceBlocking
                                'comp.Flasher.Interval = 150
                                comp.FlashComponent = True
                            End If
                        Next
                    End If
                    Me.SelectionMode = ModeSelection.DeviceBlocking
                    Me.FlashComponent = True

                    If Not IsNothing(Me.TrackBlockingReferences) Then
                        Dim theRef As Int32
                        For Each theRef In Me.TrackBlockingReferences
                            Dim SwitchWasControlled As Boolean
                            Dim sw As Switch = TMDS.SystemUtilities.FetchData.FindSwitchFromGUID(theRef)
                            If Not IsNothing(sw) Then
                                gDeviceBlockSelection.Add(sw)
                                If sw.TypeOfSwitch = "DERAIL" Then
                                    If Not sw.ControlledReverse Then
                                        If Not sw.BlockAbsolute And sw.SignalStatOnMe = Switch.SignalStatus.SignalAtStop Then
                                            If sw.IsSwitch(True, Nothing) Then SwitchWasControlled = True
                                        End If
                                    Else
                                        SwitchWasControlled = True
                                    End If
                                Else
                                    If sw.ControlledReverse Then
                                        If Not sw.BlockAbsolute And sw.SignalStatOnMe = Switch.SignalStatus.SignalAtStop Then
                                            If sw.IsSwitch(True, Nothing) Then SwitchWasControlled = True
                                        End If
                                    Else
                                        SwitchWasControlled = True
                                    End If
                                End If
                                If Not SwitchWasControlled Then
                                    Dim frmMessageBox As frmMessageBox
                                    Dim MessageList As New ArrayList()
                                    MessageList.Add("SWITCH CANNOT BE LINE")
                                    MessageList.Add("FOR " & optBFlagString & " AT " & sw.Name)
                                    MessageList.Add("")
                                    frmMessageBox = New frmMessageBox()
                                    frmMessageBox.Owner = Me.CurrentDrawingForm
                                    Dim myPoint As New Point(TMDS.SystemForms.MySystemForms.frmMainMDI.Left + Me.CurrentDrawingForm.Left + 500, Me.CurrentDrawingForm.Top + 300)
                                    frmMessageBox.SetMessage(MessageList, optBFlagString & " NOTIFICATION", False, myPoint)
                                    frmMessageBox.ShowDialog()
                                    frmMessageBox.Dispose()
                                    frmMessageBox = Nothing
                                End If
                            End If
                        Next
                    End If
                    TMDS.SystemForms.MySystemForms.frmMainMDI.DeviceBlockFlasherReset()

                Else
                    'Check remote track linkage BLOCKING
                    If Not DoDeviceBlockForRemoteTrack(False, False) Then
                        'Exit Sub
                    End If

                    If Not Me.OsComponentCollection Is Nothing Then
                        Dim comp As Object
                        For Each comp In Me.OsComponentCollection
                            gDeviceBlockSelection.Remove(comp)
                            comp.SelectionMode = ModeSelection.Regular
                            comp.FlasherMode(False)
                            comp.Flasher.Interval = 250
                        Next
                    End If

                    Dim LikeCompArrayList As ArrayList = TMDS.SystemUtilities.FetchData.FindLikeCompInCPForBlueFlag(Me.myControlPoint, Me)
                    If Not LikeCompArrayList Is Nothing Then
                        Dim comp As Object
                        For Each comp In LikeCompArrayList
                            gDeviceBlockSelection.Remove(comp)
                            comp.SelectionMode = ModeSelection.Regular
                            comp.FlasherMode(False)
                            comp.Flasher.Interval = 250
                        Next
                    End If

                    gDeviceBlockSelection.Remove(Me)
                    Me.SelectionMode = ModeSelection.Regular
                    Me.FlasherMode(False)
                    'Me.Flasher.Interval = 250
                    TMDS.SystemForms.MySystemForms.frmMainMDI.DeviceBlockFlasherReset()


                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub

