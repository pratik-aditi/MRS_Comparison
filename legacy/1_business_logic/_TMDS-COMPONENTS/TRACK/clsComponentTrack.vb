                                If auth.Box4Components.Contains(Me) Then
                                    If auth.ShowItemFourComponents Then
                                        Me.mnuTWCRollUp.MenuItems.Add(New MenuItem(auth.AuthorityUID & ", (" & auth.IssueTo & ")", AddressOf mnuTWCRollUp_Click))
                                    End If
                                Else
                                    Me.mnuTWCRollUp.MenuItems.Add(New MenuItem(auth.AuthorityUID & ", (" & auth.IssueTo & ")", AddressOf mnuTWCRollUp_Click))
                                End If
                            Else
                                Me.mnuTWCRollUp.MenuItems.Add(New MenuItem(auth.AuthorityUID & ", (" & auth.IssueTo & ")", AddressOf mnuTWCRollUp_Click))
                            End If
                        Else
                            Me.mnuTWCRollUp.MenuItems.Add(New MenuItem(auth.AuthorityUID & ", (" & auth.IssueTo & ")", AddressOf mnuTWCRollUp_Click))
                        End If
                        If optEnableVoidAuthorityMenuItem Then
                            Dim miV As New MenuItem(auth.AuthorityUID & ", (" & auth.IssueTo & ")", AddressOf mnuTWCVoid_Click)

                            If optEnableARRCSpecificOptions Then
                                If auth.IssuedToTrain Then
                                    If auth.myTrain Is Nothing Then auth.myTrain = TMDS.SystemUtilities.FetchData.FindTrainFromSymbol(auth.TrainSymbol)
                                    If auth.myTrain IsNot Nothing Then
                                        If auth.myTrain.CheckMyPTCStatus Then
                                            miV.Enabled = False
                                        End If
                                    End If
                                End If
                            End If
                            Me.mnuTWCVoid.MenuItems.Add(miV)
                            'Me.mnuTWCVoid.MenuItems.Add(New MenuItem(auth.AuthorityUID & ", (" & auth.IssueTo & ")", AddressOf mnuTWCVoid_Click))
                        End If
                    Next

                Else
                    If Not IsNothing(miRemove) Then
                        miRemove.Visible = False
                    End If
                    If Not IsNothing(miModify) Then
                        miModify.Visible = False
                    End If
                    If optEnableVoidAuthorityMenuItem AndAlso miVoid IsNot Nothing Then
                        miVoid.Visible = False
                    End If
                End If

                If optUseSingleFormAuthorityVersionMRS Then
                    mnuTWCRemove.Visible = FailState
                    'mnuTWCRollUp.Visible = False
                    mnuTWCCreate.Visible = False
                    mnuTWCVoid.Text = optGraphicalCompContextMenuTWCVOID ' "CANCEL LICENSE"
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

