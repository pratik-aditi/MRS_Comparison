        ''' <summary>
        ''' Train ID Move From Remote Track
        ''' </summary>
        ''' <param name="symbol">symbol assigned with train</param>
        Public Sub TrainIDMoveFromRemoteTrack(ByRef symbol As String)
            Try
                TrackEventLog($"{GetCurrentMethod.Name}:Train={symbol}")
                Dim releasingTrackGUID As Integer
                If myLeftRemoteLinkedTrack IsNot Nothing Then
                    releasingTrackGUID = myLeftRemoteLinkedTrack.GUID
                ElseIf myRightRemoteLinkedTrack IsNot Nothing Then
                    releasingTrackGUID = myRightRemoteLinkedTrack.GUID
                End If
                Dim train As TrainID = Nothing
                Dim foundRemoteTrain As Boolean = False
                'Check if already exits a remote train in track, thus is not needs retrieve train from db
                For index As Integer = 0 To TrainIDs.Count - 1
                    Dim oneTrain As TrainID = TrainIDs(index)
                    If optEnableExtendLicenseinSplitDesk AndAlso
                        oneTrain IsNot Nothing AndAlso
                        oneTrain.Name = symbol AndAlso
                        oneTrain.TrainRegionStatus = TrainRegionEnum.RemoteTrain Then
                        TrackEventLog($"{GetCurrentMethod.Name}:Found remote train {oneTrain.Name _
                                      } assigned for track {Name}")
                        train = oneTrain
                        foundRemoteTrain = True
                        train.TrainRegionStatus = TrainRegionEnum.InTrasition 'Now train is in transition
                        'Invert segments and update database
                        train.thisCurrentLicense.PTCAuthoritySegmentsCurrentDesk = train.thisCurrentLicense.GetTrackSegmentsRemoteDesk(True)
                        train.thisCurrentLicense.PTCAuthoritySegmentsRemoteDesk = train.thisCurrentLicense.GetTrackSegmentsRemoteDesk(False)
                        train.thisCurrentLicense.PTCAuthoritySegments = $"{train.thisCurrentLicense.PTCAuthoritySegmentsRemoteDesk _
                            }|{train.thisCurrentLicense.PTCAuthoritySegmentsCurrentDesk}"
                        train.thisCurrentLicense.UpdateDatabaseWithPTCAuthoritySegments(GetCurrentMethod.Name)
                        'Add train in collection
                        If Not TrainCollection.Contains(train) Then
                            TrainCollection.Add(train)
                            train.StackOrder = TrainIDs.IndexOf(train)
                        End If
                        TrainIDs(0) = train
                        Exit For
                    End If
                Next
                If Not foundRemoteTrain Then train = RetrieveTrainID(symbol, False, releasingTrackGUID)
                If train IsNot Nothing Then
                    TrackEventLog($"{GetCurrentMethod.Name}:Train {symbol} found")
                    NetworkMessages.CadMessages.SendTrainEventForWabtecOne(train, "UPDATED")
                    train.TrackOccupiedTime = ApplyCurrentTimeZone(Me, Now)
                    train.ApplyTrainAbbreviation(gTrainAbbreviation)
                    If IsRemoteDatabaseLink Then
                        TrackEventLog($"{GetCurrentMethod.Name}:Added train {symbol} coming from remote database")
                        train.InsertNewTrainIDIntoDatabase(Me, gtblTrainsActive)
                        train.PerformConsistDatabaseUpdatePTC()
                        train.DoRequestTrainConsist()
                        train.DoCreateClearanceForTrain()
                    End If
                    AddTrainID(train)
                    UpdateStatus()
                    InitTrainDisplay()
                    If IsLinkToRemoteTrack Then
                        Dim leftTrack As Track = FetchData.FindRemoteTrackItemFromGUID(LeftLink)
                        If leftTrack IsNot Nothing AndAlso
                            leftTrack.IsRemoteTrack AndAlso
                            leftTrack.myRemoteTrack IsNot Nothing Then
                            TrackEventLog($"{GetCurrentMethod.Name}:Release train {symbol} for left track")
                            leftTrack.myRemoteTrack.ReleaseTrainID(train.Name)
                        End If
                        Dim rightTrack As Track = FetchData.FindRemoteTrackItemFromGUID(RightLink)
                        If rightTrack IsNot Nothing AndAlso
                            rightTrack.IsRemoteTrack AndAlso
                            rightTrack.myRemoteTrack IsNot Nothing Then
                            TrackEventLog($"{GetCurrentMethod.Name}:Release train {symbol} for right track")
                            rightTrack.myRemoteTrack.ReleaseTrainID(train.Name)
                        End If
                    End If
                    If MySystemForms.frmSystemSummary.InvokeRequired Then
                        MySystemForms.frmSystemSummary.Invoke(New MethodInvoker(AddressOf MySystemForms.frmSystemSummary.UpdateTrainSummaries))
                    Else
                        MySystemForms.frmSystemSummary.UpdateTrainSummaries()
                    End If
                    UpdateTrainIDs()
                    NetworkMessages.CadMessages.SendTrainSymbolMove(train, gCadTransmitQueue, Nothing, Me, "T")
                    UpDateTrainIDPosition(train)
                    If optEnablePTCBOSVETMSMode Then
                        NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrainStatusRequest(train)
                    End If
                    If (optEnableFlashTrainForHighWide AndAlso train.HighWide) OrElse
                        (optEnableFlashTrainForKey AndAlso train.KeyTrain) Then
                        train.EnableNotificationFlash(True)
                    End If
                    Dim logThisEvent As New DoEventLogTrainID(AddressOf train.LogTheTrainIDEvent)
                    logThisEvent.BeginInvoke(TrainID.EventTypeTrainID.MOVE, Nothing, Nothing)
                    Dim publishThisEvent As New DoPublishTrainEvent(AddressOf train.PublishTrainEvent)
                    publishThisEvent.BeginInvoke(TrainID.EventTypeTrainID.POSITION, False, Nothing, Nothing)
                Else
                    TrackEventLog($"{GetCurrentMethod.Name}:Train {symbol} not found")
                End If
                InvalidateTrainID()
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Sub


