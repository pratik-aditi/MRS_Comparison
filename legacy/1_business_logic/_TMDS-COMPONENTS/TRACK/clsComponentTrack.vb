                If optEnablePTCBOSVETMSMode AndAlso pMasterBulletinTag Then
                    TMDS.NetworkMessages.PTCBOSVETMSMessaging.Send_VETMS_PTC_TrackTagRestrictionMessageDelete(pTag)
                End If
                RemoveTagFromAllTrainTagLists(pTag)
                TMDS.NetworkMessages.CadMessages.SendSpeedRestrictionEventForWabtecOne(pTag, "CANCEL")
                pTag.Dispose()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                pTag = Nothing
                clientConnection = Nothing
            End Try
