                                                            trn = trk.TrainIDs(0)
                                                            If Not IsTrainMoveAllowedOnIndication(trn, "TrackTrainIDOn") Then Exit Sub
                                                            If trn.Direction = optDirectionWest Or trn.Direction = optDirectionSouth Then
                                                                'CHECK FOR TRACKS THAT ARE ANDED OR ORED AND ARE INDICATED OCCUPIED BEFORE THIS TRACK FOUND OCCUPIED.
                                                                If Me.TrackIndicationORED Or Me.TrackIndicationANDED Then
                                                                    Dim NextTrackToCheck As Track = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(Me.RightLink)
                                                                    If Not NextTrackToCheck Is Nothing Then
                                                                        If Not NextTrackToCheck.Ind(0) Is Nothing Then
                                                                            If Not NextTrackToCheck.Ind(1) Is Nothing Then
                                                                                If Not Me.Ind(1) Is Nothing Then
                                                                                    If (NextTrackToCheck.Ind(0) Is Me.Ind(0)) Or (NextTrackToCheck.Ind(0) Is Me.Ind(1)) Or (NextTrackToCheck.Ind(1) Is Me.Ind(0)) Then
                                                                                        NextTrackToCheck.MoveTrainIDPlace(trn, trk, OStype, TMDS.GlobalDeclarations.gDatabaseConnectionTrain, "T", "LEFT")
