        ''' <summary>
        ''' Build tag menus
        ''' </summary>
        Private Sub BuildTagMenus()
            Dim miRemove As MenuItem = Nothing
            Dim miModify As MenuItem = Nothing
            Dim miCopy As MenuItem = Nothing
            Try
                If Me.TrackTagLabels.Count >= 0 Then
                    miRemove = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuTagRemove))
                    If optEnableTagModifyMenu Then miModify = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuTagModify))
                    If optEnableTagCopyMenu Then miCopy = ContextMenuControl.MenuItems.Item(ContextMenuControl.MenuItems.IndexOf(mnuTagCopy))
                    miRemove.MenuItems.Clear()
                    If optEnableTagModifyMenu Then miModify.MenuItems.Clear()
                    If optEnableTagCopyMenu Then miCopy.MenuItems.Clear()
                End If

                If Me.myGradeCrossings.Count > 0 AndAlso Not OptEnableInfoTAGOnly Then
                    Me.mnuTagXing.MenuItems.Clear()
                    Dim gc As GradeCrossing
                    For Each gc In myGradeCrossings
                        Dim XingString As String = gc.MilePostPrefix & gc.MilePost & gc.MilePostSuffix
                        If optApplyConfigurationForKCT Then
                            XingString = XingString & " | " & gc.StreetName
                        Else
                            XingString = XingString & " - " & gc.StreetName
                        End If
                        Me.mnuTagXing.MenuItems.Add(New MenuItem(XingString, AddressOf mnuTagXing_Specific))
                    Next
                    Me.mnuTagXing.MenuItems.Add(New MenuItem("BLANK CROSSING", AddressOf mnuTagXing_Specific))
                End If

                If Me.TrackTagLabels.Count > 0 Then
                    Dim tg As Tag
                    miRemove.Visible = True
                    If optEnableTagModifyMenu Then miModify.Visible = True
                    If optEnableTagCopyMenu Then miCopy.Visible = True
                    Dim TagType As String = String.Empty
                    For Each tg In Me.TrackTagLabels
                        Select Case tg.TagType
                            Case optTagType1 '"SPEED"
                                TagType = optTagType1
                            Case optTagType2 '"XING"
                                TagType = optTagType2
                            Case optTagType3 '"INFO"
                                If tg.IsCriticalAlertType Then
                                    TagType = "CRITICAL ALERT"
                                Else
                                    TagType = optTagType3
                                End If
                            Case optTagType4 '"WEATHER
                                TagType = optTagType4
                            Case optTagType4 '"WEATHER
                                TagType = optTagType4
                            Case optTagType5 '"TRACK BULLETIN
                                TagType = optTagType5
                            Case optTagType6 '"TRACK ALARM
                                TagType = optTagType6
                            Case optTagType7 'WORK ZONE
                                TagType = optTagType7
                        End Select

                        Dim TagData As String = TagType & ", " & tg.Creator & ", " & tg.CreateTime
                        Dim DataString() As String = tg.DataString.Split("|")

                        Select Case tg.TagType
                            Case optTagType1 '"SPEED"
                                TagData = TagData & ", " & DataString(0) & ", " & DataString(5) & ", " & DataString(1) & ", " & DataString(2)
                            Case optTagType2 '"XING"
                                TagData = TagData & ", " & DataString(0) & ", " & DataString(1)
                            Case optTagType7 'WORK ZONE"
                                TagData = TagData & ", " & DataString(0) & ", " & DataString(5) & ", " & DataString(1) & ", " & DataString(2)
                        End Select

                        Me.mnuTagRemove.MenuItems.Add(New MenuItem(TagData, AddressOf mnuTagRemove_Click))
                        If optEnableTagModifyMenu Then Me.mnuTagModify.MenuItems.Add(New MenuItem(TagData, AddressOf mnuTagModify_Click))
                        If optEnableTagCopyMenu Then Me.mnuTagCopy.MenuItems.Add(New MenuItem(TagData, AddressOf mnuTagCopy_Click))
                    Next
                Else
                    If Me.TrackTagLabels.Count >= 0 Then
                        miRemove.Visible = False
                        If optEnableTagModifyMenu Then miModify.Visible = False
                        If optEnableTagCopyMenu Then miCopy.Visible = False
                    End If
                End If

                If optDisableTagSpeed Then
                    If Not IsNothing(mnuTagSpeed) Then
                        mnuTagSpeed.Enabled = False
                        mnuTagSpeed.Visible = False
                    End If
                End If

                If optDisableTagXing Then
                    If Not IsNothing(mnuTagXing) Then
                        mnuTagXing.Enabled = False
                        mnuTagXing.Visible = False
                    End If
                End If

                If optEnableLicenseGenerationForPTC Then
                    Dim Auth As Object = Nothing
                    For Each Auth In Me.TrackAuthorities
                        If Auth.GetType.ToString = gTTComponentName AndAlso Auth.LicenseTypeAuthority Then
                            If miRemove IsNot Nothing Then miRemove.Visible = False
                            If optEnableTagModifyMenu Then If miModify IsNot Nothing Then miModify.Visible = False
                            If optEnableTagCopyMenu Then If miCopy IsNot Nothing Then miCopy.Visible = False
                            Exit For
                        End If
                    Next
                    If OtherSplAuthorities.Count > 0 Then
                        If miRemove IsNot Nothing Then miRemove.Visible = False
                        If optEnableTagModifyMenu Then If miModify IsNot Nothing Then miModify.Visible = False
                        If optEnableTagCopyMenu Then If miCopy IsNot Nothing Then miCopy.Visible = False
                    End If
                End If

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                miRemove = Nothing
                miModify = Nothing
                miCopy = Nothing
            End Try
        End Sub

