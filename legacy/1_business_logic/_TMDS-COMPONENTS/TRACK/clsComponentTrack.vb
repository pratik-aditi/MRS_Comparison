        Private Function SetMilePostLimits(ByVal currentTrack As Track, ByVal LowMP As Decimal, ByVal HighMP As Decimal) As Boolean

            Try
                If currentTrack Is Nothing Then Exit Function
                If currentTrack.OStype Then
                    Dim osTrk As Object
                    If IsNothing(currentTrack.OsComponentCollection) Then
                        currentTrack.OsComponentCollection = currentTrack.FindOsTracks
                    End If
                    For Each osTrk In currentTrack.OsComponentCollection
                        If osTrk.GetType.ToString = "TMDS.TrackComponents.Track" Then
                            If osTrk.LeftLimitMilePost > osTrk.RightLimitMilePost Then
                                If Me.MilePostHigh <= currentTrack.LeftLimitMilePost Then
                                    Me.MilePostHigh = currentTrack.LeftLimitMilePost
                                End If
                                If Me.MilePostLow = 0 Then Me.MilePostLow = currentTrack.RightLimitMilePost
                                If Me.MilePostLow >= currentTrack.RightLimitMilePost And currentTrack.RightLimitMilePost <> 0 Then
                                    Me.MilePostLow = currentTrack.RightLimitMilePost
                                End If
                            Else
                                If Me.MilePostLow = 0 Then Me.MilePostLow = currentTrack.LeftLimitMilePost
                                If Me.MilePostLow >= currentTrack.LeftLimitMilePost And currentTrack.LeftLimitMilePost <> 0 Then
                                    Me.MilePostLow = currentTrack.LeftLimitMilePost
                                End If

                                If Me.MilePostHigh <= currentTrack.RightLimitMilePost Then
                                    Me.MilePostHigh = currentTrack.RightLimitMilePost
                                End If
                            End If
                        End If
                    Next

                Else
                    If currentTrack.LeftLimitMilePost > currentTrack.RightLimitMilePost Then
                        Me.MilePostHigh = currentTrack.LeftLimitMilePost
                        Me.MilePostLow = currentTrack.RightLimitMilePost
                    Else
                        Me.MilePostLow = currentTrack.LeftLimitMilePost
                        Me.MilePostHigh = currentTrack.RightLimitMilePost
                    End If
                End If
                If (LowMP >= Me.MilePostLow And LowMP <= Me.MilePostHigh) And HighMP <= Me.MilePostHigh And HighMP >= Me.MilePostLow Then
                    Return True
                End If
                Return False
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
        End Function

