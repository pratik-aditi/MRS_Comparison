                        ElseIf NextComp.GetType.ToString = "TMDS.TrackOtherComponents.RRXING" Then
                            Dim RR As RRXING = CType(NextComp, RRXING)
                            NextComp = TMDS.SystemUtilities.FetchData.FindTrackItemFromGUID(RR.FindExitGUID(LastRefNumber))

                        Else
                            If FlipIt Then
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.RightLink)
                            Else
                                NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(NextComp.LeftLink)
                            End If
                        End If
                        LoopControl = LoopControl + 1
                        If LoopControl > 10 Then
                            SearchLeftComplete = True
                        End If
                    End While

                    'if no candidate found for the left search then try to the left 
                    NextComp = TMDS.SystemUtilities.FetchData.FindCompItemFromGUID(Me.RightLink)
                    LoopControl = 0
                    While Not SearchRightComplete
