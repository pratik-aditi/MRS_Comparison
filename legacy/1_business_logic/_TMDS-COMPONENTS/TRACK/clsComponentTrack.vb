        Private Sub FindForcedSwtich()
            Dim LComp As Object = Nothing
            Dim RComp As Object = Nothing
            Dim Comp As Object = Nothing
            Dim SComp As Object = Nothing
            Dim CloneSelection As New ArrayList
            Try
                ForcedSwitch = Nothing
                ForcedSwitchCollection = New ArrayList
                ExemptTrackCollection = New ArrayList
                CloneSelection = gEntExtTrackSelection.Clone
                For Each Comp In CloneSelection

                    If Comp.GetType.ToString = gSwitchComponentName Then
                        LComp = Nothing
                        RComp = Nothing
                        LComp = FindCompFromGUID(Comp.LeftLink)
                        RComp = FindCompFromGUID(Comp.RightLink)
                        If gEntExtTrackSelection.Contains(LComp) And gEntExtTrackSelection.Contains(RComp) Then
                            If Not ObjectExistsInCollection(ForcedSwitchCollection, Comp) Then
                                ForcedSwitchCollection.Add(Comp)
                            End If
                        Else
                            ForcedSwitch = Comp
                            If Not ForcedSwitchCollection.Contains(Comp) Then ForcedSwitchCollection.Add(Comp)
                            'Exit For
                            If Not gEntExtTrackSelection.Contains(LComp) Then
                                ExemptTrack = LComp
                                ExemptTrackCollection.Add(LComp)
                                SComp = FindCompFromGUID(LComp.LeftLink)
                                If SComp.GetType.ToString = gSignalComponentName Then
                                    ExemptSignal = SComp
                                    ExemptSignalCollection.Add(SComp)
                                End If
                            ElseIf Not gEntExtTrackSelection.Contains(RComp) Then
                                ExemptTrack = RComp
                                ExemptTrackCollection.Add(RComp)
                                SComp = FindCompFromGUID(LComp.RightLink)
                                If SComp.GetType.ToString = gSignalComponentName Then
                                    ExemptSignal = SComp
                                    ExemptSignalCollection.Add(SComp)
                                End If
                            End If

                        End If
                    ElseIf Comp.GetType.ToString = gTrackComponentName Then
                        If Comp.OSReporting Then
                            Dim compCollection As Object
                            For Each compCollection In Comp.OsComponentCollection
                                If compCollection.GetType.ToString = gSwitchComponentName Then
                                    If Not ForcedSwitchCollection.Contains(compCollection) Then
                                        ForcedSwitchCollection.Add(compCollection)
                                    End If
                                End If
                            Next
                        End If
                    End If
                Next

                FindExemptTrack()
            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                LComp = Nothing
                RComp = Nothing
                Comp = Nothing
                CloneSelection = Nothing
                SComp = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Finds forced switches in the track selection?
        ''' </summary>
        ''' <remarks></remarks>
        Private Sub FindForcedSwitch_BNSF()

            Dim LComp As Object = Nothing
            Dim RComp As Object = Nothing
            Dim Comp As Object = Nothing
            Dim SComp As Object = Nothing
            Dim CloneSelection As New ArrayList
            Try
                ForcedSwitch = Nothing
                ForcedSwitchCollection = New ArrayList
                ExemptTrackCollection = New ArrayList
                CloneSelection = gEntExtTrackSelection.Clone
                For Each Comp In CloneSelection

                    If Comp.GetType.ToString = gSwitchComponentName Then
                        LComp = Nothing
                        RComp = Nothing
                        LComp = FindCompFromGUID(Comp.LeftLink)
                        RComp = FindCompFromGUID(Comp.RightLink)
                        If gEntExtTrackSelection.Contains(LComp) And gEntExtTrackSelection.Contains(RComp) Then
                            If Not ObjectExistsInCollection(ForcedSwitchCollection, Comp) Then
                                ForcedSwitchCollection.Add(Comp)
                            End If
                        Else
                            ForcedSwitch = Comp
                            If Not ForcedSwitchCollection.Contains(Comp) Then ForcedSwitchCollection.Add(Comp)
                            'Exit For
                            If Not gEntExtTrackSelection.Contains(LComp) Then
                                ExemptTrack = LComp
                                ExemptTrackCollection.Add(LComp)
                                SComp = FindCompFromGUID(LComp.LeftLink)
                                If SComp.GetType.ToString = gSignalComponentName Then
                                    ExemptSignal = SComp
                                    ExemptSignalCollection.Add(SComp)
                                End If
                            ElseIf Not gEntExtTrackSelection.Contains(RComp) Then
                                ExemptTrack = RComp
                                ExemptTrackCollection.Add(RComp)
                                SComp = FindCompFromGUID(LComp.RightLink)
                                If SComp.GetType.ToString = gSignalComponentName Then
                                    ExemptSignal = SComp
                                    ExemptSignalCollection.Add(SComp)
                                End If
                            End If

                        End If
                    ElseIf Comp.GetType.ToString = gTrackComponentName Then
                        If Comp.OSReporting Then
                            Dim compCollection As Object
                            For Each compCollection In Comp.OsComponentCollection
                                If compCollection.GetType.ToString = gSwitchComponentName Then
                                    If Not ForcedSwitchCollection.Contains(compCollection) Then
                                        ForcedSwitchCollection.Add(compCollection)
                                    End If
                                End If
                            Next
                        End If
                    End If
                Next

                FindExemptTrack_BNSF()

            Catch ex As Exception
                SystemException(ex.ToString)
            Finally
                LComp = Nothing
                RComp = Nothing
                Comp = Nothing
                CloneSelection = Nothing
                SComp = Nothing
            End Try
        End Sub

        ''' <summary>
        ''' Checks the GUID of the component submitted agains the collection submitted.
        ''' </summary>
        ''' <param name="tmds_object_collection">The collection.</param>
        ''' <param name="tmds_object">The component.</param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Private Function ObjectExistsInCollection(ByVal tmds_object_collection As ArrayList, ByVal tmds_object As Object) As Boolean

            If tmds_object_collection Is Nothing Then
                Return False
            End If

            If tmds_object_collection.Count = 0 Then
                Return False
            End If

            Try

                For Each tmdsComponent As Object In tmds_object_collection
                    If tmdsComponent.Guid = tmds_object.Guid Then
                        Return True
                    End If
                Next

            Catch ex As Exception
                SystemException(ex.ToString)
            End Try

            Return False

        End Function

