        Public Function CheckIfZoneOccupiedIsConsecutive(ByVal AuthZonelist As ArrayList, ByVal ZoneName As String) As Boolean
            Dim isConsecutive As Boolean = True
            Try
                Dim ZoneDownList As New ArrayList
                If AuthZonelist.Count > 0 Then
                    For Each zn As ZoneDetail In AuthZonelist
                        If zn.ZoneDown Then
                            ZoneDownList.Add(zn)
                        End If
                        If ZoneDownList.Count > 1 Then
                            For znDwnindx As Integer = 0 To ZoneDownList.Count - 2
                                Dim currentSequenceNumber As Int32 = ZoneDownList(znDwnindx).ZoneSequence
                                Dim nextSequenceNumber As Int32 = ZoneDownList(znDwnindx + 1).ZoneSequence
                                If currentSequenceNumber + 1 <> nextSequenceNumber Then
                                    isConsecutive = False
                                End If
                            Next
                        End If
                        If Not isConsecutive Then
                            Exit For
                        End If
                    Next

                    If ZoneDownList.Count = 1 Then
                        isConsecutive = False
                    End If
                End If
                Dim strevt As String = "ZONE EVENT SEQUENCE CHECK: ZONE NAME :" & ZoneName.ToString & " ZONE STATUS :" & isConsecutive.ToString & " ZONE DOWN COUNT :" & ZoneDownList.Count.ToString
                AddEventToLog(EventEnum.SystemEvent, strevt, SystemEventQueue)
            Catch ex As Exception
                SystemException(ex.ToString)
                isConsecutive = False
            End Try
            Return isConsecutive
        End Function

        Public Function CheckIfZoneOccupiedIsConsecutiveFromBeginningLimits(ByVal AuthZonelist As ArrayList, ByVal ZoneName As String) As Boolean
            Try
                If AuthZonelist.Count > 0 Then
                    Dim Zn As ZoneDetail
                    Dim i As Integer = 0
                    Dim znindx As Integer = 0
                    Dim isValid As Boolean = True
                    For Each Zn In AuthZonelist
                        If Zn.ZoneName = ZoneName Then
                            znindx = i
                            Exit For
                        End If
                        i = i + 1
                    Next
                    For i = 0 To znindx - 1
                        If Not AuthZonelist(i).ZoneDown Then
                            isValid = False
                            Exit For
                        End If
                    Next
                    Return isValid
                End If
            Catch ex As Exception
                SystemException(ex.ToString)
            End Try
            Return False
        End Function

